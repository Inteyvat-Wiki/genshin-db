				"objectNames": [
					"Zakariya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230380101,
					"content": "#{F#Reisende}{M#Reisender}! {F#Reisende}{M#Reisender}, komm schnell her, du musst mir bei etwas helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380102
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380102,
					"content": "Was ist passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380103
					]
				},
				{
					"id": 230380103,
					"content": "Erinnerst du dich noch an Maruf? Der Arzt des Aaru-Dorfs, für den du vorher ein Rezept von mir holen solltest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380104
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380104,
					"content": "Der Kerl hat eine Schüssel seiner selbst zubereiteten Medizin probiert und bekam davon mehrere Tage Erbrechen und Durchfall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380105
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380105,
					"content": "Ich habe ihn nach dem Grund gefragt. Als der Patient sein Heilgebräu trank, gab es keinerlei Wirkung. Da hat er auf Gutdünken selbst das Rezept geändert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380106
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380106,
					"content": "Ich habe keine Ahnung, was für eine Zutat der Kerl in das Heilgebräu getan hat, dass sie ihn so zugerichtet hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380107
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380107,
					"content": "*seufz* Wenn er beim ursprünglichen Rezept geblieben wäre und nur die Menge der Zutaten und die Art der Zubereitung etwas geändert hätte, wäre das niemals passiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380108
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380108,
					"content": "So etwas ist nicht zum ersten Mal passiert. Wie konnte er nur wieder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380109
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380109,
					"content": "Egal, vielleicht hat er ja mit irgendetwas zu kämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380110
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380110,
					"content": "#{F#Reisende}{M#Reisender}, kannst du ein paar Heilkräuter für mich holen gehen? Dann stelle ich selbst eine Medizin her, die du dann gleich zu Maruf bringen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380111,
						230380112
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380111,
					"content": "Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380114
					]
				},
				{
					"id": 230380114,
					"content": "Das Rezept, das Maruf dieses Mal geändert hat, ist das, welches ich ihm letztes Mal zur Behandlung von Kopfschmerzen ausgestellt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380115
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380115,
					"content": "Ich brauche noch drei Hennabeeren für dieses Rezept, bitte pflück doch drei für mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380112,
					"content": "Hat er das vorher schon einmal getan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380113
					]
				},
				{
					"id": 230380113,
					"content": "Na klar, ich habe schon vergessen, wie oft. Zum Glück hat er noch keine Rezepte für Medikamente mit giftigen Zutaten in die Finger bekommen, sonst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380114
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
