	"talks": [
		{
			"id": 7319401,
			"completionStepIds": [
				7319401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319401",
							"2"
						],
						"stepId": 7319401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940101,
					"content": "Die Ankündigungstafel wurde vom Mahamata eingeführt, um Bekanntgaben zu wichtigen Angelegenheiten in der Stadt Sumeru zu machen. In Zusammenhang stehende Fragen oder Zweifel können hier ebenfalls hinterlassen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319402,
			"completionStepIds": [
				7319402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319402",
							"2"
						],
						"stepId": 7319402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940201,
					"content": "„Hast du gehört? Die Waldhüter haben im Norden des Waldes einen prächtigen Palast gefunden, der aus dem Nichts entstanden ist.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940202
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731940202,
					"content": "„Aber alle, die dorthin gegangen sind, wurden um ihr ganzes Geld betrogen. Als die Waldhüter sie aufgefunden haben, waren sie nur in Unterhosen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940203
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731940203,
					"content": "„Und sie haben geweint und sich geweigert preiszugeben, was passiert ist. Es war absolut entsetzlich.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940204
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731940204,
					"content": "„Man sollte nicht im Wald umherwandern.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319403,
			"completionStepIds": [
				7319403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319403",
							"2"
						],
						"stepId": 7319403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940301,
					"content": "Die Ankündigungen zu den einheimischen und auswärtigen Angelegenheiten von Sumeru werden durch Akasha veröffentlicht. Bitte trage dein „Akasha-Kontrollgerät“, um keine wichtigen Nachrichten zu versäumen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940302
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731940302,
					"content": "Die Ankündigungstafel wird vorübergehend für fremde Kaufleute, ältere Menschen und Kinder beibehalten. Sie kann künftig jederzeit entfernt werden, bitte verlass dich nicht zu sehr auf sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319404,
			"completionStepIds": [
				7319404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319404",
							"2"
						],
						"stepId": 7319404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940401,
					"content": "Die Ausschüttung von „anahitianischem Segen“ für dieses Jahr hat begonnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940402
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731940402,
					"content": "Die Ausschüttung erfolgt grundsätzlich nach den Richtlinien und Vorgaben des letzten Jahres. Einzelheiten sind in Akasha einsehbar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940403
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731940403,
					"content": "Bitte wende dich bei Änderungen an den nächsten Mahamata, um eine Bearbeitungsanfrage an die Akademie einzureichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319405,
			"completionStepIds": [
				7319405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319405",
							"2"
						],
						"stepId": 7319405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940501,
					"content": "In letzter Zeit wurden mehrere Fälle von „Eleazar“ in der Stadt identifiziert. Solltest du Symptome wie Hauttaubheit, Gliedmaßenschwäche oder graue und schwarze Schuppenbildung am Oberkörper bei sich feststellen, begib dich bitte sofort ins Bimarstan zur Behandlung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940502
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731940502,
					"content": "Falls du den besten Behandlungszeitraum versäumst und sich das Krankheitsbild verschlechtert, kann dies zu schwerwiegenden Folgen wie beispielsweise Arbeitsunfähigkeit führen. Bitte beachte diesen Hinweis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319406,
			"completionStepIds": [
				7319406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319406",
							"2"
						],
						"stepId": 7319406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940601,
					"content": "Besonderer Hinweis: Die „Goldbrigaden“ sind die einzige zugelassene Söldnerorganisation in Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940602
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731940602,
					"content": "Bitte bleibe Fremden gegenüber misstrauisch, damit du nicht von Unbekannten um die Prämie betrogen wirst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940603
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731940603,
					"content": "Wenn du Leibwächter oder Sicherheitspersonal einstellen möchtest oder andere Aufträge hast, wende dich bitte an den Parchamdar Rukh Shah vom „Regiment der Dreißig“ oder veröffentliche eine Mission durch den Verbindungsoffizier Effendi von der Akademie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319407,
			"completionStepIds": [
				7319407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319407",
							"2"
						],
						"stepId": 7319407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940701,
					"content": "Das Bimarstan ist eine medizinische Einrichtung des Amurta-Instituts, die alle Einwohner von Sumeru kostenlos medizinisch versorgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940702
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731940702,
					"content": "Die Ärzte, die im Bimarstan tätig sind, verfügen über Lizenzen von der Schule der Lebenskunde. Die Diagnosen und Behandlungspläne werden mehrfach von Akasha überprüft. Wir stellen den Einwohnern von Sumeru die besten medizinischen Dienstleistungen mit höchster Sicherheit zur Verfügung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940703
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731940703,
					"content": "Bitte vertraue keinen unbekannten oder unlizenzierten Ärzten, um finanziellen Verlusten und irreversiblen Gesundheitsschäden vorzubeugen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319408,
			"completionStepIds": [
				7319408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
