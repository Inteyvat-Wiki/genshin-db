			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940801,
					"content": "Bitte trag nicht zu viele Mora an gut gefüllten Plätzen in der Stadt bei dir, um Diebstählen vorzubeugen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940802
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731940802,
					"content": "Falls du Opfer eines Diebstahls geworden bist, suche bitte keine Hilfe von der Goldbrigade, die in der Nähe patrouilliert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940803
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731940803,
					"content": "Denn höchstwahrscheinlich steckt die Goldbrigade hinter dem Diebstahl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
