			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731941201,
					"content": "„Bitte sei vorsichtig, wenn du eine Reise in den Regenwald planst. Mein Mentor hat mich letztens dorthin geschickt, um ein paar Kräuter zu sammeln und beinahe hätte ich mein Leben an einen Rishboland-Tiger verloren.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941202
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731941202,
					"content": "„Zum Glück hat mich die Waldhüterin in der Nähe gerettet. Sie meinte zwar, sie wäre eine auszubildende Waldhüterin, aber sie war wirklich sehr erfahren. Außerdem hat sie mir Essen gegeben, um meinen Schock zu lindern.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941203
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731941203,
					"content": "„Sie ist sogar eine Studentin von Tighnari. Sie hat wirklich vom Besten gelernt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
