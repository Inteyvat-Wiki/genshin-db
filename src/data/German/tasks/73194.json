			"dialogs": [
				{
					"id": 731940901,
					"content": "Kopfgeld: Kasim",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940902
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731940902,
					"content": "Diese Person gibt sich als berühmter Bandit aus, der durch die Welt reist, ist aber in Wirklichkeit ein Betrüger, der nirgendwo in der Rangliste der Goldbrigade zu finden ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940903
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731940903,
					"content": "Die Person ist in mehrere Betrugsfälle verwickelt. Bitte bleib wachsam und fall nicht seine Heucheleien herein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
