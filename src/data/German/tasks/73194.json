				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731941101,
					"content": "Da die Mahamata die Tafel nicht mehr für Ankündigungen brauchen, wird sie von nun an als Nachrichtentafel von Lambads Taverne verwendet. Hinterlass hier gern jederzeit eine Nachricht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941102
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731941102,
					"content": "„Sind die zehn Kisten Wein, die ich bestellt habe, angekommen? Ich bin gestern wie vereinbart gekommen und am Ende waren sie nicht da.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941103
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731941103,
					"content": "Wie kann das sein! Früher war ein blonder Junge hier und meinte, er wäre dein Mitbewohner. Er hat den ganzen Wein mitgenommen. Ich erinnere mich sogar, dass ihr beide zusammen hier wart. Hier muss ein Irrtum vorliegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941104
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731941104,
					"content": "„... In Ordnung. Ich weiß Bescheid.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319412,
			"completionStepIds": [
				7319412
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
