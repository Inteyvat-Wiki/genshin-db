			"dialogs": [
				{
					"id": 731941001,
					"content": "Kopfgeld: Mustah",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941002
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731941002,
					"content": "Diese Person gibt sich als Mahamata aus und ist an Erpressungs- und Raubüberfällen auf dem Basar und im Hafen beteiligt. Die Halle von Regzar führt zurzeit Ermittlungen gegen diese Person durch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941003
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731941003,
					"content": "Verschiedene Meldungen geben an, dass sie sich derzeit im Wald versteckt. Bitte melde dich, wenn du ihn siehst.",
					"roleType": "TALK_ROLE_NPC",
