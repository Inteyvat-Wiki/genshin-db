			},
			"dialogs": [
				{
					"id": 110040301,
					"content": "Fluxeisbäumchen, Fluxilein, komm, mein leckeres Bäumchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040302
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040302,
					"content": "Flüxchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040303,
						110040305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040303,
					"content": "Jetzt mach nicht auch noch mit!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040304
					]
				},
				{
					"id": 110040304,
					"content": "Ach, jetzt hör doch mal auf! Was könnte es Schöneres auf dieser Welt geben, als so seltene Zutaten zu bekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040307
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040307,
					"content": "Hm, hier scheint noch etwas anderes zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040308
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040308,
					"content": "Das muss das Wildschwein sein, von dem der Jäger gesprochen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040309,
					"content": "Eins mit so einem Muster habe ich aber noch nicht gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040310,
					"content": "Dieses Muster habe ich schon einmal gesehen! Warte mal, das muss im „Historia Naturalis Liyue“ gewesen sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040311
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040311,
					"content": "So ein Muster ... Ja, das muss es sein! Diese Wildschweine müssten schon seit 300 Jahren ausgestorben sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040312
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040312,
					"content": "Echt? Wie kann dieses Schwein dann noch am Leben sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040313,
						110040315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040313,
					"content": "Es war sicher eingefroren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040314
					]
				},
				{
					"id": 110040314,
					"content": "Das könnte sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040317,
					"content": "Im Buch stand, dass diese Wildschweinart aufgrund ihres besonders leckeren Fleischs gejagt wurde und zwar solange, bis sie ausgerottet war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040318
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040318,
					"content": "Ein Fluxeisbaum und ein Wildschwein ... Da haben wir zwei wahre Schätze gefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040319
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040319,
					"content": "Damit können wir nur gewinnen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040320
					]
				},
				{
					"id": 110040320,
					"content": "Genau, also gehen wir nach Quellingen zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040315,
					"content": "Es könnte einfach besonders alt geworden sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040316
					]
				},
				{
					"id": 110040316,
					"content": "Das ist viel zu alt für ein Schwein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040305,
					"content": "Fluxibuxi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040306
					]
				},
				{
					"id": 110040306,
					"content": "Hahaha! Bei euch klingt das gleich ganz anders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040307
					],
					"speakerTitle": "Xiangling"
				}
			]
		}
	]
}