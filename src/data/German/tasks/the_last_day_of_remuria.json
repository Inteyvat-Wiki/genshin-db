				"objectNames": [
					"Herr Os"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832101,
					"content": "Ich hätte nicht gedacht, dass Drachenechsen diese Größe erreichen können.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832102
					]
				},
				{
					"id": 741832102,
					"content": "Hmpf, letztlich sind sie Barbarenvölker ohne Erziehung. Es wäre keine Überraschung, wenn sie sich in etwas noch Merkwürdigeres verwandeln konnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herr Os"
				}
			]
		},
		{
			"id": 7418322,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"402501",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418304",
							"2"
						],
						"stepId": 7418304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Herr Os"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832201,
					"content": "Da wir gerade dabei sind, ist Neuvillette nicht der ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832202
					]
				},
				{
					"id": 741832202,
					"content": "Stimmt, ist Neuvillette nicht der Wasserdrache? Bedeutet das etwa, dass dieses Geschöpf noch viel älter als Neuvillette ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832203,
					"content": "Ist bereits ein neuer Wasserdrache geboren worden? Wohl schon, denn selbst die einst mächtige Herrin allen Wassers ist schon vor langer Zeit dahingeschieden ... Zu viel Zeit ist seither verflossen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herr Os"
				}
			]
		},
		{
			"id": 7418323,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418304",
							"2"
						],
						"stepId": 7418304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Herr Os"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832301,
					"content": "Jedenfalls galt Scylla, der böse Drache, einst als Getreuer des Sebastos. Er entfesselte jedoch einen Aufstand genau in dem kritischen Augenblick, als wir, das Volk von Remuria, den entscheidenden Kampf gegen die Menschen von Fontaine führten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832302
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741832302,
					"content": "An jenem Tag zog der böse Drache mit seiner grausamen Drachenbrut geradewegs auf Machimos zu, mit dem Ziel, ins Innere des Capitoliums, in dem sich der Sebastos aufhielt, einzudringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832303,
						741832304
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741832303,
					"content": "Machimos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832305
					]
				},
				{
					"id": 741832305,
					"content": "Ja, die Bewohner der Stadt redeten immerfort von irgendeinem „Machimos“ und einer Art Glockenturm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832306,
					"content": "Richtig, Machimos ist der äußere Teil der Hauptstadt, aber wenn der böse Drache in die innere Stadt vordringen will, muss er das Initium Iani passieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832307
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741832307,
					"content": "Es ist die Barriere, die den inneren vom äußeren Teil der Hauptstadt trennt. Die Sinfonie, die der Sebastos zusammen mit den Musikern schuf, verbreitete sich durch die goldenen Wasserstraßen am Initium Iani, um ganz Remuria zu erreichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832308
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741832308,
					"content": "Boethius und seine Truppen nutzten genau diesen Umstand, um das Initium Iani zu schließen, damit der böse Drache endgültig gebannt wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832309
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741832309,
					"content": "Vielleicht ersuchte Scylla eine Audienz beim Sebastos, aber diese Gelegenheit hat es nie wieder gegeben. Danach versank der böse Drache mit Remuria in den dunklen Fluten, und der Sebastos ward nicht mehr gesehen, bis zum heutigen Tag ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832310,
						741832311,
						741832312
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741832310,
					"content": "(Etwas stimmt hier nicht ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832313
					]
				},
				{
					"id": 741832313,
					"content": "#{NICKNAME}, erinnerst du dich an etwas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832314
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741832314,
					"content": "Ich bin ein wenig durcheinander.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832315
					]
				},
				{
					"id": 741832315,
					"content": "Das ist verständlich ... Von diesen Dingen habe ich auch erst später erfahren. Zum Zeitpunkt der Katastrophe war ich nicht in der Hauptstadt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832316
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741832316,
					"content": "Niemand wusste, was sich zu jener Zeit beim Sebastos zugetragen hat. Weitere Hinweise werden wir wohl nur finden, wenn wir unseren Weg fortsetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832317
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741832317,
					"content": "Jener große leuchtende Fisch, den wir im Schloss sahen, war vermutlich ein aus den Spalten seines steinernen Gefängnisses entflohener Gedanke Scyllas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832318
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741832318,
					"content": "Wahrscheinlich hat er uns schon lang bemerkt. Jetzt, nach der langen Zeit der Isolation, wo er endlich Menschen von draußen bemerkt hat, wird er sich bestimmt einen Weg einfallen lassen, uns hineinzulocken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832319
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741832319,
					"content": "So ist das also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832320,
					"content": "Warte, du hast gesagt, um zur Domus Aurea zu kommen, müssen wir durch dieses Tor oder so ähnlich. Aber wurde es nicht von Boethius geschlossen? Bedeutet das nicht, dass wir überhaupt nicht dorthin gelangen können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832321,
					"content": "Das ist wirklich ein Problem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832322
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741832322,
					"content": "Waah, unhöflich bleibt unhöflich, da hilft auch kein vorgetäuschtes „ich warte in der Domus Aurea auf euch“ ... Und dann hat er uns nicht einmal den Eingang offen gehalten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832323,
					"content": "Paimon findet, wir sollten lieber versuchen, das Siegel, mit der er den bösen Drachen gebannt hat, zu brechen, damit sein ehemaliger Getreuer das Tor für uns aufbricht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832324,
					"content": "Das geht doch nicht! Egal wie man es betrachtet ... er bleibt ein Widersacher Remurias ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832325,
						741832326
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741832325,
					"content": "Die Feinde unserer Feinde sind unsere Freunde!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832327
					]
				},
				{
					"id": 741832327,
					"content": "Genau, und es ist so viel Zeit vergangen. Vielleicht hat er seine Meinung geändert und ist ein guter Drache geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832328,
					"content": "Dennoch bleibt er ein Drache ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832329
					],
					"speakerTitle": "Herr Os"
