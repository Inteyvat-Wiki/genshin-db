						"position": [
							1494.143,
							702.766,
							4593.569
						],
						"pointId": 901101004
					}
				]
			},
			"dialogs": [
				{
					"id": 741830401,
					"content": "Waah ... Er ähnelt dem merkwürdigen leuchtenden Fisch, den wir zuvor gesehen haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830402,
					"content": "Und er ist von seltsamen Schnüren gefesselt ... Was ist das alles? Komisch, Paimon wird immer verwirrter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830403,
						741830404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830403,
					"content": "Ich habe diese Stimme schon einmal in einem Traum gehört ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830405
					]
				},
				{
					"id": 741830405,
					"content": "Nun, du solltest ihn in den Erinnerungen des Sebastos gesehen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830406
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741830406,
					"content": "„Scylla“ ist ein böser Drache, der einst dem Sebastos diente. Boethius hat ihn gebändigt und an diesem Ort eingeschlossen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830407
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741830407,
					"content": "Ähm, hä? Einen bösen Drachen einsperren? Paimon hätte nicht gedacht, dass dieser unhöfliche Kerl so etwas Tolles vollbracht hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830408,
					"content": "Der „böse Drache“ war in Wirklichkeit einfach eine etwas stärkere Drachenechse. Schließlich kann kein neuer Wasserdrache geboren werden, solange die Herrin allen Wassers noch in den Tiefen der Meere lebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741830404,
					"content": "Jedenfalls erinnere ich mich aber nicht an den Namen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830405
					]
				}
			]
		},
		{
			"id": 7418306,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418306",
							"2"
						],
						"stepId": 7418306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Scylla",
					"Herr Os"
				],
				"points": [
					{
						"sceneId": 11,
						"position": [
							1569,
							656.42,
							4486
						],
						"pointId": 901101005
					}
				]
			},
			"dialogs": [
				{
					"id": 741830601,
					"content": "Oooh! Welch eine wärmende Meeresströmung! Ich werde endlich frei sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830602
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830602,
					"content": "Ihr kleinen Wesen, kommt ihr von der Oberfläche? Auch wenn ich nicht weiß, welche Fügung euch zu meinem Gefängnis in den Tiefen des Wassers geführt hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830603
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830603,
					"content": "Wir sind überhaupt keine kleinen Wesen! Du bist einfach nur viel zu groß, das ist alles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830604,
					"content": "Haha, stimmt! Wie auch immer, nun, da ihr mich aus meinen tausendjährigen Ketten befreit habt, will ich euch dankbar sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830605
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830605,
					"content": "Falls es etwas gibt, das ich für euch tun kann, dann nur heraus damit. Seht es als Dankeschön an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830606
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830606,
					"content": "#Hehe, Paimon wusste doch, dass du ein einsichtiger vernünftiger Typ bist! Hier ist Paimon und {M#dieser}{F#diese} hier ist {NICKNAME} und da drüben ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830607,
					"content": "Ähm ... Paimon weiß nicht, unter welchem Namen du ihn kennst, aber wir nennen ihn „Herrn Os“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830608,
					"content": "Ah, Cassiodor, du bist es. Lange nicht gesehen. Du bist wirklich zurückgekommen, schade nur, dass du etwas zu spät kommst ... etwa tausend Jahre zu spät!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830609
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830609,
					"content": "Oh! Anscheinend kennt unser großer Freund Herrn Os auch schon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830610,
					"content": "Ich habe einem schändlichen Verräter nichts zu sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830611
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741830611,
					"content": "Pass mal lieber auf, was du da sagst, Sterblicher! Im Gegensatz zu euch selbstgefälligem Schnöselvolk halten wir Nachkommen der Drachen uns an unsere Versprechen und begehen keinen Verrat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830612
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830612,
					"content": "Deine Worte sind kurzlebiger als eine Eintagsfliege im Wasser. Dein Verrat steht außer Frage, und es war dein Verrat, der uns den Krieg gekostet hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830613
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741830613,
					"content": "Wenn wir den Krieg nicht verloren hätten ... hätte unser Land ... und der Sebastos auch nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830614
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741830614,
					"content": "Du warst zu lange weg, Cassiodor! Die Wahrheit ist nicht, wie du sie dir vorstellst. Aber es ist auch kein Wunder, denn ursprünglich war es ein geheimer Plan. Wie können dir nur diese Details zu Ohren kommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830615
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830615,
					"content": "... Ein geheimer Plan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830616
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741830616,
					"content": "Dass ich die Armee der Drachenechsen gegen die Hauptstadt führte, war eben Teil von Remus’ letztem geheimem Plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830617
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830617,
					"content": "Und all dies, um sein Land und seine Bevölkerung zu retten. Er ist ein Mann von außerordentlichem Edelmut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830618,
						741830619
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830618,
					"content": "Das klingt irgendwie nach Seemannsgarn ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830620
					]
				},
				{
					"id": 741830620,
					"content": "Das ist doch echt komisch!? Welcher König würde denn eine andere Person bitten, in das eigene Land einzufallen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830621,
					"content": "Kleines Wesen, wie könnten wir jemals die Gedanken von Remus ergründen? Wie dem auch sei, bei der Betrachtung dieses Gegenstands, Cassiodor, wirst du zweifellos die darin liegende Botschaft erfassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830623
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830623,
					"content": "Es sind die goldenen Bienen ... Sie folgen dem Lauf des Schicksals und hören nur auf den Ruf der Sinfonie. Warum würde der Sebastos die Kraft der Sinfonie einem unzivilisierten Drachenwesen anvertrauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830624
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741830624,
					"content": "Weil sie eine Absprache hatten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830625
					]
				},
				{
					"id": 741830625,
					"content": "#Oh? {F#Die}{M#Der} Kleine weiß ja allerhand! Wo hast du diese Dinge denn gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830626
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830626,
					"content": "Aus Erinnerungen, die in den Wassern versunken sind ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830627
					]
				},
				{
					"id": 741830627,
					"content": "Du hast recht! Tatsächlich hatten wir eine Vereinbarung. Aber dann habe ich ihn enttäuscht. Ich erwies mich seines großen Opfers als unwürdig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830628
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830628,
					"content": "Ich habe die Domus Aurea letztlich nicht mehr rechtzeitig erreicht! So haben die tobenden Wellen die ganze Stadt verschlungen, und auch wir konnten nicht entkommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830629
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830629,
					"content": "... Wie kann das sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830630
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741830630,
					"content": "Hmpf! Wenn man von Verrat sprechen will, so ist Boethius der wahre Verräter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830631
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830631,
					"content": "Hätte nicht dieser verlogene Teufel, diese betrügerische Ratte, uns mit ihrer geschmeidigen Zunge in die Irre geführt, wie hätte ich, der ich als Prinz des uralten Drachengeblüts über die Nachkommenschaft herrschte, so ohne Weiteres zu Fall kommen können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830632
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830632,
					"content": "Dieser Teufel behauptete zuerst, auf Remus’ Geheiß gehandelt und bereits seinen Truppen befohlen zu haben, den Widerstand aufzugeben. Doch als wir diesen Ort erreichten, begann er plötzlich einen Aufstand ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830633
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830633,
					"content": "Wenn ich jetzt darüber nachdenke, hat er wohl schon längst irgendwie Wind von Remus’ Plänen bekommen, sodass er sein riesiges Netz ausbreiten und mich Schritt für Schritt in die Falle locken konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830634
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830634,
					"content": "So versteinerten mein Fleisch und Blut und blieben so, bis ich tausend Jahre später, am heutigen Tage, durch eure Hand gerettet wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830635
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830635,
					"content": "Boethius wusste sehr wohl, dass sein Handeln in eine große Katastrophe münden würde, aber dennoch ... Hat er etwa nur, um die Kontrolle über Phobos zu erlangen, solche Untaten begangen ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830636
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741830636,
					"content": "Mir scheint, wir haben die Sache bisher nur zum Teil durchschaut ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830637
					]
				},
				{
					"id": 741830637,
					"content": "Waah, dieser Kerl, der andere Verräter nennt, ist selbst durch und durch ein übler Verräter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830638
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830638,
					"content": "Aber warum hat er es nur getan ...? Sollen wir diesen unhöflichen Kerl vielleicht einfach fragen? Wahrscheinlich würde er uns aber keine ehrliche Antwort geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830639
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830639,
					"content": "Hä? Ist dieser erbärmliche, starrsinnige und unbelehrbare Teufel denn immer noch nicht verschwunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830640
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830640,
					"content": "Ganz genau! Er hat sich auch der Seelen vieler Menschen von Fontaine bemächtigt! Wir sind genau deshalb hierhergekommen, um diese Leute zu befreien ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830641,
					"content": "#Er sagte, er werde in der Domus Aurea auf uns warten ... Nein, falsch, er sagte, er werde auf Herrn Os warten. Und wir sind {F#Heldinnen}{M#Helden}, die zufällig hier sind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830699
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830699,
					"content": "Jedenfalls hat er nicht einmal die Tür für uns offengelassen. Was für ein unhöflicher Kerl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830642,
					"content": "Das Initium Iani ...? Hmpf, auch wenn hier einiges an Blendwerk zum Einsatz kommt, ist sie doch nichts als eine Steintür, die vorgibt, geheimnisvoll zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830643
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830643,
					"content": "Obwohl ich meiner körperlichen Hülle beraubt bin, ist es immer noch ein Leichtes, euch kleine Wesen hinüberzugeleiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830648
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830648,
					"content": "Passt gut auf, ihr kleinen Wesen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830644
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830644,
					"content": "Oooh! Du bist aber ganz schön zuverlässig, Großer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830649
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830649,
					"content": "Jetzt gilt es nur noch, diese sichtbar gewordenen Siegel eins nach dem anderen zu zerschlagen ... dann sind wir startklar. Wenn ihr so weit seid, machen wir uns auf den Weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830645
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830645,
					"content": "Also, Herr Os, bist du bereit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830646,
					"content": "Nun, da wir schon hier sind, können wir nur voranschreiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830647
					],
					"speakerTitle": "Herr Os"
				},
				{
					"id": 741830647,
					"content": "#Jawohl! Und, {NICKNAME}, bist du auch bereit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830619,
					"content": "Ist er auch verrückt geworden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830620
					]
				}
			]
		},
