				"points": []
			},
			"dialogs": [
				{
					"id": 708250601,
					"content": "Wie ist dein Fortschritt? Bist du schon fertig damit, das Gebiet zu säubern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250602
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250602,
					"content": "Alles erledigt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250603
					]
				},
				{
					"id": 708250603,
					"content": "Fantastisch. Du bist eine enorme Hilfe. Wer weiß, wie viel länger diese hässlichen Dinge sonst hier gestanden hätten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250604
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250604,
					"content": "Ehrenritter, akzeptiere dies bitte als Ausdruck meiner Dankbarkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		}
	]
