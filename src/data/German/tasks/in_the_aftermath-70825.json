			"dialogs": [
				{
					"id": 708250401,
					"content": "*seufz* Wenn wir doch nur ein paar weitere Leute zur Verfügung hätten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250402,
						708250406
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250402,
					"content": "Was machen die anderen Ritter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250403
					]
				},
				{
					"id": 708250403,
					"content": "Die Verteidigung der Stadt aufrecht erhalten, mit dem Wiederaufbau helfen und eine ganze Reihe von anderen Aufgaben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250404
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250404,
					"content": "Jeder einzelne Ritter von uns ertrinkt in Arbeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250405
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250405,
					"content": "Zum ersten Mal ist der Wachdienst am Haupttor die vergleichsweise einfachste Aufgabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250406,
					"content": "Du könntest Hilfe von der Abenteurergilde anfordern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250407
					]
				},
				{
					"id": 708250407,
					"content": "Wir sind tatsächlich glücklich, ihre Hilfe von Beginn an gehabt zu haben. Zunächst haben sie dabei geholfen, Opfer in der Stadt zu finden und zu retten. In letzter Zeit haben sie angefangen, die Aktivitäten der Monster weiter draußen zu beobachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250408
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250408,
					"content": "Als die Monster damit begonnen haben, sich in der Nähe der Stadt zu sammeln, lag es an den Abenteurern, die früh Aufklärungsarbeit geleistet und an uns Bericht erstattet haben, dass wir besondere und effektive Pläne für die Verteidigungsbemühungen benötigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250409
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250409,
					"content": "Sogar jetzt arbeiten sie hart daran, all unsere Bemühungen, um die Stadt wieder auf die Beine zu stellen. Ohne sie würden die Ritter ehrlichgesagt bereits unter der Last zusammenbrechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250410
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250410,
					"content": "Ich muss Zeit finden, um Cyrus richtig zu danken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 7082506,
