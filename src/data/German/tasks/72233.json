				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330401,
					"content": "#{NICKNAME}, was möchtest du noch fragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330402,
						722330406
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330402,
					"content": "Über die Schlüsselmuster ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330403
					]
				},
				{
					"id": 722330403,
					"content": "Die Schlüsselmuster befinden sich an der „Flosse von Watatsumi“ und dem „Herzen von Watatsumi“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330404
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330404,
					"content": "In der Tat sind wir gerade ein wenig näher herangekommen. Immerhin sind die beiden Schreine noch relativ versteckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330405
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330405,
					"content": "Ich gebe mein Bestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330406,
					"content": "Über den Altar ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330407
					]
				},
				{
					"id": 722330407,
					"content": "Die Altare befinden sich im Norden und im Osten. Sie befinden sich an der zweiten Wand des Berges unterhalb der mondbeschienenen Tiefe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330408
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330408,
					"content": "Wenn du die beiden Linien von Sangonomiya zu der Flosse und dem Herzen von Watatsumi nimmst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330409
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330409,
					"content": "Nimm zwei weitere Schnittpunkte mit dem Bogen des Mondbadeabgrunds. Das sind die beiden Punkte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
