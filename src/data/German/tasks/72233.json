			},
			"dialogs": [
				{
					"id": 722330101,
					"content": "#Hallo, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330102
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330102,
					"content": "Wie bereitest du dich auf die Korallenbergung vor, Tsuyuko?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330103,
					"content": "Leider ist die Situation noch so schwierig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330104
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330104,
					"content": "Obwohl du traurig dreinschaust, Tsuyuko ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330105,
					"content": "Aber es war zu aufschlussreich, um uns weiterhin zuzuzwinkern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330106,
					"content": "Oooh, natürlich habt ihr herausgefunden, dass die Situation auch kritisch ist. Dann werde ich es nicht verbergen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330107
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330107,
					"content": "Du versuchst nicht einmal, es zu verbergen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330108,
					"content": "Obwohl der „Schlüssel zur mondbeschienenen Tiefe“ zunächst beschaffen wurde und Enkanomiya langsam erwacht, kommen die Ermittlungen wegen des Mangels an Arbeitskräften nur langsam voran. Aufgrund des Personalmangels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330109
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330109,
					"content": "Schließlich ist es immer noch eine besondere Zeit und ich weiß nicht, ob die Beziehungen zu Narukami entspannt werden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330110
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330110,
					"content": "Nun, einer mehr oder weniger ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330111
					]
				},
				{
					"id": 722330111,
					"content": "Das ist nicht dasselbe. Traditionell ist die Person, die am meisten gebraucht wird, um die Koralle zu holen, ein sogenannter Recke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330112
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330112,
					"content": "Baut zunächst einen Stützpunkt auf, helft dann dem Recken, die Spuren ihrer Vorfahren zu erkunden, und nehmt schließlich die Prüfungen auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330113
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330113,
					"content": "So viel zur sogenannten Strategie der Stetigkeit und Beständigkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330114
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330114,
					"content": "Aber wegen des Personalmangels in letzter Zeit gibt es keine Möglichkeit zu erkunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330115,
					"content": "Genau das ist geschehen und der entscheidende „Recke“ ist nicht einmal mehr um Haaresbreite zu erkennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330116
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330116,
					"content": "Ich glaube, ich sehe es jetzt. Es scheint eine Strähne zu sein ... eine Strähne blonden Haares!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330117
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330117,
					"content": "Oooh, das klingt nach einer Menge Ärger. Paimon möchte nicht in dieses Chaos verwickelt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330118,
					"content": "Doch die Erkundung führt in der Regel zur Entdeckung einiger exotischer Schätze. Es ist üblich, sie der Sangonomiya-Familie zu überlassen, wenn man sie bekommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330119
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330119,
					"content": "Wenn du runtergehst und diesmal etwas findest, ist es nicht unmöglich, ein Auge zuzudrücken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330120,
						722330121
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330120,
					"content": "Vielleicht beide Augen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				},
				{
					"id": 722330122,
					"content": "Krieger, Held, Retter! Du bist also einverstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330123
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330123,
					"content": "Wie können wir vor den Gefahren von Sangonomiya die Augen verschließen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330124,
					"content": "Du hast vollkommen recht. Es scheint, dass du die Menschen tatsächlich nach den von Kokomi gelehrten Worten überreden kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330125
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330125,
					"content": "Ihre Exzellenz hat mir sogar vorausgesagt, dass du zu mir zurückkommen würdest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330126
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330126,
					"content": "Wie bitte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330127,
					"content": "Nichts, nichts. Dann kommt mit mir und ich werde euch etwas zeigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330128
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330128,
					"content": "Wir treffen uns gleich da vorn am Altar. Wenn du es nicht siehst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330129
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330129,
					"content": "Wenn du es nicht siehst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330130,
					"content": "Es ist im Südosten, mache die Augen klein und du siehst es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330121,
					"content": "Ich bin mit Kokomi befreundet!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				}
			]
		},
		{
			"id": 7223302,
			"completionStepIds": [
				7223303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223302",
