						],
						"stepId": 7223302,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223303",
							"2"
						],
						"stepId": 7223303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsuyuko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330201,
					"content": "Dies ist das so genannte „Schlüsselmuster“, das einst das Abzeichen von Enkanomiya war. Es erscheint nur auf dem Boden, wenn der Weg offen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330202
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330202,
					"content": "Es soll sich um einen weiteren Schlüsselsatz handeln, der den Bewohnern von Watatsumi zur Zeit der Erweckung von Enkanomiya ausgehändigt wurde. Und in den Aufzeichnungen von Sangonomiya finden sich fünf solcher Schlüsselmuster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330203
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330203,
					"content": "Derzeit befinden sich drei von ihnen auf Watatsumi, die wir finden. Sie können wieder an ihren Platz zurückgebracht und freigegeben werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330204
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330204,
					"content": "Diese drei haben wir vorhin extra aus dem Schlüsselloch gezogen und an anderer Stelle in Watatsumi platziert. Dadurch kann die Barriere wieder in Kraft treten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330205
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330205,
					"content": "Damit soll verhindert werden, dass sich Leute wie freche Kinder, die Spione der Fatui, die Narukami-Bewohner und Fremde dorthinschleichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330206
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330206,
					"content": "Natürlich gehörst du nicht mehr zu den Fremden. Hahahaha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330207
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330207,
					"content": "Zu diesem Zeitpunkt gibt es keine Möglichkeit, mit der Abenteurergilde in Kontakt zu treten, sodass keiner der Abenteurer die Möglichkeit hat, sich zu melden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330208
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330208,
					"content": "Lasst ihr Abenteurer runter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330209,
					"content": "Das ist historisch belegt, eine Partnerschaft, von der alle Seiten profitieren. Schließlich ist die Erkundung ihre und deine Stärke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330210
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330210,
					"content": "Na ja, das heißt, es gibt diesmal niemanden, der uns die Lorbeeren stiehlt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330211,
					"content": "Achte auf deine Manieren ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330212
					]
				},
				{
					"id": 722330212,
					"content": "Wie soll ich es sagen ... diese temporäre Schutzbarriere ist ziemlich unzuverlässig. Da die Zeit zwischen der Untersuchung des Ortes der Schlüsselmuster und ihrer Entfernung so lange gedauert hat, sind in dieser Zeit möglicherweise einige Personen abgerutscht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330213
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330213,
					"content": "Schließlich gibt es nicht genug Leute ... Wenn du also dort unten auf Fatui, Schatzräuber oder Kairagi triffst, zögere nicht, ihnen eine ordentliche Tracht Prügel zu verpassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330214
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330214,
					"content": "Wenn sie so einfach hinuntergegangen sind, was war dann der Zweck des Schlüssels, den wir vorher bekommen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330215,
					"content": "Nur wenn du den Schlüssel zur mondbeschienenen Tiefe nimmst, wird Enkanomiya erwachen. Das System funktioniert nur, wenn du die Tür mit dem „Schlüssel zur mondbeschienenen Tiefe“ öffnest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330216
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330216,
					"content": "Wäre ich nicht wegen Watatsumi Goryou Matsuri nach Enkanomiya hinuntergegangen, hätte ich mich vielleicht tatsächlich durch die bösen Wege der äußeren Welt einschleichen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330217
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330217,
					"content": "Ich hoffe also, dass ihr bald losziehen werdet und bitte euch, die anderen „Schlüsselmuster“ aus Watatsumi zu holen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330218
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330218,
					"content": "Die Schlüsselmuster befinden sich an der „Flosse von Watatsumi“ und dem „Herzen von Watatsumi“. Die beiden Altäre befinden sich in der Linie zwischen ihnen und Sangonomiya, an der zweiten Bergwand der mondbeschienenen Tiefe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330219
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330219,
					"content": "Ich werde dann an meinen gewohnten Platz zurückkehren und auf deine Nachricht warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
		{
			"id": 7223303,
			"completionStepIds": [
				7223308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223317",
							"3"
						],
						"stepId": 7223317,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223308",
							"2"
						],
						"stepId": 7223308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsuyuko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330301,
					"content": "Der nächste Moment ist der Moment der Entsiegelung. Bitte nimm den „Schlüssel zur mondbeschienenen Tiefe“ von vorher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330302
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330302,
					"content": "Kannst du das nochmal wiederholen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330303,
					"content": "„Schlüssel zur mondbeschienenen Tiefe.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330304
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330304,
					"content": "Kannst du das noch dreimal wiederholen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330305,
					"content": "Schlüssel zur mondbeschienenen Tiefe, Schlüssel zur mondbeschienenen Tiefe, Schüssel zur mondbeschiss... Mensch! Das ist ein echter Zungenbrecher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330306
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330306,
					"content": "Es muss also etwas mit der Namensgebung nicht stimmen. Ändert den Namen doch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330307,
					"content": "Selbst wenn du es ändern willst, wird es den Menschen in Hunderten von Jahren zugutekommen. Nimm es dieses Mal einfach hin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330308
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330308,
					"content": "Wie dem auch sei, ich bin dabei, das Ritual durchzuführen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330309
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330309,
					"content": "Leider haben wir keine genauen Angaben zu Enkanomiya, sodass du dich selbst um den Rest kümmern musst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330310
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330310,
					"content": "Diese Tradition, das Geheimnis am Leben zu erhalten, ist eine wirklich schlechte Sache. Ich kann dir also auch hier nur Glück wünschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330311
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330311,
					"content": "Und bitte spiel nicht den Helden. Deine Sicherheit ist von äußerster Wichtigkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
