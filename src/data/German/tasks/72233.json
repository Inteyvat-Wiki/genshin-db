			"dialogs": [
				{
					"id": 722330501,
					"content": "#{NICKNAME}, was möchtest du noch fragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330502
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330502,
					"content": "Über Byakuyakoku...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330503
					]
				},
				{
					"id": 722330503,
					"content": "Der Name von Enkanomiya lautete einst „Byakuyakoku“. Der Grund dafür ist, dass es im unterirdischen Reich weder Sonne noch Mond gibt, sondern nur die beiden Himmelserscheinungen der Hellen Nacht und der Ewigen Nacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330504
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330504,
					"content": "In meiner Familie gab es eine Schreinjungfer namens Eboshi, die in der Geschichte des Byakuyakoku eine wichtige Rolle spielte, und deshalb wurde ich mit der Leitung des „Watatsumi Goryou Matsuri“ beauftragt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		}
	]
}