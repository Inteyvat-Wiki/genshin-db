				{
					"id": 700081401,
					"content": "Wie ist es gelaufen? Haben es einige Leute probiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081402
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081402,
					"content": "Oh, das war kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081403
					]
				},
				{
					"id": 700081403,
					"content": "Sich beim Fest einen hinter die Binde kippen, was ... Kein Wunder, dass die Engelsgabe so viele Gäste hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081404
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081404,
					"content": "Trotzdem sollte es passen. Schließlich haben die Kinder und die Stadtwache nicht vor, sich zu betrinken. Sie werden beim Fest Freude daran haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081405
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081405,
					"content": "Ich werde den Geschmack weiter verfeinern. Danke übrigens für deine Hilfe. Hier ist eine kleine Aufmerksamkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081406
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081406,
					"content": "Ah, und ein fröhliches Windblumenfest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		},
