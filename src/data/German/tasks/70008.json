			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Margaret"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700080101,
					"content": "Wir müssen uns wohl doch eine neue Spezialmischung einfallen lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080102
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080102,
					"content": "Gibt es ein Problem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080103
					]
				},
				{
					"id": 700080103,
					"content": "Oh, du bist es. Ich überlege nur, ein besonderes Getränk passend zum Windblumenfest auf den Markt zu bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080104
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080104,
					"content": "Alle werden sich in der Stadt amüsieren, da wäre es nicht unangebracht, für das leibliche Wohl zu sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080105
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080105,
					"content": "Doch werden nur alkoholische Getränke angeboten, sind alle so schnell berauscht, dass die Ritter sie zur Ausnüchterung wegsperren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080106
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080106,
					"content": "Und wenn jeder eine Fahne hat, ruiniert das die Stimmung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080107
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080107,
					"content": "Wirklich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080108
					]
				},
				{
					"id": 700080108,
					"content": "Nun, manchen Leute gefällt diese vernebelte Feststimmung. Doch wenn sich während des Fests die Betrunkenen auf der Straße stapeln, hinterlässt das keinen guten Eindruck.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080109
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080109,
					"content": "Aus diesem Grund habe ich mir ein erfrischendes, nicht-alkoholisches Milchgetränk ausgedacht, das nach „Wind“ schmeckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080110
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080110,
					"content": "Um den Geschmack des „Windes“ zu betonen, glaube ich, dass wir auch zwei besondere Zutaten verwenden sollten, den Löwenzahn und die Windmühlenastern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080111
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080111,
					"content": "#Doch wenn ich ganz alleine die Zutaten beschaffe, nimmt das viel Zeit in Anspruch. {F#Reisende}{M#Reisender}, würdest du mir dabei helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080112,
						700080116
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080112,
					"content": "Ich kümmere mich um den Löwenzahn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080113
					]
				},
				{
					"id": 700080113,
					"content": "Vielen Dank. An der Sterngreifklippe soll ausgezeichneter Löwenzahn wachsen, bitte hol mir welchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080114
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080114,
					"content": "Ich werde meinerseits ein paar Windmühlenastern sammeln. Wir sehen uns hier wieder, sobald wir unsere entsprechenden Zutaten haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080115
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080115,
					"content": "Dann bereiten wir das Getränk zu, damit ein paar Leute es vorher ausprobieren können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080116,
					"content": "Ich besorge die Windmühlenastern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080117
					]
				},
				{
					"id": 700080117,
					"content": "Ich zähle also auf dich! Die Windmühlenastern vom Windstieg sind von sehr guter Qualität, also versuche bitte, dort welche zu sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080118
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080118,
					"content": "Ich werde meinerseits ein paar Löwenzahnsamen sammeln gehen und wir sehen uns hier wieder, wenn wir mit dem Sammeln unserer entsprechenden Zutaten fertig sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080119
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080119,
					"content": "Dann bereiten wir das Getränk zu, damit ein paar Leute es vorher ausprobieren können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		},
