					"id": 700081301,
					"content": "Willst du mit mir spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081302
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 700081302,
					"content": "Hallöchen, bei Zum Katzenschwanz gibt es ein neues Getränk ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081303
					]
				},
				{
					"id": 700081303,
					"content": "Zum Katzenschwanz ... Tante Grace meint, Kinder dürfen keinen Alkohol trinken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081304
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 700081304,
					"content": "Oh, da ist kein Alkohol drin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081305
					]
				},
				{
					"id": 700081305,
					"content": "Wirklich? Dann probiere ich es ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081306
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 700081306,
					"content": "Das ist wirklich schön! Das ist süß und kühl! Ist das ein neues Getränk von Zum Katzenschwanz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081307
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 700081307,
					"content": "Ich gebe auch Timmie und Lily Bescheid! Die hätten bestimmt auch gerne was davon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				}
			]
		},
