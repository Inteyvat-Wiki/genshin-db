			},
			"dialogs": [
				{
					"id": 700081201,
					"content": "Hallo, kann ich helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081202
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700081202,
					"content": "Hallöchen, bei Zum Katzenschwanz gibt es ein neues Getränk ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081203
					]
				},
				{
					"id": 700081203,
					"content": "Verzeihung, aber ich bin gerade im Dienst. Ich darf nichts trinken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081204
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700081204,
					"content": "Es ist alkoholfrei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081205
					]
				},
				{
					"id": 700081205,
					"content": "Ach ja? Nun ... wenn das so ist. Ich verspüre leichten Durst, also nehme ich einen Schluck ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081206
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700081206,
					"content": "Oh! Das schmeckt lecker. Und erfrischend ist es auch. Das haucht einem neue Lebensgeister ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081207
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700081207,
					"content": "Das ist ein neues Getränk von Zum Katzenschwanz, oder? Ich werde bei nächster Gelegenheit mal hingehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
				}
			]
		},
