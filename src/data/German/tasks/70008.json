			"dialogs": [
				{
					"id": 700081101,
					"content": "*seufz* Ohne ordentliches Gesöff ist so ein Fest einfach nicht das Wahre ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081102
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081102,
					"content": "Hallöchen, bei Zum Katzenschwanz gibt es ein neues Getränk ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081103
					]
				},
				{
					"id": 700081103,
					"content": "Oh, soll ich es ausprobieren? Hahaha! Überhaupt kein Problem! Was alkoholhaltige Getränke angeht, kenne ich mich aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081104
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081104,
					"content": "Das soll ich probieren ... wie? Man ... schmeckt gar keinen Alkohol. Schmeckt eher wie ein Milchgetränk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081105
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081105,
					"content": "Versteh mich nicht falsch, es schmeckt gut, aber ein alkoholfreies Getränk passt nicht wirklich zum Fest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081106
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081106,
					"content": "Viele Leute kommen hierher, um sich beim Windblumenfest einen hinter die Binde zu kippen. So ein Getränk würde nicht auf allzu viel Gegenliebe stoßen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
		{
			"id": 7000812,
