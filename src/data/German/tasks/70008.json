					"content": "Das perfekte Getränk fürs Windblumenfest. Es war richtig, sich an dich zu wenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081506
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081506,
					"content": "#Als Nächstes sollte es getestet werden. {F#Reisende}{M#Reisender}, würdest du noch einmal nach ein paar Freiwilligen Ausschau halten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081507
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081507,
					"content": "Ich kümmere mich drum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081508
					]
				},
				{
					"id": 700081508,
					"content": "Ich verlasse mich auf dich. Bei der Statue des Windgottes ist viel los. Dort solltest du einige Freiwillige finden.",
					"roleType": "TALK_ROLE_NPC",
