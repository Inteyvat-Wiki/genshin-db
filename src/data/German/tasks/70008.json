					"content": "Das sind sehr schöne Windmühlenastern. Wie sie wohl zum Geschmack beitragen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		},
		{
			"id": 7000838,
			"completionStepIds": [
				7000815,
				7000817
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Margaret"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700083801,
					"content": "Gut, wir haben alle nötigen Zutaten. Beginnen wir mit der Zubereitung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083802
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083802,
					"content": "Wie es wohl schmecken wird ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700083803
					]
				},
				{
					"id": 700083803,
					"content": "Oh, du willst es ebenfalls versuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083804
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083804,
					"content": "Nun ... die Zubereitung ist nicht sonderlich aufwendig. Du musst lediglich meine Schritte befolgen, dann sollte es ein durchschlagender Erfolg sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083805
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083805,
					"content": "#Willst du es selbst ausprobieren, {F#Reisende}{M#Reisender}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083806
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083806,
					"content": "Klar, ich versuche es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700083807
					]
				},
				{
					"id": 700083807,
					"content": "Prima. Dann werde ich dir die Zubereitung erklären. Präg dir die Schritte gut ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083808
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083808,
					"content": "Zuerst musst du eine <color=#00E1FFFF>Zuckerblume</color> einsetzen, bevor du den Alkohol, den wir für dieses Getränk verwenden, eingießen kannst ... und dann träufeln wir natürlich etwas <color=#00E1FFFF>Milch</color> hinein und legen damit den Grundstein für die klare, süße Textur, die wir haben wollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083809
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083809,
					"content": "Wir müssen jetzt die <color=#00E1FFFF>Windmühlenaster</color> hinzufügen, um den Geschmack zu verstärken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083810
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083810,
					"content": "Überstürze das Mischen nicht. <color=#00E1FFFF>Warte</color> einen Moment und lass den blumigen Duft entstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083811
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083811,
					"content": "Streue dann die <color=#00E1FFFF>Löwenzahnsamen</color> hinzu, damit das Getränk aussieht, als sei es mit Sternen verziert worden. Dann gibst du ein paar <color=#00E1FFFF>Eiswürfel</color> hinzu und fertig ist das Getränk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083812
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083812,
					"content": "Und so funktioniert es. Soll es köstlich werden, darfst du die Schritte nicht durcheinanderbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083813
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083813,
					"content": "Wenn du dir alles gemerkt hast, probiere es aus. Hast du es vergessen, frag mich ruhig ein zweites Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		},
