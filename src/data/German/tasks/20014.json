			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony",
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200140101,
					"content": "Anna, denk darüber nach. Ich denke, wir müssen uns die Sache genau ansehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140102,
					"content": "Oh, mach dir keine Sorgen um mich, ich komme schon klar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140103,
						200140104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140103,
					"content": "Anna, geht es dir gut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				},
				{
					"id": 200140105,
					"content": "#{F#Reisende}{M#Reisender}! Du kommst gerade rechtzeitig. Hilf mir, Anna zu überzeugen. Sie will eine Abenteurerin werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140106,
					"content": "Warum kann ich keine Abenteurerin sein? Ich bin gesund und Onkel Cyrus sagt, ich sei klug und fit genug, um eine Abenteurerin zu sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140107,
					"content": "Wie lange geht es dir schon gut? Was ist, wenn du als Abenteurerin losziehst und wieder krank wirst? Außerdem würden Mama und Papa das nicht gutheißen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140108,
					"content": "Ich habe mit Mama und Papa gesprochen und sie haben gesagt, dass sie damit einverstanden wären, dass ich Abenteurerin werde, wenn ich die Prüfungen der Abenteurergilde bestehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140109,
					"content": "Was?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140110,
						200140111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140110,
					"content": "Beruhige dich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140112,
					"content": "Onkel Cyrus hat mir vor ein paar Tagen mit einem Trainingsplan geholfen und ich trainiere jetzt seit ein paar Tagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140113
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140113,
					"content": "Aber in diesen Plänen ging es nur um das Auskundschaften, das Finden von Notnahrung, das Überleben in der Wildnis und so weiter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140114,
					"content": "Aber ich habe gehört, dass Abenteurer auch oft in der Wildnis gegen diese Monster kämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140115
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140115,
					"content": "Ich würde das gern lernen, aber ich finde niemanden, der es mir beibringen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140116,
					"content": "Und mein Bruder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140117
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140117,
					"content": "Nein, natürlich nicht! Diese Monster sind gefährlich, und selbst wenn du dich auf den Weg machst, solltest du einen erfahrenen Abenteurer dabei haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140118,
					"content": "Habe ich mich nicht schon einmal an Jack gewandt? Er hat es mir versprochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140119
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140119,
					"content": "Es ist nicht so, dass ich diesen Kerl nicht kenne, diesen Jack ... Er kann sich nicht einmal in der Wildnis um sich selbst kümmern. Wie soll er sich da um dich kümmern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140120,
					"content": "Ich kann in der Gilde für eine Weile keine erfahrenen Abenteurer finden und ich kann es mir nicht leisten, eine Provision zu zahlen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140121,
						200140122
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140121,
					"content": "Ich gehe mit dir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140123,
					"content": "Was? Möchtest du mir helfen? Großartig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140124
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140124,
					"content": "Bruder, jetzt musst du dir keine Sorgen mehr machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140125
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140125,
					"content": "Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140126
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140126,
					"content": "#Na ja, wir haben {F#die Ehrenritterin}{M#den Ehrenritter} ... Dann wird das sicherlich was werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140127
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140127,
					"content": "Aber! Du solltest auch vorsichtig sein, wenn du in die Wildnis gehst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140128
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140128,
					"content": "... Das ist alles, erinnerst du dich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140129
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140129,
					"content": "Jaaaa ... du nervst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140130
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140130,
					"content": "#{F#Reisende}{M#Reisender}, lass uns aufbrechen, ich habe Jack nach dem Standort des Lagers gefragt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140122,
					"content": "Ich habe einige Kenntnisse im Kampf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140111,
					"content": "Wie läuft dein Training?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140104,
					"content": "Anthony, was macht ihr?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				}
			]
		},
