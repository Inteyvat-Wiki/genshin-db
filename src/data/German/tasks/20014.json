			"dialogs": [
				{
					"id": 200140201,
					"content": "Diese Monster ... Sie wurden alle besiegt. Stark.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140202,
					"content": "Das Abenteuerbuch hat recht, es gibt verschiedene Möglichkeiten, die Monster zu besiegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140203
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140203,
					"content": "Aber ... um ehrlich zu sein, macht es mir immer noch ein wenig Angst, diesen Monstern so nahe zu sein ... Zum Glück habe ich dich bei mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140204,
					"content": "Du musst noch mehr trainieren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140205
					]
				},
				{
					"id": 200140205,
					"content": "Nun, ich weiß. Es ist nicht leicht, ein Abenteurer zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140206
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140206,
					"content": "#Danke, {F#Reisende}{M#Reisender}, ich gehe zurück in die Stadt. Mein Bruder wird wieder nervös werden, weil ich so lange weg war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140207
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140207,
					"content": "Ich werde mich in Zukunft ein bisschen mehr anstrengen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
