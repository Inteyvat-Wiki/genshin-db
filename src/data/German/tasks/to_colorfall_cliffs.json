			"dialogs": [
				{
					"id": 150400101,
					"content": "Da sind wir! Das müssen also die auf der Karte eingezeichneten „Schaumblumenfelder“ sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400102
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400102,
					"content": "Warum ist alles so ... grün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400103,
					"content": "Für mich sehen sie eher nach Schaumgrasfeldern aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400104
					]
				},
				{
					"id": 150400104,
					"content": "Haha, nicht gerade das, was ich mir vorgestellt habe ... Aber das passiert ziemlich oft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400105
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400105,
					"content": "Du meinst, wenn die Vermarktung der Orte besser klingt, als sie tatsächlich sind? So wie ich das sehe, hat das bereits ein Niveau erreicht, bei dem ich eine Beschwerde in Betracht ziehen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400106
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400106,
					"content": "Außerdem würden sich meine Gäste über mich beschweren, wenn ich das nicht täte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400107,
					"content": "Nein, nein. Tut mir leid, ich habe mich nicht klar genug ausgedrückt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400108
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400108,
					"content": "Ich meinte die Diskrepanz zwischen meinen Erwartungen und der Realität. Normalerweise sehen die Dinge am Ende anders aus, als ich sie mir vorgestellt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400109
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400109,
					"content": "Bedeutet das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400110,
					"content": "Es ist, als würde man auf den Gipfel eines Berges klettern, um die Aussicht zu genießen, und dann zieht ein dichter Nebel auf, so dicht, dass man nicht einmal den Weg nach unten sehen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400111
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400111,
					"content": "Oder wenn man zu seinem Zelt zurückkehrt und feststellt, dass sich ein Pyro-Schleim eingeschlichen hat und das ganze Feuerholz, das man gerade gesammelt hat, in Brand gesetzt hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400112
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400112,
					"content": "Das klingt ziemlich hart ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400113,
					"content": "Um ehrlich zu sein, habe ich mich inzwischen daran gewöhnt. Nur die üblichen Unebenheiten auf dem Weg eines Abenteuers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400114
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400114,
					"content": "Wenn man bedenkt, dass wir diese weite, offene Landschaft genießen können, überall frische Luft und keine Monster in Sicht ... würde ich sagen, dass wir schon ziemlich viel Glück haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400115
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400115,
					"content": "Ich würde sagen, das größte Glück ist deine Fähigkeit, so optimistisch zu bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400116
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400116,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400117
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400117,
					"content": "Glaubst du, der Asha ist an etwas dran? Es hörte sich so an, als ob er genau das sagen wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400118
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400118,
					"content": "Mensch, ihr könnt euch schon verstehen? Ihr zwei seid ja wie ein Ei dem anderen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400119,
					"content": "(Du liest zu Ende.)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150400120
					]
				},
				{
					"id": 150400120,
					"content": "Also, das sind zwei Erzfeinde, wenn es je welche gab ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400121,
					"content": "Wenn beide Menschen wären, könnten sie sich vielleicht zusammensetzen und darüber reden ... Aber eine ist ein Asha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400122
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400122,
					"content": "Komm schon, reichen wir ihnen eine Hand! Bist du bereit, Asha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400123
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400123,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400124
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400124,
					"content": "Hm, hat Paimon etwas verpasst? Wie kommt es, dass wir plötzlich direkt in den Aktionsmodus übergehen? Was wollt ihr denn machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400125,
					"content": "Es ist nicht schwer zu erraten, was die Asha am liebsten tun. Sie färben wohl Dinge in verschiedenen Farben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400126
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400126,
					"content": "Nun, da hast du bestimmt nicht unrecht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400127,
					"content": "Und sie sind einfache Wesen mit reinem Herzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400128
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400128,
					"content": "Ich bezweifle, dass er absichtlich hier ist, um Ärger zu machen. Wahrscheinlich kann er einfach nicht ertragen, wie langweilig und einfallslos all dieses einfache Gras aussieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400129
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400129,
					"content": "Ja, und die beiden können nicht miteinander kommunizieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400130
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400130,
					"content": "Genau! Wenn wir also dabei helfen können, die Wiese in einer Reihe von leuchtenden Farben zu färben, etwas, das den Erwartungen aller entspricht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400131
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400131,
					"content": "... Dann können wir uns vielleicht die Anerkennung dieser künstlerischen Asha verdienen, während wir gleichzeitig diesem Mitarbeiter helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400132
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400132,
					"content": "Das ist genau das, was ich gedacht habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400133
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400133,
					"content": "Keine schlechte Idee. Du wärst ein vielversprechender Friedensstifter, weißt du das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400134
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400134,
					"content": "Ich bin dabei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400135
					]
				},
				{
					"id": 150400135,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400136
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400136,
					"content": "Haha, das kitzelt ... Hör auf ...! Moment mal, wo gehen wir denn hin? Ist es weit? Ich sollte zuerst meinen Freunden Bescheid sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400137
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400137,
					"content": "He, wohin geht ihr denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400138,
					"content": "Also, Frau Dolmetscherin, hast du das verstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400139,
					"content": "Vielleicht sollen wir etwas transportieren? Oder es ist noch jemand in der Nähe, der unsere Hilfe noch dringender braucht ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400140
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400140,
					"content": "Diese beiden Dinge scheinen überhaupt nichts miteinander zu tun zu haben! Und außerdem, wie hast du das überhaupt herausgefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400141
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400141,
					"content": "Um ehrlich zu sein, je länger ich sie beobachte, desto mehr erinnert mich ihre Körpersprache an Saurier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400142
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400142,
					"content": "Hm ... Du nimmst mich nicht auf den Arm, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400143
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400143,
					"content": "Ich meine es ernst. In der Körpersprache der Saurier kann ein und dieselbe Bewegung oft verschiedene Bedeutungen haben. Wenn meine Saurier-Mutter ihre Flügel hob, bedeutete das entweder „Komm früh zum Abendessen nach Hause“ oder „Du steckst in großen Schwierigkeiten, Kind“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400144
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400144,
					"content": "Warte mal, woran erkennst du dann den Unterschied?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400145
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400145,
					"content": "Als ich klein war, konnte ich das nicht. An manchen Tagen eilte ich früh nach Hause, nur um direkt Prügel zu bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400146
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400146,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400147
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400147,
					"content": "Super stabil und dazu noch schnell ... Das ist also ein Heißluftballon aus Natlan? Der Wahnsinn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400148
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400148,
					"content": "Hallo zusammen, wir sind wieder da! Schnell, schaut in den Himmel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				}
			]
		},
