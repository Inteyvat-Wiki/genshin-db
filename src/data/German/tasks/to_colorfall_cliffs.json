			"dialogs": [
				{
					"id": 150400701,
					"content": "Gut, wir sind da. Dies, meine Damen und Herren, ist der „Asha in der Luft“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400702
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400702,
					"content": "Boah, das ist so toll! Ich hätte nicht erwartet, dass er aus der Nähe so riesig ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400703
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400703,
					"content": "Wenn er erst einmal bemalt ist, werden wir ihn schon von weitem sehen können, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400704
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400704,
					"content": "Ganz sicher! Solange du dich in einem offenen Bereich befindest und die Aussicht nicht durch Berge versperrt ist, kannst du ihn von überall aus sehen – sei es vom Dachpool auf dem Wusch-Wusch-Hügel oder von den Fjorden der Tete-Insel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400705
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400705,
					"content": "Das ist großartig! Ihre Arbeit wird im Mittelpunkt stehen! Ihr schafft das!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400706
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400706,
					"content": "Mann, ich bin schon ganz aufgeregt! Soll ich mich für meine Glücksfarbe entscheiden? Oder vielleicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400707
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400707,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400708
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400708,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400709
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400709,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400710
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400710,
					"content": "Oh, er hat wirklich eine Menge dazu zu sagen, was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400711,
					"content": "Chasca, hast du das alles mitbekommen? Könntest du das noch einmal für uns übersetzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400712,
					"content": "Hmm, das war eine Menge zu verarbeiten. Ich muss ein paar Zahlen ausrechnen, um herauszufinden, wie viele Möglichkeiten es gibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400713
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400713,
					"content": "#Schon gut, ich glaube, ich habe es! Asha will sich mit mir zusammentun und gegen {NICKNAME} antreten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400714
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400714,
					"content": "Er hilft gerne anderen Leuten, indem er mit seinen Freunden zusammenarbeitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400715
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400715,
					"content": "Aber es ist das Element des Wettbewerbs, das gewöhnliche Aktivitäten in aufregende Abenteuer verwandelt, und das ist es, was er am meisten genießt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400716
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400716,
					"content": "D... Das alles hat er wirklich gesagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400717,
					"content": "Haha, mehr oder weniger! Wahrscheinlich auch mit ein bisschen meiner eigenen Interpretation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400718
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400718,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400719
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400719,
					"content": "Seiner Reaktion nach zu urteilen, scheint es, dass du genau das Richtige gesagt hast. Die Bindung zwischen euch wird wirklich immer stärker ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400720
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400720,
					"content": "#In Ordnung, Asha. Mir gefällt deine Idee, aber wir sollten {NICKNAME} nicht unter Druck setzen, etwas zu tun, was {F#sie}{M#er} nicht will, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400721
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400721,
					"content": "Wir müssen auch die Gefühle und Meinungen unserer Freunde respektieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400722
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400722,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400723,
						150400726,
						150400729
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400723,
					"content": "Eine Chance, den Spitzenreiter herauszufordern – darauf habe ich gewartet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400724
					]
				},
				{
					"id": 150400724,
					"content": "„Dann nehme ich deine Herausforderung an.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400725
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400725,
					"content": "Haha ... Wenn du mich so ansiehst, kann ich das unmöglich mit ernster Miene sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400732,
					"content": "Also gut, wenn beide Truppen bereit sind, dann folgt mir! Ich werde eure Schiedsrichterin sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400726,
					"content": "Alles, was zählt, ist, dass Bennett und Asha glücklich sind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400727
					]
				},
				{
					"id": 150400727,
					"content": "#He, wir können nicht die Einzigen sein, die Spaß haben! Ich möchte, dass es dir auch Spaß macht, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400728
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400728,
					"content": "Komm schon, fangen wir an! Kein Druck, nur Spaß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400729,
					"content": "Selbst gegen alle fünf von euch würde ich immer noch gewinnen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400730
					]
				},
				{
					"id": 150400730,
					"content": "Du bist selbstbewusst, das steht fest! Na gut, dann gebe ich auch mein Bestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400731
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400731,
					"content": "He, Paimon war schon immer auf deiner Seite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "Paimon"
				}
			]
		},
