				]
			},
			"dialogs": [
				{
					"id": 150400301,
					"content": "Oh, das sieht unglaublich aus! Die Schaumblumenfelder machen ihrem Namen endlich alle Ehre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400302
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400302,
					"content": "Gute Arbeit, Leute! Jetzt müssen wir nur noch dem Mitarbeiter Bescheid geben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400303,
					"content": "Bitte, alle zusammen, wartet doch kurz ... *stöhn*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400304
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400304,
					"content": "Oh, und da ist sie auch schon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400305,
					"content": "Keine Eile. Atme erst einmal durch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400306
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400306,
					"content": "*Puh* ... Danke. Seid gegrüßt, ich bin die Mitarbeiterin, die für die Haupt-Herausforderung hier in den Farbfall-Klippen verantwortlich ist ... Die Herausforderung „Asha in der Luft“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400307
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400307,
					"content": "Gerade habe ich von oben herab gesehen, wie sich die Wiese plötzlich in ein Blumenmeer verwandelt hat. Und die Farben waren so kunstvoll, so überwältigend ... dass ich fast mein Fernglas fallen ließ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400308
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400308,
					"content": "I... Ihr seid wirklich die Retter der Farbfall-Klippen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400309
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400309,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400310
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400310,
					"content": "Das war gar nichts, hehe. Außerdem waren es die beiden, die die meiste Arbeit gemacht haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400311,
					"content": "Würdet ihr beide, liebe Abenteurer, an unserer Herausforderung teilnehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400312
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400312,
					"content": "Oder besser gesagt ... Würdet ihr uns die Ehre erweisen, auch etwas Farbe in unsere Wahrzeichen zu bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400313
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400313,
					"content": "Das klingt toll ... Aber bist du sicher, dass wir das tun dürfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400314
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400314,
					"content": "Aber natürlich! Ich würde mich sogar sehr freuen, wenn ihr ja sagen würdet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400315
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400315,
					"content": "Ihr habt meinem Kollegen so einen großen Gefallen getan, also ist es nur richtig, dass ich euch in seinem Namen danke. Und ich dachte mir, dass diese Erfahrung sogar noch besonderer ist als eine finanzielle Belohnung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400316
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400316,
					"content": "Ähm, nicht wirklich. Wir wollen lieber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400317,
					"content": "Was sie meint, ist, dass wir euch gerne helfen würden! Haha ... Also, wie kommen wir dahin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400318
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400318,
					"content": "Bitte, folgt mir. Wir nehmen den Heißluftballon nach oben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tikraq"
				}
			]
		},
