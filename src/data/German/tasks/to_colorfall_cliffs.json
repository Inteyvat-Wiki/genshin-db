			"dialogs": [
				{
					"id": 150400601,
					"content": "#Haha, das hat wirklich Spaß gemacht! Danke, {NICKNAME}, Asha und ich hatten eine tolle Zeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400602,
						150400603,
						150400604
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400602,
					"content": "Du hast einen beeindruckenden Rivalen abgegeben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400606
					]
				},
				{
					"id": 150400606,
					"content": "Gut gemacht, Leute!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400607
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400607,
					"content": "#Glückwunsch an {NICKNAME} für den Sieg und ein großes Dankeschön an unseren hilfsbereiten Retter und Asha für ihre hervorragende Zusammenarbeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400608
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400608,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400609
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400609,
					"content": "Als ich vorhin deine Interpretation der Worte des Ashas hörte, konnte ich es nicht ganz glauben. Aber nach diesem Spiel muss ich sagen, dass ich wirklich beeindruckt bin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400610
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400610,
					"content": "Ich fühle mich ganz genauso! Ich habe mit euch beiden mitgefiebert! Es fühlte sich an wie das Finale der Pilgerreise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400611
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400611,
					"content": "Ich verstehe dich. Als der Kampf seinen Höhepunkt erreicht hat, konnte ich dem Drang kaum widerstehen, hochzufliegen und selbst ein paar Kugeln abzufeuern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400612
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400612,
					"content": "Moment, kann man die Kugeln auch zum Bemalen von Dingen verwenden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400613
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400613,
					"content": "So etwas in der Art — die endgültige Farbe wäre allerdings unbekannt. Und ich könnte nicht garantieren, dass der Asha immer noch in der Luft bleiben würde, wenn ich damit fertig wäre ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400614
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400614,
					"content": "Ähm ... hehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400615,
					"content": "Haha! Wie auch immer, wir sind jetzt nur noch einen Schritt vom Abschluss von „Asha in der Luft“ entfernt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400616
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400616,
					"content": "Könnten unsere beiden Retter bitte die Pinsel von „Asha in der Luft“ anzünden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400617
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400617,
					"content": "(Wahrzeichen-Chronik des Ashas abspielen)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150400618
					]
				},
				{
					"id": 150400618,
					"content": "Sieht toll aus, oder? Ich kann einen Aussichtspunkt empfehlen, der sich perfekt für ein Gruppenfoto eignen würde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400603,
					"content": "Du und Asha seid eine hervorragende Truppe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400606
					]
				},
				{
					"id": 150400604,
					"content": "Ich hätte Paimon um Hilfe bitten sollen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400605
					]
				},
				{
					"id": 150400605,
					"content": "Oh, jetzt erinnerst du dich also an Paimon? Dafür ist es ein bisschen spät!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400606
					],
					"speakerTitle": "Paimon"
				}
			]
		},
