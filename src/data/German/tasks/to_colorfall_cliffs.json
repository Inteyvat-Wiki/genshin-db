			"dialogs": [
				{
					"id": 150401001,
					"content": "Also gut! Der „Asha in der Luft“ sieht toll aus und alle sind im Bild. Chasca, geh etwas näher in die Mitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401002
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150401002,
					"content": "Ich bin so aufgeregt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401003
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150401003,
					"content": "Sind alle bereit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401004
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150401004,
					"content": "He, du musst auch mit ins Bild!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150401005,
					"content": "Keine Sorge, ich brauche nur eine Sekunde! Gut, alle sind bereit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401006
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150401006,
					"content": "Drei, zwei, eins ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401007
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150401007,
					"content": "Asha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401008
					],
					"speakerTitle": "Paimon"
				},
				{
