				]
			},
			"dialogs": [
				{
					"id": 240210101,
					"content": "Autsch ... Warum ist die Kiste so schwer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210102
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210102,
					"content": "Alles in Ordnung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210103
					]
				},
				{
					"id": 240210103,
					"content": "#{M#Ehrenamtlicher Spitzenforscher}{F#Ehrenamtliche Spitzenforscherin}, es ist schön, dich wiederzusehen. Es tut mir so leid ... Ich ... Ich glaube, ich habe mir die Taille verletzt, es tut weh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210104
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210104,
					"content": "Ich wollte eine Kiste hierhertragen, um die Akten darin zu sortieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210105
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210105,
					"content": "Ich ... Ich habe nicht gedacht, dass die Kiste so schwer ist. Ich bin beim Hochheben nicht stehengeblieben, und so hat die ganze Last auf meine Taille gedrückt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210106
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210106,
					"content": "Jetzt ... habe ich das Gefühl, dass mir die Taille bricht, autsch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210107,
						240210108
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210107,
					"content": "Soll ich dich zum Arzt bringen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				},
				{
					"id": 240210109,
					"content": "Nein, nein ... Ich habe mir schon mal die Taille verzerrt. Ich muss mich nur etwas ausruhen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210110
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210110,
					"content": "Wie viele Akten sind darin eigentlich, damit sie so schwer ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240210111,
					"content": "Es sollten ... ganz schön viele Aktenbände sein, denke ich ... Das war das „Büroverfahren, bei dem Spuren hinterlassen werden müssen“, das früher im Forschungsinstitut einige Zeit lang propagiert wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210112
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210112,
					"content": "Kurz gesagt, in allen Forschungsangelegenheiten innerhalb des Instituts muss ein Bearbeitungsnachweis in Papierform hinterlassen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210113
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210113,
					"content": "Nach der Anordnung dieses Büroverfahrens verfünffachte sich der Papierverbrauch des gesamten Forschungsinstituts ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210114
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210114,
					"content": "Aufgrund der vielen Akten war jedes Büro sogar gezwungen, eine Stelle fürs „Sortieren der Akten“ einzurichten, um die Dokumente in verschiedene Kategorien zu sortieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210115
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210115,
					"content": "Das heißt, es muss alles auf Papier aufgeschrieben werden? Klingt nach einer Menge Aufwand ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240210116,
					"content": "Ja, das stimmt! Später verschwand dieses Büroverfahren nach und nach und wurde nur in geringem Umfang praktiziert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210117
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210117,
					"content": "#Lasst uns nicht mehr davon sprechen ... {M#Ehrenamtlicher Spitzenforscher}{F#Ehrenamtliche Spitzenforscherin}, könntest du mir bitte die Aktenkiste hierherbringen? Meine Taille schmerzt zwar, aber ich muss die Akten darin noch schnell sortieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210118,
						240210119
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210118,
					"content": "Gut, mach ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240210119,
					"content": "Ruh dich einfach ein wenig aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210120
					]
				},
				{
					"id": 240210120,
					"content": "Kein Problem, ich brauche nur meine Hände, um die Akten zu sortieren, nicht meine Taille. Mach dir keine Sorgen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210108,
					"content": "Ich kann jemanden herbeirufen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				}
			]
		},
