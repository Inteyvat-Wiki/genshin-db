			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400050501,
					"content": "Ich seh schon, die Menschen handeln in vollkommener Unbesonnenheit. Aber für mich ist das alles egal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050502
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050502,
					"content": "Aber nun bin ich hier. Ihr wolltet ja unbedingt, dass ich herkomme. Von hier aus kann man die Mingxiao-Laterne sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050503,
						400050504
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050503,
					"content": "Genau wegen der Mingxiao-Laterne wollten wir, dass Ihr kommt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050505
					]
				},
				{
					"id": 400050505,
					"content": "Du bist offensichtlich einer der Helden, um die es bei dem Fest geht ... Warum willst du nicht Teil davon sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050506,
					"content": "Ich kann mich den Menschen nicht nähern, diesen unbesorgten Menschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050507
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050507,
					"content": "Zu lange habe ich gelitten und getötet. Ich habe mich längst an dieses Leben gewöhnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050508
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050508,
					"content": "Belassen wir es dabei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050509
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050509,
					"content": "Lebt wohl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050510
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050510,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050511
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050511,
					"content": "Aber solltet ihr in Liyue auf Schwierigkeiten stoßen, die mit Dämonen und Geistern zu tun haben, ruft einfach meinen Namen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050512
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050512,
					"content": "Ob von euch oder von Liyue. Ich höre alle Schreie nach Hilfe, alle Gebete für Frieden und alle Wünsche, die von den Laternen getragen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050513
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050513,
					"content": "Tja, dann frohes neues Jahr!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050514
					]
				},
				{
					"id": 400050514,
					"content": "Frohes neues Jahr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050504,
					"content": "Wir wollten, dass Ihr das Laternenritual seht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050505
					]
				}
			]
		}
	]
}