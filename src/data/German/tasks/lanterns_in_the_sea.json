			},
			"dialogs": [
				{
					"id": 400050201,
					"content": "Ihr seid dann wohl von den Schatzräubern? Ich hatte doch klar und deutlich geschrieben, dass ihr euch verkleiden solltet. Dieses Treffen soll schließlich geheim bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050202
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050202,
					"content": "Und dennoch läuft einer von euch ganz offen ohne Verkleidung herum. Ihr habt wohl gar keine Angst. Das muss man euch schon lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050203
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050203,
					"content": "Püh! Wir müssen nicht wie du herumschleichen, weil wir es nicht nötig haben, uns hinter Masken zu verstecken! Wir haben uns nämlich nichts zu Schulden kommen lassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050204,
					"content": "He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050205,
						400050206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050205,
					"content": "Er hat aber vorher Bescheid gegeben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				},
				{
					"id": 400050207,
					"content": "Ihr seid gar nicht von den Schatzräubern! Wer seid ihr wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 400050206,
					"content": "Sieht ehrlich gesagt ganz fesch aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				}
			]
		},
		{
			"id": 4000504,
			"completionStepIds": [
				4000504
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000504",
							"2"
						],
						"stepId": 4000504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400050401,
					"content": "Jetzt sag uns, was du vorhast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050402,
					"content": "Gut, ich sag ja schon alles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050403
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050403,
					"content": "Wenn du nicht bald damit rausrückst ...Was? Du gibst schon auf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050404,
					"content": "Na ja, ich finde die Schatzräuber einfach klasse und will auch einer sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050405
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050405,
					"content": "Du willst auch einer sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050406,
					"content": "Ich bin noch vollkommen unerfahren und ganz allein. Ich sehe zu den Schatzräubern auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050407
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050407,
					"content": "Bitte langsam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050408,
					"content": "Deswegen wollte ich einen großen Coup landen, um mir einen Namen zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050409
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050409,
					"content": "Jetzt halt mal die Luft an! Das geht Paimon zu schnell!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050410,
					"content": "Das passt überhaupt nicht in das Bild, das Paimon sich von dem üblen Brandstifter mit den finsteren Plänen gemacht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050411,
					"content": "Brandstifter? Wovon sprichst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050412
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050412,
					"content": "Jetzt tu mal nicht so! Du hast dich immer wieder bei den leicht entzündlichen Materialien herumgetrieben. Sag nicht, du wolltest kein Feuer legen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050413,
					"content": "Ah, ich weiß, wovon du sprichst. Ich wollte mich doch nur genauer umsehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050414
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050414,
					"content": "Meine Pläne haben gar nichts mit diesen Baumaterialien zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050415
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050415,
					"content": "Red dich nicht raus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050416,
					"content": "Ich wollte doch einfach nur den größten Plaustrit seit zwanzig Jahren stehlen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050417
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050417,
					"content": "Mein Plan sah vor, nachts die Hälfte der Befestigungen zu lösen, damit er Richtung Meer treibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050418
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050418,
					"content": "Ach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050419,
					"content": "Dann hätte ich mir noch überlegt, wie ich ihn zur seichten Bucht im Wolkenmeer hätte bringen können. Das wäre doch das perfekte Verbrechen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050420
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050420,
					"content": "Wirklich gut hast du dir das aber nicht überlegt! Wie hättest du den Plaustrit denn zum Wasser gebracht, nachdem er schon in der Luft gewesen wäre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050421,
					"content": "Ich war doch noch beim Überlegen! Deswegen habe ich den Plan ja noch nicht ausgeführt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050422
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050422,
					"content": "Du bist wohl von allen guten Geistern verlassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050423,
					"content": "#Paimon findet, dass wir ihm eine Lektion erteilen sollten, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050424,
					"content": "Suchen wir den Herrn Yaksha auf und erzählen ihm, was wir herausgefunden haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4000505,
