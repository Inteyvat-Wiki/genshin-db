			"trigger": {
				"objectNames": [
					"Pervases"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030101,
					"content": "Die Geister weilen über Bergen und Flüssen, die Sterblichen schwingen ihre Papierfächer zu Genüssen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030102
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030102,
					"content": "Entschuldigung für die Unterbrechung, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030103,
					"content": "Wir würden gerne ein Weihrauchgefäß und sieben Lampen borgen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030104
					]
				},
				{
					"id": 111030104,
					"content": "So etwas hört man heutzutage nur noch selten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030105
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030105,
					"content": "Ihr wollt weder die Götter noch die Adepten anbeten. Stattdessen wollt ihr die Mittel der Anbetung selbst mitnehmen. Hahaha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030106
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030106,
					"content": "Es ist ungebührlich, das stimmt, doch wir brauchen sie nur kurz ... ehrlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030107,
					"content": "Dann braucht ihr sie wohl für das Traumfängerritual?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030108
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030108,
					"content": "Wa... Woher weißt du das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030109,
					"content": "Ich lebe schon länger in diesem Schrein, als ihr denkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030110
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030110,
					"content": "Mein treuer Glaube ermöglichte mir manch Einsicht in die Künste der Adepten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030111
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030111,
					"content": "Klingt überzeugend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030112,
					"content": "Aber das ist nicht so wichtig. Nehmt, was ihr braucht. Es freut mich, anderen von Nutzen sein zu können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030113
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030113,
					"content": "Sie werden hier ohnehin nicht vermisst werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030114,
						111030116
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030114,
					"content": "Bekümmert dich etwas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030115
					]
				},
				{
					"id": 111030115,
					"content": "Nein, mach dir keine Gedanken. Nehmt, was ihr wollt, und brecht auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030116,
					"content": "Nun ... Danke!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030117
					]
				},
				{
					"id": 111030117,
					"content": "Ist nicht wichtig. Nehmt, was ihr wollt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pervases"
				}
			]
		},
		{
			"id": 1110302,
			"completionStepIds": [
				1110317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110301",
							"2"
						],
						"stepId": 1110301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030201,
					"content": "Dieses Weihrauchgefäß sollte reichen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030202,
					"content": "Nun, wenigstens ist es nicht so schäbig wie dieser Schrein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030203,
					"content": "Jetzt brauchen wir nur noch die Sieben-Sterne-Lampen, oder? Die sind ganz in der Nähe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1110303,
			"completionStepIds": [
				1110303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110303",
							"2"
						],
						"stepId": 1110303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030301,
					"content": "Wie? Es ist keiner hier! Aber er war doch eben noch da ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030302,
					"content": "Und ich dachte, ihr würdet mit eurer Beute einfach verschwinden. Doch ihr habt euch tatsächlich gefragt, wo ich wohl abgeblieben bin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030330,
					"content": "Ah! Das ist die gleiche Stimme! Äh, Moment. W... Wo bist du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030303,
					"content": "Meine Form hat sich schon vor tausend Jahren aufgelöst. Was ihr eben gesehen habt, war nur eine Illusion der Adeptenkunst, bekannt als Nachklang des Lebens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030304,
					"content": "Da ihr die Sieben-Sterne-Lampen und das Weihrauchgefäß an euch genommen habt, ist meine Form natürlich nicht mehr sichtbar für euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030305,
						111030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030305,
					"content": "Du bist also ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030308
					]
				},
				{
					"id": 111030308,
					"content": "Ich gehörte einst zum Nachwuchs des Yaksha-Ordens, Rex Lapis persönlich verlieh mir den Namen Pervases. Doch ich war zu schwach und fiel in der Schlacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030309,
					"content": "Am Tag meines Todes war mein letzter Wunsch, das moderne Liyue zu erblicken, und so führte ich vermessen dieses Ritual durch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030310,
					"content": "Apropos ... ihr gehört zum Dämonenbändiger, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030311,
					"content": "Ihr beide kennt euch also?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030312,
					"content": "Ich spüre seine Aura ... und sein starkes Karma umgibt auch euch beide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030313,
					"content": "*seufz* Selbst nach tausend Jahren trägt er immer noch die schwere Last des Leids.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030314,
					"content": "Wirklich beschämend für mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030315,
					"content": "Sagtest du nicht, Pervases habe sein Leben für Liyue gegeben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030316,
					"content": "Das Leben ist kostbar, ja ... Doch im Vergleich mit dem, was der Dämonenbändiger erträgt, ist mein Tod nicht mehr als eine Kleinigkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030317,
					"content": "Pervases ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030318,
					"content": "Haha, tut mir leid. Geburtstage sind ein Anlass zur Freude, doch an einem Todestag hingegen ist ein wenig Melancholie nicht unangebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030319,
					"content": "Ich befürchte, der Nachklang des Lebens ist nicht von Dauer. Passt gut auf euch auf, und bitte erkundigt euch für mich nach dem Wohlbefinden des Dämonenbändigers ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030320,
						111030321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030320,
					"content": "Das werden wir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030322
					]
				},
				{
					"id": 111030322,
					"content": "*seufz* Könnte ich doch nur noch einmal gegrillten Fisch kosten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030323,
					"content": "Bei Wellen und Sturm such ich nach Fisch, bei Wind und Schnee erlege ich das Böse ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030324,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030325,
					"content": "Er scheint fort zu sein ... Paimon hofft, dass sich jemand an den Yaksha namens Pervases erinnert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030326,
					"content": "Wir sollten auch aufbrechen. Bringen wir ihm ein paar Opfergaben, wenn wir Zeit haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030321,
					"content": "Pass auch auf dich auf, Pervases ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030322
					]
				},
				{
					"id": 111030306,
					"content": "D... Du bist ein Geist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030307
					]
				},
				{
					"id": 111030307,
					"content": "Haha ... Nun ja, das ist nicht ganz falsch. Adepten und Geister trennte von jeher nur ein schmaler Grat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030308
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1110305,
			"completionStepIds": [
				1110316
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
