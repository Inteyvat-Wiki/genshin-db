			},
			"dialogs": [
				{
					"id": 111030901,
					"content": "B... Bitte, nicht! I... Ich ergebe mich! Argh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030902,
						111030904
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030902,
					"content": "Glaubst du uns jetzt also?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030903
					]
				},
				{
					"id": 111030903,
					"content": "Ja! Ja, ich glaube euch! Ich dachte, ich sterbe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030906
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030906,
					"content": "Welch ein Unglück, euch beiden je begegnet zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030907
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030907,
					"content": "Bitte, große Adepten, verschont mein Leben. Ich werde es nie wieder tun, ich schwöre ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030908
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030908,
					"content": "Wir haben zwar deinen Geist gerufen, sind aber keine Adepten. Der echte Adept steht da drüben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030909,
					"content": "Du täuschst die Massen mit hohler Prahlerei, maskierst dich als Adept, exorzierst Dämonen, ohne sie auszulöschen, und achtest das Leben selbst nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030910
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030910,
					"content": "Eines Tages wird dich sicher deine gerechte Strafe treffen und du wirst den dämonischen Verlockungen erliegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030911
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030911,
					"content": "Ah ... Ich ... Du bist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030912
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030912,
					"content": "Xiao jagt ihm einen Mordsschrecken ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030913,
					"content": "Oh, großer Adept ... dürfte ich nach deinem Namen fragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030914,
						111030915
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030914,
					"content": "„Dämonenbändiger“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030916
					]
				},
				{
					"id": 111030916,
					"content": "Du bist es wirklich! Du! Nie im Leben hätte ich gedacht, einmal dem Dämonenbändiger zu begegnen, dem Schützenden Yaksha selbst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030917
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030917,
					"content": "Du weißt von Xiao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030918,
					"content": "Natürlich! Mein Großvater kannte alle Sagen. Er erzählte mir die Geschichten vom Dämonenbändiger, als ich auf seinem Schoß saß ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030919
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030919,
					"content": "Bis heute sammle ich alle Bücher über die Yaksha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030920
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030920,
					"content": "Doch seit ich in den Hinterlassenschaften meines Großvaters den Passierschein entdeckte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030921
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030921,
					"content": "Zuerst imitierte ich die Adepten nur zum Spaß, doch dann kam ich immer weiter und weiter vom rechten Weg ab ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030922
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030922,
					"content": "Das steckt also dahinter ... Im Grunde bist du also ein Fan von Xiao, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030923,
					"content": "Äh ... Ja. Ich danke euch beiden, dass ich den Dämonenbändiger persönlich erleben darf. Es ist wie ein Traum, der wahr wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030924
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030924,
					"content": "Nun, das war nicht unsere Absicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030925,
					"content": "Oh, großer Dämonenbändiger, bitte erlaube mir, vor dir diesen Schwur zu leisten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030926
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030926,
					"content": "Ich schwöre, das Böse abzulegen, ein ehrliches Leben zu leben und nie wieder den Namen der Adepten zu beschmutzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030927
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030927,
					"content": "Ich werde mich an deinen Schwur erinnern ... Jetzt geh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030928
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030928,
					"content": "Danke ... Tausend Dank für deine Vergebung, und für alles, was du für Liyue getan hast ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030929
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030929,
					"content": "Am Ende wirkte er aufrichtig. Er wird wohl niemanden mehr betrügen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030930,
					"content": "Oh, warte. Wir haben den Passierschein noch nicht zurück. Wir sollten morgen gleich zum Gasthaus Wangshu gehen und nach ihm suchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030915,
					"content": "„Schützender Yaksha“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030916
					]
				},
				{
					"id": 111030904,
					"content": "Also, ziehst du dieses Gerede von dir in der dritten Person immer noch durch?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030905
					]
				},
				{
					"id": 111030905,
					"content": "N... Nein, nie wieder! I... Ihr habt mich fast getötet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030906
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				}
			]
		},
		{
			"id": 1110310,
			"completionStepIds": [
				1110310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
