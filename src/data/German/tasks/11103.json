				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111031001,
					"content": "Hallo Chef. Der nach den Sternen greifende Himmelsfürst nächtigt hier, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031002,
					"content": "Nach den Sternen greifender Himmelsfürst ... Du meinst den falschen Adepten, der eine Maske trug, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031003
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031003,
					"content": "Er hat sich hier unter dem Namen Wang Ping’an eingetragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031004,
						111031005
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031004,
					"content": "Das ist ein ... ziemlich gewöhnlicher Name.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031006
					]
				},
				{
					"id": 111031006,
					"content": "Er ist bereits abgereist, meinte, er möchte auf eine einsame Pilgerfahrt gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031007
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031007,
					"content": "#Ah, ja. Er wollte außerdem, dass ich diesen Brief {F#einer Reisenden}{M#einem Reisenden} gebe, {F#die}{M#der} zusammen mit einer „sprechenden Fee“ unterwegs ist, sollten sie nach ihm fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031008
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031008,
					"content": "Eine sprechende Fee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031009,
					"content": "#Nun, du musst {F#diese Reisende}{M#dieser Reisende} sein. Hier ist der Brief.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031010
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031010,
					"content": "Er hat sogar einen Brief für uns hinterlassen. Hoffentlich ist das kein neuer Trick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031011,
					"content": "Los, öffne ihn! Paimon ist gespannt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031019,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031012,
					"content": "Oh, er hat uns tatsächlich einige Dinge hinterlassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031013,
					"content": "Unter anderem den Passierschein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031014,
					"content": "So einem Schurken ist Paimon schon lange nicht mehr begegnet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031015,
						111031016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031015,
					"content": "Ich bin wirklich gerührt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031017
					]
				},
				{
					"id": 111031017,
					"content": "Ja ... Oh, wir sollten diesen Passierschein Xiao geben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031016,
					"content": "Das haben wir Xiao zu verdanken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031017
					]
				},
				{
					"id": 111031005,
					"content": "Klingt nach einer ganz normalen Person ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031006
					]
				}
			]
		},
		{
