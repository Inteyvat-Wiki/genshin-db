			"dialogs": [
				{
					"id": 111030701,
					"content": "Das sollten alle Anweisungen von Xiao gewesen sein, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030702,
					"content": "Mehr oder weniger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030703
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030703,
					"content": "Überlasst den Rest mir. Macht ihr euch bereit für die Begrüßung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030704
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030704,
					"content": "Wo bin ich ... oh? Euch beide kenne ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030705
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030705,
					"content": "Was ist mit meinem Körper los? Ich bin so ... leicht. Schwerelos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030706,
						111030709
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030706,
					"content": "Wir haben deinen Körper mit einer Adeptenkunst gerufen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030707
					]
				},
				{
					"id": 111030707,
					"content": "Einer Adeptenkunst? Hahaha! Ihr wagt es, einen Adepten in der Gegenwart von einem vorzutäuschen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030708
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030708,
					"content": "Apropos, dieser Ort ist ihm nicht vertraut. Einer erinnert sich nur an das friedliche Gasthaus Wangshu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030712
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030712,
					"content": "Ah, richtig ... so muss es sein. Natürlich. Haha, wie von einem erwartet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030713
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030713,
					"content": "Einer muss in der Tat träumen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030714
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030714,
					"content": "Argh, dieser Typ ist echt hoffnungslos ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030715,
						111030716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030715,
					"content": "Oh, du träumst nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030717,
					"content": "Wie? Was soll das heißen? Glaubt ihr wirklich, einer lässt solch Anmaßung im eigenen Traum zu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030718
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030718,
					"content": "Ja, legen wir los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030716,
					"content": "Träumende spüren schließlich keinen Schmerz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030709,
					"content": "Rate mal. Du bist tot.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030710
					]
				},
				{
					"id": 111030710,
					"content": "T... Tot?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030711
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111030711,
					"content": "Nein, unmöglich! Ich ruhte doch friedlich im Gasthaus Wangshu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030712
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				}
			]
		},
