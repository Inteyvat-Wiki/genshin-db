			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030501,
					"content": "Hast du die Gegenstände für das Ritual beisammen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030502
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030502,
					"content": "Hmm. Das Weihrauchgefäß, die Lampen ... Sie sind perfekt, fast so, als wären sie für die Adeptenkünste gemacht. Wo habt ihr dir her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030503
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030503,
					"content": "Wir haben sie von einem Yaksha namens Pervases ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030504
					]
				},
				{
					"id": 111030504,
					"content": "Wir sollen dich auch von Pervases grüßen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030505,
					"content": "Pervases ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030506
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030506,
					"content": "Ja, das scheint zu ihm zu passen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030507
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030507,
					"content": "Ich dachte mir schon, dass er von Liyue nicht ablassen kann ... Hoffentlich kann er nun in Frieden ruhen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030508
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030508,
					"content": "Gut. Kümmern wir uns um das Ritual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030509
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030509,
					"content": "Stellt das Weihrauchgefäß in der Mitte auf und die Sieben-Sterne-Lampen drumherum. Dekoriert den Bereich mit den Objekten von bitterer Kälte. Dann können wir fortfahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030510
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030510,
					"content": "Ja, das wird reichen. Der nächste Schritt ist essenziell für den Traumfänger ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030511
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030511,
					"content": "Dieses Ritual umfasst vier Schritte: Opfern von Weihrauch, Meditation, Beschwörung und der Abschuss eines Pfeils.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030512
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030512,
					"content": "Das ... klingt nach viel Arbeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030513,
					"content": "Die Adeptenkünste sind das Ergebnis tausend Jahre langer Studien der Adepten. Ihre mystischen Vorgaben sollten eingehalten werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030514
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030514,
					"content": "Nimmt man das nicht ernst, wird womöglich der eigene Körper verschlungen oder der Geist dauerhaft vom Körper getrennt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030515
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030515,
					"content": "Argh! Das will ich nicht hören! Paimon tut es leid!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030516,
					"content": "Das Opfern von Weihrauch ist einfach. Wir bieten im Gefäß Weihrauch dar, im Gedenken an Rex Lapis in unseren Herzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030517
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030517,
					"content": "In der Meditation reinigen wir uns von sinnlosen Gedanken und konzentrieren uns auf das Ziel der Kunst, die wir vollführen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030518
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030518,
					"content": "Dann rufen wir mit lauter Stimme die Beschwörung: „Devayaksha, herbei den Sünder!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030519
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030519,
					"content": "Schließlich verschießen wir jeweils einen Pfeil in Richtung der Yaksha-Statuen, um ihre Macht für unsere Vereinbarung zu gewinnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030520
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030520,
					"content": "Läuft alles gut, wird die Seele dieses Mannes bald erscheinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030521,
						111030522
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030521,
					"content": "Verstanden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030523
					]
				},
				{
					"id": 111030523,
					"content": "Dann lasst uns anfangen, falls es keine Fragen mehr gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030524
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030524,
					"content": "Gut ... also opfern wir zuerst den Weihrauch, ja? Mit Respekt für Rex Lapis und so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030522,
					"content": "*schluck*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030523
					]
				}
			]
		},
