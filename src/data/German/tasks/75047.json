			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kusi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750470401,
					"content": "Hm, das Gewicht habe ich zwar kontrolliert, aber ... Entschuldigung, gibt es ein Problem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470402,
						750470405,
						750470409
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470402,
					"content": "Darf ich nach deinem Namen fragen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470403
					]
				},
				{
					"id": 750470403,
					"content": "Ah, ich bin einer der Wächter des Abwehrpostens hier, aber derzeit bin ich im Urlaub ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470404
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470404,
					"content": "Falls etwas anliegt, wendet euch an den daneben stehenden Yukom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470405,
					"content": "Machst du dir gerade irgendwelche Sorgen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470406
					]
				},
				{
					"id": 750470406,
					"content": "Na ja, ich habe in letzter Zeit ein bisschen zugenommen, also habe ich viel gesundes Gemüse in die normalen Kornfrüchte gemischt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470407
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470407,
					"content": "Aber ich verstehe nicht ganz, warum mein Gefährte Ur in letzter Zeit ebenfalls so viel Gras frisst ... Obwohl Saurier Allesfresser sind, wird er wahrscheinlich nicht genügend Nährstoffe erhalten, wenn er nur Gras zu sich nimmt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470408
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470408,
					"content": "Ich sollte das nächste Mal besser mit ihm darüber sprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470409,
					"content": "Alles ist in Ordnung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470410
					]
				},
				{
					"id": 750470410,
					"content": "Na gut, dann wünsche ich dir eine gute Reise, Fremder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kusi"
				}
			]
		}
	]
