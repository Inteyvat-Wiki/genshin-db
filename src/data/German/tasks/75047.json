			"dialogs": [
				{
					"id": 750470201,
					"content": "Kornfrüchte sind echt lecker ... Hm, aber wenn man nur Kornfrüchte isst, wird man sich nach ein paar Tagen daran satt essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470202
					],
					"speakerTitle": "Ur"
				},
				{
					"id": 750470202,
					"content": "Ist das der Grund, warum Menschen Gras und Kornfrüchte zusammen essen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ur"
				}
			]
		},
		{
