			},
			"dialogs": [
				{
					"id": 750470301,
					"content": "Ich bin so müde und will schlafen ... Aber wir müssen hier stehen bleiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470302
					],
					"speakerTitle": "Huruk"
				},
				{
					"id": 750470302,
					"content": "Warum müsst ihr hier den ganzen Tag stehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huruk"
				}
