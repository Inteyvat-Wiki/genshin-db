			"dialogs": [
				{
					"id": 102030101,
					"content": "Nun ja, Klee ist der Funkenritter des Ordo Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030102
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030102,
					"content": "Was? Klee ist ein Ritter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030103,
						102030104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102030103,
					"content": "Wenn das so ist ... Könnte Paimon eventuell auch ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102030105
					]
				},
				{
					"id": 102030105,
					"content": "Ja, das ist auch für Paimon zu viel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102030106,
					"content": "Jetzt hat es auch Sinn, dass ein „Funkenritter“ einen derartigen „Schatz“ hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102030107,
					"content": "Sie bereitet dem Ritterorden zwar häufig Ärger, aber die Ritter kümmern sich trotzdem gern um sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030108,
					"content": "Und was ihre Herkunft betrifft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030109
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030109,
					"content": "Du wirst sie später sicher besser kennenlernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030110
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030110,
					"content": "#Pass bitte auch in Zukunft auf sie auf, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030104,
					"content": "Das klingt sogar noch wichtiger als „Ehrenritter“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102030105
					]
				}
			]
		},
