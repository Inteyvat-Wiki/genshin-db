			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111229901,
					"content": "Warte, es gibt hier Spuren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111229902,
					"content": "Diese müssen von den Bergleuten stammen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111229903,
					"content": "Wir müssen den Weg aus dem Lingju-Pass finden. Wenn es dort keine Fußspuren gibt, würde das darauf hindeuten, dass die Bergleute noch im Pass selbst sind. Wenn wir neue Spuren finden, können wir ihnen folgen, wohin auch immer sie führen mögen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1112202,
			"completionStepIds": [
				1112202
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112202",
							"2"
						],
						"stepId": 1112202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220201,
					"content": "Juhu! Fußabdrücke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220202,
					"content": "Es sieht so aus, als ob sie sich ihren Weg durch den Lingju-Pass bahnten und dann weiterzogen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220203
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220203,
					"content": "Wenn wir ihren Fußspuren folgen, sollten wir in der Lage sein, herauszufinden, wohin sie gegangen sind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112204,
			"completionStepIds": [
				1112204,
				1112210,
				1112211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112204",
							"2"
						],
						"stepId": 1112204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220401,
					"content": "Hallo, hast du einen Bergmann gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220402,
					"content": "Es muss vor etwa vier oder fünf Tagen gewesen sein. Da waren ein paar Männer, die mit Körben und Hacken hier durchkamen ... Ich schätze, das könnten sie gewesen sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220403
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220403,
					"content": "Ja! Das waren sie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220404,
					"content": "Vor vier oder fünf Tagen? Offenbar sind sie langsamer, als wir dachten. Vielleicht haben die Geländebedingungen am Lingju-Pass sie gebremst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220405
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220405,
					"content": "Es war so seltsam! Vier große Kerle mit leblosen Gesichtern ... Es war, als wären sie in einer Art Trance! Und da war ein Kind, das vor ihnen taumelte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220406
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220406,
					"content": "Dieses Kind ... hast du gesehen, wie es aussah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220407
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220407,
					"content": "Ich habe einen flüchtigen Blick erhascht ... blaues Haar, kurz. Ich glaube ... Ich glaube, es war ein Mädchen. Sie lächelte nicht, sie sah sogar sehr ernst aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220408
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220408,
					"content": "Und sie haben diesen Weg genommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220409
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220409,
					"content": "Ja, sie sind ihm direkt von hier aus gefolgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220410
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220410,
					"content": "Verfolgen wir sie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112207,
			"completionStepIds": [
				1112207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112207",
							"2"
						],
						"stepId": 1112207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wanyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220701,
					"content": "Diese Monster waren so aggressiv ... Sie müssen mich beim Durchqueren bemerkt haben! Ehe ich mich’s versah, waren sie überall auf mir ... Danke, dass ihr mich gerettet habt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220702
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220702,
					"content": "Mein Name ist Wanyu, ich gehöre zur Shenglu-Kammer von Liyue. Ich leite unsere Forschung zur menschlichen Kultur und Zivilisation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220703
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220703,
					"content": "Hm? Bist du sicher, dass du nicht ... ein Bergmann bist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220704,
					"content": "Ein Bergmann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220705
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220705,
					"content": "Ja. Wir suchen ein paar Bergleute! Eine Gruppe von vier starken Kerlen, die Bergbauausrüstung tragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220706,
					"content": "I... Ich glaube, ich habe diese Leute gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220707
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220707,
					"content": "Wirklich!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220708,
					"content": "Ja. Ich bin vorgestern von Nantianmen aus in Richtung Lingju-Pass aufgebrochen. Etwa auf halber Strecke traf ich auf ein paar Leute — ein paar Männer und ein Kind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220709
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220709,
					"content": "Kannst du etwas genauer sein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220710
					]
				},
				{
					"id": 111220710,
					"content": "Ich hatte es eilig, ich konnte nicht genau hinsehen. Ich fürchte, ich bin nicht einmal sicher, wie sie aussahen ... Entschuldigung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220711
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220711,
					"content": "Ich denke, das ist alles, was wir hören mussten. Ich danke dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220712,
					"content": "Ich hoffe, es wird euch helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220713
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220713,
					"content": "Ich gehe jetzt besser, ich muss noch zu einer Konferenz. Nochmals vielen Dank an euch alle für eure Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220714
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220714,
					"content": "Dieser Gelehrten zufolge waren die Bergmänner auf dem Weg nach Nantianmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220715,
					"content": "Können wir absolut sicher sein, dass es die Männer waren, die wir suchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220716
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220716,
					"content": "Ein Kind mit einer Gruppe von Erwachsenen! Hört sich für Paimon ziemlich danach an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220717,
					"content": "Es hätte durchaus auch eine andere Gruppe sein können.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220718
					]
				},
				{
					"id": 111220718,
					"content": "Äh ... a... aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220719,
					"content": "Schau, vielleicht kann uns der Felsen da drüben mehr erzählen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220720
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220720,
					"content": "Aha! Paimon hätte fast unsere Geheimwaffe vergessen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220721,
					"content": "Es sieht vielversprechend aus, ich werde mein Bestes tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220722
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220722,
					"content": "Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220723
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220723,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220724
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220724,
					"content": "Es ist natürlich dieselbe Gruppe. Sie ging diese Straße entlang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220725
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220725,
					"content": "Kun Jun, dein Steinsehen ist etwas, das ich so schnell nicht vergessen werde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220726
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220726,
					"content": "Ich nehme an, dass es ein Vorteil ist, auch wenn ich selten eine Verwendung dafür finde. Aber ein Lob von Herrn Zhongli ist wirklich ein großes Lob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220727
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220727,
					"content": "Gut, dass wir unseren „Kun-Jun-Kompass“ dabei hatten! Wir hätten schon längst jeden Orientierungssinn verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220728,
					"content": "Hahaha, findest du? Ich schätze, dann war es eine lohnende Reise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220729
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220729,
					"content": "Es fühlt sich an ... als würden wir einen Kriminalfall lösen. Es macht eine Menge Spaß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220730
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220730,
					"content": "Wie dem auch sei, wir täten gut daran, unsere Wachsamkeit hoch zu halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220731
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220731,
					"content": "Vier ausgewachsene Männer in einem tranceartigen Zustand ... unaufhörlich Tag und Nacht wandernd ... über Hügel und Berge ... geführt von einem Kind ... Dies ist kein gewöhnlicher Vorfall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220732,
					"content": "Oh! Ihr habt ganz recht, Herr Zhongli. Wir sollten unseren Verstand gebrauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220733
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220733,
					"content": "Das ist noch nicht alles. Die Gelehrte eben wurde von jungen Geo-Drachenechsen angegriffen, aber der Grad der Aggression, den sie an den Tag legten, war ... ungewöhnlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220734
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220734,
					"content": "Auf dem Weg dorthin sind wir auf viele Hinweise gestoßen. Bis jetzt haben sie uns in die richtige Richtung gewiesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220735
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220735,
					"content": "Die Bergmänner machten sich vorgestern auf den Weg in Richtung Nantianmen. Von hier aus hätten sie eine gefährliche Bergstraße passieren müssen. Wenn ihr Ziel tatsächlich Nantianmen ist, sollten wir in der Lage sein, sie einzuholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220736
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220736,
					"content": "Toll! Keine Zeit zu verlieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220737,
					"content": "Ich habe gerade eine Markierung in der Nähe hinterlassen. Wenn Onkel Dai hier durchkommt, sollte sie ihn zu uns führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220738
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220738,
					"content": "Kluges Denken! Wie man es von Zhongli kennt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112208,
			"completionStepIds": [
				1112208
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112208",
							"2"
						],
						"stepId": 1112208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Minenarbeiter"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220802,
					"content": "Hier liegt auch ein Korb ... das muss einer der Bergmänner sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220803
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220803,
					"content": "He! Hallo? Kannst du uns hören?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220804,
					"content": "Seinem Aussehen nach zu urteilen, muss er vor Erschöpfung zusammengebrochen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220805
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220805,
					"content": "Sollen wir ihn aufwecken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220806,
					"content": "Ich kann ... Ich kann immer noch graben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220807
					],
					"speakerTitle": "Minenarbeiter"
				},
				{
					"id": 111220807,
					"content": "Hm? Klingt, als würde er etwas flüstern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220808,
						111220809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220808,
					"content": "Er sieht aus, als würde er sich abmühen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220810
					]
				},
				{
					"id": 111220810,
					"content": "Es scheint, als ob er denkt, dass er noch Arbeit zu erledigen hat. Irgendetwas stimmt hier nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220811
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220811,
					"content": "In der Nähe gibt es ein Lager. Wir sollten ihn dorthin bringen und seinen Zustand beobachten, bevor wir über unseren nächsten Schritt entscheiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220809,
					"content": "Es sieht so aus, als wolle er aufstehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220810
					]
				}
			]
		},
		{
			"id": 1112209,
			"completionStepIds": [
				1112209
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112209",
							"2"
						],
						"stepId": 1112209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220901,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220902
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220902,
					"content": "Wie geht es ihm? Er wird doch nicht sterben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220903,
					"content": "Er hat bis zur Benommenheit gearbeitet. Zum Glück ist er nicht in ernsthafter Gefahr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220904
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220904,
					"content": "Wie konnte er so erschöpft werden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220905
					]
				},
				{
					"id": 111220905,
					"content": "Paimon hörte, wie er davon sprach, nach etwas zu graben. Hat er sich selbst in diesen Zustand hineingegraben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220906,
					"content": "Das ist sicherlich eine Möglichkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220907,
						111220908
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220907,
					"content": "Wie merkwürdig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				},
				{
					"id": 111220909,
					"content": "Hm? Es sieht so aus, als ob er etwas in seiner Tasche hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220910
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220910,
					"content": "Sind das ... Erzfragmente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220911
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220911,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220912
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220912,
					"content": "Ich habe gerade die Erinnerungen in diesen Erzfragmenten gesehen. Diese Person hat diese Fragmente aus der Mine gebracht. Er ist einer der vier, nach denen wir suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220913
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220913,
					"content": "Wie er hierherkam, müssen wir verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220914
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220914,
					"content": "Er wurde also entführt und dann ... hier ausgesetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220915,
					"content": "Aber wenn er nicht gebraucht wurde, warum ihn den ganzen Weg hierherbringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220916,
					"content": "Es sei denn, es ist etwas passiert ... etwas, das dazu führte, dass er zurückfiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220917
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220917,
					"content": "*schluchz* Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220918,
					"content": "Paimon hat genug! Das ist zu mysteriös!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220919,
					"content": "Oh! Warte einen Moment! Der Anblick dieser Fragmente hat meinem Gedächtnis auf die Sprünge geholfen — ich habe etwas für euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220920
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220920,
					"content": "Was ist das? Ooh! Ist es ein Geschenk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220921,
					"content": "Etwas ... für uns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220922,
					"content": "Wie gesagt, bevor ich Onkel Dai traf, war ich wie benebelt. Nachdem ich nun mit euch zu diesem Fall aufgebrochen bin, fühlt es sich an, als würde sich der Nebel lichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220923
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220923,
					"content": "Ich war so froh, als Onkel Dai dich um Hilfe gebeten hat. Alleine hätte ich es nie geschafft, diese Hinweise aufzuspüren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220924
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220924,
					"content": "Dies sind einige Kristalle, die ich auf dem Markt gekauft habe. Nicht irgendwelche alten Kristalle wohlgemerkt — diese Reinheit ist außerordentlich selten! Einer für jeden von euch. Eine Erinnerung, wenn ihr so wollt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220925
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220925,
					"content": "Sie sind so wunderschön! Oh, und die Farben ändern sich, wenn man sie dreht! Aus verschiedenen Blickwinkeln sehen sie wie andere Kristalle aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220926,
						111220927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220926,
					"content": "Sieht teuer aus ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220928,
					"content": "Aber natürlich, greif zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220929
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220929,
					"content": "Und dieser hier ist für Herrn Zhongli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220930
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220930,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220931
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220931,
					"content": "Hm? Äh, stimmt etwas nicht? Nicht nach Eurem Geschmack?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220932
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220932,
					"content": "Ganz im Gegenteil ... Ich hatte nur nicht damit gerechnet, unter den gegebenen Umständen ein Geschenk zu erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220933,
					"content": "Danke, ich werde gut darauf aufpassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220934
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220934,
					"content": "Ich freue mich, dass sie euch gefallen. Es ist schön, ein Geschenk machen zu können, das andere zu schätzen wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220935
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220935,
					"content": "Ich sehe da drüben noch mehr Steine. Ihr solltet euch alle etwas ausruhen, ich werde ein wenig spazieren gehen. Vielleicht gibt es noch mehr Erinnerungen zu entdecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220936
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220936,
					"content": "Du magst wohl Steine, was Kun Jun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220937
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220937,
					"content": "Erze sind die Kristalle der Erde, das Sediment der Zeit selbst. Ich fühle mich in Frieden unter ihnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220938
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220938,
					"content": "Ruh dich aus und ruf nach mir, wenn du bereit bist, loszugehen. Ich werde nicht weit weg sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220939
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220939,
					"content": "Er kommt doch allein zurecht, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220940
					]
				},
				{
					"id": 111220940,
					"content": "Bleib ruhig, ich habe die Gegend untersucht. Es besteht hier keine Gefahr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220941
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220941,
					"content": "Ah ja, da ist etwas, was ich mit dir besprechen wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220942
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220942,
					"content": "Hm? Warum seid Ihr auf einmal so ernst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220943
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220943,
					"content": "#{F#Reisende}{M#Reisender} ... Hat Drachenfall eine Bedeutung für dich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220944
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220944,
					"content": "Nein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220945
					]
				},
				{
					"id": 111220945,
					"content": "Ihr meint das Erz, nach dem Kun Jun sucht? Was ist daran so besonders?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220946
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220946,
					"content": "Drachenfall ist ein unglaublich seltenes Erz, das beim Schmieden verwendet wird. Die meisten regulären Kristalle werden in Hochtemperaturumgebungen gebildet. Drachenfall hingegen entsteht als Produkt elementarer Reaktionen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220947
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220947,
					"content": "Elementare Reaktionen können materielle Objekte erzeugen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220948
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220948,
					"content": "Das können sie in der Tat. Allerdings kann nur eine kleine Anzahl über lange Zeiträume fortbestehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220949
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220949,
					"content": "Drachenfall entstand inmitten einer großen Schlacht vor Tausenden von Jahren. Mächtige Zusammenstöße von elementarer Energie ließen Elementarkristalle entstehen. Als die Kämpfe aufhörten, wurden diese geologischen Überreste auf wundersame Weise konserviert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220950
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220950,
					"content": "Toll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220951
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220951,
					"content": "Und doch sind sie Kristallkreationen, äußerst dünn gesät und relativ unbekannt. Vor ein paar hundert Jahren wurden sie praktisch in die Vergessenheit abgebaut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220952
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220952,
					"content": "Wie kommt es dann, dass ein Bürger von Liyue jetzt auf Erze stoßen will, die schon längst von der Erde verschwunden sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220953
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220953,
					"content": "Ja! Wenn er von ihrer Existenz weiß, weiß er doch sicher auch, dass alles bereits abgebaut wurde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220954
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220954,
					"content": "Seltsam ... Paimon kapiert es nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220955
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220955,
					"content": "Es gibt jene im Bergbaugewerbe, die ein großes Interesse an Drachenfall hegen. Aber für jemanden wie Kun Jun ... dessen Beweggründe, es zu suchen, selbst für ihn unklar sind ... so etwas gibt es so gut wie nie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220956
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220956,
					"content": "Vielleicht hat er Hintergedanken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220957
					]
				},
				{
					"id": 111220957,
					"content": "Hinterhältige Beweggründe ... Uuuh ... Ist er ein Schurke!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220958
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220958,
					"content": "Eine Schlussfolgerung, die derzeit unmöglich zu bestätigen ist. Wir müssen beobachten ... und warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220959
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220959,
					"content": "Vergiss nicht, dass die Rettung der Bergleute das Hauptziel ist. Was alles andere angeht ... Früher oder später werden die Gezeiten die Wahrheit offenbaren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220960
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220960,
					"content": "Wir kommen unserem Ziel immer näher. Ich glaube, wir sollten diesen Weg weiterverfolgen. Jetzt, da wir einen gefunden haben, werden die anderen nicht mehr weit sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220961
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220961,
					"content": "Sobald du ausgeruht bist, rufe Kun Jun zu uns. Wir haben noch weitere Untersuchungen anzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220962
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220962,
					"content": "Wir sollten dafür sorgen, dass dieser Bergmann hier im Lager gut aufgehoben ist. Wenn wir die Sache erledigt haben, können wir zurückkehren und uns um ihn kümmern. Ich schlage vor, wir hinterlassen eine Nachricht für Onkel Dai. Wenn er das Lager findet, wird er wissen, was zu tun ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220927,
					"content": "Kann ich ihn wirklich behalten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220908,
					"content": "Wurde er nicht hierher gebracht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				}
			]
		},
