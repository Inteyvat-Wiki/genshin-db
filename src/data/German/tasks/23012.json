			"dialogs": [
				{
					"id": 230121101,
					"content": "Ich habe früher schon mit Katzen geredet ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121102
					]
				},
				{
					"id": 230121102,
					"content": "Du meinst „Neko“? Aber Neko spricht doch Menschensprache, das zählt nicht als „Katzensprache“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230121103,
					"content": "Stimmt, aber im Gegenzug musst du mir helfen, ein Kätzchen wiederzufinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121104,
						230121105
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121104,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121108
					]
				},
				{
					"id": 230121108,
					"content": "Das heißt, ihr seid einverstanden? Dann herzlichsten Dank im Voraus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121109
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121109,
					"content": "Ähem ... Hört bitte gut zu. Das sind die „Grundlagen der Katzensprache“, an denen ich sehr lange gearbeitet habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121105,
					"content": "Für jede Stadt braucht es unterschiedliche Methoden, um eine Katze zu finden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121106
					]
				},
				{
					"id": 230121106,
					"content": "Haha, ha ... Stimmt. Wenn Paimon darüber nachdenkt, haben wir schon in vielen Städten Menschen geholfen, ihre Katzen wiederzufinden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230121107,
					"content": "Soll Paimon sagen, dass alle Menschen Kätzchen lieben, oder, dass alle Katzenbesitzer die gleichen Probleme haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
