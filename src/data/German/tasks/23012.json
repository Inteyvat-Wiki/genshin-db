			"dialogs": [
				{
					"id": 230121501,
					"content": "Der Name des „schwarzweißen“ Kätzchens, das heute zum Spielen herausgekommen ist, ist „Lale“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121502
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121502,
					"content": "In „Katzensprache“ ruft man es so: „Miau, miau miau miau, miau ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121503
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121503,
					"content": "Merk dir, dass der Ton erst fällt, dann steigt und das letzte „Miau“ sehr hoch ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
