			},
			"dialogs": [
				{
					"id": 230120301,
					"content": "Ihr habt schon das Kätzchen zurückgebracht. Ich bin euch wirklich dankbar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120302
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120302,
					"content": "Seht an, ihr seid gar nicht so schlecht in der „Katzensprache“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120303
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120303,
					"content": "Hier, nimm dies als Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120304
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120304,
					"content": "Nur wenige Menschen lernen die „Katzensprache“ so schnell. Wahrscheinlich brauche ich beim nächsten Mal noch deine Unterstützung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120305
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120305,
					"content": "Miau!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120306
					]
				},
				{
					"id": 230120306,
					"content": "Du kannst jetzt normal sprechen! Frau Sareh ist doch keine Katze!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120307,
					"content": "Ich kann an deiner Miene sehen, dass du „kein Problem“ sagen wolltest, aber ... deine Aussprache hat noch Luft nach oben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120308
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120308,
					"content": "Aber das macht nichts, ich werde dir weiter „Katzensprache“ beibringen. Lass uns sie gemeinsam meistern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sareh"
				}
			]
		},
