			},
			"dialogs": [
				{
					"id": 761230101,
					"content": "Das riecht ja großartig! Sind wir wieder pünktlich zu Columbinas Essenszeit gekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230102,
					"content": "Hm. Stellen sich die Kuuhenki ... etwa für die Suppe an, die Columbina serviert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230103,
					"content": "Einen Moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230104
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230104,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230105
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761230105,
					"content": "Ooh, das ist wirklich gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230106,
					"content": "Erfrischende, leckere Fruchtsuppe, so was hat Paimon noch nie probiert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230107,
					"content": "Möchtest du noch eine Portion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230108
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230108,
					"content": "Mach zwei daraus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230109,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230110
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761230110,
					"content": "Lernst du gerade kochen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230111
					]
				},
				{
					"id": 761230111,
					"content": "Ja. Ich habe Ineffa nach ein paar einfachen Rezepten gefragt und schon mehrere Versuche gemacht. Sowohl die Kuuhenki als auch die Tiere haben sehr positiv darauf reagiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230112
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230112,
					"content": "Hast du irgendwelche Probleme gehabt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230113
					]
				},
				{
					"id": 761230113,
					"content": "Nun ... Meine Ärmel sind zu weit. Sie streifen den Topf, wenn ich nicht aufpasse ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230114
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230114,
					"content": "(Also liegt das Problem nicht am Kochen selbst.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230115
					]
				},
				{
					"id": 761230115,
					"content": "Allerdings habe ich manchmal Probleme damit, Süßigkeiten zuzubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230116
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230116,
					"content": "Du musst die Temperatur und die Proportionen genau richtig abstimmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230117
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230117,
					"content": "(Dann hat sie wohl in der Vergangenheit nicht viel für sich selbst gekocht.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230118
					]
				},
				{
					"id": 761230118,
					"content": "(Außerdem ist es besonders schwierig, Desserts und Snacks alleine richtig hinzubekommen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230119
					]
				},
				{
					"id": 761230119,
					"content": "Soll ich dir dabei helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230120
					]
				},
				{
					"id": 761230120,
					"content": "Klar. Fangen wir mit Krumkake an, in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230121
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230121,
					"content": "Nach einer Weile ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230122
					]
				},
				{
					"id": 761230122,
					"content": "Möchtest du einen probieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230123,
						761230124
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230123,
					"content": "(Einen kleinen Bissen nehmen)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230125
					]
				},
				{
					"id": 761230125,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230126
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230126,
					"content": "(Boah, der erste Bissen schmeckt, als hätte ich in eine saure Frucht gebissen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230127
					]
				},
				{
					"id": 761230127,
					"content": "(Aber nach dem Runterschlucken kommt die Süße wieder durch ... Vielleicht schmeckt es besser, wenn man sich daran gewöhnt hat ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230128
					]
				},
				{
					"id": 761230128,
					"content": "Was denkst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230129,
						761230130
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230129,
					"content": "Geht so ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230131
					]
				},
				{
					"id": 761230131,
					"content": "Hat Paimon etwas verpasst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230132,
					"content": "Probier das mal schnell aus, ja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230133
					]
				},
				{
					"id": 761230133,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230134,
					"content": "Uaaah, das ist ja supersauer! W... Was habt ihr beide mit Paimon vor!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230135,
					"content": "Haha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230136
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230136,
					"content": "Der Nachgeschmack ist aber echt gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230137
					]
				},
				{
					"id": 761230137,
					"content": "Es geht nur um den ersten Geschmack! Hätte keiner von euch Paimon warnen können, einen kleineren Biss zu nehmen!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230138,
					"content": "Wenn du nichts gesagt hättest, hätte Paimon gedacht, das wäre ein Scherz! Die Gesichter der Leute zu sehen, wie sie sich verziehen, so etwas ist doch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230139,
					"content": "Gut. Lass es mich noch einmal versuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230140
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230140,
					"content": "Noch mehr Zeit vergeht ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230141
					]
				},
				{
					"id": 761230141,
					"content": "Hier. Versuch diese Portion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230142
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230142,
					"content": "(Woah ... Das ist viel besser!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230143,
						761230144
					]
				},
				{
					"id": 761230143,
					"content": "Wirklich köstlich!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230145
					]
				},
				{
					"id": 761230145,
					"content": "Wirklich? Paimon will auch was davon! ... Mmm! Das ist der Hammer! Sooo lecker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230146,
					"content": "Gut genug, um es zu verschenken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230147
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230147,
					"content": "Genau! Moment mal, hast du kochen gelernt und Krumkake gemacht, weil du jemandem ein Geschenk machen wolltest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230148,
					"content": "Ja ... Für meine Freunde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230149
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230149,
					"content": "Das ist eine tolle Idee.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230150
					]
				},
				{
					"id": 761230150,
					"content": "Erinnerst du dich noch an das erste Mal, als ihr hierhergekommen seid? Du hattest etwas zu essen für mich vorbereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230151
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230151,
					"content": "Auch wenn das Essen meine verlorene Kraft nicht wirklich wiederherstellen konnte, fühlte ich mich dadurch zumindest entspannter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230152
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230152,
					"content": "Damals habe ich mir nicht viel dabei gedacht, aber jetzt verstehe ich es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230153
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230153,
					"content": "Die Zeit und Mühe, die man in die sorgfältige Zubereitung von Speisen von Hand steckt, gibt ihnen ihre Seele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230154
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230154,
					"content": "Was ich genossen habe, war nicht nur das Essen selbst, sondern auch die Wärme und Güte der Hände, die es zubereitet haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230155
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230155,
					"content": "Und je weniger diese Hände Gegenseitigkeit erwarten, desto größer sind die Wärme und Freundlichkeit, die erforderlich sind, um darauf zu reagieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230156
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230156,
					"content": "Ooh, Paimon wird noch ganz rot, wenn du so weitermachst ... Ehrlich gesagt haben wir damals nur gehofft, bei dir einen guten Eindruck zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230157,
						761230158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230157,
					"content": "Aber jetzt ist alles anders.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230159
					]
				},
				{
					"id": 761230159,
					"content": "Stimmt. Aber jetzt, wo ich das alles verstehe, möchte ich noch mehr tun ... Es ist ein wunderbares Gefühl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230160
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230160,
					"content": "Kommst du mit mir, um unsere Freunde zu besuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230161
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230161,
					"content": "Außer dem Krumkake habe ich auch noch ein paar andere Geschenke vorbereitet. Ah, aber die müssen heimlich verschickt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230162
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230162,
					"content": "Warum „heimlich“, wenn Paimon fragen darf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230163,
					"content": "Nun, ihr wart ja immer diejenigen, die mich „überrascht“ haben. Ich möchte gerne sehen, wie meine Freunde reagieren, wenn der Spieß einmal umgedreht wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230164
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230164,
					"content": "Puh. Wir sind überall herumgelaufen! Aber jetzt sind wir endlich fertig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230165
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230165,
					"content": "Ihre Reaktionen waren allerdings ziemlich überraschend. Manche haben nicht mal bemerkt, dass die Geschenke von dir kamen, Columbina ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230166
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230166,
					"content": "Aino hat einfach direkt angefangen zu naschen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230167
					]
				},
				{
					"id": 761230167,
					"content": "Ist schon in Ordnung. Das habe ich erwartet. Wichtig ist nur, dass sie sich über die Geschenke gefreut haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230168
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230168,
					"content": "In diesem Fall wusste Lauma ganz sicher, dass die Krumkakes und der Kranz auf ihrem Schreibtisch von dir kamen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230169
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230169,
					"content": "Paimon kann ja noch verstehen, dass sie zögert, den Kranz zu tragen, aber dass sie die Krumkake ganze zehn Minuten lang angestarrt hat und sich immer noch nicht überwinden konnte, auch nur einen zu essen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230170
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230170,
					"content": "Ich hatte schon Angst, dass sie die Sachen wie Heiligtümer aufbewahren würde ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230171
					]
				},
				{
					"id": 761230171,
					"content": "Sieht so aus, als hätte Jahoda einen ziemlichen Schreck bekommen ... Vielleicht hätten wir die Geschenke nicht direkt hinter ihr platzieren sollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230172
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230172,
					"content": "Sie ist fast aus der Haut gefahren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230173
					]
				},
				{
					"id": 761230173,
					"content": "Vielleicht ist sie von Natur aus einfach wachsamer? Aber sie schien sich zu beruhigen, als Ashru zum Kratzbaum kam, den du geschickt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230174
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230174,
					"content": "Was meine anderen Freunde betrifft, die nicht in Nod-Krai sind, so zähle ich auf euch, ihre Geschenke zu überbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230175
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230175,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230176
					],
					"speakerTitle": "Ibis"
				},
				{
					"id": 761230176,
					"content": "Ich muss sagen, du bist echt gut darin, Geschenke vorzubereiten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230177
					]
				},
				{
					"id": 761230177,
					"content": "Hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230178
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230178,
					"content": "Oh! Sind wir jetzt endlich dran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230179
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230179,
					"content": "Hm? Süßigkeiten? Paimon dachte, wir würden wie alle anderen Krumkake bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230180
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230180,
					"content": "Du hattest schon vorher ein paar. Ein bisschen Abwechslung ist doch auch schön, findest du nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230181,
						761230182
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230181,
					"content": "Ja ... Die sind auch echt gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230183
					]
				},
				{
					"id": 761230183,
					"content": "Das freut mich zu hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230184
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230184,
					"content": "Und hier ist noch ein Geschenk. Das ist für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230185
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230185,
					"content": "Das ist ... ein Windgleiter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230186
					]
				},
				{
					"id": 761230186,
					"content": "Es heißt, der Himmel gehört den Vögeln und die Erde den wilden Tieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230187
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230187,
					"content": "Der weite Raum zwischen den beiden ist für Abenteurer mit Windgleitern reserviert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230188
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230188,
					"content": "Möge dieser Begleiter deinen Weg stets wie das Mondlicht erhellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230189
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230189,
					"content": "Das ist perfekt. Danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230190
					]
				},
				{
					"id": 761230190,
					"content": "Und danke dir für deine Begleitung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761230182,
					"content": "Sogar besser als die Süßigkeiten der Mondgebetsnacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230183
					]
				},
				{
					"id": 761230158,
					"content": "Wenn du etwas essen möchtest, sag es einfach.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230159
					]
				},
				{
					"id": 761230144,
					"content": "Du lernst ja wirklich schnell!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230145
					]
				},
				{
					"id": 761230130,
					"content": "Aber da ist noch Luft nach oben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
