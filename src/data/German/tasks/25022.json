			"dialogs": [
				{
					"id": 250220101,
					"content": "Hm ... Anscheinend brauchen wir wirklich ein neues Rezept ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220102,
					"content": "*brüll*! *brüüüllll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220103,
						250220104
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220103,
					"content": "Was hast du dir jetzt wieder ausgedacht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220106
					]
				},
				{
					"id": 250220106,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220107
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220107,
					"content": "Normalerweise verputzt Hora eine ganze Schüssel Früchte und ist danach den ganzen Tag munter wie ein Wirbelwind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220108
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220108,
					"content": "Jetzt isst er nur noch die halbe Schüssel und sitzt dann einfach nur da und rührt sich nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220109
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220109,
					"content": "Ich dachte schon, er sei krank, und bin voller Angst mitten in der Nacht los, um einen Arzt aufzusuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220110
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220110,
					"content": "Wir haben die ganze Nacht herumgedoktert und am Ende festgestellt, dass mit Hora alles in Ordnung ist. Er ist einfach nur ein ziemlicher Feinschmecker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220111
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220111,
					"content": "Der Arzt meinte, es wäre das Beste, wenn wir Hora ein neues Rezept servieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220112
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220112,
					"content": "Er sagte auch, dass ich Musik spielen soll, die den Appetit anregt. Das könnte Horas Lust am Essen wecken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220113,
						250220114
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220113,
					"content": "Das hört sich vernünftig an!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220115,
					"content": "Ahaha ... Ich hab dann eine Schallplatte gefunden und die Musik fand er gar nicht mal so schlecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220116
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220116,
					"content": "Aber als Hora dann hochsprang und die halbe Platte abbiss ... musste ich die Idee leider verwerfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220117
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220117,
					"content": "Eine Schallplatte aus Obsidian und Phlogiston ist für einen Tepetlisaurier wie Hora nämlich eine veritable Delikatesse ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220118
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220118,
					"content": "Jetzt bleibt mir nichts anderes übrig, als die Nachkommen der Baumkrone zu fragen, ob sie mir ein paar ungewöhnliche Zutaten besorgen könnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220119,
						250220120
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220119,
					"content": "Ich organisiere dir ein paar Zutaten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220121,
					"content": "Du willst wirklich helfen? Das wäre fantastisch! Die Nachkommen der Baumkrone suchen ihre Zutaten nur in Natlan, aber du kannst ja auch außerhalb fündig werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220124
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220124,
					"content": "Warte kurz, ich schau mal auf die Zutatenliste, die der Arzt mir gegeben hat. Der Kerl weiß wirklich Bescheid, selbst was die Welt außerhalb von Natlan angeht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220125
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220125,
					"content": "Hm ... Da steht, man kann <color=#00E1FFFF>Regenbogenrose, Lavendelmelone</color> und <color=#00E1FFFF>Qingxin</color> ausprobieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220122
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220122,
					"content": "Danke, dass du das für mich erledigst. Wenn du außergewöhnliche Zutaten findest, bring sie einfach zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220123
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220123,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220120,
					"content": "Ich bin gut darin, Zutaten aufzutreiben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220114,
					"content": "Es gibt echt Schallplatten für sowas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220104,
					"content": "(Hora streicheln)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220105
					]
				},
				{
					"id": 250220105,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220106
					],
					"speakerTitle": "Hora"
				}
			]
		},
