			"dialogs": [
				{
					"id": 250221201,
					"content": "Ach ja! Die hier sind für dich, als kleines Dankeschön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250221202
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250221202,
					"content": "Dank deiner Unterstützung kann ich sicher das ideale Rezept für Hora entwickeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250221203
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250221203,
