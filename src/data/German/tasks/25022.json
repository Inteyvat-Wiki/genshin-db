			"dialogs": [
				{
					"id": 250220301,
					"content": "Diese Blume sieht wirklich bezaubernd aus. Der Name hat auch etwas ... Hora, möchtest du sie versuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220304
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220304,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220305
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220305,
					"content": "(Hora knabbert vorsichtig an den Blütenblättern und kostet ihren Geschmack.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220306
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220306,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220307
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220307,
					"content": "Oh! Anscheinend schmeckt Hora die Blume richtig gut. Aber von Blumen allein wird man auch nicht satt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220308
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220308,
					"content": "Diese Blume wirkt allerdings sehr teuer. Wie dem auch sei, ich mach mir erstmal eine Notiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220309
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220309,
					"content": "Und wie macht man aus Blumen eigentlich eine Mahlzeit? Hm, vielleicht in Teigfladen wickeln ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
		{
			"id": 2502204,
