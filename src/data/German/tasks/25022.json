			"dialogs": [
				{
					"id": 250220501,
					"content": "Hm, die Blume duftet echt gut, so erfrischend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220504
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220504,
					"content": "Hora? Du ... Waaah! Hast du sie etwa schon weggefuttert?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220505
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220505,
					"content": "(Hora schluckt die Qingxin in einem Bissen runter und zwinkert euch verschmitzt zu ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220506
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220506,
					"content": "Hora dreht sich plötzlich um und putzt die halbe Obstschale in einem Haps weg ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250220507
					]
				},
				{
					"id": 250220507,
					"content": "Warum hat Hora plötzlich so einen Heißhunger? Wirken diese komischen Qingxin wirklich so gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220508
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220508,
					"content": "Ich ... Ich muss unbedingt mit dem Arzt darüber reden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
