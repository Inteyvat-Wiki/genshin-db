			"dialogs": [
				{
					"id": 250220401,
					"content": "Boah! Diese Frucht sieht ordentlich aus, davon wird man bestimmt satt. Hora, willst du mal probieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220404
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220404,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220405
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220405,
					"content": "(Hora schnappt sich die Lavendelmelone und isst einen großen Bissen nach dem anderen, bis alles weg ist.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220406
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220406,
					"content": "*brüll*! *brüüüllll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220407
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220407,
					"content": "Hahaha, das ging aber schnell. Die hat dir wirklich geschmeckt, oder, Hora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220408
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220408,
					"content": "*brüüüllll*! *brüll*! *brüüüllll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220409
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220409,
					"content": "Nun, ich werde mich mal schlaumachen ... Wo kann ich denn Händler aus Inazuma finden, um mehr Lavendelmelonen zu kaufen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
