						80000305
					],
					"speakerTitle": "Abgrundbote"
				},
				{
					"id": 80000305,
					"content": "#Puh ... Was für ein erbitterter Kampf. Geht es dir gut, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000306,
					"content": "Ein so mächtiger Feind. Wer konnte ahnen, dass der Orden des Abgrunds so mächtige Monster in seinen Reihen hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
