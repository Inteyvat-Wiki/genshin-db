			"trigger": {
				"objectNames": [
					"Ganyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80000101,
					"content": "Ja, ja. Sie besitzen die Frechheit, auf alles loszugehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000102,
					"content": "Selbst uralte Artefakte der Sieben, von Göttern und Drachen, sind nicht vor ihren gierigen Absichten sicher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000103
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000103,
					"content": "Doch jetzt ist es anders ... Für wen halten die sich, nach den Schätzen des Ordens des Abgrunds zu suchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000104,
					"content": "#Oh {F#Reisende}{M#Reisender}, du bist es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000105,
					"content": "Hm? Ganyu, was machst du denn hier mit Lan? Hast du vielleicht eine Mission, die du veröffentlichen musst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000106,
					"content": "#Hallo, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000107
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000107,
					"content": "Wir haben gerade über die Schatzräuber geredet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000108
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000108,
					"content": "Ja, wir meinten gerade, dass selbst die unverfrorenen Schatzräuber sich besser nicht mit dem Abgrund anlegen sollten. Er ist einfach zu böse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000109
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000109,
					"content": "Aber vor kurzer Zeit haben wir vom Rat für Allgemeine Angelegenheiten die Nachricht erhalten, dass zwei bekannte Schatzräuber in Liyue und Mondstadt eine große gemeinsame Aktion planen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000110
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000110,
					"content": "„Zwei bekannte Schatzräuber“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000111,
					"content": "Ja, man nennt sie die „Große Schwester des Südens“ und den „Komischen Vogel des Nordens“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000112,
					"content": "Aah! Der Komische Vogel! Paimon weiß noch, dass er in Mondstadt versuchte, vor Amber wegzulaufen ... Aber wer ist die „Große Schwester des Nordens“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000113,
						80000114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000113,
					"content": "„Große Schwester“ bedeutet, dass sie die älteste Schwester ist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000116
					]
				},
				{
					"id": 80000116,
					"content": "Das stimmt. Sie ist die Anführerin der Schatzräuber in Liyue. So, wie ich es verstanden habe, nennen die Schatzräuber sie alle „Chefin“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000117
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000117,
					"content": "Einige sagen, dass der Gott der Diebe ihr sogar ein Geschenk für ihre Dienste gemacht hat, was sie zur „Großen Schwester der Götter“ machte. Aber das ist wahrscheinlich nur ein wildes Gerücht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000118
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000118,
					"content": "Auf jeden Fall haben die Schatzräuber einige bisher unerforschte Ruinen entdeckt, welche der Orden des Abgrunds insgeheim bewacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000119
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000119,
					"content": "Obwohl es so gefährlich ist, können die Schatzräuber nur an die Schätze denken, die sich darin befinden könnten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000120
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000120,
					"content": "Sie haben schon einen Plan ausgeheckt: Sie schicken einen Köder aus, um die Truppen des Ordens des Abgrunds von den Ruinen wegzulocken und entsenden dann einen erfahrenen Dieb dorthin, um den Schatz zu stehlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000121
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000121,
					"content": "Dazu haben die Chefin und der komische Vogel angeblich einen gewissen „Meisterdieb“ aus Fontaine angeheuert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000122
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000122,
					"content": "„Meisterdieb“? Ein ziemlich eindrucksvoll klingender Titel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000123,
					"content": "Ja. Er ist ein sehr außergewöhnlicher Mensch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000124
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000124,
					"content": "Der Meisterdieb genießt bei den Schatzräubern hohes Ansehen, ganz so, wie wir Abenteurer zu den großen Abenteurern aufblicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000125,
						80000127
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000125,
					"content": "Genau wie die legendäre Abenteurerin Alice?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000126
					]
				},
				{
					"id": 80000126,
					"content": "Ah, du kennst also die Verfasserin des Teyvat-Reiseführers? Genau, der Meisterdieb ist ebenso berühmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000129,
					"content": "Und obwohl sie in Liyue und Mondstadt ziemlich bekannt sind, mussten die Chefin und der komische Vogel eine Menge Überzeugungsarbeit leisten, um einen Dieb von seinem Format davon zu überzeugen, diese Operation persönlich zu beaufsichtigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000130
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000130,
					"content": "Der Rat für Allgemeine Angelegenheiten und die Millelithen haben aufgrund der jüngsten, großen Veränderungen in Liyue bereits alle Hände voll zu tun. Sie haben keine Zeit, den Gerüchten über die Machenschaften der Schatzräuber nachzugehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000131
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000131,
					"content": "Aber alles, was mit dem Abgrund zu tun hat, erweckt in mir das Gefühl, dass eine unbekannte Gefahr unter der Oberfläche lauert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000132
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000132,
					"content": "Also habe ich beschlossen, zur Abenteurergilde zu gehen, um dort eine Mission zu posten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000133,
						80000134
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000133,
					"content": "Na ja, wenn ich schon mal hier bin ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000135,
					"content": "Hmm! Überlass diese Mission uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000136,
					"content": "Oh, vielen herzlichen Dank ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000137
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000137,
					"content": "Schön zu sehen, dass die Aufgabe in den Händen eines bewährten Gildenmitglieds liegt. Also dann, viel Glück. Die Gilde wird sich um die Details dieser Mission kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000134,
					"content": "Ich kenne ebenfalls die Gefahren des Abgrunds.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000127,
					"content": "Wie der große Abenteurer Stanley?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000128
					]
				},
				{
					"id": 80000128,
					"content": "Oh, also hast du die lebende Legende persönlich getroffen, als du in Mondstadt warst? Richtig, der Meisterdieb ist genauso berühmt ist wie er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000114,
					"content": "Sie ist der „Chef“, den die Schatzräuber meinten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000115
					]
				},
				{
					"id": 80000115,
					"content": "Dann weißt du ja schon einmal etwas. Ich schätze, du bist den Schatzräubern sicher schon öfter über den Weg gelaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000116
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 800002,
			"completionStepIds": [
				800004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800004",
