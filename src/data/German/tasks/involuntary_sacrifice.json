					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80000201,
					"content": "Das ... sieht wie eine Person aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000202,
					"content": "Könnte das ... der Meisterdieb sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000203,
					"content": "Warum ist er in dieser Position? Betet er, oder was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000204,
					"content": "?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000205,
					"content": "*keuch* Da... Das ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000206,
						80000207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000206,
					"content": "Eine ... Statue der Sieben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000208
					]
				},
				{
					"id": 80000208,
					"content": "Warum hängt diese Statue der Sieben ... verkehrt herum ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000209,
					"content": "Und die Hände der Statue ... Paimon weiß, dass sie sonst eine Kugel halten, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000210,
					"content": "Aber ... DIESE Statue hält ... Was ist das denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000211,
					"content": "Äh ... Paimon hat ein ganz schlechtes Gefühl bei der Sache ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000212,
					"content": "Und der Meisterdieb hat sich keinen Zentimeter bewegt. Meinst du, dass er ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000213,
					"content": "Hallo ...? Geht es dir gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000214,
					"content": "(Es zeigt sich weder eine Reaktion noch ein Hauch von Atmung.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000215
					]
				},
				{
					"id": 80000215,
					"content": "Er ist tot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000216,
					"content": "#{NICKNAME}, Paimon hat kein gutes Gefühl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000217,
						80000218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000217,
					"content": "Was für ein entsetzlicher Ort ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000219
					]
				},
				{
					"id": 80000219,
					"content": "Hauen wir hier ab, und zwar schnell! Wir sollten das Ganyu und Lan sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000220,
					"content": "Aah! Und jetzt?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
