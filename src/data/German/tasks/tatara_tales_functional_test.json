				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721190101,
					"content": "#Oh! Äh, Reisende{M#r} ... Die Dinge sehen nicht gut aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190102,
					"content": "Die Fatui im Inneren haben ihre Kräfte in der Nähe des Kerns konzentriert. Es scheint, dass sie etwas entdeckt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190103
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190103,
					"content": "Sicherlich haben sie nicht vor, die Kernverteidigung zu durchbrechen, oder doch? Nein, wir können es uns nicht länger leisten, zu zögern. Wir müssen jetzt mit den Funktionstests beginnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190104,
					"content": "Funktionstests?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190105
					]
				},
				{
					"id": 721190105,
					"content": "Damit meine ich, dass wir die Reinigungsfähigkeiten unseres Maschinenfreundes testen müssen. Ich habe nicht die Absicht, ihn in den Ofen zu schieben, nur um dann festzustellen, dass er nicht funktionieren wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190106,
					"content": "Bitte hilf mir also, drei Onikabuto zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190107,
					"content": "Ich würde sie gerne um den Mikage-Hochofen herum platzieren, wodurch sie von den Energien hier verdorben werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190108,
					"content": "Dann werden wir sie zurückholen und dieses Reinigungsgerät benutzen, um sie zu reinigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190109,
					"content": "Dies ist der Test, den ich mir ausgedacht habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190110,
					"content": "Wo finde ich diese Onikabuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190111
					]
				},
				{
					"id": 721190111,
					"content": "Hmm, ich erinnere mich, dass sie normalerweise in Gegenden zu finden sind, die reich an Elektro-Kraft sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190112,
					"content": "Ich habe auch gehört, dass sie in der Nähe des Mikage-Hochofens überleben können. Was für zähe kleine Kerle sie doch sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190113,
					"content": "Warum nehme ich sie nicht einfach aus dem Mikage-Hochofen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190114
					]
				},
				{
					"id": 721190114,
					"content": "Nun, das könntest du tun, aber wenn du Onikabuto direkt aus dem Mikage-Hochofen zum Testen nehmen würdest ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190115,
					"content": "Um ehrlich zu sein, mache ich mir Sorgen um die Zuverlässigkeit meiner kleinen Maschine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190116,
					"content": "Am besten ist es, wenn wir es langsam angehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190117,
					"content": "*hust* Na dann ... bitte hilf mir drei Onikabuto zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190118,
						721190120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190118,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190119
					]
				},
				{
					"id": 721190119,
					"content": "Nur drei reichen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190120,
					"content": "Ich könnte auch einfach eintauchen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190121
					]
				},
				{
					"id": 721190121,
					"content": "Nun ... du könntest dich selbst als Testperson benutzen, ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190122
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190122,
					"content": "Aber wie ich schon sagte, die Zuverlässigkeit dieses Geräts wird vielleicht nicht den Erwartungen entsprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190123,
					"content": "Wenn wirklich etwas Unerwartetes während des Reinigungsprozesses passiert, könntest du ... äh, auf einige unvorhergesehene Probleme stoßen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190124,
					"content": "Ähem. Lass uns für den Moment bei der Verwendung der Onikabuto bleiben, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190125
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190125,
					"content": "Nur drei werden reichen! Sobald du sie gefangen hast, bringst du sie einfach hierher zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
