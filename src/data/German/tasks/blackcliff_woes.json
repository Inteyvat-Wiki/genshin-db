				{
					"id": 708230501,
					"content": "Und, wie ist die Lage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708230502,
						708230504
					],
					"speakerTitle": "Kuan"
				},
				{
					"id": 708230502,
					"content": "Sie ist voll von Monstern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708230503
					]
				},
				{
					"id": 708230503,
					"content": "Ist das so ... *seufz* Dann sieht es schwierig aus, die Arbeit wieder aufzunehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708230508
					],
					"speakerTitle": "Kuan"
				},
				{
					"id": 708230508,
					"content": "Ich verstehe die Situation. Bitte nimm dies als Dankeschön für deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708230509
					],
					"speakerTitle": "Kuan"
				},
				{
					"id": 708230509,
					"content": "Aber wenn es so weitergeht, werden wir um Verlängerungen bitten müssen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708230510
					],
					"speakerTitle": "Kuan"
				},
				{
					"id": 708230510,
					"content": "Nein, so geht das nicht! Ich muss einen Platz finden, wo ich mit der Arbeit anfangen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuan"
				},
				{
					"id": 708230504,
					"content": "Sie ist voll von Schatzräubern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708230505
					]
				},
				{
					"id": 708230505,
					"content": "Schatzräuber und Monster? Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708230506
					],
					"speakerTitle": "Kuan"
				},
				{
					"id": 708230506,
					"content": "Schatzräuber ... Sie werden ihr Leben nur für eine Tüte Mora verkaufen.",
					"roleType": "TALK_ROLE_NPC",
