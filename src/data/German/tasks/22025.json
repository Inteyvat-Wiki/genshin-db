					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250101,
					"content": "Ah ... Ich bin so hungrig ... Ich fühle mich nicht gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250102
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250102,
					"content": "Was ist passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250103
					]
				},
				{
					"id": 220250103,
					"content": "Ich bin mir nicht sicher ... Ich fühle mich einfach ziemlich träge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250104
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250104,
					"content": "Es war wahrscheinlich gestern Abend, als ich das Gourmet-Menü, das du gemacht hast, nach Hause genommen und gegessen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250105
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250105,
					"content": "Obwohl dieses Gericht ... ziemlich speziell war, aber es hat zumindest meinen Magen gefüllt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250106
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250106,
					"content": "Ich wollte dann ausschlafen und heute gut arbeiten, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250107
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250107,
					"content": "Jedes Mal, wenn ich kurz vor dem Einschlafen war, kam der interessante Geruch dieses Gerichts plötzlich aus der Magengrube wieder hoch! Es hat mich sofort aufgeweckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250108
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250108,
					"content": "Dieser Kreislauf ging dann weiter und ich lag im Halbschlaf, bis die Sonne aufging ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250109
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250109,
					"content": "Es ist keine große Sache, wenn es nur darum geht, weniger Schlaf zu haben. Ich habe in der Vergangenheit gelegentlich Überstunden machen müssen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250110
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250110,
					"content": "Die Hauptsache ist, was heute passiert ist! Ich dachte, dass es mir gut gehen würde, nachdem ich aufgestanden war und etwas gegessen hatte, aber ich habe nicht erwartet, dass selbst dann, wenn ich etwas anderes esse, der Geschmack des gestrigen Gerichts immer noch in meinem Mund verbleibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250111
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250111,
					"content": "Ist dieses Gericht so mächtig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250112
					]
				},
				{
					"id": 220250112,
					"content": "*seufz* Ich denke ... nur ein Gericht mit einem einzigartigen Geschmack kann diesen interessanten Geschmack überdecken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250113
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250113,
					"content": "Ein Gericht mit einem einzigartigen Geschmack? Warum gehen wir nicht herum und fragen andere, ob sie ein solches Gericht kennen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250114,
					"content": "Dann können wir einen für Tang Wen machen ... Vielleicht wird das ihr Problem lösen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250115,
					"content": "Wirklich? Das ist toll, vielen Dank! Wenn es dir passt, geh bitte nach Ritou und frag ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250116
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250116,
					"content": "Ich erinnere mich ... Li Xiao, ein Händler aus Ritou, kennt sich sehr gut mit Essen aus und Qiuyue von der Handelskompanie Chuyu, sie kann auch als halber Gourmet gelten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2202502,
			"completionStepIds": [
				2202502
