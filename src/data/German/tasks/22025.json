			"dialogs": [
				{
					"id": 220250401,
					"content": "Oh nein, wir haben unterschiedliche Antworten bekommen. Sowohl Jueyun-Schinkenreis als auch Bambussuppe mit Fleischeinlage sind besondere Gerichte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250402,
					"content": "Was sollen wir tun? Paimon ist so unentschlossen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250403,
					"content": "Was denkst du, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250404
					]
				},
				{
					"id": 220250404,
					"content": "Äh ... Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250405,
					"content": "Nun ja ... Wenn Paimon wählen müsste ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250406,
					"content": "Paimon wählt den gegrillten Tigerfisch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250407,
					"content": "Gegrillter Tigerfisch klingt sehr mutig. Wenn Fräulein Tang Wen diesen Mut runterschluckt, werden ihre Probleme gelöst sein, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250408,
						220250409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250408,
					"content": "Paimon, du weißt wirklich eine Menge über das Essen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250410
					]
				},
				{
					"id": 220250410,
					"content": "Ups, deshalb sollte Paimon dich entscheiden lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250411,
						220250412,
						220250413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250411,
					"content": "Hmm ... Der Jueyun-Schinkenreis soll es sein!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250414,
					"content": "Juhu! Lass uns schnell dieses Gericht zubereiten und es zu Tang Wen bringen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250412,
					"content": "Hmm ... Die leckere Bambussuppe mit Fleischeinlage soll es sein!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250413,
					"content": "Hmm ... Der leckere gegrillte Tigerfisch soll es sein!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250409,
					"content": "Ich glaube nicht, dass das die Geschichte dahinter ist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250410
					]
				}
			]
