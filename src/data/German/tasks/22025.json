			"dialogs": [
				{
					"id": 220250301,
					"content": "Was ist? Hmm ... Fräulein Tang Wen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250307
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250307,
					"content": "Ein seltsamer Geschmack im Mund, Appetitlosigkeit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250302
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250302,
					"content": "Ist es wirklich, weil sie etwas Seltsames gegessen hat? Du irrst dich doch nicht, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250303
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250303,
					"content": "Warum hört es sich eher so an, als ob sie nur aufgebläht ist? Hmm, lass mich nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250304
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250304,
					"content": "Vergiss es, da es keine Möglichkeit gibt, das zu beurteilen, gibt es nur ein Gericht, das ich empfehlen kann, und das ist ... Bambussuppe mit Fleischeinlage!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250305
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250305,
					"content": "Der Geschmack ist herzhaft, das Fleisch ist zart und das Aroma erfrischend und appetitlich. Am wichtigsten ist, dass die Suppe bei der Verdauung helfen kann. Hmmm! Ich wünschte, ich könnte jetzt etwas davon haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250306
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250306,
					"content": "Glaube mir, alles was Tang Wen jetzt braucht, ist die Bambussuppe mit Fleischeinlage!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiuyue"
				}
			]
		},
