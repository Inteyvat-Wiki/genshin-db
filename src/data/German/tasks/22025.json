					"Li Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250201,
					"content": "Was ist denn los? Ah ...Tang Wen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250207
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250207,
					"content": "Appetitlosigkeit ... Ein seltsamer Geschmack im Mund ... Braucht es eine besondere Delikatesse, um diese Situation zu retten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250202
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250202,
					"content": "Sie ist tatsächlich auf eine Schwierigkeit gestoßen ... Das ist wirklich ziemlich knifflig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250203
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250203,
					"content": "Aber meiner Meinung nach, muss es kein besonders teures Gericht sein. Solange der Geschmack und die Aromen einzigartig sind und es eine Wucht ist, sollte das reichen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250204
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250204,
					"content": "Ich empfehle Jueyun-Schinkenreis! Es hat sowohl eine einzigartige knusprige Konsistenz als auch einen stark würzigen Geschmack ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250205
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250205,
					"content": "Es ist mehr als zehn Jahre her, seit ich das erste Mal den Jueyun-Schinkenreis im Qingce-Dorf probiert habe, und ich denke immer noch von Zeit zu Zeit daran ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250206
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250206,
					"content": "Ich denke, wenn es der Jueyun-Schinkenreis ist, wird das Problem gelöst, egal was es ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Li Xiao"
				}
			]
		},
		{
			"id": 2202503,
