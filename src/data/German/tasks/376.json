						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37607",
							"2"
						],
						"stepId": 37607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3760601,
					"content": "Ah, Diluc! Habt Ihr zwei Diebe gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760602
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3760602,
					"content": "Was ist denn jetzt los? Plötzlich so viele Leute hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760603
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760603,
					"content": "Habt Ihr nicht davon gehört, Diluc? Zwei Diebe haben doch tatsächlich die Heilige Leier Der Himmel gestohlen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760604
					],
					"speakerTitle": "Miles"
				},
				{
					"id": 3760604,
					"content": "Ach ja? Das klingt merkwürdig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760605
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760605,
					"content": "Nicht wahr? Die heilige Leier wurde vom Anemo-Archon höchstpersönlich gespielt. Dieser wertvolle Kulturschatz ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760606
					],
					"speakerTitle": "Miles"
				},
				{
					"id": 3760606,
					"content": "Da ist doch tatsächlich jemand so dumm, etwas zu stehlen, was man nicht wieder loswird? Da hätte sich ein Einbruch in meinem Keller mehr gelohnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760607
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760608
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3760608,
					"content": "Verzeihung, ich bin vom Thema abgekommen. Einer in Gelb und einer in Grün sind eben dorthin verschwunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760609
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760609,
					"content": "Sehr gut, vielen Dank, Diluc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miles"
				}
			]
		},
		{
			"id": 37607,
			"completionStepIds": [
				37608
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
