					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3760401,
					"content": "So, Diluc, sehen die Bücher für diesen Monat aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760402
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 3760402,
					"content": "Der Sturm hat unser Geschäft stark beeinflusst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760403
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760403,
					"content": "Hoffen wir, dass er bald vorbei sein wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760404
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 3760404,
					"content": "Herr Wirt, wir wären gern an einem weniger auffälligen Platz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760405,
					"content": "Oben sind weniger Leute, wenn du das meinst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760406
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760406,
					"content": "Aber bist du kein Barde? Willst du nicht am bunten Treiben teilhaben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760407
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760407,
					"content": "Ahaha! Nächstes Mal gebe ich eine kostenpflichtige Darbietung. Dieses Mal gehen wir nach oben. Bis später!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760408,
					"content": "Beobachte diese Leute. Der Barde verhält sich sehr auffällig. Ich werde fragen, was los ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760409
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760409,
					"content": "Öh, bei wem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760410
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 3760410,
					"content": "Bei den „Sicherheitskräften“ von Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				}
			]
		},
		{
			"id": 37605,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
