			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aino"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765020101,
					"content": "#{NICKNAME} und Paimon? Wie geht’s, wie steht’s? Gibt es etwa eine superwichtige Mission, die mein Talent als Mechanikerin erfordert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020102
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020102,
					"content": "Hehe, da wir ja alte Bekannte sind, kann ich euch zwanzig Prozent Rabatt anbieten! Aber nur, wenn ihr mir ein paar Snacks bringt, und zwar heimlich, denn Ineffa darf nichts davon wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020103,
						765020104
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020103,
					"content": "Wir erkunden einfach nur die Umgebung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				},
				{
					"id": 765020105,
					"content": "Dann seid ihr hier genau richtig. In meiner Werkstatt gibt es überall funkelnde Schätze, wie ihr sie sonst nirgends findet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020106
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020106,
					"content": "Aber passt auf, wo ihr hintretet, damit ihr nicht über die herumliegenden Teile stolpert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020107,
						765020108
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020107,
					"content": "Dieser Roboter sieht ziemlich ... einzigartig aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020109,
					"content": "Haha, natürlich! Er heißt „Prügelente“. Eigentlich sollte er ein Schrottsortierroboter werden, der mir hilft, das ganze Altmetall zu trennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020110
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020110,
					"content": "Doch dann habe ich ihn versehentlich zu robust gebaut und die Arme zu beweglich gemacht. Da hatte ich einen Geistesblitz und stattete ihn kurzerhand mit starken Verteidigungsfunktionen aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020111
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020111,
					"content": "So kann er jeden ungebetenen Gast in meiner Werkstatt zu „nicht recycelbarem Abfall“ verarbeiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020112
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020112,
					"content": "Aino, deine Ideen sind genauso unkonventionell wie eh und je.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020113,
						765020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765020113,
					"content": "Das ist eine seltene Gelegenheit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020115,
					"content": "Von ... Von mir? Zusammen mit „Prügelente“? Normalerweise interessieren sich alle nur für meine Erfindungen, es kommt nur selten vor, dass jemand mich fotografieren will ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020116
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020116,
					"content": "Aber wenn ihr den Alltag einer genialen Mechanikerin wie mir und ihres unbesiegbaren kleinen Helfers festhalten wollt, dann nur zu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020117
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020117,
					"content": "Nur ... Ich mache sonst keine Fotos von mir selbst und weiß nicht, welche Pose ich einnehmen soll ... Was, wenn es am Ende nicht gut aussieht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020118,
						765020119
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020118,
					"content": "Ganz, wie du dich gewöhnlich verhältst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020120,
					"content": "Also gut, dann überlasse ich das ganz dir! Und vergiss nicht, auch „Prügelente“ in all ihrer Pracht aufs Foto zu bekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020119,
					"content": "Ich werde mein Bestes geben, den perfekten Moment einzufangen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020114,
					"content": "Darf ich ein Foto von dir machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020108,
					"content": "Zählt er auch zu deinen „kleinen Helfern“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020104,
					"content": "Wir suchen einfach nur nach Motiven für unsere Aufnahmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				}
			]
		},
