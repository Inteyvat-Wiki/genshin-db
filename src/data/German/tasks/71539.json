					"nextDialogs": [
						715390104
					]
				},
				{
					"id": 715390104,
					"content": "Natürlich, es ist schließlich das alljährliche Laternenritual. Wir müssen uns also in festliche Stimmung versetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715390105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715390105,
					"content": "Komm schon, komm schon! Paimon hat so viele Ideen für die Glückwunschkarten. Du wirst sie lieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715390106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715390106,
					"content": "Wenn du sie bastelst, werde ich sie auf jeden Fall lieben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715390107
					]
				},
				{
					"id": 715390107,
					"content": "#Hehe, deine wird Paimon auch ganz toll finden, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715390108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715390108,
					"content": "Hach, genug davon. Fangen wir schnell mit dem Basteln an.",
