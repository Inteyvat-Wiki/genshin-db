				"objectNames": [
					"Hongyi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190301,
					"content": "Was ist denn mit diesem Brunnen los ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190302
					],
					"speakerTitle": "Hongyi"
				},
				{
					"id": 718190302,
					"content": "Geschenke-Lieferung zum Laternenritual.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190303
					]
				},
				{
					"id": 718190303,
					"content": "Oh, das muss vom Rat für Allgemeine Angelegenheiten sein. Vielen Dank, ich nehme es gerne an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190304
					],
					"speakerTitle": "Hongyi"
				},
				{
					"id": 718190304,
					"content": "Dennoch muss ich hier noch eine Weile meinen Dienst versehen, um sicherzugehen, dass niemand hier Wasser von diesem Brunnen holt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190305
					],
					"speakerTitle": "Hongyi"
				},
				{
					"id": 718190305,
					"content": "*seufz* Wer weiß schon, was wirklich damit los ist ... Aber wie dem auch sei, jetzt darf niemand dieses Wasser trinken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hongyi"
				}
			]
		},
		{
			"id": 7181904,
			"completionStepIds": [
				7181905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
