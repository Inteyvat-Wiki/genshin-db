			"trigger": {
				"objectNames": [
					"Wangya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190101,
					"content": "Ich weiß schon nicht gar nicht mehr, ob ich gekommen bin oder bereits am Gehen war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190102
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190102,
					"content": "Stimmt etwas nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190103
					]
				},
				{
					"id": 718190103,
					"content": "Keine Sorge, ich versuche nur, alles zu regeln, was für das Laternenritual erledigt werden muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190104
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190104,
					"content": "Aber das Dumme ist ... Je mehr ich darüber nachdenke, umso mehr Probleme fallen mir ein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190105
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190105,
					"content": "Wenn mir meine Kollegen auch ein bisschen Arbeit abgenommen haben, bin ich dieses Jahr für die Koordinierung der Laternen-Lieferung zuständig. Wenn ich mich nicht beeile und alles vorbereite, werde ich nie rechtzeitig fertig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190106,
						718190107
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190106,
					"content": "Laternen-Lieferung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190108
					]
				},
				{
					"id": 718190108,
					"content": "Stimmt ... Als ich sagte „Laternen-Lieferung“, meinte ich damit mehr, als einfach nur Laternen auszuliefern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190109
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190109,
					"content": "Einfach gesagt ... geht es dabei eher um die Rolle des Laternenritual-Botschafters, also die Weitergabe von Glück- und Besserungswünschen wie auch das Erzeugen einer festlichen Stimmung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190110
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190110,
					"content": "Wenn auch die meisten Menschen zur Zeit des Fests freihaben, zu denen auch einige Ladeninhaber und ihre Mitarbeiter gehören ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190111
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190111,
					"content": "Gibt es trotzdem auch Menschen, die wichtige Arbeiten verrichten und sich nicht einfach freinehmen können. Wie die Millelithen zum Beispiel, die während den Feierlichkeiten für Ordnung sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190112
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190112,
					"content": "Der Rat für Allgemeine Angelegenheiten schickt ihnen normalerweise immer Geschenke zu, um ihre harte Arbeit in Zeiten des Laternenrituals zu würdigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190113
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190113,
					"content": "Ich wollte gerade die Millelithen besuchen, die für die Sicherheit unserer Stadt verantwortlich sind, um ihnen als Zeichen der Dankbarkeit ein paar Laternen zu schenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190114
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190114,
					"content": "Allerdings ... sind wir derzeit ein bisschen unterbesetzt, und ich habe es noch nicht geschafft, allen Soldaten auf unserer Liste ihr Geschenk zu bringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190115
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190115,
					"content": "Könntest du mir einen Gefallen tun und diese Geschenke ausliefern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190116
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190116,
					"content": "Ich werde es natürlich tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190117
					]
				},
				{
					"id": 718190117,
					"content": "Wirklich? Das ist ja fantastisch! Vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190118
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190118,
					"content": "Wer sind die glücklichen Empfänger?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190119
					]
				},
				{
					"id": 718190119,
					"content": "Mal sehen ... Welche der Millelithen haben noch nichts bekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190120
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190120,
					"content": "Xiangming ... Hongyi ... und Cai Le.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190121
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190121,
					"content": "Ich werde ihre Standorte für dich markieren. Ich kann dir nicht genug für deine Hilfe danken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190107,
					"content": "An wie viele Menschen musst du denn Laternen ausliefern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190108
					]
				}
			]
		},
		{
			"id": 7181902,
			"completionStepIds": [
				7181902
