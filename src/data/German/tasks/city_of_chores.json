			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yi Xian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190401,
					"content": "*schluchz* Ich habe meinen Wunsch noch nicht fertig geschrieben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190402
					],
					"speakerTitle": "Yi Xian"
				},
				{
					"id": 718190402,
					"content": "Sei ein braves Mädchen, Yi Xian. Der nette Onkel von den Millelithen ist extra losgegangen, um sie dir zurückzubringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190403
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190403,
					"content": "Cai Le ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190404
					]
				},
				{
					"id": 718190404,
					"content": "Suchst du diesen netten Millelithen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190405
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190405,
					"content": "Meine Yi Xian hat gerade ihren Wunsch auf eine Laterne geschrieben, als ihr diese plötzlich aus der Hand rutschte und fortflog ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190406
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190406,
					"content": "Dieser Millelithe sagte, er hätte die Laterne in einem Baum hängen gesehen und ging los, um sie für uns zu holen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190407,
						718190408
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190407,
					"content": "Was ist denn so besonders an dieser Laterne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				},
				{
					"id": 718190409,
					"content": "Ich habe ihr gesagt, dass wir eine neue machen können, aber sie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190410
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190410,
					"content": "Oh ... Nein ... Das geht nicht. Mein Bruder hat so lange und hart an dieser Laterne gearbeitet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190411
					],
					"speakerTitle": "Yi Xian"
				},
				{
					"id": 718190411,
					"content": "Der nette Onkel bringt sie uns sicher ganz schnell wieder zurück, Yi Xian ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190412
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190412,
					"content": "Entschuldigung bitte. Wenn du wirklich mit diesem Millelithen sprechen möchtest, findest du ihn da drüben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190408,
					"content": "Kannst du nicht einfach eine neue machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				}
			]
		},
		{
			"id": 7181905,
			"completionStepIds": [
				7181906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
