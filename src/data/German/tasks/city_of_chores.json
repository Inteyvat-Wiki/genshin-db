			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiangming"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190201,
					"content": "Hmm? Brauchst du irgendwas? Ich bin hier gerade im Dienst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190202
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190202,
					"content": "Geschenke-Lieferung zum Laternenritual.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190203
					]
				},
				{
					"id": 718190203,
					"content": "Sprich leiser! Ich arbeite hier ... was für ein Geschenk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190204
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190204,
					"content": "Oh, vom Rat für Allgemeine Angelegenheiten? Ich verstehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190205
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190205,
					"content": "Ein neues Jahr, ein neues Laternenritual. Und dieses Jahr wollte ich eigentlich mal früher zu Hause sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190206
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190206,
					"content": "Aber bei der aktuellen Situation kann ich mich einfach noch nicht entspannen ... Also werde ich wohl wieder mal ein paar Stunden später zu Hause sein als sonst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190207
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190207,
					"content": "Danke, dass du diesen weiten Weg gemacht hast. Ich nehme es gerne an. Vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190208
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190208,
					"content": "*seufz* Wann wird dieser Mensch wohl endlich wieder abhauen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangming"
				}
			]
		},
