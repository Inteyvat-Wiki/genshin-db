			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wangya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190701,
					"content": "Du bist wieder da! Wie ist es mit der Geschenke-Lieferung gelaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190702
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190702,
					"content": "Alle haben ihre Geschenke bekommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190703
					]
				},
				{
					"id": 718190703,
					"content": "Du hast mich gerettet ... Ohne dich hätte ich das nie geschafft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190704
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190704,
					"content": "Müssen sie etwa das ganze Fest über ihren Dienst versehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190705
					]
				},
				{
					"id": 718190705,
					"content": "Nun ... Der Rat für Allgemeine Angelegenheiten wird Wechselschichten für sie planen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190706
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190706,
					"content": "Aber Liyue ist wirklich groß. Es gibt zu viele Stationen und Orte, an denen patrouilliert werden muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190707
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190707,
					"content": "Wir haben einfach nicht genügend Rekruten. Selbst wenn sie sich abwechseln, werden einige von ihnen Pech haben und während des Laternenrituals arbeiten müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190708
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190708,
					"content": "Wenn man außerdem bedenkt, wie gewaltig die Laternenritual-Feiern jedes Jahr ausfallen, werden bestimmte Teile der Stadt noch zusätzliche Ressourcen benötigen. Wir werden nie genügend Leute haben, ganz egal wie wir sie aufteilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190709,
						718190710
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190709,
					"content": "Das klingt wirklich nach einer großen Herausforderung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				},
				{
					"id": 718190711,
					"content": "Nun, das ist eben unsere Aufgabe ... Wir werden alles tun, was in unserer Macht steht, damit auch jeder hier ein schönes Laternenritual feiern kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190712
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190712,
					"content": "Das erinnert mich an andere Menschen, die in den Zeiten des Fests Hilfe gebrauchen könnten. Es wäre schön, wenn du ihnen zur Hand gehen könntest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190713
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190713,
					"content": "Je mehr Leute wir ermutigen, am Laternenritual teilzunehmen, umso festlicher wird die Stimmung am Ende sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190714
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190714,
					"content": "Wir senden Laternen aus, weil wir möchten, dass jeder eine Laterne aufsteigen lassen kann und sich etwas wünschen darf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190715
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190715,
					"content": "Im weiteren Sinne ... möchten wir, dass sich das Laternenritual immer weiter verbreitet. Es wäre toll, wenn wirklich jeder die Stimmung eines Laternenrituals erleben könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190716
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190716,
					"content": "Immerhin ist das Laternenritual für alle bestimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190717
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190717,
					"content": "In Ordnung, die Pflicht ruft. Ich hoffe, dass du beim Laternenritual eine schöne Zeit verbringen kannst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718190710,
					"content": "Das hört sich wirklich schwierig an.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				}
			]
		},
