			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cai Le"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190501,
					"content": "Um der Götter willen ... Wie komme ich da nur hinauf? Vielleicht sollte ich etwas anderes ausprobieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190502
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190502,
					"content": "Was machst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190503
					]
				},
				{
					"id": 718190503,
					"content": "#{F#Reisende}{M#Reisender}? Haha, nichts Besonderes. Ich versuche nur, auf den Baum zu gelangen und diese Laterne zu erwischen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190504
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190504,
					"content": "Aber in voller Rüstung ist die Schwerkraft nicht zu unterschätzen ... ich rutsche immer wieder hinunter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190505
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190505,
					"content": "Ähem ... Würdest du mir vielleicht kurz helfen? Für dich ist es bestimmt leichter, diese Laterne zu erreichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190506
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190506,
					"content": "Ich werde es natürlich tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190507
					]
				},
				{
					"id": 718190507,
					"content": "Super, vielen Dank. Lass uns das so schnell wie möglich erledigen, damit das kleine Mädchen nicht mehr traurig sein muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cai Le"
				}
			]
		},
		{
			"id": 7181906,
			"completionStepIds": [
				7181908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181908",
							"2"
						],
						"stepId": 7181908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cai Le"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190601,
					"content": "Hast du die Laterne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190602
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190602,
					"content": "Na klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190603
					]
				},
				{
					"id": 718190603,
					"content": "Lass mich mal sehen ... Ja, das ist sie. Du hast diesen Kindern wahrlich den Tag gerettet. Ich werde sie ihnen zurückgeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190604
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190604,
					"content": "Hoffentlich warten sie immer noch dort, wo ich sie stehengelassen habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190605
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190605,
					"content": "Dieses Geschenk ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190606
					]
				},
				{
					"id": 718190606,
					"content": "Das muss vom Rat für Allgemeine Angelegenheiten sein. In Ordnung, ich nehme es dankend an. Und vielen Dank für deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190607
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190607,
					"content": "War das ebenfalls deine Pflicht als Mitglied der Millelithen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190608
					]
				},
				{
					"id": 718190608,
					"content": "Verlorengegangene Laternen suchen, meinst du? Hahahah, aber natürlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190609
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190609,
					"content": "Es macht im Grunde keinen Unterschied, ob man Laternen sucht, Übeltätern nachjagt oder Monster bekämpft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190610
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190610,
					"content": "Wahre Millelithen haben stets die Pflicht, den Bedürftigen zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190611
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190611,
					"content": "Nochmals vielen Dank. Ich gehe lieber wieder schnell zurück und gebe sie den Kindern zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190612
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190612,
					"content": "Und dann habe ich noch ein paar andere Dinge zu erledigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cai Le"
				}
			]
		},
		{
			"id": 7181907,
			"completionStepIds": [
				7181909
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181909",
							"2"
						],
						"stepId": 7181909,
						"stateName": "QUEST_STATE_UNFINISHED"
