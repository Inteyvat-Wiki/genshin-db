			"dialogs": [
				{
					"id": 751750101,
					"content": "Während du in das flüssige Phlogiston eintauchst, erscheinen Bilder wie warme Erinnerungen direkt vor deinem geistigen Auge.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750102
					]
				},
				{
					"id": 751750102,
					"content": "Am Becken mit dem fließendem Feuer führen ein silberweißer und ein ascheüberzogener Schatten folgendes Gespräch ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750103
					]
				},
				{
					"id": 751750103,
					"content": "„Die Überprüfungsexperimente der zweiten Phase sind abgeschlossen. Das, was alles reinigen und weiterentwickeln wird, nenne ich ‚Huitzilopochtli‘ oder ‚Himmlische Feuerwelle‘ ...“",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750104
					]
				},
				{
					"id": 751750104,
					"content": "„Es spielt keine Rolle mehr, an diesem Ort werden Namen früher oder später bedeutungslos.“",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750105
					]
				},
				{
					"id": 751750105,
					"content": "„Gegen die Korrosion muss die ‚Sternhäufung‘ aktiviert und aktiv gebunden werden, um den Einfluss des Abgrunds durch Selbstzerstörung zu vernichten, bevor die vollständige Verzerrung eintritt ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750106
					],
					"speakerTitle": "Ins Becken tauchen"
				},
				{
					"id": 751750106,
					"content": "Aber wie kannst du die befallenen Subjekte genau identifizieren? Eine kontrollierbare Probe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750107
					],
					"speakerTitle": "Ins Becken tauchen"
				},
				{
					"id": 751750107,
					"content": "Bist du wahnsinnig? Du experimentierst an dir selbst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750108
					],
					"speakerTitle": "Ins Becken tauchen"
				},
				{
					"id": 751750108,
					"content": "„Das ist doch gut so. Auf diese Weise kann dieser verfallene, verrottete Körper wenigstens noch einen Nutzen erfüllen.“",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750109
					]
				},
				{
					"id": 751750109,
					"content": "Also, nach dem Start dieses Systems bist ausgerechnet du derjenige, der die geringste Überlebenschance hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750110
					],
					"speakerTitle": "Ins Becken tauchen"
				},
				{
					"id": 751750110,
					"content": "Hat der Abgrund nun endlich auch deinen Verstand zerfressen ... oder willst du nur dein ganzes Volk als Grabbeigabe für dein Begräbnis opfern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750111
					],
					"speakerTitle": "Ins Becken tauchen"
				},
				{
					"id": 751750111,
					"content": "„Hast du so wenig Vertrauen in dein eigenes Volk? Alle anderen Herrscher haben bereits zugestimmt.“",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750112
					]
				},
				{
					"id": 751750112,
					"content": "Sie folgen blind deinem Plan, ohne die wahre Bedeutung dahinter zu verstehen ... Ich werde dem nicht zustimmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750113
					],
					"speakerTitle": "Ins Becken tauchen"
				},
				{
					"id": 751750113,
					"content": "„Ist auch egal. Zerstörung ... bedeutet auch Wiedergeburt, ich habe mich bereits entschieden.“",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750114
					]
				},
				{
					"id": 751750114,
					"content": "„Ha ... Ich bin jeden Tag nur noch für so kurze Zeit bei Bewusstsein. Jedenfalls werde ich es aktivieren, sobald alles bereit ist.“",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750115
					]
				},
				{
					"id": 751750115,
					"content": "Gibt es wirklich keinen anderen Ausweg? Ich versuche noch, eine andere Lösung zu finden ... Stürzt du die Welt wirklich nicht aus persönlicher Rache in den Abgrund?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750116
					],
					"speakerTitle": "Ins Becken tauchen"
				},
				{
					"id": 751750116,
					"content": "„Vielleicht ja. Um den großen Feind, der in den Schatten lauert, von der Welt fernzuhalten, werde ich vor nichts zurückschrecken.“",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750117
					]
				},
				{
					"id": 751750117,
					"content": "„Ha, und das Gerede von einer anderen Lösung ... Glaubst du wirklich, du könntest von diesen ‚Menschen‘ bekommen, was du suchst? Du steckst bereits viel zu tief drin ...“",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750118
					]
				},
				{
					"id": 751750118,
					"content": "„Ich habe versucht, es dir begreiflich zu machen ... Aber genau wie bei jenem Volk, das in den Flammenbecken nach Weisheit suchte, sind Wissen und wahre Akzeptanz zwei verschiedene Dinge.“",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750119
					]
				},
				{
					"id": 751750119,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750120
					],
					"speakerTitle": "Ins Becken tauchen"
				},
				{
					"id": 751750120,
					"content": "„Wenn du denkst, dass ich nur einfach Zerstörung will und du selbst eine Welt erschaffen möchtest ... dann komm, halte mich auf, töte mich und beweise es mir!“",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750121
					]
				},
				{
					"id": 751750121,
					"content": "„Aber eines Tages, das ist keine Prophezeiung, Kukulkan, nur ein Rat von jemandem, der diesen Weg gegangen ist ... eines Tages ...“",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750122
					]
				},
				{
					"id": 751750122,
					"content": "„... wirst du denselben Weg wie ich beschreiten.“",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}