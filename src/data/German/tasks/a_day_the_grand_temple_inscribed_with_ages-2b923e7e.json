					},
					{
						"sceneId": 103,
						"position": [
							156.335,
							170.333,
							410.095
						],
						"pointId": 108
					},
					{
						"sceneId": 103,
						"position": [
							154.182,
							170.359,
							413.867
						],
						"pointId": 18
					}
				]
			},
			"dialogs": [
				{
					"id": 760950301,
					"content": "Istoria, jetzt sind die drei Gebiete im Grunde befreit. Und fast alle Leute sind gerettet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950302,
					"content": "Wir haben auch alles wiedergefunden, was Zeitlind verloren hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950303,
					"content": "Oh, vielen Dank euch! Nihilita hat wirklich einen guten Blick, seit er die Augen geöffnet hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950304
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950304,
					"content": "Jetzt musst du uns aber auch sagen, wie wir nach oben kommen und was der Preis dafür ist, von dem du gesprochen hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950305,
					"content": "Wenn es nur wieder ein paar kleine Abenteuer sind oder es einfach nur ein paar Mora kostet, hat Paimon keine Angst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950306,
					"content": "Ach ja, und wie bringen wir Zeitlind eigentlich wieder nach unten? Sie hat hier doch alles erledigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950307,
					"content": "Dazu kommen wir schon noch. Aber ruht euch jetzt erst mal aus. Morgen erkläre ich euch alles ganz genau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950308
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950308,
					"content": "Na gut. Aber hier gibt es doch gar keine Betten und nichts zu essen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950309,
					"content": "Bedürfnisse gibt es hier aber auch nicht mehr, ist dir das nicht aufgefallen? Du bist schon so lange hier, aber hast weder Hunger noch bist du müde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950310
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950310,
					"content": "Waah, aber wie soll Paimon sich denn die Zeit vertreiben, wenn wir uns mal einen Tag ausruhen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950311,
					"content": "Hier gibt es alle möglichen sonderbaren Gestalten aus allen Zeitaltern der Geschichte. Mit ihnen zu quatschen wäre doch sicher ganz interessant, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950312
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950312,
					"content": "#Na gut. Aber Schlafen ist nun mal Paimons Grundrecht! Selbst wenn Paimon nicht müde ist, wird Paimon auf {NICKNAME}s Kopf schlafen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950313,
					"content": "Zeitlind, wenn du dich ausgeruht hast, möchte ich mit dir reden. Und zwar über das, was ich vorhin schon erwähnt habe. Du weißt schon, die Sache, für die ich Zeit zum Nachdenken brauchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950314
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950314,
					"content": "Dann komm mich später besuchen und wir reden, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950315
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950315,
					"content": "Gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950316
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950316,
					"content": "#{NICKNAME} und Paimon, wenn ihr euch gut ausgeruht habt, dann kommt doch rüber zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		},
