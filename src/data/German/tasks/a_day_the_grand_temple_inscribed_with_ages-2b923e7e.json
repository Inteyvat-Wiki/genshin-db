					}
				]
			},
			"dialogs": [
				{
					"id": 760950501,
					"content": "Fühlst du dich ausgeruht? Hast du mit all den spannenden Leuten über das gesprochen, was dich interessiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950502,
						760950504
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950502,
					"content": "Noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760950503
					]
				},
				{
					"id": 760950503,
					"content": "Dann erhol dich noch gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950506
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950506,
					"content": "Zeitlind, bitte bleib jetzt ganz ruhig und hör mir zu. Ich will nicht respektlos sein und ich bilde mir das auch nicht ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950507
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950507,
					"content": "Deine Schwester müsste noch am Leben sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950508
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950508,
					"content": "Ich habe doch den Grabstein gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950509
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950509,
					"content": "Es war sogar ein Foto meiner Schwester auf dem Grabstein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950510
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950510,
					"content": "Aber unter dem Grabstein könnte doch auch einfach ... nichts sein, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950511
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950511,
					"content": "Obwohl Paimon auch hofft, dass es Zeitlinds Schwester gut geht ... findet Paimon doch, dass du da etwas zu optimistisch bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950512,
					"content": "Meine Schwester schrieb in ihrem letzten Brief an mich, dass sie fest entschlossen ist, zu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950513
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950513,
					"content": "Mit diesem Abschied meinte sie sicher nicht, dass sie ihr Leben beenden möchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950514
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950514,
					"content": "Sie sagte, sie würde an einen sehr weit entfernten Ort gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950515
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950515,
					"content": "Das hat sie mir auch erzählt. Ihr Traum war es immer, einmal um die Welt zu reisen, bevor sie alt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950516
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950516,
					"content": "Hilda meinte das auch wortwörtlich so. Sie hat das Sanatorium verlassen, um die Welt zu bereisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950517
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950517,
					"content": "Sie hat dir sogar davon erzählt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950518
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950518,
					"content": "Sie steckte immer voller Heiterkeit und kam mit allen sehr gut aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950519
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950519,
					"content": "Dann hat sie dir bestimmt nicht erzählt, dass wir keine anderen Verwandten mehr haben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950520
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950520,
					"content": "Das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950521
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950521,
					"content": "Lass mich das mal kurz ganz nüchtern betrachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950522
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950522,
					"content": "Wenn ihr Fortgehen drei oder vier Menschen das Herz gebrochen hätte, dann hätte diese Schwere vielleicht ihre eigene Trauer überwogen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950523
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950523,
					"content": "Aber jetzt bin nur noch ich übrig. Und sie weiß, dass ich sie verstehe. Ich würde ihr verzeihen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950524
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950524,
					"content": "Nein, so solltest du nicht denken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950525
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950525,
					"content": "Du musst mich nicht bemitleiden. Als wir klein waren, gab es unsere Eltern noch, wir waren glücklich. Diese Erinnerungen reichten aus, um uns beim Großwerden zu unterstützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950526
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950526,
					"content": "Aber wenn man älter wird, dann wird auch das Leben härter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950527
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950527,
					"content": "Schon als Kind war ich eher introvertiert. Der Umgang mit Menschen bei der Arbeit kostet mich daher besonders viel Kraft. Ich dachte eigentlich, dass meine extrovertierte Schwester sich da schon eher wie ein Fisch im Wasser fühlen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950528
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950528,
					"content": "Aber seit meine Schwester erwachsen ist, steht selbst ihr die Erschöpfung ständig ins Gesicht geschrieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950529
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950529,
					"content": "Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950530,
					"content": "Ihr habt noch eine Zukunft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950531
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950531,
					"content": "Oh, dann hat sie dir anscheinend auch nichts von ihrem Verlobten erzählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950532
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950532,
					"content": "Ein normaler, guter Mensch, und auch ein interessanter. Aber manchmal hätte ich mir gewünscht, er wäre das nicht gewesen. Wäre er ein schlechter Mensch gewesen, wäre vielleicht einiges leichter gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950533
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950533,
					"content": "In seiner Familie gibt es eine Veranlagung für eine seltsame Krankheit, niemand von ihnen hat wirklich ein hohes Alter erreicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950534
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950534,
					"content": "Er machte sich oft darüber lustig: Es sei die Schuld des Anemo-Archons, der Mondstadt so gut geplant habe, dass sogar eine Blutlinie wie seine, die eigentlich nicht lange bestehen sollte, überlebt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950535
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950535,
					"content": "Später meinte er einmal, dass er die Welt retten müsse. Und dann ist er gegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950536
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950536,
					"content": "Die Welt retten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950537
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950537,
					"content": "Nun, unsere Welt dreht sich noch immer, vielleicht liegt das ja wirklich daran, dass er die Welt gerettet hat, irgendwo, wo niemand etwas davon mitbekommen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950538
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950538,
					"content": "Sagt ihr nicht immer, „Wenn jemand, der ewig lebt, nicht jeden lieben und von jedem geliebt werden kann, würde dann die Welt nicht in Kummer untergehen?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950539
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950539,
					"content": "Das ergibt Sinn. Scheint also, dass dann die Liebe für ein kürzeres Leben nicht geeignet ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950540
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950540,
					"content": "Er wollte sein Leben der Liebe geben. Das Ergebnis war nur, dass meine Schwester noch mehr verletzt wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950541
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950541,
					"content": "So sehr, dass sie sogar in das Sanatorium in den Bergen geschickt wurde. Genau das hier unter unseren Füßen, dieses im wahrsten Sinne verfluchte Sanatorium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950542
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950542,
					"content": "Sie hat mir nie davon erzählt. Das tut mir leid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950543
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950543,
					"content": "Glaubst du, nachdem du das alles gehört hast, nun immer noch, dass meine Schwester lebt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950544
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950544,
					"content": "Ja, das tue ich. Denn sie hat hier etwas getan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950545
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950545,
					"content": "Wegen meiner Feigheit musste sie weiterleben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950546
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950546,
					"content": "Ich respektiere dich sehr, Istoria. Aber ich denke, du hast im Verlauf der Geschichte vielleicht schon zu viel Leid gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950547
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950547,
					"content": "Genug Leid, dass die ganze Welt darin ertrinken könnte ... Doch schon eine Handvoll genügt, um ein gewöhnliches Leben wie meines zu begraben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950548
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950548,
					"content": "Du kannst meine Schwester und mich nicht wirklich verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950549
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950549,
					"content": "Also, wie komme ich wieder an die Oberfläche? Ich bin nur ein unbedeutendes kleines Licht mit einem kurzen Leben. Die Ewigkeit ist nichts für mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950550
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950550,
					"content": "*seufz* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950551
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950551,
					"content": "Herr Istoria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950552
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950552,
					"content": "Ursprünglich waren Himmel und Erde hier voneinander getrennt, sodass es für uns unmöglich war, diesen Ort zu verlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950553
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950553,
					"content": "Aber seit Nihilita vom Himmel gefallen ist, scheint Dex die Fertigkeit zu besitzen, euch Leute aus der gegenwärtigen Welt zwischen der Säulenhalle und dem Boden hin und her zu befördern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950554
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950554,
					"content": "Aber er kann die, die auserwählt wurden, hierherzukommen, nicht mitnehmen, denn er ist die juvenile Form eines Wächters. Und dies ist eine Regel, die tief in ihm verankert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950555
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950555,
					"content": "Was? Dex und Nihilita gehören also zur selben Sorte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950556
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950556,
					"content": "♪ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950557
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950557,
					"content": "Wenn wir nach unten wollen, müssen wir all unsere Erinnerungen und unser Wissen aufgeben und bis zur Spitze hinaufsteigen. Früher taten wir das, um eine Audienz bei der Meisterin zu erhalten, heute ist es für eine Audienz bei Melanta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950558
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950558,
					"content": "Ich kann also nicht mit euch gehen. Bitte lasst mich euch Lebewohl sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950504,
					"content": "Ich fühl mich wieder fit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760950505
					]
				},
				{
					"id": 760950505,
					"content": "Dann ist ja gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950506
					],
					"speakerTitle": "Istoria"
				}
			]
		},
