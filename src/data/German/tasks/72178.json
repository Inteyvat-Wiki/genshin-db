				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721780201,
					"content": "Hier gibt es auch einen Schrein. Sollen wir ihn uns ansehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780202,
					"content": "(Gewöhnlich aussehender Schrein, ohne besondere elementare Spuren.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780203
					],
					"speakerTitle": "Schrein"
				},
				{
					"id": 721780203,
					"content": "Untersuchen",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780204
					]
				},
				{
					"id": 721780204,
					"content": "(Dieser Schrein sieht sauber und aufgeräumt aus und verströmt einen schwachen Duft der heiligen Sakura. Vielleicht hat hier jemand vor nicht allzu langer Zeit gebetet.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780205
					],
					"speakerTitle": "Schrein"
				},
				{
					"id": 721780205,
					"content": "(Aber ansonsten gibt es keine neueren Spuren.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780206
					],
					"speakerTitle": "Schrein"
				},
				{
					"id": 721780206,
					"content": "Es ist der Geruch von Blüten der heiligen Sakura ... Choujis Mutter könnte hier gewesen sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780207,
					"content": "Und unlängst auch noch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7217803,
			"completionStepIds": [
				7217804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
