			"dialogs": [
				{
					"id": 721780101,
					"content": "(Gewöhnlich aussehender Schrein, ohne besondere elementare Spuren.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780102
					],
					"speakerTitle": "Schrein"
				},
				{
					"id": 721780102,
					"content": "Untersuchen",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780103
					]
				},
				{
					"id": 721780103,
					"content": "(Der Schrein scheint in gutem Zustand zu sein und scheint vor nicht allzu langer Zeit gut gepflegt worden zu sein. Wer auch immer sich um diesen Ort gekümmert hat, mag eine sorgfältige Person gewesen sein.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780104
					],
					"speakerTitle": "Schrein"
				},
				{
					"id": 721780104,
					"content": "(Aber ansonsten gibt es keine Anzeichen dafür, dass jemand hier war.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780105
					],
					"speakerTitle": "Schrein"
				},
				{
					"id": 721780105,
					"content": "Seltsam also ... es sieht so aus, als ob jemand hier gewesen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7217802,
			"completionStepIds": [
				7217803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217801",
