				"points": []
			},
			"dialogs": [
				{
					"id": 721780301,
					"content": "Dieser Schrein sieht so neu aus. Lass uns ihn untersuchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780302,
					"content": "(Gewöhnlich aussehender Schrein, ohne besondere elementare Spuren.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780303
					],
					"speakerTitle": "Schrein"
				},
				{
					"id": 721780303,
					"content": "Untersuchen",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780304
					]
				},
				{
					"id": 721780304,
					"content": "(Das Holz dieses Schreins ist schon etwas älter, aber gute Pflege hat das stumpfe Äußere eher charmant als abgenutzt aussehen lassen.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780305
					],
					"speakerTitle": "Schrein"
				},
				{
					"id": 721780305,
					"content": "Es scheint, dass jemand oft hierherkommt ... und sich um diesen Schrein kümmert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7217804,
			"completionStepIds": [
				7217805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
