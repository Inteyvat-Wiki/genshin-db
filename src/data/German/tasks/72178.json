			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721780401,
					"content": "Das ist der Schrein, von dem Chouji gesprochen hat, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780402,
					"content": "(Gewöhnlich aussehender Schrein, ohne besondere elementare Spuren.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780403
					],
					"speakerTitle": "Schrein"
				},
				{
					"id": 721780403,
					"content": "Untersuchen",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780404
					]
				},
				{
					"id": 721780404,
					"content": "(Der Schrein ist schlicht, aber elegant. Sein Holz schimmert schwach durch Lichtströme und empfängt die Opfer der Besucher mit einer würdevollen Stille).",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780405
					],
					"speakerTitle": "Schrein"
				},
				{
					"id": 721780405,
					"content": "(Es gibt viele heilige Sakura-Blütenblätter, die rund um den Schrein verstreut sind. Es scheint so, als wären sie nicht natürlich entstanden, sondern als hätte jemand absichtlich Sakura-Blüten hierhingestreut).",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780406
					],
					"speakerTitle": "Schrein"
				},
				{
					"id": 721780406,
					"content": "Nun ... Auch hier ist keine Spur davon zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780407,
						721780408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780407,
					"content": "Schau mal, Sakura-Blüten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780409
					]
				},
				{
					"id": 721780409,
					"content": "Oh ja, Chouji erwähnte, dass seine Mutter sowas im Schrein dargebracht hatte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780410,
					"content": "So viele Blütenblätter erscheinen hier ... das sollte kein Zufall sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780411,
					"content": "Lass uns zurückgehen und es ihm sagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780408,
					"content": "Das sind Opfergaben von Choujis Mutter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780409
					]
				}
			]
		},
