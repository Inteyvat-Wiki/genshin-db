			"dialogs": [
				{
					"id": 721780501,
					"content": "Hier gibt es auch einen Schrein, er sieht so vertraut aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780502,
					"content": "(Gewöhnlich aussehender Schrein, ohne besondere elementare Spuren.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780503
					],
					"speakerTitle": "Schrein"
				},
				{
					"id": 721780503,
					"content": "Untersuchen",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780504
					]
				},
				{
					"id": 721780504,
					"content": "(Der Schrein sieht etwas baufällig aus, die hölzerne Hülle ist angefressen und verblasst und zeigt an einigen Stellen Spuren von bedrohlichem Dunkelrot).",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780505
					],
					"speakerTitle": "Schrein"
				},
				{
					"id": 721780505,
					"content": "Dieser Schrein ... Er ist unheimlich und gruselig ... Ich habe schon Gänsehaut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780506,
					"content": "Lass uns hier verschwinden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
