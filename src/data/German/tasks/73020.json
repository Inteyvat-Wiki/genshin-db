			},
			"dialogs": [
				{
					"id": 730200501,
					"content": "(Die Pilze scheinen tatsächlich etwas größer zu sein. Es ist am besten, ihn später zu pflücken, sobald die Verwelkung beseitigt ist ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Kopfpilz“"
				}
			]
		}
	]
