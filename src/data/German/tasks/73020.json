			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arachatora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200401,
					"content": "„Kopfpilz“ gefunden, Kochausbildung abgeschlossen, großen und zuverlässigen Nara kennengelernt. Ich bin außer mir vor Freude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200402
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200402,
					"content": "#Arapacati, Arasaka, Arapas und Araphala sind dir bestimmt auch sehr dankbar. Nara {NICKNAME}, du bist ein guter Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200403
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200403,
					"content": "Warum bei mir bedanken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200404
					]
				},
				{
					"id": 730200404,
					"content": "Denn indem du mir hilfst, gibst du ihnen die Chance, den „Kopfpilz“ zu probieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arachatora"
				}
			]
		},
		{
			"id": 7302005,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
