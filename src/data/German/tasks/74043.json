			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Henri"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740430201,
					"content": "Protest! Protest! Ich protestiere für meine Rechte als Arbeiter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430202,
						740430204,
						740430206
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430202,
					"content": "Hier sind die Kerne, die du wolltest ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430203
					]
				},
				{
					"id": 740430203,
					"content": "Oh? Lass mich mal sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430204,
					"content": "Warum protestierst du immer noch hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430205
					]
				},
				{
					"id": 740430205,
					"content": "Wo man hinfällt, sollte man auch aufstehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430206,
					"content": "Was sollte ich noch gleich tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430207
					]
				},
				{
					"id": 740430207,
					"content": "Hä, du hast es schon vergessen? Also, auf dem Land und unter Wasser haben Leute eine Art von seltsamen Maschinen aufgestellt. Du kannst sie an dem sonderbaren Lichtschein erkennen, der sie umgibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430208
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430208,
					"content": "Zerstöre sie und bring mir diese besonderen Kerne darin. Insgesamt <color=#00E1FFFF>brauche ich sieben davon</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				}
			]
		},
		{
