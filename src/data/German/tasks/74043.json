			"dialogs": [
				{
					"id": 740430301,
					"content": "Ja, das sind sie, sieben geheimnisvolle Kerne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430302
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430302,
					"content": "Und wofür sind diese Kerne nun eigentlich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430303
					]
				},
				{
					"id": 740430303,
					"content": "Woher soll ich das wissen? Der Chef hat nur gesagt, dass er sieben geheimnisvolle Kerne von diesen geheimnisvollen Maschinen braucht. Wenn wir an die Kerne kommen, dann können wir eine hübsche Stange Geld verdienen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430304
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430304,
					"content": "Gut, ich habe mit dem Chef abgemacht, mich heute hier mit ihm zu treffen, um ihm einen Bericht über meinen Arbeitsfortschritt zu geben. Am besten, ihr fragt ihn gleich selbst. Ihr müsst sowieso warten, bis er mich ausgezahlt hat, bevor ich euch euren Anteil geben kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430305
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430305,
					"content": "Na ja, wenn du meinst ... Dann warten wir mit dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430306,
					"content": "Eine Weile später ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740430307
					]
				},
				{
					"id": 740430307,
					"content": "Lieber Henri, wie ist die Lage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430308
					],
					"speakerTitle": "„Chef“"
				},
				{
					"id": 740430308,
					"content": "Sehr gut, Chef! Ich habe die sieben geheimnisvollen Kerne, die du wolltest. Hier, darf ich dir die beiden vorstellen, das sind meine Geschäftspartner ... Äh, wie heißt ihr noch gleich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430309
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430309,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430310
					]
				},
				{
					"id": 740430310,
					"content": "Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430311
					],
					"speakerTitle": "„Chef“"
				},
				{
					"id": 740430311,
					"content": "Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430312,
					"content": "Oh? Ihr kennt euch bereits? Das macht alles viel einfacher! Also, die Sache ist so, Chef ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430315
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430313,
					"content": "#„Was? {NICKNAME}! Was macht {NICKNAME} denn hier?!“\\nDer „Chef“ dreht sich um und läuft davon, doch er wird von Hunter und Turner ergriffen, die wie aus dem Nichts aufgetaucht sind!\\n\\n",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740430314
					]
				},
				{
					"id": 740430315,
					"content": "Nein! Verschont mich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430316
					],
					"speakerTitle": "„Chef“"
				},
				{
					"id": 740430316,
					"content": "Boah! Die beiden haben es echt drauf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430317,
					"content": "Keine Sorge, Chef, es droht keine Lebensgefahr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430318
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430318,
					"content": "Selbstverständlich, es droht keine Lebensgefahr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430319
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430319,
					"content": "Zumindest für den Moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430320
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430320,
					"content": "Zu... Zumindest für den Moment ...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430321
					],
					"speakerTitle": "„Chef“"
				},
				{
					"id": 740430321,
					"content": "Und jetzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430322
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430322,
					"content": "Deine Antwort auf unsere Frage wird darüber entscheiden, ob es ein Grillhähnchen oder ... etwas anderes sein wird, das du neben deinen Kopf legst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430323
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430323,
					"content": "Aaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430324
					],
					"speakerTitle": "„Chef“"
				},
				{
					"id": 740430324,
					"content": "Wie kommt es, dass ihr hier seid?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430325,
					"content": "Nach unserer letzten ... glücklichen Begegnung haben wir beschlossen, Henri zu beobachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430326
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430326,
					"content": "Was? Wieso habt ihr mich beobachtet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430327
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430327,
					"content": "Nein, ich sollte eher fragen, warum habt ihr es überhaupt auf mich abgesehen! Ich bin doch einfach nur jemand, der einer ehrlichen, harten Arbeit nachgeht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430328
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430328,
					"content": "Die Maschinen, die du zerstört hast, sind Apparate, die die Leute vom Forschungsinstitut Fontaine zur Überwachung und Verbesserung der Wasserqualität verwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430329
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430329,
					"content": "Was? Es handelt sich nicht um Maschinen, die Verschmutzung verursachen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430330
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430330,
					"content": "Die herausgerissenen Kerne enthalten die fortschrittlichsten mechanischen Komponenten und hydrologische Daten von Fontaine. Wir würden gern ... erfahren, wer dein Abnehmer ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430331
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430331,
					"content": "Äh? Äh? Was? Warum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430332,
						740430334
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430332,
					"content": "Henri! Du hast mich betrogen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430333
					]
				},
				{
					"id": 740430334,
					"content": "Unglaublich! Wir wurden hereingelegt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430335
					]
				},
				{
					"id": 740430333,
					"content": "Nein, nein, du hast mir vorhin das Leben gerettet! Wie könnte ich dich da betrügen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430335
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430335,
					"content": "Chef, du hast mich betrogen und mich dazu gebracht, diese wichtigen Dinge zu zerstören!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430336
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430336,
					"content": "Es ... Es ist nicht meine Schuld ... Ich bin doch nur das kleinste Rad ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430337
					],
					"speakerTitle": "„Chef“"
				},
				{
					"id": 740430337,
					"content": "Oh? Was? Lieber Chef, was war das gerade? Ich habe das nicht genau gehört. Hast du gerade gesagt, dass es nicht deine Schuld ist? ... Kannst du das nochmal wiederholen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430338
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430338,
					"content": "Waaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430339
					],
					"speakerTitle": "„Chef“"
				},
				{
					"id": 740430339,
					"content": "Es scheint, als wäre dieser Chef hier recht müde. Er ist mit offenen Augen eingeschlafen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430340
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430340,
					"content": "Ähm, also, es war auch nicht ganz unsere Schuld ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430341,
					"content": "Nun, was ihr getan habt ... Wir haben beschlossen, die Sache nicht weiter zu verfolgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430342
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430342,
					"content": "Oh? Wir kommen also ungestraft davon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430343,
					"content": "Solange die Kerne und die Daten darin unbeschädigt sind, ist alles halb so wild. Die Maschinen an sich sind nicht der Rede wert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430344
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430344,
					"content": "Ja, die Oberen sagten, das sei egal. Und wir sollten es vermeiden, mit euch in Konflikt zu geraten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430345
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430345,
					"content": "Warum würdet ihr möglicherweise mit mir in Konflikt geraten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430346
					]
				},
				{
					"id": 740430346,
					"content": "Oh, das ist nichts, und es wird auch nicht passieren. Denn wir sind nur ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430347
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430347,
					"content": "Auf einem Spaziergang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430348
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430348,
					"content": "Eine wirklich zufällige Begegnung, nicht wahr? Was für schönes Wetter und was für ein schönes Treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430349
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430349,
					"content": "Aber auch die schönste Begegnung muss einmal enden. Wir sollten ... uns verabschieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430350
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430350,
					"content": "Dann erinnern wir uns einfach nur an eine schöne Begegnung, oder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430351
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430351,
					"content": "Am besten vergessen wir sie, ja, das wäre noch besser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430352
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430352,
					"content": "Äh ... Also wir dürfen dann gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430353
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430353,
					"content": "Oh? Würdest du gerne bei uns bleiben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430354
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430354,
					"content": "Nein, nein! Haha! Natürlich nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430355
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430355,
					"content": "Pff, ich habe tatsächlich gedacht, dass ich auf einen guten Menschen getroffen wäre und dass ich endlich meinem Schicksal mit meiner Arbeit eine neue Wende geben könnte. Aber am Ende gibt es immer mehr schlechte Menschen als gute Menschen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430356
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430356,
					"content": "... He, Henri. Pack mal mit an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430357
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430357,
					"content": "Hä?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430358
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430358,
					"content": "Was für ein Pech, dieser ... ach so unschuldige Chef hat das Bewusstsein verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430359
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430359,
					"content": "Wir brauchen einen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430360
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430360,
					"content": "Gewissenhaften Arbeiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430361
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430361,
					"content": "Er muss treu und verlässlich sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430362
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430362,
					"content": "Einen guten Freund, der sich erhofft, seinem Schicksal mit seiner Arbeit eine neue Wende zu geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430363
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430363,
					"content": "Genau, einen guten Freund, der uns hilft, diesen Chef hier in unser sicheres Versteck zu bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430364
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430364,
					"content": "Sodass wir dort in Ruhe mit ihm ... plaudern können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430365
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430365,
					"content": "Natürlich werden wir unserer Dankbarkeit ... auch auf angemessene Weise Ausdruck verleihen, und zwar in Form von Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430366
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430366,
					"content": "Oh? Ja! Ich bin genau der Richtige!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430367
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430367,
					"content": "Sehr gut! Ich danke euch! Und auch euch beiden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430368
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430368,
					"content": "#Ich bin {NICKNAME} und das hier ist Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430369
					]
				},
				{
					"id": 740430369,
					"content": "#Danke {NICKNAME} und Paimon! Nachdem ich euch getroffen habe, hat sich mein Schicksal wirklich gewandelt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430370
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430370,
					"content": "Keine Ursache! Viel Glück, Henri! Und lass dich nicht wieder hereinlegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430371,
					"content": "Auf keinen Fall! Ich werde hart arbeiten und reich werden! Und dann werde ich andere anstellen, um für mich zu arbeiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430372
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430372,
					"content": "Hunter, Turner und Henri graben den bewusstlosen Fatuus aus und tragen ihn davon.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740430373
					]
				},
				{
					"id": 740430373,
					"content": "Paimon hofft, dass Henri sein Glück machen wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430374
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430374,
					"content": "Moment! Wo bleibt unsere Bezahlung, die Henri uns versprochen hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}