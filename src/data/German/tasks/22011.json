			"dialogs": [
				{
					"id": 220110301,
					"content": "Ernsthaft, warum glauben Menschen an Gerüchte, die keinen Sinn ergeben, wenn man nur eine Sekunde darüber nachdenkt?",
					"roleType": "TALK_ROLE_NPC",
