			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220110101,
					"content": "Uff ... wer in aller Welt verbreitet dieses Gerücht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110102
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110102,
					"content": "Welches Gerücht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110103
					]
				},
				{
					"id": 220110103,
					"content": "Über die Orakelzettel am Schrein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110104
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110104,
					"content": "Du weißt, was Orakelzettel sind, richtig? Um es einfach auszudrücken, sie sind eine Form der Astrologie, die durch Auslosung erfolgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110105
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110105,
					"content": "Du kannst einige einfache Wahrsagen aus dem Wortlaut des Zettels, den du bekommst, aufdecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110106
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110106,
					"content": "Wenn du ein gutes Zeichen bekommst, toll. Aber die Leute lassen normalerweise die schlechten Zeichen am Schrein zurück, um das Unglück loszuwerden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110107
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110107,
					"content": "Aber ... irgendwie hat sich das Gerücht verbreitet, dass, wenn du die schlechten Zettel in die Spitze des Baumes wirfst, dein Pech von Gottheiten vertrieben werden wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110108
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110108,
					"content": "Hier ist der lustigste Teil: Manche Leute denken sogar, dass je höher man sie wirft, desto schneller das Glück kommt und desto schneller das Pech verschwindet. Was für ein Blödsinn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110109
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110109,
					"content": "Als die Gerüchte immer ungeheuerlicher wurden, haben die Leute angefangen, auch Mora auf den Baum zu werfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110110
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110110,
					"content": "Es heißt, wenn die Mora, die du geworfen hast, in den Ästen hängen bleibt, bedeutet das, dass dein Gebet angenommen wurde. Dein Wunsch wird nicht nur in Erfüllung gehen, sondern du wirst auch ein ganzes Jahr lang viel Glück haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110111,
						220110114
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110111,
					"content": "Ist das wahr?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110112
					]
				},
				{
					"id": 220110112,
					"content": "Natürlich nicht! Lassen wir mal beiseite, ob einzelne Gebete erhört werden können oder nicht ... Mora zu werfen ist einfach weit daneben. Außerdem sehen die Mora doch alle gleich aus, oder nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110113
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110113,
					"content": "Erwarten sie, dass der Archon die Mora einen nach dem anderen abholt, um herauszufinden, von wem sie sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110116
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110116,
					"content": "Ich verstehe, dass sie für Segen beten wollen, aber ... Dinge dort hoch zu werfen, wird ihnen keinen bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110117
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110117,
					"content": "Außerdem fällt alles zusammen, sobald der Wind aufkommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110118
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110118,
					"content": "Ich habe versucht, den Baum selbst aufzuräumen, aber ich bin nicht sehr sportlich. Ich habe es nicht nur nicht geschafft, ihn zu säubern, sondern bin auch lange Zeit stecken geblieben und konnte nicht mehr runter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110119
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110119,
					"content": "#Aber ich kann es nicht einfach unbeaufsichtigt lassen ... {F#Reisende}{M#Reisender}, könntest du mir helfen, auf das Dach zu gehen, um ein wenig aufzuräumen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110120,
						220110122
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110120,
					"content": "Kein Problem. Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110121
					]
				},
				{
					"id": 220110121,
					"content": "#Danke! Ich zähle auf dich, {F#Reisende}{M#Reisender}. Geh auf das Dach und räume es auf. Wenn du Orakelzettel bekommst, bringe sie bitte zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110122,
					"content": "Was wirst du mit ihnen machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110123
					]
				},
				{
					"id": 220110123,
					"content": "Nun ja ... Frau Hotomi sagt, dass egal was, das sind die Schicksale, die die Menschen gesucht haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110124
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110124,
					"content": "Es wäre unangebracht, sie einfach wegzuwerfen. Also lege ich sie dahin, wo sie hingehören, sobald sie gesammelt sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110125
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110125,
					"content": "*seufz* Wenn sich alle von Anfang an an die Regeln gehalten hätten, hätten wir nicht so viel Ärger ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110126
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110126,
					"content": "#Danke! Ich zähle auf dich, {F#Reisende}{M#Reisender}. Geh auf das Dach und räume es auf. Wenn du Orakelzettel bekommst, bringe sie bitte zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110114,
					"content": "Können wir nicht einfach reinen Tisch machen, um das Problem zu lösen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110115
					]
				},
				{
					"id": 220110115,
					"content": "Es gibt zu viele Leute, die das jetzt machen. Ich glaube nicht, dass ich alle überzeugen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110116
					],
					"speakerTitle": "Maki"
				}
			]
		},
		{
			"id": 2201102,
