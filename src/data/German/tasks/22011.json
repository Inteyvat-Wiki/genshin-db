					"Maki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220110201,
					"content": "Du bist also fertig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110202
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110202,
					"content": "Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110203
					]
				},
				{
					"id": 220110203,
					"content": "Ich danke dir vielmals. Überlass mir die Orakelzettel und ich hänge sie an der richtigen Stelle auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110204
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110204,
					"content": "Bitte nimm dies als Dank für deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110205
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110205,
					"content": "Ich verstehe, dass die Menschen verzweifelt sind, um das Pech loszuwerden und das Glück zu bekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110206
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110206,
					"content": "Aber ich denke, wenn sie ihre Probleme wirklich lösen wollen, werden ihre eigenen Aktionen effektiver sein als Orakelzettel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110207
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110207,
					"content": "Wie sollen sie erwarten, dass die Götter Hilfe anbieten, wenn sie selbst nichts unternehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maki"
				}
			]
		},
