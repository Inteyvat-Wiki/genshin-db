			"dialogs": [
				{
					"id": 722250201,
					"content": "Wegen der Opferung an den Nistbaum zähle ich auf dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250202
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250202,
					"content": "Ich bin hier mit Ku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				}
			]
		},
		{
			"id": 7222503,
			"completionStepIds": [
				7222505
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
