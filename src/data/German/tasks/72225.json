			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ruu",
					"Ku"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722250301,
					"content": "Der Nistbaum scheint wieder zu leben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250302
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250302,
					"content": "Die Opfergabe an den Nistbaum ist endlich abgeschlossen, das war hart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250303
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250303,
					"content": "Schließlich sind wir Experten im Umgang mit dieser Art von Problemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250304,
					"content": "Ähnlich wie die „Lichtleitzeremonie“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250305
					]
				},
				{
					"id": 722250305,
					"content": "Um eine Angelegenheit zu bearbeiten, müssen drei Probleme gelöst werden, die sich auf drei Standorte verteilen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250306,
					"content": "Es fühlt sich so an, als ob sowas mit dir immer passiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250307,
					"content": "Obwohl ich sonst nicht viel davon verstehe, gibt es so ein Sprichwort unter Erwachsenen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250308
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250308,
					"content": "„Aller guten Dinge sind drei.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250309
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250309,
					"content": "„Aller guten Dinge sind drei.“ ... Was heißt das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250310,
					"content": "Nun ... vermutlich braucht es drei Erlebnisse, bevor etwas Früchte trägt, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250311
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250311,
					"content": "Zum Beispiel: Es braucht drei Glücksfälle, damit das Glück wirklich kommt. Wenn schlechte Sachen dreimal passieren, wird das Pech in der Nähe sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250312
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250312,
					"content": "Wenn man etwas tut, stößt man auch dreimal auf Schwierigkeiten, bevor man beim vierten Mal Erfolg hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250313
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250313,
					"content": "Aber müsste es in diesem Fall nicht heißen: „Aller guten Dinge sind vier“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250314,
					"content": "Und so ist es auch! Paimon ist so gut in Mathe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250315
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250315,
					"content": "Natürlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250316,
						722250318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250316,
					"content": "Mathe ist der Punkt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250317
					]
				},
				{
					"id": 722250317,
					"content": "Übrigens, ist Kus Verletzung wieder in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250319,
					"content": "Kein Grund zur Sorge. Er ist immer so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250320
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250320,
					"content": "Was für eine Unannehmlichkeit ... Ich hoffe, das Ritual wird davon nicht beeinträchtigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250321
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250321,
					"content": "Sonst wäre es zu schade für Ruu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250322
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250322,
					"content": "Wie kann das sein? Ku ist immer gut zu mir gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250323
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250323,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250324
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250324,
					"content": "#{NICKNAME}, Paimon, geht vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250325
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250325,
					"content": "Ich bleibe noch ein wenig bei Ku und kümmere mich um den Rest der Opfergabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250318,
					"content": "Bei Kus Verletzung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250319
					]
				}
			]
		},
