			},
			"dialogs": [
				{
					"id": 722250101,
					"content": "Aua ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250102
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250102,
					"content": "#{NICKNAME}, Paimon, ihr kommt rechtzeitig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250103
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250103,
					"content": "Was ist passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250104
					]
				},
				{
					"id": 722250104,
					"content": "Mein Fuß ist verstaucht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250105
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250105,
					"content": "Ku ist wieder verletzt. Darf ich dich bitten, dem Nistbaum Opfergaben zu bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250106,
						722250108
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250106,
					"content": "Eine solche Entwicklung ist nicht unvorhersehbar ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250107
					]
				},
				{
					"id": 722250107,
					"content": "Kein Problem, ich kümmere mich darum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250109,
					"content": "Du hast meine Dankbarkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250110
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250110,
					"content": "Übrigens, bist du nicht auch empfindlich gegenüber den „Elementen“, Ruu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250111,
					"content": "Warum machst du nicht deine eigenen Opfergaben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250112,
					"content": "Nun ja ... ich habe schon alles Mögliche auf dem Ritual gemacht, aber das Endergebnis scheint nicht sehr gut zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250113,
						722250115,
						722250116
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250113,
					"content": "Warum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250114
					]
				},
				{
					"id": 722250114,
					"content": "Ich weiß es leider auch nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250117
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250117,
					"content": "Kein Problem, ich kümmere mich darum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250115,
					"content": "Überlass mir das.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250117
					]
				},
				{
					"id": 722250116,
					"content": "Ich überlasse den Verletzten dann dir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250117
					]
				},
				{
					"id": 722250108,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250109
					]
				}
			]
		},
		{
			"id": 7222502,
			"completionStepIds": [],
