			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200101,
					"content": "Sieh mal, da oben! Das ist das Jadegemach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200102,
						10200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200102,
					"content": "Das ist ziemlich weit oben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200104
					]
				},
				{
					"id": 10200104,
					"content": "Hmm ... Äh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200105,
					"content": "Ah, das ist nicht gut ... Paimon soll dein Reiseführer sein und weiß selbst nicht, wie man zum Jadegemach kommt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200106,
						10200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200106,
					"content": "Denkst also jetzt erst drüber nach, was ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200108
					]
				},
				{
					"id": 10200108,
					"content": "Argh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200109,
					"content": "Na ja, am logischen ist ja, erst mal an den auf der Karte markierten Ort zu gehen, um zum Jadegemach zu gelangen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200110,
					"content": "Sehen wir uns mal um. Da gibt es bestimmt irgendwo eine Möglichkeit, hochzukommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200107,
					"content": "Wir hätten die Botin Ganyu fragen sollen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200108
					]
				},
				{
					"id": 10200103,
					"content": "Die Frage ist, wie kommen wir da hoch?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200104
					]
				}
			]
		},
		{
			"id": 102002,
			"completionStepIds": [
				102002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102002",
							"2"
						],
						"stepId": 102002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200201,
					"content": "He, schau mal! Da ist so eine Art Vorrichtungsding!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200202,
					"content": "Da dies der richtige Ort ist, muss er etwas mit dem Jadegemach zu tun haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200203,
						10200205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200203,
					"content": "Vielleicht ist es der Pfad zum Jadegemach?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200204
					]
				},
				{
					"id": 10200204,
					"content": "Ja, das muss der Weg sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200205,
					"content": "Das sieht nach irgendeiner Falle aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200206
					]
				},
				{
					"id": 10200206,
					"content": "Niemals! Vertraue einfach Paimons Instinkten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 102004,
			"completionStepIds": [
				102004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102004",
							"2"
						],
						"stepId": 102004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huaqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200401,
					"content": "Anhalten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200402
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200402,
					"content": "Wer wagt es, diesen heiligen Boden zu betreten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200403,
						10200404
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200403,
					"content": "Wir sind nur auf der Durchreise ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				},
				{
					"id": 10200405,
					"content": "Genau. Wovon redest du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200406,
					"content": "Wir sind geladene Gäste! Wie kommst du darauf, uns so zu behandeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200407,
					"content": "Nein, warte ... Vielleicht war das von Anfang an Ningguangs Plan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200408,
					"content": "Die Einladung in das Jadegemach war nur ein Vorwand, um uns in einen Hinterhalt der Millelithen zu locken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200409,
						10200410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200409,
					"content": "Mit Sicherheit nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200411,
					"content": "Argh, jetzt ist Paimon aber wütend! Du da drüben! Das ist doch eine Falle, stimmt’s? Wie feige!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200412,
					"content": "Was? Wir patrouillieren hier nur. Was meinst du mit „feige“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200413
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200413,
					"content": "Was für ein Theater! Nehmt die Eindringlinge sofort fest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200414
					],
					"speakerTitle": "Yang"
				},
				{
					"id": 10200414,
					"content": "Na dann werden wir wohl kämpfen müssen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200410,
					"content": "Wir haben das mit der Einladung einfach nur noch nicht erklärt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200404,
					"content": "Heiliger Boden? Das ist doch nur die Wildnis um den Tianheng-Berg ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				}
			]
		},
		{
			"id": 102006,
			"completionStepIds": [
				102006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102006",
							"2"
						],
						"stepId": 102006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200601,
					"content": "Stopp! Was geht hier vor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200602
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200602,
					"content": "Keqing, diese beiden seltsamen Gestalten sind hier plötzlich aufgetaucht und scheinen etwas mit dem Guizhong-Geschütz vorzuhaben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200603
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200603,
					"content": "Was? Wen nennst du hier eine seltsame Gestalt?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200604,
					"content": "Wir haben nur nach einem Weg ins Jadegemach gesucht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200605
					]
				},
				{
					"id": 10200605,
					"content": "Hm? Ihr wollt ins Jadegemach? Wer seid ihr denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200606
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200606,
					"content": "Wir sind geladene Gäste, die zu den Qixing von Liyue wollen! Und wer bist du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200608
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200608,
					"content": "Tja, rein zufällig gehöre ich auch zu den Qixing von Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200609
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200609,
					"content": "???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200610,
					"content": "Ich bin Keqing, der Yuheng der Qixing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200611
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200611,
					"content": "#Ich habe von dir gehört, {F#Reisende}{M#Reisender}. Du bist also Ningguangs Gast, ja? Ich hätte nicht erwartet, dich hier in den Bergen zu treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200612
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200612,
					"content": "Oh ... Paimon hat auch nicht damit gerechnet, jemand so Reichem hier mitten im Nirgendwo zu begegnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200613,
					"content": "Das Guizhong-Geschütz am Tianheng-Pass ist schon lange baufällig, doch es wurde in einer einzigen Nacht repariert. Ich bin hier, um den Vorfall zu untersuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200614
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200614,
					"content": "Die Millelithen hier sind nur Aufpasser, sie sollen niemanden Bestimmtes verhaften.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200615
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200615,
					"content": "Das war also alles nur ein Missverständnis? Paimon hätte nie gedacht, dass ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200616,
					"content": "Denken ist gar nicht mal so schwer, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200617
					]
				},
				{
					"id": 10200617,
					"content": "Jedenfalls ist es für einen Sterblichen quasi unmöglich, eine Maschine der Adepten zu reparieren, selbst für die Qixing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200618
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200618,
					"content": "Hehe, das war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200619,
						10200620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200619,
					"content": "(Psst, Paimon, mach es nicht noch komplizierter, als es bereits ist!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				},
				{
					"id": 10200621,
					"content": "Hm? Ach ja. Also, großer Yuheng, hast du irgendeine Vermutung, warum der Tianquan uns in das Jadegemach eingeladen hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200622,
					"content": "Bitte nenn mich einfach nur Keqing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200623
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200623,
					"content": "Ich glaube, dass Ningguang es darauf abgesehen hat, den Retter von Mondstadt darum zu bitten, eine neutralere Haltung einzunehmen ... Oder sich zumindest nicht komplett auf die Seite der Adepten zu stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200624
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200624,
					"content": "Wir sind auf der Seite von niemandem. Wir haben mit den Adepten gesprochen. Auch sie wollen Liyue beschützen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200625,
					"content": "Wenn du „beschützen“ sagst, meinst du damit ihre Scheinheiligkeit und Arroganz, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200626
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200626,
					"content": "Wie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200627,
					"content": "Ihr seid Sterbliche und steht daher unter ihrem Schutz. Sie würden euch niemals als jemanden ansehen, der einen Gott töten könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200628
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200628,
					"content": "Natürlich würden sie auch die Abriegelung des Gebiets durch Ningguang, die Befragung der Bürger und die Verfolgung des Attentäters als sinnlos erachten. Vielleicht fragen sie sich sogar, ob etwas vertuscht wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200629
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200629,
					"content": "Um es auf den Punkt zu bringen: Sie unterschätzen uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200630
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200630,
					"content": "Damit hast du nicht ganz unrecht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200631,
					"content": "Aber ich treffe zum ersten Mal jemanden aus Liyue, der weder die Götter noch die Adepten zu respektieren scheint.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200632,
					"content": "Hah. Sollte ich das schlechte Zeitgefühl und die Herablassung gegenüber den Sterblichen respektieren, die sie dazu gebracht haben, ihre Schritte gegen uns Qixing zu verzögern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200633
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200633,
					"content": "Vergiss es. Ich sollte nicht so von ihnen reden. Dass ich ihnen gegenüber solche Gefühle hege, ist allein mein Problem. Ningguang teilt meine Skepsis nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200634
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200634,
					"content": "Ich gebe jedoch zu, dass die Adepten diesmal weniger aggressiv gehandelt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200635
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200635,
					"content": "Der Tod von Rex Lapis ist ein außergewöhnlicher Umstand. Aber dass sie einen Rat der Adepten einberufen würden, statt direkt herzukommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200636
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200636,
					"content": "Wie überraschend zivilisiert von ihnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200637,
						10200638
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200637,
					"content": "Könntest du vielleicht versuchen, es ihnen auszureden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200639,
					"content": "Nun, was Ningguang angeht ... Diese Frau würde jedem alles ausreden, wenn sie könnte. Doch ich bezweifle, dass es diesmal funktionieren wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200640
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200640,
					"content": "Die Zeit der Adepten ist lange vorbei. Wenn selbst die Qixing von Liyue dieser Wahrheit nicht in die Augen sehen wollen, welche Zukunft erwartet Liyue dann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200641
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200641,
					"content": "Puh ... Noch so eine gewagte Aussage ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200642,
					"content": "#*seufz* Ich halte lieber den Mund. Ich wollte eigentlich auch gar nicht so viel meiner eigenen Meinung preisgeben. Aber du bist {F#eine ziemlich gute Zuhörerin, Reisende}{M#ein ziemlich guter Zuhörer, Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200643
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200643,
					"content": "Ihr solltet euch jetzt ins Jadegemach begeben. Beeilt euch, Ningguang ist eine sehr beschäftigte Frau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200644
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200644,
					"content": "Die Crème de la Crème von Liyues Kaufleuten betrachtet den „Aufstieg ins Jadegemach“ als größte Ehre. Jeder bringt bei seinem Besuch die besten Geschenke mit, um etwas von Ningguang zurückzubekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200645
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200645,
					"content": "Zurückbekommen? Etwa ein Geschenk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200646,
						10200647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200646,
					"content": "Paimon, darum geht es nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200648,
					"content": "Aber ... Aber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200649
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200649,
					"content": "Ja, genau! Begrüßungsgeschenke sind ein fester Bestandteil in Liyues Kultur. Wir wollen uns nicht bei ihr einschleimen. Wir wollen nur ... Liyues Kultur respektieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200650
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200650,
					"content": "Ah, ziemlich zielstrebig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200651
					]
				},
				{
					"id": 10200651,
					"content": "Also gut, ihr dürft selbst entscheiden, welches Begrüßungsgeschenk ihr ihr überreichen wollt. Aber erst will ich euch sagen, wie ihr ins Jadegemach kommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200652
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200652,
					"content": "Ihr hättet gar nicht zum Tianheng-Berg kommen müssen. Geht zurück zum Hafen von Liyue, sucht euch im Yuehai-Pavillon einen Reiseführer und ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200653
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200653,
					"content": "Tja, dann sehen wir uns vielleicht irgendwann wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200654
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200654,
					"content": "Also auch wenn der Yuheng keinen Respekt vor den Göttern hat, findet Paimon sie ziemlich fesch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200655,
						10200656
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200655,
					"content": "Sie hat bei mir auch einen guten Eindruck hinterlassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200657,
					"content": "Also, was wollen wir Ningguang zur Begrüßung schenken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200658
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200658,
					"content": "Du nimmst die Sache mit dem Geschenk ja ganz schön ernst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200659
					]
				},
				{
					"id": 10200659,
					"content": "Ich hab’s! Paimon hat letzte Nacht von einem total leckeren Snack geträumt: <color=#00E1FFFF>glasierter Schleim!</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200660
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200660,
					"content": "Paimon hat das Gefühl, dass dies das perfekte Geschenk für jemanden wie Ningguang ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200661
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200661,
					"content": "Wollen wir ihr das bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200662,
						10200664
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200662,
					"content": "Hast du denn ein Rezept dafür?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200663
					]
				},
				{
					"id": 10200663,
					"content": "Nein! Aber bestimmt brauchen wir dafür nur ein bisschen Pfiff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200666,
					"content": "Sammeln wir schnell die Zutaten. Wir wollen unsere Gastgeberin doch nicht warten lassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200664,
					"content": "Und ... wie sollen wir dieses Zeug aus deinem Traum dann machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200665
					]
				},
				{
					"id": 10200665,
					"content": "Na, mit dem gewissen Pfiff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200656,
					"content": "Ich teile einige ihrer Ansichten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200647,
					"content": "Paimon, jetzt mal im Ernst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200638,
					"content": "Ningguang würde doch lieber verhandeln, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200620,
					"content": "(Wir haben nur einen kleinen Teil der Arbeit gemacht ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				}
			]
		},
		{
			"id": 102007,
			"completionStepIds": [
				102007
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102007",
							"2"
						],
						"stepId": 102007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200701,
					"content": "Hm? Weiter scheinen wir so nicht zu kommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200702,
					"content": "Menno, wenn die Windströmung stärker wäre, könnten wir im Handumdrehen oben sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200703,
					"content": "Am besten gehen wir zurück nach Liyue und fragen den Millelithen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200704
					]
				},
				{
					"id": 10200704,
					"content": "Was? Warum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200705,
					"content": "Der Weg nach oben sollte doch kein Geheimnis sein, es sei denn ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200706
					]
				},
				{
					"id": 10200706,
					"content": "Es sei denn? ... Oh, jetzt versteht Paimon! Wenn es geheim wäre, hätte Ganyu nicht zugelassen, dass wir alleine versuchen es herauszufinden, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200707,
					"content": "Na gut, dann folgen wir deinem Plan und können dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200708,
					"content": "Oh! Warte mal. Guck mal nach unten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200709,
					"content": "Wie es aussieht, sind wir jetzt ganz nah am <color=#00E1FFFF>Guizhong-Geschütz</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200710,
					"content": "Hmm ... Da fällt mir gerade was Neues ein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200711,
					"content": "Wir könnten dich doch mit dem Geschütz zum Jadegemach hochschießen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200712,
						10200714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200712,
					"content": "Nein, danke, ich wollte noch nicht sterben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200713
					]
				},
				{
					"id": 10200713,
					"content": "Oh ... Stimmt, diese Methode ist vielleicht nicht die sicherste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200716,
					"content": "Ich weiß noch, dass man mit dem Guizhong-Geschütz weit sehen kann.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200717
					]
				},
				{
					"id": 10200717,
					"content": "Oh, stimmt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200718,
					"content": "Jetzt, da du es erwähnst: Wir könnten das Guizhong-Geschütz benutzen, um herauszufinden, ob es in der Nähe einen Weg nach oben gibt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200714,
					"content": "Übrigens, kann es sein, dass du mich nicht leiden kannst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200715
					]
				},
				{
					"id": 10200715,
					"content": "Äääh ... Nein. Paimon hat nur die Sicherheitsmaßnahmen nicht bedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}