			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asagiri"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 725010201,
					"content": "Warum erteilt mir Fräulein Moriko immer die schrägsten Projekte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010202,
						725010203
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010202,
					"content": "Malst du immer noch an deinen Illustrationen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010204
					]
				},
				{
					"id": 725010203,
					"content": "Schon wieder keine Inspiration?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010204
					]
				},
				{
					"id": 725010204,
					"content": "#Ah! {F#Reisende}{M#Reisender}, was machst du denn hier? Lange nicht gesehen! Ich dachte, du wärst woanders unterwegs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010205
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010205,
					"content": "Ah ... Wenn ich bei besserer Gesundheit wäre, würde ich gerne eine Reise machen wie du.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010206
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010206,
					"content": "Dann würde mich Fräulein Moriko nicht ständig persönlich zur Manuskriptabgabe drängen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010207
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010207,
					"content": "Meine letzten Illustrationen scheinen gut angekommen zu sein. Viele Kunden möchten eine Illustration von mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010230
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010230,
					"content": "Fräulein Moriko hat zwar schon viele Projekte für mich abgewiesen, aber trotzdem sind es viel zu viele Projekte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010209
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010208,
					"content": "Und die Autoren aus dem „Verlagshaus Yae“ schreiben immer ... wildere kurze Erzählungen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010209
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010209,
					"content": "Ich dachte am Anfang, dass sie außer Inazuma nur über Mondstadt und Liyue schreiben würden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010210
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010210,
					"content": "Aber mittlerweile beschäftigen sich ihre kurzen Erzählungen mit ... Sumeru mit Blick auf Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010216
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010216,
					"content": "#Hmm ... Zurück zum Thema. {F#Reisende}{M#Reisender}, wie geht es deinem „Fotoapparat“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010217,
						725010218
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010217,
					"content": "Ihm geht es gut ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010219
					]
				},
				{
					"id": 725010218,
					"content": "Möchtest du neue Bilder von mir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010219
					]
				},
				{
					"id": 725010219,
					"content": "Findest du nicht, dass ich dich beim letzten Mal fürstlich bezahlt habe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010220
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010220,
					"content": "#{M#Reisender}{F#Reisende}, bitte schieße in allen Ecken dieser Welt ein paar Bilder für mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010221,
						725010224
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010221,
					"content": "*seufz* Überlass das mir ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010222
					]
				},
				{
					"id": 725010224,
					"content": "Du kannst eine Missionsanfrage an die Abenteurergilde stellen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010225
					]
				},
				{
					"id": 725010222,
					"content": "Ich zähle auf dich! Hehe, ich halte mein Notizbuch schon längst bereit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010223
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010223,
					"content": "Wenn du nicht zu mir kämst, würde ich Fräulein Moriko bitten, dich zu suchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010225,
					"content": "Aah! Nein, nicht doch! Ich bitte dich! Ich habe Anfragen an die Abenteurergilde gestellt, aber es gibt sonst keine Abenteurer, die sich mit Fotoapparaten auskennen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010226
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010226,
					"content": "#Bitte hilf mir, {F#Reisende}{M#Reisender}! Wenn ich meine Manuskripte nicht einreiche, wird Fräulein Moriko bei mir einziehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010227
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010227,
					"content": "#Ich kann ihren Sakurareis nicht leiden, {F#Reisende}{M#Reisender}! Du musst mir unbedingt helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010228
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010228,
					"content": "Na gut, ich weiß ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010229
					]
				},
				{
					"id": 725010229,
					"content": "Puh ... Dann ist gut. Warte kurz, ich suche mein Notizbuch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				}
			]
		}
	]
}