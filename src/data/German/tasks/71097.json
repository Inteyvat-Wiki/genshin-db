			"dialogs": [
				{
					"id": 710970101,
					"content": "Habt ihr einen „Altstein“ gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970102,
					"content": "Hier sind sie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7109702,
			"completionStepIds": [
				7109702
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109702",
							"2"
						],
						"stepId": 7109702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710970201,
					"content": "Mit diesen drei sind es insgesamt neun. Das sollte genug sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970202
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970202,
					"content": "Die Bedürfnisse der Huishan-Kammer so schnell zu befriedigen ... Kein Wunder, schließlich seid ihr es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970203
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970203,
					"content": "Das war ein Superschlagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970204,
					"content": "Das war ein Zuckerschlecken ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970205
					]
				},
				{
					"id": 710970205,
					"content": "Aah! Paimon meint ... Na ja ... Das ist genauso ein Zuckerschlecken, wie für einen Superschlag auszuholen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970206,
					"content": "Herzlichen Glückwunsch, Paimon, dass du gelernt hast, starke Argumente vorzubringen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970207
					]
				},
				{
					"id": 710970207,
					"content": "Hahaha ... Paimon hat recht, wir haben alle gesehen, wie gut ihr gegen Seeungeheuer gekämpft habt. Ich bin sicher, dass es für euch nicht allzu schwierig war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970208,
						710970209
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970208,
					"content": "In der Tat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970210
					]
				},
				{
					"id": 710970210,
					"content": "Ich hatte nicht erwartet, dass ich für den Rat für Allgemeine Angelegenheiten zuständig sein würde und zusätzlich einen Altstein in der Großen Kluft suchen muss ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970211
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970211,
					"content": "Oh ja, damals hast du dich noch jeden Tag mit deinem eigenen Vater gestritten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970212,
					"content": "Und danach bist du zum Rat für Allgemeine Angelegenheiten gegangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970213,
					"content": "Ich schuldete eine größere Summe Geld und war verzweifelt, aber daher auf keinen Fall bereit, nach Hause zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970214
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970214,
					"content": "Daraufhin gingen die Schuldeneintreiber direkt zur Shenglu-Kammer und sprachen meinen Vater an ... Als ich davon hörte, dachte ich: „Mein Vater wird mir sicher alle Knochen brechen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970215
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970215,
					"content": "Aber deine Glieder sehen ziemlich unversehrt aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970216,
					"content": "Es war ... tatsächlich so, dass mein Vater meine Schulden tilgte und mich dann auf der Straße fand und sagte: „Ich habe alle deine Schuldscheine, also schuldest du mir jetzt Geld“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970217
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970217,
					"content": "Ich wurde erpresst, eine Arbeit anzunehmen ... um das Geld zurückzuzahlen, das ich schuldete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970218
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970218,
					"content": "Also schuldest du jetzt deinem Vater Geld.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970219,
					"content": "So ist es ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970220
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970220,
					"content": "Natürlich war ich damals jeden Tag auf der Flucht vor meinen Schulden und ich habe schon vor langer Zeit beschlossen, dass ich, wenn ich die Chance dazu hätte, mein Leben in Ordnung bringen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970221
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970221,
					"content": "Aber ich hatte nicht damit gerechnet, dass mein Vater, der oft mit mir stritt, mir diese Chance geben würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970222
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970222,
					"content": "Zum ersten Mal in meinem Leben hat mein Vater nicht mit mir gestritten, sondern ein offenes und ehrliches Gespräch geführt, das ich gern früher begonnen hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970223
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970223,
					"content": "Aber selbst wenn er vorher mit mir hätte reden wollen, war ich damals wohl nicht in der Stimmung, ihm zuzuhören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970224
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970224,
					"content": "Es scheint, dass dein Vater sehr gut zu dir war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970225,
					"content": "Ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970226
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970226,
					"content": "Egal was passiert, die Aufgabe muss erledigt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970227
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970227,
					"content": "Egal ob es sich um den Fall der Großen Kluft handelt oder um die Aufgabe, der Huishan-Kammer bei der Suche nach „Altsteinen“ zu helfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970228
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970228,
					"content": "Diesen Auftrag habe doch ich für dich erledigt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970229
					]
				},
				{
					"id": 710970229,
					"content": "Sich Hilfe zu holen, um die Arbeit zu erledigen, ist auch eine Möglichkeit, die Arbeit zu erledigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970230
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970230,
					"content": "Aber dieses Mal war es wirklich euch beiden zu verdanken, dass die Arbeit so schnell und über meine Erwartungen hinaus erledigt wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970231
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970231,
					"content": "Das hört man gern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970209,
					"content": "Tatsächlich war es ein bisschen schwierig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970210
					]
				}
			]
		}
	]
}