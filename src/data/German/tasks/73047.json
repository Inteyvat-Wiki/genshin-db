					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730470101,
					"content": "#Nara {NICKNAME}, Paimon, wir treffen uns wieder. Haha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470102
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470102,
					"content": "Araja sieht echt glücklich aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470103,
					"content": "Haha ... Ich bin wirklich glücklich, wenn so viele Aranara nach Hause kommen und Vanarana so lebendig ist. Ach, ich hätte nicht gedacht, selbst dieses Utsava-Fest erleben zu können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470104,
						730470105
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470104,
					"content": "Du hast es noch nie erlebt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470107
					]
				},
				{
					"id": 730470107,
					"content": "In einer Geschichte war ich schon einmal auf dem Utsava-Fest, das ist aber schon sehr lange her ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470108
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470108,
					"content": "Ich, Aramuhukunda, Arana, Araji ... viele, viele Aranara haben zusammen mit Nara Varuna das Utsava-Fest gefeiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470109
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470109,
					"content": "Es war eine schwere Zeit, aber zum Utsava-Fest haben wir trotzdem zusammen gelacht und gesungen. Ich mag diese Geschichte sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470110
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470110,
					"content": "Dann hast du doch teilgenommen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470111,
					"content": "Aber nur in einer Geschichte. Ich kann mich nicht mehr daran erinnern. Arana und die anderen haben mir später von diesen Geschichten erzählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470112
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470112,
					"content": "Hmm ... Araja klingt schon wie ein alter Opa, vielleicht, weil er so alt ist und sich nicht mehr richtig erinnern kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470113,
					"content": "#Aber vielleicht ist das auch besser so ... Egal, Nara {NICKNAME} und Paimon, wollt ihr das hier haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470114
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470114,
					"content": "Eine kleine Blume ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470115,
					"content": "Ich hoffe, diese Blume wird euch auf euren weiteren Reisen immer begleiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470116,
						730470117
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470116,
					"content": "Ich nehme sie gern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470118,
					"content": "Zeit ist für Nara viel wertvoller als für Aranara. Ich möchte euch nicht mehr aufhalten, ihr solltet Spaß haben. Und später könnt ihr zu Arakavi gehen, er bereitet sich auch auf die Zeremonie vom Utsava-Fest vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470117,
					"content": "Danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470105,
					"content": "Ich bin auch glücklich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470106
					]
				},
				{
					"id": 730470106,
					"content": "Paimon ist auch glücklich! Aber war Araja denn vorher noch nie beim Utsava-Fest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470107
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}