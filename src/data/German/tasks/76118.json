			"dialogs": [
				{
					"id": 761180401,
					"content": "Ah, ihr seid zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180402
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180402,
					"content": "Stell dir vor, Columbina! Du hattest recht, Lauma hat uns überhaupt nichts erzählt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180403,
					"content": "Sie scheint allerdings ziemlich beschäftigt zu sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180404
					]
				},
				{
					"id": 761180404,
					"content": "Deshalb werden wir dir in den nächsten Tagen Gesellschaft leisten. Lehn dich einfach zurück und freu dich schon mal darauf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180405,
					"content": "Freuen auf ... was genau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180406
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180406,
					"content": "Ach ...! Oh! Äh, n... nichts! Wir wissen wirklich gar nichts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180407,
					"content": "Hehe ... Na gut. Ich freue mich darauf, die nächsten Tage mit euch zu verbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180408
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180408,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180409
					],
					"speakerTitle": "Ibis"
				},
				{
					"id": 761180409,
					"content": "Oh, da kommt unser Essen ... Moment mal. Wo ist es denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180410,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180411
					],
					"speakerTitle": "Ibis"
				},
				{
					"id": 761180411,
					"content": "Er sagt: „Die Zeit ist gekommen.“ Weißt du, was das bedeutet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180412
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180412,
					"content": "Oooh, jetzt hat Paimon es verstanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180413,
					"content": "Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180414
					]
				},
				{
					"id": 761180414,
					"content": "Mh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180415
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180415,
					"content": "Du trägst normalerweise eine Augenbinde, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180416
					]
				},
				{
					"id": 761180416,
					"content": "Ja. Was ist damit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180417
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180417,
					"content": "Aber du kannst doch trotzdem mit Kuuvahki die Außenwelt beobachten, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180418,
					"content": "Genau. Eigentlich nehme ich die Dinge so sogar noch deutlicher wahr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180419
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180419,
					"content": "Könntest du dann, äh, für eine Weile absichtlich keine Veränderungen von draußen wahrnehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180420,
					"content": "Damit das eine „schöne Überraschung“ sein kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180421
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180421,
					"content": "... Es scheint, dass du schon erraten hast, worum es hier geht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180422,
					"content": "Gut, ich verstehe. Würdest du in diesem Fall meine Hand nehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				}
			]
		},
