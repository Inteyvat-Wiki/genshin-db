			"dialogs": [
				{
					"id": 761180101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180102
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180102,
					"content": "Liegt es nur an Paimon, oder riechst du auch etwas so Leckeres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180104
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180104,
					"content": "Columbina hält ein Festmahl für sich allein ab!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180105,
					"content": "#{NICKNAME}, Paimon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180106
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180106,
					"content": "Sieht aus, als hätte hier jemand richtig Spaß ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180107,
					"content": "Möchtest du auch etwas probieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180108
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180108,
					"content": "Nein, nein, fang du ruhig an.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180109
					]
				},
				{
					"id": 761180109,
					"content": "Wir sehen dich hier sonst nie essen! Bist du extra losgegangen, um das zu kaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180110,
					"content": "Lauma hat es mir gegeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180111
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180111,
					"content": "Oh, sie kümmert sich wirklich gut um dich, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180112,
					"content": "Unter der Bedingung, dass ich nicht weggehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180113
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180113,
					"content": "Moment mal, was!? Ist das nicht einfach nur Bestechung, damit du den Hausarrest akzeptierst? Und noch dazu eine billige!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180114,
					"content": "Sie hat mir auch ein paar interessante Bücher und kunstvoll gefertigte Spielsachen gebracht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180115
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180115,
					"content": "Ähm, jetzt klingt es eher wie eine Mutter, die auf Geschäftsreise geht, und das Kind, das sie zu Hause lässt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180116,
					"content": "Hat Lauma dir ihre Gründe erklärt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180117
					]
				},
				{
					"id": 761180117,
					"content": "Sie hat mir nur gesagt, dass ich vorerst nicht rausgehen soll und besonders darauf achten muss, den Nachkommen des Frostmonds aus dem Weg zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180118
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180118,
					"content": "Ich fragte die Tiere, die mir das Essen brachten, aber Lauma hatte ihnen befohlen zu schweigen, und das taten sie auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180119
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180119,
					"content": "Äh, das ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180120,
					"content": "Wenn ich raten müsste, bereitet sie etwas vor, das mit mir zu tun hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180121
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180121,
					"content": "Keine Sorge. Ich fand es von Anfang an nicht langweilig, hierzubleiben. Das Essen hier ist gut und entspricht genau meinem Geschmack. Es macht mir nichts aus, nicht rauszugehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180122
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180122,
					"content": "Und wenn die Nachkommen des Frostmonds sich tatsächlich auf etwas vorbereiten ... Nun, dann ist es umso mehr Grund, sie nicht zu stören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180123
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180123,
					"content": "Sollen wir uns mal umhören?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180124
					]
				},
				{
					"id": 761180124,
					"content": "Ja. Paimon ist jetzt auch neugierig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180125,
					"content": "Das könnt ihr ... aber ihr solltet vorbereitet sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180126
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180126,
					"content": "Sie weiß wahrscheinlich, dass ihr zu mir kommen werdet, deshalb wird sie euch vielleicht gar nichts erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				}
			]
		},
