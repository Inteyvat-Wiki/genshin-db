			"dialogs": [
				{
					"id": 761180501,
					"content": "Da wären wir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180502,
					"content": "Du kannst jetzt deine Augen öffnen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180503
					]
				},
				{
					"id": 761180503,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180504
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180504,
					"content": "(Sie hat tatsächlich ihre Augen geöffnet!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180505,
					"content": "(Das habe ich einfach so dahergesagt ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180506
					]
				},
				{
					"id": 761180506,
					"content": "Es ist wunderschön ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180507
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180507,
					"content": "Dieses Flügelpaar macht es noch vollkommener.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180508
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180508,
					"content": "Dies ist ein Geschenk, das wir Nachkommen des Frostmonds dir, Columbina, gerne überreichen möchten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180509
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180509,
					"content": "Um unsere Göttin zu feiern, die nun frei fliegen kann und deren Finger endlich den Ort berühren können, den sie „Zuhause“ nennt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180510
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180510,
					"content": "... Früher hätte mich dieser Anblick jedes Mal an die Verwirrung erinnert, die ich bei meiner Geburt empfunden habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180511
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180511,
					"content": "Aber jetzt spüre ich die Wärme eines „Zuhauses“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180512
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180512,
					"content": "Vielleicht habe ich mich, genau wie diese Statue, dafür entschieden, hierzubleiben, auch wenn ich jetzt Flügel habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180513
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180513,
					"content": "... Danke euch allen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180514
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180514,
					"content": "Wir haben noch ein Geschenk vorbereitet, aber dafür musst du ein Stück mit mir mitlaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180515
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180515,
					"content": "Hm? Es gibt noch eine Überraschung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180516,
					"content": "Wir haben im Wald ein kleines Willkommensbankett organisiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180517
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180517,
					"content": "Von nun an wird das hier auch dein Zuhause sein, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180518
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180518,
					"content": "Wann immer du Heimweh hast, bleib hier bei uns und genieße unsere bescheidene Gastfreundschaft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180519
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180519,
					"content": "Klar. Das werde ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180520
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761180520,
					"content": "Schau! Der Mond ist aufgegangen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180521
					]
				},
				{
					"id": 761180521,
					"content": "Gehen wir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180522
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180522,
					"content": "Ich hoffe, dass jede Nacht so wundervoll sein wird wie jene Mondgebetsnacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180523
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180523,
					"content": "Willkommen zu Hause, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		}
	]
