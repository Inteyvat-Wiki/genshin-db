						"position": [
							1803.217,
							240.145,
							10366.37
						],
						"pointId": 360600060
					}
				]
			},
			"dialogs": [
				{
					"id": 761180301,
					"content": "Du willst die Statue von Kuutar renovieren!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180302,
					"content": "Ganz genau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180303
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180303,
					"content": "Sie ist nicht länger die flügellose Kuu{RUBY#[S]Mondmädchen}tar, die nur einsam zum Mond am Himmel emporblicken konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180304,
					"content": "Wir haben gesehen, wie sie ihre Flügel entfaltete, und wissen, dass sie ihre Freiheit zu leben wiedererlangt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180305
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180305,
					"content": "Daher ist es nur richtig, dass auch die Statue neu aufgebaut wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180306,
					"content": "Das klingt wirklich nach einer guten Idee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180307,
					"content": "Hast du den anderen Nachkommen des Frostmonds davon erzählt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180308
					]
				},
				{
					"id": 761180308,
					"content": "Das habe ich. Ich habe ihnen von dem Opfer der Mondgöttin erzählt und von ihrer Rückkehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180309
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180309,
					"content": "Und davon, wie wir uns unter der Führung dieses sanften Lichts gegen die Kraft gestellt haben, die diese Welt verunreinigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180310
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180310,
					"content": "Alle waren erfreut, von ihrer Rückkehr zu hören, also nutzte ich die Gelegenheit, ihnen Columbinas Gedanken mitzuteilen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180311
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180311,
					"content": "Dass sie uns als Familie sehen möchte und sich wünscht, dass wir das Gleiche für sie empfinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180312
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180312,
					"content": "Und was haben die anderen gesagt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180313
					]
				},
				{
					"id": 761180313,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180314
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180314,
					"content": "Die Mondgöttin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180315
					],
					"speakerTitle": "Zirnytsia"
				},
				{
					"id": 761180315,
					"content": "Wäre es ... nicht anmaßend, sie als Familie zu betrachten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180316
					],
					"speakerTitle": "Lauha"
				},
				{
					"id": 761180316,
					"content": "Ich glaube, dass das wirklich Columbinas Wunsch ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180317
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180317,
					"content": "(Die Mondkantorin nannte die Mondgöttin einfach so „Columbina“ ...!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180318
					],
					"speakerTitle": "Kunegunda"
				},
				{
					"id": 761180318,
					"content": "Vielleicht erinnert ihr euch noch an die Worte, die ich vor Kurzem gesprochen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180319
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180319,
					"content": "„Der Weg soll mit Wahrheit gepflastert sein, und wir werden ihn selbst pflastern.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180320
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180320,
					"content": "Ich verlange nicht, dass ihr alle dieselbe Entscheidung trefft wie ich, aber ich möchte euch heute etwas mitteilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180321
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180321,
					"content": "„Wenn wir das Mondlicht einladen möchten, bei uns zu bleiben, müssen wir zuerst die Türen öffnen, die einst fest verschlossen waren.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180322
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180322,
					"content": "... So ist es passiert. Wenn ich mir die Situation der letzten Tage ansehe, dann scheint alles besser gelaufen zu sein, als ich gedacht hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180323
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180323,
					"content": "Frau Lauma, eine neue Lieferung Steine ist im Lager eingetroffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180324
					],
					"speakerTitle": "Maciej"
				},
				{
					"id": 761180324,
					"content": "Verstanden. Ich komme sofort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180325
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180325,
					"content": "Könntet ihr das, was ich gesagt habe und was ihr gesehen habt, vorerst vor Columbina geheim halten? Ich möchte, dass es eine Überraschung wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180326
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180326,
					"content": "Paimon weiß, dass du es gut meinst, aber ehrlich gesagt bist du wirklich besessen von deinen Überraschungen ... Und deine Mondgöttin auch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180327,
					"content": "Meine Lippen sind versiegelt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180328
					]
				},
				{
					"id": 761180328,
					"content": "He, Lauma, wegen Paimons Schweigegeld ... Äh, Paimon meinte damit, haben wir heute zufällig noch übrige Portionen Mondschmaus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180329,
					"content": "Ja, das haben wir. Kommt, ich bereite euch etwas zu. Ach, und noch etwas ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		},
