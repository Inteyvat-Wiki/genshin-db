			},
			"dialogs": [
				{
					"id": 751270101,
					"content": "Ah, bist du auch hier, um ein Foto zu machen? Schon früher sind Reisende aus der Ferne gekommen, um Erinnerungen festzuhalten. Diese schwebende Insel ist ja auch eine Augenweide ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270102
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270102,
					"content": "Schade, dass ich früher keine Kamera hatte. Ich musste extra einen fremden Händler bitten, mir eine zu besorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270103
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270103,
					"content": "Wie steht’s, edler Gast? Möchtest du ein Bild aufnehmen? Allerdings müsstest du es selbst machen, ich bin nicht so gut mit der Kamera ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270104
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270104,
					"content": "Seltsam, der Nebel über dem Meer ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270105
					]
				},
				{
					"id": 751270105,
					"content": "Nebel über dem Meer? Was redest du da, bei dem starken Wind hier gibt es doch keinen Nebel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270106
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270106,
					"content": "Seit ich lebe, habe ich noch nie Nebel über dem Meer gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270107
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270107,
					"content": "Verwechselst du das hier vielleicht mit der nebelverhangenen Gegend unter Tezcatepetonco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270108
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270108,
					"content": "Vielleicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270109
					]
				},
				{
					"id": 751270109,
					"content": "Hehe, wenn du mich fragst, edler Gast, du bist einfach nur zu angespannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270110
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270110,
					"content": "Für eine Reise durch Natlan wäre mehr Gelassenheit ratsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sakaw"
				}
			]
		}
	]
