			"trigger": {
				"objectNames": [
					"Tlamot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260101,
					"content": "Dieser arme kleine Yumkasaurier ... Das war’s, diesen Schurken werd ich’s zeigen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260102
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260102,
					"content": "Ihr könnt weglaufen, ihr Rüpel, aber ihr könnt euch nicht verstecken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260103
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260103,
					"content": "Was ist passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260104
					]
				},
				{
					"id": 250260104,
					"content": "#Du bist ... ein{F#e} Reisende{M#r} aus der Ferne? Sei gegrüßt! Wobei ich fürchte, dass ich dir keine weitere Gastfreundschaft gewähren kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260105
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260105,
					"content": "Diese elenden Schatzsucher hatten es wieder auf den kleinen Yumkasaurier abgesehen. Zum Glück war ich zur Stelle, um sie zu verjagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260106
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260106,
					"content": "Aber der arme Yumkasaurier hat sich zu Tode erschreckt. Er kommt nicht näher, egal wie ich ihn rufe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260107
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260107,
					"content": "Doch jetzt habe ich ihr Versteck gefunden. Ich werde ihnen eine Lektion erteilen, und wenn ich das getan habe, werde ich sie an einen Baum binden und ihnen mit einem Ast eine verpassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260108
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260108,
					"content": "Außerdem muss ich etwas Leckeres finden, um den armen verängstigten Yumkasaurier zu trösten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
		{
			"id": 2502602,
			"completionStepIds": [
				2502601,
				2502606
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2502601",
							"2"
						],
						"stepId": 2502601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tlamot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260201,
					"content": "Ich würde vorschlagen, dass du erstmal den Yumkasaurier tröstest.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260202
					]
				},
				{
					"id": 250260202,
					"content": "Hmm ... Da hast du schon recht. Das arme Kind hat schon genug Angst gehabt. Na gut. Beruhigen wir ihn erst einmal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260203
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260203,
					"content": "#Dann komm mit. So, wie du aussiehst, musst du ein{F#e} erfahrene{M#r} Abenteurer{F#in} sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260204
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260204,
					"content": "Wenn wir beide dabei sind, werden die Diebe nichts wagen. Und mach dir keine Sorgen wegen der Bezahlung. Ich kenne die Regeln der Gilde und ich werde sie befolgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260206
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260206,
					"content": "Der kleine Saurier isst so gern Fackelparasolpilze ... Und wenn ich mich recht erinnere, wachsen viele von ihnen unter dem Baum dort drüben. Warum fängst du nicht an, welche zu pflücken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260205
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260205,
					"content": "Ich werde auf der anderen Seite Fackelparasolpilze sammeln. Wenn du auch fertig bist, treffen wir uns auf der Klippe in der Nähe der Arena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260207
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260207,
					"content": "Das ist der Ort, an dem der kleine Saurier normalerweise eine Pause macht. Vielleicht können wir ihn dort finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
		{
			"id": 2502603,
			"completionStepIds": [
				2502603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2502603",
							"2"
						],
						"stepId": 2502603,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
