				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tlamot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260301,
					"content": "Hier hält er sich normalerweise auf, aber heute ist keine Spur von ihm zu sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260302
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260302,
					"content": "Er muss sich nach diesem Schreck versteckt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260303
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260303,
					"content": "Sollen wir nach ihm suchen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260304
					]
				},
				{
					"id": 250260304,
					"content": "Nein. Lassen wir ihn eine Weile in Ruhe. Wir lassen die Pilze einfach hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260305
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260305,
					"content": "Du hast einiges an Erfahrung, wie ich sehe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260306
					]
				},
				{
					"id": 250260306,
					"content": "Darin, wie man sich um Kinder kümmert? Sicher. Es dauerte ein bisschen und ich weiß, dass er sensibel ist. Selbst der Anblick von Fremden könnte ihn erschrecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260307
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260307,
					"content": "Erst nachdem ich ihn lange Zeit gefüttert hatte, war er bereit, sich mir zu nähern ... Aber ich bezweifle, dass er in nächster Zeit wieder herauskommt, jetzt, da diese Schurken alles durcheinandergebracht haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260308
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260308,
					"content": "Wir müssen ihn eine Weile in Ruhe lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260309
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260309,
					"content": "Danke, dass du gekommen bist. Hier ist die Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260310,
						250260311
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260310,
					"content": "Es ist nur schade, dass wir ihn nicht sehen konnten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				},
				{
					"id": 250260312,
					"content": "Keine Sorge, er erinnert sich an diejenigen, die sich für ihn eingesetzt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260311,
					"content": "Ich hätte den kleinen Yumkasaurier gern kennengelernt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				}
			]
		},
