			},
			"dialogs": [
				{
					"id": 250260401,
					"content": "Los, erteilen wir diesen Schatzräubern eine Lektion.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260402
					]
				},
				{
					"id": 250260402,
					"content": "#Willst du mitkommen? Ich danke dir! Du wärst echt eine große Hilfe. Ich weiß, dass du ein{F#e} erfahrene{M#r} Abenteurer{F#in} bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260403
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260403,
					"content": "Ich werde dich so bezahlen, wie es die Regeln der Abenteurergilde vorsehen. Dann lass uns gehen! Wir werden es diesen Schurken schon zeigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
		{
			"id": 2502605,
			"completionStepIds": [
