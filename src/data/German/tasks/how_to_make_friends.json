				]
			},
			"dialogs": [
				{
					"id": 250260501,
					"content": "Hmpf. Mal sehen, ob sie es noch einmal wagen, meinen kleinen Yumkasaurier zu verletzen, was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260502
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260502,
					"content": "Ich habe das Gefühl, dass es sich um ein Missverständnis handelt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260503
					]
				},
				{
					"id": 250260503,
					"content": "Hört nicht auf ihre schönen Worte. Ich habe mit eigenen Augen gesehen, wie sie dem armen Yumkasaurier ein Seil an den Schwanz gebunden haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260504
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260504,
					"content": "Wer weiß, was passiert wäre, wenn ich nicht rechtzeitig aufgetaucht wäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260505
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260505,
					"content": "Auf jeden Fall vielen Dank für deine Hilfe. Hier ist deine Bezahlung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260506
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260506,
					"content": "Es ist nur schade, dass sie so schnell geflohen sind. Hätten wir sie erwischt, hätten wir ihrem Treiben ein für alle Mal ein Ende setzen können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
