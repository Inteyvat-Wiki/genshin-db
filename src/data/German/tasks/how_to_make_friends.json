			"dialogs": [
				{
					"id": 250260601,
					"content": "Pst, sieh mal da drüben. Er wartet auf uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260602
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260602,
					"content": "... *brüll*? *brüll*... *brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260603
					],
					"speakerTitle": "Scheuer kleiner Yumkasaurier"
				},
				{
					"id": 250260603,
					"content": "Braves Kind, komm her, wir tun dir nicht weh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260604
					],
					"speakerTitle": "Tlamot"
				},
