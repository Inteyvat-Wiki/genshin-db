			"dialogs": [
				{
					"id": 3900401,
					"content": "Sieht aus, als hätten wir alles richtig gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3900402,
					"content": "In diesem Turm gibt es noch drei leuchtende Ringe, die ihn schützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900403
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3900403,
					"content": "Das heißt, wir müssen noch drei weitere <color=#00E1FFFF>Lichtleiter</color> aktivieren, um alle Siegel zu brechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900404
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3900404,
					"content": "Ah, von hier aus kann man einen sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900405
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3900405,
					"content": "Die anderen sind bestimmt innerhalb der Ruinen. Wir sollten überall um den Turm herum suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900406
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3900406,
					"content": "Warum musste Dvalin ausgerechnet einen Ort auswählen, der voller Vorrichtungen und Siegel ist? Ist das nicht auch für ihn anstrengend?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3900407,
					"content": "Er muss nicht durch das Tor gehen. Er kann doch fliegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3900408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3900408,
					"content": "Da ... hast du recht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
