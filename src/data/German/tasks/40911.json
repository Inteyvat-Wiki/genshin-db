			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110103
					]
				},
				{
					"id": 409110101,
					"content": "#{F#Reisende}{M#Reisender}, bitte warte einen Augenblick ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110102
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110103,
					"content": "Es ist mir etwas unangenehm, dich zu fragen, aber ich muss dich um einen Gefallen bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110104
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110104,
					"content": "Du weißt sicherlich, ich studiere seit Ewigkeiten Alchimie. Dennoch habe ich bisher nicht wirklich einen Durchbruch auf dem Gebiet erzielt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110105
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110105,
					"content": "Wenn ich meine Studien weiterführe wie bisher, werden sich meine alchimistischen Fähigkeiten nie bessern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110106
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110107,
					"content": "Du willst also Bio-Alchimie studieren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110108
					]
				},
				{
					"id": 409110109,
					"content": "Du willst also altertümliche Alchimie studieren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110110
					]
				},
				{
					"id": 409110106,
					"content": "Also begann ich, einen anderen Weg einzuschlagen, und wollte einen neuen Forschungszweig eröffnen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110107,
						409110109
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110108,
					"content": "Das ... also dieses Feld wurde ja bereits erforscht. Das lohnt sich nicht wirklich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110110,
					"content": "Altertümliche Alchimie? Nein, soweit fortgeschritten bin ich noch nicht mit meinen Studien ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110111,
					"content": "Weißt du, was bei der Alchimie am wichtigsten ist? Die „Elemente“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110112
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110112,
					"content": "Aus verschiedenen Gründen nutzt man generell in der Alchimie Materialien, die mit Elementarenergie durchzogen sind, nicht die reine Elementarkraft selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110113
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110113,
					"content": "Natürlich bewirkt die Nutzung solcher Materialien Unreinheiten im Alchimieverfahren. Diese Unreinheiten wiederum haben Einfluss auf die Effizienz der Elementarreaktion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110114
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110114,
					"content": "Um die Unreinheiten auszugleichen, werden größere Mengen an Material verwendet und selbst dann kann das Verfahren ohne ständige Beobachtung immer noch fehlschlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110115
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110115,
					"content": "Für die jedoch, die ohne Göttliches Auge auskommen müssen und in die Alchimie einsteigen wollen, ist dies nur ein notwendiger Preis, der gezahlt werden muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110116
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110116,
					"content": "Eins der größten Probleme ist, dass die Preise für diese elementaren Materialien nicht gerade erschwinglich sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110117
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110117,
					"content": "Am Ende eines Alchimievorgangs ist die Rechnung wichtiger als der Erfolg ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110118
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110119,
					"content": "Ich besitze ebenfalls kein „Göttliches Auge“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110120
					]
				},
				{
					"id": 409110121,
					"content": "Was brauchst du dann von mir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110122
					]
				},
				{
					"id": 409110118,
					"content": "Vielleicht ist das der Grund, warum meine Alchimieversuche niemals einen Durchbruch hatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110119,
						409110123
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110120,
					"content": "Richtig ... Obwohl ich gehört habe, du seist in der Lage, die Elemente zu manipulieren. Stimmt das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110123
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110122,
					"content": "Obwohl du kein Göttliches Auge besitzt, kannst du, wie ich gehört habe, Elemente kontrollieren, korrekt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110123
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110123,
					"content": "Es ist so, ich habe eine neue Art von Alchimie-Brennofen gebaut. Ich nenne ihn <color=#00E1FFFF>Elementarofen</color>. Die Theorie dahinter ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110124
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110124,
					"content": "Einfach gesagt, es ist ein Behältnis, das reine Elemente halten kann und somit elementare Reaktionen auslöst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110125
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110125,
					"content": "Vielleicht bringt mir der Elementarofen endlich den erwünschten Durchbruch im Feld der Alchimie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110126
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110126,
					"content": "Alles, was mir jetzt noch fehlt, ist jemand, der die Elemente frei manipulieren kann, der mir hilft, sie zu „transportieren“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110127
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110127,
					"content": "Wenn du einwilligst mir zu helfen, begib dich bitte zum <color=#00E1FFFF>Tempel der Tausend Winde</color> und such mich dort. Ich habe bereits jemanden gebeten, dort alles vorzubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110128
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110128,
					"content": "Ich hoffe, dass meine Alchimie dieses Mal gelingt und mir den Durchbruch bringt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		},
		{
			"id": 4091103,
