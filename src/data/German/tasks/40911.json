			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110301,
					"content": "Da bist du ja! Schau, dies ist mein <color=#00E1FFFF>Elementarofen</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110302
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110302,
					"content": "Lasst uns nicht weiter warten und endlich mit dem Experiment beginnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		},
		{
			"id": 4091104,
			"completionStepIds": [
				4091104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4091104",
							"2"
						],
						"stepId": 4091104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110401,
					"content": "Ich muss ihn nur noch ein paarmal einschalten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110402
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110402,
					"content": "#{F#Reisende}{M#Reisender}, gut, dass du da bist! Erinnerst du dich an den Elementarofen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110403
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110403,
					"content": "Nachdem du ihn angeworfen hattest, war ich in der Lage, viele interessante Daten zu sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110404
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110404,
					"content": "Was am wichtigsten ist, ich konnte die Zuverlässigkeit bestätigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110405
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110405,
					"content": "Mit einem so zuverlässigen Apparat können wir viele weitere Experimente in Zukunft durchführen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110406
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110406,
					"content": "#{F#Reisende}{M#Reisender}, könnt ihr mir noch einmal helfen, den Elementarofen anzufeuern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110407,
						409110409
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110407,
					"content": "Nicht im Geringsten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110408
					]
				},
				{
					"id": 409110408,
					"content": "Dann vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110409,
					"content": "Wie viele Experimente willst du denn durchführen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110410
					]
				},
				{
					"id": 409110410,
					"content": "Je mehr, desto besser! Ein Alchimist wie ich ohne Göttliches Auge muss auf herkömmliche Methoden bauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110411
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110411,
					"content": "#Habt vielen Dank, {F#Reisende}{M#Reisender}, dann helft mir bitte noch einmal, den Elementarofen anzufeuern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		}
	]
}