			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Neko“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721640201,
					"content": "Ist dein „Saubermachen“ bald fertig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640202
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640202,
					"content": "Alles ist blitzeblank.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640203
					]
				},
				{
					"id": 721640203,
					"content": "Miau, miau. Das ist gut. Ich habe auch die kleinen Krabbeltiere verjagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640204
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640204,
					"content": "Oh, dieser Schrein sieht mehr und mehr nach einem aus. Das Kästchen ist repariert und der Schrein selbst ist sauber ... Ja, mehr Menschen sollten kommen und ihren Respekt zollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640205
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640205,
					"content": "Miau, miau ... Wir müssen die ehemalige Pracht des Schreins wiederherstellen, ja ... Miau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640206
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640206,
					"content": "Hier hören wir auf. Danke für deine Hilfe bis hierhin ... miau, miau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640207
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640207,
					"content": "Eure Sprache zu sprechen ist ... ermüdend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640208
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640208,
					"content": "Ich werde mich ausruhen. Vielleicht wird deine Hilfe später auch benötigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640209
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640209,
					"content": "Wenn diese Zeit kommt, kehrt hierher zurück ... miau, miau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				}
			]
		},
		{
			"id": 7216403,
			"completionStepIds": [],
