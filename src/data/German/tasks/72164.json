			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"„Neko“",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721640101,
					"content": "Miau, miau ... Diese Truhe hat ihren Wert wohl bewiesen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640102
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640102,
					"content": "Ah, du bist zurück. Dieses Kästchen, das du repariert hast, hat seine Effizienz wirklich unter Beweis gestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640103
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640103,
					"content": "Nicht lange nach deiner Abreise kamen zwei Menschen in Grün zu dem Schrein, miau, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640104
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640104,
					"content": "Sie haben nicht nur ein paar Mora gespendet, sondern der große, grüne Mensch schien am aufgeregtesten, wenn er mich sprechen hörte. Wie einfach ihr Menschen zu erstaunen seid, wirklich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640105
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640105,
					"content": "Trotzdem, das Spendenkästchen ist ein wahrlich wundersames Artefakt. Vielleicht lockt es noch mehr Menschen an, ein weiteres zu reparieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640106
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640106,
					"content": "Uh, so funktioniert das nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640107
					]
				},
				{
					"id": 721640107,
					"content": "So? Menschliche Angelegenheiten sind wirklich sehr lästig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640108
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640108,
					"content": "P... Paimon denkt, dass das viel mehr mit dem Zustand des Schreins zu tun hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640109,
					"content": "Und was ist mit meinem Schrein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640110,
						721640111
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640110,
					"content": "Er ist ein wenig durcheinander ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640112
					]
				},
				{
					"id": 721640112,
					"content": "Hä, ist das so? Diese kleinen Rabauken genießen es sehr, in den abgefallenen Blättern zu spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640113
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640113,
					"content": "Ah, aber wenn ich mich richtig daran erinnere, hat Hibiki einen langen Stab mit spitzen Enden verwendet, um einen Stapel Blätter zu formen. Wenn sie das gemacht hat, muss es das Richtige sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640114,
						721640115
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640114,
					"content": "Was muss gekehrt werden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640116
					]
				},
				{
					"id": 721640116,
					"content": "Was könnte ich über die Feinheiten menschlicher Tätigkeiten wissen? Trotzdem ... wenn es Hibiki wäre ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640117
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640117,
					"content": "Hibiki hat oft diesen Stab genommen und vor Sonnenaufgang mit ihm hin und her gewunken. Ich habe es sehr genossen, den Stab zu jagen, ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640118
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640118,
					"content": "Aber jetzt, da ich die vorläufige Oberpriesterin bin, ist ein solch flegelhaftes Verhalten nicht in Ordnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640119
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640119,
					"content": "Ich erinnere mich, dass Hibiki auch Wasser auf dem Boden verwendete ... Eine schlimme Sache, wirklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640120
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640120,
					"content": "Domeki kam auch manchmal vorbei und er hat gekreuzte Metallplatten durch die Luft zischen lassen! Und die Zweige und Blätter sind heruntergefallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640121,
						721640123
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640121,
					"content": "Domeki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640122
					]
				},
				{
					"id": 721640122,
					"content": "Ein sehr großer und lauter Mensch. Er und Hibiki haben viel zusammen gespielt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640125
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640125,
					"content": "Hmpf. Dieser Rabauke hat immer die gleichen Zweige abgehackt, die ich am meisten geliebt habe. Er bringt einen zur Weißglut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640126
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640126,
					"content": "So, wie es klingt, haben sie saubergemacht. Man kann es wohl auch Neuorganisation nennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640127,
					"content": "Den Boden wischen, ihn mit Wasser waschen, die Zweige trimmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640128,
					"content": "So eine vertraute Arbeit, hm ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640129
					]
				},
				{
					"id": 721640129,
					"content": "Das war also das „Saubermachen“? Ich verstehe. Könntest du, wenn es so ist, losgehen und das machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640130
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640130,
					"content": "Ah, ja. Du kannst das Zischen überspringen. Ich mag die Zweige genau so, wie sie sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640131
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640131,
					"content": "Der lange Stab, Blätter und Wasser sind genug. Habt ihr meine Worte verstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640132,
						721640133
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640132,
					"content": "Mach dir keinen Kopf darum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640144
					]
				},
				{
					"id": 721640144,
					"content": "Miau! Ja, diese Arbeit wurde mir speziell von Hibiki gegeben. Eine wichtige Aufgabe, die von keinem anderen zu erledigen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640133,
					"content": "Könnte ich vielleicht fragen, wer Hibiki war?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640134
					]
				},
				{
					"id": 721640134,
					"content": "Hibiki ist Hibiki. Sie ist die Oberpriesterin vom Schrein Asase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640135
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640135,
					"content": "Und dein Name ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640136
					]
				},
				{
					"id": 721640136,
					"content": "Mein Name ist Neko, ein Name gegeben von Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640137
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640137,
					"content": "Es war sie, die oft herausgekommen ist, um Gäste beim Schrein zu empfangen. So muss ich den Schrein nicht führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640138
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640138,
					"content": "Damals hatte ich weder Name noch Titel. Ich schlief, wo ich wollte, und spielte, mit wem ich wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640139
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640139,
					"content": "Eines Tages sagte Hibiki, dass sie mich „Neko“ nennen würde, aufgrund meiner Angewohnheit zu schlafen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640140
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640140,
					"content": "Hibiki ist im Moment abwesend, aber ein Schrein ist kein Schrein ohne eine Oberpriesterin und daher habe ich den Posten übernommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640141
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640141,
					"content": "Daher hoffe ich auch, die frühere Lebhaftigkeit des Schreins zurückzubringen, bevor Hibiki zurückkehrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640142
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640142,
					"content": "... Das stimmt! Sobald sie zurückkehrt, kann ich an ihrer Brust einschlafen und muss nicht lange darauf warten, bis sie das Spendenkästchen repariert hat, oder warten, bis sie ihren langen Stab verwendet, um die Blätter zu entfernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640143
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640143,
					"content": "Na ja, ich will diese Aufgaben dir überlassen. Es gibt einige raffinierte Insekten, die sich in den Schrein geschlichen haben, und die müssen nun vertrieben werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640144
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640123,
					"content": "Zischen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640124
					]
				},
				{
					"id": 721640124,
					"content": "Neko spricht wahrscheinlich davon, die Zweige zu trimmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640115,
					"content": "Was genau muss getan werden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640116
					]
				},
				{
					"id": 721640111,
					"content": "Er sollte mal wieder gereinigt werden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640112
					]
				}
			]
		},
		{
			"id": 7216402,
			"completionStepIds": [
				7216443
			],
