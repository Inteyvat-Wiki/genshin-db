					"„Neko“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721640301,
					"content": "Miau! Ja, diese Arbeit wurde mir speziell von Hibiki gegeben. Eine wichtige Aufgabe, die von keinem anderen zu erledigen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640302,
						721640311
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640302,
					"content": "Also, zu deinem Namen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640303
					]
				},
				{
					"id": 721640303,
					"content": "Mein Name ist Neko, ein Name gegeben von Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640304
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640304,
					"content": "Es war sie, die oft herausgekommen ist, um Gäste beim Schrein zu empfangen. So muss ich den Schrein nicht führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640305
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640305,
					"content": "Damals hatte ich weder Name noch Titel. Ich schlief, wo ich wollte, und spielte, mit wem ich wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640306
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640306,
					"content": "Eines Tages sagte Hibiki, dass sie mich „Neko“ nennen würde, aufgrund meiner Angewohnheit zu schlafen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640307
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640307,
					"content": "Hibiki ist im Moment abwesend, aber ein Schrein ist kein Schrein ohne eine Oberpriesterin und daher habe ich den Posten übernommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640308
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640308,
					"content": "Daher hoffe ich auch, die frühere Lebhaftigkeit des Schreins zurückzubringen, bevor Hibiki zurückkehrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640309
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640309,
					"content": "Sobald sie zurückkehrt, kann ich an ihrer Brust einschlafen und muss nicht lange darauf warten, bis sie das Spendenkästchen repariert hat oder bis sie ihren langen Stab verwendet, um die abgefallenen Blätter zu entfernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640310
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640310,
					"content": "Na ja, ich will diese Aufgaben dir überlassen. Es gibt einige raffinierte Insekten, die sich in den Schrein geschlichen haben, und die müssen nun vertrieben werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640311,
					"content": "So, wer hat den Schrein sauber gehalten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640312
					]
				},
				{
					"id": 721640312,
					"content": "Es war Hibiki. Domeki hat ihr manchmal geholfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640313
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640313,
					"content": "Hibiki hat oft vor Sonnenausgang diesen Stab hin- und hergeschwenkt. Sie hat auch Wasser auf den Boden geschüttet. Igitt, Wasser ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640314
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640314,
					"content": "Warte. Hat sie zuerst das Wasser ausgeschüttet? Ich kann mich nicht ganz an den Ablauf der Ereignisse erinnern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640315
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 721640315,
					"content": "Domeki kam auch manchmal vorbei und er hat gekreuzte Metallplatten durch die Luft zischen lassen! Und die Zweige und Blätter sind heruntergefallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				}
			]
		},
