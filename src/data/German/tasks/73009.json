			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730090301,
					"content": "(Rana schläft so tief wie früher. Arana ist nicht da.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090302
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730090302,
					"content": "(Ein vages Bild von etwas erscheint in der „Blase“ heraus, in die Rana eingehüllt ist ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090303,
						730090307
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730090303,
					"content": "(Tauche ein in das Bild ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090304
					]
				},
				{
					"id": 730090304,
					"content": "Du befindest dich in einem Dschungel. Alles um dich herum ist riesig und tief, aber du fühlst dich sehr wohl.\\nDer gelegentlich durch die Blätter hindurchfallende Sonnenschein schimmert wie Goldfolie und das Gras, das so hoch wie du selbst ist, lacht mit leiser Stimme und berührt beim Vorbeigehen sanft deine Hand ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730090305
					]
				},
				{
					"id": 730090305,
					"content": "Wie du so dem Brummen der Bäume im Wind und dem Musizieren des fließenden Wassers lauschst, hörst du plötzlich ein trauriges Weinen. Folge dem Geräusch und du findest ein kleines Menschlein.\\nAls ob sie vom Weinen völlig erschöpft wäre, schläft sie auf dem Gras. Du gehst auf sie zu und singst ihr eine beruhigende Weise ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730090306
					]
				},
				{
					"id": 730090306,
					"content": "(... Ranas Zustand scheint sich nicht verschlechtert zu haben.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730090307,
					"content": "(Gehe leise weg.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
