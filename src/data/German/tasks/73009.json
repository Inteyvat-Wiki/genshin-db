					"Araja"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730091401,
					"content": "Über „Marana“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091402
					]
				},
				{
					"id": 730091402,
					"content": "Diese Geschichte ist lange her ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091403
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091403,
					"content": "Vor langer Zeit wandelten die Aranara auf der Erde und freundeten sich mit Nara und allen lebenden Geschöpfen an. Im Wald gab es Marana noch nicht, bis vor vielen, vielen Monden eine Katastrophe geschah ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091404
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091404,
					"content": "Viele kehrten nach Sarva zurück und Marana trat in Erscheinung. Als der Wald seine Lebenskraft wieder zurückgewonnen hatte, versteckten die Aranara das wahre Vanarana in einem Traum, um sich zu schützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091405
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091405,
					"content": "Der Wald kannte den Tod nicht, bis die Bäume eines Tages erkannten, dass der Boden von verwelkten Blumen und toten Tieren überströmt war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091406
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091406,
					"content": "So wie am selben Tag erinnerte sich die Erde an das dunkle, giftige Blut, das sie verschlungen haben könnte. Die Flüsse dachten an die rote Welt, die nach Sonnenuntergang aufkommen und in der alles Wasser verdampfen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091407
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091407,
					"content": "Sie erkannten, dass alles Leben sein Ende nehmen würde. Zu dieser Zeit wurde „Marana“ geboren. Es ist der Name des „Todes“ und alle, die um seine Existenz wissen, werden letztendlich sterben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091408
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091408,
					"content": "Seine Macht ist der Tod. Die großen, dunklen, verkrümmten Kreaturen sind Inkarnationen, Marana für sich ausgewählt hat. Boten des Todes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091409
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091409,
					"content": "Natürlich. In meinen Geschichten kann die „Inkarnation von Marana“ unterschiedliche Gestalten annehmen. Manchmal sind sie Tiere, manchmal sind sie Vögel. Manchmal sind sie Nara, manchmal sind sie eine Plage ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091410
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091410,
					"content": "Aber diese Geschichte ist in der Tat nichts anderes als eine Geschichte und nicht länger eine meiner Erinnerungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
		},
