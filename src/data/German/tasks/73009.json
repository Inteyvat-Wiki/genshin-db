			"dialogs": [
				{
					"id": 730091001,
					"content": "Über die „Vasoma“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091002
					]
				},
				{
					"id": 730091002,
					"content": "Sie ist eine Frucht voller Energie. Um zu wachsen, nimmt sie die Erinnerungen und Träume in der Erde auf, und sie braucht die Hilfe der Aranara und Nara, um zu reifen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091003
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091003,
					"content": "Wenn der „Ashvattha-Baum“ mit der Energie der Vasoma versorgt wird, entsteht eine Bija. Der Baum wurde von der Höheren Herrin Rukkhadevata persönlich angepflanzt und ist der Ursprung der Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
		},
