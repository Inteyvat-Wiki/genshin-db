			},
			"dialogs": [
				{
					"id": 730091101,
					"content": "Über das „Aranyaka“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091102
					]
				},
				{
					"id": 730091102,
					"content": "#Nara Varuna hat es hinterlassen. {M#Sie}{F#Er} war ein goldener Nara, der so gütig, mutig und aufrichtig wie du war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091103
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091103,
					"content": "#Ich erinnere mich, wie die Aranara zu jenen Zeiten {M#sie}{F#ihn} vermissten und {M#ihre}{F#seine} Geschichten liebten. Aber ich bin der festen Ansicht, da wir heute Nara {NICKNAME} haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
		},
		{
			"id": 7300912,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
