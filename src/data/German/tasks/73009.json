					"nextDialogs": [
						730091202
					]
				},
				{
					"id": 730091202,
					"content": "Ja. Ich freue mich darauf, das Utsava-Fest mit euch zu feiern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
		},
		{
			"id": 7300913,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
