					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090802
					]
				},
				{
					"id": 730090802,
					"content": "Wo du es gerade erwähnst, Arakavi benötigt sicher Hilfe bei der Organisation des Festes. Du solltest ihn im Zentrum von Vanarana antreffen können.",
					"roleType": "TALK_ROLE_NPC",
