				"objectNames": [
					"Arana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730090101,
					"content": "Arana wird sich um sie kümmern. Denn sie ist Aranas wichtigste Freundin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090102
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090102,
					"content": "#Nara {NICKNAME}, bitte gehe nach „Vanarana“ und singe die „Melodie des Großen Traums“. Dann bitte sie, die „Bija“ vorzubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090103,
						730090104
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090103,
					"content": "Ich verstehe nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090106
					]
				},
				{
					"id": 730090106,
					"content": "So wie die Wolken verstehen, dass sie abregnen müssen und das Regenwasser versteht, dass es im Boden versickern muss. Die Samen verstehen, dass sie wachsen, zu großen Bäumen werden und reiche Frucht tragen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090104,
					"content": "Ich ... Ich verstehe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090105
					]
				},
				{
					"id": 730090105,
					"content": "#Nara {NICKNAME}, du hast es anscheinend noch nicht verstanden, aber kein Problem. Zu gegebener Zeit wird Nara {NICKNAME} verstehen, was zu tun ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090106
					],
					"speakerTitle": "Arana"
				}
			]
		},
		{
			"id": 7300902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
