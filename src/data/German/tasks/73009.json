					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730090202,
					"content": "(Ich muss Rana helfen, sich schneller zu erholen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 730090203,
					"content": "(Wir gehen besser leise.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7300903,
			"completionStepIds": [],
