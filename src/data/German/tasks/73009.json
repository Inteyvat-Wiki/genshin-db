				"objectNames": [
					"Araja"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730091301,
					"content": "#Dank Nara {NICKNAME} und Paimon konnte ich erst das Utsava-Fest mitfeiern. Danke euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091302
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091302,
					"content": "Leider kann ich weder dir helfen noch dich bei deinen Abenteuern begleiten wie Arama und die anderen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091303
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091303,
					"content": "Aber dieser Traum heißt euch für immer willkommen. Wenn ihr der Außenwelt überdrüssig seid, kommt nach Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
		},
		{
			"id": 7300914,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
