			},
			"dialogs": [
				{
					"id": 745250401,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250402,
						745250403
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250402,
					"content": "Du siehst ziemlich ernst aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250404
					]
				},
				{
					"id": 745250404,
					"content": "Ach, du bist es. Nein, meine Untersuchung für heute ist bereits abgeschlossen. Hier in der Umgebung wurde vorerst nichts Verdächtiges entdeckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250405
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250405,
					"content": "Ich frage mich nur, warum die Goldbrigade, die gerade vorbeigekommen ist, so niedergeschlagen aussah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250406,
						745250407
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250406,
					"content": "Vielleicht sind sie von der Reise erschöpft?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250408,
					"content": "Ich vermute, es liegt am Geld. Immerhin ist eine Goldbrigade ohne „Gold“ doch nur eine halbe Brigade, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250409,
						745250410
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250409,
					"content": "... Wie wäre es mit etwas Spannendem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250411,
					"content": "Verstanden. Allerdings könnte das Bild etwas langweilig wirken, wenn ich einfach nur still dastehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250412
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250412,
					"content": "Keine Sorge, ich werde meine Elektrokräfte einsetzen, damit dein Bild richtig „strahlt“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250413
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250413,
					"content": "... Eine gute Idee, ich werde schöne Fotos machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250414
					]
				},
				{
					"id": 745250414,
					"content": "Hm. Ich verlasse mich auf dich. Verpasse nicht den „entscheidenden Moment“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250410,
					"content": "Lass mich ein Foto von dir machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250407,
					"content": "Oder liegt es daran, dass einer ihrer Aufträge gescheitert ist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250403,
					"content": "Bist du etwa auf der Jagd nach einem Verbrecher?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250404
					]
				}
			]
		}
	]
