				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620101,
					"content": "#{F#Reisende}{M#Reisender}, du kommst gerade rechtzeitig. Hier ist ein Auftrag, um den ich dich bitten muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620102,
						716620103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620102,
					"content": "Ist es etwas Gefährliches?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620104
					]
				},
				{
					"id": 716620104,
					"content": "Nun, es geht um einen bisher unbekannten Bereich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620105,
					"content": "Obwohl die Gilde umfangreiche Untersuchungen in diesem Bereich durchgeführt hat, sind wir noch nicht zu nennenswerten Ergebnissen gekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620106,
					"content": "Honglang, der mit den Ermittlungen betraut ist, sagt, er brauche einen Abenteurer, der gut improvisieren kann, um bei den Ermittlungen zu helfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620107,
					"content": "#{F#Die}{M#Der} erste, an {F#die}{M#den} ich dachte, warst du, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620108,
					"content": "Um was für eine Sphäre geht es hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620109
					]
				},
				{
					"id": 716620109,
					"content": "Honglang befindet sich neben dem Eingang zu dieser Sphäre. Wenn du bereit bist zu helfen, kannst du ihn fragen, was er braucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620110,
					"content": "#Dann zähle ich auf dich, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620103,
					"content": "Wird es schwierig sein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620104
					]
				}
			]
		},
		{
			"id": 7166202,
			"completionStepIds": [
				7166202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166202",
							"2"
						],
						"stepId": 7166202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Honglang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620201,
					"content": "Was ist nur mit der Sphäre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620202
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620202,
					"content": "Wegen der Mission ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620203
					]
				},
				{
					"id": 716620203,
					"content": "#Hm? Bist du ... Moment mal, bist du {F#die}{M#der} Abenteurer{F#in}, von {F#der}{M#dem} Katheryne gesprochen hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620204
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620204,
					"content": "#Ich habe gehört, dass du gut improvisieren kannst, dich mit allen Arten von Abenteuern auskennst und eine{M#r} der besten bist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620205,
						716620206
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620205,
					"content": "Genau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620207
					]
				},
				{
					"id": 716620207,
					"content": "Ich bin froh, dass du hier bist, dann habe ich ein gutes Gefühl ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620208
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620208,
					"content": "Aber die Sphäre ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620209
					]
				},
				{
					"id": 716620209,
					"content": "Fast hätte ich es vergessen ... Ich muss dich noch über die Situation informieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620210
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620210,
					"content": "Das ist so. Vor einiger Zeit fand eine kleine Truppe von Abenteurern der Gilde ein seltsames Tor in der Wildnis ... das neben mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620211
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620211,
					"content": "Nachdem sie dieses Tor durchschritten hatten, betrat die Truppe eine unbekannte Sphäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620212
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620212,
					"content": "Die ersten Abenteurer, die die Sphäre betraten, sagten, sie sei wie ein „leerer Raum“ gewesen, als sie hineingingen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620213,
						716620214
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620213,
					"content": "Was meinst du damit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620215
					]
				},
				{
					"id": 716620215,
					"content": "Dies ist nur eine Beschreibung für einen Bereich, der „etwa zweiundfünfzig Schritte lang, zweiundfünfzig Schritte breit und von unbekannter Höhe“ ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620216
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620216,
					"content": "Im Umkreis von zweiundfünfzig Schritten um diesen Bereich befinden sich die üblichen mit Steinplatten gepflasterten Flächen, aber der Bereich jenseits der zweiundfünfzig Schritte ist von einer Art dunkelgrauem Nebel erfüllt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620217
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620217,
					"content": "Und wenn jemand die Grenze in ein Gebiet überschreiten will, das zweiundfünfzig Schritte entfernt ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620218
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620218,
					"content": "Drehte sich die Person entweder auf unerklärliche Weise um und ging in die entgegengesetzte Richtung ... oder sie verschwand plötzlich und tauchte dann hinter allen anderen wieder auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620219
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620219,
					"content": "Kurz gesagt, egal welche Methode angewandt wurde, niemand konnte das Gebiet jenseits der zweiundfünfzig Schritte betreten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620220
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620220,
					"content": "Hat man versucht, mit anderen Werkzeugen das Gebiet zu erkunden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620221
					]
				},
				{
					"id": 716620221,
					"content": "Sie versuchten es natürlich, aber alles, was sie warfen, kehrte an dieselbe Stelle zurück, und nicht einmal das Licht der Fackeln konnte den Bereich jenseits der zweiundfünfzig Schritte durchdringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620222
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620222,
					"content": "Du möchtest also, dass ich dir helfe, diesen Ort zu untersuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620223,
					"content": "Ja, aber ... du musst vielleicht mehr tun, als nur zu „erkunden“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620224
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620224,
					"content": "Das kann man hier nicht genau erklären, gehen wir also zur Sphäre ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620214,
					"content": "Leerer ... Raum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620215
					]
				},
				{
					"id": 716620206,
					"content": "Das kann man so sagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620207
					]
				}
			]
		},
		{
			"id": 7166203,
			"completionStepIds": [
				7166204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166204",
							"2"
						],
						"stepId": 7166204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Honglang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620301,
					"content": "Hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620302,
					"content": "Ist das derselbe geheime Ort wie der von dir erwähnte „leere Raum“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620303,
						716620304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620303,
					"content": "Es ist eine normale Sphäre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620305
					]
				},
				{
					"id": 716620305,
					"content": "Ja! Ist das nicht die Art von Ruine, die wir immer erforschen?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620306,
					"content": "Das ist in der Tat der Bereich, den wir erforschen wollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620307
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620307,
					"content": "Und warum es so aussieht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620308
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620308,
					"content": "Das liegt daran, dass diese Sphäre vor nicht allzu langer Zeit ihre Form geändert hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620309
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620309,
					"content": "Äh ... Ähm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620310,
					"content": "Wie „geworden“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620311
					]
				},
				{
					"id": 716620311,
					"content": "Das ist richtig. Dieses Gebiet verwandelt sich nach den Wünschen der Menschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620312
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620312,
					"content": "Nach Aussage des Truppenführers der Abenteurertruppe, der das Abenteuer zu diesem Zeitpunkt leitete, waren sie so lange in dieser grauen und trüben Umgebung herumgewandert, dass alle langsam die Geduld verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620313
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620313,
					"content": "In diesem Moment begann eines der Mitglieder zu meckern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620314
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620314,
					"content": "„Wäre dies ein gewöhnliches Gebiet, hätten wir es schon längst erforscht.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620315
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620315,
					"content": "Hungrig und schläfrig stimmten ihm die Männer der Abenteuertruppe zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620316
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620316,
					"content": "Als immer mehr Menschen dieser Ansicht zustimmten, befand sich die Abenteurertruppe irgendwann plötzlich in einer „gewöhnlichen Ruine“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620317
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620317,
					"content": "Diese „gewöhnliche Sphäre“ enthielt Vorrichtungen, Wege, Schätze ... sogar Fackeln, die noch brannten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620318
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620318,
					"content": "Da die Abenteurer glaubten, die Situation nicht allein regeln zu könne, kehrten die Abenteurer sofort zur Gilde zurück, um den Vorfall zu melden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620319
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620319,
					"content": "Wir haben schnell zusätzliches Personal eingesetzt und eine gründlichere Untersuchung der Sphäre eingeleitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620320
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620320,
					"content": "Allerdings wissen wir bis heute nur, dass sich diese Sphäre nach dem Willen einer Person verändern kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620321
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620321,
					"content": "Wenn mehr als eine Person gleichzeitig die Sphäre betritt, verändert sich das Reich nach der Person mit dem stärksten Wunsch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620322
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620322,
					"content": "Oho! Dieser Ort kann also in ein weiteres Liyue verwandelt werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620323,
					"content": "Wir haben das versucht, aber es hat nie funktioniert ... Ich glaube, unser Wille, dies in einen weiteren Liyue-Hafen zu verwandeln, war nicht stark genug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620324
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620324,
					"content": "Wie dem auch sei, wir versammeln derzeit Abenteurer, die dieses Gebiet betreten und alle möglichen Veränderungen nach ihren Wünschen herbeiführen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620325
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620325,
					"content": "Auf diese Weise können wir vielleicht bestimmte Muster des Wandels in dieser Sphäre erkennen und so die Antworten finden, nach denen wir suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620326,
						716620327
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620326,
					"content": "Und wie mache ich das?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620328
					]
				},
				{
					"id": 716620328,
					"content": "Siehst du die Vorrichtung dort drüben? Das ist der „Auslöser“, den wir festgelegt haben, und es war ein Abenteurer, der die Idee dazu hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620329
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620329,
					"content": "Vereinfacht ausgedrückt war sein Wunsch, „diese Sphäre nur dann verändern zu können, wenn wir diesen Mechanismus berühren“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620330
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620330,
					"content": "Die Sphäre hat diese Wünsche erhört, aber um sicherzustellen, dass diese Vorrichtung hier bleibt, müssen wir ihn regelmäßig zurückholen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620331
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620331,
					"content": "Ich kann nicht glauben, dass es so eine Methode gibt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620332
					]
				},
				{
					"id": 716620332,
					"content": "Wenn es nicht einige dieser Unwägbarkeiten gäbe, würde sich das Gebiet ständig verändern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620333
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620333,
					"content": "Aber wenn du es aus einem anderen Blickwinkel betrachtest, ist diese Sphäre wirklich sehr gut geeignet, um Abenteurer zu trainieren. Ich meine, nur ein Gedanke und alle möglichen Vorrichtungen und Terrains können im Handumdrehen auftauchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620334
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620334,
					"content": "Ich bin sicher, dass du es nicht verstehen würdest, wenn wir nur darüber reden, also warum probierst du es nicht einfach selbst aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620335
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620335,
					"content": "Siehst du die goldenen „Abenteuertaler“ dort drüben? Auch das ist ein kleines Detail, das wir aus unseren Wünschen erstellt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620336
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620336,
					"content": "#Reisende{M#r}, versuch du zuerst, die „Abenteuertaler“ zu bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620327,
					"content": "Gibt es dafür eine besondere Methode?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620328
					]
				},
				{
					"id": 716620304,
					"content": "Sieht ziemlich gewöhnlich aus ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620305
					]
				}
			]
		},
		{
