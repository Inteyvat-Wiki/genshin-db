				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620401,
					"content": "Oha! Das war ziemlich beeindruckend. Du hast dich hier wirklich schnell zurechtgefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620402
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620402,
					"content": "Wenn das so ist, zählen wir auf dich. Nutze all deinen Verstand und deine Fantasie, um diese Sphäre zu verwandeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620403
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620403,
					"content": "Ich hoffe, dass wir die Gesetzmäßigkeiten der Änderungen in dieser Sphäre bald verstehen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Honglang"
				}
			]
		},
