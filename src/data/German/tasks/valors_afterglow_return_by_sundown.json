	"talks": [
		{
			"id": 7103604,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103801",
							"2"
						],
						"stepId": 7103801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360401,
					"content": "Hallo! Bitte sucht euch einen Platz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360402
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360402,
					"content": "Über Abenteuergeschichten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360403
					]
				},
				{
					"id": 710360403,
					"content": "Willst du fragen, warum ich früher so stur war und alle so genervt habe? Haha ... Ich weiß, dass ich falsch liege, bitte belehre mich nicht mehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360404
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360404,
					"content": "Aber andererseits liegt es wohl in der Natur von uns Abenteurern, dass wir von der „Gefahr“ besessen sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360405
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360405,
					"content": "Schließlich werden wir mit einem starken Rückgrat und flinken Gliedern geboren ... Es ist nicht leicht, sich ein Leben ohne Wind und Wellen vorzustellen, wenn man so scharfe Waffen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360406
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360406,
					"content": "Was das Risiko von Todesfällen angeht, so ist es nicht so, dass ich es nicht in Betracht gezogen hätte, aber ... darf ich dir eine Frage stellen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360407
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360407,
					"content": "Schieß los.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360408
					]
				},
				{
					"id": 710360408,
					"content": "Der große Abenteurer Stanley von Mondstadt ist berühmt für seine Überquerung des Mare Jivari ... ein Abenteuer, bei dem er seinen besten Freund verlor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360409
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360409,
					"content": "Wegen dieses Abenteuers ist sein lieber Freund gestorben ... Obwohl nur wenige wissen, wie er hieß, lebt die Erinnerung an ihn unter Abenteurern bis heute weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360410
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360410,
					"content": "Ich habe mich gefragt ... haha, bitte lach mich nicht aus, weil ich naiv bin. Könnte es sein, dass Stanleys Freund, der nie zurückkehrte, vielleicht gar nicht verstorben ist, sondern tatsächlich „lebt“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360411,
						710360414,
						710360418
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360411,
					"content": "Das Einzige, was zählt, ist das Leben selbst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360412
					]
				},
				{
					"id": 710360412,
					"content": "Aber ist nicht gerade die Tatsache, dass man sich an ihn erinnert, eine Art Lebensverlängerung, selbst wenn die Ursache sein früher Tod war?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360413
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360413,
					"content": "Und so lebt er auf andere Weise unter den Menschen weiter, durch die Sehnsucht und die Erinnerung, die Bewertung und den Blick der anderen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360422,
					"content": "Mach dir nicht so viele Gedanken darüber, was andere Leute denken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360423
					]
				},
				{
					"id": 710360423,
					"content": "Viele Leute haben mir geraten: „Sei einfach du selbst“, „Kümmere dich um deinen eigenen Kram“. Das sind aber Sätze, die einem zum Aufgeben motivieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360424
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360424,
					"content": "Wie ich bereits gesagt habe, sind meine Abenteuer nicht für andere bestimmt, nicht einmal für mich selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360425
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360425,
					"content": "Nun ... hast du jemals auf diese Weise darüber nachgedacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360426
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360426,
					"content": "Die Welt ist der Gnade der Götter ausgeliefert ... aber wir Sterblichen, auch ohne die „Augen“ von Göttern, sind genauso besessen davon, uns nicht mit Frieden und Vergessenheit zufriedenzugeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360427
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360427,
					"content": "Ich bin sicher, dass diese Widerwillen nicht unbegründet ist, und deshalb renne ich um mein Leben, um diese gefährlichen Orte zu erkunden. Immerhin, ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360428
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360428,
					"content": "In einem schwachen Körper mit der Ewigkeit zu ringen, die selbst die Götter fürchten, macht einen Menschen „menschlich“ ... Das glaube ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360429,
						710360432
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360429,
					"content": "Aber du bist nicht der Einzige, der dem Abenteuer einen Sinn gibt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360430
					]
				},
				{
					"id": 710360430,
					"content": "Ja ... ich verstehe. Ich werde die Hilfe aller und den Ärger, den ich dir bereitet habe, nicht vergessen ... Schließlich geht es bei diesem Abenteuer nicht nur um mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360437,
					"content": "Haha, wenn das nicht der Abenteurer ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360432,
					"content": "Willst du so den Helden spielen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360433
					]
				},
				{
					"id": 710360433,
					"content": "Ich bin nicht so gut wie du ... Ich bin nicht so gut wie ein Held, aber „Es sind die, die leben wollen, die keine Angst vor dem Sterben haben“, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360434
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360434,
					"content": "Das hat mir ein Abenteuer aus Sumeru erzählt, die es auch in der Goldbrigade gehört hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360435
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360435,
					"content": "Oh, das klingt gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360436
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360436,
					"content": "Es ist eher so, dass du dem Pech einen Schritt nach dem anderen folgst ... dieser Mensch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710360414,
					"content": "Wenn man in Erinnerung bleibt, ist es auch ein Erfolg, denke ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360415
					]
				},
				{
					"id": 710360415,
					"content": "Nun ... ich wollte nie ein „erfolgreiches“ Leben führen. Im Gegenteil, selbst wenn ich „versage“, ist es gut, bei allen einen Eindruck zu hinterlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360416
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360416,
					"content": "Zumindest wird jemand sagen: „Dieser Mann, Zhiqiong, hat sogar die Große Kluft herausgefordert!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360417
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360417,
					"content": "Zumindest wird es nicht so sein wie bei denen, die vor mir im Niemandsland gestorben sind ... oder zumindest nicht so vergessen wie ich jetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360418,
					"content": "An solche Fragen habe ich nie gedacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360419
					]
				},
				{
					"id": 710360419,
					"content": "Ist das so ... Vielleicht liegt das daran, dass ein Außenstehender wie du natürlich im Mittelpunkt der Aufmerksamkeit steht, egal wohin du gehst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360420
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360420,
					"content": "Genauso wie ein Kind, das mit einem goldenen Löffel im Mund geboren wurde, Armut nur als ein aufregendes Abenteuer sieht, das nicht notwendig ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360421
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360421,
					"content": "Ah, entschuldige ... So habe ich es nicht gemeint, ich meinte nur ... nichts. Tut einfach so, als ob ich nicht gefragt hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhiqiong"
				}
			]
		},
		{
			"id": 7103802,
			"completionStepIds": [
				7103802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103802",
							"2"
						],
						"stepId": 7103802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710380201,
					"content": "Es ist wieder Zhiqiong, sie ist gegangen, um die Baken zu holen ... Aber sie ist noch nicht zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380202
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380202,
					"content": "Ich wusste, dass sie dazu neigt, umherzuwandern, und gab ihr drei Stunden extra für den Rückweg ... Aber jetzt sind es schon mindestens fünf oder sechs Stunden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380203
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380203,
					"content": "Dieses Kind hat großen Respekt vor dir, also hilf mir bitte, sie wiederzufinden. Ich möchte nicht, dass irgendjemandem unter meiner Aufsicht noch etwas zustößt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380204
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380204,
					"content": "He! Was ist los mit ihr? Warum ist sie wieder weg?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380205,
						710380206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710380205,
					"content": "Gut, dann mache ich das.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710380207
					]
				},
				{
					"id": 710380207,
					"content": "Ah, ja! Ich habe vergessen, dir die wichtigste Information zu geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380208
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380208,
					"content": "Sie ging wahrscheinlich nicht sehr weit, aber wo sollte sie auch hingehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380209
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380209,
					"content": "Schon gut, mach dir keine Sorgen, Jinwu! Wir gehen zuerst zu dem Ort, an dem wir gestern die Baken aufgestellt haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710380210,
					"content": "Paimon hat recht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710380211
					]
				},
				{
					"id": 710380211,
					"content": "Na gut ... also los. Wenn du sie findest, informiere mich bitte so schnell wie möglich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380206,
					"content": "Wo finde ich sie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710380207
					]
				}
			]
		},
