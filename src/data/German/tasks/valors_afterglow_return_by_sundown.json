			},
			"dialogs": [
				{
					"id": 710380601,
					"content": "Khedive gab ihr etwas Medizin ... Zhiqiong kam wieder ein wenig zu sich, aber sie sagte nichts zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380602
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380602,
					"content": "Wisst ihr, was mit ihr passiert ist? Wie konnte sich ein lebhafter Mensch so entwickeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380603
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380603,
					"content": "Wir haben sie gefunden, als sie in dem schwarzen Schlamm gefangen war.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710380604
					]
				},
				{
					"id": 710380604,
					"content": "Ja! Es ist gut, dass wir sie rechtzeitig rausgeholt haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710380605,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380606
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380606,
					"content": "Das ist erst einmal egal. Was Zhiqiong jetzt braucht, ist Ruhe. Könntest du mir helfen, ihr die Suppe zu bringen, solange sie noch heiß ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380607
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380607,
					"content": "Ich bin kein guter Koch, aber ich habe mich sowieso schon oft um die Bergleute gekümmert. Bisher hat sich noch niemand über mein Gericht beschwert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380608
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380608,
					"content": "Nun, geh und sieh nach, ob es Zhiqiong besser geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380609
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380609,
					"content": "Ich muss Muning zu verstehen geben, dass Zhiqiong nicht im Untergrund bleiben kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
