			},
			"dialogs": [
				{
					"id": 710380408,
					"content": "Mann, sie ist in einem schlechten Zustand! Holen wir sie zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380401,
						710380402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710380401,
					"content": "Kannst du noch laufen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710380403
					]
				},
				{
					"id": 710380402,
					"content": "Hab keine Angst, ich bringe dich zurück.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710380403
					]
				},
				{
					"id": 710380403,
					"content": "Es tut mir leid ... Jinwu ... und ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380406
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710380406,
					"content": "Bitte nicht ... ähem ... äh ... Schaut mich nicht so an ... Bitte seid nicht enttäuscht von uns ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380407
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710380407,
					"content": "Die goldene Stadt ... der schwarze Turm ... ähem! Die Boten des Himmels ziehen ab ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380404
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710380404,
					"content": "Rede keinen Blödsinn! Du bist ja einer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
