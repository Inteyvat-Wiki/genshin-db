					"id": 710381601,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710381602
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710381602,
					"content": "... Entschuldigung, ich habe an etwas anderes gedacht. Es tut mir leid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710381603
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710381603,
					"content": "Ich werde mit ihr reden müssen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710381604
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710381604,
					"content": "Es ist ja nicht so, dass ich Kinder wie sie nicht schon gesehen hätte, als ich in den Minen gearbeitet habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710381605
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710381605,
					"content": "Es gibt zu viele, die wie sie das Abenteuer als eine Art edles Streben ansehen, nur um dann festzustellen, dass ihre Hoffnungen zunichtegemacht wurden ... und dass es zu spät ist, ihre Entscheidungen zu revidieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710381606
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710381606,
					"content": "Aber wer bin ich schon, dass ich urteilen kann? *seufz* Wie könnte ein Glasglöckchen, das in einer Felsspalte gedeiht, einen Vogel für seine Lebensweise kritisieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710381607
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710381607,
					"content": "Und trotzdem, wie kann ich einfach so loslassen ... *hust* Weißt du was? Vielleicht ist es das Falsche, sie aufzuhalten. Ich meine, sie ist doch erwachsen und kann schon auf sich selbst aufpassen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710381608,
						710381609
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710381608,
					"content": "Es wird ihr gut gehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710381610
					]
				},
				{
					"id": 710381610,
					"content": "Ich nehme an ... Ich hoffe, dass du recht hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710381609,
					"content": "Sie wird ihre Entscheidungen nicht bereuen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710381610
					]
				}
