						710380702
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710380702,
					"content": "Du weißt nun auch, dass es dir leidtut! Warum hast du nicht daran gedacht, dass es dir leidtut, als du herumgelaufen bist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710380703,
					"content": "Paimon, es ist in Ordnung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710380704
					]
				},
				{
					"id": 710380704,
					"content": "Ähm ... ha ... Es war ... ein Ausrutscher ... ein versehentlicher ... Ausrutscher ... Irgendwie lustig ... haha ... oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380705
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710380705,
					"content": "Was ist daran so lustig! Nimmst du dein Leben nicht ernst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710380706,
					"content": "Du brauchst Ruhe. Jinwu hat dir eine Suppe gemacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
