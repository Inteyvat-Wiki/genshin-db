						710380304
					]
				},
				{
					"id": 710380304,
					"content": "Nun ... Bitte findet sie so schnell wie möglich. Falls etwas passiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
