				},
				{
					"id": 710380708,
					"content": "Ist schon gut, nach einem guten Schlaf wird es mir besser gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380709
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710380709,
					"content": "Es tut mir wirklich sehr leid ... *hust* Könntest du bitte bald wiederkommen?",
					"roleType": "TALK_ROLE_NPC",
