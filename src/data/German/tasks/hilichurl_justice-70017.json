			"dialogs": [
				{
					"id": 700170201,
					"content": "Yeye dada! Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700170202
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700170202,
					"content": "Du Wei zido dala? Mi mito nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700170203
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700170203,
					"content": "Hm, das ist seltsam — dieser behauptet, nichts darüber zu wissen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700170204
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700170204,
					"content": "Mi mito du, du ya mito Wei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700170205
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700170205,
					"content": "Und jetzt zeigt er auf die Karte und sagt, dass jemand, den er hier kennt, den merkwürdigen Hilichurl vielleicht schon gesehen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700170206
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700170206,
					"content": "Valo, mimi tomo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hilichurl"
				}
