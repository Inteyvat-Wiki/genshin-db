					},
					{
						"sceneId": 1083,
						"position": [
							5.38,
							0,
							6.033
						],
						"pointId": 15
					},
					{
						"sceneId": 1083,
						"position": [
							1.877,
							0,
							-1.993
						],
						"pointId": 31
					},
					{
						"sceneId": 1083,
						"position": [
							1.88,
							0,
							-0.955
						],
						"pointId": 32
					}
				]
			},
			"dialogs": [
				{
					"id": 740350201,
					"content": "#{F#Reisende}{M#Reisender}, wie schön, dass du uns mal wieder besuchst. Möchtest du eine Tasse Kaffee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350202,
						740350203
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350202,
					"content": "Übrigens, ich bin ein bisschen neugierig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350204
					]
				},
				{
					"id": 740350204,
					"content": "Paimon wollte schon vorher fragen, aber ... aber die anderen haben sich so laut unterhalten, dass Paimon sich nicht traute zu sprechen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350243,
					"content": "Ich habe damit gerechnet, dass man mich sofort hinausschmeißt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350205
					]
				},
				{
					"id": 740350205,
					"content": "Warum? Haha, bitte macht euch darüber keine Sorgen. Da die Wache euch hereingelassen hat, warum sollten wir es auf uns nehmen, euch hinauszuwerfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350206
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350206,
					"content": "#Auch das ist ein Beispiel für eine klare Delegation von Befugnissen und Verantwortung. Sehr erfreut, {F#Reisende}{M#Reisender}, ich bin Semaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350207,
						740350208
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350207,
					"content": "Freut mich auch, dich kennenzulernen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350209
					]
				},
				{
					"id": 740350209,
					"content": "Herr Semaine war früher als Assistentsekretär am Gericht tätig. Er wurde wegen einiger ... Angelegenheiten zurück in die Maison Gestion versetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350210
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350210,
					"content": "Er hat mit rationaler Präzision für viele Probleme Lösungen gefunden, die wir vorher nicht lösen konnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350211
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350211,
					"content": "Das ist ein bisschen übertrieben. Ich habe lediglich meine früheren Berufserfahrungen übertragen und den Wert bestimmter Dinge benutzt, um daraus auf die Bedeutung der damit verbundenen Angelegenheiten zu schließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350212
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350212,
					"content": "In der Praxis stoße ich gelegentlich auf Dinge, die nicht messbar sind. In solchen Fällen kann mir der Sinn für Fairness und Gerechtigkeit, in dem sich Herr Roialte sehr gut auskennt, eine große Hilfe sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350213
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350213,
					"content": "Das bedeutet also ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350214
					]
				},
				{
					"id": 740350214,
					"content": "Kurz gesagt, Herr Semaine ist sehr gut darin, die Gefühle aller auszugleichen und jedem das Gefühl zu geben, wichtig zu sein. Er ist wie das Zünglein an der Waage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350215
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350215,
					"content": "Wenn es nicht klappt, dann kann ich ein bisschen „rhetorisches Gewicht“ beisteuern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350216,
						740350217
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350216,
					"content": "Iaune scheint eine schwere Zeit zu haben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350218,
					"content": "Ja, es scheint, als könnte er jeden Moment ohnmächtig werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350219,
					"content": "So muss es für jeden sein, und wenn ich jetzt gehe und Iaune bei seiner Arbeit helfe, wird er sich nicht an diese Lektion erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350220
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350220,
					"content": "Er hatte immer unrealistische Vorstellungen von der Maison Gestion. Aber Vorstellungen zu haben, ist das Recht der jungen Menschen, nicht das der Angestellten der Maison Gestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350221
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350221,
					"content": "Und ich bin einfach nicht gut im Schreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350222
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350222,
					"content": "Du bist sehr direkt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350223
					]
				},
				{
					"id": 740350223,
					"content": "Also! Nun, darf ich erfahren, warum genau du hier bist? Ich werde sehen, ob ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350224
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350224,
					"content": "Iaune kommt plötzlich in Panik ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740350225
					]
				},
				{
					"id": 740350225,
					"content": "Was für ein Pech ... Herr Roialte, hast du eine Tastenkappe für die Schreibmaschine übrig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350226
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350226,
					"content": "Ich habe gerade getippt und plötzlich bemerkt, dass eine der Tastenkappen irgendwann verschwunden war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350227
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350227,
					"content": "Hast du in der Umgebung gesucht? Vielleicht ist sie einfach auf den Boden gefallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350228
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350228,
					"content": "Oder sie steckte in einem Buch, oder unter einem Ordner ... Hast du an diesen Stellen nachgesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350229
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350229,
					"content": "Und in Bleistifthaltern und Ärmeln.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350230
					]
				},
				{
					"id": 740350230,
					"content": "Und in Haaren und Teetassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350231,
					"content": "Ich habe überall nachgeschaut, sogar in den Taschen meiner Kleidung und in den Sohlen meiner Schuhe, aber da ist nichts zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350232
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350232,
					"content": "Nun, da musst du Fräulein Cornélia fragen. Wenn es wirklich ein „Ersatzteil“ für dieses Ding gibt, dann hätte man es auch bei ihr angefordert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350233
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350233,
					"content": "Ansonsten kaufe ich mir einfach selbst eine. Estelle würde nicht lange brauchen, um eine zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350234
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350234,
					"content": "Mein Iaune, warum musst du es selbst bezahlen? Es handelt sich um ein öffentliches Eigentum der Maison Gestion, und es ist nur angemessen, es bei Fräulein Cornélia zu beantragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350235
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350235,
					"content": "Es kostet doch nicht viel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350236
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350236,
					"content": "Es geht nicht darum, wie viel es kostet. Es ist eine Frage von Rechten und Pflichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350237
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350237,
					"content": "Die Instandhaltung des öffentlichen Eigentums der Maison Gestion sollte aus den öffentlichen Konten der Maison Gestion bezahlt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350238
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350238,
					"content": "Wenn du dafür mit deinen privaten Mitteln bezahlst und keinen Antrag auf Rückerstattung stellst, wird bei der Prüfung der Ausgaben am Ende des Jahres nicht klar sein, woher das Geld kam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350239
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350239,
					"content": "Na gut! Ich gehe zu Fräulein Cornélia ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350240,
						740350241
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350240,
					"content": "Ich hätte nie gedacht, dass Einkaufen so anstrengend sein kann.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350242,
					"content": "Das ist normal in der Maison Gestion. Gehen wir zu Fräulein Cornélia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350241,
					"content": "Wieso kann das Geldausgeben so ein Problem sein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350217,
					"content": "Könnt ihr ihm nicht helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350208,
					"content": "Darf ich fragen, wer du bist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350209
					]
				},
				{
					"id": 740350203,
					"content": "Warum seid ihr überhaupt nicht überrascht, mich das letzte Mal zu sehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350204
					]
				}
			]
		},
		{
			"id": 7403503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
