			"dialogs": [
				{
					"id": 740350301,
					"content": "Tastenkappe einer Schreibmaschine ... Semaine, kann man für solche Dinge eine Erstattung beantragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350302
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350302,
					"content": "Ich bin mir nicht sicher. Aber wenn die Schreibmaschine selbst erstattungsfähig ist ... dann sollte auch die Tastenkappe erstattungsfähig sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Semaine"
				}
			]
		},
		{
