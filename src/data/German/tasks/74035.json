			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740350101,
					"content": "#Ah, {F#Reisende}{M#Reisender} ... Schön, dich zu sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350102,
						740350103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350102,
					"content": "Wie geht es dir denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				},
				{
					"id": 740350104,
					"content": "Du hast dunkle Ringe unter den Augen und besitzt kaum Kraft zum Reden, vielleicht solltest du dich ausruhen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350105,
					"content": "Ich ... Ich kann mich noch nicht ausruhen ... Ich war die ganze letzte Nacht wach und habe mehrere Entwürfe geschrieben, aber keiner von ihnen war in Ordnung. Jetzt fange ich noch einmal an zu schreiben ... Ich muss noch einen schreiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350106
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350106,
					"content": "Wenn du etwas mit mir zu besprechen hast, warte bitte einen Moment ... Du kannst zu Herrn Roialte gehen und dir einen Stuhl holen, vielleicht hat er dort Kaffee ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350107,
					"content": "Ich ... Ich muss weiterschreiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350108,
					"content": "Nein, „Liebe Kolleginnen und Kollegen“ klingt irgendwie nicht förmlich genug ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350103,
					"content": "Du siehst nicht gut aus ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				}
			]
		},
		{
			"id": 7403502,
			"completionStepIds": [
				7403504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
