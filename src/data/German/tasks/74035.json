			"dialogs": [
				{
					"id": 740350601,
					"content": "Iaune, ist etwas nicht in Ordnung? Warum bist du so außer Atem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350602
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740350602,
					"content": "Estelle! Schnell, hol mir eine Tastenkappe für meine Schreibmaschine! Ich glaube, du hast hier eine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350603
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350603,
					"content": "Ja, aber es gibt viele Tastenkappen für Schreibmaschinen, also komm und sieh selbst, welche du haben willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350604
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740350604,
					"content": "Iaune fängt an, nach der gewünschten Tastenkappe zu suchen ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740350605
					]
				},
				{
					"id": 740350605,
					"content": "Das war’s, ich lege das Geld hier hin. Danke, Estelle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350606
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350606,
					"content": "Letztes Mal hast du gesagt, du würdest mit mir Boot fahren ... Iaune! He, Iaune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Estelle"
				}
			]
		},
