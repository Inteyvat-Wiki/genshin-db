					}
				]
			},
			"dialogs": [
				{
					"id": 740350401,
					"content": "Hallo, Herr Iaune, gibt es etwas, womit ich behilflich sein kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350402
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350402,
					"content": "Guten Tag, Frau Cornélia. Bitte, haben wir noch die Tastenkappe für die Schreibmaschine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350403,
					"content": "Was denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350404
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350404,
					"content": "Meiner Schreibmaschine fehlt eine Tastenkappe und ich möchte eine Ersatztastenkappe anfordern, um sie zu ersetzen. Wenn es keine gibt ... könntest du mir eine erstatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350405,
					"content": "Erstattung der Tastenkappe ... im Prinzip ist das in Ordnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350406
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350406,
					"content": "Bitte hier unterschreiben. Es sollte heißen „Eine Tastenkappe muss erstattet werden, weil die Schreibmaschine ohne diese Tastenkappe nicht mehr funktioniert“ und dann unterschreibe bitte mit deinem Namen und dem Namen deines Büros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350407
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350407,
					"content": "Gut, ich sollte diese Tastenkappe heute bekommen können, oder? Ich habe es ein bisschen eilig, zur Arbeit zu kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350408,
					"content": "Herr Iaune, hast du schon einmal für öffentliche Mittel Erstattung bekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350409
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350409,
					"content": "Die Erstattung für öffentliche Mittel ist überhaupt nicht so, wie du es dir vorstellst ... Wir müssen die Forderungen monatlich zusammenstellen und sie dann am Ende des Monats der Maison Cardinalice zur Genehmigung vorlegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350410
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350410,
					"content": "Dieses Genehmigungsverfahren steht im Zusammenhang mit der Genehmigung und Zahlung der Gehälter für die gesamte Maison Gestion. Wenn der Betrag zu hoch ist, muss die Maison Cardinalice dies sogar Herrn Neuvillette selbst zur Genehmigung vorlegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350427
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350427,
					"content": "Die Zuweisung wird erst dann offiziell beginnen, wenn er das Ganze geprüft und unterschrieben hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350411
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350411,
					"content": "Wenn Herr Neuvillette ein Problem mit einer Erstattung hat, muss die betreffende Person eine schriftliche Erklärung abgeben ... Wir werden den ersten Teil in den nächsten Tagen einreichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350412
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350412,
					"content": "Du meinst, wenn ich Pech habe, muss ich die Erstattung für diese Tastenkappe von Herrn Neuvillette genehmigen lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350413
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350413,
					"content": "Das ist die Vorschrift, Herr Iaune. Und der Betrag, der diesen Monat erstattet werden soll, ist beträchtlich und erfordert wahrscheinlich die Überprüfung durch Herrn Neuvillette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350414
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350414,
					"content": "Herr Neuvillette ... Ist das nicht der „Oberste Richter“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350415,
					"content": "Es ist doch nur eine Tastenkappe, und er muss sie unterschreiben ... Das klingt irgendwie komisch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350416,
						740350417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350416,
					"content": "Gibt es eine andere Wahl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350418
					]
				},
				{
					"id": 740350418,
					"content": "Das denke ich auch. Es ist nur eine Tastenkappe, es ist nicht nötig, Herrn Neuvillette damit zu belästigen, es ist wirklich nicht nötig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350419
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350419,
					"content": "Es gibt einen anderen Weg. Nun ... Du kannst dir selbst eine Tastenkappe kaufen, und ich gebe dir einen Schuldschein auf ein öffentliches Konto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350420
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350420,
					"content": "Wenn der Erstattungsprozess abgeschlossen ist und das Geld zugewiesen wurde, wird dir der entsprechende Betrag vom öffentlichen Konto ausgezahlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350421
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350421,
					"content": "Super! Machen wir es so, eine Tastenkappe kostet nicht viel, ich kann sie mir leisten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350422
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350422,
					"content": "Dann unterschreibe hier, und schreibe „eine Tastenkappe für eine defekte Schreibmaschine“ ... Willst du zu Frau Estelle gehen, um die Tastenkappe zu kaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350423
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350423,
					"content": "Ja, warum fragst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350424
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350424,
					"content": "Ich bringe diesen Schein später zu Herrn Roialte und lasse ihn unterschreiben, und dann gehe ich zu Frau Estelle, um die Rechnung zu prüfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350425
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350425,
					"content": "Mach dir darüber keine Sorgen, geh einfach schnell die Tastenkappe kaufen, und ich kümmere mich um den Rest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350426
					],
					"speakerTitle": "Cornélia"
				},
				{
					"id": 740350426,
					"content": "#Danke schön. Das ist sehr nett von dir, Frau Cornélia. Ich gehe und kaufe die Tastenkappe ... Komm, {F#Reisende}{M#Reisender}, lass uns loslegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350417,
					"content": "Lass es uns lieber anders machen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350427
					]
				}
			]
		},
