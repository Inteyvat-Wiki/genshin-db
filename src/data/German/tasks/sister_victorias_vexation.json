			},
			"dialogs": [
				{
					"id": 190010101,
					"content": "Ich hoffe sehr, dass es Barbara gut geht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010102
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010102,
					"content": "Was ist mit Barbara geschehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190010103
					]
				},
				{
					"id": 190010103,
					"content": "Barbara wollte vorhin Kräuter pflücken gehen, aber ich befürchte, dass sie noch nicht zurückgekehrt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010104
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010104,
					"content": "Hmm ... Vielleicht sollte ich diese Sache dem Ordo Favonius melden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010105
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010105,
					"content": "Ich werde Barbara suchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190010106
					]
				},
				{
					"id": 190010106,
					"content": "Du? Na ja ... Ich schätze, als Ehrenritter bist du sehr gut geeignet für diese Aufgabe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010107
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010107,
					"content": "Außerdem müsste ich die Angelegenheit nicht den Rittern melden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010108
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010108,
					"content": "Na gut, ich überlasse es dir. Bevor Barbara aufbrach, sagte sie, dass sie nach Wolfenlauf gehen würde, um ein paar Kräuter zu sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010109
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010109,
					"content": "Du solltest dort anfangen, nach ihr zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Victoria"
				}
			]
		},
