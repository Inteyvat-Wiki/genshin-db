			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530801,
					"content": "Wir haben viele wertvolle Informationen erhalten. Es ist an der Zeit, sie zu analysieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530802
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530802,
					"content": "Einige von ihnen sind leicht zu verstehen, aber der Rest ist ziemlich bizarr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530803
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530803,
					"content": "Du findest bestimmt heraus, wer und wo sie ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530804
					]
				},
				{
					"id": 191530804,
					"content": "Danke, ich werde mein Bestes tun. Jetzt lass mich nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530805
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530805,
					"content": "(Layla, Layla, konzentriere dich! Die Hinweise sind verworren, aber das ist kein Problem für dich.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530806
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530806,
					"content": "(Zuerst schließe ich anhand der Hinweise auf die Identität der Seelie.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530807
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530807,
					"content": "(Dann analysiere ich ihre Aktionen und Motive. Zum Schuss kombiniere ich alle Erkenntnisse ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530808
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530808,
					"content": "(So müsste ich zu einer Strategie gelangen. Ja, so werde ich es machen.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Layla"
				}
			]
		},
		{
			"id": 1915309,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1915304",
							"2"
						],
						"stepId": 1915304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530901,
					"content": "So ist das also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530902
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530902,
					"content": "Lass hören, zu welchem Ergebnis du gekommen bist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530903
					]
				},
				{
					"id": 191530903,
					"content": "Also, erstens, aus Katayouns Aussage können wir schließen, dass die Seelie eine „Studentin“ des Rtawahist-Instituts ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530904
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530904,
					"content": "Die Möglichkeit von Fremden haben wir ja schon ausgeschlossen und es gab keine Möglichkeit, die beiden Bücher an der Bibliothekarin vorbeizuschmuggeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530905
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530905,
					"content": "Weiter. Außer den fantastischen Kräften wurden alle Sichtungen an offiziellen astrologischen Beobachtungsorten des Instituts gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530906
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530906,
					"content": "Das heißt ... sie forscht vielleicht ... auf demselben Gebiet wie ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530907
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530907,
					"content": "Ich habe ihr keine leichten Fragen gestellt, aber sie konnte sie trotzdem innerhalb eines Tages beantworten. Sie verfügt also über ein ähnliches Hintergrundwissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530908
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530908,
					"content": "Demnach bräuchten wir nur am nächsten Beobachtungsort auf sie zu warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530909,
						191530910
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530909,
					"content": "Deine Schlussfolgerungen sind nachvollziehbar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				},
				{
					"id": 191530911,
					"content": "D... Danke, du überschätzt mich ... Und es gibt noch einige andere Gründe, die mir schon seit einiger Zeit durch den Kopf gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530912
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530912,
					"content": "... Aber das ist jetzt nicht wichtig. Lass uns zuerst das versuchen. Obwohl wir jetzt einige Spuren haben, bin ich mir nicht sicher, ob wir Erfolg haben werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530913
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530913,
					"content": "Und warum bin ich so wenig zuversichtlich ... Ich erkläre es dir, wenn sie nicht auftaucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530910,
					"content": "Mit einem solchen Talent kannst du deine Arbeit sicher fertigstellen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				}
			]
		}
	]
}