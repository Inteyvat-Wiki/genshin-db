			"dialogs": [
				{
					"id": 205120301,
					"content": "Hast du die Sachen gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120302,
					"content": "Ja, habe ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120303
					]
				},
				{
					"id": 205120303,
					"content": "Das ... sieht wirklich sehr reichhaltig aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120304,
					"content": "Kann man das wirklich verwenden, um Medizin herzustellen. Ich werde es selbst versuchen, sobald es erledigt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120305,
					"content": "Falls mir etwas passiert, pass bitte auf Anna auf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120306,
					"content": "... und gib sie in die Obhut von Schwester Grace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120307,
					"content": "Sag ihr, dass ich gegangen bin, um weit weg im Ausland zu arbeiten. Bitte, das ist mein letzter Wunsch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120308
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120308,
					"content": "He, he. Du machst dir selbst Angst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120309
					]
				},
				{
					"id": 205120309,
					"content": "Aber diese Medizin sieht so gruselig aus! Wie auch immer, nimm zuerst dies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120310
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120310,
					"content": "Und denk an das, was ich gesagt habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
	]
