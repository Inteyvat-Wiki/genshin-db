			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205120101,
					"content": "Dieses Rezept wurde gerade komischer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120102,
					"content": "Wie geht’s Anna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120103
					]
				},
				{
					"id": 205120103,
					"content": "Oh, du bist es. Na ja, es mag vielleicht schwer zu glauben sein, aber Anna sagt, dass sie sich jetzt viel besser fühlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120104,
					"content": "Vielleicht funktioniert das Rezept des Doktors wirklich? Ich kann es selbst kaum glauben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120105,
					"content": "Na ja, egal ob es stimmt oder nicht, Weitermachen ist das Beste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120106,
					"content": "Das Rezept dieses Mal ist ... Hmm. Könntest du mir helfen, „das feste Kondensat eines Hydro-Schleims“ zu finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120107,
						205120112,
						205120117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120107,
					"content": "Dieses klingt fast schon normal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120108
					]
				},
				{
					"id": 205120108,
					"content": "Hmm, wirklich? Ich denke, das Gegenteil ist der Fall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120109,
					"content": "Aber es ist zumindest einfach zu finden. Ich habe herumgefragt und sie sagten, dass man das feste Kondensat nur kriegt, wenn man die großen Schleime besiegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120110,
					"content": "Ich habe Jack sagen hören, dass du, wenn du es auf große Schleime abgesehen hast, geduldig die Kleinen vernichten musst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120111,
					"content": "Ich habe nicht diese Art von Kampffähigkeiten. Ich zähle also auf dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120112,
					"content": "Keine Sorge, diese könnte essbar sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120113
					]
				},
				{
					"id": 205120113,
					"content": "Und woher weißt du das? Hast du sie jemals probiert? Ähm, warum sagst du denn nichts?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120114,
					"content": "Was auch immer. Hydro-Schleime sollte recht einfach zu finden sein. Ich habe herumgefragt und andere haben gesagt, dass du „Festes Kondensat“ kriegen kannst, wenn du Große Schleime besiegst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120115,
					"content": "Ich habe Jack sagen hören, dass du, wenn du es auf große Schleime abgesehen hast, geduldig die Kleinen vernichten musst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120116,
					"content": "Ich habe nicht diese Art von Kampffähigkeiten. Ich zähle also auf dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120117,
					"content": "Ich weiß, wo es welche gibt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120118
					]
				},
				{
					"id": 205120118,
					"content": "Ja, das ist gut. Sieht so aus, als wärst du versiert im Umgang mit Schleimen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120119,
					"content": "Danke, dass du mir helfen willst. Du solltest es schaffen, einige „Feste Kondensate“ zu kriegen, nur indem du Große Schleime besiegst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120120,
					"content": "Ich habe Jack sagen hören, dass du, wenn du es auf große Schleime abgesehen hast, geduldig die Kleinen vernichten musst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120121
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120121,
					"content": "Ich danke dir schon im Voraus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
