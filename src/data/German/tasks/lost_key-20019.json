			"dialogs": [
				{
					"id": 200190201,
					"content": "Hast du den Schlüssel gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190202
					],
					"speakerTitle": "Wyatt"
				},
				{
