			"dialogs": [
				{
					"id": 200190101,
					"content": "#{F#Reisende}{M#Reisender}, du kommst genau richtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190102
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190102,
					"content": "Eigentlich war ich auf dem Weg nach Mondstadt, um diese Waren auszuliefern. Gestern Nacht kam ich hier an und fand diese leuchtenden Kugeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190103
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190103,
					"content": "Ich hatte ein paar zu viel und dann ... dann wollte ich mir diese Kugeln ansehen. Also bin ich rüber und habe erst zu spät gemerkt, dass es Schleime waren. Sie haben mich ziemlich zugerichtet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190104
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190104,
					"content": "Ich hatte so Angst und bin davongelaufen. Am Ende wusste ich nicht mehr, wo ich war, und habe meinen Wagen erst nach Stunden gefunden. Heute Morgen ist mir aufgefallen, dass mein <color=#00E1FFFF>Schlüssel</color> weg ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190105
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190105,
					"content": "Könntest du mir beim Suchen helfen? Er ist bestimmt hier irgendwo ... ganz in der Nähe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190106,
						200190108
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190106,
					"content": "In Ordnung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200190107
					]
				},
				{
					"id": 200190107,
					"content": "Sehr gut! Ich weiß gar nicht, wo ich anfangen soll zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190108,
					"content": "Eine dringende Angelegenheit wartet auf mich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200190109
					]
				},
				{
					"id": 200190109,
					"content": "Ich weiß doch gar nicht, wo ich anfangen soll zu suchen. Nur du kannst mir noch helfen, bitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wyatt"
				}
			]
		},
