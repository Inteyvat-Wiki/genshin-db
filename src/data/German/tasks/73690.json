			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Daya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736900101,
					"content": "Hallo, ich bin Daya vom Kshahrewar-Institut! Bist du wegen der Akademiemesse hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900102
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900102,
					"content": "Hier ist ein Vergnügungsprojekt, das von unserem Institut angeboten wird: „Wegplanung“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900103
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900103,
					"content": "Was meinst du? Möchtest du es ausprobieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900104
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900104,
					"content": "Ich dachte, das Kshahrewar-Institut konzentriert sich auf ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900105
					]
				},
				{
					"id": 736900105,
					"content": "Der Forschungsschwerpunkt unseres Insituts liegt im Bereich der Vorrichtungen und der Architektur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900107
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900107,
					"content": "Ähem, zurück zum Thema ... Um an diesjähriger Akademiemesse teilzunehmen, arbeiteten viele Studenten unseres Instituts zusammen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900108
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900108,
					"content": "Und am Ende wurde das Vergnügungsprojekt „Wegplanung“ entwickelt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900109
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900109,
					"content": "Vereinfacht gesagt, müssen die Spieler Wege mit verschiedenen Gegenständen bauen, die wir vorbereitet haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900110
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900110,
					"content": "Man kann alles Mögliche bauen, Brücken, Treppen und so weiter. Das Ziel ist es, einen Weg zu schaffen, auf dem die Leute reisen und ihr Ziel erreichen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900111
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900111,
					"content": "Am Ende der Bauphase werden wir eine Endabnahme durchführen, wie die Abnahme eines neu errichteten Gebäudes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900112
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900112,
					"content": "Kurz gesagt, wer einen sicheren Weg bauen kann, hat gewonnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900113,
						736900114
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900113,
					"content": "Klingt aber kompliziert ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				},
				{
					"id": 736900115,
					"content": "Hahaha, keine Sorge, es ist nicht so, als ob man wirklich ein Gebäude bauen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900116
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900116,
					"content": "Auch wenn ein Bau schiefgeht und der Weg zusammenbricht, spielt es keine Rolle. Man kann ihn einfach wieder aufbauen und wir werden die Anzahl der Versuche nicht begrenzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900117
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900117,
					"content": "Lass deiner Kreativität einfach freien Lauf und baue einen schönen Weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900118,
						736900120
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900118,
					"content": "Ich möchte es mal ausprobieren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900119
					]
				},
				{
					"id": 736900119,
					"content": "Klar, also schau mal hier entlang ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900120,
					"content": "Ich habe noch etwas zu tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900121
					]
				},
				{
					"id": 736900121,
					"content": "Ach so ... kein Problem, unser Stand bleibt während der gesamten Dauer der Akademiemesse geöffnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900122
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900122,
					"content": "Falls du es ausprobieren möchtest, komm einfach vorbei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900114,
					"content": "Ich habe kein Talent zum Bauen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				}
			]
		}
	]
}