			"dialogs": [
				{
					"id": 737140101,
					"content": "Hoho! Paimon hat sich die nächste Route ganz genau überlegt! Auch wenn wir noch ein Stück laufen müssen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
