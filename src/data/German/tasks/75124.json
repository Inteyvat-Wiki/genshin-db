					}
				]
			},
			"dialogs": [
				{
					"id": 751240101,
					"content": "*seufz* ... Schon wieder weggelaufen. Mal sehen ... Im Schwimmring ist doch nur noch einer übrig ... Was mache ich denn jetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240102
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240102,
					"content": "Wie lange soll das denn noch so weitergehen ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240103
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240103,
					"content": "Was, jemand knipst hier Bilder? Fotografiert er etwa ... die Wassertreiblinge?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240104,
					"content": "Diese Wassertreiblinge sind wirklich putzig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240105,
						751240107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240105,
					"content": "Ja, sie schunkeln schön ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240106
					]
				},
				{
					"id": 751240106,
					"content": "Ja, wie sie beim Laufen so watscheln, das ist einfach goldig. Und wenn sie sich aufblasen und wie kleine Bälle auf dem Wasser schaukeln, einfach zum Knuddeln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240109,
					"content": "Dieses kleine Wesen mit dem wunderschönen silbernen Haar hat absolut recht! Der Schöpfer der Wassertreiblinge verdient alle Anerkennung der Welt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240110
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240110,
					"content": "Wirklich erstaunlich. Ach, Verzeihung, ich habe mich noch gar nicht vorgestellt. Ich bin ein begeisterter Wassertreibling-Fotograf, nennt mich einfach Jonvelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240111
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240111,
					"content": "#Also, hier ist Paimon, und das ist {NICKNAME} ... Aber sag mal, Jonvelle, warum seufzt du so? Hier wimmelt es doch von Wassertreiblingen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240112,
					"content": "Ach, das ist eine lange Geschichte ... Aber ich mache es kurz, ich bin Jonvelle. Es gibt viele Fotografen, die Wassertreiblinge ablichten wollen, und jeder möchte das beste Foto machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240113
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240113,
					"content": "Vor ein paar Tagen kam mir eine brillante Idee: Was wäre, wenn ich ein Foto mache, auf dem jeder Wassertreibling einen Schwimmring trägt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240114,
						751240117
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240114,
					"content": "Was hat das für einen Sinn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240115
					]
				},
				{
					"id": 751240115,
					"content": "Natürlich, der Witz ist, dass es keinen Sinn gibt! Die Wassertreiblinge können von selbst schwimmen, aber sie tragen trotzdem Schwimmringe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240116
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240116,
					"content": "Das ist wie Mora verdienen, nur um noch mehr Mora zu bekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240120,
					"content": "Du legst einfach zu viel Gewicht auf die Schultern der Wassertreiblinge ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240121,
					"content": "Das ist wohl der Kern der surrealen Fotografie ... in den Aufnahmen einen tieferen Sinn zu finden ...! Aber dann bin ich auf ein Problem gestoßen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240122
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240122,
					"content": "In der Realität tragen Wassertreiblinge natürlich keine Schwimmringe ... Deshalb wird man so ein Bild nie schießen können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240123
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240123,
					"content": "Immerhin geht es ja um surreale Fotografie ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240124
					]
				},
				{
					"id": 751240124,
					"content": "#Aber es klingt so, als müssten wir nur alle Wassertreiblinge in Schwimmringe stecken, richtig? {NICKNAME}, wir lieben doch Wassertreiblinge, also lass uns helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240125,
						751240127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240125,
					"content": "Na ja, Wassertreibling-Enthusiasten sollten einander unterstützen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240126
					]
				},
				{
					"id": 751240126,
					"content": "Du hast recht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240129,
					"content": "Wirklich? Ihr seid bereit zu helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240130
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240130,
					"content": "Hehe, solange du uns danach ein paar schöne Bilder gibst, sind wir zufrieden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240131,
					"content": "Also, dann seid ihr zwei jetzt an der Reihe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240127,
					"content": "Ich bevorzuge zwar immer noch Gleithörnchen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240128
					]
				},
				{
					"id": 751240128,
					"content": "Jetzt hör aber mal auf, mit solchen Sprüchen die Stimmung zu verderben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240117,
					"content": "Kein normaler Mensch würde sich so etwas ausdenken ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240118
					]
				},
				{
					"id": 751240118,
					"content": "Die Wassertreiblinge können ja selbst schwimmen, aber sie tragen trotzdem Schwimmringe. Das verleiht dem Bild eine ganz eigene unnötige Tiefgründigkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240119
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240119,
					"content": "Hierdurch werden eigentlich Themen wie „übermäßige Nutzung“ und „Verschwendung“ aufgezeigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240107,
					"content": "Um ehrlich zu sein, ich mag lieber Gleithörnchen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240108
					]
				},
				{
					"id": 751240108,
					"content": "Klar, Gleithörnchen sind auch süß, aber wie kannst du bloß sagen, Gleithörnchen seien süßer als Wassertreiblinge, wenn sie vor deiner Nase so fröhlich herumpaddeln!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "Paimon"
				}
			]
		},
