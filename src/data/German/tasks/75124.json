			"dialogs": [
				{
					"id": 751240301,
					"content": "Oh, genau der richtige Moment!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240302
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240302,
					"content": "Das Bild, an dem ich so lange gearbeitet habe, ist mit eurer Hilfe endlich fertig geworden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240303
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240303,
					"content": "Hach, die Wassertreiblinge, wie sie in ihren Schwimmringen wackeln ... Das rührt einen fast zu Tränen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240304
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240304,
					"content": "Kann das wirklich so emotional sein ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240305
					]
				},
				{
					"id": 751240305,
					"content": "Was andere nicht verstehen können und als absurd empfinden, ist für uns genau das, worum sich dieses Leben dreht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240306
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240306,
					"content": "Ich bin mir sicher, wenn ich noch mehr niedliche Fotos von den Wassertreiblingen mache, wird die Schar ihrer Verehrer immer größer werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240307
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240307,
					"content": "Paimon glaubt auch fest, dass es so kommen wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240308,
					"content": "Ah, vielen Dank für eure Hilfe. *seufz* Hier, das ist ein kleines Dankeschön, bitte nehmt es an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jonvelle"
				}
			]
		},
