			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kleiner Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220020101,
					"content": "Lulu, wieso soll ich jetzt wieder der Kapitän sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020102
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220020102,
					"content": "Weil du, Meng, als Kapitän so gut bist, dass wir damit den meisten Spaß haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020103
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020103,
					"content": "Wenn du findest, dass es so am besten ist, Lulu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020104
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220020104,
					"content": "Was macht ihr denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020105
					]
				},
				{
					"id": 220020105,
					"content": "Wir möchten gerade ein Spiel spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020106
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020106,
					"content": "Meng ist der Kapitän, Fei ist Matrose und ich bin ein reicher Händler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020107
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020107,
					"content": "Uns fehlt noch ein Pirat, der uns ausraubt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020108
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020108,
					"content": "Willst du der Pirat sein und mit uns spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020109,
						220020111
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020109,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020110
					]
				},
				{
					"id": 220020110,
					"content": "Danke dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020113,
					"content": "Gut, sobald du bereit bist, kannst du einfach herkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020111,
					"content": "Ich will ein Guter sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020112
					]
				},
				{
					"id": 220020112,
					"content": "Wir spielen ja nur ein Spiel. Ich weiß doch, dass du ein guter Mensch bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "Kleine Lulu"
				}
			]
		},
		{
			"id": 2200202,
			"completionStepIds": [
				2200202
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200202",
							"2"
						],
						"stepId": 2200202,
						"stateName": "QUEST_STATE_UNFINISHED"
