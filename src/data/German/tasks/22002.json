				},
				{
					"id": 220020502,
					"content": "Noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020503
					]
				},
				{
					"id": 220020503,
					"content": "Schon gut, hat ja Zeit ... Obwohl ... Lieber doch eher als später.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020504
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020504,
					"content": "Wir haben so lange gespielt, dass wir ganz schön hungrig sind.",
