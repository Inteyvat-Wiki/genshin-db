				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kleine Lulu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220020201,
					"content": "Ich bin bereit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020202
					]
				},
				{
					"id": 220020202,
					"content": "Dann fangen wir mal an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020203
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020203,
					"content": "Gut, dann los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020204
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020204,
					"content": "Hallo, Überfall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020205
					]
				},
				{
					"id": 220020205,
					"content": "Am helllichten Tage willst du uns überfallen? Die Leute von den Millelithen sind gleich hier in der Nähe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020206
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220020206,
					"content": "Lulu, schnell, wir müssen fliehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020207
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220020207,
					"content": "Hallo, was hättest du denn gern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020208,
						220020209
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020208,
					"content": "Öhm, wie wär’s mit Geld?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					]
				},
				{
					"id": 220020212,
					"content": "Aber ich habe doch schon kaum Geld.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020213
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020213,
					"content": "Papa sagt, dass die wertvollsten Dinge auf einem Schiff die Waren der Händler sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020214
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020214,
					"content": "Na, dann eben so: Du suchst einfach ein paar wertvolle Dinge zusammen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020215
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020215,
					"content": "Dann habe ich etwas, das geraubt werden kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020216
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020216,
					"content": "Also du könntest doch ... ein paar Lotosfrüchte sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020217
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020217,
					"content": "Wir drei essen Lotos sehr gern. Deswegen passt es gut, wenn du als böser Pirat unseren Lotos raubst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020209,
					"content": "Dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020210
					]
				},
				{
					"id": 220020210,
					"content": "Das ist zwar ein Spiel, aber du musst trotzdem ein bisschen aufpassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020211
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020211,
					"content": "Siehst du? Die Leute von den Millelithen gucken schon her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					],
					"speakerTitle": "Kleine Lulu"
				}
			]
		},
