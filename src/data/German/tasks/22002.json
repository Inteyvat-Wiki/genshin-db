			"dialogs": [
				{
					"id": 220020301,
					"content": "Hast du die Lotosfrüchte gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020302
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020302,
					"content": "Ja, hier ist er.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020303
					]
				},
				{
					"id": 220020303,
					"content": "Danke dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020304
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020304,
					"content": "Meng, Fei, kommt her und esst etwas von dem Lotos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020305
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020305,
					"content": "He, wir spielen doch noch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220020306,
					"content": "Oh, ach so. Dann kriegst du hier das Geld und die Sachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020307
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020307,
					"content": "Du bist echt ein Spitzenpirat! Du hast so viel von kleinen Kindern geraubt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020308
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220020308,
					"content": "Hört Paimon da Sarkasmus heraus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220020309,
					"content": "Dankeschön! Das hat Spaß gemacht. Hoffentlich bist du das nächste Mal wieder da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleine Lulu"
				}
			]
		},
