				"points": []
			},
			"dialogs": [
				{
					"id": 705310101,
					"content": "Einen Moment bitte! Bist du hier, um an der „Ass-Beschwörer-Meisterschaft“ teilzunehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310102
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310102,
					"content": "Wenn du einen Moment Zeit hast, möchte ich dir „Tour der zahllosen Wunder“ vorstellen. Eine Veranstaltung der Abenteurergilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310103,
						705310104
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310103,
					"content": "Ich ... Ich habe tatsächlich Zeit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				},
				{
					"id": 705310105,
					"content": "Ich danke dir! Lass es mich dir ganz kurz erklären, wie die von der Gilde organisierte „Tour der zahllosen Wunder“ aussieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310106
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310106,
					"content": "Kurzum, wir von der Abenteurergilde haben in ganz Mondstadt eine Reihe von „Stempelstellen“ eingerichtet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310107
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310107,
					"content": "Alles, was du tun musst, ist, eine dieser Stellen zu finden und den Stempel bei ihr zu benutzen, um einen Erinnerungsstempel in das „Tourbuch“ zu stempeln, das du von uns bekommst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310108
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310108,
					"content": "Wenn du alle „Stempelstellen“ gefunden und alle Stempel gesammelt hast, hast du die Herausforderung abgeschlossen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310109
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310109,
					"content": "Diese Veranstaltung ... entspricht ganz dem Stil der Abenteurergilde ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310110
					]
				},
				{
					"id": 705310110,
					"content": "Hehe ... Die Orte, an denen die „Stempelstellen“ stehen, haben wir sorgfältig ausgewählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310111
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310111,
					"content": "Einige der „Stempelstellen“ liegen ... vielleicht etwas abgelegen und es könnten sich Monster in der Nähe aufhalten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310112
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310112,
					"content": "Aber ich denke, dass diese mit deinen Fähigkeiten kein Problem darstellen dürften!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310113
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310113,
					"content": "Also, hier ist dein „Tourbuch“. Viel Spaß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310104,
					"content": "Lass mich erstmal hören ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				}
			]
		}
	]
}