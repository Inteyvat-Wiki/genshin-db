			"dialogs": [
				{
					"id": 200500301,
					"content": "Geschafft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500302
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500302,
					"content": "Darauf wäre ich nie im Leben gekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500303
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500303,
					"content": "Danke dir! Ich werde es gleich selbst versuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		}
	]
