			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ellin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200500201,
					"content": "Und? Ist dir schon etwas eingefallen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500202
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500202,
					"content": "Ich hatte noch keine passende Idee ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500203
					]
				},
				{
					"id": 200500203,
					"content": "Na gut ... Ich bin schon einigen Abenteurern begegnet. So einige konnten mir bei solchen Problemen nicht weiterhelfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500204
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500204,
					"content": "Bei Monstern wissen sie immer sofort, was zu tun ist. Stehen ein paar Holzpflöcke vor ihnen, sind sie aber plötzlich ratlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500205
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500205,
					"content": "Dann verstärken sie die Pflöcke noch auf jede erdenkliche Weise, als hätten sie Angst, dass sie die Dinger zu schnell umhauen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500206
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500206,
					"content": "Wenn sie eine große Herausforderung suchen, können sie sich doch gleich ein riesiges Monster irgendwo in der Wildnis suchen, oder nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
