			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ellin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200500101,
					"content": "So ein Mist! Was soll ich denn jetzt tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500102,
					"content": "Was tust du denn hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500103
					]
				},
				{
					"id": 200500103,
					"content": "Ich trainiere für die nächste Ritterauswahl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500104,
					"content": "Aber na ja, ich bin natürlich nicht so stark wie Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500105,
					"content": "Ich glaube, ich sollte mich eher an die Technik als an die Stärke halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500106,
					"content": "Beispielsweise denke ich darüber nach, wie ich all die Holzpfähle mit einem Schlag abschlagen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500107,
					"content": "Wenn du Zeit und Lust hast, kannst du gern mit mir zusammen darüber nachdenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500108,
						200500109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500108,
					"content": "Ich überlege mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500110
					]
				},
				{
					"id": 200500110,
					"content": "Klar, lass dir Zeit. Die Holzpflöcke laufen ja nicht weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500111,
					"content": "Das einzige, was uns davonlaufen könnte, ist unsere Zeit ... und unser Leben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500114,
					"content": "Ich habe mal gehört, dass die Elemente miteinander interagieren. Wenn man dieses Feuerbecken zur Explosion bringen könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500115
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500115,
					"content": "Dafür müsste dort aber erstmal Feuer sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500109,
					"content": "Wir könnten es zusammen versuchen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500112
					]
				},
				{
					"id": 200500112,
					"content": "Kämpfst du sonst auch immer in der Gruppe? Beneidenswert ... jemanden zu haben, auf den man zählen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500113,
					"content": "Jemand wie ich muss lernen, allein zurechtzukommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
		{
			"id": 2005002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
