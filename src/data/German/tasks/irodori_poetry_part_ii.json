			"dialogs": [
				{
					"id": 726920601,
					"content": "Haha, ich habe gehört, dass es der Traum aller Mondstädter ist, so frei wie der Wind zu fliegen. Ehrlich gesagt, dass dieser Satz sehr gut zu Lenne passt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920602
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920602,
					"content": "Es ist nur schade, dass ich als Kind keinen Spaß am Fliegen hatte. Wenn ich damals einen Freund wie dich gehabt hätte, hätte ich jetzt vielleicht sogar einen Flugschein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
