			"dialogs": [
				{
					"id": 726920701,
					"content": "Kinder in Inazuma versammeln sich oft, um Geschichten über Youkai zu erzählen und den Mut der anderen zu testen. Diese Erlebnisse werden auch zu wertvollen Erinnerungen, wenn sie erwachsen geworden sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920702
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920702,
					"content": "Ich hätte nicht erwartet, dass Lenne das mit den Bildern dieser Kreaturen in Verbindung bringen würde. Diese Strophe hat in der Tat eine tiefe Bedeutung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
		},
