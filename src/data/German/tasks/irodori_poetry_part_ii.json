				"points": []
			},
			"dialogs": [
				{
					"id": 726920501,
					"content": "#{F#Junge Frau}{M#Junger Mann}, da sowohl du als auch Ootomo diesen Satz so lieben, lass ihn uns verwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920502
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920502,
					"content": "Lennes Gedicht und die Bilder ergänzen sich sehr gut. Ehrlich gesagt wird das Gedicht immer bewegender, wenn man sich gleichzeitig die Bilder ansieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920503
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920503,
					"content": "Um ehrlich zu sein, habe ich auch ein Gedicht geschrieben, für das ich morgen vielleicht deine Hilfe brauche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920504
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920504,
					"content": "Soll ich auch ein paar Fotos machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920505
					]
				},
				{
					"id": 726920505,
					"content": "Ha, lass uns morgen genauer darüber reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
		},
