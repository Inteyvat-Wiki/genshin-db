			"dialogs": [
				{
					"id": 726920401,
					"content": "Ich habe gehört, dass die Überquerung von Flüssen und Meeren sehr viel Zeit in Anspruch nimmt. Aber wenn ich einen Freund dabei hätte, wäre es sicher eine wunderbare Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
		},
		{
