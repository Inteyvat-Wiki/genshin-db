					"Ootomo",
					"Lenne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726920101,
					"content": "#{F#Junge Frau}{M#Junger Mann}, der perfekte Moment! Lenne und ich haben gerade an einem neuen Gedicht gearbeitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920102
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920102,
					"content": "Brauchst du meine Hilfe, um wieder etwas Inspiration zu bekommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920103
					]
				},
				{
					"id": 726920103,
					"content": "Haha, das ist richtig. Unter Ootomos Anleitung habe ich ein weiteres Gedicht im Inazuma-Stil verfasst, obwohl ich zugegebenermaßen noch ein ziemlicher Amateur bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920104
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920104,
					"content": "Das Thema dieses Gedichts ist „Freundschaft“ und tatsächlich können wir beide nur bedauern, dass wir uns nicht früher getroffen haben. In einer der Zeilen, die ich schreiben möchte, geht es um Tiere, die in Gesellschaft miteinander durch die Landschaft streifen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920105
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920105,
					"content": "Da dies ein Gedicht über Inazuma ist, müssen wir uns auf <color=#00E1FFFF>Geschöpfe beziehen, die es nur in diesen Landschaften gibt</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920106
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920106,
					"content": "Wir sehen ziemlich oft Tiere, die es nur in Inazuma gibt, ob sie nun laufen oder fliegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726920107,
					"content": "#Aber da sie alle in freier Wildbahn auftauchen, lass uns losziehen und sie suchen, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726920108,
					"content": "Ich stehe in deiner Schuld! Dann hilf mir bitte, <color=#00E1FFFF>vier</color> Fotos von verschiedenen Tieren aus Inazuma zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
		{
			"id": 7269202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
