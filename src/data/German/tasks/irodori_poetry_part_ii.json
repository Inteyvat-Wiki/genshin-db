					"Lenne",
					"Ootomo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726920201,
					"content": "#Sind die Bilder fertig, {F#meine Liebe}{M#mein Freund}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920202
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920202,
					"content": "Hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920203
					]
				},
				{
					"id": 726920203,
					"content": "Lass mich mal sehen ... Oh, die sind toll! Ich glaube, ich weiß jetzt, was ich schreiben soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920204
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920204,
					"content": "Ich habe ein paar verschiedene Strophen geschrieben, die auf den Bildern basieren, die du mitgebracht hast. Warum wählst du nicht diejenige aus, die wir noch einmal verwenden sollen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
