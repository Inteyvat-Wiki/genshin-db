			"dialogs": [
				{
					"id": 726920901,
					"content": "#Sind die Bilder fertig, {F#meine Liebe}{M#mein Freund}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920902
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920902,
					"content": "Noch nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920903
					]
				},
				{
					"id": 726920903,
					"content": "Mach dir keine Sorgen. Wir brauchen heute nur <color=#00E1FFFF>vier Bilder von Tieren aus Inazuma</color>. Herzlichen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
