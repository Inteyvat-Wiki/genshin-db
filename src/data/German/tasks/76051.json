			},
			"dialogs": [
				{
					"id": 760510301,
					"content": "Das sollte gehen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510302,
					"content": "~~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510303,
					"content": "Oh! Und da malt sie schon wieder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510304,
					"content": "Ähem ... Liebe Juroren, bereitet euch darauf vor, verzaubert zu werden! Welches Meisterwerk wird uns unsere talentierte Kuuhenki-Künstlerin wohl diesmal präsent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510305,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510306
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510306,
					"content": "Hm? Du bist schon fertig?! Paimon hat nicht mal ihre Einführung zu Ende bringen können ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510307,
					"content": "Gut, dann schauen wir mal. Oh! Ein weiteres Gemälde von Columbina. Wenig überraschend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510308,
						760510309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510308,
					"content": "Es ist wunderschön.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				},
				{
					"id": 760510310,
					"content": "Soll das ... ein Wald irgendwo in Nod-Krai sein? Da sind ja so viele kleine Tiere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510311,
					"content": "Ich befürchte ... dass du in die Zeit, bevor ich die Nachkommen des Frostmonds verlassen habe, zurückreisen müsstest, um so einen Anblick zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510312
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760510312,
					"content": "Woah, Paimon ist echt neidisch! Haben sich solche niedlichen kleinen Tiere wirklich so um dich versammelt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510313,
					"content": "Ja, die meisten von ihnen wurden vom Kuuvahki um mich herum angezogen. So eingerollt neben mir haben sie sich sicher gefühlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510314
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760510314,
					"content": "Das ist so toll! Du konntest sie so viel streicheln, wie du wolltest, ohne, dass sie wegrennen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510315,
					"content": "Hm ... Ich finde, dass sich Poncho-Dachse am besten angefühlt haben beim Streicheln. Das sind die mit den großen, flauschigen Schwänzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510316
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760510316,
					"content": "Das Nackenfell eines Rauhorn-Hirschs ist auch ziemlich weich. Kann man auch als bequemes Kissen benutzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510317
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760510317,
					"content": "Welches magst du am liebsten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510318
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760510318,
					"content": "Ähm, wir haben noch nicht wirklich solche Erfahrungen gemacht, als dass wir das sagen könnten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510319,
					"content": "Aber Paimon würde sich wahrscheinlich entscheiden, den Schwanz eines Poncho-Dachses zu streicheln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510320,
					"content": "Poncho-Dachse sind eigentlich ziemlich scheu. Wenn du sie streicheln möchtest, müssen sie sich erstmal sicher fühlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510321
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760510321,
					"content": "Ah ... Aber ich wäre lieber vorsichtig, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510322
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760510322,
					"content": "Warum? Können sie etwa auch ... beißen oder so? P... Paimon verspricht, super sanft zu ihnen zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510323,
					"content": "Nein. Ich meine Gefahr aus der Luft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510324
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760510324,
					"content": "Gefahr aus der Luft ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510325,
					"content": "Ja ... Ibisse jagen oft solche Tiere. Ich musste ihnen eine Verwarnung aussprechen, damit sie aufhören, sich auf die Kuuhenki zu stürzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510326
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760510326,
					"content": "Und das sagst du Paimon erst jetzt?! Ein Wunder, dass Paimon noch nicht fortgetragen wurde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510327,
					"content": "Ah ... Dann ich werde ich das nächste Mal, wenn ich einen sehe, darauf hinweisen, dass du ebenfalls Tabu bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510328
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760510328,
					"content": "Nächstes Mal? Nein, du musst jetzt sofort einen finden, sonst hat Paimon zu viel Angst, überhaupt aus dieser Tür rauszufliegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510329,
					"content": "Ah, verstehe. Wenn da so ist, dann werde ich ihnen auf jeden Fall erzählen, dass Paimon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510330,
						760510332,
						760510334
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760510330,
					"content": "die beste Gefährtin überhaupt ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510331
					]
				},
				{
					"id": 760510331,
					"content": "Genau! Die können doch nicht einfach so rumfliegen und die Reisegefährten von den Leuten wegschnappen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510336,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510337
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510337,
					"content": "Die Kleine ... scheint die Vorstellung, wie Paimon von einem Ibis weggetragen wird, ungewöhnlich interessant zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510338
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760510338,
					"content": "Denk nicht mal daran, davon ein Bild zu malen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510332,
					"content": "Die beste Reiseführerin in ganz Teyvat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510333
					]
				},
				{
					"id": 760510333,
					"content": "Oh ... Paimon freut sich, dass du das so siehst, aber ... sie wissen wahrscheinlich nicht einmal, was eine „Reiseführerin“ ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510334,
					"content": "Eine Nahrungsquelle, mit der sie sich nur den Magen verderben würden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510335
					]
				},
				{
					"id": 760510335,
					"content": "Nein, du darfst sie gar nicht erst auf diese Idee bringen! Was, wenn sie doch ihr Glück versuchen?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510309,
					"content": "Allein vom Betrachten werde ich ganz glücklich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				}
			]
		},
