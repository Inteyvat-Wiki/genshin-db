			"dialogs": [
				{
					"id": 760510101,
					"content": "#{NICKNAME}, Paimon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510102
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760510102,
					"content": "Was ist los, Columbina? Du siehst aus, als bereitet dir etwas Sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510103,
					"content": "Habt ihr ein wenig Farbe bei euch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510104
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760510104,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510105
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510105,
					"content": "Oh! Du bist ... Maalaus, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510106,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510107
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510107,
					"content": "Du möchtest noch gerne ein bisschen mehr malen, was? Die meiste Farbe hast du wohl selbst abbekommen ... Wie ist das passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510108,
					"content": "Maalaus war eine kurze Weile weg und kam dann so zurück. Ich befürchte, es wird eine Weile dauern, die ganze Farbe abzuwaschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510109
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760510109,
					"content": "Hm, vielleicht ist Maalaus auf Schwierigkeiten gestoßen bei der Suche nach Inspiration ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510110,
					"content": "Aber trotzdem sieht das doch gar nicht schlecht aus. Sehr passend für eine Künstlerin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510111,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510112
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510112,
					"content": "Oh, und wegen der Farbe ... Wir müssen Maalaus einfach nur bunte Sachen geben, richtig? Also wie letztes Mal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510113,
					"content": "~~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510114
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510114,
					"content": "Hehe, na das nenn ich mal eine glückliche Kuuhenki. Maalaus muss echt einige gute Einfälle gehabt haben ... Garantiert irgendwas spaßiges, freudiges!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510115,
					"content": "Lass uns diesmal ein paar warme, fröhliche Farben finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
