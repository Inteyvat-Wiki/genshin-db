			"dialogs": [
				{
					"id": 710750101,
					"content": "He, du!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750102
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750102,
					"content": "Jemand wie du, der sich hier auskennt, findet sicher, was dieser Erge nicht finden konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750103
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750103,
					"content": "Da dieser Tunichtgut nichts finden kann, muss ich einfach auf jemanden warten, der es finden kann, und denjenigen dann zwingen, das Gefundene herauszugeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750104
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750104,
					"content": "Ich bin als „Qingce-Kind“ bekannt. Wenn ich eine Gruppe von Buddlern hier an der Großen Kluft nicht loswerden kann, wie kann ich dann anderswo Geld verdienen? Komm schon, gib mir das Zeug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750105
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750105,
					"content": "Den Schatz der Millelithen werden wir Schatzräuber behalten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750106,
						710750107
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750106,
					"content": "Egal was du willst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750108
					]
				},
				{
					"id": 710750108,
					"content": "Ha! Wirklich? Ich glaube nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750109
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750109,
					"content": "... Hm, ich dachte, ihr würdet stärker aussehen, wenn ihr jeden Tag hin- und herlauft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750110
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750110,
					"content": "Du hast die Wahl: Willst du von mir gewaltsam durchsucht werden oder willst du den „Helm des dienlichen Schutzes“ mit deinen eigenen Händen überreichen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750111
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750111,
					"content": "Ich glaube nicht, dass du mit mir kämpfen willst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750112
					]
				},
				{
					"id": 710750112,
					"content": "Hui, das sind aber große Töne ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750113
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750113,
					"content": "Ich sehe, auf die angenehme Tour wird es wohl nicht gehen. Also ich kann auch anders!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 710750107,
					"content": "Das gibt es hier nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750108
					]
				}
			]
		}
	]
