			"dialogs": [
				{
					"id": 747070101,
					"content": "... Gut, das war großartig! Machen wir einfach noch eine Aufnahme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070102,
					"content": "Gut. Uuuund ... Schnitt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070103,
					"content": "Furina! Oh, und Columbina und Chiori! Ihr seid noch hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070104,
					"content": "Mmhmm! Wir haben gerade unsere Aufnahmen für die Schnittbilder abgedreht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070105
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070105,
					"content": "Oh! Ihr meint diese Schauspiel-Sache mit dem Fischlein, die ihr da gemacht habt? Wie ist alles gelaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070106,
					"content": "Dank eurer Hilfe haben wir einen passenden Schauspieler für die Rolle gefunden. Der Dreh verlief reibungslos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070107
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070107,
					"content": "Ihr beide habt wirklich ein Talent für diese ganze Aquarium-Sache. Furina hat uns gerade erzählt, dass ihr sie sogar dazu inspiriert habt, eine Unterwasserdokumentation zu drehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070108,
						747070109
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747070108,
					"content": "Du bist zu nett!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				},
				{
					"id": 747070110,
					"content": "Mir gefällt es auch. Ich kann spüren, wie zufrieden die kleinen Fische sind, wenn sie herumschwimmen. Du hast dich wirklich großartig um ihre Bedürfnisse gekümmert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070111
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 747070111,
					"content": "Ich wünschte einfach, dieses Aquarium könnte für immer hier bleiben. Dann könnte ich es besuchen kommen, wann immer ich möchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070112,
					"content": "Wenn du es so sehr vermissen wirst, warum fügst du dem Film nicht noch ein paar schöne Aufnahmen hinzu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070113
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747070113,
					"content": "Du hast recht. Wir sollten unbedingt noch mehr drehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070114,
					"content": "Noch ein paar Fische?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070115
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 747070115,
					"content": "Noch ein paar Aufnahmen! Los jetzt, Licht, Kamera ... Wo ist meine Regieassistenz? Alle auf Position!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070116,
					"content": "Paimon ist bereit! Aber Aufnahmen für Fisch-Darsteller anzusagen ... Das ist definitiv eine neue Erfahrung, so viel steht fest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070109,
					"content": "Wir freuen uns sehr, dass es euch gefällt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				}
			]
		}
	]
}