						],
						"pointId": 360300006
					}
				]
			},
			"dialogs": [
				{
					"id": 760520101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520102
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520102,
					"content": "Columbina, alles gut bei dir? Du siehst ein bisschen verstimmt aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520103,
					"content": "Oh, ihr zwei seid es. Mir geht’s gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520104
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520104,
					"content": "(Denkt sie schon wieder über den Mond nach ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520105
					]
				},
				{
					"id": 760520105,
					"content": "Können wir dir irgendwie helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520106
					]
				},
				{
					"id": 760520106,
					"content": "Ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520107
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520108
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520108,
					"content": "Das geht schon klar! Erzähl es uns einfach! Auch wenn es nur eine kleine Sache ist, wirst du dich schon bald besser fühlen, sobald du darüber gesprochen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520109,
					"content": "Ich ... würde gerne ein Getränk aus der Taverne probieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520110
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520110,
					"content": "... Was?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520111,
					"content": "... *seufz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520112
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520112,
					"content": "Tut mir leid ... Paimon war nur ein wenig überrascht. Du redest nie davon, dass du irgendetwas für dich selbst haben oder machen möchtest, deswegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520113,
					"content": "Und, das ist alles? Nur ein ... Getränk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520114,
					"content": "Was denn, meinst du, sie hätte ein paar Nummern größer denken sollen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520115
					]
				},
				{
					"id": 760520115,
					"content": "Ja, schon irgendwie. Zumindest etwas, das ein bisschen monumentaler ist ... Wie „Bringt mir den Mond“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520116,
					"content": "Aber andererseits ergibt das auch wieder Sinn. Columbina kann gerade nicht einfach hingehen, wohin sie möchte, also ist ein Ausflug in die Taverne genauso schwierig wie einer zum Mond ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520117,
					"content": "Es geht nicht nur darum, wie die Dinge jetzt gerade sind. Sogar als ich noch bei den Fatui war und sie mich noch nicht einfangen wollten ... hat trotzdem jeder Abstand gehalten, wann immer ich für einen Spaziergang rausging.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520118
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520118,
					"content": "(Die Dritte unter den Elf der Fatui ... Dieser Titel allein reicht schon aus, um Leute, die sich nicht kennen, in Angst und Schrecken zu versetzen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520119
					]
				},
				{
					"id": 760520119,
					"content": "Eine Sekunde mal, jetzt wo du es sagst ... Vielleicht ist es doch nicht so schwer, wie Paimon erst dachte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520120,
					"content": "#Ein Tavernenbesuch steht außer Frage, aber ein Getränk ... Also das kriegen wir hin! {NICKNAME} packt das!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520121,
					"content": "... Wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520122
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520122,
					"content": "Ähm, aber du solltest besser nicht allzu hohe Erwartungen haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520123,
					"content": "Irgendwelche Geschmackspräferenzen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520124
					]
				},
				{
					"id": 760520124,
					"content": "Geschmack ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520125
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520125,
					"content": "Ich bin nicht sehr erfahren im Bestellen von Getränken, daher weiß ich gar nicht, wie ich anfangen soll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520126
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520126,
					"content": "Vielleicht etwas, das nicht zu ... schwer ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520127
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520127,
					"content": "Ähm, was meinst du denn mit „schwer“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520128,
					"content": "Schwer wie ein ... Mantel der Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520129
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520129,
					"content": "Dieser Vergleich macht die ganze Sache nur noch verwirrender ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520130,
						760520131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520130,
					"content": "Also dann etwas Leichtes und Erlesenes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				},
				{
					"id": 760520132,
					"content": "Gut, was immer du meinst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520131,
					"content": "Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				}
			]
		},
		{
			"id": 7605202,
			"completionStepIds": [
				7605203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
