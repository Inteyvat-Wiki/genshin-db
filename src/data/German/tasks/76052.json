			"dialogs": [
				{
					"id": 760520501,
					"content": "*gluck* ... *gluck* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520502
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520502,
					"content": "Oha, das war schnell! Sie scheint es zu lieben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520503,
					"content": "Hm ... komplett geschmacksneutral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520504
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520504,
					"content": "G... G... Geschmacksneutral?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520505,
					"content": "Ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520506,
						760520507
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520506,
					"content": "Vielleicht hast du es zu schnell getrunken ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				},
				{
					"id": 760520508,
					"content": "Oh ... Danke, aber nicht nötig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520509
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520509,
					"content": "Es gab mal eine Zeit, in der ich nicht verstand, warum die Leute zur Erntezeit solche Freude verspürten. Dann griff ich eines Tages nach einer reifen Frucht, die von einem Ast herabhing ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520510
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520510,
					"content": "Allein in der Textur der Schale spürte ich schon die Lebenskraft – die organische Verkörperung des Sonnenlichts, des Wasser, der Erde und der Luft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520511
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520511,
					"content": "Mit jedem Bissen spürte ich, wie mich eine erfrischende Süße überkam wie Wellen aus kühlem, weichem Schaum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520512
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520512,
					"content": "Und so wurde ich mir endlich der unwiderstehlichen Kraft der Aromen bewusst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520513
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520513,
					"content": "Oh, das ist interessant!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520514,
					"content": "Und dann vollenden wir den Kreislauf der Natur, indem wir uns diese Lebenskraft für uns selbst nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520515
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520515,
					"content": "Ohh, das ist jetzt aber ziemlich plötzlich ziemlich düster geworden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520516,
					"content": "Daher bevorzuge ich frische Früchte. Sie erlauben mir zu erkennen, was ich dieser Welt genommen habe, genauso, wie sie war, bevor ich es genommen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520517
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520517,
					"content": "Und erinnert mich daran, was ich dieser Welt im Gegenzug schuldig bin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520507,
					"content": "Wie wär’s, wenn ich noch eins mache?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				}
			]
		},
