			"dialogs": [
				{
					"id": 761870301,
					"content": "Bitte nimm meinen Dank im Namen von Fräulein Mamère für deine freundliche Einladung an, Fräulein Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870302
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870302,
					"content": "Mmhmm, das ist wirklich lecker. Danke, Sandrone. Du machst wirklich fantastische Desserts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870303
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 761870303,
					"content": "Ich freue mich, dass es dir schmeckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870304
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761870304,
					"content": "Aber Prototyp 4ACV07, ich glaube, wir treffen uns zum ersten Mal? Wie hast du mich erkannt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870305
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761870305,
					"content": "Oh, das ist das erste Mal, dass ich jemanden Seymour so nennen höre ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870306
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 761870306,
					"content": "Positiv. Obwohl ich mit deiner Sanftheit und deinem Strahlen vertraut bin, habe ich dich zuvor noch nie leibhaftig gesehen, Fräulein Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870307
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870307,
					"content": "Ich kann dich erkennen, weil dein Aussehen exakt dem meiner Meisterin, Fräulein Mary-Ann Guillotin, entspricht. Ihr Bild ist dauerhaft in meiner Speichereinheit gespeichert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870308
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870308,
					"content": "Fräulein Mary-Ann hat mir von dir erzählt. Da dein Aussehen ihrem entspricht, ist die logische Schlussfolgerung, die nötig ist, um dich zu erkennen, ziemlich einfach, Fräulein Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870309
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870309,
					"content": "Hah, selbst Alains früheste Arbeit ist so beeindruckend. Obwohl es aussieht, als hättest du ein paar Verbesserungen bekommen ... Ich nehme an, ich sollte dich jetzt Seymour nennen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870310
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761870310,
					"content": "Warst du verwirrt, als du mich gesehen hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870311
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761870311,
					"content": "Negativ. Meine Hauptdirektive ist es, dich anstelle von Alain Guillotin zu begleiten und zu beschützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870312
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870312,
					"content": "Daher ist mein Wissen über Fräulein Mary-Ann vollständig. Und basierend auf einer logischen Analyse von endlichdimensionalen Vektorräumen bist du völlig anders als Fräulein Mary-Ann, Fräulein Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870313
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870313,
					"content": "Wie der Unterschied zwischen den Teeblättern aus dem Chenyu-Tal und der Blasenmandarine aus dem Bezirk Béryl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870314
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870314,
					"content": "Ist Sandrone der Tee oder die Blasenmandarine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870315
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 761870315,
					"content": "Wird gesucht ... Daten unzureichend. Antworten unmöglich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870316
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870316,
					"content": "(*seufz* ... Ich bin froh, dass Alain das Design seines Sprachmoduls verbessert hat, bevor er mich erschaffen hat.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
