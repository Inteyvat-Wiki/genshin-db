			"dialogs": [
				{
					"id": 761870401,
					"content": "Das Dessert ist lecker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870402,
						761870403
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 761870402,
					"content": "(Lass uns noch ein Weilchen so sitzen bleiben.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870404
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761870404,
					"content": "Häh?! Jetzt schon? Danke, Fräulein Sandrone! Ich hoffe, wir sehen uns beim nächsten Mal wieder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mamère"
				},
				{
					"id": 761870403,
					"content": "Ich glaube, es wird Zeit, dass ich mit dem Aufräumen anfange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870404
					],
					"speakerTitle": "Marionette"
				}
			]
		}
