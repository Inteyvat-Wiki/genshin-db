				"points": []
			},
			"dialogs": [
				{
					"id": 708020101,
					"content": "Können wir Papa dieses Mal wirklich finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020102
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020102,
					"content": "Hast du schon von deinem Vater gehört?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020103
					]
				},
				{
					"id": 708020103,
					"content": "#Reisende{M#r}, du bist es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020104
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020104,
					"content": "Pallad hat mir gesagt, dass Onkel Cyrus anscheinend Neuigkeiten über meinen Vater gefunden hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020105
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020105,
					"content": "Obwohl er sich noch nicht sicher war ... Pallad sagte, dass die Hinweise, die sie dieses Mal gefunden haben, so gut waren, dass sie meinen Vater tatsächlich finden könnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020106
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020106,
					"content": "Ich würde gerne mit ihnen auf den Drachengrat gehen, aber Cyrus sagt, dass ich im Lager bleiben soll und dass sie es mir sagen werden, sobald sie mehr Neuigkeiten haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020107
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020107,
					"content": "#Großartig Reisende{M#r}, könntest du zu Onkel Cyrus gehen und ihn um Informationen für mich bitten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020108,
						708020109
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020108,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				},
				{
					"id": 708020110,
					"content": "Ich ... Ich habe Angst, schlechte Nachrichten zu hören ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020111
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020111,
					"content": "#Ich bitte dich! Reisende{M#r}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020109,
					"content": "Warum gehst du ihn nicht selber fragen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				}
			]
		},
		{
			"id": 7080202,
			"completionStepIds": [
				7080203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
