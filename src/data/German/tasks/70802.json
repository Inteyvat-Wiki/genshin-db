			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Joel"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708020501,
					"content": "#{NICKNAME}, hast du was Interessantes mitgebracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020502
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020502,
					"content": "Das heißt, Cyrus hat meinen Vater noch nicht gefunden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020503,
						708020504
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020503,
					"content": "Vertraue Cyrus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020505
					]
				},
				{
					"id": 708020505,
					"content": "#Nun, ich weiß. Ich werde Cyrus genauer fragen, wenn er da ist. Danke, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020506
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020506,
					"content": "Wo bist du, Papi ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020504,
