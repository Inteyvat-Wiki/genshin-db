			"dialogs": [
				{
					"id": 708020301,
					"content": "Endlich ist es in der Umgebung ein bisschen sicherer geworden, danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020302
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708020302,
					"content": "Über Joserf ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020303
					]
				},
				{
					"id": 708020303,
					"content": "Leider habe ich im Moment keine neuen Hinweise gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020304
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708020304,
					"content": "Aber da hier alles sicher ist, werde ich weitersuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020305
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708020305,
					"content": "Bitte geh zuerst zur Gilde zurück und sag Cyrus, dass ich die Suche eingeleitet habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verwegener Pallad"
				}
			]
		},
		{
			"id": 7080204,
