			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus",
					"Verwegener Pallad"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708020201,
					"content": "Ich kann nicht glauben, dass es in dieser Gegend ist ... Pallad, bist du sicher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020202
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020202,
					"content": "Ich bin mir ganz sicher, Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020203
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708020203,
					"content": "Sprichst du von Joels Vater?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020204
					]
				},
				{
					"id": 708020204,
					"content": "#Ist das nicht {F#die}{M#der} Reisende? Sieht aus, als kämst du wegen Joel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020205
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020205,
					"content": "Der Junge, der jeden Tag Leute bittet, Informationen von mir zu bekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020206
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020206,
					"content": "Doch dieses Mal werde ich ihm eine gute Nachricht überbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020207
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020207,
					"content": "Vor einiger Zeit hat unsere Abenteurergilde ein „Spezialtraining auf dem Drachengrat“ organisiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020208
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020208,
					"content": "Ich werde alles Weitere erklären, Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020209
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708020209,
					"content": "Auf dem Weg zu dieser speziellen Trainingseinheit wurde ich wegen des Windes und des Schnees von meiner geplanten Route abgelenkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020210
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708020210,
					"content": "Als ich die Route zurückkehren wollte, sah ich plötzlich eine verschwommene Gestalt auf einer Klippe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020211
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708020211,
					"content": "Zuerst dachte ich, es sei ein Abenteurer, der sich wie ich verirrt hatte, und rief ihm etwas zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020212
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708020212,
					"content": "Doch bevor ich die Aufmerksamkeit des Mannes auf mich ziehen konnte ... zog mein Schrei zuerst Monster an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020213
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708020213,
					"content": "In dieser Umgebung hatte ich nicht das Selbstvertrauen, diese Monster zu bekämpfen, und musste mich erst einmal zurückziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020214
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708020214,
					"content": "Als ich zurückkam, erzählte ich Cyrus davon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020215,
						708020217
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708020215,
					"content": "Ist diese Gestalt der Vater von Joel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020216
					]
				},
				{
					"id": 708020216,
					"content": "Wir können nicht sicher sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020218
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020218,
					"content": "Egal, zumindest wissen wir jetzt, dass jemand auf dem Drachengrat gefangen ist. Daher glaube ich, dass eine Rettung angebracht ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020219
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020219,
					"content": "Ob dieser Mann Joels Vater, Herr Joserf, ist oder nicht, ist reine Glückssache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020220
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020220,
					"content": "Wie auch immer, ich habe bereits alle, die den Drachengrat erkunden können, losgeschickt, um sich auf die Suche zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020221
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020221,
					"content": "Ich werde mich auch bereit machen und später an der Such- und Rettungsaktion auf dem Drachengrat teilnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020222,
						708020223
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708020222,
					"content": "Wir können doch auch zusammen gehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020224,
					"content": "Willst du helfen? Gut, dann lass uns gemeinsam loslegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708020223,
					"content": "Ich werde die Monster vernichten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020217,
					"content": "Vielleicht war es ein weiterer verirrter Abenteurer ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020218
					]
				}
			]
		},
