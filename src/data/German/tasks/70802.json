			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708020401,
					"content": "#{F#Reisende}{M#Reisender}, du bist ja wieder da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020402,
						708020404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020402,
					"content": "Pallad hat mit dem Suchen angefangen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020403
					]
				},
				{
					"id": 708020403,
					"content": "Nun, der Kerl kann immer noch ab und zu etwas Anständiges machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020406,
					"content": "Nachdem ich die Informationen, die ich habe, sortiert habe, werde ich auch auf den Drachengrat fahren, um den Jungen Joel zu treffen und ihm alles genau zu erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020407,
					"content": "#{F#Reisende}{M#Reisender}, sag Joel bitte, dass ich gleich da sein werde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020408
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020408,
					"content": "Ich werde einige Zeit brauchen, um die Informationen zusammenzustellen. Nicht dass er ungeduldig wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020404,
					"content": "Können wir die Person wirklich finden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020405
					]
				},
				{
					"id": 708020405,
					"content": "Das kann ich ... nicht garantieren. Ich kann nur sagen, dass wir unser Bestes tun werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020406
					],
					"speakerTitle": "Cyrus"
				}
			]
		},
		{
			"id": 7080205,
			"completionStepIds": [
				7080208
			],
