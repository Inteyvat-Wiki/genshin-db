					"nextDialogs": [
						207420702
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420702,
					"content": "Also, äh. Ist etwas passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420703
					]
				},
				{
					"id": 207420703,
					"content": "Du! Donne hat mir alles darüber erzählt - sie hat gesehen, wie du meinen Löwenzahn weggeblasen hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420704
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420704,
					"content": "Ähm, Entschuldigung deswegen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420705
					]
				},
				{
					"id": 207420705,
					"content": "Ich weiß, Donna hat mir alles erzählt. Du warst derjenige, der all meinen Löwenzahn fortgeblasen hat, stimmt’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420706
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420706,
					"content": "Wenn du so dringend Löwenzahnsamen brauchen würdest, könntest du dir einfach welche in der Wildnis holen. Die waren mir wichtig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420707
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420707,
					"content": "Muss ich erwähnen, dass das der Löwenzahn war, den du mir sammeln geholfen hast? Und so behandelst du ihn? Wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		}
