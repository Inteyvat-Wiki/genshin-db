						207420502
					]
				},
				{
					"id": 207420502,
					"content": "Hast du meine Löwenzahnsamen gekriegt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420503
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420503,
					"content": "Die sind für dich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420504
					]
				},
				{
					"id": 207420504,
					"content": "... Danke. Ich pflanze später einen neuen Topf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420505
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420505,
					"content": "Aber ich lasse ihn nie wieder draußen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
