			"dialogs": [
				{
					"id": 207420101,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420102
					]
				},
				{
					"id": 207420102,
					"content": "Ah! Der Löwenzahn! Er fliegt komplett davon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420103
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420103,
					"content": "Was machst du da? Hast du eine Ahnung davon, wie anstrengend es ist, diese wachsen zu lassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420104,
					"content": "Ich verteile sie weit und breit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420105
					]
				},
				{
					"id": 207420105,
					"content": "Wir sind in der Stadt. Sie werden nicht weit kommen, bevor sie von diesen Wänden blockiert werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420106
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420106,
					"content": "Auf diese Art können wir viel mehr Löwenzahn wachsen lassen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420107
					]
				},
				{
					"id": 207420107,
					"content": "Na ja, warum nimmst du dann nicht einige Löwenzahnsamen mit aus der Stadt heraus und verteilst sie dort?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420108
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420108,
					"content": "Uhm, mein Löwenzahn! Es war so viel Arbeit, ihn wachsen zu lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420109
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420109,
					"content": "D... du ... Falls du Löwenzahn brauchst, kannst du dann nicht hinausgehen und welchen pflücken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420110
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420110,
					"content": "Dieser Löwenzahn war auch der, den du mir geholfen hast zu pflücken. Es hat mich viel Anstrengung gekostet, ihn aufzuziehen ... Und so willst du ihn behandeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
