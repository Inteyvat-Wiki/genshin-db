						207420602
					]
				},
				{
					"id": 207420602,
					"content": "Sobald ich fertig damit bin, die Löwenzahnsamen in den neuen Topf zu pflanzen, muss ich mir einen guten Standort aussuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420603
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420603,
					"content": "Na ja, vielleicht zeige ich ihn einfach wieder draußen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
