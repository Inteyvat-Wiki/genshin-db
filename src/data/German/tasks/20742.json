				},
				{
					"id": 207420202,
					"content": "Blumen aufzuziehen ist nicht so einfach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420203
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420203,
					"content": "... Wie wäre es dann damit? Finde mehr Löwenzahnsamen für mich und ich pflanze sie wieder selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
