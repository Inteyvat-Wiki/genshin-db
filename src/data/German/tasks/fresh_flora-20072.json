			"dialogs": [
				{
					"id": 200720101,
					"content": "Wie steht es um die Blumen, die ihr zuvor auf dem Drachengrat gelagert habt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720102,
					"content": "Ich habe nur einen Behälter geborgen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720103
					]
				},
				{
					"id": 200720103,
					"content": "Die anderen ließen sich nicht bergen? Ähm ... Na gut, in Ordnung. Es ist ja ziemlich schwer, die Bedingungen auf diesem Berg vorherzusagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720104,
					"content": "Aber wenn wir bloß einen haben, dann können wir keine Vergleiche ziehen. Ich denke, wir müssen einfach abwarten, bis sich eine Gelegenheit ergibt, noch einmal nachzuschauen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720105,
					"content": "Danke, dass du dir trotzdem die Mühe gemacht hast. Hier, ich habe dies als Gegenleistung vorbereitet. Vielleicht werde ich auch in Zukunft deine Hilfe in Anspruch nehmen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
			"id": 2007202,
			"completionStepIds": [
				2007210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
