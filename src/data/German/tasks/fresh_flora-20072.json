				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200720401,
					"content": "Hallo, hier drüben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720402
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720402,
					"content": "Erinnerst du dich noch an die Blumen, die du auf dem Drachengrat aufbewahren solltest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720403
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720403,
					"content": "Seither ist ein Tag vergangen und ich würde gern die Ergebnisse unseres Tiefkühlexperimentes sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720404
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720404,
					"content": "Könntest du mir helfen, zum Berg hinaufzugehen und diese Blumen zurückzubringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720405,
						200720407
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720405,
					"content": "Ich werde das machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720406
					]
				},
				{
					"id": 200720406,
					"content": "Ich zähle also auf dich. Ich werde hier warten. Komm bald zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720407,
					"content": "Wo habe ich sie nochmal hingelegt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720408
					]
				},
				{
					"id": 200720408,
					"content": "Hast du es vergessen? Du hast sie <color=#00E1FFFF>neben eine Statue der Sieben</color>, <color=#00E1FFFF>bei einem Berggewässer</color> und <color=#00E1FFFF>neben einer Höhle</color> platziert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720409
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720409,
					"content": "Ich helfe dir, sie wieder auf deiner Karte zu markieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		}
	]
}