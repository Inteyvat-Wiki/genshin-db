				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200720201,
					"content": "Wie geht es den Blumen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720202
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720202,
					"content": "Entschuldige!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720203
					]
				},
				{
					"id": 200720203,
					"content": "Hä? Was ist passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720204
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720204,
					"content": "Ich habe aus Versehen die Behälter und die Blumen zerstört ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720205
					]
				},
				{
					"id": 200720205,
					"content": "Versehentlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720206
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720206,
					"content": "Äh ... Ich habe diese Blumen eigens ausgesucht. So gute Blumen findet man nirgendwo ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720207,
					"content": "Ist der Drachengrat so gefährlich, dass selbst ein Abenteurer wie du so einen Behälter nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720208
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720208,
					"content": "Trotzdem vielen Dank, dass du diese Reise für mich angetreten hast. Bitte nimm dies als Dankeschön. Wenn du mich jetzt entschuldigen würdest, ich muss mich um meine Blumen kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720209
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720209,
					"content": "*seufz* Vielleicht probiere ich doch mal die Methode aus, die Sara vorgeschlagen hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
