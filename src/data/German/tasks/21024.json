			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bao’er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210240601,
					"content": "Sieht so aus, als brächte das nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240602
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 210240602,
					"content": "Entschuldigung, hast du zufällig eine Schachtel hier herumliegen sehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240603
					]
				},
				{
					"id": 210240603,
					"content": "Eine Schachtel? Ja, ich habe sogar eine aufgehoben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240604
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 210240604,
					"content": "Ich habe sie geöffnet und hineingesehen, ein großer Stapel mit Papieren lag darin, sah nach einem ziemlich großen Geschäft aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240605
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 210240605,
					"content": "Jaha, ich kann mir gar nicht vorstellen, wie viel der Besitzer der Schachtel bereit sein muss zu zahlen, um sie wiederzubekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240606
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 210240606,
					"content": "... Was soll das heißen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240607
					]
				},
				{
					"id": 210240607,
					"content": "Jetzt guckt doch nicht so angespannt! War doch bloß ein Scherz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240608
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 210240608,
					"content": "Der Wert dieser Papiere ist nicht gerade niedrig. Ich wüsste nur zu gern, wer der Empfänger dieser Waren in Liyue ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240609
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 210240609,
					"content": "Mir ist die prekäre Lage durchaus bewusst. Aber für alles gibt es einen richtigen Zeitpunkt, ich werde nicht unnötig hart zuschlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240610
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 210240610,
					"content": "Findet ihr aber nicht auch, dass man mir etwas für meine Mühe geben sollte, wo ich doch so gut auf die Schachtel aufgepasst habe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240611
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 210240611,
					"content": "Lasst uns den traditionellsten Weg des Güteraustauschs beschreiten, das wird das Problem lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240612
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 210240612,
					"content": "Ihr sucht mir drei Stücke „Nachtjade“ und ich geb euch im Austausch diese Schachtel zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240613
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 210240613,
					"content": "Verglichen mit den Beträgen in diesen Verzeichnissen ist die Nachtjade ja gar nichts ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240614,
						210240616
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 210240614,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240615
					]
				},
				{
					"id": 210240615,
					"content": "Dann macht euch mal schnell auf die Suche. Wenn ihr die Nachtjade habt, beginnen wir den Austausch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 210240616,
					"content": "Von was für Geschäften ist in den Verzeichnissen überhaupt die Rede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240618
					]
				},
				{
					"id": 210240618,
					"content": "Wisst ihr das nicht? Ihr seid nur hier, um anderen bei ihren Geschäften zu helfen. Aber ich hab nichts dagegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240619
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 210240619,
					"content": "Nehmt meinen Rat an, in solch große Geschäfte mischt man sich am besten nicht ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240620
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 210240620,
					"content": "So, dann sucht mir mal die Nachtjade. Dann gebe ich euch die Verzeichnisse zurück und ihr könnt sie dem zurückgeben, der sie verloren hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240621
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 210240621,
					"content": "So wird das gemacht, sauber und geschwind, keine Unannehmlichkeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao’er"
				}
			]
		},
