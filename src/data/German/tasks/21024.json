			},
			"dialogs": [
				{
					"id": 210240901,
					"content": "Habt ihr meine Warenverzeichnisse gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240902
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240902,
					"content": "Wir haben alle gefunden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240903
					]
				},
				{
					"id": 210240903,
					"content": "Habt vielen, vielen Dank! Ich bin so froh, dass nichts passiert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240904
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240904,
					"content": "Mein Chef wäre bestimmt aus der Haut gefahren, hätte ich diese Verzeichnisse verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240905
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240905,
					"content": "Wollt ihr nicht fragen, welche Art von Geschäften ich mit diesen Waren abgeschlossen habe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240906
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240906,
					"content": "Es tut mir sehr leid, aber das kann ich euch wirklich nicht verraten. Das ist ein Handelsgeheimnis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240907
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240907,
					"content": "Das ist eure Belohnung ... Moment mal, diese Schachtel, die wurde ja bereits geöffnet?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240908
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240908,
					"content": "Ihr habt einen Fremden getroffen und ihn die Schachtel öffnen lassen?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240909
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240909,
					"content": "Nein, nein! Es ist alles aus ... Ich muss es dem Chef sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240910
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240910,
					"content": "Keine Sorge, ich verdächtige euch nicht, nach all dem, was ihr getan habt für mich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240911
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240911,
					"content": "Hmm, ich muss einen Weg finden, meinen Chef zu kontaktieren. Ihr da, ihr könnt euch jetzt wieder euren Geschäften widmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Landa"
				}
			]
		},
