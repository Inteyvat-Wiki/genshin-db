			"dialogs": [
				{
					"id": 210240802,
					"content": "Nicht schlecht, diese Nachtjade ist akzeptabel, ich nehm sie euch ab. Hier sind eure Papiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240803
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 210240803,
					"content": "Nehmt schnell die Verzeichnisse! Euer Auftraggeber muss sich bestimmt bereits Sorgen darum machen.",
