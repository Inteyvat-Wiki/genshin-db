			"dialogs": [
				{
					"id": 700890101,
					"content": "Huch, warum ist hier jemand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890102,
					"content": "Diese Statue des Windgottes ist es auch nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890103
					],
					"speakerTitle": "„Maukie“"
				},
				{
					"id": 700890103,
					"content": "He, was machst du da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890104,
					"content": "Ich suche nach dem Rückweg. Ich erinnere mich nur daran, dass ich die Statue des Windgottes finden muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890105
					],
					"speakerTitle": "„Maukie“"
				},
				{
					"id": 700890105,
					"content": "An alles andere kann ich mich auch nicht mehr erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890106
					],
					"speakerTitle": "„Maukie“"
				},
				{
					"id": 700890106,
					"content": "Dein Rückweg?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890107,
					"content": "Es ist eine Art vages Heimweh, aber ich kann mich an nichts erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890108
					],
					"speakerTitle": "„Maukie“"
				},
				{
					"id": 700890108,
					"content": "Als ich aufgewacht bin, hatte ich nur einen Zettel in der Hand, auf dem stand: „Du bist ‚Maukie‘“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890109
					],
					"speakerTitle": "„Maukie“"
				},
				{
					"id": 700890109,
					"content": "Daher nehme ich an, dass mein Name „Maukie“ ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890110
					],
					"speakerTitle": "„Maukie“"
				},
				{
					"id": 700890110,
					"content": "Ich will nicht weiter stören. Tschüs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890111
					],
					"speakerTitle": "„Maukie“"
				},
				{
					"id": 700890111,
					"content": "Was für ein seltsamer Kerl. Aber er ist sicher nicht böse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890112,
					"content": "Was ist denn los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890113,
					"content": "Ich habe etwas Seltsames gesehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700890114
					]
				},
				{
					"id": 700890114,
					"content": "Etwas Seltsames? Liegt das vielleicht daran, dass dieser Kerl vorhin die Statue angefasst hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
