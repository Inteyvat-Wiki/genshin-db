				"points": []
			},
			"dialogs": [
				{
					"id": 730600501,
					"content": "Arabalika sollte bald von den Ruinen von Dahri zurückkehren. Mit Arabalikas Ararakalari stellen Eisenbrocken und „Pilzbestien“ keine Gefahr für uns dar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600502
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600502,
					"content": "Falls Aranakula halb so stark wie Arabalika ist, dann ist die Baumschule gerettet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600503
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600503,
					"content": "Aranakula hat nicht einmal die Hälfte der Hälfte der Stärke von Arabalika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600504
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600504,
					"content": "*wimmer* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600505
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600505,
					"content": "Aranakula kann so mutig sein wie der goldene Nara, aber er braucht Zeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
