				"points": []
			},
			"dialogs": [
				{
					"id": 730600601,
					"content": "Beim Yasna-Monument wimmelt es von Bösewichten, aber Aranakula ist wohlbehalten zurückgekommen. Wie schön.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600602
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600602,
					"content": "Der goldene Nara hat Aranakula geholfen, den Bösewichten auszuweichen, und hat das Steingedächtnis beseitigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600603
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600603,
					"content": "Sobald die Varuna-Maschine geheilt ist, können die Blumen aus der Baumschule mitgebracht werden. Die Aranara vergessen das nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600604
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600604,
					"content": "Jetzt bleibt nur noch Arakunti im Hain der Träume übrig. Wenn er wieder da ist, können wir die Schädlinge auslöschen, die sich an den Wurzeln der Varuna-Maschine zu schaffen machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
