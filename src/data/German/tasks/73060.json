			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapandu",
					"Arabalika"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730600301,
					"content": "Arabalika geht es gut, aber ich mache mir Sorgen um Aranakula beim Yasna-Monument und Arakunti im Hain der Träume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600302
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600302,
					"content": "Bei Aranakula ... sind zu viele böse Pilze. Falls sie ihn wieder in die Fänge bekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600303
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600303,
					"content": "Sorgen bringen nichts. Der goldene Nara ist sehr stark und hat den riesigen Eisenbrocken wie ein starker Wind über das morsche Holz niedergemetzelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600304
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600304,
					"content": "Solange wir die Varuna-Maschine heilen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
		{
