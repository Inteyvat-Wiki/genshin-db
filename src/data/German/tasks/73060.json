			"dialogs": [
				{
					"id": 730600701,
					"content": "Aranakula ist beim Yasna-Monument. Da sind so viele Pilze ... Ich mache mir Sorgen ... Arabalika ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600702
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600702,
					"content": "Arabalika geht nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600703
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600703,
					"content": "Aranakula weiß, wie man sich versteckt. Die Pilze werden ihn nicht ausfindig machen. Warum macht sich Arapandu solche Sorgen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakunti"
				}
			]
