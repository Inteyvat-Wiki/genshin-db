			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arakunti",
					"Arapandu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730600401,
					"content": "Der Hain der Träume ... Eine ruhige Melodie, der Klang des Wassers, das Geräusch von Flügelschlägen, das Geräusch von brechenden Zweigen auf dem Boden, nachdem auf sie getreten wurde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600402
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600402,
					"content": "Ich rede mit Nara und Paimon ... Paimon ist lustig. Nur leider möchte Paimon nicht zu einem Samen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600403
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600403,
					"content": "Weil Paimon kein Aranara ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600404
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600404,
					"content": "Im Hain der Träume ist alles in Ordnung. Arabalika ist bei den Ruinen von Dahri, aber ich mache mir keine Sorgen. Beim Yasna-Monument wimmelt es von „Pilzbestien“. Ich mache mir Sorgen um Aranakula ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
		{
