			"trigger": {
				"objectNames": [
					"Aranakula",
					"Arapandu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730600201,
					"content": "Der goldene Nara scheint sich vor nichts zu fürchten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600202
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600202,
					"content": "Der goldene Nara ist ein tapferer Nara wie Nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600203
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600203,
					"content": "Zwar mache ich mir Sorgen um Arabalika bei den Ruinen von Dahri und um Arakunti im Hain der Träume, aber mit der Hilfe des goldenen Nara ist nichts unmöglich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600204
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600204,
					"content": "Sobald die Varuna-Maschine geheilt ist, treiben die Bösewichte keinen Unfug mehr in der Baumschule. Die Blumen aus der Baumschule würde ich gerne dem goldenen Nara schenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
		{
