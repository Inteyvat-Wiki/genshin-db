				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500701,
					"content": "Die Pilze sind hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500702
					]
				},
				{
					"id": 710500702,
					"content": "Danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500703
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500703,
					"content": "Mit deiner Hilfe waren meine Nachforschungen wie ... Wie heißt das Liyue-Sprichwort? „So geschmeidig wie ein Tiger mit Flügeln“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500704
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500704,
					"content": "Wie ein Tiger mit Flügeln?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500705
					]
				},
				{
					"id": 710500705,
					"content": "Ja, es ist wie ein Tiger mit Flügeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500706
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500706,
					"content": "Diese Pilze ... Wie kann das nur sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500707
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500707,
					"content": "Das ist seltsam, dieser Pilz ist praktisch identisch mit einem der Pilze von Sumeru, aber wie kann er leuchten? Hat er Leuchtmittel entwickelt, während er im Dunklen war?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500708
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500708,
					"content": "Aber wenn das Leuchtmittel entwickelt hat, warum hat sich dann im Körper des Pilzes nichts verändert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500709,
						710500710
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500709,
					"content": "Ich kann das nicht verstehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500711
					]
				},
				{
					"id": 710500711,
					"content": "Einfach ausgedrückt: Pilze wandeln sich, indem sie sich an ihre Umgebung anpassen, aber dieser Pilz ist eindeutig eine Spezies, die besser für das Wachstum in einer Waldumgebung geeignet ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500712
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500712,
					"content": "Es besteht also kein Zweifel, dass dieser Pilz ursprünglich in Sumeru wuchs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500713
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500713,
					"content": "Das leuchtende ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500714
					]
				},
				{
					"id": 710500714,
					"content": "Die Tatsache, dass es sich bei dem Pilz nicht um eine einheimische Art der Großen Kluft handelt, lässt vermuten, dass das Leuchten kein Produkt der Evolution ist, sondern eher das Ergebnis abnormaler ökologischer Einflüsse ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500715
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500715,
					"content": "Wahrscheinlich wegen der Fragmente, die vom Himmel fielen und ihre Energie absorbierten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500716,
						710500717
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500716,
					"content": "Fragmente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500718
					]
				},
				{
					"id": 710500718,
					"content": "Ähem ... Hm? Was hast du gerade gesagt, Fragmente? Ah, ich meine, das muss an den Pilzfragmenten liegen, die entstehten, wenn sie vom Himmel herabschweben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500719
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500719,
					"content": "Das hat eine zufällige Mutation ergeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500720
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500720,
					"content": "Das muss es sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500721
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500721,
					"content": "Vielen Dank, dass du diese Pilze sammeln konntest, das war harte Arbeit, geh dich erst einmal ausruhen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500722
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500722,
					"content": "Ich muss noch mehr über diese Pilze recherchieren und jemand neben mir würde mich stören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500717,
					"content": "Welche Fragmente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500718
					]
				},
				{
					"id": 710500710,
					"content": "Hm? Wo ist das Problem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500711
					]
				}
			]
		}
	]
}