			"dialogs": [
				{
					"id": 710500401,
					"content": "Über diesen Pilz ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500402
					]
				},
				{
					"id": 710500402,
					"content": "Ich sollte sagen, dass du wirklich ein erfahrener Abenteurer bist, da du so schnell Ergebnisse hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500403
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500403,
					"content": "Hm? Sicher, dass die Pilze hier gepflückt wurden? Das ist etwas seltsam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500404
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500404,
					"content": "Können Pilze nicht unter der Erde wachsen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500405
					]
				},
				{
					"id": 710500405,
					"content": "Es ist nicht so, dass es nicht geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500406
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500406,
					"content": "Es ist nur, weil dieser Pilz einem Pilz ähnelt, der in Sumeru wächst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500407,
					"content": "Nur eines ist nicht genug ... Wenn es genug Proben gäbe, könnten wir vielleicht etwas herausfinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500408,
					"content": "Proben ... Da du auch diese hier bekommen hast, musst du doch wissen, wo es noch mehr gibt ... Warum holst du nicht ein paar für mich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500409
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500409,
					"content": "Wenn du mir hilfst, genug Pilze zu sammeln, gebe ich dir viele Mora als Bezahlung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500410
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500410,
					"content": "Also, wie viel ist genug?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500411
					]
				},
				{
					"id": 710500411,
					"content": "Hmmm ... Mal sehen ... Acht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500412
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500412,
					"content": "Solange du sie hierher bringst, wirst du genug Geld bekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				}
			]
		},
		{
			"id": 7105007,
			"completionStepIds": [
				7105003
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
