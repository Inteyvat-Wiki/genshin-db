				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180101,
					"content": "Na dann! Endlich, es ist geschafft! Zum Glück erinnere ich mich an diese Spezifikationen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180102,
					"content": "Wir gehen also hinein, um diese Tatarigami zu bereinigen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180103
					]
				},
				{
					"id": 721180103,
					"content": "Das würde ich gerne tun, ja, aber wir dürfen hier nicht nachlassen, nicht einmal für eine Sekunde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180104,
					"content": "Da zudem einige Materialien einfach nicht gefunden werden konnten und somit durch andere ersetzt werden mussten, ist die Zuverlässigkeit dieses Gerätes etwas ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180105,
					"content": "Hmm. Nun, lass mich einfach sagen, dass „es unter Umständen nicht die gewünschte Wirksamkeit erzielt“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180106,
					"content": "Man kann es normal benutzen, ja, aber ich bezweifle, dass es irgendwelche Unfälle aushält, und sollte es zu sehr durchgeschüttelt werden, könnte es auch Probleme bekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180107,
					"content": "Daher benötigen wir noch ein wenig mehr Vorbereitung, bevor wir unseren neuen Freund hier in Betrieb nehmen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180108,
					"content": "Ich möchte, dass du in die Nähe des Mikage-Hochofens gehst und ein paar Daten für mich aufzeichnest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180109,
						721180111
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180109,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180110
					]
				},
				{
					"id": 721180110,
					"content": "Ich danke dir vielmals. Ich werde hier auf dich warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180111,
					"content": "Müssen wir wirklich so zurückhaltend sein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180112
					]
				},
				{
					"id": 721180112,
					"content": "Natürlich tun wir das. Um die Wahrheit zu sagen, selbst jetzt habe ich ziemlich viele Schritte vernachlässigt. Wenn Flois hier wäre, würde es noch eine Woche dauern, bis wir seinen Prozess durcharbeiten würden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180113,
					"content": "Alles in allem, lasst uns tun, was diese einzigartige Situation verlangt. Wir sind schließlich das zuständige Prüfungsgremium ... und ich ermächtige uns, uns so anzupassen, wie es unserer Situation entspricht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7211802,
