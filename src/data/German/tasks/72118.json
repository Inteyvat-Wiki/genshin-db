			"dialogs": [
				{
					"id": 721180501,
					"content": "Die jüngsten Aktionen der Fatui sind immer seltsamer geworden. Sie alle versammeln sich um den Kern des Ofens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180502
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180502,
					"content": "Hoffentlich brüten sie nicht eine weitere heimtückische Verschwörung aus. Oder sollte ich sagen: etwas versuchen, wogegen wir nicht ankommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		}
