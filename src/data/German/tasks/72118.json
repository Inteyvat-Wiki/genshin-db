				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180301,
					"content": "Also, hast du die Situation ausgekundschaftet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180302,
					"content": "Das habe ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211804,
			"completionStepIds": [
				7211809
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211809",
							"2"
						],
						"stepId": 7211809,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180401,
					"content": "Super! Lass mich sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180402
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180402,
					"content": "Wir haben Glück, wie es scheint. Der Mikage-Hochofen ist ziemlich stabil und die Energien darin sind noch nicht übersättigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180403
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180403,
					"content": "Bei diesem Konzentrationsgrad hält mein Gerät noch durch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180404
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180404,
					"content": "Müssen wir all diese Energie reinigen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180405
					]
				},
				{
					"id": 721180405,
					"content": "Wenn dieses Gerät das könnte, dann hätte ich schon längst ein Patent angemeldet. Aber unser feiner Freund hier kann das Energieniveau nur in einem begrenzten Bereich senken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180406
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180406,
					"content": "Der Grund für die Deaktivierung des Mikage-Hochofens und das Scheitern sogar eines automatischen Neustarts ist jedoch die hohe Sättigung der Energien der Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180407
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180407,
					"content": "Solange wir den Bereich mit der höchsten Konzentration finden und ihn reinigen, sollten wir in der Lage sein, den Kern neu zu starten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180408
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180408,
					"content": "Zu diesem Zeitpunkt sollte der Mikage-Hochofen wieder anlaufen, und darüber hinaus ... über solche Dinge müssen wir uns nicht aufregen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180409
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180409,
					"content": "Das ist alles, was ich geplant habe ... Und bevor wir diesen Plan ausführen, muss ich noch ein paar weitere Vorbereitungen treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
