			"dialogs": [
				{
					"id": 790040202,
					"content": "Wer hätte gedacht, dass wir auf einer Insel wie dieser eine solche Wandmalerei finden würden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7900403,
			"completionStepIds": [
				7900422
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7900402",
							"3"
						],
						"stepId": 7900402,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7900419",
							"2"
						],
						"stepId": 7900419,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790040301,
					"content": "Also, wir haben uns all diese Wandmalereien notiert. Wenn wir sie verbinden, sollten wir herausfinden können, was passiert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7900404,
			"completionStepIds": [
				7900404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7900404",
							"2"
						],
						"stepId": 7900404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790040401,
					"content": "Hm ... Die Dinge, die hier in diesen Malereien abgebildet sind, sind an sich nicht schwer zu entziffern. Ich kann sie noch nicht alle in die richtige Reihenfolge bringen, aber es sollte in Ordnung sein, wenn wir versuchen sie eins nach dem anderen zu verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040402
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040402,
					"content": "Zunächst haben wir diese Wandmalerei, die eine Gruppe Schiffbrüchiger darstellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040403
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040403,
					"content": "Nachdem sie Schiffbruch erlitten haben, müssen sie zu der Insel getrieben sein, wo du auf diese Wandmalereien getroffen bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040404
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040404,
					"content": "Dann sind sie auf der Insel geblieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040405
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040405,
					"content": "Diese Malerei zeigt fünf Gegenstände mit fünf verschiedenen Markierungen darin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040406
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040406,
					"content": "Wie fünf mit Wasser gefüllte Tassen, wobei jede eine andere Menge enthält.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040407
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040407,
					"content": "Eine solche Darstellung deutet für gewöhnlich auf eine Veränderung des aktuellen Status von etwas hin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040414,
						790040415
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040414,
					"content": "Eine Veränderung der Situation ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040408
					]
				},
				{
					"id": 790040408,
					"content": "Jedoch kann ich natürlich nicht genau sagen, was dieses „Etwas“ sein könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040409
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040409,
					"content": "Doch da sich diese Insel mitten im Ozean befindet, könnte dieses „Etwas“ natürlich das „Meerwasser“ sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040410
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040410,
					"content": "Schauen wir uns als Nächstes diese Wandmalerei an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040411
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040411,
					"content": "Nach einem weiteren Schiffbruch begrüßt die Insel einige neue „Gäste“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040412
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040412,
					"content": "Das dürfte wohl die erste Gruppe sein, die einen Rettungsversuch gestartet hat. Wenn du außerdem einen Blick auf das Wrack wirfst, das hier abgebildet ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040413
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040413,
					"content": "Die erste Wandmalerei deutet nur auf ihre Situation hin, aber diese geht bezüglich des Schiffswracks doch sehr ins Detail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040416
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040416,
					"content": "Vielleicht war gerade dieses Schiffswrack von seltsamer Bedeutung für die Menschen, die auf dieser Insel strandeten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040417
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040417,
					"content": "Nun kommen wir zu dieser Wandmalerei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040418
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040418,
					"content": "Hier, ich bin sicher, dir fällt auf, dass dieser Berg besonders hervorgehoben wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040419
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040419,
					"content": "Ich vermute, dass dies ein wichtiger Ort für die Menschen dort gewesen sein muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040422
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040422,
					"content": "Und schließlich kommen wir zu diesem hier. Offensichtlich haben sie einen Weg gefunden, die Insel zu verlassen, und sind aufgebrochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040423
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040423,
					"content": "Das ist also die Geschichte, die die Wandmalereien erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040424,
						790040428
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040424,
					"content": "Danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040425
					]
				},
				{
					"id": 790040425,
					"content": "Nichts zu danken. Tatsächlich war ich schon immer sehr an Forschung dieser Art interessiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040426
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040426,
					"content": "Ich sollte euch danken, dass ihr diese Geschichte und Wandmalereien zu mir gebracht habt. Ich hätte nie gedacht, dass mir solche Dinge in Mondstadt einmal begegnen würden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040427
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040427,
					"content": "Vielleicht sollte ich mir etwas Zeit nehmen und draußen einen Spaziergang machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040428,
					"content": "Aber warum haben sie sich entschieden, Wandmalereien zu nutzen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040429
					]
				},
				{
					"id": 790040429,
					"content": "Manchmal sind Bilder intuitiver als Sprache, wenn es darum geht Informationen aufzuzeichnen und weiterzugeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040426
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040415,
