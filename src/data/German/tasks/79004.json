					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790041201,
					"content": "Hallo, Freund. Kann ich etwas für dich tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041202
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041202,
					"content": "Bist du ein Gelehrter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790041203,
					"content": "Haha, da zähle ich wohl dazu. Genauer gesagt bin ich ein „reisender Gelehrter“, aber ich schätze das ist wohl einfach nur eine Unterkategorie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041204
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041204,
					"content": "Nun denn, bist du auf ein Problem gestoßen, bei dem du die Hilfe eines „Gelehrten“ benötigst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041205
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041205,
					"content": "Also, Folgendes ist geschehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041206
					]
				},
				{
					"id": 790041206,
					"content": "Eine Insel im Meer ... und Wandmalereien, die du dort gefunden hast. Faszinierend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041207
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041207,
					"content": "Daraus schließe ich, dass du nach einem Gelehrten suchst, der dir beim Entziffern dieser Wandmalereien helfen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041208,
						790041210
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041208,
					"content": "Würdest du uns helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041209
					]
				},
				{
					"id": 790041209,
					"content": "Selbstverständlich. Ich habe noch nie eine Gelegenheit ausgelassen, das Unbekannte zu studieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041213,
					"content": "Dann sollten wir nicht weiter Zeit verschwenden. Dürfte ich einen Blick auf diese Wandmalereien werfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041214
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041214,
					"content": "Hier sind die, die wir aufgezeichnet haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041215
					]
				},
				{
					"id": 790041215,
					"content": "Oh, nicht schlecht, ganz und gar nicht schlecht. Entschuldigt, ich brauche einen Moment zum Nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041210,
					"content": "Wir können dich bezahlen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041211
					]
				},
				{
					"id": 790041211,
					"content": "Hahaha, so wie es aussieht, seid ihr sehr erfahrene Abenteurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041212
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041212,
					"content": "Doch ich würde sagen, dass diese Geschichten des Unbekannten bereits der größtmögliche Lohn für mich sind. Ihr müsst mir weiter nichts geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "Sayid"
				}
			]
		},
