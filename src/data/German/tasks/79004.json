			},
			"dialogs": [
				{
					"id": 790040101,
					"content": "Hm? Schau mal, da ist eine Art ... Zeichnung auf diesem Stein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040102
					],
					"speakerTitle": "Betrachten"
				},
				{
					"id": 790040102,
					"content": "Sieht wie ein Schiff mit großer Besatzung aus ... die in Seenot geraten sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040103
					],
					"speakerTitle": "Betrachten"
				},
				{
					"id": 790040103,
					"content": "Paimon kann das nicht besonders gut erkennen ... So oder so sollten wir uns eine Notiz von dieser Wandmalerei machen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Betrachten"
				}
			]
		},
		{
			"id": 7900402,
