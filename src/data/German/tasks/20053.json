			"dialogs": [
				{
					"id": 200530301,
					"content": "Geschafft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530302
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530302,
					"content": "Darauf wäre ich nie im Leben gekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530303
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530303,
					"content": "Danke dir! Ich werde es gleich selbst versuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		}
	]
