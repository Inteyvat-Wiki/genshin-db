			"dialogs": [
				{
					"id": 747030101,
					"content": "Moment mal ... Diese Zahlen ... Seid ihr euch sicher, dass ihr euch nicht verrechnet habt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030102,
					"content": "Hmm? Stimmt etwas nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030103,
					"content": "... Habt ihr wirklich so viel Gewinn gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030104,
					"content": "#Hast du es dir mit deinem Anteil von 30{NON_BREAK_SPACE}Prozent anders überlegt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030105
					]
				},
				{
					"id": 747030105,
					"content": "Glaubst du wirklich, dass ich so kleinlich bin? Ich bin einfach nur erstaunt, dass ihr das Aquarium so gut geführt habt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030106,
					"content": "Paimon denkt, dass die Fontainale auch einen Teil dazu beigetragen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030107,
					"content": "So hohe Einnahmen ... Selbst nachdem wir die Miete für die Wingalet bezahlen, bleibt da noch ein ordentlicher Gewinn übrig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030108,
					"content": "Denkst du über einen Berufswechsel nach?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030109
					]
				},
				{
					"id": 747030109,
					"content": "Nicht im Geringsten. Ich mache mir keine Illusionen über meinen Geschäftssinn. Meine Leidenschaft liegt darin, Maschinen zu bauen und Formeln zu studieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030110,
					"content": "Trotzdem ... Zu sehen, wie aus diesem Raum ohne Fische das geworden ist, was er heute ist, fühlt sich wirklich wie ein Wunder an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030111,
					"content": "Hehe, na ja, wir haben es dir zu verdanken, dass du uns den Platz überlassen hast! Es ist einfach toll zu sehen, wie unsere Arbeit so vielen Leuten Freude macht! Findest du nicht auch, Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030112,
					"content": "Hmpf. Vielleicht ein bisschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030113
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030113,
					"content": "Nur ein bisschen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030114,
					"content": "#Das liegt bestimmt daran, dass sie sich mit 30{NON_BREAK_SPACE}Prozent zufriedengegeben hat ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030115
					]
				},
				{
					"id": 747030115,
					"content": "Ich habe dir gesagt, dass mir das egal ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
