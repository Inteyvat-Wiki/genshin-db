			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Furuya Noboru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630201,
					"content": "Hmm, da bekommt man Kopfweh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630202
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630202,
					"content": "Weißt du vielleicht irgendetwas über diese Karte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630203
					]
				},
				{
					"id": 721630203,
					"content": "Der Topografie nach würde ich sagen, dass es ein Ort auf der Insel Seirai ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630204
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630204,
					"content": "Woher weißt du das?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630205
					]
				},
				{
					"id": 721630205,
					"content": "Die Gilde hat in der Vergangenheit mehrere Expeditionen zur Insel Seirai in Auftrag gegeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630206
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630206,
					"content": "Die Abenteurer, die diese Missionen akzeptiert haben, sollten uns in Form von Berichten Informationen über die Insel liefern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630207
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630207,
					"content": "Unglücklicherweise hatten wir nicht genug Personal, um eine Expedition im großen Stil zu starten, also mussten wir uns damit begnügen, jeweils nur wenige Abenteurer zu schicken, um die Gegend zu erkunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630208
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630208,
					"content": "Ich fürchte, dass ich dir deswegen nicht weiter helfen kann, diese Karte zu analysieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630209
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630209,
					"content": "Ich kenne aber jemanden, der mit Seirai mehr zu tun haben könnte als ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630210
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630210,
					"content": "Sein Name ist Oda Tarou. Ich habe gehört, dass seine Vorfahren auf Seirai gelebt haben, bevor sie aus verschiedenen Gründen hierher ausgewandert sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630211
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630211,
					"content": "Da wir gerade davon sprechen: Er ist vor einiger Zeit zur Gilde gekommen, um einige Abenteurer anzuheuern, die ihn nach Seirai begleiten, um sich den Ort anzusehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630212
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630212,
					"content": "Du kannst ihn zu dieser Karte befragen. Mit ein wenig Glück, weiß er etwas darüber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furuya Noboru"
				}
			]
		},
		{
			"id": 7216303,
			"completionStepIds": [
				7216302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7216302",
							"2"
						],
						"stepId": 7216302,
						"stateName": "QUEST_STATE_UNFINISHED"
