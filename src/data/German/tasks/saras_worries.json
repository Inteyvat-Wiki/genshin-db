			"dialogs": [
				{
					"id": 4890301,
					"content": "Süß mariniertes Hühnchen, verstanden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890302
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890302,
					"content": "Das riecht aber ... nicht schlecht. Das kann sich sehen lassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890303
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890303,
					"content": "Dann kannst du auch gleich die <color=#00E1FFFF>Honigmöhren-Fleischpfanne</color> von dieser Bestellung übernehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890304
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890304,
					"content": "<color=#00E1FFFF>Honigmöhren-Fleischpfanne</color>! Die haben wir doch mal mit Amber zusammen gegessen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890305,
					"content": "Genau, dieses Gericht ist das ganze Jahr über auf der Karte. Es ist der Stolz des Hirschjägers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890306
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890306,
					"content": "Der Ritterorden gibt oft diese Bestellung heraus, wenn es etwas zu feiern gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890307
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890307,
					"content": "Dann gebe ich dir erst einmal das Rezept für die <color=#00E1FFFF>Honigmöhren-Fleischpfanne</color> ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890308
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890308,
					"content": "Warte, meintest du nicht, es sei der ganze Stolz des Hirschjägers? Kannst du uns das Rezept dann einfach so überlassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890309,
					"content": "Bei deinen Kochkünsten wäre es geradezu eine Verschwendung, es dir nicht zu geben, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890310
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890310,
					"content": "Bring die <color=#00E1FFFF>Honigmöhren-Fleischpfanne</color> her, sobald sie fertig ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
