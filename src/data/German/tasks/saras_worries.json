			"dialogs": [
				{
					"id": 4890201,
					"content": "Habt ihr die Zutaten gesammelt? Ich seh mal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890202
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890202,
					"content": "Ah, ja. Scheint alles da zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890203,
					"content": "Und jetzt ... brauchen wir noch ein <color=#00E1FFFF>süß mariniertes Hühnchen</color> für Bestellung Nr. 7. Dankeschön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890204
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890204,
					"content": "Ihr haltet uns wohl für Köche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890205,
					"content": "Ihr wolltet dem Hirschjäger doch helfen! Bringt das Gericht bitte noch heiß her, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
