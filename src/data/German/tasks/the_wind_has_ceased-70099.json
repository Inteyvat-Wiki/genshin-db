			"dialogs": [
				{
					"id": 700650101,
					"content": "Zum einen Ohr rein, zum anderen wieder raus, was? Ich sagte doch schon, dass jetzt nicht der richtige Zeitpunkt ist, in die Berge zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650102
					],
					"speakerTitle": "Herr Mann"
				},
				{
					"id": 700650102,
					"content": "Immer mit der Ruhe, Herr Mann. Komm erstmal runter und lass uns das nochmal besprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650103
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650103,
					"content": "Vorhin im „Nachtbräu“ hab ich mich doch noch ganz nett mit Herrn Mann unterhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650104
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650104,
					"content": "Als er hörte, dass ich zum Windruh-Berg wollte, hat er mich sofort mitgeschleift, den ganzen Weg bis hierher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650105
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650105,
					"content": "Oh, das ist ja Huffman! Ist hier irgendwas passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700650106,
					"content": "Wie du siehst, versucht Herr Mann gerade, die Leute mit aller Kraft davon zu überzeugen, sich vom Windruh-Berg fernzuhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650107
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650107,
					"content": "Darf ich vorstellen: Das ist Lipphart, eine Abenteurerin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650108,
					"content": "Was ich am eigenen Leib erlebt habe, ist aber echt gruselig! Wollt ihr das wirklich hören?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650109
					],
					"speakerTitle": "Herr Mann"
				},
				{
					"id": 700650109,
					"content": "Na gut, ich habe das Gefühl, dass ich heute hier nicht mehr wegkomme. Dann höre ich mir das mal an. Ich tu einfach so, als wäre das die Fortsetzung der Angeberei beim Trinken vorhin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650110
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650110,
					"content": "Dann will ich mal sehen, wie gefährlich es wirklich ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650111
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650111,
					"content": "Im Sanatorium gibt es wirklich Geister! Ich habe sie mit eigenen Augen gesehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650112
					],
					"speakerTitle": "Herr Mann"
				},
				{
					"id": 700650112,
					"content": "Waah, Geister?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700650113,
					"content": "Also, was gestern Abend angeht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herr Mann"
				}
			]
		}
	]
