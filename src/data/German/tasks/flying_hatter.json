			"dialogs": [
				{
					"id": 790720101,
					"content": "#Oh, was für eine Ehre! Du bist bestimmt {NICKNAME}! Und die Person an deiner Seite muss deine Begleiterin, Fräulein Paimon sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720102
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720102,
					"content": "Hehe, das stimmt! Wir sind es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790720103,
					"content": "Sind wir schon so berühmt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720104
					]
				},
				{
					"id": 790720104,
					"content": "Neuigkeiten verbreiten sich in der Konstellations-Metropole schnell, schneller als im Rest der Welt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720105
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720105,
					"content": "Ich muss sagen, dass du genau zur richtigen Zeit kommst! Ich war gerade dabei, meinem Spiel „Fliegender Hut“ den letzten Schliff zu geben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720106
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720106,
					"content": "Ich kann zwar nicht wie der Hutmacher aus „Der fliegende Hutmacher“ jedem einen schönen Hut geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720107
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720107,
					"content": "Aber ich glaube, dass dieses „Fliegender Hut“-Spiel allen, die es spielen, viel Freude bereiten wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720108
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720108,
					"content": "Außerdem habe ich drei völlig unterschiedliche Spielmodi dafür entwickelt ... Keine Sorge, die Regeln sind gar nicht kompliziert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720109
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720109,
					"content": "Versuche nur ein Spiel, und du wirst wissen, wovon ich spreche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720110,
						790720112
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720110,
					"content": "Dann will ich es mal ausprobieren!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720111
					]
				},
				{
					"id": 790720111,
					"content": "Gut, hier entlang, bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720112,
					"content": "Ich habe gerade keine Zeit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720113
					]
				},
				{
					"id": 790720113,
					"content": "Verstehe. Komm einfach zu mir, wann immer du Zeit hast. Ich werde bis auf Weiteres hier sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Devitt"
				}
			]
		}
	]
}