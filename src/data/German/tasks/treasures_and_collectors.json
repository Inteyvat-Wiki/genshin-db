				},
				{
					"id": 750090202,
					"content": "Diese kleine Kugel ... Sieht aus wie ein Bauteil oder so. Gefällt sie dir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090203
					],
