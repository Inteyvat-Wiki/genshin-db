			"dialogs": [
				{
					"id": 750090101,
					"content": "Dreihundert Mora für den Eintritt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090102,
						750090103
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090102,
					"content": "Etwas billiger, bitte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090105
					]
				},
				{
					"id": 750090105,
					"content": "Der Preis wird vom Verein für Saurierrelikte festgelegt und kann nicht verhandelt werden. Soweit ich weiß, ist dies schon die billigste Ausgrabungsstätte, da sie als eine der ersten eröffnet wurde und schon seit langem erschlossen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090106
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090106,
					"content": "Aber es gibt immer wieder Träumer wie euch, die ihr Glück versuchen wollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090107
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090107,
					"content": "Denn vielleicht hatte doch keiner der Tausenden von Menschen, die vor euch gekommen sind, ein gutes Auge für Schätze und hat ein unbezahlbares Relikt übersehen, das einfach nur gewöhnlich aussieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090108
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090108,
					"content": "Dreihundert Mora sind ein günstiger Preis für einen großen Traum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090109
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090109,
					"content": "Also, glaubst du auch, dass du der einzige Glückspilz bist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090110
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090110,
					"content": "*brüll* ... *brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090111,
						750090112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090111,
					"content": "Vielleicht habe ich heute einfach Glück.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090113,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, willst du auch dein Glück versuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090114,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090115,
					"content": "Er sieht sehr interessiert aus! Hehe, nur dreihundert Mora, das kann Paimon bezahlen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090116,
					"content": "Drei Hoffnungen für nur dreihundert Mora, das ist wirklich ein Schnäppchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090117,
					"content": "Dann wünsche ich euch allen viel Glück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090112,
					"content": "Das ist egal, denn ich habe hier einen Glückssaurier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090103,
					"content": "Wenn ich dich schlage, ist es kostenlos, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090104
					]
				},
				{
					"id": 750090104,
					"content": "He, so machen wir das normalerweise nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090105
					],
					"speakerTitle": "Paimon"
				}
			]
		},
