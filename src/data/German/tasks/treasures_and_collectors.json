			"dialogs": [
				{
					"id": 750090601,
					"content": "Wie ist es gelaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090602
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090602,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} hat das hier gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090603,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090604
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090604,
					"content": "Lass mich mal nachsehen ... Obwohl dies nichts Seltenes ist, sieht man nicht oft ein so gut erhaltenes Stück. Sogar die Muster des Phlogistonflusses sind noch deutlich zu erkennen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090605
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090605,
					"content": "Gut. Ich würde es für zehntausend Mora kaufen, wenn ihr einverstanden seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090606
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090606,
					"content": "Oh? Haben wir wirklich ein wertvolles Saurierrelikt gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090607,
					"content": "#Du bist wirklich ein toller kleiner Glückspilz, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090608,
					"content": "Nein, es ist nicht annähernd so wertvoll, wie du zu glauben scheinst. Wenn ihr es zum Hauptquartier des Vereins für Saurierrelikte bringen würdet, um es schätzen zu lassen, würde ich sagen, dass es höchstens etwa fünftausend Mora wert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090609
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090609,
					"content": "Paimon fällt nicht auf diesen Trick herein! Wenn es wirklich nur fünftausend wert ist, warum bist du dann bereit, zehntausend dafür zu bezahlen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090610,
					"content": "Weil ich die einzigartigen Muster darauf mag. Auch wenn es in den Augen anderer nicht so wertvoll ist, bin ich bereit, ein bisschen mehr dafür zu bezahlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090611
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090611,
					"content": "Man kann mich als exzentrisch bezeichnen, aber man kann auch sagen, dass das einfach die Art eines Sammlers ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090612
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090612,
					"content": "Hmm ... Wenn du es so sagst, kann Paimon es auch verstehen. Und verglichen mit den dreihundert Mora Eintrittsgeld sind zehntausend schon eine ganze Menge ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090613,
					"content": "Und, tauschen wir es gegen zehntausend Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090614,
					"content": "*brüll* ... *brüüüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090615
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090615,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} scheint darüber nicht sehr froh zu sein ... Möchte er es für sich behalten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090616,
					"content": "*brüll* ... *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090617,
						750090618
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090617,
					"content": "#Schließlich hat {REALNAME[ID(2)|SHOWHOST(true)]} es gefunden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090619
					]
				},
				{
					"id": 750090619,
					"content": "#Da {REALNAME[ID(2)|SHOWHOST(true)]} es nicht verkaufen will, sollten wir es einfach selbst behalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090620,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090621
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090621,
					"content": "#Ihr scheint {REALNAME[ID(2)|SHOWHOST(true)]} mehr zu schätzen als Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090622
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090622,
					"content": "#Natürlich! Denn {REALNAME[ID(2)|SHOWHOST(true)]} ist unser Freund! Aber wenn wir in Zukunft wieder etwas Ähnliches finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090623,
					"content": "Danke, aber die Leidenschaft eines Sammlers ist so unbeständig wie die Gezeiten. Sie steigt schnell an, kann sich aber ebenso schnell wieder zurückziehen. Vielleicht werde ich in Zukunft von etwas anderem besessen sein, obwohl ich noch nicht sagen kann, was mein neues Interesse sein wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090624
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090624,
					"content": "*brüll*! *brüll* *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090625
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090625,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, stimmst du ihr zu? Oh, Paimon hat es verstanden! Das muss der gegenseitige Respekt und das Verständnis zwischen Sammlern sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090626,
					"content": "Es ist mir eine Ehre, von einem so brillanten jungen Tepetlisaurier anerkannt worden zu sein. Doch auch wenn wir keine Geschäfte machen können, können wir trotzdem Freunde sein. Ihr könnt mich jederzeit aufsuchen, wenn ihr über das Sammeln reden wollt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090627
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090627,
					"content": "Dann will ich euch nicht länger aufhalten. Viel Glück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090618,
					"content": "#Es sieht so aus, als wolle {REALNAME[ID(2)|SHOWHOST(true)]} auch ein Sammler werden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090619
					]
				}
			]
