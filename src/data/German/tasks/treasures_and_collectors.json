					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090204,
					"content": "Zwar haben wir es nicht ausgegraben, aber da wir es hier gefunden haben ... ist es vielleicht auch etwas wirklich Wertvolles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090205,
					"content": "Fragen wir danach, wenn wir gehen!",
					"roleType": "TALK_ROLE_NPC",
