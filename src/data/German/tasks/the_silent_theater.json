							-26.859
						],
						"pointId": 31
					},
					{
						"sceneId": 1156,
						"position": [
							19.488,
							0.278,
							-25.627
						],
						"pointId": 32
					},
					{
						"sceneId": 1156,
						"position": [
							21.366,
							0.278,
							-24.957
						],
						"pointId": 33
					}
				]
			},
			"dialogs": [
				{
					"id": 762030101,
					"content": "Oh, da seid ihr ja! Ich hab mich schon gefragt, ob ich euch deutlichere Anweisungen schicken soll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030102,
					"content": "Aber dann dachte ich mir, wenn ich euch zu deutliche Hinweise gebe, könnte das eure Reisepläne durcheinanderbringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030103,
					"content": "Und dann, während ich hin und her gelaufen bin und mir den Kopf zerbrochen habe, was ich tun sollte ... seid ihr trotzdem hier aufgetaucht! Also hat sich anscheinend alles von selbst geregelt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030104,
					"content": "He, Nicole! Du bist heute ja voller Energie! Und ... Worte ... du bist so voller Worte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030105,
					"content": "Das nehme ich mal als Kompliment! Also gut, seid ihr bereit euch meinen nächsten Raum anzusehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7620302,
			"completionStepIds": [
				7620302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
