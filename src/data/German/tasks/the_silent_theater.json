			"dialogs": [
				{
					"id": 762030501,
					"content": "Diese Gemälde erinnern mich alle an Orte, die mir sehr am Herzen liegen. Und jetzt ist das Atelier vollständig wiederhergestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030502
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030502,
					"content": "Also gut, hol dir unsere Belohnung. Was? Schau mich nicht so an! Natürlich ist diese Belohnung „unsere“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030503
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030503,
					"content": "Du wirst die Truhe doch nicht etwa ungeöffnet lassen, oder? Wenn du das tust, kann ich dich nicht gehen lassen. Außerdem, nachdem ich dir so viele Geschichten erzählt habe, verdiene ich doch auch eine Belohnung, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
