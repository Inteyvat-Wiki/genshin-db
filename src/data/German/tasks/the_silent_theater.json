						],
						"pointId": 9
					}
				]
			},
			"dialogs": [
				{
					"id": 762030301,
					"content": "Ist das ein Irminsul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030302,
					"content": "Oh, dieses Gemälde hier? Ihr kennt die weißen Bäume offensichtlich ... aber wusstet ihr, dass der Verrat des ersten Engels unter einem ihrer Äste geschah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030303,
						762030304
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030303,
					"content": "Ich glaube nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030305
					]
				},
				{
					"id": 762030305,
					"content": "Jetzt ist Paimon neugierig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030306,
					"content": "Dann ist es wohl an der Zeit, dir eine Geschichte über Romantik und Schrecken zu erzählen. Lass mich nur überlegen, wie ich die Identität der Beteiligten am besten schützen kann ... Ja, ich hab’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030307,
					"content": "#Vor langer, langer Zeit gab es einen Reisenden, der zwischen den Sternen umherwanderte – ganz anders als du, {NICKNAME}, aber das ist gerade nicht wichtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030308,
					"content": "Eines Tages reiste er zu einem silbernen Baum, um die Prinzessin des Morgensterns zu besuchen. Schon bald begann er, sie über die verbotendsten Geheimnisse ihres Königreichs auszufragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030309,
					"content": "Seine Worte verwirrten die Prinzessin. Wie konnte er von all diesen Dingen wissen, die von den Göttern verboten waren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030310,
					"content": "Der junge Mann erzählte von seiner Herkunft und zeigte der Prinzessin Dinge, die sie noch nie gesehen hatte – von freiem Willen und Liebe, edel und erhaben zugleich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030311,
					"content": "Seine Worte weckten ihr Selbstgefühl, das bisher von den Göttern gefesselt war. Ihr Herz flog hoch und trug sie über Grenzen hinaus, die sie nie zuvor überschritten hatte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030312
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030312,
					"content": "Die Prinzessin des Morgensterns vertraute dem Jungen die Geheimnisse des Königreichs an, und zwischen ihnen wuchs und blühte die Liebe – zusammen mit der Entschlossenheit, sich den Göttern zu widersetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030313
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030313,
					"content": "Das ist doch nur eine kitschige Liebesgeschichte! Du hast gesagt, es würde gruselig werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030314,
					"content": "Keine Sorge, Paimon, es wird schon noch gleich gruselig genug. Sie sehnten sich danach, den Menschen ein Leben in ungehinderter Freiheit zu ermöglichen, doch die Götter konnten ihren Verrat nicht verzeihen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030315
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030315,
					"content": "Sie schickten Donner und Zorn herab und zerstörten das Zuhause der Liebenden. Und als der große Krieg endete, waren die Macht und die Weisheit der Prinzessin verloren ... für immer verloren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030316
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030316,
					"content": "Sogar ihre engsten Freunde wurden verflucht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030317
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030317,
					"content": "... Oooh, ja ... Dieses Ende war jetzt wirklich gruselig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030318,
					"content": "Aber ... wolltest du uns nicht vom ersten Engel erzählen? Und ... du willst doch nicht etwa sagen, dass diese Geschichte wahr ist, oder ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030319,
					"content": "Ist sie wirklich, und das ist der gruseligste Teil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030320
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030320,
					"content": "Nun, dann erzähle ich mal wieder eine gruselige Liebesgeschichte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030321
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030321,
					"content": "Lasst mich nur überlegen, wie ich die Identität der Beteiligten am besten schützen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030322
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030322,
					"content": "Ich hab’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030304,
					"content": "Habe ich schonmal gehört ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030305
					]
				}
			]
		},
