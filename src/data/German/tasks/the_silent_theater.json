				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nicole"
				],
				"points": [
					{
						"sceneId": 20360,
						"position": [
							589.654,
							904.556,
							494.111
						],
						"pointId": 5
					},
					{
						"sceneId": 20360,
						"position": [
							588.836,
							904.613,
							494.721
						],
						"pointId": 6
					},
					{
						"sceneId": 20360,
						"position": [
							589.08,
							904.586,
							495.725
						],
						"pointId": 7
					}
				]
			},
			"dialogs": [
				{
					"id": 762030201,
					"content": "Was zum ...!? Paimon hätte fast einen Herzinfarkt bekommen, so von einem Gemälde eingesaugt zu werden! ... Moment mal, dieser Ort kommt Paimon bekannt vor ... Oh, das ist der Tisch, an dem die Hexen ihre Teegesellschaften abhalten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030202,
					"content": "Alles fing an, als Alice mich das erste Mal zum Tee einlud ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030203,
					"content": "An diesem Tag bin ich nicht persönlich hingegangen – vor allem, weil ich damals noch nicht entschieden hatte, ob ich dem Hexenzirkel wirklich beitreten wollte oder nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030204,
					"content": "Alice war die Einzige dort, die meine wahre Identität kannte. Sie warnte mich, kein Wort zu sagen oder irgendjemand anderem zu verraten, wer ich bin. Ich sollte nur beobachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030205
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030205,
					"content": "Und was geschah dann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030206,
					"content": "Nun ja ... Ich kam zu dem Schluss, dass sie mich dafür bestraft, dass ich gezögert habe mitzumachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030207,
					"content": "Alle haben über so interessante Dinge gesprochen. Wie hätte ich da nicht mitmachen können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030208,
					"content": "Und natürlich ... wenn du mitten in einem Gespräch bist und jemand eine Frage stellt, auf die du die Antwort kennst, wie sollst du da deinen Mund halten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030209,
					"content": "So kommen wir zur Wette zwischen Barbeloth und Alice, Rheindottirs verbotenen Schöpfungen, Ivanovnas politischen Machenschaften ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030210
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030210,
					"content": "Es war wie eine Reihe von exquisit gespielten Theaterstücken, eingedampft in die Grenzen einer Teetasse. Ihre Worte allein reichten aus, um meinen Instinkt zu entfachen, die Wahrheit vor ihnen bloßzulegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030211,
					"content": "Also hast du dich in ihren Köpfen zu Wort gemeldet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030212,
					"content": "Natürlich nicht! Obwohl ich das Gefühl hatte, dass mein Kopf gleich explodiert, habe ich alles für mich behalten. Ich bin schließlich ein verantwortungsvoller Engel – und mir ist der Unterschied zwischen „was ich sagen will“ und „was ich sagen darf“ sehr wohl bewusst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030213
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030213,
					"content": "Also hatte ich ein kleines privates Gespräch mit Alice in ihrem Kopf – nur sie und ich – und ich stimmte zu, dem Hexenzirkel beizutreten, genau dort und in dem Moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030214
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030214,
					"content": "Sie war sehr glücklich über meine Entscheidung, aber was das Reden in ihrem Kopf angeht ... Nun, sie behauptet, dass sie in den folgenden Tagen solche Kopfschmerzen hatte, dass sie einen Arzt in Liyue aufsuchen musste, um etwas Linderung zu bekommen. Aber dafür kann sie mir wirklich nicht die Schuld geben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7620303,
