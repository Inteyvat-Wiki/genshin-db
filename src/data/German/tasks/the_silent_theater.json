				]
			},
			"dialogs": [
				{
					"id": 762030401,
					"content": "He, das ist Simulanka! Ähm ... aber warum liegen hier überall kurze Erzählungen vom Verlagshaus Yae auf dem Boden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030402,
					"content": "Also, was meine literarische Erleuchtung angeht ... meine größte Inspiration von allen ... ist niemand Geringeres als Frau Anya höchstpersönlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030403
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030403,
					"content": "Sie war die Letzte, die dem Hexenzirkel beitrat, und doch die Erste, die ging ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030404
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030404,
					"content": "Ich liebte all ihre Geschichten. Ob es nur eine Idee war oder ein vollständig ausgearbeitetes Manuskript, Anya hatte immer das Geschick, ihre Leser vor Freude nach Luft schnappen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030405
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030405,
					"content": "Die Diskussionen im Hexenzirkel drehen sich selten um etwas anderes als Magie, und ich bin überzeugt, dass Anya eine ganz eigene Magie besaß. Sie konnte Liebe und Mitgefühl in Worte und Geschichten verweben, die die Herzen anderer berührten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030406
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030406,
					"content": "Ich habe sie um Tipps gebeten, wie man fesselnde Geschichten schreibt. Sie hat mir viele Tricks und Techniken beigebracht, aber am Ende war mein größter Feind immer ich selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030407
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030407,
					"content": "Zu faul, um die Feder aufs Papier zu setzen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030408
					]
				},
				{
					"id": 762030408,
					"content": "Ha! So kann man es auch ausdrücken. Gedanklich zu kommunizieren ist einfach viel praktischer. Ich schätze, selbst Engel können der Faulheit verfallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030409
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030409,
					"content": "Aber seit Kurzem habe ich mir vorgenommen, mir Mühe zu geben, wenn auch nur, um mir Vorwürfe von einer gewissen alten Seelien-Freundin zu ersparen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030410
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030410,
					"content": "Ooh! Heißt das, wir können endlich etwas lesen, das du geschrieben hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030411,
					"content": "Wer hat denn was vom Schreiben gesagt? Ich rede davon, beliebte Werke aus den letzten paar Jahrhunderten zu kaufen und sie in meiner Freizeit durchzublättern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030412
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030412,
					"content": "Ja, genau das meine ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030413
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030413,
					"content": "Gedanklich zu kommunizieren ist einfach viel praktischer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030414
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030414,
					"content": "Ich schätze, selbst Engel können der Faulheit verfallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
