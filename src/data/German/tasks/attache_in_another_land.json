						],
						"stepId": 2300205,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_NUM_LESS_THAN",
						"rawParams": [
							"101955",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanbei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230020301,
					"content": "Sehr gut! Das dürfte reichen. Diese Champignons sehen nicht schlecht aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020302
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020302,
					"content": "Hier ist deine Bezahlung. Vielen Dank für deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020303
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020303,
					"content": "Ist das der Brutto- oder der Nettolohn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020304
