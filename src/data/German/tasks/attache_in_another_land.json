			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanbei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230020101,
					"content": "Die Champignons in dem Laden hier scheinen von guter Qualität zu sein. Ich werde sie auf die Einkaufsliste setzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020102
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020102,
					"content": "Hanbei? Der Name kommt Paimon sehr bekannt vor. Paimon hat ihn scheinbar schon irgendwo einmal gehört ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020103,
						230020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020103,
					"content": "War das der Kerl in Tatarasuna ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020105
					]
				},
				{
					"id": 230020105,
					"content": "Oh! Er ist dieser Faulenzer, der Chaos beim „Mikage-Hochofen“ gestiftet hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020106,
						230020107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020106,
					"content": "Er ist wohl als „Außenattaché“ hierhergekommen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020108
					]
				},
				{
					"id": 230020108,
					"content": "Er ist also tatsächlich hier in Sumeru! Paimon dachte, dass diese Sache mit dem „Außenattaché“ nur ein Witz wäre ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020109,
					"content": "Was? Blondes Haar ... mit einem kleinen fliegenden Ding neben sich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020110
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020110,
					"content": "#Bist du {M#der Reisende}{F#die Reisende}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020111,
						230020112
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020111,
					"content": "Ja, das bin ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020114
					]
				},
				{
					"id": 230020114,
					"content": "Haha! Du bist es tatsächlich. Yousuke hat dich in seinem Brief erwähnt. Er hat geschrieben, dass du die Sache mit dem „Mikage-Hochofen“ zusammen mit Herrn Xavier geregelt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020115
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020115,
					"content": "Es ist mir wirklich peinlich, dass ich nicht helfen konnte. Als ihr beiden den „Mikage-Hochofen“ repariert habt, hatte ich alle Hände voll mit administrativer Arbeit zu tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020116
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020116,
					"content": "Wie kann administrative Arbeit wichtiger als der „Mikage-Hochofen“ sein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020117
					]
				},
				{
					"id": 230020117,
					"content": "Du hast deine Prioritäten falsch gesetzt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020118,
					"content": "Haha, nicht ganz. Wenn sich niemand um die administrative Arbeit kümmern würde, wie könnte dann die Reparatur des „Mikage-Hochofens“ so reibungslos vorankommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020119
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020119,
					"content": "Überleg es dir bitte, die Verwaltung muss die Menschen in der Umgebung evakuieren, sowohl die Materialien als auch die Handwerker für die Reparatur organisieren und alle Anforderungen der Produktion koordinieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020120
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020120,
					"content": "Ohne administrative Unterstützung würde das alles in einem kompletten Chaos enden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020121
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020121,
					"content": "Also genau wie Toranosuke gesagt hat ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020122
					]
				},
				{
					"id": 230020122,
					"content": "Du wirst deinem Ruf gerecht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020123,
					"content": "Toranosuke ... Dieser Herr hat keinerlei Wertschätzung für administrative Arbeit. Mit ihm zusammenzuarbeiten, endet für mich immer in zusätzlicher Arbeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020124
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020124,
					"content": "Aber ich bin nun nicht mehr länger für den „Mikage-Hochofen“ zuständig. Ich habe jetzt die Rolle eines „Außenattachés“ in Sumeru inne und kümmere mich um den Handel mit Champignons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020125
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020125,
					"content": "#Hmm ... {F#Reisende}{M#Reisender}, Yousuke hat mir bereits von deinen Taten berichtet und ich halte dich für eine ... überaus zuverlässige Person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020126
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020126,
					"content": "Wenn es dir nichts ausmacht, würdest du mir dann einen Gefallen tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020127
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020127,
					"content": "Ich suche derzeit nach einem verlässlichen Zulieferer für Champignons und ich habe hier mehrere Händler getroffen, die dafür infrage kämen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020128
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020128,
					"content": "Doch die Champignons, die sie mir zeigen, sind allesamt speziell ausgewählte Ausstellungswaren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020129
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020129,
					"content": "Um mir ein besseres Bild von der Qualität ihres Angebots zu machen, halte ich es für notwendig, zu ihren Anbaugebieten zu reisen und die Qualität ihrer Champignons direkt in Augenschein zu nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020130
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020130,
					"content": "Aber wie du ja sehen kannst, habe ich keinerlei Erfahrungen mit Inspektionen in der Wildnis. Sollte ich mich alleine in den Wald wagen, dann steht zu befürchten, dass ich es nicht lebend zurückschaffe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020131
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020131,
					"content": "Daher möchte ich dich darum bitten, in den Wald zu gehen und einige Champignons für mich zu sammeln. Wie hört sich das für dich an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020132,
						230020133
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020132,
					"content": "Das ist kein Problem für mich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020134
					]
				},
				{
					"id": 230020134,
					"content": "Du bist also wirklich dazu bereit? Fantastisch! Über die Bezahlung musst du dir keine Gedanken machen, ich habe bereits alles vorbereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020135
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020135,
					"content": "Schau mal hier, ja genau, diese Schriftstücke. Es handelt sich um einen Auftragsvertrag und dann ist da noch eine Lohnaufstellung sowie eine Auskunfts- und eine Vertraulichkeitsvereinbarung. Ah richtig, und außerdem noch die Karte für das Anbaugebiet der Champignons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020136
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020136,
					"content": "Nachdem du alle Dokumente mit Hanbei im Detail durchgegangen bist, fühlst du dich völlig erschöpft ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230020137
					]
				},
				{
					"id": 230020137,
					"content": "Sehr gut, damit sollte dir nun alles klar sein. Ich werde zunächst einen Bericht an das Bakufu senden und sobald ich die Genehmigung dazu bekommen habe, werden wir das Ganze offiziell machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020138
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020138,
					"content": "Doch bis dahin werde ich deinen Lohn aus eigener Tasche zahlen. Denn die Sache mit den Champignons duldet keinen Aufschub.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020139
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020139,
					"content": "Und natürlich werde ich das auch dem Bakufu melden. Schließlich musst du dein Einkommen ja auch versteuern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020140
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020140,
					"content": "Ich ... Ich geh dann erstmal die Champignons sammeln!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020141
					]
				},
				{
					"id": 230020141,
					"content": "Oh? Ah ... Na dann will ich dich nicht länger aufhalten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020142
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020142,
					"content": "Hoffentlich geraten wir hierbei nicht wieder in irgendwelche Schwierigkeiten, Paimon macht sich wirklich Sorgen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020143,
						230020145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020143,
					"content": "Ich bin extra hier, um ihn im Auge zu behalten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020144
					]
				},
				{
					"id": 230020144,
					"content": "Echt? Na gut, dann ergibt das alles einen Sinn ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020147,
					"content": "Hm? Warum schaust du mich an, als ob du mir nicht vertrauen würdest ... Du brauchst dir keine Sorgen zu machen. Ich habe alles mit großer Sorgfalt vorbereitet. Du wirst während des Prozesses auf keinerlei Probleme stoßen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020148
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020148,
					"content": "Wir reden doch nicht von dieser Art an Problemen ... *seufz* Wie auch immer, lass uns einfach in den Wald gehen und die Champignons sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020145,
					"content": "Ich frage mich, welchen Ärger er dieses Mal verursachen wird.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020146
					]
				},
				{
					"id": 230020146,
					"content": "He! Sollte es dabei wirklich neuen Ärger geben, dann gibt es hier niemanden, den wir um Hilfe bitten können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020133,
					"content": "Aber zunächst sollten wir die Bezahlung besprechen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020134
					]
				},
				{
					"id": 230020112,
					"content": "Das hier ist Paimon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020113
					]
				},
				{
					"id": 230020113,
					"content": "Paimon heißt Paimon und nicht ein „kleines fliegendes Ding“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020107,
					"content": "Er ist wohl für den Handel mit Champignons hierhergekommen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020108
					]
				},
				{
					"id": 230020104,
					"content": "Toranosuke und Yousuke hatten ihn erwähnt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020105
					]
				}
			]
		},
