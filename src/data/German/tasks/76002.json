			"dialogs": [
				{
					"id": 760020101,
					"content": "Oh, Blondschopf! Du kommst genau richtig. Du hast wohl gerade nichts zu tun, was? Willst du mir zur Hand gehen? Ich verspreche dir, dass es sich für dich lohnt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020102
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020102,
					"content": "#Ich meine, was zum Geier ... Krieg was auf die Mütze und hol dann Verstärkung? Das kann ich auch! Jo, {M#Jungchen}{F#Mädel}, hör mal, hilf mir dabei, diesem Taugenichts ’ne Lektion zu erteilen. Als Belohnung winkt ’ne Menge Mora, ich teil mit euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020103
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020103,
					"content": "W... Was?! Wir sind doch nur auf der Durchreise ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
