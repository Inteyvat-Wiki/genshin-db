			"dialogs": [
				{
					"id": 760020701,
					"content": "Hehe, wie sie laufen! Echt mal, diese Schatzräuber wollten allen Ernstes, dass wir die Drecksarbeit für sie erledigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020702,
						760020704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020702,
					"content": "Ein weiterer Beweis dafür, dass das Böse niemals über das Gute siegen wird!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760020703
					]
				},
				{
					"id": 760020703,
					"content": "Aber sowas von! Apropos, was hatten die eigentlich gestohlen? Paimon platzt vor Neugier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020707
