					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020704,
					"content": "Also gut, das gehört dann wohl jetzt alles uns ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760020705
					]
				},
				{
					"id": 760020705,
					"content": "Genau. Alles für uns! Als ob wir mit denen geteilt hätten ... Warte, das klingt irgendwie nicht richtig, wir sind schließlich rechtschaffene Abenteurer ... stimmt doch, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020706,
					"content": "Aber apropos, was hatten die eigentlich gestohlen? Jetzt ist Paimon schon neugierig!",
					"roleType": "TALK_ROLE_NPC",
