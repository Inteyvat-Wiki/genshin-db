			"dialogs": [
				{
					"id": 760020501,
					"content": "Ha! Das wäre erledigt. Dieser ausländische Schwätzer und sein Geschwätz über „in Flammen aufgehen“ ... so eingefroren ist wohl nichts mehr mit Flammen, was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020502
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020502,
					"content": "Da... Das sollte doch ausreichen, um den illegalen Warentransport nach Nasha zu unterbinden, oder? Oh ja, vergiss ja nicht unsere Belohnung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020503,
					"content": "Na, na, na, nicht so schnell. Ich will erstmal die Waren überprüfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020504
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020504,
					"content": "Was? Überprüfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020505,
					"content": "Ja, was denn sonst? Wenn irgendetwas schiefgeht ... Dann können wir uns unsere Belohnung abschminken, ganz zu schweigen von eurem Anteil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020506
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020506,
					"content": "Tss ... Diese Kratzer und sogar Rost! Die beim Fleuve Cendré werden wirklich immer nachlässiger ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020507
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020507,
					"content": "Oh, ein Uhrwerk-Mecha aus Fontaine! Aber wenn Paimon ihn sich so ansieht, dann ist die Technik von Fontaine echt der Hammer. Er kann sich immer noch bewegen, obwohl er den ganzen Weg hierhergebracht wurde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020508,
					"content": "Bewegen? Diesem Schrotthaufen hätte schon lange der Saft ausgehen sollen, wie kann es sein, dass ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020509
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020509,
					"content": "„Warnung! Startmodus <color=#FF5E41FF>fehlerhaft</color>. Energiemodul <color=#FF5E41FF>fehl... fehl... fehlerhaft</color>. Überprüfung fehlgeschlagen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020510
					],
					"speakerTitle": "„Fräulein Belleville“"
				},
				{
					"id": 760020510,
					"content": "„Überprüfung fehlgeschlagen. <color=#FF5E41FF>Überprüfung fehlgeschlagen</color>. <color=#FF5E41FF>Überprüfung fehlgeschlagen</color>. <color=#FF5E41FF>Auslöschen</color>. <color=#FF5E41FF>Auslöschen</color>. <color=#FF5E41FF>Auslöschen</color>. <color=#FF5E41FF>Auslöschen, Auslöschen, Auslöschen</color> ...“",
