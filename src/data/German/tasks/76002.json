			"dialogs": [
				{
					"id": 760020301,
					"content": "Puh ... das wäre erledigt! Diese Waschlappen kennen echt keinen Respekt. Die wollten sich doch tatsächlich mit uns anzulegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020302
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020302,
					"content": "Vielen Dank für eure Hilfe. Sobald meine Jungs „Fräulein Belleville“ sicher nach Nasha gebracht haben, bekommt ihr auch euren Anteil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020303
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020303,
					"content": "Ja, die Belohnung ... Moment, Fräulein Belleville? Seid ihr etwa Menschenhändler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020304,
					"content": "Haha, keine Sorge, junge Dame. Mit sowas haben wir nichts am Hut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020305
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020305,
					"content": "Nein, diese Blechkiste dort heißt „Fräulein Belleville“. Es war eine ganze Menge Arbeit, sie den weiten Weg vom Fleuve Cendré hierher zu bringen. Wenn jemand sie uns geraubt hätte, hätten wir wohl ziemlich dumm aus der Wäsche geschaut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020306
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020306,
					"content": "Oh, ein Uhrwerk-Mecha aus Fontaine! Aber wenn Paimon ihn sich so ansieht, dann ist die Technik von Fontaine echt der Hammer. Er kann sich immer noch bewegen, obwohl er den ganzen Weg hierhergebracht wurde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020307,
					"content": "Kleines Fräulein, du willst mich doch wohl vergackeiern. Diesem Schrotthaufen ist schon lange der Saft ausgegangen, wie sollte er ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020308
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020308,
					"content": "„Warnung! Startmodus <color=#FF5E41FF>fehlerhaft</color>. Energiemodul <color=#FF5E41FF>fehl... fehl... fehlerhaft</color>. Überprüfung fehlgeschlagen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020309
					],
					"speakerTitle": "„Fräulein Belleville“"
				},
				{
					"id": 760020309,
					"content": "„Überprüfung fehlgeschlagen. <color=#FF5E41FF>Überprüfung fehlgeschlagen</color>. <color=#FF5E41FF>Überprüfung fehlgeschlagen</color>. <color=#FF5E41FF>Auslöschen</color>. <color=#FF5E41FF>Auslöschen</color>. <color=#FF5E41FF>Auslöschen</color>. <color=#FF5E41FF>Auslöschen, Auslöschen, Auslöschen</color> ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020310
					],
					"speakerTitle": "„Fräulein Belleville“"
				},
				{
					"id": 760020310,
					"content": "#Aaah! {NICKNAME}, Vorsicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
