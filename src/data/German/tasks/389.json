						3890302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3890302,
					"content": "Der Weg ist blockiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890303
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890303,
					"content": "Hmm ... seht mal <color=#00E1FFFF>da oben</color>! Ist das nicht ein <color=#00E1FFFF>großes Loch</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3890304,
					"content": "Wir müssten das <color=#00E1FFFF>Windfeld</color> dort nutzen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890305
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890305,
					"content": "Gut, dann gehen wir darüber hinein. Auf geht’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890306
					],
					"speakerTitle": "Paimon"
				},
				{
