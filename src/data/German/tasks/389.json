			"dialogs": [
				{
					"id": 3890601,
					"content": "Wir kommen hier nicht weiter. In diesen Ruinen gibt es anscheinend uralte <color=#00E1FFFF>Siegel</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890602,
					"content": "Ist das Dvalins Werk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3890603,
					"content": "Nein, diese Ruinen waren einst eine antike Stadt. Dvalin hat sich hier nur vorübergehend niedergelassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890604
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890604,
					"content": "Diese Ruinen sind sogar noch älter als die Vier Winde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890605
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890605,
					"content": "In Mondstadt gibt es zwar keinen Alleinherrscher. Aber vor seiner Gründung war das anders ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890606
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890606,
					"content": "Ein schrecklicher Tyrann herrschte über diesen Ort ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890607,
					"content": "Aber gut ... Ich werde euch bei Gelegenheit die Geschichte dieses Tyrannen vorspielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890608,
					"content": "Dieses Siegel ... Wenn mich mein Wissen über Archäologie nicht täuscht, ist dies hier ein sogenannter <color=#00E1FFFF>„Lichtleiter“</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890609
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3890609,
					"content": "Wenn wir die verlorenen <color=#00E1FFFF>Einzelteile</color> wieder an der <color=#00E1FFFF>Vorrichtung</color> befestigen, sollten wir die <color=#00E1FFFF>Lichtleitzeremonie</color> durchführen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890610
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3890610,
					"content": "Diese Vorrichtung sollte bald so weit sein, dass man mit ihr die Lichtleitzeremonie durchführen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890611
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3890611,
					"content": "Fügen wir das <color=#00E1FFFF>letzte Teil</color> hinzu und sehen, was passiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		}
	]
