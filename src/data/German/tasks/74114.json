			},
			"dialogs": [
				{
					"id": 741140201,
					"content": "Ach, der Film wird doch nicht nass, oder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140202
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140202,
					"content": "Mach dir keine Sorgen, Frau Qiu. Die Kiste ist so stabil, dass kein Wasser eindringen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140203
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140203,
					"content": "Ein Glück, dass unsere Filmkamera nicht ins Wasser gefallen ist, sonst hätten wir endgültig einpacken können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingye"
				}
			]
		},
