			"dialogs": [
				{
					"id": 741140101,
					"content": "Es ist in Ordnung, unsere Kiste ist wasserdicht. Jetzt müssen wir nur noch hinuntertauchen und die Kiste herausholen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140102
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140102,
					"content": "Frau Qiu, aber keiner von uns dreien kann tauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140103
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140103,
					"content": "Natürlich kann ich schwimmen, aber vom Tauchen habe ich wirklich keine Ahnung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140104
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140104,
					"content": "Hängt die Mission, die wir letztens bei der Abenteurergilde in Auftrag gegeben haben, noch an der Missionstafel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140105
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140105,
					"content": "Frau Qiu, du hast uns doch gesagt, dass wir uns so schnell wie möglich auf den Weg machen sollen, um diese Mission abzusagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140106
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140106,
					"content": "Wir haben das doch gestern erst erledigt. Und die Abenteurergilde hat uns gesagt, dass sie uns heute die im Voraus für die Mission gezahlte Gebühr zurückerstatten wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140107
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140107,
					"content": "Hm ... Wird eine zusätzliche Gebühr fällig, wenn wir die Mission erneut bekannt machen wollen ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140108,
						741140109
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140108,
					"content": "Seid ihr immer noch am „Filmen“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				},
				{
					"id": 741140110,
					"content": "#{M#Abenteurer}{F#Abenteurerin} ... {NICKNAME}, du bist wirklich eine große Hilfe für uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140111
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140111,
					"content": "Kannst du tauchen? Oder kannst du einen Taucher finden, der uns helfen könnte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140112
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140112,
					"content": "Wollt Ihr ... unter Wasser gehen und einen Film drehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140113
					]
				},
				{
					"id": 741140113,
					"content": "Wir haben nicht die Fähigkeiten und können uns keine wasserdichte Filmausrüstung leisten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140114
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140114,
					"content": "Kurz gesagt, liegt es einfach daran, dass die Schachtel, in der wir den Film hatten, ins Wasser gefallen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140115
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140115,
					"content": "#Na ja, ihr zwei könnt aufhören mit dem Quatsch! {NICKNAME}, ich bitte dich um deine Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140116
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140116,
					"content": "Wie beim letzten Mal werde ich dich persönlich bezahlen. Keine Sorge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140109,
					"content": "Was macht ihr hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				}
			]
		},
