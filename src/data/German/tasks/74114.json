			"dialogs": [
				{
					"id": 741140401,
					"content": "Dieser Topf ist wirklich seltsam, Hm ... aber die Verwendung sollte die gleiche sein wie die in Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140402
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140402,
					"content": "Frau Qiu, ich habe das Gemüse gekauft, aber in dem Laden waren Marcotten ausverkauft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140403
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140403,
					"content": "Und ich habe auf die Schnelle keinen anderen Laden gefunden, der sie auf Lager hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140404
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140404,
					"content": "#Es fehlt ... nur diese eine Zutat. Ähm, {NICKNAME} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140405,
						741140406
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140405,
					"content": "Ich werde gehen und etwas davon zurückholen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				},
				{
					"id": 741140407,
					"content": "Ich danke dir für deine Hilfe. Sei beruhigt, ich kenne die Gepflogenheiten der Abenteurer und werde dich niemals umsonst gehen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140406,
					"content": "Es ist in der Vergütung inbegriffen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				}
			]
		},
