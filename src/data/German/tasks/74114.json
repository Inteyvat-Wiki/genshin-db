			},
			"dialogs": [
				{
					"id": 741140301,
					"content": "#Oh, du bist toll, {NICKNAME}. Auf dich ist Verlass!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140302
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140302,
					"content": "Hättest du uns nicht geholfen, wäre die ganze Kiste mit den Filmen kaputt gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140303
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140303,
					"content": "Als Erstes müssen wir zurück in die Stadt und diese Filme Herrn Geisert übergeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140304
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140304,
					"content": "#Und dann ... werden wir unterwegs etwas essen gehen. {NICKNAME}, wenn du Interesse hast, komm doch auch mit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140305
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140305,
					"content": "Ich werde dir nach dem Essen die Vergütung bezahlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140306,
						741140307
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140306,
					"content": "Sehr gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				},
				{
					"id": 741140308,
					"content": "Dann ist es entschieden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140309
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140309,
					"content": "Yifeng, du bringst später diese Kiste mit dem Film zu Herrn Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140310
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140310,
					"content": "Xingye, geh mal los, um hier in der Umgebung gutes Gemüse zu kaufen. Ich habe mir vor Kurzem das Rezept für die Poisson-Suppe genauer angesehen und möchte heute Herrn Geisert eine Kostprobe meiner Kochkunst geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140311
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140311,
					"content": "Frau Qiu, wir sind alle zum Essen ins Gasthaus gegangen. Warum musst du es unbedingt selber machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140312
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140312,
					"content": "Es ist etwas ... sparsamer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140313
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140313,
					"content": "So! Es ist alles geklärt, brechen wir auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140314
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140314,
					"content": "#{NICKNAME}, du folgst mir einfach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140307,
					"content": "Ich bin sowieso hungrig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				}
			]
		},
