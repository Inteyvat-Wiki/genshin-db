			},
			"dialogs": [
				{
					"id": 741140601,
					"content": "#{NICKNAME}, ich möchte dir hier den Experten für Film, Herrn Geisert, vorstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140602
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140602,
					"content": "#Herr Geisert, das ist {NICKNAME}, {F#eine sehr talentierte Abenteurerin}{M#ein sehr talentierter Abenteurer}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140603
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140603,
					"content": "#Wenn du in Zukunft einen Kampfsportfilm drehen willst, wird {NICKNAME} als {F#Hauptdarstellerin}{M#Hauptdarsteller} die erste Wahl sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140604
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140604,
					"content": "Haha, Frau Qiu übertreibt, ich bin kein Filmexperte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140605
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140605,
					"content": "Ich kenne mich nur ein bisschen mit dem Einsatz von Licht und Schatten im Film aus. Das ist alles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140606
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140606,
					"content": "Oh, du bist zu bescheiden. Das Licht und die Schatten in deinen Filmen sind so gut, dass sie fast sprechen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140607,
						741140609
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140607,
					"content": "Auf welche Art und Weise werden Licht und Schatten in den Filmen eingesetzt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140608
					]
				},
				{
					"id": 741140608,
					"content": "Ja. In meiner Filmtheorie entspricht der Einsatz von Licht und Schatten dem Einsatz von Emotionen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140611,
					"content": "Aber ... wie soll ich sagen, in Fontaines Filmwelt wird meine Theorie momentan noch nicht ernst genommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140612
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140612,
					"content": "Von der Mehrzahl der Regisseure werden immer noch die direkte Handlung oder Szenen bevorzugt, um die Filmhandlung auszudrücken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140613
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140613,
					"content": "Ich habe mehrere Filme gedreht, bei denen nur durch den Wechsel von Licht- und Schattenbildern erzählt wird, und kaum jemand hat sich dafür interessiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140614
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140614,
					"content": "Aber jetzt hält endlich eine Regisseurin meine Theorie von Licht und Schatten für sinnvoll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140615
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140615,
					"content": "Eine Regisseurin? Ich? Hahaha, mach keine Witze, ich war früher nur eine Teeverkäuferin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140616
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140616,
					"content": "Wer sagt denn, dass eine Teeverkäuferin keine Regisseurin sein kann? Ich war früher auch nur ein Journalist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140617
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140617,
					"content": "Journalist ... Du warst bestimmt also schon vorher gut darin, Geschichten zu schreiben? Du weißt schon, solche Geschichten, die in der Zeitung stehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140618
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140618,
					"content": "Mehr oder weniger, warum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140619
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140619,
					"content": "Na ... eben deshalb ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140620
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140620,
					"content": "Ah! Kein Problem! Kein Problem! In Zukunft werden wir noch sehr viele Gelegenheiten für eine Zusammenarbeit haben, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140621
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 741140621,
					"content": "Unter dem heiteren Lachen von Frau Qiu nehmen alle ihre Plätze ein.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741140622
					]
				},
				{
					"id": 741140622,
					"content": "Als das Essen beendet ist, nimmt Frau Qiu eine Extraportion, packt sie ein und steckt sie in deine Tasche ...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741140609,
					"content": "Sind Licht und Schatten im Film denn wichtig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140610
					]
				},
				{
					"id": 741140610,
					"content": "Selbstverständlich. In meiner Filmtheorie sind Licht und Schatten wichtige Mittel, um die Emotionen in einer Szene auszudrücken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "Geisert"
				}
			]
		},
