					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752520601,
					"content": "Ach, du bist doch der Typ vom Taverne-Empfang, oder? Wir sind uns schon mal begegnet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520602
					]
				},
				{
					"id": 752520602,
					"content": "Ach so? Kein Wunder, dass dein Gesicht mir irgendwie bekannt vorkam. Aber ich treffe am Tag so viele Leute, da kann ich mir nicht alles merken ... Ist sowieso nicht wichtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525207,
			"completionStepIds": [
				7525205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
