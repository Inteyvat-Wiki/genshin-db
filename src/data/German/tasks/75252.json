			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752520701,
					"content": "Viel wichtiger ist: Hast du hier irgendwo einen Glatzkopf gesehen? Ich müsste was mit dem klären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520702,
						752520703
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520702,
					"content": "Den suche ich auch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520704
					]
				},
				{
					"id": 752520704,
					"content": "Ach so? Der war gerade hier? Sieht so aus, als wäre er schon abgehauen ... Wahrscheinlich hat er Wind davon bekommen, dass ich hinter ihm her bin, hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520709
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520709,
					"content": "Hmpf, Icahua ... Du entkommst mir nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520706,
					"content": "Weil es ja wohl eine Art Schicksal ist, dass wir uns begegnet sind, hier ein Tipp: Halt dich lieber von dem Kerl und von mir fern. Sonst landet dein hübsches Gesicht schneller voller roter und weißer Flecken, als dir lieb ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520707
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520707,
					"content": "Ach ja, das hier habe ich in dem Lager gefunden. Sieht aus, als wäre das alles, was er bei seiner Flucht nicht mehr mitnehmen konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520708
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520708,
					"content": "Hier, schenke ich dir. Keine Scheu, das sind jetzt sowieso meine Sachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520710
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520710,
					"content": "Sein Leben gehört sowieso bald mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520703,
					"content": "Ich habe keinen gesehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520705
					]
				},
				{
					"id": 752520705,
					"content": "Du veralberst mich doch nicht, oder? Na gut, ich glaube dir erst mal, bei so einem ehrlichen Gesicht wie deinem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "Tecuhtli"
				}
			]
		}
	]
