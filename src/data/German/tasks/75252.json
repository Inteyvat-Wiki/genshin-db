						752520104
					]
				},
				{
					"id": 752520104,
					"content": "Danke, ich habe gerade viel um die Ohren. Bitte steh mir hier nicht im Weg herum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520110
					],
					"speakerTitle": "Icahua"
				},
				{
