			"dialogs": [
				{
					"id": 761120101,
					"content": "Hallo! Das hier haben wir von Maite. Sie meinte, wir sollten ihren Namen erwähnen, dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761120102,
						761120105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761120102,
					"content": "... Gingen Essen und Getränke aufs Haus!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761120103
					]
				},
				{
					"id": 761120103,
					"content": "... Oh? Das hat Maite gesagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761120104
					],
					"speakerTitle": "Katya"
				},
				{
					"id": 761120104,
					"content": "#{NICKNAME}! Nein, das hat sie nicht gesagt! Sie meinte nur, dass Katya ... äh, also ... dass sie uns vielleicht ein Getränk spendiert, wenn sie gut gelaunt ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761120106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761120106,
					"content": "Ihr seid Freunde von Maite! Na, dann habt ihr Glück. Die Getränke gehen heute auf mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761120107
					],
					"speakerTitle": "Katya"
				},
				{
					"id": 761120107,
					"content": "Achtet bitte auf sie, wenn ihr könnt. Ihr seid auch jederzeit willkommen, im „Speranza“ zu speisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katya"
				},
				{
					"id": 761120105,
					"content": "... Würde Katya uns ein Getränk oder so ausgeben, wenn sie gute Laune hat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761120106
					]
				}
