					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630513,
					"content": "*weint* Du bist so ein Lügner! Das war voll gemein von dir! Eine Schande für den Ritterorden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630514
					],
					"speakerTitle": "Paimon"
				},
				{
