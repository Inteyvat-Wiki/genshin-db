					"nextDialogs": [
						4630529,
						4630530
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630531,
					"content": "Was für ein schöner Tag heute! Nun gut, ich muss noch einen Verdächtigen verhören ...",
