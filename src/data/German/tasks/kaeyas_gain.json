					"content": "Den Schatz gibt es also nicht wirklich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630513
					]
				},
				{
					"id": 4630512,
					"content": "Ich wurde also angelogen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630513
					]
				},
				{
					"id": 4630509,
					"content": "Wenn die beiden die <color=#00E1FFFF>falschen Informationen</color> nicht überall verbreitet hätten, wäre das alles nicht so einfach geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
