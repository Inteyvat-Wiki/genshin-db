					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630529,
					"content": "Ihr habt Paimon völlig im Griff.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630531
					]
				},
				{
					"id": 4630530,
					"content": "Das heißt, Ihr werdet das nächste Mal eine andere Methode verwenden?",
