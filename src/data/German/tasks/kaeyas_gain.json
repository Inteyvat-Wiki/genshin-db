					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630517,
					"content": "Ah! Das ... Ihr ... Hmpf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630518,
					"content": "#{NICKNAME}, gehen wir! Sowas müssen wir uns nicht bieten lassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630519,
					"content": "Haha, eine Sekunde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630520
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630520,
					"content": "Ihr beiden habt mir wirklich einen großen Gefallen getan. Ein Dankeschön ist da mehr als angebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630521
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630521,
					"content": "Dieses Schwert ist bekannt unter dem Namen „Sieg verheißendes Schwert der Morgendämmerung“ und steht, wie sein Name andeutet, für Sieg und Licht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630533
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630533,
					"content": "Wenn es den Herrschaften recht ist, überreiche ich euch hiermit das Schwert der Dämmerung zum Dank für eure Taten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630522
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630522,
					"content": "„Schwert der Dämmerung“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630523,
					"content": "Ganz genau. Eine so verständnisvolle und kluge Dame wie du, Paimon, sollte diesem Geschenk nicht abgeneigt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630524
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630524,
					"content": "Na ja ... Wenn das Dankeschön dieses Schwert der Dämmerung ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630525,
					"content": "Ihr würdet mir doch verzeihen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630526
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630526,
					"content": "Es ehrt mich, so nette und verständnisvolle Freunde wie euch zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630527
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630527,
					"content": "Ja ... vollkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
