				"points": []
			},
			"dialogs": [
				{
					"id": 4630101,
					"content": "Das hier sind also die Ruinen von Arcadia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630102,
					"content": "Sieht mir irgendwie ... zu einfach aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630103,
					"content": "Ach ich weiß. Je normaler etwas aussieht, desto weniger achtet man darauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630104,
					"content": "Nicht übel, Kaeyas Opa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630105,
					"content": "*raschel*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630106
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630106,
					"content": "Hm? Was ist das, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630107
					]
				},
				{
					"id": 4630107,
					"content": "Eine Maus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630108,
					"content": "Hast du überhaupt richtig hingehört?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630109
					]
				},
				{
					"id": 4630109,
					"content": "Sei nicht so ein Angsthase. Es wird schon nichts sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630110,
					"content": "Wir müssen jetzt schnell sein. Drinnen warten ein Schatz auf uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 46303,
			"completionStepIds": [
				46303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46303",
							"2"
