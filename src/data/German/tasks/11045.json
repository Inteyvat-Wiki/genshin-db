			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450101,
					"content": "Ich könnte mir vorstellen, dass du auf deinen Reisen so einigen Rätseln begegnet bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450102
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450102,
					"content": "Ich würde deine Intelligenz gerne mithilfe eines praktischen Tests deiner Kapazitäten austesten. Ungefähr so, wie wir das auch beim körperlichen Test gemacht haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450103,
						110450104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450103,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				},
				{
					"id": 110450105,
					"content": "Ich möchte, dass ihr diese Ruine erkundet und mit eurer Antwort zurückkehrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450106,
					"content": "Am anderen Ende der Ruine findet ihr zwei Rätsel. Wenn ihr sie gelöst habt, solltet ihr die Vorrichtung im Zentrum aktivieren können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450107,
					"content": "Wie beim körperlichen Test, sind euch auch hier keine Grenzen gesetzt. Was auch immer ihr tut, ist etwas, das ich beobachten möchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450108,
						110450110
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450108,
					"content": "Ich werde langsam richtig gut in dieser Sache.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450109
					]
				},
				{
					"id": 110450109,
					"content": "#{F#Eine}{M#Ein} {F#erfahrene}{M#erfahrener} {F#Abenteurerin}{M#Abenteurer}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450112,
					"content": "Dann legen wir mal los. Fangt einfach irgendwo an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450110,
					"content": "Wo ein Wille ist, ist auch ein Weg.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450111
					]
				},
				{
					"id": 110450111,
					"content": "Denk daran, dass wir hier deine Intelligenz testen. Glück hat mit der Sache nichts zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450104,
					"content": "Würde ein schriftlicher Test nicht reichen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				}
			]
		},
		{
			"id": 1104504,
			"completionStepIds": [
				1104504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104504",
							"2"
						],
						"stepId": 1104504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450461,
					"content": "Was ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450462,
						110450463
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450462,
					"content": "Unbekannte Zeichen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				},
				{
					"id": 110450401,
					"content": "Soweit ich weiß gehören die zu einer Art Schrift. Man findet sie in ganz Teyvat, aber ihre Geheimnisse behalten sie für sich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450402
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450402,
					"content": "Über sie gibt es noch unheimlich viel herauszufinden, schon alleine, wie sie hierhergekommen sind ... ist ein Rätsel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450403
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450403,
					"content": "Ich fertige eine Kopie an. Nachdem wir unsere Forschung beendet haben, werde ich mir die Zeit nehmen und sie genauer untersuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450404
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450404,
					"content": "*seufz* Noch etwas für die Liste der Dinge, die wir nicht verstehen. Unlösbare Rätsel hier, seltsame Experimente da ... es wäre nett, zur Abwechslung mal ein tolles Ergebnis zu erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450405,
					"content": "Klingt so, als müsstest du den Preis bezahlen, wenn du die Belohnung haben willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450406,
					"content": "Ich habe wirklich viel durch das Ganze hier gelernt. Im Vergleich dazu ist die kleine Belohnung, die ich anbieten kann, nicht der Rede wert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450407
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450407,
					"content": "Ich laufe vor zum Lager. Wenn ihr dann eintrefft, habe ich vielleicht ein flüchtiges Wunder für euch, das ihr euch ansehen könnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450408,
						110450409
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450408,
					"content": "Bis gleich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450410,
					"content": "Paimon freut sich irgendwie darauf, die Ergebnisse der ganzen Mühen zu sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450411,
					"content": "Wenn dir nichts Besseres einfällt, sollten wir zum Lager zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450412,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450413,
					"content": "Nicht so schnell. Ich lasse euch nicht weg, solange ihr mir nicht beweist, dass ihr keine Gefahr seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450414
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450414,
					"content": "Wah! Du! Du hast den Berg nicht verlassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450415,
					"content": "Ganz bestimmt nicht. Und ich habe alles beobachtet, das ihr und Albedo gemacht habt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450416
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450416,
					"content": "Ich muss sagen, dass ihr ganz schön unvorsichtig geworden seid. Oder habt ihr euch von seiner ach so fesselnden Hypothese und seinem freundlichen Verhalten einlullen lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450417,
						110450418
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450417,
					"content": "Was meinst du damit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450419,
					"content": "Du nimmst Befehle von einem völlig Fremden entgegen, trinkst unbekannte Tränke, nimmst an den verschiedensten Experimenten teil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450420
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450420,
					"content": "Ich würde lieber glauben, dass du ausgetrickst wurdest, als dass du so naiv bist. Oder vielleicht ... steckt ihr schon von Anfang an unter einer Decke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450421
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450421,
					"content": "Hör zu, Schwester, du bist so übervorsichtig, dass es schon an Paranoia grenzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450422,
						110450423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450422,
					"content": "Ich habe ihm nur bei seiner Forschung geholfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450424,
					"content": "Es ist egal, was du denkst. Du weißt nichts über ihn, er könne für dich ein Heiliger sein. Aber ich kenne ihn ein bisschen besser als du.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450425
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450425,
					"content": "Ich will nur eines wissen: Hat dich seine Alchimie in etwas Böses verwandelt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450426
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450426,
					"content": "Sicher nicht! Paimon hätte das gespürt! Außerdem hat er nicht einmal Alchimie eingesetzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450427,
					"content": "Bei einem Alchimisten seiner Größe würdest du nicht das Geringste spüren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450428
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450428,
					"content": "Auf jeden Fall werde ich eine potenzielle Gefahr nicht nach Mondstadt zurückkehren lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450429
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450429,
					"content": "Also, was wirst du tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450430,
					"content": "Du bist hergekommen, um dich zu versichern. Dann tu, was du tun musst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450431
					]
				},
				{
					"id": 110450431,
					"content": "Das muss ich dir lassen, du bist manchmal gar nicht so dumm. Wenn ich sicher sein kann, dass nichts, mit dem du Kontakt hattest, gefährlich ist, reicht mir das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450432
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450432,
					"content": "Ich habe alles untersucht. Fehlen nur noch diese Zeichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450433
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450433,
					"content": "Aber wir wissen nicht einmal, was sie bedeuten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450451
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450451,
					"content": "Das mag schon stimmen, von dem einmal abgesehen, dass ... Hmm. Anscheinend sind es ganz gewöhnliche Schriftzeichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450452
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450452,
					"content": "Ich fertige aber zur Sicherheit eine Kopie an ... Hmm. Das ist jetzt ein Ort von Interesse, wir sollten eine Patrouille festlegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450434
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450434,
					"content": "Na gut. Alles in allem scheint ihr keine unmittelbare Bedrohung zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450435
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450435,
					"content": "Und ich hatte gehofft, dass das so sein wird. Ich wäre eine äußerst unglückliche Schwester, wenn ich wegen euch Überstunden machen hätte müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450436
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450436,
					"content": "... Überstunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450437,
					"content": "Bevor sich unsere Wege trennen, noch ein Wort des Rates. Vertraue Albedo nicht blind und wiederhole deine Fehler ab jetzt nicht mehr. Du hast heute eine Menge voreiliger Entscheidungen getroffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450439
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450439,
					"content": "Und weg war sie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450440,
					"content": "Die wenigsten Leute in Mondstadt sind so wie sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450441,
						110450442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450441,
					"content": "Vielleicht war sie nur unsicher.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450443,
					"content": "Pft. Schwamm drüber. Kehren wir zu Albedo zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450442,
					"content": "Vielleicht ist sie nur sehr empfindlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450423,
					"content": "Ich glaube nicht, dass er ein schlechter Mensch ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450418,
					"content": "Führt er etwas im Schilde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450409,
					"content": "(Ich gehe davon aus, dass ich den Intelligenztest bestanden habe.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450463,
					"content": "Ich habe das Gefühl, die schon irgendwo gesehen zu haben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				}
			]
		},
		{
			"id": 1104505,
			"completionStepIds": [
				1104505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104505",
							"2"
						],
						"stepId": 1104505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450501,
					"content": "Ihr seid wieder da! Und das gerade rechtzeitig, ich bin zu einem endgültigen Schluss gekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450502,
					"content": "Aber ihr habt ganz schön lange gebraucht. Wurdet ihr aufgehalten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450503,
						110450504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450503,
					"content": "Nicht wirklich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450506
					]
				},
				{
					"id": 110450506,
					"content": "Die Ergebnisse sind da. Wir haben heute unzählige Daten gesammelt, war ziemlich schwierig, die ganze Forschung in einem Zug abzuschließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450507
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450507,
					"content": "Aber im Wesentlichen kann ich den endgültigen Schluss ziehen ... dass du den Menschen dieser Welt sehr ähnlich bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450508,
						110450509
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450508,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450510
					]
				},
				{
					"id": 110450510,
					"content": "Und das Ganze hättest du nicht einfach nur sehen können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450511,
					"content": "Dafür haben wir uns den ganzen Tag geschunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450512,
					"content": "Ich verstehe, dass euch das alles irgendwie so vorkommt, als wäre es schon im Vornherein offensichtlich gewesen, aber tatsächlich sollte nichts in dieser Welt als selbstverständlich erachtet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450513
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450513,
					"content": "Ist euch je in den Sinn gekommen, dass die Welt von Teyvat Fremden gegenüber feindlich gesonnen sein könnte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450514,
						110450515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450514,
					"content": "Nur die Götter würden das wissen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450516
					]
				},
				{
					"id": 110450516,
					"content": "Ich habe die Naturgesetze dieser Welt erwähnt. Ihr könnt hier mit mir ohne Konsequenzen sprechen und alles scheint normal zu sein. Aber das ist vielleicht ein kleines Wunder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450517,
					"content": "Die einzige andere Lebensform, die wie du aus weiter Ferne kommt, ist dieser Samen, von dem ich gesprochen habe. Und aufgrund der Naturgesetze von Teyvat kann er nicht einmal sprießen, geschweige denn blühen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450518,
					"content": "Aber nach den ganzen Experimenten mit euch hatte ich eine andere Idee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450519
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450519,
					"content": "Dich zu imitieren, hat meiner Alchimie geholfen, und deshalb ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450520
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450520,
					"content": "Oooh! Sieht aus, als ... würde sich da was tun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450521,
					"content": "Der Übergang vom Nichts ins Dasein, vom Setzling zur Pflanze und jetzt zur Frucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450522
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450522,
					"content": "Nährt man nicht die Welt selbst, wenn man Leben einer anderen Welt nährt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450523
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450523,
					"content": "Aah ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450524,
						110450525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450524,
					"content": "Das war wunderschön.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450526
					]
				},
				{
					"id": 110450526,
					"content": "*seufz* Wir haben wohl unsere Grenze erreicht: eine unvergleichlich schöne Blume, die nur vorübergehend blüht. Der größte Erfolg des Lebens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450527
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450527,
					"content": "Paimon meint, dass sie mit unseren Bemühungen eigentlich ewig blühen hätte sollen. Und sie hat wohl nicht einmal Früchte getragen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450528,
					"content": "Das Leben ist ein Mosaik der verschiedensten Dinge. Es sollte nicht nach der Dauer bewertet werden. Selbst ein kurzes Aufblühen ist wertvoll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450529
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450529,
					"content": "Ein kurzes Leben muss nicht unbedingt schlecht sein. Ein perfektes und ertragreiches Leben ist eins, das die Bürde der Einsamkeit nicht trägt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450530
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450530,
					"content": "Versteht ihr nun, was ich vorhin gemeint habe? Als ich sagte, dass es ein kleines Wunder wäre, dass wir hier miteinander sprechen können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450531,
						110450532
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450531,
					"content": "Na ja, noch bin ich nicht verwelkt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
				{
					"id": 110450533,
					"content": "He? Ist dir eine Laus über die Leber gelaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450534,
					"content": "#Hehe, sei nicht traurig, {NICKNAME}. Paimon passt auf dich auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450535,
					"content": "Albedo, Paimon möchte wirklich deine Freundin sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450536,
					"content": "Habt Dank, ihr zwei. Selbst wenn man sein Leben auch in Einsamkeit verbringen kann, macht es gar nichts, wenn das nicht so ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450537
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450537,
					"content": "#{NICKNAME}, mit eurer Hilfe ist mir eingefallen, wie ich eine Blume zum Blühen bringe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450538
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450538,
					"content": "Bin ich also ein hilfreiches Exemplar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450539
					]
				},
				{
					"id": 110450539,
					"content": "Ich will damit sagen, dass die Zeit mit euch in den Bergen für mich von unschätzbarem Wert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450540
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450540,
					"content": "Sollte ich ... in Zukunft noch einmal Hilfe brauchen ... Kann ich wieder auf euch zählen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450541
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450541,
					"content": "Natürlich, auch wenn du nur Gesellschaft brauchst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450542
					]
				},
				{
					"id": 110450542,
					"content": "Vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450543
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450543,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450544
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450544,
					"content": "Ich habe die ganze Zeit über betont wie gewöhnlich ihre Ergebnisse wären ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450545
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450545,
					"content": "Aber was war das für ein Sediment, das sich am Boden der Phiole gesammelt hat? Das hätte sich nicht bilden sollen ... Was könnte das bedeuten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450546
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450546,
					"content": "Die aus der Erde Geborenen sind gebunden durch ihre Makel, aber diejenigen, die der Kreide entstammen, sind makellos ... Du und ich, wir sind uns ähnlich. Wir bestehen beide aus einer Substanz, die noch nicht ganz definiert wurde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450547
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450547,
					"content": "Sollte ich eines Tages die Kontrolle verlieren ... und Mondstadt zerstören ... alles zerstören ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450548
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450548,
					"content": "Kann ich mich darauf verlassen, dass du mich aufhalten wirst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450532,
					"content": "#(Ich frage mich, wie es {F#ihr}{M#ihm} geht ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
				{
					"id": 110450525,
					"content": "Wie schnell das vorbei war.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450526
					]
				},
				{
					"id": 110450515,
					"content": "Vielleicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450516
					]
				},
				{
					"id": 110450509,
					"content": "Das ist alles?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450510
					]
				},
				{
					"id": 110450504,
					"content": "Kann man so sagen. Und das sogar von einer Ordensschwester.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450505
					]
				},
				{
					"id": 110450505,
					"content": "Aha, ich würde mir nicht den Kopf zerbrechen, sie macht nur ihre Arbeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450506
					],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 1104506,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104505",
							"2"
						],
						"stepId": 1104505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450621,
					"content": "Tut mir leid, meine Forschung hat mir ziemliche Probleme bereitet. Viele der von mir gezogenen Rückschlüsse widersprechen den Daten aus den Experimenten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450622
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110450622,
					"content": "Dafür haben sich einige von Albedos intuitiven Folgerungen bestätigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450623
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110450623,
					"content": "Ich bin nur froh, dass wir ein paar Fortschritte gemacht haben, deshalb, ähm ... kein Grund, deprimiert zu sein! Albedo hat gemeint, ich hätte gute Arbeit geleistet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450624
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110450624,
					"content": "Wenn ihr die Ergebnisse genauer wissen wollt, solltet ihr mit ihm reden. Ich muss noch arbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		}
	]
}