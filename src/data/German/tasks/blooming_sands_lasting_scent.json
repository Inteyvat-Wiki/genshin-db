			"dialogs": [
				{
					"id": 230420801,
					"content": "#{F#Reisende}{M#Reisender}, was machst du da wieder? Hin- und herlaufend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420802
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420802,
					"content": "Übrigens, hast du in letzter Zeit etwas für Nermin getan? Oder ... hast du irgendwelche Gerüchte über sie gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420803
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420803,
					"content": "Ich habe immer das Gefühl, dass sie in letzter Zeit sehr beschäftigt ist, aber ich weiß nicht, was sie macht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420804,
						230420806
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420804,
					"content": "Sie ... Sie ist damit beschäftigt, Blumen zu pflanzen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420805
					]
				},
				{
					"id": 230420805,
					"content": "Ist das so? Aber ich habe auch nicht mehr Blumen in ihrem Haus gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420806,
					"content": "Sie ... Sie ist mit Kochen beschäftigt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420807
					]
				},
				{
					"id": 230420807,
					"content": "Hm? Könnte es sein, dass Hilmi und die anderen Nermin wieder gebeten haben, Minzbohnensuppe zu kochen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420808
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420808,
					"content": "Diese Kinder ... Ich muss mal ein Gespräch mit ihnen führen, wenn ich Zeit habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				}
			]
		},
