	"talks": [
		{
			"id": 2304201,
			"completionStepIds": [
				2304201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
