			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420101,
					"content": "Das wird Raef sicher überraschen ... Hehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420102
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420102,
					"content": "Was für eine Überraschung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420103
					]
				},
				{
					"id": 230420103,
					"content": "#Waah! Erschrecke mich doch nicht so, {F#Reisende}{M#Reisender}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420104
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420104,
					"content": "Ich bin doch von vorn gekommen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420105
					]
				},
				{
					"id": 230420105,
					"content": "Ich habe über etwas nachgedacht und habe dich gar nicht bemerkt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420106
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420106,
					"content": "#{F#Reisende}{M#Reisender}, darf ich dich etwas fragen? Hast du schon einmal etwas vom „Parfüm“ gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420107
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420107,
					"content": "Oma Jawahir hat mir erzählt, dass sie in ihrer Jugend ihr eigenes „Parfüm“ hergestellt hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420108
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420108,
					"content": "Der Duft von „Parfüm“ überdeckt nicht nur den Schweißgeruch, einige spezielle „Parfüms“ haben auch eine belebende Wirkung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420109
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420109,
					"content": "Raef arbeitet als Wächter am Eingang des Dorfs, schwitzt jeden Tag in der Hitze und sagt immer wieder, dass ihm von der Sonne schwindelig ist, wenn er zurückkommt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420110
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420110,
					"content": "Also dachte ich, ich stelle ihm eine Flasche „Minzparfüm“ als Geschenk her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420111
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420111,
					"content": "Oma Jawahir hat mir eine Anleitung für die Herstellung von Parfüm geschrieben und mir außerdem dabei geholfen, eine Menge Materialien einzukaufen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420112
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420112,
					"content": "Aber die Herstellung des Parfüms war überraschend knifflig ... Allein die heimliche Verarbeitung der einzelnen Materialien hat mich viel Zeit gekostet, und ich habe eine Reihe von gescheiterten Produkten hergestellt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420113
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420113,
					"content": "Wenn ich das noch länger hinauszögere, wird Raef herausfinden, dass ich ein Parfüm mache!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420114
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420114,
					"content": "#Also, {F#Reisende}{M#Reisender}, könntest du vielleicht ein paar Materialien für mich besorgen gehen? Es muss still und leise geschehen, ohne dass Raef es erfährt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420115,
						230420117
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420115,
					"content": "Du kannst es ihm ruhig sagen, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420116
					]
				},
				{
					"id": 230420116,
					"content": "Nein, nein, diese Überraschung habe ich schon so lange vorbereitet, ich darf es ihm nicht so einfach sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420119,
					"content": "Eigentlich gibt es nicht so viele Materialien, die du für mich besorgen musst. Gehe zu Herrn Azalai und hole die Ware, die ich bestellt habe, und bringe mir dann einen kleinen Eimer Wasser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420120
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420120,
					"content": "Denk daran, es muss unauffällig sein, und Raef darf es unter keinen Umständen mitbekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420117,
					"content": "*seufz* ... Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420118
					]
				},
				{
					"id": 230420118,
					"content": "Dann überlasse ich es dir! Keine Sorge, ich werde sicher eine Belohnung vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "Nermin"
				}
			]
		},
		{
			"id": 2304203,
			"completionStepIds": [
				2304202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304202",
							"2"
						],
						"stepId": 2304202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Azalai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420301,
					"content": "Willkommen, was kann ich für dich tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420302
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420302,
					"content": "Über Nermins „Waren“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420303
					]
				},
				{
					"id": 230420303,
					"content": "Aha ... Ich habe alles schon vorbereitet. Diese Gewürze sind von sehr guter Qualität und auch nicht zu teuer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420304
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420304,
					"content": "Nermin will aus diesen Gewürzen „Parfüm“ herstellen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420305
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420305,
					"content": "Ach, zwar ist es gut, voller Energie zu sein, aber Nermin muss immer noch auf ihren Körper achten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azalai"
				}
			]
		},
		{
			"id": 2304205,
			"completionStepIds": [
				2304205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304205",
							"2"
						],
						"stepId": 2304205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420501,
					"content": "Super! Ich habe noch ein paar Materialien von früher übrig, und mit denen, die du mitgebracht hast, kann ich noch ein paar Versuche machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420502
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420502,
					"content": "Puh ... Ich schaue mir die Notizen noch einmal an. Dieses Mal wird es klappen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420503
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420503,
					"content": "Ach ja, ich muss noch ein paar Blütenblätter pflücken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420504
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420504,
					"content": "Nermin beginnt, konzentriert an dem „Parfüm“ zu arbeiten ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230420505
					]
				},
				{
					"id": 230420505,
					"content": "Geschafft! Der Duft ist nicht schlecht ... und es ist auch nicht klebrig geworden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420506
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420506,
					"content": "Das kann als Erfolg betrachtet werden, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420507,
						230420508
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420507,
					"content": "Es fühlt sich an wie ein Erfolg.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420509
					]
				},
				{
					"id": 230420509,
					"content": "Ja! Ich habe sogar eine spezielle Flasche gekauft. Lass mich zuerst das Parfüm einfüllen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420510
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420510,
					"content": "#{F#Reisende}{M#Reisender}, lass uns zusammen zu Raef gehen und ihm das Parfüm geben. Ich hoffe, es wird ihm gefallen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420508,
					"content": "Zumindest ist es kein Misserfolg.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420509
					]
				}
			]
		},
		{
			"id": 2304206,
			"completionStepIds": [
				2304206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304206",
							"2"
						],
						"stepId": 2304206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raef",
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420601,
					"content": "#Nermin und {F#Reisende}{M#Reisender} ... Was führt euch hierher? Steckt ihr in irgendwelchen Schwierigkeiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420602
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420602,
					"content": "Mit der Blume ist doch nicht etwa etwas nicht in Ordnung, oder? Ich bin noch im Dienst, nach meiner Schicht werde ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420603
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420603,
					"content": "Nermin möchte dir etwas schenken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420604
					]
				},
				{
					"id": 230420604,
					"content": "Dieses „Parfüm“ schenke ich dir! Es duftet nach Minze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420605
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420605,
					"content": "Ich wollte eigentlich Zaytun-Pfirsich-Geruch herstellen, aber aus irgendeinem Grund wurde das Parfüm klebrig, sobald ich Zaytun-Pfirsich hinzugefügt habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420606
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420606,
					"content": "Danke ... Danke, aber wozu ist das „Parfüm“ gut? Zur Abwehr von Insekten? Oder ist es zum Markieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420607
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420607,
					"content": "Es soll dich auffrischen und den Geruch deines Schweißes überdecken. Wird dir nicht schwindelig, wenn du jeden Tag diesen schweren Schweiß riechst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420608
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420608,
					"content": "Man gewöhnt sich gut an den Geruch, und es ist etwas ungewohnt, wenn man ihn plötzlich nicht mehr riechen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420609
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420609,
					"content": "Dann nehme ich das „Parfüm“. Benutz es nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420610
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420610,
					"content": "He! Komm schon, ich mache nur Spaß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420611
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420611,
					"content": "Schnell, gib mir das Parfüm, mir dreht sich jetzt schon der Kopf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420612
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420612,
					"content": "Hier, schmier es dir einfach auf den Arm, das hat Oma Jawahir gesagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420613
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420613,
					"content": "Der Duft ist gut und wirklich erfrischend. Außerdem fühlt es sich beim Auftragen kühl und angenehm an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420614
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420614,
					"content": "Hehe, schließlich ist es das Geheimrezept von Oma Jawahir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420615
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420615,
					"content": "#Dank der Hilfe {F#der}{M#des} Reisenden konnte ich ein so gutes „Parfüm“ herstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420616
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420616,
					"content": "Das war doch nur ein kleines Gefallen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420617
					]
				},
				{
					"id": 230420617,
					"content": "Es tut mir wirklich leid, dass wir dich so oft genervt haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420618
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420618,
					"content": "Das ist für dich als Belohnung gedacht. Ich danke dir wirklich sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420619
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420619,
					"content": "Das „Parfüm“ ist wirklich sehr angenehm zu benutzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420620
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420620,
					"content": "Es ist nur so, dass ... äh ... Nermin, warum habe ich dort einen Ausschlag, wo ich das Parfüm aufgetragen habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				}
			]
		},
