					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420904,
					"content": "Halb so wild. Hast du die Materialien für mich besorgt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420905
					],
					"speakerTitle": "Nermin"
				},
				{
