			},
			"dialogs": [
				{
					"id": 190551701,
					"content": "Sie hatte ein Treffen mit Frau Miko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551702
					]
				},
				{
					"id": 190551702,
					"content": "Richtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551802
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551802,
					"content": "Es war in der Kanjou-Verwaltung. Bei ihrem Treffen mit Frau Miko handelte es sich offiziell um die Rezeption der kurzen Erzählungen. Tatsächlich ging es aber auch um andere Themen, auch wenn sie nicht öffentlich gemacht wurden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551803
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551803,
					"content": "Nachdem sie zurückkam, begannen wir mit Maßnahmen zur Förderung von Handel. In Narukami wurde auch ein neues Dienstleistungssteuer-Gesetz beschlossen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551804
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551804,
					"content": "Und was meint ihr? Weiß Ihre Exzellenz davon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				}
			]
		},
