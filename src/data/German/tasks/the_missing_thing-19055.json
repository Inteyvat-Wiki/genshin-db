			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tokuda",
					"Todoroki",
					"Masashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190551001,
					"content": "Todorokis Information war richtig, die Nobushi haben tatsächlich noch geschlafen, als wir ankamen, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551002
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551002,
					"content": "Wir haben sie all auf einmal eingefangen und alle Waren wurden konfisziert. Es ist alles da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551003
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551003,
					"content": "Lasst mich mal überprüfen ... Gut ... sieht gut aus. Danke für die harte Arbeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551004
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551004,
					"content": "Das ist nicht der Rede wert. Dank der Bemühungen deiner Karawane ist der Preis für Getreide im Dorf gesunken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551005
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551005,
					"content": "Das stimmt, und wir Verwundeten müssen uns auch bei dir bedanken. Wer hätte gedacht, dass die Wunden vom Schlachtfeld so viele Folgeerkrankungen verursachen können? Zum Glück haben wir die lebensrettende Medizin, die Todoroki mitgebracht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551006
					],
					"speakerTitle": "Masashi"
				},
				{
					"id": 190551006,
					"content": "Dank der Unterstützung von Sangonomiya ist die Situation besser geworden. Wie ist die Versorgungslage im Dorf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551007
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551007,
					"content": "Ich muss das heute Abend überprüfen. Wir müssen morgen früh gleich nach dem Treffen mit Herrn Gorou im Sangonomiya-Schrein loslegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551008
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551008,
					"content": "Keine Sorge, Todoroki. Wir haben eine Liste vorbereitet. Komm bitte mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masashi"
				}
			]
		},
