			"dialogs": [
				{
					"id": 190550901,
					"content": "Todoroki, die Waren sind eingetroffen. Bitte komm rüber und schau nach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550902
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190550902,
					"content": "Los geht’s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550903
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190550903,
					"content": "Todoroki ... ähm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 190550904,
					"content": "Pssst! Gib keinen Laut von dir, wir schleichen uns an und folgen ihnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shikanoin Heizou"
