				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gorou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190551601,
					"content": "#{NICKNAME}, ich entschuldige mich noch einmal bei dir. Es tut mir wirklich leid, dass ich dir nicht die Wahrheit gesagt habe, aber ich ... hatte keine andere Wahl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551602
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551602,
					"content": "Ich verstehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551603
					]
				},
				{
					"id": 190551603,
					"content": "Übrigens, weiß Kokomi davon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551604
					]
				},
				{
					"id": 190551604,
					"content": "Ihre Exzellenz ... Ich kann nur sagen, der Krieg hat viel Schlimmes gebracht und uns wiederum auch wachsen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551605
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551605,
					"content": "Bedeutet es, dass sie davon weiß oder nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 190551606,
					"content": "Äh ... Seid ihr nicht neugierig, wer dieses Warengesetz vorangetrieben hat? Es kann nicht die Kanjou-Verwaltung sein, weil das ihnen nichts Gutes tun würde. Außerdem haben wir bei der Verwaltung auch keine Kontakte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551607
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551607,
					"content": "Ja, wenn man es so ausdrückt, klingt es wie eine göttliche Hand, die euch plötzlich geholfen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 190551608,
					"content": "Haha, eine helfende göttliche Hand ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551609
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551609,
					"content": "Vor einiger Zeit wurde das Irodori-Fest in Narukami abgehalten. Ihre Exzellenz und ich wurden ebenfalls zur Teilnahme eingeladen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551610
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551610,
					"content": "Damals wartete ich gerade auf dem Markt und Ihre Exzellenz ging zum ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				}
			]
		},
