			"dialogs": [
				{
					"id": 738020101,
					"content": "Ad astra abyssosque! Zu den Sternen und Abgründen! Herzlich willkommen bei der Abenteurergilde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020102,
					"content": "Hallo, Fräulein Katheryne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 738020103,
					"content": "Hallo, Katheryne ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020104
					]
				},
				{
					"id": 738020104,
					"content": "Hallo, ihr zwei scheint heute ja in guter Verfassung zu sein. Seid ihr hier, um eine Mission anzunehmen? Oder habt ihr etwas anderes zu erledigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020105,
					"content": "Hm ... Warum starrt ihr mich so an? Gibt es etwas ... das ihr mich fragen wollt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020106,
						738020107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020106,
					"content": "Nein!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020108
					]
				},
				{
					"id": 738020108,
					"content": "Ach so ... Du siehst aus, als hättest du eine Menge Abenteuer erlebt, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020109,
					"content": "Hmm ... könnte man so sagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020110
					]
				},
				{
					"id": 738020110,
					"content": "Dann weißt du sicher, wie die Abenteurergilde funktioniert, also werde ich deine Zeit nicht damit verschwenden, es dir zu erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020111,
					"content": "Wenn du Fragen zur Vorgehensweise der Gilde hast, stelle sie mir gerne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020112,
					"content": "#Bitte hilf mit, die Aufträge in Sumeru abzuschließen. {M#Ein fähiger Abenteurer}{F#Eine fähige Abenteurerin} wie du, kann den Menschen eine große Hilfe sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020113,
					"content": "Mögest du deine Abenteuer fortführen. Ad astra abyssosque! Zu den Sternen und Abgründen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020107,
					"content": "Wir ... Wir würden nur gern einige Missionen übernehmen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020108
					]
				}
			]
		}
	]
