					"nextDialogs": [
						10293202
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293202,
					"content": "Geht es dir gut? Du bist plötzlich so still. Es ist nicht deine übliche Art.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293203
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10293203,
					"content": "Pssst, lass uns später reden. Ich sortiere gerade die Hinweise, die wir bisher erhalten haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293204
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293204,
					"content": "Vielleicht ist der Durchbruch in einem Detail verborgen, das ich übersehen habe. Ich muss nochmal alles überprüfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293205
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293205,
					"content": "Na dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293206
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10293206,
					"content": "Keine Sorge. Ich werde die Dinge, die du gesagt hast, nicht auf Papier festhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293207
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293207,
					"content": "Nein. Ich meine, wenn du sie analysieren willst, kann ich dir auch helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				}
			]
		},
		{
			"id": 103202,
