				"points": []
			},
			"dialogs": [
				{
					"id": 10293301,
					"content": "Ushi, denkst du, dass diese Zwergen-Lavendelmelone eingeschlafen ist? Wovon träumt sie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293302
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293302,
					"content": "Muh? Muh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293303
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10293303,
					"content": "Es ist erstaunlich, sie auch mal so energielos zu sehen, wo sie doch sonst gern ihre Macht demonstriert. Ach ... So traurig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293304
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293304,
					"content": "Und dieser kleine Kerl sieht auch sehr müde aus. Es ist wirklich besorgniserregend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293305
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293305,
					"content": "Muh, muh, muh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293306
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10293306,
					"content": "Schlafe ich auch so in meiner Zelle? Du machst wirklich Witze. Meine Schlafposition muss die schönste der Welt sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293307
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293307,
					"content": "#{NICKNAME}?! Wann bist du hierhergekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
