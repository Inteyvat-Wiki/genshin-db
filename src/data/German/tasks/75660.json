			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xilonen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756600101,
					"content": "Uii, das Wetter ist echt prächtig, dieser Ausflug hat sich wirklich gelohnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600102
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600102,
					"content": "#Hm? Ist das nicht unser{F#e} stolzgeschwellte{M#r} „Tum{RUBY#[D]Hoffnung}aini“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600103,
						756600104
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600103,
					"content": "Was für ein Zufall!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600105
					]
				},
				{
					"id": 756600105,
					"content": "Du erklärst Xilonen die Sache mit Irade und den Prüfungslevels ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756600106
					]
				},
				{
					"id": 756600106,
					"content": "Ach so, ja, beinahe hätte ich es vergessen. Ich habe ihr tatsächlich einmal geholfen. Das Prüfungslevel der Kinder der Echos ist auch gar nicht weit von hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600107
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600107,
					"content": "Anfangs war es Irade nur gelungen, von Nkunga, „Katastrophe von Tetlahuitl“, und Amuru, „Sandklinge von Seit’aad“, Rat einzuholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600108
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600108,
					"content": "Doch den beiden war an flexiblen Manövern wenig gelegen. Sie setzten gänzlich auf direkte Frontalkämpfe, was ihre Empfehlungen ein wenig einseitig erscheinen ließ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600109
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600109,
					"content": "Als Pacal davon erfuhr, bat er mich um Rat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600110,
						756600113
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600110,
					"content": "Also sind die jetzigen Levels dein Werk?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600111
					]
				},
				{
					"id": 756600111,
					"content": "Im Großen und Ganzen, ja. Nach ein paar Gesprächen mit Pacal und Irade haben wir beschlossen, die Struktur der Levels unseres Stammes ein wenig anzupassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600112
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600112,
					"content": "Jetzt kommt es bei diesen Levels mehr darauf an, dass die Kämpfer strategisch Positionen einnehmen und geschickt stetig die Stützpunkte verlagern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600116,
						756600117
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600116,
					"content": "Dann will ich mich doch gleich mal deiner Herausforderung stellen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600118
					]
				},
				{
					"id": 756600118,
					"content": "Deine Fähigkeiten sind in ganz Natlan anerkannt. Kein Level sollte dir ernsthafte Schwierigkeiten bereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600119
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600119,
					"content": "Schau mal, das Level ist da drüben. Wenn du Lust hast, probier’s doch aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600117,
					"content": "Hoffentlich sind Xilonens Levels nicht zu schwer ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600118
					]
				},
				{
					"id": 756600113,
					"content": "Du scheinst eine wahre Meisterkonstrukteurin zu sein, die alles hinbekommt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600114
					]
				},
				{
					"id": 756600114,
					"content": "Das sind doch nur ein paar einfache Apparate, keine große Herausforderung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600115
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600115,
					"content": "Wenn sich durch diese Anstrengung die Reihen der Kinder der Echos wieder füllen, hab ich endlich mal mehr Ruhe und kann meine ganzen offenen Aufträge nach und nach abarbeiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600116,
						756600117
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600104,
					"content": "Ich hab den Auftrag von Fräulein Irade angenommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600105
					]
				}
			]
		}
	]
}