			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fräulein Bai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413310301,
					"content": "Scheint, als bräuchten wir noch einige zusätzliche Zutaten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310302
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 413310302,
					"content": "Lass mich dir helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310303
					]
				},
				{
					"id": 413310303,
					"content": "Huch? Oh, du willst helfen? Du bist gerade rechtzeitig! Ich hab mir schon Sorgen gemacht, dass wir es nicht schaffen würden, alle Zutaten zu kriegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310304
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 413310304,
					"content": "Lass mich mal sehen ... Wenn du könntest, hilf mir doch bitte, drei Stück rohes Fleisch und drei Stück rohes Geflügel zu kriegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310305
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 413310305,
					"content": "In der Zwischenzeit werde ich mir einen Weg überlegen, die restlichen Zutaten aufzutreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fräulein Bai"
				}
			]
		},
		{
			"id": 4133104,
