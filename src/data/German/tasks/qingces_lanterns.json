				"objectNames": [
					"Onkel Kai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413310601,
					"content": "Oh? Suchst du nach mir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310602
					],
					"speakerTitle": "Onkel Kai"
				},
				{
					"id": 413310602,
					"content": "Wir werden bald diese Tische und Stühle benötigen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310603
					]
				},
				{
					"id": 413310603,
					"content": "Ah ja, die Tische und Stühle ... ich erinnere mich. Ich habe bereits alles vorbereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310604
					],
					"speakerTitle": "Onkel Kai"
				},
				{
					"id": 413310604,
					"content": "Ah, aber es sollten noch einige mehr im Laden sein. Ah gut, dann sollten wir sie alle nach draußen bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310605
					],
					"speakerTitle": "Onkel Kai"
				},
				{
					"id": 413310605,
					"content": "Das sollten genug Tische und Stühle für jeden sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310606
					],
					"speakerTitle": "Onkel Kai"
				},
				{
					"id": 413310606,
					"content": "Ich hätte nie erwartet, dass du den ganzen Weg hier herkommst, um mir zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310607
					],
					"speakerTitle": "Onkel Kai"
				},
				{
					"id": 413310607,
					"content": "Ich bin froh, dass ich helfen konnte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310608
					]
				},
				{
					"id": 413310608,
					"content": "#He! Ich muss sagen, dass du {M#ein außergewöhnlicher junger Mann}{F#eine außergewöhnliche junge Frau} bist ... Aber warum bist du noch nicht nach Hause gegangen? Willst du nicht mit deiner Familie feiern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310609,
						413310610
					],
					"speakerTitle": "Onkel Kai"
				},
				{
					"id": 413310609,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310611
					]
				},
				{
					"id": 413310611,
					"content": "Mach dir keine Sorgen, ich werde nicht weiter fragen. Ich bin sicher, du hast deine Gründe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310612
					],
					"speakerTitle": "Onkel Kai"
				},
				{
					"id": 413310612,
					"content": "Wenn du das Fest hier feiern willst, bist du mehr als eingeladen, mit uns mitzumachen. Je mehr, desto besser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Onkel Kai"
				},
				{
					"id": 413310610,
					"content": "Na ja, es gibt Gründe dafür ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310611
					]
				}
			]
		},
