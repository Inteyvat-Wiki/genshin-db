					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313702
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413313702,
					"content": "He, jetzt lassen wir die Laternen zusammen steigen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313703
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413313703,
					"content": "Ich wünsche jedem hervorragende Gesundheit und viel Glück im kommenden Jahr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313704
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413313704,
					"content": "Und mögen die Träume von allen Kindern, die herumlaufen, auch in Erfüllung gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313705
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413313705,
					"content": "Na gut, Oma Ruoxin. Wenn wir noch länger warten, wird das Essen, das ich gekocht habe, kalt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313706
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 413313706,
					"content": "Ooh! Sieh dir all das leckere Essen an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313707
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 413313707,
					"content": "Komm schon, Oma! Los geht’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313708
					],
					"speakerTitle": "Dongdong"
				},
				{
					"id": 413313708,
					"content": "Ihr albernen Kinder! Na gut, dann legt mal los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313709
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413313709,
					"content": "Willst du nicht mitmachen, Oma Ruoxin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313710
					]
				},
				{
					"id": 413313710,
					"content": "Oh, ich? Ich habe keine Eile. Außerdem will ich mir noch etwas länger die Laternen ansehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313711
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413313711,
					"content": "Ach übrigens, die hier sind für dich, mein liebes Kind. Es ist meine Art dir für die Hilfe bei der Vorbereitung der Festlichkeiten zu danken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313712
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413313712,
					"content": "Danke, Oma Ruoxin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313713
					]
				},
				{
					"id": 413313713,
					"content": "Wirklich gern geschehen! So wie es aussieht, musst du noch sehr jung sein. Ich kann mir vorstellen, dass dich das ganze Herumgelaufe ziemlich ausgelaugt hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313714
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413313714,
					"content": "Warum bleibt ihr nicht eine Weile bei uns und wohnt den Festivitäten bei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313715
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413313715,
					"content": "Es ist gut, nach einem ganzen Jahr voller Stress etwas zu entspannen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oma Ruoxin"
				}
			]
		},
