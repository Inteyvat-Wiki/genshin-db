			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Oma Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413310201,
					"content": "*seufz* Das Laternenritual ist wieder da ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310202
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413310202,
					"content": "Oma Ruoxin, was geht dir im Kopf herum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310203
					]
				},
				{
					"id": 413310203,
					"content": "Während des Laternenrituals sollte es festlich und belebt sein, weißt du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310204
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413310204,
					"content": "Aber im Qingce-Dorf sind die Alten zu alt und die Jungen zu jung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310205
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413310205,
					"content": "All diese jungen Arbeiter, die seitdem in die große Stadt geströmt sind, sind entweder zu beschäftigt und können sich keinen freien Tag von der Arbeit nehmen, um das Fest zu feiern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310206
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413310206,
					"content": "Oder sie sind zu weit weg, um es rechtzeitig nach Hause zu schaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310207
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413310207,
					"content": "Das Laternenritual ist ein lebhaftes Fest, es ist eine Zeit in der jeder zusammen kommen und feiern sollte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310208
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413310208,
					"content": "Sicher, ich verstehe, dass es für sie nicht einfach ist, aber ... *seufz* Was ist mit all den Festlichkeiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310209
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413310209,
					"content": "Ähm, es bringt nichts, sich zu beschweren. Das ist keine Art zu feiern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310210
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413310210,
					"content": "Wenn du so freundlich wärst, ich bin mir sicher, dass Fräulein Bai in diesem Moment Hilfe benötigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310211
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413310211,
					"content": "Die junge Dame meinte, sie wolle einen Tisch decken mit Essen für jeden und arbeitet bereits hart an den Vorbereitungen. Ich fürchte, sie wird eine solche Aufgabe nicht alleine schultern können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310212,
						413310213
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413310212,
					"content": "Überlass es ganz mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				},
				{
					"id": 413310214,
					"content": "Oh, danke dir. Du bist zu freundlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413310213,
					"content": "Sorge dich nicht, ich werde ihr helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				}
			]
		},
		{
			"id": 4133103,
			"completionStepIds": [
				4133103
			],
