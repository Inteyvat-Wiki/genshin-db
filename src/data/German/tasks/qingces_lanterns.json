			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fräulein Bai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413310501,
					"content": "Toll, das sollte reichen. Ah, ja. Ich werde auch deine Hilfe brauchen, zu Onkel Kai zu gehen und ihm zu sagen, alle Stühle und Tische herüberzubringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310502
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 413310502,
					"content": "Ich plane, viele Gerichte zuzubereiten. Wenn wir also zu lange damit warten, die Tische aufzustellen, fürchte ich, dass das Essen kalt werden könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fräulein Bai"
				}
			]
		},
		{
			"id": 4133106,
			"completionStepIds": [
				4133106,
				4133108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
