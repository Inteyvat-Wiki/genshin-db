			},
			"dialogs": [
				{
					"id": 413311001,
					"content": "Ah, du bist zurück. Entschuldigung, dass ich dich an einem so festlichen Tag so viel arbeiten lasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311002
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413311002,
					"content": "Ich bin froh, dass ich helfen konnte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413311003
					]
				},
				{
					"id": 413311003,
					"content": "Danke dir, du bist zu freundlich. Ich habe auch meinen Teil der Arbeit geleistet und es geschafft, einige Laternen für die Menschen aus dem Qingce-Dorf zu basteln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311004
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413311004,
					"content": "Wenn du möchtest, kannst du mich später am Abend in der Nähe des Tors finden. Wir werden die Laternen steigen lassen und das Fest zusammen feiern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311005
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413311005,
					"content": "Aber wer weiß, wo all die anderen Kinder jetzt hingelaufen sind ... Mit diesen alten Beinen ist es unmöglich, ihnen hinterherzulaufen und sie alle zu suchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311006
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413311006,
					"content": "Könnte ich dich darum bitten, die Kinder für mich einzusammeln? Ich bin mir sicher, sie werden es lieben, die Laternen steigen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311007
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 413311007,
					"content": "Und sag unbedingt jedem, den du auf dem Weg findest, dass er zurück in das Dorf gehen soll ... Je mehr Leute, desto schöner wird es, weißt du.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oma Ruoxin"
				}
			]
		},
