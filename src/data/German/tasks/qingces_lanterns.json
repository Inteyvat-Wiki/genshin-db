			"dialogs": [
				{
					"id": 413312001,
					"content": "Uff, ich kann meinen Schatten noch immer nicht einfangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413312002
					],
					"speakerTitle": "You"
				},
				{
					"id": 413312002,
					"content": "Wir werden bald die Laternen im Dorf steigen lassen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413312003
					]
				},
				{
					"id": 413312003,
					"content": "Wir können die Laternen heute Abend steigen lassen? Großartig! Ich werde es meinem großen Bruder erzählen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413312004
					],
					"speakerTitle": "You"
				},
				{
					"id": 413312004,
					"content": "Ich hörte Opa sagen, dass wir einen Wunsch äußern können, wenn wir die Laternen haben steigen lassen. Ist das wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413312005
					],
					"speakerTitle": "You"
				},
				{
					"id": 413312005,
					"content": "Ich habe einen großen Wunsch, über den ich jetzt seit einer langen Zeit nachdenke ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413312006
					],
					"speakerTitle": "You"
				},
				{
					"id": 413312006,
					"content": "Oh wirklich? Was ist dein Wunsch?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413312007
					]
				},
				{
					"id": 413312007,
					"content": "Es ist so, dass ich ... Ah, warte, ich sollte es dir nicht sagen ... Opa hat gesagt, dass unsere Wünsche nicht wahr werden, wenn wir sie anderen erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413312008
					],
					"speakerTitle": "You"
				},
				{
					"id": 413312008,
					"content": "Warte einfach, bis ich es meinem großen Bruder erzähle. Ich bin sicher, er wird auch einen Wunsch haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413312009
					],
					"speakerTitle": "You"
				},
				{
					"id": 413312009,
					"content": "Oh warte. Es scheint, wir müssen unsere Wünsche auf eine Laterne schreiben ... Ich denke also, nur daran zu denken, ist nicht genug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "You"
				}
			]
		},
