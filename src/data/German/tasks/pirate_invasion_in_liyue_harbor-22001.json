				"objectNames": [
					"Kleiner Fei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220010601,
					"content": "Ich bin bereit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010602
					]
				},
				{
					"id": 220010602,
					"content": "Gut, na, dann los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010603
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220010603,
					"content": "Echt mal, wie soll man als Matrose Spaß haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010604
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220010604,
					"content": "Lulu und Meng haben ja ihren Spaß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010605
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220010605,
					"content": "Ich würde gern rauben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010606
					]
				},
				{
					"id": 220010606,
					"content": "Ein Pirat? Entschuldigung, aber ich bin nur ein Matrose. Bei mir gibt es nichts zu rauben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010607
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220010607,
					"content": "Wenn du etwas rauben willst, solltest du dir jemand Reichen suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010608
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220010608,
					"content": "He! Ihr wollt doch jemanden ausrauben. Der Kapitän hat Geld! Ihr könnt euch ihn vornehmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010609
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220010609,
					"content": "Wie? Was? Bist du kein Matrose auf diesem Schiff?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010610,
					"content": "Doch, deswegen weiß ich ja, wo der Kapitän steckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
