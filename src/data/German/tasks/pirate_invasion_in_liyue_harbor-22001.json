			"dialogs": [
				{
					"id": 220010401,
					"content": "Hast du den Lotos gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010402
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220010402,
					"content": "Ja, habe ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010403
					]
				},
				{
					"id": 220010403,
					"content": "Du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010404
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220010404,
					"content": "Du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010405
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220010405,
					"content": "Hört auf zu streiten! Ist das nicht anstrengend?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010406
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220010406,
					"content": "Das war doch nur ein Spiel. Seid nicht böse aufeinander. Ihr seid doch Freunde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010407
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220010407,
					"content": "Hier, frisch gepflückter Lotos. Lasst ihn euch schmecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010408
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220010408,
					"content": "Wenn ihr fertig seid, sprechen wir noch einmal in Ruhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010409
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220010409,
					"content": "Dann bereden wir, wer den Kapitän und wer das Personal spielt. In Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010410
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220010410,
					"content": "Gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010411
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220010411,
					"content": "Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010412
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220010412,
					"content": "Sie haben wirklich aufgehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010413,
					"content": "Haha, hab ich doch gesagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010414,
						220010416
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220010414,
					"content": "Woher hast du das gewusst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010415
					]
				},
				{
					"id": 220010415,
					"content": "Wir haben schon viel miteinander gespielt. Das ist Erfahrung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220010416,
					"content": "Lulu ist echt klasse ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010417
					]
				},
				{
					"id": 220010417,
					"content": "Danke, aber Beidou ist besser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010418
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220010418,
					"content": "Ob ich auch so werden kann, wenn ich groß bin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleine Lulu"
				}
			]
		},
		{
