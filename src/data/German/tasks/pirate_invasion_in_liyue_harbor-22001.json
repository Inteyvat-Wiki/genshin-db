					"Kleiner Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220010301,
					"content": "Hier ist der Kapitän!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010302
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220010302,
					"content": "Wieso hast du denn einen Piraten hergeführt? Solltest du den Piraten nicht woandershin führen, damit ich mit Lulu fliehen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010303
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220010303,
					"content": "Warum solltest du mit Lulu fliehen, während ich mit einem Piraten festsitze?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010304
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220010304,
					"content": "Wenn ich dich dem Piraten überlasse, kann ich doch auch mit Lulu fliehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010305
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220010305,
					"content": "Du ... Beidou hat gesagt, man darf seine Freunde nicht verraten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010306
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220010306,
					"content": "Hat Beidou auch gesagt, dass der Kapitän einfach davonlaufen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010307
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220010307,
					"content": "Du ... Ich werde nie wieder Lotosfrüchte mit dir teilen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010308
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220010308,
					"content": "Dann eben nicht! Als wär das was Besonderes ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010309
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220010309,
					"content": "Warum streiten sie sich denn jetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010310,
					"content": "Hmm, ich habe einen Plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010311
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220010311,
					"content": "Sie mögen doch Lotosfrüchte so sehr. Wenn wir ihnen etwas Leckeres bringen, sind sie bestimmt ruhig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010312
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220010312,
					"content": "Könntest du ein paar Lotosfrüchte suchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010313,
						220010315
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220010313,
					"content": "Klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010314
					]
				},
				{
					"id": 220010314,
					"content": "Danke! Bitte beeil dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220010315,
					"content": "Was sie am meisten mögen, ist bestimmt nicht Lotos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010316
					]
				},
				{
					"id": 220010316,
					"content": "Hm ... Was sagst du? Na, was glaubst du, was sie stattdessen mögen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010317
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220010317,
					"content": "Ach, finden wir einfach den Lotos, damit sie wieder Ruhe geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleine Lulu"
				}
			]
		},
