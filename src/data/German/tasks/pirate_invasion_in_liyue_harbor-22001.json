					"Kleiner Fei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220010101,
					"content": "Meng, kann ich heute endlich Kapitän sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010102
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220010102,
					"content": "Lulu, ich war jetzt schon mehrere Tage am Stück der Kapitän. Jetzt müsste Fei dran sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010103
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220010103,
					"content": "Aber ich finde, dass das Meng echt gut macht. Ich sage, wir sollten ihn weiter den Kapitän spielen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010104
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220010104,
					"content": "Was macht ihr denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010105
					]
				},
				{
					"id": 220010105,
					"content": "Ah, wir spielen ein Spiel. Eigentlich sollte ich heute der Kapitän sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010106
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220010106,
					"content": "Aber Lulu sagt, dass es mehr Spaß macht, wenn Meng der Kapitän ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010107
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220010107,
					"content": "Menno, Lulu ist immer so ... Aber wenn sie meint, dass es so besser wäre ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010108
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220010108,
					"content": "Wenn du Zeit hast, könntest du dich doch als Pirat verkleiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010109,
						220010111
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220010109,
					"content": "In Ordnung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010110
					]
				},
				{
					"id": 220010110,
					"content": "Und am Ende bin ich wieder der Matrose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220010113,
					"content": "Wie beim letzten Mal. Komm einfach her, sobald du fertig bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220010111,
					"content": "Ich will ein Guter sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010112
					]
				},
				{
					"id": 220010112,
					"content": "Menno, ich will der Kapitän sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "Kleiner Fei"
				}
			]
		},
