			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Orupeusu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450701,
					"content": "#Ach, bist du {F#die}{M#der} Reisende aus einem fremden Land ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450702
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450702,
					"content": "Deine Haltung, während du den Bergpfad entlanggehst, ist in der Tat traurig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450703
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450703,
					"content": "Traurig? Gibt es daran etwas, das andere traurig macht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450704,
					"content": "Für den Sänger ist alles auf der Welt etwas, worüber man traurig sein kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450705
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450705,
					"content": "Vereint zu sein bedeutet zum Beispiel, getrennt zu sein, lebendig zu sein bedeutet, eines Tages unter dem Staub begraben zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450706
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450706,
					"content": "#Zum Beispiel ist ein Wiedersehen zu kurz, um den Schmerz des Abschieds zu lindern, o Reisende{M#r} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450707
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450707,
					"content": "Nur wer auf der Suche nach etwas ist, begibt sich auf eine Reise fern der Heimat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450708
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450708,
					"content": "Die Reise muss für die Langzeitbewohner des einen Ortes sehr romantisch sein, für die Reisenden selbst aber vielleicht unsagbar schmerzhaft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450709
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450709,
					"content": "Wenn es wie früher wäre, dann wäre ich hier, um für dich zu singen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450710
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450710,
					"content": "Nur habe ich neulich jemandem geschworen, dass ich meine Gesangsstimme nicht mehr zeigen werde, wenn ich ihre Stimme nicht hören kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450711
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450711,
					"content": "Ich kann dir nur alles Gute wünschen, obwohl du auch viel älter aussiehst als ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450712
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450712,
					"content": "Ich wünsche dir alles Glück, das du dir wünschen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orupeusu"
				}
			]
		}
	]
}