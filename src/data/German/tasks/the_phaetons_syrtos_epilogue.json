			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Piramumon",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450601,
					"content": "#Ah, so wie du aussiehst, bist du ein{F#e} Reisende{M#r} aus einem fremden Land!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450602
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450602,
					"content": "Woher kommst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450603
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450603,
					"content": "Aus Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450604,
					"content": "Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450605
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450605,
					"content": "Du beschreibst Piramumon die Landschaft von Mondstadt in einfachen Worten ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722450606
					]
				},
				{
					"id": 722450606,
					"content": "Ich habe noch nie von diesem Stadtstaat gehört, aber es ist bemerkenswert, dass es einen solchen Ort gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450607
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450607,
					"content": "Hahahaha, ich habe mir gedacht, dass die Welt nicht nur so groß ist wie Byakuyakoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450608
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450608,
					"content": "Wenn es so wäre, wäre das nicht unfassbar einsam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450609
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450609,
					"content": "Als ich die alten Texte las, gab es auch Hinweise auf die Geschichte von Byakuyakoku, bevor es zu einem Königreich wurde, und da wurde mir klar, dass es eine jenseitige Welt gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450610
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450610,
					"content": "Dennoch hatte ich ursprünglich Angst, Angst, dass es jenseits von Byakuyakoku nichts gab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450611
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450611,
					"content": "#Reisende{M#r}, deine Ankunft hat mich so sehr beruhigt. Hach, es gibt so viele interessante Orte auf der Welt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450612
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450612,
					"content": "Es ist nur schade, dass ich jetzt ein Ritual namens Fest der wiederkehrenden Sonne vollziehen muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450613
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450613,
					"content": "#Wie wäre es, o Reisende{M#r}, wenn du mir deinen Weg zu diesem Ort zeigen würdest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450614
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450614,
					"content": "Wenn das Fest der wiederkehrenden Sonne beendet ist, werde ich eine Gelegenheit finden, mich aus dem Dainichi Mikoshi hinauszuschleichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450615
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450615,
					"content": "Dann trinken wir eben zusammen einen Saft! Hahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piramumon"
				}
			]
		},
		{
			"id": 7224507,
