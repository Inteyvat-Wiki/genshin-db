			},
			"dialogs": [
				{
					"id": 1903203101,
					"content": "*schluchz* Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203102
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203102,
					"content": "Hallo! Darf ich dich um einen Gefallen bitten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203103,
						1903203104
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203103,
					"content": "Mich? Gefallen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				},
				{
					"id": 1903203105,
					"content": "Dieser Mystiker mit den blauen Haaren ist so unheimlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203106
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203106,
					"content": "Kannst du ihn von mir weglocken? Er jagt mir Angst ein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203107,
						1903203108
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203107,
					"content": "Spürst du seine Yang-Energie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203109,
					"content": "Ich würde es nicht wagen, mich in seine Nähe zu begeben. Seine Energie ... sie ist schrecklich! Sie lässt mich verschwinden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203110
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203110,
					"content": "Ich will nicht verschwinden! Bitte hilf mir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203111,
						1903203112
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203111,
					"content": "Ich frage mich, ob er dich als bösen Geist betrachten würde ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203113,
					"content": "In dem Fall habe ich eine Idee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203114
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203114,
					"content": "Ich habe gesehen, wie der Mystiker mit den blauen Haaren da drüben heftig mit irgendwelchen Leuten diskutiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203115
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203115,
					"content": "Ich jage sie in die Flucht, aber du musst den Mystiker bitten, mich ziehen zu lassen, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203116,
						1903203118
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203116,
					"content": "Du lügst mich doch nicht an, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203117
					]
				},
				{
					"id": 1903203117,
					"content": "Nein, Hand aufs Herz, ich ... oh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203120,
					"content": "Also, was sagst du dazu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203121
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203121,
					"content": "Er muss das entscheiden. Aber ich werde versuchen, die Lage so gut wie möglich zu schildern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203122
					]
				},
				{
					"id": 1903203122,
					"content": "Oh, verstehe. Das ist also ein „Ja“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203123
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203123,
					"content": "Ich hoffe, der Mystiker mit den blauen Haaren ist ein guter Mensch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203124
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203124,
					"content": "Ich helfe ihm und du sprichst mit ihm. Dann ... hilfst du mir, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203118,
					"content": "Ich kann ihn auch selbst aus der brenzligen Lage retten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203119
					]
				},
				{
					"id": 1903203119,
					"content": "Ja, aber das wäre kompliziert. Ich habe schon einen Plan. Du musst mir glauben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203112,
					"content": "Er muss entscheiden, was jetzt zu tun ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203108,
					"content": "Kein Wunder, dass wir dich den ganzen Tag nicht gesehen haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203104,
					"content": "Warum ich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				}
			]
		}
	]
}