			"dialogs": [
				{
					"id": 240040301,
					"content": "Oha! Du hast mich aber schnell gefunden! Ich wollte mich gerade woanders verstecken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040302
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040302,
					"content": "Hm, dann muss ich wohl zurück zum Treffpunkt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
