				]
			},
			"dialogs": [
				{
					"id": 240040501,
					"content": "Warum ... schaut ihr zwei mich so an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040502
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040502,
					"content": "Ach, Bruder ... hast du dich etwa wieder davongemacht, um zu lesen? Du spielst gar nicht richtig mit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040503
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040503,
					"content": "Genau, das ist kein einfaches Spiel, streng dich etwas mehr an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040504
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040504,
					"content": "Ihr habt doch schon alle guten Plätze belegt und ich bin ja auch nicht gut im Verstecken ... also konnte ich nur lesen, um mir die Zeit zu vertreiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040505
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040505,
					"content": "Pah! Lügner!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040506
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040506,
					"content": "Hmpf! Du willst immer nur lesen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040507
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040507,
					"content": "Lasst mich doch in Ruhe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040508,
						240040509
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040508,
					"content": "Lasst ihn in Ruhe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040510
					]
				},
				{
					"id": 240040510,
					"content": "Hehe, Lovi ist richtig gut im Versteckspielen und kennt viele gute Plätze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040517
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040517,
					"content": "Hehe, mit Lovi an meiner Seite ist es hier ziemlich interessant!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040511
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040511,
					"content": "Verut kann ganz schnell Mauern hochklettern. Und er ist so stark, er hat mich schon so oft hochgezogen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040512
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040512,
					"content": "Normalerweise finden uns die anderen gar nicht, wenn wir kooperieren, also sei stolz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040513
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040513,
					"content": "Gut, ihr habt jetzt genug gespielt. Lovi, wir bringen dich nach Hause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040514
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040514,
					"content": "Und ... bei der Gelegenheit kannst du auch gleich meinen Papa etwas fragen, stimmt’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040515
