			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verut",
					"Aurèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240040101,
					"content": "Bruder! Wir verstecken uns dort, das ist bestimmt ein besserer Platz als ihrer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040102,
					"content": "Verut, lauf nicht überall herum! Wenn du verloren gehst, kann ich dich nicht unbedingt rechtzeitig finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040103,
						240040104
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040103,
					"content": "Was macht ihr denn hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				},
				{
					"id": 240040105,
					"content": "Ach! Du bist es! Hehe, hast du Zeit? Schnell, versteck dich mit uns, Lovi hat bestimmt schon ein Schlupfloch gefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040106
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040106,
					"content": "Was Lovi angeht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040107
					]
				},
				{
					"id": 240040107,
					"content": "Los doch, wir haben keine Zeit, sie kennt sich hier aus ... Wir müssen ein besseres Versteck finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040108,
					"content": "Verut verschwindet wie ein geölter Blitz ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240040109
					]
				},
				{
					"id": 240040109,
					"content": "*seufz* Ach, Verut ... Wann wird er jemals hören ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040110
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040110,
					"content": "Entschuldige, würdest du noch einmal mitspielen? Aus irgendeinem Grund ist Verut plötzlich so aufgeregt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040111,
						240040114
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040111,
					"content": "Vielleicht weil er neue Spielkameraden gefunden hat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040112
					]
				},
				{
					"id": 240040112,
					"content": "Das glaube ich auch. Aber egal, Hauptsache, Verut hat Spaß beim Spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040113
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040113,
					"content": "Aber ... er ist wirklich zu aufgedreht. Hoffentlich versteckt er sich nicht wieder mit Lovi an irgendwelchen seltsamen Orten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040118,
					"content": "Also ... Bitte, könntest du wieder mit uns spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040119
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040119,
					"content": "Ich sollte mir auch lieber schnell ein Versteck suchen, sonst wird Verut wieder sauer auf mich. Wenn er hier draußen anfängt zu weinen, weiß ich absolut nicht, was ich tun soll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040120
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040120,
					"content": "Aurèle verschwindet ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240040114,
					"content": "Was Lovi angeht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040115
					]
				},
				{
					"id": 240040115,
					"content": "Das ist ein Mädchen, das wir gerade kennengelernt haben. Als sie uns Versteckspielen gesehen hat, wollte sie unbedingt mitspielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040116
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040116,
					"content": "Sie hat die fast gleiche Persönlichkeit wie Verut, deshalb verstehen sich die beiden so gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040117
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040117,
					"content": "Außerdem scheint ihr Papa auch keine Zeit für sie zu haben, ganz wie bei uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040104,
					"content": "Spielt ihr immer noch Verstecken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				}
			]
		},
		{
			"id": 2400402,
			"completionStepIds": [
				2400402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
