			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lovi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240040401,
					"content": "Na gut, du hast mich gefunden ... Hä? ... Wer bist du denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040402,
					"content": "#Ich bin {M#ein Freund}{F#eine Freundin} von Aurèle und Verut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040403
					]
				},
				{
					"id": 240040403,
					"content": "Ooh! Sie haben von dir erzählt. Verut sagte, du wärst gut im Versteckspiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040404
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040404,
					"content": "Jetzt habe ich gesehen, dass du wirklich gut darin bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040405
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040405,
					"content": "Na, ich habe verloren. Dann gehe ich zum Treffpunkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
		{
