					"Aurèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240040201,
					"content": "... Diese Seite habe ich doch schon gelesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040202,
						240040203
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040202,
					"content": "Du ... liest?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				},
				{
					"id": 240040204,
					"content": "Oh, ich habe nicht erwartet, dass du mich so schnell finden würdest. Ich habe das Buch gerade aufgeschlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040205
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040205,
					"content": "Lovis Papa ließ sie mir dieses Buch bringen. Er hat auch gesagt, dass ich ihn fragen kann, wenn ich etwas nicht verstehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040206
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040206,
					"content": "Aber ... Hehe, ehrlich gesagt verstehe ich das ganze Buch nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040207
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040207,
					"content": "Aber das tut jetzt nichts zur Sache. Ich sollte zurück zum Treffpunkt, schließlich hast du mich gefunden und ich muss mich an die Regeln halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040203,
					"content": "Du hörst wirklich nie auf zu lernen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				}
			]
		},
		{
			"id": 2400403,
			"completionStepIds": [
				2400403
