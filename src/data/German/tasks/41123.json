				},
				{
					"id": 411230902,
					"content": "Quellingen ist sicher.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230903
					]
				},
				{
					"id": 411230903,
					"content": "Großartig ... Ich war ernstlich besorgt, dass wir niemanden entbehren können, um ihnen zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230904
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230904,
					"content": "Vielen herzlichen Dank. Du hast uns diesmal wirklich geholfen. Bitte nimm dies als Zeichen unserer Anerkennung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230905
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230905,
					"content": "*seufz* Gefallene Sterne, Monster ... Ich kann nur hoffen, dass es zu keiner Katastrophe kommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
