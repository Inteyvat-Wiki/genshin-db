			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Scheuer Morrow"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230801,
					"content": "Wie? Du schon wieder? Was hast du die ganze Zeit über getrieben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230802
					],
					"speakerTitle": "Scheuer Morrow"
				},
				{
					"id": 411230802,
					"content": "Du hast alle Monster besiegt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230803
					]
				},
				{
					"id": 411230803,
					"content": "Alle besiegt ... wie? Du alleine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230804
					],
					"speakerTitle": "Scheuer Morrow"
				},
				{
					"id": 411230804,
					"content": "Du kannst es selbst überprüfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230805
					]
				},
				{
					"id": 411230805,
					"content": "Argh, lieber nicht. Wenn die mich sehen, bin ich Geschichte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230806
					],
					"speakerTitle": "Scheuer Morrow"
				},
				{
					"id": 411230806,
					"content": "Ich werde lediglich berichten, was du den Rittern gesagt hast – ob es stimmt oder nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230807
					],
					"speakerTitle": "Scheuer Morrow"
				},
				{
					"id": 411230807,
					"content": "Die können sicher irgendwie überprüfen, ob du all diese Monster besiegt hast. Da bin ich sicher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Scheuer Morrow"
				}
			]
		},
