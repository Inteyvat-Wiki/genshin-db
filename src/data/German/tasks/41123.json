			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230301,
					"content": "Konntest du die Schatzräuber vertreiben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230302
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230302,
					"content": "Ja klar, habe ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230303
					]
				},
				{
					"id": 411230303,
					"content": "Wunderbar. Du warst eine riesige Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230304
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230304,
					"content": "Hoffentlich haben diese Schatzräuber ihre Lektion gelernt und lassen Mondstadt ab jetzt in Ruhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230305
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230305,
					"content": "Nun, das wäre dann so weit alles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230306
					]
				},
				{
					"id": 411230306,
					"content": "Ähm, bitte warte einen Augenblick ... Ich brauche deine Hilfe noch bei einer anderen Sache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230307
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230307,
					"content": "Um ehrlich zu sein, gehen aktuell bei uns zahlreiche Meldungen über ungewöhnliche Monster ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230308
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230308,
					"content": "Diesen Meldungen zufolge werden die Monster durch die gefallenen Sterne außergewöhnlich aggressiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230309
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230309,
					"content": "Die Stadt verfügt über eine robuste Verteidigung, sie hat nichts zu befürchten. Doch einer dieser fallenden Sterne ist nahe bei Quellingen eingeschlagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230310
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230310,
					"content": "In Quellingen leben viele Jäger. Zur Unterstützung haben wir einige Ritter gesendet, doch das Gebiet ist schwer zu überblicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230311
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230311,
					"content": "Falls Monster in den Ort gelangen, wäre das eine Katastrophe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230312
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230312,
					"content": "Würdest du nach Quellingen gehen und überprüfen, ob die Monster eine Bedrohung darstellen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230313,
						411230315
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230313,
					"content": "Werde ich machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230314
					]
				},
				{
					"id": 411230314,
					"content": "Ich lege dies in deine fähigen Hände. Wenn möglich, werde ich weitere Ritter schicken, um dich zu unterstützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230315,
					"content": "Wie ist die Lage in Quellingen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230316
					]
				},
				{
					"id": 411230316,
					"content": "Um ehrlich zu sein, sieht es nicht gut aus. Wir schlagen uns bereits mit den Auswirkungen der gefallenen Sterne herum. Zusätzlich müssen wir uns der Monster und Schatzräuber erwehren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230317
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230317,
					"content": "Es ist beinahe unmöglich, mit so vielen Dingen zugleich fertigzuwerden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230318
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230318,
					"content": "Tut mir leid, dass ich das dir überlassen muss. Ich werde versuchen, dir ein paar Ritter zur Unterstützung zu schicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
