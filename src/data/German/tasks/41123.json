			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230101,
					"content": "#Hallo {F#Reisende}{M#Reisender}. Bitte bleib aufgrund der Situation fürs Erste in der Stadt, wenn möglich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230102
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230102,
					"content": "Was ist los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230103
					]
				},
				{
					"id": 411230103,
					"content": "Du hast die gefallenen Sterne sicher auch gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230104
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230104,
					"content": "Aus irgendeinem Grund werden es immer mehr. Darum wird es immer gefährlicher, sich in der Wildnis aufzuhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230105
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230105,
					"content": "Innerhalb der Stadt häufen sich alle möglichen Angelegenheiten, die Ritter sind damit fast überfordert. Und als wäre das nicht genug, haben wir Schatzräuber in der Nähe der Stadt gesichtet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230106
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230106,
					"content": "Diese Typen scheuen für ein paar Mora vor nichts zurück. Ich befürchte, sie versuchen die Lage auszunutzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230107
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230107,
					"content": "#{F#Reisende}{M#Reisender}, würdest du uns dabei helfen, diese Diebe zu verscheuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230108,
					"content": "Eigentlich sollten das die Ritter übernehmen, aber leider können wir gerade keine entbehren. Kannst du uns dabei helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230109,
						411230111
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230109,
					"content": "Ihr könnt auf mich zählen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230110
					]
				},
				{
					"id": 411230110,
					"content": "Ich schulde dir Dank. Es tut mir leid, die Umstände verlangen, dass ich dich um Hilfe bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230111,
					"content": "Fürchten sich die Schatzräuber nicht vor den fallenden Sternen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230112
					]
				},
				{
					"id": 411230112,
					"content": "Hmph. Ich schätze, wenn es um Mora geht, schrecken diese Gauner vor nichts zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230113
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230113,
					"content": "Ich schulde dir Dank. Es tut mir leid, die Umstände verlangen, dass ich dich um Hilfe bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 4112303,
			"completionStepIds": [
				4112303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
