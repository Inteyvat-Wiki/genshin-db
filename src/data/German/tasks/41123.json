			"dialogs": [
				{
					"id": 411230401,
					"content": "Aaaah!! Komm ja nicht näher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230402
					],
					"speakerTitle": "Scheuer Morrow"
				},
				{
					"id": 411230402,
					"content": "Wie? Du kein Monster? Wer ... Wer bist du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230403
					],
					"speakerTitle": "Scheuer Morrow"
				},
				{
					"id": 411230403,
					"content": "Wie sieht die Lage mit den Monstern aus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230404
					]
				},
				{
					"id": 411230404,
					"content": "Die Monster? Was gibt es dazu fragen? Ich bin gerade vor ihnen weggerannt. Punkt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230405
					],
					"speakerTitle": "Scheuer Morrow"
				},
				{
					"id": 411230405,
					"content": "Sie waren genau dort, ein ganzer Haufen. Sie könnten den Ort angreifen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230406
					],
					"speakerTitle": "Scheuer Morrow"
				},
				{
					"id": 411230406,
					"content": "Wenn ich nicht so schnell gerannt wäre, wäre ich jetzt erledigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230407
					],
					"speakerTitle": "Scheuer Morrow"
				},
				{
					"id": 411230407,
					"content": "Wo sind diese Bestien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230408
					]
				},
				{
					"id": 411230408,
					"content": "Nahe beim Dorf. Sie sind nicht weit entfernt, direkt um die Ecke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230409
					],
					"speakerTitle": "Scheuer Morrow"
				},
				{
					"id": 411230409,
					"content": "Du solltest ebenfalls Schutz suchen. Ich verschnaufe hier kurz, dann werde ich das Dorf warnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Scheuer Morrow"
				}
			]
		},
		{
			"id": 4112308,
			"completionStepIds": [
				4112308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
