			"dialogs": [
				{
					"id": 752570801,
					"content": "Das Bild war super! Jetzt ist der charmante Herr dran, was möchtest du gerne fotografieren lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570802
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570802,
					"content": "Ganz richtig gesprochen! Seit meiner Geburt lege ich größten Wert auf Haltung und Stil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570803
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570803,
					"content": "Ohne Haltung, keine Eleganz. Ohne Laune, kein Stil. Verstehst du, worauf ich hinauswill?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570804
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570804,
					"content": "Hm ... lass mich kurz überlegen ... gut, legen wir los!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
