			},
			"dialogs": [
				{
					"id": 752570701,
					"content": "Puh, endlich alles erledigt! Danke euch beiden, ohne eure Hilfe bekäme ich bestimmt einen Haufen von Beschwerden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570702
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570702,
					"content": "#Hehe, keine Ursache, wir sind die hilfsbereitesten {F#Abenteurerinnen}{M#Abenteurer} weit und breit!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570703
					]
				},
				{
					"id": 752570703,
					"content": "#{F#Abenteurerinnen}{M#Abenteurer}? Wie wär’s, wenn ich euch ein Foto mache, als Erinnerung an eure gute Tat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570704
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570704,
					"content": "Na los, lächeln! Gemütliches Natlan, gemütlicher Sommer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570705
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570705,
					"content": "Danke euch! Nehmt das hier bitte als kleines Dankeschön.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
