			"dialogs": [
				{
					"id": 752570101,
					"content": "Meine Liebe, der Platz hier sieht doch völlig in Ordnung aus. Warum ist er dann noch geschlossen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570102
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570102,
					"content": "Tut mir echt leid, meine Dame. Unser Kulissenhelfer hat sich gestern Abend einen über den Durst gegönnt und kann heute nicht zur Arbeit kommen. Bitte komm morgen nochmal vorbei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570103
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570103,
					"content": "Ach je ... Ich bin nicht mehr die Jüngste, so einen weiten Weg schaffe ich morgen wohl nicht nochmal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570104
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570104,
					"content": "Genau, wir haben morgen auch schon was anderes vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570105
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570105,
					"content": "Es tut uns leid. Unser „Sommer-Fotoservice“ lebt davon, dass wir für unsere Gäste den Hintergrund nach Wunsch gestalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570106
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570106,
					"content": "Ohne den Kulissenhelfer können wir das leider nicht machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570107
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570107,
					"content": "Brauchst du Hilfe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570108
					]
				},
				{
					"id": 752570108,
					"content": "Oh? Ihr beiden würdet wirklich mithelfen? Das wäre super! Ist auch gar nicht kompliziert. Ihr müsst einfach nur den Fotohintergrund so aufbauen, wie es die Gäste möchten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
		{
			"id": 7525702,
			"completionStepIds": [
				7525701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
