			},
			"dialogs": [
				{
					"id": 752570301,
					"content": "Das Foto war super! Jetzt ist dieser Herr von den Fatua dran. Was darf’s für dich sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570302
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570302,
					"content": "Ich will aussehen wie ein echter Scharfschütze, so richtig treffsicher auf den ersten Blick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570303
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570303,
					"content": "Dann muss ich mir keine Sorgen mehr machen, bei der Schießübung vom Trupp wieder ganz hinten zu landen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570304
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570304,
					"content": "Kein Problem, wir fangen gleich an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
