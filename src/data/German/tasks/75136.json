					}
				]
			},
			"dialogs": [
				{
					"id": 751360501,
					"content": "Oh! Wir haben es geschafft! Hm, da ist doch eine ziemlich bekannte „Schillernde Inschrift“. Ist dies also die legendäre „Jade der Rückkehr“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360502,
					"content": "He, bei näherem Hinsehen ... Ist das nicht eine „Goldscheibe des Ultimatums“?! Sie ist genau wie die, die wir damals bei der Steintafel bekommen haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360503,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360504
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360504,
					"content": "Ach so!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360505
					]
				},
				{
					"id": 751360505,
					"content": "Ein Schatz, der die Unreinheit des Abgrunds unterdrücken kann, und ein Abzeichen, das Flüche und Katastrophen entfernen kann ... Ja, ihre Funktion klingt auch ähnlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360506,
					"content": "Das fällt dir erst jetzt auf?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360507
					]
				},
				{
					"id": 751360507,
					"content": "Warum hast du es Paimon nicht einfach gesagt, wenn du es schon wusstest? Moment mal, woher wusstest du es überhaupt? ... Sag Paimon aber nicht, weil du Abenteuererfahrung hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360508,
					"content": "Ein Schatz, der die Unreinheit des Abgrunds unterdrücken kann, und ein Abzeichen, das Flüche und Katastrophen entfernen kann ... Ja, ihre Funktion klingt auch ähnlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360509,
					"content": "Aber kann dieses Ding wirklich den Abgrund in Ochkanatlan unterdrücken? Paimon hat so etwas noch nie von jemandem aus dem Verein für Saurierrelikte gehört ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360510,
					"content": "Ach ja, da die Jade der Rückkehr in Wirklichkeit eine Goldscheibe des Ultimatums ist ... könnte das der Grund sein, warum der böse Drache uns verfolgt hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360511,
					"content": "Hm, es ging also nicht um den geschmorten Fleischeintopf, den Paimon am Morgen gegessen hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360512,
