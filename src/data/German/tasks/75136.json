			},
			"dialogs": [
				{
					"id": 751360401,
					"content": "Uff, immer noch Steine finden, nachdem wir auf der Tonatiuh angekommen sind ... Und Paimon dachte, es wäre etwas anderes und Aufregenderes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360402
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360402,
					"content": "Dann zähle ich auf euch, dass ihr die Feuersteine besorgt! Und wenn ihr etwas braucht, sagt es mir einfach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bona"
				}
			]
		},
		{
			"id": 7513605,
