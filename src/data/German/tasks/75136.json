			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-306.442,
							1277.558,
							9810.905
						],
						"pointId": 8612
					}
				]
			},
			"dialogs": [
				{
					"id": 751360101,
					"content": "Puh ... Wir sind noch am Leben! Was für ein tolles Gefühl, wieder festen Boden unter den Füßen zu haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360102,
					"content": "Aber du schwebst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360103
					]
				},
				{
					"id": 751360103,
					"content": "Es ist jedoch ein großer Unterschied, ob man in der Nähe des Bodens schwebt oder vom Winde verweht wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360104,
					"content": "Der „Boden“ sieht auch hier nicht sehr fest aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360105
					]
				},
				{
					"id": 751360105,
					"content": "#Hä? E... Erschrecke Paimon nicht! Paimon kann dich und {REALNAME[ID(2)|SHOWHOST(true)]} nicht gleichzeitig auffangen, wenn der Boden zusammenbricht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360106,
					"content": "*zwitsch* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360107
					],
					"speakerTitle": "„Cocouik“"
				},
				{
					"id": 751360107,
					"content": "Ist das die Tonatiuh? Juhuu! Wir haben es geschafft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360108,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360109
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360109,
					"content": "Es sieht aber eher aus wie ein riesiges Garnknäuel als wie ein Schiff! Aber diese Linien sehen auch irgendwie wie Schlangen aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360110,
					"content": "Lasst uns erst mal da rübergehen, da sieht es sicherer aus ... Hm, Paimon fragt sich, wo Bona hin ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360111,
					"content": "Sie hat zwar gesagt, dass sie viel Flugerfahrung hat, aber Paimon ist trotzdem etwas besorgt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360112,
					"content": "Solange die Richtung des Winds richtig war ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360113
					]
				},
				{
					"id": 751360113,
					"content": "Du hast recht, dann ist sie wahrscheinlich irgendwo in der Nähe gelandet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360114,
					"content": "Wir werden es so oder so nicht wissen, wenn wir einfach hier bleiben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360115
					]
				},
				{
					"id": 751360115,
					"content": "Du hast recht, wir müssen jetzt los. Vielleicht wartet sie schon an Bord der Tonatiuh auf uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360116,
					"content": "Na dann los!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
