			},
			"dialogs": [
				{
					"id": 105011101,
					"content": "Diese Suppe mit Bambus und Fleischeinlage ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011102
					]
				},
				{
					"id": 105011102,
					"content": "Dieses Gericht mögen besonders unsere Stammgäste. Bambussprossen, frisches Fleisch und Schinken werden zusammen gekocht, bis eine kräftige Suppe entsteht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011103
					],
					"speakerTitle": "Yuhua"
				},
				{
					"id": 105011103,
					"content": "Ein paar Löffel voll in eine Schüssel mit purem, weißem Reis und ihr werdet selbst davon nicht genug bekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuhua"
				}
			]
		},
		{
