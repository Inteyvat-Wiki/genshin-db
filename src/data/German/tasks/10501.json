			},
			"dialogs": [
				{
					"id": 105011201,
					"content": "Ich nehme alles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011202
					]
				},
				{
					"id": 105011202,
					"content": "Alles? Wir sind doch aber nur drei ... nein, warte, zweieinhalb! Das ist doch viel zu viel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011203
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011203,
					"content": "Paimon gilt als ganze Person! Außerdem habe ich noch gar nicht bestellt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011204,
					"content": "Eichhörnchenfisch, kalte Geflügelhäppchen und Juwelensuppe, bitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011205,
					"content": "Sehr wohl. Und was darf ich dir bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011206
					],
					"speakerTitle": "Yuhua"
				},
				{
					"id": 105011206,
					"content": "Ich würde gern wissen, wie viel das bisher kosten würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011207,
					"content": "Hmm, um die zwanzigtausend Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011208
					],
					"speakerTitle": "Yuhua"
				},
				{
					"id": 105011208,
					"content": "Also, ich hätte dann gern ... eine Schüssel Nudeln mit Gemüse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011209,
					"content": "Aber gern, eine Schüssel Nudeln für die Dame. Bitte einen Moment Geduld, wir werden alles vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011210
					],
					"speakerTitle": "Yuhua"
				},
				{
					"id": 105011210,
					"content": "Paimon findet es ein wenig seltsam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011211,
					"content": "Warum hat sie nur eine Schüssel Nudeln bestellt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011212
					]
				},
				{
					"id": 105011212,
					"content": "Hat sie vielleicht wirklich kein Geld?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011213,
					"content": "Ich bin immer noch anwesend! Ich habe gesagt, ich lade euch ein. Da sind ein paar Mora mehr oder weniger auch keine Sache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011214,
					"content": "Als Astrologe sollte man sich auf die Sterne konzentrieren und sich nicht von trivialen Geldangelegenheiten aufhalten lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011215
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011215,
					"content": "Man sollte sich besonders davor in Acht nehmen, Mora zu verwenden, um sich kurzfristige Freude zu erkaufen. Das ist sowohl geschmacklos ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011216
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011216,
					"content": "*grummel*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011217,
					"content": "Als auch gefährlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011218
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011218,
					"content": "Es gehört also auch zur Würde eines Astrologen nicht mitzuessen? Das verstehe, wer will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011219,
					"content": "Unangenehm ist es dann natürlich schon, wenn wir uns hier die Bäuche vollschlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011220,
					"content": "Mal sehen, was ich da tun kann.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011221
					]
				},
				{
					"id": 105011221,
					"content": "Oh, da hast du recht! ... Warte kurz auf uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
