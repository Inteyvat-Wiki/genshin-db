				{
					"id": 105011401,
					"content": "Ihr müsst euch meinetwegen nicht so anstrengen. Ich bin überhaupt nicht hungrig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011402
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011402,
					"content": "Also ein bisschen schon, aber ... eben nicht allzu sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 1050115,
			"completionStepIds": [
				1050105,
				1050111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
