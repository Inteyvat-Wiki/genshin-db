			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010501,
					"content": "Na, was sagt ihr dazu? Dieses Mal sollte ich euren Erwartungen doch gerecht geworden sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010502,
						105010503
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010502,
					"content": "Dein Kampfstil ist beeindruckend!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010504
					]
				},
				{
					"id": 105010504,
					"content": "Für Astrologen gehört das zum Einmaleins der Künste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010505
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010505,
					"content": "Lügen sind nutzlos im Angesicht der Astrologie. Das Schicksal und die Wahrheit stehen in den Sternen geschrieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010506,
					"content": "Ich mag zwar ein bisschen Zeit benötigen, um Einzelheiten zu erkennen. Eine ungefähre Vorstellung bekomme ich aber recht schnell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010507
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010507,
					"content": "Du scheinst dich aber doch hin und wieder zu irren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010508,
					"content": "Das liegt einfach daran, dass die Sterne von Teyvat aus gesehen nur das Schicksal und die Wahrheit dieser Welt zeigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010509
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010509,
					"content": "Alles, was mit euch zu tun hat, ist mir mehr oder weniger ein Rätsel, das ich nicht lösen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010510,
					"content": "Genau aus diesem Grund muss ich diesen Nachfolger finden. Nur gemeinsam können wir es schaffen, einen Blick in dein Schicksal zu werfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010511,
						105010512
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010511,
					"content": "Ich bin schon ganz aufgeregt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010513
					]
				},
				{
					"id": 105010513,
					"content": "Was auch dabei herauskommen sollte, es schadet keinem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010514,
					"content": "Na gut, ich bin ausgeruht. Wir können sofort nach <color=#00E1FFFF>Mondstadt</color> aufbrechen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010515
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010515,
					"content": "Wenn wir einen Wagen hätten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010516,
					"content": "Hast du nicht gesagt, du wärst nicht müde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010512,
					"content": "Ich hege keinerlei Hoffnung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010513
					]
				},
				{
					"id": 105010503,
					"content": "Du hast die Banditen durchschaut!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010504
					]
				}
			]
		},
