			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai’an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010201,
					"content": "Hallo, wie kann ich euch helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010202
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 105010202,
					"content": "Wir würden gern ein Weilchen eure Küche in Anspruch nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010203,
						105010204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010203,
					"content": "Meine Freundin hätte gern ein besonderes Gericht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				},
				{
					"id": 105010205,
					"content": "Aber natürlich, gar kein Problem. Solange ihr eure eigenen Zutaten mitbringt, könnt ihr die Küche gern benutzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010206
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 105010206,
					"content": "Wenn mir die Frage erlaubt ist ... Bist du sehr geübt in der Kunst des Kochens?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010207,
						105010209
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 105010207,
					"content": "Natürlich, bei mir wird alles „lecker“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010208
					]
				},
				{
					"id": 105010208,
					"content": "Haha, das klingt großartig! Ich hätte da einen kleinen Vorschlag ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 105010211,
					"content": "Deiner Kleidung nach zu urteilen kommst du nicht von hier. Aber da du schon einmal in Liyue bist, willst du dich an der Küche hier probieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010212
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 105010212,
					"content": "Ich habe ein Rezept für „Goldkrebs“ dabei. Das ist ein traditionelles Gericht der Yue-Küche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010213
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 105010213,
					"content": "Ein in Mehl gewendeter, dann frittierter und zu guter Letzt mit Ingwer und Knoblauch angebratener Krebs, der auf einem Teller serviert aussieht, als läge er auf goldenem Grund.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010214
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 105010214,
					"content": "G... Goldkrebs!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010215,
						105010216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010215,
					"content": "Das klingt ein wenig kompliziert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010217,
					"content": "#Goldkrebs! {NICKNAME}, Goldkrebs!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010218,
						105010219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010218,
					"content": "Ja, ich hab’s verstanden, Goldkrebs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010220,
					"content": "Ehehe, dann nichts wie ab in die Küche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010221,
					"content": "Mit deinen Errungenschaften in der Küche wird das ein Kinderspiel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010219,
					"content": "Dann lern ich das Rezept eben für dich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010216,
					"content": "Extra ein neues Gericht für Mona zu lernen, ist vielleicht doch etwas ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010209,
					"content": "Nicht so richtig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010210
					]
				},
				{
					"id": 105010210,
					"content": "Haha, du bist also bescheiden! Ich hätte da einen kleinen Vorschlag ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 105010204,
					"content": "Meine Freundin hätte gern ein von mir persönlich zubereitetes Gericht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				}
			]
		},
		{
