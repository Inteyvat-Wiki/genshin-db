			"dialogs": [
				{
					"id": 105010301,
					"content": "Für mich musst du dich nicht so anstrengen. Ich bin nicht so hungrig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010302
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010302,
					"content": "Also ein bisschen schon, aber ... eben nicht allzu sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 1050104,
			"completionStepIds": [
				1050107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050107",
							"2"
						],
						"stepId": 1050107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010401,
					"content": "Endlich sind wir in Mondstadt! Hach, das war anstrengend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010402
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010402,
					"content": "Mächtiges, verstecktes Wissen zu erlangen, ist wahrlich nicht einfach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010403
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010403,
					"content": "Also Paimon ist nicht so erschöpft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010404,
					"content": "Du kannst ja auch von allein schweben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010405
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010405,
					"content": "Dann scheinen Astrologen doch nicht so viel drauf zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010406,
					"content": "Das liegt nur daran, dass du dir unter einem Astrologen etwas völlig Falsches vorstellst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010407
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010407,
					"content": "Ruht ihr euch auch hier aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010408
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010408,
					"content": "Wer bist du denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010409,
					"content": "Oh, wir sind Händler, wir gehören zusammen. Wir kommen eben aus Liyue, wo wir Geschäfte gemacht haben. Jetzt wollen wir zurück nach Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010410
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010410,
					"content": "Ihr scheint recht erschöpft zu sein. Unsere Kutsche müsste bald hier sein. Wollt ihr mit aufspringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010411,
						105010413
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010411,
					"content": "Ich fühl mich schon ein wenig erschöpft ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010412
					]
				},
				{
					"id": 105010413,
					"content": "Wird das was kosten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010414
					]
				},
				{
					"id": 105010412,
					"content": "Haha, dann komm doch einfach mit. Mit mehr Leuten hat man gleich viel mehr Spaß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010415
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010414,
					"content": "Ach, i wo! Wir sind doch auf demselben Weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010415
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010415,
					"content": "Ist nicht nötig. Geh aus dem Weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010416
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010416,
					"content": "Ich muss schon bitten! Hat die Dame ein Problem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010417
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010417,
					"content": "Jetzt verstellt euch doch nicht so. Das ist ja peinlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010418
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010418,
					"content": "Erst wartet ihr auf nette Leute, die ihr leicht hereinlegen könnt. Dann lasst ihr sie auf den Wagen steigen, den ihr irgendwo in die Einsamkeit fahrt. Am Ende habt ihr genügend Zeit, alle fein säuberlich auszurauben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010419
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010419,
					"content": "Wovon redest du bitte? Wir wollten einfach nur nett sein! Das ist also der Dank dafür!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010420
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010420,
					"content": "Wenn du nicht mit auf die Kutsche willst, dann sag es doch einfach und mach nicht so ein Theater!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010421
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010421,
					"content": "Dürfte ich dann wenigstens erfahren, was von den Dingen, die ihr mit euch tragt, alles gestohlen ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010422
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010422,
					"content": "Wenn ihr nicht hören wollt, werde ich jemanden bringen, der euch dazu bringt mir zuzuhören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010423
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010423,
					"content": "Sollten wir verlieren, geben wir euch zwanzigtausend Mora. Wenn wir gewinnen, bringen wir euch nach Liyue, wo ihr im Knast landen werdet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010424
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010424,
					"content": "Was denkt ihr? Wenn ihr einfach Geschäftsleute seid, solltet ihr doch kein Problem damit haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010425
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010425,
					"content": "Du ... Du ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010426
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010426,
					"content": "Du bist zu weit gegangen, du kleine Göre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010427
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010427,
					"content": "Keine Ahnung, wie du es herausgefunden hast. Aber wir werden dich zum Schweigen bringen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010427,
						105010428
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010428,
					"content": "Mona, pass auf!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010430
					]
				},
				{
					"id": 105010429,
					"content": "Ich werde nicht zulassen, dass ihr ihr etwas tut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010430
					]
				},
				{
					"id": 105010430,
					"content": "Ist schon gut. Das sind doch nur ein paar Banditen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010431
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010431,
					"content": "Ihr hattet doch gemeint, Astrologen wären doch nicht so toll, wie ihr gedacht hattet. Dann werde ich euch mal zeigen, was eure Meisterin draufhat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 1050105,
			"completionStepIds": [
				1050109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
