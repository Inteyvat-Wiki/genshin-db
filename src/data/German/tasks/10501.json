			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105011501,
					"content": "Oh, das duftet ja wie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011502,
						105011504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011502,
					"content": "Etwas, das zu deinen Nudeln passt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011503
					]
				},
				{
					"id": 105011503,
					"content": "Ich hatte nichts so Aufwendiges erwartet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011506,
					"content": "#Aber ich verstehe, dass {F#meine Schülerin}{M#mein Schüler} viel Aufwand investiert hat, und werde daher diese Geste annehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011507
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011507,
					"content": "Ach, du meine Güte! Ist das lecker! Das ist das Beste, was ich je gegessen habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011508
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011508,
					"content": "#A... Aber ich will damit ausdrücken ... Wer hätte gedacht, dass {F#meine Schülerin eine so begabte Köchin}{M#mein Schüler ein so begabter Koch} ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011509,
						105011510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011509,
					"content": "Hauptsache ist, dass du satt wirst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011511
					]
				},
				{
					"id": 105011511,
					"content": "Das sind nicht umsonst Delikatessen aus Liyue, wirklich wundervoll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011512
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011512,
					"content": "Alles in Allem hab ich kein so schlechtes Gewissen mehr, all das Geld ausgegeben zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011513
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011513,
					"content": "Ach, nichts weiter! Jetzt, da wir satt sind, können wir wieder abdampfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011514,
					"content": "Wenn wir von hier aus nach Norden gehen, sollten wir auf das <color=#00E1FFFF>Steintor</color> treffen. Von dort aus gehen wir dann weiter in das Gebiet von Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011515
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011515,
					"content": "Was ich wohl für arkanes Wissen erlangen werde? Hehe, ich bin schon sehr aufgeregt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011510,
					"content": "Du scheinst es regelrecht zu genießen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011511
					]
				},
				{
					"id": 105011504,
					"content": "Das haben wir extra für dich zubereitet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011505
					]
				},
				{
					"id": 105011505,
					"content": "Das ist einfach unglaublich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011506
					],
					"speakerTitle": "Mona"
				}
			]
		},
