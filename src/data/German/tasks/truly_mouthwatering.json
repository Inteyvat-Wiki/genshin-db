			"dialogs": [
				{
					"id": 741210601,
					"content": "Hmpf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210602
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210602,
					"content": "*seufz* ... Nein ... Das ist die neuste Schönheitsbehandlung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210603
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210603,
					"content": "... Boah, seit wann seid ihr hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210604,
					"content": "Wir machen einen Spaziergang. Das Spazieren ... ist eine Art der Bewegung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210605
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210605,
					"content": "Bewegung bewirkt Verschiebung. Verschiebung hat uns hierher gebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210606
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210606,
					"content": "Habt ihr das gemacht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210607
					]
				},
				{
					"id": 741210607,
					"content": "Und wenn ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210608
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210608,
					"content": "#Hunter, jetzt erinnere ich mich. Schau {M#ihn}{F#sie} dir genauer an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210609
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210609,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210610
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210610,
					"content": "#Es ist {M#derjenige}{F#diejenige}, {M#den}{F#die} er erwähnt hat. {M#Er}{F#Sie} darf auf keinen Fall provoziert werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210611
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210611,
					"content": "Stimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210612
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210612,
					"content": "Was redet ihr da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210613,
					"content": "Nichts Besonderes, wir machen nur einen Spaziergang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210614
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210614,
					"content": "Richtig. Wir machen nur einen Spaziergang. Wenn es sonst nichts gibt, werden wir einfach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210615
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210615,
					"content": "... Woanders spazieren gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210616
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210616,
					"content": "Was? Ihr müsst mir nichts Schlimmes antun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210617
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210617,
					"content": "Die Lektion sollte genug gewesen sein, wenn du verstehst, was ich meine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210618
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210618,
					"content": "Welche Lektion?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210619
					]
				},
				{
					"id": 741210619,
					"content": "Nichts. Ich meine, Grillhähnchen ist gefährlich und kann zu Problemen führen. Nimm das als eine wertvolle Lektion. Gehen wir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210620
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210620,
					"content": "Aber das Grillhähnchen ... Debord ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210621
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210621,
					"content": "Vergiss das Grillhähnchen! Wir sollten weitergehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210622
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210622,
					"content": "„Nächstes Mal soll uns Sonny zu einem Grillhähnchen einladen.“\\nsagte Turner und führte Hunter weg.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741210623
					]
				},
				{
					"id": 741210623,
					"content": "Danke euch! Danke! Ich wusste, dass ihr versteht, was ich meine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210624
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210624,
					"content": "#Es scheint wirklich so zu sein, wie {NICKNAME} gesagt hat ... Wir graben jetzt Henri aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210625,
					"content": "Aber es ist eine anstrengende Arbeit, also nehmen wir das Grillhähnchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210626,
					"content": "Was? Argh ... Ich kann wohl nicht nein sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210627
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210627,
					"content": "Es hat eine Weile gedauert, bis ihr Henri aus dem Sand ausgegraben und aus dem Fass geholt habt, in dem er war.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741210628
					]
				},
				{
					"id": 741210628,
					"content": "Du fängst mit Paimon an, das aromatische Grillhähnchen zu essen.\\nHenri sieht hungrig aus, aber er hält sein Wort und seine Würde und verlangt nicht danach.\\nPaimon hat Henri aber verstanden und bietet ihm an, das Grillhähnchen mit ihm zu teilen.\\nDie äußere Haut ist knusprig gebraten und duftet nach Fett. Äußerst köstlich!",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7412107,
