			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Henri"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2902.934,
							441.595,
							4185.005
						],
						"pointId": 5536
