					{
						"sceneId": 3,
						"position": [
							2904.566,
							441.616,
							4182.956
						],
						"pointId": 5746
					}
				]
			},
			"dialogs": [
				{
					"id": 741210701,
					"content": "... Was? Also wollten sie mich gar nicht töten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210702
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210702,
					"content": "Ach, ich kann es wohl nicht vor dir verbergen. Es stimmt, ich habe die Maschine sabotiert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210703
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210703,
					"content": "Aber warum hast du sie denn sabotiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210704,
					"content": "Natürlich weil ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210705
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210705,
					"content": "Früher führte ich ein sehr ärmliches Leben und war jeden Tag traurig. Dann lernte ich einen sehr netten Kumpel kennen, der mir gesunde Getränke gab, die mich stimulieren konnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210706
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210706,
					"content": "Er war sehr nett zu mir, also wollte ich es ihm zurückzahlen. Dann kam endlich eine Chance für mich! Mein Kumpel stellte mich einigen reichen Leuten vor und bat mich, ihnen zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210707
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210707,
					"content": "Es waren alles kleine Aufgaben, wie das Sammeln von mechanischen Teilen aus dem Forschungsinstitut Fontaine. Im Gegenzug gaben sie mir eine Menge Geld.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210708
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210708,
					"content": "Klingt nach einer guten Arbeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210709,
					"content": "Absolut! Diesmal ließen sie mich diese merkwürdigen Maschinen finden, die Kerne herausnehmen und ihnen bringen. Natürlich muss ich hart arbeiten! Einerseits, um es meinem Kumpel zurückzuzahlen, und andererseits, um Geld zu verdienen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210710
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210710,
					"content": "Doch diese Kerle ... Es gefiel ihnen nicht, wenn ich hart arbeitete, um Geld zu verdienen und mein Schicksal in die Hand zu nehmen. Also geboten sie mir Einhalt und warnten mich davor, ihnen diese wissenschaftlichen Präzisionsteile zu geben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210711
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210711,
					"content": "Aber ich blieb hart! Ich habe nicht nur die Arbeit angenommen, sondern mich auch gegen ihre Brutalität aufgelehnt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210712
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210712,
					"content": "Dann, wie ihr sagtet, wurde mir eine Lektion erteilt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210713
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210713,
					"content": "Oh, das ist wirklich schade ... Ist denn die Arbeit tatsächlich so einträglich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210714,
					"content": "Selbstverständlich. Darum wollte ich euch vorher nicht verraten, wogegen ich protestiere. Aber immerhin seid ihr ja diejenigen, die mir das Leben gerettet haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210715
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210715,
					"content": "Es ist ja nicht so, dass dein Leben in Gefahr ist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210716
					]
				},
				{
					"id": 741210716,
					"content": "... Andererseits scheint mir, dass ich es nicht vor euch verheimlichen kann, also kann ich es euch doch auch einfach sagen. Lasst uns doch einfach Partner sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210717
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210717,
					"content": "Also, auf dem Land und unter Wasser haben Leute eine Art von seltsamen Maschinen aufgestellt. Du kannst sie an dem sonderbaren Lichtschein erkennen, der sie umgibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210718
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210718,
					"content": "Zerstöre sie und bring mir diese besonderen Kerne darin. Insgesamt <color=#00E1FFFF>brauche ich sieben davon</color>. Anschließend teilen wir uns die Belohnung hälftig. Abgemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210719,
						741210721,
						741210722
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210719,
					"content": "Das klingt nicht schlecht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210720
					]
				},
				{
					"id": 741210720,
					"content": "Hm, aber wofür sind denn diese Maschinen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210725,
					"content": "Sie kann die Umwelt schädigen und ist eine höchst abscheuliche Maschine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210726
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210726,
					"content": "Auf welche konkrete Art und Weise kann sie denn die Umwelt schädigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210727,
					"content": "Woher soll ich das wissen? Ich arbeite nicht am Forschungsinstitut Fontaine. Jedenfalls muss sie schlecht für die Umwelt sein, wenn sie Anomalien erzeugt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210728
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210728,
					"content": "Ja ... Ganz verkehrt klingt das nicht. Jedes Mal, wenn wir bei unseren Abenteuern unterwegs ein unerklärliches übernatürliches Phänomen sehen, passiert irgendetwas Schlimmes, das wir in Ordnung bringen müssen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210729,
					"content": "#{NICKNAME}, los, wir helfen Henri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210730,
					"content": "Haha, ja. Dann ist es abgemacht! <color=#00E1FFFF>Bring mir sieben Kerne</color>, dann können wir zusammen ein Vermögen machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210721,
					"content": "Wofür sind diese Maschinen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210725
					]
				},
				{
					"id": 741210722,
					"content": "Ich will zwanzig Prozent mehr, und du musst mir diesen Teil im Voraus bezahlen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210723
					]
				},
				{
					"id": 741210723,
					"content": "... Na schön, aber ich kann dich nicht im Voraus bezahlen. Du musst mir erst die Teile besorgen, damit ich von meinem Chef bezahlt werden kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210724
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210724,
					"content": "Hm, aber wofür sind denn diese Maschinen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210725
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
