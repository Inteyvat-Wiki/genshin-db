			},
			"dialogs": [
				{
					"id": 741210101,
					"content": "Danke schön! Danke schön! Ihr seid meine Retter! Ich, Henri, werde das nie vergessen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210102
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210102,
					"content": "Ist schon gut. Davon abgesehen ist Paimon eher neugierig darauf, wie du bloß in diese Situation geraten bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210103,
					"content": "*seufz* Die Krebse müssen vom Geruch des Grillhähnchens angelockt worden sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210104
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210104,
					"content": "Der Geruch des Grillhähnchens hat auch Paimon hierher angezogen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210105,
					"content": "Krebse sind überhaupt nicht wie du! Schau mal, sie überlegen wahrscheinlich, ob sie zuerst mich oder das Grillhähnchen essen sollen, und hoffentlich kommen sie nicht zu dem Schluss, dass es besser ist, das frischere Gericht zu essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210106,
						741210109
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210106,
					"content": "Eine vernünftige Entscheidung, je frischer, desto besser.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210107
					]
				},
				{
					"id": 741210107,
					"content": "Ah, Paimon ist eher neugierig auf Henri! Normalerweise werden Menschen nicht auf diese Weise im Boden begraben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210108,
					"content": "Also, brauchst du Hilfe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210111,
					"content": "Natürlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210112
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210112,
					"content": "Äh ... Natürlich nicht, ihr beiden! Grabt mich nicht aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210113
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210113,
					"content": "#Waah! Paimon versteht, Paimon versteht! Wir können dich hören, nicht so laut! Hmpf, {NICKNAME}, gehen wir weiter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210114,
					"content": "Wartet! Bitte wartet einen Moment ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210115
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210115,
					"content": "Und? Was ist denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210116,
					"content": "Ich ... Ähem, die Sache sieht so aus! Hört zu, ihr zwei! Was ihr hier seht, ist eine neu erfundene Schönheitsbehandlung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210117
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210117,
					"content": "Paimon sagte doch, du musst nicht schreien. Es ist so laut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210118,
					"content": "Seid nicht argwöhnisch! Ich bin ein vernünftiger Mensch, der diese wissenschaftliche und gesunde Methode der Schönheitsbehandlung gewählt hat! Ich habe mich aus eigener Kraft im feuchten Sand eingegraben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210119
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210119,
					"content": "Geht mir bitte aus dem Weg! Und blockiert nicht meine Sonnenstrahlen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210120
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210120,
					"content": "Äh, dann lass uns gehen ... oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210121,
					"content": "Also interessiert es euch doch! Dann kann ich nichts dagegen tun! So lasst mich euch bitte die Wunder dieser Schönheitsbehandlung erläutern! Äh, Sandwürmer und andere Tiere in der sandigen Erde können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210122
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210122,
					"content": "#(Argh, er ist so laut. {NICKNAME}, was ist denn nur los mit dem Kerl? Seine Worte passen nicht zusammen ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210123,
					"content": "(Irgendwie fühlt sich das komisch an ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210124
					]
				},
				{
					"id": 741210124,
					"content": "(Ja? Hast du eine Idee?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210125,
					"content": "(Schauen wir uns mal in der Nähe um.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210126
					]
				},
				{
					"id": 741210126,
					"content": "He! Wollt ihr schon gehen ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210127
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210127,
					"content": "Wir wollen uns erst etwas umsehen. Dann gehen wir wieder zu dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210128,
					"content": "Ja, gut! Los geht’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210109,
					"content": "Ich möchte wirklich wissen, warum du im Boden begraben bist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210110
					]
				},
				{
					"id": 741210110,
					"content": "Stimmt! Brauchst du Hilfe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
