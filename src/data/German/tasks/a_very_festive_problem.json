						],
						"stepId": 4134001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kräuterkundler Gui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400101,
					"content": "#Verzeih, dass ich dich trotz des Fests störe, {F#Reisende}{M#Reisender}, aber wir sind derzeit unterbesetzt. Zu jedem Laternenritual häufen sich die Krankmeldungen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400102
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400102,
					"content": "Warum geschieht das bloß ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400103
					]
				},
				{
					"id": 413400103,
					"content": "Während des Laternenrituals legen alle die Arbeit beiseite, um Zeit mit der Familie zu verbringen. Natürlich kommt es überall zu Banketten mit feinen Speisen und Getränken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400104
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400104,
					"content": "Darum tritt auch die ein oder andere Magenverstimmung auf, neben einigen anderen Wehwehchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400105
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400105,
					"content": "Ich rate den Leuten zwar, sich ein wenig zu zügeln, doch bei so einem Anlass stoße ich auf taube Ohren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400106
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400106,
					"content": "Ein paar Haushalte baten mich bereits um Mittel gegen Verdauungsbeschwerden, doch ich kann die Bubu-Hütte nicht einfach so verlassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400107
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400107,
					"content": "#{F#Reisende}{M#Reisender}, wäre es in Ordnung für dich, die Medikamente auszuliefern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kräuterkundler Gui"
				}
			]
		},
		{
			"id": 4134002,
			"completionStepIds": [
				4134003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
