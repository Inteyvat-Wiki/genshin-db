			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kräuterkundler Gui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400401,
					"content": "Danke für deine Mühe. Wurden alle Medikamente ausgeliefert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400402,
						413400403
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400402,
					"content": "So wie ich das sehe, haben sie es nicht gelernt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400404
					]
				},
				{
					"id": 413400404,
					"content": "Tja, so ist es nun mal. Wer nicht auf seinen Lebensstil achtet, dessen Darmbeschwerden sind nicht zu heilen. Wir können bloß die Symptome behandeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400405
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400405,
					"content": "Doch zumindest meine Aufgabe ist nun erfüllt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400406
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400406,
					"content": "Also, wegen der Laternen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400407
					]
				},
				{
					"id": 413400407,
					"content": "Oh, das Laternensteigen? Wir ... beteiligen uns nicht daran. Die Laternen bergen Wünsche, aber was sollte die Bubu-Hütte für einen Wunsch haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400408
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400408,
					"content": "Andere Geschäfte wünschen sich höhere Umsätze, doch eine Apotheke soll heilen und retten. Diesen Wunsch sollten wir darum nicht hegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400409,
						413400410
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400409,
					"content": "Du hast ein gutes Herz, Gui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400411
					]
				},
				{
					"id": 413400411,
					"content": "Aber was mich persönlich betriftt, würde ich gerne mitmachen. Schließlich ist es ein Fest ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400412
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400412,
					"content": "Doch ich konnte noch keine Laterne flechten. Ich war in den letzten Tagen viel zu beschäftigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400413
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400413,
					"content": "In meinen kurzen Pausen kann ich bloß ein wenig daran herumbasteln. Wenn ich damit fertig bin, ist das Laternenritual vorbei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400414
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400414,
					"content": "Ich kann dir helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400415
					]
				},
				{
					"id": 413400415,
					"content": "Das würdest du wirklich? Danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400410,
					"content": "Du bist eine ehrliche Haut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400411
					]
				},
				{
					"id": 413400403,
					"content": "Diese Mittelchen halten nicht ewig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400404
					]
				}
			]
		},
