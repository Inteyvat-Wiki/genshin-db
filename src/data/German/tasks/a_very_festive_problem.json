			},
			"dialogs": [
				{
					"id": 413400701,
					"content": "Da bist du ja. Ich habe meinen Wunsch niedergeschrieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400702
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400702,
					"content": "Du kommst gerade recht ... Lassen wir die Laterne aufsteigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400801
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400801,
					"content": "Was meinen Wunsch angeht ... Letzten Endes habe ich allen in Liyue gute Gesundheit gewünscht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400802
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400802,
					"content": "Und was die Bubu-Hütte angeht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400803
					]
				},
				{
					"id": 413400803,
					"content": "Nun, dieser Wunsch ist persönlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400804
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400804,
					"content": "Ich denke mir Rezepte aus, um zu verhindern, dass jemand von Krankheit geplagt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400805
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400805,
					"content": "Es gilt der alte Spruch: „Ich wünsche mir, dass niemand sich mit Krankheit plagen muss, wie viel Staub sich auch auf unseren Regalen sammelt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400806
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400806,
					"content": "Wären alle gesund, bliebe mir mehr Freizeit. Und wenn du mich fragst, wäre das schön ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400807
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400807,
					"content": "Oh, warte! Da fällt mir ein, dass eine Person ihr Mittel noch nicht erhalten hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400808
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400808,
					"content": "Tut mir leid, aber ich muss zuerst handeln! Ein frohes Laternenritual!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kräuterkundler Gui"
				}
			]
		},
