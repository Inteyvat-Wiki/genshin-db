							"4134001",
							"3"
						],
						"stepId": 4134001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400201,
					"content": "Argh, ich muss etwas Schlechtes gegessen haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400202
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400202,
					"content": "Hier sind einige Medikamente vom Kräuterkundler Gui ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400203
					]
				},
				{
					"id": 413400203,
					"content": "Oh, vielen Dank. Das ist das Mittel gegen Magenbeschwerden, um das ich ihn bat, oder? Mein Magen fühlt sich einfach schrecklich an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400204
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400204,
					"content": "Als ich durch die Straßen schlenderte, gönnte ich mir einen Imbiss nach dem anderen. Bevor ich mich versah, war ich vollgefressen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400205
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400205,
					"content": "Was genau hast du gegessen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400206
					]
				},
				{
					"id": 413400206,
					"content": "Hmm, gebratenen Reis, rohen Fisch, Früchte und jede Menge Garnelen ... Ah, und exzellenten Wein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400207,
						413400208
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400207,
					"content": "Tja, kein Wunder.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400209
					]
				},
				{
					"id": 413400209,
					"content": "Na ja, dazu gibt es ja Medikamente, oder? Wozu so ein Fest, wenn man nicht essen kann, worauf man Lust hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400210
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400210,
					"content": "Aber danke fürs Überbringen der Mittel. Ich sollte mich jetzt lieber ausruhen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400208,
					"content": "Du solltest dich nicht so gehen lassen, nur weil ein Fest stattfindet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400209
					]
				}
			]
		},
		{
			"id": 4134003,
			"completionStepIds": [
				4134004
