			},
			"dialogs": [
				{
					"id": 413400601,
					"content": "Die Laterne ist so robust wie schön geformt. Ha, im Vergleich zu mir bist du viel geschickter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400602
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400602,
					"content": "Wenn das so ist, sollten wir die Laterne später am Abend steigen lassen. Ich kenne ein gutes Plätzchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400603
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 413400603,
					"content": "Bis dahin sollte ich mir einen Wunsch einfallen lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kräuterkundler Gui"
				}
			]
		},
