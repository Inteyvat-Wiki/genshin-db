			"dialogs": [
				{
					"id": 722420401,
					"content": "Es gibt also einen riesigen Raum unter Watatsumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420402,
					"content": "Es sieht so aus, als sollten wir diesen Platz in der Mitte anstreben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420403,
					"content": "#Nun, {NICKNAME}, lass uns einfach stetig vorwärts gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420404,
					"content": "Die Ruinen dort drüben sehen näher aus, also sollten wir mit der Erkundung dort beginnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420405,
					"content": "Das Vorhandensein eines Gebäudes bedeutet, dass jemand dort war, und wenn jemand dort war, hätte er diese Art von Notiz hinterlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420406,
					"content": "An solchen Orten mit viel Papier ist es am einfachsten, Hinweise zu finden, die man einfach nicht lesen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
