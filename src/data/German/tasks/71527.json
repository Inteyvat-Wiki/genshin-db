			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Überlegen ausgerüstete Kandidatin“"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-347.962,
							200.495,
							-711.101
						],
						"pointId": 7028
					}
				]
			},
			"dialogs": [
				{
					"id": 716664001,
					"content": "Hallo! Ich bin wieder da! Wie läuft das „Arataki-Ausbildungslager zum Flammenpanzer-Käferkampf“ ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664002
					],
					"speakerTitle": "„Überlegen ausgerüstete Kandidatin“"
				},
				{
					"id": 716664002,
					"content": "Du kommst gerade rechtzeitig, Yanfei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716664003,
					"content": "Meine Retterin! Danke für die Hilfe mit der Genehmigung! Und für das Schild mit dem genialen Kunstwerk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664004,
					"content": "Warte, ich kenne diesen Blick ... Hast du auch Lust, äh ... ein paar Käfer umzuhauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664005
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664005,
					"content": "Hä? Ist daran etwas nicht in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664006
					],
					"speakerTitle": "„Überlegen ausgerüstete Kandidatin“"
				},
				{
					"id": 716664006,
					"content": "Eine Großkundin von mir ist viel im grenzüberschreitenden Handel tätig ... Nun, einmal, als ich ihr mit einem wichtigen Gerichtsprozess aushalf, überhäufte sie mich mit Geschenken. Unter denen befand sich auch ein ganz außergewöhnlicher Onikabuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664007
					],
					"speakerTitle": "„Überlegen ausgerüstete Kandidatin“"
				},
				{
					"id": 716664007,
					"content": "Ich hatte damals keine Ahnung, wie ich mich um ihn kümmern sollte, also trug ich es für eine Weile Madame Ping auf. Inzwischen ist er offensichtlich ganz schön kräftig geworden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664008
					],
					"speakerTitle": "„Überlegen ausgerüstete Kandidatin“"
				},
				{
					"id": 716664008,
					"content": "Macht es euch etwas aus, wenn ich teilnehme? Ihr habt doch nicht etwa Angst, dass ich euch einenge, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664009
					],
					"speakerTitle": "„Überlegen ausgerüstete Kandidatin“"
				},
				{
					"id": 716664009,
					"content": "Wir sollten deine Retterin nicht abweisen, Oni-König. Was ihr an Erfahrung fehlt, macht sie mit ihrem robusten und Furcht einflößenden Onikabuto wieder wett.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664010
					],
					"speakerTitle": "„Marschall Hanakado“"
				},
				{
					"id": 716664010,
					"content": "Wie könnte ich dieses Angebot ablehnen ...!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664011
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664011,
					"content": "#So, es ist an der Zeit, die treue rechte Hand des Oni-Königs und scharlachroter Stößel hineinzuschicken. Ich weiß, {M#mein Freund}{F#meine Freundin} kann auch unter Druck die Nerven behalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664012,
						716664013
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664012,
					"content": "Aber hallo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				},
				{
					"id": 716664014,
					"content": "#Es treten also {NICKNAME} und ich gegeneinander an, ja? Fein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664015
					],
					"speakerTitle": "„Überlegen ausgerüstete Kandidatin“"
				},
				{
					"id": 716664015,
					"content": "Ich habe dieses Spiel noch nicht ganz durchschaut. Also entschuldige ich mich schon im Voraus für jegliche Patzer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Überlegen ausgerüstete Kandidatin“"
				},
				{
					"id": 716664013,
					"content": "Danke für das Kompliment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				}
			]
		},
