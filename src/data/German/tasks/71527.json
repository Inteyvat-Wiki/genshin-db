						],
						"pointId": 7028
					}
				]
			},
			"dialogs": [
				{
					"id": 716664101,
					"content": "Yanfeis Onikabuto wirkt so stark! Womit Madame Ping ihn wohl gefüttert hat ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716664102,
					"content": "Siehst du? Der Onikabuto deiner Retterin ist eine Verstärkung, mit der zu rechnen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664103
					],
					"speakerTitle": "„Marschall Hanakado“"
				},
				{
					"id": 716664103,
					"content": "Aber genauso wie beim letzten Mal, als meine Generäle dich aus dem Konzept brachten, kann auch das mächtigste Schwert sein Ziel nur dann treffen, wenn es von einer geübten Hand geführt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664104
					],
					"speakerTitle": "„Marschall Hanakado“"
				},
				{
					"id": 716664104,
					"content": "#Wei... Weise Worte, Marschall ... Ähm, zum Glück hat {M#mein Freund}{F#meine Freundin} einen kühlen Kopf bewahrt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664105,
					"content": "Wah, was für ein Schlag! Langsam gefällt mir diese Käferkampf-Sache!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664106
					],
					"speakerTitle": "„Überlegen ausgerüstete Kandidatin“"
				},
				{
					"id": 716664106,
					"content": "Es ist die reine Freude! Danke euch allen! Ich werde bleiben und noch eine Weile weiter spielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Überlegen ausgerüstete Kandidatin“"
				}
			]
		},
