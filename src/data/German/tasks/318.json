			"dialogs": [
				{
					"id": 3180201,
					"content": "Oh, sag mal, hast du ... diese Geo-Kraft gespürt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3180202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3180202,
					"content": "Echt auffällig, dass du nicht so wie die Leute mit einem „Göttlichen Auge“ bist! Du kannst das Element, zu dem du neigst, verändern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3180203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3180203,
					"content": "Das scheint ganz wie in Mondstadt zu sein. Du musst nur vor einer Statue der Sieben beten, um eine Antwort zu bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3180204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3180204,
					"content": "Ja, wir sind hier in Liyue, dem Gebiet des Geo-Archons. Deswegen sieht die Statue auch anders aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3180205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3180205,
					"content": "Wenn du doch lieber die Anemo-Kraft kontrollieren willst, solltest du mal wieder in Mondstadt vorbeischauen und zu einer Statue dort gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
