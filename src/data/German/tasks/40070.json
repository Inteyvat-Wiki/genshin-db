			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Entflammtes Herz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400700401,
					"content": "Einige der Berge auf der Insel haben ihre Vegetation und Wasseradern verloren. Hast du eine Möglichkeit, sie wieder freizulegen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700402
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400700402,
					"content": "Ich kenn jemanden, der hier helfen kann. Oben haust mein Kumpel Gefrorenes Herz, geh und frag ihn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Entflammtes Herz"
				}
			]
		},
		{
			"id": 4007005,
			"completionStepIds": [
				4007005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007005",
							"2"
						],
						"stepId": 4007005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gefrorenes Herz",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400700501,
					"content": "Wer seid ihr Leute? Wie könnt ihr es wagen, in mein Haus einzudringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700502
					],
					"speakerTitle": "Gefrorenes Herz"
				},
				{
					"id": 400700502,
					"content": "Hallo, wir würden gern deine Kräfte leihen, um die Berge auf der Insel freizulegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700503
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400700503,
					"content": "Berge? Oh, ich verstehe ... Ihr wollt auch große Musiker werden, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700504
					],
					"speakerTitle": "Gefrorenes Herz"
				},
				{
					"id": 400700504,
					"content": "Oh, wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400700505,
					"content": "Genau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700506
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400700506,
					"content": "In diesem Fall sind wir Gleichgesinnte. Auch wenn ich schwächlich bin, werde ich euch meine Kraft leihen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700507
					],
					"speakerTitle": "Gefrorenes Herz"
				},
				{
					"id": 400700507,
					"content": "Nimm mein Blütenblatt und pflanze es am Ende des Aufeinandertreffens der Töne. Die Berge, die im Boden versunken sind, werden sich zum Klang dieser Musik erheben. Solange wir Musik haben, wird das Leben durch alle Winkel der Erde fließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700508
					],
					"speakerTitle": "Gefrorenes Herz"
				},
				{
					"id": 400700508,
					"content": "... Danke dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4007010,
			"completionStepIds": [
				4007010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007010",
							"2"
						],
						"stepId": 4007010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Mona",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701001,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701002
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701002,
					"content": "Endlich ist es so weit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701003
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701003,
					"content": "Leute, ich hatte mir ein Konzert mit jemandem gewünscht, den sich niemand hätte vorstellen können. Und heute habe ich die Antwort auf der Insel gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701004
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701004,
					"content": "Die Person, die diese Insel vor vielen Jahren in ein riesiges Musikinstrument verwandelt hat, niemand kennt ihren Namen oder weiß, wie sie aussah, aber sie war definitiv einer der größten Musiker von Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701005
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701005,
					"content": "Ich hätte nie gedacht, dass ich ein solches Instrument sehen würde. Ganz zu schweigen davon, es zu spielen, während die Gezeiten steigen und fallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701006
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701006,
					"content": "Bereit für Rock ’n’ Roll?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701007
					]
				},
				{
					"id": 400701007,
					"content": "Nein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701008
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701008,
					"content": "Musik ist ein Geschenk an Vertraute, also ... würde ich eine angemessenere Methode wählen, um mit dieser eingeborenen Person zu spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701009
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701009,
					"content": "Heute ist Schluss mit Rock ’n’ Roll, ich zeige euch was Neues!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701010
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701010,
					"content": "Puh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701011
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701011,
					"content": "Wieso? Ich spiele doch nicht zu schlecht, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701012
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701012,
					"content": "Ausgezeichnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701013
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701013,
					"content": "So ein Ensemble habe ich noch nie gehört. Es war sehr interessant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701014
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701014,
					"content": "Und es ist elegant! Paimon weiß nicht, wie man es sagen soll ... Es ist auf jeden Fall anders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701015,
						400701016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701015,
					"content": "Eine sehr charakterstarke Leistung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				},
				{
					"id": 400701017,
					"content": "Hehe, danke an alle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701018
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701018,
					"content": "Somit wurde mein Wunsch erfüllt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701019
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701019,
					"content": "Möchtest du noch etwas tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701020
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701020,
					"content": "Nicht mehr. Ich sollte heute Nacht gut schlafen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701021
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701021,
					"content": "Jetzt haben wir alle Zeit, oder? Dann habe ich einen Vorschlag.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701022
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701022,
					"content": "Ich würde gerne noch einmal zum Lager der Fatui fahren, um die dortige Lage zu bestätigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701023
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701023,
					"content": "Hm? Du hast also auch das Lager der Fatui gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701024
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701024,
					"content": "Warte, du weißt auch davon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701025
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701025,
					"content": "Ich bin eine geniale Astrologin und ich habe dir schon gesagt, dass der Wasserspiegel sich ein wenig wiederhergestellt hat. Ich kann durch Wahrsagen spüren, was hier vor sich geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701026
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701026,
					"content": "Was? Gibt es hier Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701027
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701027,
					"content": "Ja. Ich habe Fischl heute auch davon erzählt, als sie sich von uns getrennt haben. Wenn sie Fatui begegnet, wird sie sich verbergen und ist nicht in Gefahr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701028
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701028,
					"content": "So ist es also, dann lass mich auch etwas gestehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701029
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701029,
					"content": "Den anderen wird vom Lager der Fatui und dem seltsamen Apparat am Tag der Landung erzählt ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400701030
					]
				},
				{
					"id": 400701030,
					"content": "Seltsamer Apparat, wahnsinniger Fatuus ... Ihr meint, dass das etwas mit den kürzlichen Illusionen zu tun hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701031
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701031,
					"content": "Dafür gibt’s keinerlei Garantie. Aber ich denke, dass zwischen den beiden eine Verknüpfung besteht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701032
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701032,
					"content": "Stimmt, also lasst uns das Lager untersuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701016,
					"content": "Eine sehr rhythmische Performance.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				}
			]
		},
		{
			"id": 4007016,
			"completionStepIds": [
				4007016
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007016",
							"2"
						],
						"stepId": 4007016,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701601,
					"content": "Seltsam, den ganzen Weg über waren nur die einheimischen Monster auf der Insel, keine Fatui mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701602,
					"content": "Die Spuren des Lagers und der Apparat sind noch da, aber die Menschen sind weg, so seltsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701603
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701603,
					"content": "(Ich habe immer gedacht, dass die Entwicklung dieser Illusionen viel mit diesem Apparat der Fatui zu tun hat. Es sieht beschädigt aus, also ist das vielleicht die Ursache des Problems.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701604
					]
				},
				{
					"id": 400701604,
					"content": "(... Wenn der Apparat Illusionen hervorrufen kann, warum sind sie dann von selbst verschwunden? Oder geht es um etwas anderes?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701605
					]
				},
				{
					"id": 400701605,
					"content": "(Können wir sie nicht finden, weil sie verschwunden sind, oder verstecken sie sich vor uns?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701606
					]
				},
				{
					"id": 400701606,
					"content": "Vergiss es, finde es mit Hilfe einer Wahrsagung heraus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701607
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701608
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701608,
					"content": "Hm? Ist das ... Kraft, die fließt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701609
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701609,
					"content": "Leute, es scheint kein Zeichen von Fatui zu geben, der Wasserspiegel ist wieder trübe geworden, aber diesmal kann ich eine Art von Kraft spüren, die Gestalt annimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701610
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701610,
					"content": "Das Ziel ist ... die Insel dort drüben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701611
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701611,
					"content": "Mit wem ist die Illusion dieses Mal verknüpft?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701612
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701612,
					"content": "Hm ... Gehen wir rüber und schauen nach, vielleicht gibt’s ja einen Hinweis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007017,
			"completionStepIds": [
				4007017
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007017",
							"2"
						],
						"stepId": 4007017,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Mona",
					"Fischl",
					"Oz",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701701,
					"content": "Hier sind wir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701702
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701702,
					"content": "Hm? Fischl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701703
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701703,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701704
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701704,
					"content": "Das ist sie wirklich! Fischl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701705,
					"content": "... Hm, ist es bald so weit, ihr törichten Vasallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701706
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701706,
					"content": "Oh ja, das ist schon eine Weile her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701707
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701707,
					"content": "So lange hat es doch nicht gedauert, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701708
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701708,
					"content": "Ah ... Mein Fräulein und ich haben eine gewisse Aura gespürt und sind sofort hergeeilt, um euch alle zu treffen. Wir hatten nicht erwartet, dass ihr so schnell ankommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701709
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701709,
					"content": "Oz sieht etwas nervös aus ... oder geht es nur Paimon so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701710,
					"content": "Das Immernachtreich steht vor der Tür und ich muss mich noch auf die Weihezeremonie vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701711
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701711,
					"content": "Mein Fräulein, Ihr seid wieder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701712
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701712,
					"content": "Ich kann alles alleine handeln, Oz, und wenn du des Eindringens der späten Nacht überdrüssig bist, ziehe dich in das gleißende Licht des Tages zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701713
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701713,
					"content": "Mein Fräulein, solche Worte sind nichts für mich. Ich bin Euer Untergebener, Eure Augen, und kann Euch nicht zurücklassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701714
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701714,
					"content": "... Hör auf, mich mit finsteren Blicken anzuschauen! Wie auch immer, kurz gesagt, für Erklärungen bleibt keine Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701715
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701715,
					"content": "Oh, mein Fräulein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701716
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701716,
					"content": "Meine Damen und Herren, es tut mir sehr leid, aber das Fräulein ist in schlechter Stimmung. Und verzeiht mir, dass ich mich entschuldigen muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701717
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701717,
					"content": "... Ha, sie war eine ganze Weile auf sich allein gestellt und ihre Stimmung ist immer noch ziemlich schlecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701718
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701718,
					"content": "Als ich Fischl sah, dachte ich, dass die Illusion, die in diesem Gebiet Gestalt annehmen sollten, etwas mit ihr zu tun haben würden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701719
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701719,
					"content": "Genau. Ich spüre eine gewisse Vertrautheit, als ich mich der Illusion näherte, die mich beschäftigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701720
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701720,
					"content": "Ich auch. Es ergibt keinen Sinn, aber es fühlt sich so an, als ob etwas Spannendes bevorsteht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701721
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701721,
					"content": "Die Tatsache, dass Fischl und Oz etwas spüren können, bedeutet, dass sich ihr Gefühl bald bewahrheiten wird ... Fischl wollte sich ihrer Illusion einfach nicht stellen, deshalb ist sie so aufgewühlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701722
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701722,
					"content": "Wie kann das sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701723,
					"content": "Vielleicht verbirgt ihre Illusion ein Geheimnis, von dem sie nicht möchte, dass es offenbart wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701724
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701724,
					"content": "Lasst uns alle hier eine Pause einlegen. Wenn die Illusion erscheint, wird das Geheimnis natürlich gelüftet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007018,
			"completionStepIds": [
				4007018
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007018",
							"2"
						],
						"stepId": 4007018,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Mona",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701801,
					"content": "Alles, was getan werden kann, wurde getan, aber gegen die restlichen zwei Berge können wir nichts tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701802,
					"content": "Denken wir noch einmal darüber nach, es muss einen Weg geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701803
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701803,
					"content": "Ich habe mir das gerade genauer angesehen und die meisten der verschiedenen Berge auf der Insel haben Wasseradern und Gewächse in ihrem Inneren, und dieses System verbindet sie miteinander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701804
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701804,
					"content": "Aber jetzt sind die Berge in sich zusammengestürzt und die Vegetation und die Wasseradern lassen sich nicht mehr verbinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701805
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701805,
					"content": "Wenn alle Adern miteinander verbunden sind, bilden sie das, was in Albedos Notizen als „Rieseninstrument“ bezeichnet wird, das als Inseln gespielt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701806
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701806,
					"content": "Nun, das war nötig für das, was ich tun wollte ... Ich dachte, ich frage die Blume, sie wird den Weg wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4007019,
			"completionStepIds": [
				4007019
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007019",
							"2"
						],
						"stepId": 4007019,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Gefrorenes Herz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701901,
					"content": "Wir haben das Blütenblatt gepflanzt. Spürst du etwas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701902
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701902,
					"content": "Nun ... Da hast du’s. Die Sonne war schön, das Meer leuchtete wie ein Juwel, die Wellen plätscherten an den cremefarbenen Sand, die Sandkörner flossen ins Meer und wurden zurückgestoßen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701903
					],
					"speakerTitle": "Gefrorenes Herz"
				},
				{
					"id": 400701903,
					"content": "... Seevögel landen auf den Felsen, picken sanft und erzeugen rhythmische Musik. *klack* *klack* *klack* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701904
					],
					"speakerTitle": "Gefrorenes Herz"
				},
				{
					"id": 400701904,
					"content": "Das ist Musik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701905
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701905,
					"content": "Das ist Musik. Außerdem soll die Insel ein riesiges Musikinstrument sein. Da du Musiker bist, solltest du in der Lage sein, die Tiefe der Bedeutung zu verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701906
					],
					"speakerTitle": "Gefrorenes Herz"
				},
				{
					"id": 400701906,
					"content": "Musik mit Meeresbrise, Wellen und Gezeiten zu spielen, ist das Romantischste, was es gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701907
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701907,
					"content": "Kommt Leute, es wird Zeit, dass ihr euch meine Musik anhört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		}
	]
}