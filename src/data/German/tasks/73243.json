				"points": []
			},
			"dialogs": [
				{
					"id": 732431901,
					"content": "„... Hinsichtlich der Untersuchungsergebnisse in der Causa ‚Zandik‘ ... Dastur ... Todesursache ... möglicherweise Mord ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431902
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431902,
					"content": "„... ‚Zandik‘ ... nach der Auslistung ... Eleazar ... aber mangelnde Belege ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431903
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431903,
					"content": "„... Einträge plötzlich verschwunden ... Unbekanntes Jahr ... Eleazar ausgebrochen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431904
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431904,
					"content": "„... Vor dem Verschwinden ... ‚Legende von Varuna‘ ... besessen von ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431905
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431905,
					"content": "(Der folgende Inhalt ist komplett verunreinigt und man kann keinen vernünftigen Text ausmachen.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7324320,
			"completionStepIds": [
				7324320
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324320",
							"2"
						],
						"stepId": 7324320,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432001,
					"content": "„Nachdem ich das ‚Sternenlog‘ des großartigen Weisen Tabari gelesen habe, habe ich endlich erkannt, dass alles, egal ob der Krieg der Archonten oder der Zusammenbruch des alten Reichs, eine Projektion der Sterne auf die Erde ist.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432002
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732432002,
					"content": "„Das einzig Ewige ist der Sternenhimmel über uns.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432003
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732432003,
					"content": "„Hm ... Hat die Himmelskunde, außer das sogenannte lyrische Element in die ernsthafte akademische Forschung zu integrieren, noch etwas anderes erreicht, als mit ihrer Forschung die Geschehnisse der letzten tausend Jahre durcheinander zu bringen?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432004
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732432004,
					"content": "„Ich hoffe wirklich, ihr lernt die Fragen aus der historischen Perspektive zu betrachten, anstatt den ganzen Tag die Sterne wahnsinnig anzustarren.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432005
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732432005,
					"content": "„Was verstehst du schon! Das nennt man das Weltgesetz erkunden. Kein Wunder, dass ihr von Vahumana alle Buchfuzzis seid.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7324321,
			"completionStepIds": [
				7324310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324310",
							"2"
						],
						"stepId": 7324310,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"302821",
							"3"
						],
						"stepId": 302821,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432101,
					"content": "„Als internationaler Student spüre ich jeden Tag, den ich an der Akademie studiere, die Erhabenheit vom Dendro-Archon mehr.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432102
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732432102,
					"content": "„Als ich in Mondstadt war, musste ich ein Dutzend Bücher wälzen, um die verschiedenen Theorien zu einer einfachen Frage herauszufinden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432103
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732432103,
					"content": "„Aber seit ich das ‚Akasha-Kontrollgerät‘ habe, erhalte ich die passenden Informationen, wenn ich nur einen bestimmten Inhalt überdenke. Ich glaube, auf der ganzen Welt gibt es keine herrlichere Kreation als Akasha.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7324322,
			"completionStepIds": [
				7324312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324312",
							"2"
						],
						"stepId": 7324312,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"302821",
							"3"
						],
						"stepId": 302821,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432201,
					"content": "„Ich vertraue dem Urteil der Weisen und Mentoren zwar voll und ganz, aber macht sich die Akademie nicht zu abhängig von Akasha?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432202
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732432202,
					"content": "„Es ist offensichtlich, dass die akademische Kompetenz der reisenden Gelehrten, die wir aussenden, durch die Gewöhnung an Akasha als Quelle des Wissens, sinkt. Ich glaube, wir sollten die Nutzung von Akasha durch die neuen Studenten mit Regelungen einschränken.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432203
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732432203,
					"content": "„Wie kannst du das sagen. Weißt du nicht, dass diese Schulen, die sich in die Wüste zurückgezogen haben und nicht die Erleuchtung von Akasha empfangen, längst in Ignoranz und Wahn verfallen sind und sie sogar törichterweise giftige Schlangen schlucken, um Wissen zu erlangen?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432204
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732432204,
					"content": "„Ich muss euch alle daran erinnern, dass es nur Akasha ist, das unser Wissen rein hält.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7324323,
			"completionStepIds": [
				7324301
			],
