				{
					"id": 732430801,
					"content": "„In meinen Augen ist die verstärkte Implementierung von Akasha durch das Institut nicht zu drastisch sondern eher zu zurückhaltend. Ein großer Teil der Arbeit der Mahamata ist überflüssig und ineffektiv. Manche Aspekte sind sogar schlechter als zuvor.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430802
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732430802,
					"content": "„Bitte stelle dich vor, wir würden Akasha nutzen, um allen direkt ihre Aufgaben zuzuteilen. Der Warenaustausch könnte auch durch Akasha verwaltet werden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430803
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732430803,
					"content": "„Dann könnte mindestens die Hälfte der Mahamata abberufen werden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430804
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732430804,
					"content": "„Was du sagst klingt sehr vernünftig und ich denke, das könnte der Grund sein, warum wir es nicht durchführen können.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7324309,
			"completionStepIds": [
				7324309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324309",
							"2"
						],
						"stepId": 7324309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430901,
					"content": "„Wie alle wissen, ist es die Aufgabe der Gelehrten, nach tiefem Wissen zu suchen. Doch derzeitig sind in der Akademie zu viele mit administrativen Aufgaben ausgelastet.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430902
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732430902,
					"content": "„Momentan müssen sehr viele Studenten nach der übereilten Anfertigen ihrer Abhandlung ihre Forschung unterbrechen, weil sie überall zur Arbeit der Mahamata verpflichtet werden. Ist das nicht ein Abfall vom eigentlichen Zweck der Akademie?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430903
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732430903,
					"content": "„Wurde dieses Problem nicht schon längst in Akasha gelöst?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430904
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732430904,
					"content": "„Während die normalen Leute immer noch dem Aberglauben anhängen, sind wir das einzige Leuchten, dass sich der Wahrheit nähert. Wie könnten wir auch die schwere Verantwortung, die Menschen zu erleuchten, abwerfen. Wenn wir uns nicht kümmern würden, wer weiß, was für ein Chaos dann in Sumeru herrschen würde!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7324310,
			"completionStepIds": [
				7324310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324310",
							"2"
						],
						"stepId": 7324310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431001,
					"content": "„Als internationaler Student spüre ich jeden Tag, den ich an der Akademie studiere, die Erhabenheit von Rukkhadevata mehr.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431002
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431002,
					"content": "„Als ich in Mondstadt war, musste ich ein Dutzend Bücher wälzen, um die verschiedenen Theorien zu einer einfachen Frage herauszufinden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431003
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431003,
					"content": "„Aber seit ich das ‚Akasha-Kontrollgerät‘ habe, erhalte ich die passenden Informationen, wenn ich nur einen bestimmten Inhalt überdenke. Ich glaube, auf der ganzen Welt gibt es keine herrlichere Kreation als Akasha.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7324311,
			"completionStepIds": [
				7324311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324311",
							"2"
						],
						"stepId": 7324311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431101,
					"content": "„Seit Pir Kavikavus hat die Akademie die Mittel für Kshahrewar nicht mehr aufgestockt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431102
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431102,
					"content": "„Diese Leute da oben sagen, dass für ein stetes und friedliches Leben die Entwicklung und Verbreitung der mechanischen Technologie streng kontrolliert werden muss. Wer das sagt, kann auch gleich das ganze Akasha abstellen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431103
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431103,
					"content": "„Ohne die langfristigen Investitionen von weitsichtigen Geschäftsleuten wie Herr Sangemah Bay, wäre unsere Schule der Baulehre schon abgewickelt worden!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7324312,
			"completionStepIds": [
				7324312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324312",
							"2"
						],
						"stepId": 7324312,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431201,
					"content": "„Ich vertraue dem Urteil der Weisen und Mentoren zwar voll und ganz, aber macht sich die Akademie nicht zu abhängig vom Akasha?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431202
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431202,
					"content": "„Es ist offensichtlich, dass die akademische Kompetenz der reisenden Gelehrten, die wir aussenden, durch die Gewöhnung an Akasha als Quelle des Wissens, sinkt. Ich glaube, wir sollten die Nutzung von Akasha durch die neuen Studenten mit Regelungen einschränken.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431203
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431203,
					"content": "„Wie kannst du das sagen. Weißt du nicht, dass diese Schulen, die sich in die Wüste zurückgezogen haben und nicht die Erleuchtung von Akasha empfangen, längst in Ignoranz und Wahn verfallen sind und sie sogar törichterweise giftige Schlangen schlucken, um Wissen zu erlangen?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431204
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431204,
					"content": "„Nach dem Ableben der Höheren Herrin Rukkhadevata, ist es nur Akasha, das unser Wissen rein hält.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7324313,
			"completionStepIds": [
				7324313
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324313",
							"2"
						],
						"stepId": 7324313,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431301,
					"content": "Diese Woche hält der Waldhütermeister Tighnari die „Botanikvorlesung“ wie üblich in Pardis Dhyai ab. Jeder ist eingeladen, sich anzumelden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431302
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431302,
					"content": "Jeder kann teilnehmen, so lange er nur an Pflanzen interessiert ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431303
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431303,
					"content": "Wir sind untröstlich. Wegen der vielen Anmeldungen für diese Vorlesung und für ein reibungsloses Wissensmanagement, hat die Akademie nach Beratung beschlossen, dass die Teilnahme auf Studenten der Lebenskunde und Mitarbeiter des Waldschutzes beschränkt ist, wofür hiermit die Ankündigung erfolgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7324314,
			"completionStepIds": [
				7324314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324314",
							"2"
						],
						"stepId": 7324314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431401,
					"content": "„Hat jemand den neuesten Roman des Verlagshauses Yae gelesen? Die diesmalige Autorin kommt aus Sumeru, sie heißt wohl ... Pursina oder so. Sie scheint zu euch von der Lebenskunde zu gehören.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431402
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431402,
					"content": "„Ach ... Wenn ich den Aufnahmetest für Amurta doch nur bestanden hätte, dann könnte ich nicht nur jeden Tag in der Natur umherziehen, sondern hätte auch Zeit, einen Roman zu schreiben. Stattdessen hänge ich in diesem Haravatat fest und muss jeden Tag Dokumente lesen und an meiner Abhandlung schreiben, ich kann nicht einmal für Nachforschungen rausgehen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431403
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431403,
					"content": "„Was, jemand hat vor mir eine kurze Erzählung im Verlagshaus Yae veröffentlicht, bin ich nicht mehr die Autorität auf dem Gebiet der Studien über kurze Erzählungen?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7324315,
			"completionStepIds": [
				7324315
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324315",
							"2"
						],
						"stepId": 7324315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431501,
					"content": "„Klar, Geschäfte und Bücher sind zwei verschiedene Paar Schuhe. Es wäre besser gewesen, wenn ich gleich auf dem Großen Basar geblieben wäre und Geschäfte gemacht hätte.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431502
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431502,
					"content": "„Und jetzt kann ich keine Abhandlung fertigstellen und Geld hab ich auch nicht.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431503
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431503,
					"content": "„Wenn das nichts wird, dann breche ich eben das Studium ab und gehe zur Goldbrigade.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7324316,
			"completionStepIds": [
				7324316
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324316",
							"2"
						],
						"stepId": 7324316,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431601,
					"content": "„Ich habe ja nichts gegen Leute aus der Wüste, aber ich glaube, der Mahamatra sollte ein edler und angesehener Gelehrter sein, besonders die akademischen Probleme dürfen nicht mit den Fäusten gelöst werden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431602
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431602,
					"content": "„Ha, ich denke das ist immer noch besser, als wenn ihr von der Himmelskunde an der Macht wärt, wenigstens wird so kein Institut bevorzugt. Glaubt ihr wirklich, dass niemand weiß, wie ihr die ganzen Jahre auf eure Publikationsrate gekommen seid?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431603
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431603,
					"content": "„He! Ihr Typen von der Baulehre müsst schon Beweise vorlegen, wenn ihr etwas behauptet, sonst werde ich den Matra einschalten.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7324317,
			"completionStepIds": [
				7324317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324317",
							"2"
						],
						"stepId": 7324317,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431701,
					"content": "„Von mir aus können Leute aus anderen Ländern hier studieren, aber den Fremden jetzt auch Akasha offen steht ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431702
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431702,
					"content": "„Davon abgesehen, was für einen schlechten Einfluss die Gehirne von Fremden auf Akasha haben könnten, wissen wir auch nicht, wie groß der Effekt durch den unvermeidlichen Transfer von Wissen ins Ausland für den Export von Sumeru ist.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431703
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431703,
					"content": "„Eigentlich ist es ja nicht üblich, dass sich Gelehrte über die Wirtschaft Gedanken machen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431704
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431704,
					"content": "„Deswegen seid ihr von der Redelehre so abgehoben. Wenn ich nicht eine verbesserte Lackfarbe synthetisieren wollte, wäre ich nie auf die Idee gekommen, auf die Akademie zu gehen!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7324318,
			"completionStepIds": [
				7324318
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324318",
							"2"
						],
						"stepId": 7324318,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431801,
					"content": "„Ich habe diesen Wüstenzwerg schon lange nicht mehr gesehen, vielleicht haben wir jetzt endlich ein bisschen Ruhe.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431802
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431802,
					"content": "„Keine Ahnung, was diese Aushilfsmoralisten geschnüffelt haben, dass sie so nervig wurden und mich dazu brachten, die Evaluierung des letzten Semesters nicht zu bestehen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431803
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431803,
					"content": "„Soweit ich weiß, kannst du diese Evaluierung nur durch Anwesenheit bestehen, oder nicht? Selbst nicht ernsthaft studieren und dann andere beschuldigen. Außerdem solltest du aufpassen, was du sagst, sonst könntest du Besuch bekommen, auch wenn die Matra im Moment unterbesetzt sind.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431804
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431804,
					"content": "„Welche Matra? Ehrlich gesagt, diese Herren da oben spielen sich doch nur auf. Warte, das Akasha hat mir eine Nachricht gesendet ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431805
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732431805,
					"content": "„Anscheinend wäre es besser für alle, etwas vorsichtiger zu sein.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7324319,
			"completionStepIds": [
				7324319
			],
