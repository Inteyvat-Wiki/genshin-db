					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430101,
					"content": "Alle Benachrichtigungen und Dekrete der Akademie wurden bereits ins Akasha überführt. Dieses Anschlagbrett ist ausschließlich der außerschulischen Kommunikation zwischen Lehrern und Schülern vorbehalten. Außenstehende dürfen keine Nachrichten hinterlassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7324302,
			"completionStepIds": [
				7324302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324302",
							"2"
						],
						"stepId": 7324302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430201,
					"content": "„Für eine entspanntere Lernumgebung, für einen freundlicheren akademischen Austausch, dafür, das alle mit einem Lächeln an ihren Arbeiten schreiben können!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430202
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732430202,
					"content": "„Wir unterstützen Vikram für den Posten als neuen Großkonservator!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430203
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732430203,
					"content": "„Willkommen im ‚Verein der Freunde Vikrams‘, wo wir Zeugen des Aufstiegs eines jungen, zugänglichen und faszinierenden Großkonservators werden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7324303,
			"completionStepIds": [
				7324303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324303",
							"2"
						],
						"stepId": 7324303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430301,
					"content": "„Die drei Tugenden und sechs Sünden der Akademie dürfen niemals vergessen werden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430302
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732430302,
					"content": "„Ermahnung, Findigkeit und Praxis. Diese Tugenden sollte jeder Gelehrte befolgen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430303
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732430303,
					"content": "„Rifaet praktiziert diese drei Tugenden schon seit Jahrzehnten.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430304
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732430304,
					"content": "„Willkommen im ‚Bücher-Klub Fravashi‘, Partner des Wissens und des zukünftigen Großkonservators.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7324304,
			"completionStepIds": [
				7324304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324304",
							"2"
						],
						"stepId": 7324304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430401,
					"content": "„Mitglieder des ‚Bücher-Klub Fravashi‘, ich bewundere euer Streben nach Tugendhaftigkeit.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430402
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732430402,
					"content": "„Ich habe aber gehört, dass mehr als die Hälfte der Veröffentlichungen Rifaets von einem Auftragsschreiber verfasst wurden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430403
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732430403,
					"content": "„Das ist auch der Grund, warum er trotz seiner offensichtlich zahlreichen akademischen Leistungen so zurückhaltend ist.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430404
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732430404,
					"content": "„Für das Anschlagbrett werden zwar keine umfänglichen Argumente wie bei schriftlichen Arbeiten verlangt, aber böswillige Angriffe gegen Menschen dürfen dennoch nicht erfolgen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430405
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732430405,
					"content": "„Die vorherigen Kommentare erfolgten nur aus Neid!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430406
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732430406,
					"content": "„Ich habe auch gehört, dass Vikram die Herzen vieler Mädchen mit seiner Wortgewandtheit gewonnen hat.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430407
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732430407,
					"content": "„Doch keines dieser Mädchen weiß, dass er verheiratet ist. Na? Willst auch du ihn um seine Beliebtheit beneiden?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430408
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732430408,
					"content": "„Es ist verboten, Gelehrte der Akademie böswillig anzugreifen. Bei einem wiederholten Verstoß wird der Matra dem Ursprung der Verleumdung auf den Grund gehen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7324305,
			"completionStepIds": [
				7324305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324305",
							"2"
						],
						"stepId": 7324305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430501,
					"content": "„Dieses Anschlagbrett unterliegt nicht dem Akasha Berechtigungssystem und kann direkt ohne Akasha gelesen werden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430502
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732430502,
					"content": "„Bitte erhöht alle das Bewusstsein für die Informationssicherheit. Es ist streng verboten, Informationen außerhalb des Gebiets der öffentlichen Kommunikation auszutauschen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7324306,
			"completionStepIds": [
				7324306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324306",
							"2"
						],
						"stepId": 7324306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430601,
					"content": "„Freundlicher Hinweis: Alle Studenten sollten auch in ihrer Freizeit außerhalb des Campus nicht vergessen, die Campusdisziplin zu befolgen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430602
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732430602,
					"content": "„Die zentrale Verwaltung des Wissens ist die Grundlage, auf der das ‚Reich der Weisheit‘ fußt. Verliere nicht die Möglichkeit, an der Akademie zu studieren, durch unbeabsichtigte Fehler.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7324307,
			"completionStepIds": [
				7324307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324307",
							"2"
						],
						"stepId": 7324307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430701,
					"content": "„In letzter Zeit gab es eine Serie von Schmuggelfällen, Corpus Delicti waren Wissenskonserven. Die Details werden den Lehrern und Studenten nach Abschluss der Ermittlungen und vor dem nächsten Jnagarbha-Tag über das Akasha bekanntgegeben.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430702
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732430702,
					"content": "„Alle Mentoren werden ebenfalls gebeten, die Kommunikation mit den Studenten zu verbessern, dadurch soll das Risiko, das Studenten, durch zu hohen Druck beim Anfertigen der Abhandlung, verzweifeln, vermieden werden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
