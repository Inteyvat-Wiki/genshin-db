							"302812",
							"3"
						],
						"stepId": 302812,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432401,
					"content": "„Dieses Anschlagbrett dient zur Kommunikation innerhalb der Akademie. Die Nutzung zum Verbreiten nicht wahrheitsgemäßer und rechtswidriger Informationen ist streng verboten.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432402
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732432402,
					"content": "„Die Matra werden alle Gelehrten dazu ermahnen, sich gemäß dem Verhaltenskodex zu verhalten!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
