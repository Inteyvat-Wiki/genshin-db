			"dialogs": [
				{
					"id": 20210101,
					"content": "Was genau habt ihr in Shougun Raidens „utopischen Gefilde“ gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210102,
					"content": "Das Augenhatz-Dekret wurde aufgehoben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210103,
						20210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210103,
					"content": "Das ist Yae Miko zu verdanken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210105
					]
				},
				{
					"id": 20210105,
					"content": "Uff ... Paimon war krank vor Sorge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210106,
					"content": "Sucht sie uns also dieses Mal, um sich bei uns zu bedanken? Hehehe ... Geh rüber zu ihr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210104,
					"content": "Die Wünsche und der Glaube der Menschen wurden erhört.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210105
					]
				}
			]
		}
