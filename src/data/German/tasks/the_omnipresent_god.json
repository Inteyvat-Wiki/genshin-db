			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shougun Raiden"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200301,
					"content": "Lass mich nachdenken, was ist es, das dich noch einmal zu mir führt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200302
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200302,
					"content": "Ist dein törichter Mut, um das Volk zu schützen, oder ist eine Audienz bei mir die Absicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200303,
						20200304
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200303,
					"content": "Die Fatui haben Shougun Raiden hinters Licht geführt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				},
				{
					"id": 20200305,
					"content": "Oh? Darum geht es aber nicht nur, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200306
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200306,
					"content": "Dann unterschätzt du mich ein wenig zu sehr. Die Sache mit dem Augenhatz-Dekret ist mir durchaus bekannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200307
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200307,
					"content": "Du weißt über alles Bescheid?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200308
					]
				},
				{
					"id": 20200308,
					"content": "Nein, ich weiß nur einiges über die „Ewigkeit“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200309
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200309,
					"content": "Dazu gehört auch der Erlass des Augenhatz-Dekrets, das ich stillschweigend genehmigt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200310
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200310,
					"content": "Und was diese Fatui getan haben, hat noch keine Bedrohung für die Ewigkeit dargestellt, sonst ... wären sie schon längst beseitigt worden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200311,
						20200312
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200311,
					"content": "Aber das Augenhatz-Dekret ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200313,
					"content": "Das Begehren ist von Natur aus etwas, das der Ewigkeit abträglich ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200314
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200314,
					"content": "Du hast vielleicht noch nicht erkannt, dass das Verfolgen dieses Begehrens ... oft mehr kostet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200315
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200315,
					"content": "Genauso wie das Einsammeln von Göttlichen Augen an sich niemanden tötet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200316
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200316,
					"content": "Diejenigen, die ihr Leben verlieren, werden stattdessen diejenigen sein, die darauf bestehen, ihren Wünschen nachzujagen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200317
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200317,
					"content": "Teppei ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200318
					]
				},
				{
					"id": 20200318,
					"content": "#{F#Reisende}{M#Reisender}, du bist in der Tat eine besondere Präsenz in meinen Augen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200319
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200319,
					"content": "Es scheint eine unendliche Anzahl von Ungewissheiten über dich zu geben, mit anderen Worten, du bist sehr weit entfernt von der „Ewigkeit“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200320
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200320,
					"content": "Deshalb werde ich nicht darauf beharren, dass du die Bedeutung davon verstehst, aber du sollst versuchen, der „Ewigkeit“ zu dienen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200321
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200321,
					"content": "Das sind deine „utopischen Gefilde“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200322
					]
				},
				{
					"id": 20200322,
					"content": "Es ist ein Raum, der aus deinem Bewusstsein besteht, nicht wahr?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200323
					]
				},
				{
					"id": 20200323,
					"content": "Genau. Woher weißt du das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200324
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200324,
					"content": "Es ist nur so, dass du nach ... der Chance suchst, meinen Willen umzulenken, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200325
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200325,
					"content": "Ich diskutiere nicht mehr mit dir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200326
					]
				},
				{
					"id": 20200326,
					"content": "Ich werde dich einfach „absetzen“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200327
					]
				},
				{
					"id": 20200327,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200328
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200328,
					"content": "In Ordnung, „du, der zerbrechliche Mensch, der der Ewigkeit trotzt“, lass mich sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200312,
					"content": "Es hat dazu geführt, dass das Volk von Inazuma viel verloren hat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200304,
					"content": "Das Augenhatz-Dekret war ein Fehler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				}
			]
		},
		{
			"id": 202005,
			"completionStepIds": [
				202005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202005",
							"2"
						],
						"stepId": 202005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Shougun Raiden"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200501,
					"content": "Du hast verloren, Ei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200502
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200502,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200503
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200503,
					"content": "Ich habe verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200504
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200504,
					"content": "Warum kannst du deinen Leuten und der Kraft ihres Begehrens nicht vertrauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200505
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200505,
					"content": "Dieses Begehren hat Entfernung, Raum und Zeit überwunden und ist bereits etwas, das niemand mehr auslöschen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200506,
						20200507,
						20200508
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200506,
					"content": "Während die Leute mit voller Kraft voranschreiten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200509,
					"content": "Ist es das, was du von deiner Reise nach Liyue mitgenommen hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200510
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200510,
					"content": "Richtig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200511
					]
				},
				{
					"id": 20200511,
					"content": "Laufen die Menschen vorwärts und lassen die Götter hinter sich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200512
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200512,
					"content": "Aber warum sollten wir auf uns selbst schauen ... und die Bewegung nach vorne aufgeben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200513
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200513,
					"content": "Die Verluste, die mit dem Vorwärtsgehen kommen, hast du mit mir erlebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200514
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200514,
					"content": "Nur die Ewigkeit, die Ewigkeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200515
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200515,
					"content": "Die himmlische Ordnung ... ist etwas, das mir unbekannt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200516
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200516,
					"content": "Kurzum, du willst nur dein geliebtes Inazuma für immer beschützen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200517
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200517,
					"content": "Das ist sehr leicht gesagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200518
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200518,
					"content": "Aber hat dieses Reich die Ewigkeit auch verdient?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200519
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200519,
					"content": "Ein Reich, das seinen Glauben verloren hat, das seine Veränderung verloren hat, das nur existiert, ist nichts weiter als eine leere Hülle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200520
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200520,
					"content": "Nun, in diesem Fall, was würde es schaden, es zu zerstören?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200521
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200521,
					"content": "Nimm deine anmaßenden Worte zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200522
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200522,
					"content": "Ewigkeit unverändert für tausend Generationen, das ist das Versprechen, das ich meinem Volk gebe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200523
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200523,
					"content": "Aber es sind nicht deine Versprechen, die dein Volk braucht, es ist deine „Aufmerksamkeit“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200524
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200524,
					"content": "Die Göttlichen Augen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200525
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200525,
					"content": "Der Mensch lebt nur hundert Jahre und kann sich diese Verluste nicht leisten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200526
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200526,
					"content": "Weil ich alles erlebt habe, entscheide ich mich, sie in die richtige „Ewigkeit“ zu führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200527
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200527,
					"content": "*seufz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200528
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200528,
					"content": "Aber die Ewigkeit ist zu brutal für dich, Ei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200529
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200529,
					"content": "Für mich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200530
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200530,
					"content": "Du hast nicht nur aufgehört, auf die Welt aufzupassen, sondern auch auf dich selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200531
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200531,
					"content": "Es muss einsam gewesen sein, hier jahrhundertelang allein zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200532
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200532,
					"content": "Aber das war notwendig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200533
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200533,
					"content": "Wenn man sich nicht vorwärts bewegt, wird man auch viel verpassen ... Verpasst du nicht auch viel, während du hier auf die Ewigkeit wartest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200534
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200534,
					"content": "Du erträgst diese Einsamkeit, nur in der Hoffnung auf die Ewigkeit, und dehnst diese Einsamkeit bis ins Unendliche hinaus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200535
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200535,
					"content": "Sag mir, warum war der Himmel hier so dunkel ... und warum leuchtet er jetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200536
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200536,
					"content": "Dies sind deine „utopischen Gefilde“, deine innere Welt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200537
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200537,
					"content": "Also ... bist du tatsächlich froh, mich wiederzusehen ... Du konntest die Einsamkeit hier nicht länger ertragen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200538
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200538,
					"content": "Ich habe nichts zu sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200539
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200539,
					"content": "Oh, dann habe ich dir mehr zu sagen, oh ja, lass mich dir sagen, was in diesen Jahrhunderten geschehen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200540
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200540,
					"content": "Wie lange dauert es, zu erzählen, was in ein paar hundert Jahren passiert ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200541
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200541,
					"content": "Ich habe als Kitsune ein gutes Gedächtnis und ich habe über die Jahrhunderte kein einziges Detail vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200542
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200542,
					"content": "Also werde ich einige Jahrhunderte brauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200543
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200543,
					"content": "Ach ... hehe ... Ich hatte gedacht, dass ich nicht mehr die Gelegenheit haben würde, mich so mit dir zu treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200544
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200544,
					"content": "Dich zu treffen ist eine Veränderung in der Ewigkeit ... und eine Art Überraschung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200545
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200545,
					"content": "Oh, jetzt, da du es ehrlich zugegeben hast, können wir doch immer noch Freunde sein, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200546
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200546,
					"content": "Kindliches Getue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200547
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200547,
					"content": "Da ich jedoch gegen eure Pläne verloren habe, werde ich das Augenhatz-Dekret in Übereinstimmung mit eurem Willen aufheben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200548
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200548,
					"content": "Aber über die „Ewigkeit“, darüber, ob dieses Reich vorankommen soll, muss ich noch einmal nachdenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200549
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20200549,
					"content": "Du warst immer schon das Kind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200507,
					"content": "Kann es jenseits der göttlichen Erwartung sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200508,
					"content": "Es übernimmt sogar die Arbeit der Götter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				}
			]
		},
