				{
					"id": 740240301,
					"content": "Jedenfalls danke ich euch ganz herzlich für eure Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240302
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240302,
					"content": "#Allerdings kann ich nicht einfach nehmen, was dir gehört, {M#ehrenwerter}{F#ehrenwerte} {NICKNAME}. Wenn du mir also den Namen dieses Materials nennen könntest, könnte ich mich später selbst auf die Suche begeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240303
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240303,
					"content": "Aber, würdet ihr nicht auch finden, dass diese Farbe ein wenig zu intensiv ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240304
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240304,
					"content": "Ich denke, die „Farbe der Sonne“ sollte einen helleren Ton haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240305
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240305,
					"content": "Einen helleren Ton. Meinst du, sie sollte mehr in Richtung „Weiß“ tendieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240306,
					"content": "Hmm, das ist wahr. Die Sonne ist eher „weiß“ als „golden“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240307,
					"content": "„Weiß“, sagst du? Ich weiß jedoch nicht, welche Materialien ich verwenden muss, um diesen helleren Farbton zu erzeugen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240308,
						740240311
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240308,
					"content": "Könnten wir nicht einfach mehr Wasser hinzufügen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240309
					]
				},
				{
					"id": 740240309,
					"content": "Ich habe das bereits versucht ... aber es hat nicht so gut funktioniert. Die auf diese Weise erzeugten Farben erweisen sich eher als trüb, ihnen fehlt die packende Brillanz der Sonne ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240310
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240310,
					"content": "Es wäre daher besser, ein anderes Material zu verwenden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240314
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240314,
					"content": "Abgesehen davon haben wir oft glänzende und weiße Dinge gesehen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240311,
					"content": "Vielleicht könnten wir Paimons Haare verwenden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240312
					]
				},
				{
					"id": 740240312,
					"content": "Mit Haaren kann man doch keine Farbe herstellen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240313,
					"content": "Und selbst wenn man das könnte, darf man Paimons Haare doch nicht einfach so rausrupfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240314
					],
					"speakerTitle": "Paimon"
				}
			]
		},
