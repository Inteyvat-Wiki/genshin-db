						"pointId": 340300092
					},
					{
						"sceneId": 3,
						"position": [
							2408.264,
							252.729,
							4986.404
						],
						"pointId": 340300093
					}
				]
			},
			"dialogs": [
				{
					"id": 740240101,
					"content": "He, was machst du hier ganz allein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240102,
					"content": "Waaaha! Sprich nicht aus dem heiteren Himmel mit mir, während du hinter mir stehst! Ich hätte fast das ganze Pulver fallen lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240103
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240103,
					"content": "Pulver? Äh, was ist das für ein Zeug?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240104,
					"content": "Das sind Edelsteine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240105
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240105,
					"content": "Edelsteine?! Aber warum sollte es hier welche geben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240106,
					"content": "Wäre es nicht merkwürdiger, sie hier nicht zu finden? Ich meine, das ist meine Werkstatt, in der ich Edelsteine verarbeite ... Auch wenn ich zugeben muss, dass sie noch keinen offiziellen Namen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240107
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240107,
					"content": "Ich hatte überlegt, sie „Werkstatt Sluasi“ zu nennen, aber ich weiß nicht, ob es eine so gute Idee ist, meinen richtigen Namen zu verwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240108
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240108,
					"content": "Was meinst du mit „Edelsteine verarbeiten“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240109
					]
				},
				{
					"id": 740240109,
					"content": "Das bedeutet, dass ich Edelsteine in verschiedene hübsche Schmuckstücke ... und andere Dinge verwandle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240110
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240110,
					"content": "Leider kann ich eine Zeit lang keine neuen Aufträge annehmen. Ich muss mich auf die Herstellung von Farbstoffen konzentrieren ... auch wenn ich dafür auch Edelsteine verwende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240111
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240111,
					"content": "Du willst Farbstoffe aus Edelsteinen herstellen? Ernsthaft?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240112,
					"content": "Ja? Warum ist das so schlimm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240113
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240113,
					"content": "Äh, nun, es fühlt sich etwas verschwenderisch an ... Du könntest sie auch einfach Paimon geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240114,
					"content": "Aber warum musst du überhaupt Farben herstellen? Man braucht doch keine Farbstoffe, um Schmuckstücke aus Edelsteinen herzustellen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240115,
					"content": "Nun, ein Kind, das gerne malt, kam zu mir und fragte mich, ob ich Farbe herstellen könnte, die so funkelt wie Edelsteine und so strahlend wie die Sonne ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240116
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240116,
					"content": "Sie hat vor kurzem meine jüngere Schwester gerettet, als das Dorf sehr heftig bebte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240117
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240117,
					"content": "Deshalb beschloss ich, ihren Wunsch zu erfüllen, indem ich Farbe „so strahlend wie die Sonne“ herstelle und es ihr als Dankeschön schenke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240118
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240118,
					"content": "Warte, das Kind ist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240119
					]
				},
				{
					"id": 740240119,
					"content": "Das Kind, das gern malt, von dem du gesprochen hast, heißt nicht zufällig Mamère?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240120,
					"content": "Hmm? Ja ... Kennt ihr sie etwa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240121
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240121,
					"content": "Ihr erzählt Sluasi von euren früheren Erlebnissen mit Mamère ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240122
					]
				},
				{
					"id": 740240122,
					"content": "#Oh ... Ihr seid also die beiden ehrenwerten {M#Abenteurer}{F#Abenteuerinnen}, die mit Mamère Puca gerettet haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240123
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240123,
					"content": "E... Ehrenwert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240124,
						740240125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240124,
					"content": "Ja, das waren wir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240126
					]
				},
				{
					"id": 740240126,
					"content": "Vielen Dank! Ich danke euch zwei vielmals! Ohne euch wäre Puca vielleicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240127
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240127,
					"content": "Nehmt das bitte ... als kleines Dankeschön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240128,
						740240130
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240128,
					"content": "(Feinste Edelsteine ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240129
					]
				},
				{
					"id": 740240129,
					"content": "#Können wir das wirklich annehmen, {NICKNAME}? Sie sehen wirklich sehr teuer aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240131,
					"content": "Paimon glaubt aber nicht, dass Mamère von sich aus etwas in Auftrag geben würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240132,
					"content": "Nun, sie hat mich nicht wirklich beauftragt, etwas zu tun. Sie hat mich nur gefragt, ob ich es tun könnte. Sie lief schon weg, bevor ich überhaupt antworten konnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240133
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240133,
					"content": "Ja ... Das klingt schon eher nach Mamère.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240134,
					"content": "#Apropos, {F#ehrenwerte}{M#ehrenwerter} {NICKNAME} und ehrenwerte Paimon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240135
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240135,
					"content": "Was würdet ihr als „was der Sonne farblich am nächsten kommt“ bezeichnen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240136
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240136,
					"content": "Ich habe versucht, die Sonne selbst zu beobachten, aber ich bin mir nicht sicher, welche Materialien ich verwenden soll, um ihre Farben nachzubilden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240137
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240137,
					"content": "Hm ... „Was der Sonne farblich am nächsten kommt“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240138,
						740240141,
						740240145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240138,
					"content": "... Gold, vielleicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240139
					]
				},
				{
					"id": 740240139,
					"content": "Ja, Canotila hat uns mal erzählt, „Gold sind die Tränen der Sonne“ oder so ähnlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240140
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240140,
					"content": "Aber wäre das nicht zu luxuriös? Es muss doch etwas Alltäglicheres geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240148,
					"content": "Denk mal nach. Wir müssen etwas gesehen haben, das „der Sonne farblich am nächsten kommt“ und das so gut wie überall zu finden ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240141,
					"content": "... Die Sonne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240142
					]
				},
				{
					"id": 740240142,
					"content": "... Das ist wirklich wahr. Das, was der Sonne am nächsten kommt, ist in der Tat die Sonne selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240143
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240143,
					"content": "Aber wie kann ich die Sonne zu Pulver zermahlen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240144
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240144,
					"content": "Hä? Das ist nicht dein Ernst, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240145,
					"content": "In diesem Fall könntest du vielleicht mein Haar verwenden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240146
					]
				},
				{
					"id": 740240146,
					"content": "... Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240147
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240147,
					"content": "Ein bisschen mehr Ernsthaftigkeit! Man kann Haare doch nicht zu Farbe verarbeiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240130,
					"content": "Danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240131
					]
				},
				{
					"id": 740240125,
					"content": "Ich würde uns allerdings nicht „ehrenwert“ nennen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240126
					]
				}
			]
		},
