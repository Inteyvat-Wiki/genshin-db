			"dialogs": [
				{
					"id": 740241301,
					"content": "Ah, ich verstehe. Das ist also das, was ihr „Beere“ nennt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740241302
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740241302,
					"content": "Es ist kalt und hart, und doch sehr weich. Es schmerzt in den Augen, wie die Sonne an einem Winternachmittag. Die Menschen müssen sie wahrscheinlich als Metall für Waffen verwenden? Wie auch immer, ich danke euch vielmals. Ich werde dieses Material nicht vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740241303
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740241303,
					"content": "Hmm ... Wie bist du denn darauf gekommen?",
