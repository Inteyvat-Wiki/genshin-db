			"dialogs": [
				{
					"id": 740240516,
					"content": "Sluasi untersucht das Material gründlich, bevor sie es euch zurückgibt ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240501
					]
				},
				{
					"id": 740240501,
					"content": "Ah, ich verstehe. Das ist also die Farbe, die ihr als „weiß“ bezeichnet, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240502
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240502,
					"content": "Ich kann mich nicht des Eindrucks erwehren, dass es das genaue Gegenteil der „Farbe der Sonne“ ist. Wäre es dann nicht sinnvoller, direkt „die gegenteilige Farbe“ zu verwenden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240503
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240503,
					"content": "„Die gegenteilige Farbe“ ... Du meinst Schwarz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240504,
					"content": "„Schwarz“ ... Ja, das muss es sein. Brillante Idee, ehrenwerte Paimon. Das muss tatsächlich die Farbe der Sonne sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240505,
						740240506
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240505,
					"content": "Irgendwie kommt mir das komisch vor ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240508
					]
				},
				{
					"id": 740240508,
					"content": "Aber warum schwarz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240509,
						740240510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240509,
					"content": "Die Sonne ist golden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240512
					]
				},
				{
					"id": 740240512,
					"content": "Darf ich euch noch um etwas bitten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240513
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240513,
					"content": "Könntet ihr mir bitte etwas „Schwarzes“ bringen? Dann wüsste ich, welches Material ich verwenden muss, um eine „Farbe so strahlend wie die Sonne“ zu schaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240514
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240514,
					"content": "Müssen wir wirklich danach suchen? Paimon hat den Eindruck, wir entfernen uns immer weiter von allem, was mit der Sonne in Verbindung steht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240515,
					"content": "Aber da sie uns darum gebeten hat ... Lass uns etwas „Schwarzes“ für sie finden, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240510,
					"content": "Wenn es also die Sonne bei Nacht wäre ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240511
					]
				},
				{
					"id": 740240511,
					"content": "Die Sonne wird nachts auch nicht schwarz! Man sieht nicht einmal die Sonne in der Nacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240506,
					"content": "Brillante Idee, oh ehrenwerte Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240507
					]
				},
				{
					"id": 740240507,
					"content": "He, hör damit auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240508
					],
					"speakerTitle": "Paimon"
				}
			]
		},
