			"dialogs": [
				{
					"id": 740241201,
					"content": "Ah, das ist also das, was ihr „Nilotpala-Lotos“ nennt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740241202
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740241202,
					"content": "Hmm, wie seltsam. Nilotpala, blauer Mond. Warum ist dieser Lotos nach dem Mond benannt, wenn er doch farblich der Sonne am nächsten kommt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740241203
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740241203,
					"content": "Nun ... Die Farben der Sonne und des Mondes sind doch nicht so unterschiedlich, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
