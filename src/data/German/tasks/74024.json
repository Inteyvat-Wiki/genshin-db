			"dialogs": [
				{
					"id": 740240712,
					"content": "Sluasi untersucht das Material gründlich, bevor sie es euch zurückgibt ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240701
					]
				},
				{
					"id": 740240701,
					"content": "Vielen Dank! Damit kann ich bestimmt eine Farbe herstellen, die so strahlend wie die Sonne ist. Dann kann ich sie ihr als Geschenk überreichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240702
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240702,
					"content": "Wird das wirklich funktionieren ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240703,
					"content": "Oder besser gesagt: Kann man mit solchen Ausgangsmaterialien wirklich „strahlende“ Farben herstellen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240704,
						740240706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240704,
					"content": "Ich glaube nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240705
					]
				},
				{
					"id": 740240705,
					"content": "Aber Sluasi sieht so glücklich aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240708,
					"content": "Jedenfalls danke ich euch beiden für eure Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240709
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240709,
					"content": "Bitte nehmt das als Dankeschön an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240710
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240710,
					"content": "G... Glänzende Edelsteine und auch Komponenten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240711,
					"content": "Haha. Ich freue mich, dass sie euch gefallen. Wenn ihr in Zukunft Schmuckstücke braucht, wisst ihr ja, wo ihr mich finden könnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240706,
					"content": "Das ist nicht ausgeschlossen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240707
					]
				},
				{
					"id": 740240707,
					"content": "Stimmt, Mamères Farben sind auch aus ziemlich seltsamen Dingen verarbeitet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240708
					],
					"speakerTitle": "Paimon"
				}
			]
		},
