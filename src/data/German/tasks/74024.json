			"dialogs": [
				{
					"id": 740241601,
					"content": "Oh, eine Perle! Aber sie ist ein bisschen anders als die, die ich bereits gesehen habe. Sie gibt mir irgendwie ein Gefühl von ... Kälte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740241602
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740241602,
					"content": "Hehe, das ist keine gewöhnliche Perle. Sie ist eine Sango-Perle, was so viel wie „Korallen-Perle“ bedeutet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740241603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740241603,
					"content": "Korallen? Können Korallen auch Perlen produzieren? Die Welt da draußen ist wirklich faszinierend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740241604
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740241604,
					"content": "Ähm ... Das ist nicht ganz richtig. Sie werden so genannt, weil sie sich in der Nähe von Korallen bilden.",
					"roleType": "TALK_ROLE_NPC",
