			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620101,
					"content": "Schaut mal! Ich habe das Segelbuch meines Vaters noch einmal durchgeblättert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620102
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620102,
					"content": "Dort gibt es einen Anhang, der ein spezielles Rezept für einen Köder erwähnt, den sie entwickelt hatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620103
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620103,
					"content": "Als sie dem „Mond-Leviathan“ begegnet sind, stellten sie einen speziellen Köder her, der aus Seegras und magischem Kristallerz bestand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620104
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620104,
					"content": "Wenn wir diesen Köder auch herstellen, können wir den „Mond-Leviathan“ vielleicht auch anlocken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620105
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620105,
					"content": "Ich habe haufenweise Seegras, aber das magische Kristallerz ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620106
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620106,
					"content": "Keine Sorge, ich habe welches.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620107
					]
				},
				{
					"id": 726620107,
					"content": "Hm? Wirklich? Wurde das bei Araumi abgebaut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620108
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620108,
					"content": "Im Logbuch meines Vaters stand, dass das magische Kristallerz aus den Ruinen von Araumi stammen muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620109
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620109,
					"content": "Ich weiß zwar nicht, was da den Unterschied zu normalem magischem Kristallerz ausmacht, aber da wir die Sache durchziehen wollen, sollten wir streng sein und uns an das Segellogbuch halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620110
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620110,
					"content": "Apropos Araumi ... Dort gibt es eine Menge gefährlicher Monster. Gehen wir zur Abenteurergilde und machen einen Aushang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620111
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620111,
					"content": "Ist schon gut, ich kümmere mich um die Monster.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620112
					]
				},
				{
					"id": 726620112,
					"content": "#Ah, richtig ... Ich vergaß, dass du ja {F#eine furchtlose Abenteurerin}{M#ein furchtloser Abenteurer} bist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620113
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620113,
					"content": "Ich habe so ein Glück, dass ihr mir helft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620114
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620114,
					"content": "Ich gehe zurück und hole ein paar Werkzeuge für die Köderherstellung. Wir treffen uns später am Strand westlich von Araumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		},
		{
			"id": 7266202,
			"completionStepIds": [
				7266204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266204",
							"2"
						],
						"stepId": 7266204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620201,
					"content": "#So schnell hast du es gefunden? Du bist wirklich {F#eine furchtlose Abenteurerin}{M#ein furchtloser Abenteurer}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620202
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620202,
					"content": "Wird das genug sein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620203
					]
				},
				{
					"id": 726620203,
					"content": "Ja, schau gut zu, jetzt muss ich nur das machen ... das ... und das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620204
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620204,
					"content": "Das sollte es sein, geschafft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620205
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620205,
					"content": "Im nächsten Schritt verteilen wir die Köder und warten darauf, dass der „Mond-Leviathan“ auftaucht, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620206,
					"content": "Ja. Ich habe diesen Ort mit Absicht gewählt. Von hier haben wir damals die Küste angesteuert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620207
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620207,
					"content": "Der „Mond-Leviathan“, der uns damals zum Schiff zurückgeführt hat, ist auch hier verschwunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620208
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620208,
					"content": "Also, sind alle bereit? Vergesst nicht, euch etwas zu wünschen, wenn ihr den „Mond-Leviathan“ seht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620209
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620209,
					"content": "Was, wenn es nicht klappt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620210
					]
				},
				{
					"id": 726620210,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620211
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620211,
					"content": "Sag doch solche demotivierenden Sachen nicht. Es wird funktionieren. Der „Mond-Leviathan“ wird definitiv auftauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620212
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620212,
					"content": "Ja! Es wird klappen! Großes Fischlein, großes Fischlein, sei lieb und friss den Köder! Paimon zählt auf dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620213,
					"content": "Guck! Guck dir das an! Es leuchtet unter der Wasseroberfläche! Da kommt etwas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620214
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620214,
					"content": "Wirklich? Ist der „Mond-Leviathan“ wirklich hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620215,
					"content": "Hilfe! Es ist ein Ruinenwächter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620216,
					"content": "Warum muss es ausgerechnet so einer sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7266203,
			"completionStepIds": [
				7266206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
