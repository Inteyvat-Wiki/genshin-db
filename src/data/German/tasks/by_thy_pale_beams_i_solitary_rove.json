			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620301,
					"content": "Wie ... Wie konnte das passieren? Sogar das Köderrezept meines Vaters hat versagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620302
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620302,
					"content": "Sei nicht traurig, das ist die Schuld von diesem Ruinenwächter! Er muss dem „Mond-Leviathan“ Angst gemacht haben! Versuchen wir es einfach nochmal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620303,
					"content": "Ja, versuchen wir es nochmal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620304
					]
				},
				{
					"id": 726620304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620305
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620306
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620306,
					"content": "Vergessen wir das erstmal, ich bin müde. Vielleicht hat Nantuck ja recht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620307
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620307,
					"content": "*seufz* Ich möchte draußen einen kleinen Spaziergang machen. Ich muss darüber nachdenken, wie es weitergeht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620308
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620308,
					"content": "Hier ist dein Lohn. Was jetzt auch passiert, ich danke dir vielmals für deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620309
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620309,
					"content": "Sieht so aus, als möchte Frau Kujirai erstmal alleine sein. Wir sollten später wiederkommen und nach ihr sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}