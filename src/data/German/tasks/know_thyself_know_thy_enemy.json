				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010201,
					"content": "Aber wie finden wir heraus, in welcher Beziehung Fürst Maocai zu den Fatui steht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010202,
						120010203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010202,
					"content": "Wir brauchen Beweise mit Überzeugungskraft.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010204
					]
				},
				{
					"id": 120010204,
					"content": "Sollten wir vielleicht ganz direkt mit ihm reden? Wenn wir ihn nicht auf frischer Tat ertappen, dann jagen wir ihm einfach Angst ein. Womöglich erzählt er uns ja etwas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010205,
					"content": "Fragen wir erst einmal die Wachen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010206
					]
				},
				{
					"id": 120010206,
					"content": "Überlass das nur mir! Ich werde das hinkriegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010203,
					"content": "Am besten wäre es, ihn auf frischer Tat zu ertappen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010204
					]
				}
			]
		},
		{
			"id": 1200103,
			"completionStepIds": [
				1200103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200103",
							"2"
						],
						"stepId": 1200103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Stämmiger Wu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010301,
					"content": "Wer da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010302,
						120010304
					],
					"speakerTitle": "Stämmiger Wu"
				},
				{
					"id": 120010302,
					"content": "Ich bin ein Händler aus Mondstadt und habe eine Verabredung mit Fürst Maocai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010303
					]
				},
				{
					"id": 120010303,
					"content": "Was? Davon hätte man mir etwas gesagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "Stämmiger Wu"
				},
				{
					"id": 120010306,
					"content": "Mein Herr hat heute etwas Dringendes zu tun und musste allen anderen absagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010307
					],
					"speakerTitle": "Stämmiger Wu"
				},
				{
					"id": 120010307,
					"content": "Was hat er denn zu tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010308,
					"content": "Er arbeitet an einem äußerst wichtigen Geschäft und musste heute sehr früh raus, um seinen Kunden zu treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010309
					],
					"speakerTitle": "Stämmiger Wu"
				},
				{
					"id": 120010309,
					"content": "Wo ist er denn hingegangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010310,
					"content": "Verzeihung, diese Information kann ich leider nicht weitergeben. Mein Herr besteht darauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010311
					],
					"speakerTitle": "Stämmiger Wu"
				},
				{
					"id": 120010311,
					"content": "So geht man hier also mit seinen Gästen um?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010312
					]
				},
				{
					"id": 120010312,
					"content": "Nein, natürlich nicht. Ich würde euch niemals verärgern wollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010313,
						120010314
					],
					"speakerTitle": "Stämmiger Wu"
				},
				{
					"id": 120010313,
					"content": "Wenn du uns nicht zu Fürst Maocai lässt, wird das Folgen für dich haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010315,
					"content": "Ich bitte aufrichtig um Verzeihung! Mein Herr befindet sich gerade im Lokal Xinyue und bespricht dort sein Geschäft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010316
					],
					"speakerTitle": "Stämmiger Wu"
				},
				{
					"id": 120010316,
					"content": "Habt Gnade mit mir und erzählt ihm nichts davon! Denn er wird keine haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010317
					],
					"speakerTitle": "Stämmiger Wu"
				},
				{
					"id": 120010317,
					"content": "#{F#Meine Herrin}{M#Mein Herr} hat auch wichtigere Dinge zu tun, als sich mit dir herumzuschlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010318,
					"content": "#Du solltest hoffen, dass {F#sie}{M#er} vergisst, was du dir hier erlaubst, wenn {F#sie}{M#er} und Fürst Maocai ihre Geschäfte besprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010319,
					"content": "Vielen, vielen Dank! Möge der Herrscher über die Felsen auch über eure Geschäfte wachen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010320
					],
					"speakerTitle": "Stämmiger Wu"
				},
				{
					"id": 120010320,
					"content": "#Ich hatte nicht erwartet, dass du derartige Talente hast, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010321,
						120010323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010321,
					"content": "Ich habe doch nur improvisiert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010322
					]
				},
				{
					"id": 120010322,
					"content": "#Paimon wird wohl in Zukunft aufpassen müssen. {F#Eine solche Gefährtin}{M#Einen solchen Gefährten} bei sich zu haben, scheint gefährlich zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010325,
					"content": "So, wie die Wache von dem wichtigen Gast geredet hat, muss es sich um einen der Fatui handeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010326,
						120010327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010326,
					"content": "Das vermute ich auch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010328,
					"content": "Na, dann auf zum Lokal Xinyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010327,
					"content": "Wir müssen zum richtigen Augenblick aufkreuzen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010323,
					"content": "Du warst aber auch nicht übel!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010324
					]
				},
				{
					"id": 120010324,
					"content": "Hehehe, Paimon freut sich über jedes Kompliment! Wenn du es ernst meinst, könntest du mir ein paar Süßigkeiten kaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010314,
					"content": "Erklär deinem Herrn ruhig, warum er den Mist ausbaden muss, den du verzapft hast.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010304,
					"content": "#Ich bin {NICKNAME}, dein Herr hat mich eingeladen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010305
					]
				},
				{
					"id": 120010305,
					"content": "Seltsam, du stehst nicht auf der Liste ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "Stämmiger Wu"
				}
			]
		},
		{
			"id": 1200107,
			"completionStepIds": [
				1200107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200107",
							"2"
						],
						"stepId": 1200107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fürst Maocai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010701,
					"content": "Ich weiß, ich weiß. Die Bestellung wird auf jeden Fall wie angekündigt fertiggestellt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010702
					],
					"speakerTitle": "Fürst Maocai"
				},
				{
					"id": 120010702,
					"content": "Mir wurde aber zugetragen, dass der Fortschritt nicht gerade den Erwartungen entspricht. Tanzt da etwa jemand aus der Reihe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010703
					],
					"speakerTitle": "Schuldeneintreiber"
				},
				{
					"id": 120010703,
					"content": "Ähm, ich gebe zu, es gibt einige Schwierigkeiten bei der Beschaffung der Rohmaterialien. Den Cor Lapis konnten wir bisher noch nicht einkaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010704
					],
					"speakerTitle": "Fürst Maocai"
				},
				{
					"id": 120010704,
					"content": "Sorgen müsst Ihr Euch da aber keine machen. Wenn dieser Chang IX. nicht einwilligt, werde ich das Material eben woandersher beschaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010705
					],
					"speakerTitle": "Fürst Maocai"
				},
				{
					"id": 120010705,
					"content": "Was auch immer Ihr tun müsst. Ich habe ja gesagt, die Fatui kümmern sich nur um die Ergebnisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010706
					],
					"speakerTitle": "Schuldeneintreiber"
				},
				{
					"id": 120010706,
					"content": "Um die Bestellung abschließen zu können, wären die Fatui auch bereit, Euch ein wenig Unterstützung zukommen zu lassen. Solltet Ihr sie aber nicht rechtzeitig abschließen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010707
					],
					"speakerTitle": "Schuldeneintreiber"
				},
				{
					"id": 120010707,
					"content": "Ihr müsst wissen, unsere Dienste haben ihren Preis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010708
					],
					"speakerTitle": "Schuldeneintreiber"
				},
				{
					"id": 120010708,
					"content": "Ich verstehe, ja. Ich stehe in Eurer Schuld. Wie könnte ich Euch nur enttäuschen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010709
					],
					"speakerTitle": "Fürst Maocai"
				},
				{
					"id": 120010709,
					"content": "Das werden wir an den Ergebnissen sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010710
					],
					"speakerTitle": "Schuldeneintreiber"
				},
				{
					"id": 120010710,
					"content": "Hach, dieser verdammte alte Chang ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fürst Maocai"
				},
				{
					"id": 610045701,
					"content": "Dieser Fürst Maocai hat also tatsächlich Beziehungen zu den Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 610045702,
					"content": "Meinst du, der Buchfuzzi ist inzwischen weitergekommen? Fragen wir ihn doch mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1200108,
			"completionStepIds": [
				1200108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200108",
							"2"
						],
						"stepId": 1200108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010801,
					"content": "Du hast doch gesagt, du wolltest dich um etwas kümmern, und hast ganz geheimnisvoll getan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010802,
					"content": "Letzten Endes hast du dich einfach woanders hingesetzt, um zu lesen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010803,
					"content": "Wir haben nachgeforscht und herausgefunden, was Fürst Maocai für Geschäfte macht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010804
					]
				},
				{
					"id": 120010804,
					"content": "So, so, das habe ich mir fast gedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010805
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010805,
					"content": "Wirklich? Oder sagst du das nur so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010806,
					"content": "Den Plan habe ich mittlerweile ausgearbeitet. Hier ist ein Brief. Überbringt ihn bitte der Händlergilde Feiyun. Dort wird man wissen, was zu tun ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010807
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010807,
					"content": "Wegen einiger schwer zu beschreibender Gründe kann ich nicht mit euch gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010808
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010808,
					"content": "Kümmert euch nicht um den Inhalt des Briefes. Sobald die Zeit kommt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010809
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010809,
					"content": "Was hast du denn für eine Handschrift?! Geht es vielleicht noch unleserlicher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010810,
						120010811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010810,
					"content": "Ist das eine alte Schrift?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				},
				{
					"id": 120010812,
					"content": "Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010813
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010813,
					"content": "Deswegen habe ich ja gesagt, dass ihr euch nicht darum kümmern müsst ... Kommt am Ende aufs Selbe hinaus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010814
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010814,
					"content": "Bei der Händlergilde wird jemand den Brief entziffern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010815
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010815,
					"content": "Du willst demnach die Händlergilde Feiyun mit hineinziehen? Das ist eine der bedeutendsten Gilden in Liyue überhaupt. Warum sollte sie uns helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010816,
					"content": "Die Händlergilde Feiyun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010817
					]
				},
				{
					"id": 120010817,
					"content": "Nachdem wir in Liyue angekommen waren, haben viele von dieser Organisation geredet. Sie scheint die Geschäftstätigkeiten hier zu kontrollieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010818,
					"content": "Mit einer so großen Händlergilde im Rücken hätten wir klar einen Vorteil. Aber würde sie uns wirklich helfen wollen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010819,
					"content": "Sei unbesorgt. Soweit ich weiß, teilen ihre Mitglieder mein Verständnis von Gerechtigkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010820
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010820,
					"content": "Sobald sie meinen Brief lesen, in dem ich ausführlich und leidenschaftlich die Sachlage beschrieben habe, werden sie mit Sicherheit Hilfe schicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010821,
						120010822
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010821,
					"content": "Meinst du, das wird klappen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010823,
					"content": "Fürst Maocai muss seine Lektion einfach lernen. Dazu brauchen wir Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010824
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010824,
					"content": "Außerdem will ich nicht, dass jemand anderes erfährt, dass ich dafür verantwortlich bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010825
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010825,
					"content": "Warum das? Macht du das nicht, um Chang IX. zu helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010826,
					"content": "Nach Abschluss einer gerechten Tat keinen Dank oder Ruhm einzufordern, ist eine Tugend. Mir genügt die Erinnerung daran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010827
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010827,
					"content": "Jede mir erwiesene Freundlichkeit werde ich zurückgeben. Doch damit sind wir quitt und ich brauche keinerlei Belohnung oder Gefallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010828
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010828,
					"content": "Das sagst du jetzt so, aber in Wahrheit willst du einfach nur in Ruhe dein Buch weiterlesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010829,
					"content": "Bitte bringt den Brief schnellstens zum Hausdiener der Händlergilde Feiyun, er müsste sich in der Nähe des Liuli-Pavillons befinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010830
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010830,
					"content": "Jetzt hör auf Paimon einfach zu ignorieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010822,
					"content": "Warum sollten wir sie darin verwickeln?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010811,
					"content": "Ist das eine Geheimschrift?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				}
			]
		}
	]
}