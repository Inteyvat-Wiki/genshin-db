			"dialogs": [
				{
					"id": 205130301,
					"content": "Hast du die Sachen gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130302,
					"content": "Ja, habe ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130303
					]
				},
				{
					"id": 205130303,
					"content": "Was? Diese Windmühlenaster fühlt sich anders an als normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130304,
					"content": "Hahaha. Frag mich nicht, warum es so ist, aber ich habe das Gefühl, dass es Anna sicher besser gehen wird, wenn sie diese Medizin zu sich nimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130305,
					"content": "Vielleicht hat mich ihre kürzliche Besserung hoffen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130306,
					"content": "Einerlei, dank dir vielmals. Nimm dies als Vergütung für deinen Aufwand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130307,
					"content": "Ich hoffe, Anna wird es besser gehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130308
					]
				},
				{
					"id": 205130308,
					"content": "Danke. Es wird schon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130309
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130309,
					"content": "Ich habe immer daran geglaubt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
