				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205130101,
					"content": "Dieser sieht normal genug aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130102,
					"content": "Du siehst ziemlich gut aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130103
					]
				},
				{
					"id": 205130103,
					"content": "Ja, na ja, ich hab mich wohl selbst erschreckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130104,
					"content": "Anna sieht jeden Tag besser aus. Der Arzt ist wirklich gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130105,
					"content": "Kannst du mir, wenn du willst, helfen, weitere Zutaten zu finden? Dieses Mal brauchen wir eine Windmühlenaster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130106,
						205130111,
						205130115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130106,
					"content": "Das klingt nicht nach Medizin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130107
					]
				},
				{
					"id": 205130107,
					"content": "Na ja, Windmühlenastern werden manchmal in der Medizin verwendet, aber für gewöhnlich, um kleinere Leiden zu heilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130108,
					"content": "Vielleicht ist der Anemo-Schleim der Schlüssel. Aber Windmühlenastern und Anemo-Schleime werden nicht so oft zusammen gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130109,
					"content": "Glücklicherweise hat Jack das schon mehrere Male gesehen und sich daher die ungefähren Stellen gemerkt. Ich werde dir die nächstgelegene Stelle auf deiner Karte markieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130110,
					"content": "Ich komme mit Anemo-Schleimen nicht zurecht, da sie fliegen können. Ich kann mich also nur an dich wenden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130111,
					"content": "Das sieht ziemlich nach Mondstadt aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130112
					]
				},
				{
					"id": 205130112,
					"content": "Ich will mich nicht streiten mit dir, aber Windmühlenastern und Anemo-Schleime werden nicht häufig zusammen gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130113,
					"content": "Gut, dass Jack das schon mehrere Male gesehen hat und sich daher die ungefähren Stellen gemerkt hat. Ich werde dir die nächstgelegene Stelle auf deiner Karte markieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130114,
					"content": "Ich kann wirklich nicht gegen Anemo-Schleime kämpfen, da sie fliegen können. Ich kann mich also auf dich zählen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130115,
					"content": "Ich fange einfach einen Anemo-Schleim für dich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130116
					]
				},
				{
					"id": 205130116,
					"content": "Du willst einfach sehen, wie ich mich blamiere, oder etwa nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130117,
					"content": "Wie dem auch sei, Windmühlenastern und Anemo-Schleime werden nicht häufig zusammen gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130118,
					"content": "Gut, dass Jack das schon mehrere Male gesehen hat und sich daher die ungefähren Stellen gemerkt hat. Ich werde dir die nächstgelegene Stelle auf deiner Karte markieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130119,
					"content": "Falls du es wirklich nicht finden kannst, dann bringe einen Anemo-Schleim zurück. Ich tue alles für Anna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
