			},
			"dialogs": [
				{
					"id": 751310301,
					"content": "Lebendiger ... Lebendiger Feuerregen?! Bedeutet das, dass das Feuer wie ein Lebewesen über die Köpfe der Menschen fliegt? Oha, Natlans Vulkane sind wirklich furchterregend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310302,
					"content": "#{NICKNAME}, Paimon ist ein wenig neugierig. Hehe, warum erkunden wir nicht ein wenig das Gebiet vor uns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7513104,
			"completionStepIds": [
				7513102
