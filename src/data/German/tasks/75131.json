			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310401,
					"content": "... Hm, lebendig aussehendes Feuer, mysteriöse hinterbliebene Schatten und eine Kamera, die von selbst auslöst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310402,
					"content": "Ein Gefühl flüstert, dass hier ein kompliziertes und mysteriöses Rätsel verborgen liegt! Vielleicht hat es sogar mit einem Schatz zu tun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310403,
					"content": "Paimon, was ist dir aufgefallen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310404
					]
				},
				{
					"id": 751310404,
					"content": "Ehrlich gesagt ... Paimon hat keine Ahnung! Aber ... der Besitzer des Fotoapparats hat ihn bestimmt hier platziert, um Bilder aufzunehmen, wenn der Boden bebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310405,
					"content": "Also müssen wir den Fotoapparat nur reparieren und dann darauf warten, dass der Boden wackelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310406,
					"content": "Hehe, jede Wette, wenn es soweit ist, werden die Hinweise zum Schatz wie ein hinterbliebener Schatten hervorbrechen, rumpelnd und donnernd!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
