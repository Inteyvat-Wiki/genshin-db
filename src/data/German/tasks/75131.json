			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matzahtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310101,
					"content": "Lebendiger Feuerregen ... Könnte die Legende wahr sein, dass sich der Vulkan bei einem Ausbruch wie ein Lebewesen entwickeln und wild vermehren kann, sodass alles um ihn herum ebenfalls zu Vulkanen wird? Oh nein, das wäre ja schrecklich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310102,
						751310103
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310102,
					"content": "So entstehen Vulkane aber nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310104
					]
				},
				{
					"id": 751310104,
					"content": "Ja, ja, wie würde ein Vulkan ohne Magma entstehen? Ein Vulkan bricht nicht einfach so aus, sonst wäre dieses Gebiet schon längst zur Gefahrenzone geworden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310105
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310105,
					"content": "Aber ... Aber was, wenn die Legende wirklich wahr wäre? Hmm, wenn nur dieser Fotoapparat, der automatisch Fotos machen soll, funktionieren würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310106
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310106,
					"content": "Warte mal, was, wenn der Fotoapparat einen Fehler macht und kein Bild aufnimmt? Das wäre ja schrecklich! Nein, nein, ich muss unbedingt mal vorbeischauen und nachsehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310103,
					"content": "Verzeih die Störung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310107
					]
				},
				{
					"id": 751310107,
					"content": "Auf Wiedersehen ... Ob da noch mehr dahintersteckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				}
			]
		},
		{
			"id": 7513102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7513105",
							"3"
						],
						"stepId": 7513105,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matzahtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310201,
					"content": "Oh, der lebendige Feuerregen besteht also eigentlich nur aus Feuertreiblingen, die vom Himmel kommen! Kein Wunder, dass der betroffene Bereich viel größer ist als bei einer gewöhnlichen Eruption ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310202
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310202,
					"content": "Ach, was ist, wenn sie eines Tages in mein Haus krachen? Ich muss etwas dagegen tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310203,
						751310206
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310203,
					"content": "Das ist nur ein Sonderfall.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310204
					]
				},
				{
					"id": 751310204,
					"content": "Oh, ja, ein Feuertreibling kann nur durch einen Vulkanausbruch in die Luft steigen und mein Haus liegt nicht im Bereich des Vulkanausbruchs, also sollte ich mir keine Sorgen machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310205
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310205,
					"content": "A... Aber, was wäre, wenn es eines Tages einen beispiellosen Ausbruch gäbe? Wäre man dann überhaupt noch irgendwo sicher? Nein, nein, ich muss unbedingt einen Ausweg finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310206,
					"content": "Verzeih die Störung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310207
					]
				},
				{
					"id": 751310207,
					"content": "Es ist schon gut, ich fühle mich nicht gestört ... Auf jeden Fall sollte ich zuerst mein Dach abdichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				}
			]
		},
		{
			"id": 7513103,
			"completionStepIds": [
				7513106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
