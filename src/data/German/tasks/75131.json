			"dialogs": [
				{
					"id": 751310601,
					"content": "Nachdem ihr den Fotoapparat überprüft habt, entdeckt ihr, dass nicht nur eine Reihe von Fotos von der Umgebung darin enthalten sind, sondern auch einen besonderen Mechanismus, der es dem Fotoapparat ermöglicht, automatisch Fotos zu machen, wenn er Vibrationen des Bodens wahrnimmt.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
