					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726780401,
					"content": "Ja ... Der Wind ist so stark ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780402
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780402,
					"content": "Hier kommt man nicht durch die Windwand! Man muss einen Umweg in Kauf nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780403,
					"content": "Kichiboushi, folge uns langsam um die Seite herum und den Hügel hinauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7267805,
			"completionStepIds": [
				7267807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267807",
							"2"
						],
						"stepId": 7267807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726780501,
					"content": "Endlich sind wir oben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780502,
					"content": "Die Aussicht von hier ist viel besser als da unten. Siehst du, dort drüben sind wir hergekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780503,
					"content": "Gefällt es Paimon an hohen Orten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780504,
						726780505
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780504,
					"content": "Von oben hat man einen tollen Blick und kann toll dahingleiten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780507
					]
				},
				{
					"id": 726780507,
					"content": "Schläft der Winddrache in diesem Turm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780508
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780508,
					"content": "Nun, er hat sehr lange dort geschlafen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780509,
					"content": "#Obwohl {NICKNAME} gegen den „Sturmschrecken“ gekämpft hat, ist er kein schlechter Drache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780510,
					"content": "Es geriet einfach in eine traurige Situation, wurde verletzt und von bösen Leuten ausgetrickst, also dachte er, der Windgott wolle ihn nicht mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780511,
					"content": "Oh ... und dann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780512
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780512,
					"content": "#Und später ... {NICKNAME} erinnerst du dich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780513,
					"content": "Wir haben das „Gerinnsel“ während der Schlacht gereinigt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780514
					]
				},
				{
					"id": 726780514,
					"content": "Aber auch die Plattform, auf der der Kampf stattfand, stürzte ein. Es schien, als würden wir und der Windgott so tief ins Dunkle fallen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780515,
					"content": "#Oh! Wie furchteinflößend ... Also was war mit Paimon und {NICKNAME}? Sind alle herausgeflogen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780516,
						726780519
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780516,
					"content": "Dvalin hat uns gerettet und uns mitgenommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780517
					]
				},
				{
					"id": 726780517,
					"content": "Dval...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780518
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780518,
					"content": "Das ist „Sturmschrecken“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780520,
					"content": "#„Sturmschrecken“ hat seinen eigenen Namen. Genauso wie Kichiboushi, Paimon und {NICKNAME}. Er heißt Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780521,
					"content": "Zuerst war Dvalin sehr, sehr wütend, als er von den Bösewichten verletzt und ausgetrickst wurde, und ging nach Mondstadt, um ein großes Chaos anzurichten. Alle hielten ihn für einen bösen Drachen und nannten ihn „Sturmschrecken“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780522,
					"content": "Später, nachdem wir die Bösewichte besiegt und zusammen mit dem Windgott das Gerinnsel geheilt hatten, wusste er, dass der Windgott ihn nicht wirklich verlassen hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780523,
					"content": "Ah! Und so wurde der Winddrache gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780524
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780524,
					"content": "Das ist richtig! Also ja ... Paimon hat Kichiboushi heute hierher zum Training gebracht, um ihm die Geschichte von Dvalin zu erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780525,
					"content": "Nachdem du groß geworden bist, wirst auch du auf Missverständnisse, Schmerz und Traurigkeit stoßen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780526,
					"content": "Aber auf keinen Fall darfst du böse werden. Denn „der Wind kann sich drehen“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780527,
					"content": "Eines Tages wird er in eine bessere Richtung wehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780528
					]
				},
				{
					"id": 726780528,
					"content": "Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780529
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780529,
					"content": "Ist das für Kichiboushi zu schwer zu verstehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780530
					]
				},
				{
					"id": 726780530,
					"content": "Ich scheine es zu verstehen, aber doch nicht so ganz ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780531
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780531,
					"content": "#Ich weiß jedoch, dass es sich um etwas Wichtiges handelt. Was Paimon und {NICKNAME} gesagt haben, wird nicht vergessen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780532
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780532,
					"content": "Nun, das entspricht der Geschichte, über die Paimon lange, lange nachgedacht hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780533,
					"content": "Aber sei nicht zu verspielt und frech, Kichiboushi, Lass dich nicht von anderen versiegeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780534,
						726780535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780534,
					"content": "Diesmal war Kichiboushi am Ende.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780536,
					"content": "Uuh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780537
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780537,
					"content": "Sei nicht so traurig! Kehr mit einem Lächeln im Gesicht zurück, damit Ioroi glücklich ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780538,
					"content": "#Nun, es ist an der Zeit, dass Paimon und {NICKNAME} ihre letzten Aufgaben als Führer erfüllen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780539,
					"content": "Das heißt, Kichiboushi zu Ioroi zurückzubringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780540,
						726780541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780540,
					"content": "Lass uns gehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780542,
					"content": "Mnja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780541,
					"content": "Gehen wir, Kichiboushi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780535,
					"content": "Die Mission von Ioroi gilt ebenfalls als abgeschlossen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780519,
					"content": "Sturmschrecken hat uns gerettet. Er ist mit uns weggeflogen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780520
					]
				},
				{
					"id": 726780505,
					"content": "„Dummköpfe und Qualm“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780506
					]
				},
				{
					"id": 726780506,
					"content": "He! So funktioniert das nicht. Von oben hat man eine tolle Aussicht und die Luft ist sauberer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780507
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7267808,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267802",
							"2"
						],
						"stepId": 7267802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": []
		},
		{
			"id": 7267811,
			"completionStepIds": [
				7267811
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267811",
							"2"
						],
						"stepId": 7267811,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726790101,
					"content": "Ioroi, wir sind zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790102,
					"content": "Oh, du bist wieder da! Kichiboushi, wie geht es voran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790103
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790103,
					"content": "Lavala, Bumm-Bumm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790104
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726790104,
					"content": "Hahah, wirklich nicht schlecht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790105
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790105,
					"content": "Oooh, Paimon versteht wieder kein Wort von dem, was Kichiboushi sagt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790106,
					"content": "Wir haben auch viele, viele Fotos gemacht. Ioroi, schau mal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790107,
					"content": "Die Fotos, die Kichiboushi während der gemeinsamen Reisen gemacht hatte, gab er nach und nach an Ioroi.\\nAuch die Sachen, die er auf der Reise erlebt hatte, erzählte er Ioroi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726790108
					]
				},
				{
					"id": 726790108,
					"content": "Auf diese Weise erfüllten wir deine Bitte, Kichiboushi an acht Orte zu bringen, um zu üben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790109,
					"content": "Hmmm! Nicht schlecht, kein Wunder, dass ich euch vertraue! Wenn ihr kleine Tanuki wärt, dann könntet ihr große, berühmte Bakedanuki werden. Vielleicht sogar halb so gut wie ich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790110
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790110,
					"content": "(Hört sich nicht sehr stark an ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790111,
					"content": "Aber da der Auftrag abgeschlossen ist, sollten wir auch gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790112,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790113
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726790113,
					"content": "Schon gut, schon gut, hör auf. Paimon wird Kichiboushi noch eine Sache beibringen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790114,
					"content": "Wenn du dich von einem Freund verabschiedest, dann tu dies mit einem Lächeln! Wenn du ihn das nächste Mal wiedersiehst, werden alle noch glücklicher sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790115,
					"content": "... Oh? Geht klar, kein Problem. Ich werde übernehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790116
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790116,
					"content": "Kichiboushi sagte: „Verstanden, Weißfell.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790117
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790117,
					"content": "Huch? Ist das etwa ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790118,
						726790119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790118,
					"content": "Kann Kichiboushi nicht mehr sprechen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				},
				{
					"id": 726790120,
					"content": "Nach einer so langen Zeit sollte die Wirkung des Bakedanuki-Mahls nachlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790121
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790121,
					"content": "He, wäre ich nicht in Stein gemeißelt, wäre es ein Leichtes gewesen, euch allen verständlich zu machen, was Bakedanuki die ganze Zeit reden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790122
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790122,
					"content": "Hm, gut, ich werde dir helfen es zu übermitteln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790123
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790123,
					"content": "„Kichiboushi wird fleißig üben.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790124
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790124,
					"content": "„Und er wird zu einem großen Bakedanuki wie Ioroi.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790125
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790125,
					"content": "... Ach? Du hast eine große Klappe, mein Freund. Du hast die gleiche Einstellung wie ich damals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790126
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790126,
					"content": "„Auf diese Weise müssen Weißfell und Gelbfell nicht Bakedanuki-Essen essen und können Kichiboushi dennoch verstehen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790127
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790127,
					"content": "... Ja! Paimon wird warten. Das nächste Mal wird Paimon zusammen mit Kichiboushi üben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790128,
					"content": "Kichiboushi muss alles geben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790129
					]
				},
				{
					"id": 726790129,
					"content": "Lass dich nicht versiegen, ja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790130
					]
				},
				{
					"id": 726790130,
					"content": "Hm?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790131
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790131,
					"content": "Ja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790132
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726790132,
					"content": "Egal, euch Menschen zuliebe, die ihr Kichiboushi zum Üben mitgenommen habt, werde ich nicht böse sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790133
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790133,
					"content": "Im Übrigen: Ein Typ namens Utamarou hat früher die versiegelten Tanuki im Chinju-Wald gemalt und einige Zeichnungen hinterlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790134
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790134,
					"content": "Ich gebe sie euch einfach. Wenn ihr das stattliche Aussehen unseres Bakedanuki-Klans vermisst, könnt ihr euch einfach diese Porträts anschauen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790135
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790135,
					"content": "Hach, wenn ihr nur Bakedanuki wärt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790136
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790136,
					"content": "Dann hätten wir schon längst versteinert werden müssen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790137
					]
				},
				{
					"id": 726790137,
					"content": "Hm, das ist auch richtig. Wenn du nichts zu tun hast, dann geh jetzt, ich und Kichiboushi, wir müssen noch Zaubern lernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790119,
					"content": "Verstehen wir nicht mehr, was Kichiboushi sagt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				}
			]
		}
	]
}