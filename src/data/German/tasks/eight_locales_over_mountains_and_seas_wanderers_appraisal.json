			},
			"dialogs": [
				{
					"id": 726780301,
					"content": "Ja ... sehr gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780302
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780302,
					"content": "Kichiboushi, was ist los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780303,
					"content": "Die Stadt ist trostlos und ich weiß nicht warum, aber ich fühle mich ein wenig traurig. Seltsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780304,
						726780305
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780304,
					"content": "Finde ich auch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				},
				{
					"id": 726780306,
					"content": "Es geht weiter ins Herz der „Stadt“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780305,
					"content": "Kichiboushi ist wirklich komisch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				}
			]
		},
		{
			"id": 7267804,
			"completionStepIds": [
				7267804
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267804",
							"2"
						],
						"stepId": 7267804,
