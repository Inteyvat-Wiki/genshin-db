			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726780101,
					"content": "Was für eine große Stadt, aber ... sie fühlt sich, nun ja, trostlos an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780102
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780102,
					"content": "#In der Vergangenheit kämpfte Paimon mit {NICKNAME} und vielen Kameraden hier gegen den „Sturmschrecken“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780103,
					"content": "Ist es einer dieser furchterregenden Drachen mit großem Körper, fliegenden Flügeln und reißenden Reißzähnen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780104,
						726780105
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780104,
					"content": "In Wahrheit war es eigentlich nicht so furchteinflößend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				},
				{
					"id": 726780106,
					"content": "Erinnert sich Kichiboushi an die Statue des Windgottes, die wir vorhin in Mondstadt gesehen haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780107,
					"content": "Die Statue des Windgottes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780108
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780108,
					"content": "Da ist sie, die große, große Steinstatue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780109,
					"content": "Ah! Der Windgott hat große Hände.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780110
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780110,
					"content": "„Sturmschrecken“ ist ein guter Freund des Windgottes! Er stammte auch aus dieser Stadt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780111,
					"content": "Oh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780112
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780112,
					"content": "Aber wenn der Winddrache so riesig ist, wie soll er dann reinkommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780113,
						726780114
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780113,
					"content": "Ich glaube, jemand hat die gleiche Frage schon einmal gestellt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780115,
					"content": "Ah, Paimon weiß es! Weil er nicht so laufen muss, wie wir es tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780116,
					"content": "Kichiboushi versteht das. Der Winddrache fliegt, also muss er nicht hineingehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780117
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780117,
					"content": "Aaargh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780118,
					"content": "Ah? Paimon scheint aus irgendwelchen Gründen nicht zufrieden zu sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780119
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780119,
					"content": "Ja ... Darüber reden wir später, aber erst einmal machen wir hier ein Foto zur Erinnerung! Beweg dich nicht, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780120,
					"content": "Kichiboushi steht still!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726780114,
					"content": "Es heißt „Sturmschrecken“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780105,
					"content": "Ehrlich gesagt war es sehr schön.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				}
			]
		},
		{
