					"Aberaku",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722470201,
					"content": "Es scheint, dass du stark genug bist, um das Opfer zu begleiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470202
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470202,
					"content": "Das wird mir Seelenfrieden geben ... Ihr müsst es liefern, damit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470203
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470203,
					"content": "Damit was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470204,
					"content": "Damit ... Damit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470205
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470205,
					"content": "Es ist vorbei, es ist völlig kaputt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470206,
					"content": "Aber das ist das Opfer, das er meint, glaubt Paimon ... Es sieht auch ein bisschen zerlumpt aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224703,
			"completionStepIds": [
				7224705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
