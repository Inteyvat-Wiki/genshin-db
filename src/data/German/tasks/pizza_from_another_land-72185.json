			"dialogs": [
				{
					"id": 721850501,
					"content": "Danke. Diese Zutaten sind genug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850502
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850502,
					"content": "Die originale „Pilzza“ von Mondstadt ... Ich frage mich, ob ich sie ohne Probleme machen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850503
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850503,
					"content": "Erledigt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850504
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850504,
					"content": "Diese Pizza sieht ... ziemlich gut aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850505
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850505,
					"content": "#Danke für deine Hilfe, {F#Reisende}{M#Reisender}. Bitte nimm dies hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850506
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850506,
					"content": "Ich werde den Geschmack dieser Pizza auf jeden Fall auskosten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850507
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850507,
					"content": "Sobald sie gut genug ist ... sollte sie bald offiziell als neues Produkt eingeführt werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				}
			]
