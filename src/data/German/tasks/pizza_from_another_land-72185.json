			"dialogs": [
				{
					"id": 721850201,
					"content": "*seufz* Gibt es auf dieser Welt neue und aufregende Gerichte, die meine Geschmacksnerven befriedigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850202
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850202,
					"content": "Über die Pizza im „Restaurant Kiminami“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850203
					]
				},
				{
					"id": 721850203,
					"content": "Du sagtest, dass die Pizza, also dass ihr Geschmack wirklich gut ist und viele lokale Zutaten eingearbeitet sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850204
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850204,
					"content": "Allerdings habe ich schon einmal die tolle „Pilzza“ probiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850205
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850205,
					"content": "Wenn ich mich recht erinnere, bestand diese Pizza aus Käse, Weißkohl und Champignons ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850206
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850206,
					"content": "Hahaha, ich finde, dass es besser ist, das Essen von solchen verschiedenen Ländern mit dem unterschiedlichen Geschmack zu behalten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matsumoto"
				}
			]
		},
		{
			"id": 7218503,
			"completionStepIds": [
				7218503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
