			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kiminami Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721850301,
					"content": "#{F#Reisende}{M#Reisender}, du bist ja wieder da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850302
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850302,
					"content": "Wie sieht es aus? Hast du eine Antwort bekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850303
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850303,
					"content": "Über die Rückmeldungen unserer Gäste ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850304
					]
				},
				{
					"id": 721850304,
					"content": "Die originale „Pilzza“ ... Na ja, die würde ich gern einmal probieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850305
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850305,
					"content": "Die Zutaten für die Zubereitung sind Käse, Weißkohl und Champignons ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850306
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850306,
					"content": "Der Rest der Zutaten ist im Laden erhältlich, aber dieser Käse, der Laden hat normalerweise nicht viel vorrätig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850307
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850307,
					"content": "#{F#Reisende}{M#Reisender}, könntest du mir bitte einen Käse holen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850308,
						721850310
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850308,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850309
					]
				},
				{
					"id": 721850309,
					"content": "Dann wäre bitte nur eine Portion Käse nötig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850310,
					"content": "Wird im Laden nicht normalerweise Käse verwendet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850311
					]
				},
				{
					"id": 721850311,
					"content": "Ich kann nicht sagen, dass ich ihn überhaupt nicht benutze, nur eben sehr wenig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850312
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850312,
					"content": "Schließlich gibt es nicht viele dieser Gerichte, die nach Käse verlangen, sodass ich nur sehr wenig vorrätig habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850313
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850313,
					"content": "#Wie auch immer, {F#Reisende}{M#Reisender}, bitte bringt mir einen Käse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				}
			]
		},
