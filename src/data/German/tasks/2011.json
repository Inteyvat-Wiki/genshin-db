	"talks": [
		{
			"id": 201101,
			"completionStepIds": [
				201101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201101",
							"2"
						],
						"stepId": 201101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110101,
					"content": "#Ad astra abyssosque! Was kann ich für dich tun, {F#Reisende}{M#Reisender}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110102,
						20110103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110102,
					"content": "Erzähl mir was über die Reise nach Inazuma ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				},
				{
					"id": 20110104,
					"content": "Ah, ja! Ich habe gehört, dass du dich bereits mit dem Kapitän der Crux wegen deiner Überfahrt nach Inazuma in Verbindung gesetzt hast. Stimmt das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110105,
					"content": "Wenn ich so darüber nachdenke, ist es schon lange her, seit ich das letzte Mal dort war. Leider habe ich keine aktuellen Informationen, die dir was bringen würden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110106,
					"content": "#Da bist du ja! Du bist {F#die Reisende}{M#der Reisende}, {F#die}{M#den} Beidou nach Inazuma mitnehmen wird, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110107,
						20110109
					],
					"speakerTitle": "Meeresdrache"
				},
				{
					"id": 20110107,
					"content": "Ich warte schon den ganzen Tag lang auf dich!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110108
					]
				},
				{
					"id": 20110108,
					"content": "Oh, wirklich? Hehe ... Es ist eine Ehre, dich kennenzulernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110110
					],
					"speakerTitle": "Meeresdrache"
				},
				{
					"id": 20110110,
					"content": "Die Flotte hat ihre Vorräte fast wieder aufgefüllt. Sobald alle Mitglieder der Mannschaften da sind, lichten wir die Anker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110111
					],
					"speakerTitle": "Meeresdrache"
				},
				{
					"id": 20110111,
					"content": "Kapitän Beidou hat mich geschickt, um euch zu holen. Wir lichten Anker, sobald ihr an Bord seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110112
					],
					"speakerTitle": "Meeresdrache"
				},
				{
					"id": 20110112,
					"content": "Kapitän Beidou hält wohl ihr Wort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110113,
					"content": "Natürlich! Es gibt vieles, auf das sie besteht. Aber das wirst du selbst sehen, wenn ihr an Bord seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110114
					],
					"speakerTitle": "Meeresdrache"
				},
				{
					"id": 20110114,
					"content": "Du brichst also auf? Dann sind wohl Glückwünsche angebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110115,
					"content": "Ob dich nun deine Reise in die Höhen des Himmels oder in die Tiefen des Abgrunds führt, jeder gemachte Schritt ist ein weiterer Erfolg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110116,
					"content": "Bis zum nächsten Mal, ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110117,
						20110118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110117,
					"content": "Ad astra abyssosque, Katheryne ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110119,
					"content": "Oh ... Irgendwie fällt der Abschied gerade ziemlich schwer ... Wir sehen uns ja quasi fast jeden Tag.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110120,
					"content": "Hehe, na ja, wenn das so ist, kommt nach eurer Ankunft doch zu mir. Ich warte auf Narukami auf euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110121,
						20110122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110121,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110123,
					"content": "Es gibt also noch eine Katheryne in Inazuma! Siehst du, du hast gar keinen Grund, jetzt ganz rührselig zu werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110124,
					"content": "Haha, na ja, dann ist es wohl Zeit, dem Hafen von Liyue Lebewohl zu sagen. Da ich nun meine Nachricht überbracht habe, kehre ich zurück. Das Schiff liegt im Moment vor den Guyun-Türmen vor Anker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110125
					],
					"speakerTitle": "Meeresdrache"
				},
				{
					"id": 20110125,
					"content": "Danke, dass du diesen weiten Weg auf dich genommen hast, um uns Bescheid zu geben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110126,
					"content": "Ich folge nur meinen Befehlen. Wir sehen uns an Bord der Alcor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Meeresdrache"
				},
				{
					"id": 20110122,
					"content": "Ich wusste es doch!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110118,
					"content": "Du wirst uns fehlen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110109,
					"content": "Anscheinend ist unsere Nachricht angekommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110110
					]
				},
				{
					"id": 20110103,
					"content": "Erzähl mir was über die Crux ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				}
			]
		},
		{
			"id": 201103,
			"completionStepIds": [
				201103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201103",
							"2"
						],
						"stepId": 201103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110301,
					"content": "Ah, du bist endlich hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110302
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110302,
					"content": "In allen Jahren hat sich die Crux nie verspätet, komme Regen oder Sturm. Auf jemand anderen hätte ich nicht gewartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110303,
						20110304
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110303,
					"content": "Tut mir leid, Kapitän!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				},
				{
					"id": 20110305,
					"content": "Hahaha, schau nicht so ernst. Das war doch nur ein Scherz. Du bist genau zur rechten Zeit eingetroffen, die Mannschaft hat gerade eben die letzten Vorbereitungen abgeschlossen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110306
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110306,
					"content": "*seufz* Da nun alle hier sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110307
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110307,
					"content": "Setzen wir die Segel, um das Land zu erreichen, das von Stürmen und Gewitter umgeben ist ... Das Land der „Ewigkeit“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110308
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110308,
					"content": "Lichtet die Anker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110304,
					"content": "Es ist eine Ehre, an Bord zu sein!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				}
			]
		},
		{
			"id": 201107,
			"completionStepIds": [
				201107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201107",
							"2"
						],
						"stepId": 201107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110701,
					"content": "Du bist also endlich hier. Du hast mich ziemlich warten lassen, Kapitän.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110702
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110702,
					"content": "Und anscheinend haben wir noch ein paar blinde Passagiere ... oder vielleicht sollte ich lieber „Ehrengäste“ sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110703
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110703,
					"content": "Pff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110704,
					"content": "Du kannst deinem allmächtigen Shougun die Schuld geben. Die Stürme rund um Inazuma sind in letzter Zeit sogar noch schlimmer geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110705
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110705,
					"content": "Obwohl die Flotte bestens gerüstet war, hat das feindselige Wetter für Verspätung gesorgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110706
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110706,
					"content": "Nun dann, lass mich mal alle vorstellen. Das ist Thoma, ein Handelspartner, den ich vor Kurzem kennengelernt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110707
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110707,
					"content": "He, ihr habt keine Ahnung, wie lange ich schon eure Bekanntschaft machen will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110708
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110708,
					"content": "Thoma, die beiden sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110709
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110709,
					"content": "Ich brauche keine Vorstellung, ihr Ruf eilt ihnen voraus. Nicht einmal die stürmische See kann die Kunde von den Taten dieser Fremden aufhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110710,
						20110711
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110710,
					"content": "Freut mich, dich kennenzulernen, Thoma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110712
					]
				},
				{
					"id": 20110712,
					"content": "Hehe, das hört man ja gern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110713,
					"content": "Ha, mit etwas Glück werdet ihr es hier deshalb ein wenig leichter haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110714
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110714,
					"content": "#{NICKNAME}, Thoma wohnt jetzt schon eine ganze Weile auf Ritou. Es wäre nicht übertrieben zu sagen, dass er in dieser Gegend der Vermittler ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110715
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110715,
					"content": "Solltet ihr hier auf Probleme stoßen, wendet euch einfach an Thoma. Wenn er euch auf irgendeine Weise hintergeht, kümmere ich mich persönlich um ihn, wenn ich das nächste Mal hier bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110716
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110716,
					"content": "Hehe, kein Grund zur Sorge. Wir werden uns bestimmt ausgezeichnet verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110717
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110717,
					"content": "Gut. Wenn das dann alles geklärt ist, breche ich auf. Ich will hier nicht mit eingeholten Segeln erwischt werden, immerhin hab ich einen gesuchten Flüchtling an Bord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110718
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110718,
					"content": "Oh, stimmt. Kazuha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110719,
					"content": "#Bis zum nächsten Mal, {F#Reisende}{M#Reisender}! Gib dein Bestes, egal welchen gefährlichen „Stürmen“ du begegnen wirst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110720,
						20110721
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110720,
					"content": "Wird gemacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110722
					]
				},
				{
					"id": 20110722,
					"content": "Mast- und Schotbruch, Kapitän Beidou! Auf Wiedersehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110723,
					"content": "Nun denn, das Wichtigste zuerst. Wir müssen euch bei der Grenzkontrolle registrieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110724
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110724,
					"content": "Ähm, Paimon dachte, wir sollten nicht auffallen? Marschieren wir so nicht direkt der Regierung in die Hände?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110725,
					"content": "Haha, unterschätze die Reichweite des Sakoku-Dekrets nicht. Einer Kontrolle könnt ihr nicht entgehen, selbst wenn ihr es versuchen würdet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110726
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110726,
