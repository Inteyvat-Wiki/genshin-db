					"content": "Ich werde mich ein wenig ausruhen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580802
					]
				},
				{
					"id": 200580802,
					"content": "Aber nicht so lange.",
