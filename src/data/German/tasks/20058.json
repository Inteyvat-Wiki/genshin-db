					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200580901,
					"content": "Ach, Nora ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580902,
						200580907
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580902,
					"content": "Passt du auf sie auf?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580903
					]
				},
				{
					"id": 200580903,
					"content": "Nun ja, ihre Mutter ist zurzeit nicht zu Hause und kann daher nicht auf sie aufpassen. Deswegen übernehme ich das solange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580904
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580904,
					"content": "Ich muss aber noch auf ein paar andere Kinder aufpassen. Auch das gehört zu den Pflichten einer Ordensschwester.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580905
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580905,
					"content": "Auf einmal hatte ich so viele Kinder. Sie sind alle sehr lieb und kommen mit Glory gut zurecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580906
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580906,
					"content": "Und jetzt ... nennt mich Timmie, auf den ich schon am längsten aufpasse, Mama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580907,
					"content": "Was ist mit Noras Vater?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580908
					]
				},
				{
					"id": 200580908,
					"content": "Das wäre dann Patton. Sein Alkoholkonsum führte zu Problemen zu Hause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580909
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580909,
					"content": "Die Kathedrale und der Ordo Favonius haben ihn mehrfach verwarnt, ändern wollte er jedoch nichts. Zuletzt musste Diluc helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580910
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580910,
					"content": "Schwester Victoria ist davon überzeugt, dass Patton momentan nicht in der Lage ist, sich um Nora zu kümmern. Deswegen hat sie sie in die Obhut der Kathedrale gegeben, sodass Patton etwas Zeit hat, über sein Verhalten nachzudenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580911
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580911,
					"content": "Aber auch Nora wird langsam immer älter. Da kann man irgendwann keine Ausreden wie „Papa ist auf Arbeit. Wir sollten ihn besser nicht stören.“ mehr verwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580912
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580912,
					"content": "Den Löwenzahn des großen Windgottes findet man auch überall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
