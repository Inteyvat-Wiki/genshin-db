				"points": []
			},
			"dialogs": [
				{
					"id": 200580201,
					"content": "Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580202
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580202,
					"content": "Was willst du denn da oben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580203
					]
				},
				{
					"id": 200580203,
					"content": "Tante Grace sagt, dass man dem Löwenzahn eine heimliche Nachricht geben kann. Wenn man die Samen dann wegpustet, werden sie vom Windgott an die richtige Person weitergetragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580204
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580204,
					"content": "Je höher man steht beim Pusten, desto schneller kommt die Nachricht an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580205
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580205,
					"content": "Glory hat sich auch von einem Abenteurer helfen lassen, damit der Löwenzahn vom Windgott getragen wird ... Ein paar Tage später kam die Antwort von Godwin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580206
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580206,
					"content": "Ich möchte Papa auch etwas sagen. Ich habe sogar schon Löwenzahn gesammelt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580207
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580207,
					"content": "Aber Grace lässt mich einfach nicht. Sie sagt nur immer, dass ich erst bei Papa wohnen kann, wenn ich groß bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580208
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580208,
					"content": "Ich bin schon lange auf der Suche nach einem Weg, um schneller erwachsen zu werden. Aber ich bin immer noch so klein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580209
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580209,
					"content": "Hm ... Ich sehe oft, wie du durch die Stadt fliegst. Kannst du mir zeigen, wie das geht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580210,
						200580212
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580210,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580211
					]
				},
				{
					"id": 200580211,
					"content": "Hihi! Dann sehe ich von hier aus zu. Diesmal sollte Tante Grace eigentlich nichts dagegen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580212,
					"content": "Wollen wir gemeinsam fliegen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580213
					]
				},
				{
					"id": 200580213,
					"content": "Nein, lieber nicht. Sonst sieht Tante Grace das noch und schimpft mit mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				}
			]
		},
