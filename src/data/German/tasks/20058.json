					"nextDialogs": [
						200581103
					]
				},
				{
					"id": 200581103,
					"content": "Dann werde ich so schnell wie möglich erwachsen, damit Papa mit mir spielen kann, wenn er fertig ist mit Arbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200581106
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200581106,
					"content": "Wenn man erwachsen ist, ist das bestimmt nicht mehr so schwer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200581107
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200581107,
					"content": "Danke! Hier, diesen Schatz gebe ich dir. Den habe ich ganz allein gefunden. Das ist mein Geschenk an dich.",
