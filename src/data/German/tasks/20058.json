			"dialogs": [
				{
					"id": 200581101,
					"content": "Wie toll! Werde ich auch so fliegen können, wenn ich groß bin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200581102,
						200581104
