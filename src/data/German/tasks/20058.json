			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200580101,
					"content": "Es ist schrecklich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580102
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580103
					]
				},
				{
					"id": 200580103,
					"content": "Hast du die Statue des Windgottes gesehen? Ganz da oben ist die Hand des Windgottes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580104
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580104,
					"content": "Ich würde so gern da oben spielen ... Aber Tante Grace lässt mich einfach nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580105
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580105,
					"content": "Bitte, bitte hilf mir! Lass Tante Grace woandershin gucken. Ich klettere auch echt schnell ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580106,
						200580108
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580106,
					"content": "Na gut ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580107
					]
				},
				{
					"id": 200580107,
					"content": "Dankeschön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580110
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580110,
					"content": "Du musst Tante Grace einfach nur ein wenig ablenken, damit ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580111
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580111,
					"content": "Nora, nein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580112
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580112,
					"content": "Oh, das tut mir leid. Ich war nur kurz abgelenkt und schon belästigt sie dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580113,
					"content": "Wieso denn? Ich will doch nur da oben spielen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580114
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580114,
					"content": "Auf keinen Fall! Dein Vater würde das nicht erlauben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580115
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580115,
					"content": "Und stimm ihr auf keinen Fall zu! Wenn du sie etwas so Gefährliches tun lässt, wird es mit Sicherheit großen Ärger geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580108,
					"content": "Das ist zu gefährlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580109
					]
				},
				{
					"id": 200580109,
					"content": "Ach, ich kann das wirklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580110
					],
					"speakerTitle": "Nora"
				}
			]
		},
		{
			"id": 2005802,
			"completionStepIds": [
				2005802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
