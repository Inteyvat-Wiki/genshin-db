			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tunner"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4680301,
					"content": "Ich habe leider noch zu tun ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680302
					]
				},
				{
					"id": 4680302,
					"content": "Oh, na dann kann ich nur auf meinen Sohn warten, um diesen Biestern eins auszuwischen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		},
		{
			"id": 46804,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46802",
							"3"
						],
						"stepId": 46802,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tunner"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4680401,
					"content": "Guten Tag! Hat mein Sohn eine Nachricht für mich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680601,
					"content": "Wer bist du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680602
					]
				},
				{
					"id": 4680602,
					"content": "Ich? Die Leute auf dem Weingut nennen mich Tunner. Ich bewirtschafte das Weingut Morgenröte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680603
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680603,
					"content": "Die Vorfahren unserer Familie haben hier schon die Felder gepflügt. Wenn du hier auf einen guten Wein stößt, kann ich mit Recht behaupten, dass er mit hoher Wahrscheinlichkeit von diesen Feldern stammt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680604
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680604,
					"content": "Deswegen haben uns die Inhaber des Weinguts immer gut behandelt. Wir hatten immer genug Nahrung und Kleidung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680605
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680605,
					"content": "Wenn ich daran denke, dass meine Nachfahren hier auch ihr Leben mit dem Pflügen der Felder verbringen sollen, habe ich gar kein gutes Gefühl ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680701,
					"content": "Was ist mit deinem Sohn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680702
					]
				},
				{
					"id": 4680702,
					"content": "Gale! Mein Bursche heißt Gale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680703
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680703,
					"content": "Wie? Du hast noch nicht von ihm gehört? Macht nichts! Du wirst ihn sicher noch kennenlernen. Er ist in ganz Mondstadt bekannt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680704
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680704,
					"content": "Er wird einmal der beste Ritter des Ordo Favonius sein! Das hat er mir so gesagt und natürlich glaube ich an ihn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680705
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680705,
					"content": "Hach, damit er später mal nicht so wie ich ackern muss, habe ich all meine Ersparnisse auf seine Zukunft gesetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680706
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680706,
					"content": "Und jetzt macht er mir alle Ehre. Mit 16 ist er zum Knappen geworden. Seitdem setzen wir alles auf ihn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680801,
					"content": "Tschüs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680802
					]
				},
				{
					"id": 4680802,
					"content": "Bis bald! Sag Gale, dass er gern mal wieder vorbeischauen kann, wenn er Zeit hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		},
