					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650504,
					"content": "Oh Schätzchen, das Licht der spirituellen Kräuter ist gerade ziemlich schwach. Sie müssen sich anscheinend ein bisschen ausruhen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650505
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650505,
					"content": "Trotzdem kann ich euch gern bei einer weiteren Weissagung behilflich sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650506
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650506,
					"content": "Hmm. Das Funkeln der spirituellen Kräuter sagt, dass dir eine glückliche Zukunft bevorsteht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650507
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650507,
					"content": "In den Ruinen einer einsamen, uralten Stadt am Meer im Nordosten verweilt ein Trauergeist, der dir den Weg leiten wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650508
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650508,
					"content": "Allerdings ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650509
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650509,
					"content": "Du musst ein großes Tor für sie öffnen und sie in ein Nest des ewigen Schlummers zurückbringen, um die Belohnung zu erlangen, die das Schicksal für dich bestimmt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650510
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650510,
					"content": "Das war jetzt ein bisschen viel auf einmal ... Irgendwas mit Nestern in einer alten Stadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650511,
					"content": "Haha, kein Problem. Ich werde hierbleiben. Wenn du nicht weiterweißt, kannst du jederzeit herkommen und mir Fragen stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650512
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650512,
					"content": "He! Will sie damit etwa sagen, dass Paimon dumm ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
