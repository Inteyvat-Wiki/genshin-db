					]
				},
				{
					"id": 721650403,
					"content": "Paimon möchte auch wissen, was der heutige Tag bringt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650404,
					"content": "Hmm. Die spirituellen Kräuter sagen dir einen verhängnisvollen Tag voraus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650405
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650405,
					"content": "Der zerstörte Schrein im Osten ist von einer unheilvollen Aura umhüllt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650406
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650406,
					"content": "Äh, das hört sich irgendwie gruselig an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650407,
					"content": "Allerdings ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650408
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650408,
					"content": "All jene, die mutig ausziehen, um solche Vorzeichen zu meistern, werden ihren gerechten Lohn erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650409
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650409,
					"content": "Das hört sich ziemlich genau so an wie das, was du vorher gesagt hast ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650410
					]
				},
				{
					"id": 721650410,
					"content": "Ah, genau so ist das Leben, nicht wahr? Neue Erfahrungen verhüllen sich stets in vertraut anmutenden Tagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komaki"
				}
			]
		},
