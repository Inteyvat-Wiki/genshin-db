					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721650201,
					"content": "Oh, wie geht es euch, ihr jungen Leute?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650202
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650202,
					"content": "Sag mir bitte die Zukunft voraus!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650203
					]
				},
				{
					"id": 721650203,
					"content": "Hehe, mal sehen, ob das heute vielleicht unser Glückstag ist, hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650204,
					"content": "Die spirituellen Kräuter sagen ... dass dir eine schlechte Zukunft blüht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650205
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650205,
					"content": "Im Süden der Insel von Watatsumi gibt es eine Höhle, in der du eine unerwartete und unglückselige Begegnung haben wirst, ein Schwarm von Abschaum und Schurkerei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650206
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650206,
					"content": "Äh, also ein echtes Unglück! Dann, äh ... sollten wir solche Orte lieber meiden, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650207,
					"content": "Hehe. Allerdings ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650208
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650208,
					"content": "Kann das Überwinden eines unglückseligen Schicksals zu unerwartetem Segen führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650209
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650209,
					"content": "Segen? Also ein Schatz, ja? Ist es ein Schatz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650210,
					"content": "Das habe ich nicht gesagt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650211
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650211,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650212,
					"content": "Aber ich habe auch nicht gesagt, dass es kein Schatz ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650213
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650213,
					"content": "Ach, jetzt komm schon, Großmütterchen. Warum musst du dich so benehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
