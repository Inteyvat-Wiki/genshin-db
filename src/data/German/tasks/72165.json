				},
				{
					"id": 721650303,
					"content": "Hehe, mal sehen, ob das heute vielleicht unser Glückstag ist, hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650304,
					"content": "Die spirituellen Kräuter sagen ... dass dir großes Glück ins Haus steht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650305
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650305,
					"content": "Eine gütige Elektro-Seelie wird dich auf deinem Wege zu den Tiefen im Zentrum von Watatsumi geleiten, direkt unterhalb des Schreins von Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650306
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650306,
					"content": "Toll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650307,
					"content": "Das könnte wirklich stimmen. Diese Weissagungen waren immer schon sehr präzise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650308
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650308,
					"content": "Hmm, je mehr du sagst, umso misstrauischer wird Paimon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650309,
					"content": "Kümmere dich nicht um Paimon, Großmütterchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650310
					]
				},
				{
					"id": 721650310,
					"content": "Hehe, kein Problem, kein Problem. Du bist noch sehr jung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650311
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650311,
					"content": "#Warte mal, was willst du damit eigentlich sagen, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
