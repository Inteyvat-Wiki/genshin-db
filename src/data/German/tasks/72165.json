			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Komaki",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721650101,
					"content": "Du bist zurück. Gibt es etwas, das ich für dich tun kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650102
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650102,
					"content": "Sag mir bitte die Zukunft voraus!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650103
					]
				},
				{
					"id": 721650103,
					"content": "#Paimon möchte auch wissen, welche Art von Glück {NICKNAME} heute haben wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650104,
					"content": "Hmm ... Wenn ich das Muster auf den spirituellen Kräutern richtig deute ... hast du eine glückliche Zukunft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650105
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650105,
					"content": "Du wirst dein Glück am höchsten Punkt der Insel Watatsumi finden, an einem uralten Ort, der den Göttern geweiht ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650106
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650106,
					"content": "Hmm ... Warum kann Paimon nichts davon erkennen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650107,
					"content": "Hehe, das nennt man die Weisheit der Alten Einheimischen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650108
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650108,
					"content": "Es hört sich an, als wolltest du Paimon täuschen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7216502,
			"completionStepIds": [
				7216503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
