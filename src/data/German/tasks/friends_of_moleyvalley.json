			"dialogs": [
				{
					"id": 760240101,
					"content": "Ha, jetzt haben wir euch endlich erwischt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240102,
					"content": "Das ist das erste Mal, dass ich den Schatzmarder-Anführer aus der Nähe sehe ... sogar Paimon muss ihn „Anführer“ nennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240115
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240115,
					"content": "W... Was ... Paimon nennt diesen bösen Schatzmarder bestimmt nicht Anführer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240118,
					"content": "Stimmt, böse Kinder können keine Brüder sein. Zu ihren Beerdigungen kommt bestimmt niemand ... es wird wahrscheinlich gar keine Beerdigungen für sie geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240132
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240132,
					"content": "Ach ja, Helka hat mal erzählt, dass es wirklich ein paar seltsame Leute gibt, die seltsames Fleisch essen, zum Beispiel vom Schatzmarder, und andere sammeln lieber Präparate ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240133
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240133,
					"content": "Wenn man so darüber nachdenkt, braucht es sowieso keine Beerdigung mehr zu geben, egal ob sie gegessen oder ausgestopft werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240134
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240134,
					"content": "Waaah ... Auni sagt so schreckliche Dinge, als wäre es das Normalste der Welt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240135,
					"content": "(Sieht sehr verängstigt aus ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240136
					],
					"speakerTitle": "„Schatzmarder-Anführer“"
				},
				{
					"id": 760240136,
					"content": "He! Nicht abhauen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240137,
					"content": "Huh? Anscheinend laufen sie gar nicht weg, sondern warten dort auf uns. Dann lasst uns mal hingehen und nachsehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602402,
