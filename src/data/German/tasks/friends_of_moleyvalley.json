		{
			"id": 7602408,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7602422",
							"3"
						],
						"stepId": 7602422,
						"stateName": "QUEST_STATE_FINISHED"
