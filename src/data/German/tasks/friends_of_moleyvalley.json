			},
			"dialogs": [
				{
					"id": 760241501,
					"content": "Wah, da ist Moleys Familie, der Opa, die Mutter, der Vater, Klein-Moley und Mini-Moley ... und alle anderen Moleys sind auch da, keiner fehlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241502
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241502,
					"content": "Ach, das sind also die Schnüffelmaulwürfe! Aber wie kann Auni sie auseinanderhalten? Sie sehen doch alle gleich aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241503,
					"content": "Sie haben alle unterschiedliche Persönlichkeiten. Das merkt man, wenn man länger mit ihnen zusammen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241504
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241504,
					"content": "Aber sie haben alle dieselbe schlechte Angewohnheit, sie betteln die Menschen um Futter an. *seufz* Die armen Tiere ... Was würden sie nur tun, wenn die Menschen aussterben würden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241505
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241505,
					"content": "... Die Menschen aussterben? Und wird es danach überhaupt noch Schnüffelmaulwürfe geben? D... Das wird doch nicht passieren, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241506,
					"content": "Linnea hat gesagt, dass Tiere aus verschiedenen Gründen aussterben können. Aber Menschen könnten natürlich auch aussterben, warum glaubt Paimon denn, dass das nicht passieren wird?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241507,
						760241509
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241507,
					"content": "Ich werde wohl etwas länger leben als ein Maulwurf ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241508
					]
				},
				{
					"id": 760241508,
					"content": "Aber das beantwortet Aunis Frage auch nicht. Hm, wenn Paimon so darüber nachdenkt, ist die Lage der Menschen wirklich gefährlich. Es gibt so viele Dinge, die das Überleben der Menschheit bedrohen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241512,
					"content": "Jetzt, da wir die Maulwurfsfamilie gefunden haben ... Was machen wir mit den drei Schatzmardern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241513,
					"content": "Wenn du nicht weißt, was wir tun sollen, überlassen wir das einfach den Leuten vom „Flaggschiff“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241514
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241514,
					"content": "Eine Truhe! Äh, oder ist das etwa Bestechung? Ach, egal, wenn sie für uns ist, nehmen wir sie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241515,
					"content": "#Sie sehen aus, als hätten sie ihren Fehler erkannt. {NICKNAME}, dieses Mal lassen wir sie davonkommen. D... Das liegt natürlich nicht nur an der Truhe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241509,
					"content": "Man sagt, dass es Insekten schon vor der Entstehung der Menschen gab ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241510
					]
				},
				{
					"id": 760241510,
					"content": "Und wahrscheinlich werden sie auch dann noch da sein, wenn Menschen aussterben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241511
					]
				},
				{
					"id": 760241511,
					"content": "Sogar gegen Insekten verlieren ...? Irgendwie fühlt sich das total unfair an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241512
					],
					"speakerTitle": "Paimon"
				}
			]
		}
