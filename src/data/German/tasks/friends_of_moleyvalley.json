			"dialogs": [
				{
					"id": 760240301,
					"content": "Sollen wir ihn am Strand vergraben oder oben auf einem Hügel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				}
