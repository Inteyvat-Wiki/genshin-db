							9665.294
						],
						"pointId": 360700068
					}
				]
			},
			"dialogs": [
				{
					"id": 760240501,
					"content": "Auch wenn ihr nicht genau wisst, warum, geht ihr trotzdem zu dem kleinen Mädchen ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760240502
					]
				},
				{
					"id": 760240502,
					"content": "Passt auf die Schatzmarder auf. Sie haben das Moley-Tal schon seit einer Weile besetzt. Wenn sie euch treffen, werdet ihr auch zu Menschen ohne Schatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240503
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240503,
					"content": "Schatzmarder? Wo sind die Schatzmarder? Und was soll das mit den Menschen ohne Schatten heißen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240504,
					"content": "Wah! Was ist mit dieser Maschine los? Sind es die Schatzmarder, die die Maschine bedienen, um uns anzugreifen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240505,
					"content": "Sie wurden von Menschen aufgezogen und sind vielleicht sogar schlauer als wir. Wahrscheinlich haben sie die großen Kerle genau deswegen vertrieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240506
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240506,
					"content": "Die großen Kerle haben es auch schon versucht, sind aber gescheitert. Man sagt, es reicht, wenn man <color=#00E1FFFF>den Energiekern entfernt</color>, aber sie scheitern immer beim letzten Schritt. Sieht so aus, als wäre es doch nicht so einfach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240507
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240507,
					"content": "#Hm, also wenn wir den Energiekern entfernen, können wir den Schatzmarder aufhalten, richtig? {NICKNAME}, sollen wir es versuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240508,
					"content": "Wenn wir es einfach so lassen, ist das viel zu gefährlich, besonders weil hier auch noch ein so kleines Kind ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240509,
					"content": "Wenn Paimon mich darum bittet, ist das natürlich kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240510
					]
				},
				{
					"id": 760240510,
					"content": "Kleine, du kannst dich erst mal hier verstecken ... Sag mal, wie heißt du denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240511,
					"content": "Also wirklich ... Eigentlich ist doch die Kleinste die Kleine, oder? Ich heiße Auni. Du solltest mich „große Auni“ nennen. Alles andere wäre unlogisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240512
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240512,
					"content": "#Hm ... lassen wir die Anrede erst mal beiseite! {NICKNAME}, lass uns den Schatzmarder aufhalten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602406,
