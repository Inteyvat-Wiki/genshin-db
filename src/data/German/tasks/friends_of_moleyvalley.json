					},
					{
						"sceneId": 3,
						"position": [
							1651.032,
							213.487,
							9656.428
						],
						"pointId": 360700011
					},
					{
						"sceneId": 3,
						"position": [
							1650.233,
							213.48,
							9657.646
						],
						"pointId": 360700069
					}
				]
			},
			"dialogs": [
				{
					"id": 760240201,
					"content": "#{NICKNAME}, du bist stärker als diese großen Kerle! Die Größe macht also doch keinen Unterschied.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240202
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240202,
					"content": "#Hehe, stimmt’s? {NICKNAME} mag zwar nicht {F#die Größte}{M#der Größte} sein, aber selbst Monster, die um ein Vielfaches größer sind, sind kein Problem für {F#sie}{M#ihn}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240203,
						760240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240203,
					"content": "Ach was, Paimon ist mir da noch weit voraus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240204
					]
				},
				{
					"id": 760240204,
					"content": "Eh? A... Auch wenn du Paimon so lobst ... Na gut, wenn Paimon das nächste Mal etwas Leckeres hat, bekommst du bestimmt mehr als die Hälfte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240206,
					"content": "#{NICKNAME}, du kannst den Schatzmarder-Anführer doch bestimmt auch aus dem Moley-Tal verjagen, oder? Das ist ja nicht mal ihr Zuhause, und trotzdem haben sie hier alles durcheinandergebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240207
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240207,
					"content": "Die Beerdigung, die geplant war, konnte nicht stattfinden. Opa Moley wurde vielleicht sogar von ihnen umgebracht ... Wenn wir wieder eine Beerdigung durchführen wollen, müssen wir sie erst alle finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240208
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240208,
					"content": "Eh?! Die Schatzmarder sind ... Aber was war das mit der Beerdigung? Paimon hat vorher gar nicht gefragt. A... Aber die findet doch nicht wirklich hier statt, oder? Warum ausgerechnet hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240209,
					"content": "Natürlich. Ich hab schon alles vorbereitet, sogar die Lieder. Hier, schaut mal ... Aber ganz leise, damit er friedlich ruhen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240210
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240210,
					"content": "Auni zieht ein winziges Streichholzschächtelchen aus ihrer Tasche. Beim Öffnen kommt ein hübscher kleiner Käfer zum Vorschein, der auf einem gemusterten Tuch liegt, umgeben von weißen Blütenblättern ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760240211
					]
				},
				{
					"id": 760240211,
					"content": "Da er für immer eingeschlafen ist, müssen wir eine Beerdigung für ihn abhalten. Aber die Orte, die ich ausgesucht hatte, sind alle von den Schatzmardern besetzt, also diese kleinen Hügel mit Maschinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240212
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240212,
					"content": "Moleys Familie ist wohl entweder geflohen oder gestorben. Die Schatzmarder haben ihr Zuhause ganz schön verwüstet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240213
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240213,
					"content": "#({NICKNAME}, Paimon fragt sich ... ob der Opa „Moley“, von dem Auni gesprochen hat, vielleicht ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240214,
						760240216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240214,
					"content": "(Das ist bestimmt irgendein kleines Tier.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240215
					]
				},
				{
					"id": 760240215,
					"content": "(Hmm, Paimon denkt das auch. Vielleicht ist es ihr tierischer Freund.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240218,
					"content": "Hm, wenn das so ist, sollte Paimon Auni helfen und den bösen Schatzmarder schnappen! Und was Moleys Familie angeht ... Sobald wir die Schatzmarder erwischt haben, kann Paimon dir helfen, sie zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240219,
					"content": "#Waah, {NICKNAME} und Paimon, ihr seid so nett zu mir! Ich werde euch zur Beerdigung einladen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240220
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240220,
					"content": "D... Das ist nicht nötig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240221,
					"content": "Na gut. Also, die Zuckerfigur, die ich vorher gekauft habe ... Ach, die ist ja schon weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240222
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240222,
					"content": "Aber ich habe noch das Taschengeld von Jurva. Hm, dann gebe ich es euch und ihr könnt euch selbst Zuckerfiguren kaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240223
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240223,
					"content": "Wenn man um Hilfe bittet, soll man Mora geben und Danke sagen. So gehört sich das, ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240224,
						760240226
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240224,
					"content": "Paimon will einem Kind tatsächlich die Süßigkeiten wegnehmen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240225
					]
				},
				{
					"id": 760240225,
					"content": "Warum stellst du Paimon so dar, als wäre Paimon ein Bösewicht? Aber Auni ist wirklich sehr höflich, obwohl sie noch so klein ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240227,
					"content": "Danke fürs Kompliment. Aber die Mora, die ich geben kann, reichen nur für eine Zuckerfigur pro Person. Mehr kann ich euch trotz eures Lobs nicht geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240228
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240228,
					"content": "Ganz schön realistisch in der Hinsicht ... Nach dem, was du gerade gesagt hast, gibt es wohl mehr als einen Schatzmarder, der Unfug treibt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240229,
					"content": "Hm. Der Schatzmarder, der gerade weggelaufen ist, war nicht der Schatzmarder-Anführer, den ich vorher gesehen habe. Wie viele Handlanger er hat, weiß ich auch nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240230
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240230,
					"content": "Aber dort drüben gibt es auch die gleichen Kugeln schießenden Roboterklauen wie hier. Vielleicht finden wir dort ein paar Handlanger der Schatzmarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240231
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240231,
					"content": "#Na klar, diesmal dürfen die Schatzmarder nicht mehr entkommen! {NICKNAME}, lass uns diesen bösen Schatzmardern eine Lektion erteilen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240226,
					"content": "Auni ist wirklich sehr höflich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240227
					]
				},
				{
					"id": 760240216,
					"content": "(Vielleicht hat hier früher mal jemand gewohnt.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240217
					]
				},
				{
					"id": 760240217,
					"content": "(Hä? Sieht nicht danach aus, als würde hier jemand dauerhaft wohnen ... Paimon denkt, das könnten Aunis tierischer Freund sein! Schau mal, sie veranstaltet sogar Beerdigungen für Käfer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240205,
					"content": "Auch mit den kleinen Monstern werde ich keine Gnade haben!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240206
					]
				}
			]
		},
		{
			"id": 7602403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
