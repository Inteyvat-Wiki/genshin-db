						"pointId": 360700097
					}
				]
			},
			"dialogs": [
				{
					"id": 760240601,
					"content": "Ich vermute, der Schatzmarder-Anführer will es den großen Kerlen nachmachen und Moleys Familie zu ihren Handlangern machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240602
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240602,
					"content": "Aber genau, wie die großen Kerle gescheitert sind, haben der Schatzmarder-Anführer und die anderen wohl auch versagt. Selbst wenn sie das Moley-Tal total verwüstet hätten, würden sie sich nur in ihren Höhlen verstecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240603,
						760240605
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240603,
					"content": "Wir sollten von den Maulwürfen auch nicht zu viel erwarten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240604
					]
				},
				{
					"id": 760240604,
					"content": "Immerhin sind es nur Schnüffelmaulwürfe ... und die Schatzmarder haben sogar gefährliche Waffen! Obwohl es irgendwie absurd ist, dass sie solch gefährliche Maschinen bedienen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240607,
					"content": "Das Moley-Tal gehört jetzt wieder Moleys Familie. Hier sind die versprochenen Mora für eure Hilfe, vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240608
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240608,
					"content": "Ach ja, ihr könnt auch das hier haben. Helka meinte, dass sie keine fiktiven Geschichten in ihrem Büchlein haben möchte, sonst könne man nicht mehr unterscheiden, was echt und was erfunden ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240609
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240609,
					"content": "Ich finde, das spielt doch keine Rolle ... Auch wenn etwas erfunden ist, steckt doch immer auch etwas Wahres darin, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240610
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240610,
					"content": "#{NICKNAME} und Paimon, dann sage ich mal tschüss. Falls der Schatzmarder-Anführer wieder etwas anstellt, werde ich euch um Hilfe bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240611
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240611,
					"content": "#{NICKNAME}, anscheinend haben wir uns einen ganz guten Ruf erarbeitet, hehe. Hoffentlich machen sie diesmal keinen Ärger mehr. Pass gut auf dich auf, Auni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240612,
					"content": "#Ja, {NICKNAME} und Paimon, eine gute Reise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240605,
					"content": "Auch diesmal verlassen sie sich auf Menschen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240606
					]
				},
				{
					"id": 760240606,
					"content": "Immerhin sind es nur Schnüffelmaulwürfe ... Und wenn man darüber nachdenkt, haben die Schatzmarder die gefährlichen Maschinen ja auch wegen der Menschen bedient ... Es ist nur logisch, dass Menschen die Probleme der Menschen lösen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240607
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
