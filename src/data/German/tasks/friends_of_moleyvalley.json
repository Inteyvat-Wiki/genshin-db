							1489.509,
							220.36,
							9700.62
						],
						"pointId": 360700070
					}
				]
			},
			"dialogs": [
				{
					"id": 760240401,
					"content": "Ach ja, die Schatzmarder sind übrigens alle in Richtung dieses Hügels gelaufen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240402,
					"content": "Ja, das war das Zeug, das der große Kerl mitgebracht hat, der den Schatzmarder-Anführer und die anderen trainiert. Vorher hat der Schatzmarder-Anführer es benutzt, um den großen Kerl und seine Leute zu vertreiben. Sie mussten kriechen und sich wegwälzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240403,
						760240404
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240403,
					"content": "Das ist schwer vorzustellen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240406
					]
				},
				{
					"id": 760240406,
					"content": "#Hm, lass uns zum Hügel gehen und dort nachforschen. Aber pass auf, {NICKNAME}! Die Schatzmarder könnten dort lauern, also bitte nicht krabbeln und kriechen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240404,
					"content": "Wenn ich nur dort gewesen wäre ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240405
					]
				},
				{
					"id": 760240405,
					"content": "Willst du ihnen helfen? ... Nein, warte mal, du willst doch nicht nur zugucken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240406
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602405,
			"completionStepIds": [
				7602414
			],
			"beginWay": "TALK_BEGIN_MANUAL",
