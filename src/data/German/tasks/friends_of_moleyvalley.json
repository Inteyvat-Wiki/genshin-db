			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Auni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760240801,
					"content": "Ach ja, wir müssen noch eine Beerdigung abhalten ... Sollen wir die anderen von der Meeresschnecken-Bande einladen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240802,
						760240805,
						760240808
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240802,
					"content": "Über die Meeresschnecken-Bande ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240803
					]
				},
				{
					"id": 760240803,
					"content": "Willst du auch mitmachen? Dann geh zu Jurva, er ist im „Speranza“. Hm ... wenn es zur Abstimmung kommt, Helka ist nicht da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240804
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240804,
					"content": "Macht aber nichts. Jurva hat bestimmt eine andere Lösung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240805,
					"content": "Über die Schnüffelmaulwürfe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240806
					]
				},
				{
					"id": 760240806,
					"content": "Ich vermute, das liegt daran, dass sie immer mit Menschen zusammenleben und deshalb einige menschliche Verhaltensweisen übernommen haben. Das Gleiche gilt für die Schatzmarder und auch für die Saurier von Natlan, wie man hört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240807
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240807,
					"content": "Aber ... ob das nun gut oder schlecht ist ...",
