			"trigger": {
				"objectNames": [
					"Runtuma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751850301,
					"content": "Was sind diese Magma-Eier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850302
					]
				},
				{
					"id": 751850302,
					"content": "Diese Eier gibt es nur in unserer vulkanischen Region!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850303
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850303,
					"content": "Zuerst legst du ein Vogelei auf den geothermischen Schlot, lässt es durch das aus dem Vulkan ausströmende gasförmige Phlogiston grillen, dann nimmst du es genau in dem Moment heraus, wenn es gar ist! Und so bekommst du ein perfektes Magma-Ei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850304
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850304,
					"content": "Aber Vorsicht, nicht zu lange kochen, denn der Geschmack wäre dann sehr ... ungewöhnlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		},
		{
			"id": 7518504,
			"completionStepIds": [
				7518502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
