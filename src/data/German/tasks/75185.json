				"points": []
			},
			"dialogs": [
				{
					"id": 751850201,
					"content": "Jetzt müsst ihr nur noch eine kleine „Vulkanei-Herausforderung“ erledigen! Brecht den geothermischen Schlot dort drüben auf und nehmt die Magma-Eier darin heraus, dann könnt ihr die frisch zubereitete Speise genießen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		},
		{
			"id": 7518503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
