					"Runtuma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751850701,
					"content": "Ah, ihr seid es! Geschickte Reisende aus der Ferne. Na, habt ihr schon versucht, ein paar Magma-Eier selbst zuzubereiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850702,
						751850705,
						751850710
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850702,
					"content": "Ja, und ich fühle mich so energiegeladen, nachdem ich sie gegessen habe!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850703
					]
				},
				{
					"id": 751850703,
					"content": "Haha, natürlich fühlst du dich so! Sie sind doch eine Delikatesse mit der Essenz des Vulkans!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850704
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850704,
					"content": "Es heißt, wenn man sie jeden Tag isst, wird der Körper immer stärker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850705,
					"content": "Ich habe sie zu lange gegrillt. Nachdem ich eines gegessen hatte, wurde ich fast ohnmächtig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850706
					]
				},
				{
					"id": 751850706,
					"content": "Haha, dieser Geschmack war ziemlich unvergesslich, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850707
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850707,
					"content": "Ehrlich gesagt finde ich es eigentlich gar nicht so schlecht, nachdem ich mich daran gewöhnt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850710,
					"content": "Noch nicht, ich probiere es beim nächsten Mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850711
					]
				},
				{
					"id": 751850711,
					"content": "Kein Problem, ich wünsche dir eine gute Reise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		}
