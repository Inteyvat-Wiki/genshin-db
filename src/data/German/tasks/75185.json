				"objectNames": [
					"Runtuma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751850401,
					"content": "Ihr habt wirklich tolle Fähigkeiten! Mit ein paar schnellen Schwüngen habt ihr die Herausforderung schon abgeschlossen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850402
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850402,
					"content": "Lasst mich sehen ... Oh! Diese tiefschwarze Farbe und der konzentrierte Duft regen wirklich den Appetit an! Probiert es schnell, solange es noch heiß ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850403
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850403,
					"content": "Nehmt dieses Rezept auch mit. Wenn ihr in Zukunft wieder Magma-Eier probieren möchtet, könnt ihr es euch selbst zubereiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		},
