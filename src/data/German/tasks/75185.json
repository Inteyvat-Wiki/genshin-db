			"dialogs": [
				{
					"id": 751850101,
					"content": "Reisende aus fernen Ländern, seid gegrüßt! Habt ihr schon von „Magma-Eiern“, unserer regionalen Spezialität des Kollektivs der Fülle, gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
