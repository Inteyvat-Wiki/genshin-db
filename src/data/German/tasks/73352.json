			"dialogs": [
				{
					"id": 733520101,
					"content": "#Oh, {F#liebe Reisende}{M#lieber Reisender} aus der Ferne und {F#ihr}{M#sein} kleines Freundchen, schön euch zu sehen. Hattet ihr Spaß auf dem Sabzeruz-Fest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520102
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520102,
					"content": "Wenn ihr noch Interesse habt, lade ich, der fantastische Spielzeugkönig, euch gern zu einem neuen Spiel ein, das es nur während des Fests gibt: „Schaukelnder Festwagen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520103
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520103,
					"content": "„Schaukelnder Festwagen“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733520104,
					"content": "Schon beim Namen stellt Paimon sich Nahida vor, wie sie sich im Festwagen fröhlich hin- und herwiegt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520105,
						733520106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733520105,
					"content": "Ich kann das Glück irgendwie auch spüren!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520107
					]
				},
				{
					"id": 733520107,
					"content": "Sehr gut! Dass der Dendro-Archon jeden Tag glücklich sein kann, ist ein gemeinsamer Wunsch aller Menschen aus Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520108
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520108,
					"content": "Und was ihr euch da vorstellt, ist ... in der Tat eine wunderbare Szene, die es wert ist, als prächtiges Kunstwerk gemalt zu werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520109
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520109,
					"content": "Dennoch ist die Stimmung in diesem Spiel etwas lebendiger. Es ist keine Feier, sondern eher ein Abenteuer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520110
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520110,
					"content": "„Ob klug oder nicht, brav oder frech, jedes Kind mit einer schönen Seele erhielt am Sabzeruz-Fest seinen eigenen blumigen Festwagen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520111
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520111,
					"content": "„Auf ihrem Wagen erlebten die Kinder einzigartige Abenteuer, überwanden viele Gefahren und fanden am Ende den Schatz der tausend blühenden Blumen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520112,
						733520113
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520112,
					"content": "Paimon ist klug und brav.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520114
					]
				},
				{
					"id": 733520114,
					"content": "Hehe, ganz genau! Und was den Schatz der tausend blühenden Blumen angeht, den holen wir uns auf jeden Fall auch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733520115,
					"content": "In diesem Fall spielt bitte nach Herzenslust! Ich wünsche euch viel Spaß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520113,
					"content": "Wir sind gut darin, Gefahren zu überwinden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520114
					]
				},
				{
					"id": 733520106,
					"content": "Das möchte ich auch sehen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520107
					]
				}
			]
		}
	]
}