				]
			},
			"dialogs": [
				{
					"id": 760220201,
					"content": "He! Du da! Fleischklops! Was soll denn das? Hör sofort auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220202,
					"content": "Mora ... Nein, nein! Er ist für den Tod von Murasaki verantwortlich ... stirb!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220203
					],
					"speakerTitle": "Wütender Samurai"
				},
				{
					"id": 760220203,
					"content": "#Aaaah! {NICKNAME}, sei vorsichtig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602203,
			"completionStepIds": [
				7602203
