				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Peco"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2260.9,
							200.7,
							9289.5
						],
						"pointId": 12118
					},
					{
						"sceneId": 3,
						"position": [
							2260.4,
							200.2,
							9293.5
						],
						"pointId": 13302
					}
				]
			},
			"dialogs": [
				{
					"id": 760220301,
					"content": "Meine Güte, ich danke euch beiden von Herzen für die Rettung! Ich bin Peco, ein reisender Händler. Wenn ihr mal bei mir einkauft, gibt’s den besten Rabatt, ich versprech’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220302
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220302,
					"content": "Heute werde ich echt vom Pech verfolgt. Ausgerechnet heute lauf ich dieser sagenumwobenen Gestalt über den Weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220303
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220303,
					"content": "Sagenumwobene Gestalt? Ist er berühmt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220304,
					"content": "Ja, im Schlechten. Es gibt da ein paar Gerüchte. Ein paar Händlerkollegen haben mir davon erzählt ... Sie waren so verängstigt, dass sie meinten, sie würden diese Route nie wieder nehmen. Ich wollte es zuerst nicht glauben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220305
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220305,
					"content": "Du bist aber mutig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220306,
					"content": "Wir sind fahrende Händler, was wir schon alles gesehen haben. Und wenn wir dann mal zusammensitzen und Geschichten austauschen, na ja ... da wird auch gern mal ein bisschen übertrieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220307
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220307,
					"content": "Aber ich schweife ab ... Sein Name ist „Gonpachi“. Es heißt, er hätte in Inazuma irgendwas angestellt und sei dann hier aufs Land geflohen, gemeinsam mit seiner Liebsten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220308
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220308,
					"content": "Also, als er „Murasaki“ erwähnte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220309
					]
				},
				{
					"id": 760220309,
					"content": "#Stimmt! Dieser Spinner hat diesen Namen auch immer wieder während des Kampfes gegen {NICKNAME} gebrüllt. Sehr seltsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220310,
					"content": "Wer früher schonmal vom rechten Weg abgekommen ist, hat es auch an einem neuen Ort nicht leicht. Da lässt sich nicht so einfach plötzlich ein ehrliches Leben führen. Und ohne ein anständiges Auskommen fällt man schnell wieder in alte Muster zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220311
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220311,
					"content": "Wäre er allein, wäre so ein Lebensstil vielleicht noch vertretbar. Aber man weiß nie, wem man auf die Füße tritt, wenn man ein Leben auf Messers Schneide führt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220312
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220312,
					"content": "Ich habe gehört, dass seine Geliebte auch deshalb gestorben ist ... Wie auch immer, seitdem ist er verrückt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220313
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220313,
					"content": "*seufz* Es ist zwar schrecklich, dass dieser große Kerl die Leute um ihre Mora bringt ... aber so, wie er jetzt aussieht, kann er einem schon ein wenig leidtun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220314,
						760220316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220314,
					"content": "Also Paimon, tu am besten nie etwas Unüberlegtes. Nicht wegen ein paar Mora ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220315
					]
				},
				{
					"id": 760220315,
					"content": "He! Darum geht’s ja wohl nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220318,
					"content": "Na schön, ich werde eure Zeit nicht länger in Anspruch nehmen. Bitte nehmt dies als Dankeschön.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220316,
					"content": "Wenn Paimon eines Tages ausgeraubt werden sollte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220317
					]
				},
				{
					"id": 760220317,
					"content": "#Hehe! Paimon hat ja noch dich, {NICKNAME}! Paimons Mora sind also sicher!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}