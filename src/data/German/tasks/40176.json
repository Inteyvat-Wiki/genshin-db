			"dialogs": [
				{
					"id": 401730501,
					"content": "#Hm? Suchst du nach mir, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730502
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730502,
					"content": "Das rituelle Schwert muss ich dem Häuptling in Kürze zurückbringen, aber alles andere im Lager lasse ich erst einmal so, wie es ist. Ihr könnt es gern benutzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730503
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730503,
					"content": "Ähm ... Ich habe den letzten Band von „Trugbild-Krieger“ hier ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730504
					]
				},
				{
					"id": 401730504,
					"content": "Hö?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730505
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730505,
					"content": "Zusammen mit einer Sonderausgabe von „Die Fallakte des Fräuleins Orith“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730506
					]
				},
				{
					"id": 401730506,
					"content": "Häää?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730507
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730507,
					"content": "Willst du mal reinsehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730508
					]
				},
				{
					"id": 401730508,
					"content": "Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730509
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730509,
					"content": "#(Was ist das? Was ist denn hier los? Woher weiß {F#sie}{M#er}, dass ich auf diese Bücher stehe? Sag mir nicht, dass ... {F#sie}{M#er} meine Interessen erforscht hat?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730510
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730510,
					"content": "(Nein, Quatsch, das wäre lächerlich ... Ich wette, Ororon hat mich verraten, der kleine Schlingel ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730511
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730511,
					"content": "#(Trotzdem ... {F#Sie}{M#Er} hat sich gemerkt, was ich mag? Na ja, eigentlich hätte es auch keinen Unterschied gemacht, wenn nicht, das ist schließlich keine große Sache ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730512
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730512,
					"content": "#(Worauf ich mich konzentrieren sollte, ist die Tatsache, dass {F#sie}{M#er} mich gerade um ein Rendezvous gebeten hat! Was soll ich tun? Wie soll ich reagieren?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730513
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730513,
					"content": "Ähem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730514
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730514,
					"content": "Klar, warum nicht? Ich sollte später etwas Zeit haben. Ich gebe dir Bescheid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		}
	]
}