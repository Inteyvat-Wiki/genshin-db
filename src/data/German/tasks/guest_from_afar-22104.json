			"dialogs": [
				{
					"id": 221040101,
					"content": "Das geht echt zu weit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040102
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040103
					]
				},
				{
					"id": 221040103,
					"content": "Was? Seit wann bist du denn hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040104
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040104,
					"content": "Es ist so, die Monster in der Umgebung werden immer mehr. Mein Mann sagt zwar immer, dass sie nicht zum Gasthaus kommen, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040105
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040105,
					"content": "Aber er so ganz allein ... Da habe ich schon meine Bedenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040106
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040106,
					"content": "Glaubst du, du könntest dich mal in der Umgebung des Gasthauses umsehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040107,
						221040108
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040107,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040109
					]
				},
				{
					"id": 221040109,
					"content": "Danke für deine Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040113
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040113,
					"content": "Jedenfalls wäre es schön, wenn du helfen könntest. Eine Belohnung würdest du natürlich auch bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040108,
					"content": "Aber ist es nicht komisch, hier ein Gasthaus zu führen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040110
					]
				},
				{
					"id": 221040110,
					"content": "Das ist doch ein ganz normales Gasthaus. Es ist vielleicht etwas abgelegen und nimmt viele Gäste entgegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040111
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040111,
					"content": "Aber da haben die Menschen von außerhalb wenigstens einen Platz zum Schlafen und essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040112
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040112,
					"content": "Mein Mann und ich haben uns das jedenfalls so gedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040113
					],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
