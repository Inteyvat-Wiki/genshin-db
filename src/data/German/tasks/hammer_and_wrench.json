			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hammer Li"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420602,
					"content": "Siyu hat ihm diese Laterne geschickt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420603,
						413420604
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420603,
					"content": "Du hast zugehört?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420605
					]
				},
				{
					"id": 413420605,
					"content": "Ha, ich kenne ihn nun mal. Ich musste nicht mal raten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420606
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420606,
					"content": "Das Gleiche hat er letztes Jahr schon gemacht. Er unternahm nur einen kurzen Spaziergang. Dann hämmerte er die ganze Nacht lang Nägel in einen Schiffrumpf. Er verließ nicht eine Sekunde seinen Posten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420607
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420607,
					"content": "Ich kenne den Grund dafür, aber trotzdem *seufz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420608
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420608,
					"content": "#{F#Reisende}{M#Reisender}, könntest du ihm helfen? Während eines Fests sollte man sich nicht selbst quälen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420609
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420609,
					"content": "Na gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420610
					]
				},
				{
					"id": 413420610,
					"content": "*seufz* Entschuldige die Umstände.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420611
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420611,
					"content": "Bestimmt arbeitet er gerade an Deck ... Sieh lieber rasch nach ihm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420612
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420612,
