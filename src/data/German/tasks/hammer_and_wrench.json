			},
			"dialogs": [
				{
					"id": 413420401,
					"content": "#Hmm? Haben wir etwas miteinander zu schaffen, {F#Reisende}{M#Reisender}? Bin gerade ziemlich beschäftigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420402
					],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
				},
				{
					"id": 413420402,
					"content": "Hier ist eine Laterne von Siyu ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4134205,
			"completionStepIds": [
				4134205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134205",
							"2"
						],
						"stepId": 4134205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang Banzi der Schraubenschlüssel"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420501,
					"content": "Siyu? Sie ... sie schickt mir eine Laterne? Lass sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420502
					],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
				},
				{
					"id": 413420502,
					"content": "Hahaha, dieser Wunsch stammt von ihr, oder? Als Kind war das mein allergrößter Wunsch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420503
					],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
				},
				{
					"id": 413420503,
					"content": "Und plötzlich sind so viele Jahre vergangen. Die Zeit vergeht wirklich wie im Flug ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420504
					],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
				},
				{
					"id": 413420504,
					"content": "Aber warum hat sie dich gebeten, diese Laterne zu überbringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420505,
						413420506
					],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
				},
				{
					"id": 413420505,
					"content": "Sie muss sich zu Hause um einiges kümmern ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				},
				{
					"id": 413420507,
					"content": "Ah, ist das so ... Gut, gut. Wirklich gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420508
					],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
				},
				{
					"id": 413420508,
					"content": "Es scheint ihr ganz gut zu gehen. Das ist gut ... Haha ... Ha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420509
					],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
				},
				{
					"id": 413420509,
					"content": "Ja, wirklich gut ist das ... Tut mir leid, aber ich hab noch viel zu erledigen. Wenn du mich entschuldigen würdest ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
				},
				{
					"id": 413420506,
					"content": "Sie muss ihrem Mann zu Hause helfen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				}
			]
		},
		{
			"id": 4134206,
			"completionStepIds": [
				4134206
			],
