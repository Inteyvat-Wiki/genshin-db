			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Siyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420101,
					"content": "Ich sollte ihm wohl doch eine Laterne schicken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420102
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420102,
					"content": "Wem willst du eine Laterne schicken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420103
					]
				},
				{
					"id": 413420103,
					"content": "#Oh, {F#Reisende}{M#Reisender}, du bist es. Der „Schraubenschlüssel“ hat sich immer gut um mich gekümmert. Selbst jetzt hilft er mir die ganze Zeit, er ist wie ein Bruder für mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420104
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420104,
					"content": "Ein Fest ereignet sich, doch er arbeitet die ganze Zeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420105
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420105,
					"content": "Ich möchte ihm eine Laterne schicken. Als Kinder waren wir Spielgefährten. Ich weiß, dass er von ihnen immer begeistert war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420106
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420106,
					"content": "#Sicher hätte er jetzt gerne eine. {F#Reisende}{M#Reisender}, würdest du diese Laterne für mich überbringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420107,
						413420108
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420107,
					"content": "Du gehst nicht selbst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				},
				{
					"id": 413420109,
					"content": "Das würde ich gerne, doch ich muss zu Hause zu viel erledigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420110
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420110,
					"content": "Während ich einkaufen ging, musste mein Mann die ganze Hausarbeit übernehmen. Ich sollte lieber so schnell wie möglich zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420111
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420111,
					"content": "Darum überlasse ich die Laterne dir. Sobald wir Zeit haben, besuchen mein Mann und ich den „Schraubenschlüssel“ zusammen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420112
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420112,
					"content": "Hoffentlich ist er dann etwas weniger beschäftigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420108,
					"content": "Du solltest lieber selbst gehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				}
			]
		},
		{
