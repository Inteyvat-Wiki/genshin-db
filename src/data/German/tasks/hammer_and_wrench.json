			},
			"dialogs": [
				{
					"id": 413420901,
					"content": "Es ist fertig. Hoffentlich musstest du nicht warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420902
					],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
				},
				{
					"id": 413420902,
					"content": "Oh, du hast alles geregelt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420903
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420903,
					"content": "#Ja. Es war keine große Sache, außerdem hat {F#diese Reisende}{M#dieser Reisende} mir dabei geholfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420904
					],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
				},
				{
					"id": 413420904,
					"content": "Du ... *seufz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420905
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420905,
					"content": "Ach, komm schon. Mach kein langes Gesicht, wir haben ein Fest zu feiern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420906
					],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
				},
				{
					"id": 413420906,
					"content": "Klar, wie auch immer. Hast du eine Laterne vorbereitet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420907
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420907,
					"content": "Die Laterne ... Argh, die hab ich vergessen! Mein Gedächtnis spinnt heute ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420908
					],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
				},
				{
					"id": 413420908,
					"content": "Na ja, ist nicht schlimm, oder? Schließlich ist es nur eine Laterne. Wir müssen sie ja nicht unbedingt steigen lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420909
					],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
				},
				{
					"id": 413420909,
					"content": "Ha, versuch es erst gar nicht. Sollen wir das Laternenritual wirklich ohne eine Laternen feiern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420910
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420910,
					"content": "#{F#Reisende}{M#Reisender}, würdest du meinem Kollegen helfen, eine Laterne zu basteln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420911
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420911,
					"content": "Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420912
					]
				},
				{
					"id": 413420912,
					"content": "Danke vielmals. Wir werden hier auf dich warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hammer Li"
				}
			]
		},
