			},
			"dialogs": [
				{
					"id": 413421202,
					"content": "Hmm, die sollten reichen. Vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421203
					],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
				},
				{
					"id": 413421203,
					"content": "Es gibt noch Kleinkram zu erledigen. Dürfte ich dich damit behelligen, am Hafen ein paar neu eingetroffene Waren zu inventarisieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421204
					],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
				},
				{
					"id": 413421204,
					"content": "Es handelt sich um insgesamt drei Kisten am Hafen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421205
					],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
				},
				{
					"id": 413421205,
					"content": "Überlass das ganz mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413421206
					]
				},
				{
					"id": 413421206,
					"content": "Du bist eine große Hilfe. Ich werde mich in der Zwischenzeit um diese Aufgaben kümmern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
				}
			]
		},
