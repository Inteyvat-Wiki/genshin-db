			"dialogs": [
				{
					"id": 413421001,
					"content": "Wir haben getrödelt, sicher hinken wir bereits hinterher. Legen wir uns lieber ins Zeug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421002
					],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
				},
				{
					"id": 413421002,
					"content": "Ist auch wirklich alles in Ordnung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413421003
					]
				},
				{
					"id": 413421003,
					"content": "*seufz* Geht ja nicht anders, oder? Es ist nichts, gar nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421004
					],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
				},
				{
					"id": 413421004,
					"content": "Ich sollte wieder zurück an die Arbeit. Ich denke darüber nach, sobald wir fertig sind ... *seufz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421005
					],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
				},
				{
					"id": 413421005,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413421006
					]
				},
				{
					"id": 413421006,
					"content": "Nun, wenn du willst, dann bring mir einige Holzbretter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
				}
