		{
			"id": 4133704,
			"completionStepIds": [
				4133704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133704",
							"2"
						],
						"stepId": 4133704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370401,
					"content": "Danke! Jetzt können wir eine Laterne flechten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370402,
					"content": "Und fertig. Schreibe unsere Wünsche später auf diese Laterne. Du hattest schon immer eine schöne Handschrift ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370403
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370403,
					"content": "Sicher. Ich kümmere mich darum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370404
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 413370404,
					"content": "Schwester ... bist du wegen irgendetwas ... sauer? Was ist los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370405
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370405,
					"content": "Oh nein, ich bin nicht sauer. Ich könnte gar nicht glücklicher sein, mit dieser Laterne zu helfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370406,
						413370407
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 413370406,
					"content": "*hust* Ähem! Wo willst du mit dieser Laterne hin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370408
					]
				},
				{
					"id": 413370408,
					"content": "Das sollten wir in der Tat, vollkommen richtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370409
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370409,
					"content": "Dann geh, wenn du willst. Ich komme aber nicht mit. Für so eine Kletterpartie fehlt mir die Kraft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370410
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 413370410,
					"content": "Aber ... Aber wir haben uns hier lange genug ausgeruht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370411
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370411,
					"content": "Äh, bei mir sind Kopfschmerzen im Anmarsch. Bei der kalten Bergluft fange ich mir eine Erkältung ein. Der Wind weht stark hier oben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370412
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 413370412,
					"content": "Ich ... Äh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370413,
						413370414
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370413,
					"content": "Bitte, gestatte es mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
					"id": 413370415,
					"content": "Ich ... *seufz* Wenn du so freundlich wärst. Ursprünglich wollte ich sie von einem ganz bestimmten Punkt aus steigen lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370416
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370416,
					"content": "Als die Guhua-Schule noch ... nun ja, existierte, führte mich zu jedem Laternenritual ein älterer Schüler hierher, um eine Laterne steigen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370417
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370417,
					"content": "Leider war die Schule dem Niedergang geweiht. Schon lange hat kein Guhua-Anhänger diesen Ort betreten, um eine Laterne steigen zu lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370418
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370418,
					"content": "Da du deine Hilfe anbietest, werde ich nicht ablehnen. Bitte begib dich dorthin und lass die Laterne für mich steigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370419
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370419,
					"content": "Ich markiere den Ort für dich. Ich muss mich um meinen Gefährten kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370414,
					"content": "Ich lasse die Laterne für dich aufsteigen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
					"id": 413370407,
					"content": "Ähem. Du solltest deine Laterne steigen lassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370408
					]
				}
			]
		},
		{
			"id": 4133706,
			"completionStepIds": [
				4133706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133706",
							"2"
						],
						"stepId": 4133706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370601,
					"content": "Willst du hier ... Laternen aufsteigen lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370602
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370602,
					"content": "Nur die Mitglieder der Guhua-Schule kennen diesen Ort. Eure Gesichter aber sind mir fremd ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370603
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370603,
					"content": "Ich habe einen Auftrag.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370604
					]
				},
				{
					"id": 413370604,
					"content": "In der Guhua-Schule erinnert sich noch jemand an diesen Ort?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370605
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370605,
					"content": "Als ich eintraf, war keiner hier. Das stimmte mich traurig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370606
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370606,
					"content": "Doch jetzt freut es mich, dass sich in der Guhua-Schule noch jemand an diesen Ort erinnert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370607
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370607,
					"content": "Die Guhua-Schule ließ hier Laternen steigen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370608
					]
				},
				{
					"id": 413370608,
					"content": "Ja ... Wir flochten unsere Laternen, dann brachte uns ein älterer Schüler her. Sie gingen voran, wir folgten mit der Laterne in der Hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370609
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370609,
					"content": "Damals ... verschmolzen die Laterne vom Berg und von unten am Himmel zu einer einzigen. Ein wunderbarer Anblick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370610
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370610,
					"content": "Aber jetzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370611
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370611,
					"content": "Lassen wir zuerst die Laternen steigen. Falls ihr danach Zeit habt, können wir weiter über die Vergangenheit reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
		{
			"id": 4133707,
			"completionStepIds": [
				4133713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133713",
							"2"
						],
						"stepId": 4133713,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370701,
					"content": "Einst wollte sich zum Anlass des Laternenaufstieg ein feuriger älterer Schüler mit mir messen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370702
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370702,
					"content": "Bevor ich antwortete, hatte eine treue Mitschülerin schon heimlich Wasser vor ihm auf den Boden geschüttet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370703
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370703,
					"content": "Der Boden war nass und rutschig. Einer der älteren Schüler wollte sein Schwert ziehen, da rutschte er schon aus und landete auf dem Hintern. Ich lachte so sehr, dass ich es ihm gleichtat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370704
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370704,
					"content": "Er war nicht wütend, sondern zeigte nur lachend auf mich. Die anderen standen um uns herum und lachten ebenfalls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370705
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370705,
					"content": "Keine Ahnung, wo er heute ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
		{
			"id": 4133708,
			"completionStepIds": [
				4133714
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133714",
							"2"
						],
						"stepId": 4133714,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370801,
					"content": "Ich erblickte auch einen Hoffnungsschimmer. Es war ein Junge, der noch ganz neu zur Guhua-Schule gehörte. Er war hübsch, gut erzogen und außergewöhnlich talentiert. Es schien, als würde er die Tradition wiederbeleben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370802
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370802,
					"content": "Doch er war schwer zu finden, lange Zeit gab es keine Spur von ihm ... *seufz* Ich hätte nie meine Hoffnungen in ihn setzen dürfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370803
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370803,
					"content": "Ich sollte ihn lieber aufgeben und nicht auf seine Rückkehr warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
		{
			"id": 4133709,
			"completionStepIds": [
				4133715
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133715",
							"2"
						],
						"stepId": 4133715,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370901,
					"content": "Als ich die Guhua-Schule verließ, gab es kaum noch Schüler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370902
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370902,
					"content": "Der Meister gab mir keine Schuld. Er meinte nur, ich solle ein gutes Leben leben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370903
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370903,
					"content": "Doch jetzt weiß ich nicht, ob ich das geschafft habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370904
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370904,
					"content": "... oder bloß ... ein belangloses Leben lebte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370905
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370905,
					"content": "Es heißt, ein Guhua-Schüler namens Sun Yu, der Guhua wiederbeleben will, befinde sich derzeit auf dem Berg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370906
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370906,
					"content": "Hätte ich bloß seinen Mut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370907
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370907,
					"content": "Pardon, ich verplaudere mich ... Es fühlt sich gut an, draußen etwas frische Luft zu schnappen und mir einiges von der Seele zu reden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370908
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370908,
					"content": "Du wirkst niedergeschlagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370909
					]
				},
				{
					"id": 413370909,
					"content": "Oh ... mir geht’s gut. Es ist bloß ... der festliche Anlass.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370910
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370910,
					"content": "Aber es wird langsam spät. Frohes Laternenritual, und ... bitte, würdet ihr dem, der dich mit der Laterne hierher sandte, eine Nachricht überbringen? Sie lautet so:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370911
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370911,
					"content": "Die Nachricht lautet ... Äh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370912
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370912,
					"content": "Äh, äh ... „Frohes Laternenritual von Zhiruo“, schätze ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370913
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370913,
					"content": "Dir auch ein frohes Laternenritual!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370914
					]
				},
				{
					"id": 413370914,
					"content": "Danke. Pass auf dich auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
		{
			"id": 4133710,
