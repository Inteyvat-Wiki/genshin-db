			},
			"dialogs": [
				{
					"id": 413371101,
					"content": "Ist alles in Ordnung? Warum hast du so plötzlich Kopfschmerzen bekommen ... Brauchst du Medizin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371102
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371102,
					"content": "Nein, äh, nicht nötig ... Bleib nur ein bisschen bei mir, das geht vorbei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleine Que’er"
				}
