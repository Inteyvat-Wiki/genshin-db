							"2"
						],
						"stepId": 4133702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370201,
					"content": "Eine Laterne, die hier aufsteigt, sehen die Adepten vielleicht, oder? Doch mit diesen Materialien ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370202
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370202,
					"content": "Was machst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370203
					]
				},
				{
					"id": 413370203,
					"content": "Ah, mein Junior und ich haben uns bloß mit dem Aufstieg der Laternen beschäftigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370204,
					"content": "Leider nur haben wir nicht genügend Materialien zur Hand ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370205,
					"content": "Falls du bereit wärst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370206
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370206,
					"content": "Und schon wieder ... Guhua dies, Guhua das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370207
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 413370207,
					"content": "Das Laternenritual gibt es nur einmal im Jahr, du aber kannst bloß an die Guhua-Schule denken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370208
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 413370208,
					"content": "Haben wir beide etwa nicht die Guhua-Schule besucht? Es ist unsere Aufgabe, die Guhua-Schule wieder zu altem Ruhm zu führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370209
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370209,
					"content": "Ja, Bruder ... Was immer du sagst, Bruder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370210
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 413370210,
					"content": "Verzeihung. Wärst du vielleicht bereit, einige Laternenmaterialien für mich zu beschaffen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370211,
						413370213
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370211,
					"content": "Werde ich machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370212
					]
				},
				{
					"id": 413370212,
					"content": "Hab vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370216
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370216,
					"content": "Ich habe alles überprüft, es fehlt uns immer noch eine Qingxin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370217
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370217,
					"content": "Unsere letzten gepflückten sind mittlerweile vertrocknet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370218
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370218,
					"content": "Ihr könnt Laternen aus Qingxin basteln?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370219
					]
				},
				{
					"id": 413370219,
					"content": "Eine ungewohnte Methode, doch meine Guhua-Mitschüler und ich kamen auf die Idee, als uns langweilig war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370220
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370220,
					"content": "Laternen mit Blumenduft haben einen gewissen Reiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370221
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370221,
					"content": "Ich werde hier auf dich warten. Bitte bring mir die Materialien, sobald du sie hast. Vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370213,
					"content": "Dein Mitschüler hat dir etwas zu sagen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370214
					]
				},
				{
					"id": 413370214,
					"content": "Nein, es war nichts! Was er auch will, ist in Ordnung für mich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370215
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 413370215,
					"content": "*seufz* Schwester ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370216
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
