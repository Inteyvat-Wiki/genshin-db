				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413371001,
					"content": "Ah, du bist zurück. Hast du die Laternen steigen lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371002
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371002,
					"content": "Als wir die Laterne aufsteigen ließen, sind wir jemandem begegnet ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413371003
					]
				},
				{
					"id": 413371003,
					"content": "Verstehe. Ja, Zhiruo ... Ich erinnere mich an sie. Sie hat sich vor langer Zeit um mich gekümmert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371004
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371004,
					"content": "Und sie denkt immer noch an die Guhua-Schule. Wie erfreulich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371005
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371005,
					"content": "Wie geht es der kleinen Que’er?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413371006
					]
				},
				{
					"id": 413371006,
					"content": "Ihre Kopfschmerzen werden besser. Vielleicht hat sie sich bloß einen Schnupfen eingefangen. Jetzt geht es um ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371007
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371007,
					"content": "Bruder, diese Zhiruo, die du gerade erwähntest ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371008
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 413371008,
					"content": "Gehörte sie zur Guhua-Schule? War sie schön? Hast du sie gut gekannt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371009
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 413371009,
					"content": "Oh, nun ja, allzu gut kannte ich sie nicht ... Aber Zhiruo war eine recht talentierte Heilerin. Wer verletzt war, ging direkt zu ihr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371010
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371010,
					"content": "Hahaha, jetzt, da ich darüber nachdenke, waren wahrscheinlich viele in der Guhua-Schule in sie verschossen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371011
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371011,
					"content": "Auch du, Bruder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371012
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 413371012,
					"content": "Oh, äh, ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371013
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371013,
					"content": "Bruder, was für ein Verhältnis ... hattest du zu Zhiruo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371014
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 413371014,
					"content": "Äh ... Wir stehen uns wirklich nicht sonderlich nah. Wir teilen das Schicksal unserer Schule ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371015
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371015,
					"content": "Oh ... Aber Bruder, in was für einem Verhältnis stehen dann wir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371016
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 413371016,
					"content": "Hahaha, wir teilen natürlich ebenfalls das Schicksal unserer Schule!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371017
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371017,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371018
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 413371018,
					"content": "Que’er? Was ... Was hast du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
