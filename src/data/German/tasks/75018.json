					"nextDialogs": [
						750180347
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180347,
					"content": "Hehe, auf euch ist echt Verlass! Ich gehe dann mal zurück ins Lager, um ein paar Dinge vorzubereiten. Kururuk ist jetzt in eurer Obhut!",
