							-1245.777,
							277.26,
							9383.85
						],
						"pointId": 9801
					}
				]
			},
			"dialogs": [
				{
					"id": 750180301,
					"content": "„Ga!“\\nAls ob er wüsste, dass er nicht gewinnen kann, fliegt der Qucusaurier unter lautem Kreischen davon ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750180302
					]
				},
				{
					"id": 750180302,
					"content": "Waah!! Der fliegt ja schnell! Einmal nicht hingeschaut und schon ist er weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180303,
						750180305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180303,
					"content": "Paimon, los, schnell hinterher!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180304
					]
				},
				{
					"id": 750180304,
					"content": "Hä? Paimon soll ihn verfolgen? Meinst du echt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180307,
					"content": "Hm, wenn er so schnell fliegen kann, scheint er sich ja immerhin gut erholt zu haben. Jetzt sollten wir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180308
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180308,
					"content": "Aber warum war der Qucusaurier überhaupt so sauer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180309,
					"content": "... Ah, das muss es sein! Du hast ihm doch nicht etwa seine Leckereien weggegessen? Da hört der Spaß nämlich wirklich auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180310,
					"content": "Leckereien? Ich habe etwas davon gegessen, aber Kururuk ist doch nicht so geizig. Über so eine Kleinigkeit würde er sich nicht aufregen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180311
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180311,
					"content": "„Kururuk“? Also hat er auch einen Namen ... Aber sein Temperament lässt echt zu wünschen übrig, so wie er gerade um sich geschlagen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180312,
					"content": "Na ja, man kann es ihm nicht übel nehmen, es ist ja alles im Sinne der Heilung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180313
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180313,
					"content": "Schläge gehören also auch zur Behandlung ... Wieder was gelernt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180314
					]
				},
				{
					"id": 750180314,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180315
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180315,
					"content": "#Das kann doch keine Behandlung sein! Siehst du, jetzt glaubt {REALNAME[ID(2)|SHOWHOST(true)]} dir auch noch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180316,
					"content": "*brüll*? *brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180317,
					"content": "Haha, wenn diese Heilmethode wirklich hilft, würde ich sie auch mal ausprobieren! Aber Saurier sind eben nicht wie Menschen ... Auch wenn du ihnen erklärst, dass es hilft, werden sie es nicht verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180318
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180318,
					"content": "Ach ja, ich hab mich noch gar nicht vorgestellt. Ich bin Mazkal. Normalerweise kümmere ich mich hier in der Gegend um verletzte oder kranke Saurier. Nicht, dass ich prahlen will, aber meine Heilmittel haben einen ziemlich guten Ruf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180319
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180319,
					"content": "Euer kleiner Freund sieht sehr gesund aus. Er scheint meine Hilfe nicht zu brauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180320
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180320,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180321,
					"content": "Du bist also Saurierärztin? Wenn Paimon sich so Kururuks Zustand anschaut, dürfte das eine ziemlich anstrengende Arbeit sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180322,
					"content": "So anstrengend ist es nicht, aber Kururuk ist ein schwieriger Fall ... Er hat keinerlei Vertrauen in Menschen und lehnt jede Behandlung und jedes Medikament strikt ab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180323
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180323,
					"content": "Ach, wenn ich doch ein Saurier wäre ... Er kommt mit anderen Sauriern ja prima aus. Vielleicht würde er die Medizin doch nehmen, wenn ein anderer Saurier sie ihm gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180324
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180324,
					"content": "*brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180325
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180325,
					"content": "Wenn das so ist, könnten wir vielleicht helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180326,
					"content": "Hm? Meinst du etwa, dass ihr in Wirklichkeit Saurier seid, obwohl ihr so ausseht, wie ihr halt ausseht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180327
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180327,
					"content": "Deine Gedankengänge sind ganz schön sprunghaft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180328,
					"content": "#Wie auch immer. {REALNAME[ID(2)|SHOWHOST(true)]} ist eigentlich ein extrem kluger kleiner Saurier! Er kann uns bestimmt helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180329,
					"content": "Hä? Ist er wirklich so schlau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180330,
						750180332
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180330,
					"content": "Er hat mich ausgewählt, das spricht für seinen guten Geschmack.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180331
					]
				},
				{
					"id": 750180331,
					"content": "Kann schon sein ... aber darum geht es doch gerade gar nicht, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180333,
					"content": "#Das bisschen Arbeit überlassen wir jetzt einfach {REALNAME[ID(2)|SHOWHOST(true)]}, das wird schon klappen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180334,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180335
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180335,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, dann bedanke ich mich schon mal im Namen von Kururuk bei dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180336
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180336,
					"content": "Ich hatte wirklich große Sorge, dass er sich durch diese Wutanfälle nicht nur nie mehr erholen, sondern sich womöglich noch weitere Verletzungen zuziehen würde ... Aber jetzt, da ihr helfen wollt, bin ich beruhigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180337
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180337,
					"content": "Ich hab für Kururuk zwei Arzneien vorbereitet. Ich wünschte, ich könnte die Heilwirkung mit einem guten Geschmack verbinden, aber so ein Rezept habe ich noch nicht gefunden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180338
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180338,
					"content": "Also, eine davon wirkt besser, aber Saurier mögen den Geschmack nicht. Die andere schmeckt besser, wirkt aber nicht so gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180339
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180339,
					"content": "#Vielleicht wäre es gut, wenn {REALNAME[ID(2)|SHOWHOST(true)]} mal daran riecht, dann versteht ihr schon, was ich meine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180340
