						750180348
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180348,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} ist ein verlässlicher Gefährte, überlass das ruhig ihm!",
