			"dialogs": [
				{
					"id": 750180101,
					"content": "... Ga! Ga! Ga! Ga! Ga! Ga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180102
					],
					"speakerTitle": "„Kururuk“"
				},
				{
					"id": 750180102,
					"content": "Kleiner, mach nicht so einen Aufstand! Ohne die Medizin wirst du doch nicht gesund ... *seufz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180103
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180103,
					"content": "#Achtung! {NICKNAME}, wir müssen ihr helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
