						750180344
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180344,
					"content": "Wah, das sieht man ja sofort!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180345,
					"content": "Ganz gleich, welche Kururuk nimmt, sie wird ihm auf jeden Fall helfen. Ich gebe euch beide mit, und ihr entscheidet, welche besser passt.",
					"roleType": "TALK_ROLE_NPC",
