					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181008
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750181008,
					"content": "#Hehe, wenn jemand {REALNAME[ID(2)|SHOWHOST(true)]} lobt, fühlt sich das schöner an, als wenn Paimon selbst gelobt wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750181009,
					"content": "Ihr beide versteht euch super mit dem kleinen Tepetlisaurier, wirklich klasse! Davon könnte ich mir noch was abgucken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181010,
						750181011
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181010,
					"content": "Tja, so bin ich eben!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750181012
					]
				},
				{
					"id": 750181012,
					"content": "Ich wünschte, ich könnte noch etwas für euch tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181013
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181013,
					"content": "... aber ich wünsche euch einfach nur das Beste und hoffe, ihr müsst nie wieder meine Dienste in Anspruch nehmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181014
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181014,
					"content": "Ach ja, falls ihr einfach mal zum Plaudern vorbeikommen wollt, seid ihr immer willkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181015
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181015,
					"content": "Ach, hoffentlich wird Kururuk bald wieder fit und hört auf, einfach auf andere Leute loszugehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750181016,
					"content": "Na ja ... vertrau mir, ich werde mir etwas einfallen lassen. Wenn seine Wunden verheilt sind, wird er bestimmt auch friedlicher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181011,
					"content": "#Ach was, {REALNAME[ID(2)|SHOWHOST(true)]} ist der wahre Held.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750181012
					]
				}
			]
		},
