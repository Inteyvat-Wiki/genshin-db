					{
						"sceneId": 3,
						"position": [
							-1244.858,
							277.046,
							9382.045
						],
						"pointId": 10325
					},
					{
						"sceneId": 3,
						"position": [
							-1243.222,
							276.828,
							9382.064
						],
						"pointId": 9800
					},
					{
						"sceneId": 3,
