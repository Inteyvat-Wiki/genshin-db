				]
			},
			"dialogs": [
				{
					"id": 742510101,
					"content": "Vielen Dank für die Einladung, Fräulein Guillotin. Ich nehme an, dieses reine Wasser wurde speziell für mich zubereitet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510102
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510102,
					"content": "Keine Ursache, Monsieur Neuvillette. Es ist mir eine Ehre, dass sich der Oberste Richter von Fontaine trotz seines vollen Terminplans Zeit nimmt, um mit mir eine Tasse ... Wasser zu trinken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510103,
					"content": "Haben die Fatui ein offizielles Anliegen, das du mit mir besprechen möchtest, Fräulein Guillotin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510104
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510104,
					"content": "Mitnichten. Das ist ein rein privater Besuch. Und du brauchst nicht so förmlich zu sein. Ich wollte dich einfach nach einem alten Bekannten fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510105
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510105,
					"content": "Ein alter Bekannter ... Ah, du sprichst sicher von Herrn Alain Guillotin? Dem großartigen Herrn der wunderlichen Maschinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510106
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510106,
					"content": "Genau. Was für ein Mensch war er? Ich habe gehört, dass er in seiner Jugend dein Untergebener war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510107,
					"content": "Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510108
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510108,
					"content": "Herr Guillotin war ein ernsthafter und bodenständiger junger Mann. Selbst nachdem ihm der Titel des Weißen Kavaliers verliehen wurde, zeigte er nicht einen Funken Arroganz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510109
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510109,
					"content": "Er verbrachte die meiste Zeit damit, Maschinen zu erforschen. Die Welt außerhalb seiner eigenen kleinen Blase interessierte ihn kaum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510110
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510110,
					"content": "Hm ... Er war also schon in jungen Jahren so? Ich frage mich, ob er für sein Alter sehr weise war oder einfach keine Ahnung von der Welt hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510111,
					"content": "Allerdings ... Er hat sich stark verändert, nachdem er seine Familie und Freunde verloren hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510112
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510112,
					"content": "Der Turm der Gestalt? Und Elynas ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510113
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510113,
					"content": "#In der Tat. Als er und ich den Befehl zur Durchsuchung des Turms unterschrieben, wirkte er{NON_BREAK_SPACE}... hilflos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510114
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510114,
					"content": "Die Distanz und Entfremdung der Vergangenheit haben zu all dem geführt. Er muss sich auch schuldig gefühlt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510115
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510115,
					"content": "Hmm ... Danach wurde er noch schweigsamer und wir hatten weniger Kontakt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510116
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510116,
					"content": "Bei der Zeremonie, bei der ihm der Titel des Herrn der wunderlichen Maschinen verliehen wurde, sagte er nur Folgendes:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510117
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510117,
					"content": "„Ein ruhiges, bescheidenes Leben ist ein sichererer Weg zum Glück als das blinde Streben nach endloser Perfektion.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510118
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510118,
					"content": "Heh ... Und genau so hat er in seinen späteren Jahren gelebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510119
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510119,
					"content": "Ich glaube, das hat er nicht nur zur Menge gesagt. Er hat es zu sich selbst gesagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510120
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510120,
					"content": "Und was hältst du von all dem, Fräulein Guillotin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510121
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510121,
					"content": "Ich? Hmpf. Ich werde nicht über seine Erkenntnis oder seine Lebensweise urteilen, genau wie er mir nie gesagt hat, wie ich mein eigenes Leben leben soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510122
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510122,
					"content": "Aber ich habe weder vor, seinen Weg zu gehen, noch seine Ideale nachzuahmen. Ich bin schließlich ich selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510123
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510123,
					"content": "Heh ... Danke. Du hast mir geholfen, ihn besser zu verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510124
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510124,
					"content": "Gern geschehen. Es ist mir eine Freude, Geschichten aus der Vergangenheit mit jemandem aus seiner Familie zu teilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				}
			]
		},
		{
			"id": 7425102,
