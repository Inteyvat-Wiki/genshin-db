			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neuvillette"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742510201,
					"content": "Und es ist mir eine Freude, bei diesem wunderbaren Glas Wasser Geschichten aus der Vergangenheit mit dir zu teilen, Fräulein Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510202,
						742510203
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510202,
					"content": "(Lass uns noch ein Weilchen so sitzen bleiben.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510204,
					"content": "Also gut. Wohin auch immer du als Nächstes gehst, ich wünsche dir eine gute Reise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510203,
					"content": "Ich glaube, es wird Zeit, dass ich mit dem Aufräumen anfange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
}