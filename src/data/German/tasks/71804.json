			"dialogs": [
				{
					"id": 718040601,
					"content": "Hallo? Möchtest du etwas einreichen? Gibt es Fragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040602
					],
					"speakerTitle": "Beamte Zhao"
				},
				{
					"id": 718040602,
					"content": "Ivanovich will eine neue Betriebserlaubnis beantragen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040603
					]
				},
				{
					"id": 718040603,
					"content": "Du vertrittst ihn also? Gut. Seine <color=#00E1FFFF>alte Betriebserlaubnis</color>, bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040604
					],
					"speakerTitle": "Beamte Zhao"
				},
				{
					"id": 718040604,
					"content": "Wenn du sie hast, übergib sie. Wenn er eine neue will, brauche ich die.",
