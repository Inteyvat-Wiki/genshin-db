					"nextDialogs": [
						718045105
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718045105,
					"content": "Das stimmt, aber zu viel ist zu viel. Mir wird schon ganz schwindlig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718045106,
					"content": "Ist es in Snezhnaya auch so?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718045107
					]
				},
				{
					"id": 718045107,
					"content": "Du meinst, ob es so bürokratisch zugeht? Nun, nicht wirklich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718045108
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718045108,
					"content": "Aber davon könnte ich dir jetzt ewig erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718045109
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718045109,
					"content": "Wenn du je nach Snezhnaya kommst, wirst du es schon sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
