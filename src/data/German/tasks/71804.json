					"nextDialogs": [
						718045104
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718045104,
					"content": "Fühlen wir uns nicht alle sicherer, wenn alle großen und kleinen Dinge schwarz auf weiß festgehalten werden?",
