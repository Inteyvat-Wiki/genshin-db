						],
						"stepId": 7180403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718040301,
					"content": "Hast du die Ankündigung gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040302
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040302,
					"content": "Ich habe alles aufgeschrieben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040303
					]
				},
				{
					"id": 718040303,
					"content": "Wunderbar! Lass mich mal sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040304
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040304,
					"content": "Die Kopien des Ausreiseantrags, die Betriebsgelände- und Sicherheitsurkunde ... und eine alte Betriebserlaubnis ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040305
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040305,
					"content": "Gut, gut. Ich habe diese Dokumente schon vor einigen Tagen unterzeichnen lassen, das war eine echte Strapaze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040306
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040306,
					"content": "#{F#Reisende}{M#Reisender}, würdest du mir helfen, jedes dieser Dokumente einzureichen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040307
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040307,
					"content": "Allerdings ... *hust* gibt es womöglich viele Leute, die ihre Dokumente ebenfalls einreichen wollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040308
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040308,
					"content": "Nun, zuerst muss den <color=#00E1FFFF>Ausreiseantrag</color> zum nervösen An. Dann müssen die Dokumente zur <color=#00E1FFFF>Betriebsgelände- und Sicherheitsurkunde</color> einem Millelithen-Soldaten namens Jiayi übergeben werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040309
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040309,
					"content": "Schließlich muss die <color=#00E1FFFF>alte Betriebserlaubnis</color> zur Beamten Zhao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040310
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040310,
					"content": "#Bitte hilf mir, sie zu überbringen, {F#Reisende}{M#Reisender}. Du wirst auch angemessen entschädigt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040311
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040311,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040312
					]
				},
				{
					"id": 718040312,
					"content": "Hoffentlich war es das dann mit all den Prozeduren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040313
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040313,
					"content": "Das hoffe ich auch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040314
					]
				},
				{
					"id": 718040314,
					"content": "Nun, du musst das nur einmal erledigen, aber ich ... ich darf die ganze Chose irgendwann wiederholen, wenn ich hier Geschäfte machen will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040315
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040315,
					"content": "*seufz* Diese ganzen Prozeduren garantieren zwar eine gewisse Sicherheit, aber warum vereinfacht man sie nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
