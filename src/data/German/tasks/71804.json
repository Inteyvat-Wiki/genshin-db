				"points": []
			},
			"dialogs": [
				{
					"id": 718040501,
					"content": "Immer der Reihe nach! Immer der Reihe nach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040502,
						718040504
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718040502,
					"content": "Ivanovich will eine neue Betriebserlaubnis beantragen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040503
					]
				},
				{
					"id": 718040503,
					"content": "Oh? Du vertrittst ihn also? Verstehe? Dürfte ich dann das Dokument zu den Geschäftsräumen sehen und ... Äh, was war es noch mal? Stimmt ... das Sicherheitszertifikat. Hast du beides dabei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718040504,
					"content": "Bist du für diese Zertifikate verantwortlich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040505
					]
				},
				{
					"id": 718040505,
					"content": "Nein, nein, ich helfe nur spontan aus, so wie du. Die Beamte Zhao hat gerade alle Hände voll zu tun, darum helfe ich dabei, diese Dokumente entgegenzunehmen und zu erfassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040506
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718040506,
					"content": "*seufz* Wirklich ermüdende Arbeit ... Also, hast du sowohl das Dokument zu den Geschäftsräumen als auch das Sicherheitszertifikat dabei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
		{
			"id": 7180406,
