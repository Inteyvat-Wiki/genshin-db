			"dialogs": [
				{
					"id": 718040401,
					"content": "Der Papierkram für diese Prozeduren ist schon wieder unvollständig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040402
					],
					"speakerTitle": "Nervöser An"
				},
				{
					"id": 718040402,
					"content": "Ivanovich will eine neue Betriebserlaubnis beantragen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040403
					]
				},
				{
					"id": 718040403,
					"content": "Ivanovich? Oh, stimmt, ich erinnere mich an ihn. Er war schon ein paarmal da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040404
					],
					"speakerTitle": "Nervöser An"
				},
				{
					"id": 718040404,
					"content": "Er will eine neue Betriebserlaubnis beantragen? Haha ... Da ist er gerade sicher schrecklich beschäftigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040405
					],
					"speakerTitle": "Nervöser An"
				},
				{
					"id": 718040405,
					"content": "Ich nehme an, du willst ihm helfen. Hast du den <color=#00E1FFFF>Ausreiseantrag</color> dabei? Ich sagte ihm, dass seine Dokumente nicht vollständig waren und er noch etwas ausfüllen musste ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nervöser An"
				}
			]
		},
		{
