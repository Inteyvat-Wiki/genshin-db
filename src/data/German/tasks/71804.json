			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 718040201,
					"content": "Dies ist das Anschlagsbrett am Feiyun-Hang. Hier stehen allgemeine Nachrichten und Werbung von Geschäften. Bitte nur Dinge anbringen, die von Belang sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040202,
						718040205,
						718040208
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 718040202,
					"content": "Suchen wir nach Infos zu Versetzungen beim Rat ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040203
					]
				},
				{
					"id": 718040203,
					"content": "„Die Versetzungen beim Allgemeinen Rat sind folgende ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040204
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 718040204,
					"content": "Warte mal. Wir sollen doch nach den Geschäftszulassungen sehen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718040205,
					"content": "Suchen wir nach Neuigkeiten zur Wasserverschmutzung am Feiyun-Hang ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040206
					]
				},
				{
					"id": 718040206,
					"content": "„Was die jüngste Wasserverschmutzung am Feiyun-Hang betrifft ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040207
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 718040207,
					"content": "Komm schon, Ivanovich hat nicht viel Zeit. Darum können wir uns gerade nicht kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718040208,
					"content": "Suchen wir nach Neuigkeiten zu den Geschäftszulassungen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040209
					]
				},
				{
					"id": 718040209,
					"content": "„Wer eine neue Geschäftszulassung beantragen will, sollte folgende Schritte unternehmen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040210
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 718040210,
					"content": "Da sollte es um die neue Geschäftszulassung gehen, die Ivanovich beantragen will. Schreiben wir es auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7180403,
			"completionStepIds": [
				7180403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
