			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070201,
					"content": "Hat es sich geöffnet? Hat es sich geöffnet? Hat unser „Inazumadept“ hier einen Schatz hinterlassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070202,
					"content": "Was ist das denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070203
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070203,
					"content": "Hm ... Sieht wie ein Buch aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070204,
					"content": "Scheint ein weiteres Notizbuch zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070205
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070205,
					"content": "Könnte das Tsubakis Notizbuch sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070206
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070206,
					"content": "Gehen wir wieder nach draußen. Die Atmosphäre hier ist anders, als ich sie mir vorgestellt habe. Irgendwie ... will ich das Notizbuch hier nicht lesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070207
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070207,
					"content": "Paimon versteht, was du meinst. Gedimmtes Licht ist nicht gut für die Augen. Kommt, gehen wir wieder nach draußen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1200703,
			"completionStepIds": [
				1200707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200707",
							"2"
						],
						"stepId": 1200707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070301,
					"content": "Hier ist es gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070302
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070302,
					"content": "Dann sehen wir doch mal, was drinsteht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070303,
					"content": "Oooh, Paimon wettet, dass etwas über geheimnisvolle Schätze drinsteht! Ist das aufregend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070304,
					"content": "Psst, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070305
					]
				},
				{
					"id": 120070305,
					"content": "Was ist? Warum flüsterst du plötzlich? Paimon wird ganz nervös ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070306,
					"content": "Komm. Gehen wir da drüben hin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070307
					]
				},
				{
					"id": 120070307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070308
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070308,
					"content": "Oooh, du willst, dass Ayaka das Notizbuch ungestört lesen kann. Da muss also etwas ganz Wichtiges drinstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070309,
					"content": "Aber, hm, ihrem Gesichtsausdruck nach ... ist es wohl keine Schatzkarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070310,
					"content": "Hmm, was könnte es sonst sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070311,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070312
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070312,
					"content": "Puuuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070313
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070313,
					"content": "#{F#Reisende}{M#Reisender}, Paimon, entschuldigt bitte, dass ihr warten musstet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070314
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070314,
					"content": "Ach, so lange war das doch gar nicht! Du liest ganz schön schnell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070315,
					"content": "Hast du das Notizbuch zu Ende gelesen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070316
					]
				},
				{
					"id": 120070316,
					"content": "Ja, habe ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070317
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070317,
					"content": "Ich glaube, ich sollte euch die Wahrheit über dieses Notizbuch erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070318
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070318,
					"content": "Auch wenn der Inhalt nicht ganz der war, den ich erwartet hatte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070319
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070319,
					"content": "Inwiefern? Gehört es also keinem Fuchsboten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070320,
					"content": "Nein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070321
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070321,
					"content": "Wie sich herausgestellt hat, ist Tsubaki ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070322
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070322,
					"content": "... meine Mutter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070323
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070323,
					"content": "Hm?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070324,
					"content": "Überrascht? Ja, ich auch ... Aber so steht es gleich auf der ersten Seite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070325
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070325,
					"content": "„Tsubaki und ich sind ein und dieselbe Person und doch sind wir unterschiedlich. Wenn ich zu Tsubaki werde, bin ich nicht mehr Kamisato Kayo, sondern die normalste Frau der Welt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070326
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070326,
					"content": "„Auf den folgenden Seiten wird nur der völlig normale Alltag einer völlig normalen Person beschrieben. Nicht mehr und nicht weniger.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070327
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070327,
					"content": "Im Grunde ist das Notizbuch eine Sammlung privater, völlig unspektakulärer Gedanken meiner Mutter. Alles was wir über Tsubaki dachten ... betrifft in Wirklichkeit meine Mutter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070328
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070328,
					"content": "Also ... waren dieser Kimono-Entwurf und diese ausländischen Gerichte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070329,
					"content": "Alles Dinge, die meine Mutter mal ausprobieren wollte, ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070330
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070330,
					"content": "Das klingt zwar alles ziemlich bizarr, aber ich kann das Verhalten meiner Mutter nun verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070331
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070331,
					"content": "Oder besser gesagt ... Auch ich habe noch eine andere Seite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070332
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070332,
					"content": "Ich war sprachlos, als ich begann, das Notizbuch zu lesen. Es war, als hätte jemand in meinen Kopf gesehen und meine eigenen Gedanken aufgeschrieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070333
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070333,
					"content": "Ayaka ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070334,
					"content": "In dem Moment, als meine Mutter meinen Vater heiratete, wurde sie die Mutter der Familie Kamisato. Und damit übernahm sie auch alle Pflichten, die diese Rolle mit sich brachte. Gleichzeitig brachte auch das Prestige der Yashiro-Verwaltung viel Verantwortung mit sich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070335
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070335,
					"content": "Dazu wurde jede ihrer Handlungen als Repräsentation der Familie Kamisato gesehen. Die Leute beobachteten sie ständig. So konnte sie nie die Dinge tun, die sie wirklich tun wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070336
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070336,
					"content": "Nach dem Tod meines Vaters übernahmen Ayato und ich die Verantwortung für die Familienangelegenheiten. Wir hatten damals extrem viele Schwierigkeiten damit ... Wahrscheinlich können sich Außenstehende kaum vorstellen, wie so etwas ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070337
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070337,
					"content": "Jedes Mal, wenn ich ein schwieriges Problem hatte, fragte ich mich, ob meine Mutter das auch durchmachen musste und was sie in dieser Situation getan hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070338
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070338,
					"content": "Vielleicht liegt es daran, dass ich sie so lange nicht gesehen hatte, aber ... irgendwie war die einzige Erinnerung an sie in meinem Kopf die Seite von ihr, die Ehrfurcht einflößte und Respekt gebot ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070339
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070339,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070340
					]
				},
				{
					"id": 120070340,
					"content": "Aber mein Bild von ihr war falsch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070341
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070341,
					"content": "Während ich das Notizbuch las, merkte ich, dass sie genauso war wie ich. Welche Position auch immer sie innehatte, im Grunde war sie eine ganz normale Frau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070342
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070342,
					"content": "Sie mochte hübsche Kimonos, sie wollte fremdes Essen probieren und Orte sehen, die sie noch nie zuvor gesehen hatte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070343
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070343,
					"content": "Vielleicht klingt das in euren Ohren etwas unreif, aber ich empfinde auch so. Ich möchte mein Leben nicht als Kamisato Ayaka führen, sondern als normale Frau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070344
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070344,
					"content": "Mutter schrieb, dass sie immer gerne auf ein Fest in Inazuma gehen wollte und dass man in klaren Nächten manchmal die Lichter in der Ferne sehen konnte, wenn man von unserem Haus aus hinausblickte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070345
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070345,
					"content": "Ich hab diese Lichter auch gesehen! Es war immer so voller Menschen und so festlich und hell, dass der ganze Himmel leuchtete ... Natürlich hatte ich manchmal auch etwas Angst um die öffentliche Ordnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070346
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070346,
					"content": "Aber wäre jemand in meiner Position ohne Vorwarnung auf einem solchen Fest aufgetaucht, wäre das „unangebracht“ gewesen. Besonders zu der Generation meiner Eltern, als die Yashiro-Verwaltung noch kein so enges Verhältnis zu den normalen Bürgern pflegte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070347
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070347,
					"content": "Selbst wenn es einfach so gegangen wäre, allein die Vorstellung, dass sich jemand von der Yashiro-Verwaltung einfach so unters Volk gemischt hätte ... Das hätte auf jeden Fall skeptische Blicke auf sich gezogen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070348
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070348,
					"content": "Mutter sagt, dass sie den Leuten nicht den Spaß verderben wollte ... Sie wollte sie nicht stören und hatte sowieso nicht viel Freizeit, also ging sie nie hin. Kein einziges Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070349
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070349,
					"content": "Oh ... Also war dieser Kimono-Entwurf sozusagen das, was sie auf dem Fest tragen wollte, wenn sie je hingegangen wäre, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070350
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070350,
					"content": "Genau. Und manchmal gibt es auf solchen Festen auch ausländisches Essen. Das hätte sie gerne probiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070351
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070351,
					"content": "Ich hoffe, das klingt jetzt nicht respektlos, aber ich wusste gar nicht, dass meine Mutter sich das innere Kind so bewahrt hat, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070352
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070352,
					"content": "Das klingt überhaupt nicht respektlos! Paimon findet, dass deine Mutter das Beste von beiden hatte: innerlich ein weiches Herz und nach außen hin ein unerschütterliches Verantwortungsbewusstsein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070353,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070354
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070354,
					"content": "Ohne es zu wissen, habe ich schon einige Wünsche meiner Mutter erfüllt. Aber auf ein Fest zu gehen, ist etwas, das ich nicht für sie tun kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070355
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070355,
					"content": "Vielleicht ist es das Einzige, was nie passieren wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070356,
						120070357
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070356,
					"content": "Du hast doch schon so viel erreicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070358
					]
				},
				{
					"id": 120070358,
					"content": "Ich weiß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070359
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070359,
					"content": "... Danke. Ich glaube, ich verstehe es jetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070360
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070360,
					"content": "Mutter und ich sind uns in vielem so ähnlich. Die Dinge, denen sie sich stellen musste, erwarten auch mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070361
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070361,
					"content": "Sie entschied, alle unerfüllten Wünsche auf die Identität der Tsubaki zu übertragen. Und ich ... ich habe mich schon entschieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070362
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070362,
					"content": "Oh! Du hast dir also auch eine andere Identität zugelegt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070363
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070363,
					"content": "Nein, ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070364
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070364,
					"content": "Nein und ich habe es auch nicht vor. Ich glaube, dass ich mir ein neues Ziel setzen möchte: Jeden Tag so zu leben, dass ich ihn nicht bereuen werde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070365
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070365,
					"content": "#Und, ähm ... {F#Reisende}{M#Reisender}, ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070366
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070366,
					"content": "Uff, tief einatmen, Ayaka, tief einatmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070367
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070367,
					"content": "Hättet ihr Lust, mich auf ein Fest in Inazuma zu begleiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070368
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070368,
					"content": "Paimon will schon auf eines, seit wir dieses Plakat gesehen haben! Soll das heißen, du willst hin, Ayaka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070369
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070369,
					"content": "Du warst also wirklich noch nie auf einem Fest?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070370
					]
				},
				{
					"id": 120070370,
					"content": "He, mach dich nicht über mich lustig! Ich hatte nun mal immer dieselben Bedenken wie meine Mutter ... Aber jetzt sehe ich das ein wenig anders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070371
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070371,
					"content": "Ich werde mir selber treu sein und mir den Wunsch erfüllen, den ich und meine Mutter beide hatten. Gerade ihr versteht, dass ich nun meinen eigenen Weg gehen möchte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070372
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070372,
					"content": "Also ... ja, gehen wir! Gehen wir zusammen auf ein Fest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070373
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070373,
					"content": "Ich komme liebend gerne mit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070374
					]
				},
				{
					"id": 120070374,
					"content": "Paimon kommt auf jeden Fall mit! Auf solchen Festen gibt es immer total leckere Sachen, nicht wahr? Oh, und lustige Spiele! Hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070375
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070375,
					"content": "Wie schön! Ich danke euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070376
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070376,
					"content": "Wenn wir sofort losgehen, könnten wir es noch schaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070377
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070377,
					"content": "Oh, stimmt, heute ist ja der letzte Tag des Festes. Also, worauf warten wir? Auf geht’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070357,
					"content": "Es ist nicht deine Schuld, dass die Dinge so sind, wie sie sind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070358
					]
				}
			]
		}
	]
}