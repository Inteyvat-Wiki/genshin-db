				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4810102,
					"content": "Eigentlich ganz gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810103,
					"content": "Ich lass mich leicht ablenken und fliege zu hoch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810101,
					"content": "#{NICKNAME}! Ich habe schon überall nach dir gesucht! Wie kommst du mit dem Windgleiter zurecht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810102,
						4810103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810104,
					"content": "Du scheinst das Fliegen ja richtig zu genießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810105,
					"content": "Du hast aber immer noch keinen Flugschein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810106,
					"content": "Flugschein? Was ist das denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810107,
					"content": "Der Name sagt doch schon alles. Um legal in und um Mondstadt fliegen zu dürfen, braucht man einen Flugschein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810108,
					"content": "#Aha ... {NICKNAME} ist jetzt schon so lange durch die Gegend geflogen und keiner hat etwas davon erwähnt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810109,
					"content": "Gerade weil ihr überall durch die Gegend fliegt, habt ihr jeden darauf aufmerksam gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810110,
					"content": "Aha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810111,
					"content": "Bist du extra hergekommen, um uns den Flugschein zu bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810112,
					"content": "Natürlich nicht! Die Ritter haben da strenge Regeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810113,
					"content": "Man muss erst die Prüfung bestehen. Dann wird der Flugschein von dem Ritterorden ausgestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810114,
					"content": "#Ich bin heute hier, damit du deine Prüfung ablegen kannst, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810115,
					"content": "Schließlich habe ich dir den Windgleiter gegeben. Deswegen sollte ich auch die Verantwortung dafür übernehmen. Zumindest würde das Jean auch so sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810117,
					"content": "Könnten wir in der Sache vielleicht ein Auge zudrücken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810118
					]
				},
				{
					"id": 4810119,
					"content": "Ich schaff das schon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810120
					]
				},
				{
					"id": 4810116,
					"content": "Eine Prüfung? Das klingt aber nach viel Stress. Aber wenigstens bist du die Prüferin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810117,
						4810119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810118,
					"content": "Sieh mich nicht so an! Das mach ich selbst für dich nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810120,
					"content": "#{NICKNAME} macht das sicher mit Links!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810121,
					"content": "Das ist nur ein kleiner Test deiner Flugkünste. Jeder hat gesehen, was du draufhast, als du gegen Sturmschrecken gekämpft hast. Das ist sicher kein Problem für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810122,
					"content": "Trotzdem musst du die Regeln und Standards beim Fliegen einhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810123,
					"content": "Hier hast du einen Ratgeber, den du dir ruhig mal ansehen solltest. Du musst ihn nicht auswendig lernen, aber solltest ihn gelesen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810124
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810124,
					"content": "Beispielsweise dürfen nicht zwei Leute zur selben Zeit einen Windgleiter benutzen. Man darf auch keine zu schweren Gegenstände mitnehmen oder sich mithilfe von Anemo-Schleimen in die Lüfte begeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810125
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810125,
					"content": "Sieh ihn dir einfach mal an. Lisa hat mich auch einen Haufen dicke Bücher lesen lassen, als sie mir Magie beibrachte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810126,
					"content": "Sieht ja wirklich dick aus. Aber was sollen wir machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810127,
					"content": "Gut, dann kommt zum Windstieg, wenn ihr fertig seid!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810401,
					"content": "Dieser Flugratgeber des Ordo Favonius sieht echt schwierig zu lesen aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810402,
					"content": "Dann sollte ich lieber mal anfangen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4810602,
					"content": "Das sieht eher wie eine Fabel aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810603,
					"content": "Die Leute in Mondstadt lernen das Fliegen wirklich auf romantische Art ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810601,
					"content": "Das ist eine tolle Geschichte ... Ist der Ratgeber des Ordo Favonius aber wirklich in diesem Stil geschrieben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810602,
						4810603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810604,
					"content": "Egal, gehen wir lieber schnell zu Amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}