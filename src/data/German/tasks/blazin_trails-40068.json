				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Kaedehara Kazuha",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400681001,
					"content": "Oh, wir sind raus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400681002,
					"content": "Es ist immer so schön und hell draußen. Aber ich hasse diese heiße Höhle auch nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681003
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400681003,
					"content": "Das „Eisgipfelquellwasser“ ist auf dem nahegelegenen Berg. Lasst uns gemeinsam danach suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681004
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681004,
					"content": "Warte, warum gibt es hier unter der Erde Licht? Ist das ... eine Wasserader?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681005
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400681005,
					"content": "Nach dem, was die Blume sagte, sind die Wasseradern mit den Pflanzen verbunden und die Pflanzen mit dem Quellwasser in den Bergen. Lasst uns den Wasseradern folgen. Dann wird es nicht schiefgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4006812,
			"completionStepIds": [
				4006812
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006812",
							"2"
						],
						"stepId": 4006812,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400681201,
					"content": "Leute, hier liegt ein Zettel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681202
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681202,
					"content": "Ach so. Diese Insel ist wirklich interessant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681203
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681203,
					"content": "Aus den Andeutungen und dieser Signatur erkennt Paimon ... Albedo! Unser Freund in Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400681204,
					"content": "Albedo ist ein großartiger Alchimist. Er war auch auf dieser Insel. Dieser Zettel ist eine Notiz, die er späteren Besuchern hinterließ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400681205,
					"content": "Oh? Er ist es also.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681206
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681206,
					"content": "Was meint er damit? Die ganze Insel wurde zu Musikinstrumenten gemacht? Ach, das ist großartig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681207
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400681207,
					"content": "Außerdem hängt es auch mit den unterirdischen Wasseradern zusammen. Hm, vielleicht müssen wir alle Wasseradern reinigen, damit diese Insel wieder Musik spielt ...",
					"roleType": "TALK_ROLE_NPC",
