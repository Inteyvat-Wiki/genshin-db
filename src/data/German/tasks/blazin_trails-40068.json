				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680401,
					"content": "*hust* Paimons Mund ist voller Staub ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680402,
					"content": "Alles in Ordnung, Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680403
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680403,
					"content": "Wir wurden tatsächlich in eine andere Welt verlegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680404
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680404,
					"content": "Warum fühlt sich dieser Ort trostlos an ... Xinyan, das ist eine Illusion, die mit dir zu tun hat, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680405
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680405,
					"content": "Ich denke ja. Aber ... warum ist es hier so trostlos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680406
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680406,
					"content": "Guckt mal da, da drüben ist es so hell. Es scheint uns dort zur Erkundung einzuladen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680407,
					"content": "Gut, dann schauen wir mal nach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680408
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680408,
					"content": "Halt! Nein, es muss eine Falle sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680409,
					"content": "Davon abgesehen haben wir keinen anderen Weg zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680410
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680410,
					"content": "Sehr wahr ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680411
					]
				},
				{
					"id": 400680411,
					"content": "Wenn das wirklich Xinyans Illusion ist, sollte es keine Fallen geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680412
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680412,
					"content": "Das klingt sehr gut! Mit diesen Worten lässt sich mein Charakter sofort anerkennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680413
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680413,
					"content": "Ergibt Sinn. Dann lass uns gehen und einen Blick darauf werfen. Aber wir sollen vorsichtig sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4006805,
			"completionStepIds": [
				4006805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
