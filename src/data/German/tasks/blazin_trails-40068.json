			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Entflammtes Herz",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680901,
					"content": "Oh! Eine große Blume!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680902,
					"content": "Es ist so heiß hier ... Hat das etwas mit dieser Blume zu tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680903
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680903,
					"content": "Unerwartet haben wir heute Gäste hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680904
					],
					"speakerTitle": "Entflammtes Herz"
				},
				{
					"id": 400680904,
					"content": "Oh neeeein! Sie kann sprechen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680905,
						400680906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680905,
					"content": "Gestern konnte das Eichhörnchen auch sprechen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680907
					]
				},
				{
					"id": 400680907,
					"content": "Paimon weiß es! Aber ... Aber dieses Ding ist anders ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680908,
					"content": "Hallo, wir wurden hierher gebracht, nachdem wir diese trommelartigen Pflanzen am Strand berührt hatten. Bist du der Besitzer hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680909
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680909,
					"content": "Das ist der Tempel der Musik. Ich bin nur ein Torwächter. Freunde, seid ihr auch hier, um der ultimativen Musik nachzugehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680910
					],
					"speakerTitle": "Entflammtes Herz"
				},
				{
					"id": 400680910,
					"content": "Richtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680911
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680911,
					"content": "Was ist deine Interpretation von Musik ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680912
					],
					"speakerTitle": "Entflammtes Herz"
				},
				{
					"id": 400680912,
					"content": "Singen für den Widerstand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680913
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680913,
					"content": "Du bist ein richtiger Könner! Großartig! Ich habe wirklich Glück, einen intimen Freund kennenzulernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680914
					],
					"speakerTitle": "Entflammtes Herz"
				},
				{
					"id": 400680914,
					"content": "Sie kann sich sogar mit einer seltsamen Blume anfreunden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680915,
					"content": "Menschen, mit denen man gut auskommt, haben überall viele Freunde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680916
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680916,
					"content": "Ihr habt es geschafft, hierherzukommen, weil ihr ein höheres Niveau von Musik erreichen wollt. Ihr braucht meinen Gesang, um diesen Tempel zu betreten. Aber es tut mir leid, dass ich gerade etwas heiser bin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680917
					],
					"speakerTitle": "Entflammtes Herz"
				},
				{
					"id": 400680917,
					"content": "Geht’s dir noch gut? Möchtest du etwas Erkältungsmedizin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680918
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680918,
					"content": "Nein, ich habe das „Eisgipfelquellwasser“ einfach zu lange nicht mehr getrunken. Ich kann meine Stimme wiederbeleben und euch den Weg öffnen, sobald ich dieses Quellwasser wieder trinke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680919
					],
					"speakerTitle": "Entflammtes Herz"
				},
				{
					"id": 400680919,
					"content": "„Eisgipfelquellwasser“? Ist das der Name eines Quellwassers?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680920
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680920,
					"content": "Genau. Müde Erwachsene, schläfrige Vögel, unwissende Kinder ... alle können die schönsten Singstimmen bekommen, solange sie dieses Wasser trinken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680921
					],
					"speakerTitle": "Entflammtes Herz"
				},
				{
					"id": 400680921,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680922
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680922,
					"content": "Gut, ich helfe dir, es zu finden. Sag mir, wo die Quelle ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680923
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680923,
					"content": "Danke! Das klare Wasser ermöglicht es den Pflanzen zu wachsen. Sie wachsen stark und überwinden Schwierigkeiten, um die Berge zu besteigen ... Das Quellwasser befindet sich genau auf dem Berg, der von der Vegetation geschützt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680924
					],
					"speakerTitle": "Entflammtes Herz"
				},
				{
					"id": 400680924,
					"content": "Auf dem Berg? Paimon dachte, dass ein bisschen Meerwasser ausreichen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680925,
					"content": "Bergquellen und Meerwasser sind zwei völlig verschiedene Dinge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680926
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680926,
					"content": "Aber wenn man so eine Bergquelle sehen will, muss er sich vielleicht auf meine Kraft verlassen. Freund, gib mir deine Hand, damit du sehen kannst, was ich sehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680927
					],
					"speakerTitle": "Entflammtes Herz"
				},
				{
					"id": 400680927,
					"content": "Wenn du meine Hand hältst, machst du mir einen Freund.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680906,
					"content": "Das Boot auch ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680907
					]
				}
			]
		},
		{
			"id": 4006810,
