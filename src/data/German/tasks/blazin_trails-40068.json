			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Xinyan",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680201,
					"content": "Steh auf! Der Sonnenschein strahlt dir schon auf den Hintern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680202,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680203
					]
				},
				{
					"id": 400680203,
					"content": "Paimon, ich schlafe doch auf dem Rücken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680204
					]
				},
				{
					"id": 400680204,
					"content": "Na gut. Der Sonnenschein strahlt dir schon auf den Bauch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680205,
					"content": "#{NICKNAME}, hast du letzte Nacht gut geschlafen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680206,
						400680207
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680206,
					"content": "Na ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680208
					]
				},
				{
					"id": 400680208,
					"content": "Die anderen scheinen dir ähnlich zu sein. Heute bin ich früh aufgewacht, herumgelaufen und habe Obst für das Frühstück gepflückt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680209,
					"content": "Paimon hat nicht zuerst gegessen, nur um darauf zu warten, dass du aufstehst, damit wir zusammen essen können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680210,
					"content": "Alle genossen das Obstfrühstück zusammen, wobei sich alle unterhielten ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400680211
					]
				},
				{
					"id": 400680211,
					"content": "Hä? Fischl ist am Morgen allein gegangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680212,
					"content": "Ja, sie scheint nicht bereit zu sein, mit uns gemeinsam zu handeln. Sie hat gesagt, dass sie eine andere Abenteueraufgabe zu tun hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680213
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680213,
					"content": "Was soll das heißen?! Sie sagte eindeutig, sie sei hier, um das Immernachtreich wiederherzustellen. Warum arbeitet sie jetzt für die Abenteurergilde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680214,
					"content": "Schon gut ... Paimon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680215
					]
				},
				{
					"id": 400680215,
					"content": "Ihrem Gesichtsausdruck nach zu urteilen, muss sie etwas im Kopf haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680216
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680216,
					"content": "Wie ursprünglich geplant, schickten wir Mona zu ihr, um sie zu trösten. Aber unerwartet sagte sie, dass Mona die Arbeit einer Abenteurerin nicht verstehe und ihr deswegen nicht auf Abenteuer folgen könne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680217
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680217,
					"content": "Um allein zu sein, braucht Fischl nicht einmal die Ausrede des Immernachtreiches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680218,
					"content": "Sie müsste auf ein großes Problem gestoßen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680219
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680219,
					"content": "Als Freund würde ich ihr gern helfen. Aber eines hat sie richtig gesagt, heute werden wir zu anderen Inseln gehen, um sie zu erkunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680220,
					"content": "Oh, wirklich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680221
					]
				},
				{
					"id": 400680221,
					"content": "Es wurde von allen einstimmig beschlossen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680222,
					"content": "Was heißt „einstimmig“? Ich war nicht dabei!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680223
					]
				},
				{
					"id": 400680223,
					"content": "Paimon hat gerade für dich gestimmt. Sie sagte, du und sie gehören einer Gemeinschaft an. Sie ist dort, wo du bist, und so auch umgekehrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680224
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680224,
					"content": "#Hehe, du bist {M#ein Abenteurer}{F#eine Abenteurerin}. Daher wirst du auf jeden Fall mitkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680225,
					"content": "(Ach, Paimon. Na gut ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680226
					]
				},
				{
					"id": 400680226,
					"content": "Fischl hat gesagt, sie kommt nicht mit. Sie hat noch andere Dinge, die sie untersuchen möchte. Aber wir sollten uns keine Sorgen machen. Sie wird sich uns anschließen, wenn sie fertig ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680227
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680227,
					"content": "Schau nicht auf ihre übliche Art. Sie ist immerhin eine erfahrene Abenteurerin. Ich denke, wir sollten ihr vertrauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680228
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680228,
					"content": "Da ich Fischl erst seit kurzer Zeit kenne, ist meine Meinung nur eine wilde Vermutung. Aber ich denke ... ihr Widerspruch liegt in ihr selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680229
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680229,
					"content": "Das ergibt Sinn ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680230,
					"content": "Konflikte mit anderen werden entweder gelöst oder abgetan. Die mit sich selbst kann man jedoch nie so einfach ignorieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680231
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680231,
					"content": "... Ich hatte diese Periode auch und ich kann sie daher sehr gut verstehen. Ich weiß zwar nicht, worüber sie sich Sorgen macht, aber jetzt soll man sie allein lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680232
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680232,
					"content": "Ich stimme auch zu. Es ist nur schade für das heutige Abenteuer ... Es wird nur Spaß machen, wenn wir das zusammen machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680233
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680233,
					"content": "Xinyan ist so unternehmungslustig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680234,
					"content": "#Ach ja, ich habe es euch noch nicht gesagt. Heute Morgen gab es eine Illusion auf der Insel im Norden. Lasst uns der Sache nachgehen, wenn {NICKNAME} mit dem Frühstück fertig ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680207,
					"content": "Doch gut!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680208
					]
				}
			]
		},
		{
			"id": 4006803,
			"completionStepIds": [
				4006803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006803",
							"2"
						],
						"stepId": 4006803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Mona",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680301,
					"content": "Es sieht aus wie eine normale Insel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680302,
					"content": "... Es scheint einen brennenden Geruch im Wind zu geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680303
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680303,
					"content": "Mein Wasserspiegel ist etwas heller geworden. Aber ich kann immer noch nichts sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680304,
					"content": "He! Schaut mal hier, was ich gefunden habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680305
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680305,
					"content": "Dieses Ding ... ist eine Trommel oder eine Pflanze?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680306
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680306,
					"content": "Ist es ein Musikinstrument aus Pflanzen? Es scheint ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680307
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680307,
					"content": "Xinyan, sollte das nicht eine Insel sein, die mit dir verwandt ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680308,
					"content": "Ist das ein Instrument für mich? Dann klopfe ich es zuerst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680309
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680309,
					"content": "Warte mal. Gestern habe ich den Steingarten in der Miniaturlandschaft berührt und wir wurden in eine besondere Welt versetzt. Xinyan, willst du dich zuerst vorbereiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680310
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680310,
					"content": "Du hast recht. Aber ich habe keine Angst davor. Ich bin auf Musik jederzeit gut vorbereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
