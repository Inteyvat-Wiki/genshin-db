			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Kaedehara Kazuha",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680501,
					"content": "Die Tür ist verschlossen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680502,
						400680504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680502,
					"content": "Mona, verwandle dich ins Wasser und geh hinein!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680503
					]
				},
				{
					"id": 400680503,
					"content": "Was für einen Unsinn erzählst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680506,
					"content": "Xinyan, warum hast du die Tür verschlossen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680507,
					"content": "Ahaha, du fragst mich danach. Aber ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680508
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680508,
					"content": "Aber ich bin die Art von Person, die Schlüssel unter einem Blumentopf an der Tür aufbewahrt, also ... Der Schlüssel müsste in der Nähe sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680509
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680509,
					"content": "Oh! Gibt es hier in der Nähe Blumentöpfe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680510,
					"content": "Nein, aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680511
					]
				},
				{
					"id": 400680511,
					"content": "Das ist sicherlich eine Möglichkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680504,
					"content": "Wenn Kazuha hochspringt, wird alles gelöst sein!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680505
					]
				},
				{
					"id": 400680505,
					"content": "... Denken wir nochmal darüber nach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680506
					],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006809,
			"completionStepIds": [
				4006809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
