						],
						"pointId": 11221
					}
				]
			},
			"dialogs": [
				{
					"id": 751650901,
					"content": "Illimani, du hast wohl schon wieder zugenommen, herzlichen Glückwunsch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650902
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650902,
					"content": "Haha, danke, Suriqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650903
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650903,
					"content": "Gute Nachricht, ich habe einen weiteren Lauch überzeugt, der abnehmen wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650904
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650904,
					"content": "Oh, sehr beeindruckend, du hast ihm einen großen Gefallen getan!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650905
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650905,
					"content": "Oh, du bist es. Wie geht’s? Hast du in den letzten Tagen gut gegessen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650906,
						751650908
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650906,
					"content": "Ja, ich habe ordentlich gegessen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650907
					]
				},
				{
					"id": 751650907,
					"content": "Sehr gut, man sollte viel essen, nur so kann man gut zunehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650910
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650910,
					"content": "#Illimani, ich sage dir, {M#er}{F#sie} ist echt gut bei Krugkeile. {M#Er}{F#Sie} hat beinahe meinen besten Rekord erreicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650911
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650911,
					"content": "#{M#Er}{F#Sie} hat auch meine Herausforderung angenommen und war echt nicht schlecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650912
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650912,
					"content": "Ooh, ich bin beeindruckt! Wer hätte gedacht, dass du so gut bist, dass du uns beide fast geschlagen hättest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650913
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650913,
					"content": "#Ich denke, wenn {M#er}{F#sie} noch ein bisschen zunimmt, könnte {M#er}{F#sie} uns vielleicht wirklich schlagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650914
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650914,
					"content": "Hm, vielleicht. Du bist zwar meiner Meinung nach echt dürr, aber du bist noch jung, hast also noch ordentlich Zeit, zuzulegen. Trotzdem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650915
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650915,
					"content": "Meinen Respekt hast du!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650916
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650916,
					"content": "Genauso wie meinen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650917
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650917,
					"content": "Trotzdem würde ich vorschlagen, dass du bei jeder Mahlzeit richtig reinhauen solltest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650918
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650918,
					"content": "Bloß nicht zu wenig essen und ja keine Diät. Wir wären echt enttäuscht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650908,
					"content": "In letzter Zeit hatte ich nichts Gutes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650909
					]
				},
				{
					"id": 751650909,
					"content": "Das ist nicht gut. Es gibt nichts Wichtigeres, als gut zu essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650910
					],
					"speakerTitle": "Suriqui"
				}
			]
		},
