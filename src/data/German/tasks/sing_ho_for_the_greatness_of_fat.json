					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751651002
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751651002,
					"content": "Na komm schon, du wirst schon sehen, was ein großer Körperbau in der Praxis so an Kraft aufbringen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
