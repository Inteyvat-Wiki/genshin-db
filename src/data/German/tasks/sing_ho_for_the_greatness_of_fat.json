				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Suriqui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650201,
					"content": "Durchreisender Recke, da du nach Teteocan kommst, bist du doch auch auf der Suche nach Stärke, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650202
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650202,
					"content": "Wahrscheinlich hast du schon die ganzen Kraftprotze vom „Kollektiv der Fülle“ gesehen, hm? Die meisten von ihnen sind ja ganz schön aufgepumpt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650203
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650203,
					"content": "#Du hingegen hast ja nicht gerade viel auf den Rippen. Hast wohl nicht jeden Tag wie ein{F#e} Bekloppte{M#r} das Eisen gestemmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650204
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650204,
					"content": "Ich sag’ dir, das ist alles ein Riesenbetrug, fall da bloß nicht drauf rein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650205,
						751650206
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650205,
					"content": "Stehst du nicht so auf Training?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				},
				{
					"id": 751650207,
					"content": "So kann man das jetzt auch nicht sagen, aber dicke Arme machen dich noch lange nicht zum Krieger und viele Muskeln heißt nicht selbstverständlich viel Kraft. Wer das Gegenteil behauptet, redet Unsinn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650208
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650208,
					"content": "Ich sag’ dir, die Krieger von damals bestanden sicher nicht nur aus Muckis und Knochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650209
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650209,
					"content": "Das Leben damals war viel härter als heute. Im Kampf ging es darum, sich zu verteidigen, ums nackte Überleben. Dafür ist auf jeden Fall ’ne ordentliche Fettschicht vonnöten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650210
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650210,
					"content": "Die hatten eher eine Statur wie ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650211
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650211,
					"content": "Ein bisschen füllig halt, wie bei mir, so sahen die aus. Ein Körperbau, der Kraft und Beweglichkeit vereint.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650212
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650212,
					"content": "Aber keiner aus meinem Stamm will das erkennen, was für Hohlköpfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650213
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650213,
					"content": "Deinem Gesicht nach zu urteilen, scheinst du mir nicht ganz zu glauben ... Hm, ich habe da eine Idee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650214
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650214,
					"content": "Komm und probier mal meine Krugkeile-Herausforderung aus! Ich habe dieses Feld extra für mein eigenes Training vorbereitet, du kannst dich also gern austoben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650215
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650215,
					"content": "Na komm schon, du wirst schon sehen, was ein großer Körperbau in der Praxis so an Kraft aufbringen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650206,
					"content": "Gefallen dir keine Muckis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				}
			]
		},
		{
			"id": 7516503,
