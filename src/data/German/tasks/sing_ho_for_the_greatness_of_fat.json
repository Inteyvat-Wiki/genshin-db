			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Illimani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650401,
					"content": "Reisender Recke, ja, stimmt, genau du.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650402
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650402,
					"content": "*seufz* So abgemagert ... Hattest du nie eine richtige Mahlzeit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650406,
						751650404
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650406,
					"content": "Mein Essen wurde von Reiseführerin Paimon weggeputzt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650403
					]
				},
				{
					"id": 751650403,
					"content": "Wo auch immer der Schuh drückt oder in welchen Schwierigkeiten du steckst, was Anständiges zu essen muss immer an erster Stelle stehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650408,
					"content": "Da du ja bereits Teteocan betreten hast, bist du wahrscheinlich schon den Muskelprotzen vom „Kollektiv der Fülle“ begegnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650409
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650409,
					"content": "Lass mich dir einen guten Rat geben: Vertraue bloß niemals diesen Typen, die nur auf Muskeln stehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650410
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650410,
					"content": "Die Götter haben uns unser Fett als kostbares Geschenk gemacht. Einfach so auf gutes Essen zu verzichten, um hübsche Muskeln zu bekommen und sich dabei vom Fett zu verabschieden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650411
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650411,
					"content": "Das ist so dumm, da hätte selbst ein Waldschwein Mitleid mit dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650412
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650412,
					"content": "Und was das gute Aussehen angeht ... Nun, muskulöse Körper scheinen da auch erst seit ein paar Jahrzehnten angesagt zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650413
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650413,
					"content": "Mein Opa meinte mal, dass in seiner Jugend die Leute eher auf eine leicht füllige Statur standen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650414
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650414,
					"content": "Lass dich also bloß nicht in die Irre führen und schlag den Irrweg des Abnehmens ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650415
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650415,
					"content": "Aber wenn du eines Tages, wie meine Verwandten vom „Kollektiv der Fülle“, beschließt, abzunehmen, nur um stärker zu werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650416
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650416,
					"content": "Lass mich dir da eine Sache sagen: Was die Agilität betrifft, so kann auch ein dickerer Krieger so flink sein wie ein Fisch im Wasser, und wenn es um die Stärke geht, würden uns diese mageren Krieger niemals das Wasser reichen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650417
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650417,
					"content": "Du willst Beweise? Die Krüge hier auf diesem Trainingsplatz dürften wohl als Beweis genügen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650418
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650418,
					"content": "Mit meiner Statur ist es für mich ein Kinderspiel, dort <color=#00E1FFFF>durchzusprinten, ohne auch nur einen Krug zu zerbrechen</color>. Das kriegt kein noch so dünner Hänfling hin, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650419
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650419,
					"content": "Schau sich nur einer deinen Gesichtsausdruck an. Dir ist es wohl peinlich, zu lachen ... Schon gut, ich wusste, dass du mir nicht glauben würdest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650420
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650420,
					"content": "Versuch mal, so schnell wie möglich über den Trainingsplatz zu kommen, pass aber auf, <color=#00E1FFFF>keine Krüge kaputtzumachen</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650421
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650421,
					"content": "Mal sehen, was du draufhast und ob du mich übertreffen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650404,
					"content": "Wah, will mich da etwa jemand zum Essen einladen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650407
					]
				},
				{
					"id": 751650407,
					"content": "Das ist es nicht ... aber wenn du wirklich hungrig bist, habe ich ein wenig Grillfleisch in meiner Reisetasche. Aber lassen wir das erstmal beiseite ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Illimani"
				}
			]
		},
