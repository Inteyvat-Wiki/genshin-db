				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Suriqui",
					"Illimani"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-3157.844,
							310.426,
							10135.9
						],
						"pointId": 11041
					},
					{
						"sceneId": 3,
						"position": [
							-3157.031,
