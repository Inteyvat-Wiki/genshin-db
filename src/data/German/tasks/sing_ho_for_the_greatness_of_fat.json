			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Suriqui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650701,
					"content": "Hmm, gar nicht mal schlecht. Aber um es mit mir aufzunehmen, reicht es noch nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650702
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650702,
					"content": "Ich habe jahrelang meinen kräftigen Körperbau gehalten und dabei nie mein Training außer Acht gelassen. Was meine Agilität und Durchschlagskraft angeht, kann man mich wohl kaum mit diesen Hohlköpfen von Fitnessfanatikern vergleichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650703
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650703,
					"content": "Vergessen wir doch das Streben nach Muckis, komm schon, lang lebe das Fettsein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				}
			]
		},
		{
			"id": 7516508,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516505",
							"3"
						],
						"stepId": 7516505,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516506"
						],
						"stepId": 7516506
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Illimani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650801,
					"content": "Deine Leistung ist nicht schlecht, aber um ehrlich zu sein ... Ich will ja nicht angeben, aber ich bin definitiv besser als du.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650802
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650802,
					"content": "Menschen haben immer ein oder zwei Dinge, die sie richtig gut können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650803
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650803,
					"content": "Jetzt glaubst du mir doch, oder? Ein Krieger von meiner Größe ist nicht unbedingt unbeweglich und langsam. Denk also daran, gut zu essen und niemals zwanghaft abzunehmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illimani"
				}
			]
		},
		{
			"id": 7516509,
			"completionStepIds": [
				7516506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
