					"content": "Ich muss mich noch kurz fertig machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650302
					]
				},
				{
					"id": 751650302,
					"content": "Gut, komm jederzeit wieder vorbei, wenn du bereit bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				}
			]
		},
		{
			"id": 7516504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
