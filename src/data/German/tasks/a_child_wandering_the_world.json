			"dialogs": [
				{
					"id": 100060701,
					"content": "Ähem ... Und das ist alles, was Meisterin Rheindottir zu sagen hat. *hust* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060702
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060702,
					"content": "Gut gemacht, Sebas. Es ist bestimmt nicht leicht, du selbst zu sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060703
					]
				},
				{
					"id": 100060703,
					"content": "He. Eine Katze, die die Stimme von jemand anderem nachahmen kann, ist immer noch genauso seltsam anzusehen, wie beim ersten Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060704,
					"content": "Ach, sei nicht so schockiert. Ich bin eben keine gewöhnliche Katze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sebas"
				}
			]
		},
