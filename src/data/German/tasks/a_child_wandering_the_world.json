							-35.013
						],
						"pointId": 4
					}
				]
			},
			"dialogs": [
				{
					"id": 100060901,
					"content": "Biologisch gesehen bin ich eigentlich gar keine Katze, sondern ein alchemistisches Wesen. Du würdest dich ja auch nicht als Gespenst bezeichnen, nur weil du wie eins in der Luft schwebst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060902
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060902,
					"content": "Ein Gespenst? Was willst du damit sagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060903,
					"content": "Oh, ich weiß es! Sebas meint damit, dass du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060904
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060904,
					"content": "Sprich diesen Gedanken lieber nicht aus, Durin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060905
					]
				},
				{
					"id": 100060905,
					"content": "Was für einen Gedanken? He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060906,
					"content": "Oh, und wenn ich mir ansehe, wie Meisterin Rheindottirs Nachricht endete, ist diese Technik jetzt wohl nutzlos. Ich werde sie einfach zerstören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060907
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060907,
					"content": "Es gibt nur wenige Menschen, die sie zum Umdenken bewegen können. Das ist wirklich eine beeindruckende Leistung, junger Mann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060908
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060908,
					"content": "So, das wäre erledigt. Ich muss dann los. Ich habe noch eine weitere Nachricht zu überbringen. Vielleicht sehen wir uns ja irgendwann wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sebas"
				}
			]
		}
	]
