			"dialogs": [
				{
					"id": 100060101,
					"content": "Hey, Durin! Hier hast du also die ganze Zeit gesteckt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060102,
					"content": "#Oh, {NICKNAME}, Paimon. Was führt euch hierher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060103
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060103,
					"content": "Hehe, die eigentliche Frage ist doch, warum du hier drinnen hockst und ein Buch liest? Das Wetter draußen ist doch super.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060104,
					"content": "Oh. Tja, seitdem ich mehr Gelegenheiten habe, mit den Leuten in Mondstadt zu interagieren, fällt es mir schwer zu erkennen, wann jemand einen Scherz macht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060105
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060105,
					"content": "Zum Beispiel habe ich beim letzten Mal beim Blumenhändler eine wunderschöne Blume gesehen. Als ich das der Verkäuferin erzählte, sagte sie:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060106
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060106,
					"content": "„Hehe, wenn du diese Wildkräuter so magst, solltest du etwas Minze und Zuckerblume hinzufügen und daraus einen Strauß machen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060107
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060107,
					"content": "Also habe ich getan, was sie sagte. Aber als ich ihr den fertigen Blumenstrauß zeigte, warf sie mir einen richtig beängstigenden Blick zu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060108,
						100060109
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060108,
					"content": "Du hast eine einzigartige Sichtweise, Durin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				},
				{
					"id": 100060110,
					"content": "Später meinte Albedo, dass das passiert sei, weil ich Schwierigkeiten habe, die „Bedeutung hinter den Worten“ zu verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060111
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060111,
					"content": "Also, nachdem ich die Schrift von Mondstadt gelernt hatte, sagte er mir, dass ich hierherkommen und lesen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060112
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060112,
					"content": "Da ich aus einem Geschichtenbuch geboren wurde, dachte ich, dass diese Bücher mir vielleicht mehr über die „Regeln“ dieser Welt beibringen könnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060113
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060113,
					"content": "Und tja, ich schätze, ich habe die Zeit vergessen ... Also, ähm, braucht ihr etwas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060114,
						100060117
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060114,
					"content": "Freunde schauen oft einfach mal vorbei, um Hallo zu sagen, Durin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060115
					]
				},
				{
					"id": 100060115,
					"content": "Ach so, verstehe. Das ist dann eine weitere Regel, die ich gelernt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060116
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060116,
					"content": "Genau! Aber wir hatten doch noch etwas zu besprechen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060118,
					"content": "Ja, wir haben eine Nachricht von Rheindottir zu überbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060119,
					"content": "Oh ... Sie ... ist von Rheindottir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060120,
						100060121
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060120,
					"content": "Was gibt’s?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060122,
					"content": "Nein, ich ... ich bin nur überrascht. Rheindottir ist eine Freundin meiner Mutter ... Und die Mutter des Drachen, der einst an meiner Stelle existierte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060123
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060123,
					"content": "Ich habe ihn verdrängt – habe das Schicksal übernommen, das eigentlich seins hätte sein sollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060124
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060124,
					"content": "Also, wenn sie mich nicht mag ... Na ja, ich weiß nicht, was ich dann tun würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060125,
						100060126
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060125,
					"content": "Ich glaube nicht, dass sie dir das übel nimmt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060127,
					"content": "Ja! Wir sind für dich da! Aber ehrlich gesagt, Paimon glaubt nicht, dass es etwas Schlimmes ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060128,
					"content": "Das beruhigt mich wirklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060129
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060129,
					"content": "Tja, dann sollte ich es wohl öffnen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060126,
					"content": "Auf jeden Fall hast du uns.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060121,
					"content": "Kein Grund, nervös zu sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060117,
					"content": "Also sind wir hier im Auftrag des Hexenzirkels ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060118
					]
				},
				{
					"id": 100060109,
					"content": "Sieht so aus, als wäre sie diejenige, die Probleme hat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				}
			]
		},
