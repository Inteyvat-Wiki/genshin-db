			"dialogs": [
				{
					"id": 100060801,
					"content": "Ähem ... Und das ist alles, was Meisterin Rheindottir zu sagen hat. *hust* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060802
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060802,
					"content": "Äh, könntest du dich wenigstens vorstellen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060803
					]
				},
				{
					"id": 100060803,
					"content": "Ja! Sprechende Katzen sind für uns inzwischen normal, aber eine, die die Stimme von jemand anderem nachahmen kann ... Das ist wirklich was Neues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060804,
					"content": "Ich verstehe nicht, warum das wichtig sein soll, aber wenn ihr es unbedingt wissen müsst ... Ich bin Sebas, ein einfacher Butler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060805
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060805,
					"content": "Ihr seid Freunde von Albedo, nicht wahr? Genau genommen bin ich sein „Senior“. Also täuscht euch nicht – ich bin keine gewöhnliche Katze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sebas"
				}
			]
		},
		{
			"id": 1000609,
			"completionStepIds": [
				1000606
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
