				]
			},
			"dialogs": [
				{
					"id": 100060501,
					"content": "Wir treffen uns zum ersten Mal, also weiß ich nicht, wie ich dich ansprechen soll. Aber da du M’s Kind bist, bleibe ich wohl bei „Mini-Durin“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060502
					],
					"speakerTitle": "„Rheindottir“"
				},
				{
					"id": 100060502,
					"content": "„Auch wenn du kleiner bist als der Durin vor dir, fließt dieselbe Kraft durch deine Adern – nicht einen Tropfen weniger.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060503
					],
					"speakerTitle": "„Rheindottir“"
				},
				{
					"id": 100060503,
					"content": "„Er war ein Kind des ‚Humus‘, eine unvollständige Schöpfung. Deshalb fehlte ihm der ‚Wille‘, seine eigene Kraft zu kontrollieren.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060504
					],
					"speakerTitle": "„Rheindottir“"
				},
				{
					"id": 100060504,
					"content": "„Doch diese Macht überstieg seine Kräfte, und so verdrehte sie ihn, verschlang ihn und besiegelte damit sein endgültiges Schicksal.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060505
					],
					"speakerTitle": "„Rheindottir“"
				},
				{
					"id": 100060505,
					"content": "„Albedo behauptet, dass du dieses verdorbene Blut überwunden hast und zu einem Wesen wie er selbst geworden bist. Das ist seine Meinung, aber ich bin nicht überzeugt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060506
					],
					"speakerTitle": "„Rheindottir“"
				},
				{
					"id": 100060506,
					"content": "Ich vertraue nur den Fakten, nur dem, was ich selbst „sehe“. Also ergreife diese Chance, Ms Kind. Beweise dich mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Rheindottir“"
				}
			]
		},
		{
			"id": 1000606,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
