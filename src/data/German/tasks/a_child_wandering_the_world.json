					}
				]
			},
			"dialogs": [
				{
					"id": 100060601,
					"content": "Hmm. Sieht so aus, als hätte sich Albedo doch nicht geirrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060602
					],
					"speakerTitle": "„Rheindottir“"
				},
				{
					"id": 100060602,
					"content": "Nächstes Mal lass uns bitte nicht von einem Haufen Monster überfallen, nur um uns etwas zu beweisen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060603,
					"content": "Trotzdem fühle ich, dass ich meine Kräfte viel besser kontrollieren kann, seitdem wir sie besiegt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060604
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060604,
					"content": "„Nachdem ich von dir gehört habe, habe ich eine Technik vorbereitet, die die dunkle Macht in deinem Blut versiegeln wird. Ich hatte geplant, sie dir bei dieser Gelegenheit beizubringen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060605
					],
					"speakerTitle": "„Rheindottir“"
				},
				{
					"id": 100060605,
					"content": "„Natürlich hat die Anwendung ihren Preis. Sie würde zwar deine Existenz in Teyvat aufrechterhalten, aber gleichzeitig deine Verbindung zu dieser Welt schwächen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060606
					],
					"speakerTitle": "„Rheindottir“"
				},
				{
					"id": 100060606,
					"content": "„Und du bist nun mal Ms Kind. Wie könnte ich ihr mit gutem Gewissen gegenübertreten, wenn diese unkontrollierte Kraft dich auf denselben Weg führen würde wie das Kind vor dir?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060607
					],
					"speakerTitle": "„Rheindottir“"
				},
				{
					"id": 100060607,
					"content": "„Aber wenn ich dich jetzt so sehe, waren meine Sorgen wohl unbegründet. M ist eine wunderbare Mutter und viel fähiger als ich.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060608
					],
					"speakerTitle": "„Rheindottir“"
				},
				{
					"id": 100060608,
					"content": "„Und ich muss zugeben, ich bin ziemlich neugierig darauf zu sehen, wie weit du kommst – wie wirst du, ein alchemistisches Wesen, das wirklich in diese Welt integriert ist, deinen Platz in der menschlichen Gesellschaft finden?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060609
					],
					"speakerTitle": "„Rheindottir“"
				},
				{
					"id": 100060609,
					"content": "„So ein Experiment habe ich noch nie durchgeführt. Deswegen könntest du der Schlüssel zu einigen unerwarteten Antworten sein.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060610
					],
					"speakerTitle": "„Rheindottir“"
				},
				{
					"id": 100060610,
					"content": "He! Da hast du etwas falsch verstanden. Durin ist kein Experiment! Er ist unser Freund!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060611,
					"content": "Ich bin mir nicht sicher, ob ich es verstehe, aber ... ich schätze deine Freundlichkeit, Rheindottir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Durin"
				}
			]
		},
		{
