	"talks": [
		{
			"id": 7332701,
			"completionStepIds": [
				7332701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7332701",
							"2"
						],
						"stepId": 7332701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jeht"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733270101,
					"content": "#{NICKNAME}?! Bist du das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270102
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270102,
					"content": "Und Paimon! Ich hatte nicht erwartet, euch beiden hier zu begegnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270103
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270103,
					"content": "Jeht!! Du bist es wirklich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270104,
					"content": "Haha, nicht so laut! Sonst verscheuchst du meine Fische!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270105
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270105,
					"content": "Biepbiep!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270106
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270106,
					"content": "Ah ... Ihr angelt, ja? Aber warum sieht Paimon keine Angelrute?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270107,
					"content": "Biep ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270108
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270108,
					"content": "#Benben, redest du keinen Unsinn! Nun ... {NICKNAME}, lass uns über etwas anderes reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270109,
						733270121
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270109,
					"content": "Wo ist deine Angelrute?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270110
					]
				},
				{
					"id": 733270110,
					"content": "Auch du!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270111
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270111,
					"content": "Hehe ... Sie ... ist kaputt. Aber das ist ihre eigene Schuld!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270112
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270112,
					"content": "*seufz* ... Ich hätte nie gedacht, dass sich Angeln so sehr vom Jagen unterscheidet. Warum ist das so schwierig! Ich habe keine Geduld, stundenlang hier zu sitzen und auf einen Fisch zu warten ... Warum springe ich nicht einfach in den Fluss und fange sie selbst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270113
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270113,
					"content": "Aber am Ende hast du nichts gefangen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270114,
					"content": "Hmph, natürlich habe ich! Ich habe einen richtig großen und der ist länger als du ... Ja, eine Hälfte von Benben länger als du!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270115
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270115,
					"content": "Biepbiep! Biepbiep!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270116
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270116,
					"content": "Ich habe alles gegrillt und gegessen, also ist nichts für dich übrig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270117
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270117,
					"content": "... Biepbiep?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270118
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270118,
					"content": "Ja, auch Benben hat ein bisschen gegessen. Du bist die Einzige, die nichts bekommen hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270119
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270119,
					"content": "Als ob Paimon das glauben würde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270120,
					"content": "Hahahaha! Wenn du mir nicht glaubst, ist das dein Problem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270125,
					"content": "Wie geht es dir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270126
					]
				},
				{
					"id": 733270126,
					"content": "Hm? Gut, mach dir keine Sorgen um mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270127
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270127,
					"content": "Es ist sowieso nicht das erste Mal, dass ich allein reise ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270128
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270128,
					"content": "Biepbiep! Biepbiep!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270129
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270129,
					"content": "Hahaha, da weiß ich, dass ich dich habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270130
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270130,
					"content": "Seit dem Fall in Tanit versorgten mich die Wüstenbewohner nicht mehr mit Zelten und Nahrung ... Ich stehe nicht mehr unter dem Schutz des Stammes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270131
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270131,
					"content": "Und dann ... bot mir Rukh Shah von „Regiment der Dreißig“ eine Wohnung in der Stadt an, aber ... ich habe mich dort nicht wohlgefühlt. Es erinnerte mich an meine Mutter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270132
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270132,
					"content": "So verließ ich Sumeru und dachte, dass ich besser in ein anderes Land gehen sollte, um mir einige schöne Orte anzusehen, die ich noch nie gesehen hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270133
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270133,
					"content": "Also bin ich an Bord eines Handelsschiffes gegangen und irgendwie hier gelandet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270134
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270134,
					"content": "Dann ... Haha, dann gibt es nichts Neues zu berichten! Weißt du, Leibwächter werden immer und überall gebraucht, vor allem in großen Städten, wo so viele Karawanen zu jeder Stunde des Tages ein und aus gehen. Mir geht es also gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270135
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270135,
					"content": "Hehe, das war’s ... Ich genieße das Leben, das ich jetzt führe, treibend und ungebunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270136
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270136,
					"content": "Benben und ich sind genau wie du und Paimon, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270137
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270137,
					"content": "Ha, Benben ist nicht halb so gut wie Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270138,
					"content": "Biepbiep!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270139
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270139,
					"content": "#Hahaha, nicht streiten ... {NICKNAME}, ich will euch nicht länger aufhalten. Eigentlich würde ich euch gerne zu einem großen Essen einladen, aber die Leibwächter müssen sich an die Regeln halten ... *seufz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270140
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270140,
					"content": "So! Genug gejammert! Tausend Umarmungen für dich und gute Fahrt für den Rest deiner Reise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270141
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270141,
					"content": "#{M#Vergiss nicht, dass sich unsere Wege eines Tages kreuzen werden!}{F#... Vergiss nicht, was ich dir vorhin beim Stamm der Tanit gesagt habe. Wenn du dich jemals müde fühlst oder ausruhen willst ... sehen wir uns vielleicht wieder.}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270121,
					"content": "Ich habe nicht erwartet, dich hier zu sehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270122
					]
				},
				{
					"id": 733270122,
					"content": "Ja ... Ich habe auch nicht mit dir gerechnet. Was für eine tolle Überraschung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270123
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270123,
					"content": "Hehe, wir haben dich doch nicht beim Angeln ... ähm, Fischfang gestört, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270124,
					"content": "Hör auf damit, kleine Paimon! Du hast zu viel geredet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "Jeht"
				}
			]
		},
