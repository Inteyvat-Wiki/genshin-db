				"points": []
			},
			"dialogs": [
				{
					"id": 760940501,
					"content": "Ach, das ist der „Gefährte“ eines ausländischen Händlers, der zuvor in der Höhle gefangen war. Ich hätte nicht gedacht, dass du ihn retten würdest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940502
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940502,
					"content": "Wir wissen zwar alle, dass die Schläfchen dir nur folgen, um ihre Samen in die Ferne zu verbreiten, aber dieser Herr wollte einfach nicht zuhören, egal, wie man es ihm auch zu erklären versuchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940503
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940503,
					"content": "#Ich habe mir schon Sorgen darüber gemacht, aber zum Glück habe ich {F#eine hilfsbereite Abenteurerin}{M#einen hilfsbereiten Abenteurer} wie dich getroffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940504
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940504,
					"content": "Das ist nur ein kleines Zeichen meiner Dankbarkeit, auch wenn es nicht viel ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
		}
	]
