			"dialogs": [
				{
					"id": 760940301,
					"content": "#Als {F#Abenteurerin}{M#Abenteurer} findest du bestimmt einen Weg, das Schläfchen da drinnen herauszuholen, oder? Ich werde dir auch im Namen jenes Herrn danken.",
					"roleType": "TALK_ROLE_NPC",
