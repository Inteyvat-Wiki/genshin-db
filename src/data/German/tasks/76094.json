			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vacarao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760940201,
					"content": "Wunderbar, ich wusste, dass du eine Lösung finden würdest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940202
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940202,
					"content": "Auch wenn Schläfchen ohne Kuuvahki nicht überleben können, spenden sie diesem Herrn zumindest während seiner Zeit in Nod-Krai ein wenig Trost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940203
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940203,
					"content": "Dann werde ich mich jetzt verabschieden. Dies ist ein kleines Zeichen meiner Dankbarkeit, auch wenn es nicht viel ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
		},
		{
