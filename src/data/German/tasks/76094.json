			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vacarao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760940101,
					"content": "Wie kriegen wir diesen Kerl bloß da raus ... Das macht mir echt Kopfzerbrechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940102
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940102,
					"content": "Kann ich etwas tun, um zu helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760940103
					]
				},
				{
					"id": 760940103,
					"content": "#Hm? Oh, du bist es, {F#die hilfsbereite Abenteurerin}{M#der hilfsbereite Abenteurer}! Wie gut, dass ich dich treffe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940104
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940104,
					"content": "Also, es ist so: Durch diese Höhle im Fels führte früher ein Weg nach Norden, aber vor einiger Zeit ist er wegen der Kuuvahki-Anomalie eingestürzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940105
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940105,
					"content": "Zum Glück gab es keine Verletzten, aber ein ausländischer Händler sagte, sein „Gefährte“ sei dort drinnen eingesperrt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940106
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940106,
					"content": "Es war ein Schläfchen, das er hier in der Gegend kennengelernt hatte. Wenn du lange genug hierbleibst, wirst du schnell merken, dass Schläfchen einem meistens nur folgen, um die Samen, die sie tragen, möglichst weit zu verbreiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940107
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940107,
					"content": "Aber dieser Herr wollte einfach nicht zuhören, egal wie wir es ihm erklärten. Er bestand darauf, dass wir einen Weg finden müssen, es zu retten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940108
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940108,
					"content": "Um den Weg in die Tiefen der Höhle wieder zu verbinden, müssen wir diese Verworrenen Blüten nutzen. Leider beherrsche ich weder die Magie der Nachkommen des Frostmonds, noch besitze ich eine starke Kuuvahki-Vorrichtung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940109
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940109,
					"content": "#Zum Glück bin ich dir begegnet. Als {F#Abenteurerin}{M#Abenteurer} findest du bestimmt einen Weg, das Schläfchen da drinnen herauszuholen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940110
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940110,
					"content": "Ich werde dir auch im Namen jenes Herrn danken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
		},
		{
			"id": 7609402,
			"completionStepIds": [
				7609405
