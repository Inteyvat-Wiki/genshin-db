			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sukhovykh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760010101,
					"content": "Dürfen wir euch kurz stören? Wir haben eine Frage ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760010102,
					"content": "Du zeigst den beiden Lichthütern die Dinge, die du zuvor erhalten hast, und erzählst ihnen, wie du mit dem seltsamen Mann, der die Kleidung der Lichthüter trug, Seite an Seite gegen die Wilde Jagd gekämpft hast ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760010103
					]
				},
				{
					"id": 760010103,
					"content": "... War das ... Sigurd? Er ... kann also immer noch nicht in Frieden ruhen ... Wenn ich doch nur ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010104
					],
					"speakerTitle": "Lushne"
				},
				{
					"id": 760010104,
					"content": "Sag das nicht. Das ist nicht deine Schuld. Solange die Wilde Jagd existiert, wird er nicht aufhören zu kämpfen ... Alles, was wir tun können, ist, unsere Pflicht zu erfüllen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010105
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010105,
					"content": "Sigurd war also einst ein Lichthüter, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760010106,
					"content": "Er war ein außergewöhnlicher Starshyna. Als die Armee der Wilden Jagd Nod-Krai verwüstete, kämpfte er tapfer bis zum bitteren Ende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010107
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010107,
					"content": "Es heißt, dass die Monster, die ihren Verstand verloren haben, bei dem Klang der Alarmglocke einen Schauer über den Rücken bekommen und nicht wagen, sich zu nähern ... Ich hätte nicht gedacht, dass jemand seine verlorenen Ausrüstungen finden würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010108
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010108,
					"content": "Wenn möglich, bringt seine Ausrüstungen bitte zu den Ruinen des Schlachtfelds im Osten von Lempo, zu seinem Grab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010109
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010109,
					"content": "Wird gemacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760010110
					]
				},
				{
					"id": 760010110,
					"content": "Danke. Möge der Tag kommen, an dem seine Seele in Frieden ruhen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sukhovykh"
				}
			]
		},
