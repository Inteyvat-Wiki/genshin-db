			"dialogs": [
				{
					"id": 710660201,
					"content": "Du bist zurück! Wie ist es gelaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660202
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660202,
					"content": "Schau, ist es dieser Ring?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
