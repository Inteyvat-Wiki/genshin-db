					"Taliesin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660101,
					"content": "Leider ... seltsam, seltsam, wirklich seltsam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660102
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660102,
					"content": "Ich glaube, er ist immer noch da ... aber ich kann ihn nicht finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660103
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660103,
					"content": "Was ist passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660104
					]
				},
				{
					"id": 710660104,
					"content": "Mein Ring ... Er ist weg. Dieser Ring ist sehr wichtig für mich. Es wäre nicht gut, ihn hier zu verlieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660105
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660105,
					"content": "Wie sieht dein Ring aus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660106
					]
				},
				{
					"id": 710660106,
					"content": "Der Ring ist aus Messing mit einem schönen roten Stein besetzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660107
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660107,
					"content": "Ich habe es bei einem Lavasee gefunden. Die Legende besagt, dass der Schattendrache Durin hier gefallen ist. Das erklärt, warum er einen Glanz hat, der an schwelende Flammen erinnert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660108
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660108,
					"content": "Oha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660109,
					"content": "Die Legende besagt, dass sein Besitzer, sobald er ihn trägt, vom „Herrn des Abgrunds“ beobachtet und von dessen dunklen Armee gejagt wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660110
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660110,
					"content": "Oh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
