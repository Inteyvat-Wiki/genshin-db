					"Taliesin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660301,
					"content": "Genau. Das ist er. Vielen Dank euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660302
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660302,
					"content": "Bitte betrachte dies als Belohnung. Es ist nicht viel, aber fühl dich bitte nicht beleidigt. Ich werde Verse verfassen, um deine Taten zu preisen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
		{
