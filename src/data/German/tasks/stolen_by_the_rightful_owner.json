				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Taliesin",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660701,
					"content": "Entschuldigung, aber als Dichter versucht man immer, dramatischer zu sein und mit neuen Geschichten zu experimentieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660702
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660702,
					"content": "He, ich habe diesen Ring vor ein paar Jahren aus der Höhle eines Schatzmarders geholt ... Er schien in ziemlich gutem Zustand zu sein und ziemlich gut auszusehen, also habe ich ihn bei mir behalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660703
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660703,
					"content": "Hmpf, es ist also Diebesgut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660704,
					"content": "Sei nicht so streng ... Es ist eigentlich mehr ein „Mitbringsel“. Diesen Schatz hege ich immer noch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660705
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660705,
					"content": "Gibt es einen Hinweis in Bezug auf den Ring?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660706
					]
				},
				{
					"id": 710660706,
					"content": "Hmmm ... Ich habe gehört, dass es hier oft Schatzmarder gibt, also haben diese Kleinen vielleicht meinen Ring gestohlen, während ich schlief.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660707
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660707,
					"content": "Es gibt also immer noch Leute, die ihre Ringe im Bett abnehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660708,
					"content": "Davon habe ich noch nicht gehört.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660709
					]
				},
				{
					"id": 710660709,
					"content": "Paimon macht das jedenfalls nicht! Es ist reine Zeitverschwendung, wenn man nach dem Abnehmen des Rings überlegen muss, wohin man ihn steckt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660710,
					"content": "Gibt es wirklich einen kleinen Ring, den Paimon tragen kann?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660711
					]
				},
				{
					"id": 710660711,
					"content": "Aber natürlich! Die Welt ist groß, es gibt noch viel mehr, was du nicht weißt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660712,
					"content": "Gut, bitte hört auf, wahllos Kommentare über die Gewohnheiten anderer zu machen und darüber zu reden! Das ist unhöflich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660713
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660713,
					"content": "... Wie auch immer, wenn du mithelfen willst ... Bitte halte Ausschau nach Schatzmarderhöhlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660714
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660714,
					"content": "Ich habe gehört, dass in diesem Teil der Karte ... die Schatzräuber ein verdächtiges Lager errichtet haben. Hier, ich werde es für dich markieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660715
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660715,
					"content": "Man sagt, dass es in der Gegend Schatzmarder gibt, wahrscheinlich im Zusammenhang mit diesen Schatzräubern ... Wie auch immer, geh bitte zuerst hierher und sieh dir das mal an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660716
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660716,
					"content": "Hm ... Ein Ring, der aus der Höhle von Schatzmardern gestohlen und von einem Schatzmarders zurückgestohlen wurde, ist eine Rückkehr zu seinem rechtmäßigen Besitzer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660717,
					"content": "Bitte sei nicht so sarkastisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
		{
			"id": 7106608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
