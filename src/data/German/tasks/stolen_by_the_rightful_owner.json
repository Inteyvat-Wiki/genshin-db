			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitopho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660801,
					"content": "Hallo, ist in letzter Zeit etwas passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660802
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660802,
					"content": "In Bezug auf die Schatzmarder ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660803
					]
				},
				{
					"id": 710660803,
					"content": "Ach so, du meinst die Schatzmarder aus der Großen Kluft? Haha ... Ich sollte eigentlich die Verantwortung tragen, aber ich habe es vermasselt ... Mehr gibt es nicht zu sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660804
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660804,
					"content": "Nun ... Oh, es ist unwahrscheinlich, dass ich sie wieder fangen kann ... Schließlich sind diese kleinen Biester so unberechenbar und schwer zu verfolgen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660805
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660805,
					"content": "Aber ja, ich kann einen kleinen Hinweis geben, falls von jemandem die Sachen gestohlen wurden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660806
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660806,
					"content": "Schatzmarder, die von Schatzräubern ausgebildet werden, werden zu einer bestimmten Zeit am Tag gefüttert. Es gibt drei Arten von Schatzmardern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660807
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660807,
					"content": "Der goldene Schatzmarder ist der gerissenste ... Dann gibt es noch den häufigeren hortenden Schatzmarder. Der dümmste von allen ist der Anfänger-Schatzmarder, aber wann er auftaucht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660808
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660808,
					"content": "*seufz* Es sollte ein Trainingshandbuch geben, in dem der Zeitplan steht. Keiner müsste sich die Mühe machen, sich die genauen Fütterungszeiten zu merken. Das Handbuch sollte im Lager liegen, wo die Schatzmarder oft gesehen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660809
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660809,
					"content": "Ah ... Das hätte ich fast vergessen! Pfeife nicht nach ihnen, wenn du sie nicht rufen willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660810
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660810,
					"content": "Pfeifen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660811
					]
				},
				{
					"id": 710660811,
					"content": "Eine normale Pfeife reicht aus, sie muss nicht ausgefallen sein, es kommt auf die richtige Zeit an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				}
			]
		}
	]
}