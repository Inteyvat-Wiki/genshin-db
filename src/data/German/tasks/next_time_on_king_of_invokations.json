			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fukumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350101,
					"content": "*seufz* Ich möchte zurück nach Inazuma ... Wie konnte mir das nur passieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350102,
						230350103
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350102,
					"content": "Was ist mit dir los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				},
				{
					"id": 230350104,
					"content": "#{F#Reisende}{M#Reisender}? Ach, erwähne den Roman nicht einmal. Das Team, das an „Geniale Beschwörung“ arbeitet, hält wohl nicht mehr länger durch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350105
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350105,
					"content": "Laut einem Gelehrten, den ich ziemlich gut kenne, stieß das Team auf eine Reihe von Problemen, die man nur als Chaos bezeichnen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350106
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350106,
					"content": "Eines Tages stellte zum Beispiel ein Haravatat-Gelehrter plötzlich eine Frage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350107
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350107,
					"content": "Er sagte, wenn die Beschreibungen der Karteneffekte zu lang sind, könnte dies Leute, die es nicht gewohnt sind, lange Texte zu lesen, davon abhalten, „Geniale Beschwörung“ zu spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350108
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350108,
					"content": "Gelehrte sind es gewohnt, lange Texte zu lesen und sind daher von diesem Problem nicht betroffen. Aber lange Beschreibungen können potenzielle Spieler davon abhalten, „Geniale Beschwörung“ zu spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350109
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350109,
					"content": "Daher schlug er vor, die Textmenge auf einigen Karten zu halbieren, um sie leichter lesbar zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350110,
						230350111
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350110,
					"content": "Ist das wirklich notwendig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350112,
					"content": "Für mich ist das kein Problem ... aber die Gelehrten diskutieren noch darüber. Schließlich geht es um das Spielerlebnis, und je weniger Probleme, desto besser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350113
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350113,
					"content": "Also, lassen wir das beiseite ... Was mich jetzt am meisten beunruhigt, ist, dass sie versprochen haben, mir bei der Suche nach Modellen zu helfen, und anscheinend hatten sie auch damit Probleme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350114
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350114,
					"content": "Erinnerst du dich? Ich habe dir vorhin gesagt, dass ein Gelehrter sagte, er würde mir Tighnari und Cyno vorstellen und sie bitten, Modelle für meinen Roman zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350115
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350115,
					"content": "Aber sie sind zu beschäftigt. Ich glaube nicht, dass ich mich jetzt auf sie verlassen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350116,
						230350117
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350116,
					"content": "Was möchtest du tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350118,
					"content": "Der Gelehrte, der mich empfing, konnte mir zwar dabei nicht weiterhelfen, aber er brachte mich auf eine Idee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350119
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350119,
					"content": "Er sagte, Herr Cyno gehe manchmal ins Puspa-Kaffeehaus, um Karten zu spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350120
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350120,
					"content": "Wenn ich also will ... kann ich dort mein Glück versuchen. Oder ich warte, bis sie Zeit haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350121
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350121,
					"content": "Und du wirst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350122
					]
				},
				{
					"id": 230350122,
					"content": "*seufz* Wenn ich warte, bis sie Zeit haben, ist mein Roman vielleicht schon fertig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350123
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350123,
					"content": "Nun, ich verlasse mich lieber auf mich selbst und sehe nach, ob ich Herrn Cyno finden kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350124
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350124,
					"content": "Aber wenn ich das Glück hätte, Herrn Cyno im Kaffeehaus zu treffen, wie sollte ich mich ihm überhaupt vorstellen? Das ist ein echtes Kopfzerbrechen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350128,
						230350129
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350128,
					"content": "Ich kann dir helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350130,
					"content": "Echt!? Das ist toll! Aber wie hast du ... Äh, egal, das ist ja nicht wichtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350131
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350131,
					"content": "Worauf warten wir noch? Lass uns gleich ins Puspa-Kaffeehaus gehen! Hoffentlich können wir Herrn Cyno treffen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350129,
					"content": "Ich kenne Cyno ziemlich gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350117,
					"content": "Wie wirst du sie kontaktieren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350111,
					"content": "Die Texte sind doch nicht so lang ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350103,
					"content": "Läuft dein Roman gut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				}
			]
		},
		{
			"id": 2303503,
			"completionStepIds": [
				2303503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303503",
							"2"
						],
						"stepId": 2303503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fukumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350301,
					"content": "Psst ... I... Ist das nicht Herr Cyno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350302
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350302,
					"content": "Sieh dir sein Outfit, seine Frisur und seine Haarfarbe an ... Genau so sollte ein Protagonist in einem Kartenroman aussehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350303,
						230350305
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350303,
					"content": "Das ergibt keinen Sinn ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350304
					]
				},
				{
					"id": 230350304,
					"content": "He, vertraue einfach meinem Bauchgefühl über den Markt. Aber jetzt ist kein guter Zeitpunkt, es zu erklären ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350309
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350309,
					"content": "#{F#Reisende}{M#Reisender}, bitte hilf mir und lass Herrn Cyno ein Modell für meinen Roman sein ... Ich zähle auf dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350305,
					"content": "Wenn das der Fall ist, kenne ich tatsächlich viele solcher Leute ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350306
					]
				},
				{
					"id": 230350306,
					"content": "Wirklich? Das ist toll. Ich arbeite derzeit am dritten Werk von „Ass-Beschwörer“, und dieses Mal werde ich es nicht auf der Spielmechanik von „Geniale Beschwörung“ aufbauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350307
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350307,
					"content": "Ich werde eine ganz neue Art des Spielens erschaffen. Zum Beispiel ... alle Karten auf dem Spielfeld hängen in der Luft. Die Spieler müssen während des Spiels ständig neue Karten sammeln und gleichzeitig die Gegner daran hindern, Karten zu sammeln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350308
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350308,
					"content": "Hahaha! Ich werde aufgeregt, wenn ich nur daran denke! Aber das ist jetzt nicht der richtige Zeitpunkt, darüber zu diskutieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350309
					],
					"speakerTitle": "Fukumoto"
				}
			]
		},
		{
			"id": 2303504,
			"completionStepIds": [
				2303504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303504",
							"2"
						],
						"stepId": 2303504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350401,
					"content": "... Hmm, diese Kartenkombination ist vielleicht nicht schlecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350402
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350402,
					"content": "Aber diese Karten sind nicht stark genug, um mit schnellen Angriffen fertig zu werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350403
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350403,
					"content": "Was machst du hier, Cyno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350404
					]
				},
				{
					"id": 230350404,
					"content": "#{NICKNAME}? Ich hatte nicht erwartet, dich hier zu treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350405
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350405,
					"content": "Ich versuche gerade, ein Deck von „Geniale Beschwörung“ mit einer relativ langsamen Angriffsgeschwindigkeit zu bauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350406
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350406,
					"content": "Mein Plan ist, dass Spieler, die dieses Deck verwenden, eine Fülle von Ressourcen und viele mächtige Karten zum Spielen haben werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350407
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350407,
					"content": "Aber um ehrlich zu sein, es ist ziemlich schwer, so ein Deck zu bauen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350408
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350408,
					"content": "Derzeit ziehen es einige Spieler von „Geniale Beschwörung“ vor, Karten mit schneller Angriffsgeschwindigkeit zu verwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350409
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350409,
					"content": "Zu Beginn des Spiels spielen sie viele Karten auf einmal, um ihren Gegner blitzschnell zu besiegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350410
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350410,
					"content": "Aber diese Taktik ist nicht mein Stil. Ich ziehe es vor, Ressourcen auf verschiedene Arten fortlaufend anzusammeln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350411
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350411,
					"content": "Jede mögliche Gelegenheit zu nutzen, meinen Vorteil ständig auszubauen und schließlich den letzten Sieg zu sichern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350412
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350412,
					"content": "Ja! Genau so! Wunderbar! Du bist genauso wie der Protagonist in meinem Roman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350413
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350413,
					"content": "Tut mir leid! Äh ... ich bin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350414,
						230350415
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350414,
					"content": "Das ist Fukumoto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350415,
					"content": "Das ist der Autor von „Ass-Beschwörer“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350416,
					"content": "Hallo, Mahamatra, also ... Ich glaube, du kennst mich nicht, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350417
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350417,
					"content": "Ich habe deinen Roman gelesen. Er ist sehr gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350418
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350418,
					"content": "Oh, ich fühle mich so geehrt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350419
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350419,
					"content": "Immer wenn der Protagonist dieses Romans im Nachteil ist, schafft er es auf verschiedene Weise, eine Karte zu bekommen, die nicht in seinem Deck ist, und besiegt dann seinen Gegner. Das hat bei mir einen tiefen Eindruck hinterlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350420
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350420,
					"content": "Ich verstehe, dass das Schreiben von Romanen einen kreativen Ansatz erfordert, aber diese Gewinnmethode widerspricht der grundlegenden Mechanik von „Geniale Beschwörung“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350421
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350421,
					"content": "Also, was das angeht ... Obwohl ich „Geniale Beschwörung“ viel spiele, bin ich nicht sehr gut darin ... Und wenn man Kartenduelle mit einer wettbewerbsorientierten Denkweise schreibt, ergibt das keine interessante Geschichte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350422
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350422,
					"content": "Hm, ist das so? Nun, ich habe gerade zwei Decks zusammengestellt, also können wir hier ein paar Runden „Geniale Beschwörung“ spielen. Vielleicht findest du ja hier Inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350423,
						230350424
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350423,
					"content": "(Jetzt spielen sie gleich Karten ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350425
					]
				},
				{
					"id": 230350424,
					"content": "(Dieser Typ will vielleicht einfach Karten spielen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350425
					]
				},
				{
					"id": 230350425,
					"content": "Äh? Mi... Mit dir? Ich würde gerne, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350426,
						230350427
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350426,
					"content": "Ich erkläre es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230350427,
					"content": "Über Fukumotos Bitte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230350428,
					"content": "Du hast Cyno Fukumotos Bitte erzählt ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230350429,
					"content": "Du bittest mich, für die Illustrationen in „Ass-Beschwörer“ Modell zu stehen? Das ist sicher kein Problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350430
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350430,
					"content": "#Super! {F#Reisende}{M#Reisender}, schnell, hilf mir, ein paar Fotos zu machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fukumoto"
				}
			]
