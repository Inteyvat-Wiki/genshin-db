					"nextDialogs": [
						230350604
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350604,
					"content": "Hast du nicht schon vorher versprochen, ein paar Runden „Geniale Beschwörung“ mit mir zu spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350605
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350605,
					"content": "#Äh?! I... Ich bin nicht sehr gut darin, also ... {F#Reisende}{M#Reisender}, du spielst sicher besser als ich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350606,
						230350607
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350606,
					"content": "Hab ich nicht einmal gespielt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350608
					]
				},
				{
					"id": 230350607,
					"content": "Du spielst besser als ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350608
					]
				},
				{
					"id": 230350608,
					"content": "Gut, also ist es abgemacht. Hier, nimm dieses Deck mit schnellen Angriffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350609
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350609,
					"content": "Ich werde dieses Deck mit der relativ langsamen Geschwindigkeit verwenden. Mal sehen, wie ich mit deinen schnellen Angriffen umgehen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350610
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350610,
					"content": "Ich werde mein Bestes tun, Herr Cyno ...",
