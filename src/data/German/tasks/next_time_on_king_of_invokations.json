				},
				{
					"id": 230350602,
					"content": "Vielen Dank, Herr Cyno. Sobald der Roman erscheint, schicke ich dir auf jeden Fall ein Exemplar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350603
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350603,
					"content": "Ähm, Herr Cyno, die zwei Decks in deiner Hand sind ...?",
