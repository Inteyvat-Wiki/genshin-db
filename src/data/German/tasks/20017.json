			"dialogs": [
				{
					"id": 200170401,
					"content": "#Vielen Dank, {F#Reisende}{M#Reisender}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170402
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170402,
					"content": "Scheint, als wollten diese Kerle einfach nicht gehen. Ich muss hier schleunigst verschwinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170403
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170403,
					"content": "Jetzt hat der Wagen schon wieder etwas abbekommen. Ihn komplett zu reparieren, wird wohl nichts bringen. Dann nehme ich eben mein Seil und ... Öhm, wo ist mein Seil hin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170404
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170404,
					"content": "Unmöglich! Diese Monster müssen es mitgenommen haben. Siehst du bitte nach, ob du irgendwo ein <color=#00E1FFFF>Seil</color> findest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		},
