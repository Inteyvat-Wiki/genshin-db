			"dialogs": [
				{
					"id": 200170601,
					"content": "Das geht doch. Damit werde ich es zumindest bis zur Stadt schaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170602
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170602,
					"content": "#Danke, {F#Reisende}{M#Reisender}. Bis zum nächsten Mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170603
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170603,
					"content": "Bäh, dieser Gestank! Wie soll ich den nur rauskriegen?",
					"roleType": "TALK_ROLE_NPC",
