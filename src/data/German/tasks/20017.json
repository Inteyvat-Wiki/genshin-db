					"content": "Eine dringende Angelegenheit wartet auf mich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200170802
					]
				},
				{
					"id": 200170802,
					"content": "So warte doch! Riechst du das? Wenn ich diese Früchte nicht bald an ihr Ziel bringe, werden sie alle schlecht. Ich flehe dich an, mir zu helfen!",
					"roleType": "TALK_ROLE_NPC",
