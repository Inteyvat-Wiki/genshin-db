					"Farrah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200170101,
					"content": "#Bitte hau mich nicht! Bitte ... Ah, {F#Reisende}{M#Reisender}, wo sind sie denn alle hin? Hast du sie verscheucht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170102
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170102,
					"content": "Super! Ich danke dir! ... Aber sind sie auch wirklich alle weg?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170103
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170103,
					"content": "Puh, gut, dass du da warst. Aber mit dieser Verzögerung hole ich die Karawane sicher nicht mehr ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170104
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170104,
					"content": "Außerdem haben sie meinen Wagen demoliert. Ich muss ich schleunigst reparieren und zurück in die Stadt fahren. Sonst werden die Früchte noch schlecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170105
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170105,
					"content": "Du kannst dir nicht vorstellen, wie mein Wagen aussehen würde, wenn die ganzen Früchte schlecht würden. Das krieg ich nie wieder raus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170106
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170106,
					"content": "Ich muss mir die Früchte noch einmal genau ansehen. Ich kann schon riechen, dass einige schlecht geworden sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170107
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170107,
					"content": "Kannst du mir ein paar Materialien sammeln, damit ich den Wagen reparieren kann? Ein <color=#00E1FFFF>stabiles Brett</color> sollte genügen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		},
		{
