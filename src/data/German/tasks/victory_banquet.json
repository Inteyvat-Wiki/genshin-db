	"talks": [
		{
			"id": 1202301,
			"completionStepIds": [
				1202302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
