				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kouzen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230201,
					"content": "Puh ... Dieser Typ riecht nach Alkohol ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230202,
					"content": "#Hmm? Wartet, wartet, sagt es mir nicht ... {F#die}{M#der} Truppenführer{F#in} von Schwertfisch II! Richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230203
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230203,
					"content": "Du bist tatsächlich zurückgekehrt. Ich dachte, du hättest die Truppe verlassen und dich davon gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230204
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230204,
					"content": "Nie! Wir würden nie vor einem Kampf weglaufen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230205,
					"content": "Hmpf, ist das so. Alles worüber alle in letzter Zeit reden, ist Frieden und Stabilität.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230206
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230206,
					"content": "Erinnerst du dich, was die wichtigste Sache der Widerstandstruppe ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230207
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230207,
					"content": "Der Wille eines Kriegers.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230208
					]
				},
				{
					"id": 120230208,
					"content": "Da hast du recht. Ich werde dich also testen. Es ist an der Zeit zu sehen, ob du wirklich ein echter Widerstandskämpfer bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230209
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230209,
					"content": "Ich werde deine Fragen beantworten, aber nur, wenn du mich in einem Duell besiegen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230210
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230210,
					"content": "Ach, dieser Typ ... Wäre es so schlimm, einfach ein normales Gespräch zu haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230211,
					"content": "#Was sollen wir tun, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230212,
						120230213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230212,
					"content": "Sicher. Wir werden kaum verlieren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				},
				{
					"id": 120230214,
					"content": "Pff ... Das werden wir sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230213,
					"content": "In ein paar Sekunden wirst du betteln zu reden!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				}
			]
		},
		{
			"id": 1202303,
			"completionStepIds": [
				1202305,
				1202312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202305",
							"2"
						],
						"stepId": 1202305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kouzen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230301,
					"content": "Du bist ein starker Kämpfer ... Kein Wunder, dass Ihre Exzellenz dich gewählt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230302
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230302,
					"content": "Du hast tatsächlich den Willen eines Kriegers ... Dann kannst du uns ja vielleicht verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230303
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230303,
					"content": "#Truppenführer{F#in} ... Gesellst du dich zu uns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230304
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230304,
					"content": "Erst musst du mir sagen, was hier los ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230305
					]
				},
				{
					"id": 120230305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230306
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230306,
					"content": "Wir haben es uns ausgedacht. Die Geschichte über das Komplott der Tenryou-Verwaltung mit den Fatui ... Es ist nicht passiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230307
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230307,
					"content": "WAS!? Die arme Kokomi war krank vor Sorge! Und du sagst uns, dass die ganze Sache nur ausgedacht war?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230308,
					"content": "Was zur Hölle habt ihr euch gedacht? Das könnte euch direkt wieder in den Krieg mit der Tenryou-Verwaltung stürzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230309,
					"content": "Ja. Das ist genau, was wir zu erreichen hoffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230310
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230310,
					"content": "Friedensgespräche? Pfft ... Alle sind fasziniert von dem Gedanken. Deshalb steht die Zukunft von Watatsumi auf dem Spiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230311
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230311,
					"content": "Was soll die Tenryou-Verwaltung davon abhalten, uns in den Rücken zu fallen? Und was soll den Shougun Raiden davon abhalten, ein weiteres Augenhatz-Dekret zu erlassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230312
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230312,
					"content": "Wir sind die Widerstandstruppe! Alles hängt von unserem Kriegerwillen ab!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230313
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230313,
					"content": "Wir können der Tenryou-Verwaltung und dem Shougun Raiden nicht trauen. Aber wir können uns selbst trauen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230314
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230314,
					"content": "Sicherlich stimmt ihr damit überein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230315
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230315,
					"content": "Sein Standpunkt ergibt irgendwie Sinn, aber etwas daran fühlt sich für Paimon nicht richtig an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230316,
					"content": "Worauf es hinausläuft ist ... dass ihr einfach kämpfen wollt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230317
					]
				},
				{
					"id": 120230317,
					"content": "Ja! Alles, was du gerade gesagt hast, war pure Spekulation, oder etwa nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230318,
					"content": "Bist du ernsthaft bereit, ein wildes Gerücht zu erfinden und den Frieden zu ruinieren, für den alle so hart gearbeitet haben, und das alles wegen einer imaginären Situation, die möglicherweise nicht einmal eintrifft?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230319,
					"content": "Rede nicht so mit mir, tust so, als stündest du über all dem! Was kannst du schon verstehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230320
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230320,
					"content": "Um des Sieges willen haben wir den Willen des Kriegers voll und ganz verkörpert. Verstehst du? Wir waren alle drin. Jetzt versuchen sie uns plötzlich zu sagen, dass nichts davon mehr zählt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230321
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230321,
					"content": "Ich würde einfach meine Waffe niederlegen und anfangen, wie ein gewöhnlicher Mensch zu leben, aber wie kann ich das? Wie kann ich, wenn ... wenn ich jedes Mal, wenn ich meine Augen schließe, die Gesichter der Freunde sehe, die wir im Kampf verloren haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230322
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230322,
					"content": "Jedes Mal, wenn ich sie dort vor meinem geistigen Auge sehe, erinnert es mich daran, dass ich der Tenryou-Verwaltung niemals verzeihen kann, und auch nicht dem Augenhatz-Dekret!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230323
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230323,
					"content": "Ich schätze, du bist keiner von uns ... Na ja, was auch immer. Sag es Sangonomiya, wenn du willst. Aber es ist jetzt zu spät, um uns aufzuhalten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230324
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230324,
					"content": "Zu spät? Was meinst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230325,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230326
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230326,
					"content": "Verflucht, scheint nicht, als würde er darauf antworten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230327,
					"content": "#Was sollen wir tun, {NICKNAME}? Es ist dringend, gehen wir und sagen wir es zuerst Kokomi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202304,
			"completionStepIds": [
				1202306,
				1202307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202306",
							"2"
						],
						"stepId": 1202306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230401,
					"content": "... Wir haben ein paar Sachen herausgefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230402,
					"content": "Die ganze Sache über die Tenryou-Verwaltung und ihr Komplott mit Fatui ist Humbug. Sie haben sich alles ausgedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230403,
					"content": "Sie wollten, dass die Friedensgespräche abgebrochen werden, damit sie den Krieg weiterführen können. Und sie sagten, dass es zu spät ist, sie aufzuhalten, egal was wir tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230404,
					"content": "Hmm. Ich verstehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230405,
						120230406
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230405,
					"content": "Was ist los, Kokomi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				},
				{
					"id": 120230407,
					"content": "Es geht mir gut, keine Sorge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230408
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230408,
					"content": "Das ist meine Schuld. Wenn ich nur früher wahrgenommen hätte, was sie fühlen, wäre es nie dazu gekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230409
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230409,
					"content": "Ich glaube, ich verstehe, was Kouzen meint, wenn er sagt, es ist zu spät.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230410
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230410,
					"content": "Die Gespräche beginnen erst morgen, aber beide Seiten haben bereits ihre Wachen an den Ort geschickt. Sie sind dafür verantwortlich, dass das Gebiet sicher und geschützt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230411
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230411,
					"content": "Ich habe den starken Verdacht, dass einer von Kouzens Kriegsbefürwortern die Wache infiltriert hat, mit der Absicht, die Feindseligkeiten morgen während der Verhandlungen neu zu entfachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230412
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230412,
					"content": "Na, das ist nicht gut. Sollen wir jetzt rübergehen und das Team austauschen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230413,
					"content": "Es wird nicht gehen. Erstens wird allein der Vorgang, ein neues Team von Wachleuten an einen neutralen Verhandlungsort zu bringen, beide Seiten in höchste Alarmbereitschaft versetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230414
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230414,
					"content": "Dies würde die Pro-Kriegsfraktion mit ziemlicher Sicherheit zum Handeln zwingen. Sie würden die Wächter der Tenryou-Verwaltung angreifen, und es bestünde die Gefahr, dass der Krieg wieder ausbricht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230415
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230415,
					"content": "Ganz zu schweigen davon, dass wir keine Ahnung haben, wie viele Soldaten von Watatsumi in diese Intrige verwickelt sind. Wenn wir unsere Wache übereilt wechseln, stehen wir vor dem Problem, nicht zu wissen, wem wir vertrauen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230416
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230416,
					"content": "Klingt nach einer wirklich kniffligen Situation ... können wir also wirklich nichts dagegen tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230417,
					"content": "Mach dir keine Sorgen, was geschehen ist, ist geschehen. Jetzt liegt es an mir, einen Gegenplan zu entwerfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230418
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230418,
					"content": "Diese Soldaten haben eine Grenze überschritten, aber die Schuld liegt nicht allein bei ihnen. Was auch immer passiert, ich werde einen Weg finden, dass sie nicht zu Schaden kommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230419
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230419,
					"content": "Treffen wir uns morgen nochmal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230406,
					"content": "Geht es dir gut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				}
			]
		},
		{
			"id": 1202305,
			"completionStepIds": [
				1202308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
