						],
						"stepId": 1202302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi",
					"Denjirou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230101,
					"content": "Sieht aus, als wäre alles vorbereitet für das Fest. Aber ich muss dennoch eine kurze Rede geben, bevor die Festivitäten beginnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230102
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230102,
					"content": "Oh ... Wie viel Energie wird das kosten? Glaubst du, du hast genug?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230103,
					"content": "Keine Sorge, ich habe reichlich. Dank euch beiden, habe ich mich schneller als gewöhnlich erholt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230104
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230104,
					"content": "Das ist großartig! Wir drücken dir die Daumen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230105,
					"content": "Herzlich willkommen. Heute ist der Tag, an dem wir unseren Sieg feiern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230106
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230106,
					"content": "Kürzlich ging unser Krieg mit der Bakufu-Armee zu Ende und wir sahen endlich die Abschaffung des Augenhatz-Dekrets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230107
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230107,
					"content": "Keiner von uns kann wissen, wie das Inazuma der Zukunft aussehen wird. Aber morgen treffe ich mich mit der Tenryou-Verwaltung für Friedensgespräche. Ich gebe euch mein Wort, dass ich ein für alle Mal nach Frieden für die Insel Watatsumi streben werde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230108
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230108,
					"content": "Ich danke euch allen für eure tapferen Bemühungen. Wahrlich, nur durch diese Bemühungen konnten wir uns in diesem schwierigen Krieg durchsetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230109
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230109,
					"content": "Dieses Fest wird zu Ehren jedes einzelnen von euch abgehalten, der sich heute hier versammelt hat. Ich hoffe, ihr alle könnt euch entspannen und unseren hart erkämpften Sieg genießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230110
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230110,
					"content": "Ooooh!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230111
					],
					"speakerTitle": "Denjirou"
				},
				{
					"id": 120230111,
					"content": "Der heutige Abend scheint reibungslos zu verlaufen. Ich bin so froh, dass alles glattläuft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230112
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230112,
					"content": "#Wenn Menschen glücklich sind, neigen sie zu einem erhöhten Bedürfnis, sich anzuvertrauen. {NICKNAME}, kannst du bitte einige weitere Informationen für mich sammeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230113
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230113,
					"content": "Ich habe immer noch keine weiteren Hinweise in Bezug auf ein mögliches Komplott der Tenryou-Verwaltung und den Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230114
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230114,
					"content": "Und ich mache mir Sorgen, dass bei den morgigen Friedensgesprächen etwas passieren könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230115
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230115,
					"content": "Klar, sicher. Wir hören uns mal um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202302,
			"completionStepIds": [
				1202303
