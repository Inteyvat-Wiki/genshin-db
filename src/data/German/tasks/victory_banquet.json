			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hirai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230501,
					"content": "Auf Watatsumi herrscht endlich Frieden, und das alles dank Ihrer Exzellenz, Sangonomiya ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230502
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230502,
					"content": "Es scheint, als ob die Soldaten nicht nur wegen des Festes aufgeregt sind ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230503
					]
				},
				{
					"id": 120230503,
					"content": "In letzter Zeit? Hm, lass mich nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230504
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230504,
					"content": "Das Größte für uns ist, dass wir endlich wieder auf den Ozean hinausfahren können, um zu fischen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230505
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230505,
					"content": "Während der Feindseligkeiten war das offene Meer voll von Kriegsschiffen. Wir mussten uns mit ein paar Fischen und den Krabben begnügen, die wir in Küstennähe ergattern konnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230506
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230506,
					"content": "Wenn der Fang nicht gut war, mussten wir alle hungern. Die armen Kinder weinten den ganzen Tag und die ganze Nacht, aber es gab einfach nichts, was ich tun konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230507
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230507,
					"content": "Wir gingen ausgehungert ins Bett und wälzten uns die ganze Nacht hin und her und versuchten, uns bis zum Morgen zusammenzureißen. Wenigstens wird es jetzt endlich besser ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230508
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230508,
					"content": "#Ich hörte, du bist {F#die}{M#der} Truppenführer{F#in} von Schwertfisch II, stimmt das? Ich danke dir für deinen Dienst. Hier, nimm dir den Fisch! Er ist frisch gefangen, also ist er ein bisschen, äh, fischig, aber er ist in Ordnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230509
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230509,
					"content": "Nein, nein, nein, nein, w... wir könnten nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230510,
					"content": "Ah, komm schon, nimm ihn! Ohne dich würden wir heute Abend wahrscheinlich immer noch hungern. Ihre Exzellenz lehrt uns immer, Freundlichkeit mit Dankbarkeit zu erwidern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230511
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230511,
					"content": "#Na ja, danke! {NICKNAME}, wir fragen einfach woanders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
