				"points": []
			},
			"dialogs": [
				{
					"id": 120230601,
					"content": "He, habt ihr Lust auf frisches Obst und Gemüse? Das Mittel der Natur, wenn ihr es mit dem Grillen übertreibt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230602
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230602,
					"content": "Was ist in letzter Zeit passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230603
					]
				},
				{
					"id": 120230603,
					"content": "Meinst du die Sache mit der Tenryou-Verwaltung und den Fatui? Ich habe Gerüchte gehört, aber nichts allzu Detailliertes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230604
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230604,
					"content": "Es ist lustig, dass du sagst, die Soldaten scheinen aufgeregt zu sein. Ich habe den gleichen Eindruck. Siehst du den Typen da drüben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230605
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230605,
					"content": "Er verhält sich in letzter Zeit seltsam, schreit immer und fuchtelt mit seinem Speer herum, wenn er nichts zu tun hat. Er hat mich ein paar Mal zu Tode erschreckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230606
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230606,
					"content": "Uff ... Es ist ein Wunder, dass die Kämpfe endlich beendet sind. Ich hoffe wirklich, dass wir uns nicht noch mehr Ärger einhandeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230607
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230607,
					"content": "Ich fürchte, ich habe nicht viele Informationen. Wenn du noch weitere Fragen hast, kannst du genauso gut zu ihm gehen und mit ihm sprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230608
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230608,
					"content": "#Endlich ein Hinweis, {NICKNAME}. Lass uns hingehen und nachsehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
