			},
			"dialogs": [
				{
					"id": 30011101,
					"content": "#Oh, {F#Reisende}{M#Reisender}, ihr seid wieder da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011102
					],
					"speakerTitle": "Nasrin"
				},
				{
					"id": 30011102,
					"content": "Hallo, hast du Collei gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011103,
					"content": "Ach, Collei, ich habe sie gerade auf ihr Zimmer gehen sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011104
					],
					"speakerTitle": "Nasrin"
				},
				{
					"id": 30011104,
					"content": "Tja ... Dann müssen wir sie wohl morgen wieder aufsuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
