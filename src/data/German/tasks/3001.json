				{
					"id": 30010609,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010610
					]
				},
				{
					"id": 30010610,
					"content": "Moment mal, was war das? Hat sich Paimon das eingebildet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010611,
						30010613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010611,
					"content": "Du hast es also auch gesehen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010612
					]
				},
				{
					"id": 30010612,
					"content": "Ja! Es ist eines dieser kleinen, runden, gemüseartigen Dinger ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010615,
					"content": "Der hat Paimon gerade wirklich erschreckt. Paimon denkt, wir sollten uns erkundigen, was das für ein Ding ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010616,
					"content": "Aber jetzt lass uns erst einmal an die Arbeit gehen. Paimon fliegt nach oben und du schrubbst unten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010617,
					"content": "Nachdem du die Statue sorgfältig mit Paimon zusammen gereinigt hast ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 30010613,
					"content": "Ist das Weißkohl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010614
					]
				},
				{
					"id": 30010614,
					"content": "Ja, ja! Er ist klein und rund und er sieht tatsächlich wie ein Weißkohl aus. Aber er kann sich offensichtlich bewegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010605,
					"content": "Die „Niedere Herrin Kusanali“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010606
					]
				},
				{
					"id": 30010606,
					"content": "Der Name passt gut zu dieser Götterstatue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010607
					],
					"speakerTitle": "Paimon"
				}
			]
		},
