			"dialogs": [
				{
					"id": 30011001,
					"content": "Ja! Was gibt’s denn Feines?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011002,
					"content": "Paimon, benimm dich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011003
					]
				},
				{
					"id": 30011003,
					"content": "Was denn? Collei gehört doch jetzt zu uns. Das beste Kompliment für einen Koch ist übrigens doch die Begeisterung der Gäste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011004,
					"content": "Heute habe ich den Proviant mitgebracht, den die Waldhüter oft essen, den sogenannten „Taschenfladen“. Ich hoffe, es gefällt euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011005
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011005,
					"content": "Aah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011006
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011006,
					"content": "Oh nein, es ist auf den Boden gefallen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011007,
					"content": "Das ist in Ordnung, ich habe sie in mehrere Lagen Butterbrotpapier eingewickelt. Es sollte nichts schmutzig werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011008
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011008,
					"content": "Puh ... Das hat Paimon fast zu Tode erschreckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011009,
					"content": "Ihr habt den Proviant gemeinsam mit Collei genossen ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30011010
					]
				},
				{
					"id": 30011010,
					"content": "Das war so lecker! Collei, du bist wirklich ein toller Koch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011011,
					"content": "Gut, dass du jedes Stück vorher sorgfältig eingepackt hast, sonst hätte Paimon nachts vor lauter Aufregung nicht schlafen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011012,
					"content": "Haha, übertreib mal nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011013
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011013,
					"content": "Aber da es euch gefällt, schreibe ich das nächste Mal das Rezept für euch ab. Keine Sorge, ich schreibe das Wichtigste zur Zubereitung auf und ihr werdet es im Handumdrehen lernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011014
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011014,
					"content": "Danke, Collei! Hehehe, es ist schwer vorstellbar, dass jemand, der so achtsam ist wie du, manchmal auch so grob fahrlässig sein kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011015,
					"content": "Haha, vielleicht ein bisschen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011016
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011016,
					"content": "Aber ist Tighnari nicht ein bisschen zu streng mit dir? Du darfst gar nichts anfassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011017,
					"content": "#Paimon stößt gelegentlich Dinge auf dem Tisch um, wenn Paimon fliegt, aber {NICKNAME} gibt Paimon nie die Schuld, schließlich ist jeder mal unvorsichtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011018,
					"content": "Nein, so ist es nicht! Hättet ihr etwas mehr Zeit mit meinem Meister verbracht, hättet ihr erkannt, dass er eigentlich ein sehr netter Mensch ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011019
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011019,
					"content": "Ich habe von meinen Vorgängern gehört, dass der Meister von einem sehr alten und geheimnisvollen Volk abstammt. Alle Mitglieder seines Volks sind sehr intelligent und meist ein wenig verschlossen, aber mein Meister ist ein sehr warmherziger Mensch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011020
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011020,
					"content": "Übrigens, kennt ihr die Akademie? Ich glaube, es heißt A... Amu-irgendwas-Institut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011021
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011021,
					"content": "Aufgrund seiner Pflanzenkenntnisse schrieb ihm der Weise dieses Instituts mehrmals und bat ihn, der Akademie beizutreten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011022
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011022,
					"content": "Er lehnte jedoch mit der Begründung ab, dass „der Lärm in Sumeru für seine Ohren zu laut sei“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011023,
						30011026
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011023,
					"content": "Das klingt ganz nach Tighnari ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011024
					]
				},
				{
					"id": 30011024,
					"content": "Haha, ja. Aber wenn der Weise den Brief sieht, wird er sicherlich verärgert sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011025
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011025,
					"content": "Er hätte in die Akademie gehen können, aber stattdessen entschied er sich für den Beruf des Waldhütermeisters, der den Bewohnern des Regenwaldes jeden Tag hilft und seinen Untergebenen alles Mögliche beibringt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011029
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011029,
					"content": "Sogar die Zubereitung von Taschenfladen hat er mir beigebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011030
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011030,
					"content": "Wirklich? Das hatte Paimon überhaupt nicht erwartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011031,
					"content": "Nun ... Aber als Tighnari dich gestern ohnmächtig vorfand, hat er dir ohne jedes Zögern geholfen. Und er war auch derjenige, der dich nach Gandharva zurückgebracht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011032
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011032,
					"content": "Aber Paimon ist immer noch ein bisschen verärgert, weil er den ganzen Weg lang gemeckert hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011033
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011033,
					"content": "Und was hast du angestellt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011034
					]
				},
				{
					"id": 30011034,
					"content": "Ah, das tut mir leid, eigentlich war es mein Meister ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011035
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011035,
					"content": "#Paimon hat nämlich die ganze Zeit geschrien, „Was sollen wir nun tun? Wird {F#sie}{M#er} jetzt sterben?“ Paimon wollte einfach nicht aufhören, da ist mein Meister wütend geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011036
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011036,
					"content": "Och menno, jetzt lach doch nicht! Alles nur, weil Paimon sich um dich gesorgt hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011037
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011037,
					"content": "Puh ... Hahaha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011038
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011038,
					"content": "Was ist hier los? Warum fängt Collei auch noch an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011039
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011039,
					"content": "Aah, Paimon ist so wütend auf euch! Paimon wird sich revanchieren! Paimon wird eure Köpfe aneinander reiben, bis sie wie Vogelnester aussehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011040
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011040,
					"content": "Fass mich nicht an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011041,
						30011042
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011041,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011043
					]
				},
				{
					"id": 30011043,
					"content": "Collei, tut mir leid, das ... das wollte Paimon nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011044
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011044,
					"content": "Ah, ich ... eben ... Nein, so ist es nicht, es ist nur ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011045
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011045,
					"content": "Collei, alles in Ordnung? Geht es dir gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011046
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011046,
					"content": "Ah ... Also, mir geht’s gut, mir geht’s gut ... Tut mir leid, dass ich euch gerade erschreckt habe. Haha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011047
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011047,
					"content": "Oh, es ist schon spät, lasst uns schnell zurück nach Gandharva gehen, der Meister und die anderen sollten auch bereits zurück sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011048
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011048,
					"content": "Was ist gerade passiert? Geht es ihr gut? Sie ist so schnell verschwunden, dass man sie nicht mehr sehen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011042,
					"content": "Collei, was ist los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011043
					]
				},
				{
					"id": 30011026,
					"content": "Ohren ... Seine Ohren lassen sich bestimmt gut streicheln!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011027
					]
				},
				{
					"id": 30011027,
					"content": "Genau! Das dachte ich mir auch ... Ähem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011028
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011028,
					"content": "Kurz gesagt, er ist Waldhütermeister geworden, obwohl er in der Akademie sein könnte, und er verbringt seine Tage damit, den Bewohnern des Regenwaldes zu helfen und seinen Untergebenen alles Mögliche beizubringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011029
					],
					"speakerTitle": "Collei"
				}
			]
		},
