			"dialogs": [
				{
					"id": 30015101,
					"content": "Ich bin nicht sehr gut im Klettern, also überlasse ich die Reinigung der Statue euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30015102
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30015102,
					"content": "Ich werde kurz die Einrichtungen da vorn überprüfen. Wenn ihr fertig seid, können wir dann noch etwas reden?",
					"roleType": "TALK_ROLE_NPC",
