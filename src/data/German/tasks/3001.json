			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010101,
					"content": "Gut, als Nächstes ist die rechte Hand dran ... Es scheint alles in Ordnung zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010102
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010102,
					"content": "Aber immer noch mit Vorsicht genießen, verstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010103
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010103,
					"content": "Ja, ich habe es verstanden. Übrigens, Meister, ich habe die Routenkarte für die heutige Waldpatrouille nicht dabei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010104
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010104,
					"content": "Heute wird es ein langer Weg sein. Am besten kommst du nicht mit, es besteht die Möglichkeit, dass die Dinge auf der Strecke auftauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010105
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010105,
					"content": "Ich habe auch ein Göttliches Auge, aber ich kann nichts tun, um zu helfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010106
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010106,
					"content": "Sag doch so etwas nicht, das ist nichts, worüber du jetzt nachdenken solltest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010107
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010107,
					"content": "Ihr seid da. Geht es euch gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010108
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010108,
					"content": "Gibt es etwas, bei dem du Hilfe benötigst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010109
					]
				},
				{
					"id": 30010109,
					"content": "Ja, wenn wir schon mal hier sind, wollen wir auch ein bisschen was unternehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010110,
					"content": "Seid ihr auch immer so ungeduldig, wenn ihr nichts zu tun habt? Dann lasst euch heute von Collei für einen Rundgang über die Südseite von Gandharva mitnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010111
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010111,
					"content": "Wenn ihr auf eure Ausdauer vertraut, überlasse ich euch gern die Reinigung der Statue der Sieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010112
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010112,
					"content": "Herr Tighnari, wir sind bereit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010113
					],
					"speakerTitle": "Amir"
				},
				{
					"id": 30010113,
					"content": "Ich komm gleich! Wir machen uns zuerst auf den Weg in den Wald. Den Rest lasst ihr euch von Collei erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010114
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010114,
					"content": "Klar, überlass das mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010115
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010115,
					"content": "Collei, was werden wir alle heute tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010116,
					"content": "Gerade hat Tighnari gesagt, dass wir die Statue der Sieben reinigen sollen, aber Paimon hätte nicht gedacht, dass das die Aufgabe eines Waldhüters ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010117,
					"content": "Nun, eigentlich haben Waldhüter eine Vielzahl von Aufgaben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010118
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010118,
					"content": "Die Kontrolle des Zustands der Wege, die Instandhaltung der Forsteinrichtungen, die Beseitigung von Brandgefahren, Hilfe für Reisende und Anwohner ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010119
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010119,
					"content": "Der Meister hat es auch oft mit gefährlichen Gebieten des Regenwaldes zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010120
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010120,
					"content": "Bevor wir die Statue der Sieben erreichen, sollten wir die Straßenbeleuchtung auf dem Weg dorthin überprüfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
		{
			"id": 300105,
			"completionStepIds": [
				300103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300103",
							"2"
						],
						"stepId": 300103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010501,
					"content": "Die Statue der Sieben befindet sich auf dem riesigen Felsen, den ihr gesehen haben solltet, als ihr vorhin von dieser Straße kamt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010502
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010502,
					"content": "Ist das vielleicht ein bisschen zu hoch? Wenn du meinst, dass es etwas mühsam ist, dort hinaufzuklettern, ist es in Ordnung, wenn du sie nicht reinigst. Der Meister wird nichts dagegen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010503,
						30010504
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010503,
					"content": "Das macht nichts, ich bin sehr gut im Klettern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				},
				{
					"id": 30010505,
					"content": "Wirklich? Dann überlasse ich das dir. Es gibt sehr wenig Platz um die Statue herum, also muss man dort oben vorsichtig sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010506
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010506,
					"content": "#{NICKNAME}, Paimon kommt mit hoch. Paimon kann dir helfen, die höher gelegenen Bereiche zu reinigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010507,
					"content": "Übrigens, weißt du, was für ein Gott der Dendro-Archon ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010508,
					"content": "Meinst du die „Höhere Herrin Rukkhadevata“ oder die „Niedere Herrin Kusanali“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010509
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010509,
					"content": "Hä, „Höhere Herrin Rukkhadevata“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010510,
					"content": "Ah, ist das der Name des früheren Dendro-Archons?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010511,
					"content": "Ja. Die „Höhere Herrin Rukkhadevata“ war die erste Göttin der Pflanzen von Sumeru. Sie schuf den Regenwald und baute den Samiel-Wall am Rande der Wüste, damit alle in Frieden leben konnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010512
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010512,
					"content": "Für die Menschen in Sumeru war sie ein Symbol für Weisheit, Güte und Allmacht, aber sie verschwand vor Hunderten von Jahren bei einer Katastrophe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010513,
						30010514
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010513,
					"content": "(So wie bei Raiden Makoto ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010515,
					"content": "Ich hörte von meinem Meister, dass die Weisen später den neuen Dendro-Archon fanden und sie zurück nach Sumeru brachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010516
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010516,
					"content": "Um die Ankunft der Göttin nach diesem Verlust zu feiern, nannten die Weisen sie „Niedere Herrin Kusanali“ und ließen sie im Heiligtum von Surasthana wohnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010517
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010517,
					"content": "Ooh, und was ist dann passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010518,
					"content": "Und dann? Ähm ... ich weiß nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010519
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010519,
					"content": "Hm? Du weißt es auch nicht? Heißt das, du kommst nicht aus Sumeru, Collei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010520,
					"content": "Doch, ich bin aus Sumeru, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010521
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010521,
					"content": "Liegt es daran, dass wir uns fremd sind und es Dinge gibt, über die wir nicht sprechen dürfen? Es ist nicht schlimm, wenn das der Fall ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010522,
					"content": "Nein, nein, ihr habt mich missverstanden, ich verberge nichts. Außerdem seid ihr keine Fremden für mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010523
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010523,
					"content": "Ähm ... Ihr kennt Amber doch auch, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010524
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010524,
					"content": "Warte, redest du von der ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010525,
						30010526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010525,
					"content": "Kundschafterin des Ordo Favonius?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010527,
					"content": "Ja, das ist sie! Ich war eine Zeit lang in Mondstadt und hatte damals viel Hilfe von Amber. Dank ihr bin ich ein anderer Mensch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010528
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010528,
					"content": "Amber ist wirklich klasse! Leidenschaftlich für das Leben, mit einem Sinn für Gerechtigkeit, nicht nur voller Tatendrang, sondern auch sehr verständnisvoll und immer in der Lage, in anderen ein Feuer anzuzünden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010529
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010529,
					"content": "Meiner Meinung nach ist sie als Kundschafterin perfekt. Denn fast jeder, der einen Fuß in Mondstadt setzt, wird ihr zuerst begegnen und sich dann durch ihre Begeisterung in das Land verlieben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010530
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010530,
					"content": "Ah ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010531,
						30010532
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010531,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010533,
					"content": "Nun, Paimon hat zwar das Gefühl, dass das nicht der Zweck eines Kundschafters ist, aber Paimon hat das Gefühl, dass du Amber wirklich magst, Collei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010534,
					"content": "Ähem ... Ah, tut mir leid, ich glaube, das ist falsch rausgekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010535
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010535,
					"content": "Schon gut, Paimon fühlt sich dir viel näher, jetzt, da Paimon weiß, dass du Ambers Freundin bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010536,
					"content": "Aber woher wusstest du, dass wir auch Amber kennen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010537,
					"content": "Nun, seit meiner Rückkehr nach Sumeru habe ich mit Amber postalischen Kontakt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010538
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010538,
					"content": "#In ihren Briefen erzählte sie vom Angriff eines Drachen auf die Mondstadt und berichtete, dass {F#eine blonde Reisende und ihre}{M#ein blonder Reisender und seine} schwebende Begleiterin geholfen hätten, die Krise zu entschärfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010539
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010539,
					"content": "Als ich euch gestern sah, habe ich euch sofort erkannt. Aber da du gerade erst aufgewacht warst, fand ich es unangemessen, es zu erwähnen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010540
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010540,
					"content": "Jetzt wird Paimon alles klar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010541,
					"content": "Nun, dann macht euch keine Sorgen! Ich vertraue euch auf jeden Fall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010542
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010542,
					"content": "Ich würde euch gern mehr über den Dendro-Archon erzählen, aber ich habe schon lange nicht mehr in Sumeru gelebt und nicht viel gelesen ... Tut mir leid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010543
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010543,
					"content": "Es ist in Ordnung. Die Informationen, die du uns gerade mitgeteilt hast, waren auch sehr wertvoll. Schließlich hatten wir zuvor noch nicht einmal von der „Höheren Herrin Rukkhadevata“ oder dem „Heiligtum von Surasthana“ gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010544
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010544,
					"content": "Es ist gut, helfen zu können. Aber warum fragt ihr nach der Göttin der Pflanzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010545
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010545,
					"content": "Ihr erklärt Collei kurz den Zweck eurer Reise ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30010546
					]
				},
				{
					"id": 30010546,
					"content": "Ich verstehe. Danke, dass ihr bereit wart, mir das zu erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010547
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010547,
					"content": "Gern geschehen, wir sind ja schließlich Freunde, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010548
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010548,
					"content": "Paimon hat recht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010549
					]
				},
				{
					"id": 30010549,
					"content": "Dann lass uns jetzt hinaufgehen und die Statue reinigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010550
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010550,
					"content": "Danke. In der Zwischenzeit überprüfe ich das Regendach dort drüben und wir treffen uns später hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010532,
					"content": "So bist du also, Collei ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010526,
					"content": "Flugbegeisterte aus Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010514,
					"content": "(Zu jener Zeit in Khaenri’ah ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010504,
					"content": "Das ist doch ein Kinderspiel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				}
			]
		},
