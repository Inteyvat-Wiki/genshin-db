						30010802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010802,
					"content": "Ihr müsst vom vielen Klettern müde sein. Wir sollten uns hier eine Weile ausruhen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010803
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010803,
					"content": "Collei, hast du hier ein kleines, pflanzenähnliches Wesen gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010804,
					"content": "Ein pflanzenähnliches Wesen? Nun ... Der Meister würde sagen: „Pflanzen sind auch Lebewesen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010805
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010805,
					"content": "Ihr erzählt Collei, was ihr gerade gesehen habt ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30010806
					]
				},
				{
					"id": 30010806,
					"content": "Oh, das ist erstaunlich, es klingt wie ein Fantasiewesen, über das Kinder oft sprechen. Ich werde mich das nächste Mal für dich erkundigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010807
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010807,
					"content": "Ach, seid ihr hungrig? Ich habe Wasser und Essen mitgebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
