			"dialogs": [
				{
					"id": 710210101,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210102,
						710210106
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210102,
					"content": "Nimm einen Windgleiter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710210103
					]
				},
				{
					"id": 710210103,
					"content": "Vergiss es. Seit ich der Akademie von Sumeru beigetreten bin, hab ich keine Kontakt zur Außenwelt. Ich war kein einziges Mal draußen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210104
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210104,
					"content": "Außerdem braucht man im Normalfall keinen Windgleiter in der Akademie. Meine Gleitkenntnisse sollten mittlerweile gegen Null streben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210105
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210105,
					"content": "Wenn ich versuchen würde, mit dem Windgleiter hinüberzufliegen, wäre ich nach der Hälfte schon im Wasser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210106,
					"content": "Miete dir ein Boot.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710210107
					]
				},
				{
					"id": 710210107,
					"content": "Das habe ich mir auch überlegt. Ich weiß noch, dass man in Dornmannshaven Boote welche ausleihen kann. Das wäre aber ziemlich weit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210108
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210108,
					"content": "Wer weiß, wie viel Zeit ich bei dem ganzen Hin und Her vertrödeln würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210109
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210109,
					"content": "Mein eigenes Boot kann ich mir natürlich auch schlecht bauen. In der Akademie lernt man dazu nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
		}
	]
}