			"dialogs": [
				{
					"id": 761970120,
					"content": "(test) Gesprochene Inhalte",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						761970101
					]
				},
				{
					"id": 761970101,
					"content": "Als ich damals auf dem Meer trieb, hörte ich einen Ruf, der aus dem Nichts zu kommen schien. Die anderen beachteten ihn nicht, aber ich war sofort in seinen Bann gezogen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970102
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970102,
					"content": "Das war bestimmt eine Stimme aus einer anderen Welt. Ich habe sie auch schon gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970103
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970103,
					"content": "Später wurde mir klar, dass dieser Ruf all die Träume enthielt, die das andere Ufer nicht erreichen konnten ... man könnte sagen, es ist eine Ansammlung von Groll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970104
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970104,
					"content": "Du hättest den Frostsprudelstein mitnehmen sollen. Wenn du durch das Loch in der Mitte schaust, kannst du sehen, wer dich gerufen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970105
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970105,
					"content": "Aber damals war ich noch ein junger Hitzkopf. Gefahr war für mich nur eine Chance, also stürzte ich mich einfach kopfüber hinein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970106
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970106,
					"content": "Ich habe gehört, dass die Löcher in der Mitte des Frostsprudelsteins das Tor zu einer anderen Welt sind ... Aber wie kommt man da durch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970107
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970107,
					"content": "Und danach ... haben Wind und Wellen des Ozeans mir meinen Reichtum, meine Ehre und meine Familie genommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970108
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970108,
					"content": "Abenteuer, die von Ehrgeiz und Verlangen getrieben werden, finden niemals ein gutes Ende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970109
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970109,
					"content": "Ah, ich steck fest ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970110
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970110,
					"content": "Lass mich dir dabei helfen. Mach das beim nächsten Mal aber bitte nicht wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970111,
					"content": "Linnea, wie kommt es, dass du Zeit hast, zurückzukommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970112
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970112,
					"content": "Ich bin hier in der Nähe, um Frostsprudelsteine zu sammeln. Ich habe gesehen, dass ihr euch unterhaltet, und wollte kurz Hallo sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970113
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970113,
					"content": "Ach ja. Wenn es Linnea ist, kann man mit dem Frostsprudelstein vielleicht wirklich ein Tor in eine andere Welt öffnen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970114
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970114,
					"content": "Selbst ich kann das nicht. Habe ich dir das nicht schon gesagt? Das ist nur eine weit hergeholte Legende, für die es keinerlei verlässliche Beweise gibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970115
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970115,
					"content": "Das wird also nichts?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970116
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970116,
					"content": "Warte, du hast zugehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970117
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970117,
					"content": "Ähm ... Nein, ich bin einfach nicht mehr der, der ich mal war. Ich bin zufrieden mit dem, was ich habe, und will nichts weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970118
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970118,
					"content": "Das ist echt schade. Dann helfe ich Linnea auch beim Sammeln der Frostsprudelsteine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970119
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970119,
					"content": "Super, dann danke ich dir für deine Mühe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970124
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970124,
					"content": "Mit Aunis Hilfe ist alles schnell gesammelt ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761970122
					]
				},
				{
					"id": 761970122,
					"content": "Danke dir, aber ich habe schon alles gesammelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970123
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970123,
					"content": "Na gut. Dann gehe ich ins Moley-Tal, um Opa Moley und die anderen zu suchen. Tschüss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				}
			]
		},
