			"dialogs": [
				{
					"id": 730570401,
					"content": "Das ist das Instrument des Nara, Aranakin hat es wohl verwahrt. Aber es kann nicht mehr singen ... Die Saiten sind verstimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570402
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570402,
					"content": "(Eine altmodische Oud, die mit mehreren Narben versehen ist, trotzdem sorgfältig repariert und gepflegt wurde.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
