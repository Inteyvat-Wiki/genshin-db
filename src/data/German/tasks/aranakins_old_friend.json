				{
					"id": 730570602,
					"content": "Diese Blätter verwenden die Nara, um Erinnerungen aufzubewahren. Nara schreiben auf den Blättern und setzen sie zusammen. Aber Aranakin kann die Worte der Nara nicht verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570606
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570606,
					"content": "Meinst du ein ... „Notizbuch“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570603,
					"content": "Ein „Notizbuch“ ... Das ist es, womit die Nara ihre Erinnerungen aufbewahren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570604
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570604,
					"content": "Oh, das stimmt ... Aranakin, macht es dir etwas aus, wenn wir nach oben gehen und das Notizbuch lesen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570605,
					"content": "Mir? Keinesfalls!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				}
			]
		},
		{
			"id": 7305707,
			"completionStepIds": [
				7305706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305706",
							"2"
						],
						"stepId": 7305706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aranakin",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570701,
					"content": "Was für Erinnerungen stehen in ihm? Was seht ihr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570702
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570702,
					"content": "Der Besitzer des Notizbuchs scheint dich zu kennen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570703
					]
				},
				{
					"id": 730570703,
					"content": "Ist das so ... Ich kann mich nicht erinnern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570704
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570704,
					"content": "Er sagt ... Er kann dich nicht mehr sehen. Weil er erwachsen geworden ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570705,
					"content": "Ooh ... Das Erwachsenwerden bringt viel Ärger mit sich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570706,
					"content": "Ach ja, er schreibt im Notizbuch ... dass diese Blume für dich ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570707,
					"content": "Hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570708
					]
				},
				{
					"id": 730570708,
					"content": "Wie ... Ah! Das ist eine wichtige Blume! Was macht sie bei dir ... bei ihm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570709
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570709,
					"content": "Eigentlich hast du uns eine gleiche Blume gegeben ... Du erinnerst dich nur nicht mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570710,
					"content": "Wenn das so ist ... können wir wieder Freunde sein. Aber ... was ihn angeht, ich kann mich nicht mehr an sein Gesicht erinnern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570711
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570711,
					"content": "Schon gut, schon gut ... Du musst nicht traurig sein. Wir haben die Blume, sie bringt dir bestimmt mehr Erinnerungen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570712,
					"content": "Ja, weißes Fliegerchen hat recht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570713
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570713,
					"content": "Ich bringe die Blume zurück. „Mawtiyima“ sollte wissen, wie man sie erweckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570714
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570714,
					"content": "#Oh, ähm ... Nara {NICKNAME} und weißes Fliegerchen, ich gehe zurück zu Aranaga und werde sie einpflanzen und ihren Liedern zuhören. Falls ihr Zeit habt, kommt vorbei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570715
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570715,
					"content": "Ja, bestimmt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7305708,
			"completionStepIds": [],
