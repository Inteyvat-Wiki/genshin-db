			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570101,
					"content": "Hm, verschwunden ... Er erinnert sich nicht mehr an unser Abenteuer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570102,
						730570103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570102,
					"content": "Sei nicht traurig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570104
					]
				},
				{
					"id": 730570104,
					"content": "Ja, du hast recht ... Ja, stimmt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570105,
					"content": "Beim letzten Mal hat uns Aranakin doch ein Lied beigebracht! Vielleicht erinnert er sich wieder, wenn wir es ihm vorspielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570106,
						730570108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570106,
					"content": "Du hast völlig Recht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570107
					]
				},
				{
					"id": 730570107,
					"content": "Hehe, schließlich ist Paimon die Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570108,
					"content": "Ein selten sinnvoller Vorschlag ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570109
					]
				},
				{
					"id": 730570109,
					"content": "Du bist so gemein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570103,
					"content": "Wir können wieder Freunde sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570110
					]
				}
			]
		},
		{
			"id": 7305702,
			"completionStepIds": [
				7305707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305707",
							"2"
						],
						"stepId": 7305707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Aranakin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570201,
					"content": "Haha, er kommt! Hallo, kleines Ding!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570202,
					"content": "Aranakin ist kein kleines Ding! Du fliegendes, weißes Ding bist klein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570203
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570203,
					"content": "... Übrigens, goldener „Sand“ ... Nara, woher kennt ihr dieses Lied?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570204
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570204,
					"content": "Also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570205,
						730570207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570205,
					"content": "Du hast es uns beigebracht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570206
					]
				},
				{
					"id": 730570206,
					"content": "Genau! Du hast uns das Lied auf unserem letzten Abenteuer beigebracht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570209,
					"content": "So ... ist das? Hmpf, Aranakin ist nicht besonders hell, aber ihr wirkt nicht wie „Sand“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570210
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570210,
					"content": "Genau! Der „Sand“ ist „Valuka“, der böse Nara! Und wir sind gute Nara! Das hast du uns gesagt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570211,
					"content": "Äh! Ich habe euch sogar das gesagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570212
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570212,
					"content": "#Haha, richtig! {NICKNAME}, erzählen wir ihm von unseren früheren Erlebnissen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570213,
					"content": "Ihr beschreibt Aranakin euer Abenteuer und wie ihr die „Verwelkung“ befriedet habt.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730570214
					]
				},
				{
					"id": 730570214,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570215
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570215,
					"content": "Aranakin ist nicht besonders hell, aber ihr solltet die Wahrheit sprechen. Aber Aranakin erinnert sich nicht mehr, es tut mir leid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570216
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570216,
					"content": "Das muss dir nicht leidtun! Dinge zu vergessen, ist das Natürlichste der Welt ... Außerdem, können wir wieder neue Freunde sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570217,
						730570218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570217,
					"content": "Aranakin ist ein gutes Kind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570220
					]
				},
				{
					"id": 730570220,
					"content": "Ähm ... Da wir alle gute Freunde sind, folgt mir bitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570221
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570221,
					"content": "Hä? Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570222,
					"content": "Goldener Nara, weißes Fliegerchen! Folgt mir zu meinem Haus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570218,
					"content": "Paimon ist ein gutes Kind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570219
					]
				},
				{
					"id": 730570219,
					"content": "Hehe, das kannst du laut sagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570207,
					"content": "Ich habe das Lied gespielt, um dich zu sehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570208
					]
				},
				{
					"id": 730570208,
					"content": "#Hehe, hat {NICKNAME} gut gespielt? Wir erinnern uns immer noch an dein Lied!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570209
					],
					"speakerTitle": "Paimon"
				}
			]
		},
