			"dialogs": [
				{
					"id": 730570801,
					"content": "Lasst es mich wissen, wenn ihr etwas interessantes entdeckt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				}
			]
		},
		{
			"id": 7305709,
			"completionStepIds": [
				7305705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305705",
							"2"
						],
						"stepId": 7305705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570901,
					"content": "„... Ich habe die Oud, die Onkel Bakr fallen gelassen hat, wieder repariert. Also kein Grund mehr, hier so ganz alleine zu weinen, ja? Wenn du traurig bist, dann unterhalte dich doch mit mir und Khayyam ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570902
					],
					"speakerTitle": "Uraltes Notizbuch"
				},
				{
					"id": 730570902,
					"content": "„... Ich wurde in die Akademie aufgenommen. Glückwunsch an mich selbst! Ich will nicht ‚Braut eines Soldaten‘ sein, stattdessen will ich zur ‚Großen Weisen Siman‘ werden!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570903
					],
					"speakerTitle": "Uraltes Notizbuch"
				},
				{
					"id": 730570903,
					"content": "„... Hehe, der ‚große Musiker‘ Irfan und der überschlaue Khayyam! Vergesst mich nicht, wenn wir uns trennen. Insbesondere du, Khayyam, vergiss mich nicht!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570904
					],
					"speakerTitle": "Uraltes Notizbuch"
				},
				{
					"id": 730570904,
					"content": "„... Auf bald, Notizbuch! Auf bald Irfan und Siman, meine besten Freunde! Ich hoffe, der Wald wird unsere Geschichte nie vergessen, und ich hoffe, wir werden einander nie vergessen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570905
					],
					"speakerTitle": "Uraltes Notizbuch"
				},
				{
					"id": 730570905,
					"content": "(... Der Rest besteht aus den bunt durcheinandergewürfelten freudigen und traurigen Erinnerungen der Kinder ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570906
					],
					"speakerTitle": "Uraltes Notizbuch"
				},
				{
					"id": 730570906,
					"content": "„... Aranakin ist verschwunden. Ich weiß nicht seit wann, doch er ist fort. Auch für mich wird es Zeit, mich von der Oud zu verabschieden. Ich sollte Handwerker werden, wie Vater es sich erhofft hat ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570907
					],
					"speakerTitle": "Uraltes Notizbuch"
				},
				{
					"id": 730570907,
					"content": "(Hier scheint noch mehr aufgeschrieben worden zu sein, doch es wurde mit schwarzer Tinte durchgestrichen.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570908
					],
					"speakerTitle": "Uraltes Notizbuch"
				},
				{
					"id": 730570908,
					"content": "„... An mein zukünftiges Ich, das in vielen Jahren dieses Notizbuch lesen wird: Solltest du Aranakin und die anderen auf wundersame Weise ein weiteres Mal treffen, dann schenk ihm bitte diese Blume zurück ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570909
					],
					"speakerTitle": "Uraltes Notizbuch"
				},
				{
					"id": 730570909,
					"content": "Hä? Da scheint etwas aus dem Buch gefallen zu sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570910,
					"content": "Es scheint eine ... Blume zu sein? Sie sieht genauso aus wie die, die wir erhalten haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
