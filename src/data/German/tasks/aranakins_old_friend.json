			},
			"dialogs": [
				{
					"id": 730570501,
					"content": "Das ist ... Ähm, wie heißt das? Aranakin muss nicht darauf schlafen, deshalb kennt er den Namen nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570502
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570502,
					"content": "Das ist ein „Bett“. Wirkt sehr neu ... Hat hier jemand geschlafen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570503,
					"content": "Hehe, Aranakin putzt es ständig ... Ihr könnt hier schlafen, wenn ihr möchtet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				}
			]
		},
