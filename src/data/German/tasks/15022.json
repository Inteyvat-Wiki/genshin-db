			"dialogs": [
				{
					"id": 150221301,
					"content": "Uff ... Puh ... Paimon ist noch nie so schnell geflogen ... Gleich dreht sich der Magen um ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150221302,
					"content": "Immerhin sind wir heil angekommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150221303
					]
				},
				{
					"id": 150221303,
					"content": "Aha ... Genau, wie ich dachte. Von außen sieht es vielleicht wie ein normaler Heißluftballon aus, aber aus der Nähe erkennt man, dass er stark umgebaut wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221304
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221304,
					"content": "Und wie vermutet, ist er nur unter die Wolkendecke gesunken, weil die maßgefertigte Mechanik ausgefallen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221305
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221305,
					"content": "Weißt du, wo der Fehler liegt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150221306
					]
				},
				{
					"id": 150221306,
					"content": "Ich sollte es mit Tepals Notizbuch herausfinden können. Zum Glück kenne ich mich mit dem Getüftel aus, weil ich meine Gewehre immer selbst repariere, wenn sie mal streiken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221307
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221307,
					"content": "Mhm ... Das sollte reichen. Jetzt fehlt nur noch ein kräftiger Tritt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221308
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221308,
					"content": "Äh ... Das funktioniert vielleicht bei deinen Gewehren, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150221309,
					"content": "Hä!? Wir bewegen uns wirklich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
