				"points": []
			},
			"dialogs": [
				{
					"id": 150221001,
					"content": "Wir werden alles tun, um den Konflikt im Stamm in den Griff zu bekommen, während ihr weg seid. Hoffentlich verschafft euch das etwas Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221002
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150221002,
					"content": "Häuptling, wir sollten einen Plan zur Verteidigung aufstellen ... nur für den Fall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allpa"
				}
			]
		},
		{
