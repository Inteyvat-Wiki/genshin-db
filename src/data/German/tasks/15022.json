					"content": "Schluss mit den Qucusauriern! Wir wollen Phlogiston-Flügel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220802
					],
					"speakerTitle": "Huascar"
				},
				{
					"id": 150220802,
					"content": "Seid ihr wahnsinnig? Die Qucusaurier sind unsere Partner!",
					"roleType": "TALK_ROLE_NPC",
