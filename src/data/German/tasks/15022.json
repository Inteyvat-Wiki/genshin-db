						150220703
					]
				},
				{
					"id": 150220703,
					"content": "Sie gibt nicht auf ... und scheint sich beruhigt zu haben. Ich schaue später nochmal nach ihr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220704
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220704,
					"content": "Ich glaube, dass sie dir das Notizbuch gegeben hat, hat ihr geholfen, einige Dinge endlich loszulassen. Vielleicht ist es letztlich besser so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				}
			]
		},
