				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xilonen"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1350.876,
							161.634,
							7851.647
						],
						"pointId": 350400213
					}
				]
			},
			"dialogs": [
				{
					"id": 150220101,
					"content": "Allpa sagt also, dass Tepal von den Kindern der Echos stammt. Aber wie finden wir ihn? Einfach ... herumfragen, bis wir ihn haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220102,
					"content": "Wir fangen am besten mit jemandem an, den wir kennen. Das geht schneller. Ich wette, um diese Zeit und an diesem Ort wäre das wohl ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220103
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220103,
					"content": "Aufwachen, Xilonen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220104
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220104,
					"content": "*gähn* Ah, ihr seid es ... Uaah ... Wartet einen Moment, ich komme runter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220105
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220105,
					"content": "*gähn*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220106
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220106,
					"content": "Sieht so aus, als würdet ihr beide gern auf Bäume klettern ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220107
					]
				},
				{
					"id": 150220107,
					"content": "Ich klettere auf Bäume, um weiter fliegen und in die Ferne sehen zu können. Nickerchen mache ich dabei eher selten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220108
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220108,
					"content": "Na ja, nicht jeder von uns hat so viel Energie wie du ... Selbst nach einem ganzen Tag Fliegen ... Ihr seid also extra hergekommen und habt meinen kostbaren Schönheitsschlaf unterbrochen. Darf ich fragen, warum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220109
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220109,
					"content": "Tut mir leid, Xilonen, aber das konnte nicht warten. Sagt dir der Name „Tepal“ etwas? Er soll ein Handwerker sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220110
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220110,
					"content": "Tepal? Ja, das sagt mir was ... Ich glaube, das ist Pumas Sohn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220111
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220111,
					"content": "Ist er gerade im Stamm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220112
					]
				},
				{
					"id": 150220112,
					"content": "Nee, ich fürchte, da seid ihr ein paar Jahre zu spät ... Warum sucht ihr ihn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220113
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220113,
					"content": "Das ist eine lange Geschichte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220114
					]
				},
				{
					"id": 150220114,
					"content": "Ihr versucht, kurz und knapp zu erklären, was passiert ist ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220115
					]
				},
				{
					"id": 150220115,
					"content": "„Phlogiston-Flügel“? Boah, nicht schlecht. Der Junge hat’s wirklich gewuppt ... Na gut, sieht aus, als wird das heute nichts mehr mit meiner Pause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220116
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220116,
					"content": "Gewuppt? Du meinst, er hat sowas schon mal versucht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220117,
					"content": "Ja, er hat gleich nach seiner Rückkehr vom Blumenfeder-Klan angefangen, an einer Flugmaschine zu tüfteln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220118
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220118,
					"content": "Also direkt nachdem er flügellos wurde ... Hat diese Flugmaschine irgendwas mit der Waffe zu tun, die du für mich gebaut hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220119
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220119,
					"content": "Du meinst deine Waffe, die schwerer zu bändigen ist als der stolzeste Qucusaurier? Nein, er wollte etwas erschaffen, das es jedem erlaubt, frei zu fliegen, auch ohne besonderes Talent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220120
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220120,
					"content": "Weit ist er damals allerdings nicht gekommen. Er hat seine Werkstatt ein paarmal in die Luft gesprengt und überlebte nur knapp. Danach habe ich seine Fortschritte nicht weiterverfolgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220121
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220121,
					"content": "Seine Eltern sind in ihrer Jugend viel gereist und kehrten erst nach seiner Geburt zum Stamm zurück. Aber sie leben sehr abgeschieden und haben kaum Kontakt zu anderen Leuten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220122
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220122,
					"content": "Das heißt, die meisten im Stamm kennen sie kaum ... Ihr solltet wohl am besten direkt mit seiner Familie sprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220123
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220123,
					"content": "Ich gehe Puma holen. Wartet vor meiner Werkstatt auf mich, es dauert nicht lange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				}
			]
		},
		{
			"id": 1502202,
			"completionStepIds": [
				1502202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
