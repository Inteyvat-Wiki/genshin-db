			},
			"dialogs": [
				{
					"id": 150220301,
					"content": "Chasca, endlich bist du zurück! Die Stimmung im Stamm ist ziemlich angespannt. Bist du bei deiner Untersuchung weitergekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220302
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220302,
					"content": "Einige Leute glauben sogar, dass wir die Händler nur verhaftet haben, um die Flugstaffel zu stärken und gegen die Phlogiston-Flügel vorzugehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220303,
						150220304
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220303,
					"content": "Wenn die Lage sich weiter zuspitzt, obwohl wir die Händler geschnappt haben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				},
				{
					"id": 150220305,
					"content": "Wir haben ein paar gute Hinweise, aber es gibt da ein großes Hindernis zwischen uns und den belastbaren Beweisen, die wir brauchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220306
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220306,
					"content": "Chasca erklärt, was ihr über Tepal herausgefunden habt, und eure Theorie zu der Werkstatt in den Lüften ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220307
					]
				},
				{
					"id": 150220307,
					"content": "Ein Relikt aus der aschenen Stadt? Puh ... also schafft es Och-Kan, selbst nach all den Jahren noch Zwietracht zu säen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220308
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220308,
					"content": "Eine fliegende Werkstatt ... und ein Ballon über der Arena ... Und da wollt ihr jetzt hin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220309
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220309,
					"content": "Irgendwelche Ideen, wie wir da hochkommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220310
					]
				},
				{
					"id": 150220310,
					"content": "Weder die Phlogiston-Flügel noch ein Qucusaurier schaffen es so hoch. Glaubt ihr wirklich, dass Tepal sich dort oben versteckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220311
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220311,
					"content": "Hm ... Ich glaube ... da gibt es vielleicht doch einen Weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220312
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220312,
					"content": "Wirklich!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220313,
					"content": "Erinnert ihr euch noch an die Öffnungen in der Arena? Als sie alle blockiert waren, konnte das gasförmige Phlogiston nicht mehr fließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220314
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220314,
					"content": "Aber jetzt strömt es wieder. Doch wenn wir sie nochmal blockieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220315
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220315,
					"content": "Du meinst ... Alle außer der obersten Öffnung in der Arena? Damit sich dort der Druck aufbaut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220316
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220316,
					"content": "Genau. Wenn alles gasförmige Phlogiston durch eine Öffnung flösse, würde ein starker Luftstrom entstehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220317
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220317,
					"content": "Und von dem lassen wir uns dann in den Himmel tragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220318,
					"content": "Genau. Es ist riskant, aber mit Chascas Fähigkeiten sollte das machbar sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220319
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220319,
					"content": "Es ist ein sehr gewagter Plan ... aber ich stimme zu, dass es möglich ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220320
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220320,
					"content": "Wenn du es probieren willst, rede mit Inkanak auf dem Prüfungsplatz. Sie kann dir erklären, wie man die Öffnungen blockiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220321
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220321,
					"content": "Chasca ... Wenn jemand in der Lage ist, diesen Beweis aus dem Himmel zu holen, dann bist du es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220304,
					"content": "Gibt es vielleicht da draußen noch andere, die das Feuer weiter schüren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				}
			]
		},
