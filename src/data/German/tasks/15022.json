						],
						"pointId": 350800005
					}
				]
			},
			"dialogs": [
				{
					"id": 150221101,
					"content": "Ihr eilt zur Prüfungsarena und erklärt Inkanak die Situation ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150221102
					]
				},
				{
					"id": 150221102,
					"content": "Holla ... Das ist echt eine gewagte Idee ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221103
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221103,
					"content": "Mag sein, aber wir müssen schnell handeln. Wie können wir die Öffnungen am schnellsten blockieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221104
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221104,
					"content": "Aus technischer Sicht würde ich sagen, dass wir zuerst alles messen und genau planen sollten ... Aber ich nehme an, das ist nicht, was du hören willst, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221105
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221105,
					"content": "Richtig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150221106
					]
				},
				{
					"id": 150221106,
					"content": "... Dann müssen wir eben den Holzfäller-Ansatz nehmen. Seht ihr das feste Phlogiston da drüben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221107
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221107,
					"content": "Frühere Untersuchungen haben gezeigt, dass sich darin eine stabile Struktur gebildet hat, die es sehr widerstandsfähig gegen Beschädigungen macht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221108
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221108,
					"content": "Es hat zwar seine Schwachstellen, aber solange die nicht alle gleichzeitig getroffen werden, bleibt die Struktur stabil ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221109
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221109,
					"content": "Was passiert denn, wenn wir alle Schwachstellen gleichzeitig treffen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150221110,
					"content": "Es wird zusammenbrechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221111
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221111,
					"content": "... Gut, ich verstehe, worauf du hinauswillst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221112
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221112,
					"content": "Richtig, du sagst es! Man muss nur alle Schwachstellen gleichzeitig aus dem richtigen Winkel treffen und schon wird das Phlogiston genau auf die Öffnung fallen und sie blockieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221113
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221113,
					"content": "Du hast recht mit der „Holzfäller-Methode“. Genau mein Ding.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				}
			]
		},
