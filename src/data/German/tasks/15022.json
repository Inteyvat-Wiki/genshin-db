						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Puma",
					"Xilonen"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1374.526,
							169.17,
							7678.847
						],
						"pointId": 350400214
					}
				]
			},
			"dialogs": [
				{
					"id": 150220201,
					"content": "Kurz darauf in Xilonens Werkstatt ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220202
					]
				},
				{
					"id": 150220202,
					"content": "Ich bin wieder da. Darf ich vorstellen: Tepals Mutter Puma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220203
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220203,
					"content": "Hallo! Wir sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220204,
					"content": "Sparen wir uns die Höflichkeiten. Ich habe keine Lust, länger über diesen Jungen zu sprechen als nötig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220205
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220205,
					"content": "... Hä?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220206,
					"content": "Ich habe ihn schon vor langer Zeit verstoßen ... Er ist nicht mehr mein Kind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220207
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220207,
					"content": "Alles, was ihn je interessiert hat, war sein Traum vom Fliegen ... Wir haben versucht, ihn zur Vernunft zu bringen, aber er war völlig besessen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220208
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220208,
					"content": "Hmpf ... Als er uns dann verließ, faselte er davon, eine Werkstatt im Himmel zu bauen, um dem ständigen Gerede von uns „Bodenbewohnern“ zu entkommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220209
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220209,
					"content": "Er hat dieses Notizbuch dagelassen. Was auch immer ihr wissen wollt, sucht es da drin ... Ich bin durch mit diesem Thema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220210
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220210,
					"content": "Er ist nicht mein Sohn ... Er hat mich sowieso nie „Mama“ genannt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220211
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220212
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220212,
					"content": "Wah, die haben sich ja wirklich zerstritten ... Das hätte Paimon nicht gedacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220213,
					"content": "Ihr Ehemann, Tepals Vater ... er ist kürzlich gestorben und Tepal hat sich nicht mal auf der Beerdigung blicken lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220214
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220214,
					"content": "Wenn ihr mich fragt, war das das Schüppchen obendrauf, das für Puma noch gefehlt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220215
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220215,
					"content": "Ich bleibe bei ihr. Wenn ihr noch etwas braucht, kommt einfach zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220216
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220216,
					"content": "Danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220217
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220217,
					"content": "Aha, also ist dieses Notizbuch jetzt unser einziger Anhaltspunkt, oder? Was steht denn drin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220218,
					"content": "Hm ... ein paar frühe Entwürfe der Phlogiston-Flügel ... und Theorien über eine „fliegende Werkstatt“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220219
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220219,
					"content": "Ochkanatlan, die aschene Stadt ... Sieht aus, als hätte er sich seine technischen Inspirationen von dort geholt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220220
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220220,
					"content": "Also meinte er es ernst mit der Werkstatt im Himmel? Aber das ist doch ein riesiges Projekt für eine einzelne Person ... Meinst du, er hat es tatsächlich geschafft?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220221,
						150220222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220221,
					"content": "Hm, schau dir mal diese Zeichnung von einem Ballon an ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				},
				{
					"id": 150220223,
					"content": "... Oh! Ja! Der Ballon, der ganz oben über der Prüfungsarena hing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220224,
					"content": "Dieser Ballon hängt da schon eine Weile und jeder fragt sich, wie er dahin gekommen ist. Aber ... was, wenn das die falsche Frage ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220225
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220225,
					"content": "Was, wenn er ursprünglich viel höher schwebte, über den Wolken und außer Sicht, und nur wegen einer Fehlfunktion auf die aktuelle Höhe heruntergekommen ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220226
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220226,
					"content": "Anders gesagt, er könnte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220227
					]
				},
				{
					"id": 150220227,
					"content": "... zu Tepals Werkstatt gehören?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220228,
					"content": "Das klingt plausibel. Wenn Tepals Basis die ganze Zeit über den Wolken versteckt war, könnte das definitiv erklären, warum Isidore sie nicht finden konnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220229
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220229,
					"content": "Paimon hat das sowas von vorhergesehen ... Aber, ähm, wie kommen wir da jetzt hin? Chasca, kannst du überhaupt so hoch fliegen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220230,
					"content": "Alleine ... vielleicht. Aber mit einem Passagier, unmöglich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220231
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220231,
					"content": "Selbst die Phlogiston-Flügel könnten dich nicht so weit hochtragen ... zumindest nicht ohne dieses „Relikt“, das Tepal in seinem Notizbuch erwähnt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220232
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220232,
					"content": "Ja, und das hat er wahrscheinlich bei sich ... Wir müssen einen anderen Weg finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220233,
					"content": "Kannst du so hoch fliegen, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220234
					]
				},
				{
					"id": 150220234,
					"content": "Nö, das ist vieeel höher, als Paimon fliegen kann! Und du glaubst doch nicht ernsthaft, dass Paimon da hochfliegt und sich Tepal ganz alleine stellt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220235,
					"content": "Macht euch keine Sorgen. Nur weil wir keine Lösung haben, heißt das nicht, dass niemand eine findet. Ich bin schließlich nicht die einzige Flugexpertin in meinem Stamm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220236
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220236,
					"content": "Gute Idee. Lass uns die Älteste Allpa fragen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220237,
					"content": "Und Mutota. Der war früher auch ein richtiger Profi der Luftfahrt. Gehen wir zurück und schauen, was sie vorschlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220222,
					"content": "Haben wir das nicht schon mal irgendwo gesehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				}
			]
		},
