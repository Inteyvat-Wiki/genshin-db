				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4820202,
					"content": "Durchgelesen schon, aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820203,
					"content": "Diese Regeln kann man sich einfach nicht merken ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820201,
					"content": "Ah, du bist hier. Hast du den Ratgeber auch durchgelesen und dich mit den Regeln vertraut gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820202,
						4820203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820204,
					"content": "Ach, diesen Ton kenne ich. Ich weiß, wie du dich fühlst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820205
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820205,
					"content": "Der Flugratgeber ist total trocken und langweilig. Ich habe mich nur durchgequält. Aber erzähl Jean nicht davon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820206
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820206,
					"content": "Wirklich? Also ich finde, dass die Geschichte in diesem Ratgeber ziemlich interessant ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820207,
					"content": "Geschichte? Hm, wahrscheinlich meinst du den Anhang am Ende des Ratgebers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820208
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820208,
					"content": "Einige sind ganz lustig. Am meisten mag ich die, in der jemand illegal mit einem Anemo-Schleim geflogen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820209
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820209,
					"content": "Anscheinend kann man richtig hoch abheben, wenn man den Luftstrom nutzt, der entsteht, wenn ein Anemo-Schleim explodiert. Das würde ich echt gern selbst ausprobieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820210
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820210,
					"content": "Was? Also ich finde die Geschichte süß, bei der ein kleiner Vogel lernt zu fliegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820211,
					"content": "Hm ... was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820212
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820212,
					"content": "Lass mal sehen ... Ah! Das ist doch das Fabelbuch, das ich als Kind so gern gelesen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820213
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820213,
					"content": "Entschuldigt bitte! Ich hatte das Buch gestern mit dem Ratgeber zusammen in einer Tasche. Da muss ich das falsche Buch erwischt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820214
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820214,
					"content": "Wie kann man diese beiden Bücher denn vertauschen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820215,
					"content": "Ach, ist mir das peinlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820216
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820216,
					"content": "Aber vielleicht habe ich euch das Fabelbuch gegeben, weil mein Innerstes weiß, dass ich damit fliegen gelernt habe und nicht mit dem Ratgeber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820217
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820217,
					"content": "„Was euch fehlte, war nicht der Wind, sondern der Mut. Er war es, der euch erlaubte, in die Lüfte zu steigen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820218
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820218,
					"content": "Diese Worte haben mir den Mut gegeben, eine Kundschafterin und letztendlich Flugmeisterin von Mondstadt zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820219
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820219,
					"content": "Na gut, lassen wir das Thema. Beginnen wir lieber mit der Prüfung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820220
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820220,
					"content": "Du brauchst nicht aufgeregt zu sein. Flieg einfach so wie sonst auch, dann wird schon alles gutgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820221
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820222,
					"content": "Ich bin bereit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4820221,
					"content": "Flieg einfach entlang der <color=#00E1FFFF>markierten Strecke</color> bis zum Endpunkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "Amber"
				}
			]
		},
