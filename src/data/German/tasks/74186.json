			"dialogs": [
				{
					"id": 741860301,
					"content": "Herr Cassiodor! Herr Cassiodor ... bist du es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860302
					],
					"speakerTitle": "Namenloser Golem"
				},
				{
					"id": 741860302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860303
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741860303,
					"content": "Du bist es, wie ich dachte! Endlich bist du zurückgekehrt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860304
					],
					"speakerTitle": "Namenloser Golem"
				},
				{
					"id": 741860304,
					"content": "Ich hatte den Befehl, diese Festung zu schützen, aber die unerbittlichen Vorstöße der Drachenechsen und der Barbaren zwangen mich, Schritt für Schritt zurückzuweichen, bis ich hierhergelangte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860305
					],
					"speakerTitle": "Namenloser Golem"
				},
				{
					"id": 741860305,
					"content": "Seitdem scheinen viele Jahre vergangen zu sein ... Wie ist die Lage in der Außenwelt? Haben wir gesiegt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860306
					],
					"speakerTitle": "Namenloser Golem"
				},
				{
					"id": 741860306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860307
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741860307,
					"content": "... So ist es. Also haben wir verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860308
					],
					"speakerTitle": "Namenloser Golem"
				},
				{
					"id": 741860308,
					"content": "Es tut mir leid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860309
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741860309,
					"content": "Sag nicht so etwas, geehrter Herr. Als ich der Armee des Sebastos beitrat, erwartete ich, dass es eines Tages dazu kommen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860310
					],
					"speakerTitle": "Namenloser Golem"
				},
				{
					"id": 741860310,
					"content": "Der Sebastos sprach einst davon, uns zu helfen, die Fesseln Fortunas abzuwerfen. Aber sind die Dinge wirklich so einfach?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860311
					],
					"speakerTitle": "Namenloser Golem"
				},
				{
					"id": 741860311,
					"content": "Schließlich ist es das Schicksal, dem wir die Stirn bieten, ein Schicksal, dem sich selbst die größten Götter nicht widersetzen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860312
					],
					"speakerTitle": "Namenloser Golem"
				},
				{
					"id": 741860312,
					"content": "Am Ende waren all unsere Anstrengungen vergeblich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860313
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741860313,
					"content": "Nein, mein Herr. Wir haben unsere Klingen gegen das Schicksal selbst gerichtet und durch unser Tun die himmlischen Gesetze herausgefordert. Wir haben im Angesicht der Prophezeiung Widerstand geleistet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860314
					],
					"speakerTitle": "Namenloser Golem"
				},
				{
					"id": 741860314,
					"content": "Wir sind zwar gescheitert ... aber es muss ein Verrat gewesen sein, der uns auf diesen Irrweg geschickt hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860315
					],
					"speakerTitle": "Namenloser Golem"
				},
				{
					"id": 741860315,
					"content": "Aber jetzt ist das Ergebnis nicht mehr von Bedeutung. So oder so haben wir einen Platz in der „Geschichte“ dieser Welt errungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860316
					],
					"speakerTitle": "Namenloser Golem"
				},
				{
					"id": 741860316,
					"content": "He, warum ist er denn umgefallen? Können Steinmenschen auch einfach so ohnmächtig werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741860317,
					"content": "Ich kenne seinen Namen noch nicht ... Wie es scheint, ist seine „Geschichte“ bereits abgeschlossen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860318
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741860318,
					"content": "Wie bitter. Verbrachte er wirklich Tausende von Jahren hier im Kampf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741860319,
					"content": "Aber nun hat er endlich seinen Frieden gefunden. Lasst uns weiter vorangehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Os"
				}
			]
		}
	]
}