			"dialogs": [
				{
					"id": 221130301,
					"content": "Hast du die Bretter geholt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130302
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221130302,
					"content": "Ja, hier ist es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130303
					]
				},
				{
					"id": 221130303,
					"content": "Klasse! Diese Monster gehen einem wirklich auf die Nerven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130304
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221130304,
					"content": "Scheint genug zu sein. Vielen Dank! Ich werde gleich mit der Arbeit beginnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				}
			]
		},
		{
			"id": 2211305,
			"completionStepIds": [
				2211305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
