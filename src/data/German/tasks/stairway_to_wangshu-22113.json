			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai’an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221130101,
					"content": "Man kriegt hier wirklich nie Ruhe rein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130102
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221130102,
					"content": "Reparierst du immer noch die Treppe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130103
					]
				},
				{
					"id": 221130103,
					"content": "Du kommst gerade richtig! Das letzte Mal hast du mir sehr geholfen. Hast du jetzt vielleicht auch etwas Zeit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130104
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221130104,
					"content": "Diesmal ist die Stelle größer.und ich habe nicht genügend Bretter. Deswegen habe ich eine neue Fuhre bestellt, die eigentlich jemand abholen sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130105
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221130105,
					"content": "Der dafür Zuständige wurde aber auf dem Weg von Monstern angegriffen. Vor Schreck hat er die Sachen fallen lassen und ist geflüchtet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130106
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221130106,
					"content": "Er ist so eingeschüchtert, dass er sich nicht mehr zurück traut. Wenigstens konnte er mir sagen, wo die Bretter ungefähr sein sollten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130107
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221130107,
					"content": "Ich weiß einfach nicht, was ich machen soll. Mir fällt nur ein, dass du nach den Brettern suchen könntest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130108,
						221130110
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221130108,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130109
					]
				},
				{
					"id": 221130109,
					"content": "Super, dann warte ich hier auf dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221130110,
					"content": "Die kaputte Stelle ist ja riesig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130111
					]
				},
				{
					"id": 221130111,
					"content": "Sieh mich doch nicht so an! Das stammt von keinem Monster. Das müsste ja ein wahrer Riese gewesen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130112
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221130112,
					"content": "Also, das war so: Wir haben kurz hintereinander zwei Gäste aufgenommen, die offensichtlich eine Fehde hatten. Der eine ist dem anderen hinterhergerannt. Der andere konnte sich aber verstecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130113
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221130113,
					"content": "Am Ende haben sich aber beide entschieden, die Nacht hier zu verbringen. Als sie die Treppe benutzen wollten, sind sie sich begegnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130114
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221130114,
					"content": "Da haben die beiden natürlich angefangen sich zu raufen. Das hielt solange an, bis ich dazwischen ging. Die Treppe hat aber ordentlich was abbekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130115
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221130115,
					"content": "Ich war vielleicht wütend, sag ich dir! Ich habe ihnen sofort drei Nächte extra berechnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130116
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221130116,
					"content": "Aber das geht viel zu sehr ins Detail. Ich würde mich sehr freuen, wenn du mir schnell ein paar Bretter besorgen könntest, damit ich die Treppe reparieren kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130117
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221130117,
					"content": "Wenn das noch einmal passiert, werde ich keine Nacht mehr extra berechnen. Wer was kaputtmacht, soll auch die Reparatur selbst übernehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				}
			]
		},
