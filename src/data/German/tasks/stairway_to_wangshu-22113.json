				"points": []
			},
			"dialogs": [
				{
					"id": 221130501,
					"content": "Na, endlich ist alles wieder ganz! Ist doch ganz gut gelungen, findest du nicht auch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130502
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221130502,
					"content": "Das wird die Situation für die Gäste hier deutlich verbessern, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130503
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221130503,
					"content": "Komm, hier, nimm das für deine Dienste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130504
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221130504,
					"content": "Du bist jederzeit herzlich willkommen, wenn du dich auf einen Tee oder eine Knabberei hinsetzen möchtest. Unser Koch hier ist wirklich eine Nummer für sich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				}
			]
		}
	]
