			"dialogs": [
				{
					"id": 221130201,
					"content": "Hast du die Bretter geholt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130202
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221130202,
					"content": "Noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130203
					]
				},
				{
					"id": 221130203,
					"content": "Dann beeil dich bitte etwas. Ich werde sofort anfangen, sobald ich die Bretter habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				}
			]
		},
