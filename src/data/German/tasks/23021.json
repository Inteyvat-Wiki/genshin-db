				"objectNames": [
					"Rafiq"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230210801,
					"content": "Großartig, ein durchschlagender Erfolg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210802
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210802,
					"content": "Bei der Struktur des Bootsrumpfs gibt es keine Probleme ... Die Wasserlinie und der Tiefgang sind in Ordnung. Das Boot kippt auch nicht mehr um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210803
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210803,
					"content": "Schau mal, Qishan! Mein Entwurf und meine Berechnungen sind einwandfrei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210804
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210804,
					"content": "Das war nur die erste Phase des Belastungstests. Freu dich nicht zu früh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210805
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210805,
					"content": "Außerdem hast du die Verschiebung des Schwerpunkts des Boots bei der Fahrt und die unterschiedlichen Wettereinflüsse nicht bedacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210806
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210806,
					"content": "Ähm ... Ähm, ich werde das berücksichtigen. Lass mich zuerst diesen Moment genießen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210807
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210807,
					"content": "#Gut, {F#Reisende}{M#Reisender}. Hier ist deine Belohnung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210808
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210808,
					"content": "Qishan, kannst du mich nicht einfach anspornen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210809
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210809,
					"content": "Aber beim Bootsbau nützt das doch nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210810
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210810,
					"content": "Denk gut darüber nach, wie du dein eigenes Portemonnaie „anspornst“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qishan"
				}
			]
		},
