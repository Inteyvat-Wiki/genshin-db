				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rafiq",
					"Qishan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230210101,
					"content": "#{F#Reisende}{M#Reisender}, du kommst gerade recht! Das Boot ist gerade vom Stapel gelaufen und es liegt ganz ruhig im Wasser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210102,
					"content": "Meine Berechnungen waren wirklich fehlerlos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210103
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210103,
					"content": "Also, wann beginnen wir den Belastungstest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210104
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210104,
					"content": "#Keine Sorge. {F#Die Reisende}{M#Der Reisende} ist da. Wir fangen sofort an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210105,
					"content": "Was ist ein Belastungstest?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210106
					]
				},
				{
					"id": 230210106,
					"content": "Einfach gesagt, testen wir mit schweren Sachen die Beladungskapazität des Boots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210107,
					"content": "Hmm ... Das bedeutet, dass jemand mit mir zusammen die schweren Sachen auf das Boot tragen muss ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210108,
					"content": "#{F#Reisende}{M#Reisender}! Letztes Mal ist mir aufgefallen, dass du über immense körperliche Stärke verfügst. Eine solche Aufgabe sollte für dich eine Kleinigkeit sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210109,
						230210110
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210109,
					"content": "Deshalb bin ich also hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210111
					]
				},
				{
					"id": 230210111,
					"content": "Nein, Nein. Ich kann das unmöglich allein schaffen. Deswegen muss ich dich bitten, mir zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210112,
					"content": "Außerdem wird die Belohnung alles andere als klein ausfallen! Sei beruhigt. Ich habe in den letzten Tagen jemandem geholfen, ein großes Schiff zu reparieren und dafür ein schönes Sümmchen bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210113,
					"content": "Oh ... Ein schönes Sümmchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210114
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210114,
					"content": "Äh, ich habe doch fast die ganze Belohnung in den Bau der Boote gesteckt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210115
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210115,
					"content": "Alles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210116
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210116,
					"content": "Etwas ist noch da! Herrje, ich gebe dir einen Kaffee aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210117
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210117,
					"content": "#{F#Reisende}{M#Reisender}, wir beginnen jetzt! Los, los, los!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210110,
					"content": "Ich bin wütend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210111
					]
				}
			]
		},
		{
			"id": 2302106,
			"completionStepIds": [
				2302106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2302106",
							"2"
						],
						"stepId": 2302106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rafiq",
					"Qishan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230210614,
					"content": "Sehr gut! Das sollte es gewesen sein. Schauen wir mal, was nun passiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210601
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210601,
					"content": "Ooh! Das Boot hat ein Leck!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230210615,
					"content": "Was?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210602
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210602,
					"content": "Das Boot kippt! Wie konnte das passieren?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230210603,
					"content": "Los, los, holt die Sachen vom Boot! Es gibt ein Problem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210604
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210604,
					"content": "Zusammen mit Rafiq entlädst du in aller Eile alles vom Boot ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230210605
					]
				},
				{
					"id": 230210605,
					"content": "Puh ... Huch ... Zum Glück waren das nicht zu viele Sachen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210606
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210606,
					"content": "Wo ist doch das Problem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210607
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210607,
					"content": "Was habe ich gesagt? Die theoretischen Daten, die du errechnet hast, sind zu grenzwertig, um verlässlich zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210608
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210608,
					"content": "*seufz* ... Ich ... Ich ... Ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210609
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210609,
					"content": "Aber so sollte es nicht sein. Ich habe es doch ganz genau berechnet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210610
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210610,
					"content": "#Vielen Dank für deine Hilfe, {F#Reisende}{M#Reisender}. Bitte nimm dies als Lohn für deine Mühen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210611
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210611,
					"content": "Ich werde das noch einmal nachrechnen ... Qishan, kannst du mir dabei helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210612
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210612,
					"content": "Als ob ich dir vorher nicht geholfen hätte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210613
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210613,
					"content": "Überlass das mir. Aber denk daran, mir einen Kaffee auszugeben, wenn wir mit den Berechnungen fertig sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qishan"
				}
			]
		},
		{
			"id": 2302108,
			"completionStepIds": [
				2302108
			],
