			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Glory"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350401,
					"content": "Hoffentlich geht es Godwin gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350402
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350402,
					"content": "Hallo. Godwin hat mich gebeten nach dir zu sehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350403
					]
				},
				{
					"id": 411350403,
					"content": "Godwin? Weißt du, wo er ist? Ich habe lange nichts mehr von ihm gehört, ich mache mir Sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350404
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350404,
					"content": "Er ist immer noch auf einer Mission in einem fernen Land.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350405
					]
				},
				{
					"id": 411350405,
					"content": "Oh ... Verstehe. Also gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350406
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350406,
					"content": "Wenn diese gefallenen Sterne nicht wären, hätte ich beim Ordo nach seinem Verbleib gefragt..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350407
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350407,
					"content": "Hier in der Stadt bin ich sicher. Aber er ist da draußen unterwegs und erfüllt seine Mission. Wenn diese Sterne überall auf der Welt einschlagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350408
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350408,
					"content": "*seufz* Hoffentlich ist er wohlauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350409
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350409,
					"content": "Das wird er.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350410
					]
				},
				{
					"id": 411350410,
					"content": "Danke. Das wäre wunderbar. Oh, richtig. Könntest du mir helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350411
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350411,
					"content": "Ich habe Löwenzahnsamen gekauft und möchte sie von einem hohen Aussichtspunkt verstreuen ... damit der Wind sie zu Godwin trägt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350412
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350412,
					"content": "Doch bei der aktuellen Lage ist es schwer, jemanden zu finden, der mir dabei hilft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350413
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350413,
					"content": "Da du schon einmal hier bist, würdest du diese Löwenzahnsamen zu Godwin bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350414
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350414,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350415
					]
				},
				{
					"id": 411350415,
					"content": "Danke. Er muss wirklich weit entfernt sein. Schließlich ist er zusammen mit dem Großmeister zu dieser Expedition aufgebrochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350416
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350416,
					"content": "Bitte bring ihm diese Löwenzahnsamen und sag ihm, dass es mir gut geht. Und ... gemahne ihn, dass er gut auf sich aufpasst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		},
		{
			"id": 4113505,
			"completionStepIds": [
				4113507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113507",
							"2"
						],
						"stepId": 4113507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350501,
					"content": "#{F#Reisende}{M#Reisender}, bist du Glory begegnet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350502
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350502,
					"content": "Wie geht es ihr? Ist sie gesund? War sie verletzt? Ist sie – ja, ich weiß, dass sie die ganze Zeit in der Stadt war, aber trotzdem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350503
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350503,
					"content": "Sie schickt dir Löwenzahnsamen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350504
					]
				},
				{
					"id": 411350504,
					"content": "Löwenzahnsamen ... Das passt zu ihr. *seufz* Hoffentlich ist sie nicht wütend auf mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350505
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350505,
					"content": "Danke, dass du mir schon wieder geholfen hast. Bitte nimm das hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350506
					],
					"speakerTitle": "Godwin"
				},
