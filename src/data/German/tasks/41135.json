			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350201,
					"content": "Wo zur Hölle steckt der Großmeister ... Ob er wohl erfahren hat, was vorgefallen ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350202
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350202,
					"content": "*seufz* Doch selbst wenn er davon erfährt, könnte er nicht so rasch zurückkehren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
		{
			"id": 4113503,
			"completionStepIds": [
				4113505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113505",
							"2"
						],
						"stepId": 4113505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350301,
					"content": "Hast du alle Monster beseitigt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350302
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350302,
					"content": "Hab alle erwischt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350303
					]
				},
				{
					"id": 411350303,
					"content": "#Ich danke dir, {F#Reisende}{M#Reisender}. Fürs Erste sollten sie keine Bedrohung mehr darstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350304
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350304,
					"content": "Du solltest zurück zur Stadt gehen. Es tut mir leid, dass du dich wegen mir in der Wildnis in Gefahr gebracht hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350305
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350305,
					"content": "Würdest du mir bei einer Sache helfen ... sobald du zurück in der Stadt bist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350306
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350306,
					"content": "Es ist ganz leicht! Du musst bloß nach etwas Ausschau halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350307
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350307,
					"content": "Und was könnte das sein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350308
					]
				},
				{
					"id": 411350308,
					"content": "Nun ... Könntest du in der Stadt überprüfen, was Glory so treibt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350309
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350309,
					"content": "Sie sollte in der Stadt sicher sein, aber ich möchte gerne sichergehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350310
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350310,
					"content": "Würdest du also bitte für mich nach ihr sehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350311
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350311,
					"content": "Werde ich machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350312
					]
				},
				{
					"id": 411350312,
					"content": "#Danke, {F#Reisende}{M#Reisender}. Oh, richtig – bitte sag ihr nicht, dass ich hier bin? Sag ihr ... nur, dass ich immer noch auf einer Mission in einem fernen Land bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350313
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350313,
					"content": "Es tut mir leid, aber bitte sage ihr das. Verzeih mir die Umstände, aber ich kann meine privaten Probleme nicht mit dir teilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
		{
			"id": 4113504,
			"completionStepIds": [
				4113506
			],
