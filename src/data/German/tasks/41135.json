			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350101,
					"content": "Wie es Glory wohl geht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350102
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350102,
					"content": "Was gibt es?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350103
					]
				},
				{
					"id": 411350103,
					"content": "#Ah, du bist es, {F#Reisende}{M#Reisender}? Da draußen ist es jetzt gefährlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350104
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350104,
					"content": "Wenn du sicheren Schutz suchst, solltest du sobald wie möglich nach Mondstadt zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350105
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350105,
					"content": "Du gehst nicht zurück?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350106
					]
				},
				{
					"id": 411350106,
					"content": "Nun, ich ... ich bleibe erst einmal hier. Ich gehöre schließlich zum Ordo Favonius – ich kann meinen Posten jetzt nicht aufgeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350107
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350107,
					"content": "Ich kann aus verschiedenen Gründen nicht nach Mondstadt zurück, doch ich kann hier draußen helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350108
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350108,
					"content": "Nach dem Fall der Sterne wurden viele Monster unter ihrem Einfluss zunehmend aggressiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350109
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350109,
					"content": "Wenn sie nicht aufgehalten werden, gibt das eine Katastrophe. Ich habe mich gerade darauf vorbereitet, sie auszulöschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350110
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350110,
					"content": "Schaffst du das alleine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350111
					]
				},
				{
					"id": 411350111,
					"content": "Ähm, das sind echt viele ... Aber so lange ich aufpasse, sollte es in Ordnung sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350112
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350112,
					"content": "Aber wer weiß, wie lange ich dafür benötige, wenn ich es ganz alleine versuche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350113
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350113,
					"content": "#Würdest du mir helfen, ihr Lager zu säubern, {F#Reisende}{M#Reisender}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350114,
						411350116
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350114,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350115
					]
				},
				{
					"id": 411350115,
					"content": "Danke, das wäre wirklich eine große Erleichterung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350116,
					"content": "Warum bittest du nicht die Ritter um Hilfe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350117
					]
				},
				{
					"id": 411350117,
					"content": "Die Ritter bitten – Nun ja ... Sagen wir einfach, ich habe meine eigenen privaten Probleme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350118
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350118,
					"content": "Bitte hilf mir dabei, das Monsterlager zu zerstören. Sieh es als Gefallen, den du dem Ordo erweist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
		{
			"id": 4113502,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
