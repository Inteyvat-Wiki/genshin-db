					"Kaeya",
					"Rosaria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705040101,
					"content": "He, was für eine Überraschung, dass du heute der Wirt bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040102,
					"content": "Dann will ich einen „Tod nach ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040103
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040103,
					"content": "Du bist wirklich gut darin, andere in Schwierigkeiten zu bringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040104
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040104,
					"content": "#Ich wollte nur sehen, wie {M#er}{F#sie} reagieren würde. Ich hatte nicht erwartet, dass Rosaria heute auf einen Becher vorbeikommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040105
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040105,
					"content": "#Bei so vielen kniffligen Kunden in der Taverne kann {M#er}{F#sie} es sich nicht leisten, nicht frühzeitig Erfahrung zu sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040106,
					"content": "Kaeya ist immer noch so eine Schlangenzunge wie eh und je!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040107,
					"content": "Das ist ungerecht, ich habe es gut gemeint! Solltest du dich nicht bei mir bedanken? Wie wäre es mit einer einfachen Mondscheingasse oder so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040108
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040108,
					"content": "In Groß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040109
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040109,
					"content": "Gib mir irgendwas. Ein Getränk mit Tee-Aroma, nicht zu große Mengen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040110
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040110,
					"content": "Alles klar, einen Moment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040111
					]
				},
				{
					"id": 705040111,
					"content": "Nimm dir Zeit. Auch die Zeit des Wartens auf die köstlichen Produkte ist spannend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 7050402,
			"completionStepIds": [
				7050404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050404",
							"2"
						],
						"stepId": 7050404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rosaria",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705040201,
					"content": "Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040202
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040202,
					"content": "Mag Rosaria das nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040203,
					"content": "Ich kann ein neues machen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040204
					]
				},
				{
					"id": 705040204,
					"content": "Nein, es ist nicht das. Ich trinke nur selten Tee und der Geschmack erinnert mich an etwas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040205
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040205,
					"content": "Hat es was mit der Kathedrale zu tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040206
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040206,
					"content": "Hm. Es gab eine Veranstaltung, zu der ich nicht ging, und zu meiner Überraschung ließ Barbara mir einen Tee und ein Gebäck da ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040207
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040207,
					"content": "Das Gebäck schmeckte so schlecht, nachdem es zu lange draußen gestanden hatte, dass sie es heimlich wegnahm. Aber die Tasse Tee, die hat ziemlich genauso geschmeckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040208
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040208,
					"content": "Rosarias derzeitiges Gemüt ist eine Seltenheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040209,
					"content": "Es sieht so aus, als würde Mondstadt einen weiteren Liebhaber von schwarzem Tee bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040210
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040210,
					"content": "Alkohol ist besser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040211
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040211,
					"content": "Kaeya, wie ist das Getränk?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040212
					]
				},
				{
					"id": 705040212,
					"content": "Wenn ich ein paar Mängel feststelle, wirst du dann den Becher für mich neu machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040213
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040213,
					"content": "Hahahaha, nur ein Scherz, wie könnte ich so etwas tun? Das wäre nicht nett.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040214
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040214,
					"content": "Hmm, Kaeya spricht wieder seltsam, man weiß nie, was er als Nächstes sagen wird. Paimon fragt sich, warum Rosaria es ertragen kann, mit ihm zu trinken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040215,
					"content": "Ist das so? Seine Redeweise interessiert mich überhaupt nicht. Wenn man trinkt, redet man nur über den Alkohol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040216
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040216,
					"content": "Außerdem, egal ob du oder der Besitzer hier ... Kaeya kümmert sich nur um Leute oder Dinge, die ihn interessieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040217
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040217,
					"content": "He! Wir sind wenigstens Trinkfreunde. Wie kannst du mich hintergehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040218
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040218,
					"content": "Das ist doch nicht Hintergehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040219
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040219,
					"content": "Es gibt zu viele „anständige Leute“ in meinem Leben. Die lockere Atmosphäre in der Kneipe gefällt mir besser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040220
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040220,
					"content": "Was? Ist es an der Zeit, anständige Menschen zu kritisieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040221
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040221,
					"content": "Apropos, ich kenne jemanden, der auf der „Liste der anständigen Leute aus Mondstadt“ unter den ersten drei Plätzen stehen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040222
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040222,
					"content": "Um das Ausmaß zu sagen ... Oh, ich sollte es so beschreiben. Er ist inzwischen so weit, dass sich sein Gesichtsausdruck überhaupt nicht mehr verändert, selbst wenn er so beurteilt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040223
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040223,
					"content": "Es gibt also so eine Liste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040224,
					"content": "Ja, natürlich. Mal sehen ... Es gibt auch eine Rangliste der aufeinanderfolgenden Tage beim Trinken, eine Rangliste der längsten Arbeitszeiten, eine Rangliste der Küchenmeister, eine Rangliste mit verbotenem Wissen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040225
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040225,
					"content": "Die Leute in Mondstadt haben zu viel Langeweile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040226,
					"content": "Gibt es so viele Menschen, die nicht arbeiten müssen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040227,
						705040228
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040227,
					"content": "Nein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040229
					]
				},
				{
					"id": 705040229,
					"content": "Gibt es nicht etwas, womit wir es auf eine Liste schaffen könnten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040230,
					"content": "Doch, wie der „beste Wirt“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040231
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040231,
					"content": "Wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040232,
					"content": "#Toll, {NICKNAME}, wir lassen unsere Namen hier auch zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040233,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040234
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040234,
					"content": "Hm, das ist eine schöne Atmosphäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040235
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040235,
					"content": "Genau, allein der Anblick von ihnen macht mich glücklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040236
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040236,
					"content": "Die ansteckende Atmosphäre wird ein wichtiges Verkaufsargument für die Taverne sein. Der Titel „bester Wirt“ scheint an die richtige Person vergeben worden zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040237
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040237,
					"content": "Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040238,
					"content": "Ach, nichts, danke für die Gastfreundschaft dieses Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040239
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040239,
					"content": "Nun, es ist fast an der Zeit, dass ich zurückkehre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040240
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040240,
					"content": "Außerdem schmeckt der schwarze Tee sehr gut und ich werde versuchen, ihn nachher selbst zu machen, solange ich morgens früh aufstehen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040241
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040241,
					"content": "Also auf Wiedersehen für den Moment?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040242
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040242,
					"content": "Bis zum nächsten Mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705040228,
					"content": "Ich weiß, wer gemeint ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040229
					]
				}
			]
		}
	]
}