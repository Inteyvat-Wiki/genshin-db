			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Harris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205210101,
					"content": "Wie kann sie auf Abenteuer gehen ohne ihren Abenteuertreibstoff ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210102
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210102,
					"content": "„Abenteuertreibstoff“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210103
					]
				},
				{
					"id": 205210103,
					"content": "Oh, ich meine warmes Essen. Ich habe von Iris, der Forscherin, geredet, sie sollte wirklich etwas warmes Essen zu sich nehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210104
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210104,
					"content": "Sie plant, für ein Forscherteam eine Expedition in die Berge zu veranstalten. Aber sie will zunächst alleine aufbrechen, ein wenig kampieren und die Bedingungen beobachten, bevor sie einen definitiven Plan ausarbeitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210105
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210105,
					"content": "Das Lager ist nicht so weit entfernt und es ist immer noch recht einfach, dort Vorräte anzuliefern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210106
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210106,
					"content": "Aber trotzdem, oben in den Bergen zu kampieren, draußen im Schnee ... Ich glaube, eine warme Mahlzeit gäbe ihr die nötige zusätzliche Energie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210107
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210107,
					"content": "Ich hingegen wage es nicht, die Reise selbst anzutreten ... Was ist mit dir? Könntest du für mich diesen Sahneeintopf zu Iris liefern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210108,
						205210110
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210108,
					"content": "Überlass es mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210109
					]
				},
				{
					"id": 205210109,
					"content": "Danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210113,
					"content": "Dieses Gericht wurde frisch zubereitet und ist noch heiß. Du bringst es besser schnell zu Iris. Unter solchen Bedingungen wird es schnell kalt werden und dann lohnt es sich nicht mehr, es zu essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210114
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210114,
					"content": "Und dann wäre das Schlimmste, dass du unterwegs in Schwierigkeiten gerätst und das Essen zu einem Kollateralschaden wird. In diesem Fall komm einfach wieder hierher zurück und ich koche dir ein neues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210110,
					"content": "Wo finde ich sie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210111
					]
				},
				{
					"id": 205210111,
					"content": "Sie sagte, dass das Lager auf halber Höhe des Berges läge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210112
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210112,
					"content": "Sie ist eine erfahrene Abenteurerin und versteht es, mit Vorsicht vorzugehen. Sie wird sich nicht weit vom Lager entfernt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "Harris"
				}
			]
		},
		{
			"id": 2052102,
			"completionStepIds": [
				2052102
