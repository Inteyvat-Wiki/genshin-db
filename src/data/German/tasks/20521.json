			},
			"dialogs": [
				{
					"id": 205210201,
					"content": "Hm? Was machst du denn hier? Forschst du auch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 2052103,
			"completionStepIds": [
				2052103
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2052103",
							"2"
						],
						"stepId": 2052103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205210301,
					"content": "Dieser Sahneeintopf ist für dich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210302
					]
				},
				{
					"id": 205210302,
					"content": "Ah, Harris muss dich geschickt haben. Danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210303
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210303,
					"content": "Ich sollte mich lieber nicht zu sehr an seine leckeren Kochkünste gewöhnen, sonst kann ich niemals wieder auf diesen trockenen Mahlzeitenersatz zurückgreifen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210304
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210304,
					"content": "Haha, ich mache nur Witze. Als Abenteurer weiß ich, wann ich es schmunzelnd ertragen muss, wenn es ums Essen geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210305
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210305,
					"content": "Wirst du noch weiter in die Berge gehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210306
					]
				},
				{
					"id": 205210306,
					"content": "Dieses Lager ist selbstverständlich nur eine Zwischenstation. Ich warte auf eine gute Gelegenheit, dann werde ich sehen, ob ich ein Stück weiter vorn ein Lager aufschlagen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210307
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210307,
					"content": "Danach wird es mit Sicherheit kein warmes Essen mehr geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210308
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210308,
					"content": "Ich werde aber nicht weiter vordringen, ehe es nicht sicher genug dafür ist. Nach etwas mehr Beobachtung hier werde ich ins Lager zurückkehren, einen Aktionsplan aufstellen und dann meine Entscheidung treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210309
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210309,
					"content": "Danke, dass du den weiten Weg auf dich genommen hast, nur um mir etwas zu essen zu bringen. Hier, nimm das im Gegenzug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
