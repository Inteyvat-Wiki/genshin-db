					"content": "Ich danke dir! Jetzt kann ich endlich mit Zuversicht an Bord gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080202
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080202,
					"content": "Wohin geht es?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080203
					]
				},
				{
					"id": 722080203,
					"content": "Das Land des Goldes, das Land der Träume. Das Land ohne Nebel ... wir sehen dich im Schlaf, Freund.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ipe"
				}
