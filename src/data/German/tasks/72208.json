			"dialogs": [
				{
					"id": 722080401,
					"content": "Du bist gekommen! Hast du das Amulett gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080402
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080402,
					"content": "Ich bin immer noch dabei alles zu geben, um es zu finden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080403
					]
				},
				{
					"id": 722080403,
					"content": "So ist das. Keine Eile und bitte sei vorsichtig. Freund vom Festland.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080404
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080404,
					"content": "Die kleine Insel mit Blick auf den dreifachen Wasserfall westlich der Autake-Ebene ... was ich will, ist im Meer weiter westlich der Insel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ipe"
