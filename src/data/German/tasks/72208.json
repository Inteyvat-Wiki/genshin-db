			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ipe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722080101,
					"content": "Die Angelkenntnisse sind zwar gut, aber es gibt noch Raum für Verbesserungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080102,
						722080103
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080102,
					"content": "Ah?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080104
					]
				},
				{
					"id": 722080104,
					"content": "Ups, Entschuldigung ... vergesse immer zu grüßen und vergesse, dass ich Leute erschrecken kann ... hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080105
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080105,
					"content": "Ich kann nicht glauben, dass du das amüsant findest ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080106
					]
				},
				{
					"id": 722080106,
					"content": "Ich kann nicht anders, es macht Spaß, die Kinder ab und zu zu erschrecken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080107
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080107,
					"content": "Kommen wir zurück zum Angeln, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080108,
						722080109
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080108,
					"content": "Was gibt’s?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080110
					]
				},
				{
					"id": 722080110,
					"content": "Es ist mir peinlich, aber es ist so ... ich habe versehentlich das Amulett zurückgelassen, das Makiri mir beim Angeln gegeben hat ... es enthält den Segen ihrer Ahnengeister und vom Donnervogel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080111
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080111,
					"content": "Wenn sie wüsste, dass ich es beim Betreten des Bootes verloren habe, wäre das eine Katastrophe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080112
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080112,
					"content": "Der goldene Bootsmann hat versprochen, jemanden zu finden, der mir bei der Suche nach ihm hilft ... Aber bis jetzt war niemand in Sicht ... Also dachte ich, wenn du schon mal hier bist, dann hilf mir doch bitte auch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080113,
						722080114
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080113,
					"content": "Ich dachte, du wärst zuverlässig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080115
					]
				},
				{
					"id": 722080115,
					"content": "Mein regelmäßiger Angelplatz ist dort drüben ... Aber mein Gedächtnis lässt nach, also muss ich dich vielleicht bitten, weiter danach zu suchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080116,
						722080117
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080116,
					"content": "Nun, es ist ein Ort der alten Erinnerungen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080118
					]
				},
				{
					"id": 722080118,
					"content": "Nun ... Was hast du gesagt? Ist das die Methode, die Außenstehende verwenden, um Standorte zu finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080119
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080119,
					"content": "*seufz* ... Wie auch immer, wenn man an der richtigen Stelle sucht, kann man es finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080120
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080120,
					"content": "Wie soll ich vorgehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080121
					]
				},
				{
					"id": 722080121,
					"content": "Mit der Angel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080122
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080122,
					"content": "Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080123
					]
				},
				{
					"id": 722080123,
					"content": "Der Donnervogel und die Geister der Ahnen beschützen dich! Ich zähle auf dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080117,
					"content": "Ich denke, man kann es dann mit der „Feder“ erkennen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080118
					]
				},
				{
					"id": 722080114,
					"content": "Ein hoffnungsloser Fall ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080199
					]
				},
				{
					"id": 722080199,
					"content": "Die kleine Insel gegenüber den drei Wasserfällen, westlich der Autake-Ebene ... etwas weiter westlich der Insel im Meer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080115
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080109,
					"content": "Warum denkt dieser Mensch immer noch ans Angeln ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080110
					]
				},
				{
					"id": 722080103,
					"content": "Bitte begrüße uns, bevor du auftauchst!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080104
					]
				}
			]
		},
