					"nextDialogs": [
						732470204
					],
					"speakerTitle": "Arapratap"
				},
				{
					"id": 732470204,
					"content": "Guter Nara, bist du bereit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732470205
					],
					"speakerTitle": "Arapratap"
				},
				{
