			},
			"dialogs": [
				{
					"id": 718120201,
					"content": "Und hast du irgendetwas gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120202,
					"content": "Ich habe dies hier gefunden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718120203
					]
				},
				{
					"id": 718120203,
					"content": "Das ... so etwas habe ich ja noch nie gesehen. Wo hast du das gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120205
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120205,
					"content": "In der Nähe des Dunyu-Mausoleums ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718120206
					]
				},
				{
					"id": 718120206,
					"content": "Das Dunyu-Mausoleum? Was hat so ein Gegenstand da verloren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120207
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120207,
					"content": "Vielen Dank, dass du diesem Hinweis auf den Grund gegangen bist. Gemäß dem Abenteurerkodex gehört dieser Gegenstand dir, zusammen mit einer zusätzlichen Belohnung natürlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120208
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120208,
					"content": "Ich werde jemanden zum Dunyu-Mausoleum schicken, um es gründlicher zu untersuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120209
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120209,
					"content": "So seltsam ... Das Gebiet des Dunyu-Mausoleums wurde schon unzählige Male durchkämmt ... Wie konnten wir das übersehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 7181203,
