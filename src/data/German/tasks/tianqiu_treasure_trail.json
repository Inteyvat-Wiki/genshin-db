			"dialogs": [
				{
					"id": 718120301,
					"content": "Ist das etwa ein ... Stück Papier? Was steht da drauf? Sehen wir es uns an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718120302,
					"content": "Oh ... das scheint zu bedeuten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718120303,
					"content": "Wir müssen uns unter einen riesigen Baum begeben, die Mitte des Pfades finden, und dann ... eine Treppe hinuntergehen, um den Schatz zu suchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
