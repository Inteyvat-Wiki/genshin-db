				"points": []
			},
			"dialogs": [
				{
					"id": 221020101,
					"content": "Was für ein Ärger ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020102
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221020102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020103
					]
				},
				{
					"id": 221020103,
					"content": "Sieh dir meine Augenringe an! Ich habe schon seit Tagen nicht mehr geschlafen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020104
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221020104,
					"content": "Hast du die Gäste im Gasthaus gesehen? Einer verrückter als der andere. Da gibt es echt welche, die von ganz oben hinunterspringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020105
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221020105,
					"content": "Na, egal, ich habe einiges an Nahrungsmitteln aus der Stadt bestellt. Sie müssten bald eintreffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020106
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221020106,
					"content": "Die Monster auf dem Weg machen bestimmt keine Pause. Könntest du vielleicht den Weg freiräumen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020107,
						221020108
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221020107,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020109
					]
				},
				{
					"id": 221020109,
					"content": "Danke sehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221020108,
					"content": "Aber ist es nicht komisch, hier ein Gasthaus zu führen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020110
					]
				},
				{
					"id": 221020110,
					"content": "Also ich habe mir gedacht, dass es doch schön sein muss, ein Gasthaus zu haben, in dem Menschen von überall unterkommen und die Aussicht genießen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020111
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221020111,
					"content": "Aber es ist und bleibt ein einfaches Gasthaus. Es ist etwas abgelegen, hat trotzdem viele Gäste, ist aber auch nichts Besonderes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020112
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221020112,
					"content": "Ich danke dir schon im Voraus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				}
			]
		},
