			"dialogs": [
				{
					"id": 221020301,
					"content": "Und wie sieht es mit den Monstern in der Umgebung aus? Hast du sie beseitigt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020302
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221020302,
					"content": "Ja, sie sind Geschichte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020303
					]
				},
				{
					"id": 221020303,
					"content": "Perfekt, danke dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020304
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221020304,
					"content": "Hier hast du deine Belohnung. Schau gern mal wieder vorbei, wenn du in der Nähe bist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
