				"points": []
			},
			"dialogs": [
				{
					"id": 221020201,
					"content": "Und wie sieht es mit den Monstern in der Umgebung aus? Hast du sie beseitigt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020202
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221020202,
					"content": "Noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020203
					]
				},
				{
					"id": 221020203,
					"content": "Bitte mach etwas schneller. Der Koch hat bald keine Sachen mehr, die er zubereiten kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020204
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221020204,
					"content": "Wenn es keinen anderen Weg gibt, muss ich selber ran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				}
			]
		},
