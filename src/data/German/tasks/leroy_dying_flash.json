			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Euphrasie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490101,
					"content": "Gibt es neue Aufträge für mich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490102
					]
				},
				{
					"id": 741490102,
					"content": "Oh? Sind die Aufträge aus den „Chroniken der Menschheit“ zu wenig Herausforderung für dich oder bist du in letzter Zeit wirklich knapp bei Kasse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490103,
						741490105
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490103,
					"content": "Je mehr Mora, desto besser.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490104
					]
				},
				{
					"id": 741490104,
					"content": "Mhm, das denken die meisten Menschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490107,
					"content": "Die letzte Sache, an der es uns hier mangelt, sind Aufträge. Ich glaube übrigens, dass wir das größte Verteilungszentrum für Aufträge außerhalb der Abenteurergilde sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490108
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490108,
					"content": "Obwohl wir theoretisch diese Art von sozialer Dienstleistung nicht wirklich übernehmen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490109
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490109,
					"content": "Wie auch immer, da du Mora brauchst, werde ich dir eine langfristige Beschäftigung empfehlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490110
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490110,
					"content": "Hier ist eine Notiz, die Herr Leroy vor über einem halben Jahr bei uns hinterlassen hat. Alle, die an dieser Straße leben und arbeiten, kennen ihn gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490111
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490111,
					"content": "In seiner Jugend hatte er zwar einen schlechten Ruf, aber ich habe in den letzten Jahren keine unangenehmen Gerüchte über ihn gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490112
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490112,
					"content": "Er war die meiste Zeit seines Lebens allein, und da seine einzige Tochter nicht an seiner Seite ist, gibt es auch niemanden, der sich um ihn kümmert. Daher wäre ein gelegentlicher Helfer sehr nützlich für ihn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490113
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490113,
					"content": "Soweit ich weiß, ist er nicht knapp bei Kasse, du wirst also gut entlohnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490114
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490114,
					"content": "Außerdem glaube ich nicht, dass diese Arbeit ein Risiko birgt. Warum also nicht einen Versuch wagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490115
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490115,
					"content": "Wir müssen ihm also nur bei der Hausarbeit helfen, richtig? Paimon findet diese Arbeit toll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490116,
					"content": "Gib mir bitte seine Adresse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490117
					]
				},
				{
					"id": 741490117,
					"content": "Natürlich. Geh in diese Richtung, biege an dieser Ecke ab und geh weiter, dann solltest du an der nächsten Ecke ... Ach, vergiss es. Lass mich dir stattdessen eine Karte geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490118
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490118,
					"content": "Vergiss nicht, ihm zu sagen, dass ich dich ihm vorgestellt habe, in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490105,
					"content": "Beides, eigentlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490106
					]
				},
				{
					"id": 741490106,
					"content": "#Du bist also {F#eine sehr fleißige junge Frau}{M#ein sehr fleißiger junger Mann}, na gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "Euphrasie"
				}
			]
		},
		{
			"id": 7414902,
			"completionStepIds": [
				7414902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
