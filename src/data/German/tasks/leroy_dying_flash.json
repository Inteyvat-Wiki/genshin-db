				"points": []
			},
			"dialogs": [
				{
					"id": 741490701,
					"content": "Habt ihr vergessen, worum ich euch gebeten hatte? Ah, das Gedächtnis der Kinder, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490702
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490702,
					"content": "Die erste Sache ist, den Schmutz in der Nähe der Tür und hinter dem Haus zu beseitigen. Die zweite Sache ist, meine Katze, Nana, mit Fisch zu füttern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				}
			]
		}
	]
}