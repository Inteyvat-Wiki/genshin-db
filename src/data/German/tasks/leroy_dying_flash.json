			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Benoit Leroy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490201,
					"content": "Athos’ Hemd, eintausend Mora ... und Morticias Collier ... Tss, die Jugend von heute weiß genau, wie man Geld ausgibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490202
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490202,
					"content": "Guten Tag, Herr Leroy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490203
					]
				},
				{
					"id": 741490203,
					"content": "Guten Tag! Fräulein Euphrasie hat uns geschickt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490204,
					"content": "Ihr sagt Herrn Leroy, warum ihr hier seid.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741490205
					]
				},
				{
					"id": 741490205,
					"content": "Haha, das ist doch schon ein halbes Jahr her, oder? Ich hätte nicht gedacht, dass Fräulein Euphrasie das Auftragsformular, das ich damals ausgestellt habe, noch behalten würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490206
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490206,
					"content": "Ja, ja, ich wollte eine Haushaltshilfe einstellen. Egal, wie stark und fähig man in jungen Jahren ist, der Tag wird kommen, an dem man von anderen versorgt werden muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490207
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490207,
					"content": "Ich habe mein ganzes Leben lang hart gearbeitet und mir dieses Haus verdient. Aber im Alter habe ich gemerkt, dass mir in diesem leeren Gebäude nichts anderes als Einsamkeit geblieben ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490208
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490208,
					"content": "Das hat mich eine Zeit lang ziemlich traurig gemacht. Aber jetzt ist alles gut, meine Tochter und mein Schwiegersohn sind gekommen, um sich um mich zu kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490209
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490209,
					"content": "Sie sind sehr gute Kinder und ein schönes Paar. Mit ihrer Gesellschaft gibt es nichts, worüber ich mich beschweren könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490210
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490210,
					"content": "Also, gutes Kind, ich stelle keine Haushaltshilfe mehr ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490211,
						741490212
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490211,
					"content": "Ach, der ganze Weg hierher war umsonst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				},
				{
					"id": 741490213,
					"content": "Nun, seid nicht so enttäuscht. Ich möchte wirklich keine jungen Leute seufzen sehen, ihr solltet lächeln und euch über alles Schöne freuen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490214
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490214,
					"content": "Da ihr den Weg hierher gemacht habt und Fräulein Euphrasie euch empfohlen hat, habe ich in der Tat etwas Arbeit für euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490215
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490215,
					"content": "Zufälligerweise sind die beiden Kinder gerade nicht da und ich kann mich hier nicht um alles kümmern. Keine Sorge, ihr werdet bezahlt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490216
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490216,
					"content": "Oha, Herr Leroy, du bist wirklich ein netter Mensch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490217,
					"content": "Haha, wie lieb von dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490218
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490218,
					"content": "Gut, dann helft mir bitte, den Schmutz in der Nähe der Tür und hinter dem Haus zu beseitigen und füttert Nana mit Fisch, wenn ihr schon dabei seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490219
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490219,
					"content": "Nana ist meine Katze. Die, die da an der Tür sitzt. Ich danke euch im Voraus in ihrem Namen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490220
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490220,
					"content": "Das klingt ganz einfach. Kein Problem! Überlass das uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490212,
					"content": "Hach, Fräulein Euphrasie ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				}
			]
		},
		{
			"id": 7414905,
			"completionStepIds": [
				7414905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
