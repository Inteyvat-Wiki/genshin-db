			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Benoit Leroy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490501,
					"content": "Seid ihr fertig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490502
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490502,
					"content": "Ja, Herr Leroy, also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490503,
					"content": "Möchtest du ein paar Süßigkeiten? Oder möchtest du etwas Taschengeld?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490504
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490504,
					"content": "Paimon möchte beides, hehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490505,
					"content": "*seufz* Paimon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490506
					]
				},
				{
					"id": 741490506,
					"content": "Haha, was für ein gieriges Kind. Aber das ist in Ordnung, genau so sollten kleine Kinder sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490507
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490507,
					"content": "Vor allem so süße kleine Damen wie du, Paimon. Du solltest in einem schönen Haus sitzen, ein hübsches Kleid tragen und Macarons genießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490508
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490508,
					"content": "#Da kann Paimon nur zustimmen! {NICKNAME}, hehe, also ... darf Paimon ein paar ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490509,
					"content": "Das darfst du nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490510
					]
				},
				{
					"id": 741490510,
					"content": "#Waaah! {NICKNAME}! Geizhals!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490511,
						741490512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490511,
					"content": "#Paimon, vergiss nicht, dass wir {F#Abenteurerinnen}{M#Abenteurer} sind ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				},
				{
					"id": 741490513,
					"content": "Und? Was hat das mit Macarons, hübschen Kleidern und großen schönen Häusern zu tun? Hmpf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490514,
					"content": "Ach, Kinder, hört auf zu streiten. Tss, tss, wie kindisch ... Aber ein bisschen Geplänkel ab und zu ist auch gut, es zeigt, dass ihr noch Kinder seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490515,
						741490516
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490515,
					"content": "Ähm, über mein Alter ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490517,
					"content": "Schätzt eure Kindheit, denn sie wird nicht ewig dauern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490518
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490518,
					"content": "Nun, nun ... Süßigkeiten und Taschengeld für euch beide. Benehmt euch jetzt gut, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490519
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490519,
					"content": "Juhu! Süßigkeiten! Danke, Herr Leroy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490520,
					"content": "Nennt mich einfach Benoit. Leroy ist mein Nachname.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490521
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490521,
					"content": "Da ich der letzte Leroy am ganzen Hof von Fontaine bin, würde die Erwähnung meines Familiennamens diese arme alte Seele nur noch einsamer machen. Also bitte, benutzt einfach meinen Vornamen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490522
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490522,
					"content": "Hä? Ist der Nachname deiner Tochter nicht Leroy, Herr Le... ähm, Benoit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490523,
					"content": "Morticia ist nicht meine Blutsverwandte. Ich habe sie vor einem halben Jahr bei mir aufgenommen. Aber für mich ist sie wie meine echte Tochter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490524
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490524,
					"content": "Wenn es euch nichts ausmacht, könnt ihr morgen wiederkommen. Morticia und Athos sollten bis dahin zurück sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490525
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490525,
					"content": "Ich bin mir sicher, dass Morticia nichts dagegen hat, wenn zwei nette Kinder wie ihr vorbeikommen, um bei der Hausarbeit zu helfen und ein paar Leckereien zu essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490526
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490526,
					"content": "Manchmal kommen auch andere Kinder vorbei, ihr könnt dann gern mit ihnen spielen. Ich liebe es, wenn Kinder vorbeikommen, sie machen das Haus lebendig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490527
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490527,
					"content": "Wenn ihr mich bei eurem nächsten Besuch nicht seht, klopft einfach an die Tür. Athos wird euch die Tür öffnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490528
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490528,
					"content": "Abgemacht! Dann kommen wir morgen wieder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490529,
					"content": "Gut, abgemacht ... Es wird auch für mich Zeit, zurück ins Haus zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490530
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490530,
					"content": "Bis morgen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490531
					]
				},
				{
					"id": 741490531,
					"content": "Bis morgen, Kinder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490516,
					"content": "Es ist auch ein Beweis für unsere Freundschaft.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490512,
					"content": "Paimon, vergiss nicht den Zweck unserer Reise ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				}
			]
		},
		{
			"id": 7414907,
