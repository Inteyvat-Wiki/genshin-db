			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150101,
					"content": "Es ist an der Zeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150102
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150102,
					"content": "Oho, willkommen. Wie kann ich helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150103
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150103,
					"content": "Hm, ich verstehe. Du willst nur herumschauen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150104
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150104,
					"content": "Nun, dies ist die bescheidene Detektei Bantan Sango. Und ich bin ein Detektiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150105,
						220150108
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150105,
					"content": "Wer bist du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150106
					]
				},
				{
					"id": 220150106,
					"content": "Mein Name ist Sango und ich bin die Präsidentin dieser Detektei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150107
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150107,
					"content": "Nun, ich nenne mich selbst den Präsidenten, aber diese Detektei hat nur zwei Mitarbeiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150113
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150113,
					"content": "Ist das das erste Mal, dass du eine Detektei siehst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150108,
					"content": "Was tust du als Detektiv?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150109
					]
				},
				{
					"id": 220150109,
					"content": "Hm, das ist eine gute Frage. Aus der Sicht der Allgemeinheit muss die Detektivarbeit ziemlich speziell und geheimnisvoll erscheinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150110
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150110,
					"content": "Aber was mich betrifft, ist es wie jede andere Arbeit auch. Es bezahlt die Rechnungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150111
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150111,
					"content": "Das heißt, die Arbeit ist manchmal etwas ungewöhnlich und die Kunden sind gelegentlich bemerkenswerte Persönlichkeiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150112
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150112,
					"content": "Aber ansonsten ist es eine Art, seinen Lebensunterhalt zu verdienen, wie jede andere auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150113
					],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 2201502,
			"completionStepIds": [
				2201504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201504",
							"2"
						],
						"stepId": 2201504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150205,
					"content": "Ah. Du bist der Assistent, von dem Sango gesprochen hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150206,
					"content": "Du hast mich erwartet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150207
					]
				},
				{
					"id": 220150207,
					"content": "Na ja ... nicht wirklich. Es ist nur so, dass Sango gesagt hat, dass jemand kommen würde, um zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150208
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150208,
					"content": "He, was macht ihr da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150209
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150209,
					"content": "Sind das Schatzräuber? Warum sind sie so nah an der Stadt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150210
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150210,
					"content": "#Ryuuji, warum bist du hier? Und {F#diese}{M#dieser} verdächtige Fremde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150211,
						220150213
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150211,
					"content": "Redest du mit mir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150212
					]
				},
				{
					"id": 220150212,
					"content": "#Ja, ich meine, du bist {F#die}{M#der} einzige Fremde hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150215
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150215,
					"content": "In Ordnung, lass uns nicht übermäßig empfindlich sein. Ryuuji, was führt dich hierher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150216
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150216,
					"content": "Ich bin hier nach Sangos Anweisungen einer verdächtigen Person gefolgt, aber dann bin ich auf ein paar Schatzsucher gestoßen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150217
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150217,
					"content": "#{F#Die}{M#Der} Reisende ist {F#eine Assistentin}{M#ein Assistent}, {F#die}{M#der} von Sango eingeladen wurde. Wir haben die Schatzsucher einfach zusammen vertrieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150218
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150218,
					"content": "Ich verstehe ... Aber warum sollte es Schatzräuber in der Nähe geben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150219
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150219,
					"content": "Ryuuji, du hast gerade erwähnt, dass du einigen verdächtigen Leuten gefolgt bist ... He! Bist du den Schatzräubern von der Stadt aus gefolgt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150220
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150220,
					"content": "Ich denke schon. Sango hat sich mit einem Fall von Seriendiebstahl beschäftigt. Ich habe die Stadt auf Grund ihrer Vermutung durchsucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150221
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150221,
					"content": "Kurz darauf entdeckte ich einen verdächtigen Mann in der Nähe von Hanamizaka. Nachdem ich ihm ein paar Fragen gestellt hatte, geriet er in Panik und ergriff schnell die Flucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150222
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150222,
					"content": "Ich bin ihm aus der Stadt gefolgt und ihr wisst alle, was danach passiert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150223
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150223,
					"content": "Hmm ... Ryuuji, wieso kannst du plötzlich so gut reden? Du warst doch vorher kein großer Redner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150224
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150224,
					"content": "Die Arbeit mit Sango macht dich zu einem guten Sprecher, wie ich sehe, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150225,
						220150228
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150225,
					"content": "Was macht ihr zwei hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150226
					]
				},
				{
					"id": 220150226,
					"content": "Andou sagte, dass eine verdächtige blonde Person von außerhalb in der Stadt herumläuft, also sind wir gekommen, um uns das anzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150227
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150227,
					"content": "Deshalb sind wir dir gefolgt, aber wie sich herausstellt, bist du Sangos Assistent. Tut mir leid für das Missverständnis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150232
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150232,
					"content": "Ah ... Ryuuji, du hast gesagt, dass du die verdächtige Person in der Stadt gefunden hast, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150233
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150233,
					"content": "Das ist korrekt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150234
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150234,
					"content": "Wie können sie es wagen, ihre Pfoten in unserer Stadt zu versenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150235
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150235,
					"content": "Ja. Aber wenn es nur ... wir sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150236,
						220150237
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150236,
					"content": "(Warum ist er plötzlich so sprachlos?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150238
					]
				},
				{
					"id": 220150238,
					"content": "Hmm ... Trotzdem können wir nur ein oder zwei Schatzräuber alleine vertreiben. Um sie komplett loszuwerden, müssen wir uns auf euch verlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150239
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150239,
					"content": "Wenn du die Beweise sehen willst, kannst du in die Stadt gehen und nach Sango suchen. Sie wird dir alles im Detail erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150240
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150240,
					"content": "Hmm ... Amano, lass uns nach Sango suchen gehen. Wenn es wirklich Schatzräuber in der Stadt gibt, sollten wir etwas unternehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150241
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150241,
					"content": "Ja ... ja, das ist richtig! Lass uns Sango suchen gehen. Ryuuji, du solltest auch bald zurückgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150242
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150242,
					"content": "... Puh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150243
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150243,
					"content": "Wir müssen jetzt gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150244
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150244,
					"content": "Die Dinge, die du gerade gesagt hast ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150245
					]
				},
				{
					"id": 220150245,
					"content": "Sango bat mich, sie zu sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150246
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150246,
					"content": "Wir haben unseren Teil getan, also lass uns zurückgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150237,
					"content": "(Er scheint vergessen zu haben, was er gesagt hat ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150238
					]
				},
				{
					"id": 220150228,
					"content": "Du bist also auch hier einer verdächtigen Person gefolgt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150229
					]
				},
				{
					"id": 220150229,
					"content": "Das kannst du so sagen. Obwohl die verdächtige Person, die wir verfolgten, eigentlich du warst. Ähem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150230
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150230,
					"content": "Andou sagte, dass eine verdächtige blonde Person von außerhalb in der Stadt herumläuft, also sind wir gekommen, um uns das anzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150231
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150231,
					"content": "Deshalb sind wir dir gefolgt. Ich wusste nicht, dass du Sangos Assistentin bist. Entschuldigung für das Missverständnis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150232
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150213,
					"content": "#Ich bin {F#die Assistentin}{M#der Assistent} von Sango.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150214
					]
				},
				{
					"id": 220150214,
					"content": "#Sangos {F#Assistentin}{M#Assistent}? Das klingt jetzt noch verdächtiger ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150215
					],
					"speakerTitle": "Andou"
				}
			]
		},
		{
			"id": 2201503,
			"completionStepIds": [
				2201505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201505",
							"2"
						],
						"stepId": 2201505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150301,
					"content": "Fräulein Sango, ist das wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150302
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150302,
					"content": "Sind die Serieneinbrüche in der Stadt wirklich das Werk von Schatzräubern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150303
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150303,
					"content": "Das ist ganz sicher. Ich habe dir gerade die Beweise gezeigt, ich bin mir sicher, dass du das mit deinem professionellen Instinkt schon herausgefunden haben solltest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150304
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150304,
					"content": "Die Schatzräuber ... wie können sie es wagen! Sie haben überhaupt keinen Respekt vor uns, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150305
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150305,
					"content": "Amano! Lass uns zurückgehen und das berichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150306
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150306,
					"content": "Wir müssen unsere Patrouillen verstärken. Wir können diesen Idioten kein einziges Schlupfloch geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150307
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150307,
					"content": "Fräulein Sango, dürfen wir uns die Beweise ausleihen? Wir brauchen sie, um die Höheren zu überzeugen, etwas zu unternehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150308
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150308,
					"content": "Kein Problem, mach weiter. Es liegt nicht in den Möglichkeiten unserer Agentur, mit den Schatzräubern umzugehen. Dafür müssen wir uns auf die Polizei verlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150309
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150309,
					"content": "Bitte sei versichert! Wir werden keinen der Schatzräuber entkommen lassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150310
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150310,
					"content": "Danke dir. Nun ... sollte alles bereit sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150311,
						220150313
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150311,
					"content": "Bist du bereit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150312
					]
				},
				{
					"id": 220150312,
					"content": "Ja. Die beiden Doushins von der Polizeiwache sind wichtige „Helfer“ beim Abschluss dieses Falles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150316
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150316,
					"content": "Nachdem die beiden Doushins ihre Patrouillen verstärkt haben, werden die Schatzräuber der Stadt in höchster Alarmbereitschaft sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150317
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150317,
					"content": "Ryuuji, du hast mit den Schatzräubern an dem Ort gekämpft, an den ich dich gebeten habe, zu gehen, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150318
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150318,
					"content": "Ja. Der Reisende und ich haben sie abgewehrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150319
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150319,
					"content": "Hmm ... das ist gut. Du hast wahrscheinlich einen ziemlichen Aufschwung erlebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150320
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150320,
					"content": "Alles was wir jetzt tun müssen, ist auf unsere Chance zu warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150321
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150321,
					"content": "Danke für deine Hilfe, Reisender. Hier ist deine Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150322
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150322,
					"content": "Ich bin mir nicht sicher, ob ich etwas getan habe, um zu helfen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150323
					]
				},
				{
					"id": 220150323,
					"content": "Sag das nicht. Du hast die Aufmerksamkeit von Andou auf dich gezogen, indem du ein Fremder warst und ihn und Amano dazu gebracht hast, dich zu jagen und sich mit Ryuuji zu treffen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150324
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150324,
					"content": "Dann sahen sie die Bedrohung durch die Schatzräuber mit eigenen Augen, was sie dazu veranlassen wird, die Patrouillen in der Stadt zu verstärken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150325
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150325,
					"content": "Das war alles etwas, was nur du hättest tun können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150326
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150326,
					"content": "Schließlich war es effektiver, die Doushins das selbst erleben zu lassen, als dass ich es ihnen nur erzählte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150327
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150327,
					"content": "Wie auch immer, nimm die hier. Wer weiß? Vielleicht brauche ich deine Hilfe irgendwann wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150313,
					"content": "Was hast du vor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150314
					]
				},
				{
					"id": 220150314,
					"content": "Ich bin ein Detektiv, also habe ich natürlich vor, den Fall zu lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150315
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150315,
					"content": "Die beiden Doushins von der Polizeiwache sind wichtige „Helfer“ beim Abschluss dieses Falles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150316
					],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 2201505,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
