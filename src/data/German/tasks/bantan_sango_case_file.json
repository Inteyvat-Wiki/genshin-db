					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150501,
					"content": "Ich habe in meiner ganzen Zeit in Mondstadt keinen einzigen Detektiv getroffen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150502
					]
				},
				{
					"id": 220150502,
					"content": "Oh, du meinst Mondstadt. Davon habe ich schon gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150503
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150503,
					"content": "Die zwei berühmtesten Dinge an Mondstadt sind Wein und Freiheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150504
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150504,
					"content": "Hahaha, diese beiden Dinge ergänzen sich wirklich gut ... Ich vermute, wenn es in Mondstadt Detektive gäbe, würde ihr Geschäft jeden Tag boomen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 2201506,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201501",
							"2"
						],
						"stepId": 2201501,
						"stateName": "QUEST_STATE_UNFINISHED"
