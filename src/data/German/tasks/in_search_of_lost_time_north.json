			"dialogs": [
				{
					"id": 740540801,
					"content": "Hebel ziehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740540802
					]
				},
				{
					"id": 740540802,
					"content": "#Ach, {NICKNAME}, was machst du da!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740540803,
					"content": "Du ziehst ohne zu zögern den Hebel.\\nIm nächsten Moment beginnt der ganze Turm, begleitet von einem donnernden Grollen, heftig zu beben, als wäre der Himmel hereingebrochen und die Erde aufgerissen ...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740540804
					]
				},
				{
					"id": 740540804,
					"content": "Dann ... spuckt die Maschine mit einem Knall einen Stapel Papierstreifen genau in deine Hände.\\nUnd alles ist wieder ruhig.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740540805
					]
				},
				{
					"id": 740540805,
					"content": "Das ist ... alles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740540806,
					"content": "Hm ... Paimon hat keine Ahnung, was darauf eingeritzt ist, aber es scheint wichtig zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740540807,
					"content": "#{NICKNAME}, sollten wir die Papierstreifen nicht vorerst behalten? Vielleicht können wir sie ja später noch gebrauchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
