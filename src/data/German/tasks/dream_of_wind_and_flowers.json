				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130201,
					"content": "Jean, wir sind da!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130202,
					"content": "#{F#Reisende}{M#Reisender}! Ah, entschuldige bitte. Unter den Umständen muss ich dich als „Ehrenritter“ ansprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130203
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130203,
					"content": "Du hast es sicher schon gehört? Du bist der diesjährige Windblumenstar. Du wirst dem Anemo-Archon Barbatos im Namen von ganz Mondstadt eine Windblume darbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130204
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130204,
					"content": "Allerdings ... sind die Dinge dieses Mal ein wenig anders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130205
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130205,
					"content": "Ja, ja! Da wir und der Straßenmusikant hier sind, wird das diesjährige Windblumenfest mit Sicherheit noch besser werden als je zuvor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130206,
					"content": "Das stimmt. Ich danke dir, dass du dich in Mondstadt niedergelassen hast, und ich wünsche dir weiterhin viel Freude am Leben in Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130207
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130207,
					"content": "Die Windblumen-Zeremonie fängt gleich an. Windblumenstar, hast du deine Windblume gewählt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130208
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130208,
					"content": "Also wählen wir eine Blumenart und bieten sie dem Anemo-Archon dar, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130209,
					"content": "Exakt. Ich bitte dich, deine Wahl gut zu überdenken. Bitte bedenke, dass du die ganze Stadt Mondstadt repräsentierst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130210,
					"content": "Venti, welche Blumensorte magst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130211
					]
				},
				{
					"id": 414130211,
					"content": "Hm? Sehr schlau, versuchst wohl zu betrügen, was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130212,
					"content": "Ähem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130213
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130213,
					"content": "He! Ihr beiden solltet an solch einem Ort keine Geheimnisse ausplaudern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130214,
					"content": "Haha, jetzt wissen wir Bescheid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130215,
					"content": "Mach dir keine Gedanken um mich, such dir etwas aus, was dir gefällt. Ich vertraue deinem Geschmack.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130216
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130216,
					"content": "Also, Ehrenritter, wie lautet deine Wahl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130217,
						414130219,
						414130221,
						414130223,
						414130225,
						414130227
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130217,
					"content": "Löwenzahn",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130218
					]
				},
				{
					"id": 414130218,
					"content": "Aha! Du setzt dich für einen der Lieblinge des Volkes ein! Windblumen sind wohl doch Löwenzahn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130229,
					"content": "Im Namen der Bürger von Mondstadt möchte ich dich bitten, der Statue deine Windblume darzubringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130219,
					"content": "Windmühlenaster",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130220
					]
				},
				{
					"id": 414130220,
					"content": "Aha! Du setzt dich für einen der Lieblinge des Volkes ein! Windblumen sind wohl doch Windmühlenastern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130221,
					"content": "Cecilia",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130222
					]
				},
				{
					"id": 414130222,
					"content": "Oh! Die gleiche Idee wie Beatrice, Cecilias als Windblume. Ein wenig unbeliebt, aber nicht ohne Fürsprecher!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130223,
					"content": "Lampenkraut",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130224
					]
				},
				{
					"id": 414130224,
					"content": "Oh! Die gleiche Idee wie Nimrod, Lampenkraut als Windblumen. Eine Blume, die Licht in die Dunkelheit bringt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130225,
					"content": "Zuckerblume",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130226
					]
				},
				{
					"id": 414130226,
					"content": "Oh! Die gleiche Idee wie Saccharose, Zuckerblumen als Windblumen. Eine Blume, welche die Zeiten überdauert hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130227,
					"content": "Wolfshaken",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130228
					]
				},
				{
					"id": 414130228,
					"content": "Oh! Die gleiche Idee wie Razor, Wolfshaken als Windblumen. Stachelig und prickelnd!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4141304,
			"completionStepIds": [
				4141304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141304",
							"2"
						],
						"stepId": 4141304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130401,
					"content": "Danke, Windblumenstar, für dein ehrfürchtiges Windblumenopfer an den Anemo-Archon Barbatos. Der Wind möge Mondstadt beschützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130402
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130402,
					"content": "Gute Wahl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130403
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130403,
					"content": "Du magst sie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130404
					]
				},
				{
					"id": 414130404,
					"content": "Hehe, willst du raten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130405,
					"content": "Du Schelm! Hör auf, die Leute ständig raten zu lassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130406,
					"content": "Ahahahaha! Ist schon gut, ich sag’s dir. Aber nicht hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130407,
					"content": "Das ist keine gute Idee, wenn so viele Menschen auf dem Platz sind. Lass uns lieber woanders hingehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130408,
					"content": "Wo sollen wir hingehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130409,
					"content": "Ich möchte, dass du mit mir zu den Sturmschreckenruinen kommst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 4141307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141307",
							"2"
						],
						"stepId": 4141307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130701,
					"content": "Ah ... das ist doch mal eine schöne Aussicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130702,
						414130703
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130702,
					"content": "Die Landschaft ist herrlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				},
				{
					"id": 414130704,
					"content": "Nicht wahr? Ich liebe diesen Ort. Wenn ich nichts zu tun habe, dann komme ich manchmal hierher, um einfach nur dazusitzen und den Blick schweifen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130705,
					"content": "Du meinst herumsitzen und faulenzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130706,
					"content": "Hahaha, schuldig im Sinne der Anklage!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130707,
					"content": "Das ist so schön ... wenn wir doch nur etwas Apfelwein dabeihätten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130708
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130708,
					"content": "#Also, {F#Reisende}{M#Reisender}. Wie gefällt dir das? Das Windblumenfest in Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130709,
						414130710
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130709,
					"content": "Es ist voller Lebensfreude und Liebe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130711,
					"content": "Und du möchtest doch noch etwas fragen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130712
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130712,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130713
					]
				},
				{
					"id": 414130713,
					"content": "Ich ahne deine Frage. Was genau sind Windblumen? Und welche Bedeutung haben Windblumen und das Windblumenfest für Barbatos, den Anemo-Archon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130714,
					"content": "Wie du siehst, trifft jeder der Bewohner von Mondstadt seine eigene Wahl. Aus den Millionen von Blumen, die es gibt, entscheiden sich die einen für den Löwenzahn, die anderen für die Windmühlenaster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130715
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130715,
					"content": "Es ist wohl wirklich so, dass „Windblume“ für jeden Menschen etwas sehr Persönliches bedeutet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130716,
					"content": "Das ist richtig, und so soll es auch bleiben. Es gibt keine eindeutige Antwort und keine „richtige“ Windblume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130717
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130717,
					"content": "Also gibt es Windblumen ... nicht wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130718,
					"content": "Das Wort „Windblume“ stammt aus der Zeit der alten Mondstadt. Es war ein Codewort, mit dem die Menschen in Kontakt blieben und im Geheimen Widerstand leisteten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130719,
					"content": "Zu jener Zeit hieß es oft: „Je stärker der Wind weht, desto fester wachsen die Wurzeln der Windblume und desto schöner erblühen die Blumen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130720
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130720,
					"content": "Wenn Du mich fragst: Windblumen gibt es nicht. Aber trotzdem sind sie überall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130721
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130721,
					"content": "Sie stehen für die Sehnsucht nach Freiheit, den Mut, dem Wind zu folgen, wohin er auch führt ... Alle Dinge, die schön und würdig sind, gesegnet zu werden ... Alle können Windblumen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130722
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130722,
					"content": "Man sieht sie nicht, aber man spürt, dass sie immer da sind ... genau wie der Wind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130723,
					"content": "Haha, gut gesagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130724
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130724,
					"content": "Also, was sind Windblumen? Eine Sache, die der Anemo-Archon Barbatos nicht festlegen will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130725
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130725,
					"content": "Blumen des Segens, Blumen des Respekts, Blumen der Liebe. Alle Menschen haben ihre persönlichen Windblumen und jeder Mensch hat das Recht, sie für sich zu definieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130726
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130726,
					"content": "Es verwundert wohl nicht, dass die Blumenart, welche die Stadt der Freiheit ihrer Gottheit schenkt, selbst ein Ausdruck der Freiheit ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130727,
					"content": "Ich liebe auch das Gefühl der Freiheit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130728
					]
				},
				{
					"id": 414130728,
					"content": "Ich weiß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130729,
					"content": "Es ist der geteilte Wille der Menschen, der sie eint. Und sicherlich ist es der Wind der Freiheit, der uns geeint hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130730
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130730,
					"content": "Es stammt vom Ende der Reise, von der Grenze der Welt, aus den Tiefen unserer Herzen. Es ist endlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130731
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130731,
					"content": "„Wer war es, der dein blut’ges, steinernes Antlitz streichelte\\nam Bach, der leise fließt,\\nam Felsen, der tapfer steht?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130732
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130732,
					"content": "„Wer war es, der deine müde, edle Seele umarmte\\nin tiefsten Träumen\\nin Himmeln schwebend?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130733
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130733,
					"content": "„Liebster Freund,\\nich nehme dich an die Hand\\nin der Nacht, in der Laternen strahlen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130734
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130734,
					"content": "„Und ich erzähle dir eine Geschichte von Freiheit und Träumen,\\ndie Geschichte, mit der dieses Fest beginnt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130710,
					"content": "Es ist großartig, mit den Leuten unterwegs zu sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130703,
					"content": "Es ist eine sehr angenehme Umgebung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				}
			]
		},
