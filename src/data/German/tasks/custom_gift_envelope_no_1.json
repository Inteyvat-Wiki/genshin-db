			"dialogs": [
				{
					"id": 715330101,
					"content": "Hm, das scheint auch nicht richtig zu sein ... Diese Glückwunschkarten sind echt schwer zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330102
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330102,
					"content": "Mika, machst du Glückwunschkarten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330103
					]
				},
				{
					"id": 715330103,
					"content": "#{NICKNAME}! Was für ein Zufall! Ich habe nicht damit gerechnet, dich hier zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330104
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330104,
					"content": "Bist du wegen des Laternenrituals hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330105
					]
				},
				{
					"id": 715330105,
					"content": "Oh, das nicht, nein. Ich bin hier, um einen Brief zu überbringen, und dass jetzt das Laternenritual ist, war Zufall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330106
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330106,
					"content": "Klee sagte, sie wolle unbedingt eine Glückwunschkarte für das Laternenritual, also habe ich überlegt, eine für sie zu kaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330107
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330107,
					"content": "Allerdings war ich überrascht, als ich erfuhr, dass man sie selbst basteln muss ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330108
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330108,
					"content": "Ich habe lange versucht, eine Glückwunschkarte zu basteln, aber aus irgendeinem Grund scheint sie noch nicht ganz richtig zu sein. Ich kann allerdings nicht sagen, was ich falsch gemacht habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330109
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330109,
					"content": "#{NICKNAME}, du hast schon viel erlebt ... Kannst du mir ein paar Tipps geben, wie ich am besten so eine Glückwunschkarte bastle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330110
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330110,
					"content": "Darüber muss ich kurz nachdenken ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
