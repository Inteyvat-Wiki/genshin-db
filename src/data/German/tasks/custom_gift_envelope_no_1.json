			"dialogs": [
				{
					"id": 715330301,
					"content": "#Waah! Die Glückwunschkarte ist ja schön! Echt gut gelungen und auch noch so schnell, danke dir, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330302
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330302,
					"content": "... Oh nein! Ich muss jetzt los! Ich muss mich beim Ritterorden zurückmelden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330303
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330303,
					"content": "#Danke für die Hilfe, {NICKNAME}! Klee wird die Glückwunschkarte sicher lieben.",
