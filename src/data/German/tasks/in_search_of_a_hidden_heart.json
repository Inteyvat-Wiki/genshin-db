			"dialogs": [
				{
					"id": 751500901,
					"content": "Seid gegrüßt. Neue Kategorie von wiederhergestellten Daten erkannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500902
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751500902,
					"content": "... Eintrag zum Energiekern des „Quellapparats“ wurde aktualisiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500903
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751500903,
					"content": "Die Quellapparate ziehen ihre Energie hauptsächlich aus Phlogiston, wenngleich aus einer konzentrierten Form davon, die eher Licht ähnelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500904
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751500904,
					"content": "Durch die kontrollierte Reaktion „DATEN NICHT VORHANDEN“ können stabile „Phlogiston-Einheiten“ erzeugt werden, die eine noch präzisere Kontrolle der Energieabgabe ermöglichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500905
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751500905,
					"content": "Die Energie, die ein Quellapparat benötigt, hängt von seiner Größe und der Komplexität seiner Betriebslogik ab. Die Menge an Phlogiston-Einheiten, die ein Geheimquellen-Drachenknecht benötigt, ist „DATEN NICHT VORHANDEN“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500906
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751500906,
					"content": "Wobei die größeren Geheimquellen-Drachenstatuen weniger Phlogiston-Einheiten benötigen, nämlich genau drei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500907
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751500907,
					"content": "„Daten sind Energie und Energie sind Daten.“ Der Datenträger, den du zurückgeholt hast, zählt als eine Phlogiston-Einheit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500908
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751500908,
					"content": "Die Phlogiston-Einheit ist also der Feuerball ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751500909
					]
				},
				{
					"id": 751500909,
					"content": "Ja, das kann man so sehen. Ihr habt eine Phlogiston-Einheit wiederhergestellt, die vom Abgrund verunreinigt worden war. Erst dann konnte ich daraus etwas extrahieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500910
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751500910,
					"content": "Sie können auch als Ersatzenergie für vom Abgrund verunreinigte Quellapparate genutzt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				}
			]
		},
