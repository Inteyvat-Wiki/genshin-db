			"dialogs": [
				{
					"id": 751501101,
					"content": "Wo können wir diese Erlaubnis bekommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501102
					]
				},
				{
					"id": 751501102,
					"content": "Entsprechend der Vereinbarung und des Erlasses von Xiuhcoatl ist der Zugang zum ... Herzen des heiligen Berges, auch bekannt als „Huitzilopochtli“ ... den Nachkommen von ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501103
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501103,
					"content": "Begib dich zur „Aufsichtskammer“, um einen Antrag einzureichen und warte dann auf die Erteilung der Erlaubnis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501104
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501104,
					"content": "Wenn du dorthin gehen möchtest, kann ich dir gern die Position der „Aufsichtskammer“ markieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				}
			]
