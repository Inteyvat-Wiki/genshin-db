			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 751501301,
					"content": "Hast du vielleicht eine Frage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501302
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501302,
					"content": "Wie gelangt man in das Herz des heiligen Berges?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501303
					]
				},
				{
					"id": 751501303,
					"content": "Der Eingang zum Herzen des heiligen Berges befindet sich am neu ausgegrabenen Eingang ... In der tiefsten Spalte des Vulkans, wo er von einer Geheimquellen-Drachenstatue bewacht wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501304
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501304,
					"content": "Außerdem benötigt jeder Besucher des Herzens des heiligen Berges eine „Erlaubnis“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501305
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501305,
					"content": "Nur dann erhältst du die Anerkennung der Geheimquellen-Drachenstatue, die das Herz des heiligen Berges, auch bekannt als „Huitzilopochtli“, bewacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501306
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501306,
					"content": "Wo können wir diese Erlaubnis bekommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501307
					]
				},
				{
					"id": 751501307,
					"content": "Entsprechend der Vereinbarung und des Erlasses von Xiuhcoatl ist der Zugang zum ... Herzen des heiligen Berges, auch bekannt als „Huitzilopochtli“ ... den Nachkommen von ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501308
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501308,
					"content": "Begib dich zur „Aufsichtskammer“, um einen Antrag einzureichen und warte dann auf die Erteilung der Erlaubnis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501309
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501309,
					"content": "Was ist mit der Energiequelle, die die Geheimquellen-Drachenstatue benötigt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501310
					]
				},
				{
					"id": 751501310,
					"content": "Suche läuft ... Keine entsprechende Kategorie von Dateneinträgen vorhanden ... Oder die relevanten Daten sind, wie so viele andere, aufgrund der Abgrund-Korrosion in der Stadt verloren gegangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501311
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501311,
					"content": "Wenn du den Einfluss des Abgrunds entfernen und die Daten zurückholen kannst, findest du vielleicht die gesuchten Dateneinträge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501312
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501312,
					"content": "Ich habe dir einen potenziellen Datenspeicherort markiert. Bitte beseitige die dort vorhandene Abgrund-Korrosion, um das Datenspeichergebiet wiederherzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501313
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501313,
					"content": "Hast du vielleicht eine Frage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501314
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501314,
					"content": "Ich habe keine weiteren Fragen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501315
					]
				},
				{
					"id": 751501315,
					"content": "Verstanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				}
			]
		},
