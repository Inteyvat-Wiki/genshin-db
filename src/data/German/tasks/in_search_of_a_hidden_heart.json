				{
					"id": 751501503,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501504
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501504,
					"content": "Hehe, so schnell sieht man sich wieder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501505,
					"content": "... Tut mir leid, aber über euch wurden noch keine Informationen in meine Datenbank eingespeichert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501506
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501506,
					"content": "Menschen, die so tief bis hier vorgedrungen sind ... Das hat es seit mindestens fünfhundert Jahren nicht mehr gegeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501507
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501507,
					"content": "Warte, du bist nicht „Amaru“ ... aber auch nicht „Ehecatl“, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501508,
					"content": "... Es gab in der Tat Individuen, die so genannt wurden, aber ich bin keines von ihnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501509
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501509,
					"content": "Ich glaube, es gab da einige Missverständnisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501510
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501510,
					"content": "Ich bin ein Prototyp, der hergestellt wurde, um Xiuhcoatl beim Aufzeichnen von Informationen zu assistieren, daher habe ich keinen Namen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501511
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501511,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751501512,
					"content": "Also, nicht dass ich an sich keine Bezeichnung hätte. Ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501513
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501513,
					"content": "Ich bin der einzige intelligente Geheimquellen-Drachenknecht ohne Herrn. Selbst nachdem Xiuhcoatl gefallen war, kümmerte ich mich noch immer um die grundlegendsten Aufgaben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501514
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501514,
					"content": "Die grundlegenden Instandhaltungsarbeiten in der Stadt und die Aufzeichnung von Informationen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501515
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501515,
					"content": "Aber aufgrund der Invasion des Feindes, der in den Schatten lauert, sind einige der Aufzeichnung verloren gegangen. Daher habe gerade keine Daten zu meinem eigenen Namen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501516
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501516,
					"content": "Hm, da haben wir wohl wirklich den Falschen erwischt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501517,
					"content": "Das macht nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501518
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751501518,
					"content": "Hm, dieser Roboter ist zwar groß, aber er sieht nicht besonders schlau aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501519,
					"content": "#{NICKNAME}, das ist wahrscheinlich wirklich nicht dieser Kerl, der sich in den Maschinen versteckt und zu uns spricht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501520,
					"content": "Aber er hat doch selbst gesagt, dass er für die Aufzeichnung zuständig ist ... Also die Aufzeichnung von Informationen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501521,
					"content": "Wie wäre es, wenn wir ihn einfach fragen, was er weiß, oder ... wie wir in das Herz des heiligen Berges gelangen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501522,
						751501523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501522,
					"content": "Vielleicht ist das genau das, was „dieser Kerl“ meinte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501524
					]
				},
				{
					"id": 751501524,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751501523,
					"content": "Gut, dann fragen wir mal ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501524
					]
				}
