			"dialogs": [
				{
					"id": 751500401,
					"content": "Wie gelangt man in das Herz des heiligen Berges?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751500402
					]
				},
				{
					"id": 751500402,
					"content": "Der Zugang zum Herzen des heiligen Berges ist in der Nähe. Beim Wiedererschaffen der Stadt „Tollan“ grub Xiuhcoatl nach unten, um eine stabile Versuchsumgebung zu erzeugen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500403
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751500403,
					"content": "Dort wurde die ultimative Waffe für den Kampf gegen den Abgrund gebaut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500404
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751500404,
					"content": "Jedoch führte das Siegel dazu, dass diese Waffe tiefgreifend von der Abgrund-Korrosion befallen wurde. So wurde die Stadt übernommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500405
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751500405,
					"content": "Der Eingang zum Herzen des heiligen Berges befindet sich unter den Spalten in der heiligen Stadt ... Genau dort, wo die Korrosion unseres Feindes, der in den Schatten lauert, am tiefsten liegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				}
			]
		},
