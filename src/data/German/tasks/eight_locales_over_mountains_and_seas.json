	"talks": [
		{
			"id": 7267401,
			"completionStepIds": [
				7267401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267401",
							"2"
						],
						"stepId": 7267401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740101,
					"content": "Hallo, Ioroi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740102,
					"content": "Ih! Ich kann nicht glauben, dass ich entdeckt worden bin! Was ist das für ein Geruch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740103
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740103,
					"content": "Also seid ihr die jungen Leute! Ich habe euch schon lange nicht mehr gesehen und ich erkenne nicht einmal den Geruch wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740104
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740104,
					"content": "Ioroi hingegen hat sich überhaupt nicht verändert, er hat immer noch Angst beim Anblick von Menschen und ist in einem Felsen gefangen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740105,
					"content": "Was meinst du damit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740106,
						726740107
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740106,
					"content": "Ich hoffe, dein Siegel wird bald aufgehoben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740108
					]
				},
				{
					"id": 726740108,
					"content": "Das ist nur ein kleines menschliches Siegel! Wenn ich mich anstrenge ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740109
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740109,
					"content": "*hust*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740110
					]
				},
				{
					"id": 726740110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740111
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740111,
					"content": "Nun, wie auch immer. Die Kinder sagen, ein Gelbfell mit schönem Duft hat ihnen viel geholfen. Sie sind alle sehr froh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740112,
						726740113,
						726740114
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740112,
					"content": "Gelbfell ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740115,
					"content": "Ich hatte gedacht, dass alle Menschen so böse und furchterregend sind wie der Kerl, der meinen Bakedanuki-Klan versiegelt hat. Es scheint, dass es doch einige gute Menschen gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740116,
						726740117
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740116,
					"content": "Die meisten sind gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740118
					]
				},
				{
					"id": 726740118,
					"content": "#Ja, die meisten Leute, die Paimon mit {NICKNAME} getroffen habe, waren gute Leute. Ioroi wurde doch nur versiegelt, weil er den Kamm gestohlen hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740119,
					"content": "In aller Bescheidenheit, der Kamm wurde euch nun überreicht. Wenn du diesen Kerl triffst, der Zaubersprüche von Reizenbou gelernt hat, sprich mit ihm und bitte ihn, mich aus dem Stein zu holen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740120
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740120,
					"content": "Ich sitze hier nur wegen dieses Fuchses fest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740121
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740121,
					"content": "(Ioroi ist wie ein Opa, wenn er sich beschwert.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740122,
					"content": "(Er ist ja auch alt.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740123
					]
				},
				{
					"id": 726740123,
					"content": "Ihr wart an vielen Orten, oder? Schließlich wurdet ihr nicht versteinert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740124
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740124,
					"content": "Natürlich! Wir kommen von der anderen Seite des Meeres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740125,
					"content": "Ioroi wurden einige Geschichten von Mondstadt und Liyue erzählt.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740126
					]
				},
				{
					"id": 726740126,
					"content": "... Es gibt so viele Orte da draußen. Es ist erstaunlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740127
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740127,
					"content": "Die ganze Zeit über waren es nur die Bakedanuki, die mir Bericht erstatteten, ich hatte also keine Ahnung, wie es draußen aussah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740128
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740128,
					"content": "Früher, auf dem Yougou-Berg, sahen wir auf der anderen Seite des Meeres im Norden einen Berg, der so hoch und groß war, vielleicht sogar höher als der Yougou-Berg selbst, und wir fragten uns immer, was das wohl sei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740129,
						726740131
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740129,
					"content": "Dort ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740130
					]
				},
				{
					"id": 726740130,
					"content": "Das sollte der Drachengrat sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740132,
					"content": "Uff... allein der Klang davon beschert mir einen eisigen Schauer über dem Rücken. Ich weiß nicht, wie der Typ an so einen Ort gehen wollte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740133
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740133,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740134
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740134,
					"content": "Ähem. Wie ich schon sagte, ihr seid gute Leute, also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740135
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740135,
					"content": "Er will was von uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740136,
					"content": "Nun! Ich bin immerhin der verborgene Beschützer des Hains im Chinju-Wald, der von der Ogosho beauftragt wurde, den Wald zu bewachen, und wenn ich nicht in Stein versiegelt worden wäre, hätte ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740137,
						726740138
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740137,
					"content": "Können wir helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740143
					]
				},
				{
					"id": 726740143,
					"content": "Obwohl ich mich nicht frei bewegen kann, geht es den Kindern gut. Ich möchte euch bitten, mit den Kleinen draußen zu „üben“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740144
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740144,
					"content": "Nehmt einfach „Kichiboushi“ mit. Er hat seit eurem letzten gemeinsamen Aufenthalt davon gesprochen, euch wiederzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740145,
						726740146
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740145,
					"content": "Nun ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740147,
					"content": "Wir sprechen nicht die gleiche Sprache. Wird das ein Problem sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740148,
					"content": "Nein, er wird euch verstehen, aber nur ihr ihn nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740149
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740149,
					"content": "Gibt es denn sowas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740150,
					"content": "Aber als Reisegefährte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740151
					]
				},
				{
					"id": 726740151,
					"content": "Es wäre schon schön, wenn man miteinander reden könnte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740152
					]
				},
				{
					"id": 726740152,
					"content": "#Wie Paimon und {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740153
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740153,
					"content": "Hmm. Hat nicht vorher jemand die Magie der Bakedanuki benutzt, um euch Essen zu machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740154
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740154,
					"content": "Nun, solange ich euch noch Essen machen kann, damit ihr Kichiboushi versteht, passt es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740155
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740155,
					"content": "Ja, gutes Essen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740156,
					"content": "Ist nicht unbedingt gut ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740157
					]
				},
				{
					"id": 726740157,
					"content": "Unterschätzt mich nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740158
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740158,
					"content": "Es ist schwer zu beschreiben, woher Ioroi das Essen hergezaubert hat ...\\nJedenfalls hast du mit Paimon das Essen, das wohl sehr gut aussah, auf Iorois Bauch gegessen.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740159
					]
				},
				{
					"id": 726740159,
					"content": "Ooh, das ist toll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740160,
					"content": "Das steht fest. Ich war derjenige, der einmal die Vier Oni von Ogata mit einer Sashimi-Platte aus Schlammknödeln und Tanukifell getäuscht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740161
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740161,
					"content": "Stark! Aber woraus ist das Essen, was du gerade gemacht hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740162
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740162,
					"content": "Frag lieber nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740163
					]
				},
				{
					"id": 726740163,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740164
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740164,
					"content": "Macht nichts, lass uns mit Kichiboushi sprechen und nachsehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740146,
					"content": "Ich habe noch eine Frage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740138,
					"content": "Ich, nun, ähm ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740139
					]
				},
				{
					"id": 726740139,
					"content": "#Hmm, Paimon versteht {NICKNAME}! Irgendwelche Schätze?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740140,
					"content": "Ein Schatz? Das ist sicher, ich bin der Anführer von fünfhundertfünfzig Bakedanuki und ich habe nichts anderes als Schätze aus Inazuma gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740141
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740141,
					"content": "Wie können wir also helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740142
					]
				},
				{
					"id": 726740142,
					"content": "Wir helfen gern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740131,
					"content": "Das sollte der Drachengrat sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740132
					]
				},
				{
					"id": 726740117,
					"content": "Danke, vielen Dank!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740118
					]
				},
				{
					"id": 726740113,
					"content": "Schöner Duft ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740114,
					"content": "#Nicht Gelbfell, sondern {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740107,
					"content": "Paimon wollte damit sagen, dass Paimon hoffte, das Siegel würde früher aufgehoben werden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740108
					]
				}
			]
		},
		{
			"id": 7267402,
			"completionStepIds": [
				7267402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267402",
							"2"
						],
						"stepId": 7267402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Kichiboushi“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740201,
					"content": "Kichiboushi. Lange schon nicht mehr gesehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740202,
					"content": "Uh, Weißfell und Gelbfell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740203
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726740203,
					"content": "Gelbfell bin ich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740204
					]
				},
				{
					"id": 726740204,
					"content": "He, wer ist hier weiß?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740205,
					"content": "Oooh, sie verstehen mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740206
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726740206,
					"content": "#Ich bin {NICKNAME}, das ist Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740207
					]
				},
				{
					"id": 726740207,
					"content": "Merk dir das!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740208,
					"content": "Lavalendelmelone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740209
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726740209,
					"content": "Was für eine Melone? Was soll das bedeuten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740210,
					"content": "Nun, immerhin kann man sich unterhalten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740211,
					"content": "Na ja ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740212
					]
				},
				{
					"id": 726740212,
					"content": "#Wie auch immer, {NICKNAME}, lass uns zu Ioroi! Schließlich ist es an der Zeit, Kichiboushi auf eine lange Reise mitzunehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740213,
					"content": "Ioroi! Juhu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740214
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726740214,
					"content": "Juhu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7267403,
			"completionStepIds": [
				7267403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267403",
							"2"
						],
						"stepId": 7267403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740301,
					"content": "Was ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740302
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740302,
					"content": "Hii! Ich mag Weißfell und Gelbfell. Lavummelmelone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740303
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726740303,
					"content": "Lavummelmelone ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740304
					]
				},
				{
					"id": 726740304,
					"content": "Nicht schlecht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740305
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740305,
					"content": "Bumm-Bumm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740306
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726740306,
					"content": "Was heißt dieses Lavummelmelone?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740307
					]
				},
				{
					"id": 726740307,
					"content": "Das eine ist Bumm-Bumm, das andere ist Lavendelmelone ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740308
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726740308,
					"content": "Es scheint, dass ihr keine Probleme mehr mit der Kommunikation habt. Meine „Kochkünste“ sind so gut wie immer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740309,
						726740311
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740309,
					"content": "Es passt alles?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740310
					]
				},
				{
					"id": 726740310,
					"content": "Nein! Was Kichiboushi sagt, versteht Paimon nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740312,
					"content": "Also, es ist so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740313,
					"content": "Die Kommunikationsqualität wurde an Ioroi übermittelt.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740314
					]
				},
				{
					"id": 726740314,
					"content": "Nun gut, so ist das also. Keine Sorge, das liegt daran, dass ihr euch noch nicht an den Geruch von Kichiboushi gewöhnt habt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740315
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740315,
					"content": "Nehmt euch Zeit, euch daran zu gewöhnen! Je mehr ihr euch an den Geruch von Kichiboushi gewöhnt, desto besser werdet ihr verstehen, was er sagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740316
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740316,
					"content": "Wie lange soll das dauern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740317,
					"content": "Gute Frage, lass mich mal nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740318
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740318,
					"content": "Na ja, das braucht Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740319
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740319,
					"content": "Seid nicht zu ungeduldig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740320
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726740320,
					"content": "Ioroi weiß es also auch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740321
					]
				},
				{
					"id": 726740321,
					"content": "Hmpf! Ich bin ein Bakedanuki, der seit langer, langer Zeit lebt, ich rechne nicht so mit der Zeit wie ihr Menschen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740322
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740322,
					"content": "(Die meiste Zeit hat er im Stein verbracht ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740323,
					"content": "Warum kann Ioroi mit den Menschen kommunizieren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740324
					]
				},
				{
					"id": 726740324,
					"content": "Also wirklich. Die Frage ist, warum können Menschen mit mir sprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740325
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740325,
					"content": "Bakedanuki wie ich, die schon sehr, sehr lange leben und über große Macht verfügen, haben sich mehr oder weniger mit den Menschen auseinandergesetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740326
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740326,
					"content": "Vor langer, langer Zeit hatten wir es mit Tengu, Füchsen, Geistern, Dämonen und Menschen zu tun. Die Geschichte des Menschen, obwohl sie sich immer um den Menschen dreht, ist in Wirklichkeit zur Hälfte die Geschichte von als Menschen verkleideten Bakedanuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740327
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740327,
					"content": "Die Hälfte der verbleibenden Hälfte sind Geschichten über die Menschen selbst, die andere Hälfte sind Geschichten über Tengu, Füchse, Geister und andere Dämonen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740328
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740328,
					"content": "Die Hälfte dieser Hälfte ist jedoch auch die Geschichte unserer als Dämonen verkleideten Bakedanuki. Von allen Geschichten über die Bakedanuki ist die Hälfte die Geschichten über mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740329
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740329,
					"content": "Also bin ich der mächtigste. Mit euch reden zu können, ist ja wohl selbstverständlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740330
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740330,
					"content": "Ich verstehe. Fünf Sechzehntel sind alle deine Geschichten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740331
					]
				},
				{
					"id": 726740331,
					"content": "„Fünf Sechzehntel“ ... Ist das was zu essen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740332
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740332,
					"content": "Mhmm ... klingt echt lecker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740333
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726740333,
					"content": "#{NICKNAME} meint, dass das der Anteil deiner Geschichten ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740334,
					"content": "Ioroi, stark.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740335
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726740335,
					"content": "Was du nicht sagst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740336
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740336,
					"content": "Wenn Paimon es sich recht überlegt, versteht Paimon Kichiboushi ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740337,
					"content": "Du bist klug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740338
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726740338,
					"content": "Oooh, es fühlt sich komisch an, von Kichiboushi so gelobt zu werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740339,
					"content": "Das ist gut. Dieses Kind ist in euren Händen, nehmt es mit nach draußen zum Üben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740340
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740340,
					"content": "Als junger Bakedanuki besuchte ich die achtzehn heiligen Stätten von Inazuma wie der berühmte Bakedanuki Tsukumo in der Vergangenheit auf, wobei ich nie vom Pfad abwich. Das machte mich zu dem, was ich heute bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740341
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740341,
					"content": "Das ist also der Grund für die Versteinerung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740342,
					"content": "Hahah, Versteinerung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740343
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726740343,
					"content": "Was? Kichiboushi, auch du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740344
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740344,
					"content": "Zurück zum Geschäft! Was ist also der beste Ort, an den wir zuerst gehen können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740345,
						726740347
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740345,
					"content": "Ioroi hat eben gesagt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740346
					]
				},
				{
					"id": 726740346,
					"content": "Ja! Der Drachengrat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740348
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740348,
					"content": "„Weil dort der Berg ist“ Endlich mal eine Gelegenheit, solche Sätze souverän zu sagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740349,
					"content": "Der Berg ist dort!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740350
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726740350,
					"content": "Oooh, das klingt so kalt ... Kichiboushi, frier nicht deinen Bauch ein. Sonst holst du dir eine Erkältung. Wenn du erkältet bist, kannst du nicht bauchtrommeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740351
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740351,
					"content": "Halte dich an Gelbfell und iss immer gesund.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740352
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740352,
					"content": "Alles klar, mit Gelbfell, mache ich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740353,
						726740354,
						726740355
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726740353,
					"content": "Wir werden Kichiboushi beschützen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740356
					]
				},
				{
					"id": 726740356,
					"content": "Kichiboushi, pass gut auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740357,
					"content": "Ich passe gut auf euch auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740358
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726740358,
					"content": "War wohl ein Missverständnis ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740354,
					"content": "Keine Sorge, wir werden ihn gut umsorgen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740356
					]
				},
				{
					"id": 726740355,
					"content": "#Nicht Gelbfell, sondern {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740356
					]
				},
				{
					"id": 726740347,
					"content": "Wie ist der Drachengrat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740348
					]
				},
				{
					"id": 726740311,
					"content": "Es gibt noch große Probleme!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740312
					]
				}
			]
		},
		{
			"id": 7267404,
