			},
			"dialogs": [
				{
					"id": 726740401,
					"content": "Mit meinem speziellen Bakedanuki-Mahl kannst sogar du mit den kleinen Danuki sprechen. Sprich mit Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740402
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740402,
					"content": "Alles klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740403
					]
				},
				{
					"id": 726740403,
					"content": "Los geht’s, los geht’s. Ich kann sowieso nirgendwo anders hin, und ich habe viel Zeit, nicht wie die Kleinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ioroi"
				}
			]
		}
	]
