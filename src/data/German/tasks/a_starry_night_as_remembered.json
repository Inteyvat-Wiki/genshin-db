			"dialogs": [
				{
					"id": 790540401,
					"content": "Fotos ... Wo es jetzt diese wundersamen Dinge gibt, dann könnte man ja auch mühelos die Landschaft entlang des Wegs festhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540402
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540402,
					"content": "#Also, {NICKNAME}, hast du das Foto gemacht? Ich freue mich sehr auf den Sternenhimmel, den du dort fotografiert hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
