				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7905401",
							"2"
						],
						"stepId": 7905401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Jeroney"
				],
				"points": [
					{
						"sceneId": 10,
						"position": [
							-86.963,
							390.917,
							1393.968
						],
						"pointId": 69
					}
				]
			},
			"dialogs": [
				{
					"id": 790540101,
					"content": "Huch, wie seid ihr denn hergekommen? Hier gibt es keine Fahrbahnen und der Ort ist in sehr großer Höhe ganz am Rand der Veluriyam-Mirage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540102
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540102,
					"content": "Hier kommen nur sehr selten Leute her. Hmpf, ich wette, dass nicht einmal Idyia weiß, dass dieser Ort existiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540103
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540103,
					"content": "Gibt es hier denn gar nichts? Was machst du dann hier, Jeroney?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540104,
					"content": "Ich mache einfach nur einen Spaziergang ... He, schaut mich nicht mit diesem „Er hat sich doch etwa schon wieder mit Ferdinand gestritten, hat daher das Haus verlassen und ist hierhergekommen“-Blick an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540105
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540105,
					"content": "So war es nicht, wir haben uns wirklich nicht gestritten. Dass ich überall herumlaufe, geht auf ein, äh ... wie soll ich sagen ... persönliches Interesse zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540106
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540106,
					"content": "Ich glaube, ich habe das früher schon einmal erwähnt. Die ursprüngliche Idee für den „Tschu-Tschu-Express“ stammt von mir. Damals habe ich nach einem Mittel gesucht, um mühelos an hohe Orte zu gelangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540107
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540107,
					"content": "Also habe ich ... hat Jeroney sich den Express und die Fahrbahnen einfallen lassen, denn ich liebe den Himmel und hohe Orte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540108
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540108,
					"content": "Das muss euch wohl recht töricht vorkommen, oder? Ich erinnere mich, dass es in Inazuma ein Sprichwort gibt, irgendetwas darüber, dass nur Rauch und Leute mit schwachem Verstand gern gen Himmel ziehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540109,
						790540110
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540109,
					"content": "Du bist ein großartiger Erfinder.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				},
				{
					"id": 790540111,
					"content": "Ein solcher Express kann jedoch nur in der Veluriyam-Mirage gebaut werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540112
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540112,
					"content": "... Vergesst es, reden wir nicht davon. Es gibt noch einen weiteren Grund, warum ich hierhergekommen bin. Ich sehe mir von hier aus gerne das Firmament an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540113
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540113,
					"content": "Das Firmament in der Veluriyam-Mirage ist wahrscheinlich nur eine Spiegelung des Sternenhimmels außerhalb der Flasche, aber für mich ist es trotzdem schön genug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540114
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540114,
					"content": "Jeden Abend ... blicke ich zu den Sternen und fühle eine unvergleichliche Ruhe in meinem Herzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540115
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540115,
					"content": "Derjenige, der den Sternenhimmel liebt ... ist es Jeroney?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540116
					]
				},
				{
					"id": 790540116,
					"content": "Jeder, der einen solchen Sternenhimmel sieht, wird ihn lieben. Es ist nur schade, dass wir ihn nicht auch am Tag sehen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540117
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540117,
					"content": "Natürlich, wenn ich nicht jeden Tag hier hochklettern müsste, um die Sterne zu sehen, wäre das noch besser, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540118
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540118,
					"content": "Ah, da hat Paimon gleich eine Idee, wie das funktionieren könnte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540119,
					"content": "Oh? Was für eine Idee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540120
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540120,
					"content": "Einfach nur ein Foto machen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540121
					]
				},
				{
					"id": 790540121,
					"content": "Ein ... Foto machen? Hm, die Technologie da draußen muss sich enorm entwickelt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540122
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540122,
					"content": "Ja. Wir können ein Foto vom Sternenhimmel für dich machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540123,
					"content": "Ist das wirklich möglich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540124
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540124,
					"content": "Aber natürlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540125
					]
				},
				{
					"id": 790540125,
					"content": "Aber Paimon ist sich nicht ganz sicher, von wo aus man eine gute Aufnahme des Firmaments machen könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540126,
					"content": "Ah, genau hier! Nachts kann man von dieser Plattform aus den schönsten Sternenhimmel sehen. Deshalb bin auch ich hier hochgeklettert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540127
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540127,
					"content": "Also gut! Jeroney, warte du auf unser Foto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540110,
					"content": "Der Express macht wirklich Spaß.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				}
			]
		},
