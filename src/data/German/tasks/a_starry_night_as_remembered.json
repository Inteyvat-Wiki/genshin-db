			"dialogs": [
				{
					"id": 790540301,
					"content": "Jeroney! Wir sind zurück. Schau mal, hier ist das Foto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540302,
					"content": "Das ... Das sieht genauso aus wie der echte Sternenhimmel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540303
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540303,
					"content": "Wollt ihr mir dieses Foto wirklich geben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540304
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540304,
					"content": "Klar! Wir haben es ja für dich gemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540305,
					"content": "Haha, danke ... vielen Dank. Ich hätte nicht gedacht, jemals eine so großartige Technologie zu erleben. Jetzt gibt es also eine so fortschrittliche Technologie. Eines Tages kann vielleicht außerhalb der Mirage auch ein „Tschu-Tschu-Express“ gebaut werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540306
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540306,
					"content": "Ein wirklich wunderschöner Sternenhimmel. Wenn es doch nur damals schon diese Technologie gegeben hätte ... dann hätte er sich jederzeit dieses Firmament ansehen können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeroney"
				}
			]
		},
