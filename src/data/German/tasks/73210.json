			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732100501,
					"content": "Hmm ... Was für Schätze hier wohl zu finden sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100502,
					"content": "Der Schrank ist voller Hefte. Ihr blättert sie durch. Es scheint sich um Krankenhausdokumente wie Patientenkarten und Bilanzunterlagen zu handeln.\\nEnttäuscht schließt ihr den Schrank.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732100503
					]
				},
				{
					"id": 732100503,
					"content": "Pff, Paimon hat gedacht, dass da drin irgendwelche besonderen Schätze zu finden wären ... Und dabei war da weniger drin als in den Holzeimern und Holzkisten, über die wir auf unseren gewöhnlichen Abenteuern stolpern! Dort ist wenigstens Weißkohl und Rohes Geflügel drin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100504,
					"content": "Nanu? Was ist das denn? Es sieht aus, als wäre es von innen herausgefallen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100505,
					"content": "Paimon schaut sich das mal an ... Vielleicht ist das ja ein Hinweis auf einen Schatz ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100507,
					"content": "Woah! „Eleazar“ scheint furchtbar zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100508,
					"content": "Was steht auf dem anderen Dokument ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100510,
					"content": "Hmm ... Paimon versteht rein gar nichts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100511,
						732100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100511,
					"content": "Das verstehe ich auch nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100512,
					"content": "Das einzige, was Paimon verstanden hat, war irgendetwas über eine „anleitende Stimme Gottes“ ... Könnte hier etwa wirklich eine sonderbare Stimme erklungen sein, die die Leute angeleitet hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100515,
					"content": "Vielleicht waren es „unterirdische Wasseradern oder biologische Aktivitäten“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100516
					]
				},
				{
					"id": 732100516,
					"content": "Ja, genau! Vielleicht gibt es im Untergrund ja irgendwelche Ruinen! Wenn wir irgendwelche Geräusche hören, sollten wir uns das genauer ansehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100513,
					"content": "Es ist vielleicht besser, dass du das nicht verstehst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100514
					]
				},
				{
					"id": 732100514,
					"content": "Oh? Kannst du das verstehen? Paimon hat nur etwas von einer „anleitenden Stimme Gottes“ verstanden ... Könnte hier etwa wirklich eine sonderbare Stimme erklungen sein, die die Leute angeleitet hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}