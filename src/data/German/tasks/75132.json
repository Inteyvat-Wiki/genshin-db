			"dialogs": [
				{
					"id": 751320501,
					"content": "Hüte dich vor den Orten, an denen die pechschwarzen Feinde umherstreifen, und vor den Mächten, die alles zersetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Der Wille des mysteriösen Graffitis"
				},
				{
					"id": 751320502,
					"content": "Recke aus der Fremde ... Gibt es noch etwas, das du wissen möchtest ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320503,
						751320506,
						751320509,
						751320512
					],
					"speakerTitle": "Der Wille des mysteriösen Graffitis"
				},
				{
					"id": 751320503,
					"content": "Über das Wandgemälde der Helden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320504
					]
				},
				{
					"id": 751320504,
					"content": "Im Osten, in den Höhlen, wo die schimmernden Bäume schwanken und wiegen, wie der Geschichtenerzähler mit der Geweberolle schildert, lauert Grauen, das sich in den Erzählungen der Vergangenheit verbirgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320505
					],
					"speakerTitle": "Der Wille des mysteriösen Graffitis"
				},
				{
					"id": 751320505,
					"content": "Es mag sein, dass jener Schatten einen Ausweg sucht, indem er sich in die alten Geschichten flüchtet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Der Wille des mysteriösen Graffitis"
				},
				{
					"id": 751320506,
					"content": "Über das, was über dem verlorenen Meer ist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320507
					]
				},
				{
					"id": 751320507,
					"content": "Im Westen, wo eine Insel im Nebel verborgen liegt, befand sich einst ein heiliger Ort der Rituale und die Heimat derer, die vor langer Zeit einen Bund mit den Iktomisauriern schlossen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320508
					],
					"speakerTitle": "Der Wille des mysteriösen Graffitis"
				},
				{
					"id": 751320508,
					"content": "Doch dann traten daraus Unrat und Schlamm hervor, und verwandelten die Stätte in einen düsteren Sumpf und versiegelt fiel sie der Vergessenheit anheim ... Aber ach, der listige Feind gibt so leicht nicht auf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Der Wille des mysteriösen Graffitis"
				},
				{
					"id": 751320509,
					"content": "Über den blassen Nebel ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320510
					]
				},
				{
					"id": 751320510,
					"content": "Jener unheilvolle Nebel entstand, als die uralte Stadt Ochkanatlan zerstört wurde. Er wurde einst verbannt ... Doch die Zeit und das Vergessen sind erbitterte Feinde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320511
					],
					"speakerTitle": "Der Wille des mysteriösen Graffitis"
				},
				{
					"id": 751320511,
					"content": "Könnte doch nur ... Ach ... Wenn nur jemand diesen Nebel wieder vertreiben könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Der Wille des mysteriösen Graffitis"
				},
				{
					"id": 751320512,
					"content": "Nein, es gibt nichts weiteres, was ich wissen möchte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320513
					]
				},
				{
					"id": 751320513,
					"content": "Ach ... Vergiss nicht, unbedingt ... äußerste Vorsicht walten zu lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Der Wille des mysteriösen Graffitis"
				}
			]
		},
