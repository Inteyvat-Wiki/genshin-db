			},
			"dialogs": [
				{
					"id": 751320601,
					"content": "Ah, Recke aus der Ferne ... Ich kann all deine Taten spüren ... alles, was du getan hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320602
					],
					"speakerTitle": "Der Wille des mysteriösen Graffitis"
				},
				{
					"id": 751320602,
					"content": "Wie unglaublich! Die verzehrende Kraft ist in das Königreich der Nacht zurückgekehrt. Ich kann die Wonne der Nachtseelen spüren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320603
					],
					"speakerTitle": "Der Wille des mysteriösen Graffitis"
				},
				{
					"id": 751320603,
					"content": "So nimm dies als Belohnung, Recke. Wer Großes vollbringt, sollte belohnt werden ... bitte nimm es an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Der Wille des mysteriösen Graffitis"
				}
			]
		}
	]
}