			"dialogs": [
				{
					"id": 751320101,
					"content": "#... Ah ... {M#Held}{F#Heldin} aus einem fernen Land ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320102
					],
					"speakerTitle": "Der Wille des mysteriösen Graffitis"
				},
				{
					"id": 751320102,
					"content": "Hör bitte auf meine Worte. Ich bin der Nachtrabe, der den Weg weist, und zugleich das wehmütige Abschiedslied des wahren Meisters der Nacht ... Oder vielleicht bin ich auch nur ein Gedanke unter Millionen im Mondlicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320103
					],
					"speakerTitle": "Der Wille des mysteriösen Graffitis"
				},
				{
					"id": 751320103,
					"content": "Hör bitte auf meine Worte. Da der unterirdische Fluss der Seelen zerbrochen ist, kann ich nur durch diese Erscheinung zu euch sprechen, um euch vor den pechschwarzen Feinden zu warnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320104
					],
					"speakerTitle": "Der Wille des mysteriösen Graffitis"
				},
				{
					"id": 751320104,
					"content": "An diesem Ort warf der zerbrochene Spiegel einst lichte Strahlen. Jetzt aber breitet sich schwarzer Rauch langsam an drei Orten aus. Merke sie dir:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320105
					],
					"speakerTitle": "Der Wille des mysteriösen Graffitis"
				},
				{
					"id": 751320105,
					"content": "Der erste Ort liegt im Osten, wo verborgene Schatten aus einer Wandmalerei längst vergangener Heldensagen allmählich hervortreten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320106
					],
					"speakerTitle": "Der Wille des mysteriösen Graffitis"
				},
				{
					"id": 751320106,
					"content": "Der zweite Ort liegt im Westen, über dem verlorenen Meer, wo pechschwarze Gestalten die Stimme des Königs der Mitternacht wie lästige Papageien nachahmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320107
					],
					"speakerTitle": "Der Wille des mysteriösen Graffitis"
				},
				{
					"id": 751320107,
					"content": "Der dritte Ort liegt unter den Klippen. Dort breitet sich ein blasser Nebel aus, der eigentlich längst verschwunden sein sollte, aber nach den Unruhen in der aschenen Stadt wieder zurückkehrte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320108
					],
					"speakerTitle": "Der Wille des mysteriösen Graffitis"
				},
				{
					"id": 751320108,
					"content": "Recke aus der Fremde, sei auf der Hut ... Hüte dich vor den Orten, an denen die pechschwarzen Feinde umherstreifen, und vor den Mächten, die alles zersetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Der Wille des mysteriösen Graffitis"
				}
			]
		},
