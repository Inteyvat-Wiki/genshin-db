			},
			"dialogs": [
				{
					"id": 728020301,
					"content": "Das Datum der Rückkehr unserer Tochter nach Hause ... Wie kann es früher sein als das Datum, das auf dem Brief an die Familie steht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020302
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020302,
					"content": "Hör auf, dir Dinge einzubilden, es ist wahrscheinlich nur ein Missverständnis, und hilf mir einfach, herauszufinden, was ich morgen zum Mittagessen machen soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michiru"
				}
			]
		},
		{
			"id": 7280204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280204",
							"2"
						],
						"stepId": 7280204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yoh",
					"Michiru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020401,
					"content": "Unsere Atsuko ist im Moment nicht da. Bitte warte bis heute Abend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020402
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020402,
					"content": "Wenn der Abend kommt, sollte Atsuko zurück sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michiru"
				}
			]
		},
		{
			"id": 7280205,
			"completionStepIds": [
				7280205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280205",
							"2"
						],
						"stepId": 7280205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Atsuko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020501,
					"content": "Ich glaube die Familie von Atsuko ist im Haus. Lass uns an die Tür klopfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020502,
					"content": "Sie scheinen über etwas zu reden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020503
					]
				},
				{
					"id": 728020503,
					"content": "Übrigens, ich frage mich, wie es dem Tanuki geht, den wir zuvor gerettet haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020504
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020504,
					"content": "Du bist wirklich lieb, dieser Tanuki hat nur eine kleine Verletzung am Bein. Lass ihn im Gras liegen und er wird sich von alleine erholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020505
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020505,
					"content": "Ich konnte ihn nicht liegen lassen, er sah mich mit Tränen in den Augen an. Wie könnte ich ihn nicht mit nach Hause nehmen und mich um ihn kümmern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020506
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020506,
					"content": "Nun, es ist immer gut, Gutes zu tun, aber er isst ein bisschen zu viel, fast so viel wie ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020507
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020507,
					"content": "An die Tür klopfen",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020508
					]
				},
				{
					"id": 728020508,
					"content": "Wer ist es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020509
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020509,
					"content": "#Ich bin {F#die Reisende}{M#der Reisende} von vorher.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020510
					]
				},
				{
					"id": 728020510,
					"content": "#Oh, es ist {F#die Reisende}{M#der Reisende}, ja? Einen Moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020511
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020511,
					"content": "Du, hallo! Ich bin Atsuko. Schön, dich kennen... äh, wiederzusehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020512
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020512,
					"content": "Es tut mir leid, aber ich hatte so viel Heimweh, dass ich es mir anders überlegt habe, nachdem ich dir den Brief gegeben hatte, und bin mit dem Boot nach Hause gefahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020513
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020513,
					"content": "Ahahaha ... Es war alles ein Missverständnis ... Tut mir leid, dass ich dich den ganzen Weg hierher habe kommen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020514
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020514,
					"content": "Wie hast du es geschafft, zurück nach Inazuma zu kommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020515
					]
				},
				{
					"id": 728020515,
					"content": "Ah, ich habe meinen eigenen Weg, haha. Darum musst du dir keine Sorgen machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020516
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020516,
					"content": "Also, ich habe etwas vorbereitet, bitte nimm es an. Danke für deine Hilfe. Beeil dich ... ähm, beeil dich und geh deiner Arbeit nach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020517
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020517,
					"content": "Wie kommt es, dass die Dinge, die Atsuko uns jetzt erzählt, anders sind als vorher? Wenn die Rückkehr nach Inazuma so einfach war, warum hast du uns dann überhaupt um Hilfe gebeten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020518,
						728020520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020518,
					"content": "Was ist mit deiner Arbeit in Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020519
					]
				},
				{
					"id": 728020519,
					"content": "Arbeit? Welche Arbeit? Was hatte ich denn in Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020522,
					"content": "Ah, solche Dinge sind zu weltlich und völlig unwichtig im Vergleich zu meiner Familie, ich habe sie längst jemand anderem anvertraut, ah ... haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020523
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020523,
					"content": "He, he, he. Die echte Atsuko hat Probleme, eine Arbeit in Liyue zu finden. Wie konnte sie zu einer reichen Frau werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020524,
					"content": "Wer zum Teufel bist du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020525
					]
				},
				{
					"id": 728020525,
					"content": "Ich ... Natürlich bin ich Atsuko! Was gibt es zu bezweifeln, wenn man wie Atsuko aussieht und wie Atsuko klingt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020526
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020526,
					"content": "Jetzt hör doch auf! Was für eine Nervensäge ... Vergiss es, ich werde nicht mehr mit dir reden, ich muss morgen arbeiten, ich gehe jetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020527
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020527,
					"content": "He, Atsuko! Dieses Kind ... warum ist sie auf einmal so wütend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020528
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020528,
					"content": "#Entschuldigung, {F#Reisende}{M#Reisender}, sie ist wohl müde von der Arbeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020529
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020529,
					"content": "Aber wie du sehen kannst, ist das tatsächlich unsere Tochter, und der Brief, den du mitgebracht hast ... Vielleicht hat sie es wirklich einfach vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020530
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020530,
					"content": "Aber wie auch immer, danke für die Hilfe! Und wegen der Bezahlung ... Bitte warte noch ein bisschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020531,
						728020532
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020531,
					"content": "Was ist denn passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020533,
					"content": "Das ist es nicht. Wir können immer noch zahlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020534
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020534,
					"content": "Dieses Kind geht tagsüber doch zur Arbeit, ja? Aber die Bezahlung, die sie jeden Tag für ihre Arbeit bekommt, ist immer ein bisschen seltsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020535
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020535,
					"content": "Mal sind es seltsame Samen, mal wilde Früchte, sie kommt nie direkt mit Mora zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020536
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020536,
					"content": "Sie sind etwas Geld wert, aber wir müssen sie trotzdem erst verkaufen, um etwas davon zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020537
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020537,
					"content": "#Es muss für {F#eine Reisende}{M#einen Reisenden} wie dich einfacher sein, sich in Mora bezahlen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020538
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020538,
					"content": "Bitte, komm morgen wieder. Dann gebe ich dir Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020532,
					"content": "Wenn es Schwierigkeiten gibt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020520,
					"content": "Was ist mit deiner Villa in Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020521
					]
				},
				{
					"id": 728020521,
					"content": "Eine Villa? Welche Villa? Ich habe eine Villa in Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "Atsuko"
				}
			]
		},
		{
			"id": 7280206,
			"completionStepIds": [
				7280207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
