			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michiru",
					"Yoh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020601,
					"content": "Wo ist unsere Tochter nochmal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020602,
						728020603
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020602,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				},
				{
					"id": 728020604,
					"content": "Auch wenn sie am nächsten Tag arbeitet, sagt Atsuko normalerweise etwas zu uns, bevor sie geht. Aber heute ist sie gegangen, ohne etwas zu sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020605
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020605,
					"content": "Nachdem du gestern Abend gegangen warst, sagte Atsuko, dass sie sich müde fühlte, und ging direkt in ihr Zimmer, um zu schlafen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020606
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020606,
					"content": "Als wir nach Sonnenaufgang aufstanden, war sie nicht mehr in ihrem Bett.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020607
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020607,
					"content": "Wir suchten überall und konnten unsere Tochter nicht finden, also machte sich mein Mann direkt auf den Weg, um in der weiteren Umgebung zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020608
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020608,
					"content": "Aber ich habe die Gegend einen halben Tag lang abgesucht und absolut keine Spur von meiner Tochter gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020609
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020609,
					"content": "Ah, das Kind macht doch nicht schon wieder eine Reise, oder? Was kann ich nur tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020610
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020610,
					"content": "Mach dir keine Sorgen, Liebling. Ich werde später nach ihr suchen. Du kannst zuerst das Zimmer von Atsuko zu Hause aufräumen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020611
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020611,
					"content": "Das Kind hat das Fenster auch nicht geschlossen, als sie gegangen ist, und so wurde ein ganzer Haufen Blätter ins Zimmer geweht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020612
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020612,
					"content": "#Übrigens, {F#Reisende}{M#Reisender}, das ist die vereinbarte Zahlung. Bitteschön.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020613
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020613,
					"content": "Uff, was zur Hölle hat dieses Kind Atsuko schon wieder gemacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020603,
					"content": "Ist Atsuko wieder zur Arbeit gegangen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				}
			]
		},
