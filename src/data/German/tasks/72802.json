			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michiru",
					"Yoh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020201,
					"content": "Wie viele Gerichte wären gut, um sie morgen zum Mittagessen zuzubereiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020202
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020202,
					"content": "Unsere Kinder essen immer mehr in letzter Zeit, also ist es immer eine gute Idee, mehr zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020203
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020203,
					"content": "Hm? Darf ich fragen, wer du bist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020204,
						728020205
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020204,
					"content": "Ist das die Familie von Atsuko?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				},
				{
					"id": 728020206,
					"content": "Ja, darf ich fragen, was du willst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020207
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020207,
					"content": "Dies ist ein Brief, den Atsuko mich euch hat bringen lassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020208
					]
				},
				{
					"id": 728020208,
					"content": "Ein Brief? Warum schreibt sie auf einmal Briefe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020209
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020209,
					"content": "Und so lang ... Sie ist doch schon zu Hause ... Sie kann uns doch einfach erzählen, was sie auf dem Herzen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020210,
						728020211
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020210,
					"content": "Was?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020212,
					"content": "#{F#Reisende}{M#Reisender}, du klingst, als wärst du überrascht? Es stimmt zwar, dass unsere Atsuko eine Zeit lang unterwegs war, aber jetzt ist sie wieder zu Hause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020213
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020213,
					"content": "Warum würde sie jemanden bitten, einen Brief nach Hause zu bringen, wenn sie doch zu Hause ist? Du hast dich sicher geirrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020214
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020214,
					"content": "Moment mal, Liebling, ich habe den Brief angesehen und die Handschrift, der Stil, das war tatsächlich unsere Tochter Atsuko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020215
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020215,
					"content": "In dem Brief stand auch, dass sie nicht vorhatte, in nächster Zeit zurückzukehren und dass wir auf uns selbst aufpassen sollten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020216
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020216,
					"content": "#Was zum Teufel ist hier los? Es kann doch nicht sein, dass unser Kind {F#diese Reisende}{M#diesen Reisenden} bittet, einen Brief mitzubringen, während es selbst schon zurückkehrt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020217
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020217,
					"content": "Ich glaube, hier liegt ein kleines Missverständnis vor. Lass uns danach fragen, sobald sie zurück ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020218
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020218,
					"content": "#{F#Reisende}{M#Reisender}, leider ist meine Atsuko heute nicht in der Stadt. Wenn sie zurückkommt, werden wir beide sie um Klärung bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020219
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020219,
					"content": "Komm morgen Abend wieder zu uns, wenn du magst, und lass dir von ihr alles von Angesicht zu Angesicht erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020220,
						728020222
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020220,
					"content": "Wo ist sie jetzt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020221
					]
				},
				{
					"id": 728020221,
					"content": "Sie sagte, sie müsse sich um die Arbeit kümmern und ging eilig, nachdem sie gegessen hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020224,
					"content": "Ja, sie ist jeden Tag früh raus und spät zurück, und wir sehen sie nur abends, also weiß ich nicht, was das Kind treibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020225
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020225,
					"content": "Wie auch immer, bitte komm morgen Abend vorbei, und wenn das Kind wirklich etwas falsch gemacht hat, sorgen wir dafür, dass es sich persönlich bei dir entschuldigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020226
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020226,
					"content": "Und dass ich dich mit einem so langen Lauf belästige, tut mir leid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020227
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020227,
					"content": "Dieses Kind ist so unberechenbar ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020222,
					"content": "Warum abends?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020223
					]
				},
				{
					"id": 728020223,
					"content": "Sie sagte, sie müsse sich mit Arbeit beschäftigen und würde jeden Tag nach dem Mittagessen tagsüber hinausgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020211,
					"content": "Atsuko ... zu Hause?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020205,
					"content": "Seid ihr die Eltern von Atsuko?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				}
			]
		},
		{
			"id": 7280203,
