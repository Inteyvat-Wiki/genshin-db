			"dialogs": [
				{
					"id": 761910201,
					"content": "Ich habe dich doch immer wieder daran erinnert, einen klaren Kopf zu bewahren! Ein Stammkunde aus Snezhnograd hat ausdrücklich nach dieser erstklassigen Ware verlangt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910202
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910202,
					"content": "Und du hast das einfach so geschehen lassen? Bist du bei mir jetzt etwa weich geworden? Hat dich plötzlich dein Gewissen übermannt, dass du das Ding einfach hast laufen lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910203
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910203,
					"content": "Boss, lass es mich erklären. Ich kann wirklich nichts dafür, es waren diese Hilichurle ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910204
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910204,
					"content": "Hilichurle? Dass du dich überhaupt traust, das zu sagen! Wegen dir wird unser Ruf als Schatzräuber noch völlig den Bach runtergehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910205
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910205,
					"content": "Ich bin einfach nicht mit ihnen fertig geworden, Boss, keine Chance! Dieses blaue und das grüne Ding sind noch härter als Schuldeneintreiber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910206
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910206,
					"content": "(Die beiden Typen sehen wie Schmuggler aus ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910207
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910207,
					"content": "... Wer ist da?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910208
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910208,
					"content": "He, Lumi! Es ist noch nicht Zeit für deinen Auftritt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910209
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910209,
					"content": "Was ist das denn für ein Ding ... Sieht ziemlich selten aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910210
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910210,
					"content": "He, junge Dame, kommst du damit zurecht? Das Ding sieht ziemlich scharf aus, tauschen wir es einfach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910211
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910211,
					"content": "Ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910212
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910212,
					"content": "Dass ihr es auf Lumi abgesehen habt! Leute wie ihr ruinieren den Ruf der Schatzräuber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910213
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910213,
					"content": "Äh, na welchen Ruf haben Schatzräuber denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910214
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910214,
					"content": "Verschwende keine Zeit mit ihr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alhoma"
				}
			]
		},
