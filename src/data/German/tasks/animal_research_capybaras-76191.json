					"content": "In Panik geflohen ... Wie erbärmlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910502
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910502,
					"content": "(Das geschmuggelte Wasserschwein scheint nicht hier zu sein ... Ob die Hilichurle etwas damit zu tun haben?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910503
					],
					"speakerTitle": "Linnea"
				},
				{
