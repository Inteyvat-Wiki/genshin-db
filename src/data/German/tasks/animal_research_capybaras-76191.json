			"dialogs": [
				{
					"id": 761910301,
					"content": "Es ist wirklich ein silbernes Wasserschwein. Nicht gefärbt, keine optische Täuschung. Das ist so selten ... unglaublich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910302
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910302,
					"content": "Ich habe in Natlan wirklich alles versucht, es aber nicht gefunden. Es wurde also von Schmugglern gefangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910303
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910303,
					"content": "Aber es sieht unverletzt aus ... Hehe, ein silbernes Wasserschwein. Ich hätte nie gedacht, dass ich mal eines mit eigenen Augen sehe. Lass mich mal fühlen, ob es einen Unterschied zwischen silbernen und normalen gibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910304
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910304,
					"content": "... Wie heiß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910305
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910305,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910306
					],
					"speakerTitle": "Wasserschwein"
				},
				{
					"id": 761910306,
					"content": "Fast vergessen, du bist ja noch im Topf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910307
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910307,
					"content": "Bist du etwa schon so an das flüssige Phlogiston in Natlan gewöhnt, dass dir diese Temperatur gar nichts ausmacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910308
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910308,
					"content": "Wie dem auch sei ... Komm erstmal mit mir zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910309
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910309,
					"content": "♪ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wasserschwein"
				}
			]
