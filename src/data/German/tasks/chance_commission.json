				]
			},
			"dialogs": [
				{
					"id": 761260201,
					"content": "Ah ... Jahoda? Was führt dich her? Hmm ... Hat Chefin Nefer jetzt etwas Zeit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260202
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260202,
					"content": "(Wie ich gedacht habe, will er wirklich Chefin Nef sehen ... Hmpf, so eine Kleinigkeit schaffe ich auch allein.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260203,
					"content": "So viel Aufwand ist nicht nötig. Die Chefin hat mich geschickt, um dir zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260204
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260204,
					"content": "Hä? W... Was meinst du? Soll das heißen, dass Chefin Nefer schon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260205
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260205,
					"content": "Du wolltest doch schon immer die „Nachkommen des Frostmonds“ besuchen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260206
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260206,
					"content": "Deswegen willst du eine gute Beziehung mit Lyylikki aufbauen und sie dann bitten, dich zu den „Nachkommen des Frostmonds“ zu bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260207
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260207,
					"content": "Was?! Chefin Nefer weiß schon Bescheid? Das habe ich doch immer alles für mich behalten und kaum jemandem erzählt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260208
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260208,
					"content": "(Jetzt ist der Moment, um jenen besonders coolen Satz zu sagen! Wie hat Chefin Nef es noch gleich ausgedrückt ... Hm ... Oh!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260209
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260209,
					"content": "Hehe, Herr Zompaynco, wer ein Geheimnis bewahren will, muss auch verbergen können, dass er eines hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260210
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260210,
					"content": "Sonst bekommt die Mauer in deinem Herzen früher oder später Risse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260211
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260211,
					"content": "*seufz* In meiner Heimat konnte ich meine Gedanken nie gut verbergen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260212
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260212,
					"content": "(Ich habe es ausgesprochen! Die lange Übung war nicht umsonst, hehehehe!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260213
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260213,
					"content": "Na gut ... da du es eh weißt, kannst du mich vielleicht vorstellen? Ich bin ein Fremder und möchte Fräulein Lyylikki nicht einfach so stören ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260214
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260214,
					"content": "Keine Sorge, Lyylikki ist sehr freundlich. Selbst wenn die Besucher Fremde sind, ja sogar, wenn es keine Menschen sind, wird sie Lyylikki freundlich empfangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260215
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260215,
					"content": "Was? Wirklich ... Echt jetzt ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260216
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260216,
					"content": "Aber egal wie, einfach so aufzutauchen wäre unhöflich ... Hmm, würdest du sie kennen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260217
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260217,
					"content": "Klar, sie müssten gerade mit dem Austeilen des Essens fertig sein. Los geht’s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260218
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260218,
					"content": "Übrigens, die Chefin hat noch gesagt, dass wir diesmal nichts verlangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260219
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260219,
					"content": "Danke dir! Ich pack gleich meine Sachen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zompaynco"
				}
			]
		}
	]
}