			},
			"dialogs": [
				{
					"id": 761260101,
					"content": "Jahoda? Und ... Herr Zompaynco, was gibt’s, wenn ich fragen darf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260102
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260102,
					"content": "Ich ... Äh ... also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260103
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260103,
					"content": "Er möchte die „Nachkommen des Frostmonds“ treffen, aber er traut sich nicht. Deshalb will er dich um Hilfe bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260104
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260104,
					"content": "Ja! Ja, genauso ist es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260105
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260105,
					"content": "Fräulein Lyylikki! Schön, dich zu sehen. Ähm ... das ist ein Fossil, das ich aus Natlan mitgebracht habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260106
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260106,
					"content": "Danke, Herr Zompaynco, aber ich kenne dich doch schon lange. Du musst wirklich nicht so formell sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260107
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260107,
					"content": "Hm? Wie hast du mich diesmal erkannt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260108
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260108,
					"content": "Du warst doch da, als ich das Essen ausgegeben habe. Du bist die ganze Zeit hin und her gelaufen, aber hast dich nie angestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260109,
					"content": "Ich dachte, du wolltest auch eine Portion nehmen, hast dich aber nicht getraut. Also habe ich dir heimlich eine zurückgelegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260110
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260110,
					"content": "Aber ... du hast sie nie abgeholt. Wärst du heute nicht gekommen, hätte ich jemanden geschickt, um zu fragen, ob du Hilfe brauchst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260111,
					"content": "Äh ... I... Ich ... Tut mir leid, ich war unsicher, wie ich dich ansprechen soll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260112
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260112,
					"content": "Also, Fräulein Lyylikki, darf ich mal bei den „Nachkommen des Frostmonds“ vorbeischauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260113
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260113,
					"content": "Klar, bei den „Nachkommen des Frostmonds“ gibt es ohnehin ein paar Gäste von außerhalb. Aber was willst du denn dort machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260114
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260114,
					"content": "Ich will ein paar Fotos machen, in Dokumenten stöbern und, wenn möglich, Leute nach Legenden fragen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260115
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260115,
					"content": "Ich bin Mitglied im „Verein für Saurierrelikte“ in Natlan. Wenn ich ein paar Materialien zu meinem Forschungsthema sammeln könnte, wäre das super!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260116
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260116,
					"content": "Oh ... du willst also in die Bücher schauen? Lass mich mal überlegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260117
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260117,
					"content": "Da ihr euch so gut unterhaltet, ist dieser Auftrag damit beendet. Ich muss dann auch zurück und meiner Chefin Bericht erstatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260118
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260118,
					"content": "Danke, Fräulein Jahoda! Ähm ... die Kosten bezahle ich natürlich trotzdem, wie könnte ich dich denn auch einfach so herumschicken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260119
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260119,
					"content": "Und wenn du zurückgehst, richte bitte unbedingt Chefin Nefer meinen Dank aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260120
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260120,
					"content": "Kein Problem, dann gehe ich erst mal. Unterhaltet euch ruhig weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
