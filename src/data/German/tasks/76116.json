			"dialogs": [
				{
					"id": 761160101,
					"content": "He! Da seid ihr wieder, Freunde fürs Leben von Bobik und mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160102,
						761160105,
						761160108,
						761160110
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160102,
					"content": "Was euch beide angeht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160103
					]
				},
				{
					"id": 761160103,
					"content": "Wir werden eine Weile hierbleiben, da wir ja die Tür zu Drzislavs Labor zerstört haben. Wir müssen aufpassen, dass die bösen Kerle nicht nochmal rein können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160104
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160104,
					"content": "Wenn wir die Tür repariert haben oder Slava nach Hause kommt, werden wir wohl auch mit Bobik losziehen, genau wie ihr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160105,
					"content": "Über Drzislav ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160106
					]
				},
				{
					"id": 761160106,
					"content": "Wir haben keine Ahnung, wo er sich aufhält ... Falls ihr ihm auf eurer Reise über den Weg lauft, grüßt ihn bitte von uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160107
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160107,
					"content": "Ich würde so gern noch mal mit ihm im „Flaggschiff“ die ganze Nacht trinken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160108,
					"content": "Über Bobik ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160109
					]
				},
				{
					"id": 761160109,
					"content": "Und wenn du Bobik vermisst, kannst du jederzeit vorbeikommen, wenn du Zeit hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160110,
					"content": "Tschüs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160111
					]
				},
				{
					"id": 761160111,
					"content": "Ja, wir werden uns wiedersehen. Schließlich sind wir Freunde fürs Leben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				}
			]
		}
