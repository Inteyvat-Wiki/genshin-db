			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Glory"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200370301,
					"content": "#Hallo ... Oh, diese Stimme! Das muss doch unser{F#e Reisende}{M# Reisender} sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370302
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370302,
					"content": "Was führt dich zu mir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370303
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370303,
					"content": "Jemand hat mich beauftragt, dir diesen Brief zu überreichen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370304
					]
				},
				{
					"id": 200370304,
					"content": "Einen Brief? Wer würde mir denn einen Brief schreiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370305
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370305,
					"content": "Godwin etwa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370306
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370306,
					"content": "Hast du ihn getroffen? Wie geht es ihm? Hat er gesagt, wann er zurückkommen würde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370307
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370307,
					"content": "Es tut mir leid ... Er muss furchtbar beschäftigt sein. Vergiss einfach, was ich eben gesagt habe. Ich will ihm nicht noch mehr Stress bereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370308
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370308,
					"content": "Wärst du so freundlich, mir den Brief vorzulesen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370309
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370309,
					"content": "Bitte sprich leise. Es reicht, wenn wir beide wissen, was drin steht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370310
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370310,
					"content": "In Ordnung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370311
					]
				},
				{
					"id": 200370311,
					"content": "Du hast so schön vorgelesen ... Tust du das öfter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370312
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370312,
					"content": "Der Brief endet hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370313
					]
				},
				{
					"id": 200370313,
					"content": "Liyue also ... Godwin muss an so vielen Orten gewesen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370314
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370314,
					"content": "Ich danke dir! Ich werde diesen Brief in Ehren halten. Richte <color=#00E1FFFF>Godwin</color> bitte meine herzlichsten Grüße aus, wenn du ihn das nächste Mal siehst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370315
					],
					"speakerTitle": "Glory"
				}
			]
		},
		{
