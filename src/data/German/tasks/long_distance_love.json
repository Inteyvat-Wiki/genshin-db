		{
			"id": 2003705,
			"completionStepIds": [
				2003706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003706",
							"2"
						],
						"stepId": 2003706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200370501,
					"content": "Hast du den Brief überbracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370502
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370502,
					"content": "Glory lässt dich grüßen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370503
					]
				},
				{
					"id": 200370503,
					"content": "Puh ... Ich habe so lange nichts von mir hören lassen. Gut, dass sie nicht sauer ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370504
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370504,
					"content": "Du bist die ganze Zeit in der Nähe von Mondstadt. Wieso weißt du dann von Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370505,
					"content": "Ach das, na ja ... Der Großmeister hat davon erzählt. Er war schon an sehr vielen Orten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370506
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370506,
					"content": "Gut, danke dir! Du hast mir sehr geholfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370507
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370507,
					"content": "Diese Löwenzahnsamen sind für dich. Ich habe sie selbst gesammelt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370508
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370508,
					"content": "Wenn Glory das nächste Mal Löwenzahnsamen haben will, kannst du sie ihr geben. Bitte hilf ihr, wenn sie dich braucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		}
	]
}