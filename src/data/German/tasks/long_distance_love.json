			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200370101,
					"content": "Hmpf, ich würde am liebsten gleich wieder zurück nach Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370102
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370102,
					"content": "#Oh, {F#Reisende}{M#Reisender}! Würdest du mir einen Gefallen tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370103
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370103,
					"content": "Wie du siehst, bin ich ein Ritter des Ordo Favonius und laufe Patrouille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370104
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370104,
					"content": "Ich habe meiner Freundin versprochen, ihr von Zeit zu Zeit einen Brief zu schicken, damit sie weiß, dass es mir gutgeht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370105
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370105,
					"content": "Aber ich war so beschäftigt, dass ich glatt vergessen habe, den Brief abzuschicken, hahaha ... Könntest du ihr diesen <color=#00E1FFFF>Brief</color> geben? Ihr Name ist <color=#00E1FFFF>Glory</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370106
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370106,
					"content": "Was? Für Glory?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370107
					]
				},
				{
					"id": 200370107,
					"content": "Das blinde Mädchen ... mit den Löwenzahnsamen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370108,
					"content": "Was? Der Godwin, von dem Glory gesprochen hat, bist du?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370109,
					"content": "Oh, wieso kennt ihr denn Glory?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370110
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370110,
					"content": "Wir haben ihr einen Gefallen getan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370111
					]
				},
				{
					"id": 200370111,
					"content": "Sie ... Sie hat euch um Hilfe gebeten? Ich hoffe, sie hat euch nichts Gefährliches tun lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370112
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370112,
					"content": "Glory hat uns nur darum gebeten, dass wir ihr helfen, Löwenzahnsamen zu sammeln. Sie geht davon aus, dass sie ihre Wünsche weitertragen, wenn sie durch die Luft schweben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370113,
					"content": "Ah, Löwenzahn ... Das klingt tatsächlich nach Glory.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370114
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370114,
					"content": "Hast du Mondstadt nicht vor langer Zeit verlassen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370115
					]
				},
				{
					"id": 200370115,
					"content": "Zumindest war das so gedacht ... Aber was soll’s, jetzt kann ich’s euch auch erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370116
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370116,
					"content": "Habt ihr gehört, dass der Großmeister jeweils vier von fünf Rittern mitgenommen hat, als er Mondstadt verließ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370117
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370117,
					"content": "Gut, denn ich war einer von den entsandten Rittern ... Aber als wir uns auf den Weg machten, habe ich gemerkt, dass ich Glorys Andenken habe liegen lassen. Auf meiner Suche danach habe ich die Truppen aus den Augen verloren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370118
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370118,
					"content": "Bis jetzt konnte ich sie nicht wiederfinden. Deswegen durchstreife ich noch immer die Gegend auf der Suche nach ihnen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370119
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370119,
					"content": "Ich traue mich auch nicht zurück nach Mondstadt. Was werden die anderen Ritter des Ordo Favonius denn denken, wenn ich mich dort so blicken lasse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370120
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370120,
					"content": "Außerdem habe ich Glory versprochen, ihr aus allen möglichen Ecken der Welt Briefe und Geschenke zu schicken, um ihr „die ganze Welt“ nahezubringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370121
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370121,
					"content": "Wenn sie erführe, dass ich nicht einmal die Umgebung Mondstadts verlassen habe ... dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370122
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370122,
					"content": "Du schämst dich also.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370123,
					"content": "Würdest du <color=#00E1FFFF>Glory</color> bitte diesen <color=#00E1FFFF>Brief</color> übergeben? Sie wird sich schon große Sorgen um mich machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370124,
						200370126
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370124,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370125
					]
				},
				{
					"id": 200370125,
					"content": "#Ich kann dir nicht genug danken, {F#Reisende}{M#Reisender}! Bitte behalte unser Geheimnis für dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370126,
					"content": "Nimm doch auch Löwenzahn stattdessen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370127
					]
				},
				{
					"id": 200370127,
					"content": "Es gibt zu viele Dinge, die ich Glory sagen will. Dafür reichen ein paar Löwenzahnsamen sicher nicht aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370128
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370128,
					"content": "Ich vertraue dir den Brief und mein Geheimnis an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
