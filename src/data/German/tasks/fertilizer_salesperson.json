			"dialogs": [
				{
					"id": 728130601,
					"content": "Ich wollte nur eine These schreiben, warum bin ich schon wieder eingesperrt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
