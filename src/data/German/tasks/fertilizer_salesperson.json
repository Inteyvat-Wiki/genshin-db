			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iwata",
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130901,
					"content": "#Du bist zurück, {F#Reisende}{M#Reisender}, ich bin den Düngerhaufen losgeworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130902
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130902,
					"content": "Leider muss ich einen anderen Ort zum Experimentieren finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130903
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130903,
					"content": "Hm? Das ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130904,
						728130906
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130904,
					"content": "Deine neue Hilfe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130905
					]
				},
				{
					"id": 728130905,
					"content": "Hallo, ich bin Alrani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130909
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130909,
					"content": "Wie auch immer, dieser „General“ Gorou hat mich gebeten, dir bei deiner Düngerforschung zu helfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130910
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130910,
					"content": "Danach sollten wir gut zusammenarbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130911
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130911,
					"content": "Wirklich ... das ist großartig! Wenn es uns wirklich gelingt, Dünger herzustellen, können wir mehr Pflanzen auf der Insel bewirten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130912
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130912,
					"content": "Leg den Düngerhaufen etwas weiter weg.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130913
					]
				},
				{
					"id": 728130913,
					"content": "Ah? Oh ... Ich weiß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130914
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130914,
					"content": "Kurzum, lass uns gut zusammenarbeiten, Alrani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130915
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130915,
					"content": "Ich werde mir Mühe geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130916
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130916,
					"content": "Für meine These, woo ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130906,
					"content": "Das ist die Düngemittelspezialistin von Sumeru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130907
					]
				},
				{
					"id": 728130907,
					"content": "Hallo, ich heiße Alrani ... Moment mal, eine Düngemittelspezialistin!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130908
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130908,
					"content": "Ich kenne mich nur ein wenig aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130909
					],
					"speakerTitle": "Alrani"
				}
			]
