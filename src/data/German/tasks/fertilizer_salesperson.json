		},
		{
			"id": 7281305,
			"completionStepIds": [
				7281306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7281306",
							"2"
						],
						"stepId": 7281306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hiroyuki",
					"Alrani",
					"Gorou",
					"Ookubo Daisuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130501,
					"content": "Sei nicht frech! Nicht bewegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130502
					],
					"speakerTitle": "Hiroyuki"
				},
				{
					"id": 728130502,
					"content": "Ich habe mich auch nicht bewegt! Hört mir zu, ich bin wirklich eine Gelehrte der Akademie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130503
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130503,
					"content": "Hast du nicht gerade gesagt, dass du für den Vertrieb von Dünger zuständig bist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130504
					],
					"speakerTitle": "Hiroyuki"
				},
				{
					"id": 728130504,
					"content": "Ich ... Die Gelehrten der Akademie können auch Dünger vertreiben! Lasst mich erklären ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130505
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130505,
					"content": "Ist sie das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130506
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130506,
					"content": "Ja, General.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130507
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130507,
					"content": "Als wir sie einfingen, lief sie draußen heimlich herum und schrieb ständig etwas auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130508
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130508,
					"content": "General, sie muss vom Bakufu geschickt worden sein, um uns auszuspionieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130509
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130509,
					"content": "Ich bin es nicht! Ich bin es wirklich nicht! Ich sagte doch, dass ich eine Gelehrte bin und Material für meine These brauche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130510
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130510,
					"content": "Mach dich nicht lächerlich! Für diese wie auch immer geartete These wagst du es sogar, auf das Schlachtfeld zu kommen? Es muss einen anderen Grund geben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130511
					],
					"speakerTitle": "Hiroyuki"
				},
				{
					"id": 728130511,
					"content": "Oooh ... wie kann ich es wagen, an einen anderen Grund als meine These zu denken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130512,
						728130513
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130512,
					"content": "Du ... Du!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130514
					]
				},
				{
					"id": 728130514,
					"content": "#{F#Reisende}{M#Reisender}! Toll, da bist du ja. Erklär ihnen, ich bin kein schlechter Mensch, ich bin nur hier, um meine Arbeit zu schreiben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130515
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130515,
					"content": "Kennst du sie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130516
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130516,
					"content": "Das kann man so sagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130517
					]
				},
				{
					"id": 728130517,
					"content": "Die Gelehrten von Sumeru ... können sich wahnsinnig viel Mühe geben, um ihren „Abschluss“ zu machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130518
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130518,
					"content": "Aber nach dem, was du gesagt hast, scheinst du sie auch nur flüchtig zu kennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130519
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130519,
					"content": "Was die Sache mit der „Gelehrten aus Sumeru“ angeht, so hast du das nur von ihr gehört, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130520
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130520,
					"content": "Genau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130521
					]
				},
				{
					"id": 728130521,
					"content": "Nun ... All diese Beweise sind wirklich nicht sehr glaubwürdig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130522
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130522,
					"content": "Aber da du dich dafür verbürgst, bin ich bereit zu glauben, dass sie kein schlechter Mensch ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130523
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130523,
					"content": "Hmm, mir ist gerade etwas eingefallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130524
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130524,
					"content": "Erinnerst du dich an Kaushik? Der Gelehrte, der sich mit der Kultur und Geschichte unserer Insel beschäftigt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130525
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130525,
					"content": "Er war schon einmal hier gewesen, und der Gelehrte war glaubwürdig ... Vielleicht sollte er herausfinden, ob diese ... Düngemittelverkäuferin eine Gelehrte ist oder nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130526
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130526,
					"content": "#Nun, das ist gut. {F#Reisende}{M#Reisender}, könntest du bitte Kaushik herbringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130527
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130527,
					"content": "Um Unerwartetes zu vermeiden, werde ich hier bleiben und diese ... Düngemittelverkäuferin bewachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130528
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130528,
					"content": "Alles klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130529
					]
				},
				{
					"id": 728130529,
					"content": "Vielen Dank! Fort mit dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130513,
					"content": "Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130514
					]
				}
			]
		},
		{
			"id": 7281306,
