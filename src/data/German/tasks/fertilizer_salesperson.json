			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaushik"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130701,
					"content": "#Die Bedeutung vom Totem ... Äh? {F#Reisende}{M#Reisender}, was willst du von mir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130702
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130702,
					"content": "Über Alrani ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130703
					]
				},
				{
					"id": 728130703,
					"content": "Du sagst, Alrani ist in Watatsumi? Seltsam, warum ist sie hier, sollte sie nicht nach Liyue gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130704
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130704,
					"content": "Sie wurde von Soldaten gefasst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130705
					]
				},
				{
					"id": 728130705,
					"content": "Wie? Öh ... In dieser Situation nach Watatsumi zu kommen ... Natürlich würde sie verdächtigt werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130706
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130706,
					"content": "Vergessen wir das erst einmal, beeilen wir uns dorthin, das Mädchen ist zu leichtsinnig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaushik"
				}
			]
		},
		{
			"id": 7281308,
			"completionStepIds": [
				7281309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7281309",
							"2"
						],
						"stepId": 7281309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaushik",
					"Alrani",
					"Gorou",
					"Hiroyuki",
					"Ookubo Daisuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130801,
					"content": "Alrani, du bist es wirklich, was bringt dich nach Inazuma? Solltest du nicht in Liyue sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130802
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130802,
					"content": "Das ist eine lange Geschichte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130803
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130803,
					"content": "Kaushik, kennst du Alrani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130804
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130804,
					"content": "Du bist ... Gorou, denke ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130805
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130805,
					"content": "Ich kenne sie, sie ist wie ich von der Akademie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130806
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130806,
					"content": "Jeder von uns verließ die Akademie, um sich anderen Themen zu widmen. Ich hätte nie gedacht, dass ich sie hier treffen würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130807
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130807,
					"content": "Könnt ihr die Akademie einfach so verlassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130808
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130808,
					"content": "Nicht einfach so. Alrani und ich gehören beide zu den „Driyosh“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130809
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130809,
					"content": "Für uns ist das Auswärtsstudium ein Teil der Forschung, sodass das Verlassen der Akademie eine erlaubte Handlung ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130810
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130810,
					"content": "Gorou, ich kann für Alrani bürgen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130811
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130811,
					"content": "Gut, dann ist das kein Problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130812
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130812,
					"content": "Du ... hast mich gerettet. Vielen, vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130813
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130813,
					"content": "Hiroyuki, Ookubo, geht, hier ist alles gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130814
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130814,
					"content": "Ja, General.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130815
					],
					"speakerTitle": "Hiroyuki"
				},
				{
					"id": 728130815,
					"content": "Ja, General.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130816
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130816,
					"content": "Entschuldige, Alrani, dass ich dich vorhin wie eine verdächtige Person behandelt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130817
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130817,
					"content": "Nun ... Obwohl der Verdacht gegen dich ausgeräumt wurde, hast du uns durch dein unerlaubtes Eindringen auf die Insel eine Menge Ärger bereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130818
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130818,
					"content": "Was? Gi... Gibt es eine Strafe? Ich habe nicht viele Mora mitgebracht, oooh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130819
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130819,
					"content": "Da du vorhin sagtest, dass du eine Düngemittelverkäuferin bist ... und zwar eine mit akademischem Status.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130820
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130820,
					"content": "Das ist gut. Wir haben hier einen Mann namens Iwata, der an Düngemitteln arbeitet. Alrani, bitte geh und assistiere ihm eine Weile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130821
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130821,
					"content": "Wenn du ihm helfen könntest, einen weniger „belästigenden“ Dünger herzustellen, dann kannst du hier forschen, genau wie Kaushik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130822
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130822,
					"content": "Dünge... Düngemittel? Nein, das, ich habe nur ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130823,
						728130824
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130823,
					"content": "Sie wird es schaffen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130825
					]
				},
				{
					"id": 728130825,
					"content": "Alrani, dies ist eine großartige Gelegenheit, um Materialien zu entnehmen, und da du hier in Inazuma bist, beweist es, dass deine These noch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130826
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130826,
					"content": "*schluchz* Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130827
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130827,
					"content": "Du kennst die Abschlusskriterien der Akademie: Wenn du deinen Abschluss nach so vielen Jahren nicht erreichen kannst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130828
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130828,
					"content": "Ich ... Ich mach’s! Ich werde es tun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130829
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130829,
					"content": "Von Vahid habe ich auch etwas über Dünger gelernt ... Ich erledige das!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130830,
						728130831
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130830,
					"content": "Der Abschluss bringt einen echten Wachstumsschub ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130832
					]
				},
				{
					"id": 728130832,
					"content": "Dann ist die Sache erledigt, und ich überlasse dir den Dünger, Alrani, und ich werde mich um andere Dinge kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130833
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130833,
					"content": "Übrigens, vergesst nicht, Iwata zu sagen, dass er den Düngerhaufen etwas weiter weg legen soll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130834
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130834,
					"content": "Ich werde mich dann wieder meinen Nachforschungen widmen, Alrani, wenn du Fragen hast, kannst du mich fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130831,
					"content": "Der Abschluss ist wirklich die stärkste Motivation ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130832
					]
				},
				{
					"id": 728130824,
					"content": "Alrani, ich zähle auf dich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130825
					]
				}
			]
		},
		{
			"id": 7281309,
			"completionStepIds": [
				7281310
			],
