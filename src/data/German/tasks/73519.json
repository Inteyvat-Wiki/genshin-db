			"trigger": {
				"objectNames": [
					"Vinayak"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735190101,
					"content": "Das verstehe ich einfach nicht ... Sie ist doch diejenige, die vorgeschlagen hat, den Bericht im Kaffeehaus zu schreiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190102,
						735190103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190102,
					"content": "Wieso bist du denn allein hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				},
				{
					"id": 735190104,
					"content": "Ach, sprich nicht davon. Sie ging allein, um den Bericht zu schreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190105
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190105,
					"content": "Wir haben uns gestern im Kaffeehaus verabredet, aber sie kam erst sehr spät und hatte nicht einmal das Schreibzeug und das Material für den Bericht dabei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190106
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190106,
					"content": "Ich habe ihr vorgeworfen, dass sie unsere Zeit für den Bericht verschwendet, da ist sie wieder ausgerastet! Sie sagte, sie würde den Bericht allein schreiben, und hat mich rausgeschmissen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190107
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190107,
					"content": "... Das ist doch ungerecht, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190108
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190108,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190109
					]
				},
				{
					"id": 735190109,
					"content": "Ach, ich bin ihre ständigen Wutausbrüche ja schon gewohnt. In ein paar Tagen wird sie sich wieder beruhigt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190110
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190110,
					"content": "... Wenn ihr Charakter doch nur so simpel wie eine Vorrichtung wäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190111,
						735190112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190111,
					"content": "Viel Glück.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190113,
					"content": "Was? Wieso sagst du jetzt auch so komische Sachen ... Egal, jedenfalls gibt es hier noch ein paar gereizte Wenut. Sie würden sich zwar auch ohne unser Zutun wieder beruhigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190114
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190114,
					"content": "Aber wenn du Zeit hast, solltest du dich besser um sie kümmern, damit sie niemandem mehr gefährlich werden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190115
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190115,
					"content": "... Übrigens, die Elementarumgebung und der Aufladeapparat sind wieder in ihrem ursprünglichen Zustand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190116
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190116,
					"content": "Das ist die perfekte Gelegenheit, die volle Leistung der „Wenut-Kammerjägerkanone“ auszutesten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190112,
					"content": "Das musst du selbst ausbaden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190103,
					"content": "Wo ist Shriya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				}
			]
		}
	]
}