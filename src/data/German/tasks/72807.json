			"dialogs": [
				{
					"id": 728070201,
					"content": "Uff, was für Kopfschmerzen ... Hallo, was ist los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070202
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070202,
					"content": "Über Kamaji ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070203
					]
				},
				{
					"id": 728070203,
					"content": "Du sagtest Kamaji? Was willst du von ihm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070204
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070204,
					"content": "(Handgeschriebenen Brief zeigen)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070205
					]
				},
				{
					"id": 728070205,
					"content": "Du sagtest, dies sei Hiiragi Chisatos handgeschriebener Brief? Das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070206
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070206,
					"content": "Aber wenn dieser Brief wirklich von dieser Hiiragi Chisato ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070207
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070207,
					"content": "Es ist etwas, das du ... besser direkt Kamaji fragen solltest, er ist in letzter Zeit oft über die Brücke gegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sanada"
				}
			]
		},
		{
			"id": 7280703,
			"completionStepIds": [
				7280703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
