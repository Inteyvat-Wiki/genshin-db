			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kiminami Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728070401,
					"content": "Hallo und willkommen beim „Restaurant Kiminami“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070402
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070402,
					"content": "Über die Süßigkeiten, die Kamaji bestellt hat ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070403
					]
				},
				{
					"id": 728070403,
					"content": "Oh, ich habe die Snacks vorbereitet, die Kamaji bestellt hat, ich bringe sie dir jetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070404
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070404,
					"content": "Aber ich frage mich, wem Kamaji diese Snacks zu geben gedenkt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070405
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070405,
					"content": "Es ist nichts weiter als eine Geste der Öffentlichkeitsarbeit, Frau Kiminami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070406
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070406,
					"content": "Vor einiger Zeit hatte Hiiragi Shinsuke meinen Vater mit einer Ladung guten Tees beschenkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070407
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070407,
					"content": "Mein Vater weiß, dass Hiiragi Shinsukes Tochter, Hiiragi Chisato, Süßigkeiten liebt, also bat er mich, ein paar Süßigkeiten als Gegengeschenk zu schicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070408
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070408,
					"content": "#Ich war besorgt, dass es zu lange dauern würde, sie dorthin zu schicken, und der Weg holprig sein würde ... Also habe ich {F#diese Reisende}{M#diesen Reisenden} gebeten, die Süßigkeiten für mich zu überbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070409
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070409,
					"content": "Frau Kiminami, bitte zeige mir diese Süßigkeiten, damit ich eine Bestandsaufnahme machen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070410
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070410,
					"content": "Hmm ... Gut, hier sind die Süßigkeiten, bitte schau sie dir an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070411
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070411,
					"content": "In der Tat ist alles da. Danke, Fräulein Kiminami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070412
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070412,
					"content": "#Lass uns zur Seite gehen. {F#Reisende}{M#Reisender}, gehen wir aus dem Weg. Ich habe dir etwas zu sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070413
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070413,
					"content": "Das ist die „Reiseerlaubnis“, sie ist für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070414
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070414,
					"content": "Mit dieser Erlaubnis solltest du die Insel frei betreten und verlassen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070415
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070415,
					"content": "Danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070416
					]
				},
				{
					"id": 728070416,
					"content": "Gern geschehen. Da du diese Erlaubnis nun hast, wird es für dich einfacher sein, die Süßigkeiten für mich zu liefern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070417
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070417,
					"content": "Und ... und diesen Brief.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070418
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070418,
					"content": "Ist das dein handgeschriebener Brief?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070419
					]
				},
				{
					"id": 728070419,
					"content": "Ja, ich habe geschrieben, was mir am passendsten erschien ... und ich hoffe, dass Hiiragi es nicht als beleidigend empfindet, wenn sie ihn liest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070420
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070420,
					"content": "Bitte schicke diesen Brief an Hiiragi zusammen mit den Süßigkeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070421
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070421,
					"content": "Gehen wir wieder zurück ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070422
					]
				},
				{
					"id": 728070422,
					"content": "Du gehst dieses Mal mit einer „Reiseerlaubnis“ zurück, sodass du frei ein und ausgehen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070423
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070423,
					"content": "#Dann bitte, {F#Reisende}{M#Reisender}, es ist Zeit für mich, zu meinen offiziellen Pflichten zurückzukehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070424
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070424,
					"content": "Uff, wann werde ich in der Lage sein, direkt hinzugehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Kamaji"
				}
			]
		},
		{
			"id": 7280705,
			"completionStepIds": [
				7280705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
