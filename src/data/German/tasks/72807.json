			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujou Kamaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728070301,
					"content": "#Du bist ... ah, {F#eine Reisende}{M#ein Reisender} aus der Fremde. Was willst du von mir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070302
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070302,
					"content": "Über Hiiragi Chisatos handgeschriebenen Brief ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070303
					]
				},
				{
					"id": 728070303,
					"content": "Hat Hiiragi dich gebeten, diesen Brief zu überbringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070304
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070304,
					"content": "Die Handschrift, es ist wirklich ihre ... Das ist toll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070305
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070305,
					"content": "#Danke, dass du diese Reise extra gemacht hast, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070306
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070306,
					"content": "Wegen der „Reiseerlaubnis“ ... Da Hiiragi mich persönlich damit betraut hat, werde ich alles tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070307
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070307,
					"content": "Aber ich muss zurückgehen und diese „Reiseerlaubnis“ vorbereiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070308
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070308,
					"content": "Ich sag dir was, warte zuerst drüben im „Restaurant Kiminami“ auf mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070309
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070309,
					"content": "Warum willst du dorthin gehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070310
					]
				},
				{
					"id": 728070310,
					"content": "Das ... ist ein kleiner Gefallen, den du für mich tun sollst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070311
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070311,
					"content": "Ich habe tatsächlich ... vor einiger Zeit daran gedacht, etwas an Hiiragi zu schicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070312
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070312,
					"content": "Ich hatte einen Brief geschrieben und Kiminami gebeten, ein paar Snacks zu bestellen, die ich Hiiragi zusammen als Geschenk schicken wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070313
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070313,
					"content": "Aber wenn Vater herausfindet, dass ich einen Brief an Hiiragi schicke, könnte er ein wenig verärgert sein ... Ich habe darüber nachgedacht, wie ich einen Brief abschicken kann, und dann bist du zufällig gekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070314,
						728070320
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070314,
					"content": "Es ist nur ein Geschenk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070315
					]
				},
				{
					"id": 728070315,
					"content": "Mein Vater ist nicht sehr erfreut, dass ich mit Hiiragi korrespondiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070316
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070316,
					"content": "Ich verstehe auch seine Bedenken, als Mitglied des Kujou-Klans und als einer der Vollstrecker der Tenryou-Verwaltung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070317
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070317,
					"content": "Und Hiiragi ist die Tochter des Hiiragi-Klans der Kanjou-Verwaltung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070318
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070318,
					"content": "Wenn ich mich ihr zu sehr nähern würde, wäre es unvermeidlich, dass jemand das mitbekommt und die Situation ausnutzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070319
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070319,
					"content": "Obwohl es in der Tat nur ein Geschenk war, war es in den Augen einiger Leute so viel mehr als nur ein Geschenk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070326
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070326,
					"content": "Oh, über solche Kleinigkeiten möchte ich lieber nicht reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070327
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070327,
					"content": "#{F#Reisende}{M#Reisender}, bitte warte am „Restaurant Kiminami“ auf mich. Sobald ich die „Reiseerlaubnis“ genehmigt habe, bringe ich sie dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070320,
					"content": "Ist dein Vater sehr streng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070321
					]
				},
				{
					"id": 728070321,
					"content": "Mein Vater er ist ... Natürlich ist er sehr streng. Ich kann verstehen, warum er nicht wirklich will, dass ich mit Hiiragi korrespondiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070322
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070322,
					"content": "Schließlich bin ich ein Mitglied des Kujou-Klans und einer der Vollstrecker des Tenryou-Verwaltung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070323
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070323,
					"content": "Und Hiiragi ist die Tochter des Hiiragi-Klans der Kanjou-Verwaltung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070324
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070324,
					"content": "Wenn ich mich ihr zu sehr nähern würde, wäre es unvermeidlich, dass jemand das mitbekommt und die Situation ausnutzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070325
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070325,
					"content": "Obwohl es in der Tat nur ein Geschenk war, war es in den Augen einiger Leute so viel mehr als nur ein Geschenk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070326
					],
					"speakerTitle": "Kujou Kamaji"
				}
			]
		},
