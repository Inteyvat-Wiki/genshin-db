			"dialogs": [
				{
					"id": 736740301,
					"content": "He, hast du mich nicht hierher gebracht? Geh weiter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740302
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740302,
					"content": "Ah, egal. Dann bleib besser liegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740303,
						736740304
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740303,
					"content": "Ulman?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740305
					]
				},
				{
					"id": 736740305,
					"content": "#{F#Reisende}{M#Reisender}? Ach, lange nicht gesehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740306
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740306,
					"content": "Wie geht es dir? Reist du immer noch durch die Welt? Ich habe unglaubliche Geschichten über dich gehört. Du bist ein wahres Phänomen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740307
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740307,
					"content": "Hehe, um was für ein Problem kümmerst du dich diesmal in Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740308,
						736740310
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740308,
					"content": "Kannst du nicht etwas Fröhliches sagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740309
					]
				},
				{
					"id": 736740309,
					"content": "#Na gut, kommen wir zur Sache. {F#Reisende}{M#Reisender}, wie wäre es mit einer neuen Zusammenarbeit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740313
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740313,
					"content": "Sieh nur, das Land von Sumeru ist von Schätzen und Mora gesegnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740314
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740314,
					"content": "Genau wie früher ziehe ich immer noch Seelien an. Darunter gibt es auch die altbekannten „Schatz suchenden Seelien“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740315
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740315,
					"content": "Genau wie vorher. Du gehst mit den Seelien auf Schatzsuche und ich halte deine Bezahlung bereit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740316
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740316,
					"content": "Wir verdienen ein Vermögen, wenn wir zusammenarbeiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740317,
						736740321
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740317,
					"content": "Diesmal willst du wieder „Eisenmünzen“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740318
					]
				},
				{
					"id": 736740318,
					"content": "Nein, diesmal möchte ich die wertvolleren „antiken Eisenmünzen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740319
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740319,
					"content": "Nur ein Wort mehr!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740320
					]
				},
				{
					"id": 736740320,
					"content": "Und was für ein Wort! Dank ihm gibt es mehr Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740326
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740326,
					"content": "Dann ist die Sache abgemacht! Wir arbeiten wie vorher zusammen und werden viel Geld verdienen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740321,
					"content": "Kannst du nicht jemand anderen finden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740322
					]
				},
				{
					"id": 736740322,
					"content": "Ach ... Du sollst nur mit Bekannten zusammenarbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740323
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740323,
					"content": "Außerdem sind wir Freunde! Eine solche Gelegenheit biete ich keinen Fremden an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740324
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740324,
					"content": "Dein Mundwerk ist ganz schön geschmeidig geworden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740325
					]
				},
				{
					"id": 736740325,
					"content": "Hehe, ein gutes Mundwerk ist für den Verkauf bitter nötig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740326
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740310,
					"content": "Du siehst selbst ziemlich nach einem Problem aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740311
					]
				},
				{
					"id": 736740311,
					"content": "Haha, dann mach erst mal eine Pause! Ich halte deine Fäuste nicht aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740312
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740312,
					"content": "#Kommen wir zur Sache. {F#Reisende}{M#Reisender}, wie wäre es mit einer neuen Zusammenarbeit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740313
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740304,
					"content": "Was machst du denn hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740305
					]
				}
			]
		}
	]
}