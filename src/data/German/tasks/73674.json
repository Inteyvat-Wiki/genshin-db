					"Ulman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736740101,
					"content": "He, hast du mich nicht hierher gebracht? Geh weiter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740102
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740102,
					"content": "Ah, egal. Dann bleib besser liegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740103,
						736740104
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740103,
					"content": "Was machst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740106
					]
				},
				{
					"id": 736740106,
					"content": "Ach, sie hat mich schon wieder hereingelegt ... Ich bringe dich auf den neuesten Stand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740107
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740107,
					"content": "Hört sich vielleicht seltsam an, aber aus unerfindlichen Gründen werden Seelien von mir angezogen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740108
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740108,
					"content": "Unter den Seelien, die mir folgen, habe ich ein paar gefunden, die sehr gerne auf Schatzsuche gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740109
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740109,
					"content": "Ich bin nicht gut im Benennen, also nenne ich sie einfach „Schatz suchende Seelie“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740110
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740110,
					"content": "Sie sind talentierte Schatzsucher. Dank ihrer Hilfe habe ich viele Schätze ausgegraben und ein kleines Vermögen gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740111
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740111,
					"content": "Aber manchmal lassen sie mich plötzlich außer Acht. Vielleicht sind sie erschöpft oder finden mich langweilig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740112
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740112,
					"content": "Zu solchen Zeitpunkten suche ich mir einen Assistenten, der den Seelien gefällt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740113
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740113,
					"content": "Er führt die „Schatz suchenden Seelie“ auf Schatzsuche und ich ... verkaufe die Schätze für gutes Geld.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740114
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740114,
					"content": "Ich habe gehört, dass es in Sumeru überall Ruinen und Antiquitäten gibt. Also wollte ich mein Glück probieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740115
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740115,
					"content": "Und natürlich habe ich hier auch Seelien angezogen. Einige der „Schatz suchenden Seelien“ haben mich hierher gebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740116
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740116,
					"content": "Kaum habe ich mich an die Arbeit gemacht, da ignorieren sie mich schon wieder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740117
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740117,
					"content": "Huch? Warum bewegt sie sich plötzlich? Heißt das etwa ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740118
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740118,
					"content": "#{F#Reisende}{M#Reisender}, hast du Interesse an einer Schatzsuche mit Seelien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740119,
						736740120
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740119,
					"content": "Ich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740121
					]
				},
				{
					"id": 736740121,
					"content": "Das ist nicht nötig. Du musst ihnen nur folgen und graben, wenn sie stehen bleiben. So einfach ist das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740122
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740122,
					"content": "Und? Probiere es aus ... Falls du einen Schatz findest, möchte ich nur die „antiken Eisenmünzen“. Der Rest gehört dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740123
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740123,
					"content": "Außerdem bezahle ich dich angemessen, wenn du mir „antike Eisenmünzen“ bringst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740124,
						736740126
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740124,
					"content": "Ich kann einen Versuch wagen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740125
					]
				},
				{
					"id": 736740125,
					"content": "So ist’s recht! Du gefällst mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740130
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740130,
					"content": "Jedenfalls sind wir ab jetzt Partner!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740131
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740131,
					"content": "Bitte nimm das Notizbuch. Ich habe ein paar Schätze gefunden, die noch ausgegraben werden müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740132
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740132,
					"content": "#Ich zähle auf dich, {F#Reisende}{M#Reisender}. Bring mir auf jeden Fall „antike Eisenmünzen“ zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740126,
					"content": "Was sind „antike Eisenmünzen“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740127
					]
				},
				{
					"id": 736740127,
					"content": "Einfach gesagt, eine Art von Antiquität.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740128
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740128,
					"content": "Mit einem guten Netzwerk kann ich die „antiken Eisenmünzen“ gegen tolle Sachen tauschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740129
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740129,
					"content": "Auch ... wenn ich noch ein gutes Netzwerk aufbauen muss ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740130
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740120,
					"content": "Ich kann nicht mit ihnen sprechen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740121
					]
				},
				{
					"id": 736740104,
					"content": "Ist das ... eine Seelie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740105
					]
				},
				{
					"id": 736740105,
					"content": "Du meinst die hier? Ähm ... So ungefähr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740106
					],
					"speakerTitle": "Ulman"
				}
			]
		},
