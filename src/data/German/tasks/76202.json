					}
				]
			},
			"dialogs": [
				{
					"id": 762020301,
					"content": "Ein Windstoß weht dir ins Gesicht.\\nSeltsam, er schmeckt nach Doppelfruchtröllchen, Mittsommertorte, knusprigem Grillfleisch und fruchtigen Kräuterbonbons.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762020302
					]
				},
				{
					"id": 762020302,
					"content": "Urgh! Ein super süßer Windstoß ist Paimon direkt in die Kehle geweht! *hust* ... He! Wo sind wir? Diese Teekanne und die Tassen sehen wirklich, wirklich groß aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020303,
					"content": "Warte mal ... Sind wir etwa geschrumpft!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020304,
					"content": "Das fühlt sich an, als hätte Nicole hier ihre Finger im Spiel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020305
					]
				},
				{
					"id": 762020305,
					"content": "Entschuldigung, ich hatte gehofft, tierische Schauspieler einladen zu können, aber leider ... Ich bin es gewohnt, mit Schauspielern zu arbeiten, die eine eher ... „steinerne“ Miene haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020306
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020306,
					"content": "Hä? Nicole, du bist auch geschrumpft? Paimon dachte, du wärst riesig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020307,
					"content": "Nicole, die großartige und gewaltige Hexe, stützt den Himmel, während sie sich herabbeugt, um zu reden? Nein, danke! Ich bin mit meiner jetzigen Größe vollkommen zufrieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020308,
					"content": "Wie auch immer ... Willkommen zur Teegesellschaft der großen Hexe! Los, gießt euch Tee ein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7620204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
