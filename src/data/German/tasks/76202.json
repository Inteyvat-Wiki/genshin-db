				"points": []
			},
			"dialogs": [
				{
					"id": 762020401,
					"content": "War das jetzt ein bisschen viel? Keine Sorge, es ist ganz einfach – setzt eure Denkermützen auf, sucht überall und holt euch am Ende eure Belohnung ab. Genau die Art von Abenteuer, in der ihr beide brilliert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
