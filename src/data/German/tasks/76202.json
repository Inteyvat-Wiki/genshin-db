			"dialogs": [
				{
					"id": 762020601,
					"content": "Boah! Warum sind wir plötzlich einfach so runtergefallen? Und ist das eine ... riesige Mandragora-Statue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020602,
					"content": "Klong ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020603
					],
					"speakerTitle": "Tür ansehen"
				},
				{
					"id": 762020603,
					"content": "Warte einen Moment. Entschuldigung, nur eine kleine technische Schwierigkeit. Lass mich mal sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020604
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020604,
					"content": "Klick ... Klack ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020605
					],
					"speakerTitle": "Tür ansehen"
				},
				{
					"id": 762020605,
					"content": "Sie bewegt sich! He! Greift uns dieses Ding an!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020606,
					"content": "Aha, viel besser ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762021401,
					"content": "Was soll das heißen, viel besser!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762021402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762021402,
					"content": "#Hm? Diese Angriffe sind doch gar nicht schlimm, oder? Jetzt ist es an der Zeit, zu zeigen, was du kannst, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762021403
