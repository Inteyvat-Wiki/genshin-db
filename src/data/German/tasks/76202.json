			},
			"dialogs": [
				{
					"id": 762020901,
					"content": "Paimon fragt sich, warum du dich so sehr über diese Belohnungen freust, Nicole ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020902,
					"content": "#Paimon meint, wenn Paimon {NICKNAME} ein Geschenk gibt, freut sich Paimon auch auf {M#seine}{F#ihre} Reaktion. Aber bei Nicole wirkt das irgendwie anders?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020903,
					"content": "Was hab ich dir über geschenkte Gäule gesagt, Paimon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020904
					]
				},
				{
					"id": 762020904,
					"content": "Oh, mach dir darüber keine Sorgen. Das macht mir nichts aus! Im schlimmsten Fall zerstört meine Antwort ein paar Illusionen, die ihr über die Engel habt. Falls ihr dachtet, wir wären alle selbstlos und gütig, wird euch die Wahrheit vielleicht zum Umdenken bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020905
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020905,
					"content": "Was deine Frage angeht, liebste Paimon, meine Aufregung hat nichts damit zu tun, dass ich die Freude derer teile, die ich führe. Sie kommt vielmehr daher, dass ich die Pflichten erfülle, die mir auferlegt wurden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020906
					],
					"speakerTitle": "Nicole",
					"speakerSubtitle": "Nicole"
				},
				{
					"id": 762020906,
					"content": "Hä?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020907,
					"content": "Es begann alles mit der Geburt der Engel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020908
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020908,
					"content": "Wir bekamen die Aufgabe, alle Lebewesen auf diesem Land zu lieben, aber im Gegensatz zu den Göttern, die später kamen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020909
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020909,
					"content": "... unsere Fähigkeit, Emotionen wahrzunehmen, war primitiv und unausgereift. Meistens haben wir einfach die Befehle von oben ausgeführt, wie Maschinen, die Kommandos befolgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020910
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020910,
					"content": "Neben der „Erleuchtung“ war die „Anleitung“ unsere Hauptaufgabe. Es war einer der wenigen Instinkte, die meine früheren Gefährten behielten, nachdem ihnen ihre Weisheit genommen wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020911
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020911,
					"content": "Wenn wir unsere Aufgaben erfüllten, verspürten wir eine gewisse freudige Erleichterung. Das war das intensivste Gefühl, das ein Engel normalerweise erleben konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020912
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020912,
					"content": "Ist das nicht ... irgendwie traurig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020913,
					"content": "Vielleicht, aber ich sehe das lieber nicht als etwas, das Mitleid verdient. Schließlich kann nicht einmal der große Herr des Firmaments die Wahrheit der Emotionen in meinem Herzen leugnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020914
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020914,
					"content": "Und außerdem ist es doch an sich eine gute Sache, andere zu leiten, findest du nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
