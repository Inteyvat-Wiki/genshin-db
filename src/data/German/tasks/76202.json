			"dialogs": [
				{
					"id": 762020201,
					"content": "Willkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020202,
						762020203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020202,
					"content": "Hallo, Nicole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				},
				{
					"id": 762020204,
					"content": "Wah, dein Zuhause ist wirklich schön! Paimon findet das, was du damit gemacht hast, fantastisch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020205,
					"content": "Hehe, ich wusste, dass dir das gefallen würde, Paimon. Das zu hören, macht alles lohnenswert, auch wenn ich es in meiner Freizeit reinquetschen musste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020206,
					"content": "Es begann an dem Tag, an dem ich diese geheime Hütte fertiggebaut hatte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020207,
					"content": "Ich hatte vor, das fortzuführen und noch ein paar mehr zu bauen, aber es war niemand da, der mich inspirierte. Also ist meine Begeisterung nach einer Weile einfach so ... verpufft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020208,
					"content": "„Gibt es keinen Weg, Spaß zu haben, mich zu amüsieren und dabei das Gefühl zu haben, etwas erreicht zu haben?“ Und plötzlich kam mir die Antwort in den Sinn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020209,
					"content": "Moment, sind wir direkt zur Antwort gesprungen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020210,
					"content": "Komm schon, Paimon – die Zeit wartet auf niemanden. Schau, es ist direkt vor deinen Augen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020211,
					"content": "Durch diese Tür?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020212,
					"content": "Nun, nicht nur diese Tür, aber du hast nicht unrecht. Alles muss irgendwo anfangen – wo wäre ein besserer Ort als hier? Seid ihr bereit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020213
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020213,
					"content": "W... Warte mal, das geht zu schnell! Paimon kommt nicht hinterher ... Wofür sollen wir denn bereit sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020214,
					"content": "Oh, keine Sorge. Ihr müsst für nichts bereit sein – das ist nur so eine Redewendung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020215
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020215,
					"content": "Nach meinen Beobachtungen und meinem Verständnis ... seid ihr keine Fans von komplizierten Einführungen und Erklärungen. Ihr findet euren Spaß lieber in der Hitze des Abenteuers, habe ich recht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020216,
						762020217
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020216,
					"content": "Nun ja ... damit liegst du nicht falsch ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020218,
					"content": "Haha, das freut mich zu hören! Dann macht euch bereit – ich hab nicht vor, mich zurückzuhalten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020219
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020219,
					"content": "#{NICKNAME}, du kennst uns Engel doch – das Gefühl, Menschen zu ihren Schätzen zu führen, lässt uns einfach nicht los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020220
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020220,
					"content": "Also, wenn es darum geht, nett zu sein und anderen zu helfen, Glück zu finden, warum sollte ich dann nicht bei meinen eigenen Freunden anfangen und ihnen ein paar fröhliche Hinweise geben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020221
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020221,
					"content": "Also hatte ich einen Geistesblitz! Ich habe meine kleine Hütte in einen Ort verwandelt, an dem du entspannen und Spaß haben kannst. Ich habe sogar in jedem Raum einen Schatz versteckt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020222
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020222,
					"content": "Ehrlich gesagt, bin ich selbst im Vergleich zu anderen Engeln eine echte Expertin, wenn es ums Verstecken geht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020223
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020223,
					"content": "Wenn ich eine Truhe in der Wildnis vergraben und dir den Weg nicht zeigen würde, würdest du sie wohl selbst nach Monaten nicht finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020224
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020224,
					"content": "*Hust hust* ... Egal ... Ich schweife ab ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020225
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020225,
					"content": "Ich will es euch nicht absichtlich schwer machen, und ihr müsst auch nicht draußen in der Wildnis herumlaufen, nur um mich zu unterhalten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020226
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020226,
					"content": "Alles, was ihr tun müsst, ist, drei Federn zu finden, genau hier in diesem Raum! Und sobald ihr fertig seid, sagt mir Bescheid, damit ich dabei sein kann, wenn ihr eure Belohnung öffnet – eine schöne, große Truhe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020227
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020227,
					"content": "Aaah, wir gehen also auf Schatzsuche! Paimon kann es kaum erwarten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020228,
					"content": "Genau! Eine Schatzsuche. Das wird lustig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020217,
					"content": "Aber diesmal hätte ich doch gerne eine Einführung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020203,
					"content": "Es ist mir eine Ehre, hier sein zu dürfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				}
			]
		},
