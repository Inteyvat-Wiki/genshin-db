			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790080101,
					"content": "Das sollte es sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080102
					],
					"speakerTitle": "Untersuchen"
				},
				{
					"id": 790080102,
					"content": "Hmm? Es gibt einen Brief daneben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080103
					],
					"speakerTitle": "Untersuchen"
				},
				{
					"id": 790080103,
					"content": "Für den Freund, der vielleicht das Glück hat, hierherzukommen,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080104
					],
					"speakerTitle": "Untersuchen"
				},
				{
					"id": 790080104,
					"content": "Hallo du, Reisender aus der Ferne. Wenn du diesen Brief liest, dann musst du das Harpastum gefunden haben, das ich hier hinterlassen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080105
					],
					"speakerTitle": "Untersuchen"
				},
				{
					"id": 790080105,
					"content": "Auf dem Goldapfelarchipel gibt es viele Spiele, die mit Harpasta zu tun haben, und ich und meine Freunde haben hier einen wunderbaren Sommer verbracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080106
					],
					"speakerTitle": "Untersuchen"
				},
				{
					"id": 790080106,
					"content": "Deshalb habe ich hier ein Harpastum hinterlassen, das ich selbst gemacht habe, in der Hoffnung, dass du, falls du dieses Harpastum gefunden hast, die gleichen Freuden erleben könnt wie ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080107
					],
					"speakerTitle": "Untersuchen"
				},
				{
					"id": 790080107,
					"content": "Genieße den Sonnenschein, die Meeresbrise und die Sommerspiele in vollen Zügen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080108
					],
					"speakerTitle": "Untersuchen"
				},
				{
					"id": 790080108,
					"content": "-Barbara",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080109
					],
					"speakerTitle": "Untersuchen"
				},
				{
					"id": 790080109,
					"content": "Oh, das ist so typisch Barbara! Wir haben jetzt endlich ein Harpastum, also komm, lass uns spielen gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Untersuchen"
				}
			]
		},
