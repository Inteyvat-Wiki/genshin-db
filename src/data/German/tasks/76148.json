			"dialogs": [
				{
					"id": 761480101,
					"content": "Waah, wo wart ihr denn gerade! Paimon hat sich zu Tode erschreckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761480102,
					"content": "Paimon hat die ganze Zeit eure Namen gerufen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761480103,
					"content": "Warum wurde Paimon nicht in das Intervall der Gleichgültigkeit gezogen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480104
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480104,
					"content": "Vielleicht denkt sie außer ans Essen und Schlafen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480105
					]
				},
				{
					"id": 761480105,
					"content": "... sonst an nichts anderes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480106
					]
				},
				{
					"id": 761480106,
					"content": "Hm. Stimmt auch wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480107
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480107,
					"content": "Melanta scheint wirklich richtig wütend zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480108
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480108,
					"content": "#Es drängt jetzt wirklich, dass wir {NICKNAME} hochschicken, sich Melanta zu stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480109
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480109,
					"content": "Reden wir woanders. Hier ist es nicht mehr wirklich sicher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480110
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480110,
					"content": "Ähm, auch wenn es niemanden interessiert ... Hallo allerseits, ich heiße Alara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alara"
				}
			]
		},
		{
			"id": 7614807,
