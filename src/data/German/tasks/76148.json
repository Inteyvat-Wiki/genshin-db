						"pointId": 118
					},
					{
						"sceneId": 103,
						"position": [
							252.49,
							-645.37,
							394.33
						],
						"pointId": 119
					}
				]
			},
			"dialogs": [
				{
					"id": 761480701,
					"content": "Schon wieder hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480702
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480702,
					"content": "Mein letzter Besuch hier ... in Menschenleben gerechnet, war das wohl vor vielen, vielen, vielen, vielen ... vielen Generationen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480703
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480703,
					"content": "Es sieht so aus, als wären wir wieder in das Intervall der Gleichgültigkeit geworfen worden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480704
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480704,
					"content": "Und wie kommen wir hier raus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480705
					]
				},
				{
					"id": 761480705,
					"content": "Die übliche Methode ist, zu meditieren und zu lernen, Herz und Gedanken zu kontrollieren. Und dann lässt man alle Sehnsüchte los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480706
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480706,
					"content": "Man muss diesen Zustand, in dem man an nichts denkt, halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480707
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480707,
					"content": "Das klingt einfach. Aber je nach Begabung und wie stark die eigenen Wünsche sind, kann es Jahre oder sogar Jahrhunderte dauern, bis man das schafft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480708
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480708,
					"content": "Für jemanden wie dich, der das Schicksal der Welt auf seinen Schultern trägt, ist es wohl unmöglich, dieses Verlangen loszuwerden. Außerdem solltest du das auch gar nicht tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480709
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480709,
					"content": "Was sollen wir denn tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480710
					]
				},
				{
					"id": 761480710,
					"content": "Lass uns erst Zeitlind finden, dann überlegen wir weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480711
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480711,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480712
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761480712,
					"content": "Was hast du da gefunden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480713
					]
				},
				{
					"id": 761480713,
					"content": "Moment, Dex wurde auch mit hier reingezogen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480714
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480714,
					"content": "Dann gibt es vielleicht doch noch Hoffnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480715
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480715,
					"content": "Da Dex auch ein Wächter ist, kann er vielleicht die Kraft dieser Fragmente nutzen – und so einen Ausweg erzwingen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480716
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480716,
					"content": "Wir müssen diesen Fragmenten einen Namen geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480717
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480717,
					"content": "Von diesen übertriebenen Särgen habe ich schon gehört, sie sind das Werk einer Schwester der Meisterin des Tempels. Sie scheinen „Särge von Maranasati“ zu heißen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480718
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480718,
					"content": "Dann nennen wir diese Bruchstücke doch einfach „Fragmente der Vergänglichkeit“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		}
	]
}