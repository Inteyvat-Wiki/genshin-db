				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200300201,
					"content": "Ich heiße euch hiermit offiziell als neue Mitglieder in der Abenteurergilde willkommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300202,
					"content": "Hier ist deine <color=#00E1FFFF>„Abenteurerlizenz“</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300203,
						200300205
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300203,
					"content": "Man bekommt sogar eine Lizenz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300204
					]
				},
				{
					"id": 200300204,
					"content": "Natürlich braucht man etwas feierliche Stimmung, wenn jemand der Gilde beitritt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300207,
					"content": "Darin findest du viele Informationen über die Missionen und Belohnungen der Gilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300208
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300208,
					"content": "Darüber hinaus dient sie als Beweis für deine Mitgliedschaft. Sieh öfter mal hinein und bewahre sie gut auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300209
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300209,
					"content": "Ach, eins noch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300210
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300210,
					"content": "Manchmal könnte es dir so vorkommen, als würde deine Abenteuerstufe keine Fortschritte mehr machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300211
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300211,
					"content": "Wenn du dort angelangt bist, kannst du einige Aufträge ausführen, die besonders Eindruck hinterlassen, um die Anerkennung der Gilde zu erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300212
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300212,
					"content": "Aufträge ... die besonders Eindruck hinterlassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300213,
					"content": "Man kann sie auch als Aufträge zum Durchbruch der Abenteuerstufe bezeichnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300214
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300214,
					"content": "Jetzt ist die Zeit dafür aber noch nicht reif. Sobald du genügend Erfahrung hast, werden sich genügend Gelegenheiten bieten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300215
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300215,
					"content": "Das wär’s dann wohl für heute. Wir werden uns noch recht häufig sehen, schätze ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300216
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300216,
					"content": "Ad astra abyssosque, Abenteurer! Zu den Sternen und Abgründen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300205,
					"content": "Sieht aber eher aus wie ein Werbeheft.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300206
					]
				},
				{
					"id": 200300206,
					"content": "Irgendwie schon, aber es hat noch viel mehr zu bieten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "Katheryne"
				}
			]
		}
	]
}