				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301011",
							"2"
						],
						"stepId": 1301011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno",
					"Bahari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100701,
					"content": "Oha! Du hast wirklich einen erwischt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100702,
					"content": "Bist du der Schurke, der hinter dem Ganzen steckt? Sag sofort, was du weißt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100703,
						130100704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100703,
					"content": "Weiß der überhaupt etwas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				},
				{
					"id": 130100705,
					"content": "Als er auftauchte, habe ich nicht gleich zugeschlagen, ich habe ihn erst eine Weile beobachtet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100706
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100706,
					"content": "Er ist nicht der Strippenzieher, aber er ist ein wichtiger Geschäftsmann. Hab ich recht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100707
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100707,
					"content": "Wahrhaftig Cyno, gut beobachtet ... Wenn ich gewusst hätte, dass du noch hier bist, wäre ich nicht so gierig nach diesem Ramsch gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100708
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100708,
					"content": "Gierig nach Ramsch? Wie meinst du das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100709,
					"content": "Als sie von deinem Kommen erfuhren, haben all die Wissenskonserven-Händler die Fliege gemacht, ohne sich noch um ihre ganzen Waren kümmern zu können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100710
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100710,
					"content": "Diese Sachen haben im Moment alle keinen Besitzer, man muss sie nur den anderen vor der Nase wegschnappen, dann kann man eine Stange Geld verdienen. Klar, für mich hat sich das jetzt erledigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100711
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100711,
					"content": "Du musst wissen, wer die Wissenskonserven herstellt und verkauft. Muss ich dich zwingen oder sprichst du von selbst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100712
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100712,
					"content": "Ich werde reden. Aber vorher möchte ich an einen anderen Ort gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100713
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100713,
					"content": "Wenn wir hier bleiben, könnte jemand beobachten, wie ich mit euch spreche, dann wären ich und meine ganze Familie in Gefahr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100714
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100714,
					"content": "Wohin sollen wir gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100715
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100715,
					"content": "Nach Hause, ins Aaru-Dorf, dort ist es sicher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100716
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100716,
					"content": "#Na gut. {NICKNAME}, wirf den Positionsgeber weg und dann los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100704,
					"content": "Ist er genug „wichtig“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				}
			]
		},
		{
			"id": 1301008,
			"completionStepIds": [
				1301008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301008",
							"2"
						],
						"stepId": 1301008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Simin",
					"Bahari",
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100801,
					"content": "Papa, du bist zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100802
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100802,
					"content": "Oh, sind das Kunden? Hallo ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100803
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100803,
					"content": "Das ist meine Tochter, Simin, sie ist etwas schüchtern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100804
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100804,
					"content": "Schatz, spiele eine Weile allein, Papa muss etwas mit den Kunden besprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100805
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100805,
					"content": "Oh ... Na gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100806
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100806,
					"content": "Cynos Name ist in der Branche wohlbekannt. Wie heißt ihr beiden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100807
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100807,
					"content": "#Paimon. Und das ist {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100808,
					"content": "Um ehrlich zu sein, ich hätte nicht gedacht, dass der einzelgängerische Cyno mit Partnern unterwegs sein könnte. Deshalb war ich mir sicher, dass Cyno aufgegeben hatte, als sich der Positionsgeber entfernte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100809
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100809,
					"content": "Obwohl ihr mich erwischt habt, gebe ich euch einen Rat ... Lasst es dabei bewenden, schnüffelt nicht weiter herum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100810
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100810,
					"content": "Warum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100811
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100811,
					"content": "Herstellung, Verkauf, Anteile ... Jedes Glied umfasst mindestens ein Dutzend bis zu über hundert Leute, alle vereint durch die hohen Profite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100812
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100812,
					"content": "Um diese mühsam errichtete Industriekette aufrechtzuerhalten, wird jeder Beteiligte seine ganze Kraft einsetzen. Selbst jemand wie du muss bei dem Ganzen auf der Strecke bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100813
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100813,
					"content": "Und selbst wenn du es durchziehen könntest, wäre dir niemand dankbar dafür. Vielleicht würdest du dich sogar selbst schlecht dabei fühlen ... Warum ich mich damals so bemüht habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100814
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100814,
					"content": "Jeder hat seine eigene Beharrlichkeit, mehr gibt es dazu nicht zu sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100815
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100815,
					"content": "*seufz* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100816
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100816,
					"content": "Papa ... Trink etwas Tee ... Und die Gäste auch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100817
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100817,
					"content": "Oh. Da hab ich doch glatt vergessen, den Gästen Tee zu servieren. Vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100818
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100818,
					"content": "Gerne ... Unser ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100819
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100819,
					"content": "Unser Tee ist sehr bitter, deshalb habe ich etwas von dem Zucker, den mir Papa gegeben hat, hineingetan. Jetzt schmeckt er bestimmt besser ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100820
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100820,
					"content": "Wie aufmerksam von dir. Hast du noch Zucker? Sonst kauft dir Papa nächstes Mal noch welchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100821
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100821,
					"content": "Gut, ich werde jetzt eine Pause machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100822
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100822,
					"content": "Sagtest du nicht, dass alle beteiligten gigantische Profite machen? Das sieht man dir gar nicht an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100823
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100823,
					"content": "... Das ist es ja, was ich euch sagen wollte. Ich habe eine Bitte an euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100824
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100824,
					"content": "Meine Tochter leidet seit ihrer Geburt an einer chronischen Krankheit. Ihr Herz-Lungen-Kreislauf ist schwächer als normal. Selbst eine geringe Anstrengung kann bei ihr schon zu einer Ohnmacht führen und ist sogar lebensgefährlich für sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100825
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100825,
					"content": "Deshalb hat sie auch noch nie Freunde zum Spielen und schließt sich den ganzen Tag in ihrem Zimmer ein. Außerdem muss sie eine Menge Medikamente einnehmen, die sehr teuer sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100826
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100826,
					"content": "Und ich, ich war eigentlich nur ein kleiner Geschäftsmann. Ich arbeitete von früh bis spät und war immer unterwegs. Das bisschen Einkommen hat nicht gereicht und ich konnte nur dabei zusehen, wie sie von Tag zu Tag schwächer wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100827
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100827,
					"content": "Bis jemand zu mir kam und mir gezeigt hat, wie ich zu Geld kommen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100828
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100828,
					"content": "Wissenskonserven verkaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100829
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100829,
					"content": "Genau. Seitdem ich Geld verdiene, kann sie endlich behandelt werden. Zu sehen, wie es ihr besser geht, macht mich zum glücklichsten Menschen auf der ganzen Welt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100830
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100830,
					"content": "Es geht vielen wie mir. Der Verkauf von Wissenskonserven mag für dich unverzeihlich sein, aber für uns ist es der einzige Weg, um zu existieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100831
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100831,
					"content": "Ich erzähle dir das alles, um dich zu überzeugen ... Aufzuhören, Herr Cyno, und uns unsere Existenz zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100832
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100832,
					"content": "Das kann nicht sein ... Das heißt, wenn wir den Verkauf der Wissenskonserven unterbinden, dann wird sie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100833,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100834
					]
				},
				{
					"id": 130100834,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100835
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100835,
					"content": "Ich muss die Wahrheit erfahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100836
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100836,
					"content": "Ich kann jemanden finden, der deine Tochter behandelt, aber vor dem Wissenskonserven-Schmuggel kann ich meine Augen nicht verschließen. Das sind zwei verschiedene Dinge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100837
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100837,
					"content": "Ich wusste, dass du das sagen würdest, aber das reicht mir. Wenn du wirklich so entschlossen bist, deine Ermittlungen fortzusetzen, dann wirf einen Blick hinter das Haus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100838
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100838,
					"content": "Dort ist die Ware, die ich kürzlich erhalten habe, wenn du sie gesehen hast, wirst du es verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100839
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100839,
					"content": "Ihr geht mit Cyno hinter das Haus.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130100840
					]
				},
				{
					"id": 130100840,
					"content": "So viel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100841
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100841,
					"content": "Mit Kisten vollgestapelt. Und das ist nur das Versteck eines einzigen Händlers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100842
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100842,
					"content": "Diese Menge kann unmöglich in einer kleinen Werkstatt hergestellt worden sein. Ist es wirklich die Akademie? Es ist jedenfalls unmöglich, dass so eine große Menge Waren an der Kontrolle vorbeikommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100843
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100843,
					"content": "Schau, diese Wissenskonserven sehen anders aus, könnten das die Wissenskonserven sein, die etwas über den Hof der Trübsal enthalten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100844
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100844,
					"content": "So muss es sein. Wartet, das ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100845,
						130100846
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100845,
					"content": "Ein mir unbekanntes Zeichen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				},
				{
					"id": 130100847,
					"content": "Das ist der Freigabestempel der Matra. Der Stempel beweist, dass die enthaltene Ware durch die Matra überprüft worden ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100848
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100848,
					"content": "Als ich den Positionsgeber sah, wusste ich, dass jemand von der Akademie darin verwickelt sein könnte. Aber ich konnte mir nicht vorstellen, wie so viele Wissenskonserven aus der Akademie geschafft werden konnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100849
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100849,
					"content": "Jetzt verstehe ich es. Mit diesem Stempel kann die Ware aus der Akademie geschafft werden, ohne dass sie ein zweites Mal überprüft werden muss. Dadurch kann sie frei bewegt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100850
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100850,
					"content": "Hm, kein Wunder, dass ich nicht weiter ermitteln soll. Es sind die Matra selbst, die die Disziplin untergraben. Das ist ungeheuerlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100851
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100851,
					"content": "Vielleicht ist es ein Missverständnis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100852
					]
				},
				{
					"id": 130100852,
					"content": "#{NICKNAME}, kann ich dich um etwas bitten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100853
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100853,
					"content": "Da diese Wissenskonserven aus der Akademie stammen, ist es sehr wahrscheinlich, dass diese Wissenskonserven über den Hof der Trübsal eigentlich mit dem von der Akademie versiegelten Forschungsmaterial gefüllt sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100854
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100854,
					"content": "Wir müssen nur die Aufzeichnungen im Aktenarchiv der Matra durchsehen, dann werden wir wissen, wer hier ein mieses Spiel spielt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100855
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100855,
					"content": "Aber wenn ich jetzt plötzlich selbst in der Akademie auftauchen würde, würde ich nur im Wespennest herumstochern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100856
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100856,
					"content": "Kann ich dich bitten, dir das anzusehen? Ich schreibe eine Nachricht an Nabil und bitte ihn, dich in das Aktenarchiv zu bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100857
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100857,
					"content": "Überlass das uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100858
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100858,
					"content": "Ich werde inzwischen nicht auf der faulen Haut liegen. Die Hinweise auf den Drahtzieher deuten zwar in Richtung Akademie, aber der Gegner hat offensichtlich auch große Macht außerhalb der Akademie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100859
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100859,
					"content": "Von Bahari kann ich Informationen über andere Händler bekommen. Ich bleibe hier und treffe ein paar Vorbereitungen. Wenn ihr etwas herausfindet, könnt ihr jederzeit zu mir kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100846,
					"content": "Kennst du es, Cyno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				}
			]
		},
		{
			"id": 1301010,
			"completionStepIds": [
				1301010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301010",
							"2"
						],
						"stepId": 1301010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130101001,
					"content": "Puh ... So müde. Nach so einem weiten Weg ist das doch in Ordnung, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101002,
						130101004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101002,
					"content": "Ist in Ordnung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130101003
					]
				},
				{
					"id": 130101003,
					"content": "Juhu! Dann lass uns hier ein bisschen ausruhen und danach gehen wir zurück zu Cyno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101006,
					"content": "Ihr setzt euch in der Nähe hin und rastet eine Weile.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130101007
					]
				},
				{
					"id": 130101007,
					"content": "Paimon denkt, das war lange genug, wollen wir zurück zur Auktion gehen und nachsehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101008,
					"content": "Vielleicht hat Cyno etwas gefunden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101004,
					"content": "Wir gehen noch etwas weiter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130101005
					]
				},
				{
					"id": 130101005,
					"content": "Du willst weitergehen? Aber Paimon ist schon vollkommen erschöpft ... Lass uns doch lieber ein bisschen hier ausruhen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101006
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
