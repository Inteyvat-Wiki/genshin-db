					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100610,
					"content": "Hast du etwas entdeckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100611
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100611,
					"content": "He ... Es scheint hier nichts Besonderes zu geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100612,
					"content": "Das sind alles herkömmliche Wissenskonserven.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100613
					]
				},
				{
					"id": 130100613,
					"content": "Vielleicht waren die Wissenskonserven, die Informationen zum Hof der Trübsal enthalten, nur von geringer Zahl und sie haben sie mitgenommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100614
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100614,
					"content": "#Nicht so schlimm, ich habe noch einen Plan. {NICKNAME}, ihr geht den Weg zurück und ich verstecke mich hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100615
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100615,
					"content": "Nach einer Weile kommt ihr zurück und trefft mich hier, dann sollten wir etwas haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100616
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100616,
					"content": "Kein Wunder, dass ich den Positionsgeber behalten sollte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100617
					]
				},
				{
					"id": 130100617,
					"content": "Sie mussten eiligst verschwinden und viel Stoff zurücklassen, den werden sie unmöglich hier liegen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100618
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100618,
					"content": "Wenn sie sicher sind, das wir „verschwunden“ sind, wird sicher jemand kommen, um hier aufzuräumen. Deshalb muss der Positionsgeber weit genug weg sein, um sie glauben zu machen, sie seien in Sicherheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100619
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100619,
					"content": "Paimon versteht! Du nutzt uns als Köder, um sie zu täuschen, damit sie zurückkommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100620,
					"content": "Gut, dann gehen wir gleich und überlassen das hier dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100621,
					"content": "Keine Sorge. Wenn sie es wagen, sich zu zeigen, lasse ich sie nicht entkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				}
			]
		},
