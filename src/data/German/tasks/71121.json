			},
			"dialogs": [
				{
					"id": 711210201,
					"content": "Ein großes Dankeschön! Ohne euren Superhelden-Einsatz hätten sie meine Ware komplett zerlegt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210202
					],
					"speakerTitle": "Seltsamer Händler"
				},
				{
					"id": 711210202,
					"content": "Ach, keine falsche Bescheidenheit. Ich habe nicht viel Geld bei mir. Also nehmt das hier als kleines Dankeschön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210203
					],
					"speakerTitle": "Seltsamer Händler"
				},
				{
					"id": 711210203,
					"content": "Waah, das ist aber großzügig von dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711210204,
					"content": "Haha, dann wollen wir unsere Wege gehen. Ich hoffe, wir werden uns wieder einmal begegnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Seltsamer Händler"
				}
			]
		},
		{
			"id": 7112103,
