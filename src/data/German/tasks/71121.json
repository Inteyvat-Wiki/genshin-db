			"dialogs": [
				{
					"id": 711215101,
					"content": "#Gro... {M#Großer Held}{F#Große Heldin}! ... verschone mich! Ich habe nichts mit ihnen zu tun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215102
					],
					"speakerTitle": "Seltsamer Händler"
				},
				{
					"id": 711215102,
					"content": "Wer bist du!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711215103
					]
				},
				{
					"id": 711215103,
					"content": "Ich bin ... Ich ... Ähm, es ist kompliziert ... Die haben einige Gegenstände gestohlen und ich erhielt den Auftrag, alle in ein Verzeichnis einzutragen und zurückzubringen, das ist alles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215104
					],
					"speakerTitle": "Seltsamer Händler"
				},
				{
					"id": 711215104,
					"content": "Nun! Ihr habt die Diebe alle in die Flucht geschlagen. Meine Arbeit hier ist auch beendet. Zeit, Lebewohl zu sagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215105
					],
					"speakerTitle": "Seltsamer Händler"
				},
				{
					"id": 711215105,
					"content": "Warte ...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711215106
					]
				},
				{
					"id": 711215106,
					"content": "Kein Problem, wir werden uns auf jeden Fall wiedersehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Seltsamer Händler"
				}
			]
