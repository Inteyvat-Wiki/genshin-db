				"points": []
			},
			"dialogs": [
				{
					"id": 711210301,
					"content": "Gro... Große Helden ... habt Gnade ... Äh? Seid ihr es!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210302
					],
					"speakerTitle": "Seltsamer Händler"
				},
				{
					"id": 711210302,
					"content": "Du bist es!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210303
					]
				},
				{
					"id": 711210303,
					"content": "Hehe, welch ein Zufall ... Haha, macht ihr erst einmal weiter. Ich muss kurz weg ... Entschuldigt mich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210304
					],
					"speakerTitle": "Seltsamer Händler"
				},
				{
					"id": 711210304,
					"content": "Ich rate dir, schau dir an, welche Schätze sie hiergelassen haben. Oh ... Keine Sorge, ich habe sie sämtlich verzeichnet ... Ich werde alles zurückgeben, was zurückgegeben werden muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210305
					],
					"speakerTitle": "Seltsamer Händler"
				},
				{
					"id": 711210305,
					"content": "Warte ...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210306
					]
				},
				{
					"id": 711210306,
					"content": "Kein Problem, wir werden uns auf jeden Fall wiedersehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Seltsamer Händler"
				}
			]
		},
