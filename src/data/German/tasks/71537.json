			"dialogs": [
				{
					"id": 715370101,
					"content": "#Ehrenritter{F#in}, ich kann nicht glauben, dass ich dich hier treffe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370102
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370102,
					"content": "Bastelst du Glückwunschkarten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715370103
					]
				},
				{
					"id": 715370103,
					"content": "Ja, ich bin endlich hier in Liyue im Urlaub und möchte Geschenke kaufen, um sie allen im Ritterorden zu bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370104
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370104,
					"content": "Dann hörte ich, dass die Leute in Liyue während des Laternenrituals normalerweise eine Glückwunschkarte dazulegen, wenn sie jemandem ein Geschenk überreichen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370105
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370105,
					"content": "Also wollte ich ihrem Beispiel folgen und ein paar hübsche Glückwunschkarten basteln. Aber meine Karten sehen nicht gerade gut aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370106
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370106,
					"content": "#Ich möchte sie alle sehr schön gestalten. Kannst du mir zeigen, wie man das macht, Ehrenritter{F#in}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370107
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370107,
					"content": "Na klar, ich mach das für dich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
