					"Ruu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722270101,
					"content": "#{NICKNAME} sieht beim Kämpfen so gut aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270102
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270102,
					"content": "Ruu ist hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270103,
						722270104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270103,
					"content": "Alles in Ordnung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270105
					]
				},
				{
					"id": 722270105,
					"content": "Mir ... geht’s gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270106
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270106,
					"content": "Was ist mit diesen Monstern ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270108
					]
				},
				{
					"id": 722270108,
					"content": "Ich frage mich, woher diese Monster kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270109
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270109,
					"content": "In der Tat sehen sie nicht aus, als wären sie von hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270110,
					"content": "Hm. Früher gab es diese Dinger hier nicht und auch nicht diese Roboter mit den vielen Haaren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270111
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270111,
					"content": "Früher gab es hier ein Tier, das „Wen Kamuy“ genannt wurde. Aber es war sehr zahm und es war auch sehr lecker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270112
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270112,
					"content": "Noch nie davon gehört.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270113
					]
				},
				{
					"id": 722270113,
					"content": "Ich denke schon. Seit wann sind in unserer Gegend alle Wen Kamuy verschwunden und diese Kerle aufgetaucht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270114
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270114,
					"content": "Ich frage mich, ob sie von außerhalb des „Nebelmeeres“ kamen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270115
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270115,
					"content": "Da draußen gibt es Monster wie Hilichurle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270116
					]
				},
				{
					"id": 722270116,
					"content": "Das klingt ja gefährlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270117,
						722270119
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270117,
					"content": "Es ist auch gefährlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270118
					]
				},
				{
					"id": 722270118,
					"content": "Aber die Erlebnisse beim Abenteuer sind auch toll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270120,
					"content": "Ich will auch ein Abenteuer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270121
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270121,
					"content": "Dann muss Ruu erwachsen werden und Abenteurer werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270122,
					"content": "Ja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270123
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270123,
					"content": "Dann überlasse diesen Nistbaum uns. Schließlich gibt es Monster und es wäre gefährlich für Ruu, so herumzulaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270124,
					"content": "Überlass das ruhig uns!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 722270119,
					"content": "Aber das Abenteuer macht auch Spaß!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270120
					]
				},
				{
					"id": 722270104,
					"content": "Hast du dich verletzt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270105
					]
				}
			]
		},
		{
			"id": 7222702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
