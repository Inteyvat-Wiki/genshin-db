			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721250102,
					"content": "Er wäre besser, mehr Blumen zu pflanzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250103
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250103,
					"content": "Ah, hallo! Ich freue mich darüber, dich kennenzulernen ... Darf ich fragen, ob du einer der Leute bist, die zurückgekommen sind, um hier zu leben? Entschuldigung, ich glaube, ich habe dich noch nie gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250104,
						721250109
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250104,
					"content": "Zurückkommen, um hier zu leben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250105
					]
				},
				{
					"id": 721250105,
					"content": "Ja, die Leute, die früher in Tatarasuna lebten, wurden wegen des „Mikage-Hochofens“ an andere Orte evakuiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250106
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250106,
					"content": "Vor einiger Zeit habe ich gehört, dass der „Mikage-Hochofen“ wieder in Ordnung ist und dass Tatarasuna sicher ist. Daher fragte ich, ob ich zurückkommen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250107
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250107,
					"content": "Nachdem ich die Erlaubnis bekommen hatte, nahm ich meine Sachen und kam zurück, um wieder hier zu leben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250108
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250108,
					"content": "Aber ... es gibt nicht viele Leute, die zurückkommen und hier leben wollen wie ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250115
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250115,
					"content": "Aber das lässt sich nicht ändern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250116
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250116,
					"content": "Alle hatten Angst, dass so etwas wieder passieren könnte, da nun einmal etwas so Schreckliches zuvor beim „Mikage-Hochofen“ geschehen war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250117
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250117,
					"content": "Bist du nicht besorgt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250118
					]
				},
				{
					"id": 721250118,
					"content": "Natürlich bin ich auch besorgt ... Aber ich habe Heimweh und ich kümmere mich um meine Blumen, hehe. Deshalb habe ich mich entschieden zurückzukommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250119
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250119,
					"content": "Aber die Blumen, die ich hier vorher gepflanzt habe, sind alle verwelkt. Es ist schade, dass ich die Blumensamen jetzt nicht mehr finden kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250120
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250120,
					"content": "Dieser Ort ist sehr geeignet, um Blumen zu pflanzen. Egal welche Samen gesät werden, ein Meer von Blumen wird schnell erblühen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250121
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250121,
					"content": "Ich habe schon früher Blumen aus der Fremde gezüchtet, z. B. Mondstadts Lampenkraut, Windmühlenastern und Löwenzahn sowie Liyues Seidenblumen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250122
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250122,
					"content": "Lampenkraut sieht nachts sehr hübsch aus. Es muss im Schatten gepflanzt, viel gegossen und die Spitzen der abgestorbenen Blätter müssen geschnitten werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250123
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250123,
					"content": "Ich habe gehört, dass Windmühlenastern gut wachsen, wo es Wind gibt. Aber ich denke, dass der Wind in Inazuma nicht so gut ist wie der Wind in Mondstadt ... Also fächele ich oft mit einem Fächer. Aber ich bin nicht sicher, ob das wirklich hilft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250124
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250124,
					"content": "Löwenzahn braucht kaum Sorge. Er kann auf sich selbst aufpassen, aber ... er passt zu gut auf sich auf und wächst immer an allen möglichen seltsamen Stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250125
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250125,
					"content": "Oh, das ... ähm ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250126
					]
				},
				{
					"id": 721250126,
					"content": "Es gibt auch Liyues Seidenblumen. Es ist sehr mühsam, sich um die Blätter zu kümmern. Die „Onikabuto“ verstecken sich immer in den Blütenblättern der Seidenblumen. Ich muss sie also hintereinander herauspicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250127
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250127,
					"content": "Leider ist es mir nicht gelungen, Qingxin zu züchten. Die Qingxin, die ich gepflanzt habe, sind entweder nicht gewachsen oder schnell verwelkt. Leider gibt es in dieser Welt kein magisches Land, in dem Blumen völlig ohne Probleme wachsen können, egal welche Art von Blumen gepflanzt wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250128
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250128,
					"content": "Ich ... Ich weiß ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250129
					]
				},
				{
					"id": 721250129,
					"content": "Oh ja, weißt du, dass es in Liyue eine Blume namens Glasglöckchen gibt? Diese Blume ist wirklich schwer zu finden, ich habe viele Leute gefragt, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250130
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250130,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250131
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250131,
					"content": "Ah! Es tut mir leid! Ich werde so, wenn ich über Blumen spreche. Es tut mir wirklich leid!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250132
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250132,
					"content": "Du magst Blumen wirklich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250133
					]
				},
				{
					"id": 721250133,
					"content": "Ich habe sie nur ein wenig untersucht, hehe ... Aber jetzt habe ich keine Blumensamen mehr. Ich kann so keine Blumen züchten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250109,
					"content": "Ich bin kein Anwohner hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250110
					]
				},
				{
					"id": 721250110,
					"content": "Ach? Tatsächlich? Ich dachte, jemand wie ich möchte zurückkommen und hier leben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250111
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250111,
					"content": "Die Leute, die früher in Tatarasuna lebten, wurden wegen des „Mikage-Hochofens“ an andere Orte evakuiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250112
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250112,
					"content": "Vor einiger Zeit habe ich gehört, dass der „Mikage-Hochofen“ wieder in Ordnung ist und dass Tatarasuna sicher ist. Daher fragte ich, ob ich zurückkommen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250113
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250113,
					"content": "Nachdem ich die Erlaubnis bekommen hatte, nahm ich meine Sachen und kam zurück, um wieder hier zu leben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250114
					],
					"speakerTitle": "Hanayama Kaoru"
