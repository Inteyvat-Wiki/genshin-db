			},
			"dialogs": [
				{
					"id": 721250301,
					"content": "Was machst du denn hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250302
					]
				},
				{
					"id": 721250302,
					"content": "Ich denke darüber nach, wo ich Blumensamen finden kann, damit ich in dieser Gegend wieder Blumen pflanzen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250303
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250303,
					"content": "Die Leute, die früher auf der Insel lebten, wurden wegen des „Mikage-Hochofens“ an andere Orte evakuiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250304
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250304,
					"content": "Ich kam zurück, nachdem ich gehört hatte, dass sich die Sache mit dem „Mikage-Hochofen“ löste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250305
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250305,
					"content": "Aber die Blumen, die ich hier gepflanzt habe, sind alle verwelkt. Ich kann noch keine Blumensamen finden. Schade, diese Gegend ist sehr geeignet, um Blumen zu pflanzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
