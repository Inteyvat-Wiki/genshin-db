			},
			"dialogs": [
				{
					"id": 721250501,
					"content": "Können diese Blumensamen verwendet werden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250502
					]
				},
				{
					"id": 721250502,
					"content": "Das sind ... Ja! Natürlich. Mit diesen Samen kann ich sicher eine große Menge Blumen züchten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250503
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250503,
					"content": "Ah, ähm. Entschuldigung, einen Moment bitte ... Ich muss dir eine Belohnung geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250504
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250504,
					"content": "Diese sind für dich. Danke für deine Blumensamen. Ich bin sicher, dass du ein schönes Blumenmeer sehen wirst, wenn du in der Zukunft wiederkommst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
