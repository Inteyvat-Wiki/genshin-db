				"points": []
			},
			"dialogs": [
				{
					"id": 730410601,
					"content": "Was, wie ist das möglich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410602
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410602,
					"content": "Aranishat wurde auch so schnell entdeckt, genauso schwach wie Aralila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410603
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410603,
					"content": "Äh, alle schwach, nur der goldene Nara ist stark ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410604
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410604,
					"content": "#So geht das nicht, ich muss mein Ararakalari üben. Mit starkem Ararakalari kann {F#die Nara-Freundin}{M#der Nara-Freund} mich sicher nicht finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410605,
						730410607
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410605,
					"content": "Ich glaube nicht, dass das hier so funktioniert ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730410606
					]
				},
				{
					"id": 730410606,
					"content": "#Hat {F#die Nara-Freundin}{M#der Nara-Freund} etwa Angst zu verlieren? Spiel einfach, es ist doch egal, wer gewinnt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410609
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410609,
					"content": "Es hat Spaß gemacht, auch wenn ich verloren habe. Der goldene Nara ist wirklich ein guter Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410610
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410610,
					"content": "#{F#Die Nara-Freundin}{M#Der Nara-Freund} hat gewonnen. Beeindruckend! Nimm unsere Blumen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410611
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410611,
					"content": "#Danke, guter Nara! Du bist {F#eine gute Freundin}{M#ein guter Freund}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410607,
					"content": "Gib Gas!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730410608
					]
				},
				{
					"id": 730410608,
					"content": "Ah, nächstes Mal verliere ich sicher nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410609
					],
					"speakerTitle": "Aranishat"
				}
			]
		}
