			"dialogs": [
				{
					"id": 730410101,
					"content": "Oh, Es ist der goldene Nara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410102
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410102,
					"content": "#{F#Nara-Freundin}{M#Nara-Freund}, komm und spiel mit Aralila! Aranishat ist ganz schwach, spiel nicht mit ihm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410103
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410103,
					"content": "Bumm, letztes Mal hat Aralila gegen Aranishat verloren, da war Aralila noch schwächer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410104
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410104,
					"content": "#Gut, Sonne und Mond sind egal. Jetzt wo {F#die Nara-Freundin}{M#der Nara-Freund} hier ist, können wir zusammen spielen und uns messen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410105
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410105,
					"content": "Aranishat hat keine Angst vor einem Wettkampf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410106
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410106,
					"content": "#Zuerst versteckt sich Aralila und {F#die Nara-Freundin}{M#der Nara-Freund} muss suchen. Dann versteckt sich Aranishat und {F#die Nara-Freundin}{M#der Nara-Freund} muss ihn suchen. Wer zuerst gefunden wird, verliert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410107
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410107,
					"content": "#Möchte {F#die Nara-Freundin}{M#der Nara-Freund} spielen? Wenn du bereit bist, geht’s los!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aralila"
				}
			]
		},
