				"points": []
			},
			"dialogs": [
				{
					"id": 730410501,
					"content": "Haha! Aralila ist schwächer, wie erwartet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410502
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410502,
					"content": "Der goldene Nara ist echt stark, ich wurde wirklich schnell entdeckt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410503
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410503,
					"content": "Der goldene Nara ist echt gut, aber Aralila ist zu schwach. Aranishat kann man nicht so schnell finden, schau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranishat"
				}
			]
		},
