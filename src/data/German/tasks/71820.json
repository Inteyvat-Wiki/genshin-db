			"dialogs": [
				{
					"id": 718202101,
					"content": "He, hast du Bohuanzi schon gefunden? Ist er mit meinem Plan einverstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202102
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718202102,
					"content": "Er hat versprochen, mit dir mitzugehen, aber er braucht noch einen Moment, um hierher zu gelangen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718202103
					]
				},
				{
					"id": 718202103,
					"content": "Toll, ich bin soeben Qingzhou begegnet, und er hat ziemlich beunruhigt auf mich gewirkt. Er ist nun spazieren gegangen und meinte vorher noch, er müsste nach ein bisschen Inspiration suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202104
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718202104,
					"content": "Ich bin mehr als nur dankbar. Also warte ich hier auf Bohuanzi und erzähle ihm dann alle Details.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202105
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718202105,
					"content": "Und dann muss ich mich wieder all den unerledigten Angelegenheiten im Hafen von Liyue zuwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202106
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718202106,
					"content": "Sieht so aus, als müsste ich zwischen dem Gasthaus Wangshu und dem Hafen von Liyue noch eine ganze Weile lang hin- und herreisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202107
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718202107,
					"content": "Wenn ich alle meine ausstehenden Aufgaben erledigt habe, werden wir sofort zum Qingce-Dorf aufbrechen. Du kannst uns dort treffen, wenn du dich uns anschließen möchtest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202108
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718202108,
					"content": "Oh weh, wenn ich meine Arbeit doch nur irgendwie schneller bewältigen könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wangya"
				}
			]
		},
