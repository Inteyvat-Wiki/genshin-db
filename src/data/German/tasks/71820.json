			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bohuanzi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201901,
					"content": "Danke! Vielen Dank! *seufz* Ich bin ja so leichtfertig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201902
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201902,
					"content": "Was hast du denn hier gemacht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201903
					]
				},
				{
					"id": 718201903,
					"content": "Ich bin hergekommen, um nach Materialien zu suchen. Es wäre doch nett, dachte ich, ein paar dekorative Schriftstücke zu verfassen und sie meinen Freunden als Laternenritual-Geschenke zu geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201904
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201904,
					"content": "Aber dafür brauche ich ein paar Fläschchen Spezialtinte. Es hätte einfach nur ein kurzer, angenehmer Spaziergang werde sollen, auf dem ich mir die erforderlichen Zutaten suche ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201905
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201905,
					"content": "Nie hätte ich gedacht, auf all diese Monster zu stoßen, niemals ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201906
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201906,
					"content": "Was Wangyas Wunsch angeht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201907
					]
				},
				{
					"id": 718201907,
					"content": "Ins Qingce-Dorf gehen und den Einwohnern meine Schreibkünste zur Verfügung stellen ... Überhaupt kein Problem. Du kannst auf mich zählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201908
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201908,
					"content": "Das Dorf von Qingce ... Oh, das ist doch dieses Dorf, wo so viele ältere Menschen leben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201909
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201909,
					"content": "Ich hätte folgenden Vorschlag. Warum hilfst du mir nicht dabei, nach Cor Lapis und Qingxin zu suchen? Das brauche ich, um etwas Tinte herzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201910
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201910,
					"content": "Du machst Tinte ... aus diesen Dingen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201911
					]
				},
				{
					"id": 718201911,
					"content": "Hahaha, ich orte da eine kleine Wissenslücke bei dir. Wenn man Cor Lapis in Tinte auflöst, erstrahlen die Schriftzeichen in einem herrlichen, goldenen Glanz. Also wahrhaftig glücksverheißend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201912
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201912,
					"content": "Qingxin-Saft hingegen bereichert den natürlichen Geruch der Tinte mit einem zarten und blumigen Duft. Und wenn die eigentliche Tinte von anständiger Qualität ist, werden sich diese beiden Aromen wunderbar ergänzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201913,
						718201914
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201913,
					"content": "Welch Liebe zum Detail ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				},
				{
					"id": 718201915,
					"content": "Ach, im Vergleich dazu, was andere Liebhaber so alles anstellen, um ihre Tinten zu fertigen, ist das wirklich nicht der Rede wert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201916
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201916,
					"content": "Machen wir es dieses Mal also nicht allzu kompliziert. Sammle einfach die Materialien ein und bring sie mir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201917
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201917,
					"content": "Oh weh ... ich muss ein wenig zu Atem kommen. Dieser Monsterangriff war das reinste Trauma ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201914,
					"content": "Das klingt äußerst mühsam ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				}
			]
		},
