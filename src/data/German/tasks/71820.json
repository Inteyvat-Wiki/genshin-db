			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200201,
					"content": "Jedes Laternenritual die gleiche Geschichte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200202
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200202,
					"content": "Stimmt etwas nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200203
					]
				},
				{
					"id": 718200203,
					"content": "Wir sind hier ein wenig in der Zwickmühle. Viele unserer Mitarbeiter sind fortgegangen, um das Laternenritual mit ihren Familien zu feiern. Und dies gestaltet das Betreiben des Gasthauses äußerst schwierig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200204
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200204,
					"content": "Gäste betreuen, das Gasthaus dekorieren und Vorbereitungen für die Feierlichkeiten treffen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200205
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200205,
					"content": "Zusätzlich zu unseren regelmäßigen Verantwortungen, die wir nicht einfach so ablegen können ... Mit dieser Arbeitslast wird der Lächelnde Yanxiao nie im Leben fertig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200206
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200206,
					"content": "#Würde es dir was ausmachen, {F#Reisende}{M#Reisender}, ihn ein bisschen zu unterstützen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200207
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200207,
					"content": "Ich werde es natürlich tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200208
					]
				},
				{
					"id": 718200208,
					"content": "Das weiß Yanxiao ganz sicher zu schätzen. Du findest ihn in der Küche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200209
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200209,
					"content": "Ich bin immer noch nicht fertig mit meinem Teil hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
		{
			"id": 7182003,
			"completionStepIds": [
				7182003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182003",
							"2"
						],
						"stepId": 7182003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lächelnder Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200301,
					"content": "Wer ist da!? Nur das Küchenpersonal ...  Oh, du bist es ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200302
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 718200302,
					"content": "Brauchst du irgendetwas? Wenn du etwas bestellen willst, dann könnte das eine ganze Weile dauern ... Ich habe alle Hände voll zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200303,
						718200304
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 718200303,
					"content": "Dann helfe ich dir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				},
				{
					"id": 718200305,
					"content": "Du bist gekommen, um zu helfen? Oh ... da kann ich schwer Nein sagen. Ich stecke hier bis über beide Ohren in Arbeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200306
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 718200306,
					"content": "Kannst du bitte nach unten gehen und die Kochzutaten holen, die eben für mich geliefert wurden? Ich brauche sie wirklich dringend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200307
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 718200307,
					"content": "Wenn du schon dabei bist, kannst du auch diese Laternen hier mitnehmen und sie am Eingang des Gasthauses aufhängen ... Der Gastwirt nervt mich schon die längste Zeit deswegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 718200304,
					"content": "Kann ich dir bei irgendetwas helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				}
			]
		},
		{
			"id": 7182015,
			"completionStepIds": [
				7182015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182015",
							"2"
						],
						"stepId": 7182015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lächelnder Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201501,
					"content": "Wie ist es gelaufen? Hast du dich um alles gekümmert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201502
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 718201502,
					"content": "Ja, alles erledigt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201503
					]
				},
				{
					"id": 718201503,
					"content": "Danke, dafür schulde ich dir was. Höchste Zeit, dass ich mit diesen Gerichten fertig werde. Ich möchte nicht, dass sich unsere hungrigen Gäste beschweren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lächelnder Yanxiao"
				}
			]
		},
		{
			"id": 7182016,
			"completionStepIds": [
				7182016
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182016",
							"2"
						],
						"stepId": 7182016,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201601,
					"content": "Oh, da bist du ja wieder. Und Yanxiao ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201602
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201602,
					"content": "Er sollte jetzt wieder klarkommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201603
					]
				},
				{
					"id": 718201603,
					"content": "Das ist schön. Vielen Dank für deine Hilfe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201604
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201604,
					"content": "Hier ist auch nichts ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201605,
						718201606
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201605,
					"content": "Hm? Wangya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				},
				{
					"id": 718201607,
					"content": "#{F#Reisende}{M#Reisender}? So ein Zufall aber auch! Ich hätte nicht erwartet, dich hier zu sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201608
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201608,
					"content": "Man könnte behaupten, dass ich Laternen ausliefere ... Hast du schon vom Qingce-Dorf gehört? Es liegt ziemlich weit von der Stadt entfernt. Die meisten Einwohner sind entweder Kinder oder ältere Menschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201609
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201609,
					"content": "Also beauftragt der Rat für Allgemeine Angelegenheiten jedes Jahr einen Repräsentanten damit, ihnen ein paar lebensnotwendige Güter zu bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201610
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201610,
					"content": "Die erste Ladung wurde schon ausgeliefert, aber ich möchte noch einen Schritt weitergehen und sicherstellen, dass auch die festliche Stimmung ihren Weg in dieses Dorf findet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201611
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201611,
					"content": "Deswegen habe ich den Dichter Qingzhou gebeten, ein paar Laternen-Rätsel vorzubereiten und sich ins Qingce-Dorf zu begeben, um dort die Dorfkinder ein bisschen zu unterhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201612,
						718201613
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201612,
					"content": "Qingzhou ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201614,
					"content": "Ein derart renommierter Dichter wie er ist dieser Aufgabe ganz sicher gewachsen. Und ich wollte auch Bohuanzi einbinden, ein ziemlich guter Kalligraph. Es wäre wundervoll, wenn er den älteren Menschen helfen könnte, ihre Wünsche auf die Laternen zu schreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201615
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201615,
					"content": "Trotz meiner größten Anstrengungen, ihn zu finden, ist Bohuanzi aber leider unauffindbar. Jemand sagte mir, er wäre zum Dihua-Moor gegangen, um Material zu sammeln, also bin ich hergekommen, um nach ihm zu suchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201616,
						718201617
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201616,
					"content": "Es kann nicht schaden, den Boss zu fragen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201618,
					"content": "Bohuanzi? Lass mich nachdenken ... Er kam vor nicht all zu langer Zeit ins Gasthaus und erwähnte, dass er hier in der Nähe irgendwelche Dinge sammeln möchte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201619
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201619,
					"content": "Aber es würde mich nicht überraschen, wenn er schon längst weitergezogen ist. Hier in der Wildnis lauern nämlich viele Monster ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201620
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201620,
					"content": "Ich verstehe ... Aber ich habe Qingzhou bereits gebeten, mich im Gasthaus Wangshu zu treffen. Er müsste also bald hier sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201621
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201621,
					"content": "#Kannst du bitte für mich nach Bohuanzi suchen, {F#Reisende}{M#Reisender}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201622
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201622,
					"content": "Überlass das ruhig mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201623
					]
				},
				{
					"id": 718201623,
					"content": "Meine Dankbarkeit kennt keine Grenzen. Ich werde hier auf Qingzhou warten. Es gibt da noch ein paar Dinge, die wir besprechen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201624
					],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201624,
					"content": "Oje ... Mein Terminkalender platzt schon aus allen Nähten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wangya"
				},
				{
					"id": 718201617,
					"content": "Weißt du, was mit Bohuanzi geschehen ist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201613,
					"content": "(Wie? Hatte der nicht diesen Streit mit Vermeer?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201606,
					"content": "Bist du hergekommen, um Laternen zu bringen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				}
			]
		},
		{
			"id": 7182019,
			"completionStepIds": [
				7182019
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182019",
							"2"
						],
						"stepId": 7182019,
						"stateName": "QUEST_STATE_UNFINISHED"
