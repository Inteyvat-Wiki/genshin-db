			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Koch Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413321401,
					"content": "Habt ihr das Essen geliefert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321402
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 413321402,
					"content": "Ja, das haben wir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321403
					]
				},
				{
					"id": 413321403,
					"content": "Großartig, ich wusste, dass ich auf euch zählen kann! Hast du vielleicht auch Wang Banzi den Schraubenschlüssel, Hammer Li, Guanhai und Zhihua gefragt, was sie essen möchten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321404
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 413321404,
					"content": "Wang Banzi der Schraubenschlüssel und Hammer Li möchten Bambussuppe mit Fleischeinlage haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321405
					]
				},
				{
					"id": 413321405,
					"content": "Oh? Diese zwei haben einen sehr ähnlichen Geschmack, aber die Zubereitung von Bambussuppe mit Fleischeinlage dauert etwas. Ich muss sie früh vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321407
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 413321407,
					"content": "Guanhai hätte gern Eichhörnchenfisch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321408
					]
				},
				{
					"id": 413321408,
					"content": "Kein Problem, das Gericht ist eine meiner Spezialitäten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321409
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 413321409,
					"content": "Zhihua hätte gerne Knusperlotos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321410
					]
				},
				{
					"id": 413321410,
					"content": "Hmm. Ich hätte nie gedacht, dass Zhihua eine Vorliebe für Gebäck und ähnliches hat. Knusperlotos zuzubereiten ist unkompliziert, kein Problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321411
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 413321411,
					"content": "Danke, dass du losgegangen bist, um sie zu fragen, was sie essen wollen. Hier, nimm das als Zeichen meiner Anerkennung. Jetzt sollte ich mit all den Gerichten anfangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321412
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 413321412,
					"content": "Hängst du keine Laternen auf?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321413
					]
				},
				{
					"id": 413321413,
					"content": "Ha! Dafür haben wir jetzt keine Zeit. Ich muss mehr Gerichte zubereiten und Xiangling ist gerade zu einer neuen Lieferung aufgebrochen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321414
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 413321414,
