					"nextDialogs": [
						413320518
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413320518,
					"content": "Ich bin nicht wählerisch, <color=#00E1FFFF>alles mit Fleisch ist gut genug für mich</color>. Ich brauche kein feines Essen, also was schlägst du vor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Banzi der Schraubenschlüssel"
