			"trigger": {
				"objectNames": [
					"Koch Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413320201,
					"content": "Wie viele Gerichte waren das noch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320202
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 413320202,
					"content": "Was machst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320203
					]
				},
				{
					"id": 413320203,
					"content": "Was ich hier mache? Na ja, ich betreibe natürlich das Restaurant Wanmin! Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320204
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 413320204,
					"content": "Es ist ziemlich hektisch geworden, da jeder während des Laternenrituals draußen etwas isst. Sogar Reisende von weit weg sind gekommen, um den Festivitäten beizuwohnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320205
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 413320205,
					"content": "Obwohl meine liebe Xiangling zurückgekehrt ist, um zu helfen, haben wir immer noch Probleme damit, unsere Köpfe über Wasser zu halten. Sie ist tatsächlich gerade zu einer Lieferung aufgebrochen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320206
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 413320206,
					"content": "Während jeder Laternen für das Fest aufgehängt hat, waren wir zu beschäftigt, um eine einzelne Laterne zu basteln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320207
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 413320207,
					"content": "#{F#Reisende}{M#Reisender}, würde es dir etwas ausmachen, uns zu helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320208
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 413320208,
					"content": "Kennst du vielleicht Atsuko? Sie ist das Mädchen aus Inazuma unten bei der Anlegestelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320209
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 413320209,
					"content": "Wir haben ihre Bestellung vorbereitet. Könntest du ihr das Essen hier liefern? Ich habe sogar besonders große Portionen gemacht, um das Fest zu feiern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320210
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 413320210,
					"content": "Es gibt auch noch andere, die an der Anlegestelle arbeiten ... <color=#00E1FFFF>Wang Banzi der Schraubenschlüssel, Hammer Li, Guanhai und Zhihua</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320211
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 413320211,
					"content": "Sie alle sind Stammgäste hier und suchen immer nach neuen Geschäften. Sie scheinen noch mit Arbeit am Hafen beschäftigt zu sein, auch wenn es bereits Zeit für das Fest ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320212
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 413320212,
					"content": "Ich würde gerne etwas Essen zubereiten und es ihnen geben, aber ich fürchte, ich bin einfach zu beschäftigt und habe keine Möglichkeit, das Restaurant zu verlassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320213
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 413320213,
					"content": "#Wenn du könntest, {F#Reisende}{M#Reisender}, hilf mir bitte dabei, sie zu fragen, was sie essen wollen. Und ich werde in Windeseile zubereiten, was sie sich wünschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320214
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 413320214,
					"content": "Überlass es ganz mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320215
					]
				},
				{
					"id": 413320215,
					"content": "#Vielen Dank, {F#Reisende}{M#Reisender}. Komm einfach hierher zurück und lass es mich wissen, wenn du sie gefragt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Koch Mao"
				}
			]
		},
