			"dialogs": [
				{
					"id": 413320321,
					"content": "Ich frage mich, warum meine Bestellung beim Restaurant Wanmin immer noch nicht angekommen ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320322
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320322,
					"content": "Hier ist deine Bestellung. Guten Appetit!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320323
					]
				},
				{
					"id": 413320323,
					"content": "Du bist endlich hier. Ich warte schon seit einer ganzen Weile ... Aber ich bin trotzdem dankbar, dass du noch die Lieferungen während der Zeit des Fests übernimmst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320324
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320324,
					"content": "All die Festlichkeiten für das Laternenritual haben mir etwas Heimweh gemacht ... Aber ich werde sicherlich nicht in nächster Zeit nach Inazuma zurückkehren können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320325
					],
					"speakerTitle": "Atsuko"
				},
				{
