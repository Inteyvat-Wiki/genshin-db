					"nextDialogs": [
						413320517
					]
				},
				{
					"id": 413320517,
					"content": "Ich werde nicht nach zu viel fragen, ich bin mit einer üppigen Schüssel <color=#00E1FFFF>heißer Suppe</color> und einigen <color=#00E1FFFF>knusprigen Bambussprossen</color> schon mehr als zufrieden.",
