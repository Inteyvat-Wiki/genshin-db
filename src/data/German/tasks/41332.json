			},
			"dialogs": [
				{
					"id": 413320301,
					"content": "Ich frage mich, warum meine Bestellung beim Restaurant Wanmin noch nicht angekommen ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320302
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320302,
					"content": "Hier ist deine Bestellung. Guten Appetit!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320303
					]
				},
				{
					"id": 413320303,
					"content": "Oh, vielen Dank euch! Ich dachte, dass es noch eine Weile dauern wird, bis es ankommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320304
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320304,
					"content": "All die Festlichkeiten für das Laternenritual haben mir etwas Heimweh gemacht ... Aber ich werde sicherlich nicht in nächster Zeit nach Inazuma zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320305
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320305,
					"content": "Ich frage mich, wie es zu Hause in Inazuma läuft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atsuko"
				}
			]
		},
