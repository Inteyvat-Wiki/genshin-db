			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong",
					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210101,
					"content": "Mach dich jetzt bereit, dieses Gericht wird fantastisch sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210102
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210102,
					"content": "Mein Gericht soll ähnlich fantastisch sein, also bereite dich vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210103
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210103,
					"content": "Was macht ihr da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210104
					]
				},
				{
					"id": 220210104,
					"content": "#Hallo, {F#Reisende}{M#Reisender}. Parvaneh und Julie sind unterwegs, um Zutaten zu sammeln, und wir sollten ein Essen für sie vorbereiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210105
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210105,
					"content": "Aber Onkel Munehisa und ich hatten eine kleine Meinungsverschiedenheit darüber, was wir vorbereiten sollten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210106
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210106,
					"content": "Also haben wir beschlossen, dass jeder ein Gericht für einen Wettbewerb macht. Der Gewinner darf das Thema für die heutigen Mahlzeiten bestimmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210107,
					"content": "Ich koche eine von Liyues Spezialitäten, die besondere Juwelensuppe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210108
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210108,
					"content": "Und ich werde mein bestes Gericht machen, den Spieß mit drei Aromen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210109,
						220210111
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210109,
					"content": "Kann ich helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210110
					]
				},
				{
					"id": 220210110,
					"content": "Nun, wenn du Zeit hast, wir brauchen einen Richter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210113,
					"content": "Da wir aber beide vier Portionen von jedem Gericht zubereiten müssen, obwohl wir nur zwei Hände haben, sind wir ein wenig überfordert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210114,
					"content": "Du kannst uns dabei helfen, das Essen vorzubereiten, bevor die Bewertung beginnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210115,
					"content": "Und natürlich kannst du dir aussuchen, bei welchem Gericht du helfen willst, denn du bist ja nur eine Person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210116,
						220210119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210116,
					"content": "Xudong, wirst du es alleine schaffen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210117
					]
				},
				{
					"id": 220210117,
					"content": "Mach dir keine Sorgen um mich. Ich habe früher ein Restaurant in Liyue geführt, es ist also nicht schwer für mich, ein Essen zuzubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210118
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210118,
					"content": "Das heißt, mit ein wenig Hilfe könnte ich das Essen noch besser machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210122,
					"content": "Wie auch immer, such dir einfach ein Gericht aus, das dich interessiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210123,
						220210126
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210123,
					"content": "Xudong, ich werde dir helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210124
					]
				},
				{
					"id": 220210124,
					"content": "Oh! Das ist toll, Onkel Munehisa, mach dich darauf gefasst, von meinem Gericht besiegt zu werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210125
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210125,
					"content": "Ich bin kein Mann, der leicht aufgibt. Mach weiter und gib dein Bestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210126,
					"content": "Onkel Munehisa, ich werde dir helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210127
					]
				},
				{
					"id": 220210127,
					"content": "Danke, Xudong, sei vorbereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210128
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210128,
					"content": "Kein Problem! Mach weiter und gib dein Bestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210119,
					"content": "Onkel Munehisa, wirst du das alleine schaffen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210120
					]
				},
				{
					"id": 220210120,
					"content": "Mach dir keine Sorgen. Wähle einfach, was du bevorzugst. Als ich im Bakufu war, habe ich immer ganz alleine Mahlzeiten für eine Menge Leute zubereitet. Das sind nur vier Portionen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210121
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210121,
					"content": "Aber wenn du mir helfen willst, bin ich mir sicher, dass ich das Gericht noch besser machen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210111,
					"content": "Ich nehme an, dann fehlt euch ein Richter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210112
					]
				},
				{
					"id": 220210112,
					"content": "Hahaha, das ist richtig. Wir brauchen einen Richter, der gerecht ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2202102,
			"completionStepIds": [
				2202109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202109",
							"2"
						],
						"stepId": 2202109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong",
					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210201,
					"content": "#Erledigt. Danke, {F#Reisende}{M#Reisender}. Es riecht so gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210202,
					"content": "Ich probiere es zuerst aus ... Oho, das ist toll. Die Zutaten sind genau richtig gekocht und es riecht perfekt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210203,
					"content": "Man könnte es auch eine „perfekte Juwelensuppe“ nennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210204,
					"content": "#Gut, Onkel Munehisa, wie läuft’s mit dem Kochen? Bereit, es {F#der}{M#dem} Reisenden zu zeigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210205
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210205,
					"content": "Na ja ... Ich habe einen Fehler gemacht. Ich habe gemerkt, dass ich nicht genug Vogeleier habe, gleich nachdem ich angefangen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210206
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210206,
					"content": "Obwohl ich sofort losgezogen bin, um ein paar Vogeleier aus dem Wald zu holen, waren die anderen Zutaten zu diesem Zeitpunkt schon überfällig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210207
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210207,
					"content": "Die Spieße mit drei Aromen, die mit nicht frischen Zutaten zubereitet wurden, können nicht mehr als gutes Essen angesehen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210208
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210208,
					"content": "Ich schäme mich, so nachlässig gewesen zu sein. Ich muss meine Fähigkeiten mehr verfeinern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210209
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210209,
					"content": "Dieses Mal hast du gewonnen. Aber das nächste Mal, Xudong, werde ich dich definitiv schlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210210,
						220210214
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210210,
					"content": "Das ist die richtige Einstellung, Onkel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210211
					]
				},
				{
					"id": 220210211,
					"content": "Haha, ich verspreche, dass ich kein leichter Gegner sein werde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210212
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210212,
					"content": "#Übrigens, {F#Reisende}{M#Reisender}, die sind für dich. Danke, dass du uns schon so lange hilfst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210213
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210213,
					"content": "Du solltest das nächste Mal, wenn wir antreten, auch kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210214,
					"content": "Eigentlich finde ich, dass es ganz gut schmeckt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210215
					]
				},
				{
					"id": 220210215,
					"content": "Ich gebe mich nicht mit „ganz gut“ zufrieden. Auch beim Kochen muss man das Herz haben, nach Perfektion zu streben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210216
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210216,
					"content": "Dies ist der einzige Weg, um ein Meister der Kochkunst zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210217
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210217,
					"content": "Genau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210218
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210218,
					"content": "Genau!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210219
					]
				},
				{
					"id": 220210219,
					"content": "Die Kunst des Schwertes und die Kunst des Kochens sind in dieser Hinsicht dasselbe und für mich sind beide Teil der Kunst des menschlichen Seins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210220
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210220,
					"content": "Toll! Äh, gut gemacht, Onkel Munehisa ... Ich glaube an dich. Ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210221
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210221,
					"content": "Äh ... Ich habe keine Ahnung, wie ich mit jemandem umgehen soll, der so ... ernst ist. Ich schätze, das kann nur Julie, aber sie ist gerade nicht hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210222
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210222,
					"content": "Ehrlich gesagt, bin ich auch ziemlich schockiert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210223
					]
				},
				{
					"id": 220210223,
					"content": "#*hust* Nun, danke für deine harte Arbeit, {F#Reisende}{M#Reisender}. Bitte nimm das, ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210224
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210224,
					"content": "Xudong, ich würde dir gerne noch ein paar Fragen zum Thema Kochen stellen. Hast du einen Moment Zeit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210225
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210225,
					"content": "Hm? Oh, richtig, ja! Ich werde da sein! Ich werde gleich da sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2202103,
			"completionStepIds": [
				2202110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202110",
							"2"
						],
						"stepId": 2202110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamei Munehisa",
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210301,
					"content": "Hmm. Der Geruch und wie es aussieht ... diese Spieße mit drei Aromen sollten stattdessen Extreme Spieße heißen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210302
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210302,
					"content": "Extreme Spieße?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210303
					]
				},
				{
					"id": 220210303,
					"content": "Hehe, ich meine einfach, dass es ein extrem perfektes Gericht ist ... Nun, würdest du auf die Zeit schauen. Xudongs Juwelensuppe sollte jetzt fertig sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210304
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210304,
					"content": "Aber natürlich! Hier ist meine Juwelensuppe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210305,
					"content": "Es könnte etwas verkocht sein, weil ich nicht richtig mit der Zeit hingekommen bin, aber der Geschmack sollte in Ordnung sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210306
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210306,
					"content": "Lass mich probieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210307
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210307,
					"content": "Nun, sie hat einen leicht verbrannten Geschmack. Es ist nicht schlimm genug, um den ganzen Topf zu ruinieren, aber sie hat am Ende doch Makel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210308
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210308,
					"content": "Hahaha, dieses Mal war ich in Eile. Nächstes Mal werde ich alle Zutaten im Voraus vorbereiten, damit das nicht passiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210309,
					"content": "Du hast dieses Mal gewonnen, aber sei versichert, dass ich nächstes Mal nicht denselben Fehler machen werde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210310,
						220210314
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210310,
					"content": "Scheint, als wärst du unvorsichtig geworden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210311
					]
				},
				{
					"id": 220210311,
					"content": "Hahaha ... Ja, ich war unvorsichtig. Das nächste Mal muss ich aufmerksamer sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210312
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210312,
					"content": "#Übrigens, {F#Reisende}{M#Reisender}, die sind für dich. Danke, dass du uns schon so lange hilfst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210313,
					"content": "Du solltest das nächste Mal, wenn wir antreten, auch kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210314,
					"content": "Onkel Munehisas extreme Spieße haben den Tag versüßt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210315
					]
				},
				{
					"id": 220210315,
					"content": "Extreme Spieße? Was bedeutet das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210316
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210316,
					"content": "Das bedeutet, dass diese Spieße mit drei Aromen von perfekter Qualität sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210317
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210317,
					"content": "Ein „extremes“ Streben zu haben bedeutet, dass dein Herz niemals mit bloßer „Akzeptanz“ zufrieden sein kann. Stattdessen ist die höchste Vollkommenheit das Ziel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210318
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210318,
					"content": "Auch beim Kochen muss man das Herz haben, nach Perfektion zu streben. Nur so kann man ein Meister der Kochkunst werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210319
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210319,
					"content": "Genau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210320
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210320,
					"content": "Genau!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210321
					]
				},
				{
					"id": 220210321,
					"content": "Die Kunst des Schwertes und die Kunst des Kochens sind in dieser Hinsicht dasselbe und für mich sind beide Teil der Kunst des menschlichen Seins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210322
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210322,
					"content": "Komm, Xudong. Erlaube mir, dir von dem „extremen“ Weg zu erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210323
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210323,
					"content": "#Hm? In ... äh ... In Ordnung. Gib mir nur eine Sekunde, ich bin gleich wieder da. {F#Reisende}{M#Reisender}, hier ist deine Bezahlung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210324
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210324,
					"content": "Äh ... Ich habe keine Ahnung, wie ich mit jemandem umgehen soll, der so ... ernst ist. Ich schätze, das kann nur Julie, aber sie ist gerade nicht hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210325
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210325,
					"content": "Hol dir einfach die extreme Kochkunst-Erfahrung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210326
					]
				},
				{
					"id": 220210326,
					"content": "Xudong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210327
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210327,
					"content": "Hm? Ich komme ja schon. Nur eine Sekunde! Ich bin gleich da ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
