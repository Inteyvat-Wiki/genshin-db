			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210701,
					"content": "Vielen Dank für deine Bereitschaft zu helfen. Die Spieße mit drei Geschmäckern sind einfach zuzubereiten, aber sie erfordern besondere Aufmerksamkeit für die Frische der Zutaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210702
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210702,
					"content": "Ich habe genug von jeder Zutat außer Vogeleiern ... Könntest du bitte zwei frische Eier für mich holen, nur für den Fall?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210703,
						220210705
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210703,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210704
					]
				},
				{
					"id": 220210704,
					"content": "Ich danke dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210705,
					"content": "Wie hast du gelernt, das zu machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210706
					]
				},
				{
					"id": 220210706,
					"content": "Als ich noch im Bakufu gedient habe, habe ich immer diese Art von kleinen Gerichten zum Wein gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210707
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210707,
					"content": "Aber jetzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210708
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210708,
					"content": "Wie auch immer, lass uns nicht über die Vergangenheit reden. Ich zähle auf dich wegen den Vogeleiern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210709
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210709,
					"content": "Ich werde mich hier mit den Zutaten beschäftigen. Bitte bringe die Vogeleier zu mir, sobald du sie hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		}
	]
