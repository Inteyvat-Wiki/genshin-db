					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210601,
					"content": "Dann lass uns loslegen. Für die Juwelensuppe brauchst du Goldfischkraut, Tofu und Lotosfrucht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210602
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210602,
					"content": "Lotosfrüchte und Tofu ... Zum Glück ist noch etwas übrig. Aber es gibt nicht genug Goldfischkraut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210603
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210603,
					"content": "#{F#Reisende}{M#Reisender}, ich kümmere mich um die Zutaten. Kannst du mir bitte vorsichtshalber noch drei Portionen frisches Goldfischkraut besorgen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2202107,
			"completionStepIds": [
				2202112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
