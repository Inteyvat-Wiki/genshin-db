					}
				]
			},
			"dialogs": [
				{
					"id": 750620401,
					"content": "Du bist immer noch hier, tapferer Recke ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620402
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620402,
					"content": "Einst, so behaupten die Gelehrten, habe der tyrannische Herrscher dieser aschenen Stadt ein Mittel gegen die Korrosion des Abgrunds gekannt. Also machten wir uns ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620403
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620403,
					"content": "Aber dieser Ort ist wirklich von einer seltsamen Aura umgeben, Recke. In letzter Zeit wirkt mir dieser Ort auch etwas ... sonderbar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620404
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620404,
					"content": "Manchmal wache ich auf und sehe, dass eine Straße, die am Vortag noch intakt war, plötzlich ganz verfallen ist ... Und waren diese steinernen Häuser immer so? Es scheint, als hätten sie einst mehr Vollkommenheit besessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620405
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620405,
					"content": "Doch hin und wieder gewahre ich nach dem Erwachen Freunde, die längst nicht mehr hier sein dürften ... Sind es Monster? Gewiss, es müssen Monster sein, die die Gestalt meiner Freunde angenommen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620406
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620406,
					"content": "Meine ... Meine Aufgabe hier ist es, jene Monster zu beseitigen, doch ... warum? Warum ist das meine Bestimmung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620407
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620407,
					"content": "Wie auch immer, dies ist ein höchst merkwürdiger Ort. Ihr würdet gut daran tun ... zügig zu verschwinden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
