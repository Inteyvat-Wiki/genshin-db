				]
			},
			"dialogs": [
				{
					"id": 750620301,
					"content": "Was macht ihr denn immer noch hier ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620302
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620302,
					"content": "Der Anführer unserer Abenteurertruppe, der Held mit der Falkenmaske, ist gefallen ... Wir haben ihnen nichts mehr entgegenzusetzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620303
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620303,
					"content": "Los, fort mit dir, geh! Dieser Ort ist verflucht, tapferer Recke. Hier sollte niemand bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
		{
