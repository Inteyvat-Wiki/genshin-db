						],
						"pointId": 10046
					}
				]
			},
			"dialogs": [
				{
					"id": 750620501,
					"content": "Ihr solltet euch auf und davon machen, bevor es zu spät ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620502
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620502,
					"content": "Warum wird es zu spät sein? Weil ... weil die gesamte Abenteurertruppe ausgelöscht wurde. Sie wurden alle von ... diesem pechschwarzen Ungeheuer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620503
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620503,
					"content": "Sie baten mich, die evakuierten Personen zu beschützen und sicherzustellen, dass sie aus der Stadt herauskommen. Eine Rettungseinheit des Blumenfeder-Klans ist bereits auf dem Weg ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620504
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620504,
					"content": "Ich muss diese bösartigen Monster vernichten, damit die Überlebenden zurückkehren und wieder das Licht der Welt erblicken können ... Aber ... warum bin ich jetzt hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620505
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620505,
					"content": "Das Geräusch in meinen Ohren ... aah, es wird immer lauter. Ich ... Ich muss zum Wasserfall zurückkehren. Ja, ich muss ... zurück zum Wasserfall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620506
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620506,
					"content": "Tapferer Recke, auch ihr solltet diesen Ort ... so schnell wie möglich verlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		}
	]
