				]
			},
			"dialogs": [
				{
					"id": 750620201,
					"content": "Ach, auf diesem Ort liegt wirklich ein Fluch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620202
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620202,
					"content": "Ihr solltet euch nicht zu lange aufhalten, verschwindet besser schnell ... Ja, ihr müsst unbedingt fort sein, bevor die pechschwarze Flut anrollt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620203
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620203,
					"content": "Ja, die pechschwarze Flut. Der riesige Schatten kommt immer näher. Wir müssen ... dafür sorgen, dass alle in Sicherheit gebracht werden ... dass alle ... unversehrt evakuiert werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
