				]
			},
			"dialogs": [
				{
					"id": 750620101,
					"content": "Diese unmenschlichen Kreaturen erweisen sich als zähe Gegner ... unmenschliche Monster, sollte ich sagen. Sei gegrüßt, tapferer Recke ... Ich bin Quenin von der Abenteurertruppe. Meine Aufgabe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620102
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620102,
					"content": "Meine Aufgabe ... ist es, diese Ungeheuer auszuschalten. Ja, ich bin ein Krieger der Abenteuertruppe. Sei wachsam, tapferer Recke ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620103
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620103,
					"content": "Diese Monster sind extrem hinterhältig. Sie können zur Tarnung unterschiedliche Gestalten annehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620104
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620104,
					"content": "Jede Nacht, kurz vor dem Einschlafen, höre ich ... ihre Geräusche aus den uralten Ruinen. Deswegen ... kann ich im Lager unmöglich schlafen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620105
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620105,
					"content": "Hier wimmelt es von solchen Monstern. Auch ihr solltet ... auf der Hut sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
