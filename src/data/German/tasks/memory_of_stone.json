			"dialogs": [
				{
					"id": 730152101,
					"content": "Die Aranara sind so klein, kein Wunder dass sie so Angst haben, wenn sie auf eine Pilzbestie treffen, die mehrmals so groß wie sie selbst ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730152102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730152102,
					"content": "Paimon hat keine Angst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730152103
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730152103,
					"content": "Paimon? Natürlich nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730152104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730152104,
					"content": "Ooh ... Aranakula ist stärker als Paimon, aber lange nicht so mutig. Sollten die Pilzbestien ein weiteres Mal angreifen, dann wird Aranakula sich ganz bestimmt an einem <color=#00E1FFFF>sicheren Ort</color> verstecken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		}
