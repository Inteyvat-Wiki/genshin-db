			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aranakula",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730151101,
					"content": "#Ah! Danke Nara {NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151102
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151102,
					"content": "Vana erinnert sich noch an alles, was passiert ist nachdem Nara Varuna gekommen ist. Die Bäume erinnern sich und die Samen auch. Aber ich bin mir nicht sicher, ob Nara Varuna das versteht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151103
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151103,
					"content": "Deshalb haben wir sichtbare Erinnerungen geschaffen. So wird Nara Varuna bei ihrer Rückkehr wissen, dass Vana und die Aranara nichts vergessen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151104
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151104,
					"content": "So ist das also ... Das „Steingedächtnis“ ist also eine Erinnerungsstele. Apropos, Menschen errichten auch Erinnerungsstelen, um das Vergessen zu vermeiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151105,
					"content": "Nara sind nämlich ein vergessliches Wesen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151106
					]
				},
				{
					"id": 730151106,
					"content": "... Im Vergleich zum Wald, ist ein Nara wie ein kleiner Sprössling, der nicht zu einem turmhohen Baum heranwachsen wird und sich nicht an all die Jahresringe erinnern kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151107,
					"content": "Die Aranara werden Vana nicht verlassen. Die Aranara und Vana gehören zusammen. Aber Nara kann kommen und gehen, genau wie Nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151108
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151108,
					"content": "Es gibt viele Aranara, so wie es viele große Bäume in Vana gibt. Viele Aranara haben viele Namen, so wie die Bäume viele Äste und Blätter haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151109
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151109,
					"content": "#Der goldene Nara erinnert sich an die vielen Namen der vielen Aranara. {M#Er}{F#Sie} erinnert sich auch daran, dass ich Aranakula bin. Es ist, als ob man ein Blatt im Wind fängt und weiß, von welchem Baum es stammt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151110
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151110,
					"content": "#Für die Aranara ist Nara Varuna ein „besonderer“ Nara! Deswegen haben sie für {M#sie}{F#ihn} eine Erinnerungsstele errichtet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151111,
					"content": "Das ist nicht das gleiche, aber wir haben vorher auch schon Statuen mit bestimmten Abbildern gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151112,
					"content": "... Statuen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151113
					]
				},
				{
					"id": 730151113,
					"content": "#Ja! Nachdem du schon Nara Varunas Geschichte gehört hast, möchte {NICKNAME} sicher {M#ihr}{F#sein} Antlitz sehen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151114,
					"content": "Aranara haben sogar Musik, also sind sie vielleicht auch in anderer Hinsicht für eine Überraschung gut! Vielleicht können sie auch eine lebensechte Statue meißeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151115,
						730151117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151115,
					"content": "Wenn es möglich ist, würde ich das gerne mal sehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151116
					]
				},
				{
					"id": 730151116,
					"content": "Ja, ja! Hehe, Nara Varuna, der goldene Nara ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151119,
					"content": "Ach ja, jetzt können wir die „Äste“ und „Blätter“ der Varuna-Maschine heilen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151120,
					"content": "#Aranakula wird Nara {NICKNAME} und Paimon dorthin bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151117,
					"content": "Die Künste der Aranara sind primitiv, das ist also schwer vorstellbar ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151118
					]
				},
				{
					"id": 730151118,
					"content": "#Oh ... Vielleicht ist diese Kunst zu fortgeschritten für {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151119
					],
					"speakerTitle": "Paimon"
				}
			]
		},
