			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Aranakula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730150301,
					"content": "Du bist sicher Aranakula!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150302,
					"content": "Herrje! Ich ... Ich wurde von Nara entdeckt! Was ist zu tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150303
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150303,
					"content": "Bleib erst mal hier! Arapandu hat uns gesagt, dass du hier bist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150304,
					"content": "A... Ach so ... Arapandu hat es euch gesagt. Dann seid ihr sicher gute Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150305
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150305,
					"content": "#Hm? Aranakula ist vielleicht zu leichtgläubig. Was wäre wenn {NICKNAME} ein böser Nara wäre, der nur Arapandus Namen benutzt, um dich zu täuschen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150306,
					"content": "Ah! A... Also der goldene Nara möchte Aranakula täuschen? Der goldene Nara ist also ein böser Nara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150307
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150307,
					"content": "... Paimon fühlt sich plötzlich so schuldig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150308,
					"content": "Hör nicht auf Paimon, ich bin ein guter Nara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150309
					]
				},
				{
					"id": 730150309,
					"content": "#Na wunderbar, Aramuhukunda sei Dank! Der goldene Nara ist also ein guter Nara. Obwohl Nara {NICKNAME} viel größer als Aranakula ist, habe ich keine Angst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150310
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150310,
					"content": "Und Paimon ... Paimon ist klein, ich habe natürlich keine Angst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150311
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150311,
					"content": "He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150312,
						730150314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150312,
					"content": "Paimon ist wirklich sehr kurz ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150313
					]
				},
				{
					"id": 730150313,
					"content": "Du wirst es bereuen, wenn du mich unterschätzt! Ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150316,
					"content": "Zurück zu unserer Mission, wir sind hier um die Varuna-Maschine zu heilen. Gibt es in diesem Teil von Vana „Äste“ oder „Blätter“, die zur Varuna-Maschine gehören?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150317,
					"content": "Arapandu lässt uns hier die Situation anschauen. Wenn du Probleme haben solltest, können wir dir helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150318,
					"content": "Ah! Es gibt viele üble Typen in Vana ... Es gibt sichere Wege, aber man muss vorsichtig sein. Außerdem gibt es überall bösartige Samen, die haben Nara Varunas ... *schluchz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150319
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150319,
					"content": "#Nara {NICKNAME} ist groß und mächtig, vielleicht so stark wie Arabalika ... Nara {NICKNAME} hat vielleicht eine Lösung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150320
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150320,
					"content": "#... Nara {NICKNAME} kann vielleicht helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150321
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150321,
					"content": "#Wir sind zum Helfen gekommen! Stimmt’s {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150322,
					"content": "Überlasse das uns.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150323
					]
				},
				{
					"id": 730150323,
					"content": "Aranakula hat noch eine andere Bitte. Bevor wir die Varuna-Maschine heilen ... Wir sollen zuerst das Steingedächtnis zurückholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150324
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150324,
					"content": "... Das „Steingedächtnis“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150325
					]
				},
				{
					"id": 730150325,
					"content": "Vana wird nicht vergessen, die Aranara werden nicht vergessen, aber die Aranara haben sichtbare Erinnerungen hinterlassen. Seit die üblen Typen gekommen sind, sind überall bösartige Samen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150326
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150326,
					"content": "Mit den Aranara zu sprechen ist wie ein Rätsel zu erraten ... Aber nachdem wir alles in echt gesehen haben, werden wir wohl verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150327,
					"content": "Wie auch immer, lass uns zuerst mit Aranakula zusammen dorthin gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150328,
					"content": "Guter Nara, gute Paimon! Passt auf, dass uns die üblen Typen nicht bemerken, es gibt einen sicheren Weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150329
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150329,
					"content": "Hä? Wenn Aranakula von „üblen Typen“ spricht, meint er wohl einfach die Pilzbestien. Dann besteht ja kein Grund zur Sorge!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150330,
					"content": "#Haha, Aranakula, hör mal! Nara {NICKNAME} ist sehr stark!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150331,
					"content": "Und zwar nicht nur gewöhnlich stark! Sondern sehr sehr stark!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150332,
					"content": "Wir haben mit Arapandu schon viele Pilzbestien geschlagen! Auch Arapandu kann unsere Stärke bestätigen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150333,
					"content": "#Ich weiß, Nara {NICKNAME} ist sicherlich auch so stark wie Arabalika. Aber Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150334
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150334,
					"content": "Paimon? Was soll mit Paimon sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150335,
					"content": "So etwas passierte ... Aranakula wurde von den üblen Typen verfolgt, hat sich in der Erde eingegraben, aber wurde herausgeholt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150336
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150336,
					"content": "Äh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150337,
					"content": "Aus dem Rachen der üblen Typen gefallen. Es war nass und heiß und roch nach faulem Obst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150338
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150338,
					"content": "Ooh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150339,
					"content": "Wenn Arabalika nicht rechtzeitig aufgetaucht wäre, dann wäre Aranakula ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150340
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150340,
					"content": "Ooh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150341,
					"content": "Arapandu hat Aranakula lange gescholten. Die Sonne ging derweil unter und wieder auf, selbst die Samen in der Baumschule keimten schon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150342
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150342,
					"content": "... Das war wirklich ein zu lange Schelte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150343,
					"content": "Aber was hat das mit Paimon zu tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150344
					]
				},
				{
					"id": 730150344,
					"content": "Ja, was hat das mit Paimon zu tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150345,
					"content": "Aranakula ist stärker als Paimon, aber wurde trotzdem fast von den üblen Typen aufgefressen. Pai... Paimon ist sehr klein, das ist viel zu gefährlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150346
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150346,
					"content": "#Das ergibt schon Sinn ... Nein! {NICKNAME} ist stark und wird Paimon sicher beschützen können, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150347,
						730150349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150347,
					"content": "Natürlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150348
					]
				},
				{
					"id": 730150348,
					"content": "#Hehe, immerhin ist Paimon die beste Freundin von {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150351
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150351,
					"content": "Aber die üblen Typen sind so viele, selbst Aranakula konnte sie nicht bezwingen ... Hmm ... Der goldene Nara ist zwar sehr stark, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150352
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150352,
					"content": "Aranakula kennt einen sicheren Weg, lasst uns diesen sicheren Weg gehen, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150353
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150353,
					"content": "Hä? Aranakula ... Hast du besonders Angst vor Pilzbestien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150354
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150354,
					"content": "*wimmer*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150355
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150355,
					"content": "Hehe, das ist also die Wahrheit! Aber Paimon als Ausrede zu gebrauchen ist nicht gerade artig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150356
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150356,
					"content": "#Wenn das so ist, {NICKNAME}, dann sollten wir den sicheren Weg zusammen mit Aranakula gehen. Wir sollten darauf achten, die Pilzbestien nicht zu alarmieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150357,
					"content": "Ich hab da viel Erfahrung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150358
					]
				},
				{
					"id": 730150358,
					"content": "Richtig, du hast schon viele derlei Sachen gemacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150359
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150359,
					"content": "Ja! Aranakula nimmt Nara auf den sicheren Weg mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150349,
					"content": "Paimon kann selbst fliehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150350
					]
				},
				{
					"id": 730150350,
					"content": "#Paimon kann doch nicht ohne {NICKNAME} fliehen! ... Wahrscheinlich nicht, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150351
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150314,
					"content": "Kleine Paimon, große Macht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150315
					]
				},
				{
					"id": 730150315,
					"content": "Richtig! Paimon ist sehr mächtig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150316
					],
					"speakerTitle": "Paimon"
				}
			]
		},
