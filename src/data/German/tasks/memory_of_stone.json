			"dialogs": [
				{
					"id": 730151301,
					"content": "Es ist hier versteckt! Wir werden diesen Ort wahrscheinlich nicht finden können, ohne dass Aranakula uns vorangeht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151302,
					"content": "Aber Paimon hat keine „Blätter“ gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151303,
					"content": "Blätter ... Sie sind in der Nähe des Baumes, nicht weit weg, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151304
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151304,
					"content": "Hmm ... Hier ist es sicher. Die Pilzbestien werden diesen Ort wohl auch nicht finden. Aranakula kann hier auf uns warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151305,
					"content": "Arapandu hat uns gesagt, dass wir nur die drei steinernen „Blätter“ in Richtung der „Äste“ hier drehen sollen, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151306,
					"content": "#Vielen Dank, Nara {NICKNAME} und Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
