			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Aranakula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730151601,
					"content": "Aranakula, wir sind zurück! Den Rest musst du aber von hier aus erledigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151602,
					"content": "#Danke Paimon, danke Nara {NICKNAME}, Aranakula weiß was zu tun ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151603
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151603,
					"content": "He! Es scheint, als dürfte es kein Problem geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151604,
					"content": "Hoffen wir, dass sich der Wald bald erholt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151605
					]
				},
				{
					"id": 730151605,
					"content": "Sobald die Varuna-Maschine geheilt ist, wird alles wieder gut. Aber Marana ... muss ausgemerzt werden, für Vana, für Sarva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151606
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151606,
					"content": "Das ist wie die „Erinnerungsstele“ für Nara Varuna, die von den bösartigen Samen überdeckt wurde. Aufgrund von Marana wurde auch die „Halle des Ashvattha“ in Mitleidenschaft gezogen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151607
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151607,
					"content": "Das war noch vor Nara Varuna nach Vanarana gekommen war, die Nara und die Aranara hatten zusammen die Baumschule aufgebaut. Aber jetzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151608
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151608,
					"content": "Nur die Kinder von Vimara können euch sehen und für die Erwachsenen existieren die Aranara nur in Geschichten ... Die damalige Baumschule wurde aufgrund von Marana zu einer Einöde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151609,
					"content": "Aranakula möchte in der Baumschule Blumen pflanzen, die Nara haben Aranara vergessen, aber kein Problem, denn die Nara könne die Blumen sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151610
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151610,
					"content": "Aranakula ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151611,
					"content": "#Nara {NICKNAME}, Paimon, Danke. Aranakula wird nicht vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151612
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151612,
					"content": "Jetzt wird Aranakula zum „Ruheort“ zurückkehren. Arapandu wird sich sehr freuen, dass die „Erinnerungsstele“ jetzt sauber ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151613
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151613,
					"content": "#Wollen Nara {NICKNAME} und Paimon mit Aranakula zusammen zum „Ruheort“ zurückkehren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151614,
						730151616
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151614,
					"content": "Ja!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151615
					]
				},
				{
					"id": 730151615,
					"content": "Es fühlt sich so sicher an, mit dem goldenen Nara zu reisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151616,
					"content": "Ich habe noch etwas zu tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151617
					]
				},
				{
					"id": 730151617,
					"content": "#Möge Aramuhukunda Nara {NICKNAME} und Paimon behüten. Passt auf, dass die üblen Typen euch nicht verspeisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
