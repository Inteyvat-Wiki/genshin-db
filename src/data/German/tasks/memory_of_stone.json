			},
			"dialogs": [
				{
					"id": 730150901,
					"content": "#Nara {NICKNAME}, das ist das Steingedächtnis der Aranara für Nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150902
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150902,
					"content": "Endlich ... Um nicht von den Pilzbestien entdeckt zu werden, muss man unterwegs immer auf der Hut sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150903,
						730150905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150903,
					"content": "Den Krieg zu vermeiden wäre auch nicht schlecht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150904
					]
				},
				{
					"id": 730150904,
					"content": "Ja, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150907,
					"content": "Oh ... Aber ist das das „Steingedächtnis“? Sieht so aus wie eine der von den Aranara aufgestellten Steinstelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150908,
					"content": "#Nara {NICKNAME} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150909
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150909,
					"content": "Ich räume die bösartigen Samen weg.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150910
					]
				},
				{
					"id": 730150910,
					"content": "#Aranakula muss sich keine Sorgen machen. Nara {NICKNAME} wird diese Kleinigkeit ohne jede Anstrengung erledigen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150905,
					"content": "Betrachte es einfach als Speichern von Knabbereien im Wald ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150906
					]
				},
				{
					"id": 730150906,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150907
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301510,
