			"dialogs": [
				{
					"id": 761190101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190102
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761190102,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190103
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761190103,
					"content": "... Ha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190104
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761190104,
					"content": "Sie scheinen Spaß zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190105,
					"content": "Grüße.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190106
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761190106,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190107
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190107,
					"content": "Auch dir einen schönen Gruß, Luonnotar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190108
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761190108,
					"content": "Spielst du ein neues Spiel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190109
					]
				},
				{
					"id": 761190109,
					"content": "Ja. Ich habe im Flaggschiff gesehen, wie Leute mit ihren Freunden mit Bechern gespielt haben, also habe ich die Idee aufgegriffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190110
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761190110,
					"content": "Sie haben einen Edelstein unter einen Becher gelegt und dann die Becher schnell auf dem Tisch gemischt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190111
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761190111,
					"content": "Als gestoppt wurde, musste der andere Spieler raten, unter welchem Becher sich der Edelstein befand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190112
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761190112,
					"content": "Die Kuuhenki lieben das Gefühl, sich in Stoff eingewickelt zu drehen, also habe ich den Hut des Hexenfräuleins als Referenz genommen und einige Verbesserungen vorgenommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190113
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761190113,
					"content": "Wie süß.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190114
					]
				},
				{
					"id": 761190114,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190115
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761190115,
					"content": "Warte mal. Du warst also im Flaggschiff ... Hat dich dort jemand erkannt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190116,
					"content": "Einige haben nachgefragt, und ich sagte: „Ich verkleide mich heute als Mondgöttin. Ich sehe ihr doch sehr ähnlich, oder?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190117
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761190117,
					"content": "Ooh, du hast dir diesen Trick von der Mondgebetsnacht wirklich zu Herzen genommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190118,
					"content": "Und sie haben es dir abgekauft?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190119
					]
				},
				{
					"id": 761190119,
					"content": "Na ja ... Nicht ganz, aber danach haben sie auch nicht mehr mit mir geredet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190120
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761190120,
					"content": "War mein Schauspiel nicht natürlich? Nächstes Mal werde ich woanders üben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190121
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761190121,
					"content": "Warum hat Paimon das Gefühl, dass jemand nur Streiche plant?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190122,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190123
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190123,
					"content": "Luonnotar möchte, dass du errätst, wo sie sich versteckt. Möchtest du eine Runde spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190124
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761190124,
					"content": "Klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190125
					]
				},
				{
					"id": 761190125,
					"content": "In diesem Fall setze bitte erstmal einhunderttausend Mora ein. Das sind nun mal die Regeln des Flaggschiffs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190126
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761190126,
					"content": "Diesen Teil kannst du weglassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
