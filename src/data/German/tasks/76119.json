			"dialogs": [
				{
					"id": 761190201,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190202
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190202,
					"content": "War das zu einfach für dich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190203
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761190203,
					"content": "Wenn du wieder zum Spielen kommst, werde ich versuchen, die Hüte noch schneller zu mischen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190204
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761190204,
					"content": "Paimon ist neugierig ... Wie genau hast du vorhin mit ihnen gespielt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190205,
					"content": "Ohne Kuuvahki kannst du gar nichts sehen, aber wenn du es benutzt, dann siehst du alles viel zu deutlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190206,
					"content": "Na ja, ich kann ja meine Augen öffnen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190207
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761190207,
					"content": "Ach ja ... Daran hat Paimon gar nicht gedacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
