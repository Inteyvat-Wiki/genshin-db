			"dialogs": [
				{
					"id": 3740701,
					"content": "Also, diese Leier „Der Himmel“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740702,
					"content": "Mondstadts Schatz, das ist die Leier, die der Anemo-Archon Barbatos einst spielte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740703
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740703,
					"content": "Mit der Heiligen Leier Der Himmel wird Dvalin aus seinem Albtraum erwachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740704
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740704,
					"content": "Damit können wir Sturmschrecken also dazu bringen, mit der Zerstörung aufzuhören?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740705,
					"content": "Aber natürlich! Ich bin der beste Barde der Welt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740706
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740706,
					"content": "Ich kenne alle Lieder, ob Vergangenheit, Gegenwart oder Zukunft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740707,
					"content": "Sieh in meine Augen. Findest du nicht, dass du mir vertrauen kannst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740708,
						3740709,
						3740710
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740708,
					"content": "... Verdächtig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				},
				{
					"id": 3740711,
					"content": "Hahaha, das wirkt bei Barden nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740712
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740712,
					"content": "Und wie kommen wir an die heilige Leier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740713,
					"content": "Sie soll an einem sicheren Ort in der Kathedrale versteckt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740714,
					"content": "Ich werde mich ein wenig umsehen. Du kannst gern mitkommen, wenn du möchtest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740709,
					"content": "Ein wenig Vertrauen kann sicher nicht schaden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				},
				{
					"id": 3740710,
					"content": "Deine Augen haben die gleiche Farbe wie der Himmel meiner Heimat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				}
			]
		},
