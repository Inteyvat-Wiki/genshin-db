			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3740301,
					"content": "Wie kommt es, dass sie keine Miene verzieht und wieder geht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740302
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740302,
					"content": "Aber wenigstens habe ich erfahren, was ich wissen wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740303
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740303,
					"content": "Denn sie hat nicht verneint, dass die Heilige Leier Der Himmel in der Kathedrale ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740304
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740304,
					"content": "#Also, {NICKNAME}, da du der allseits bekannte Neuling im Ritterorden bist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740305
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740305,
					"content": "solltest du es vielleicht auch mal probieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
