			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3740201,
					"content": "Ich werde das in die Hand nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740202,
					"content": "Hallo, Schwester!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740203
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740203,
					"content": "Möge der Windgott dich segnen, junger Barde. Was kann ich für dich tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740204
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740204,
					"content": "Ich habe erfahren, wie man Mondstadt retten kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740205,
					"content": "Oh, das ist der Segen des Anemo-Archons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740206
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740206,
					"content": "Diese Nachricht solltest du aber dem Ritterorden überbringen. Wie kann eine unbeteiligte Ordensschwester dabei behilflich sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740207
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740207,
					"content": "Hahaha! Natürlich kannst du mir helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740208,
					"content": "Beispielsweise mit ... der heiligen Leier. Mit ihrer Kraft können wir Sturmschrecken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740209
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740209,
					"content": "Geht bitte auf der Stelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740210
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740210,
					"content": "Wie bitte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740211
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740211,
					"content": "Obgleich die Bedrohung durch den Drachen groß ist, wird dem stellvertretenden Großmeister nichts im Wege stehen, sobald eine Entscheidung gefällt worden ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740212
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740212,
					"content": "Das wäre der Tod für Sturmschrecken. Das können wir doch nicht zulassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740213,
					"content": "Diesem törichten Tier, das den Ostwind verraten hat, wird selbst der Anemo-Archon nicht so einfach vergeben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740214
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740214,
					"content": "Puh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740215,
					"content": "Aber ... bitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740216
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740216,
					"content": "Es geht einfach nicht, kleiner Barde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740217
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740217,
					"content": "(Seltsam ... diesen Jungen abzulehnen, gibt mir ein unerwartet positives Gefühl)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740218
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740218,
					"content": "Tja, da ist wohl nichts zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740219
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740219,
					"content": "Ich kann mich einfach nicht mehr verstellen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740220
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740220,
					"content": "Frohlocket, meine frommen Anhänger! Vor euch ist <color=#00E1FFFF>der Anemo-Archon Barbatos</color> erschienen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740221
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740221,
					"content": "Habe ich dich erschreckt? Willst du nicht vor Freude in Tränen ausbrechen? Endlich stehst du der Gottheit gegenüber, der du so lange gedient hast. Wie fühlt es sich an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740222
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740222,
					"content": "Wenn du keine weiteren Fragen hast, würde ich gern zurück in die Kathedrale und die Büroarbeit erledigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740223
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740223,
					"content": "Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
