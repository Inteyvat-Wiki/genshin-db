			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lamiya",
					"Zhenchen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716680101,
					"content": "Alle sind herzlich eingeladen, dem „Klauenkonvoi“, einer Gesellschaft zur Rettung von Tieren, beizutreten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680102
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680102,
					"content": "Hallo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680104
					]
				},
				{
					"id": 716680104,
					"content": "#Ach, {NICKNAME}, du bist es. Wie geht’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680105
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680105,
					"content": "Unsere Gilde organisiert gerade eine Veranstaltung. Hast du Lust, vorbeizuschauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680106
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680106,
					"content": "Was für eine Veranstaltung meinst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680107
					]
				},
				{
					"id": 716680107,
					"content": "Kurz gesagt, wir laden dazu ein, dem von der Händlergilde Feiyun unterstützten „Klauenkonvoi“ beizutreten, und uns dabei zu helfen, ausgesetzte oder bedrohte Tiere zu adoptieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680108
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680108,
					"content": "Die Händlergilde Feiyun arbeitet mit Freiwilligen aus verschiedenen Ländern zusammen, um das ausufernde Problem streunender Tiere durch gemeinschaftliche Adoption zu lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680109
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680109,
					"content": "In den letzten Jahren ist die Gesellschaft zur Tierrettung stark gewachsen, und wir denken jetzt darüber nach, im Bereich des Artenschutzes mit Forschern wie Frau Lamiya zusammenzuarbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680110
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680110,
					"content": "Es freut mich wirklich, meine Forschung auf diese Art in die Praxis umgesetzt zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680111
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680111,
					"content": "Haha, die Freude über unsere Zusammenarbeit ist ganz auf unserer Seite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680112
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680112,
					"content": "Dank unserer engagierten Freiwilligen und visionären Forscher wie Frau Lamiya haben viele streunende Tiere ein Zuhause gefunden, und bedrohte Arten werden vor dem Aussterben bewahrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680113
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680113,
					"content": "Außerhalb von Liyue finden sich überall, wo die Händlergilde Feiyun tätig ist, wie in Mondstadt und Sumeru, Einrichtungen des „Klauenkonvois“ zur Pflege von Tieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680114
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680114,
					"content": "Um unseren Freiwilligen zu danken und allen zu zeigen, wie viele Tiere der „Klauenkonvoi“ betreut, haben wir diese Veranstaltung organisiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680115
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680115,
					"content": "Du kannst mal in den Bereich gehen, wo die adoptierten Tiere leben, und schauen, wie es ihnen so geht. Und da kannst du dir auch ein kleines Geschenk abholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680116
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680116,
					"content": "Die Geschenke wurden von unseren Mitarbeitern und anderen Tierpaten vorbereitet. Aber bevor du deins bekommst, solltest du natürlich auch etwas für die anderen vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680117
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680117,
					"content": "Die Geschenke werden dann eigens von uns eingesammelt und an die jeweiligen Paten übergeben. Sie müssen nicht teuer sein – Hauptsache, sie vermitteln deine Wertschätzung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680118
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680118,
					"content": "#Also, hast du Interesse, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680119,
						716680120
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680119,
					"content": "Klar, ich werde mal vorbeischauen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680121
					]
				},
				{
					"id": 716680121,
					"content": "Fantastisch! Wir freuen uns sehr, wenn eine berühmte Persönlichkeit wie du teilnimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680122
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680122,
					"content": "Wenn du schon alles vorbereitet hast, kannst du mir das Geschenk jetzt geben. Unsere Leute verteilen es dann nach der Veranstaltung an die Paten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680123
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680123,
					"content": "Übrigens, basierend auf meiner Erfahrung mögen manche Paten gern regionale Produkte, während andere eher leckeres Essen bevorzugen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680120,
					"content": "Ich will teilnehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680121
					]
				}
			]
		},
