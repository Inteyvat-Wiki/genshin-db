			"dialogs": [
				{
					"id": 716680601,
					"content": "Vielleicht sollte ich auch ein Tier adoptieren ...? Wenn ich doch nur einen Rishboland-Tiger halten könnte!",
					"roleType": "TALK_ROLE_NPC",
