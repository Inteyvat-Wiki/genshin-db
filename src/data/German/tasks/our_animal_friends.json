							"2"
						],
						"stepId": 7166804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lamiya",
					"Zhenchen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716680401,
					"content": "Gut, wir werden dieses Essen in einer Schachtel verpacken und dann versenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680402
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680402,
					"content": "Jedes Tier hat seine eigenen Verhaltensweisen. Wir sperren sie nicht in Käfige, sondern haben professionelle Betreuer angestellt, die ihren Gesundheitszustand überwachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680403
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680403,
					"content": "Es ist nicht einfach, sie zu finden. Du wirst den speziellen „Insignien-Spiegel“ benötigen, den Lamiya entwickelt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680404
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680404,
					"content": "Ich kenne mich nicht so gut damit aus, lass es dir besser von ihr persönlich erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680405
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680405,
					"content": "Gut, lass es mich dir erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680406
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680406,
					"content": "Die Technik des Insignien-Spiegels steht in gewisser Beziehung zu Akasha und die Funktionsweise ist recht komplex. Aber keine Sorge, er wurde ausgiebig getestet und ist sicher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680407
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680407,
					"content": "Da die Tiere schon mit Mini-Sendern ausgestattet sind, brauchst du nur das Signal zu empfangen, und der Spiegel zeigt dir alles, was das Tier sieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680408
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680408,
					"content": "Das Gerät muss noch verbessert werden, aber die Bilder reichen fürs Erste, um die gerade aktiven Tiere zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680409
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680409,
					"content": "Im Wesentlichen ist das alles. Wenn du bereit bist, heißen wir dich herzlich im „Klauenkonvoi“ willkommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680410
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680410,
					"content": "Benutze den „Insignien-Spiegel“, um unsere tierischen Freunde zu finden. Die Geschenke der Paten und die Tiere selbst warten schon freudig auf dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhenchen"
				}
			]
		},
