			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715551001,
					"content": "Vielen Dank. Ich dachte, ich wäre wirklich erledigt ... diese Gruppe von Schatzsuchern verfolgt mich schon die ganze Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551002
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551002,
					"content": "Genau als ich endlich Fortschritte in meiner Forschung gemacht hatte und dachte, dass es schön sein könnte, den Schatz hier zu finden und ihn mit mir zurück zu nehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551003
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551003,
					"content": "Sind die Schatzsucher in mein Lager eingedrungen, haben mich geschnappt und hierhergebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551004
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551004,
					"content": "Sie haben mich immer wieder zum Fundort des Schatzes befragt und gedroht, mich umzubringen, wenn ich es ihnen nicht sage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551005
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551005,
					"content": "Aber wenn ich es ihnen einfach so gesagt hätte, wäre das wirklich mein Ende gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551006
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551006,
					"content": "*seufz* Ich hätte auf Soraya hören sollen. Sie besteht immer darauf, dass sich Archäologen wie wir auf wissenschaftliche Ergebnisse statt auf Schätze konzentrieren sollten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551007
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551007,
					"content": "Aber ich erhalte nur begrenzte finanzielle Unterstützung. Ein paar Essays reichen nicht aus, um meine Reisekosten zu decken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551008
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551008,
					"content": "Ich kann beim besten Willen nicht sagen, wie es Soraya geschafft hat, die ganze Zeit allein in Liyue zu bleiben. Ich fühle mich erschöpft, wenn ich nur einen Blick auf den Haufen ihrer abgelehnten Manuskripte werfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551009
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551009,
					"content": "Was planst du, jetzt zu tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715551010
					]
				},
				{
					"id": 715551010,
					"content": "Nun, was sonst? Ich bin fertig mit dem Sammeln meines Forschungsmaterials. Was den Schatz angeht ... Nun, ihr könnt ihn haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551011
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551011,
					"content": "Ich werde den komplizierten Denkprozess, der mich hierhergebracht hat, nicht wiederholen. Alles, was ihr wissen müsst, ist, dass der Schatz <color=#00E1FFFF>unter dem riesigen goldenen Baum</color> in der Mitte des Lingju-Passes vergraben ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551012
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551012,
					"content": "Nehmt ihn euch, wenn ihr wollt. Ich notiere euch eine Beschreibung von ihm, damit ihr es nicht vergesst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551013
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551013,
					"content": "Ich ruhe mich eine Weile aus und gehe dann zurück in mein Lager, um meine Sachen einzusammeln. Ich muss so schnell wie möglich hier raus, damit nicht noch mehr Schatzsucher herkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551014
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551014,
					"content": "Ich habe keine Ahnung, wie lange es dauern wird, von hier zum Gasthaus Wangshu zu kommen. Ich kann nur hoffen, dass Soraya nicht schon weg ist, wenn ich dort ankomme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551015
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551015,
					"content": "*seufz* Wenn nur Soraya meine Tutorin sein könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		},
