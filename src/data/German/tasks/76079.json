			"dialogs": [
				{
					"id": 760790101,
					"content": "Die Monster sind verschwunden, aber die Spalte ist immer noch da. Und durch sie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760790102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760790102,
					"content": "Das ist der Gestank des Abgrunds. So stark. Etwas verbirgt sich dahinter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760790103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760790103,
					"content": "Komm schon! Worauf wartest du noch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760790104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760790104,
					"content": "Glaubst du etwa, wenn du wartest, bis niemand mehr da ist, und dann aus der Spalte gekrochen kommst, würde keiner dich bemerken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
