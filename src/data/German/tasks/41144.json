						411440102
					]
				},
				{
					"id": 411440102,
					"content": "Wie direkt du bist ... Dann beeil dich lieber – <color=#00E1FFFF>und fass nichts Seltsames an, während du unterwegs bist</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440103
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 411440103,
					"content": "Und denk daran, <color=#00E1FFFF>nicht deinen Gleiter einzusetzen</color>. Wenn du die Fleischröllchen bei der Landung verstreust, lehnt der Kunde sie ab.",
