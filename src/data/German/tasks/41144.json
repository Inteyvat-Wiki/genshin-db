			"dialogs": [
				{
					"id": 411440301,
					"content": "Ich habe gehört, es gibt eine Sonderbestellung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411440302
					]
				},
				{
					"id": 411440302,
					"content": "Wie? Bist du hier, um mir zu helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440303
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 411440303,
					"content": "Du kommst gerade recht. Jemand namens Lingguan hat mit Matsutake gefüllte Fleischröllchen bestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440304
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 411440304,
					"content": "Sie wollte, dass sie an einen Punkt nördlich des Dihua-Moor geliefert werden. Die fälligen Mora hat sie bereits bezahlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440305
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 411440305,
					"content": "Wenn du gerade Zeit hast, könntest du die Lieferung für mich übernehmen? Du wirst auch entlohnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lächelnder Yanxiao"
				}
			]
		},
