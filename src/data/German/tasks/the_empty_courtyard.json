			"dialogs": [
				{
					"id": 761250201,
					"content": "(Columbina ist also wirklich nicht hier ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250202
					]
				},
				{
					"id": 761250202,
					"content": "Ist Columbina wirklich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250203,
					"content": "(Sie ist durch das „Mondtor“ gegangen. Niemand weiß, was sich dahinter verbirgt, aber es ist ein Ort, der selbst den mächtigen Rächer von Solnari in Stücke gerissen hat ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250204
					]
				},
				{
					"id": 761250204,
					"content": "(Wenn ich damals ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250205
					]
				},
				{
					"id": 761250205,
					"content": "Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250206,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250207
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250207,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250208
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250208,
					"content": "Ah, ihr seid es ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250210
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250210,
					"content": "Ihr ... wartet ihr auch darauf, dass Columbina zurückkommt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250212
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761250212,
					"content": "Nicht auch noch du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250213,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250214
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761250214,
					"content": "Ach, kommt schon ... seid nicht so traurig. Kopf hoch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250215,
					"content": "Wenn alle zusammen traurig sind, dann ist das doch wie ... wie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250216,
					"content": "So will Paimon auf keinen Fall denken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250217,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250218
					]
				},
				{
					"id": 761250218,
					"content": "(... Ich darf nicht in Selbstvorwürfen versinken.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250219
					]
				},
				{
					"id": 761250219,
					"content": "(Columbina hat ihr Opfer nicht gebracht, damit wir so enden, und außerdem ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250220
					]
				},
				{
					"id": 761250220,
					"content": "Ich ... habe noch nicht aufgegeben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250221
					]
				},
				{
					"id": 761250221,
					"content": "Columbina und keiner ihrer Freunde wird einfach so aufgeben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250222
					]
				},
				{
					"id": 761250222,
					"content": "Gebt uns noch etwas Zeit. Ich kann euch nichts versprechen, aber ich werde auf jeden Fall mein Bestes geben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250223
					]
				},
				{
					"id": 761250223,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250224
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250224,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250225
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761250225,
					"content": "Sie ... wollen uns damit ermutigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250226,
					"content": "Hmm ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250227
					]
				},
				{
					"id": 761250227,
					"content": "Danke euch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250228,
					"content": "Können wir bei irgendwas helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250229,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250230
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250230,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250231
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250231,
					"content": "Diese Kuuhenki ... Paimon glaubt, dass es die ist, die gerne auf der Leier spielt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250232,
					"content": "Diese Kuuhenki ... Paimon findet sie etwas unruhig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250233,
					"content": "Warum spielst du nicht etwas? Wenn sie eine vertraute Melodie hört, beruhigt sie sich vielleicht ein wenig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250234,
					"content": "Eine vertraute Melodie ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250235
					]
				},
				{
					"id": 761250235,
					"content": "Probieren wir das, was Columbina immer singt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250236
					]
				},
				{
					"id": 761250236,
					"content": "... Sie sind eingeschlafen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250237,
					"content": "Sieht so aus, als hätten sie sich schon lange nicht mehr richtig ausgeruht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250238,
					"content": "Lass uns leise von hier verschwinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250239,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250240
					],
					"speakerTitle": "„Marionette“"
				},
				{
					"id": 761250240,
					"content": "Sandrone! Was bringt dich hierher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250241,
					"content": "Darf ich nicht einmal mehr draußen einen Spaziergang unternehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250242
					],
					"speakerTitle": "„Marionette“"
				},
				{
					"id": 761250242,
					"content": "Sie ist nicht zurückgekommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250243
					]
				},
				{
					"id": 761250243,
					"content": "Das vermute ich auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250244
					],
					"speakerTitle": "„Marionette“"
				},
				{
					"id": 761250244,
					"content": "Wunder haben eben ihren Preis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250245
					],
					"speakerTitle": "„Marionette“"
				},
				{
					"id": 761250245,
					"content": "He, in welche Richtung gehst du? Ich meine ... Da wir uns schon so selten sehen, wollen wir nicht noch ein Stück zusammen gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250246,
					"content": "Lass gut sein. Ich bin heute schlecht gelaunt und die Worte, die ich sagen würde, wären nicht nett.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250247
					],
					"speakerTitle": "„Marionette“"
				},
				{
					"id": 761250247,
					"content": "Und so wie ich das sehe, ist Trost hier das Letzte, was gebraucht wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Marionette“"
				}
			]
		}
	]
}