			"dialogs": [
				{
					"id": 220330701,
					"content": "Also, welche Süßigkeiten sollen wir vorbereiten? Wie wäre es, wenn wir eine für sie auswählen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330702,
					"content": "Schauen wir mal ... Meine Lieblingssüßigkeiten in letzter Zeit sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330703,
					"content": "Klebreisbällchen! Billig und lecker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330704,
					"content": "Knusperlotos! Schön und lecker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330705,
					"content": "Und die weichen, klebrigen dreifarbigen Klößchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330706,
					"content": "Das alles isst du gern, nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330707
					]
				},
				{
					"id": 220330707,
					"content": "Hehe, vertraue einfach auf Paimons Geschmack! Beeil dich und wähle eins aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330708,
						220330710,
						220330712,
						220330714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330708,
					"content": "Klebreisbällchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330709
					]
				},
				{
					"id": 220330709,
					"content": "Klingt toll! Lass uns schnell Klebreisbällchen für Tang Wen machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330710,
					"content": "Knusperlotos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330711
					]
				},
				{
					"id": 220330711,
					"content": "Klingt toll! Lass uns schnell Knusperlotos für Tang Wen machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330712,
					"content": "Dreifarbige Klößchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330713
					]
				},
				{
					"id": 220330713,
					"content": "Klingt toll! Lass uns schnell dreifarbige Klößchen für Tang Wen machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330714,
					"content": "Lass mich überlegen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330715
					]
				},
				{
					"id": 220330715,
					"content": "Hmm, lass uns das Gericht für Tang Wen zubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2203308,
			"completionStepIds": [
				2203301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203301",
