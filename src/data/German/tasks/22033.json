			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330401,
					"content": "Hmm, dieser Geschmack ... Na ja, es scheint nicht wie ein Liyue- oder Inazuma-Gericht zu schmecken. Der Geschmack ist wirklich neu für mich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330402
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330402,
					"content": "Obwohl es nicht die Küche ist, die ich wollte, bin ich schon zufrieden, so ein neuartiges Gericht probieren zu können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330403
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330403,
					"content": "#Danke, {F#Reisende}{M#Reisender}. Bitte nimm das an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203305,
			"completionStepIds": [
				2203305
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203305",
							"2"
						],
						"stepId": 2203305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330501,
					"content": "Hm? Ich glaube, das ist immer noch ein Inazuma-Gericht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330502
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330502,
					"content": "Ich glaube nicht, dass dies das Gericht ist, nach dem ich gefragt habe ... Na ja, egal, dieses Gericht ist auch sättigend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330503
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330503,
					"content": "#Trotzdem danke, {F#Reisende}{M#Reisender}. Bitte nimm das hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203306,
			"completionStepIds": [
				2203306
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203306",
							"2"
						],
						"stepId": 2203306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330601,
					"content": "Hmm? Warum schmeckt dieses Gericht ... so ... so interessant?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330602
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330602,
					"content": "Vielleicht sollte ich nicht interessant sagen ... Äh, vielleicht eher ... einzigartig oder so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330603
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330603,
					"content": "Wie bist du auf so ein Gericht gekommen? Deine Kochkünste sind wirklich ... nicht von dieser Welt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330604
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330604,
					"content": "#Danke für deine harte Arbeit! {F#Reisende}{M#Reisender}, bitte nimm das. Ich, ähm, genieße dieses Gericht später ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203307,
			"completionStepIds": [
				2203307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
