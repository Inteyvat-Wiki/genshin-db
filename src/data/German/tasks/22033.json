			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330301,
					"content": "Ah! Das ist es! Das, das ist der Geschmack von Zuhause, von dem ich geträumt habe, ich bin gerührt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330302
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330302,
					"content": "Ich danke dir so sehr! Ich fühle mich energiegeladen mit all dem guten Essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330303
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330303,
					"content": "Die sind für dich, ich wünsche dir eine gute Reise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203304,
			"completionStepIds": [
				2203304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203304",
							"2"
						],
						"stepId": 2203304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
