					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590402
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590402,
					"content": "Danke ich euch. Nicht wiederkommen werden die alten Erinnerungen zwar ... Aber zuverlässige Freunden ihr seid.",
