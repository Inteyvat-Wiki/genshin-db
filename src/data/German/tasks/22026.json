				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220260101,
					"content": "Hmm ... es sollte hier in der Nähe sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260102
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260102,
					"content": "Julie? Was führt dich hierher?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260103
					]
				},
				{
					"id": 220260103,
					"content": "#Hm? Oh, {F#Reisende}{M#Reisender}, du bist es! Hehe, ich hätte nie erwartet, dich hier zu treffen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260104
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260104,
					"content": "Ich bin hier, um nach Zutaten zu suchen. Xudong arbeitet an neuen Gerichten und Parvaneh gibt ihm Ideen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260105
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260105,
					"content": "Xudong erzählte mir, dass er ein süßes und weiches Gericht zum Nachtisch machen wollte, das auf Inazumas dreifarbigen Klößchen basiert. Aber dafür bräuchte es einige besondere Zutaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260106
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260106,
					"content": "Onkel Munehisa ist in die Stadt gegangen, um Lavendelmelonen zu kaufen. Ich bin hier, um das zu sammeln, was man Sakura-Blüten nennt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260107
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260107,
					"content": "Obwohl ich schon einiges gesammelt habe, ist es noch nicht genug. Ich wollte vorne suchen, aber es wimmelt nur so von Monstern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260108
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260108,
					"content": "#{F#Reisende}{M#Reisender}, kannst du mir bitte helfen, drei Sakura-Blüten zu suchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260109,
						220260111
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260109,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260110
					]
				},
				{
					"id": 220260110,
					"content": "Danke dir! Ich werde dich mit etwas Großartigem verwöhnen, wenn du zurückkommst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260111,
					"content": "Diese Monster sollten kein Problem für dich sein, richtig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260112
					]
				},
				{
					"id": 220260112,
					"content": "Normalerweise nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260113
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260113,
					"content": "Aber, hmm, wie soll ich das sagen? Wenn ich wirklich gegen diese Monster kämpfen muss, werde ich die Zutaten-Sammel-Mission definitiv vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260114
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260114,
					"content": "Ich bin so, seit ich in Mondstadt war. Immer wenn ich es mit Monstern zu tun hatte, habe ich alles andere vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260115
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260115,
					"content": "Erst nachdem ich die Monster komplett besiegt hatte, erinnerte ich mich daran, dass ich noch eine Aufgabe hatte, die meine Aufmerksamkeit erforderte ... So bin ich bei so vielen Aufgaben durchgefallen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260116
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260116,
					"content": "Du hasst Monster wirklich, nicht wahr ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260117
					]
				},
				{
					"id": 220260117,
					"content": "Sie hassen? Nein, nicht wirklich ... Eigentlich macht es mir sogar Spaß, gegen sie zu kämpfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260118
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260118,
					"content": "Hattest du schon einmal dieses Gefühl, wenn du an nichts anderes denken musst als an das Besiegen von Monstern? Es ist erstaunlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260119
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260119,
					"content": "Nun, lass uns nicht darauf herumreiten. Also, bitte hilf mir bei der Sakura-Blüten-Sammel-Mission, danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260120
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260120,
					"content": "Ich werde dich mit etwas Großartigem verwöhnen, wenn du zurückkommst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		},
