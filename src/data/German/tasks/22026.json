						],
						"stepId": 2202604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220260301,
					"content": "In Ordnung, die werden reichen. Danke! Wenn du nicht gewesen wärst, hätte ich mich selbst mit diesen Monstern herumschlagen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260302
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260302,
					"content": "Wenn das passiert wäre, weiß ich wirklich nicht, wann ich mich wieder daran erinnern würde, dass ich die Aufgabe hatte, Sakura-Blüten zu sammeln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260303
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260303,
					"content": "Wie auch immer, danke für deine Hilfe. Bitte nimm diese Spieße mit Pilzen und Hühnchen. Lynn hat mir beigebracht, wie man diesen Klassiker macht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260304
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260304,
					"content": "Ich bringe diese Sakura-Blüten zurück zu Xudong. Ich bin gespannt, was für Leckereien er sich einfallen lassen wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		}
	]
}