			},
			"dialogs": [
				{
					"id": 740590101,
					"content": "Ah, ihr seid es, die mir die Edelsteine verkauft haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590102
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590102,
					"content": "Ja! Paimon erinnert sich, dass du sagte, du wolltest aus den Edelsteinen, die wir dir verkauft haben, schönen Schmuck machen. Ob das wohl schon fertig geworden ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590103,
					"content": "Wir haben uns schon darauf gefreut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590104,
					"content": "Tja ... Ich fürchte, ich muss euch enttäuschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590105
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590105,
					"content": "Was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590106,
					"content": "Ich wollte ein Schmuckstück daraus machen ... Aber das Erz ist so hart, dass es schwer ist, es von Hand zu polieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590107
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590107,
					"content": "Und das Schlimmste ist, dass es nach dem Schneiden und Polieren seinen ursprünglichen Glanz verliert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590108
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590108,
					"content": "Kurzum, es ist einfach völlig ungeeignet für die Herstellung von Kunsthandwerk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590109
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590109,
					"content": "Oh, das haben wir nicht erwartet. Wir dachten, dass dieser Stein nützlich sein würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590110,
					"content": "Na ja, er ist nicht völlig nutzlos ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590126
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590126,
					"content": "Chesil stellt eine mechanische Uhr auf den Tisch, während er spricht.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590111
					]
				},
				{
					"id": 740590111,
					"content": "Sieh dir diese neue mechanische Uhr an! Sie wurde mit genau diesem Erz hergestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590112
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590112,
					"content": "Ich war enttäuscht, aber als ich den Stein entsorgen wollte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590113
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590113,
					"content": "Einige Uhrmacher sahen das ausrangierte Erz und benutzten es wegen seiner hohen Härte, um Teile für die Uhrwerke in ihren Uhren herzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590114
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590114,
					"content": "Die Härte und die Widerstandsfähigkeit gegen Abnutzung machten dieses Erz zu einem viel besseren Material für die Uhrwerke als das zuvor verwendete Material.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590115
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590115,
					"content": "Das heißt, wenn es für die Herstellung von Uhren verwendet wird, ist eine stabilere Versorgung erforderlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590116,
						740590117
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590116,
					"content": "Das ist kein Problem ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				},
				{
					"id": 740590118,
					"content": "Ihr habt Chesil von Puca und der Erzader erzählt.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590119
					]
				},
				{
					"id": 740590119,
					"content": "Aha, das ist doch ein schöner Zufall! Diese Uhr ist ein Prototyp mit einer neu erfundenen wasserdichten Muschelstruktur, und ursprünglich war vorgesehen, dass auch Melusinen sie bequem tragen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590120
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590120,
					"content": "In diesem Fall könntet ihr diese Uhr bitte zum Fräulein Puca bringen und ihr die Situation vorher erklären?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590121
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590121,
					"content": "Schließlich habe ich keine Erfahrung im Umgang mit Melusinen ... Wenn Puca für eine stabile Versorgung sorgen kann, dann können wir eine neue Produktionslinie einrichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590122
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590122,
					"content": "Ich werde auch den persönlichen Kontakt herstellen! Wir könnten auch die Kunst der Melusinen in das Design zukünftiger Uhren einbringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590123
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590123,
					"content": "Hehe, wenn das funktioniert, wird es auch für Puca gut sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590124,
					"content": "Vielleicht kann Puca auch ihre eigene Edelsteinwerkstatt haben, also gehen wir zurück zu Puca und sprechen mit ihr darüber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590125,
					"content": "Ich verlasse mich auf euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590117,
					"content": "Wenn man sich direkt an Puca wendet ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				}
			]
		},
