			"dialogs": [
				{
					"id": 740590401,
					"content": "Wenn Frau Puca für einen stetigen Nachschub sorgt, können wir die neuen Uhren vielleicht in Serie produzieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590402
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590402,
					"content": "Ich zähle auf euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
