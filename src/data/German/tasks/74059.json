			},
			"dialogs": [
				{
					"id": 740590201,
					"content": "#Oh! {NICKNAME} und Paimon. Schon lange nicht mehr gesehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590202
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590202,
					"content": "Wollt ihr immer noch den seltsamen Stein vom letzten Mal einsammeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590203
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590203,
					"content": "Ja, das ist richtig, aber das ist auch eine lange Geschichte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590204,
					"content": "Ihr habt Puca die Uhr gegeben, die ihr von Chesil bekommen habt, und ihr von Chesils Vorhaben erzählt, mit dem seltsamen Erz Uhren herzustellen.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590205
					]
				},
				{
					"id": 740590205,
					"content": "Un... Unglaublich! Aus einem solchen Stein kann man also etwas wie das hier machen?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590206
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590206,
					"content": "Jein ... Nur der Edelstein-Kern im Uhrwerk ist aus diesem Stein gefertigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590207,
					"content": "Zum ersten Mal habe ich eine Uhr gesehen, die auch unter Wasser noch ticken kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590208
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590208,
					"content": "Hm, Paimon erinnert sich, dass Chesil etwas von einer Austernstruktur sagte? Oder war es eine Muschelstruktur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590209,
					"content": "Hehe, allein das Geräusch in der Uhr zu hören, macht mich glücklich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590210
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590210,
					"content": "Ich wusste nicht, dass sogar dieser einfache Stein seine eigene Verwendung finden würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590211
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590211,
					"content": "Ich dachte, dass man tolle Werke, wie die meiner Schwestern, nur mit seltenen Edelsteinen schaffen kann. Ich hätte nie gedacht, dass man aus normalen Steinen auch so etwas Tolles machen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590212
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590212,
					"content": "Was auch immer es ist, es hat seinen Nutzen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590213
					]
				},
				{
					"id": 740590213,
					"content": "Stimmt, Puca fühlte sich plötzlich selbstbewusst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590214
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590214,
					"content": "Puca stellte die Uhr vorsichtig an einen schönen Platz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590215
					]
				},
				{
					"id": 740590215,
					"content": "In diesem Fall soll Puca das Erz aufbereiten und dann an Chesil verkaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590216,
					"content": "Auf diese Weise kann Puca ihre eigene Edelsteinwerkstatt haben, genau wie ihre Schwester!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590217,
					"content": "Puca hat so viele verschiedene Arten von Steinen, vielleicht findest du ja auch eine Verwendung für sie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590218,
					"content": "Ja! Ich werde darauf vorbereitet sein. Ich danke euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590219
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590219,
					"content": "Und wenn ihr irgendwelche Steine finden wollt, könnt ihr gern zu mir kommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590220
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590220,
					"content": "Hehe, gern geschehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
