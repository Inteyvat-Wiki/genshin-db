			"dialogs": [
				{
					"id": 761920201,
					"content": "Das Foto ist sehr gut geworden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920202
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920202,
					"content": "Bist du jetzt zufrieden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920203
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920203,
					"content": "Ja! Egal, ob die Legende wahr ist oder nicht – möge das Glück dir überallhin folgen, sodass du alle Gefahren meisterst und am Ende sicher zum „Speranza“ zurückkehrst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920204
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920204,
					"content": "... Danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920205
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920205,
					"content": "Hehe, na dann, gehen wir zurück? Danke auch dir, Linnea, wir sehen uns im „Speranza“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920206
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920206,
					"content": "Sehen wir uns im „Speranza“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
