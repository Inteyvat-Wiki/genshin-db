			},
			"dialogs": [
				{
					"id": 761920101,
					"content": "Sieht so aus, als hätte ich heute kein Glück. Ich habe so lange gewartet, aber selbst normale Frostflossenwale waren kaum zu sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920102
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920102,
					"content": "Hm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920103
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920103,
					"content": "Lass uns für heute Schluss machen und zurückgehen. Es wird bestimmt noch eine Gelegenheit geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920104
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920104,
					"content": "Aber ... Aber dieses Mal bleibst du nicht lange, bevor du wieder woanders hingehst, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920105
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920105,
					"content": "Lass uns noch einen Moment warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920106
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920106,
					"content": "Huch? Ist das etwa Helka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920107
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920107,
					"content": "Linnea. Ja, ich bin zurück. Aber mein Handbuch ist noch nicht ganz abgeschlossen, also kann ich mich noch nicht mit dir messen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920108
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920108,
					"content": "Oh! Dann war deine lange Reise wohl sehr erfolgreich. Aber ich war auch nicht ganz faul und habe dem Handbuch viele neue Inhalte hinzugefügt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920109
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920109,
					"content": "Bist du auch hier, um den Frostflossenwal zu sehen, Linnea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920110
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920110,
					"content": "Ja, genau. Ich habe gehört, dass er erst vor Kurzem entdeckt wurde. Wenn man seine Größe bedenkt, vermute ich, dass Veränderungen in der Umgebung dazu geführt haben, dass sich seine Hautfarbe geändert hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920111,
					"content": "Zum Beispiel die Konzentration von Kuuvahki in der Umgebung oder Ähnliches ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920112
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920112,
					"content": "Schade, heute sehen wir ihn wohl nicht mehr. Wir haben schon lange gewartet, aber völlig ohne Erfolg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920113
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920113,
					"content": "Linnea, überzeug du sie, dass wir heute erst mal zurückgehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920114
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920114,
					"content": "Mir geht es gut. Als ich heute aufgewacht bin, habe ich mich besser gefühlt als sonst, also lasst uns noch ein bisschen warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920115
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920115,
					"content": "Es heißt, dass Wünsche in Erfüllung gehen, wenn man diesen Frostflossenwal sieht. Das bedeutet dann wohl, dass er ein Tier ist, das Glück bringt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920116
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920116,
					"content": "Ich hoffe, Helka kann das Glück, das ihn hergebracht hat, mitnehmen, bevor sie aufbricht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920117
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920117,
					"content": "Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920118
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920118,
					"content": "Dann warten wir einfach zusammen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920119
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920119,
					"content": "Linnea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920120
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920120,
					"content": "Immer mit der Ruhe. Ich habe so eine Vorahnung, dass wir den Frostflossenwal heute noch sehen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920121
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920121,
					"content": "Helka weiß das doch auch, oder? Meine Vorahnungen stimmen immer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920122
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920122,
					"content": "Na gut ... Dann warten wir noch einen Moment. Aber wirklich nur einen Moment!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920123
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920123,
					"content": "Eine Weile später ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761920124
					]
				},
				{
					"id": 761920124,
					"content": "Schaut mal, schaut mal! Boah, wie hoch er springt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920125
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920125,
					"content": "Wenn ich nur auch so schnell schwimmen könnte! Zusammen mit ihnen zu schwimmen ... Das wäre sicher ein Riesenspaß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920126
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920126,
					"content": "Ich gehe einfach ins Wasser und probiere es aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920127
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920127,
					"content": "Das ist doch viel zu gefährlich! Hach, ich war so lange weg ... Kaum bin ich zurück, merke ich, dass Linnea immer noch so leichtsinnig ist wie früher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920128
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920128,
					"content": "G... Gar nicht! Willst du etwa nicht mit ihnen spielen, Helka? Sie haben doch so viel Spaß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920129
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920129,
					"content": "Aber dann werden die Kleider nass und du erkältest dich. Wäre es nicht besser, am Ufer zu bleiben und ihre fröhlichen Momente mit der Kamera festzuhalten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920130
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920130,
					"content": "Da hast du auch wieder recht ... Dann borge ich mir mal Helkas Kamera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
