				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610201,
					"content": "Die Fische sind dieser Tage sehr aktiv ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610202
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610202,
					"content": "Können wir vielleicht irgendwie helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610203
					]
				},
				{
					"id": 706610203,
					"content": "Ah, die Hilfe ist endlich da, hallo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610204
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610204,
					"content": "Ich bin Nantuck, vorsitzender Fischer des Mondstädter Angelvereins, *hust* *hust*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610205
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610205,
					"content": "Vor Kurzem sind viele neue Fischarten in den nahen Gewässern aufgetaucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610206
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610206,
					"content": "Ich habe mich sofort mit Freunden in anderen Regionen in Verbindung gesetzt und dieses Phänomen ist überall aufgetreten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610207
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610207,
					"content": "Manche Leute sagen, dass Teyvat einen solchen Anstieg von neuen Fischarten in einem Jahrhundert nicht gesehen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610208
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610208,
					"content": "Die Ursache wurde noch nicht ausreichend untersucht, aber ich vermute, dass es mit der ökologischen Verbesserung der Umwelt zu tun hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610209
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610209,
					"content": "Oh ... Zu viele von diesen Kerlchen bereiten euch wohl Schwierigkeiten, stimmt’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610210,
					"content": "Keine Sorge, Paimon kümmert sich darum! Solange sie nicht ekelig schmecken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610211,
					"content": "Haha, das sind keine Schwierigkeiten. Für den Angelverein gilt natürlich je mehr Fisch, desto besser. Aber zuerst brauchen wir mehr Hände, die mit anpacken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610212
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610212,
					"content": "Aber ganz ehrlich gesagt, was diese Hände angeht, die mit anpacken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610213
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610213,
					"content": "All die neuen Fischarten in einer so kurzen Zeitspanne für die Forschung zu fangen ... das ist tatsächlich etwas stressig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610214
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610214,
					"content": "Doch ist das auf der anderen Seite nicht auch eine hervorragende Gelegenheit für den Angelverein zu wachsen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610215
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610215,
					"content": "Deshalb habe ich einen Aushang in der Abenteurergilde gemacht. Wie sieht es aus? Interesse uns zu unterstützen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610216
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610216,
					"content": "Fischen macht viel Spaß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610217,
						706610219
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610217,
					"content": "Kein Problem, ich bin gut darin, Fische zu fangen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610218
					]
				},
				{
					"id": 706610218,
					"content": "Toll! Was für ein energiegeladener Jungspund!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610223
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610223,
					"content": "Also ... beginnen wir damit, zum Mostsee zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610224
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610224,
					"content": "Dort gibt es Fischgründe, die für Neulinge eingerichtet wurden. Ich bringe dir zuerst die Grundlagen bei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610219,
					"content": "Kann ich jetzt einfach ins Wasser springen und Fische fangen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610220
					]
				},
				{
					"id": 706610220,
					"content": "Ist es nicht ein bisschen gefährlich, einfach so reinzuspringen? Ihr Abenteurer seid wirklich mutig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610221
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610221,
					"content": "Leider sind die Fische nicht so abgebrüht wie du. Wenn sie so ein riesiges Wesen ins Wasser springen sehen, dann schwimmen sie alle schnell weg und bringen sich in Sicherheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610222
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610222,
					"content": "Das sollte man also besser nicht machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610223
					],
					"speakerTitle": "Nantuck"
				}
			]
		},
