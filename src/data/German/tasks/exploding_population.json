				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066106",
							"2"
						],
						"stepId": 7066106,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_NOT_EQUAL",
						"rawParams": [
							"7066110",
							"3"
						],
						"stepId": 7066110,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610601,
					"content": "Was hast du am Haken? Deinem Gesichtsausdruck nach zu urteilen, ziehst du etwas ziemlich Gutes an Land! Lass mich mal sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610602
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610602,
					"content": "Oh? Eine neue Fischart! Sehr schön.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610603
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610603,
					"content": "Du kannst fast mit mir zu meiner ruhmreichen Zeit mithalten, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610604
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610604,
					"content": "Kannst du auch mit deinen bloßen Händen Fische fangen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610605
					]
				},
				{
					"id": 706610605,
					"content": "Ähem ... Es scheint, als wären diese normalen, kleinen Fische ein Kinderspiel für dich, ich sollte dir eine größere Herausforderung geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610606
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610606,
					"content": "Dir ist vielleicht nicht bewusst, dass selbst in derselben Fischart große Unterschiede zwischen den einzelnen Individuen bestehen, die durch die unterschiedlichen Lebensumgebungen und die Nahrung bedingt sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610607
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610607,
					"content": "Obwohl sie alle gleich aussehen, sind bestimmte Individuen besonders energiegeladen und aktiv. Sie springen hin und wieder aus dem Wasser und sind ein echter Blickfang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610608
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610608,
					"content": "Diese Individuen sind den anderen aus sowohl kommerzieller als auch ästhetischer Sicht überlegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610609
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610609,
					"content": "Viele Hobby-Angler kaufen sie zu hohen Preisen und halten sie zu Hause in ihren Aquarien zu Dekorationszwecken. Aus diesem Grund nennt man diese Fische auch „Zierfische“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610610
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610610,
					"content": "Also abgesehen von „Notfall-Paimon“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610611
					]
				},
				{
					"id": 706610611,
					"content": "Gibt es auch noch „Zier-Paimon“!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610612
					]
				},
				{
					"id": 706610612,
					"content": "Nein, die gibt es nicht! Wie könnte es denn so viele verschiedene Arten von Paimons geben?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610613,
					"content": "Genau das ist der Punkt! Du scheinst es verstanden zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610614
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610614,
					"content": "In letzter Zeit gibt es in den Gewässern in der Nähe der Windblickberge viele „Zierfische“. Ich habe das mal auf deiner Karte markiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610615
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610615,
					"content": "Gehen wir und sehen uns das an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				}
			]
		},
