		{
			"id": 7066104,
			"completionStepIds": [
				7066103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066103",
							"2"
						],
						"stepId": 7066103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610401,
					"content": "Dieser Ort ist perfekt! Siehst du die kleinen Fische im Wasser? Sie sind wunderschön ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610402
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610402,
					"content": "Das hier sind deine Werkzeuge: Angelruten, Köder und Rezepte zur Köderherstellung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610403
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610403,
					"content": "Zuerst platzierst du den Köder am Haken und zielst dahin, wo die Fische sich im Wasser sammeln ... dann wirfst du aus! Und dann wartest du geduldig, bis ein Fisch anbeißt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610404
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610404,
					"content": "Ich habe gehört, dass Neulinge sowas wie „Anfängerglück“ haben. Ich habe damals einen großen Barsch gefangen, der über einen halben Meter lang war! Das solltest du auch versuchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610405
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610405,
					"content": "Hoffen wir, dass ich noch eine Paimon fange.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610406
					]
				},
				{
					"id": 706610406,
					"content": "He! Du wirst neben dieser Paimon hier keine andere Paimon haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610407,
					"content": "Paimon? Was für ein seltsamer Name, ist das eine Fischart?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610408
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610408,
					"content": "Das ist das „wundersame Meeresfrüchtchen“, das ich letztes Mal an Land gezogen habe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610409
					]
				},
				{
					"id": 706610409,
					"content": "He! Wurde Paimon gerade von „Knabberei“ zu „wundersamem Meeresfrüchtchen“ befördert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610410,
					"content": "#Ich verstehe! Ich wusste nicht, dass du bereits {F#eine erfahrene Anglerin}{M#ein erfahrener Angler} bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610411
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610411,
					"content": "Das macht es noch spannender, was du wohl fangen wirst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				}
			]
		},
		{
			"id": 7066106,
			"completionStepIds": [
				7066106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
