				"points": []
			},
			"dialogs": [
				{
					"id": 400610101,
					"content": "Ich erwartete heute den Besuch eines guten Freundes, denn der Wind in Watatsumi kommt heute aus dem Süden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610102
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610102,
					"content": "#Jedes Mal, wenn du so redest, müssen {NICKNAME} und Paimon die halbe Ewigkeit herumlaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400610103,
					"content": "Sag das nicht. Sind wir nicht irgendwie gute Partner? Die allerbesten sogar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610104
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610104,
					"content": "Aber heute möchte ich euch um etwas bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610105
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610105,
					"content": "Der Legende nach fügten meine Vorfahren dem Watatsumi Goryou Matsuri eine weitere Reihe von Prüfungen hinzu. Das hat nichts mit dem Überleben von Watatsumi zu tun, sondern mit der Wahrheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610106
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610106,
					"content": "Eine weitere Reihe von ... Prüfungen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400610107,
					"content": "Jetzt, da die Krise um das Überleben von Watatsumi überwunden ist, werde ich euch aus meiner angestammten Pflicht und Verantwortung heraus daran erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610108
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610108,
					"content": "Ihr könnt euch in das so genannte „Land des Schlangenherzens“ begeben und nach Hinweisen auf die zweite Prüfung suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610109
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610109,
					"content": "Puh, endlich habe ich es ausgepackt. Was für eine Erleichterung! Diese schwere Verantwortung kann ich nun an meine zukünftige Tochter weitergeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610110
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610110,
					"content": "Das war’s? Das ist schon quasi deine angestammte Verantwortung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400610111,
					"content": "... Bis heute hat Paimon immer noch Schwierigkeiten, Tsuyukos Gedankengängen zu folgen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}