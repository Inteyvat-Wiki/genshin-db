			"dialogs": [
				{
					"id": 722680301,
					"content": "Ich bin einer der letzten Jibashiri, Uda, und ich erkenne hiermit deine Tapferkeit an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680302
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680302,
					"content": "Deine Weisheit kann als „umfassend und akribisch“ bezeichnet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680303
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680303,
					"content": "Wie kann man den Charakter einer Person anhand einer solchen Prüfung erkennen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722680304,
					"content": "Dies waren in der Tat die Worte der göttlichen Priesterin in der Vergangenheit, um die jungen Talente zu loben. Später wurden daraus Banner, die jedes Jahr in der Abteilung der Jibashiri wehten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uda"
				}
			]
