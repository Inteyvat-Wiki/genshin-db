			"dialogs": [
				{
					"id": 722680101,
					"content": "Ich bin einer der letzten Jibashiri, Uda. Ein Recke von Sangonomiya. Ich erkenne die Ehre eurer Herausforderung an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680102
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680102,
					"content": "Ich werde die Prüfung der Weisheit durchführen. Bitte mach dich auf den Weg, um alle Rätsel zu lösen und die „Flammen der hohen Pforte“ wieder an ihren Platz zurückzubringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680103
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680103,
					"content": "Ohne ausreichende Weisheit etwas zu tun, ist nicht mutig, sondern einfach nur leichtsinnig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680104
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680104,
					"content": "Ich werde oben im Drei-Welten-Turm auf dich warten, bis du die Herausforderung gemeistert hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uda"
				}
			]
		},
