					"content": "Und hier ist der nächste Start – auch hier habe ich Laternen platziert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380402
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380402,
					"content": "Fang an, wenn du so weit bist. Es läuft wie zuvor, sammle auf dem Weg zum Ziel die Laternen ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
