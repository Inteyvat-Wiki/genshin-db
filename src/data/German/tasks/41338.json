			},
			"dialogs": [
				{
					"id": 413380201,
					"content": "Hier beginnt die erste Strecke. Der Start ist mit ein paar Laternen markiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380202
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380202,
					"content": "Also gut, fang einfach an, sobald du bereit bist. Sammle auf dem Weg zum Ziel die Laternen ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
		{
			"id": 4133803,
