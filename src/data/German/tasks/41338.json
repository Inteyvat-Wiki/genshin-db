					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413380301,
					"content": "Da ist die Ziellinie. Du bist ziemlich gut darin, nicht wahr ... also, was sagst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380302,
						413380303
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380302,
					"content": "Die festliche Stimmung hast du getroffen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380304
					]
				},
				{
					"id": 413380304,
					"content": "Hehe, na klar! Schließlich hab ich sie selbst dort platziert, weißt du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380305
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380305,
					"content": "Dann auf zur nächsten Strecke, in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380303,
					"content": "Die Laternen waren sehr hübsch ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380304
					]
				}
			]
		},
