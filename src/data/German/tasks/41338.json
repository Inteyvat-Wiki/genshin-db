			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413380101,
					"content": "Hmm ... Warum ist niemand gekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380102
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380102,
					"content": "Was gibt es?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380103
					]
				},
				{
					"id": 413380103,
					"content": "#{F#Reisende}{M#Reisender}! Würdest ... würdest du mich anhören? Die Gilde plante, den festlichen Trubel des Laternenrituals in eigener Sache zu nutzen, um einige neue Rekruten anzuwerben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380104
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380104,
					"content": "Qian hat sich so ein Spiel ausgedacht ... es heißt, ich weiß nicht genau. Aber ich will mitspielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380105
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380105,
					"content": "Also hab ich mir eine neue Aktivität ausgedacht. Ich nenne sie ... „Mein erstes Abenteuer.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380106
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380106,
					"content": "Kurz gesagt, ich möchte mit den Laternen neue Flugstrecken markieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380107
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380107,
					"content": "Wer bei dieser Aktivität mitmacht, kann seinen Windgleiter ausklappen, um dem Flug der Laternen zu folgen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380108
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380108,
					"content": "So erlebt man die Aufregung des Abenteuers, während man mit den Laternen an seiner Seite auf Liyue herabblickt! Klingt gut, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380109
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380109,
					"content": "Zwei Strecken habe ich entworfen, doch als ich den Millelithen Bescheid gab, meinten sie, die Sicherheit der Strecke sollte zuerst getestet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380110
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380110,
					"content": "Du hast reichlich Erfahrung mit Abenteuern, nicht wahr? Würdest du mir helfen, diese Strecken zu beurteilen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380111
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380111,
					"content": "Legen wir los.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380112
					]
				},
				{
					"id": 413380112,
					"content": "Vielen Dank für deine Hilfe! Gehen wir zum Tianheng-Berg. Dort beginnt die erste Strecke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
		{
