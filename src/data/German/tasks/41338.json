			"dialogs": [
				{
					"id": 413380501,
					"content": "Also, wie fandest du die beiden Strecken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380502
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380502,
					"content": "Nicht schlecht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380503
					]
				},
				{
					"id": 413380503,
					"content": "Prima! Dann berichte ich jetzt den Millelithen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380504
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380504,
					"content": "Bestimmt schließen sich viele der Gilde an, sobald sie an so einer aufregenden Veranstaltung teilnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380505
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380505,
					"content": "Ha, richtig. Hier ist die Entlohnung für die Beurteilung dieser Strecken. Bitte, nimm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
