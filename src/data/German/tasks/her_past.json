					}
				]
			},
			"dialogs": [
				{
					"id": 760350101,
					"content": "(Ist Columbina ... nicht da?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350102
					]
				},
				{
					"id": 760350102,
					"content": "Suchst du mich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350103
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350103,
					"content": "Waaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350104,
						760350105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350104,
					"content": "Boah, du hast mich erschreckt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				},
				{
					"id": 760350106,
					"content": "Als ich gespürt habe, dass du hier bist, wollte ich versuchen, mich von hinten zu nähern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350107
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350107,
					"content": "Du hast wohl zu viel Freizeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350108,
					"content": "Oh ... wirklich? Eigentlich ist es genauso wie früher. Als ich bei den Fatui war, gab es auch nichts Besonderes zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350109
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350109,
					"content": "Die Zarin brauchte nur die Kraft der Mondgöttin. Sie hat mich nie geschickt, um ein Göttliches Herz zu stehlen oder so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350110
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350110,
					"content": "Was hast du dann normalerweise so gemacht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350111
					]
				},
				{
					"id": 760350111,
					"content": "Spazieren gehen, den Mond betrachten, manchmal auch singen ... Letzteres dann eher selten, nachdem Sandrone es mir verboten hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350112
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350112,
					"content": "Hmm? Mochte sie deinen Gesang nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350113,
					"content": "Nein. Sie sagte, es klänge sehr schön, aber ich hatte mich damals gerade erst den Fatui angeschlossen ... Sie meinte, dass die anderen manchmal nervös würden, wenn sie meinen Gesang hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350114
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350114,
					"content": "Von Außen hatte es wohl den Anschein, als ob ich gleich ... irgendeine Art von Kraft anwendete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350115
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350115,
					"content": "Verstehe ... Das ergibt einigermaßen Sinn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350116,
					"content": "Ach ja, es gab noch einen Grund. Sie sagte, dass sie meistens die Nächte mit ihren Forschungen verbringe, und dass ich sie tagsüber beim Schlafen störe, wenn ich da singe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350117
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350117,
					"content": "(Ich wette, das war der Hauptgrund!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350118
					]
				},
				{
					"id": 760350118,
					"content": "Darum habe ich daraufhin nur nachts vor ihrer Tür gesungen. Aber sie hat mich trotzdem vertrieben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350119
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350119,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350120,
					"content": "Hast du dich mit den anderen gut verstanden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350121
					]
				},
				{
					"id": 760350121,
					"content": "„Gut verstanden“? Hmm ... Als wir uns das erste Mal trafen, schien Arlecchino sehr daran interessiert zu sein, sich „gut mit mir zu verstehen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350122
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350122,
					"content": "Sie ist immer leise hinter mir aufgetaucht, genau wie ich gerade eben mit euch. Sie sagte, sie wolle mich ... „testen“, wenn ich mich nicht irre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350123
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350123,
					"content": "Ich habe auch versucht, mit ihr das gleiche Spiel zu spielen, aber sie hat sich immer schon umgedreht, als ich noch weit weg war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350124
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350124,
					"content": "Schließlich wusste ich mir nicht anders zu helfen, als Kuuvahki anzuwenden. So konnte ich ihr endlich einen gehörigen Schrecken einjagen. Danach hat sie dieses Spiel allerdings nicht mehr mit mir gespielt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350125
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350125,
					"content": "(Die „Bedienstete“ hat das wahrscheinlich von vorneherein nie als Spiel betrachtet ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350126,
					"content": "Was noch ... Ach ja ... Il Dottore hat mich auch oft gebeten, ihm bei einigen Forschungsarbeiten zur Kraft der Lichtwelt zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350127
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350127,
					"content": "Ich habe ein paar Mal mitgemacht, aber es war ziemlich langweilig: Ich sollte immer Kuuvahki einsetzen, um dies oder das zu zerstören oder zu kontrollieren. Also bin ich irgendwann nicht mehr hingegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350128,
						760350129
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350128,
					"content": "Es scheint, dass du heute gut gelaunt bist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350130,
					"content": "Ja. Ich bin zwar von zu Hause weggelaufen, aber es gibt auch ein paar schöne Erinnerungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350131
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350131,
					"content": "Arlecchino und Sandrone waren nett zu mir, und ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350132
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350132,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350133
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350133,
					"content": "(Dieser Gesichtsausdruck ... An wen sie wohl denkt?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350134
					]
				},
				{
					"id": 760350134,
					"content": "Gib mir deine Hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350135,
						760350136
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350135,
					"content": "... Hä?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350137,
					"content": "Ich erinnere mich, dass Rosalyne mir beigebracht hat ... dass man sich immer bei anderen bedanken sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350138
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350138,
					"content": "Danke, dass du mir heute zugehört hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350139
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350139,
					"content": "Es war doch nichts Besonderes ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350140
					]
				},
				{
					"id": 760350140,
					"content": "(Das ist ... der Segen der Mondgöttin?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350141
					]
				},
				{
					"id": 760350141,
					"content": "Belassen wir es für heute dabei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350142
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760350142,
					"content": "Das kam plötzlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350143,
						760350144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350143,
					"content": "Psst ... Paimon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350145,
					"content": "Ja, wahrscheinlich. Dann sollten wir sie für heute nicht mehr stören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350144,
					"content": "Sie muss sich an etwas erinnert haben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350136,
					"content": "... Warum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350129,
					"content": "Wir haben ganz schön viel über die Vergangenheit geredet ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350105,
					"content": "Musstest du unbedingt hinter mir auftauchen ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				}
			]
		}
	]
}