				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500601,
					"content": "Über den seltsamen Stein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500602
					]
				},
				{
					"id": 710500602,
					"content": "Hast du Fotos davon machen können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500603
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500603,
					"content": "Ich muss sie sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500604
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500604,
					"content": "Das ist es ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500605
					]
				},
				{
					"id": 710500605,
					"content": "Ääh, die Fotos! Das neue Modell, das in Fontaine hergestellt wurde, ist in der Tat sehr gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500606
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500606,
					"content": "Ich habe schon einmal ein Testmodell gekauft, aber die Aufnahmen waren unscharf und man brauchte zwei Leute, um eine Kamera zu heben, also landete sie in der Akademie und verstaubte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500607,
						710500608
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500607,
					"content": "Verstaubte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				},
				{
					"id": 710500609,
					"content": "Na ja, zumindest ist es das Geld für eine Mahlzeit. Hmmm ... Sieht so aus, als wäre es an der Zeit, einen weiteren Stapel zu kaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500610
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500610,
					"content": "Ich bin abgeschweift. Lass mich mal sehen, der Stein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500611
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500611,
					"content": "Ja, das ist ein Fossil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500612
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500612,
					"content": "Fossil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500613
					]
				},
				{
					"id": 710500613,
					"content": "Ja, und es gibt eine Menge Meereslebewesen hier ... Interessant. In Liyue gibt es ein Sprichwort, das besagt: „Waldgärten und Felder, ertränkt von einem riesigen Meer“. Das ist damit gemeint.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500614
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500614,
					"content": "Die Tatsache, dass Fossilien hier in der Großen Kluft auftauchen können, deutet darauf hin, dass diese Lebewesen ursprünglich schnell genug begraben wurden, damit die Skelette so vollständig erhalten bleiben konnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500615
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500615,
					"content": "In diesem Fall habe ich gehört, dass es hier von Zeit zu Zeit auch Erdbeben gibt ... was Sinn haben würde, da eine aktive geologische Aktivität eine der notwendigen Bedingungen für die Bildung von Fossilien ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500616
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500616,
					"content": "Dies könnte für die Untersuchung der paläontologischen Taxa in diesem Gebiet nützlich sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500617
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500617,
					"content": "Aber mit einem Bild allein ist es nicht getan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500619
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500619,
					"content": "Wenn du auf weitere solche Fossilien stößt, mach bitte Fotos für mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500620
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500620,
					"content": "Wie viele brauchst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500621
					]
				},
				{
					"id": 710500621,
					"content": "Lass mich mal sehen. Ich brauche vier oder fünf ähnliche Bilder für meinen Bericht. Gut, dann eben fünf. Bring mir fünf Bilder von ähnlichen Felsen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500622
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500622,
					"content": "Ich werde den richtigen Preis dafür bieten, es ist ein toller Fund.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500608,
					"content": "Ein wenig verschwenderisch ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				}
			]
		},
		{
			"id": 7105009,
