		},
		{
			"id": 7105016,
			"completionStepIds": [
				7105209
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105209",
							"2"
						],
						"stepId": 7105209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500902,
					"content": "Schön, sehr schön, wirklich unglaubliche Fotos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500903
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500903,
					"content": "All die Ausgaben für den Erkundungstrupp sind mit diesen Fotos den Eintrittspreis wert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500904
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500904,
					"content": "Wie du sehen kannst, handelt es sich um die Skelette alter Meerestiere, und die Formen sind sehr deutlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500905
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500905,
					"content": "Dies beweist, dass die Große Kluft vor ihrer Entstehung unter der Meeresoberfläche lag.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500906
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500906,
					"content": "Es ist schade, ein solches Fossil könnte, wenn es in Sumeru gefunden worden wäre, sofort zur Untersuchung in die Akademie zurückgebracht werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500907
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500907,
					"content": "Wenn ich mich das nächste Mal an den Rat für Allgemeine Angelegenheiten wende, muss ich mit ihnen darüber sprechen. Ich kann für den Schutz bezahlen, aber die Arbeiter müssen sehr vorsichtig sein, ich kann es nicht zulassen, dass die Bergleute diese Fossilien zerstören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500908
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500908,
					"content": "Wobei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500909,
						710500910
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500909,
					"content": "Was denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500911
					]
				},
				{
					"id": 710500911,
					"content": "Diese Fotos ... sind gerade noch ausreichend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500912
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500912,
					"content": "Wie ich bereits sagte, braucht ein Fossil von so gutem Zustand und struktureller Integrität auch die Bedingungen für seine Entstehung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500913
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500913,
					"content": "Das heißt, das Tier wurde schnell im Boden eingegraben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500914
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500914,
					"content": "Die Fossilien der Großen Kluft kommen im Wesentlichen nur in einem bestimmten Höhenbereich vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500918,
						710500919
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500918,
					"content": "Eine feste Höhe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500920
					]
				},
				{
					"id": 710500920,
					"content": "Nun, geologisch gesehen ist der Höhenunterschied winzig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500915
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500915,
					"content": "Das heißt, es war ein schneller Prozess, und fast alle Fossilien hier sind fast zur gleichen Zeit entstanden. Das deutet darauf hin, dass in einem sehr kurzen Zeitraum besonders große ökologische Veränderungen stattgefunden haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500916
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500916,
					"content": "Zum Beispiel ein Treffer von etwas Großem, oder ... so etwas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500917
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500917,
					"content": "Nun, was ist in der Großen Kluft passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500919,
					"content": "Scheint ziemlich groß zu sein, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500920
					]
				},
				{
					"id": 710500910,
					"content": "Sind die Fotos nicht genug?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500911
					]
				}
			]
		},
