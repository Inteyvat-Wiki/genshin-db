			},
			"dialogs": [
				{
					"id": 3830401,
					"content": "Es hat geklappt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830402,
					"content": "Sie sieht komplett anders aus als vorher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830403
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830403,
					"content": "Die Anemo-Kraft ist wieder bis zum Überlaufen aufgefüllt. So sollte es jetzt kein Problem mehr geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830404,
					"content": "#Ich bin dir zu Dank verpflichtet, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830405,
					"content": "Wo sollten wir Sturmschrecken nun herbeirufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830406
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830406,
					"content": "Bestimmt nicht in Mondstadt! Wir könnten verheerende Verluste erleiden, wenn etwas schiefgeht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830407
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830407,
					"content": "Wenn wir es hier auf dem Weingut täten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830408
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830408,
					"content": "Ach, das wäre kein allzu großer Verlust. Aber vielleicht finden wir einen geeigneteren Ort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830409
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830409,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830410
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830410,
					"content": "Der frische und kraftvolle Wind auf See oder an hoch gelegenen Orten sollte den Gesang eines Barden weit tragen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830411,
					"content": "Bei trockenem und stickigem Wind werden nicht nur Barden, sondern auch Drachen mürrisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830412
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830412,
					"content": "Hmm, Paimon versteht. Auf See oder an hoch gelegenen Orten also.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830413,
					"content": "Der beste Ort, um die Leier zu spielen, ist demnach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830414,
						3830415,
						3830416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830414,
					"content": "Eine Klippe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830418
					]
				},
				{
					"id": 3830418,
					"content": "Wenn du vom Sternfallsee aus nach Osten gehst, kommst du an ein Gebirge, das südlich an die Küste grenzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830419
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830419,
					"content": "Ach! Paimon glaubt, er meint den Strand, an dem du letztens eingeschlafen warst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830420,
					"content": "Kletterst du entlang der Berge, kommst du an einen Ort mit dem Namen <color=#00E1FFFF>Sterngreifklippe</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830421
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830421,
					"content": "Sänger, das müsste deinen Anforderungen doch gerecht werden: Ein hoch gelegener Ort mit dem frischen Wind der See.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830422
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830422,
					"content": "Hm, die Sterngreifklippe, sagst du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830423
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830423,
					"content": "Das klingt wirklich passend. Dort sollte mein Gesang richtig zur Geltung kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830424
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830424,
					"content": "Sehr gut. Dann treffen wir uns an der Sterngreifklippe, sobald wir bereit sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830425
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830425,
					"content": "Das Ganze ist wirklich wichtig. Bitte kommt nicht zu spät!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830426
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830426,
					"content": "Jawohl, stellvertretender Großmeister!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830427,
					"content": "Oh, ich wollte niemandem den Eindruck vermitteln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830415,
					"content": "Die Küste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830418
					]
				},
				{
					"id": 3830416,
					"content": "In der Luft? Gleiten und spielen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830417
					]
				},
				{
					"id": 3830417,
					"content": "Sowas würde selbst Amber nicht schaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830418
					],
					"speakerTitle": "Jean"
				}
			]
		}
	]
