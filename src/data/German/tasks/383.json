			"dialogs": [
				{
					"id": 3830201,
					"content": "Heja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830202,
					"content": "Dvalin-Rettungseinheit, versammeln!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830203,
					"content": "Sehen wir uns die Kristalle an, die wir gesammelt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830204,
					"content": "Ah ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830205,
					"content": "Diese Kristalle sind sogar noch trüber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830206,
					"content": "Dvalin ... du musst solches Leid ertragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830207,
					"content": "Wie dem auch sei, Reisender aus der Ferne, ich bitte dich, reinige diese Kristalle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830208,
					"content": "Man mag es nicht glauben, wenn man es nicht mit eigenen Augen gesehen hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830209
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830209,
					"content": "Sehr interessant. Das ist wie die Filtration von Wein, sehr erfrischend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830210
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830210,
					"content": "Wir sollten jetzt genügend Tränen haben. Als Nächstes werden wir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 38303,
