			},
			"dialogs": [
				{
					"id": 733280101,
					"content": "Ah, da ist Jeht! Jeht!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280102,
					"content": "#{NICKNAME}? Und kleine Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280103
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280103,
					"content": "Biepbiep!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280104
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733280104,
					"content": "Haha, wie ich gesagt habe, wir sehen uns wieder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280105
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280105,
					"content": "Was machst du hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280106
					]
				},
				{
					"id": 733280106,
					"content": "Ah, das ist ein kleines Geheimnis einer Dame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280107
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280107,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280108,
					"content": "#{M#Das heißt, sei nicht neugierig! Sogar ich könnte etwas für mich behalten wollen ...}{F#Also ... Finde ein Izakaya und heitere mich auf, dann verrate ich dir vielleicht ein oder zwei Geheimnisse ... Sag mir nicht, dass ich dir etwas beibringen soll!}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280109
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280109,
					"content": "#{M#Pfft, nach den Regeln der Wächter darf ich euch nichts sagen. Tut mir leid!}{F#D... Das war nur ein Scherz! Es gibt ein paar Regeln, die wir befolgen müssen ... Ich darf kein Wort über die Waren sagen, die wir eskortieren. Tut mir leid!}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280110
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280110,
					"content": "Hmpf, so geheimnisvoll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280111,
					"content": "Also ... Wie geht es dir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280112,
						733280113
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280112,
					"content": "Nicht schlecht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				},
				{
					"id": 733280114,
					"content": "Ja ... Mir auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280115
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280115,
					"content": "Na gut, ich will euch nicht länger aufhalten. *seufz* Ich habe noch eine Menge zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280116
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280116,
					"content": "Oh, du bist so beschäftigt, Jeht. Früher warst du nicht so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280117,
					"content": "Pfft ... Weil ich eine „stabile“ Arbeit gefunden habe. Obwohl ich im Grunde genommen das Gleiche mache wie vorher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280118
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280118,
					"content": "Es dauert wirklich nicht lange, bis ich anfange, die alten und sorglosen Tage zu vermissen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280119
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280119,
					"content": "Ich weiß nicht, was du in letzter Zeit gemacht hast, aber ich freue mich immer darauf, deine Geschichten zu hören. Ich habe auch viel mit dir zu teilen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280120
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280120,
					"content": "Aber keine Eile im Moment. Gute Geschichten sind wie Wein. Wir müssen sie richtig gären lassen. In der Wüste waren Reisende einst darauf angewiesen, um zu überleben, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280121
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280121,
					"content": "Ja, auf jeden Fall, pass auf dich auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280122
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280122,
					"content": "Du auch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280123
					]
				},
				{
					"id": 733280123,
					"content": "Ja, tausend Umarmungen für dich. Ich werde weiter für dich beten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280124
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280124,
					"content": "Biepbiep!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280125
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733280125,
					"content": "Haha, Benben ebenfalls!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280113,
					"content": "Es geht so.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				}
			]
		},
		{
