			"dialogs": [
				{
					"id": 401540101,
					"content": "Ihr führt den Trankladen weiter. Dank eurer harten Arbeit übertreffen eure Einnahmen die bisherigen Prognosen ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401540102
					]
				},
				{
					"id": 401540102,
					"content": "Wah, das muss ich euch lassen, ihr Süßen. Ich hätte nie gedacht, dass ihr in so kurzer Zeit so viele Mora verdienen würdet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540103
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540103,
					"content": "Ihr seid ja richtige Genies, wenn es um Geschäfte geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540104,
						401540107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540104,
					"content": "Das ist alles Eurer Hilfe zu verdanken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540105
					]
				},
				{
					"id": 401540105,
					"content": "Hehe, immer so bescheiden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540106,
					"content": "Obwohl, bei so beeindruckenden Ergebnissen würde ich sagen, dass ihr ein bisschen mehr Anerkennung verdient hättet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540109,
					"content": "Wenn ich immer eure Hilfe hätte, könnte ich bestimmt doppelt so viel Urlaub nehmen, ohne mich um etwas kümmern zu müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540110,
					"content": "Durch eure harte Arbeit bis zu diesem Zeitpunkt haben wir bereits genügend Verkaufsdaten für unsere Forschung gesammelt. Vielen Dank für all eure Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540111,
					"content": "Wenn ihr natürlich daran interessiert seid, den Laden weiterzuführen, wäre ich überaus glücklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540112,
					"content": "In jedem Fall sollte ich bereits mehr als genug haben, um Jean Bericht zu erstatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540113,
					"content": "#{NICKNAME}, Paimon, lange nicht gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540114,
					"content": "Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401540115,
					"content": "Oh, du bist da! Ich habe ein paar Geschäfte mit meinen Süßen abgeschlossen und wollte mich gerade bei dir im Ritterorden melden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540116
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540116,
					"content": "Das ist nicht nötig. Ich habe bereits mit einigen anderen Rittern gesprochen, daher denke ich, dass ich die Situation recht gut verstehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540117
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540117,
					"content": "#Sieht so aus, als hättest du {NICKNAME} wieder einmal um Hilfe gebeten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540118,
					"content": "Hehe, wie könnte ich nicht? Wenn es um eine so wichtige Arbeit wie diese geht, ist ein kluger und fähiger Partner einfach ein Muss ... vor allem wenn wir gute Ergebnisse erzielen wollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540119
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540119,
					"content": "Sieh dir doch den Erfolg des Ladens an! Allein hätte ich niemals ein solches Ergebnis erzielen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540120,
					"content": "Nun, ich muss zugeben, dass euer Erfolg bemerkenswert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540121
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540121,
					"content": "Ich wollte schon seit einiger Zeit zu euch kommen, aber die Arbeit kam mir immer wieder in die Quere und ich hatte einfach keine Zeit ... Trotzdem wusste ich einfach, dass ich mich persönlich bei euch bedanken muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540122,
						401540123
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540122,
					"content": "Wir sollten auch Euch für Eure Unterstützung danken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540124
					]
				},
				{
					"id": 401540124,
					"content": "Es ist wirklich beruhigend, so hervorragende Mitglieder in unseren Reihen zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540125
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540125,
					"content": "Hehe, wenn das alles vorbei ist, glaube ich, dass ich mal Urlaub machen sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540126
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540126,
					"content": "Ich habe durch den ganzen Stress schon einige Haarsträhnen verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540127,
					"content": "Natürlich. Ich danke dir für all deine harte Arbeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540128
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540128,
					"content": "Da du die ganze Zeit in der Bibliothek eingesperrt bist, habe ich mir Sorgen gemacht, dass du dich langweilen könntest. Also dachte ich, ich gebe dir die Gelegenheit, deine Talente wirklich zu nutzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540129
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540129,
					"content": "Vielleicht habe ich dir zu viel auf einmal zugemutet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540130
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540130,
					"content": "#So schlimm war es nicht. Ich bin schließlich nicht allein gewesen. Die ganze Hilfe des Ordens und von {NICKNAME} war wirklich nützlich, um die Last zu verringern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540131
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540131,
					"content": "Außerdem hat es Spaß gemacht, wieder in die Forschung einzusteigen. Es ist schön, diese Zeit ab und zu wieder aufleben zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540132
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540132,
					"content": "Ich bin froh, das zu hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540133
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540133,
					"content": "#Nochmals vielen Dank für deine Hilfe, {NICKNAME}. Bitte nimm dies als Entlohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540134
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540134,
					"content": "Ah, apropos Entlohnung, ich habe auch ein kleines Andenken für dich vorbereitet. Hier, ich hoffe, es gefällt dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540123,
					"content": "Alle haben ihr Bestes gegeben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540124
					]
				},
				{
					"id": 401540107,
					"content": "Wir haben einfach den Dreh raus bekommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540108
					]
				},
				{
					"id": 401540108,
					"content": "Hm, ein Beweis für eure Fähigkeit, bei der Arbeit zu lernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540109
					],
					"speakerTitle": "Lisa"
				}
			]
		}
	]
}