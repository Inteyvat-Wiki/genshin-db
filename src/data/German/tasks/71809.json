				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090201,
					"content": "Alles ist gut, alles ist gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090202
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090202,
					"content": "Was ist gut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090203
					]
				},
				{
					"id": 718090203,
					"content": "#Oh, du bist es, {F#Reisende}{M#Reisender}. In der Stadt gab es einen großen Vorfall, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090204
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090204,
					"content": "Darum ist es gut, dass danach nichts Schlimmes mehr passiert ist ... Und noch wichtiger, es ist gut, dass alle Lebensmittelläden in der Stadt noch geöffnet sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090205
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090205,
					"content": "Was würde sonst aus all den Delikatessen werden, die ich so liebe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090206
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090206,
					"content": "Ah, es geht also ums Essen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090207
					]
				},
				{
					"id": 718090207,
					"content": "He, sei nicht so abschätzig. Der beste Weg, um einen Ort kennenzulernen, ist schließlich die regionale Küche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090208
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090208,
					"content": "Ah, alleine darüber zu reden, lässt mir das Wasser im Mund zusammenlaufen. Ich könnte einen kleinen Imbiss vertragen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hao"
				}
			]
		},
		{
			"id": 7180903,
			"completionStepIds": [
				7180906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7180906",
							"2"
						],
						"stepId": 7180906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fan Erye"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090301,
					"content": "Je mehr ich von dieser Oper höre, desto weniger verstehe ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090302
					],
					"speakerTitle": "Fan Erye"
				},
				{
					"id": 718090302,
					"content": "Stimmt etwas nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090303
					]
				},
				{
					"id": 718090303,
					"content": "#Oh, hallo {F#Reisende}{M#Reisender}. Nun, die Sache ist die: Im Teehaus Heyu wurden jüngst ein paar neue Opern aufgeführt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090304
					],
					"speakerTitle": "Fan Erye"
				},
				{
					"id": 718090304,
					"content": "Aber nun ja, sie sind höchst lebendig, so viel ist sicher. Doch ich scheine sie nicht ganz zu verstehen oder so schätzen zu können wie die jungen Leute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090305
					],
					"speakerTitle": "Fan Erye"
				},
				{
					"id": 718090305,
					"content": "Und wie findest du das?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090306
					]
				},
				{
					"id": 718090306,
					"content": "Gute Frage. Persönlich habe ich nichts gegen die Klassiker. Schließlich bin ich sie gewohnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090307
					],
					"speakerTitle": "Fan Erye"
				},
				{
					"id": 718090307,
					"content": "Doch zugleich verändert sich in Liyue so viel. Ein paar neue Opern scheinen zu diesem Geist des Wandels gut zu passen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090308
					],
					"speakerTitle": "Fan Erye"
				},
				{
					"id": 718090308,
					"content": "*seufz* Aber all das geschieht so schnell. Die alten Opern wurden schon eine Weile nicht gespielt. Was Rex Lapis wohl dazu – Nein, sprechen wir nicht davon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fan Erye"
				}
			]
		},
		{
			"id": 7180904,
			"completionStepIds": [
				7180909
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
