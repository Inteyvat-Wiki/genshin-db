			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090401,
					"content": "Was hast du gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090402
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090402,
					"content": "Eine ganze Menge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090403
					]
				},
				{
					"id": 718090403,
					"content": "Oh, fürwahr. Bitte teile es mir mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090404
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090404,
					"content": "An der Südwerft gibt es viele Hunde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090405
					]
				},
				{
					"id": 718090405,
					"content": "Oh, gut, gut. Wie munter und beschwinglich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090406
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090406,
					"content": "In der Bubu-Hütte leben viele Finken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090407
					]
				},
				{
					"id": 718090407,
					"content": "Finken, ja ... Ein Zeichen des Friedens. Welch poetisch liebliches Symbol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090408
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090408,
					"content": "Manche denke nur ans Essen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090409
					]
				},
				{
					"id": 718090409,
					"content": "Haha, das ist in Ordnung. Essen ist einer der Haupttriebe und Lebensfreuden – besonders in so einer Stadt wie Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090410
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090410,
					"content": "Ja, das ist alles äußerst faszinierend. Ich zeichne es auf. Es könnte noch von Nutzen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090411
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090411,
					"content": "Für manche geschieht der Wandel zu rasch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090412
					]
				},
				{
					"id": 718090412,
					"content": "Hmm, das war ebenfalls zu erwarten. Manche haben den Eindruck, dass Liyue jeden Tag seine alte Haut abstreift. Selbst ich komme da nicht immer mit oder kann es jedes Mal gutheißen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090413
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090413,
					"content": "Doch dies ist eine höchst allgemeine Beobachtung. Ein einzelnes Gedicht könnte damit überfordert sein. Gleichwohl halte ich es fest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090414
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090414,
					"content": "Das sollte fürs Erste reichen. Wie ich sehe, habe ich meinen Helfer wohl gewählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090415
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090415,
					"content": "Dies sollte für ein paar neue Bereicherungen in meiner nächsten Anthologie genügen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090416
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090416,
					"content": "Ah, richtig, abgesehen von einigen materiellen Gütern habe ich ein kleines Geschenk für dich. Bitte nimm dies als Dank für deinen Beistand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090417
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090417,
					"content": "Sobald meine neue Anthologie erscheint, kannst du diesen Namenszug gegen ein kostenloses Exemplar eintauschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
