			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jafar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230100101,
					"content": "#{M#Mein Freund}{F#Meine Freundin}, du siehst gehetzt aus. Bedrückt dich etwas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100102,
						230100105
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100102,
					"content": "Vieles ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100103
					]
				},
				{
					"id": 230100103,
					"content": "Ah ... In der Tat, ich sehe, dass du müde bist, aber keine Zeit für eine Pause hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100104
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100104,
					"content": "Du hast sicher etwas auf dem Herzen, das so schnell wie möglich erledigt werden muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100109
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100109,
					"content": "Wenn du mir erlaubst, dich für einen Moment aufzuhalten, möchte ich dich gerne einladen, dich zu mir zu setzen und eine leckere Mahlzeit zu genießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100110
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100110,
					"content": "Solche Unruhe ist selbstverständlich ein natürlicher Teil des Lebens ... Aber, wie man so schön sagt: Auch ein reißender Fluss muss manchmal friedlich durch einen ruhigen Bach fließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100111
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100111,
					"content": "Egal wie beschäftigt du bist, hin und wieder solltest du dir eine Auszeit nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100112
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100112,
					"content": "Lass mich kurz nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100113
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100113,
					"content": "Aha, wie wäre es, wenn wir die „Minzbohnensuppe“ probieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100114
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100114,
					"content": "Du brauchst mir keine Mora zu bezahlen. Hilf mir einfach, einen Bund Minze zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100115
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100115,
					"content": "Ah, richtig, sei nicht zu wählerisch, wenn du nach der Minze suchst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100116
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100116,
					"content": "Und denk daran, dass du nur nach einem gewöhnlichen Bund Minze suchst, nicht nach irgendwelchen Problemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100105,
					"content": "Eigentlich geht es mir gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100106
					]
				},
				{
					"id": 230100106,
					"content": "Oh, das ist gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100107
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100107,
					"content": "Aber du bewegst dich so hastig, dass ich denke, dass du gerade angestrengt versuchst, ein Problem zu lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100108
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100108,
					"content": "Also, ich weiß zwar nicht, welches Problem dich beschäftigt, aber ich habe da einen Vorschlag ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100109
					],
					"speakerTitle": "Jafar"
				}
			]
		},
