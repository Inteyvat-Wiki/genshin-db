				"objectNames": [
					"Jafar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230100801,
					"content": "#{M#Mein Freund}{F#Meine Freundin}, du siehst gehetzt aus. Bedrückt dich etwas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100802,
						230100805
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100802,
					"content": "Vieles ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100803
					]
				},
				{
					"id": 230100803,
					"content": "Ah ... In der Tat, ich sehe, dass du müde bist, aber keine Zeit für eine Pause hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100804
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100804,
					"content": "Du hast sicher etwas auf dem Herzen, das so schnell wie möglich erledigt werden muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100809
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100809,
					"content": "Wenn du mir erlaubst, dich für einen Moment aufzuhalten, möchte ich dich gern einladen, dich zu mir zu setzen und eine leckere Mahlzeit zu genießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100810
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100810,
					"content": "Solche Unruhe ist selbstverständlich ein natürlicher Teil des Lebens ... Aber, wie man so schön sagt: Auch ein reißender Fluss muss manchmal friedlich durch einen ruhigen Bach fließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100811
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100811,
					"content": "Egal wie beschäftigt du bist, hin und wieder solltest du dir eine Auszeit nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100812
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100812,
					"content": "Lass mich kurz nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100813
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100813,
					"content": "Wie wäre es, wenn wir die „Schawarma-Rollen“ probieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100814
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100814,
					"content": "Du brauchst mir keine Mora zu bezahlen. Hilf mir einfach, etwas rohes Fleisch zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100815
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100815,
					"content": "Es ist egal, wie du an das rohe Fleisch gelangst. Jede Methode ist in Ordnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100816
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100816,
					"content": "Und denk daran, dass du nur nach rohem Fleisch suchst, nicht nach Schwierigkeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100805,
					"content": "Eigentlich geht es mir gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100806
					]
				},
				{
					"id": 230100806,
					"content": "Oh, das ist gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100807
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100807,
					"content": "Aber du bewegst dich so hastig, dass ich denke, dass du gerade angestrengt versuchst, ein Problem zu lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100808
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100808,
					"content": "Also, ich weiß zwar nicht, welches Problem dich beschäftigt, aber ich habe da einen Vorschlag ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100809
					],
					"speakerTitle": "Jafar"
				}
			]
		},
