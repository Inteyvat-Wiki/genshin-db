						230100707
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100707,
					"content": "Ich lasse meine Gedanken friedlich durch diesen ruhigen Bach fließen, so wie ich es gesagt habe. Das ist meine Form einer Auszeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100708
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100708,
					"content": "Also, bitte genieße dein Gericht in vollen Zügen. Ich hoffe, dass sie deine Gedanken zur Ruhe kommen lässt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jafar"
				}
			]
		},
		{
			"id": 2301008,
			"completionStepIds": [
				2301008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
