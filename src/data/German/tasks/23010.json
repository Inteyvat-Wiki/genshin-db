				"points": []
			},
			"dialogs": [
				{
					"id": 230100301,
					"content": "Eine sehr gute Minze. Warte bitte kurz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100303
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100302,
					"content": "Jafar holt die anderen Zutaten und beginnt mit der Zubereitung ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230100303,
					"content": "Das ist „Minzbohnensuppe“ aus den Zutaten, die du gesammelt hast. Bitte, greif zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100304
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100304,
					"content": "Danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100305
					]
				},
				{
					"id": 230100305,
					"content": "Nichts zu danken. Lass es dir schmecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100306
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100306,
					"content": "Wenn ich esse, lasse ich all die ermüdende Arbeit und Forschung hinter mir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100307
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100307,
					"content": "Ich lasse meine Gedanken friedlich durch diesen ruhigen Bach fließen, so wie ich es gesagt habe. Das ist meine Form einer Auszeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100308
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100308,
					"content": "Also, bitte genieße dein Gericht in vollen Zügen. Ich hoffe, dass sie deine Gedanken zur Ruhe kommen lässt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jafar"
				}
			]
		},
