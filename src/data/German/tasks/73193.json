			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731930901,
					"content": "Du kannst die Dendro-Kraft anwenden? Bin ich etwa tatsächlich auf jemanden getroffen, dem ein Göttliches Auge zu eigen ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930902
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930902,
					"content": "Ich habe schon lange nicht mehr jemanden wie dich getroffen. Das weckt wirklich Erinnerungen in mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930903
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930903,
					"content": "Sabbah, Sabbah, das sollte funktionieren, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731930904,
					"content": "Ja, und durch die direkte Anwendung der Dendro-Kraft sollten sie sehr schnell sprießen. Lasst uns einfach abwarten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930905
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930905,
					"content": "Langsam wachsen einige dünne und zarte Sprösslinge aus dem Boden.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930906
					]
				},
				{
					"id": 731930906,
					"content": "Nachdem sie einige grüne Blätter ausgebildet haben, stellen die Sprösslinge ihr Wachstum ein.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930907
					]
				},
				{
					"id": 731930907,
					"content": "#Sie sind gesprossen, sie sind gesprossen! Paimon hat es ja gesagt, {NICKNAME} kriegt alles hin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731930908,
					"content": "Das Ergebnis hat sich wie erwartet sofort eingestellt. Ich danke euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930909
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930909,
					"content": "Schade, dass sie keine Blüten ausgebildet haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930910
					]
				},
				{
					"id": 731930910,
					"content": "Ah, das ist ganz natürlich, man muss Geduld haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930911
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930911,
					"content": "Pflanzen müssen stets die Wachstumsphasen Sprießen, Austreiben, Knospenbildung und Aufblühen durchlaufen. Dass du die Sprösslinge so schnell zum Sprießen gebracht hast, ist an sich schon sehr erstaunlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930912
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930912,
					"content": "Wir sollten den Rosen noch ein wenig Zeit geben, sodass sie weiter Nährstoffe aufnehmen können, um dann zu erblühen. Das ist auch besser für die Rosen selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930913
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930913,
					"content": "Außerdem bin ich euch bereits sehr dankbar für die Hilfe, die ihr mir heute erwiesen habt. Es wäre unhöflich, euch um noch mehr zu bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930914
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930914,
					"content": "Wenn ihr später etwas freie Zeit habt, dann könnt ihr gerne vorbeikommen und sie euch anschauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		}
	]
}