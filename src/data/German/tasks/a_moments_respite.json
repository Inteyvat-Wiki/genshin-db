			},
			"dialogs": [
				{
					"id": 40190401,
					"content": "Huch? Ihr ... Ihr seid zurück?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190402
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190402,
					"content": "Cuistot! Laverune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190403,
					"content": "Hat man euch etwa wieder geschnappt und wieder hier reingesteckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190404
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190404,
					"content": "Ähm ... nein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190405,
					"content": "Argh! Und ich dachte, ihr hättet die ganze Aufregung letztens genutzt, um zu fliehen. Damit hättet ihr zu den wenigen gehört, denen die Flucht gelungen wäre. Aber wer hätte gedacht, dass ihr ... gar nicht abgehauen seid?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190406
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190406,
					"content": "Hahaha ... Entschuldigung, wir hatten nur was zu tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190407,
					"content": "Schon gut, schon gut, ist ja nicht schlimm. Ich bin einfach froh, dass es euch gut geht. Er hier hat sich eine Weile echt Sorgen um euch gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190408
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190408,
					"content": "He, das bin nicht nur ich! Als ob du dir keine Sorgen gemacht hättest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190409
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190409,
					"content": "Ist ja gut. Ja, ich mir auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190410
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190410,
					"content": "Ich wurde die letzten Tage auch in die Küche versetzt, und während ich so arbeitete, murmelte Cuistot zu seinen Möhren: „Ob es den beiden wohl gut geht? Ob sie noch leben?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190411
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190411,
					"content": "Immer, wenn er das sagte, meinte ich: „Denen geht’s gut. Die sitzen sicher gerade irgendwo, schlürfen ein kühles Getränk und genießen die Aussicht.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190412
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190412,
					"content": "He! Es ist doch in Ordnung, sich um seine Mitgefangenen Sorgen zu machen, oder? Außerdem lieben die beiden meinen Tratsch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190413
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190413,
					"content": "Diese beiden ... haben viel weichere Kerne, als Paimon es je gedacht hätte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190414,
						40190415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190414,
					"content": "Die Wohlfahrtsmahlzeiten müssen in letzter Zeit sehr gut schmecken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
					]
				},
				{
					"id": 40190416,
					"content": "... He, vergiss dann bloß nicht, auch ordentlich reinzuhauen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190415,
					"content": "Mit euch beiden brummt die Kantine sicher richtig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
					]
				}
			]
		},
