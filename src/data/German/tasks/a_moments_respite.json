			},
			"dialogs": [
				{
					"id": 40190501,
					"content": "Jurieu! Die Oberschwester hat gesagt, dass du wieder nicht zu Mittag gegessen hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190502
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190502,
					"content": "Ich hatte zu tun und habe es vollkommen vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190503
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190503,
					"content": "Das ist noch lange keine ... Huch? Ihr seid es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190504
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190504,
					"content": "Jurieu, Lourvine, hallo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190505,
					"content": "Hallo! Hier herrscht in letzter Zeit ein ziemliches Chaos. Ist bei euch alles in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190506
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190506,
					"content": "Danke, uns geht’s gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190507
					]
				},
				{
					"id": 40190507,
					"content": "Und wie geht es euch? Nehmt ihr immer noch den Geheimgang von der Klinik, um hierherzukommen und an dem großen Schiff zu forschen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190508,
					"content": "Richtig. Und wir sind die Einzigen, die dieses Geheimnis kennen. Ihr dürft es niemandem verraten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190509
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190509,
					"content": "Wenn die Klinik gerade voll ist, ist es ein wenig umständlich, aber allemal besser, diesen Weg zu gehen, als vom Büro des Herzogs zu kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190510
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190510,
					"content": "Aber es ist auch wahr, dass du oft in die Klinik gehst, nur um die Arbeit zu schwänzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190511
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190511,
					"content": "Und warum bist du dann auch so oft da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190512
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190512,
					"content": "Ihr zwei nutzt doch den Bau des Schiffes vor allem für eure Techtelmechtel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190513,
					"content": "Überhaupt nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jurieu"
				}
			]
		},
