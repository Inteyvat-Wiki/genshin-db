				]
			},
			"dialogs": [
				{
					"id": 40190301,
					"content": "Entflohene Häftlinge sind von selbst zurück? Da wird ja der Hund in der Pfanne verrückt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190302
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190302,
					"content": "Wir wollten mal nachsehen, wie es um Fort Méropide so steht! Ist hier noch alles in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190303,
					"content": "Wir haben keine größeren Probleme. Neuvillette kam vorbei und hat sich dem Gröbsten angenommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190304
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190304,
					"content": "Wenn das so ist, warum habt ihr ihn denn nicht einfach gebeten hierzubleiben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190305,
					"content": "Oh ja, toller Plan. He, warum gehen wir nicht zusammen und fragen ihn: „Oberster Richter, hast du nicht Lust, den Gerichtssaal für einen Fleck Wasser irgendwo im Nirgendwo hinter dir zu lassen?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190306
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190306,
					"content": "Das wird wohl nichts ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190307
					]
				},
				{
					"id": 40190307,
					"content": "Er kam eilig hier herunter und ehe man sich’s versah, war er auch schon wieder weg. Nicht mal für ein Schlückchen Tee blieb Zeit. Aber er nahm ein Geschenk der Oberschwester mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190308
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190308,
					"content": "Klingt, als wäre er ein vielbeschäftigter Mann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190309,
					"content": "Fräulein Clorinde ist auch gegangen. Sie hat auch ein Geschenk der Oberschwester mitgenommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190310
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190310,
					"content": "Waren die Geschenke Milchmixgetränke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190311,
					"content": "Für Neuvillette, ja. Clorinde bekam einen Lippenstift.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190312
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190312,
					"content": "Ah? Das sind ja mal zwei ganz verschiedene Sachen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190313,
					"content": "Fräulein Clorinde arbeitet ja auch nicht so viel wie Neuvillette. Bei ihm besteht jedoch mehr Sorge um seine Gesundheit. Außerdem liebt die Oberschwester es, den Damen Schönheitsprodukte zu schenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190314
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190314,
					"content": "Übrigens, ich habe hier auch Geschenke für euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190315
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190315,
					"content": "Kommen die ebenfalls von Sigewinne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190316,
					"content": "Nein, von mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190317
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190317,
					"content": "Eure Arbeit im Fort Méropide ist abgeschlossen und ihr könnt jederzeit an die Wasseroberfläche zurückkehren. Allerdings ist eure Strafe noch nicht abgelaufen. Bis zum Ende eurer Haftzeit könnt ihr also nach Belieben eure Zelle benutzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190318
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190318,
					"content": "Ist das wirklich in Ordnung? Das wäre immer noch eine ziemlich lange Zeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190319,
					"content": "Inklusive Verpflegung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190320
					]
				},
				{
					"id": 40190320,
					"content": "Die Kantine steht euch kostenlos zur Verfügung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190321
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190321,
					"content": "Hurra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190322,
					"content": "Vergesst nur nicht, am Tag eurer Entlassung vorbeizukommen, um den Papierkram zu erledigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wriothesley"
				}
			]
		},
