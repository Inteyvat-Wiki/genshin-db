			"dialogs": [
				{
					"id": 40190101,
					"content": "Sigewinne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190102,
					"content": "#{NICKNAME}, Paimon, ihr seid wieder da!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190103,
					"content": "Geht’s euch gut? Seid ihr verletzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190104,
					"content": "Keine Sorge, wir sind wohlauf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190105
					]
				},
				{
					"id": 40190105,
					"content": "Alles gut! Und ihr? Es war ein solches Chaos! Ist danach alles gut gegangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190106,
					"content": "Es gab ein paar Verletzte, aber nichts allzu Ernstes. Herr Neuvillette kam vorbei, und dank ihm konnten wir die Krise vorerst eindämmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190107,
					"content": "Und natürlich danken wir auch euch für eure Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190108,
					"content": "Woher wusste Neuvillette, dass er hier gebraucht wird?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190109,
					"content": "Herr Neuvillettes Hydro-Resonanz ist außerordentlich stark. Wenn das Wasser steigt, erzeugt der Ozean eine gewaltige Wellenbewegung, die er spüren kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190110,
					"content": "Als ich dabei war, die Häftlinge zu versorgen, stieß ich auf die Bombenbrüder. Sie meinten, ihr seid einfach nach unten gerannt, ohne euch umzudrehen. Ich bin wirklich erleichtert zu sehen, dass es euch gut geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190111,
					"content": "Wenn ihr es nicht allzu eilig habt, könnt ihr ja noch ein paar Tage hier bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190112
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190112,
					"content": "Sagt mir gern, was ihr essen möchtet, ich werde dann Herrn Wolsey bitten, es für euch zuzubereiten. Wenn ihr müde seid, könnt ihr euch auch eine Weile in der Klinik ausruhen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190113,
					"content": "Ich wollte zufällig auch die Gelegenheit nutzen, eure Gesichtsmuskeln genauer zu beobachten. Euer fröhliches Lächeln ist sehr ansteckend, ich kann es einfach nicht vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				}
			]
		},
