			"dialogs": [
				{
					"id": 40190201,
					"content": "Und jetzt rate mal. Was wird auf der nächsten Karte zu sehen sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190202
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190202,
					"content": "Ähm ... Eine Katze mit gefletschten Zähnen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190203
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 40190203,
					"content": "Ah, ihr seid es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190204
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190204,
					"content": "#{NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190205
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190205,
					"content": "Hallo zusammen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190206
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 40190206,
					"content": "Fréminet sieht so aus, als hätte er sich schon fast wieder erholt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190207,
					"content": "Ja, alle haben sich sehr gut um mich gekümmert. Danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190208
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 40190208,
					"content": "Ach ja, stimmt! I... Ich habe genug Mut aufgebracht, um mich bei Fräulein Clorinde zu bedanken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190209
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 40190209,
					"content": "Oh! Wie hat sie reagiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190210,
					"content": "Sie sagte, es sei nicht der Rede wert ... Sie schien nicht zu glauben, dass es eine große Sache gewesen sei, jemandem das Leben zu retten, und sagte mir, ich solle es mir nicht zu Herzen nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190211
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 40190211,
					"content": "Sie wollte dich nur nicht unter Druck setzen. Du solltest es dir wirklich nicht zu Herzen nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190212
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190212,
					"content": "Hm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190213
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 40190213,
					"content": "Jetzt hört euch das an! Wir sind zum Opernhaus gegangen und haben Arlecchino dort getroffen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190214,
					"content": "„Vater“? Hat sie euch etwas erzählt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190215
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190215,
					"content": "Sie hat sich ziemlich mysteriös ausgedrückt und meinte, sie hoffe, in Zukunft wieder mit uns zusammenarbeiten zu können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190216,
					"content": "Ich war schon ein wenig überrascht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190217
					]
				},
				{
					"id": 40190217,
					"content": "„Vater“ ist euch gegenüber ja sogar noch etwas netter, als wir dachten ... Großartig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190218
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190218,
					"content": "#{NICKNAME}, du musst auf „Vater“ vertrauen. Sie hat ihre Verpflichtungen, und wenn nötig, wird sie alle ihr zur Verfügung stehenden Kräfte bündeln. Das schließt dich mit ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190219
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190219,
					"content": "Stimmt. „Vater“ ist äußerst zuverlässig und vertrauenswürdig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190220
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190220,
					"content": "Oh, da wir davon sprechen, meinte sie auch, dass Lyney viel zu ehrgeizig sei und lernen muss, sich hin und wieder auch mal auf andere zu verlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190221,
					"content": "Ähm ... Verstehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190222
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190222,
					"content": "Das klingt ganz nach „Vater“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190223
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 40190223,
					"content": "He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190224
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190224,
					"content": "Bleibt ihr jetzt vorerst hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190225
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190225,
					"content": "Sieht wohl ganz danach aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190226,
					"content": "Ausgezeichnet. Dann können wir ja eine Teegesellschaft veranstalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190227
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190227,
					"content": "Wirklich? Paimon will nochmal ein Stück Kuchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190228,
					"content": "„Nochmal“ deutet darauf hin, dass ihr oben schon einen leckeren Kuchen gegessen habt. Hm, wie toll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190229
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190229,
					"content": "Kommt auch das nächste Mal zu Tee und Häppchen vorbei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		},
