					}
				]
			},
			"dialogs": [
				{
					"id": 40190601,
					"content": "Wir sind zurück in unserer Zelle, nur, dass wir jetzt keine Häftlinge mehr sind. Irgendwie fühlt sich das nicht so an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190602,
					"content": "Es fühlt sich so an, als hätten wir endlich unsere Unschuld bewiesen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190603
					]
				},
				{
					"id": 40190603,
					"content": "Genau. Aber wir haben ja überhaupt nichts verbrochen. Wir sind also die ganze Zeit unschuldig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190604,
					"content": "Es fühlt sich so an, als hätten wir unsere Freiheit wiedererlangt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190605
					]
				},
				{
					"id": 40190605,
					"content": "Ja! Das Gefühl von Freiheit ist nun irgendwie ein ganz besonderes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190606,
					"content": "Paimon, möchtest du irgendwas sagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190607
					]
				},
				{
					"id": 40190607,
					"content": "Oh? Woher weißt du das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190608,
					"content": "Weil du normalerweise sofort ins Bett gehst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190609
					]
				},
				{
					"id": 40190609,
					"content": "Das stimmt doch gar nicht! Na gut ... Was Paimon eigentlich sagen will, ist, dass wir beide echt toll sind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190610,
					"content": "Wir waren schon an so vielen Orten und haben so viele Leute kennengelernt. Immer auf Reisen, immer neue Freunde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190611,
					"content": "So viele Probleme auf der Welt, und wir sind nur zu zweit, und doch lösen wir sie jedes Mal ... Ist das nicht fantastisch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190612,
					"content": "Wir sind eben die allerbesten Abenteurer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190613
					]
				},
				{
					"id": 40190613,
					"content": "#Du zählst Paimon also mit dazu? Du bist doch {F#die Abenteurerin}{M#der Abenteurer} von uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190614,
					"content": "Eine Reiseführerin wie du zählt genauso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190615
					]
				},
				{
					"id": 40190615,
					"content": "Dann muss Katheryne das nächste Mal Paimon aber auch eine Abenteurerlizenz ausstellen! Abenteurerin Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190616,
					"content": "Allein der Gedanke daran macht Paimon ganz schön aufgeregt ... Paimon muss jetzt in die Federn. Du solltest auch bald schlafen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190617,
					"content": "Als wir das letzte Mal hier geschlafen haben, sind wir in einem absoluten Chaos aufgewacht ... Das Wasser des Urmeers war am Ansteigen, wie gruselig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190618,
					"content": "Das passiert heute sicher nicht, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190619,
					"content": "Nein, wird es nicht. Du kannst beruhigt schlafen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190620
					]
				},
				{
					"id": 40190620,
					"content": "Na gut, dann gute Nacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190621,
					"content": "Gute Nacht, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
