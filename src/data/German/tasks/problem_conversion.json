			},
			"dialogs": [
				{
					"id": 230190401,
					"content": "Und? Hast du das Boot komplett überprüft?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190402
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190402,
					"content": "Schon erledigt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190403
					]
				},
				{
					"id": 230190403,
					"content": "Nach der Schilderung des Zustands des Boots ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230190404
					]
				},
				{
					"id": 230190404,
					"content": "Verstehe, bei den Strukturen, bei denen kreativ Geld gespart wurde, gibt es, wie zu erwarten, Probleme ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190405
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190405,
					"content": "Es wird aber einiges kosten, um diese Struktur zu reparieren. Und ich erinnere mich, dass der Besitzer des Boots immer knapp bei Kasse ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190406
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190406,
					"content": "Ach, ich rede besser mit ihm. Im Vergleich zu Geld ist das Leben definitiv wichtiger ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				}
			]
		}
	]
}