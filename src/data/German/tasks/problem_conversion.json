			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rafiq"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230190101,
					"content": "Ich wusste es, so ist es teurer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190102,
					"content": "Was sagst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190103
					]
				},
				{
					"id": 230190103,
					"content": "Oh, hallo! Ich bin gerade dabei, ein Konstruktionsproblem eines Boots zu untersuchen. Aktuell stoße ich auf einige Hindernisse ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190104
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190104,
					"content": "Einfach gesagt, möchte ich die Kapazität des Boots bei gleichen Kosten erhöhen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190105,
					"content": "Wenn die Ladung schwerer wird, bricht die Struktur leichter. Und eine ungleiche Verteilung des Gewichts wird auch zu Balanceproblemen führen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190106,
					"content": "Der beste Weg, um diese Probleme zu lösen, ist es, bessere Materialien zu verwenden. Aber, wenn wir das tun ... werden die Kosten wieder zum Problem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190107,
					"content": "Ach, um ehrlich zu sein, habe ich nicht das Geld, aber ich will ein gutes Boot bauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190108,
					"content": "Also lassen sich einige Probleme mit Geld lösen. Ich muss mir aber Wege überlegen, sie mit technischen Kniffen zu umschiffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190109
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190109,
					"content": "Ist das wirklich machbar ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190110
					]
				},
				{
					"id": 230190110,
					"content": "Hahaha, das klingt vielleicht schwer vorstellbar, aber viele Menschen machen das so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190111
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190111,
					"content": "Im Endeffekt sind die Boote, die wir bauen, Küstenfischerboote, die keinen starken Winden oder Wellen ausgesetzt sein werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190112,
					"content": "Jeder folgt beim Bootsbau dem Prinzip, zu sparen, wo zu sparen ist. Solange es gut funktioniert, sollte nicht einmal eine zusätzliche Mora verschwendet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190113,
					"content": "Dank dieses Prinzips läuft unser Bootsreparaturgeschäft jeden Tag sehr gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190114
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190114,
					"content": "#{F#Reisende}{M#Reisender}, wenn du willst, dann hilf mir, das Boot da drüben zu überprüfen, das gerade eingelaufen ist. Es scheint, ein paar Probleme zu haben, weil es oft schwere Ladung transportiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190115
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190115,
					"content": "Ich habe zu diesem Problembereich vor Kurzem Forschungen angestellt. Vielleicht kann ich daraus Inspiration ziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190116,
						230190118
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190116,
					"content": "Überlasse es mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190117
					]
				},
				{
					"id": 230190117,
					"content": "Vielen Dank! Ich muss schnell weiter zum nächsten Boot und es reparieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190118,
					"content": "Warum gehst du nicht selbst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190119
					]
				},
				{
					"id": 230190119,
					"content": "Ich würde gern selbst gehen, aber ich wurde gebeten, ein anderes Boot zu reparieren, damit es wieder auslaufen und die Netze einsammeln kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190120
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190120,
					"content": "#Also bleibt mir nichts anderes übrig als dich darum zu bitten, das zu übernehmen, {F#Reisende}{M#Reisender}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				}
			]
		},
