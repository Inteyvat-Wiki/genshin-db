			"dialogs": [
				{
					"id": 750280101,
					"content": "Tss ... Wir sind also heute auf die falschen Opfer gestoßen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280102
					],
					"speakerTitle": "Maus"
				},
				{
					"id": 750280102,
					"content": "Aah! Was für ein schlechter Tag heute ist! Warum bekomme ich all diese Schläge ohne Grund!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280103
					],
					"speakerTitle": "Nachteule"
				},
				{
					"id": 750280103,
					"content": "#Bitte, {M#guter Herr}{F#gnädige Frau}, erleuchte mich! Was habe ich getan, das dir missfallen hat? Lass es mich wissen, damit ich es nie wieder tue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280104
					],
					"speakerTitle": "Nachteule"
				},
				{
					"id": 750280104,
					"content": "He, du nutzloses Ding! Willst du wirklich vor diesem bösen Schurken kriechen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280105
					],
					"speakerTitle": "Maus"
				},
				{
					"id": 750280105,
					"content": "Und wozu ist es gut, nicht nutzlos zu sein? Oh, ich merke es jetzt. Für dich zu arbeiten unterscheidet sich nicht davon, ein Dieb oder Gauner zu sein. Was ist so besonders am Saurierhandel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280106
					],
					"speakerTitle": "Nachteule"
				},
				{
					"id": 750280106,
					"content": "#Da wir sowieso von stärkeren Räubern ausgeraubt werden, warum arbeite ich nicht einfach für {M#diesen guten Herrn}{F#diese gnädige Frau} hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280107
					],
					"speakerTitle": "Nachteule"
				},
				{
					"id": 750280107,
					"content": "#{M#Guter Herr}{F#Gnädige Frau}, ich will nicht angeben, aber ich bin sicher, dass ich dir viel nützlicher wäre als diese beiden. Sag mir einfach Bescheid, wenn du etwas brauchst, und ich werde alles so regeln, wie du es möchtest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280108
					],
					"speakerTitle": "Nachteule"
				},
				{
					"id": 750280108,
					"content": "*brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280109,
						750280111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280109,
					"content": "Nun, zufällig bin ich auf der Suche nach einer Hilfskraft.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280110
					]
				},
				{
					"id": 750280110,
					"content": "Ist das dein Ernst? Niemals! Paimon wird nicht zustimmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280112,
					"content": "#Und ihr seid definitiv Bösewichte! Wir sind die Guten und die Guten werden sich niemals mit illegalen Saurierhändlern zusammentun, richtig, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280113,
						750280114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280113,
					"content": "Es gibt niemanden, der gerechter ist als ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280117
					]
				},
				{
					"id": 750280117,
					"content": "#Ähem! Also, was auch immer ihr mit diesem Saurier vorhabt, hört jetzt besser auf, oder wir ... oder {NICKNAME} wird euch eine harte Lektion erteilen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280118,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280119,
					"content": "Die beiden Saurierhändler gehen unzufrieden weg ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750280120
					]
				},
				{
					"id": 750280120,
					"content": "Paimon fragt sich, wie es dem Qucusaurier geht. Schauen wir ihn uns mal an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280114,
					"content": "Nun, wenn es eine Regel gibt, dann gibt es auch eine Ausnahme ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280115
					]
				},
				{
					"id": 750280115,
					"content": "#He, sag das nicht vor {REALNAME[ID(2)|SHOWHOST(true)]}! Keine Sorge, Kleiner, wir werden uns nicht mit Saurierhändlern zusammentun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280116,
					"content": "*brüll* ... *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280111,
					"content": "Danke für deine Hilfsbereitschaft, aber das ist nicht nötig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280112
					]
				}
			]
		},
