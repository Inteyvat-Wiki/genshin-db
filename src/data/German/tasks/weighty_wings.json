						750280205
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280204,
					"content": "Können wir etwas tun, um ihm zu helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280207
					]
				},
				{
					"id": 750280207,
