					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280208,
					"content": "#Hm? {REALNAME[ID(2)|SHOWHOST(true)]}, hast du eine Idee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280209
					],
