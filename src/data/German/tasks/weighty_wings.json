					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280205,
					"content": "Aber wir können uns nicht ewig um ihn kümmern ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280206
					]
				},
				{
					"id": 750280206,
					"content": "Aber es muss doch etwas geben, was wir tun können, um ihm zu helfen ... auch wenn wir uns nur für kurze Zeit um ihn kümmern können ...",
