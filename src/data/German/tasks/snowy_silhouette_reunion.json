					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708030101,
					"content": "Hm? Das ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030102,
						708030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030102,
					"content": "Joels Vater? ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				},
				{
					"id": 708030104,
					"content": "#Ah! Du bist gekommen, Reisende{M#r}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030105
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708030105,
					"content": "Ich stelle einmal vor. Das ist Joels Vater, Herr Joserf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030106
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708030106,
					"content": "#Papa! Das ist {F#die}{M#der} Reisende, von {F#der}{M#dem} ich dir erzählt habe, {F#die}{M#der} mir schon so oft geholfen hat und diesmal sogar einen Schneemann mit mir gebaut hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030107
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708030107,
					"content": "Joel hat mir alles darüber erzählt, vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030108,
						708030109
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030108,
					"content": "Solange ihr zusammen seid ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030110,
					"content": "Ja, das ist jetzt ein Geschenk des Himmels!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030111,
					"content": "Pallad, du hast dieses Mal großartige Arbeit geleistet, gut gemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030112
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030112,
					"content": "Was hat Pallad denn gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030113,
					"content": "Du erinnerst dich an die Person, von der ich sagte, dass ich sie das letzte Mal auf dem Drachengrat gefunden habe, stimmt's?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030114
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708030114,
					"content": "Nachdem du mich an diesem Tag auf den Drachengrat begleitet und mir geholfen hast, die Monster zu besiegen, habe ich mich wieder auf die Suche gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030115
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708030115,
					"content": "Während der Suche rollte ich versehentlich den Berg hinunter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030116
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708030116,
					"content": "... rollte ... hinunter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030117,
					"content": "Zum Glück war die Schneeschicht unten dick und weich und ich wurde nicht verletzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030118
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708030118,
					"content": "Gerade als ich mich auf den Rückweg machen wollte, hörte ich plötzlich ein Geräusch neben mir und ein Mann stürmte hervor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030119
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708030119,
					"content": "Damals wusste ich noch nicht, dass er der Mann war, den ich suchte, und ich hielt ihn für einen Abenteurer, wie auch ich einer war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030120
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708030120,
					"content": "Aber es dauerte ein paar Gespräche, bis er merkte, dass er sich an vieles nicht mehr erinnern konnte und nicht einmal seinen eigenen Namen kannte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030121
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708030121,
					"content": "Es war eiskalt und wir hatten keine Zeit, uns um all das zu kümmern, also überredete ich ihn, mit mir zum Lager zu kommen und alles Weitere zu klären, wenn wir dort angekommen sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030122
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708030122,
					"content": "Zurück im Lager trafen wir Joel, der bei seinem Anblick erstarrte und daraufhin rief: „Papa!“ In diesem Moment erinnerte er sich plötzlich an etwas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030123
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708030123,
					"content": "Vater ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030124
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708030124,
					"content": "Joel, ich bin da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030125
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030125,
					"content": "Kannst du dich an nichts anderes erinnern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030126,
					"content": "„Die Wildschweinprinzessin“ und die Füchse, die du auf dem Drachengrat gefüttert hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030127,
					"content": "Tut mir leid, ich erinnere mich nicht. Vielleicht liegt es an einer traumatischen Kopfverletzung? Ich bin mir nicht mehr sicher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030128
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030128,
					"content": "Als ich aufwachte, war ich voller Blut. Sogar mein Gepäck ging verloren und es gab nichts, was meine Identität hätte beweisen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030129
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030129,
					"content": "Ich musste mich in einer Höhle verkriechen, um mich langsam zu erholen, und überlebte nur durch meinen Jagdinstinkt, nachdem sich meine Beine und Füße etwas erholt hatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030130
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030130,
					"content": "Papa ... ich mache mir wirklich Sorgen um dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030131
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708030131,
					"content": "Schon gut, schon gut, Joel, weine nicht, Papa geht diesmal nicht weg. Papa bleibt einfach bei dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030132
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030132,
					"content": "Herr Joserf, was wirst du als Nächstes tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030133,
					"content": "Ich ... möchte jetzt einfach ein bisschen mehr Zeit mit meiner Familie verbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030134
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030134,
					"content": "Es ist schön, wieder hier zu sein. Das ist ein perfektes Ende für diese ganze Sache, hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030135
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030135,
					"content": "Aber, Pallad, wenn du mitten in einer Suche den Halt verlierst und einen Hügel hinunterrollst, solltest du deine Abenteuerfertigkeiten stärken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030136
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030136,
					"content": "Ich muss dir einen guten Auffrischungskurs geben, wenn ich wieder bei der Gilde bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030137
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030137,
					"content": "Was? Anführer Cyrus ... Habe ich denn nicht eine große Leistung vollbracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030138
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708030138,
					"content": "Ich gehe zur Gilde zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030139
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030139,
					"content": "Anführer! Mach mal halblang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 708030109,
					"content": "Solange alles gut ist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030103,
					"content": "Ein großer Joel ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				}
			]
		}
	]
}