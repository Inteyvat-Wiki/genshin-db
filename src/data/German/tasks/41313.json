				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413135201,
					"content": "Hehe, der lächelnde Yanxiao ist kein dahergelaufener Koch, oder? Ihr solltet nach unserer Mahlzeit die Stadt besuchen. Ihr werdet gerade rechtzeitig kommen, um zu sehen, wie die Mingxiao-Laternen aufsteigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413135202
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 413135202,
					"content": "Ich kann nicht glauben, dass ihr ihn dazu überreden konntet, mit uns zu essen. Das passiert zum ersten Mal! Und ich kenne ihn seit Jahren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
