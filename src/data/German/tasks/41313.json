			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130201,
					"content": "Also, ist die Angelegenheit geklärt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130202
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130202,
					"content": "Wir haben uns darum gekümmert, aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130203
					]
				},
				{
					"id": 413130203,
					"content": "Dann ist ja gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130204
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130204,
					"content": "Wirst du dir nicht die Mingxiao-Laterne ansehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130205
					]
				},
				{
					"id": 413130205,
					"content": "Nein. Wie gesagt kann ich überfüllten Bereichen nichts abgewinnen. Besonders zu dieser Zeit im Jahr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130206
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130206,
					"content": "Die Mingxiao-Laterne dieses Jahr ist das Abbild des Fürsten des ziehenden Himmels.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130207
					]
				},
				{
					"id": 413130207,
					"content": "Ja, es ist ein sehr beeindruckender riesiger Hirsch. Wollen wir ihn uns zusammen ansehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130208,
					"content": "„Fürst des ziehenden Himmels“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130209
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130209,
					"content": "Trotzdem eine Mingxiao-Laterne. Ein fliegende Schöpfung von Menschenhand. Es bedeutet mir nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130210
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130210,
					"content": "Wenn dieses kurzlebige Spektakel eines ist, dem ihr beiwohnen möchtet, schlage ich vor, dass ihr zur Stadt geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				}
			]
		},
		{
			"id": 4131303,
			"completionStepIds": [
				4131303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131303",
							"2"
						],
						"stepId": 4131303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130301,
					"content": "Klingt danach, als würden du und Xiao sich wieder um Geschäfte kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130302
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413130302,
					"content": "Es hat sich definitiv herumgesprochen. Die Nachrichten haben uns sogar hier erreicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130303
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 413130303,
					"content": "Und trotzdem wird bald das Laternenritual eines weiteren Jahres vorüber sein. Und er wird trotzdem nicht hingehen und es sich ansehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413130304,
					"content": "*seufz* ... All diese ganzen Jahre und ich habe nie gesehen, dass er am Laternenritual teilnimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130305
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 413130305,
					"content": "Ich würde so weit gehen, zu sagen, dass es einfacher wäre, das Fest zu ihm zu bringen als andersherum ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130306
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 413130306,
					"content": "Das Fest zu ihm bringen ... Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130307,
					"content": "Eine schöne Idee.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130308
					]
				},
				{
					"id": 413130308,
					"content": "Ja! Wenn Xiao nicht zum Laternenritual geht, dann bringen wir das Laternenritual zu ihm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130309,
					"content": "Entschuldigung? Du hast doch sicher gemerkt, dass ich nur einen Witz gemacht habe ... Wie würdest du denn „das Laternenritual zu ihm bringen“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130310
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 413130310,
					"content": "Als wir in der Stadt waren, um uns die Festlichkeiten anzusehen, haben wir gelernt, wie man Laternen bastelt. Wir haben sogar einen Essensstand gefunden, der lokale Delikatessen serviert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130311,
					"content": "So viel leckeres Essen, so viele schöne Laternen. Und nicht zu vergessen ... hmm, was noch ... Oh, die Helden vergangener Tage, seine alten Freunde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130312,
					"content": "Sind die nicht das Herz und die Seele des Laternenrituals?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130313,
					"content": "Du hast nicht unrecht, aber wo würden wir all das aufbauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130314
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413130314,
					"content": "Jetzt, da du es sagst, frag ich mich ... Wir würden ausreichend Platz benötigen, um unseren eigenen Stand zu errichten. Hmm ... Vielleicht gibt es <color=#00E1FFFF>unter dem Gasthaus</color> gerade genug Platz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130315
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 413130315,
					"content": "Sehen wir es uns an und suchen wir uns einen Ort aus. Ich glaube, ich weiß, was für einen Stand du haben willst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130316
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 413130316,
					"content": "Hmm, es gibt ein paar Stilrichtungen, an die wir uns halten können. Ich werde darüber nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				}
			]
		},
		{
			"id": 4131307,
			"completionStepIds": [
				4131307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131307",
							"2"
						],
						"stepId": 4131307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai’an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130701,
					"content": "Hier ist es nicht allzu schlecht ... und es ist in sicherem Abstand zum Gewusel. Eine passende Wahl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130702
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 413130702,
					"content": "Wir haben einen schönen Ort für uns gefunden. Jetzt müssen wir einen richtigen Stand bauen. Ich habe nachgedacht und glaube, ich weiß ungefähr, wie es gemacht wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130703
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 413130703,
					"content": "Wenn du mich für einen Moment entschuldigst, ich finde heraus, wo wir anfangen sollten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130704
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 413130704,
					"content": "Tada! Mit einigen Ecken und Kanten, aber er sollte uns gut dienen. Was denkst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130705
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 413130705,
					"content": "Ich denke, du hast deine wahre Berufung verfehlt! So eine fachmännische Schreinerarbeit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130706
					]
				},
				{
					"id": 413130706,
					"content": "Keine große Sache! Nur ein bisschen Heimwerken, das ich vor ein paar Jahren gelernt habe. Das Meiste davon habe ich tatsächlich vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130707
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 413130707,
					"content": "Wir können den Stand von unserer Liste streichen. Sieht recht festlich aus, mit der Laterne, findest du nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130708
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 413130708,
					"content": "Du weißt auch, wie man Laternen bastelt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130709
					]
				},
				{
					"id": 413130709,
					"content": "Na ja, schon. Aber in meiner Generation war das normal für jeden, der in Liyue aufgewachsen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130710
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 413130710,
					"content": "Na ja, wo wir von Festivitäten sprechen ... Keine Feier ist vollständig ohne ein Festmahl. Weißt du, was du auf der Karte stehen haben willst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130711
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 413130711,
					"content": "Mandeltofu, das ist sicher! Wir haben ihn zuvor für Xiao gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130712,
					"content": "Und gegrillter Tigerfisch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130713
					]
				},
				{
					"id": 413130713,
					"content": "Mandeltofu und gegrillter Tigerfisch, hmm ... Was für eine interessante Kombination von Geschmäckern! Ich werde mit dem lächelnden Yanxiao darüber sprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130714
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 413130714,
					"content": "Er sollte sie in kürzester Zeit beschaffen können. Glücklicherweise gibt es in der Küche des Gasthauses alle nötigen Zutaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130715
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 413130715,
					"content": "Es ist an der Zeit unseren Ehrengast herbeizurufen. Könntest du ihn holen? Das Essen sollte fertig sein, wenn du herunterkommst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				}
			]
		},
		{
			"id": 4131308,
			"completionStepIds": [
				4131308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131308",
							"2"
						],
						"stepId": 4131308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130801,
					"content": "Was nun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130802
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130802,
					"content": "Wir wollen, dass du mit uns zum Laternenritual kommst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130803
					]
				},
				{
					"id": 413130803,
					"content": "Wir hatten doch über überlaufene Orte gesprochen. Ich will mich nicht wiederholen. Geht am besten alleine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130804
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130804,
					"content": "Ich sagte nicht, dass du zum Hafen von Liyue gehen musst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130805
					]
				},
				{
					"id": 413130805,
					"content": "Was soll das heißen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130806
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130806,
					"content": "Du wolltest nicht zum Fest kommen, also haben wir das Fest zu dir gebracht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130807
					]
				},
				{
					"id": 413130807,
					"content": "Ihr habt „das Fest zu mir gebracht“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130808
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130808,
					"content": "Gut, also im Gasthaus gibt es einen Haufen leckerer Snacks und eine Reihe von Laternen. Und es gibt praktisch niemanden sonst, um den du dich sorgen musst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130809,
					"content": "Es gibt sogar Mandeltofu und gegrillten Tigerfisch ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130810
					]
				},
				{
					"id": 413130810,
					"content": "Beeil dich besser, sonst wir das Essen kalt. Komm schon nach unten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4131309,
			"completionStepIds": [
				4131314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131314",
							"2"
						],
						"stepId": 4131314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130901,
					"content": "Tada! Dein ganz eigenes Mini-Laternenritual! Na, wenn einem da nicht das Wasser im Mund zusammenläuft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130902,
					"content": "Das habt ihr also damit gemeint, das Fest zu mir bringen zu wollen ... Sind die Eigenheiten menschlichen Verhaltens denn endlos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130903
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130903,
					"content": "Dient es einem größeren Zweck?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130904,
						413130905
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130904,
					"content": "Auf diese Art kannst du am Laternenritual teilnehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130906
					]
				},
				{
					"id": 413130906,
					"content": "Ist das so? Menschliche Motive widerstehen meinen Versuchen, sie zu verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130907
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130907,
					"content": "Weniger verstehen, mehr essen! Komm schon, hau rein, bevor es kalt wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130908,
					"content": "Hmm, na gut. Paimon wird sich nun auf das Essen konzentrieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130909,
					"content": "Jetzt, da wir mit dem wichtigsten Teil der Feier fertig sind, sollten wir nach draußen gehen, um die Mingxiao-Laterne zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130910,
					"content": "Komm mit uns, Xiao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130911
					]
				},
				{
					"id": 413130911,
					"content": "Ihr könnt gehen. Es gibt für mich dort nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130912,
						413130913
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130912,
					"content": "Du kannst uns doch einfach auf dem Weg begleiten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130914
					]
				},
				{
					"id": 413130914,
					"content": "Ja, die Mingxiao-Laterne mag nicht dein Ding sein, aber ... mit Sicherheit kann es nicht schaden, einen Spaziergang mit uns zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130915,
					"content": "Der Weg von hier bis zum Hafen von Liyue ist lang und reich an Gefahren ... Wir benötigen jemanden, der unsere Sicherheit gewährleistet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130916,
					"content": "Niemand sagt, dass ihr die Stadt betreten müsst ... Du kannst uns einfach an den Rändern absetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130917,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130918
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130918,
					"content": "... Hmpf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130919
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130919,
					"content": "So soll es sein. Ich werde euch <color=#00E1FFFF>an den Rändern</color> absetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130920
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130920,
					"content": "Und los geht’s! Na gut, es ist Zeit, uns auf den Weg zu machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130913,
					"content": "O schützender Yaksha, eskortiere uns sicher zur Stadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130914
					]
				},
				{
					"id": 413130905,
					"content": "Beim Laternenritual soll jeder dabei sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130906
					]
				}
			]
		},
		{
			"id": 4131311,
			"completionStepIds": [
				4131311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131311",
							"2"
						],
						"stepId": 4131311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413131101,
					"content": "So weit will ich gehen. Bitte findet den Weg in die Stadt alleine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131102,
						413131104
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131102,
					"content": "Warte einen Moment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131103
					]
				},
				{
					"id": 413131103,
					"content": "Was nun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131105
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131105,
					"content": "Du bist offensichtlich einer der Helden, um die es bei dem Fest geht ... Warum willst du nicht Teil davon sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413131106,
					"content": "Ich ... hasse das Gesindel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131107
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131107,
					"content": "Keine Sorgen in der Welt, so friedlich, so glücklich ... Sie sind kein bisschen wie ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131108
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131108,
					"content": "Zu lange habe ich mit Gemetzel verbracht, begleitet von der Last des Leids, die es nach sich zieht. Auf diese jubilierenden Leute zu treffen, würde mich nur ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131109
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131109,
					"content": "Das ist alles, was ich zu sagen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131110
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131110,
					"content": "Mach’s gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131111
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131111,
					"content": "Bist du sicher, dass du nicht mit uns kommen willst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131112
					]
				},
				{
					"id": 413131112,
					"content": "Stehst du wirklich so sehr auf banale Unterhaltung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131113
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131113,
					"content": "Was denkst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131114
					]
				},
				{
					"id": 413131114,
					"content": "He! Das ist ein legitimes Fest, nicht nur banale Unterhaltung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413131115,
					"content": "Legitim ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131116
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131116,
					"content": "Genug. Seht nach euren Laternen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131117
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131117,
					"content": "Aber bleibt auf der Hut. Haltet eure Augen offen für Bedrohungen. Wenn ihr auf Ärger stoßt ... sprecht meinen Namen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131118
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131118,
					"content": "Bist du dir sicher, dass du es rechtzeitig für die Rettung in die Stadt schaffst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131119
					]
				},
				{
					"id": 413131119,
					"content": "Überall, jederzeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131120
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131120,
					"content": "Ob von euch oder von Liyue. Ich höre alle Schreie nach Hilfe, alle Gebete für Frieden und alle Wünsche, die von den Laternen getragen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131104,
					"content": "(... egal, wir können es von hier sehen.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131105
					]
				}
			]
		},
