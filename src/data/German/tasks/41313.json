			"dialogs": [
				{
					"id": 413135101,
					"content": "Wenn dieses kurzlebige Spektakel eines ist, dem ihr beiwohnen möchtet, schlage ich vor, dass ihr zur Stadt geht. Ich für meinen Teil habe kein Interesse am Laternenritual.",
					"roleType": "TALK_ROLE_NPC",
