			},
			"dialogs": [
				{
					"id": 732790201,
					"content": "Hast du sie gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790202
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790202,
					"content": "Ah, ich verstehe, du brauchst noch etwas Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790203
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790203,
					"content": "Bitte findest du sie so schnell wie möglich. Die Zeit ist nicht auf unserer Seite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				}
			]
		},
		{
			"id": 7327904,
			"completionStepIds": [
				7327904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7327904",
							"2"
