					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tadhla",
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790601,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790602
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790602,
					"content": "Hallo, du bist Tadhla, oder? Wir sind hier, um dich rauszuholen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790603,
					"content": "Hm? ... Klar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790604
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790604,
					"content": "Du lässt sie gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790605,
						732790606
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790605,
					"content": "Sie stellen keine Bedrohung mehr dar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				},
				{
					"id": 732790607,
					"content": "... Sie werden zurückgehen und die anderen warnen. Bald werden sie alle wissen, dass wir hier sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790608
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790608,
					"content": "Ha, die Weisen denken ähnlich. Ich mag dieses Mädchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790609
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790609,
					"content": "Keine Sorge! Wenn sie zurückkommen, treten wir ihnen einfach wieder in den Hintern! Aber ... du bist verletzt. Brauchst du Hilfe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790610,
					"content": "In Ordnung. Ich kann immer noch laufen und mir einen Ort suchen, um in Frieden zu sterben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790611
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790611,
					"content": "Oh, sie ist noch in Ordnung, sie kann immer noch einen Ort suchen, um ... He! Wovon redest du?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790612,
					"content": "Nur ein Scherz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790613
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790613,
					"content": "Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790614
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790614,
					"content": "Ich mag den Humor dieses Mädchens ... Wie geschickt sie den Witz in das Gespräch einfließen lässt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790615
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790615,
					"content": "Ich danke euch. Gehen wir zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790616,
						732790618
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790616,
					"content": "Fällt es dir schwer, zu gehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790617
					]
				},
				{
					"id": 732790617,
					"content": "Ja, aber ich brauche keine Stütze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790618,
					"content": "Willst du dich nicht eine Weile ausruhen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790619
					]
				},
				{
					"id": 732790619,
					"content": "Ausruhen? Nein, wir kennen uns kaum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790620
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790620,
					"content": "Dann sollten wir uns vielleicht näher kennenlernen. Was sagst du dazu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790621
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790621,
					"content": "Danke, aber später.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790606,
					"content": "Wir brauchen sie nicht zu töten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				}
			]
		},
		{
			"id": 7327907,
			"completionStepIds": [
				7327907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7327907",
							"2"
						],
						"stepId": 7327907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Masseira",
					"Tadhla",
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790701,
					"content": "Ah, hier ist mein kleiner Falke! Ich danke euch vielmals!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790702
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790702,
					"content": "Entschuldigung ... Ich wurde überfallen. Es ist ihnen zu verdanken, dass ich zurückkehren kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790703
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790703,
					"content": "#... „Ihnen“? {F#Sie}{M#Er} ist {M#unser verehrter „Herr des Dschinn“}{F#unsere verehrte „Herrin des Dschinn“}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790704
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790704,
					"content": "Verzeihung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790705
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790705,
					"content": "Ach komm schon, ist schon gut! Tadhla ist verletzt, sei nett zu ihr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790706,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790707
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790707,
					"content": "... Du bist verletzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790708
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790708,
					"content": "... Es tut mir leid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790709
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790709,
					"content": "Welches Tier hat dir das angetan? Oder war es ein Mensch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790710
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790710,
					"content": "Es waren die Nordleute. Sie haben mich aus dem Hinterhalt überfallen ... Als sie merkten, dass sie verfolgt wurden, legten sie einen Hinterhalt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790711
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790711,
					"content": "Du hättest den Hinterhalt legen sollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790712
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790712,
					"content": "Von der Beute angegriffen zu werden. Was für eine Schande für einen Jagdfalken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790713
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790713,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790714
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790714,
					"content": "... Geh und ruhe dich aus. Ich werde mich später um deine Wunde kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790715
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790715,
					"content": "Tadhla nickt stumm und geht trotz ihrer Schmerzen langsam weg.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732790716
					]
				},
				{
					"id": 732790716,
					"content": "Masseira ist wirklich ein bisschen zu streng mit Tadhla ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790717,
						732790720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790717,
					"content": "Kommt ihr beide nicht miteinander aus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790718
					]
				},
				{
					"id": 732790718,
					"content": "Oh? Nein, auf keinen Fall! Sie ist mein Lieblingsfalke ... Ich liebe sie, aber ich verwöhne sie nicht. Wie kann man einen Falken satt füttern, wenn er mit leeren Händen zurückkommt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790719
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790719,
					"content": "Ach so ... Hmpf, dieses Mädchen wird nicht gut ausgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790723
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790723,
					"content": "#Bitte nimm diese Belohnung an. Du hast meine Dankbarkeit, {M#verehrter Herr}{F#verehrte Herrin} des Dschinn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790724
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790724,
					"content": "Ähem, hast du etwas vergessen? Es gibt noch zwei weitere Menschen hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790725
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790725,
					"content": "Hehe, Paimon denkt, dass einer von uns nicht wirklich als „Mensch“ bezeichnet werden kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790726,
					"content": "Oh, stimmt, dieses kleine Wesen ist kein Mensch. Aber trotzdem haben auch wir deinen Dank verdient, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790727
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790727,
					"content": "He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790728,
					"content": "Haha, ich bitte um Entschuldigung. Bitte nehmt dies als eine zusätzliche Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790729
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790729,
					"content": "Ooh, zusätzliche Belohnung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790730,
					"content": "#... Immer noch weniger als erwartet. Aber ich werde sie annehmen, wenn du nichts dagegen hast, {F#meine Herrin}{M#mein Herr}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790731
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790731,
					"content": "Also gut. Ah ... Wenn du in Zukunft Zeit hast, komm bitte noch einmal wieder. Ich glaube, mein Jagdfalke wird bis dahin deine Hilfe brauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790720,
					"content": "Sei bitte nicht zu streng zu ihr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790721
					]
				},
				{
					"id": 732790721,
					"content": "Streng? Nein, stattdessen war ich zu nett zu ihr. Deshalb ist sie so ungeschickt geworden. Alles, was ich tue, ist sie zu erziehen. Sie ist ein hervorragender „Jagdfalke“. Wie könnte ich sie je verletzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790722
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790722,
					"content": "Und ... wie sieht das endgültige Schicksal eines Jagdfalken aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790723
					],
					"speakerTitle": "Liloupar"
				}
			]
		}
	]
}