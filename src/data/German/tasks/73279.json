			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Masseira",
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790101,
					"content": "#Ah, {NICKNAME}, {M#verehrter Herr}{F#verehrte Herrin} des Dschinn. Was verschafft mir die Ehre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790102
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790102,
					"content": "#Gut, noch ein Wüstenlakai. {F#Meine Herrin}{M#Mein Herr}, ich ... *seufz* Vergiss es. Ich vertraue deinem Urteil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790103
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790103,
					"content": "Hättest du eine Minute Zeit für mich? Ich freue mich auf deine Ankunft so sehr wie auf den Mond und den Regen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790104
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790104,
					"content": "Lass uns nicht an deiner Absicht zweifeln. Bringe es einfach auf den Punkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790105
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790105,
					"content": "Natürlich, verehrter Dschinn ... Ich habe eine Bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790106
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790106,
					"content": "Es ist nichts Ernstes, haha ... Mein Jagdfalke, Tadhla, ich glaube, sie ist in Gefahr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790107
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790107,
					"content": "*seufz* Wenn ich nicht so schwache Beine hätte, würde ich dich damit nicht belästigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790108
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790108,
					"content": "Paimon versteht. Wir werden sie also retten, und dann bedankst du dich bei uns, gibst uns viele Mora und lädst uns zu einem großen Essen ein, um unseren Triumph zu feiern, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790109,
					"content": "Ähm ... Ja, genau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790110
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790110,
					"content": "Nun, wenn das der Fall ist, dann machen wir es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790111,
					"content": "Paimon wird immer besonders logisch, wenn es um solche Situationen geht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790112
					]
				},
				{
					"id": 732790112,
					"content": "*seufz* Na gut, dann machen wir das eben für Paimons großes Essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790113
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790113,
					"content": "Vielen Dank ... Ich zähle auf euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790114
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790114,
					"content": "Ah ... Lasst mich den Ort markieren, an dem sie zuletzt auftauchte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790115
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790115,
					"content": "Tadhla, nach der ihr suchen müsst, ist groß, braungebrannt, hat helles, langes Haar und benutzt einen Langbogen. Ja, das sollten genug Informationen über sie sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790116
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790116,
					"content": "So, habt ihr alles mitbekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790117
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790117,
					"content": "Hmm ... Ein großes, braungebranntes Mädchen mit hellem, langem Haar, das einen Langbogen hält! Hehe, Paimon hat ein ausgezeichnetes Gedächtnis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790118,
					"content": "Gut ... Möge die wehenden Winde euch durch die Sandstürme und weg von der Gefahr führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790119
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790119,
					"content": "Danke. Dann gehen wir jetzt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7327902,
