			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Doolan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200470101,
					"content": "Bei Abenteuern läuft nie alles glatt. Wenn du weiter so lange brauchst, wirst du keine Fortschritte machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470102
					],
					"speakerTitle": "Neugierige Patchi"
				},
				{
					"id": 200470102,
					"content": "Selbst wenn der Plan nicht perfekt ist, sollten wir uns immer noch auf alle Eventualitäten vorbereiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470103
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470103,
					"content": "Worüber streitet ihr euch denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470104
					]
				},
				{
					"id": 200470104,
					"content": "Ach, wir sind dabei, das Innere des <color=#00E1FFFF>Tempels der Tausend Winde</color> zu erkunden. Patchi hat aber leider keinerlei Erfahrung von Abenteuern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470105
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470105,
					"content": "Den Tempel der Tausend Winde durchstreifen viele böse Ungeheuer und dann ist da noch dieser schreckliche Ruinenwächter ... Wenn wir einfach so hineinstürmen, setzen wir unser Leben aufs Spiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470106
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470106,
					"content": "Das wäre viel zu gefährlich für Patchi ... also für uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470107
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470107,
					"content": "Ich bin gerade dabei, sie zu überreden, einen idiotensicheren Plan auszuarbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470108
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470108,
					"content": "Sobald ich mich aber in der Gegend umsehe, will Patchi auch gleich in den Tempel laufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470109
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470109,
					"content": "Ich muss hier auf sie aufpassen. Könntest du dich vielleicht ein wenig für uns umsehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470110,
						200470113
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470110,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470111
					]
				},
				{
					"id": 200470111,
					"content": "Sehr gut. Sei bitte gründlich. Jedes Detail könnte über unseren Erfolg entscheiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470112
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470112,
					"content": "Egal was du findest, bring es mir einfach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470113,
					"content": "Dann pass ich mal weiter auf Hilf Patchi auf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470114
					]
				},
				{
					"id": 200470114,
					"content": "Ach, nein, so geht das auch nicht! Im alten Plan gibt es viele Details, über die ich sie noch informieren muss ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470115
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470115,
					"content": "Such bitte schnell nach Hinweisen, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
		},
