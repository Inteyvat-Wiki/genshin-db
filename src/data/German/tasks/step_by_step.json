			"dialogs": [
				{
					"id": 200470301,
					"content": "Irgendwelche Spuren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470302
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470302,
					"content": "Ich habe das hier gefunden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470303
					]
				},
				{
					"id": 200470303,
					"content": "Ah, so ist das also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470304
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470304,
					"content": "Ja, ganz genau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470305
					]
				},
				{
					"id": 200470305,
					"content": "Das sind nützliche Hinweise, danke dir! Dafür geb ich dir das hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470306
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470306,
					"content": "Patchi! Ich habe einen neuen Plan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
		}
