			"dialogs": [
				{
					"id": 715100101,
					"content": "Funktioniert der „Pursina-Lichtnagel“ gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100102,
						715100103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100102,
					"content": "Geschafft.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715100104
					]
				},
				{
					"id": 715100104,
					"content": "Gut, gut. Obwohl der „Pursina-Lichtnagel“ nicht alle Austrittspunkte auf einmal versiegeln kann, kann er weiterarbeiten, sobald es ihm ein einziges Mal gelungen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100105,
					"content": "So ist es nur eine Frage der Zeit, bis alle Austrittspunkte geschlossen sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100106,
					"content": "Dieses Problem ist endlich gelöst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100107,
					"content": "Ich glaube, ich muss das aufschreiben, und wenn der vollständige Forschungsbericht über den „Pursina-Lichtnagel“ vorgelegt wird, werde ich vielleicht ein neuer Star an der Akademie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100108,
					"content": "#Nun, das könnte in meiner zukünftigen Autobiografie stehen: „Ich habe ein Experiment mit {F#der}{M#dem} hervorragend ausgebildeten {NICKNAME} in der Großen Kluft durchgeführt ...“ Das schreibe ich auf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100109,
					"content": "Dann werde ich auf diesen Tag warten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715100110
					]
				},
				{
					"id": 715100110,
					"content": "Haha, ich bin zwar sehr gut darin, wissenschaftliche Arbeiten zu schreiben, aber nicht unbedingt darin, Biografien und Geschichten zu schreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100111,
					"content": "Ich hoffe, das macht dir nichts aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100103,
					"content": "Der größte Teil des schwarzen Schlamms wurde beseitigt.",
					"roleType": "TALK_ROLE_PLAYER",
