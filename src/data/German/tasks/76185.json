			"dialogs": [
				{
					"id": 761850201,
					"content": "Tee schmeckt so viel besser, wenn man dazu nützliche Informationen bekommt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850202,
						761850203
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850202,
					"content": "(Lass uns noch ein Weilchen so sitzen bleiben.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850204,
					"content": "Oh, pass auf dich auf. Und denk daran, mal vorbeizuschauen, wenn du Zeit hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850203,
					"content": "Ich glaube, es wird Zeit, dass ich mit dem Aufräumen anfange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
