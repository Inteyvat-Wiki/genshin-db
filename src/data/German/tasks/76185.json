			"dialogs": [
				{
					"id": 761850101,
					"content": "Mm, köstlicher Tee und leckere Snacks. Danke für deine Gastfreundschaft, Fräulein Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850102
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850102,
					"content": "Freut mich, dass es dir schmeckt. Ich habe auch ein paar Leckerlis für Ashru mitgebracht. Stimmt’s, Ashru? Komm her. Braves Kätzchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850103,
					"content": "Miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850104
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850104,
					"content": "Ich hoffe, dass sich deine Sympathie für Nod-Krai und das Kuratorium der Geheimnisse als nützlich für unsere zukünftige Zusammenarbeit erweisen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850105,
					"content": "Das hoffe ich auch. Hier, Ashru, probier mal eins davon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850106,
					"content": "Übrigens, wegen der Sache, nach der ich vorhin gefragt hatte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850107,
					"content": "Haha, deine kleinen Pfoten sind so weich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850109,
					"content": "Fräulein Sandrone ... Sag mir nicht, du hast diese Teegesellschaft als Vorwand genutzt, hierherzukommen und meine Katze zu verwöhnen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850110,
					"content": "Häh ...? I... Ich? Würde ich nie tun! Ich nehme meine Angelegenheiten mit dem Kuratorium der Geheimnisse sehr ernst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850111,
					"content": "Ashru, komm her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850112,
					"content": "Miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850113
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850113,
					"content": "Ahh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850114,
					"content": "Dann lass uns mal über die Details unserer „Geschäfte“ reden, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850115
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850115,
					"content": "... Hmpf. A... Also, was ist schon dabei, wenn ich Ashru streicheln will... Wer würde das nicht wollen?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850116,
					"content": "Kleine Tiere sind Maschinen gegenüber meistens misstrauisch. Es hat viel Arbeit gekostet, dass Ashru mir vertraut, als ich hier am arithmetischen Feld gearbeitet habe. Was ist denn so schlimm daran, dass ich ihm ein bisschen den Bauch kraulen möchte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850117
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850117,
					"content": "Hah ... Du musst ja nicht gleich so defensiv werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850118
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850118,
					"content": "Na los, Ashru. Es steht mir schließlich nicht zu, dir zu sagen, an wem du dich reiben darfst und an wem nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850119,
					"content": "Miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850120
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850120,
					"content": "Aber wenn du ihn fertig gestreichelt hast, vergiss nicht, dass wir noch Geschäftliches zu besprechen haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850121
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850121,
					"content": "Wie ich dir schon gesagt habe, nehme ich unsere Geschäfte sehr ernst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
