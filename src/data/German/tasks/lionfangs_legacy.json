			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101121001,
					"content": "Leute, vielen Dank! Ich kann nicht fassen, dass wir sie wirklich gefunden haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121002
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101121002,
					"content": "Mama! Papa! Seht euch die legendären Waffen an, die ich gefunden haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121003
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101121003,
					"content": "He, warte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121004
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121004,
					"content": "Der Wein, den du versprochen hast! Urgh, und ich habe dieses Mal wirklich viel geholfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121005
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121005,
					"content": "Hmm? Was machst du hier, Stanley? Gehst du spazieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121006
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121006,
					"content": "Ah ... haha, ah! He! Was machst du hier, Barde? Stell dir vor, hm? Machst du ... äh auch einen Spaziergang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121007
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121007,
					"content": "Genau, einen Verdauungsspaziergang nach dem Abendessen, um genau zu sein. Und wir haben einem Freund geholfen, nach etwas zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121008
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121008,
					"content": "(Paimon denkt ernsthaft, Stanley könnte ein Betrüger sein ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121009,
						101121010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121009,
					"content": "(Ich glaube das mittlerweile auch.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101121011
					]
				},
				{
					"id": 101121011,
					"content": "(Hat Stanley das Schwert und den Schild hier im Voraus deponiert, um Jacks Gefühle nicht zu verletzen?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121012,
					"content": "Abenteurer müssen doch mit der Dadaupa-Schlucht ziemlich vertraut sein? Du hast hier schließlich schon einmal gekämpft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121013
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121013,
					"content": "Ich denke schon ... Ich könnte mich hier mit verbundenen Augen zurechtfinden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121014
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121014,
					"content": "Ach so. Dann bewundere ich deine Ausdauer und dein Gedächtnis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121015
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121015,
					"content": "Das ist von einem großen Abenteurer wie mir nur zu erwarten! Ihr solltet aber besser aufpassen. An diesem Ort wimmelt es nur so von Hilichurlen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121016
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121016,
					"content": "Ich, äh ... Ich setze mal meinen, ähm ... äh ... Spaziergang fort. Lebt wohl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121017
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121017,
					"content": "Na? Schlechtes Gewissen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121018,
					"content": "Nun, er hätte sich nicht so dazu hinreißen sollen, vor Jack anzugeben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121019
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121019,
					"content": "Obwohl ich nach genauerer Überlegung sagen muss, dass ich ziemlich fasziniert bin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121020
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121020,
					"content": "Jemand, der die Vergangenheit nicht loslassen kann und stattdessen die Gegenwart aufgibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121021
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121021,
					"content": "Ich frage mich ... welchen Weg sie gehen würde, wenn so eine Person dazu gezwungen wäre, den ersten Schritt in die Zukunft zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121022
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121022,
					"content": "Hm? Was meinst du damit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121023
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121023,
					"content": "Haha, ich grübele nur vor mich hin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121024
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121024,
					"content": "#Wie dem auch sei, {NICKNAME}, ich schlage vor, dass wir heute Abend einen Ausflug zur <color=#00E1FFFF>Engelsgabe</color> machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121010,
					"content": "(Er ist definitiv ein Betrüger. Keine Frage.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101121011
					]
				}
			]
		},
