				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101120401,
					"content": "Aha. Seht da, das <color=#00E1FFFF>Schwert des Heldenmuts</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120402,
					"content": "Bist du dir sicher? Für Paimon sieht das irgendwie einfach aus und auch etwas abgenutzt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120403,
					"content": "Wieso sollten sich Hilichurle vor einem Stück Schrott wie dem verneigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120404,
					"content": "(Oh ... Es sieht so aus, als hätte jemand ein altes Schwert auf einen Haufen Beute geworfen, um den diese Hilichurle jetzt kreisen ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120405,
					"content": "Das ist ja total alt Und es ist so schlicht. Ich ... Ich bin sprachlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120406,
					"content": "Hmm ... sag mal, Jack, hast du schon mal einen Anemo-Kristallschmetterling gesehen? Man kann sie im Umland von Mondstadt finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120407,
					"content": "Wenn du eine am hellichten Tag sehen würdest, würdest du sie keines Blickes würdigen. Aber in der finsteren Schwärze der Nacht? Ihr strahlender Schein ist faszinierend. Sie sieht wahrhaftig aus, wie ein exquisiter Kristall, der durch die nächtliche Luft tanzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120408,
					"content": "Ist es mit Heldenmut nicht auch so? Wenn alles zu deinen Gunsten läuft, scheint er bedeutungslos und verschwindet im Hintergrund. Aber wenn du in der Klemme steckst, ist Heldenmut die Sache, die dich anfeuert und zurückschlagen lässt. Er ist der helle Lichtstrahl, der dich aus der Dunkelheit führt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120409,
						101120410,
						101120411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120409,
					"content": "Das war sehr kunstvoller Unsinn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				},
				{
					"id": 101120412,
					"content": "Du hast recht ... Du hast recht! Dann muss das das Schwert des Heldenmuts sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120413
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120413,
					"content": "Hmm. Also haben wir unser Schwert, jetzt brauchen wir nur noch diesen Schild!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120414,
					"content": "Sehen wir uns um! Er ist auf jeden Fall in der <color=#00E1FFFF>Dadaupa-Schlucht</color>, einige – hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120415
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120415,
					"content": "Da ist jemand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120416,
					"content": "Stanley? Was macht er hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120417,
					"content": "Er benimmt sich so seltsam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120418,
					"content": "Was denn? Warum hast du plötzlich angehalten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120419
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120419,
					"content": "Was ist denn nur los? Oh, ah, es ist nichts. Da ist nur einer dieser Mora speienden Schatzmarder vorbeigekommen, nichts weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120420,
					"content": "Was? Wie, bei Vennessa? Ich will ihn sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120421
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120421,
					"content": "Vielleicht ein anderes Mal. Wir müssen einen Schild finden, erinnerst du dich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120410,
					"content": "Das ist beeindruckend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				},
				{
					"id": 101120411,
					"content": "Ich bin beinahe selbst darauf reingefallen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				}
			]
		},
		{
			"id": 1011206,
			"completionStepIds": [
				1011206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
