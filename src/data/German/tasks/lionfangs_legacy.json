			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hilichurl"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101120601,
					"content": "Seht da, der <color=#00E1FFFF>Schild des Siegeswillens</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120602,
					"content": "Du Lügner! Das ist ein Stück Holz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120603,
					"content": "Ein Stück Holz mit einem Griff ... Wer, der noch bei klarem Verstand ist, würde das als Schild benutzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120604,
					"content": "Außerdem sind da Weinflecken drauf ... Ja, ich bin mir ziemlich sicher, dass das einfach von einem Weinfass abgenommen wurde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120605
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120605,
					"content": "Und doch sagt mir meine Intuition als Barde, dass das nichts Geringeres als der Schild des Siegeswillens ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120606
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120606,
					"content": "Krieger tragen ihre Kampfnarben mit Stolz und Schilde sind da nicht anders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120607,
					"content": "Sicher, ein intakter Schild ist einer, der vor dem Schlachtfeld zurückgewichen ist. Ist nicht der zerbrochene und zersplitterte Schild derjenige, der in unzähligen Kriegen gekämpft und überlebt hat, um die Geschichte davon zu erzählen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120608,
					"content": "Obwohl der Körper des Soldaten müde und zerrissen ist, kämpfen sie bis zum Ende, bis kein Blut mehr übrig ist. Solch großartige Willensstärke ... ist das nicht die wahre Bedeutung von Ehre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120609,
						101120610,
						101120611
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120609,
					"content": "Ich stimme Venti zu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				},
				{
					"id": 101120612,
					"content": "Da hast du recht ... Glänzende neue Schilde bleiben nicht lange neu und glänzend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120613,
					"content": "In Ordnung ... Nun, vielleicht lässt er uns den Schild des Siegeswillens umsonst mitnehmen, wenn wir nett fragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120614,
					"content": "*räusper* Entschuldigung, Herr Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120615,
					"content": "Dala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120616
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120616,
					"content": "#Tja! Dann übernimmst du ab hier, {NICKNAME}! Ich hoffe, du hast inzwischen etwas Hilichurlisch aufgeschnappt. Wenn nicht, gibt es immer noch Körpersprache ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120617,
						101120618,
						101120619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120617,
					"content": "Ich zahle gute Mora für den Schild.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120622
					]
				},
				{
					"id": 101120622,
					"content": "Biadam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120623
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120623,
					"content": "Puh ... Das scheint ihm <color=#00E1FFFF>nicht gefallen zu haben</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120624,
						101120625,
						101120626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120624,
					"content": "Bitte nimm diese süße Blume, die ich gepflückt habe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120627
					]
				},
				{
					"id": 101120627,
					"content": "Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120628
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120628,
					"content": "Scheint <color=#00E1FFFF>gut gelaunt</color> genug zu sein. Vielleicht könnte Verhandeln doch funktionieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120631,
						101120633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120631,
					"content": "Venti singt Lied, du gibst Schild, ja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120632
					]
				},
				{
					"id": 101120632,
					"content": "Wie? Na gut, ich werde ein kleines Liedchen spielen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120634
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120634,
					"content": "Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120635
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120635,
					"content": "Scheint <color=#00E1FFFF>gut gelaunt</color> genug zu sein. Vielleicht könnte Verhandeln doch funktionieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120633,
					"content": "Mani nini Biaodomu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120636
					]
				},
				{
					"id": 101120636,
					"content": "Biadam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120637
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120637,
					"content": "Puh ... Das scheint ihm <color=#00E1FFFF>nicht gefallen zu haben</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120625,
					"content": "Bitte nimm diese Hilichurl-Maske, die ich gesammelt habe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120629
					]
				},
				{
					"id": 101120629,
					"content": "Biadam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120630
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120630,
					"content": "Puh ... Das scheint ihm <color=#00E1FFFF>nicht gefallen zu haben</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120631,
						101120633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120626,
					"content": "Kucha pupu gusha ye!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120629
					]
				},
				{
					"id": 101120618,
					"content": "Könnte ich den Schild bitte haben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120622
					]
				},
				{
					"id": 101120619,
					"content": "Vin plata dada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120620
					]
				},
				{
					"id": 101120620,
					"content": "Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120621
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120621,
					"content": "Scheint <color=#00E1FFFF>gut gelaunt</color> genug zu sein. Vielleicht könnte Verhandeln doch funktionieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120624,
						101120625,
						101120626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120610,
					"content": "Ja, das muss der Schild sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				},
				{
					"id": 101120611,
					"content": "Venti ist heute in Topform.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				}
			]
		},
