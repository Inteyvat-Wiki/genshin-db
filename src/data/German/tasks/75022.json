			"dialogs": [
				{
					"id": 750220703,
					"content": "Der Yumkasaurier verschlingt das vor ihm liegende Essen in Windeseile.\\nDu hast nicht einmal gesehen, wie er den Mund aufmachte.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750220304,
					"content": "Boah! Er kann wirklich viel essen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220305,
						750220307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220305,
					"content": "Paimon, jetzt hast du einen Konkurrenten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220306
					]
				},
				{
					"id": 750220307,
					"content": "Eine Portion ... scheint nicht genug zu sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220308
					]
				},
				{
					"id": 750220306,
					"content": "Was soll das denn heißen?! Paimon hat einen guten Geschmack, was Essen angeht! Wenn man das Essen einfach so hinunterwürgt, kann man nicht einmal sagen, wie es geschmeckt hat, wenn man es aufgegessen hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220308,
					"content": "#J... Ja ... Wer hätte gedacht, dass dieser Saurier so einen riesigen Bauch hat! Zum Glück frisst {REALNAME[ID(2)|SHOWHOST(true)]} nicht so viel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220309,
					"content": "Aber Paimon kann sehen, dass er wirklich hungrig ist ... Lass uns ihm noch eine Portion servieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220310,
					"content": "*brüll*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220311,
					"content": "#Oh, willst du auch etwas essen, {REALNAME[ID(2)|SHOWHOST(true)]}? Keine Sorge, wir werden dir auch etwas Leckeres servieren, sobald wir den großen Saurier gefüttert haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220312,
					"content": "Der hungrige Saurier verschlingt alles, was ihm vor die Nase kommt, in einem einzigen Zug.\\nDu blinzelst und denkst, du hättest ein Déjà-vu.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220313
					]
				},
				{
					"id": 750220313,
					"content": "Jetzt muss er satt sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220314,
					"content": "... He! Warum setzt du dich wieder hin? Sag Paimon nicht, dass zwei Portionen nicht genug sind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220315,
					"content": "Ach! Er fängt an zu schlafen, sobald er satt ist! Er scheint überhaupt nicht daran interessiert zu sein, aus dem Weg zu gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220316,
					"content": "#Was sollen wir nun tun, {NICKNAME}? Paimon versteht den Kerl einfach nicht ... Selbst wenn er nach dem Essen ein Nickerchen machen muss, dann wenigstens nicht am Eingang der Höhle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220317,
						750220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220317,
					"content": "Nun, er hat nie zugestimmt, aus dem Weg zu gehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220318,
					"content": "Wurden wir betrogen ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220319,
					"content": "Argh, Paimon ist so wütend! Er hat so viel von unserem Essen gegessen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220320,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220321,
					"content": "#Sogar {REALNAME[ID(2)|SHOWHOST(true)]} ist das zu viel, {NICKNAME}, lass uns versuchen, ob wir ihn aufwecken können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
