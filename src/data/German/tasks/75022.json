			"dialogs": [
				{
					"id": 750220606,
					"content": "Was habt ihr gemurmelt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220607,
					"content": "*grummel*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220608
					],
					"speakerTitle": "Seltsamer Yumkasaurier"
				},
				{
					"id": 750220608,
					"content": "Oh, ist er hungrig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220609,
					"content": "Er ist ganz allein hier und sein Meister ist nicht in der Nähe ... Wahrscheinlich weiß er nicht einmal, wie er sein eigenes Futter finden soll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220610,
					"content": "#{NICKNAME}, lass uns ihn füttern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220611,
					"content": "Wenn er satt ist, wird er brav aus dem Weg gehen und dann gehört der Schatz ganz uns! Hehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220612,
					"content": "Womit sollen wir ihn füttern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220613
					]
				},
				{
					"id": 750220613,
					"content": "Hm, die Saurier in Natlan scheinen so ziemlich alles zu fressen ... Paimon hat keine Ahnung, was ein Yumkasaurier bevorzugen würde. Aber seiner Farbe nach zu urteilen ... vielleicht Gräser oder Blätter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220614,
					"content": "Lass uns welche finden und sehen, ob er sie mag. Normalerweise ist man nicht allzu wählerisch, wenn man Hunger hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
