			"dialogs": [
				{
					"id": 750220801,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220802
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220802,
					"content": "Hehe, gut gemacht! Mal sehen, was sich in der Truhe verbirgt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220803,
					"content": "Was? Da gibt es gar nichts? Nur eine Notiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220804,
					"content": "Oh, also ist derjenige, der die Notiz hinterlassen hat, sein Meister? Wir wurden also nicht vom Saurier ausgetrickst, sondern von seinem Meister?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220805,
						750220808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220805,
					"content": "Er hat überhaupt kein Verantwortungsbewusstsein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220806
					]
				},
				{
					"id": 750220806,
					"content": "Ja, er kann seinen Yumkasaurier nicht einfach so hier lassen! Krankheit ist keine gültige Ausrede!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220807,
					"content": "Und er hat sogar unsere Gier ... ähem, unser Mitgefühl ausgenutzt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220810,
					"content": "*seufz* Jedenfalls können wir ihn nicht einfach hier lassen und ihn darauf warten lassen, dass Passanten ihn füttern. Lass uns den Häuptling der Nachkommen der Baumkrone suchen und ihm davon erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220811,
					"content": "Du unterrichtest den Häuptling Wayna der „Nachkommen der Baumkrone“ über diesen Vorfall und führst ihn hin.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220812
					]
				},
				{
					"id": 750220812,
					"content": "Oh weh, als ihr mich vorhin aufgesucht habt, beschlich mich bereits eine Vorahnung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220813
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220813,
					"content": "Ich hätte nicht gedacht, dass „er“ es war, der den Saurier zurückgelassen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220814
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220814,
					"content": "„Er“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220815
					]
				},
				{
					"id": 750220815,
					"content": "*brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220816
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220816,
					"content": "Er hat einen Fehler gemacht und aus Angst vor Bestrafung freiwillig den Stamm verlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220817
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220817,
					"content": "Dennoch, der Name des Sünders wird hier nicht weiter erwähnt. Womöglich wusste er selbst, dass so etwas nichts Ruhmreiches an sich hat. Sieh, er hat nicht mal seinen Namen auf diesem Brief hinterlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220818
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220818,
					"content": "Es ist also so, dass sein Saurier sich dazu entschied, mit ihm zu gehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220819
					]
				},
				{
					"id": 750220819,
					"content": "Nein, man kann es nicht als Entscheidung bezeichnen. Saurier sind reine Wesen, die nicht gut darin sind, zwischen richtig und falsch zu unterscheiden. Meistens folgen sie ihren Gefühlen und vertrauen auf ihre Gefährten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220820
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220820,
					"content": "... Wie zu erwarten, blieb er seiner Natur treu und nutzte seine Schlauheit dazu, andere zu täuschen. Mit seinen Mitteln täuschte er nicht nur andere, sondern auch seinen eigenen Saurier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220821
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220821,
					"content": "Wir werden jemanden schicken, um diesen Yumkasaurier regelmäßig füttern zu lassen, schließlich ist er ein Kind des Stammes ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220822
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220822,
					"content": "Was diesen Typen angeht ... Ach, es ist ein wahrlich tragisches Ende, aber ich werde ihm kein Mitleid schenken. Jeder sollte Verantwortung für sein eigenes Handeln übernehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220808,
					"content": "Man wird also wirklich im Stich gelassen, wenn man zu viel isst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220809
					]
				},
				{
					"id": 750220809,
					"content": "He! Mach doch keine solchen Witze! Außerdem ist er völlig unschuldig an der ganzen Sache ... Vielleicht wartet er hier nur auf die Rückkehr seines Meisters und deshalb weigert er sich, sich zu bewegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "Paimon"
				}
			]
		},
