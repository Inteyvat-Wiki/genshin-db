					"Yasuhiko Tarou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726860101,
					"content": "Darf ich nach deinem Namen fragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860102
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860102,
					"content": "#Ich bin {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860103
					]
				},
				{
					"id": 726860103,
					"content": "Gut, ich habe es mir gemerkt. Darf ich fragen, ob du bereit bist, deine Ehre als Krieger zu wagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860104,
						726860105
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860104,
					"content": "Warte, was?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860106
					]
				},
				{
					"id": 726860106,
					"content": "Bist du nicht ein Krieger, der gekommen ist, um an diesem Wettkampf teilzunehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860107
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860107,
					"content": "Davon habe ich noch nichts gehört.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860108
					]
				},
				{
					"id": 726860108,
					"content": "Hast du noch nie vom „Kampf der einsamen Klingen“ gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860109
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860109,
					"content": "Das kann nicht sein, ich hatte Aushänge ausgehangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860110
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860110,
					"content": "Wo hast du sie ausgehängt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726860111,
					"content": "Hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860112
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860112,
					"content": "Es ist sinnlos, hier Aushänge auszuhängen! Niemand wird davon erfahren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726860113,
					"content": "Hmpf! Das ist alles die Schuld der Yashiro-Verwaltung mit ihrem „Keine Waffen oder Kämpfe während des Irodori-Fests“-Quatsch. Ich habe mich beworben, um Duelle auf Ritou zu organisieren, aber sie haben es abgelehnt und mir auch nicht erlaubt, dafür zu werben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860114
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860114,
					"content": "Also konnte ich die Arena nur hier aufstellen und das Aushängeschild in der Nähe platzieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860115
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860115,
					"content": "Allerdings haben wir bereits vier Bewerber. Wenn wir dich mitzählen, sind es fünf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860116
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860116,
					"content": "#Hm, also sind die Leute tatsächlich beigetreten. Das ist seltsam. Apropos, Paimon weiß auch nicht mehr genau, warum du hierhergekommen bist, {NICKNAME} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726860117,
					"content": "So wie ich das sehe, konntest du diesen Ort ohne vorherige Hinweise finden. Das muss bedeuten, dass du in der Tat ein Krieger mit einem beeindruckenden Geist bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860118
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860118,
					"content": "Diejenigen, die sich nach kämpferischen Fähigkeiten sehnen, werden sich immer zueinander hingezogen fühlen. Das ist der Lauf der Welt ... und es gibt wenig Grund, überrascht zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860119
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860119,
					"content": "Paimon hat keine Ahnung, in welcher Welt du lebst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726860120,
					"content": "Haha, aber wärst du trotzdem bereit, mitzumachen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860121
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860121,
					"content": "Wenn du jeden der vier Herausforderer besiegen kannst, erhältst du natürlich eine Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860122
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860122,
					"content": "Ich werde es mir überlegen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860123
					]
				},
				{
					"id": 726860123,
					"content": "Dann nimm dir bitte Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860105,
					"content": "Oh nein, nein, einen schönen Tag noch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860106
					]
				}
			]
		}
	]
}