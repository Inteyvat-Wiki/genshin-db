							8534.72
						],
						"pointId": 9973
					}
				]
			},
			"dialogs": [
				{
					"id": 750761201,
					"content": "Ah, endlich ... Recke aus der Ferne, ohne deine Hilfe wären wir wahrscheinlich schon längst von der dunklen Bedrohung überrannt worden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761202
					],
					"speakerTitle": "Geschwächte Wayob-Verkörperung"
				},
				{
					"id": 750761202,
					"content": "... Einst erlagen die Bewohner dieses Stammes dem trügerischen Zauber des pechschwarzen Feindes, und zahlreiche Nachtseelen fanden sich im Bann des Abgrunds verstrickt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761203
					],
					"speakerTitle": "Geschwächte Wayob-Verkörperung"
				},
				{
					"id": 750761203,
					"content": "An der Stelle, wo das Siegel liegt, wird selbst die Macht der Verkörperung der Nacht Stück für Stück verschlungen ... Dieses Siegel hat die Verbindung zur Außenwelt und zur Quelle des Glaubens des Stammes abgeschnitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761204
					],
					"speakerTitle": "Geschwächte Wayob-Verkörperung"
				},
				{
					"id": 750761204,
					"content": "Nur wenn das Siegel gebrochen wird, haben wir die Kraft zu kämpfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761205
					],
					"speakerTitle": "Geschwächte Wayob-Verkörperung"
				},
				{
					"id": 750761205,
					"content": "Dank dir, Recke aus der Ferne, können die Nachtseelen heimkehren in ihr verschleiertes Traumreich und der finsteren Wucherung entgehen, die das Reich des Herrschers der Nacht, bedroht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761206
					],
					"speakerTitle": "Geschwächte Wayob-Verkörperung"
				},
				{
					"id": 750761206,
					"content": "Ach, wie lang ersehnt ... wir können zurückkehren in die friedvolle Stille der nächtlichen Gefilde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Geschwächte Wayob-Verkörperung"
				}
			]
		}
	]
}