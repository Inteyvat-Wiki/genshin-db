			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sakaw"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750760401,
					"content": "Der Nebel über dem Meer verdichtet sich zusehends ... Das erfüllt mich mit Sorge ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760404
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760404,
					"content": "Könnte es etwa sein, dass jene Überlieferung wahr ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760405
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760405,
					"content": "Was für eine Überlieferung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760406
					]
				},
				{
					"id": 750760406,
					"content": "Ähm ... tja, das hängt ganz davon ab, was für eine Geschichte du, tapferer Recke aus der Fremde, hören möchtest ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760407
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760407,
					"content": "Die Geschichte der schwebenden Insel und des riesigen Graffitis auf dem Meer hat zwei Ursprünge: Der eine gleicht einer Erzählung, der andere eher einer wahren Überlieferung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760402
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760402,
					"content": "Welche möchtest du hören, Krieger aus der Fremde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760408,
						750760411
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760408,
					"content": "Über die Erzählung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760409
					]
				},
				{
					"id": 750760409,
					"content": "Na ja, in Geschichten schwingt immer eine gewisse Romantik mit ... Der Ursprung des Graffitis auf der schwebenden Insel im Nebel ist ein Teil der Geschichte von Qoyllor und Ukuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760403
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760403,
					"content": "Es heißt, ein Mädchen namens Qoyllor habe ein riesiges Graffiti am Strand hinterlassen, um ihren Vater, die Sonne, zu kontaktieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760410
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760410,
					"content": "Die Sonne, Qoyllors Vater, erblickte das Graffiti am Himmel und holte sie kurzerhand aus den irdischen Gefilden ab ... das ist der Kern der Erzählung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760417
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760417,
					"content": "Es heißt, dass der beunruhigende Nebel von Vater Sonne den Menschen auf dem Land als Strafe für den Diebstahl der Macht seiner Tochter auferlegt wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760415,
					"content": "*seufz* Egal, ob es nun eine Legende oder nur eine Erzählung ist, Nebel, der vom Meer aufsteigt, war noch nie ein gutes Vorzeichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760416
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760416,
					"content": "Oh, Recke aus der Ferne ... Dieses Gebiet birgt wohl große Gefahren, hüte dich davor und nähere dich nicht leichtfertig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760411,
					"content": "Über die Überlieferung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760412
					]
				},
				{
					"id": 750760412,
					"content": "Die überlieferte Legende ... berichtet von einem bösen Zauberer, der sich in der Gestalt eines Wayob tarnte und auf diese Weise die Helden des Stammes durch seine Magie in seinen Bann zog.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760413
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760413,
					"content": "Letztlich sahen sich die Helden des Stammes gezwungen, ihn mittels eines riesigen Graffitis zu bannen, welches den pechschwarzen bösen Zauberer hinter einem Siegel des Graffitis einsperrte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760414
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760414,
					"content": "Die Erscheinung des aufgewühlten Meeres deutet der Legende nach darauf hin, dass der dunkle Zauberer das Siegel bald durchbrechen und seine finsteren Machenschaften fortsetzen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "Sakaw"
				}
			]
		},
