						190680403
					]
				},
				{
					"id": 190680403,
					"content": "Ah ... sie sprach davon, mir etwas zu essen zu bringen ... aber im Moment bin ich gar nicht hungrig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190680404
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 190680404,
					"content": "Zudem erzählt sie ständig, dass sie mir Mittagessen bringt, also habe ich mir diesmal nichts dabei gedacht ...",
