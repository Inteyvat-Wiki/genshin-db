				"objectNames": [
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220310101,
					"content": "Gerade Lanze, gerade Linie ... Ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310102
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310102,
					"content": "Ich bin hier fürs Training.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310103
					]
				},
				{
					"id": 220310103,
					"content": "Oh! Du bist es. Hast du wieder meinen Auftrag angenommen? Vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310104
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310104,
					"content": "Es ist wirklich großartig, jemanden so Formidablen wie dich zu haben, um mit mir zu trainieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310105,
						220310110
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310105,
					"content": "Dein Geschick mit der Lanze hat sich stark verbessert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310106
					]
				},
				{
					"id": 220310106,
					"content": "Haha ... Du scherzt zu viel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310107
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310107,
					"content": "Nach dem, was ich gehört habe, war einer der Gründe, warum die Lanze erfunden wurde, dass sie jemandem, der nicht wirklich weiß, wie man eine Waffe führt, wie mir, erlaubt, mit Leichtigkeit zu kämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310108
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310108,
					"content": "Immerhin ist diese Art von Waffe lang und scharf. Selbst wenn der Träger nicht weiß, wie man sie benutzt, wirkt das einfache Stechen und Schwingen mit ihr zumindest stark.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310109
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310109,
					"content": "Wie auch immer, nach dieser Regel ... Ich denke tatsächlich, dass die bescheidene Mistgabel mit ihren drei scharfen Spitzen mehr Kraft hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310110,
					"content": "Hast du deine Waffe nicht schon zurückerhalten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310111
					]
				},
				{
					"id": 220310111,
					"content": "Ich habe meine Waffe zurückbekommen, ja, aber das bedeutet nicht, dass mein Training vorbei ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310112
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310112,
					"content": "Ich hatte schon einmal einen Zusammenstoß mit den Kairagi. Es wäre vermessen zu sagen, dass ich in Zukunft nicht auf noch stärkere Feinde stoßen werde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310113
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310113,
					"content": "Ich werde nie wieder zulassen, dass meine Waffe in die Hände des Feindes fällt und damit meine Ehre als Samurai geschändet wird. Das ist der Weg des Samurai, den ich gehen möchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		},
		{
			"id": 2203102,
