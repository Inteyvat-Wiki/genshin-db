				"objectNames": [
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220310401,
					"content": "*schnauf* Deine Fähigkeiten sind wirklich weit über meinen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310402
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310402,
					"content": "Das nächste Mal halte ich mich zurück ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310403
					]
				},
				{
					"id": 220310403,
					"content": "Nein! Bitte nutze deine ganze Kraft. Ohne Übung werde ich nicht besser werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310404
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310404,
					"content": "In Anbetracht deiner großen Stärke, musst du viel Training hinter dir haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310405
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310405,
					"content": "Verzeih mir, dass ich so unverblümt bin, aber ich bin wirklich neugierig darauf, wie du dich selbst trainiert hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310406,
						220310408
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310406,
					"content": "Ein riesiger Drache hat mir einmal geholfen, das Fliegen zu üben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310407
					]
				},
				{
					"id": 220310407,
					"content": "Du ... Du bist mit einem riesigen Drachen geflogen? Das ist unvorstellbar ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310410,
					"content": "Es ist ... nichts Besonderes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310411
					]
				},
				{
					"id": 220310411,
					"content": "Hahaha, ist das so? Dann musst du wohl wirklich begabt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310412
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310412,
					"content": "Danke, dass du mit mir trainiert hast. Ich werde mich an das erinnern, was du mich gelehrt hast. Bitte nimm dies als Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310408,
					"content": "Ein großer Wolf half mir beim Üben meiner Kampfkünste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310409
					]
				},
				{
					"id": 220310409,
					"content": "Das klingt wirklich mutig. Ich wünschte wirklich, ich könnte sehen, wie du und der große Wolf gegeneinander kämpfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "Asakura"
				}
			]
		},
