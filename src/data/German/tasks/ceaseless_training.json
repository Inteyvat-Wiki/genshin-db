			]
		},
		{
			"id": 2203103,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220310301,
					"content": "Du scheinst abgelenkt gewesen zu sein. Deine Schritte waren ein Durcheinander und die Stärke deiner Angriffe war uneinheitlich, manchmal stark und manchmal schwach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310302
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310302,
					"content": "Das wird nicht reichen. Bitte mach dich erst einmal fertig und wir werden es später noch einmal versuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		},
		{
			"id": 2203104,
			"completionStepIds": [
				2203104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
