			"dialogs": [
				{
					"id": 220310201,
					"content": "*seufz* Nun, das war’s mit dem Geplauder. Ich glaube nicht, dass ich deine Zeit verschwenden sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
