			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ineffa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765040101,
					"content": "#Hallo, {NICKNAME} und Paimon. Habt ihr schon gegessen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040102
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040102,
					"content": "Ineffa? Warum bist du auch auf das Dach? Beobachtest du etwa die Wolkenformen, um die Regenwahrscheinlichkeit zu berechnen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040103,
					"content": "Ich führe gerade einen ... Auftrag aus, bei dem es zu einer unerwarteten Wendung gekommen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040104
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040104,
					"content": "Der ursprüngliche Plan war, für Aino ein „Hochpräzisionszahnrad“ und eine „spezialangefertigte Sechskantschraube“ zu kaufen, die sie auf ihrer Liste vermerkt hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040105
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040105,
					"content": "Doch auf dem Rückweg zur Werkstatt gab es einen ... unvorhersehbaren Vorfall bei der Materialbeschaffung. Ein Falke hat mir mit hoher Geschwindigkeit die spezialangefertigte Schraube aus der Hand geschnappt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040106,
					"content": "Also bist du aufs Dach, um den Falken zu suchen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040107
					]
				},
				{
					"id": 765040107,
					"content": "Ja. Aufgrund der Gewohnheiten dieser Kreatur ist das Dach ein möglicher vorübergehender Landeplatz. Ich führe gerade eine umfassende visuelle und akustische Suche durch, um das Ziel zu lokalisieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040108
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040108,
					"content": "Bisher habe ich jedoch keine brauchbaren Spuren gefunden. Vorläufige Schlussfolgerung: Das Ziel ist aus meinem Verfolgungsbereich entkommen oder hat die „Beute“ bereits in ein versteckteres Nest gebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040109
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040109,
					"content": "Der Alternativplan wurde aktiviert: Ich werde erneut zum angegebenen Lieferanten gehen und eine Schraube des gleichen Typs kaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040110
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040110,
					"content": "Übrigens, seid ihr etwa auch ... auf der Suche nach einem kleinen Tier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040111,
						765040112
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040111,
					"content": "Oh, nein, nein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				},
				{
					"id": 765040113,
					"content": "Ja! Wir wollten eigentlich einen Ort mit guter Aussicht finden, um Panoramafotos von Nasha zu machen und festzuhalten, wie geschäftig und lebendig es hier zugeht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040114,
					"content": "Paimon hätte nie gedacht, hier die „einen kleinen Dieb verfolgende“ Ineffa anzutreffen! Das ist wohl auch eines dieser seltenen „Überraschungsereignisse als Resultat einer unerwarteten Wendung“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040115,
						765040116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040115,
					"content": "Das ist eine seltene Gelegenheit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040117,
					"content": "Das darfst du. Bitte weise mir die notwendige Position zum Stehen und die Körperausrichtung sowie den empfohlenen Gesichtsausdruck zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040118
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040118,
					"content": "#Ich glaube, die Wahrscheinlichkeit, dass ich aufs Dach steige, euch hier treffe und {NICKNAME} noch dazu Fotos von mir macht ... ist wohl noch geringer, als dass dieser Falke die Schraube zurückbringt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040119
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040119,
					"content": "Bitte halte diesen seltenen „Überraschungsmoment“ genau fest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040116,
					"content": "Darf ich ein Foto von dir machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040112,
					"content": "Ich suche eigentlich nur nach guten Fotomotiven.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				}
			]
		},
