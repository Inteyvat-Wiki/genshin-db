			"dialogs": [
				{
					"id": 765040701,
					"content": "#Hallo, {NICKNAME} und Paimon. Habt ihr schon gegessen? Habt ihr heute irgendwelche besonderen Pläne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040702,
						765040703
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040702,
					"content": "Wir erkunden einfach nur die Umgebung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
					]
				},
				{
					"id": 765040704,
					"content": "Verstehe. Spazieren gehen und die Welt mit einem Fotoapparat aufzeichnen ... Eine wunderbare Art, sich zu entspannen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040705
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040705,
					"content": "Allerdings habe ich keinen Fotoapparat bei dir entdeckt. Hast du ihn vielleicht in der Eile irgendwo liegen lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040703,
					"content": "Wir suchen einfach nur nach Motiven für unsere Aufnahmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
					]
				}
			]
