			"dialogs": [
				{
					"id": 400335201,
					"content": "Keine Sorge, ich habe schon meine ersten Schlüsse gezogen, Ryuuji wird die „schwarzen Schatten“ weiter untersuchen, und ihr solltet auch die kleinen Tiere retten gehen.",
					"roleType": "TALK_ROLE_NPC",
