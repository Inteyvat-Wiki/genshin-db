				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400330301,
					"content": "Vielen Dank für deine harte Arbeit! Großartig! Jetzt sollten alle Tiere gefunden werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330302
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330302,
					"content": "Hm? Warum fehlen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330303
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330303,
					"content": "Oh, wie konnte das passieren? Es fühlt sich endlos an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330304,
					"content": "In der Tat erfordert die Untersuchung eines Falles manchmal sehr viel Geduld. Wenn man zufällig in die falsche Richtung geht, kann es sein, dass man einen Fallschirm braucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330305
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330305,
					"content": "Zumindest haben wir bisher viele der Tiere zurückbekommen, sodass die grobe Richtung stimmen sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330306
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330306,
					"content": "Es ist nur so, dass wir vielleicht einen Hinweis übersehen haben oder einfach noch nicht alle Orte untersucht haben, sodass wir in eine Sackgasse geraten sind. Ich bin aber sicher, dass es nur vorübergehend ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330307
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330307,
					"content": "Paimon hat es verstanden! Du meinst, es gibt eine Art Kniff, den wir noch nicht erkannt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330308,
					"content": "#Ein überwältigendes Gefühl ... Das könnte man auch sagen. Und wir kommen dank {F#der}{M#dem} Reisenden und Paimon nicht gerade langsam voran, also kein Grund zur Frustration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330309,
						400330310
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330309,
					"content": "(Ich habe die Worte von Paimon wirklich verstanden ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330311
					]
				},
				{
					"id": 400330311,
					"content": "He, he, Paimon hat das Gefühl, was du sagst, hat wirklich Sinn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330312,
					"content": "Es tut mir leid, aber das ist nur die Erfahrung, die ich bei der Aufdeckung von Fällen gemacht habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330313
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330313,
					"content": "Je tiefer das Geheimnis vergraben ist, desto wertvoller ist es, nachzuforschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330314
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330314,
					"content": "Es ist nur schade, dass im Moment auch keine anderen Informationen verfügbar sind, hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330315
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330315,
					"content": "Ich werde zurückkehren und Sango über die aktuelle Lage berichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330316
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330316,
					"content": "Sango muss an etwas gedacht haben, an das wir nicht gedacht haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330317
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330317,
					"content": "Hmmm! Das klingt sehr vernünftig. Wir machen das so wie du sagst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330318,
					"content": "Dann sind wir uns einig. Wie immer, wir treffen uns dann am altbekannten Ort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330319
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330319,
					"content": "Für den Fall, dass ich in etwas verwickelt werde und nicht wegkomme, kannst du dich direkt an Sango wenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330310,
					"content": "(Ryuuji versteht Paimon mittlerweile sehr gut ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330311
					]
				}
			]
		},
