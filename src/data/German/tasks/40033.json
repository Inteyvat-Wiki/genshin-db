			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400330101,
					"content": "Ihr seid es. Gerade noch rechtzeitig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330102,
					"content": "Ich habe gerade mehrere verdächtige Orte untersucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330103
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330103,
					"content": "Darunter gibt es eines, das ihm gehört ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330104,
					"content": "Es wird von diesem „schwarzen Schatten“ bewacht. Wenn du keine anderen Fragen hast ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330105
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330105,
					"content": "Die „Untersuchung“ von gestern ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330106
					]
				},
				{
					"id": 400330106,
					"content": "Was das angeht, bin ich momentan ratlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330107,
					"content": "Huch? Hat Sango dich das nicht untersuchen lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330108,
					"content": "Ja genau. Aber ... wie soll ich das sagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330109
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330109,
					"content": "So stehen zum Beispiel die „überreife Lavendelmelone“ und der „schlammige Handabdruck auf dem Türvorhang“ für mich in keinem Zusammenhang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330110,
					"content": "Aber für Sango kann es der Schlüssel zum Öffnen einer „Yosegizaiku“ sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330111,
					"content": "Was ist der Zusammenhang zwischen der „überreifen Lavendelmelone“ und dem „schlammigen Handabdruck auf dem Türvorhang“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330112,
					"content": "Nur eine Analogie. Ich folgte ihren Anweisungen und untersuchte eine Reihe von Orten auf der Insel Yashiori und im Chinju-Wald und berichtete ihr von meiner Exkursion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330113,
					"content": "Und was sie aus den Phänomenen, über die ich berichte, schließen kann, weiß nur sie selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330114,
					"content": "Nur Shikanoin kann mit ihrem Geist Schritt halten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330115,
					"content": "Shikanoin Heizou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330116
					]
				},
				{
					"id": 400330116,
					"content": "Ein Mann von der Tenryou-Verwaltung. Ich hatte das Vergnügen, ihn kennenzulernen, als ich früher in dem Fall ermittelte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330117
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330117,
					"content": "Ein Mann mit ... einzigartigem Temperament. Du würdest ihn sofort erkennen, wenn du ihn sehen würdest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330118,
					"content": "Ich danke dir auf jeden Fall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330119
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330119,
					"content": "Paimon interessiert sich immer noch für die „Lavendelmelone“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4003303,
			"completionStepIds": [
				4003303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003303",
							"2"
						],
						"stepId": 4003303,
						"stateName": "QUEST_STATE_UNFINISHED"
