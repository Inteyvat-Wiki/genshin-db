					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220300601,
					"content": "Danke schön! Diese Zutaten sind noch brauchbar, aber wir können keinen Moment länger warten ... Ich fange jetzt mit dem Kochen an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300602
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300602,
					"content": "Es ist vollbracht. Puh ... Es ist dir zu verdanken, dass dieses Gericht reibungslos fertig geworden ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300603,
						220300610
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300603,
					"content": "Du bist wirklich ein Perfektionist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300604
					]
				},
				{
					"id": 220300604,
					"content": "Ja, natürlich. Ob Blumenmuster, Tee, Kochen oder Schwertkampf, wenn du nicht nach Perfektion strebst, wird ihre Bedeutung verloren gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300605
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300605,
					"content": "Der Weg der „Extreme“ ist meine Art zu leben. Xudong scheint allerdings eine andere Meinung zu vertreten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300606
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300606,
					"content": "Er hat mir einmal erzählt, dass es in Liyue ein Wort gibt, das für Mäßigung steht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300607
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300607,
					"content": "Es bedeutet, dass man es immer vermeiden sollte, extrem zu sein, egal ob es darum geht, sein Leben zu leben oder bestimmte Dinge zu tun. Mäßigung, ohne sich zu einer der beiden Seiten zu neigen, ist die beste Art zu leben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300608
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300608,
					"content": "Ich verstehe nicht ganz, was Xudong eigentlich meinte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300609
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300609,
					"content": "Aber ich glaube, dass er viele Dinge durchgemacht haben muss, um auf diese Art von Philosophie zu kommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300612
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300612,
					"content": "Da wir die Zutaten bereits besorgt haben und mit dem Kochen fertig sind, werde ich deine Zeit nicht weiter in Anspruch nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300613
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300613,
					"content": "Bitte nimm dies und ich bringe den Rest zu Xudong. Ich bin mir sicher, dass er sich freuen wird, sie zu probieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300610,
					"content": "Was ist mit diesen Monstern ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300611
					]
				},
				{
					"id": 220300611,
					"content": "Ich habe mich bereits um sie gekümmert. Es gibt keinen Grund zur Sorge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300612
					],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
