			"dialogs": [
				{
					"id": 220300201,
					"content": "Das ist der Ort. Die beiden Gruppen von Monstern haben ihr Lager auf beiden Seiten aufgeschlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300202
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300202,
					"content": "Ich habe mich bereits dorthin geschlichen, um zu spähen. Obwohl die Monster im linken Lager schwächer zu sein scheinen, gibt es dennoch viele von ihnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300203
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300203,
					"content": "Im rechten Lager gibt es weniger Monster, aber sie sind viel stärker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300204
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300204,
					"content": "Bitte eliminiere die Monster in einem Lager und überlasse das andere Lager mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
