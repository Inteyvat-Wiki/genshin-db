			"dialogs": [
				{
					"id": 220300301,
					"content": "Ich gehe nach rechts.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300302
					]
				},
				{
					"id": 220300302,
					"content": "Dann werde ich es dir überlassen. Ich werde zum anderen Lager gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300303
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300303,
					"content": "Schaffst du das alleine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300304
					]
				},
				{
					"id": 220300304,
					"content": "Sie sind einfach nur Monster. Es gibt keinen Grund, sich um mich zu sorgen. Wenn es nicht um die Zutaten ginge, hätte ich es mit allen aufnehmen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300305
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300305,
					"content": "In Ordnung, sobald du die Monster eliminiert und die Zutaten geholt hast, kannst du zu mir ins andere Lager kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300306
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300306,
					"content": "Lass uns jetzt loslegen. Wenn die Zutaten ruiniert sind, befürchte ich, dass das Gericht nicht so lecker wird, wie ich es versprochen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
