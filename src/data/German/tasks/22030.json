			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220300101,
					"content": "Wir treffen uns wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300102
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300102,
					"content": "Entschuldige meine Unverschämtheit, aber ich brauche heute deine Hilfe in einer bestimmten Angelegenheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300103,
						220300104
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300103,
					"content": "Was gibt’s?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300106
					]
				},
				{
					"id": 220300106,
					"content": "Nachdem ich von Xudong angeheuert wurde, bin ich mit ihm und den anderen unterwegs gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300107
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300107,
					"content": "Ich möchte ein paar Geschenke machen, als Zeichen meiner Wertschätzung dafür, dass er mich aufgenommen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300108
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300108,
					"content": "Aber da Xudong anscheinend das Kochen den Kampfkünsten vorzieht, würde ich gerne selbst etwas Essen machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300109
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300109,
					"content": "Ich hatte bereits zwei Standorte für die notwendigen Zutaten gefunden und wollte die Zutaten abholen, sobald sie gereift sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300110
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300110,
					"content": "Allerdings gibt es zwei Gruppen von Monstern, die diese beiden Orte besetzen, und sie haben alle bereits die Zutaten genommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300111
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300111,
					"content": "Die Frische der Zutaten ist für mich essentiell, um das Gericht zu kochen. Ich hatte vor, sie erst von einem Ort zu besorgen und dann zum anderen zu gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300112
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300112,
					"content": "Aber jetzt, wo beide Gruppen von Monstern die Zutaten schon genommen haben, muss ich diese beiden Zutaten so schnell wie möglich zurückholen, wenn ich dieses Gericht kochen will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300113
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300113,
					"content": "Wie auch immer ... Ich kann nicht an zwei Orten gleichzeitig sein. Selbst wenn ich an einem Ort mit den Monstern fertig werde, wären die Zutaten am zweiten Ort bereits von den Monstern ruiniert worden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300114
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300114,
					"content": "Deshalb brauche ich deine Hilfe. Wir werden diese Monster gleichzeitig besiegen und die Zutaten bergen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300115,
						220300117
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300115,
					"content": "Nun, dann überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300116
					]
				},
				{
					"id": 220300116,
					"content": "Ich danke dir. Ich kann dir ehrlich gesagt nicht genug danken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300119,
					"content": "Hmm ... Hier weiter darüber zu reden, wird uns nicht guttun. Bitte komm mit mir und wir werden weiter diskutieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300117,
					"content": "Wenn du mit dem Kochen fertig bist, kann ich dann etwas davon haben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300118
					]
				},
				{
					"id": 220300118,
					"content": "#Ja, natürlich. In der Tat, du sollst {F#die}{M#der} Erste sein, der sie bekommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300104,
					"content": "Kein Grund, so höflich zu sein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300105
					]
				},
				{
					"id": 220300105,
					"content": "Da ich etwas von dir brauche, ist diese Art der Etikette notwendig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300106
					],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
		{
			"id": 2203002,
