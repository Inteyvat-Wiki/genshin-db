				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kleine Liu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150701,
					"content": "Bist du hier, um mich zu fangen und zurück ins Qingce-Dorf zu bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150702,
						708150704
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708150702,
					"content": "Oma Ruoxin hat sich große Sorgen um dich gemacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150703
					]
				},
				{
					"id": 708150703,
					"content": "Hmpf. Also bist du hier, um mich zu fangen. Nun ja, ich werde nicht zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708150706,
					"content": "Geh zurück und sag den Dorfbewohnern, dass ich zum Hafen von Liyue gehe, um nach Papa zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150707
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708150707,
					"content": "Sie müssen sich keine Sorgen machen. Sobald ich ihn finde, werde ich einfach eine Weile mit ihm sprechen und dann zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708150704,
					"content": "Ich habe etwas für dich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150705
					]
				},
				{
					"id": 708150705,
					"content": "Ich brauche nichts von dir. Du versuchst nur, mich zu bestechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "Kleine Liu"
				}
			]
		},
		{
			"id": 7081508,
			"completionStepIds": [
				7081508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7081508",
							"2"
						],
						"stepId": 7081508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kleine Liu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150801,
					"content": "Warum folgst du mir überhaupt? Ich sagte, ich geht zum Hafen von Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150802
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708150802,
					"content": "Ich werde den Monstern selbst ausweichen. Sie werden mich nicht finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150803
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708150803,
					"content": "Behandle mich nicht wie ein Kind. Ich bin jetzt ein Erwachsener!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150804
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708150804,
					"content": "Das ist von deinem Vater ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150805
					]
				},
				{
					"id": 708150805,
					"content": "Von Papa? Hat er dich gebeten, es herzuschicken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150806
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708150806,
					"content": "Ich bin mir sicher, dass es mehr Dinge zum Spielen für Kinder sind ... wenn es nicht Drachen sind, sind es Puppen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150807
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708150807,
					"content": "Magst du sie nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150808
					]
				},
				{
					"id": 708150808,
					"content": "...Doch, schon. Es ist etwas von Papa. Wie könnte ich es nicht mögen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150809
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708150809,
					"content": "Aber wenn ich diese Sachen immer mag, heißt das dann, dass ich für immer ein Kind bleibe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150810
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708150810,
					"content": "Wenn ich weiter mit ihnen spiele, wann werde ich dann überhaupt mal ein Abenteurer oder kriege ein Göttliches Auge?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150811
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708150811,
					"content": "Wofür willst du nochmal ein Göttliches Auge?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150812
					]
				},
				{
					"id": 708150812,
					"content": "Wenn ich ein Göttliches Auge hätte, könnte ich so viele Dinge tun. Ob es Geld verdienen oder etwas anderes ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150813
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708150813,
					"content": "Dann müsste Papa nicht die ganze Zeit im Hafen von Liyue arbeiten. Er könnte zurückkehren und Zeit mit mir verbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150814
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708150814,
					"content": "Im Moment kann ich alleine ohne Göttliches Auge nicht einmal zum Hafen von Liyue gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150815
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708150815,
					"content": "Aber da Papa dich schon mit seinen Geschenken hierher geschickt hat, hat er vielleicht mehr Ärger, wenn ich ihn suche gehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150816
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708150816,
					"content": "<color=#00E1FFFF>Ich hatte auch schon Geschenke für ihn vorbereitet</color>. Ich wollte ihm eine Überraschung bieten ... Aber ich kann sie jetzt nicht zu ihm bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150817
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708150817,
					"content": "<color=#00E1FFFF>Wenn mir nur jemand dabei helfen könnte, das zu machen</color>... Es ist in Ordnung. Ich werde zurückgehen. Du musst mir nicht folgen, ich kenne den Weg nach Hause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleine Liu"
				}
			]
		},
		{
			"id": 7081509,
			"completionStepIds": [
				7081509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7081509",
							"2"
						],
						"stepId": 7081509,
						"stateName": "QUEST_STATE_UNFINISHED"
