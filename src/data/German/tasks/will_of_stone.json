				"objectNames": [
					"Oma Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708151001,
					"content": "Du bist zurückgekommen. Vielen Dank für deine Hilfe. Die kleine Liu ist schon zurückgekehrt. Und sie hatte eine große Tasche mit vielen Sachen dabei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151002
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 708151002,
					"content": "Jiayi hat sie zu ihr geschickt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708151003
					]
				},
				{
					"id": 708151003,
					"content": "Hat er das ... Aber trotzdem. Was die kleine Liu wollte wirklich wollte, war, dass er persönlich zurückkehrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151004
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 708151004,
					"content": "Das Kind ist wirklich groß geworden wie der Bambus um das Dorf. Ein Wimpernschlag und du verpasst, wie schnell sie wirklich gewachsen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151005
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 708151005,
					"content": "Der Tag, an dem dein Kind jung ist, wird nie zurückkehren, sobald du es weg ist..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oma Ruoxin"
				}
			]
		},
