				{
					"id": 708151201,
					"content": "Hast du der kleinen Liu das Geschenk schon gegeben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151202
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151202,
					"content": "Nun, das ist von der kleinen Liu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708151203
					]
				},
				{
					"id": 708151203,
					"content": "Das ... ist von der kleinen Liu, für mich? So viele ... Wie viel hat sie dafür arbeiten müssen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151204
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151204,
					"content": "Ich will nichts mehr, als alles fallen zu lassen und jetzt ins Qingce-Dorf zurückzukehren. Aber der Rat für Allgemeine Angelegenheiten würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151205
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151205,
					"content": "Dank dir noch einmal. Bitte, nimm dies als Dankeschön.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151206
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151206,
					"content": "*seufz* Ich habe immer noch keine Ahnung, wann diese ganze Angelegenheit vorbei sein wird oder wann sie meinen Urlaub genehmigen werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
