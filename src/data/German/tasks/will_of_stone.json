			"dialogs": [
				{
					"id": 708151301,
					"content": "Wenn ich nur ein Göttliches Auge hätte! Mit ihr könnte ich so viele Dinge tun. Geld verdienen oder was auch immer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151302
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708151302,
					"content": "Zumindest hätte ich keine Probleme, alleine nach Liyue zu kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151303
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708151303,
					"content": "Aber wie kriege ich nur eine in die Finger ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleine Liu"
				}
			]
