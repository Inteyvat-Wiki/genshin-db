				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kleine Liu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150901,
					"content": "Puppen ... Drachen ... Windräder. Papa hat wieder solche Sachen geschickt, wie ich dachte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150902
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708150902,
					"content": "*seufz* Es ist eine Schande, dass ich ihm meine Geschenke nicht auch schicken konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150903
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708150903,
					"content": "Ich nehme sie mit zu deinem Vater.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150904
					]
				},
				{
					"id": 708150904,
					"content": "Du willst mir helfen? Na ja, auch wenn du kein Göttliches Auge hast, sah es nicht danach aus, als hättest du Schwierigkeiten mit den Monstern gehabt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150905
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708150905,
					"content": "Ich denke, wir werden es so machen müssen. Danke dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150906
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 708150906,
					"content": "*seufz* Wenn ich doch nur so stark wie du sein könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleine Liu"
				}
			]
		},
