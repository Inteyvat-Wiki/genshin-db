			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Oma Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150601,
					"content": "Und diese Jiayi. Wie konnte er seiner Tochter einfach so absagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150602
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 708150602,
					"content": "Sie sieht ihn nicht öfter als ein paar Mal im Jahr. Sollte ein Vater sich so verhalten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150603,
						708150605
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 708150603,
					"content": "Er tut das für den Hafen von Liyue ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150604
					]
				},
				{
					"id": 708150604,
					"content": "Das sagt er jedes Jahr. Ich kann nicht mehr zählen, wie oft er das gesagt hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 708150605,
					"content": "Er macht nur seine Arbeit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150606
					]
				},
				{
					"id": 708150606,
					"content": "Na ja, es ist auch seine Arbeit, sich um seine Tochter zu kümmern. Die kleine Liu wird Tag für Tag größer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150607
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 708150607,
					"content": "Wenn er nicht vorsichtig ist, ist sie diejenige, die zum Arbeiten geht, wenn er zurückkommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150608
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 708150608,
					"content": "Dieser Vater und seine Tochter kommen einfach nicht zusammen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oma Ruoxin"
				}
			]
		},
		{
			"id": 7081507,
			"completionStepIds": [
				7081505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
