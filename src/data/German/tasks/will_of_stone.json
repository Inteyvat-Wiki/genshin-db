			"dialogs": [
				{
					"id": 708151101,
					"content": "Hast du der kleinen Liu das Geschenk schon gegeben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151102,
						708151104
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151102,
					"content": "Ist bereits erledigt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708151103
					]
				},
				{
					"id": 708151103,
					"content": "Das ist gut. Meine Spielzeuge sind ihr die liebsten. Danke dir - bitte nimm dies als Zeichen meiner Dankbarkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151104,
					"content": "Sie würde es lieber mögen, wenn du zu Hause wärst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708151105
					]
				},
				{
					"id": 708151105,
					"content": "Ich will auch zurückkehren. Aber mit dem Hafen von Liyue in diesem Zustand wird das glaube ich erstmal nicht möglich sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151106
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151106,
					"content": "Trotzdem, danke dir vielmals. Ich hoffe diese Geschenke werden ihre Laune etwa verbessern - es sind schließlich ihre liebsten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151107
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151107,
					"content": "Bitte, nimm dies als Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
