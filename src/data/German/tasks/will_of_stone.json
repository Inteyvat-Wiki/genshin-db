			"trigger": {
				"objectNames": [
					"Jiayi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150401,
					"content": "*seufz* Ich habe die Tage gezählt, bis ich zurückkehren hätte können. Nur zwei oder drei Tage mehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150402
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150402,
					"content": "Mit all dem Urlaub, den ich bis jetzt angespart habe, hätte ich mehr als eine Woche mit der kleinen Liu verbringen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150403
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150403,
					"content": "Aber durch einen Befehl ist der ganze Urlaub zurückgenommen. Sogar die Leute im Urlaub wurden zurückgerufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150404
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150404,
					"content": "Meiner Erfahrung nach bedeutet das mindestens einen weiteren Monat ohne Hoffnung auf Rückkehr ins Qingce-Dorf. Was für ein fürchterliches Pech ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
		{
			"id": 7081505,
			"completionStepIds": [
				7081502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7081502",
							"2"
						],
						"stepId": 7081502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Oma Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150501,
					"content": "Oh, wohin ist das Kind abgehauen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150502
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 708150502,
					"content": "Kann ich dich etwas zur kleinen Liu fragen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150503
					]
				},
				{
					"id": 708150503,
					"content": "Suchst du nach ihr? *seufz* Was für ein furchtbarer Zeitpunkt. Ich weiß nicht, wo sie hingelaufen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150504
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 708150504,
					"content": "Sie hat einen Brief erhalten, den ihr Vater von jemanden vom Hafen von Liyue bringen hat lassen, in dem steht, das er bald zurück sei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150505
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 708150505,
					"content": "Die kleine Liu war so glücklich. Sie sagte, sie will ein Geschenk für ihren Vater vorbereiten und hat einige andere Kinder dazu gebracht, Früchte und Blumen zu pflücken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150506
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 708150506,
					"content": "Aber ein paar Tage später hat er eine Nachricht gesendet, dass er in letzter Minute einen Auftrag erhalten hat und nicht zurückkehren kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150507
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 708150507,
					"content": "Sie bekam einen Wutanfall. Und nichts, was wir sagten, konnte sie davon abbringen, selbst zum Hafen von Liyue zu gehen, weil ihr Vater nicht herkommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150508
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 708150508,
					"content": "Wir hielten es eine Weile für einen Witz. Aber diesen Morgen war sie weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150509
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 708150509,
					"content": "*seufz* Wir haben schon Leute geschickt, um nach ihr zu suchen, aber wenn du willst, kannst du auch mitmachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150510,
						708150512
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 708150510,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150511
					]
				},
				{
					"id": 708150511,
					"content": "Ich entschuldige mich für den Ärger. *seufz* Dieses Kind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 708150512,
					"content": "Wo glaubst du geht sie hin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150513
					]
				},
				{
					"id": 708150513,
					"content": "Ich glaube nicht, dass sie weit kommen kann. Sie wahrscheinlich noch in der Nähe, aber die Wildnis ist ein gefährlicher Ort ... Bitte, finde sie schnell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oma Ruoxin"
				}
			]
		},
		{
			"id": 7081506,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
