			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701270101,
					"content": "„Wenn du diese Botschaft liest, dann hoffe ich, dass du der bist, den ich erwarte.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270102
					],
					"speakerTitle": "Flaschenpost"
				},
				{
					"id": 701270102,
					"content": "„Ich habe nicht mehr gezählt, der wievielte Brief das ist. Wie weit wird er wohl treiben und an welchem Ufer wird er angespült?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270103
					],
					"speakerTitle": "Flaschenpost"
				},
				{
					"id": 701270103,
					"content": "„Sollten wir uns irgendwann einmal wiedersehen, so erzähle mir doch noch einmal von der steinernen Bergstadt und den Schneestürmen des Nordens. Vielleicht erzählst du mir aber auch von Löwenzahn und Wein. Was meinst du?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270104
					],
					"speakerTitle": "Flaschenpost"
				},
				{
					"id": 701270104,
					"content": "„Ich werde auf deine Antwort warten, so wie ich es immer getan habe.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flaschenpost"
				}
			]
		},
		{
			"id": 7012702,
			"completionStepIds": [
				7012702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701270201,
					"content": "„Wenn du diese Botschaft liest, dann hoffe ich, dass du der bist, den ich erwarte.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270202
					],
					"speakerTitle": "Flaschenpost"
				},
				{
					"id": 701270202,
					"content": "„Einst glaubten wir, dass Krieg etwas wäre, das nur in Märchen und Legenden passierte. Aber jetzt zittert jeder Einzelne von uns unter dem tosenden Zorn Ihrer Majestät.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270203
					],
					"speakerTitle": "Flaschenpost"
				},
				{
					"id": 701270203,
					"content": "„Der Strand, an den wir gewöhnlich gehen, wurde abgeriegelt, aber ich habe einen Weg gefunden, diesen Brief trotzdem rauszubringen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270204
					],
					"speakerTitle": "Flaschenpost"
				},
				{
					"id": 701270204,
					"content": "„Mach dir keine Sorgen und gib dir nicht selbst die Schuld dafür. Diese Tat ist nur unbedeutend für jemanden, der einst wie ich an deiner Seite stand.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270205
					],
					"speakerTitle": "Flaschenpost"
				},
				{
					"id": 701270205,
					"content": "„Ich werde auf deine Antwort warten, selbst wenn du nur ein einziges Wort schreibst.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flaschenpost"
				}
			]
		}
	]
}