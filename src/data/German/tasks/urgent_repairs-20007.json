					"Allan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200070101,
					"content": "#Danke! Vielen Dank, {NICKNAME}! Ich dachte schon, die Eier wären ausgegangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070102
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070102,
					"content": "Auf dem Wagen ist alles, was die Jäger mit harter Arbeit erbeutet haben. Draff will, dass ich ihn nach Mondstadt befördere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070103
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070103,
					"content": "Ich bin zwar kein guter Jäger ... Aber eine Warenlieferung sollte ich ja noch hinkriegen. Zumindest dachte ich das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070104
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070104,
					"content": "Fast hätte ich alles versaut. Plötzlich wurde ich überfallen. Die waren sicher auf die Beute aus. Aber du kamst ja zur richtigen Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070105
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070105,
					"content": "Ähm, ich trau mich kaum zu fragen ... Mein Wagen ist während des Überfalls kaputtgegangen. Um hier wegzukommen, muss er aber repariert werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070106
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070106,
					"content": "In den Wäldern ringsum gibt es sicher genügend Material, das ich dafür nehmen kann. Die Beute befindet sich aber noch auf dem Wagen. Ich befürchte, dass sie nicht sicher ist, wenn ich einfach weggehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070107
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070107,
					"content": "Wenn es nicht zu viel verlangt ist, bitte ich dich, mir ein <color=#00E1FFFF>stabiles Brett</color> zu bringen. Geht das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
		{
			"id": 2000702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
