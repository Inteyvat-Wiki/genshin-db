					"content": "Eine dringende Angelegenheit wartet auf mich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200070802
					]
				},
				{
					"id": 200070802,
					"content": "Nein! Vielleicht sind diese Kerle noch in der Nähe. Hilf mir bitte noch dieses eine Mal, damit ich hier abhauen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
