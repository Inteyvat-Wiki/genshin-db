			"dialogs": [
				{
					"id": 200070301,
					"content": "Das müsste reichen. Es sollte nicht lange dauern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070302
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070302,
					"content": "#Oh nein, {F#Reisende}{M#Reisender}! Sie sind wieder hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
		{
