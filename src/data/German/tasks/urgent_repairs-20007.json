					"content": "Ja, ich mach das für dich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200070702
					]
				},
				{
					"id": 200070702,
					"content": "Wundervoll! Dann werde ich hier auf dich warten. Bitte mach nicht zu lange, sonst kommen diese Kerle wieder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
