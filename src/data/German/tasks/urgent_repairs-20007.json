					"Allan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200070401,
					"content": "Ich bin dir zu großem Dank verpflichtet! Diese Kerle sind wirklich hartnäckig. Was ist denn an der Beute der Jäger so anziehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070402
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070402,
					"content": "Draff ist ein wahrhaft guter Jäger. Er erlegt nur das beste Wild. Wenn ich nur so ein toller Jäger wie er sein könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070403
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070403,
					"content": "Aber zuerst sollte ich den Wagen in die Stadt fahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070404
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070404,
					"content": "#Es tut mir schrecklich leid, {F#Reisende}{M#Reisender}! Ich war fast fertig mit der Reparatur, als mir noch ein kleiner Teil kaputtging.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070405
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070405,
					"content": "Wenn ich länger hierbleibe, wird es nur noch gefährlicher. Ich muss die Stelle reparieren. Auf dem Wagen hätte ein Seil sein sollen. Diese Hilichurle müssen es gestohlen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070406
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070406,
					"content": "#{F#Reisende}{M#Reisender}, würdest du mir bitte ein <color=#00E1FFFF>Seil</color> suchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
