			"dialogs": [
				{
					"id": 200070201,
					"content": "Ich muss nur ein paar Stellen reparieren, damit ich es bis nach Mondstadt schaffe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070202
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070202,
					"content": "In den Wäldern ringsum gibt es sicher passendes Holz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
