				{
					"id": 200071001,
					"content": "Ich habe noch zu tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200071002
					]
				},
				{
					"id": 200071002,
					"content": "Das ist wirklich meine allerletzte Bitte. Ich brauche nur noch das Seil und dann kann ich verschwinden. Ich bitte dich!",
