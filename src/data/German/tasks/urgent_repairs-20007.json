			},
			"dialogs": [
				{
					"id": 200070601,
					"content": "Das müsste reichen. Die Konstruktion sieht zwar etwas wackelig aus. Aber solange sie mich nach Mondstadt bringt, ist das in Ordnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070602
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070602,
					"content": "Danke dir! Dann kann ich endlich losfahren. Schau mal in Quellingen vorbei. Da können wir einen zusammen trinken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070603
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070603,
					"content": "... solange du nicht wie Daff trinkst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
