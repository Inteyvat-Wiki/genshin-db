			"dialogs": [
				{
					"id": 706960101,
					"content": "#Lange nicht gesehen, Kleine{M#r}. Wo hat dich deine Reise zuletzt hin verschlagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960102,
					"content": "Du teilst Miko deine Erlebnisse auf dem Drachengrat mit.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706960103
					]
				},
				{
					"id": 706960103,
					"content": "Hm, sie klingen wirklich niedlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960104
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960104,
					"content": "Es muss für sie ein ziemliches Abenteuer gewesen sein, von nah und fern herzukommen, um Gleichgesinnte zu treffen ... Ach, eine Geschichte voller jugendlicher Romantik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960105
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960105,
					"content": "„Chronik der Flammenkrieger“ scheint ziemlich gut anzukommen ... Vielleicht ist es Zeit für eine Neuauflage ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960106,
					"content": "Bei einer so treuen Lesergemeinde ist es nur recht, ihnen ein Zeichen der Dankbarkeit zu zeigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960107,
					"content": "Wie wäre es, wenn ich euch ein paar Comics schenke? Hmm ... Da ihr so viele seid, muss ich sicherstellen, dass es für alle genug gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960108,
						706960109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960108,
					"content": "Danke dir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				},
				{
					"id": 706960110,
					"content": "Das sind Drucke der Erstausgabe, die es nirgendwo zu kaufen gibt. Bewahrt sie also gut auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960109,
					"content": "Ich werde diese mit ihnen teilen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				}
			]
		},
