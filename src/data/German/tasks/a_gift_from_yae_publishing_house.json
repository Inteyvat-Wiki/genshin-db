			"dialogs": [
				{
					"id": 706960201,
					"content": "Miko hat uns einen Haufen Comics geschenkt. Da wir sie mit der Gruppe teilen wollen, sollten wir sie vielleicht an einem Ort ausstellen, wo sie jeder sehen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706960202,
					"content": "Lass uns die Comics in die Nähe des Bücherstands im Lager der „Legion der Flammenkrieger“ legen, damit alle sie leicht finden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706960203,
					"content": "Du leihst dir ein Bücherregal aus und legst die Comics von Miko hinein.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706960204
					]
				},
				{
					"id": 706960204,
					"content": "Schön, sieht gut aus. Jetzt können alle vorbeikommen und sich etwas aussuchen, wenn sie Zeit haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
