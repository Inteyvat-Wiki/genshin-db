						],
						"stepId": 7302104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapas"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730210301,
					"content": "Meine Suppe ... *schluchz* ... Wie kann das sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210302
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210302,
					"content": "(Geh leise weg ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7302104,
			"completionStepIds": [
				7302103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302103",
							"2"
						],
						"stepId": 7302103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapas",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730210401,
					"content": "... Oh, das ist Wasser aus der Flussquelle. „Lebendiges Quellwasser“ ist kalt und sauber, so wie das Mondlicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210402
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210402,
					"content": "Wenn Arachatora, Arasaka und Araphala mit diesem Wasser aufgewachsen wären, wären sie keine Dummköpfe wie jetzt. Nur Arapacati, meine Schwester ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210403
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210403,
					"content": "Ähem. Als Nächstes ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210404,
					"content": "Hä? Ach ja, als nächstes müsst ihr meine Suppe ersetzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210405
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210405,
					"content": "Unter der Anleitung von Arapas fügst du dem Wasser etwas Gemüse hinzu und beginnst zu kochen.\\nAllmählich beginnt ein angenehmer Duft dem Topf zu entsteigen.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730210406
					]
				},
				{
					"id": 730210406,
					"content": "Nachdem du fertig bist, probiert ihr die frisch zubereitete „Suppe“ zusammen.\\n... Sie entspricht den Erwartungen, zwar riecht sie sehr gut ...\\nDoch eine Gemüsesuppe ohne Gewürze ist viel zu fade.\\nSie schmeckt praktisch nach nichts.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730210407
					]
				},
				{
					"id": 730210407,
					"content": "Hehe, die „größte Delikatesse“ erfordert einen solchen Duft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210408
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210408,
					"content": "#Was denkst du, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210409,
						730210410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210409,
					"content": "Sie stillt den Durst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210411
					]
				},
				{
					"id": 730210411,
					"content": "Paimon findet, sie schmeckt besser, wenn wir Salz und Pfeffer dazugeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210412,
					"content": "Alles schmeckt besser mit Salz und Pfeffer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210413
					]
				},
				{
					"id": 730210413,
					"content": "Oh, Aramuhukunda! Ihr möchtet Salz dazugeben? Salz ist eine beängstigende Sache!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210414
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210414,
					"content": "Land mit Salz ist nicht fruchtbar. Aranara vertrocknen zu Samen ... und ihr möchtet Salz dazugeben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210415
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210415,
					"content": "Eine Suppe darf keinen Geschmack haben! Ihr Nara versteht nichts davon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210416
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210416,
					"content": "#Der Nara von damals hat uns folgendes gesagt, nachdem {F#er}{M#sie} die Suppe getrunken hatte:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210417
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210417,
					"content": "„Wir Nara, wenn Nara-Kinder nach Hause kommen, ist der Duft der Suppe das erste, was sie riechen. Das Aroma ist also alles, was eine Suppe braucht.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210418
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210418,
					"content": "#Danach lobte {F#er}{M#sie} meine Suppe. Ich erinnere mich daran. Deshalb glaube ich dir kein Wort!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210419
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210419,
					"content": "Aber der Duft alleine reicht nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210420,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210421
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210421,
					"content": "Hmpf, aber wenn ihr schon zum Utsava-Fest kommt, habt ihr bestimmt die Anerkennung von Araja und Arapacati gewonnen ... Dann versuchen wir uns an einer Suppe mit Geschmack.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210422
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210422,
					"content": "Bringt mir beim nächsten Mal besseres Wasser, die Suppe wird dann besser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210423
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210423,
					"content": "... Ich finde, das hat nichts mit dem Wasser zu tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210424
					]
				},
				{
					"id": 730210424,
					"content": "Wirklich? Aber meine „Kochausbildung“ ist trotzdem abgeschlossen. Warten wir das Utsava-Fest ab!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210425
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210425,
					"content": "Ich habe euch gezeigt, wie die Suppe geht. Der Geschmack genießt die Anerkennung des großen Nara, also übt gut! Denkt daran: Gutes Wasser ist das Geheimnis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210426
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210426,
					"content": "#({NICKNAME}, nächstes Mal würzen wir die Suppe ein wenig. Der Geschmack sollte dann ganz gut werden ...)",
