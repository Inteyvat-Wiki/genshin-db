			"dialogs": [
				{
					"id": 730210701,
					"content": "(Ein sehr großes Blatt, auf dem etwas in krakeliger Schrift aufgeschrieben wurde ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210702
					],
					"speakerTitle": "Blatt mit krakliger Handschrift"
				},
				{
					"id": 730210702,
					"content": "„... Das Blatt wurde zum siebzehnten Mal mit Frost überzogen. Nach mehreren Versuchen enthält das Wasser aus den Nebenflüssen immer noch Schlamm und hat einen erdigen Geruch. Nicht in Ordnung.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210703
					],
					"speakerTitle": "Blatt mit krakliger Handschrift"
				},
				{
					"id": 730210703,
					"content": "„... Das Blatt wurde zum dreißigsten Mal mit Frost überzogen. Es regnet schon wieder. Nicht in Ordnung.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210704
					],
					"speakerTitle": "Blatt mit krakliger Handschrift"
				},
				{
					"id": 730210704,
					"content": "„... Das Blatt wurde zum sechzigsten Mal mit Frost überzogen. Nach mehreren Versuchen duftet die Suppe mit Flusswasser sehr gut, hat aber ihre Makel. Nicht in Ordnung.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210705
					],
					"speakerTitle": "Blatt mit krakliger Handschrift"
				},
				{
					"id": 730210705,
					"content": "„... Das Blatt wurde zum achtzigsten Mal mit Frost überzogen. Als ich gerade die Suppe gemacht hatte, fing es an zu regnen. Zum Glück habe ich eine Mütze aufgesetzt. Hmm, die Wasserqualität ist nicht schlecht.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Blatt mit krakliger Handschrift"
