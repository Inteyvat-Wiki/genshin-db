				},
				{
					"id": 718030502,
					"content": "Diese Katze ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030503
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030503,
					"content": "Das könnte Gräupchen sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030504
					]
				},
				{
					"id": 718030504,
					"content": "Gib mir einen Moment, um die Merkmal zu überprüfen, die im Missionsauftrag stehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030505
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030505,
					"content": "Mal sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030506
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030506,
					"content": "Es kommt hin. Das scheint die Katze zu sein, nach der wir suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030508
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030508,
					"content": "Der Auftraggeber wird erfreut sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030509
					]
				},
				{
					"id": 718030509,
					"content": "Ha! Nach all den Geschehnissen geht es wieder um vermisste Katzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030510
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030510,
					"content": "Was soll ich dazu nur sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030511
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030511,
					"content": "Ich melde das dem Auftraggeber. Vielen Dank! Bitte nimm dies als Entschädigung für deine Mühe und deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030512
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030512,
					"content": "Hmm, der Auftraggeber dieser Katzenmission scheint umgezogen zu sein. Es wird eine Weile dauern, ihn zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030513
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030513,
					"content": "Ich kümmere mich inzwischen um den kleinen Streuner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030514
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030514,
					"content": "Miaumiau, miau!",
					"roleType": "TALK_ROLE_NPC",
