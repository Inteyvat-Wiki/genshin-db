			"dialogs": [
				{
					"id": 718030401,
					"content": "Hast du den Steinhaut-Lawachurl besiegt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030402,
						718030404
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030402,
					"content": "Ja klar, habe ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030403
					]
				},
				{
					"id": 718030403,
					"content": "Danke, damit hast du uns geholfen. Da diese Mission erledigt ist, haben wir einen Beweis für die Kompetenz der Gilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030404,
					"content": "Wir haben ihn besiegt und Gräupchen haben wir auch gefunden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030405
					]
				},
				{
					"id": 718030405,
					"content": "Danke, damit hast du uns geh... wie bitte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
