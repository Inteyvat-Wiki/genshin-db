			"dialogs": [
				{
					"id": 718030301,
					"content": "Miau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030302
					],
					"speakerTitle": "Gräupchen"
				},
				{
					"id": 718030302,
					"content": "Wie? Was hat eine Katze hier verloren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030303,
					"content": "Miau ... Miaaaauu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030304,
						718030308
					],
					"speakerTitle": "Gräupchen"
				},
				{
					"id": 718030304,
					"content": "Eine graue Katze ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030305
					]
				},
				{
					"id": 718030305,
					"content": "Eine graute Katze, verirrt in der Wildnis ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030306,
					"content": "Ah, Lan erwähnte eine Suchmission nach einer grauen Katze. Vielleicht ist sie das! Paimon fällt ein, dass sie Ash oder so genannt wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030307,
					"content": "Wer hätte gedacht, dass wir sie hier finden ... Hat sie sich die ganze Zeit hier versteckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030311,
					"content": "Der Steinhaut-Lawachurl hat wohl alle von hier ferngehalten, und da sie zu ängstlich war, um zu verschwinden, hat sie sich hier versteckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030312,
					"content": "Was für ein Glück, dass wir aufgetaucht sind, sonst hätte sie hier noch lange gewartet, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030313,
					"content": "Miau ... Miau, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030314,
						718030317
					],
					"speakerTitle": "Gräupchen"
				},
				{
					"id": 718030314,
					"content": "Miau ... Miaaaauu ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030315
					]
				},
				{
					"id": 718030315,
					"content": "He, was machst du da? Paimon denkt nicht, dass sie dich verstehen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030316,
					"content": "Bringen wir sie zurück zu Lan, sie kann die Katze dann ihrem Besitzer zurückbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030319,
					"content": "Miau ... Miau, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030320,
						718030322
					],
					"speakerTitle": "Gräupchen"
				},
				{
					"id": 718030320,
					"content": "Miau ... Miau, miau!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030321
					]
				},
				{
					"id": 718030321,
					"content": "Oh, komm schon. Sie wird dich nicht verstehen, wie sehr du sie auch imitierst. Bringen wir sie schnell zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030322,
					"content": "Sie scheint einverstanden zu sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030323
					]
				},
				{
					"id": 718030323,
					"content": "Wie hast du ... egal. Bringen wir sie zurück zu Lan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030317,
					"content": "Bringen wir die Katze zu Lan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030318
					]
				},
				{
					"id": 718030318,
					"content": "Jupp, mehr können wir nicht tun. Sie wird die Katze zum Auftraggeber bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030308,
					"content": "Vielleicht ist es Gräupchen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030309
					]
				},
				{
					"id": 718030309,
					"content": "Eine graute Katze, verirrt in der Wildnis ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030310,
					"content": "Richtig! Lan hat diese Suchmission erwähnt, nicht wahr? Hmm. Wer hätte gedacht, dass wir sie hier finden ... Hat sie sich die ganze Zeit hier versteckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "Paimon"
				}
			]
		},
