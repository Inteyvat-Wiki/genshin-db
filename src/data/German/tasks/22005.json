			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bao’er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220050101,
					"content": "Wo ist sie nur ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050102
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220050102,
					"content": "Was machst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050103
					]
				},
				{
					"id": 220050103,
					"content": "Huch! Wo kommst du denn plötzlich her? So ganz ohne Geräusche ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050104
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220050104,
					"content": "Ich? Ich bin ein Gelehrter, der die Gebäude und Hinterlassenschaften des Altertums auf der Guili-Ebene untersucht. Ich heiße Bao’er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050105
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220050105,
					"content": "Unglücklicherweise war ich so in meine Recherche vertieft, dass ich meine Tasche dabei verloren habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050106
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220050106,
					"content": "Darin befand sich ein Schatz, ein kulturelles Relikt, welches nicht leicht zu finden war. Wärest du bereit mir bei der Suche zu helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050107,
						220050108,
						220050109
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220050107,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050110
					]
				},
				{
					"id": 220050110,
					"content": "Wunderbar, ich muss sie ganz hier in der Nähe verloren haben, oder vielleicht doch ein bisschen weiter weg ... Jedenfalls sei bitte vorsichtig bei der Suche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220050108,
					"content": "Wie sieht denn die Tasche aus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050111
					]
				},
				{
					"id": 220050111,
					"content": "Es ist eine ganz gewöhnliche Tasche die man im Alltag auch benutzt, eine viereckige Schachtelförmige.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050112
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220050112,
					"content": "Warum ich so eine Verpackung für ein kulturelles Relikt verwendet habe? Nun weil ... so eine Verpackung eben praktisch ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050113
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220050113,
					"content": "Außerdem, habe ich doch mehrere Lagen Kleidung darum gewickelt, sodass das Relikt nicht beschädigt wird. Bitte hilf mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220050109,
					"content": "Was ist es denn für ein Relikt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050114
					]
				},
				{
					"id": 220050114,
					"content": "Ja, es ist alles in allem ein sehr wertvolles Relikt, hach! Was rede ich, du verstehst das ja doch nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050115
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220050115,
					"content": "Nur ein Profi wie ich kann den wahren Wert schätzen. Bitte hilf mir doch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao’er"
				}
			]
		},
