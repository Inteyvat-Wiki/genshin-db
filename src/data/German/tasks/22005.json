				{
					"id": 220050301,
					"content": "Hast du sie gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050302
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220050302,
					"content": "Ist sie das?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050303
					]
				},
				{
					"id": 220050303,
					"content": "Dieses Paket, es sieht nicht danach aus ... Es fühlt sich auch viel leichter an, der Inhalt ist bestimmt nicht mein Schatz ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050304
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220050304,
					"content": "Dennoch danke ich dir für deine Mühe. Ich werde selbst noch einmal suchen gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050305
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220050305,
					"content": "Wo hab ich sie nur verloren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao’er"
