			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071101,
					"content": "#Ich bin eine{M#r} der Elf, die „Marionette“!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071102
					]
				},
				{
					"id": 761071102,
					"content": "Was? W... Warte mal, so machen wir das jetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071103,
					"content": "Pah! Deine Dreistigkeit ist schon bewundernswert, das muss ich dir lassen. Aber wenn du glaubst, dass du mit so einer plumpen Lüge davonkommst, unterschätzt du uns Fatui ganz gewaltig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610712,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071201,
					"content": "#Ich bin ein{F#e} von der „Marionette“ ... speziell beauftragte{M#r} Forscher{F#in}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071202
					]
				},
				{
					"id": 761071202,
					"content": "#„Speziell beauftragte{M#r} Forscher{F#in}“? Die „Marionette“ hat ihre Forschung über Maschinen und Kuuvahki bereits zur Perfektion vollendet. Irgendwie schwer zu glauben, dass sie noch externe Forscher anheuert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610713,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071301,
					"content": "Wissenschaftlicher Fortschritt beruht auf Zusammenarbeit, das solltest du eigentlich wissen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071302
					]
				},
				{
					"id": 761071302,
					"content": "Hmm ... wo du recht hast ... Ich selbst habe dabei geholfen, einige Forschungsunterlagen aus dem Forschungsinstitut Fontaine für sie zusammenzutragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071303
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071303,
					"content": "#Aber da du ja {F#die Expertin}{M#der Experte} auf dem Gebiet bist, nehme ich mal an, dass es für dich ein Kinderspiel sein wird, die Fehlfunktion des Patrouillenboots zu beheben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071401,
					"content": "Nun ... Ich fürchte, mein Forschungsschwerpunkt ist eher theoretischer Natur ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071402
					]
				},
				{
					"id": 761071402,
					"content": "Oh, verstehe! Die Kuuvahki-Theorie ist ein sehr tiefgehendes Studiengebiet, echt beeindruckend! Im Vergleich dazu ist das Reparieren eines Patrouillenboots viel praxisorientierter. Tja, völlig unterschiedliche Disziplinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071403
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071403,
					"content": "Allerdings ist die „Marionette“ gerade nicht hier. Du kannst erst mal zu Kommandantin Azalea gehen. Sie wird schon wissen, was zu tun ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610715,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071501,
					"content": "Klar, überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071502
					]
				},
				{
					"id": 761071502,
					"content": "Du verpasst dem Patrouillenboot ein paar kräftige Schläge. *kling* *klang* *klong* ... und schon rührt sich nichts mehr.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761071503
					]
				},
				{
					"id": 761071503,
					"content": "Es ist ... total hinüber ... Und was machen wir jetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071504,
					"content": "HA! Ich wusste von Anfang an, dass mit dir was nicht stimmt. Ein echter Forscher würde niemals solche haarsträubenden Behauptungen aufstellen. Du bist eindeutig ein Hochstapler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610716,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071601,
					"content": "#Man könnte auch sagen, ich bin quasi ihr{F#e} Mentor{F#in}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071602
					]
				},
				{
					"id": 761071602,
					"content": "Oh! Apropos, ich habe ihr selbst dabei geholfen, einige Forschungsunterlagen des Forschungsinstituts Fontaine zusammenzustellen. Dabei sprach sie in den höchsten Tönen von den Forschungsergebnissen von Doktor Mosso. Warte mal ... Du bist doch nicht etwa ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071603
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071603,
					"content": "*räusper* ... Nun ja ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071604
					]
				},
				{
					"id": 761071604,
					"content": "J... Ja, genau, dein Ruf ist dir mal wieder vorausgeeilt, Doktor Mosso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071605,
					"content": "Pah, zufällig weiß ich, dass Doktor Mosso schon vor dreißig Jahren verstorben ist. Aber du kannst ihm gern nachfolgen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610717,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
