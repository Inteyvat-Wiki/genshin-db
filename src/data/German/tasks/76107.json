			"dialogs": [
				{
					"id": 761071001,
					"content": "Wer bist du? Was machst du hier? Die Frachtmannschaft sollte doch unten am Hafen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610711,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
