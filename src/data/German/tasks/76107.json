				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071701,
					"content": "Ha, ich spiele nicht nach den Regeln der Fatui!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071702
					]
				},
				{
					"id": 761071702,
					"content": "Wenn du dich nicht an die Regeln hältst, dann verschwinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610718,
