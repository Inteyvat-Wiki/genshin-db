				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071901,
					"content": "Tatsächlich habe ich hier was zu tun. Ich hätte gern einen kleinen Übungskampf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071902
					]
				},
				{
					"id": 761071902,
					"content": "#Einen Übungskampf? Meintest du nicht, du wärst {F#eine externe Forscherin}{M#ein externer Forscher}? Jetzt, da ich so darüber nachdenke, kann ich mich nicht erinnern, dass die „Marionette“ jemals einen Forscher eingestellt hat ... Warte! Du bist ein{F#e} Spion{F#in}, nicht wahr? Dann mach dich bereit, zu sterben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610720,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
