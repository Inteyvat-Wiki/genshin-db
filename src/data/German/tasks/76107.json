				"points": []
			},
			"dialogs": [
				{
					"id": 761071801,
					"content": "Dies hier ist ein militärisches Sperrgebiet. Wenn du hier nichts anderes zu tun hast, verschwinde so schnell wie möglich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610719,
