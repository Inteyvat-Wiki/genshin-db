					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761072001,
					"content": "Tut mir leid, ich hab mich wohl verlaufen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761072002
					]
				},
				{
					"id": 761072002,
					"content": "Du kommst entweder über den Hafen oder durch das Haupttor raus. Kommandantin Azalea sorgt hier für strenge Sicherheitsvorkehrungen und die gelten auch für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		}
