			},
			"dialogs": [
				{
					"id": 752190101,
					"content": "#Ah ... {NICKNAME}, bist du das da drüben? Bitte warte einen Moment!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190102
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190102,
					"content": "Hier ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190103
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190103,
					"content": "Oh, was ist los? Kann ich dir irgendwie helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190104,
					"content": "Haha, nein, hier ist ein Eilpaket für euch. Was für ein Zufall, ich habe gerade überlegt, wo ich euch antreffen könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190105
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190105,
					"content": "Wenn man vom Teufel spricht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190106
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190106,
					"content": "Uii, wer hat das wohl geschickt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190107,
					"content": "Das ist ein Paket, das einen langen Weg hierher zurückgelegt hat. Es ist durch zig Hände gegangen, von der Abenteurergilde über die Nachkommen der Baumkrone bis hierher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190108
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190108,
					"content": "Die Lage in Natlan war zuletzt ziemlich speziell und der normale Warenverkehr war eine Weile ausgesetzt. Es gibt keinen Absender, aber der Stempel ... der sieht aus, als käme er aus Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190109
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190109,
					"content": "Anscheinend habt ihr in Fontaine ja auch einige Freunde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190110,
						752190111
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190110,
					"content": "Na gut, ich nehme es an.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				},
				{
					"id": 752190111,
					"content": "Ja, immer her damit!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				},
				{
					"id": 752190112,
					"content": "Ah, der Pyro-Archon sei gepriesen! Ich habe gerade erst das Paket übernommen und den Empfänger gleich gefunden. Der Arbeitstag fängt richtig gut an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190113
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190113,
					"content": "Gut, ich gehe jetzt die anderen Sachen ausliefern. Ich wünsche euch noch einen schönen Tag!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190114
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190114,
					"content": "Alles klar, dir auch viel Erfolg bei der Arbeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190115,
					"content": "Hm, es ist aus Fontaine. Es wirkt ganz leicht, mehr wie ein Brief als ein richtiges Paket.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190116,
					"content": "Komm, wir machen es gleich auf und schauen nach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190117,
					"content": "Ah, es ist von Charlotte! Das sind wohl das Bild, das wir beim Abschied aus Fontaine gemacht haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190118,
					"content": "Es ist eigentlich gar nicht lange her, dass das Foto gemacht wurde, aber es fühlt sich an, als wäre eine Ewigkeit vergangen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190119,
					"content": "Hehe, dieses Bild sollten wir gut aufbewahren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}