				"objectNames": [
					"„Neko“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220460101,
					"content": "Der Schrein ist unordentlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460102
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220460102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460103
					]
				},
				{
					"id": 220460103,
					"content": "Aha, genau zur richtigen Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460104
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220460104,
					"content": "Es ist seit einiger Zeit nicht mehr geputzt worden und es gab wieder viele Flecken rund um den Schrein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460105
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220460105,
					"content": "So kann man nicht die Menschen empfangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460106
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220460106,
					"content": "Kannst du mir wie beim letzten Mal wieder helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460107,
						220460112
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220460107,
					"content": "Wo sind Taisuke und Etsuko? Sie sind doch dafür da.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460108
					]
				},
				{
					"id": 220460108,
					"content": "Ich werde mir nicht die Mühe machen, mit den beiden grünen Menschen zu reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460109
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220460109,
					"content": "Dieser große Mensch sieht mich immer komisch an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460110
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220460110,
					"content": "Dieser andere grüne Mensch scheint faul zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460111
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220460111,
					"content": "Wie auch immer, es sind nicht zuverlässige Menschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460115
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220460115,
					"content": "Na ja, ich brauche also deine Hilfe. Wie letztes Mal, benutze Knüppel und Wasser, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460116,
						220460117
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220460116,
					"content": "Alles klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460118,
					"content": "Also, vielen Dank im Voraus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460119
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220460119,
					"content": "Ich warte hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220460117,
					"content": "Ich verstehe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460112,
					"content": "Was ist mit Ooshima ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460113
					]
				},
				{
					"id": 220460113,
					"content": "Der Stein-Mensch ist immer beschäftigt. Er scheint ständig auf etwas herumzuklopfen. Wer weiß, was er da macht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460114
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220460114,
					"content": "Seine Arbeit scheint schon fertig zu sein, aber irgendwie macht er dennoch weiter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460115
					],
					"speakerTitle": "„Neko“"
				}
			]
		},
