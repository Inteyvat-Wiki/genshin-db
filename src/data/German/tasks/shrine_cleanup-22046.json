			"dialogs": [
				{
					"id": 220460301,
					"content": "Seid ihr fertig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460302
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220460302,
					"content": "Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460303
					]
				},
				{
					"id": 220460303,
					"content": "Gut, ihr seid zuverlässig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460304
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220460304,
					"content": "Der Schrein wird auch immer lebendiger. Hibiki wird sich freuen, wenn sie zurückkommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460305
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220460305,
					"content": "Ich muss auch alles perfekt vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				}
			]
		}
	]
