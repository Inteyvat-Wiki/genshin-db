						"pointId": 7528
					},
					{
						"sceneId": 3,
						"position": [
							3582.002,
							435.073,
							4514.881
						],
						"pointId": 7529
					}
				]
			},
			"dialogs": [
				{
					"id": 741540701,
					"content": "Genau wie ich dachte. So hartnäckig wie ihr seid, würdet ihr es nicht so einfach auf sich beruhen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540702
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540702,
					"content": "Ich dachte, ihr würdet die Maison Gardiennage über uns informieren, aber das habt ihr nicht. Sieht aus, als hättet ihr eure eigenen Absichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540703,
						741540704
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540703,
					"content": "Warum habt ihr Benoit hier eingesperrt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				},
				{
					"id": 741540705,
					"content": "Ehrlich gesagt, habt ihr mich schon ziemlich beeindruckt. Wenn ihr euren Enthusiasmus nur besser einsetzen würdet, hättet ihr etwas Großes erreichen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540706
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540706,
					"content": "Es ist nur schade, dass ihr euch für das falsche Thema interessiert. *seufz* Ihr habt wirklich keine Angst vor dem Tod, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540707
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540707,
					"content": "#Du legst dich hier mit {F#der Falschen}{M#dem Falschen} an.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540708
					]
				},
				{
					"id": 741540708,
					"content": "Du scheinst überhaupt nicht zu wissen, in was für eine Situation ihr euch gebracht habt. Oder glaubst du, dass ihr auf der Seite der Gerechtigkeit steht und ihr deshalb in Sicherheit seid?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540709
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540709,
					"content": "Übrigens, was den ertrunkenen Kaufmann aus der Geschichte angeht ... Sein Name war Brandt, ein Mann, der zu reden verstand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540710
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540710,
					"content": "Aber wisst ihr was? Der Zeitung zufolge stellte sich heraus, dass er gar nicht ertrunken war, sondern in Wirklichkeit ermordet und in den See geworfen wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540711
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540711,
					"content": "Das Maréchaussée-Phantom hat lange Zeit in seinem Fall ermittelt, konnte aber nur feststellen, dass er ermordet wurde und der Mörder sich eines abscheulichen Verbrechens schuldig gemacht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540712
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540712,
					"content": "Also schreiben die Reporter dasselbe in die Zeitungen. Aber was ist wirklich passiert? Wer von ihnen hat den Tod mehr verdient, der Mörder oder das Opfer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540713
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540713,
					"content": "Hm, eine schwierige Frage ... Ich kann dir noch keine Antwort geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540714
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540714,
					"content": "Wie auch immer, ich bin abgeschweift. Das hat nichts mit dem zu tun, was wir diskutieren müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540715
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540715,
					"content": "Was meinst du also eigentlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540716,
					"content": "Ich will damit sagen, dass leichtsinniges Handeln, bevor man eine Situation vollständig verstanden hat, töricht ist und unerwünschte Folgen haben kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540717,
						741540718
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540717,
					"content": "Nichts zu tun, nachdem man Zeuge von Ungerechtigkeit geworden ist, ist wahre Torheit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540719,
					"content": "Haha ... Wenn wir uns unter anderen Umständen kennengelernt hätten, wären wir vielleicht Freunde geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540720
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540720,
					"content": "Auch wenn mir deine Meinung gefällt, muss ich noch einiges erledigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540721
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540721,
					"content": "Das ist das letzte Mal, dass ich geduldig sein werde. Wenn ich euch das nächste Mal in der Nähe meines Hauses sehe, werde ich tun, was ich tun muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540722
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540722,
					"content": "Athos murmelt etwas Unverständliches und geht.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540723
					]
				},
				{
					"id": 741540723,
					"content": "Sein merkwürdiges Verhalten hat dich überrascht. Du fragst dich, welche Haltung du in dieser Angelegenheit einnehmen solltest ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540724
					]
				},
				{
					"id": 741540724,
					"content": "Plötzlich hörst du ein leises Klopfen vom Fenster auf der Rückseite des Hauses und dann, nach einem kaum hörbaren Knarren, wird ein Zettel hinausgeworfen ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540725
					]
				},
				{
					"id": 741540725,
					"content": "Auf dem Zettel ist braune Schrift zu sehen. Es sieht aus, als hätte jemand in großer Eile mit Kaffee als Tinte geschrieben ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540726
					]
				},
				{
					"id": 741540726,
					"content": "Schnell, schau nach, was da steht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540727,
					"content": "Das ist von Benoit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540728,
					"content": "Psst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540729
					]
				},
				{
					"id": 741540729,
					"content": "... Tut Paimon leid! Wie auch immer, lass uns den Katzennapf im Auge behalten und auf sein Signal warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540718,
					"content": "Nichts zu tun, nachdem ich Zeuge von Ungerechtigkeit geworden bin, ist nicht meine Art.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540704,
					"content": "Was ist eure wahre Beziehung zu Benoit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				}
			]
		},
