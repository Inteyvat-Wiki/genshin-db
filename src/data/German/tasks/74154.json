			},
			"dialogs": [
				{
					"id": 741540201,
					"content": "Da ist was faul, da ist wirklich was faul ... Sogar Paimon merkt, dass hier etwas faul ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540202,
					"content": "#{NICKNAME}, du bist klüger, was sollen wir jetzt tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540203,
						741540204,
						741540205,
						741540206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540203,
					"content": "Benoit braucht Hilfe, besteht aber darauf, dass er keine braucht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540207,
					"content": "Wie wäre es dann, wenn wir uns noch einmal in der Nähe von Benoits Haus umsähen? War da nicht eine seltsame Kiste am Fenster auf der Rückseite des Hauses?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540208,
					"content": "Paimon glaubt, dass etwas darin versteckt sein muss. Vielleicht sogar die Beweise, nach denen du suchst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540204,
					"content": "Dieses Paar könnte vom Fleuve Cendré stammen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540205,
					"content": "Ihren Reaktionen nach zu urteilen, gibt es wahrscheinlich etwas Wichtiges, das wir noch nicht wissen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540206,
					"content": "Ich habe einige Theorien, aber ich brauche mehr Beweise.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				}
			]
		},
