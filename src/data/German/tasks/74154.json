					}
				]
			},
			"dialogs": [
				{
					"id": 741540801,
					"content": "#{NICKNAME}, schau! Der Fisch ist frisch und auch der Boden sieht sauber aus. Da hat wohl jemand gerade saubergemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540802,
					"content": "Es muss sicher jemand in Benoits Haus sein. Lass uns rübergehen und lauschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540803,
					"content": "... Er hat recht, er kann nicht einfach für immer verschwinden. Zumindest muss er ab und zu von Menschen gesehen werden. Lass ihn irgendwann mal spazieren gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540804
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540804,
					"content": "Zumindest wird es die Nachbarn davon abhalten, es der Maison Gardiennage zu melden. Ich möchte die Musketiertruppe nicht hier haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540805
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540805,
					"content": "Vater, du willst wirklich spazieren gehen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540806
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540806,
					"content": "D... Darf ich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540807
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540807,
					"content": "Natürlich! Wir würden uns freuen, mit dir zusammen einen Spaziergang zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540808
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540808,
					"content": "Pass auf, dass er das nicht als Anlass nimmt, um Hilfe zu rufen. Diese beiden Verrückten haben diesen Ort schon die ganze Zeit beobachtet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540809
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540809,
					"content": "Vater wird das sicher nicht tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540810
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540810,
					"content": "Vater, willst du, dass die Maison Gardiennage weiß, dass ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540811
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540811,
					"content": "... Dass was?! Warum sprechen sie so leise? Paimon kann nichts hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540812,
					"content": "Sie kommen gleich heraus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540813
					]
				},
				{
					"id": 741540813,
					"content": "Na gut, dann gehen wir erst einmal weiter. Dieses Mal müssen wir einen Weg finden, um mit Benoit zu sprechen, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540814,
					"content": "Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540815
					]
				},
				{
					"id": 741540815,
					"content": "Klar, dann mal los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540816,
					"content": "Wie geht es dir, Vater? Geht es dir jetzt besser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540817
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540817,
					"content": "Ihr seid es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540818
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540818,
					"content": "Benoit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540819,
					"content": "... Helft mir! Nein ... Nein, helft mir nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540820
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540820,
					"content": "Was sagst du da, Vater? Wer hilft wem? Hehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540821
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540821,
					"content": "Ach, ihr seid es. Kein Wunder, dass Vater versucht hat, mit euch zu sprechen. Ihr kennt euch ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540822
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540822,
					"content": "... Nein, nein! Wir kennen uns überhaupt nicht ... überhaupt nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540823
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540823,
					"content": "Nein? Aber anscheinend warten sie hier auf dich, Vater.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540824
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540824,
					"content": "Sie haben die Papiere für uns gesammelt. Sie sind sogar zum Fleuve Cendré gegangen, um mit unserem alten Nachbarn Snodgrass zu sprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540825
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540825,
					"content": "Also dachte ich, ihr müsst euch sehr nahestehen! Du hast Kinder schon immer geliebt, nicht wahr, Vater?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540826
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540826,
					"content": "Ich liebe Kinder auch! Aber ich bin nicht so großzügig wie mein Vater. Ich liebe mein eigenes Kind am meisten, aber es ist ... verschwunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540827,
						741540829
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540827,
					"content": "Was wollt ihr eigentlich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540828
					]
				},
				{
					"id": 741540828,
					"content": "Athos und ich sind die Kinder unseres Vaters. Unser Vater liebt uns und wir lieben ihn auch. Ist das nicht offensichtlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540831
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540831,
					"content": "Morticia, schau mal, wie schön das Wetter ist. Perfekt für einen Spaziergang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540832
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540832,
					"content": "Ja, Athos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540833
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540833,
					"content": "Hast du die heutige Ausgabe vom Dampfvogel gelesen? Da gibt es einige interessante Geschichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540834
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540834,
					"content": "Nein, noch nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540835
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540835,
					"content": "In einer Geschichte geht es um einen alten Mann, der auf tragische Weise sein Leben verlor. Es heißt, dass er bei einem Spaziergang Räubern begegnete, ohne dass jemand auf ihn aufpasste, und schließlich von einer Klippe stürzte und starb.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540836
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540836,
					"content": "Ach, wirklich? Das ist ja furchtbar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540837
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540837,
					"content": "Und eine andere Geschichte erzählt von einem unglücklichen Kaufmann, der ertrunken ist. Es scheint, dass er zu viel getrunken hat und im Vollrausch in einen See gelaufen ist. Dann ist er einfach so ertrunken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540838
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540838,
					"content": "Meine Güte! Das ist wirklich Pech!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540839
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540839,
					"content": "#Und die letzte Geschichte ist besonders interessant. Es geht um {M#einen aufdringlichen Wichtigtuer, der}{F#eine aufdringliche Wichtigtuerin, die} einfach nicht aufhören konnte, sich in die Angelegenheiten anderer Leute einzumischen. *seufz* {M#Er}{F#Sie} hat versehentlich die falsche Medizin genommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540840
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540840,
					"content": "#{M#Er}{F#Sie} verwechselte Gift mit {M#seiner}{F#ihrer} Medizin und schluckte das Ganze. Es heißt, dass es ein ziemlich schmerzhafter Tod war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540841
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540841,
					"content": "Oje! Es gibt wirklich so viele Arten zu sterben. Bitte, erzähl weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540842
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540842,
					"content": "... Entschuldigung, Entschuldigung, ich werde das nie wieder tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540843
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540843,
					"content": "Was redest du denn da, Vater? Du brauchst dich für nichts zu entschuldigen. Aber ... du musst müde sein, nachdem du so viel herumgelaufen bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540844
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540844,
					"content": "Athos, warum gehen wir nicht zurück und lesen Vater die Zeitung vor? Du hast doch sehr viele Zeitungen abonniert, nicht wahr, Vater?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540845
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540845,
					"content": "Ja, wir haben jetzt lange genug geplaudert. Wir sollten jetzt zurückgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540846
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540846,
					"content": "Lass uns gemeinsam zurückgehen, mein lieber Vater.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540829,
					"content": "Warum tut ihr das?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540830
					]
				},
				{
					"id": 741540830,
					"content": "Meinst du, warum wir unseren Vater bei einem Spaziergang begleiten? Das ist doch unsere Pflicht als seine Kinder, nicht wahr? Das ist das Mindeste, was wir tun können, um uns für die Fürsorge zu revanchieren, die er uns entgegengebracht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540831
					],
					"speakerTitle": "Morticia"
				}
			]
		}
	]
}