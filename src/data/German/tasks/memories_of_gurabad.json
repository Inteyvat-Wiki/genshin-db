			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050401,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050402
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050402,
					"content": "Ähm ... Liloupar, geht es dir gut? Warum bist du so still?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050403,
						733050404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050403,
					"content": "Pst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				},
				{
					"id": 733050405,
					"content": "Warte mal ... Siehst du? Sie leuchtet! Das ist ziemlich ungewöhnlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050406,
					"content": "Die Zauberflasche des Dschinn schimmert und scheint im Einklang mit der Vibration der „Schachfigur“ zu sein.\\nDu hörst das Vergehen der Zeit, wie Wassertropfen in einem Gefängnis ... Es schien ein Leben lang zu dauern, oder nur einen Augenblick.\\nLiloupar hat kein Wort gesagt.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050407
					]
				},
				{
					"id": 733050407,
					"content": "Und dann, aus dem Nebel heraus, siehst du eine riesige Stadt, riesig, aufgebläht und kalt.\\nDie Erde öffnete eine Spalte und verschluckte alles in Gurabad ...\\nUnd da war das Tor, das in die Bergwände eingelassen war. Es war so hässlich, dass es den ganzen Schmutz der alten Welt zu enthalten schien, aber irgendwie war es den Blicken der Menschen entgangen ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050408
					]
				},
				{
					"id": 733050408,
					"content": "Das da drüben ist Gurabad. Jetzt erinnere ich mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050409
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050409,
					"content": "Mein Kopf tut weh ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050410
					]
				},
				{
					"id": 733050410,
					"content": "Waaah, was ist denn mit euch los ... Sagt Paimon das nächste Mal vorher Bescheid! Paimon mag es nicht, ständig erschrocken zu werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050411,
						733050413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050411,
					"content": "Entschuldigung, Paimon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050412
					]
				},
				{
					"id": 733050412,
					"content": "Tja, Paimon ist sowieso sauer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050415,
					"content": "#Hehe ... so wie ein kleines Kind. Nun, kein Grund zur Sorge, Kleine. Ich werde {M#ihn}{F#sie} dir zurückgeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050416
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050416,
					"content": "#Wenn die Zeit gekommen ist, wird {M#er}{F#sie} dich mit viel leckeren Essen entschädigen ... Und mit „Mura“, eurer Währung, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050417,
						733050418
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050417,
					"content": "Es heißt „Mora“ ... Moment, warum sollte ich dich korrigieren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050419,
					"content": "Das hört sich schon besser an ... Paimon wird es nicht vergessen! Leckeres Essen und Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050420,
					"content": "#Gut, Schluss mit der Spielzeit. Lasst uns nach Gurabad gehen, {F#meine Herrin}{M#mein Herr}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050421,
						733050424
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050421,
					"content": "Warum müssen wir dort hingehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050422
					]
				},
				{
					"id": 733050422,
					"content": "#Warum? Ich weiß es nicht ... Vielleicht ist der Grund auch egal, aber ich muss da sein. Also, {F#meine Herrin}{M#mein Herr} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050423
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050423,
					"content": "Wenn ich einen Grund nennen müsste, dann wäre es so: Ich möchte, dass du meine Vergangenheit und meine Lektionen kennenlernst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050428,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050429,
					"content": "Deine Worte sind irgendwie unlogisch ... Paimon versteht es nicht, aber was du sagst, klingt wie ein Abschied. Ist etwas Schlimmes passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050430,
					"content": "Haha, nein ... Es ist nur so, dass es einige Dinge gibt, die ihr selbst sehen solltet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050431
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050431,
					"content": "Und was ist es? Wovon redest du überhaupt?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050432,
					"content": "Wie auch immer, bitte folge mir, ich zeige dir die Lage von Gurabad ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050424,
					"content": "Gurabad ... Was gibt es dort?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050425
					]
				},
				{
					"id": 733050425,
					"content": "Nichts, nichts übrig geblieben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050426
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050426,
					"content": "Alles, was bleibt, sind Erinnerungen der Geister, zerbrochene Träume, die nicht wiederhergestellt werden können, und der süße Geschmack der Rache ... So würde ich sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050427
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050427,
					"content": "Das scheint ein bisschen viel verlangt zu sein ... Aber ich möchte, dass du meine Vergangenheit und meine Lektionen kennenlernst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050418,
					"content": "Triff keine Entscheidungen für mich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050413,
					"content": "Mir geht’s gut, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050414
					]
				},
				{
					"id": 733050414,
					"content": "Hmpf, das sagst du jedes Mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050404,
					"content": "Liloupar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				}
			]
		},
