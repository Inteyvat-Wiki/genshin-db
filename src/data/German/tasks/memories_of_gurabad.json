			"dialogs": [
				{
					"id": 733052201,
					"content": "Bitte verbinde mich mit der „Schachfigur“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052202
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733052202,
					"content": "Ver... Verbinden? Was soll das heißen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733052203,
					"content": "Suche den Vorsprung auf ihrer Oberfläche und stecke ihn in den Steckplatz meiner Flasche. So einfach ist das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052204
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733052204,
					"content": "Ähm ... Gibt es so etwas wirklich? Aber deine Flasche sieht ziemlich glatt aus ... Es gibt keinen Steckplatz, um ihn einzustecken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733052205,
					"content": "Es ist nur so, dass du es nicht sehen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052206
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733052206,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733052207,
					"content": "Weil ich es mir gerade ausgedacht habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052208
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733052208,
					"content": "Oh ... He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733052209,
					"content": "#Haha ... Na gut, keine Witze mehr. {F#Meine Herrin}{M#Mein Herr}, du musst mich nur nehmen und die „Schachfigur“ berühren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
