				"points": []
			},
			"dialogs": [
				{
					"id": 733050601,
					"content": "Waah! Wir waren gerade noch neben der „Schachfigur“ und plötzlich sind wir hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050602,
					"content": "Wie konnte das passieren? Es ist großartig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050603,
					"content": "Hehe, willst du das nochmal machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050604,
						733050606
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050604,
					"content": "Nochmal, nochmal!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050605
					]
				},
				{
					"id": 733050605,
					"content": "He, halte dich zurück! Sei nicht so kindisch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050608,
					"content": "Das ist normal. Die Koordinaten werden abgelenkt. Wahrscheinlich wegen der Alterung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050609
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050609,
					"content": "He ... Ist das nicht die Schlucht, in der wir zuerst gekommen sind? Warum bringst du uns hierher? Gibt es hier irgendetwas Sehenswertes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050610,
					"content": "Du hast zu viele Fragen, Kleine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050611
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050611,
					"content": "Seltsam ... Es sollte doch hier sein ... Ah, hier ist es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050606,
					"content": "Nein, mir ist etwas schwindlig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050607
					]
				},
				{
					"id": 733050607,
					"content": "Ja ... wie du es sagst ... Paimon fühlt sich auch ein wenig benebelt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050608
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7330509,
			"completionStepIds": [
				7330509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330509",
							"2"
						],
						"stepId": 7330509,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330510",
							"3"
						],
						"stepId": 7330510,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050901,
					"content": "Als das glitzernde Fragment in die Zauberflasche von Liloupar eindrang, spürst du, wie dir ein Teil deiner Kraft entzogen wurde ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050902
					]
				},
				{
					"id": 733050902,
					"content": "„Shiruyeh ist Khorramdin.“\\nSagte der Mann mit der Messingmaske.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050903
					]
				},
				{
					"id": 733050903,
					"content": "„Wer deinen Namen trägt, wird keinen Erben haben. Ich werde die vielen Götzen im Tempel deiner Götter zerstören. Ich werde dich wegen deiner Niedertracht ins Grab bringen.“\\nSagte der Mann mit der Messingmaske.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050904
					]
				},
				{
					"id": 733050904,
					"content": "Aus dem verstörten Blick des Dschinn siehst du, wie Gurabad in Dunkelheit gehüllt war ...\\nGurabad war lange Zeit ein Wasserreservoir, aber jetzt fliehen ihre Bewohner wie eine Flut.\\nDie besinnungslosen Dschinn brechen aus den kalten Maschinen und den Waffen der Soldaten hervor ... Und überall gibt es zinnoberroten Wein und Granatapfelsaft ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050905
					]
				},
				{
					"id": 733050905,
					"content": "Die Granatäpfel werden zerbrochen und zerdrückt und zu einer matschigen Masse zertrampelt ... Prall oder verdorrt, reich oder bescheiden ... Die scharlachroten Früchte verkünden die Ankunft Khorramdins – die Freude am Leben und den Jubel über die Rache.\\nDer Saft schmeckt so süß und weich wie süßer Wein, er fließt durch die Stadt und verwandelt sich in ein rotes Meer ...\\nDas Meer ertränkt zuerst die Sklaven, dann heulen und schreien ihre Herren, während sie auf dem Ozean der Nacht treiben.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050906
					]
				},
				{
					"id": 733050906,
					"content": "Schließlich siehst du den König mit der Messingmaske. Er flieht in die Schatten, in die Arme von Shirin ... \\nIhr Gesicht ist alt und trübe, und die Spuren von Leben und Verstand verschwinden wie Staub im Nachtwind.\\nAuch König Kisra, der sich in ein schwarzes Monster verwandelt hat ... Sie sind alle von deinem Blut und doch freust du dich darüber ... Du freust dich über deine Strafe.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050907
					]
				},
				{
					"id": 733050907,
					"content": "O Gurabad, deine Wunde ist nicht zu heilen, deine Schande ist für alle zu sehen ...\\nDiejenigen, die die Nachricht hören, werden klatschen und vor Freude schreien ...\\nDenn wer hat nicht unter deiner endlosen Tyrannei gelitten?",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050908
					]
				},
				{
					"id": 733050908,
					"content": "„O Gurabad, deine Wunde ist nicht zu heilen, deine Schande ist für alle zu sehen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050909,
						733050910
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050909,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050911
					]
				},
				{
					"id": 733050911,
					"content": "Ormazd war einst mein Geliebter. Durch die Liebe des Dschinn wurde er vom Hirten zum Herrscher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050912
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050912,
					"content": "Ich dachte, er wäre mehr als ein sterblicher Gefährte. Ich verliebte mich törichterweise in seine Augen ... Aber die Eitelkeit und der Egoismus des Königs überwältigte ihn schließlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050913
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050913,
					"content": "Er unterschied sich nicht von jenen kurzlebigen, sterblichen Königen ... Er wanderte nur in einem Traum von Eroberung und Verfolgung und baute Paläste auf Treibsand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050914
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050914,
					"content": "Und deshalb hast du ihn ermordet ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050915
					]
				},
				{
					"id": 733050915,
					"content": "Wie gesagt, ich habe ihn bestraft. Vom Vater zum Sohn, bis zu drei Generationen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050916
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050916,
					"content": "Kisra Parvezravan, Shirin, mein eigen Fleisch und Blut ... Mit Blut plante ich, mit Honig richte ich sie hin und mit der Glut des Ehrgeizes züchtigte ich sie alle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050917
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050917,
					"content": "Aber das ist noch nicht alles ... *seufz* Noch nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050918,
						733050919
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050918,
					"content": "Über die „Strafe“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050920
					]
				},
				{
					"id": 733050920,
					"content": "Der eitle Parvezravan, mein geliebter Sohn ... Er wollte unbegrenzte Macht, also gab ich sie ihm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050921
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050921,
					"content": "Ich habe für ihn eine Maschine entworfen, die von den Überresten des Dschinn angetrieben wurde, und ihn in einem Traum aus pechschwarzer Dunkelheit dazu inspiriert, einen kolossalen Mechanismus zu bauen, der alle künstlichen Dinge ständig verschlucken und ausspucken konnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050922
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050922,
					"content": "Sie haben unermesslichen Reichtum gebracht, aber auch die Fröner ihrer Lebenskraft und die Bauern ihres Eigentums beraubt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050923
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050923,
					"content": "Adlige und Reiche weinten vor Freude. Sie dachten, dies sei der Triumph der Sterblichen und das Ende der Sklaverei. Aber nur ich kannte die Wahrheit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050924
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050924,
					"content": "Die Abschaffung der Sklaverei war der Beginn einer endlosen und grausamen Knechtschaft: die Sklavenhalter wurden von der Verpflichtung befreit, Sklaven zu versorgen und die Sklaven wurden der kleinen Wohltat beraubt, nicht verhungern zu müssen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050925
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050925,
					"content": "Hm ... Paimon ist verwirrt ... Wovon redest du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050926,
					"content": "Armut erzeugt Hass, Hass weckt Ehrgeiz ... Reichtum führt zu Gier und Gier schürt auch Ehrgeiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050927
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050927,
					"content": "Der Ehrgeiz trieb ihn dazu, seine Königin Shirin, die auch seine leibliche Schwester war, zu zwingen, einen geistlosen, deformierten Dschinn zu gebären ... Und ihr Leiden hat mich erfreut und gestärkt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050928
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050928,
					"content": "... Damit ich ihr Fleisch und Blut aufziehen konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050929,
						733050932
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050929,
					"content": "Du meinst Shiruyeh ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050930
					]
				},
				{
					"id": 733050930,
					"content": "Shiruyeh ist Khorramdin mit der „Messingmaske“. Die Armen und Sklaven sahen in ihm einen Abgesandten ihrer Herrin, einen Retter des Elends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050931
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050931,
					"content": "So führte er sie dazu, die Gerechtigkeit anzunehmen ... den Tod anzunehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050935
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050935,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050936
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050936,
					"content": "Oh? Kleine, du bist also immer noch hier ... Warum bist du so still?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050937
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050937,
					"content": "Ah, ähm ... Es ist nur so, dass Paimon es nicht versteht ... Und was du gerade gesagt hast, klang wirklich beängstigend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050938,
					"content": "Ach, ist schon gut ... Ich habe nur über meine Vergangenheit und mein Schicksal gesprochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050939
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050939,
					"content": "Oh ... Ach, Paimon weiß nicht, was Paimon sagen soll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050940
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050940,
					"content": "Dank deiner Begleitung konnte ich in den Garten meiner Herrin zurückkehren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050941
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050941,
					"content": "Hä? ... Warum sagst du das plötzlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050942
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050942,
					"content": "Gurabad ist der Ort, an dem mein Schicksal liegt. Ich kehre in diese Stadt zurück, weil es hier etwas gibt, das ich tun muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050943
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050943,
					"content": "Ähm ... Weil du in der Vergangenheit viel falsch gemacht hast und du zurückgehen musst, um es wiedergutzumachen ... Ist das richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050944
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050944,
					"content": "Falsch gemacht? Haha ... Ich habe nichts falsch gemacht. Aber meine Kinder sind noch da. Sie und Shiruyeh ... sie müssen ziemlich einsam sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050945
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050945,
					"content": "Du meinst also ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050946
					]
				},
				{
					"id": 733050946,
					"content": "Die Macht der Finsternis wird immer stärker ... Nur die Kraft einer Mutter kann ihr die Stirn bieten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050947
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050947,
					"content": "Ich dachte, ich könnte den dunklen Abgrund nutzen, um zu bestrafen, was ich hasste ... Aber wie man in den Wald hineinruft, so schallt es heraus ... Es wird auch mein Schicksal sein, Gurabad zu betreten und mich der Vergeltung zu stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050948
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050948,
					"content": "#{F#Meine Herrin}{M#Mein Herr}, tut mir leid, dass ich nicht länger an deiner Seite bleiben konnte und dass ich nicht mehr Zeit habe, mich mit dir vertraut zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050949
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050949,
					"content": "Aber ich weiß, dass das Schicksal für ein Wiedersehen sorgen wird. Du hast eine unbestechliche Eigenschaft. Ich glaube, dass ich die richtige Wahl treffen werde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050950,
						733050951
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050950,
					"content": "Deine Wahl ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050952
					]
				},
				{
					"id": 733050952,
					"content": "Im Allgemeinen wählt der Meister nicht den Dschinn, sondern der Dschinn wählt seinen Meister. Selbst wenn sich unsere Wege trennen sollten, glaube ich nicht, dass unsere Verbindung so leicht abreißen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050953
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050953,
					"content": "Also ... bitte nimm dieses letzte Geschenk an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050954
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050954,
					"content": "Bitte halte mich an dein Ohr ... noch einmal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050955
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050955,
					"content": "Du hältst die Zauberflasche sanft an dein Ohr ...\\nMit einem Kichern hörst du, wie dir jemand in einer Sprache ins Ohr flüstert, die so weich und zart ist ...\\nIhre Worte klangen unberechenbar wie ein Springbrunnen, und doch hast du jedes Wort davon verstanden.\\nSchließlich verklingen die Worte und hinterlassen nur ein verweilendes Echo in deinem Ohr ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050956
					]
				},
				{
					"id": 733050956,
					"content": "Durch ihre Anweisungen wirst du mit den alten Versen vertraut ...\\nAber sie sagte nichts mehr.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050957
					]
				},
				{
					"id": 733050957,
					"content": "He, schau mal! Das Licht in der Flasche verdunkelt sich ... Liloupar, geht es dir gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050958
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050958,
					"content": "Liloupar ... Liloupar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050959
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050959,
					"content": "(Das Licht der Flasche wird schwächer und flackert allmählich wieder auf. Aber sie spricht nicht mehr.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050960,
						733050961
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050960,
					"content": "Sie ist weg ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050962
					]
				},
				{
					"id": 733050962,
					"content": "Also ... So war es wirklich ein Abschied ... Werden wir sie jemals wiedersehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050963
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050963,
					"content": "Ähm ... Sollen wir jetzt zurückgehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050961,
					"content": "... Gurabad wartet auf sie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050962
					]
				},
				{
					"id": 733050951,
					"content": "Wirst du weggehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050952
					]
				},
				{
					"id": 733050932,
					"content": "Die „Messingmaske“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050933
					]
				},
				{
					"id": 733050933,
					"content": "Ah ... Khorramdin, der König Shiruyeh mit der Messingmaske, „Abgesandter der Herrin“, „Retter der Armen und Sklaven“. Haha, ein gerissener Lügner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050934
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050934,
					"content": "Und am Ende führte er diejenigen, die ihm folgten, in ein finsteres Verderben ... Zusammen mit der ganzen Stadt Gurabad verschlang die Erde sie in einem dunklen Abgrund.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050935
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050919,
					"content": "Über den Untergang von Gurabad ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050920
					]
				},
				{
					"id": 733050910,
					"content": "Ähm ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050911
					]
				}
			]
		},
