			"dialogs": [
				{
					"id": 733051201,
					"content": "... Sei vorsichtig. Ich spüre ein seltsames Beben aus der Tiefe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051202
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733051202,
					"content": "Hä? Was hast du gefühlt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733051203,
					"content": "Nichts ... Das war nur eine Übung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051204
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733051204,
					"content": "Na klar, das war nichts, nur eine „Übung“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733051205,
					"content": "... Warte! Was für eine „Übung“ war das?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733051206,
					"content": "Psst ... Sie sind da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				}
			]
		},
