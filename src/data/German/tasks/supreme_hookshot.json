			},
			"dialogs": [
				{
					"id": 230310601,
					"content": "Klasse, alle Zutaten vorhanden. Jetzt schaut mir zu, wie ich meinen einzigartigen Köder herstelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310602
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310602,
					"content": "Geschickt stellt Kayvan den Köder her.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230310603
					]
				},
				{
					"id": 230310603,
					"content": "Gut, jetzt können wir angeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310604
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310604,
					"content": "Die Eintauchtiefe passt ... Die Fließgeschwindikeit ist moderat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310605
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310605,
					"content": "Ihr müsst leise sein, die Fische sind sehr empfindlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310606
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310606,
					"content": "Selbst Schritte am Ufer könnten sie verschrecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310607,
						230310608
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310607,
					"content": "Ich stehe ganz still.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310609
					]
				},
				{
					"id": 230310609,
					"content": "Dann entspannt euch und wartet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310610
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310610,
					"content": "Kayvan zieht einen Beutel nasser Sachen raus.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230310611
					]
				},
				{
					"id": 230310611,
					"content": "Was ist denn das, das ist doch kein Fisch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310612,
					"content": "So einen „Fisch“ habe ich wirklich noch nicht gesehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310613
					]
				},
				{
					"id": 230310613,
					"content": "So ist es, wie erwartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310614
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310614,
					"content": "#Ähem, {F#Fremde}{M#Fremder}, sei nicht so streng, und achte nicht zu sehr auf Details.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310615
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310615,
					"content": "Alles, was am Haken aus dem Wasser gezogen wird, kann als „Fisch“ gelten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310616
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310616,
					"content": "Weißt du, das mit dem „besten Angler“ hab ich mir nicht ausgedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310617
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310617,
					"content": "Schließlich ist es eine spezielle Befähigung, etwas Lebloses zu fangen, das nicht einmal einen Köder schlucken kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310618
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310618,
					"content": "Die anderen Angler bewundern mich für mein einzigartiges Talent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310619,
						230310620
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310619,
					"content": "Vielleicht haben sie Mitleid mit dir ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310621
					]
				},
				{
					"id": 230310621,
					"content": "Kurz gesagt, du kannst alles fangen, außer Fisch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310622,
					"content": "Ähem! Egal was sie meinen! Jedenfalls gehe ich niemals mit leeren Händen heim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310623
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310623,
					"content": "Wenn ich heute versage, dann komme ich morgen wieder. Eines Tages werde ich ganz sicher einen Fisch fangen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310624
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310624,
					"content": "Danke, dass ihr mir das Material gebracht habt. Nehmt dies als Belohnung. Ich suche mir jetzt einen anderen Angelplatz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310625
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310625,
					"content": "Beim nächsten Mal ... Beim nächsten Mal fange ich bestimmt einen großen Fisch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310620,
					"content": "Vielleicht spotten sie über dich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310621
					]
				},
				{
					"id": 230310608,
					"content": "Paimon berührt den Boden nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310609
					]
				}
			]
