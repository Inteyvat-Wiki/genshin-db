					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310303
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310303,
					"content": "Normalerweise nehme ich Eier von einem Baum in der Nähe. Ich beschreibe euch, wo ihr sie finden könnt.",
					"roleType": "TALK_ROLE_NPC",
