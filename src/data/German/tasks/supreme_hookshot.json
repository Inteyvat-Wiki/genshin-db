			"dialogs": [
				{
					"id": 230310201,
					"content": "Was für Material brauchst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310202
					]
				},
				{
					"id": 230310202,
					"content": "Nach meinem heutigen Gefühl ... Zaytun-Pfirsich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310203
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310203,
					"content": "Es ist nichts Besonderes, aber kaum jemand denkt daran, damit Köder zu herzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310204
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310204,
					"content": "Bitte besorgt mir dieses Material.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				}
			]
		},
