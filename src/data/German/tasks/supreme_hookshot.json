				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayvan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230310101,
					"content": "#Deinem Aussehen nach ... Bist du {F#die Reisende}{M#der Reisende}? Was verschlägt dich hierher? Dies ist der richtige Ort, um auszuspannen, gute Wahl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310102
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310102,
					"content": "Oder bist du auch ein Angler, dem dieses Gewässer gefällt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310103,
					"content": "Du hast den richtigen Instinkt! Dies ist der beste Angelplatz in der Umgebung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310104
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310104,
					"content": "Aber hier angelt doch sonst niemand, was macht dich so sicher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310105,
					"content": "Na wegen meinem einzigartigen Instinkt natürlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310106
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310106,
					"content": "Ich bin der beste Angler weit und breit und ich habe meine eigene Methode, meine Angelplätze auszuwählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310107
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310107,
					"content": "Wi... Wirklich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310108
					]
				},
				{
					"id": 230310108,
					"content": "Aber hast du überhaupt etwas gefangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310109,
					"content": "Genug der Worte, jetzt zeige ich euch die „Perfektion am Angelhaken“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310110,
						230310111
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310110,
					"content": "Der Schatz ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310112
					]
				},
				{
					"id": 230310112,
					"content": "Gib mir das richtige Material und ich mache einen Köder, mit dem „Fische“ gefangen werden können, die du nie gesehen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310113
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310113,
					"content": "Warum hat Paimon da Zweifel? Sind deine selbstgemachten Köder wirklich so wirkungsvoll?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310114,
					"content": "Ein Versuch kann nicht schaden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310115
					]
				},
				{
					"id": 230310115,
					"content": "Genau, das ist die richtige Einstellung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310116
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310116,
					"content": "Als Grundstoff für meine Köder verwende ich Dämmerfrucht und Weizen, außerdem wird er dann durch ein anderes Material weiter verbessert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310111,
					"content": "Am Haken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310112
					]
				}
			]
		},
