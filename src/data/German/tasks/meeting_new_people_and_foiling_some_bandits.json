				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710410101,
					"content": "Puh ... Danke, ihr Helden, danke, dass ihr mein Leben gerettet habt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410102
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410102,
					"content": "Warte ... Ich erkenne dich ... Du bist der Toclipho aus der Mine, bevor die Große Kluft geschlossen wurde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410103
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410103,
					"content": "Ah, nein, nein! Das bin ich nicht, ich verkaufe keine falsche Medizin. Ich bin Clitopho, der Clitopho, der keine Medizin verkauft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410104
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410104,
					"content": "Du verkaufst also falsche Medizin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410105
					]
				},
				{
					"id": 710410105,
					"content": "Nein ... Wie kann das sein? Die Medizin, die ich verkaufe, ist echter Männertrank! Sieh mal, die Bergleute trinken ihn und es geht ihnen gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410106
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410106,
					"content": "Bist du nicht der Clitopho, der keine Medizin verkauft?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410107
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410107,
					"content": "Ah ... Ja, das war, nachdem meine Karriere als Medizinhändler vorbei war ... also ... Ja, es ist alles Tocliphos Schuld! Er hat solch einen falschen Namen angenommen und mich hinters Licht geführt hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410108
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410108,
					"content": "Er hat gefälschte Medikamente unter falschem Namen verkauft und meinen Ruf ruiniert! Also schwor ich mir von nun an, nie wieder Medikamente zu verkaufen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410109
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410109,
					"content": "Das Ergebnis war, dass ich kurz danach von Schatzräubern gefangen genommen wurde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410110
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410110,
					"content": "In diesem Fall ist der falsche Medizinverkäufer echt nervig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410111
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410111,
					"content": "Ja, genau, er hat sogar einen Geschäftsfreund hinters Licht geführt, was für ein übler Kerl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410112,
					"content": "Was ist der falsche Name von Toclipho?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410113
					]
				},
				{
					"id": 710410113,
					"content": "Clitopho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410114
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410114,
					"content": "... Ah, nein ... Clitopho ist kein Pseudonym, sondern ein echter Name ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410115
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410115,
					"content": "Toclipho ist also der falsche Name?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410116,
					"content": "Nein ... Er benutzt meinen Namen unter falschem Vorwand, sodass Clitopho zu einem falschen Namen wird, verstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410117
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410117,
					"content": "Oh ... Dann ist also „Toclipho“ der richtige Name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410118,
					"content": "Wie schade ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410119
					]
				},
				{
					"id": 710410119,
					"content": "Was genau ist schade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410120
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410120,
					"content": "Schade, dass du dich fast selbst ausgehändigt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410121
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410121,
					"content": "Nehmen wir ihn mit nach oben. Ich glaube, die Millelithen haben ein paar Fragen an ihn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410122
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410122,
					"content": "Oder wir machen ihn einfach hier fertig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410123
					]
				},
				{
					"id": 710410123,
					"content": "Was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410124
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410124,
					"content": "He, mach doch nicht plötzlich solche Witze!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410125
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410125,
					"content": "Hahaha, Paimon lacht sich kaputt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410126,
					"content": "Du lachst ja gar nicht! Das ist nicht einmal lustig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410127,
						710410130
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410127,
					"content": "Das ist in der Tat nicht witzig, denn wir werden jetzt etwas Ernstes tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410128
					]
				},
				{
					"id": 710410128,
					"content": "Bitte beruhige dich, das ist nicht der richtige Zeitpunkt für Verhör!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410129
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410129,
					"content": "Ich will nicht mit einem ohnmächtigen Schatzräuber, auf meinem Rücken herumlaufen ... Wie auch immer, lasst uns ihn zuerst zurück zum Lager bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410131
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410131,
					"content": "Wartet, ich werde euch nützlich sein! Bitte nehmt mich mit auf euer Abenteuer! Schließlich wurde ich von den Schatzräubern überrumpelt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410132
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410132,
					"content": "Jetzt bin ich mehr oder weniger ... unschuldig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410133
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410133,
					"content": "Das ist also Unschuld ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410134,
					"content": "Und was kannst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410135
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410135,
					"content": "Nun ... wie zum Beispiel ... Sprengstoff zu mischen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410136
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410136,
					"content": "Falscher Sprengstoff?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410137,
					"content": "Richtiger Sprengstoff, keine falsche Medizin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410138
					]
				},
				{
					"id": 710410138,
					"content": "Kein falscher Sprengstoff?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410139
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410139,
					"content": "Ja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410140
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410140,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410141
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410141,
					"content": "... Ich bin nicht befugt, dich in unsere Truppe zu lassen. Jinwu muss entscheiden, was wir mit dir machen sollen, aber ich schätze, er wird dich an die Millelithen ausliefern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410142
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410142,
					"content": "Aber wir werden dich trotzdem im Auge behalten. Ein Schatzräuber wie du ist kein Vertrauen wert, du verkaufst sogar falsche Medikamente ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410143
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410143,
					"content": "Ich sagte, ich mache das nicht mehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410144
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410144,
					"content": "Ja, ja! Gehen wir schon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410130,
					"content": "Das stimmt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410131
					]
				}
			]
		},
		{
			"id": 7104103,
			"completionStepIds": [
				7104109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7104109",
							"2"
						],
						"stepId": 7104109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitopho",
					"Paimon",
					"Zhiqiong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710410301,
					"content": "... Der Verriegelungsmechanismus ist noch nicht verrostet und zeigt Anzeichen von Schmierung ... Er scheint auch nach der Versiegelung der Mine gepflegt worden zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410302
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410302,
					"content": "Der Verschluss ist auch intakt ... Nur die Sicherung ist in der geschlossenen Position.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410303
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410303,
					"content": "Paimon versteht nicht ... Was ist das, ein Zauberspruch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410304,
					"content": "Der Tunnel vor uns war beim Abzug der Bergleute mit Felsbrocken blockiert ... Sieht so aus, als würde sich die Kanone wieder als nützlich erweisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410305
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410305,
					"content": "Ohne Kugeln ist die Kanone nutzlos. Wir müssen noch Kugeln finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410306
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410306,
					"content": "Sag es nicht so, als wüsste ich es nicht, Schlaumeier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410307
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410307,
					"content": "In der Nähe gibt es ein Lagerhaus, in dem wahrscheinlich Kugeln gelagert wurden ... Ich hoffe, sie wurden nicht alle bei der Evakuierung entfernt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410308
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410308,
					"content": "So ist es. Legen wir los.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410309
					]
				},
				{
					"id": 710410309,
					"content": "Lasst uns gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				}
			]
		},
		{
			"id": 7104104,
			"completionStepIds": [
				7104111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7104111",
							"2"
						],
						"stepId": 7104111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong",
					"Clitopho",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710410401,
					"content": "Das ist es. *hust* ... So ein Pech! Das Tor ist verschlossen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410402
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410402,
					"content": "Man muss beide Schlüssel haben, um die Tür zu öffnen ... Leider seid ihr Leute aus Liyue immer so seriös an solch befremdenden Orten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410403
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410403,
					"content": "Hört auf, Unsinn zu reden ... Schaut euch den Aushang neben dem Tor an. Wir wissen zumindest, dass die Kugeln tatsächlich noch im Lagerhaus sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410404
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410404,
					"content": "Die Kugeln sind eine Sache, aber wir wissen immer noch nicht, in welchem Zustand sich die Zünder befinden. Ich denke, es ist besser, einen Plan B zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410405
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410405,
					"content": "Komm schon ... Hör auf, über so etwas zu reden. Es bringt nichts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410406
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410406,
					"content": "Außerdem, warum sollten wir auf die Meinung eines Schatzräubers hören?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410407,
						710410408
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410407,
					"content": "Clitopho hat schon irgendwie recht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410409
					]
				},
				{
					"id": 710410409,
					"content": "Streitet euch nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410410,
					"content": "#Hm ... Hört einfach auf {NICKNAME}. Lasst uns erst einmal weitermachen, vielleicht weiß Jinwu, wie man diese Tür öffnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410411
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410411,
					"content": "Und danach haben wir immer noch ein gutes Stück Arbeit vor uns ... Das Entriegeln der Sicherung erfordert immer noch die Aktivierung des Signalgeräts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410412
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410412,
					"content": "Ich habe von Jinwu gehört, dass es einen Beobachtungsposten für den Sprengtrupp geben sollte, der hoch oben über der Kanone eingerichtet ist ... Von dort aus könnte man das Signal einstellen und es benutzen, um die Kanone aus sicherer Entfernung zu entriegeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410408,
					"content": "Kurz gesagt, wir mussten die Tür öffnen, bevor wir etwas tun konnten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410409
					]
				}
			]
		}
	]
}