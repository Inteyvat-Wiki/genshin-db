			"dialogs": [
				{
					"id": 230070301,
					"content": "Ich habe schon ein paar Ideen, und heute ... würde ich gern einen Boden finden, der regelmäßig mit Elementarwesen in Kontakt kommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070302
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070302,
					"content": "Vaniloquen wären gut. Wo sie wachsen, hat der Lehm wahrscheinlich besondere Eigenschaften.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070303
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070303,
					"content": "Aber ich bin nur ein Maurer und ich werde doch nicht ein Gefäß nehmen und die Vaniloquen zerschlagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070304
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070304,
					"content": "#{M#Reisender}{F#Reisende}, könntest du mir dabei helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070305,
						230070308
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070305,
					"content": "Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070306
					]
				},
				{
					"id": 230070306,
					"content": "Dann ist das nun deine Aufgabe. Bring mir bitte etwas Lehm von den Wurzeln der Vaniloquen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070307
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070307,
					"content": "Ich verrate dir einen Ort, an dem es angeblich Vaniloquen gibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070308,
					"content": "Du kommst nicht mit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070309
					]
				},
				{
					"id": 230070309,
					"content": "Ich würde auch gerne hingehen, aber ich muss hier ein paar Probleme mit den Nippes und Töpfen klären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070310
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070310,
					"content": "Keine Sorge, ich werde eine angemessene Bezahlung für dich vorbereiten. Ich zähle auf dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070311
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070311,
					"content": "Ich werde den Ort auf der Karte für dich markieren, bitte geh dorthin und suche ihn ...",
					"roleType": "TALK_ROLE_NPC",
