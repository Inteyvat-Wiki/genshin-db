				"points": []
			},
			"dialogs": [
				{
					"id": 230070201,
					"content": "Ich habe schon ein paar Ideen, und heute habe ich vor, etwas mit Schleimabsonderung getränkten Lehm zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070202
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070202,
					"content": "Ich habe einen Ort ausfindig gemacht, an dem sich Schleime ansammeln. Kannst du dorthin gehen und mir etwas Lehm besorgen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070203,
						230070206
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070203,
					"content": "Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070204
					]
				},
				{
					"id": 230070204,
					"content": "Dann ist das nun deine Aufgabe. Es ist egal, ob du die Schleime beseitigst, du musst nur etwas von dem Lehm in der Nähe mitnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070205
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070205,
					"content": "Ich werde den Ort mit den Schleimen auf der Karte für dich markieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070206,
					"content": "Du kommst nicht mit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070207
					]
				},
				{
					"id": 230070207,
					"content": "Ich würde auch gerne hingehen, aber ich muss hier ein paar Probleme mit den Nippes und Töpfen klären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070208
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070208,
					"content": "Keine Sorge, ich werde eine angemessene Bezahlung für dich vorbereiten. Ich zähle auf dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070209
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070209,
					"content": "Ich werde den Ort auf der Karte für dich markieren, bitte geh dorthin und suche ihn ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070210
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070210,
					"content": "Dann ist das nun deine Aufgabe. Es ist egal, ob du die Schleime beseitigst, du musst nur etwas von dem Lehm in der Nähe mitnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				}
			]
