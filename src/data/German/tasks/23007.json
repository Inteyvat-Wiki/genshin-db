					"Akim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230070101,
					"content": "Gibt es nicht vielleicht besseres Material dafür?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070102
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070102,
					"content": "Welches Material?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070103
					]
				},
				{
					"id": 230070103,
					"content": "Verzeihung, ich habe schon wieder mit mir selbst geredet. Wegen des unbeständigen Wetters gibt es derzeit einfach zu viele Probleme im Haus zu bewältigen. Ich schaffe einfach nicht alles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070104
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070104,
					"content": "Bist du nicht ein Töpfer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070105
					]
				},
				{
					"id": 230070105,
					"content": "Ja, aber ich bin auch Maurer. Du siehst, es dreht sich beides um den Lehmboden. Da gibt es keinen großen Unterschied.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070106,
					"content": "Kennst du dieses Sprichwort? „Lernen ist wie Häuserbauen. Um ein großes Haus zu bauen, musst du ein gutes Fundament legen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070107,
					"content": "„Und wenn du dein Wissen erweitern willst, dann musst du das auch tun. Ein wackeliges Fundament wird nur zum Einsturz führen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070108,
					"content": "Die klugen vornehmen Leute reden immer so. Ich verstehe es zwar nicht wirklich, aber schau, sie halten den Hausbau für genauso wichtig wie das Lernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070109,
						230070110
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070109,
					"content": "Das ist nur ein Vergleich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070111
					]
				},
				{
					"id": 230070111,
					"content": "Wie auch immer. Wenn man das Fundament eines Hauses erwähnt, denkt man auch an Baumaterialien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070112
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070112,
					"content": "Der Lehm ist das Binde- und Stützmaterial. Wenn seine Stabilität und Anpassungsfähigkeit verstärkt werden können, werden die Häuser haltbarer. Und ich müsste nicht mehr so hart arbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070110,
					"content": "So sollte es nicht verstanden werden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070111
					]
				}
			]
		},
		{
			"id": 2300702,
