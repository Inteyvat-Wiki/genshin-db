					"id": 230070901,
					"content": "Das ist genau der, den ich brauche. Du bist eine sehr große Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070902
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070902,
					"content": "Dieser Lehm fühlt sich klebrig an. Ist darin Schleimabsonderung enthalten? Ich frage mich, ob er sich mit anderem Lehm vermischen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070903
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070903,
					"content": "Jedenfalls danke ich dir für deine Hilfe. Hier ist deine Bezahlung, bitte nimm sie an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070904
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070904,
					"content": "Oho, man könnte diesen Lehm „verdichteten Lehm“ nennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				}
			]
