			"dialogs": [
				{
					"id": 191079701,
					"content": "Aber, ist es überhaupt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079702
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 191079702,
					"content": "Connor, das Wichtigste ist jetzt, dass wir Diona unsere Aufrichtigkeit zeigen, verstanden?",
