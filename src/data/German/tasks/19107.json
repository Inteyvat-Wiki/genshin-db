			"trigger": {
				"objectNames": [
					"Elzer",
					"Connor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191079801,
					"content": "Toll gemacht, Connor, weiter so. Wir werden Diona auf jeden Fall als feste Wirtin hier beim Weingut Morgenröte einstellen können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079802
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079802,
					"content": "Ich hoffe, es funktioniert. Ich habe wochenlang rumgesessen und auf die Chance gewartet ... Wir dürfen diese Gelegenheit nicht ungenutzt verstreichen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079803
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 191079803,
					"content": "Du hast dich dieses Mal wirklich selbst übertroffen, Connor. Solange wir Diona dazu bringen können, hier zu arbeiten, hat sich all unsere harte Arbeit gelohnt. Das ist nur der erste Schritt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079804
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079804,
					"content": "Vergiss nicht, dass Diona unsere Aufrichtigkeit und unsere Leidenschaft spüren muss! Und denk daran, es nicht zu übertreiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079805
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079805,
					"content": "Kein Problem. Wir haben das echt schon oft durchgekaut, Elzer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079806
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 191079806,
					"content": "Wovon redet ihr eigentlich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191079807
					]
				},
				{
					"id": 191079807,
					"content": "Huh?! Oh, hehe ... nichts. Wir ... besprechen nur ein paar geschäftliche Dinge des Weinguts, hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079808
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079808,
					"content": "Ja, wir reden übers Geschäft. Lass uns noch mal die aktuellen Unterhaltskosten des Weinguts durchgehen, Elzer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Connor"
				}
			]
		},
