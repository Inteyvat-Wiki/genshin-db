					"nextDialogs": [
						752420102
					],
					"speakerTitle": "Miztli"
				},
				{
					"id": 752420102,
					"content": "Wann immer ihr bereit seid, lasst es mich wissen, und wir nehmen euch umgehend an Bord!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752420103
					],
					"speakerTitle": "Miztli"
				},
				{
					"id": 752420103,
					"content": "Seid ihr bereit, an Bord zu gehen?",
