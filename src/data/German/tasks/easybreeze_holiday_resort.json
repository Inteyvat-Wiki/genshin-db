			"dialogs": [
				{
					"id": 752420401,
					"content": "Hallo und willkommen in der Urlaubsanlage Leichtbrise. Ich werde euch alle für eure Unterkunft einchecken lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752420402
					],
					"speakerTitle": "Ukucha"
				},
				{
					"id": 752420402,
					"content": "Nehmt bitte diese Karte und ein spezielles Erinnerungsalbum, das wir für unsere Gäste vorbereitet haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752420403
					],
					"speakerTitle": "Ukucha"
				},
				{
					"id": 752420403,
					"content": "Die Urlaubsanlage besteht aus vier Hauptgebieten: den Farbfall-Klippen, dem Guiztli-Kamm, der Wellen-Bucht und der Tete-Insel. Erkundet alles in aller Ruhe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752420404
					],
					"speakerTitle": "Ukucha"
				},
				{
					"id": 752420404,
					"content": "Also, eure Unterkünfte liegen in dieser Richtung. Wenn ihr etwas Ruhe braucht, könnt ihr euch dorthin begeben. Und wenn ihr etwas einkaufen möchtet, ist der Leichtbrise-Markt, unsere meistbesuchte Attraktion, gleich hier drüben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ukucha"
				}
			]
		}
	]
