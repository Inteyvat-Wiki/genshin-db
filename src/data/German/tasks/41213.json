				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130101,
					"content": "Albedo! Wir sind wieder dahaaa ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130102,
					"content": "Huch? Anscheinend ist niemand hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130103,
					"content": "Ist er irgendwo unterwegs, um was zu erforschen? Oder vielleicht fertigt er irgendwo geheimnisvolle Zeichnungen an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130104,
					"content": "Ah! Ihr seid es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130105
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130105,
					"content": "Wenn das nicht Saccharose ist! Was machst du hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130106,
					"content": "Meine Forschung hat die letzte Phase erreicht. Ich habe heute fünf Stunden und sechsundzwanzig Minuten frei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130107
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130107,
					"content": "Deshalb habe ich euch gesucht, um mal wegen der besprochenen Angelegenheit nachzufragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130108
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130108,
					"content": "Du misst die Zeit aber ganz schön genau! Bist du eine menschliche Uhr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130109,
					"content": "N... Nein, da gibt’s gar nichts zu bewundern. Wie nett du bist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130110
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130110,
					"content": "Das war kein Kompliment!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130111,
					"content": "#D... Darf ich dich etwas fragen, {F#Reisende}{M#Reisender}? Ich habe gebeten, dass ihr Herrn Albedos Geheimnis auf die Spur kommt. Habt ihr da schon Fortschritte gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130112
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130112,
					"content": "Berichtige mich, wenn ich mich irre, aber es ist schon über eine Woche her, seitdem wir darüber geredet haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130113,
					"content": "Ich dachte, du hättest es bereits vergessen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130114
					]
				},
				{
					"id": 412130114,
					"content": "Was?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130115
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130115,
					"content": "Ü... Über eine Woche? Ich habe eindeutig ... Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130116
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130116,
					"content": "Ähm, ich war so in meine Forschung vertieft, dass ich diese Sache völlig vergessen habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130117
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130117,
					"content": "Wie kannst du gleichzeitig so ein gutes und so ein schlechtes Zeitgefühl haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130118,
					"content": "A... Also! Habt ihr das Geheimnis gelüftet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130119,
						412130120
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130119,
					"content": "Ja, das kann man so sagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				},
				{
					"id": 412130121,
					"content": "Das ist toll. Und was ist es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130122
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130122,
					"content": "Was meinst du, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130123
					]
				},
				{
					"id": 412130123,
					"content": "Ähm ... Ich glaube, sie darf es ruhig wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130124,
					"content": "Sie kann es auch ansehen. Nur nicht berühren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130125,
					"content": "Wovon sprecht ihr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130126
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130126,
					"content": "Was ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130127,
						412130128
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130127,
					"content": "Das ist Albedos Geheimnis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130129,
					"content": "Das ist ein supermächtiges Schwert. Berühre es ja nicht mit bloßen Händen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130130,
					"content": "Ähm ... Das ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130131
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130131,
					"content": "Ah! D... Das ist ... So etwas habe ich noch nie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130132
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130132,
					"content": "Hoho, sieh es dir ruhig genau an! Paimon weiß nicht, warum, aber sie hat auch das seltsame Gefühl, etwas erreicht zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130133,
					"content": "Erstaunlich! Ich höre zum ersten Mal von so einer geheimnisvollen Waffe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130134
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130134,
					"content": "Ich spüre kaum wahrnehmbar, wie die Macht durch dieses Schwert fließt ... Fast wie bei einem lebenden Wesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130135
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130135,
					"content": "Kannst du das so klar sagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130136,
					"content": "Das könnte an meiner Ausbildung als Alchimistin liegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130137
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130137,
					"content": "Ich würde nicht meinen Kopf darauf verwetten, aber der „Fluss“ der Macht ist schon recht deutlich spürbar. Obwohl die Beschreibung nicht ganz präzise ist. N... Normalerweise würde ich Dinge dieser Art nicht definieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130138
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130138,
					"content": "Bitte glaubt mir! Normalerweise würde ich mich eines solch unklaren Ausdrucks nicht bedienen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130139
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130139,
					"content": "Na gut, na gut, wir verstehen schon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130140,
					"content": "#{F#Reisende}{M#Reisender}, kannst du mit diesem Schwert kämpfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130141
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130141,
					"content": "Ich würde gerne mehr darüber erfahren, aber selbst kann ich das Schwert ja nicht nutzen. Ich kann dich nur um deine Hilfe bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130142,
						412130143
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130142,
					"content": "Wir sollten aber unauffällig sein. Albedo darf es nicht wissen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130144,
					"content": "Sehen wir uns um, ob wir so etwas finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130143,
					"content": "Wir sollten ein verstecktes Plätzchen finden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130128,
					"content": "Das ist die Antwort auf deine Frage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130120,
					"content": "Unsere Ermittlung war erfolgreich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				}
			]
		},
		{
			"id": 4121302,
			"completionStepIds": [
				4121305
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121305",
							"2"
						],
						"stepId": 4121305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Saccharose"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130201,
					"content": "Bemerkenswert! Diese Waffe ist wirklich einzigartig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130202
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130202,
					"content": "Und du bist das auch. Deine Haltung im Kampf, wie du das Schwert schwingst, einfach perfekt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130203
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130203,
					"content": "Du schmeichelst mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130204
					]
				},
				{
					"id": 412130204,
					"content": "Dieses Schwert ist was Besonderes. Ich wollte mich nicht zu sehr in seine Erforschung vertiefen und doch konnte ich meine Augen einfach nicht von ihm lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130205
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130205,
					"content": "Na ja, Paimon hält das eher für eine DEINER besonderen Merkmale. Und nicht das des Schwerts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130206,
					"content": "Gefährlich und verführerisch, geheimnisvoller Einhänder ... Hm. Das ist es wohl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130207
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130207,
					"content": "Es zeugt von Albedos Vertrauen in euch, dass er dir so einen wichtigen Gegenstand überlässt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130208,
						412130209
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130208,
					"content": "Ich bin genauso überrascht wie du.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				},
				{
					"id": 412130210,
					"content": "Hehe, du hast dir sein Vertrauen mit deinem Können verdient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130211,
					"content": "Paimon hat recht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130212
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130212,
					"content": "Aber das Schwert hatte, bevor er es euch gegeben hat, noch kaum Energie absorbiert ... Wie hat Herr Albedo es unter all den anderen Gegenständen im Lager entdeckt und gemerkt, dass es etwas Besonderes ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130213
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130213,
					"content": "Genialität lässt sich oft nicht erklären. Zum Beispiel Paimons Appetit auf Honigmöhren-Fleischpfanne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130214,
					"content": "Ah ... Das erinnert mich daran, dass ich heute noch kaum was gegessen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130215
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130215,
					"content": "Ich habe mich gleich nach dem Abschluss meines Experiments auf die Suche nach euch begeben. Auf dem Weg bin ich dann einem Abenteurer begegnet, der im Schnee gefangen war. Hat etwas gedauert, bis ich ihn gerettet hatte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130216
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130216,
					"content": "*grummel*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130217
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130217,
					"content": "Hat dein Magen gerade geknurrt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130218
					]
				},
				{
					"id": 412130218,
					"content": "Ah ... Aaah! N... Nein, so ist das nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130219
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130219,
					"content": "Sei nicht so ein Mäuschen! Vor uns musst du dich nicht schämen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130220,
					"content": "Ähm, ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130221
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130221,
					"content": "Paimon hilft dir: Paimon ist hungrig! Wir sollten etwas essen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130222,
						412130223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130222,
					"content": "Ich bin hungrig!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130224,
					"content": "Ich bin ... Ich habe Hunger. Ich möchte etwas ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130225
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130225,
					"content": "Herrje. Ich bringe das immer noch nicht über die Lippen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130226
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130226,
					"content": "Da gibt’s nichts zu schämen! Wenn du zugibst, dass du Hunger hast, schmeckt es nur umso besser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130227,
					"content": "Wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130228
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130228,
					"content": "Natürlich! Komm! Hinten im Lager fliegt sicher etwas Leckeres herum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130229,
					"content": "Honigmöhren-Fleischpfanne wäre gerade echt was Tolles, um uns bei dieser Kälte warm zu halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130223,
					"content": "Ich möchte etwas essen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130209,
					"content": "Ich bin dankbar für sein Vertrauen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				}
			]
		},
		{
			"id": 4121303,
			"completionStepIds": [
				4121307
