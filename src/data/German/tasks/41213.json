			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verwegener Pallad"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130301,
					"content": "Hmpf ... Args ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130302
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 412130302,
					"content": "Herr Pallad?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130303
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130303,
					"content": "D... Du bist immer noch nicht umgekehrt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130304
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130304,
					"content": "Ist das nicht der hitzköpfige Abenteurer aus Mondstadt? Ist er auch mit Cyrus hier, um den Schneeberg zu erkunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130305,
					"content": "Mir ist so k... k... kalt, HATSCHI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130306
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 412130306,
					"content": "Treibst du dich hier herum, seitdem ich dich aus der Schneegrube befreit habe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130307
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130307,
					"content": "Ich wollte zurückkehren, aber dann habe ich mich verirrt. Tut mir leid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130308
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 412130308,
					"content": "Hmpf ... es ist so k... kalt, dass ich mich n... nicht b... bewegen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130309
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 412130309,
					"content": "Tja, Herr Pallad, diesen Berg zu erklimmen, bedarf schon gründlicher Vorbereitungen. Du hättest das nicht auf die leichte Schulter nehmen dürfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130310
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130310,
					"content": "Wir begleiten ihn hinunter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130311
					]
				},
				{
					"id": 412130311,
					"content": "Könntet ihr das tun? Ich fürchte, dass er in seinem Zustand gestützt werden muss ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130312
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130312,
					"content": "Wir können ihn ja nicht einfach so hierlassen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130313,
					"content": "#Du hast recht ... Tut mir leid, {F#Reisende}{M#Reisender}. Ich entschuldige mich für ihn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130314
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130314,
					"content": "Im Augenblick ist er dein geringstes Problem. Du solltest dir lieber um dich selbst Sorgen machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130315
					],
					"speakerTitle": "???"
				},
				{
					"id": 412130315,
					"content": "Ah! Die Fatui schlagen wieder zu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130316,
					"content": "Ihr habt bestimmt schon erraten, warum wir hier sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130317
					],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130317,
					"content": "Wir lassen euch nicht ziehen, bis ihr uns das Schwert ausgehändigt habt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130318
					],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130318,
					"content": "Nein! Gib ihnen das Schwert nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130319,
						412130320
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130319,
					"content": "Natürlich nicht. Das würde mir nicht im Traum einfallen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				},
				{
					"id": 412130321,
					"content": "Wie energisch! Wir sollten den Augenblick nutzen und sie erledigen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130322,
					"content": "Herr Pallad, ich bringe dich in Sicherheit! Schnell!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130323
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130323,
					"content": "Wie kann man nur so naiv sein! Als würden wir Zeugen entkommen lassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130324
					],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130324,
					"content": "Dieses Schwert wird ein wundervolles Geschenk für Ihre Hoheit, die Heroldin La Signora, sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130320,
					"content": "Denkt nicht einmal daran, eure dreckigen Pfoten darauf zu legen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				}
			]
		},
