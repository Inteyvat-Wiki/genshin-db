		{
			"id": 4121305,
			"completionStepIds": [
				4121310
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121310",
							"2"
						],
						"stepId": 4121310,
						"stateName": "QUEST_STATE_UNFINISHED"
