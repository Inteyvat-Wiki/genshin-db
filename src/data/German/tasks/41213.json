			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130501,
					"content": "Ich habe den Radau gehört und wollte nachsehen, was los ist. Du hast also den ganzen Lärm veranstaltet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130502,
					"content": "Was ist passiert? Hast du gekämpft?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130503,
					"content": "H... Herr Albedo ... Ich wollte nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130504
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130504,
					"content": "Solltest du nicht eigentlich Dokumente ordnen? Warum bist du plötzlich hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130505
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130505,
					"content": "Und du hast dich bei diesem Wetter auf einen Kampf gegen so einen gefährlichen Gegner eingelassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130506
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130506,
					"content": "I... Ich habe auch gekämpft, tut mir leid ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130507
					]
				},
				{
					"id": 412130507,
					"content": "Tja, jetzt fühlt sich sogar Paimon schuldig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130508,
					"content": "Ähm ... Ah ... Ich ... Tut mir leid, ich bin nur vorbeigekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130509
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130509,
					"content": "Und ich fürchte, dass du noch von etwas anderem abgelenkt wurdest, das dich in seinen Bann gezogen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130510
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130510,
					"content": "Ich habe Saccharose vom Schwert erzählt. Meine Schuld.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130511
					]
				},
				{
					"id": 412130511,
					"content": "Du hast ihr alles erzählt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130512
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130512,
					"content": "Wir haben ihr erzählt, was das Schwert kann und wo es herkommt. Sie durfte es nicht berühren! Das würden wir nie zulass...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130513,
					"content": "Macht nichts. Bald hätten wir es ihr ohnehin sagen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130514
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130514,
					"content": "Saccharose wird ganz natürlich von obskurem Wissen und Geheimnissen angezogen. Sie ist aus dem Stoff, aus dem wahre Alchimisten bestehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130515,
					"content": "Ah ... Ähm ... Ich verspreche, ich werde keinen weiteren Ärger verursachen. Das schwöre ich bei den vierfach großen Zuckerblumensamen, die ich gerade gezüchtet habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130516
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130516,
					"content": "Ärger macht mir keine Sorgen. Deine Sicherheit jedoch schon. Sei nächstes Mal vorsichtiger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130517,
					"content": "Na gut, und was ist mit diesem Abenteurer, der hier kauert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130518,
					"content": "Ich habe Herrn Pallad während des Kampfes beschützt. Eigentlich sollte ihm nichts fehlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130519
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130519,
					"content": "Mir ... mir ist kalt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130520
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 412130520,
					"content": "Er hat sich wohl während des Kampfes erkältet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130521,
					"content": "Aaah! Daran habe ich gar nicht gedacht ... Das hätte mir auffallen müssen, tut mir leid!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130522
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130522,
					"content": "Herr Albedo, ich kümmere mich um ihn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130523
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130523,
					"content": "Mach das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130524
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130524,
					"content": "Saccharose kommt einem auf den ersten Blick etwas unnahbar vor, aber sie ist ein gutes Kind mit einem Herz aus Gold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130525,
					"content": "Ich würde sie nicht „Kind“ nennen, hätte ich deine Größe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130526
					]
				},
				{
					"id": 412130526,
					"content": "Da hast du wohl recht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130527,
					"content": "Dieses Mädchen ... Kaum lässt man Saccharose aus den Augen, findet man sie an den seltsamsten Orten wieder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130528
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130528,
					"content": "Machen das nicht alle jungen Leute so?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130529
					]
				},
				{
					"id": 412130529,
					"content": "Das stimmt auch wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130530
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130530,
					"content": "Saccharose wollte keinen Ärger bereiten. Sei nicht zu streng mit ihr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130531
					]
				},
				{
					"id": 412130531,
					"content": "Keine Sorge, ich bin nicht wütend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130532
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130532,
					"content": "Huch? Da scheint etwas Leuchtendes auf dem Schwert zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130533,
					"content": "Hm? Wieder eine Veränderung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130534
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130534,
					"content": "Das Schwert ist viel stärker als vorher. Wie konnte das passieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130535
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130535,
					"content": "Wir haben gegen Fatui gekämpft.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130536
					]
				},
				{
					"id": 412130536,
					"content": "Einige dieser Fatui-Soldaten waren ganz schön grimmig. Diesen Kerlen sind wir zum ersten Mal begegnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130537,
					"content": "Das heißt also, diese dem Schwert unbekannte Energie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130538
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130538,
					"content": "Sie hat verursacht, dass es viel stärker geworden ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 4121306,
			"completionStepIds": [
				4121314
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121314",
							"2"
						],
						"stepId": 4121314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130601,
					"content": "Die Macht des Drachen ... Die Lebenskraft des Drachen kann tote Pflanzen wiederbeleben und sie so stark machen, dass ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130602
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130602,
					"content": "Unfassbar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130603
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130603,
					"content": "Wie kann aus einem toten Baumstumpf so ein Monster werden?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130604,
					"content": "Paimon wurde fast verschlungen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130605,
					"content": "Und warum ist das vorher nie passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130606,
					"content": "Wahrscheinlich, weil das Schwert zu Boden gefallen ist. Durch den Aufprall ist wohl etwas von seiner Macht herausgesickert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130607
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130607,
					"content": "Das ist meine Schuld! Schickt mich nicht weg! Ich flehe euch an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130608
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 412130608,
					"content": "Ich bewege mich auch ganz bestimmt nicht mehr, versprochen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130609
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 412130609,
					"content": "Ah, Herr Pallad ... Du brauchst nicht so zu kauern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130610
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130610,
					"content": "Hmpf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130611
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130611,
					"content": "Dieser Fluxeisbaum war schon tot. Vielleicht, weil er die verderbte Macht nicht absorbieren konnte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130612
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130612,
					"content": "Nachdem du die Verderbtheit entfernt hast, wurde er durch die nun pure Elementarenergie nicht nur wiedererweckt, sondern obendrauf noch stärker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130613
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130613,
					"content": "Die pure Lebenskraft bewirkt, dass er sich konstant regeneriert ... zusammen mit seinem Kampfeswillen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130614,
						412130615
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130614,
					"content": "Das könnte ganz schönen Ärger geben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130616
					]
				},
				{
					"id": 412130616,
					"content": "Mir ist etwas Ähnliches auch noch nicht begegnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130617
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130617,
					"content": "Und doch muss ich zugeben, dass ein dermaßen seltenes Phänomen, obgleich unerwartet, eine wertvolle Entdeckung ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130618
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130618,
					"content": "Saccharose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130619
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130619,
					"content": "Ah, ja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130620
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130620,
					"content": "Behalte diesen Abenteurer im Auge. Bring ihn ins Lager zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130621
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130621,
					"content": "Wird gemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130622
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412130622,
					"content": "#Und was die Sache hier betrifft, verzeih, {F#Reisende}{M#Reisender} ... Aber dürfte ich dich wieder um deine Unterstützung bitten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130623
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130623,
					"content": "Ich tu, was ich kann, um zu helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130624
					]
				},
				{
					"id": 412130624,
					"content": "Was für ein Chaos. Und wir sind die Einzigen, die sich darum kümmern können. Wahrscheinlich, weil wir uns ständig selbst übertreffen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130615,
					"content": "Das Ganze überrascht mich. Bin ich etwa zu stark?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130616
					]
				}
			]
		}
	]
}