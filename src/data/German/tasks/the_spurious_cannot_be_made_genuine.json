			},
			"dialogs": [
				{
					"id": 760470101,
					"content": "Äh ... Also, ich beobachte euch beide jetzt schon eine Weile, und ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470102
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470102,
					"content": "Ooh. Uns ausspionieren, meinst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470103
					]
				},
				{
					"id": 760470103,
					"content": "Oh, nein, ich meine nur ... Ich bin oft hier, um nach Büchern zu suchen, und habe zufällig bemerkt, dass ihr beide sehr daran interessiert seid, zu investieren. Ich ... muss euch davon abraten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470104
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470104,
					"content": "Nun, es stimmt, wir haben noch keine beträchtlichen Investitionserträge erzielt ... Aber warum rätst du davon ab, es überhaupt zu versuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470105,
					"content": "Weil ich vermute, dass es gar keine beträchtlichen Investitionserträge geben wird. Der Inhaber hat noch viele Schulden zu begleichen und wird wahrscheinlich keine Verluste riskieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470106
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470106,
					"content": "Mein Freund ist einmal in eine ähnliche Masche verwickelt worden, also wäre es besser, wenn ihr beide nicht weitermacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470107
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470107,
					"content": "#Moment, könnte es sich wirklich um Betrug handeln ...? {NICKNAME}, wir müssen den Kerl finden und der Sache auf den Grund gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
