					{
						"sceneId": 3,
						"position": [
							1670.347,
							239.932,
							9393.557
						],
						"pointId": 13574
					}
				]
			},
			"dialogs": [
				{
					"id": 760470201,
					"content": "Na, wenn das mal nicht meinen Stammgast ist! Willst du wieder ein paar Investitionspapiere kaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470202
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470202,
					"content": "Ein Vögelchen hat mir gezwitschert, dass deine Investitionspapiere Betrug sind ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470203
					]
				},
				{
					"id": 760470203,
					"content": "Wirklich jetzt? Bist du sicher, dass du nicht nur deiner Fantasie freien Lauf lässt, weil du derzeit Verluste erleidest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470204
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470204,
					"content": "Denk mal darüber nach. Wie kann es ein Geschäft geben, das nur Geld einbringt, aber kein Kapital kostet? Manche gewinnen und manche verlieren. Damals, als ich in Sumeru war ... Ähem, ich meine, ich habe schon eine Weile Pech gehabt, aber man kann nie wissen, wann sich das ändert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470205
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470205,
					"content": "„Hoffnung“ bedeutet Durchhalten. Wenn man weiterhin investiert, wird man eines Tages einen Gewinn erzielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470206,
						760470208
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470206,
					"content": "Na gut. Ich werde wiederkommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470207
					]
				},
				{
					"id": 760470207,
					"content": "Warte! Das kann doch nicht dein Ernst sein. Du akzeptierst das einfach so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470209,
					"content": "#Das wird nicht gut für dich ausgehen, Kumpel. Wir sind ... Richtig, wir sind die berühmten {NICKNAME} und Paimon. Wir haben viele Freunde hier in Nasha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470210,
					"content": "„Freunde“ ... Was meinst du? Warte. Meinst du „diese“ Art von Freunden!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470211
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470211,
					"content": "... Hm? Äh, ja, richtig! Genau die, an die du denkst – und wir haben jede Menge davon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470212,
					"content": "Was?!? Warum hast du das nicht vorher gesagt? Ich ... Äh ... Sieh mal. Es tut mir leid, in Ordnung? Ich lasse euch beide in Ruhe. Nehmt nur ... das hier. Und zwar alles. Nehmt es und geht, und kommt mir nicht wieder wegen Investitionspapieren – nicht, dass ich euch welche verkaufen würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470208,
					"content": "Du versuchst, mir etwas vorzumachen, was?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470209
					]
				}
			]
		}
	]
}