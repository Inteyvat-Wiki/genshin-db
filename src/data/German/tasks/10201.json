			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102010301,
					"content": "Oh, das ist der Eingang zu verlassenen Ruinen! Der Abgrundmagier ist bestimmt da hineingerannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010302,
						102010303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010302,
					"content": "Dann hat er auch keinen Ausweg mehr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010304
					]
				},
				{
					"id": 102010304,
					"content": "Puh ... huff ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010305
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010305,
					"content": "Klee, kannst du noch laufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010306,
					"content": "Willst du lieber hierbleiben? Sobald wir deinen Schatz zurückhaben, geben wir ihn dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010307,
					"content": "Nein ... Ich muss auf jeden Fall mitkommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010308
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010308,
					"content": "Dieser Flauschball hat mir etwas gestohlen und ich werde es mir persönlich zurückholen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010309,
						102010310
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010309,
					"content": "Du hast ordentlich Mut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010311
					]
				},
				{
					"id": 102010311,
					"content": "Hehe, Klee aber auch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010312
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010312,
					"content": "Ehrenritter, gehen wir schnell!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010310,
					"content": "In diesen Ruinen ist es aber sehr gefährlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010311
					]
				},
				{
					"id": 102010303,
					"content": "Gehen wir ihm hinterher.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010304
					]
				}
			]
		},
		{
			"id": 1020104,
			"completionStepIds": [
				1020111
