			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102010401,
					"content": "Verdammt, ihr habt mich! Ich habe euch unterschätzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010402
					],
					"speakerTitle": "Abgrundmagier"
				},
				{
					"id": 102010402,
					"content": "Viel weiter werdet ihr aber nicht kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010403
					],
					"speakerTitle": "Abgrundmagier"
				},
				{
					"id": 102010403,
					"content": "Was hast du denn vor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010404,
					"content": "Muahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010405
					],
					"speakerTitle": "Abgrundmagier"
				},
				{
					"id": 102010405,
					"content": "Wir haben bei den Menschen detaillierte Informationen zu eurer Stärke gesammelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010406
					],
					"speakerTitle": "Abgrundmagier"
				},
				{
					"id": 102010406,
					"content": "Dabei haben wir erfahren, dass dieses in Rot gekleidete Mädchen den größten Schatz von Mondstadt besitzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010407
					],
					"speakerTitle": "Abgrundmagier"
				},
				{
					"id": 102010407,
					"content": "Nun habe ich diesen Schatz, egal was ihr auch tut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010408
					],
					"speakerTitle": "Abgrundmagier"
				},
				{
					"id": 102010408,
					"content": "Und nun ... werde ich euch mit diesem Schatz vernichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010409
					],
					"speakerTitle": "Abgrundmagier"
				},
				{
					"id": 102010409,
					"content": "Nein! Du darfst ihn auf keinen Fall berühren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010410
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010410,
					"content": "Pah! Ihr erbärmlichen Kreaturen erstarrt vor meiner neuen Macht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010411
					],
					"speakerTitle": "Abgrundmagier"
				},
				{
					"id": 102010411,
					"content": "Lass mich sehen, ein Pyro-Symbol also ... Mnehehehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010412
					],
					"speakerTitle": "Abgrundmagier"
				},
				{
					"id": 102010412,
					"content": "Bumm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010501
					],
					"speakerTitle": "Abgrundmagier"
				},
				{
					"id": 102010501,
					"content": "Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010502
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010502,
					"content": "Überlebensregel: „Verständigung von Jean bei Verletzungen durch Explosionen“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010503
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010503,
					"content": "Oh, nein, diesmal habe ich wirklich Mist gebaut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010504
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010504,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010505,
					"content": "Dein Schatz war also eine Bombe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010506,
						102010507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010506,
					"content": "Absolut abgefahren ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010508
					]
				},
				{
					"id": 102010508,
					"content": "Deswegen gibt es also Leute, die Klee für die Stärkste in ganz Mondstadt halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010509,
					"content": "Jedenfalls wird Paimon es sicher nicht mit ihr verscherzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010510,
					"content": "Aber warum rennt sie denn jetzt davon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010511,
						102010512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010511,
					"content": "Das hat sicher mit diesen Überlebensregeln zu tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010513
					]
				},
				{
					"id": 102010513,
					"content": "Ah, du hast recht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010514,
					"content": "Dann gehen wir zum <color=#00E1FFFF>Ritterorden</color> und suchen Jean. Wir werden ihr von diesem Vorfall berichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010512,
					"content": "Sie hat Jeans Namen erwähnt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010513
					]
				},
				{
					"id": 102010507,
					"content": "Der Abgrundmagier war hat keine Sekunde überlebt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010508
					]
				}
			]
		},
