			},
			"dialogs": [
				{
					"id": 102010101,
					"content": "Wir sind da! Hier war es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010102,
					"content": "Seht doch nur! Hier war ein riesiger Schatz vergraben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010103,
					"content": "Und jetzt ist hier ein großes Loch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010104,
					"content": "Wartet, da ist jemand ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010105
					]
				},
				{
					"id": 102010105,
					"content": "Ein Abgrundmagier? Ist das einer von denen, vor denen uns Jean gewarnt hat? Sie kommen der Stadt immer näher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010106,
					"content": "Hmm, was hat er da in der Hand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010107,
					"content": "Das ist mein Schatz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010108
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010108,
					"content": "Was?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010109,
					"content": "Das Mädchen hat seine Helfer mitgebracht. Planänderung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010110
					],
					"speakerTitle": "Abgrundmagier"
				},
				{
					"id": 102010110,
					"content": "He, sei kein Feigling und bleib hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010111,
					"content": "Hinterher!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 1020103,
			"completionStepIds": [
				1020113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
