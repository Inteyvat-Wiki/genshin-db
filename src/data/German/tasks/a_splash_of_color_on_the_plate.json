			"dialogs": [
				{
					"id": 756730101,
					"content": "Sieht so aus, als wäre unser Farbenkünstler Asha jetzt zufrieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730102
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730102,
					"content": "Eine weitere Herausforderung für die wunderbaren Asha ist gemeistert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730103
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730103,
					"content": "Großartig! Wir haben es geschafft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730104,
					"content": "Hat dieser Asha hier schon wieder Inspiration für ein neues Kunstwerk gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730105,
						756730106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730105,
					"content": "Du weißt ja, wie das mit der Inspiration ist: Sie kommt so schnell, wie sie auch wieder verschwindet ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				},
				{
					"id": 756730107,
					"content": "#Ach, schau dir nur mal all die Schätze an, die er zurückgelassen hat ... {NICKNAME}, Paimon, ihr beide solltet sie haben! Für all die harte Arbeit, die ihr geleistet habt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730108
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730108,
					"content": "Vielleicht können wir beim nächsten Mal ja das Meisterwerk des Farbenkünstlers Asha bewundern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730109
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730109,
					"content": "Stell dir nur einmal vor, was das für eine Arbeit wäre! Vor allem, wenn schon die gewöhnlichen Asha so gut mit diesen wunderschönen Farben umgehen können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730110,
					"content": "Paimon kann es kaum abwarten, zu sehen, was der Asha erschaffen wird! Vielleicht fällt ihm etwas ein, das sich mit Worten unmöglich beschreiben ließe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730111,
					"content": "Vielleicht schenken sie uns ... ähm ... die Farben des Phlogistons, des Mondes oder etwas aus den Tiefen des Kosmos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730112,
					"content": "Ja, genau so sollte es sein! Wenn wir auf unseren Abenteuern einem Wesen begegnen, das in Schwierigkeiten steckt, sollten wir alles in unserer Macht Stehende tun, um ihm zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730113
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730113,
					"content": "Mhm! Wer weiß? Vielleicht bringt uns das eines Tages ja unerwartete Vorteile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730114,
						756730115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730114,
					"content": "Ich bin da ganz bei Bennett.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730116,
					"content": "Ach, aber ... wir sollten es nicht nur wegen einer zu erwartenden Belohnung tun. Das würde das Thema verfehlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730117
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730117,
					"content": "Auch wenn wir selbst nichts davon hätten: Freunden in Not zu helfen und zu sehen, wie ihr Lächeln zurückkehrt, wenn sich die Lage zum Besseren wendet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730118
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730118,
					"content": "Dieses Gefühl gefällt mir wirklich sehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730115,
					"content": "Und es gibt auch ein sehr erfüllendes Gefühl.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730106,
					"content": "Man muss das Eisen also schmieden, solange es noch heiß ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				}
			]
		}
	]
}