			"dialogs": [
				{
					"id": 747090101,
					"content": "#Tolle Leistung, {NICKNAME} und Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090102,
					"content": "Ich kenne den Zustand unserer Patienten jetzt ziemlich gut, also habe ich ihnen etwas spezielle Melusinen-Medizin zusammengemischt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090103,
					"content": "Diese speziellen Kräuter ins Becken zu geben, sollte helfen, sie zu beruhigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090104,
					"content": "Du machst also im Grunde aus dem ganzen Becken ein riesiges Heilbad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747090105,
					"content": "Das ist wirklich ein Plan, den nur du haben könntest, Sigewinne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090106,
						747090107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747090106,
					"content": "Aber wird das ihre Symptome nicht nur vorübergehend lindern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747090108
					]
				},
				{
					"id": 747090108,
					"content": "Da hast du völlig recht. Ich muss eine ganze Menge verschiedener Fische zu Untersuchungen hierher einladen, bevor ich genau herausfinden kann, was nicht stimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090109,
					"content": "Ich werde eine Liste mit Patienten zusammenstellen, die ich untersuchen muss, basierend auf den Eigenschaften, die ich brauche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090110,
					"content": "Ich wäre euch dankbar, wenn ihr nach Fischen Ausschau halten könntet, die diese Kriterien erfüllen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090107,
					"content": "Um sie vollständig zu heilen, müssen wir noch die eigentliche Ursache finden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747090108
					]
				}
			]
		}
	]
}