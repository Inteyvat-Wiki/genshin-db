			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104201",
							"2"
						],
						"stepId": 1104201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420101,
					"content": "Paimon hat eine Frage. Wird aus dem Samen etwas Bestimmtes wachsen, wenn er sprießt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420102,
					"content": "Ich weiß es nicht. Aber ich habe das Gefühl, dass der Vorgang wichtiger ist als das Ergebnis selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420103,
					"content": "Leben aus anderen Welten in Teyvat erwecken zu können, würde meinem Verständnis für die Essenz des Lebens unheimlich zuträglich sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420104,
					"content": "Nach dem Erwecken könnte selbst Schöpfung möglich sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420105
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420105,
					"content": "Äh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420106,
					"content": "Haha, ist die Sache immer noch nicht so leicht zu verstehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420107,
					"content": "N... Nein! Paimon ist schlau! Aber was wird aus dem Samen werden? Ist das nicht interessanter als das, was immer du gerade gesagt hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420108,
						110420109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420108,
					"content": "Anscheinend hast du doch nicht verstanden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				},
				{
					"id": 110420110,
					"content": "Nun, sollte daraus eine leckere Frucht wachsen, lade ich dich zum Abendessen ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420111,
					"content": "Hurra! Paimon wird das nicht vergessen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420112,
						110420113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420112,
					"content": "Du weißt auf jeden Fall, wie man Paimon für eine Sache gewinnt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420114,
					"content": "Na ja, sagen wir einfach, dass ich ... manchmal auf ein Kind aufpassen muss. Eine Erklärung würde wieder zu lange dauern, fürchte ich. Wahrscheinlich gehört das zu den wenigen nicht-alchimistischen Fachgebieten, in denen ich gut bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420115
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420115,
					"content": "Meine erste Forschung drehte sich um die Elemente. Wenn man in dieser Welt Elemente manipulieren will, braucht man ein Göttliches Auge. Obwohl ich das bei dir nicht erkennen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420116,
					"content": "Wie man die Macht der Elemente nach freiem Willen manipulieren kann, das ist etwas, das ich erkunden möchte. Zu diesem Thema habe ich ein paar Fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420117,
					"content": "Erstens, hast du zusätzliche Organe? Ein zweites Herz, einen vierten Magen, du weißt schon ... So etwas in der Art.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420118,
						110420119
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420118,
					"content": "Nein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420120,
					"content": "Faszinierend. Und dieses schwebende Kind ist ... mit deinem Körper irgendwie verbunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420121
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420121,
					"content": "Was für eine dumme Frage! Siehst du den Abstand zwischen uns nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420122,
					"content": "Und noch was. Das ist PAIMON! Kein schwebendes Kind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420123,
					"content": "Ich habe einfach nur überlegt, dass du vielleicht ein externes Organ sein könntest. Vielleicht seid ihr durch eine unsichtbare Macht verbunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420124,
						110420125
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420124,
					"content": "Ich habe Paimon auf meiner Reise kennengelernt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420126,
					"content": "Oh, dann ist meine Überlegung natürlich hinfällig. Hat dir Paimon die Macht der Elemente zugeführt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420127
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420127,
					"content": "Aber das würde bedeuten, dass Paimons Elementarkraft ausreichen würde, um durch mindestens zehn Meter dicke Bergfelsen zu brechen. Oder um den Wasserfall südlich von Quellingen rückwärts fließen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420128
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420128,
					"content": "Hmm. Das kann es auf keinen Fall sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420129
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420129,
					"content": "Paimon durfte noch gar nichts sagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420130,
					"content": "Wenn das so ist, unterscheidet sich dein Körper wohl nicht offensichtlich von denen der Menschen in dieser Welt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420131
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420131,
					"content": "Da das eindeutig eine Unstimmigkeit in meiner Forschung ist, werden vermutlich nur Experimente Antworten bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420132
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420132,
					"content": "Erstens, diese mysteriöse Elementarkraft. Ich würde gerne untersuchen, wie sie sich nach außen manifestiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420133
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420133,
					"content": "Ich locke ein paar Schleime in die Gegend. Könntest du sie auf eine Art besiegen, die dir am natürlichsten vorkommt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420134
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420134,
					"content": "Hm. Das klingt nicht besonders „wissenschaftlich“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420135,
					"content": "Direkte und eindeutige Beobachtungen sind unabdingbar für ein gutes Experiment. Das ist nur eine einfache Übung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420136
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420136,
					"content": "Wenn du natürlich eine größere Herausforderung haben möchtest, könnten wir sechs Okeanide herbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420137
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420137,
					"content": "Schleime! Schleime sind gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420138,
						110420139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420138,
					"content": "Ich verstehe nicht. Das Ganze klingt ziemlich ungemütlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420140,
					"content": "Mach dich bereit. Die Schleime sind gleich da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420139,
					"content": "Solange ich nicht von Hydro-Phantome zu Brei geschlagen werde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420125,
					"content": "Ich habe Paimon mit einer Angel eingeholt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420119,
					"content": "Nicht, dass ich wüsste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420113,
					"content": "Du weißt, was Paimon bewegt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420109,
					"content": "Das würde ich auch gerne wissen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				}
			]
		},
		{
			"id": 1104203,
			"completionStepIds": [
				1104203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104203",
							"2"
						],
						"stepId": 1104203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420301,
					"content": "Wunderbar! Hast du etwas Außergewöhnliches gespürt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420302
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420302,
					"content": "Wenn du verletzt bist, habe ich ein paar Notfalltränke dabei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420303,
						110420304
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420303,
					"content": "Kein Kratzer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				},
				{
					"id": 110420305,
					"content": "Ausgezeichnet. Laut meinen Beobachtungen hat sich der externe elementare Fluss wie erwartet manifestiert. Die Elementare haben normal reagiert. Nichts Ungewöhnliches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420306,
					"content": "Da wir jetzt wissen, dass sich der externe Fluss normal manifestiert, sollten wir den internen Fluss testen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420307
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420307,
					"content": "Interner Fluss? Wie testet man das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420308,
					"content": "Ganz einfach. Ich kann einen Trank brauen, der Elementarkraft entzieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420309,
					"content": "Wenn die Elementarkraft in deinem Körper gelagert oder gesammelt wird, könnte dieser Trank eine elementare Reaktion auslösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420310,
						110420311
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420310,
					"content": "Krieg ich davon Magenschmerzen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420312,
					"content": "Klingt irgendwie zum Fürchten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420313,
					"content": "Keine Sorge. Im Regelfall solltest du nur vorübergehend ein flaues Gefühl im Magen haben. Keine echten Verletzungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420314,
					"content": "Und im Ausnahmefall?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420315,
					"content": "Wenn etwas Unerwartetes passiert, treffe ich die nötigen Vorkehrungen, keine Sorge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420316
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420316,
					"content": "Das beruhigt mich nicht besonders ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420317
					]
				},
				{
					"id": 110420317,
					"content": "Na ja, es ist nicht so, als ob die Sache keine Risiken hätte. Aber wenn es etwas gibt, das deinen Fluss der Elemente blockiert, können wir das mit diesem Test finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420318
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420318,
					"content": "Kleine Warnung. Wenn eine interne elementare Reaktion aus irgendeinem anderen Grund passiert, ist das ein schlechtes Zeichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420319
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420319,
					"content": "Das ist wie eine Vorsorgeuntersuchung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420320
					]
				},
				{
					"id": 110420320,
					"content": "Genau! Das ist eine ausgezeichnete Perspektive. Bevor wir anfangen ... Dem Trank, den wir für diesen Test nutzen, fehlt der Katalysator. Wir müssen einen finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420321,
					"content": "Es ist ein Erz, das sogenannte Sternensilber, aber leider ist nicht alles davon geeignet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420322
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420322,
					"content": "Ich nehme euch mit zu meinem Lager. Auf dem Weg können wir etwas Sternensilbererz sammeln. Ich zeige euch, was eventuell passen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420323
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420323,
					"content": "Wenn alles so klappt, wie ich es mir vorstelle, sollten wir mit dem Brauen des Tranks beginnen können, sobald wir das Lager erreicht haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420324
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420324,
					"content": "Paimon hat immer noch ein paar Sicherheitsbedenken, aber das Ganze scheint auch Vorteile zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420325,
					"content": "Halten wir unsere Augen offen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420311,
					"content": "Wird das in meinem Magen kristallisieren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420304,
					"content": "Mir ist nur ein wenig kalt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				}
			]
		},
		{
			"id": 1104205,
			"completionStepIds": [
				1104205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104205",
							"2"
						],
						"stepId": 1104205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420501,
					"content": "Das ist mein Lager. Ich habe die gesammelten Materialien gleich verwertet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420502,
					"content": "Während wir warten, schaut mal hier drüben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420503,
					"content": "Mein Assistent Timaeus hilft mir bei meiner Forschung. Ich vermute, ihr habt euch in Mondstadt bereits kennengelernt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420504,
					"content": "Hallo. Ich habe gerade die Daten deines Experiments ausgewertet, der Bericht ist bereits auf dem Brett hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420505
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420505,
					"content": "Boah! Sieh sich mal einer die ganzen Daten an! Du hast all diese Ergebnisse aus einem Kampf gegen einen Schleim entnommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420506,
					"content": "Haha. Ergebnisse ist nicht das richtige Wort. Folgerungen und ein paar gewagte Vermutungen vielleicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420507
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420507,
					"content": "#Ich glaube, am vernünftigsten wäre es, die phylogenetische Verwandtschaft zwischen {F#der}{M#dem} Reisenden und den Schleimen zu erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420508,
						110420509
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420508,
					"content": "Vernünftig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420510
					]
				},
				{
					"id": 110420510,
					"content": "Überlege mal. Du hast kein Göttliches Auge, aber du kannst die Elementarenergie manipulieren. Die Schleime haben auch kein Göttliches Auge, und doch können sie die Elemente wie du manipulieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420511
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420511,
					"content": "Wenn man diesen Gedanken fortsetzt, bin ich mir sogar sicher, dass wir eine gemeinsame Basis finden werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420512
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420512,
					"content": "Der Ansatz ist nicht schlecht, aber streng genommen sind Schleime elementare Lebensformen. In anderen Worten, sie sind Wesen, die ausschließlich aus den Elementen bestehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420513
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420513,
					"content": "Ein Fluxeisbaum oder selbst eine Vaniloqua würden eine bessere Analogie abgeben. Aber der phylogenetischen Verwandtschaft zwischen Pflanzen und Tieren auf den Grund zu kommen ... da müsste man wohl bis auf die Entstehung der Welt zurückblicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420514
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420514,
					"content": "Und das wäre dann doch ein wenig kompliziert, findest du nicht auch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420515,
					"content": "Äh! Jawohl. Das stimmt bestimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420516
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420516,
					"content": "#Schließlich haben wir doch bereits grundlegende Daten gesammelt. {F#Diese}{M#Dieser} Reisende ist aus einer anderen Welt zu uns gekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420517,
					"content": "#Würde sich herausstellen, dass {F#sie}{M#er} mit dieser Welt auf phylogenetische Weise verwandt ist ... Das wäre doch was, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420518,
					"content": "Aaah, eindeutig! Tut mir leid, ich war so aufgeregt wegen der Daten. Nächstes Mal zügle ich mich ein wenig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420519
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420519,
					"content": "Apropos Daten ... Um unsere Forschung abzuschließen, brauchen wir noch mehr davon. Ich werde mich vorerst um die Analyse hier kümmern. Wenn du wissen willst, wie es läuft, kannst du mich jederzeit aufsuchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420520
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420520,
					"content": "Ausgezeichnet. Mach das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420521,
					"content": "Sieht aus, als wäre der Trank fertig. Ich probiere ein Schlückchen. Wenn alles so klappt, wie ich es mir denke, reiche ich ihn dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420509,
					"content": "Ich hätte gewettet, dass selbst Paimon und ich näher miteinander verwandt sind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420510
					]
				}
			]
		},
		{
			"id": 1104206,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104206",
							"2"
						],
						"stepId": 1104206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420601,
					"content": "Ich habe ihn probiert. Er funktioniert so wie erwartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420602
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420602,
					"content": "Denk daran, stets ruhig zu bleiben, und atme tief, solltest du dich unwohl fühlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420603
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420603,
					"content": "Ich werde alle sichtbaren Ergebnisse und Daten aufschreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 1104207,
			"completionStepIds": [
				1104207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104207",
							"2"
						],
						"stepId": 1104207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420701,
					"content": "#Und schmeckt er, {NICKNAME}? Du verziehst dein Gesicht ein wenig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420702,
						110420703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420702,
					"content": "Er ... brennt ein bisschen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				},
				{
					"id": 110420704,
					"content": "#Du hast gesagt, du hättest schon einen Schluck probiert! Bist du sicher, dass er fertig ist? Was passiert mit {F#ihr}{M#ihm}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420705,
					"content": "Hmm? Oh, das habe ich erwartet. Und ich muss schon sagen, das Ergebnis ist äußerst positiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420706
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420706,
					"content": "Dieser Trank kanalisiert die Elementarkraft in den Körper. Unter normalen Umständen kann man eine Abwehrreaktion erwarten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420707
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420707,
					"content": "Aber der interne elementare Fluss ist nicht gestört, du wirst dich nur kurz etwas unwohl fühlen. Sobald alles fließt, wird es keine weiteren Effekte mehr geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420708
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420708,
					"content": "Du wusstest also, dass der Trank dich krank machen würde, und du hast ihn trotzdem getrunken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420709,
					"content": "Hehe, das war doch mein eigenes Gebräu, natürlich bin ich das Versuchskaninchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420710,
						110420712
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420710,
					"content": "Weil du ... dir um das Testobjekt Sorgen machst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420711
					]
				},
				{
					"id": 110420711,
					"content": "Natürlich! Du bist mein Assistent! Es wäre grundlegend verwerflich, dir dieses Risiko zuzumuten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420714,
					"content": "Und schließlich kann ich sagen, dass wir zu unserer Schlussfolgerung gelangt sind! Was die Elementarenergie betrifft, unterscheidest du dich nicht von den Bewohnern dieser Welt. Keine Auffälligkeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420715
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420715,
					"content": "Paimon hätte sich gewünscht, dass etwas Witzigeres passiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420716,
					"content": "Aber dann wieder, lieber ein gewöhnliches Ergebnis als ein auffälliges. Auffällige Ergebnisse haben eine gewisse Tendenz, Variationen aufzuweisen, die nicht unbedingt ... wünschenswert sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420717
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420717,
					"content": "Das war jetzt aber verdächtig spezifisch ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420718
					]
				},
				{
					"id": 110420718,
					"content": "Das Gute am Gewöhnlichen ist, dass alles ein Referenzobjekt sein kann und man von allen verstanden wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420719
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420719,
					"content": "Die Menschen sind alle gleich, sie können einander verstehen, mitfühlen, sich ermutigen und unterstützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420720
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420720,
					"content": "Wenn du krank bist, kann ein Arzt eine Diagnose stellen, weil er so ist wie du. Wenn etwas schiefgeht, kannst du Menschen um Rat fragen, die denselben Fehler gemacht haben, weil du so bist wie sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420721
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420721,
					"content": "Im anderen Fall ... im auffälligen Fall ... können sich Menschen nicht auf das berufen, das wir für selbstverständlich erachten. Die Essenz ihres Lebens ist völlig anders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420722
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420722,
					"content": "Zum Beispiel ... kann ein Mensch das Leben eines Fluxfeuerbaums oder eines Auges des Sturms nicht verstehen. Habe ich das halbwegs verständlich ausgedrückt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420723,
						110420724
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420723,
					"content": "Ich glaube, ich begreife langsam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420725,
					"content": "Lange Rede kurzer Sinn: Das war ein äußerst positives Ergebnis. Du kannst unsere Elementarkraft in Zukunft nutzen, ohne Angst haben zu müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420726
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420726,
					"content": "Timaeus, die Ergebnisse des neuen Experiments sind da. Wenn du sie vielleicht zuordnen könntest ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420727
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420727,
					"content": "Kurzen Moment! Ich kümmere mich darum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420728
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420728,
					"content": "Du hast mir viel Stoff zum Grübeln gegeben, meine Grenzen erweitert. Vieles ist mir um einiges klarer geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420729
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420729,
					"content": "Dich mit Tieren in eine Schublade zu werfen, war nicht sehr präzise von mir, aber die Sache mit der elementaren Lebensform? Das war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420730
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420730,
					"content": "Nicht schlecht. Ich glaube, das ist ein interessanter Ansatz. Was auch immer dabei herauskommt, ich möchte deine Forschung priorisieren und nicht mein persönliches Urteil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420731
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420731,
					"content": "Du kannst auf mich zählen! Ich werde ein Ergebnis produzieren, das alle zufriedenstellen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420732
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420732,
					"content": "Zieht er in den Krieg? Entmutigt ist er jedenfalls ganz sicher nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420733,
					"content": "Ähm ... Was Paimon sagen wollte, war ... Sehr gut! Albedo ... Sag was ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420734,
					"content": "Hmm ... bevor wir unsere Forschung fortsetzen können, muss ich ... etwas vorbereiten. Momentchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420735
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420735,
					"content": "Wenn ihr Lust habt, könnt ihr euch ruhig ein wenig umsehen. Dann vergeht die Zeit ein bisschen schneller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420724,
					"content": "Klingt immer noch ... verdächtig spezifisch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420712,
					"content": "Und bei dir ist es egal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420713
					]
				},
				{
					"id": 110420713,
					"content": "Vielleicht ist das nur das Selbstbewusstsein eines Gelehrten ... und es hat die Sache auf jeden Fall beschleunigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420703,
					"content": "Ich möchte mal sehen, wie du was davon trinkst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				}
			]
		},
