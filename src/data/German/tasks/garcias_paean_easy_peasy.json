			"dialogs": [
				{
					"id": 230165001,
					"content": "Herr, es scheint mir, als sollten wir unsere ... Perspektive ein wenig ändern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165002,
					"content": "Unsere Perspektive ändern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165003
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230165003,
					"content": "Zum Beispiel, könnten wir eine clevere, dafür weniger komplexe Maschine herstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165004,
					"content": "Ich glaube fest daran, dass deine Talente für diesen Typ von Maschine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165005,
					"content": "Mein lieber Lutong, wir haben das Thema schon durchgekaut. Du kennst meine Antwort ... Und ich respektiere deine Wahl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230165006,
					"content": "Unterhalten wir uns lieber darüber, wo dein nächstes Abendessen mit Fräulein Kaia stattfinden wird, Herr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165007
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165007,
					"content": "Danke, Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165008
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230165008,
					"content": "Mein Vergnügen, Herr. Unser Vertrag ist noch nicht abgelaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
