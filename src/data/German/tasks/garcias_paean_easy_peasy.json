			"dialogs": [
				{
					"id": 230163901,
					"content": "Garcia beginnt mit der Arbeit ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230163902
					]
				},
				{
					"id": 230163902,
					"content": "Aha! Geschafft! Das Zahnrad sieht toll aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163903
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230163903,
					"content": "Der Abstand zwischen den Zähnen ... Dicke ... Größe ... Ich muss ein Lineal holen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163904
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230163904,
					"content": "#Lassen wir Herrn Garcia bei seinen Messungen allein. {F#Reisende}{M#Reisender}, die Bezahlung ist für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163905
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163905,
					"content": "Bist du immer noch verhalten pessimistisch?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230163906
					]
				},
				{
					"id": 230163906,
					"content": "Ja, immer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163907
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163907,
					"content": "Herr Garcia und ich stehen vor einem großen Berg. Jetzt haben wir einen kleinen Steinbrocken am Fuße des Bergs weggeschafft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163908
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163908,
					"content": "Aber ehrlich gesagt, haben wir immer noch keinen Weg in den Berg gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163909
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163909,
					"content": "Hoffentlich führen uns Herrn Garcias Talente auf den rechten Weg ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163910
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163910,
					"content": "Sonst muss ich immer das Sprichwort „Wo ein Berg ist, ist ein Weg“ ins Gedächtnis rufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
