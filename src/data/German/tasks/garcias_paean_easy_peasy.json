					"id": 230165101,
					"content": "Hast du noch weitere Fragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165102,
						230165105
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165102,
					"content": "Ist Garcia schon lange hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230165103
					]
				},
				{
					"id": 230165103,
					"content": "Schon eine Weile. Er ist viel wissbegieriger als manche meiner Lehrlinge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165104
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165104,
					"content": "Aber er erscheint mir nicht wie jemand, der sein Brot als Schmied verdient ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165105,
					"content": "Ist außer mir noch jemand zu ihnen gekommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230165106
					]
				},
				{
					"id": 230165106,
					"content": "Hm ... Es gibt da eine Frau, die ihm dann und wann einen Besuch abstattet und jedes Mal einen Haufen Sachen mitbringt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165107
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165107,
					"content": "Ich habe gehört, sie heißt Kaia ... oder so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165108
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165108,
					"content": "Diese Menschen sehen nicht aus, als hätten sie etwas mit Schmieden am Hut. Warum versammeln sie sich in meiner Schmiede ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				}
			]
		},
