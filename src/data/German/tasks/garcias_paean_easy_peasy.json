			"dialogs": [
				{
					"id": 230160301,
					"content": "Lutong! Dieses Zahnrad kann aus der Form genommen werden! Hilf mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160302,
					"content": "#{F#Reisende}{M#Reisender}, du bist wieder da! Also hast du bestimmt die Techniken von Herrn Ahangar mitgebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160303,
					"content": "Los, sag schon! Was soll ich mit diesem Zahnrad anstellen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
