			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160101,
					"content": "Meine Hände ... Argh! Sie sind taub ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160102,
					"content": "Herr, du musst noch die Konten für Fräulein Kaia ausgleichen. Du darfst dich nicht überanstrengen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160103,
					"content": "Ich ... Ich weiß! Lutong, kein Wort davon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160104
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160104,
					"content": "Wenn du es nicht schaffst, kann ich natürlich an deiner Stelle gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160105,
					"content": "Nein! Ich gehe selbst. Ich muss nur ... ein paar Zahnräder mehr schmieden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160106,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160107,
					"content": "Na gut, ich gebe auf. Ich kann nicht mehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160108
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160108,
					"content": "Was treibst du schon wieder ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160109
					]
				},
				{
					"id": 230160109,
					"content": "#Du bist’s, {F#Reisende}{M#Reisender} ... Ach ... Meine Hände ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160110,
					"content": "Die Sache ist so. Herr Ahangar ist anderweitig beschäftigt und kann die Teile, die ich brauche, nicht schmieden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160111,
					"content": "Außerdem weichen die von ihm hergestellten Teile stets ein wenig von meinen Vorstellungen ab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160112
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160112,
					"content": "Um für die Funktionstüchtigkeit der Teile zu gewährleisten, habe ich beschlossen, sie höchstpersönlich zu schmieden und das Handwerk direkt von Herrn Ahangar erlernt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160113,
					"content": "Zum Glück habe ich mir ähnliche Kenntnisse in Fontaine angeeignet ... Nur leider kann ich mir manche Techniken von Herrn Ahangar nur schwer merken. Autsch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160114
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160114,
					"content": "#{F#Reisende}{M#Reisender}, kannst du dich von Herrn Ahangar zu seinen Techniken beraten lassen? Ich brauche dringend eine Pause ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160115,
						230160116
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160115,
					"content": "Ruh dich hier gut aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160121
					]
				},
				{
					"id": 230160121,
					"content": "Danke, dass du bereit bist zu helfen. Aua! Meine Hand ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160116,
					"content": "Wer ist Kaia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160117
					]
				},
				{
					"id": 230160117,
					"content": "Eine Geschäftspartnerin! Eine ... ummm ... sehr talentierte und sehr reiche ... Geschäftspartnerin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160118
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160118,
					"content": "Wir haben einen langfristigen Vertrag zur Kontenverwaltung unterzeichnet! Deshalb gehe ich ständig zu ihr, stimmt’s oder hab ich recht, Lutong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160119
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160119,
					"content": "Das entspricht den Tatsachen, Herr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160120,
					"content": "#S... So steht die Sache ... {F#Reisende}{M#Reisender}, bitte suche Herrn Ahangar so schnell wie möglich auf. Ich warte hier auf dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
		{
			"id": 2301602,
			"completionStepIds": [
				2301602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301602",
							"2"
						],
						"stepId": 2301602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ahangar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160201,
					"content": "Ich habe doch gesagt, du musst warten ... Huch? Was machst du hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160202,
						230160203
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160202,
					"content": "Ich bin gekommen, um dir ein paar Fragen in seinem Namen zu stellen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				},
				{
					"id": 230160204,
					"content": "Also macht er es wirklich selbst ... Was für ein komischer Kauz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160205
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160205,
					"content": "In all meinen Jahren als Schmied habe ich noch nie jemanden gesehen, der so hohe Ansprüche stellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160206
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160206,
					"content": "Er hat sogar ein Lineal mitgebracht, um die Fugen zwischen den Rohren und den Abstand zwischen den Gewinden zu messen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160207
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160207,
					"content": "Meine Geduld ist am Ende, also habe ich ihm gesagt, er kann seine Sachen selbst schmieden ... Am nächsten Tag kam er tatsächlich und hat meine Schmiedetechnik gelernt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160208
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160208,
					"content": "Wirklich, ich konnte nur kapitulieren und ihn sein lassen. Solange er für das Material aufkommt, kann er all meine Werkzeuge benutzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160209
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160209,
					"content": "*seufz* Keine Ahnung, was in diesem Typen vorgeht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160210,
						230160211
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160210,
					"content": "Er baut eine große Maschine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160212,
					"content": "Meinetwegen ... Jedenfalls eine komische Sache. Ihr seid hier, um meine Schmiedetechnik zu erlernen, nicht wahr? Ich habe nicht viel zur Herstellung von Zahnrädern zu sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160213
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160213,
					"content": "Aber ich habe bemerkt, dass die Ränder seiner Zahnräder scharf sind und konkav in der Mitte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160214
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160214,
					"content": "Diese Art von Zahnrad kann nicht mit einfachen Formen gegossen werden. Die Zahnräder benötigen eine zusätzliche Behandlung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160215
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160215,
					"content": "Den genauen Prozess habe ich ihm bereits dargelegt. Du musst ihn nur an Folgendes erinnern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160216
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160216,
					"content": "Zunächst darfst du <color=#00E1FFFF>nicht vergessen, etwas mehr Brennstoff hinzuzufügen</color>, wenn du dies das zweite Mal in den Brennofen gibst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160217
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160217,
					"content": "Und wenn du es dann für die Verarbeitung herausholst, musst du <color=#00E1FFFF>von innen nach außen hämmern</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160218
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160218,
					"content": "Und? Konntest du dir alles merken? Dann geh zu ihm zurück und erzähle ihm alles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160219
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160219,
					"content": "Was für ein Spinner ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160211,
					"content": "Er baut eine merkwürdige Maschine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160203,
					"content": "Seine Hände sind taub und er braucht eine Pause.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				}
			]
		},
		{
