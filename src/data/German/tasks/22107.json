			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221070101,
					"content": "„Liebe ist wie ein Schmetterling, der um dich herumflattert. Nur wenn du stillstehst, wird sich der Schmetterling auf dir niederlassen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070102
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070102,
					"content": "Wovon sprichst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070103
					]
				},
				{
					"id": 221070103,
					"content": "Natürlich geht es um mein Liebeshoroskop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070104
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070104,
					"content": "Dieses Horoskop hat Qiming extra für mich gemacht, extra für mich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070105
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070105,
					"content": "Sie will damit bestimmt etwas andeuten. Aber was genau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070106
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070106,
					"content": "Ich habe mal in einem Buch gelesen, dass ganz viele auffällige Dinge passieren, wenn sich ein Horoskop bewahrheitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070107
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070107,
					"content": "Ich glaube, dass mein Liebesglück zum Greifen nah ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070108
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070108,
					"content": "Kannst du dich vielleicht auch ein bisschen nach diesen Zeichen umsehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070109,
						221070110
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070109,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070111
					]
				},
				{
					"id": 221070111,
					"content": "Danke sehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070110,
					"content": "Warum machst du das nicht selbst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070112
					]
				},
				{
					"id": 221070112,
					"content": "Man sagt doch, dass man als Außenstehender viel neutraler ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070113
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070113,
					"content": "Ich würde wahrscheinlich alles als ein Zeichen für mein Liebesglück interpretieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070114
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070114,
					"content": "Deswegen zähle ich auf dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
