			},
			"dialogs": [
				{
					"id": 221071301,
					"content": "Eine Katze und ein Fisch haben sich angefreundet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071302
					]
				},
				{
					"id": 221071302,
					"content": "Selbst so ein Zeichen ist nicht vor dir verborgen geblieben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071303
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071303,
					"content": "Eine so ungewöhnliche Freundschaft ist etwas Großartiges sowohl für die Katze als auch für den Fisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071304
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071304,
					"content": "Das muss Liebe sein! Die Kraft der Liebe macht alles möglich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071305
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071305,
					"content": "Wenn ich könnte, würde ich ihnen Glück wünschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071306
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071306,
					"content": "Dieses Zeichen sagt mir, dass Liebe keine Grenzen kennt. Und deshalb wird Qiming auch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071307
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071307,
					"content": "Hach! Danke, danke euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210714,
			"completionStepIds": [
				2210714
			],
			"beginWay": "TALK_BEGIN_NONE",
