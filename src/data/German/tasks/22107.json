						],
						"stepId": 2210710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071001,
					"content": "Ich habe auf dem Dach ein Vogelpärchen gesehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071002
					]
				},
				{
					"id": 221071002,
					"content": "Oh, das klingt doch gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071003
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071003,
					"content": "Zwei Tauben fern von ihrem Schwarm und doch vereint im Glück. Ich wünsche ihnen alles Gute!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071004
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071004,
					"content": "Dieses Zeichen steht dafür, dass ich bald den Menschen finden werde, der nur Augen für mich hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071005
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071005,
					"content": "Mit diesem Menschen werde ich jede Schwierigkeit bezwingen und für immer zusammen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071006
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071006,
					"content": "Hach! Vielen Dank! Demnächst werde ich Qiming noch einen Besuch abstatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210711,
			"completionStepIds": [
				2210711
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2210711",
							"2"
						],
						"stepId": 2210711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071101,
					"content": "Im Laden läuft das Geschäft heute einwandfrei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071102
					]
				},
				{
					"id": 221071102,
					"content": "Das Geschäft läuft gut? Das heißt, dass es Geld regnen wird. Das ist toll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071103
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071103,
					"content": "Ich muss nur geduldig und fleißig sein. Dann werde ich auch die Früchte meiner Arbeit ernten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071104
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071104,
					"content": "Dieses Zeichen steht bestimmt für meine Finanzen und mein Liebesleben zugleich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071105
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071105,
					"content": "Hach! Das ist großartig ... Ich danke euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071106
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071106,
					"content": "Qiming, eines Tages werde ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210712,
			"completionStepIds": [
				2210712
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2210712",
							"2"
						],
						"stepId": 2210712,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071201,
					"content": "Da ist viel Laub.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071202
					]
				},
				{
					"id": 221071202,
					"content": "Hmm, das wird wohl kaum etwas mit deinem Liebesleben zu tun haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071203,
					"content": "Laub? Natürlich hat es das!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071204
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071204,
					"content": "Diese Blätter scheinen zwar nutzlos zu sein, doch im entscheidenden Moment ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071205
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071205,
					"content": "Mit nur einem Funken könnten sie einen großen Brand verursachen, der sich geschwind ausbreitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071206
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071206,
					"content": "Das bedeutet doch, dass ich nur auf die richtige Gelegenheit warten muss, damit Qiming und ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071207
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071207,
					"content": "Doch das Schicksal wird vom Himmel entschieden. Wann und in welcher Form diese Gelegenheit kommt, wird mir wohl keiner sagen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071208
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071208,
					"content": "Aber eins ist gewiss, sie wird eintreffen! Ich muss nur geduldig sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071209
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071209,
					"content": "Ich habt das jedenfalls gut gemacht.",
					"roleType": "TALK_ROLE_NPC",
