					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071401,
					"content": "Da war ein Rudel Hündchen zusammen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071402
					]
				},
				{
					"id": 221071402,
					"content": "Was ist das denn für ein Zeichen? Heißt das, dass es schon aus für mich ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071403
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071403,
					"content": "Hm, aber wenn die Hunde so gut miteinander auskommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071404,
					"content": "Ich kenne die Hunde. Sie kommen gut miteinander aus und spielen schon seit Jahren zusammen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071405
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071405,
					"content": "Sieht doch ganz gut aus. Aber keiner von ihnen hat einen echten Partner gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071406
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071406,
					"content": "Wenn sie einmal alt sind, wird sich das wohl auch nicht mehr ändern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071407
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071407,
					"content": "Sagt dieses Zeichen aus, dass ich meine Zeit mit meinen Freunden verbringen, aber niemals meine bessere Hälfte finden werde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071408
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071408,
					"content": "Das ... Das muss ich erst einmal verarbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
