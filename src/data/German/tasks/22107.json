				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071601,
					"content": "Ich habe auf dem Dach ein Vogelpärchen gesehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071602
					]
				},
				{
					"id": 221071602,
					"content": "Oh, das klingt doch gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071603
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071603,
					"content": "Zwei Tauben fern von ihrem Schwarm und doch vereint im Glück. Ich wünsche ihnen alles Gute!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071604
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071604,
					"content": "Dieses Zeichen steht dafür, dass ich bald den Menschen finden werde, der nur Augen für mich hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071605
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071605,
					"content": "Mit diesem Menschen werde ich jede Schwierigkeit bezwingen und für immer zusammen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071606
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071606,
					"content": "Ähem, dankeschön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071607
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071607,
					"content": "Ich weiß auch nicht, woher sie sich kennen und warum sie sich lieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071608
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071608,
					"content": "Ach, es ist einfach schade, dass ich keine Taube bin und nicht an diesem Glück teilhaben kann. Wirklich schade ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071609
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071609,
					"content": "Besser zwei Tauben auf dem Dach als ... eine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071610
					]
				},
				{
					"id": 221071610,
					"content": "Auf dem Dach? Was? Meinst du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071611
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071611,
					"content": "Was habe ich nur getan, um das zu verdienen? Wird die Liebe für mich immer unerreichbar bleiben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071612
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071612,
					"content": "Muss es wirklich so weit kommen? Was wird aus dem Horoskop?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071613
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071613,
					"content": "Ach, was soll’s ... Ich glaube, ich brauche etwas Zeit für mich allein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
