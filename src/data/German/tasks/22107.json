					"id": 221071501,
					"content": "Habt ihr noch etwas entdeckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071502
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071502,
					"content": "Mehr haben wir nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071503
					]
				},
				{
					"id": 221071503,
					"content": "Na gut, dann werde ich noch einmal Qiming fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
