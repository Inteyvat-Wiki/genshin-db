					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071806,
					"content": "Besonders dieser Fisch ist grandios. Er weiß ganz genau, dass er eine Katze liebt, schreckt aber dennoch nicht zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071807
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071807,
					"content": "Dann musst du deine Gefühle ja auch nicht länger verbergen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071808
					]
				},
				{
					"id": 221071808,
					"content": "Was soll das? Du hast den Fisch hergebracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071809
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071809,
					"content": "Du wirst ihn der Katze doch nicht einfach entrissen haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071810
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071810,
					"content": "Diese speziesübergreifende Freundschaft hätte man nicht zerstören dürfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071811
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071811,
					"content": "Endlich mal ein so wunderschönes Zeichen und was tust du damit?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071812
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071812,
					"content": "Vergiss es einfach ... Das muss ich erst mal eine Weile verdauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
