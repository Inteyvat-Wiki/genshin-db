			"dialogs": [
				{
					"id": 221071701,
					"content": "Da ist viel Laub.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071702
					]
				},
				{
					"id": 221071702,
					"content": "Hmm, das wird wohl kaum etwas mit deinem Liebesleben zu tun haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071703,
					"content": "Laub? Natürlich hat es das!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071704
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071704,
					"content": "Diese Blätter scheinen zwar nutzlos zu sein, doch im entscheidenden Moment ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071705
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071705,
					"content": "Mit nur einem Funken könnten sie einen großen Brand verursachen, der sich geschwind ausbreitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071706
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071706,
					"content": "Das bedeutet doch, dass ich nur auf die richtige Gelegenheit warten muss, damit Qiming und ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071707
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071707,
					"content": "Doch das Schicksal wird vom Himmel entschieden. Wann und in welcher Form diese Gelegenheit kommt, wird mir wohl keiner sagen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071708
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071708,
					"content": "Aber eins ist gewiss, sie wird eintreffen! Ich muss nur geduldig sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071709
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071709,
					"content": "Ja, das Laub und ich, wir teilen dasselbe Schicksal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071710
					]
				},
				{
					"id": 221071710,
					"content": "Was? Du und das Laub? Wie meinst du das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071711
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071711,
					"content": "Warte ... Du wirst das Laub doch nicht etwa ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071712
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071712,
					"content": "Oh nein ... Nein! Ich habe die Gelegenheit verpasst. Ich werde meine Liebe niemals finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071713
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071713,
					"content": "Was haben die Blätter denn mit dir zu tun? Du wirst schon nicht gleich sterben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071714
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071714,
					"content": "Was soll ich jetzt nur tun? Kümmere dich lieber um dich selbst. Ich werde mir eine Auszeit gönnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
