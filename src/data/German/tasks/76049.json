			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7604901",
							"2"
						],
						"stepId": 7604901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Columbina“"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2130.918,
							108.955,
							11206.71
						],
						"pointId": 360300003
					}
				]
			},
			"dialogs": [
				{
					"id": 760490101,
					"content": "... Hm, einen Halbton zu hoch, vielleicht. Lasst uns das nochmal versuchen, wollen wir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490102
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490102,
					"content": "He, Columbina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490103,
					"content": "Moment, bringst du ... den Kuuhenki bei, wie man die Leier spielt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490104,
					"content": "Ja. Sie waren so glücklich, dass sie sie repariert zurückbekommen haben, sie sind mir quasi nicht von der Seite gewichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490105
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490105,
					"content": "Aber ich war noch nie gut im Leierspielen. Ich höre eher anderen dabei zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490106
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490106,
					"content": "Ohh, stimmt! Wenn du eine Band hättest, dann wärst du definitiv für den Gesang zuständig, was ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490107,
					"content": "#Aber was Instrumente angeht ... ist {M#der Reisende}{F#die Reisende} ein echtes Wunderkind! Von der Leier bis zur Djem-Djem-Trommel, {M#er hier}{F#sie hier} kann echt alles spielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490108,
						760490109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490108,
					"content": "Ich bin ziemlich mittelmäßig, wirklich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				},
				{
					"id": 760490110,
					"content": "Oh, stimmt das? Na dann ... könntest du sie vielleicht stattdessen unterrichten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490111,
						760490112
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490111,
					"content": "Na gut, warum nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490113,
					"content": "Ich hab sie das Lied üben lassen, das ich normalerweise singe. Vielleicht erinnerst du dich noch daran, wie es ging ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490114
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490114,
					"content": "Oder ... Ein anderes Lied tut es auch. Die Kuuhenki bekommen nur selten Musik von anderen Orten zu hören. Ich wäre auch daran interessiert, sowas mal zu hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490115
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490115,
					"content": "(Hmm, was soll ich nur spielen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202,
						760490801
					]
				},
				{
					"id": 760490202,
					"content": "Probieren wir das, was Columbina immer singt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "(Aber welche Stimmung soll das Stück haben ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "Versuchen wir etwas Ruhiges und Sanftes ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "Das war hinreißend. Du hast dich also wirklich an die Melodie erinnert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490605,
					"content": "Hehe, nur, weil du so eine fantastische Sängerin bist! Wenn wir deine Stimme hören, halten wir manchmal sogar inne und hören einfach nur zu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490606,
					"content": "Hm, die Kuuhenki schienen von deiner Darbietung auch ganz entzückt zu sein. Vielleicht haben sie ja etwas dabei gelernt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490607,
					"content": "Ich könnte in Zukunft wieder auf deine lehrreiche Unterstützung angewiesen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490608,
					"content": "Komm, gib mir deine Hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490609,
					"content": "Hm? Nein, nein, das war eine kostenlose Darbietung. Keine Lehrgebühren notwendig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490610,
					"content": "Hmm? Lehrgebühren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490611,
					"content": "Ich dachte nur ... dass der sanfte Glanz des Mondlichts ein passender Begleiter wäre für solch eine schöne Melodie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490701,
					"content": "Versuchen wir etwas Fröhliches ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "Oh, schon vorbei? Da könnte ich wirklich ewig zuhören ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490703,
					"content": "Wie ich dir schon mal gesagt habe, ist das das einzige Schlaflied, an das ich mich erinnern kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490704,
					"content": "Auch wenn ich den Sinn dahinter noch nicht ganz erfassen kann – nachdem ich dich spielen gehört habe, habe ich das Gefühl, dass die Antwort, die dort oben auf dem Mond auf mich wartet ... zumindest eine wunderschöne sein muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490705,
					"content": "Hier, gib mir deine Hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490706,
					"content": "Das passt schon. Wirklich, du musst uns nichts dafür geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490707,
					"content": "Ah, das war auch nicht meine Absicht ... Ich wollte deine Melodie nur mit einem Hauch des sanften Mondlichts schmücken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490801,
					"content": "Versuchen wir etwas aus einem anderen Reich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490802
					]
				},
				{
					"id": 760490802,
					"content": "Wie faszinierend ... Ich habe solche Melodien schonmal gehört, aber in deinem Spiel entfalten sie eine ganz neue Tiefe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490803
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490803,
					"content": "#Ah, vielleicht weil {M#der Reisende seine}{F#die Reisende ihre} emotionale Verbindung zu diesem Ort hineinfließen lassen hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490804,
					"content": "Das Wunderbare ist ... Es fühlt sich an, als könne ich mir die Landschaft bildlich vorstellen, indem ich einfach der Melodie lausche. Ich frage mich, wie die Landschaft in meiner Vorstellung wohl in der Realität wirkt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490805
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490805,
					"content": "Du solltest dir das irgendwann mal anschauen! Wir können deine Reiseführer sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490806,
					"content": "Mh ... Vielleicht. Sollte dieser Tag jemals kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490112,
					"content": "Aber was soll ich spielen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490109,
					"content": "Ich spiele eigentlich nur so für mich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				}
			]
		},
