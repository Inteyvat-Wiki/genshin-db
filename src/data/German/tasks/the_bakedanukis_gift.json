			"dialogs": [
				{
					"id": 790350101,
					"content": "#{NICKNAME}, Paimon, habt ihr zwei Bakedanuki gesehen? Einer mit einem lila Beutel und einer mit einem gelben Beutel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 790350102,
					"content": "Ah! Das müssen Mamesuke und Shibasuke sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790350103,
					"content": "Ihr scheint sie zu kennen, sehr gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 790350104,
					"content": "Hm? Ist ihnen etwas zugestoßen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790350105,
					"content": "Ihnen geht es gut. Allerdings haben sie mir das hier nach etwas Gestikulieren gegeben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 790350106,
					"content": "Ich hörte, dass ihr zusammen mit den Bakedanuki aus Inazuma einmal beim Hirschjäger wart, also nehme ich an, dass diese beiden Bakedanuki auch eure Freunde sind. Sie wollten wahrscheinlich, dass ich sie an euch weitergebe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 790350107,
					"content": "Oh! Es ist ein Geschenk von Mamesuke und Shibasuke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790350108,
					"content": "Hehe, es sieht so aus, als hätte ihre Reise gut begonnen ... Werden wir sie jemals wiedersehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
