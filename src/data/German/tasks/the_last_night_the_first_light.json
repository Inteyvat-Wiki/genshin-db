			"dialogs": [
				{
					"id": 761010101,
					"content": "#Es sind {NICKNAME} und Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010102
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010102,
					"content": "Hihi, da sind wir! Hier ist ja richtig was los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010103,
					"content": "Ihr habt in letzter Zeit alle so hart gearbeitet. Endlich sind die Aufräumarbeiten so gut wie abgeschlossen, und wir haben Zeit, ein Fest zu organisieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010104
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010104,
					"content": "Du hast auch viel dazu beigetragen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010105
					]
				},
				{
					"id": 761010105,
					"content": "Was ich getan habe, ist wirklich nicht der Rede wert. Und ohne eure Hilfe hätten wir zwar am Ende vielleicht auch gewonnen, aber der Preis dafür wäre wohl viel höher gewesen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010106
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010106,
					"content": "Wir sind doch deine Truppmitglieder! Also lass das mit den Förmlichkeiten, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010107,
					"content": "Ja, da hast du recht. Oh, der Alte will wohl eine Rede halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010108
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010108,
					"content": "Liebe Kameraden, liebe Schwestern und Brüder, wir haben uns heute nicht nur zum Feiern versammelt, sondern um an diesen hart erkämpften Sieg zu erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010109
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010109,
					"content": "Während wir unsere Gläser erheben, sollten wir jene nicht vergessen, die nicht mehr mit uns feiern können. Sie haben ihr Versprechen mit ihrem Leben und Blut eingelöst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010110
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010110,
					"content": "In dieser Schlacht übernahm der von Illuga angeführte Ermittlungstrupp „Albtraum-Pirol“ die schwierigste Aufgabe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010111
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010111,
					"content": "#Besonders ihr beide, {NICKNAME} und Paimon, habt euch in dieser schweren Zeit ohne zu zögern uns angeschlossen und eine Rolle in den Kämpfen gespielt, die nicht hoch genug eingeschätzt werden kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010112
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010112,
					"content": "Sie scheuten keine Opfer und stellten sich mutig den Herausforderungen. In Zeiten der Not haben sie uns den Weg zum Sieg geebnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010113
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010113,
					"content": "Ihre Leistungen und die Leistungen all jener, die für die Lebenden und die Zukunft gekämpft haben, werden für immer in der Geschichte eingemeißelt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010114
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010114,
					"content": "Ja, wir haben gesiegt! Auch wenn der Preis dafür sehr hoch war. Wir dürfen weinen, wir dürfen trauern, aber wir dürfen uns von der Trauer nicht überwältigen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010115
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010115,
					"content": "Denn die „Zukunft“, für die wir gekämpft haben, steht kurz bevor. Um den Funken weiterzugeben und das helle Licht, das uns den Weg weist, weiter leuchten zu lassen, dürfen wir jetzt nicht innehalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010116
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010116,
					"content": "Aber heute, lasst uns auf den Sieg anstoßen, auf unsere tapferen und unsterblichen Kameraden und auf die Zukunft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nikita"
				}
			]
		},
