					{
						"sceneId": 3,
						"position": [
							5267.198,
							393.544,
							9440.139
						],
						"pointId": 361100059
					},
					{
						"sceneId": 3,
						"position": [
							5610.782,
							375.311,
							9961.593
						],
						"pointId": 361100061
					}
				]
			},
			"dialogs": [
				{
					"id": 761011301,
					"content": "Das Tor zum dämonischen Himmel ist bereits geöffnet, was kann mir dieses schwache Kuuvahki schon anhaben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011302
					],
					"speakerTitle": "„Professor“"
				},
				{
					"id": 761011302,
					"content": "Aber warum bin ich hier gefangen ... Jetzt verstehe ich, die Sampo-Mühle hat mich wieder einmal abgewiesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011303
					],
					"speakerTitle": "„Professor“"
				},
				{
					"id": 761011303,
					"content": "Sieh mal, wer da ist, was für ein seltener Gast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011304
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011304,
					"content": "... Wer ist da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011305
					],
					"speakerTitle": "„Professor“"
				},
				{
					"id": 761011305,
					"content": "Diese Gestalt ... Ah, du bist es, Relya. Wunderbar, ich wusste, dass du noch am Leben bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011306
					],
					"speakerTitle": "„Professor“"
				},
				{
					"id": 761011306,
					"content": "Nun befehle ich dir, die Kraft der Sampo-Mühle mir zu unterwerfen! Mit dem heiligen Blut in deinen Adern kannst du das bestimmt schaffen. Du bist schließlich anders als diese drei Versager, du bist mein liebster Schüler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011307
					],
					"speakerTitle": "„Professor“"
				},
				{
					"id": 761011307,
					"content": "Ha, er hält mich tatsächlich für Relya ... Welch Ironie, dass dieser einst so redegewandte Mönchsmagier nun so verblendet ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011308
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011308,
					"content": "Zögere nicht, Relya. Hast du unsere gemeinsamen Ideale vergessen? Willst du nicht deinen rechtmäßigen Status und deine Identität zurückgewinnen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011309
					],
					"speakerTitle": "„Professor“"
				},
				{
					"id": 761011309,
					"content": "Ein „Elysium“ für die Schikanierten und Erniedrigten erschaffen, damit sich diese hässlichen Feen-Aristokraten vor dir verbeugen – im ganzen Königshof des Bleichsterns bin ich der einzige Mensch, der dir helfen will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011310
					],
					"speakerTitle": "„Professor“"
				},
				{
					"id": 761011310,
					"content": "Jetzt fehlt nur noch ein letzter Schritt, und ich werde die Treppe zu den Sternen erklimmen ... Wenn das „Elysium“ jenseits des Himmels sich entfaltet, werden nur Auserwählte wie du und ich überleben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011311
					],
					"speakerTitle": "„Professor“"
				},
				{
					"id": 761011311,
					"content": "Dann wird alle Verdorbenheit und Unreinheit weggewaschen sein. Ist das nicht genau die Welt, die du dir ersehnst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011312
					],
					"speakerTitle": "„Professor“"
				},
				{
					"id": 761011312,
					"content": "Nein, das ist nicht die Welt, die er sich wünscht ... Versuchst du selbst jetzt noch, deine billigen Tricks anzuwenden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011313
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011313,
					"content": "Von Anfang an hast du ihn ausgenutzt. All deine Lügen dienten nur dazu, dass er dir die Sampo-Mühle beschafft. Das „Elysium“, von dem du sprichst, war schon immer nur für dich allein bestimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011314
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011314,
					"content": "Sogar dass er am Anfang seinen Offiziersrang verlor und zum Räuber wurde, war eine Falle, die du und Herzog Alvis gemeinsam gestellt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011315
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011316
					],
					"speakerTitle": "„Professor“"
				},
				{
					"id": 761011316,
					"content": "Auch wenn du mich mit jemand anderem verwechselst, werde ich den Namen Reed Miller nicht ablehnen, da ich sein Erbe und seinen Willen schon übernommen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011317
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011317,
					"content": "Rauthvangi, Mönchsmagier, „Professor“, Unsterbliche Schlange ... Deine Geschichte endet hier. Ich werde sie beenden, im Namen von Reed Miller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011318
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011318,
					"content": "Wir haben es geschafft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011319
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761011319,
					"content": "Endlich haben wir es geschafft, den unsterblichen Dämon ein für alle Mal zu besiegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011320
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761011320,
					"content": "„Noch zweimal wird sich diese unsterbliche Schlange erheben, nur um dreimal niedergestreckt zu werden ... Bis sie schließlich von den Helden der Welt unter dem Mond zur Ruhe gebettet wurde ...“\\nSeite an Seite mit den mutigen Ratniki habt ihr den „Professor“ endlich vernichtet ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761011321
					]
				},
				{
					"id": 761011321,
					"content": "Im Anschluss verweilt ihr einige Tage in Piramida ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}