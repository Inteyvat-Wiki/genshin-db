			"dialogs": [
				{
					"id": 761010201,
					"content": "Illuga! Endlich bist du zurück, Starshyna Nikita wartet schon auf dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010202
					],
					"speakerTitle": "Olav"
				},
				{
					"id": 761010202,
					"content": "Ah? Starshyna ... Nikita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010203,
					"content": "#{NICKNAME}, ist „Nikita“ nicht der alte Mann, der uns beauftragt hat, den „Silberdocht“ zu finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010204,
					"content": "Paimon erinnert sich, dass er gesagt hat, er sei nur ein ganz normaler Ratnik ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010205,
						761010206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010205,
					"content": "Ja ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010207
					]
				},
				{
					"id": 761010207,
					"content": "Ach, der Alte ... Betrachtet es einfach als einen seiner Scherze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010208
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010208,
					"content": "Lassen wir das jetzt, wir sollten ihm Bericht erstatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010206,
					"content": "Nein, er sieht überhaupt nicht wie ein normaler Ratnik aus ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010207
					]
				}
			]
		},
