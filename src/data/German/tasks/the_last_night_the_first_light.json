			"dialogs": [
				{
					"id": 761010301,
					"content": "Alter, wir sind zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010302
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010302,
					"content": "Schön, dass ihr zurück seid. Wie ist die Lage an der Kipumaki-Klippe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010303
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010303,
					"content": "Ihr fasst die Lage kurz zusammen ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761010304
					]
				},
				{
					"id": 761010304,
					"content": "Genau wie vermutet ... Von hier aus kann man deutlich sehen, dass die Embla-Säule vollständig von der Kraft des Abgrunds ... von diesem unsterblichen Dämon, dem „Professor“, kontrolliert wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010305
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010305,
					"content": "Es tut sich bisher kaum etwas, offenbar setzt Fräulein Alia all ihre Kraft ein, um es aufzuhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010306
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010306,
					"content": "Die kostbare Zeit, die sie für uns erkämpft hat, dürfen wir nicht verschwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010307
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010307,
					"content": "Zum Glück sind die Vorbereitungen dank Flins und der Hilfe aller anderen fast abgeschlossen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010308
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010308,
					"content": "Mit dem „Spiralschwert“, das ihr mitgebracht habt, ist der „Pfeil des Terpikeraunas“ nun fertiggestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010309
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010309,
					"content": "Äh ... Was ist der „Pfeil des Ter... Terpi... keraunas“? Ist das ein genauso mächtiges Heiligtum wie der „Silberdocht“ und das „Spiralschwert“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010310,
					"content": "Haha, das ist sogar noch mächtiger als diese beiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010311
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010311,
					"content": "Vor fünfhundert Jahren konnte der Fackelmacher den unsterblichen Dämon nur unter der Kipumaki-Klippe versiegeln, da seine Kräfte nicht ausreichten. Doch danach gaben weder der Fackelmacher noch die erste Mondkantorin auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010312
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010312,
					"content": "Um den unsterblichen Dämon eines Tages endgültig zu besiegen, erschufen sie mit uralter Technologie diesen „Pfeil“, den wir Lichthüter von Generation zu Generation bis heute bewahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010313
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010313,
					"content": "Jetzt ist endlich der Moment gekommen, in dem er seine Bestimmung erfüllen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010314
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010314,
					"content": "Oh ... Es gibt also so einen mächtigen Pfeil! Paimon würde gerne sehen ... wie er aussieht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010315,
					"content": "Dummerchen, ihr habt ihn schon längst gesehen, oder besser gesagt, wir befinden uns gerade im „Pfeil des Terpikeraunas“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010316,
						761010318
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010316,
					"content": "Was?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010317
					]
				},
				{
					"id": 761010317,
					"content": "D... Das soll doch nicht heißen, dass wir zusammen mit ihm abgeschossen werden ... Das ist doch unmöglich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010320,
					"content": "Diese Honigweinhalle wurde rund um den „Pfeil des Terpikeraunas“ gebaut, und das „Spiralschwert“, das ihr mitgebracht habt, ist genau die fehlende Pfeilspitze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010321
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010321,
					"content": "Wenn wir das „Spiralschwert“ hier einsetzen, wird der „Pfeil des Terpikeraunas“ schussbereit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010322
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010322,
					"content": "Aber das ist doch ein Kamin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010323,
					"content": "Ja, es ist ein Kamin und zugleich ein besonderer Apparat, der das „Spiralschwert“ in eine „Pfeilspitze“ verwandelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010324
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010324,
					"content": "Bevor dieses „Böse Ei“ schlüpft ... lasst es uns mit diesem von Generation zu Generation überlieferten „Pfeil“ endgültig zu Grabe tragen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010325
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010325,
					"content": "In diesem Moment wird der unsterbliche Dämon sicherlich noch um sein Leben kämpfen. Egal wie viele Schergen er schickt, wir werden sie für euch aufhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010326
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010326,
					"content": "Die wichtige Aufgabe, den „Pfeil des Terpikeraunas“ abzufeuern, überlassen wir euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010318,
					"content": "Soll ich etwa auch abgeschossen werden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010319
					]
				},
				{
					"id": 761010319,
					"content": "#Also ist {NICKNAME} unsere ultimative Geheimwaffe! ... Das kann doch nicht wahr sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "Paimon"
				}
			]
		},
