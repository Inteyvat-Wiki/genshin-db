				]
			},
			"dialogs": [
				{
					"id": 761360301,
					"content": "(Vielleicht will <color=#FFCC33FF>Jahoda</color> einen Blick in die Kiste werfen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761360302
					]
				},
				{
					"id": 761360302,
					"content": "Hehe ... Lass mal sehen, wie viel Geld ich in letzter Zeit verdient habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360303
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360303,
					"content": "Die Chefin hat versprochen, dass sie mir einen Bonus geben würde. Wie wär’s, wenn ich jetzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360304
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360304,
					"content": "Huh? Wo ist das Geld? Da liegt nur ein Zettel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360305
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360305,
					"content": "„Meine liebe Jahoda, dein Bonus kommt nicht aus diesem Kästchen. Mach es einfach zu.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360306
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360306,
					"content": "Tss, die Chefin versucht wieder, mich zu erschrecken ... Vielleicht ist darin irgendwo ein verstecktes Fach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360307
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360307,
					"content": "Es gibt kein verstecktes Fach. Dein Bonus ist hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360308
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761360308,
					"content": "Oh, danke Chefin, ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360309
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360309,
					"content": "Wah! Che... Chefin! Ich ... Ich wollte nur kurz das Geld nachzählen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360310
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360310,
					"content": "Ich mache mich an die Arbeit, sofort ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360311
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360311,
					"content": "Halt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360312
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761360312,
					"content": "Jawohl, Chefin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360313
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360313,
					"content": "Verschließ das Kästchen ordentlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360314
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761360314,
					"content": "Jawohl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360315
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360315,
					"content": "Geh jetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360316
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761360316,
					"content": "Jawohl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
