			"dialogs": [
				{
					"id": 200420101,
					"content": "Wo versteckst du dich nur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420102
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420102,
					"content": "Was machst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420103
					]
				},
				{
					"id": 200420103,
					"content": "Ich? Ach, ich suche nach einem Verdächtigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420104
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420104,
					"content": "Er heißt Albert und er lungert tagsüber immer in der Nähe der Kathedrale herum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420105
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420105,
					"content": "Er sieht so aus, als hätte er etwas vor. Ich weiß nur nicht, was es ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420106
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420106,
					"content": "Könntest du ihm bitte sagen, dass er das lassen soll?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
