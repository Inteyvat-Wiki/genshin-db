			"dialogs": [
				{
					"id": 200420601,
					"content": "Hast du schon alle Blätter weggefegt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420602
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420602,
					"content": "Ja, jetzt ist alles sauber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420603
					]
				},
				{
					"id": 200420603,
					"content": "Dankeschön! Um die Kathedrale sieht es jetzt schon viel sauberer aus. Da wird sich Barbara sicher auch freuen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420604
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420604,
					"content": "Aber bitte erzähl Barbara nichts davon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420605
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420605,
					"content": "Es geht ja darum, ihr etwas Arbeit abzunehmen. Da wollen wir sie nicht wegen so einer Sache behelligen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420606
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420606,
					"content": "Mach dir keine Sorgen! Ich halte mich an mein Versprechen und gehe jetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420607
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420607,
					"content": "Tschüs! Oder bis bald! Wir werden sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albert"
				}
			]
		},
