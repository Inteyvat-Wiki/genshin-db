					"Albert"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200421001,
					"content": "Was soll ich getan haben? Herumlungern, nichts Gutes im Sinn haben, böse Pläne schmieden ... Da müsst ihr was völlig falsch verstanden haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421002
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421002,
					"content": "Puh ... Kennst du Barbara? Ich meine den Engel von Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421003
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421003,
					"content": "Viele Leute hier in Mondstadt verehren sie. Ich bin da keine Ausnahme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421004
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421004,
					"content": "Ich bin der Leiter des Barbara-Fanklubs von Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421005
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421005,
					"content": "Die Ritter des Ordo Favonius sind gleich hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200421006
					]
				},
				{
					"id": 200421006,
					"content": "Lass mich doch ausreden! Weil ich Barbara so respektiere, will ich genau wie sie einen Beitrag für Mondstadt leisten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421007
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421007,
					"content": "Ich bin ein ganz normaler Bürger, der etwas Gutes tun will. Ich könnte beispielsweise die Kathedrale reinigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421008
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421008,
					"content": "Aber die Ordensschwester Victoria lässt mich nie ausreden und scheucht mich immer weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421009
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421009,
					"content": "Mir ist aufgefallen, dass in letzter Zeit sehr viele vertrocknete Blätter um die Kathedrale herum liegen. Die Ordensschwester Victoria wird sie mich sicher nicht wegfegen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421010
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421010,
					"content": "Würdet ihr für Mondstadt und Barbara die Blätter wegfegen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albert"
				}
			]
		},
