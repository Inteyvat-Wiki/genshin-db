			},
			"dialogs": [
				{
					"id": 200420301,
					"content": "Soll ich den Ordo Favonius informieren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420302
					]
				},
				{
					"id": 200420302,
					"content": "Darüber habe ich auch nachgedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420303
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420303,
					"content": "Aber ich habe ja nichts Handfestes gegen ihn. Da kann der Ordo Favonius auch nichts machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420304
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420304,
					"content": "O Gott des Windes, lass ihn bitte verschwinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
