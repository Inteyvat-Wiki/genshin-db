			"dialogs": [
				{
					"id": 200420701,
					"content": "Es geht um Albert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420702
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420702,
					"content": "Ist Albert jetzt weg?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420703
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420703,
					"content": "Ja, er ist weg.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420704
					]
				},
				{
					"id": 200420704,
					"content": "Na endlich ... Aber warum hast du eben Blätter gekehrt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420705
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420705,
					"content": "Aber es ist schon gut so. Dann hat Albert wenigstens keine Ausrede, wieder zur Kathedrale zu kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420706
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420706,
					"content": "Hiermit möchte ich mich bei dir bedanken. Möge der Gott des Windes dich beschützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420707
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420707,
					"content": "Wenn es nichts weiter gibt, werde ich wieder an die Arbeit gehen. Du kannst dich auch wieder um deine eigenen Aufgaben kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
