			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chenxiang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220080101,
					"content": "Sei brav, Doudou, nur wenn du die Medizin nimmst, wird es dir besser gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080102
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080102,
					"content": "Nein, pfui! Medizin schmeckt so bitter, die will ich nicht nehmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080103
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080103,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080104
					]
				},
				{
					"id": 220080104,
					"content": "#{F#Reisende}{M#Reisender}, es ist so ... Meine Doudou, sie ist nicht gesund, sie muss laut Attest diese Medizin nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080105
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080105,
					"content": "Aber Doudou sagt, die Medizin aus der Bubu-Hütte schmeckt viel zu bitter, nichts will sie annehmen, dabei ist doch jede Medizin bitter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080106
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080106,
					"content": "Damit sie wenigstens ab und zu ihre Medizin nimmt, habe ich ihr versprochen, dass sie nach jeder Medizin eine Portion Mandeltofu kriegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080107
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080107,
					"content": "#{F#Reisende}{M#Reisender}, wenn du Zeit hast, kannst du mir helfen eine Portion Mandeltofu aufzutreiben? Ich muss Doudou noch überreden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080108,
						220080110,
						220080115
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080108,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080109
					]
				},
				{
					"id": 220080109,
					"content": "Ich vertraue dir, eine Portion reicht für Doudou aus, danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080110,
					"content": "Was hat sie denn für eine Krankheit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080111
					]
				},
				{
					"id": 220080111,
					"content": "Ich weiß nicht, wie ich es beschreiben soll, aber Herr Bai sagt, sie ist sehr schwer zu heilen und selbst wenn es nur oberflächlich etwas bringt, muss die Medizin trotzdem weiter genommen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080112
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080112,
					"content": "Wer weiß, vielleicht wird Doudou ihr ganzes Leben lang Medizin nehmen müssen. Sie ist doch noch so jung, ich mag gar nicht daran denken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080113
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080113,
					"content": "Ich wünschte, ich wäre krank an ihrer Stelle. Jetzt kann ich nur hoffen, dass Doudou nicht so leiden muss ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080114
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080114,
					"content": "#{F#Reisende}{M#Reisender}, kannst du mir helfen, eine Portion Mandeltofu aufzutreiben? Eine Portion reicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080115,
					"content": "Doudou, warum magst du deine Medizin nicht nehmen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080116
					]
				},
				{
					"id": 220080116,
					"content": "Weil die Medizin viel zu bitter schmeckt! Die Medizin von der kleinen Lulu war nicht so bitter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080117
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080117,
					"content": "Doudou, das, was die kleine Lulu dir gegeben hat, war keine echte Medizin, sondern nur das Zuckerwasser vom Mandeltofu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080118
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080118,
					"content": "Also ... nur vom Mandeltofu geht meine Krankheit nicht weg? Dann muss ich also doch bittere Medizin nehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080119
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080119,
					"content": "Sei brav Doudou, wenn du nicht mehr krank bist, kannst du wieder beliebig alles essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080120
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080120,
					"content": "Warum kann die Medizin nicht so wie Mandeltofu schmecken, so schön süß ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080121
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080121,
					"content": "#Dieses Kind ... {F#Reisende}{M#Reisender}, kannst du mir bitte helfen, eine Portion Mandeltofu aufzutreiben? Eine Portion reicht aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				}
			]
		},
