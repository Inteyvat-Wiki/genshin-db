			"dialogs": [
				{
					"id": 700270101,
					"content": "Du kommst gerade rechtzeitig, denn mit der Reparatur der „Pursina-Lichtnägel“ geht alles gut voran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270102,
					"content": "Mit diesen Komponenten bin ich sicher, dass ich es so schnell wie möglich reparieren kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270103,
					"content": "Ich habe ein paar gesammelt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270104
					]
				},
				{
					"id": 700270104,
					"content": "Großartig, das ist sehr hilfreich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270105,
					"content": "Mit diesen Komponenten bin ich sicher, dass ich es so schnell wie möglich reparieren kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270106,
					"content": "Aber es gibt noch eine Kleinigkeit, die ich lieber zuerst mit dir besprechen wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270107,
					"content": "In den Tagen, in denen du die Bauteile gesammelt hast, habe ich den Innenbetrieb der „Pursina-Lichtnägel“ studiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270108,
					"content": "Ihre Struktur ist sehr raffiniert konstruiert und wird dem exquisiten Instrument seines Pursina-Vorgängers gerecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270109,
					"content": "Jede einzelne Veränderung könnte sich auf die Gesamtfunktionalität auswirken, daher war ich etwas besorgt, ob die Anpassungen die gewünschte Wirkung haben würden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270110,
					"content": "Zur Sicherheit möchte ich dich bitten, es zunächst ein paar Mal auszuprobieren, und ich werde es anhand deiner Daten während der Testphase neu kalibrieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270111,
					"content": "Damit wird sichergestellt, dass die „Pursina-Lichtnägel“ die ultimative Wirkung haben, denn sonst wäre es eine Katastrophe, wenn sie im Kampf gegen den Mechanismus versagen würden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270112,
						700270113
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270112,
					"content": "Was für eine taktvolle Sache.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				},
				{
					"id": 700270114,
					"content": "Es ist auch das erste Mal, dass ich mit „Pursina-Lichtnägeln“ arbeite, wir sollten also vorsichtig sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270115
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270115,
					"content": "Dann bitte ich dich, so hilfreich wie möglich zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270113,
					"content": "Ich verstehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				}
			]
		}
	]
