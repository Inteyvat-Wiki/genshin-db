			"dialogs": [
				{
					"id": 3090201,
					"content": "Puh, endlich geschafft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090202,
					"content": "Der Kreislauf der Elemente in Mondstadt wird nun wieder normal fließen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090203,
					"content": "Wollen wir uns mal die Lage im <color=#00E1FFFF>Ritterorden</color> ansehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090204,
					"content": "Falls dir etwas anderes Interessantes einfällt, komme ich natürlich auch gern mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090205,
					"content": "Wir könnten zum Beispiel in Mondstadt einkaufen oder noch einmal zur <color=#00E1FFFF>Statue der Sieben</color> gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090206,
					"content": "In einem der Tempel der Vier Winde haben wir doch eine Art konzentrierten Wind gefunden, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090207,
					"content": "In Mondstadt nennt man so etwas einen „verlorenen Anemoculus“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090208,
					"content": "Der Name deutet darauf hin, dass er von dem Auge der Statue aufgenommen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090209,
					"content": "In einem Märchen heißt es, dass eine Schwalbe die eigentlichen Edelsteine aus den Augen gepickt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090210,
					"content": "Ein verlorener Anemoculus hat aber gar keine eigene Form.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090212,
					"content": "Nur Menschen mit einem „göttlichen Auge“ können sie sammeln und den <color=#00E1FFFF>Statuen der Sieben</color> geben, um ihren Segen zu erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090213,
					"content": "Du hast zwar kein Göttliches Auge. Für dich gelten die Regeln dieser Welt aber sowieso nicht wie für die anderen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090214,
					"content": "Wir können uns dieses Phänomen gleich ansehen, wenn du willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090215,
					"content": "Die Statue der Sieben auf dem Windstieg sollte am nächsten sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090216,
					"content": "Paimon ist schon richtig gespannt zu sehen, was die Götter mit dir tun werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
