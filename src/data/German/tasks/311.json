					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090405,
					"content": "Stimmt ja, wir haben in einem der Tempel der Vier Winde doch noch einen verlorenen Anemoculus gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090406
					],
					"speakerTitle": "Paimon"
				},
				{
