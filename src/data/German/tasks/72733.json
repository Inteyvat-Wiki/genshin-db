			},
			"dialogs": [
				{
					"id": 727330101,
					"content": "„Silbermelone die Himmelsbrecherin“! Ich bin gekommen, um „Elektro-Elytren“ zu rächen! Hol deinen Onikabuto heraus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727330102
					],
					"speakerTitle": "„Käfigbauer“"
				},
				{
					"id": 727330102,
					"content": "Nachdem ich dich besiegt habe, werde ich die Mitglieder der Arataki-Bande eines nach dem anderen besiegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727330103
					],
					"speakerTitle": "„Käfigbauer“"
				},
				{
					"id": 727330103,
					"content": "He, diesmal kommt ein Erwachsener! Aber warum ist dieser Typ noch aufgeregter als die Kinder zuvor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727330104,
						727330105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727330104,
					"content": "Keine Angst, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727330106
					]
				},
				{
					"id": 727330106,
					"content": "Silbermelone, dieser Typ wagt es wirklich, dich zu einem Duell herauszufordern. Du darfst keinen Rückzieher machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727330107
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727330107,
					"content": "Nimm den „scharlachroten Stößel“ mit und geh aufs Ganze!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727330105,
					"content": "Lass diesen Kampf ein weiteres Abzeichen sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727330106
					]
				}
			]
		}
