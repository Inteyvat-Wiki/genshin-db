				"objectNames": [
					"Huai’an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221010101,
					"content": "Kein Ende in Sicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010102
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221010102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010103
					]
				},
				{
					"id": 221010103,
					"content": "Hier ein Gasthaus zu führen, ist nicht leicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010104
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221010104,
					"content": "Ich weiß nicht, ob ich mir das nur einbilde. Aber die Monster tauchen in der Umgebung immer häufiger auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010105
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221010105,
					"content": "Sie kommen zwar nicht in die Nähe des Gasthauses, aber die Gäste sollen sich ja frei bewegen können. Die Millelithen können ja auch nicht überall zur gleichen Zeit sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010106
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221010106,
					"content": "Falls du dich mal in der Gegend umsehen möchtest, könntest du dich vielleicht gleich um die Monster in der Nähe des Gasthauses kümmern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010107,
						221010108
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221010107,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010109
					]
				},
				{
					"id": 221010109,
					"content": "Hahaha, du hast es erfasst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221010113,
					"content": "Tut mir leid, dass ich dich so durch die Gegend hetze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010114
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221010114,
					"content": "Deswegen ist für dich auf jeden Fall eine Belohnung drin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010115
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221010115,
					"content": "Ich danke dir schon im Voraus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221010108,
					"content": "Aber ist es nicht komisch, hier ein Gasthaus zu führen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010110
					]
				},
				{
					"id": 221010110,
					"content": "Wenn man hier ein Gasthaus aufmacht, kann man einige Problemchen nicht vermeiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010111
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221010111,
					"content": "Ohne unser Gasthaus hier wären viele Reisende aber auf sich allein gestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010112
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221010112,
					"content": "Es ist zwar viel Mühe, aber es lohnt sich auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "Huai’an"
				}
			]
		},
		{
