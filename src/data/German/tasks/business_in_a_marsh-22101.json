			"dialogs": [
				{
					"id": 221010301,
					"content": "Und wie sieht es mit den Monstern in der Umgebung aus? Hast du sie beseitigt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010302
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221010302,
					"content": "Ja, sie sind Geschichte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010303
					]
				},
				{
					"id": 221010303,
					"content": "Perfekt, danke dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010304
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221010304,
					"content": "Hier hast du eine Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010305
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221010305,
					"content": "Wenn man heutzutage ein Gasthaus führt, muss man wirklich mit allem rechnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				}
			]
		}
	]
