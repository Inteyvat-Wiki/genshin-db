				"points": []
			},
			"dialogs": [
				{
					"id": 221010201,
					"content": "Und wie sieht es mit den Monstern in der Umgebung aus? Hast du sie beseitigt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010202
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221010202,
					"content": "Noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010203
					]
				},
				{
					"id": 221010203,
					"content": "Es besteht ja auch keine Eile. Diese Monster ärgern im Ernstfall nur ein paar Gäste und wollen sowieso nirgends hin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010204
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221010204,
					"content": "Selbst wenn drei, vier, fünf von ihnen kämen, ja, könnte ich sie auch noch vertreiben. Da müssen sich die Gäste keine Sorgen machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010205
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221010205,
					"content": "Hahaha! Wenn man hier draußen ein Gasthaus eröffnet, muss man schon wissen, wie man sich zu verteidigen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				}
			]
		},
