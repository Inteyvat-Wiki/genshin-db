			"dialogs": [
				{
					"id": 210230201,
					"content": "Die Treppe sollte lieber schnellstmöglich repariert werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230202
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210230202,
					"content": "Bist du der Verwalter hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210230203
					]
				},
				{
					"id": 210230203,
					"content": "Ganz richtig, das bin ich. Gibt es ein Problem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230204
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210230204,
					"content": "Jemand von ganz unten hat uns ein Paket zur für dich mitgegeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210230205,
					"content": "Ah, das muss ein Geschenk von einem Geschäftsreisenden sein ... Wieso hat Zhen Qiang es denn nicht selbst hochgebracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230206
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210230206,
					"content": "Er hat noch Waren abzuholen? Ha! Wahrscheinlich war er einfach nur zu faul, den Weg nach oben zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230207
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210230207,
					"content": "Ihr seid meine verehrten Kunden, verzeiht die Unannehmlichkeiten bitte! Die Treppe hätte zu keiner unpassenderen Zeit kaputtgehen können. Ich arbeite bereits an einer Lösung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230208
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210230208,
					"content": "Wirklich so unpassend und dann lässt man euch auch noch dieses Paket hoch schleppen. Hier, nehmt diese Belohnung als Zeichen meiner Dankbarkeit an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230209
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210230209,
					"content": "Das war ursprünglich für Zhen Qiang vorgesehen. Aber nachdem er euch das Paket hat liefern lassen, solltet ihr auch seine Belohnung bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230210
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210230210,
					"content": "Nun denn, ich begebe mich wieder zu den Treppenarbeiten. Ihr seid jederzeit herzlich willkommen! Sucht mich auf, solltet ihr einen Wunsch haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				}
			]
		}
	]
}