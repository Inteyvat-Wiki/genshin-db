			"dialogs": [
				{
					"id": 102020401,
					"content": "Rate, wer da ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020402,
					"content": "Oh, das ist ja Paimons Stimme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020403,
						102020404
					],
					"speakerTitle": "Arrestzelle"
				},
				{
					"id": 102020403,
					"content": "Hast du Lust gemeinsam abzuhauen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				},
				{
					"id": 102020405,
					"content": "Aber klar, ich ... Warte, nein. Ich muss wirklich über meine Taten nachdenken. Verleite mich nicht zum Abhauen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020406
					],
					"speakerTitle": "Arrestzelle"
				},
				{
					"id": 102020406,
					"content": "Während meines Hausarrests werde ich hierbleiben und meinen Schatz für die Ludi Harpastum vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020407
					],
					"speakerTitle": "Arrestzelle"
				},
				{
					"id": 102020407,
					"content": "Deinen Schatz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020408,
					"content": "Hehe, ich habe sie sogar so aussehen lassen wie einen Federball. Ist das nicht süß?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020409,
						102020410
					],
					"speakerTitle": "Arrestzelle"
				},
				{
					"id": 102020409,
					"content": "Wie einen Federball ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020411,
					"content": "Wartet nur auf die Ludi Harpastum! Ja ... Die Leute werden sie lieben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020412
					],
					"speakerTitle": "Arrestzelle"
				},
				{
					"id": 102020412,
					"content": "Meine Güte, wenn Jean davon wüsste ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020413,
					"content": "Ihr Hausarrest würde sich automatisch verlängern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020410,
					"content": "Das ist immer noch eine Bombe!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020404,
					"content": "Appetit auf eine Kleinigkeit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				}
			]
		}
	]
