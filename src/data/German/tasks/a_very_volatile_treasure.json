					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102020101,
					"content": "Oh, Klee ist auch hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020102,
					"content": "Ja ... Ich habe mich gestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020103,
					"content": "Was?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020104,
					"content": "Mei... Meine Bombe ... hat jemanden verletzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020105,
					"content": "Aaah, ich habe die Überlebensregeln verletzt! Das war mein letzter Tag auf Erden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020106
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020107,
					"content": "Wartet, hier gibt es wohl ein Missverständnis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020108
					]
				},
				{
					"id": 102020106,
					"content": "Klee, sag bitte, wo die Verletzten sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020107
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020109,
					"content": "Klee hat einen Abgrundmagier in die Luft gejagt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020110
					]
				},
				{
					"id": 102020108,
					"content": "Bitte was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020109
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020110,
					"content": "A... Aber dieser Flauschball hat nur etwas geklaut. Meine Bombe aber hat ihn ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020111
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020111,
					"content": "Na ja, Paimon hat doch gesagt, dass Abgrundmagier böse sind. Das ist aber noch nicht alles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020112,
					"content": "Abgrundmagier sind nicht einmal Menschen. Genauer gesagt sind sie die Feinde der Menschheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020113,
					"content": "Flauschball ... ein Feind der Menschen? Böse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020114
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020114,
					"content": "Ah, was? Ich ... Ich komme nicht mehr mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020115,
					"content": "Ja, ich habe es versäumt, dir davon zu erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020116
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020116,
					"content": "In Anbetracht deines Alters habe ich dir nichts davon sagen wollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020117
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020118,
					"content": "Etwa wegen des größten Schatzes in ganz Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020119
					]
				},
				{
					"id": 102020117,
					"content": "In Wahrheit ist die Bedrohung durch die Monster des Ordens des Abgrunds zuletzt besonders groß geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020119,
					"content": "Das leuchtet ein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020120,
					"content": "Sie haben von den Gerüchten vom Schatz gehört und haben es dann auf Klee abgesehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020121,
					"content": "Ich habe anfangs ja auch den Schatz haben wo... äh ... sehen wollen, was es mit dem Schatz auf sich hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020122,
					"content": "Richtig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020123,
					"content": "Angesichts deiner großen Leistung erlaube ich dir, an den nächsten Ludi Harpastum teilzunehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020125,
					"content": "Das hast du echt Glück im Unglück.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020127
					]
				},
				{
					"id": 102020126,
					"content": "Ich freue mich für dich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020127
					]
				},
				{
					"id": 102020124,
					"content": "Ludi Harpastum? Wahnsinn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020125,
						102020126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020127,
					"content": "Du kommst doch sicher auch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020128
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020128,
					"content": "Hach, das hätte nicht besser ausgehen können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020129,
					"content": "Wobei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020131
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020130,
					"content": "Wobei was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020131,
					"content": "Klee, wo hattest du den Schatz denn versteckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020132
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020132,
					"content": "Oh, ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020133
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020133,
					"content": "Wolltest du wieder die Fische im Sternfallsee in die Luft jagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020134
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020134,
					"content": "Ich ... Nein, auf keinen Fall!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020135
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020136,
					"content": "Ja, aber Jean hat das auch gesehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020137
					]
				},
				{
					"id": 102020135,
					"content": "Psst, sie zwinkert uns zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020137,
					"content": "Klee?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020138
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020138,
					"content": "Eieiei! Ich melde mich zum <color=#00E1FFFF>Hausarrest</color> ... *schluchz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020139
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020139,
					"content": "Klee ist bestimmt langweilig so lange allein eingesperrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
