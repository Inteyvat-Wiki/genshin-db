			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ilmari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760200101,
					"content": "Auch heute gehe ich mit leeren Händen nach Hause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200102,
						760200105,
						760200112,
						760200117
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200102,
					"content": "Was machst du hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200103
					]
				},
				{
					"id": 760200103,
					"content": "Ich angle Fische. Aber bis jetzt habe ich nur Dinge geangelt, die keine Fische sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200104
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200104,
					"content": "Kleinkram aus dem Schiffswrack wäre ja noch in Ordnung, den nimmt die Händlergilde ab. Ich hab mal einen Stiefel rausgezogen, in dem noch ein halbes ... Ach, ich rede besser nicht weiter, sonst verscheuche ich noch die Fische.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200105,
					"content": "Gibt es in der Nähe etwas Nennenswertes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200106
					]
				},
				{
					"id": 760200106,
					"content": "Bist du auch auf Schatzsuche? Das mit dem „Großen Schatz“, den man nur östlich des Mondes und westlich der Sonne finden kann ... Man hört schon, dass der nicht hier sein kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200107
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200107,
					"content": "Ach ja, früher gab es hier tatsächlich viele Schiffsunglücke. In den Schiffswracks könnte wirklich etwas Wertvolles liegen, aber das ist schwer zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200108
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200108,
					"content": "In der Taverne haben die überlebenden Matrosen erzählt, dass in jener mondlosen Nacht etwas Leuchtendes in den Wellen zu sehen gewesen sei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200109
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200109,
					"content": "Sie sagten, es müsse die einäugige Kratti gewesen sein – ein Monster, das sogar den Mond verschlingen könnte und sich mit der Riesenschlange im Meer um das Territorium streitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200110
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200110,
					"content": "Danach war es hier für lange Zeit so dunkel wie in der Tintenflasche eines Buchhalters. Kein Schiff wagte es, diese Stelle zu passieren, weil alle Angst hatten, dass die Geister unter Wasser sie in die Tiefe ziehen würden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200111
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200111,
					"content": "Man sagt, dass die Geister immer noch hier herumwandern. Aber solche Geschichten sind wohl nur was für Kinder. Ich glaube nicht an solchen Unsinn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200112,
					"content": "Über diesen Baum ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200113
					]
				},
				{
					"id": 760200113,
					"content": "Das Ding ist echt unheimlich. Hier gab es mal einen Strudel, den die Matrosen das Auge von Kratti nannten, aber eines Tages wuchs dieser Baum einfach so aus dem Nichts heraus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200114
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200114,
					"content": "Aber das war nicht das einzige seltsame Ereignis in dieser Zeit. Wenn man mal darüber nachdenkt, alles geschah erst, nachdem diese Steine vom Himmel gefallen waren ... Vielleicht stammt dieser Baum ja auch aus einer anderen Welt, genau wie die Steine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200115
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200115,
					"content": "Und dann sind da noch diese glitzernden kleinen Dinge, die man manchmal sehen kann, die sind wirklich selten. Ich dachte mir, dass es hier vielleicht auch neue Fischarten gäbe, und deswegen bin ich hier, um mein Glück zu versuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200116
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200116,
					"content": "Ursprünglich war ein Angelfreund mit mir hier, aber er behauptete ständig, er höre seltsame Gesänge, und hatte zu viel Angst, um wiederzukommen. Pah! Auch wenn er nur ein halber Nachkomme des Frostmonds ist, vereint er trotzdem alle ihrer schlechten Angewohnheiten in sich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200117,
					"content": "Entschuldige die Störung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200118
					]
				},
				{
					"id": 760200118,
					"content": "Macht nichts. Im Moment ist kein einziger Fisch in Sicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				}
			]
		},
