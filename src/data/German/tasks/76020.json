					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2219.314,
							-199.188,
							8840.311
						],
						"pointId": 13689
					}
				]
			},
			"dialogs": [
				{
					"id": 760200301,
					"content": "Oh! Hier gibt es so viele glänzende Dinge, die Paimon schonmal gesehen hat. Wo sind wir denn jetzt eigentlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200302,
					"content": "Wir sind doch nicht direkt unter diesem seltsamen Baum gelandet, oder? Was sind diese grünen Dinger in der Mitte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
