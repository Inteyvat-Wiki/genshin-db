					},
					{
						"sceneId": 3,
						"position": [
							2190.965,
							200.227,
							8784.622
						],
						"pointId": 13688
					}
				]
			},
			"dialogs": [
				{
					"id": 760200701,
					"content": "Wirklich sonderbar ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200702
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200702,
					"content": "Habt ihr das gesehen? Der Baum ist eben plötzlich aufgeleuchtet, und diese kleinen Dinger hier ... Schade, dass es keine Fische sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200703
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200703,
					"content": "Heißt das, dieses Ding in der Mitte ist seine Wurzel? Paimon versteht zwar nicht, wie das funktioniert, aber jetzt glitzert er so schön. Das sieht viel besser aus als vorher, als er noch so matt war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200704,
					"content": "Ihr erzählt von euren früheren Erlebnissen ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760200705
					]
				},
				{
					"id": 760200705,
					"content": "Kaum zu glauben ... Aber es gibt wohl keinen Grund für euch, mir Ammenmärchen aufzutischen. Mein Angelfreund, der zur Hälfte ein Nachkomme des Frostmonds ist, hat also wohl tatsächlich die Wahrheit gesagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200706
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200706,
					"content": "Aber was macht das schon? Sie sind doch nichts weiter als Schatten der Vergangenheit. Was immer sie da auch singen oder sagen, es hält uns Lebende nicht davon ab, lebendige Fische zu fangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200707
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200707,
					"content": "Apropos, ihr seid doch auch Schatzjäger. Das Ding, das ihr gerade gefunden habt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200708
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200708,
					"content": "Das ist also der <color=#00E1FFFF>Nachweis der Wissenden</color>? Er sieht wirklich nur wie eine ganz gewöhnliche Feder aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200709,
					"content": "Laut einem bekannten Händler soll man einen „Großen Schatz“ finden können, der östlich des Mondes und westlich der Sonnee vergraben ist, wenn man fünf <color=#00E1FFFF>Nachweise der Wissenden</color> sammelt. Ob das stimmt, weiß ich nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200710
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200710,
					"content": "Viele Schatzjäger haben das auf jeden Fall geglaubt und sind wie wild darauf losgestürmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200711
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200711,
					"content": "S... Schließlich geht es um einen Schatz! Wenn Paimon ehrlich ist, interessiert Paimon das auch sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200712,
					"content": "Wenn ich zwanzig Jahre jünger wäre ... nein, selbst wenn ich zwanzig Jahre jünger wäre, wäre das Angeln immer noch am wichtigsten. Aber wie dem auch sei, heute gehe ich wieder mit leeren Händen nach Hause ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				}
			]
		}
	]
}