			"dialogs": [
				{
					"id": 706510201,
					"content": "Sie sind jedoch schwer zu bearbeiten. Willst du sie nutzen, benötigst du ebenfalls eine große Menge anderer Ressourcen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510202
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510202,
					"content": "Allerdings komme ich gerade von draußen, und wie es scheint, wurden die meisten Erzadern bereits abgebaut. Wenn du dich jetzt auf die Suche begibst, wirst du kaum etwas finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510203
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510203,
					"content": "Sonst komm später bei mir vorbei, dann markiere ich alle Adern auf deiner Karte, die ich kenne, in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				}
