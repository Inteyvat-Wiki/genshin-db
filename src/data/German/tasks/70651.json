			"dialogs": [
				{
					"id": 706510101,
					"content": "Verflixt. Unser Erz geht zur Neige ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510102
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510102,
					"content": "Kann ich dir ein paar Fragen zur Erzsuche stellen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706510103
					]
				},
				{
					"id": 706510103,
					"content": "Erz? Was willst du schmieden? Waffen oder Rüstung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510104
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510104,
					"content": "Wenn du nach Erz suchst, kann ich dir einige Orte empfehlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510105
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510105,
					"content": "Allerdings gibt es vielerlei Arten von Erz. Eisenbrocken sind am weitesten verbreitet, danach kommen weiße Eisenbrocken und dann Brocken mit Kristall ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510106
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510106,
					"content": "Dann gibt es noch die magischen Brocken Kristall, die von äußerst hoher Qualität sind. Damit lassen sich ausgezeichnete Gegenstände schmieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				}
			]
		},
