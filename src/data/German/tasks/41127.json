					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270301,
					"content": "Was hast du da draußen getrieben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270302
					]
				},
				{
					"id": 411270302,
					"content": "Oh, komm schon. Warum guckst du mich so skeptisch an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270303
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270303,
					"content": "Ich war bloß spazieren, wirklich! Als die Sterne fielen, rannte ich sofort zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270304
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270304,
					"content": "Wie auch immer. Bitte sieh dich da draußen um. <color=#00E1FFFF>Wenn du wirklich nichts findest, komm zu mir zurück</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270305
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270305,
					"content": "Lass mich noch mal nachdenken. Vielleicht fällt mir etwas ein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
