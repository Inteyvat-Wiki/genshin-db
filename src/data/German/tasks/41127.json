					"id": 411271401,
					"content": "Ein Hinweis wäre nicht verkehrt, meinst du nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411271402
					]
				},
				{
					"id": 411271402,
					"content": "Ähm, na gut, einen Moment. Lass mich nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411271403
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411271403,
					"content": "Nein, mir fällt nichts ein. An der Kiste ist nichts besonders ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411271404
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411271404,
					"content": "Dann lass mich eine andere Frage stellen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411271405
					]
				},
				{
					"id": 411271405,
					"content": "Klar. Was würdest du gerne wissen?",
					"roleType": "TALK_ROLE_NPC",
