					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270201,
					"content": "Was? Gibt es noch etwas anderes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270202
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270202,
					"content": "Ohne Hinweise fällt die Suche schwer, weißt du ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270203
					]
				},
				{
					"id": 411270203,
					"content": "Ähm, na gut, einen Moment. Lass mich nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270204
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270204,
					"content": "Nein, mir fällt nichts ein. An der Kiste ist nichts besonders ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270205
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270205,
					"content": "Dann lass mich eine andere Frage stellen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270206
					]
				},
				{
					"id": 411270206,
					"content": "Klar. Was würdest du gerne wissen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
