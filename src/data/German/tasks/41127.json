					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270501,
					"content": "Was ist passiert, als du zurückgerannt bist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270502
					]
				},
				{
					"id": 411270502,
					"content": "Als ich zurückgerannt bin? Hmm, mal sehen ... Nein, ich kann mich an nichts erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270503
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270503,
					"content": "Ah, richtig! Ich bin auf eine große Gruppe Elektro-Schleim nahe beim <color=#00E1FFFF>Tempel der Tausend Winde</color> gestoßen. Sie haben mir etwas zugesetzt, darum fiel die Kiste zu Boden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270504
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270504,
					"content": "Ich konnte sie zwar wieder aufheben, aber ... dann hab ich sie in der Hektik wieder verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270505
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270505,
					"content": "Aber da sie vom Elektro-Schleim berührt wurde, sollte sie <color=#00E1FFFF>Elementarspuren</color> aufweisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270506
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270506,
					"content": "Jedenfalls solltest du versuchen, die Elektrospuren zu verfolgen, vielleicht wirst du so fündig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270507
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270507,
					"content": "Bring die Kiste zu mir, sobald du sie gefunden hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 4112706,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
