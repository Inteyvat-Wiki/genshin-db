					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270401,
					"content": "Was ist in der Kiste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270402
					]
				},
				{
					"id": 411270402,
					"content": "Das, äh, geht dich nichts an. Es ist bloß Kleinkram ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270403
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270403,
					"content": "Komm schon. Guck mich nicht so an. Ich bin kein Bösewicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270404
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270404,
					"content": "Aber du gehörst zu den Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270405
					]
				},
				{
					"id": 411270405,
					"content": "Fatui dies, Fatui das ... Wir sind also allesamt Bösewichte? Was ist das bitte für eine Logik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270406
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270406,
					"content": "Wie auch immer. Bitte sieh dich da draußen um. <color=#00E1FFFF>Wenn du wirklich nichts findest, komm zu mir zurück</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270407
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270407,
					"content": "Lass mich noch mal nachdenken. Vielleicht fällt mir etwas ein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
