			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270101,
					"content": "Oh, wie schrecklich. Das ist ganz sicher mein Ende ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270102
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270102,
					"content": "Was hast du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270103
					]
				},
				{
					"id": 411270103,
					"content": "Pah! Mir war es hier zu langweilig und die Ordensschwestern starren mich so an. Darum entschied ich mich, vor der Stadt ein wenig frische Luft zu schnappen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270104
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270104,
					"content": "Doch als ich die Stadt verließ, um zum Tempel der Tausend Winde zu wandern ... fielen all diese Sterne vom Himmel herab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270105,
					"content": "Ich rannte rasch in die Stadt zurück ... Da fiel mir auf, dass ich eine Kiste zurückgelassen hatte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270106,
					"content": "Bei all dem Chaos da draußen wollte ich aber auch nicht umkehren, um nach ihr zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270107
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270107,
					"content": "Und, na ja ... Ich bin ein Fatui. Wenn ich etwas Unerwartetes tue, würde man mich sofort irgendeiner Untat verdächtigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270108
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270108,
					"content": "Genug geredet. Würdest du mir bei der Suche helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270109,
					"content": "Unsere Transaktionen liefen bislang freundlich ab, und ich möchte weiterhin Geschäfte mit dir tätigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270110
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270110,
					"content": "Sag nicht solche verdächtigen Sachen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270111
					]
				},
				{
					"id": 411270111,
					"content": "Wie? Komm schon, an dieser Geschichte ist doch absolut nichts verdächtig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270112,
					"content": "Und, wie sieht es aus? Hilfst du mir oder nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
