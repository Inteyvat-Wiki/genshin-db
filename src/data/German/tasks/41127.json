			"dialogs": [
				{
					"id": 411271301,
					"content": "Ich werde dir helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411271302
					]
				},
				{
					"id": 411271302,
					"content": "Großartig. Lass mich nachdenken ... Ich kann mich nicht genau erinnern, aber ich wanderte beim Tempel der Tausend Winde umher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411271303
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411271303,
					"content": "Doch als ich zurückrannte, traf ich eine große Gruppe Elektro-Schleime. Sie erwischten mich einige Male und die Kiste fiel auf den Boden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411271304
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411271304,
					"content": "Ich konnte sie zwar wieder aufheben, aber ... dann hab ich sie in der Hektik wieder verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411271305
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411271305,
					"content": "Aber da sie vom Elektro-Schleim berührt wurde, sollte sie Elementarspuren aufweisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411271306
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411271306,
					"content": "Jedenfalls solltest du versuchen, die Elektrospuren zu verfolgen, vielleicht wirst du so fündig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411271307
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411271307,
					"content": "Bring die Kiste zu mir, sobald du sie gefunden hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411271308
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411271308,
					"content": "<color=#00E1FFFF>Wie auch immer. Wenn du wirklich nichts findest, komm zu mir zurück</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411271309
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411271309,
					"content": "Lass mich noch mal nachdenken. Vielleicht fällt mir etwas ein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
