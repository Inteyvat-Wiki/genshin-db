					"content": "Und unsere „Abmachung“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270905
					]
				},
				{
					"id": 411270905,
					"content": "Äh, na schön ... ich versteh schon. Raus damit. Was willst du diesmal wissen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
