			"dialogs": [
				{
					"id": 411271101,
					"content": "Was weißt du über die gefallenen Sterne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411271102
					]
				},
				{
					"id": 411271102,
					"content": "Die gefallenen Sterne ... Nun, ich würde dir gerne etwas erzählen, aber leider weiß ich darüber auch nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411271103
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411271103,
					"content": "Ich komme hier nicht aus Mondstadt weg. Was soll ich da in Erfahrung bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411271104
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411271104,
					"content": "Aber mein Bauchgefühl sagt mir, dass diese gefallenen Sterne nichts Gutes bedeuten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411271105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411271105,
					"content": "Ich würde mich an deiner Stelle davon fernhalten. Das bedeutet nur Ärger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
