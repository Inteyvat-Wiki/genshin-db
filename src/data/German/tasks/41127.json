				{
					"id": 411271201,
					"content": "Was ist mit den anderen Fatui in der Stadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411271202
					]
				},
				{
					"id": 411271202,
					"content": "Oh, die? Die drehen wahrscheinlich auch nur Däumchen, so wie ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411271203
					],
					"speakerTitle": "Viktor"
				},
				{
