					]
				},
				{
					"id": 411270903,
					"content": "Du ... hast sie tatsächlich gefunden! Puh ... Gut ... Das ist gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270904
					],
					"speakerTitle": "Viktor"
				},
				{
