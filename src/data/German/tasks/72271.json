			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722710102,
					"content": "Ich habe Schätze, die ich gern verkaufen würde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710103
					]
				},
				{
					"id": 722710103,
					"content": "Welche seltenen Dinge hast du wieder gefunden? Bitte lass mich einen Blick darauf werfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710104
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710104,
					"content": "Die Geschichte der Perle der Drachenknochenblume wurde Linlang erzählt.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722710105
					]
				},
				{
					"id": 722710105,
					"content": "Nach dem, was du gesagt hast, handelt es sich um ein bemerkenswertes Stück aus der Antike.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710106
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710106,
					"content": "Ich habe es mir gerade angeschaut und nichts besonders Auffälliges gespürt. Vielleicht muss es doch länger benutzt werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710107
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710107,
					"content": "Meiner Meinung nach sind die wundersamen Wirkungen, von denen du gehört hast, vielleicht übertrieben, oder ... Vielleicht ist es nur die Ausrede eines Verlierers ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710108
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710108,
					"content": "Haha, keine Sorge, ich sage das nur so aus dem Stegreif, hör einfach zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710122
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710122,
					"content": "In unserem Antiquitätengeschäft ist dies ein sehr häufiges Phänomen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710109
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710109,
					"content": "Außerdem hast du es offenbar nicht versiegelt und bei einem flüchtigen Blick scheint es eine gewisse Abnutzung der Oberfläche zu erfahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710110
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710110,
					"content": "Dies führt zu einem weiteren kleinen Rabatt auf den Preis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710123
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710123,
					"content": "Wie wäre es mit achtzigtausend Mora? Leg noch 5 Spezialzubereitungen Jahresfisch dazu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710111,
					"content": "Ich glaube, das ist ein guter Preis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710112,
						722710116,
						722710119
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710112,
					"content": "Was willst du damit machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710113
					]
				},
				{
					"id": 722710113,
					"content": "Ich finde die Geschichte, die dahintersteckt, sogar wertvoller als ihre Wirksamkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710114
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710114,
					"content": "Ich vermute, dass es für die Geschichtenerzähler und Opernsänger im Hafen oder für die Adligen auf der Yujing-Terrasse von Interesse sein wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710115
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710115,
					"content": "Selbst wenn sie nur auf der Ladentheke ausgestellt wäre, würde sie als seltene Antiquität gelten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710116,
					"content": "Ein sehr guter Preis. Abgemacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710117
					]
				},
				{
					"id": 722710117,
					"content": "Du bist sehr schnell. Bitte nimm diese Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710118
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710118,
					"content": "Sollte es in Zukunft weitere Artikel dieser Art geben, freuen wir uns, dich in unserem Geschäft begrüßen zu dürfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710119,
					"content": "Ich überlege es mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710120
					]
				},
				{
					"id": 722710120,
					"content": "Nun, bei solch seltenen Schätzen ist es nur richtig, die Preise zu vergleichen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710121
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710121,
					"content": "Wenn du darüber nachgedacht hast, kannst du auf mich zurückkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
		{
