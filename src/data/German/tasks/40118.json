			"trigger": {
				"objectNames": [
					"Klee",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401181001,
					"content": "Ich würde so gern mit der „Militärberaterin“ auf dem „Tschu-Tschu-Express“ fahren! Aber anscheinend wird sie dadurch ohnmächtig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181002
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401181002,
					"content": "Hehe, Klee, du bist wirklich scharfsinnig. Du hast sicher die tanzenden Sterne in den Augen der Militärberaterin gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181003
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401181003,
					"content": "Heute sind es etwas weniger! Gestern waren es Myriaden goldener Sterne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181004
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401181004,
					"content": "Mama würde wahrscheinlich sagen, all die Sterne sind Fische, die in die Wolken gefallen sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		},
		{
			"id": 4011811,
			"completionStepIds": [],
