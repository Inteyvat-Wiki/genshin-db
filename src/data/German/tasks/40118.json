				"objectNames": [
					"Lessig",
					"Eula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401180901,
					"content": "Als Nachfahre des berühmten Lawrence-Klans habe ich auf meiner Reise viele Fähigkeiten erlernt, zum Beispiel ... Pfannkuchen backen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180902
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180902,
					"content": "Gut, die Hitze ist genau richtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180903
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180903,
					"content": "Ich hätte niemals gedacht, dass du Pfannkuchen machen kannst ... Gehörst du nicht zu den Leuten, die nicht einmal das Geschirr spülen ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180904
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401180904,
					"content": "Du kommst gerade richtig. Kannst du mir zeigen, wie man einen richtigen Kuchen macht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180905
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180905,
					"content": "Hä? Dafür braucht man viel Zeit ... *seufz* Wir sind doch nicht hier, um unsere familiäre Beziehung zu vertiefen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180906
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401180906,
					"content": "Und jetzt erwähnst du wieder den Lawrence-Klan. Du hast selbst gesagt, dass wir alle nur gewöhnliche Menschen sind, also lass uns einfach voneinander lernen, wie alle anderen gewöhnlichen Menschen auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lessig"
				}
			]
		},
		{
			"id": 4011810,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
