				"points": []
			},
			"dialogs": [
				{
					"id": 401181101,
					"content": "Solch einen Tee trinke ich zum ersten Mal. Der Tee aus Inazuma ist wirklich ganz anders als die Getränke aus Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181102
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401181102,
					"content": "Apropos Tee, geben die Menschen von Sumeru auch Gewürze in ihren Tee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401181103,
					"content": "Manche schon, aber das ist nichts für mich. Ich bevorzuge ja Kaffee, nur dass man danach schlecht einschlafen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
