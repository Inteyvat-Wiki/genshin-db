			"dialogs": [
				{
					"id": 700200208,
					"content": "Es scheint, als wollte er uns etwas sagen ... Könnte es etwas mit dem merkwürdigen Hilichurl zu tun haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700200201,
					"content": "Yeye dada! Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200202
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200202,
					"content": "Odomu tomo zido mi! Mi mani yeye! <color=#00E1FFFF>Unta nunu</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200203
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200204,
					"content": "Uh ... D... Danke ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200206
					]
				},
				{
					"id": 700200205,
					"content": "Tomo, valo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200206
					]
				},
				{
					"id": 700200203,
					"content": "<color=#00E1FFFF>Unta nunu</color> ... Paimon glaubt, dass das etwas mit der Zeit zu tun hat. Das solltest du unbedingt im Handbuch nachlesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200204,
						700200205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700200206,
					"content": "Valo, tomo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
