			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kabayama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340101,
					"content": "Wie fühlst du dich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340102
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340102,
					"content": "Oh! Du hast mich erschreckt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340103
					]
				},
				{
					"id": 722340103,
					"content": "Entschuldigung, das wollte ich nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340104
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340104,
					"content": "Mein Name ist Kabayama und ich sitze oft dort, wo du jetzt sitzt. Es ist sehr ruhig und gut, um über das Leben nachzudenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340105
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340105,
					"content": "Soll ich dir Platz machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340106
					]
				},
				{
					"id": 722340106,
					"content": "Nun, danke, aber das ist nicht nötig. Übrigens, kommst du von woanders her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340107
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340107,
					"content": "Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340108
					]
				},
				{
					"id": 722340108,
					"content": "Dann hast du sicher schon eine Menge gesehen. Ich war noch nie draußen, obwohl das Umziehen schon eine Erfahrung war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340109
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340109,
					"content": "Da wir gerade von dieser Erfahrung beim Umziehen sprechen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340110
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340110,
					"content": "Da ich in meiner Jugend oft umgezogen bin, hatte ich kaum Freunde. Als ich alleine herumwanderte, fand ich oft eine tolle Aussicht und niemanden, mit dem ich sie teilen konnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340111
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340111,
					"content": "Es wäre gut, wenn ich dir die Sehenswürdigkeiten zeigen könnte. Es wäre schön, wenn du zurückkommen und mit mir über deine Erfahrung und das, was du fühlst, sprechen könntest, wenn du auf deiner Reise an diesen Orten vorbeikommst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340112
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340112,
					"content": "Eine unter dem höchsten Steintor in der Schmalen Schlucht, eine auf der von Korallen umgebenen Freifläche des Tempels der Ewigen Nacht und eine bei den hoch aufragenden Ruinen des Schlangenherzens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340113
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340113,
					"content": "Ich habe an all diesen Orten Markierungen hinterlassen und Lampen ganz hoch aufgehängt, um mir selbst etwas Licht zu geben. Du solltest sie leicht finden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				}
			]
		},
		{
			"id": 7223402,
			"completionStepIds": [],
