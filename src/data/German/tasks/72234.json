						],
						"stepId": 7223411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kabayama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340301,
					"content": "Du bist zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340302
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340302,
					"content": "Warst du schon an all diesen Orten? Je besser du dich auskennst, desto mehr denkst du vielleicht, dass die Landschaft an all diesen Orten nicht erwähnenswert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340303,
						722340304
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340303,
					"content": "Ich finde es sehr schön und einzigartig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				},
				{
					"id": 722340305,
					"content": "Oh, wenn ich daran denke, dass ich das noch nie mit jemandem geteilt habe. Es ist gut zu wissen, wie du darüber denkst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340306
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340306,
					"content": "Vielleicht gibt es anderswo viel bessere Orte als hier. Schließlich ist es stockdunkel, die Auswahl an Mahlzeiten ist gering und du musst dich vor Drachenechsen in Acht nehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340307
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340307,
					"content": "Aber nachdem ich lange Zeit dort gelebt habe, gibt es immer noch ein Gefühl des Widerwillens, wegzugehen. Ich werde immer noch nostalgisch, wenn ich an die Landschaft denke, die ich an diesen Orten gesehen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340308
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340308,
					"content": "Geht es dir auch so? Sogar Orte wie dieser können sich wie ein Zuhause anfühlen, wenn man dort lange Zeit gelebt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340309,
						722340310
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340309,
					"content": "Vielleicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340311,
					"content": "Ist das so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340312
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340312,
					"content": "... Wie auch immer, danke, dass du dir mein sinnloses Geschwafel angehört hast. Es ist nichts Wertvolles, aber es ist alles, was ich habe, also nimm es bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340310,
					"content": "Bestimmt nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340304,
					"content": "Ganz normal. Ich habe schon schönere Aussichten gesehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				}
			]
		}
	]
}