					"Kabayama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340201,
					"content": "Du bist zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340202
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340202,
					"content": "Hast du noch nicht alle Orte gefunden? Das ist schade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340203
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340203,
					"content": "Ich probiere es nochmal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340204
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340204,
					"content": "Eine unter dem höchsten Steintor in der Schmalen Schlucht, eine auf der von Korallen umgebenen Freifläche des Tempels der Ewigen Nacht und eine bei den hoch aufragenden Ruinen des Schlangenherzens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340205
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340205,
					"content": "Ich habe an all diesen Orten Markierungen hinterlassen und Lampen ganz hoch aufgehängt, um mir selbst etwas Licht zu geben. Du solltest sie leicht finden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				}
			]
		},
		{
			"id": 7223403,
			"completionStepIds": [
				7223411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223411",
