			"dialogs": [
				{
					"id": 766530201,
					"content": "Wo liegt bloß der Fehler? Nur theoretische Kenntnisse zu haben, ist anscheinend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530202
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530202,
					"content": "Diese Bestellung muss nicht überprüft werden ... Ginette, eine Ingenieurin aus Fontaine ... Das ist die Bestellung, die mich am meisten interessiert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530203
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530203,
					"content": "Endlich bist du da! Dann gibt es doch noch Hoffnung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530204
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530204,
					"content": "Hallo, wir sind Ainos Assistenten. Wie können wir helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530205,
					"content": "Sie hat eine Art Roboter entwickelt, mit denen man per Kuuvahki über lange Distanzen kommunizieren kann, wirklich toll. Aber es treten viele Störungen auf, deswegen wandte sie sich zur Justierung an mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530206
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530206,
					"content": "Wirklich beschämend. Bei Versuchen rein aus Neugierde lassen sich keine Ergebnisse erzielen. Am Ende liegt es doch an der Durchführung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530207
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530207,
					"content": "Das klingt gar nicht so kompliziert. Überlass das uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530208,
					"content": "Es ist mir ein wenig peinlich, aber ... ich würde die Bestellung gern ändern. Während ich auf die Antwort gewartet habe, hatte ich nichts weiter zu tun und habe noch ein paar weitere Sachen durcheinander gebracht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530209
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530209,
					"content": "Ich war neugierig, ob die Störungen durch eine Umgebungsveränderung behoben werden könnten. Also habe ich nach einigen Gebieten mit unterschiedlichem Kuuvahki gesucht und sie einzeln getestet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530210
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530210,
					"content": "Aber alle Roboter erlitten eine Störung und der Kontakt zu ihnen brach ab ... Deswegen wollte ich fragen, ob ihr mir, abgesehen von der vorher vereinbarten Justierung, helfen könntet, die Roboter wiederzufinden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530211
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530211,
					"content": "Du hast sie alle verloren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530212,
					"content": "Falls eine zusätzliche Bezahlung nötig ist, werde ich mir etwas einfallen lassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530213
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530213,
					"content": "Also, es gibt viele Möglichkeiten, sie zu finden. Die Roboter werden mit Kuuvahki betrieben und an den Orten, an denen sie sich aufhalten, hinterlassen sie „Kuuvahki-Muster“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530214
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530214,
					"content": "Ich werde euch ein spezielles Gerät geben. Ihr müsst nur damit genügend „Kuuvahki-Muster“ sammeln, dann könnt ihr den zugehörigen Roboter aufspüren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530215
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530215,
					"content": "Hm ... Das wird sicher Spaß machen! Da es Vergnügen verspricht, erlasse ich dir die zusätzlichen Gebühren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530216
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530216,
					"content": "Wirklich? Das wäre toll, vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ginette"
				}
			]
		}
	]
}