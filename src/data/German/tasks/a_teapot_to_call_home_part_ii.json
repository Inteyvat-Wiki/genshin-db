			"dialogs": [
				{
					"id": 716540201,
					"content": "Ooh ... diese Teekanne scheint innen noch größer zu sein als die von Madame Ping. Es steht sogar ein großes Haus in der Mitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540202,
					"content": "Hm, aber da ist einfach eine ganze Menge Nichts drumherum ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540203,
						716540205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540203,
					"content": "Fang an zu meißeln, Paimon ... Du könntest uns ein ganzes Haus aus diesem Stein schneiden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716540204
					]
				},
				{
					"id": 716540204,
					"content": "#Nun, du bist {F#diejenige}{M#derjenige} mit dem Schwert in der Hand, du tust es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540207,
					"content": "Trotzdem ... warum ist es hier so leer, abgesehen von diesem Haus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540208,
					"content": "Oh, Moment mal, was ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540205,
					"content": "Grabe dir doch eine Höhle, in der du vorerst leben kannst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716540206
					]
				},
				{
					"id": 716540206,
					"content": "He! Gleich da drüben steht ein perfektes Haus. Warum sollte Paimon in einem Loch im Boden leben müssen!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540207
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
