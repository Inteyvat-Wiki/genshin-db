			"dialogs": [
				{
					"id": 220410301,
					"content": "Hast du ihn gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410302
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220410302,
					"content": "Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410303
					]
				},
				{
					"id": 220410303,
					"content": "Er ist wieder verschwunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410304,
						220410305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220410304,
					"content": "Ich werde ihn wieder einfangen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410306
					]
				},
				{
					"id": 220410306,
					"content": "Ihr müsst nicht mehr suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410307
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220410307,
					"content": "Der Junge ist noch böse ... Ich werde dem Jungen später selbst eine Lektion erteilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410308
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220410308,
					"content": "Er ist fast ein großer Kater, aber er ist immer noch so eigensinnig. Was, wenn er die Menschen erschreckt, die zum Schrein kommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410309
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220410309,
					"content": "Die sind für dich. Danke für deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410310
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220410310,
					"content": "Dieses Kind, warum ist es immer so ungehorsam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220410305,
					"content": "Ich glaube es nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
