			"dialogs": [
				{
					"id": 220410101,
					"content": "Du bist gerade zur rechten Zeit gekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410102
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220410102,
					"content": "Was ist passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410103
					]
				},
				{
					"id": 220410103,
					"content": "Kennt ihr noch das Kind Konbumaru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410104
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220410104,
					"content": "Der Junge ist nicht zurückgekehrt, seit er in der Nähe spielen gegangen ist, und ich bin besorgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410105
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220410105,
					"content": "Bitte, sucht nach Konbumaru, und bringt ihn zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410106,
						220410108
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220410106,
					"content": "Werde ich machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410107
					]
				},
				{
					"id": 220410107,
					"content": "Danke! Bring ihn zu mir, sobald du ihn hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220410108,
					"content": "Ist nur er weggelaufen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410109
					]
				},
				{
					"id": 220410109,
					"content": "Ja, vielleicht ist er beleidigt, weil ich ihn angeschnauzt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410110
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220410110,
					"content": "Dieses Kind, warum ist es immer so ungehorsam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410111
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220410111,
					"content": "Danke! Bring ihn zu mir, sobald du ihn hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				}
			]
		},
