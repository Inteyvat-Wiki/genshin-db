				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111122301,
					"content": "Jetzt, da du es sagst, ist meines der einzige Artikel, der komplett gekauft wurde. Deine sind beide handgemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122302
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111122302,
					"content": "Aber deins ist viel mehr wert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122303
					],
					"speakerTitle": "Kleiner Wu"
				},
				{
					"id": 111122303,
					"content": "Der Wert in Mora ist nicht das Wichtigste hier. Diese Dinge haben alle eine große Rolle in unserer Kindheit gespielt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122304
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111122304,
					"content": "Sie beweisen, dass wir unser Versprechen niemals vergessen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congzi"
				}
			]
		},
		{
