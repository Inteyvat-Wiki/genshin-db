			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Congzi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120501,
					"content": "Was? Ihr seid alle hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120502,
					"content": "In alten Zeiten schwelgen, an vergangene Erlebnisse zurückdenken ... Das machen wir schon seit Jahren so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120503
					],
					"speakerTitle": "Kleiner Wu"
				},
				{
					"id": 111120503,
					"content": "Unsere Heimatstadt wurde bei einer Naturkatastrophe vollständig zerstört, sodass wir nirgendwo mehr hingehen können. Jetzt ist unser Zuhause dort, wo unsere Freunde sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120504
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120504,
					"content": "Sie haben mir gerade erzählt, dass du auf der Suche nach Erinnerungsstücken bist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120505
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120505,
					"content": "Ich stelle handgemachte Laternen im Hafen von Liyue her. Ich denke, sie repräsentieren mich besser als alles andere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120506
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120506,
					"content": "Vor einigen Tagen habe ich ein paar hochwertige Plaustritbröckchen gekauft, sie liegen zurzeit alle im Lager am Dock.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120507
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120507,
					"content": "Ich habe schon mit dem Verwalter gesprochen. Könnte ich dich bitten, sie zu holen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120508
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120508,
					"content": "#Du scheinst schon Bescheid zu wissen, {NICKNAME}! Wir sind im Handumdrehen wieder da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1111208,
			"completionStepIds": [
				1111208
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111208",
							"2"
