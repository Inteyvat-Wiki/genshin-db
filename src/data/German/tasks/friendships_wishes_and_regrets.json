			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120101,
					"content": "Das ist ja rasch eskaliert. Ich bin mir nicht mehr sicher, was da vor sich geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120102,
						111120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120102,
					"content": "Ich hatte auch nicht erwartet, dass ich einfach so über Brummi stolpere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				},
				{
					"id": 111120104,
					"content": "Eigentlich bin ich überhaupt nicht überrascht. Erinnerst du dich, was ich gesagt habe? Es gibt nur so viele böse Geister auf dieser Welt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120105
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120105,
					"content": "Es war eine Laune des Schicksals, die ihn dazu brachte, den Wuwang-Hang zu verlassen. Nun kann er aus irgendwelchen Gründen nicht mehr zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120106
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120106,
					"content": "Diese Erklärung klingt für mich etwas weit hergeholt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120107,
					"content": "Genau genommen ... hat sie es so ziemlich auf den Punkt gebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120108
					],
					"speakerTitle": "Brummi"
				},
				{
					"id": 111120108,
					"content": "Hm??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120109,
					"content": "Hehe, bitte niemals meine Professionalität infrage stellen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120110
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120110,
					"content": "Ich wollte nur nach meinen Freunden sehen. Deswegen ging ich zum Hafen von Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120111
					],
					"speakerTitle": "Brummi"
				},
				{
					"id": 111120111,
					"content": "Ich verspreche, dass ich keinen bösen Willen hatte! Ich wollte niemanden erschrecken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120112
					],
					"speakerTitle": "Brummi"
				},
				{
					"id": 111120112,
					"content": "Vor ein paar Tagen kamen ein paar Leute aufgrund einer Mutprobe zum Wuwang-Hang. Ich habe gehört, wie sie sagten, dass sie vom Hafen von Liyue kämen, also bin ich einem von ihnen gefolgt und bin hier gelandet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120113
					],
					"speakerTitle": "Brummi"
				},
				{
					"id": 111120113,
					"content": "Aha, das muss der arme Luocheng gewesen sein, dem du gefolgt bist. Vielleicht hat er dich nicht bemerkt, aber er konnte deine Anwesenheit trotzdem spüren. Jetzt wissen wir, was seine Albträume verursacht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120114
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120114,
					"content": "Was? Ich wurde entdeckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120115
					],
					"speakerTitle": "Brummi"
				},
				{
					"id": 111120115,
					"content": "Das vermute ich mal, sonst hätte er sich nicht halb tot geängstigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120116
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120116,
					"content": "Warum bist du nicht früher gekommen, um nach Meng zu suchen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120117
					]
				},
				{
					"id": 111120117,
					"content": "Ja, Hu Tao und Meng suchten überall nach dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120118,
					"content": "Oh, das ist, weil ich sie nicht finden konnte. Ich bin das erste Mal im Hafen von Liyue und habe mich in der Stadt verlaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120119
					],
					"speakerTitle": "Brummi"
				},
				{
					"id": 111120119,
					"content": "Jetzt, da du es erwähnst, Brummi hatte schon immer einen schlechten Orientierungssinn. Als wir Kinder waren, ist er nie allein den Hang hinuntergegangen, wir mussten ihn immer begleiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120120
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120120,
					"content": "Also war all das nur deshalb, weil du dich verlaufen hast?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120121,
					"content": "Warum bist du nicht einfach wie jeder andere Geist oder jede andere Seele geflogen? Meinst du nicht, dass es so viel einfacher ist, den Weg von oben zu finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120122,
					"content": "I... Ich kann das nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120123
					],
					"speakerTitle": "Brummi"
				},
				{
					"id": 111120123,
					"content": "Das ist mir zu hoch, ich würde Panik bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120124
					],
					"speakerTitle": "Brummi"
				},
				{
					"id": 111120124,
					"content": "Das stimmt, ja, er hatte früher so große Höhenangst, dass er nicht einmal den Hang hinuntersehen wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120125
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120125,
					"content": "Hahaha, du hast dich kein bisschen verändert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120126,
						111120127
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120126,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120128,
					"content": "Ich wusste, dass ich mich den lebenden Menschen nicht zeigen durfte und bei so vielen Menschen, die im Hafen von Liyue herumliefen, war meine einzige Möglichkeit, mich zu verstecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120129
					],
					"speakerTitle": "Brummi"
				},
				{
					"id": 111120129,
					"content": "Ich hätte dich nicht gefunden, wenn der Elementarmonolith nicht ausgesendet hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120130
					],
					"speakerTitle": "Brummi"
				},
				{
					"id": 111120130,
					"content": "Ich bin so froh, dass du nicht zu einem bösen Geist geworden bist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120131
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120131,
					"content": "Zweifle niemals an meinem Urteilsvermögen. Jetzt müssen wir nur noch dieses verlorene Kind zurück zum Wuwang-Hang begleiten, dann sollte alles in trockenen Tüchern sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120132
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120132,
					"content": "Aber er sagte nur, dass er seine Freunde besuchen wollte. Außer mir sind da noch der kleine Wu, Mumu und Congzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120133
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120133,
					"content": "Nun ... wenn das so ist, dürfen wir ihn nicht im Stich lassen. Wir werden sie alle bitten, uns bei der Vorbereitung einer Abschiedsfeier für Brummi zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120134
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120134,
					"content": "Meng und ich werden Brummi zurück zum Wuwang-Hang begleiten. Triff dich mit den dreien und bitte sie um Erinnerungsstücke, die jeden von ihnen beim Ritual repräsentieren sollen und komm dann zu uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120135
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120135,
					"content": "Sie sind alle Freunde, können wir nicht einfach gemeinsam dorthin gehen? Oder vielleicht bringen wir Brummi zu ihnen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120136,
					"content": "Ähm ... Das ist keine gute Idee. Ich möchte sie nicht erschrecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120137
					],
					"speakerTitle": "Brummi"
				},
				{
					"id": 111120137,
					"content": "Ich will nicht, dass die einfachen Leute abergläubisch werden. Je weniger sie wissen, desto besser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120138
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120138,
					"content": "Sei also vorsichtig, was du sagst, wenn du die Andenken sammelst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120127,
					"content": "Vielleicht ist „Brummi“ nicht der passende Name für dich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120103,
					"content": "Dann ist Brummi also kein böser Geist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				}
			]
		},
		{
			"id": 1111202,
			"completionStepIds": [
				1111202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111202",
							"2"
						],
						"stepId": 1111202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kleiner Wu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120201,
					"content": "He! Erinnerst du dich an uns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120202,
					"content": "Du ... Entschuldige, ich werde die Dienste des Bestattungsunternehmens in nächster Zeit nicht in Anspruch nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120203,
						111120204
					],
					"speakerTitle": "Kleiner Wu"
				},
				{
					"id": 111120203,
					"content": "Meng hat uns seine Geschichte erzählt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120205
					]
				},
				{
					"id": 111120205,
					"content": "Ja, Meng und ich sind gemeinsam aufgewachsen. Wir bleiben auch jetzt noch in Kontakt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120206
					],
					"speakerTitle": "Kleiner Wu"
				},
				{
					"id": 111120206,
					"content": "Ich weiß nicht, warum er anfing, für das Bestattungsunternehmen Wangsheng zu arbeiten. Ich finde deren Direktorin ehrlich gesagt ziemlich eigenartig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120207
					],
					"speakerTitle": "Kleiner Wu"
				},
				{
					"id": 111120207,
					"content": "Aber er wird seine Gründe gehabt haben. Schließlich ist er jetzt alleine und kommt immer noch nicht darüber hinweg, was mit Brummi passiert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120208
					],
					"speakerTitle": "Kleiner Wu"
				},
				{
					"id": 111120208,
					"content": "Hat er dir davon erzählt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120209
					],
					"speakerTitle": "Kleiner Wu"
				},
				{
					"id": 111120209,
					"content": "Ja, hat er. Wenn du dir eine Sache aussuchen könntest, die du Brummi als Erinnerungsstück geben würdest, was würdest du auswählen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120210,
					"content": "Aber nur, weißt du, rein hypothetisch gesehen. Wir sind hier total hypothetisch, wir werden ihm definitiv nicht tatsächlich gedenken oder sowas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120211,
						111120212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120211,
					"content": "(Das ist ein bisschen übertrieben.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120213
					]
				},
				{
					"id": 111120213,
					"content": "Ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120214
					],
					"speakerTitle": "Kleiner Wu"
				},
				{
					"id": 111120214,
					"content": "Ich würde etwas für ihn kochen. Er konnte wie niemand sonst aus unserer Gruppe scharfes Essen genießen. Sein Lieblingsessen war extra-scharfe kalte Geflügelhäppchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120215
					],
					"speakerTitle": "Kleiner Wu"
				},
				{
					"id": 111120215,
					"content": "Ich kann es für dich zubereiten, wenn du mir ein paar Jueyun-Peperoni besorgst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120216
					],
					"speakerTitle": "Kleiner Wu"
				},
				{
					"id": 111120216,
					"content": "Ich denke, er wird den Geschmack seiner Kinderjahre zu schätzen wissen. Ich verwende immer noch dieses alte Rezept.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120217
					],
					"speakerTitle": "Kleiner Wu"
				},
				{
					"id": 111120217,
					"content": "Abgemacht! Gib uns einfach eine Minute!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120212,
					"content": "(Typisch Paimon ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120213
					]
				},
				{
					"id": 111120204,
					"content": "Meng sagte, dass er ein alter Freund von dir ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120205
					]
				}
			]
		},
		{
			"id": 1111203,
			"completionStepIds": [
				1111203
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111203",
							"2"
						],
						"stepId": 1111203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kleiner Wu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120301,
					"content": "Das sollte genug sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120302
					],
					"speakerTitle": "Kleiner Wu"
				},
				{
					"id": 111120302,
					"content": "Ich fange mit den kalten Geflügelhäppchen an. Ich nehme an, dass du noch andere Leute ausfindig machen musst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120303
					],
					"speakerTitle": "Kleiner Wu"
				},
				{
					"id": 111120303,
					"content": "Wenn alle bereit sind, bringe ich das Gericht rüber zu dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120304
					],
					"speakerTitle": "Kleiner Wu"
				},
				{
					"id": 111120304,
					"content": "Toll! Wir sehen uns später!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120305,
					"content": "(Äh? Woher wusste er das?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1111204,
			"completionStepIds": [
				1111204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111204",
							"2"
						],
						"stepId": 1111204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mumu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120401,
					"content": "Ach ... nicht du schon wieder. Ich sagte doch, dass mich die inneren Vorgänge des Bestattungsunternehmens Wangsheng nicht interessieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120402
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120402,
					"content": "Meng hat uns von dir erzählt, ihr seid doch gute Freunde, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120403,
					"content": "Das stimmt, ja. Wenn ich mich richtig erinnere, ist er vor Kurzem dem Bestattungsunternehmen Wangsheng beigetreten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120404
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120404,
					"content": "Seine guten Freunde brauchten nicht lange, um herauszufinden, warum ... Der Vorfall mit Brummi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120405
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120405,
					"content": "Aber ich weiß, dass wir nichts sagen können, um ihm zu helfen, darüber hinwegzukommen. Die Vergangenheit loszulassen ist ein schmerzvoller Akt. Ich weiß das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120406
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120406,
					"content": "Also ist Brummi der Grund, warum du hier bist, mich zu sehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120407
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120407,
					"content": "Woher wusstet du das!? Wir haben überhaupt nichts gesagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120408,
					"content": "Haha, ich bin ja auch ein Geschäftsmann, ich kann meine Geheimnisse nicht preisgeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120409
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120409,
					"content": "Jeder hört den Namen „Mumu“ und denkt, dass ich wohl doof sein muss, denn als ich mich niederließ, hörte ich das pausenlos. Aber ... Ich habe ein paar Leute eines Besseren belehrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120410
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120410,
					"content": "Nimm das hier, es ist eine hochwertige Spielzeugkiste, von der wir alle als Kinder geträumt haben, sie zu haben. Damals konnte sie sich keiner von uns leisten, wir waren arm dran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120411
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120411,
					"content": "Heute brummt das Geschäft. Ich habe mir letztendlich viele davon gekauft. Es war ein Traum, der wahr wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120412
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120412,
					"content": "Oha, du musst ja superreich sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120413,
					"content": "Haha ... Für mich ist es ein Erinnerungsstück an eine längst vergessene Kindheit. Ohne sie wären wir nicht dort, wo wir heute sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120414
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120414,
					"content": "Da du mich also gefunden hast, wirst du wohl als nächstes nach dem kleinen Wu und Congzi suchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120415
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120415,
					"content": "Mhmm! Wir haben bereits den Kleinen Wu getroffen, jetzt müssen wir Congzi finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120416,
					"content": "Ich verstehe. Wenn du Congzi suchst, dann sollten wir uns an der Brücke am Feiyun-Hang treffen. Das ist direkt über der Treppe, die zum Dock hinunterführt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120417
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120417,
					"content": "Ich habe eine Besorgung zu erledigen, ich komme zu dir, sobald ich fertig bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mumu"
				}
			]
		},
		{
			"id": 1111205,
			"completionStepIds": [
				1111205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111205",
							"2"
