					"Congzi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120801,
					"content": "Ich danke euch beiden, das sieht nach großartigem Material aus. Bitte wartet einen Moment, das ist der letzte Schritt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120802
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120802,
					"content": "Gut, das war es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120803
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120803,
					"content": "Ich habe alle unsere fünf Namen auf die Innenseite der Laterne geschrieben. Weißt du, während des jährlichen Laternenrituals werden wir alle so eine Laterne steigen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120804
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120804,
					"content": "Ganz egal, was die nächsten Tage bringen werden, welche Wege wir auch wählen ... Solange dieser Ritus befolgt wird, bleibt jeder von uns derselbe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120805
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120805,
					"content": "Was die Sache mit Brummi angeht, so haben wir drei uns abgesprochen und sind zu dem Schluss gekommen, dass wir dich damit nicht belasten werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120806
					],
					"speakerTitle": "Kleiner Wu"
				},
				{
					"id": 111120806,
					"content": "Aber wenn du die Gelegenheit hast, sag ihm bitte ... dass es uns gut geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120807
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120807,
					"content": "Und dass die Dinge, von denen wir einst redeten, alle in Erfüllung gegangen sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120808,
						111120809
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120808,
					"content": "Ihr könnt auf uns zählen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120810
					]
				},
				{
					"id": 111120810,
					"content": "Danke, wir werden das weitergeben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120811,
					"content": "Brummi hat Glück, solche Freunde zu haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120809,
					"content": "Und ich werde dich nicht bedrängen mit „den Dingen, von denen ihr einst geredet habt“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120810
					]
				}
			]
		},
