			"dialogs": [
				{
					"id": 111122201,
					"content": "Jueyun-Peperoni sind in Liyue ein alltäglicher Anblick. Wenn du mir hilfst, welche zu finden, kann ich dieses Gericht im Nu zubereiten.",
					"roleType": "TALK_ROLE_NPC",
