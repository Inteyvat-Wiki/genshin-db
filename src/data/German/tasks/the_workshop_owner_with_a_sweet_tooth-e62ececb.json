			},
			"dialogs": [
				{
					"id": 402270101,
					"content": "Hm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270102
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270102,
					"content": "Hallo ihr zwei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270103,
					"content": "#{NICKNAME}, Paimon, hallo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270104
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270104,
					"content": "Wir helfen Nefer bei einigen Messevorbereitungen und haben gehört, dass die Krumkake-Werkstatt Kling-Klang daran teilnimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270105,
					"content": "Korrekt. Aino nimmt gerade eine letzte Fehlerbehebung an ihren Wächtern „Klatsch und Knall“ vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270106,
					"content": "Oh, ist das ihr Beitrag für die Messe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270107,
					"content": "Ja. Maulwürfe und andere kleine Tiere klauen oft Sachen aus der Werkstatt. Deshalb hat Aino eine Reihe von Sicherheitsvorrichtungen entwickelt, die ihnen nachempfunden sind und zur Überwachung dienen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270108
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270108,
					"content": "Nachdem weitere Tests durchgeführt worden waren, erwiesen sich diese Wächter als äußerst effektiv, sodass sie entschied, einige Verbesserungen vorzunehmen und sie auf die Messe mitzunehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270109
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270109,
					"content": "Warte, Aino wird also tatsächlich ihre Roboter verkaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270110,
					"content": "Nicht ganz. Mit Ausnahme einiger Sonderbestellungen verkauft Aino ihre fertigen Produkte nur äußerst selten. Was sie auf der Messe anbietet, sind die Baupläne, nicht die fertigen Produkte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270111
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270111,
					"content": "Ooh ... Also, seid ihr bereit, rüberzugehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270112,
					"content": "Jahoda hat uns gebeten, euch zu sagen, dass ihr euch beeilen sollt. Sie hält euch einen supertollen Platz frei und hat Angst, dass die Leute anfangen könnten, Fragen zu stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270113,
					"content": "Ich habe ihr doch gesagt, dass ich zuerst die Fehlerbehebung abschließen muss! Es hat keinen Sinn, sich zu beeilen, sonst habe ich nichts zum Handeln!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270114
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270114,
					"content": "Oha, Paimon hat Aino noch nie so seriös erlebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270115,
					"content": "Die Werkstatt hat mit erheblichen finanziellen Engpässen zu kämpfen. Aino hofft, dass die Messe unsere finanzielle Lage verbessert. Deshalb ist sie besonders gründlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270116
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270116,
					"content": "Wo ist denn das ganze Geld hin? Für irgendwelche teuren Forschungsprojekte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270117,
					"content": "Negativ. Es sind unsere Mittel für Süßigkeiten, die fehlen. Wir hatten mindestens siebenundvierzig Fälle, in denen übermäßige Süßigkeitenkäufe zu einem Mangel an Forschungsmitteln geführt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270118
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270118,
					"content": "Daher habe ich beschlossen, unsere Budgets für Forschung und Desserts aufzuteilen. Aino ist es strengstens untersagt, Geld aus dem einen Budget in das andere zu übertragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270119
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270119,
					"content": "Und es ist noch nicht so lange her, da hat sie das gesamte Süßigkeitenbudget für diesen Monat aufgebraucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270120,
						402270121
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270120,
					"content": "Verstehe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				},
				{
					"id": 402270122,
					"content": "In Ordnung, fertig! Wächter „Klatsch und Knall“, macht mich stolz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270123
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270123,
					"content": "Sieht so aus, als könnten wir jetzt rübergehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270121,
					"content": "Keine große Überraschung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				}
			]
		},
