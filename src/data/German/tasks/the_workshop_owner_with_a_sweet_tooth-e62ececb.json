			"dialogs": [
				{
					"id": 402270201,
					"content": "Du bringst Aino und Ineffa zum Veranstaltungsort.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402270202
					]
				},
				{
					"id": 402270202,
					"content": "Hm ... Das sieht nach einem guten Platz für die Demo-Plattform aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270203
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270203,
					"content": "Diese neuen Wächter-Roboter sehen ziemlich interessant aus, Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270204,
					"content": "Hehe. Dann kommt vorbei und probiert sie aus, wann immer ihr wollt! Sie werden euch umhauen, da bin ich mir sicher!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270205
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270205,
					"content": "Danke für die Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270206
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270206,
					"content": "Null Problemo! Oh, und was die Anmeldung angeht, seid ihr dann nur zu zweit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270207,
					"content": "Hm ... Ich werde teilnehmen, aber es ist nicht nötig, Aino anzumelden. Sie mag es nicht, wenn viele Leute um sie herum sind. Sobald die Messe beginnt, wird sie direkt zur Werkstatt zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270208
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270208,
					"content": "Hehe, typisch Aino ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}