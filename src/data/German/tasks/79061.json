			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790610601,
					"content": "„Dieser Brief ist für meine Nachbarn, meine Freunde, den Leuchtturm und die kleine Blume.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610602
					],
					"speakerTitle": "Kritzelig geschriebener Brief"
				},
				{
					"id": 790610602,
					"content": "„Ich gehe gleich mit Rozel auf Entdeckungstour. Du kannst gern meine Schaukel, den Tisch und den Hocker benutzen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610603
					],
					"speakerTitle": "Kritzelig geschriebener Brief"
				},
				{
					"id": 790610603,
					"content": "„Ich wünsche dir alles Gute.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610604
					],
					"speakerTitle": "Kritzelig geschriebener Brief"
				},
				{
					"id": 790610604,
					"content": "„Dein Nachbar Esnoir.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kritzelig geschriebener Brief"
				}
			]
		},
