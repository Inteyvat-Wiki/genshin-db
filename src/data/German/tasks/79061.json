			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790610501,
					"content": "Es tut mir leid, Rozel. Ich ... kann immer noch nicht mit dir gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610502
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610502,
					"content": "Es reicht mir, wenn ich hierbleibe. Wenn du von deinem Ausflug zurückkommst, wird hier jemand auf dich warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610503
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610503,
					"content": "Aber, Esnoir, ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610504
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610504,
					"content": "Ich bin weder klug noch mutig genug, Rozel. Aber ich glaube ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610505
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610505,
					"content": "Ich glaube, dass die Brise durch das Gebüsch rauscht, die Flüsse durch die Seen fließen und der Kreislauf von neuem beginnt, dass am Ende alles dorthin zurückkehrt, wo es begann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610506
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610506,
					"content": "Vielleicht ist ihr letzter Wunsch, nachdem sie so viele Veränderungen erlebt haben, immer noch ... wieder so wie früher zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610507
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610508
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610508,
					"content": "Ich werde hier, zu Hause, auf dich warten, mein Freund, wie ich es immer getan habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esnoir"
				}
			]
		},
