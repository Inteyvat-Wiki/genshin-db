							711.501
						],
						"pointId": 294
					}
				]
			},
			"dialogs": [
				{
					"id": 790610301,
					"content": "Die <color=#FFCC33FF>Welt drinnen</color> ist eigentlich auch ganz nett.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610302
					]
				},
				{
					"id": 790610302,
					"content": "Ja, das ist schließlich das Zuhause von Esnoir. Du musst diesen Ort sehr lieben und ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610303,
						790610304,
						790610305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610303,
					"content": "Es gibt hier so viele liebe Freunde ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610306,
					"content": "Genau! Es ist genau die Angst, diese Dinge zu verlieren, die mich beunruhigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610307
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610307,
					"content": "All diese Dinge sind großartig, sehr großartig ... Ich will nicht, dass sie sich ändern, und ich will mich auch nicht ändern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610308
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610308,
					"content": "... Aber ... eine lange Reise wird alles verändern. Richtig? Rozel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610309
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610309,
					"content": "Ja, es wird sich definitiv verändern. Ich möchte dich nicht anlügen und ich möchte dich nicht traurig machen, lieber Esnoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610310
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610310,
					"content": "Ja ... Ja. Ich verstehe deine Gefühle und du verstehst auch meine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610311
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610311,
					"content": "Ich werde über deine Einladung nachdenken und mich später entscheiden ... Aber jetzt sollten wir erstmal in Ruhe zusammen einen Tee trinken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610312
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610312,
					"content": "Gut ... Ich werde für dich da sein, Esnoir. Es ist noch ein langer Weg bis zum nächsten Abreisetag. Ich kann mit dir zusammen darüber nachdenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610304,
					"content": "Es gibt viele schöne Blumen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610305,
					"content": "... und so viele leckere Kuchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				}
			]
		},
		{
			"id": 7906104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7906102",
							"2"
						],
						"stepId": 7906102,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"79061"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790610401,
					"content": "Rozel, vielleicht ... kann ich mit dir gehen. Aber ... ich weiß nicht, wie genau ich mich vorbereiten soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610402
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610402,
					"content": "Das ist ganz einfach. Bereite deine Konfitüre, dein Brot und deine Neugier vor. Zieh bequeme Kleidung an und bring auch Ersatzkleidung mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610403
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610403,
					"content": "Und bereite dich letztlich darauf vor, dass du einige dieser Dinge auf dem Weg wegwerfen musst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610404
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610404,
					"content": "Oh. Das klingt alles so kompliziert. Und ich will nichts wegwerfen, denn die Sachen gehören mir, sie sind wertvoll und ich mag sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610405
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610405,
					"content": "Sobald sie dich verlassen haben, wirst du neue wertvolle Dinge entdecken, mein lieber Esnoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610406
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610406,
					"content": "Glaub mir, das wird eine faszinierende Reise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				}
			]
		},
		{
			"id": 7906105,
