			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 100,
						"position": [
							998.028,
							216.884,
							711.501
						],
						"pointId": 294
					}
				]
			},
			"dialogs": [
				{
					"id": 790610201,
					"content": "Ja, die <color=#FFCC33FF>Welt da draußen</color> ist voller neuer Erfahrungen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610202
					]
				},
				{
					"id": 790610202,
					"content": "Ja, draußen gibt es vieles leckeres Essen und unterhaltsame Dinge zu entdecken. Wir können immer sehr interessante Erfahrungen sammeln und fantastische Leute kennenlernen. Zum Beispiel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610203,
						790610204,
						790610205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610203,
					"content": "Diejenigen, die sich auf die wundervolle Natur der Sache konzentrieren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610206,
					"content": "Wirklich? Ich dachte, die Welt draußen dreht sich nur um „Wert“, und alle dort sind diejenigen, die einen Hut tragen wollen, sich aber nicht trauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610207
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610207,
					"content": "Das ... ähm ... das ist ... wie die Schokobohnen, die auf einen Kuchen gestreut werden! Jede hat ihren eigenen, einzigartigen Geschmack.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610208,
					"content": "Wenn alle Schokobohnen gleich schmecken würden, wäre der Kuchen dann nicht zu langweilig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610209,
						790610210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610209,
					"content": "Paimon, du kannst wirklich gut mit Worten umgehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610211,
					"content": "Da Paimon schon so lange zugehört hat, kann Paimon sich auch mehr oder weniger korrekt ausdrücken! Haha, was Paimon gerade gesagt hat, macht doch Sinn, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610212,
					"content": "Ist das wirklich wahr? Ich ... Ich muss noch weiter darüber nachdenken ... Vielleicht wäre es schön, einen kleinen Versuch für eine lange Reise zu machen ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610213
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610213,
					"content": "Nimm dir Zeit, Esnoir. Es ist noch ein langer Weg bis zum nächsten Abreisetag. Ich kann mit dir zusammen darüber nachdenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610210,
					"content": "Paimon, du hast dich vollkommen an diesen Ort gewöhnt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610204,
					"content": "Diejenigen, die strahlende, unvergängliche Ideale haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610205,
					"content": "Und diejenigen, die unermüdlich für ihre Träume kämpfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				}
			]
		},
		{
			"id": 7906103,
