				]
			},
			"dialogs": [
				{
					"id": 790610101,
					"content": "Rozel, egal, wie oft du es sagst, ich werde nicht mit dir auf die lange Reise gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610102
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610102,
					"content": "Ich bin dein Freund, das wird sich nie ändern. Ich habe nichts gegen dich, aber ... aber ich mag einfach keine langen Reisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610103
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610103,
					"content": "Esnoir, es ist nicht so schlimm, wie du denkst, es ist nur eine Reise, mehr nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610104
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610104,
					"content": "Die Welt draußen birgt viele Blumen, die im Dorf unbekannt sind, Menschen, die im Dorf nie gesehen wurden, und selbst die Form der Wolken ist anders als gewohnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610105
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610105,
					"content": "Erinnerst du dich an die Blumensamen, die ich von draußen mitgebracht habe? Ich schwöre, so eine Blume in der Form und Farbe hast du noch nie gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610106
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610106,
					"content": "Es sind immer noch Samen. Ich werde sie einpflanzen und darauf warten, bis sie blühen, um zu sehen, ob deine Beschreibung der Wahrheit entspricht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610107
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610107,
					"content": "Wenn du dich mit mir auf die lange Reise begibst, könnten wir vielleicht direkt diese Art von Blume finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610108
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610108,
					"content": "Rozel ... Tut mir leid, ich will nicht lange reisen oder wie diese Abenteurer werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610109
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610109,
					"content": "Sie zeigen immer nur Interesse am Wert des Teppichs, aber die Schönheit des Huts ignorieren sie einfach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610110
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610110,
					"content": "Diese Veränderung bringt das lange Reisen mit sich und sie macht mir Angst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610111
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610111,
					"content": "Ja, das stimmt schon. Aber hast du mal darauf geachtet, was die alles in ihren Koffern haben? Landkarten, Pflanzenproben und Reisetagebücher voller Geschichten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610112
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610112,
					"content": "Wir sind wie der Wind, der durch verschiedene Wälder und Graslandschaften streift, wie das Bächlein, das durch unterschiedliche Flüsse und Seen fließt ... Wir erleben ständig neue Dinge, verändern uns dabei und können nie wieder so sein wie am Anfang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610113
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610113,
					"content": "Diese Veränderung, die lange Reisen mit sich bringen, macht mir auch Angst ... Aber ich bin auch dankbar dafür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610114
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610114,
					"content": "Diese Empfindung gleicht einer Scheibe Brot mit dem Sahne-Aufstrich auf beiden Seiten. Egal, wie vorsichtig du sie anfasst, es wird immer eine Seite geben, auf der du den Sahne-Aufstrich durcheinander bringst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610115
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610115,
					"content": "Dann würde ich den Sahne-Aufstrich separat auf verschiedene Brotscheiben schmieren, damit ich sogar verschiedene Geschmacksrichtungen probieren kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610116,
						790610117
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610116,
					"content": "Das ist eine gute Idee. Das wird sicherlich dafür sorgen, dass alle satt werden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				},
				{
					"id": 790610118,
					"content": "Du bist es! Endlich bist du wieder da. Rozel hat mir immer von der Schönheit der Welt draußen erzählt und mich eingeladen, mit ihm zu reisen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610119
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610119,
					"content": "Verstehst du die Welt da draußen? Ist es wirklich so, wie Rozel es beschrieben hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610117,
					"content": "Das ist eine gute Idee, dann bekommt man die Sahne nicht an die Hände.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				}
			]
		},
		{
			"id": 7906102,
			"completionStepIds": [
				7906101
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
