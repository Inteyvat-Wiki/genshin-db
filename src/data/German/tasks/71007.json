				"points": []
			},
			"dialogs": [
				{
					"id": 710070101,
					"content": "Wie läuft die Malerei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710070102
					]
				},
				{
					"id": 710070102,
					"content": "Ich malte hier neben diesen beiden Statuen, seit ihre Augen aufleuchteten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070103
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070103,
					"content": "Aber ... Wie soll ich das ausdrücken? Ich fühle einfach, dass ich nicht dieses perfekte Bild malen konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070104,
					"content": "Es scheint einfach etwas zu fehlen, verstehst du, was ich meine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070105,
					"content": "Es ist wie bei einem guten Essen, das gute Zutaten verwendet und sehr gut gekocht ist, aber ... aber irgendwas fehlt einfach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070106,
					"content": "Ich weiß nicht, wie ich dieses Gefühl ausdrücken soll, und ich kann es auch nicht verstehen. Ich kann nur noch weiter malen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070107
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070107,
					"content": "Keine Sorge, du kannst lachen. Echt mal, diese ganze Malerei macht mich ein bisschen benommen. Und ich hätte auch eine kleine Pause gemacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070108,
					"content": "Aber jedes Mal, wenn ich meine Augen zumache, kann ich plötzlich die leuchtenden Augen der Statuen vor mir sehen. Es ist, als ob sie lebendig geworden sind und mich direkt anstarren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070109,
					"content": "Deswegen bin ich hierher zurückgekehrt, um eine Pause zu machen. Von hier aus sollte ich die Augen der Statuen nicht sehen können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070110,
					"content": "Ah, ja. Warum nimmst du nicht dieses Bild? Es ist das beste, das mir bisher gelungen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070111,
					"content": "Also, wenn es dir nichts ausmacht, ich bin wirklich müde. Ich brauche eine Pause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070112,
					"content": "Aber trotzdem, was fehlt meinen Bildern nur ... Was fehlt ihnen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		}
	]
}