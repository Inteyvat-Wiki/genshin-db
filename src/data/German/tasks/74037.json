			"dialogs": [
				{
					"id": 740370701,
					"content": "Das wird reichen! Einen Moment, es wird gleich fertig sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370702
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370702,
					"content": "Estelle baut die Teile fieberhaft ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370703
					]
				},
				{
					"id": 740370703,
					"content": "So, das Ventil und der Auslauf und die dazugehörigen Teile sind alle fertig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370704
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370704,
					"content": "#Edel, {F#Reisende}{M#Reisender}, lasst uns nach Erinnyes aufbrechen. Mit mir wird der Brunnen bald repariert sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370705
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370705,
					"content": "#Ich zähle auf dich ... Ich nehme die hier, {F#Reisende}{M#Reisender}, lass uns aufbrechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				}
			]
		},
