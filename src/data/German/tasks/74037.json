						],
						"pointId": 340100194
					}
				]
			},
			"dialogs": [
				{
					"id": 740370501,
					"content": "Hallo, darf ich fragen, was ... Äh, Edel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370502
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370502,
					"content": "Ich bin wegen des Ventils und des Auslaufes gekommen. Wenn wir den Brunnen nicht reparieren, wird Remaudière ausflippen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370503
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370503,
					"content": "Ve... Ventil ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370504
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370504,
					"content": "Du ... warum stotterst du? Estelle ... du hast sie doch, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370505
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370505,
					"content": "Ach! Ich hatte sie schon fertig, es ist nur so ... Eine frühere Kundin musste dringend etwas reparieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370506
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370506,
					"content": "Ich ... Ich habe ihr dann ein paar allgemeine Zubehörteile gegeben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370507
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370507,
					"content": "Keine Sorge! Ich baue gerade neue und sie werden bald fertig sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370508
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370508,
					"content": "Estelle, ich hatte das schon lange Zeit im Voraus bestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370509
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370509,
					"content": "Ich weiß! Aber die Kundin hatte es eilig und meinte, sie müsse ein Abflussventil oder so etwas reparieren, also konnte ich nicht anders, als ihrem Flehen nachzugeben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370510
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370510,
					"content": "Schon in Ordnung, warte bitte ... auf den Brocken Eisen, den ich gekauft habe, dann lege ich gleich mit der Herstellung los! Er sollte bald hier sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370511
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370511,
					"content": "Wann hast du denn bestellt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370512
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370512,
					"content": "Heu... Heute Morgen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370513,
						740370514
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370513,
					"content": "Überlass das mit dem Brocken Eisen mal mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				},
				{
					"id": 740370515,
					"content": "#Wirklich? Toll! Dann zähle ich auf dich, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370516
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370516,
					"content": "Tut mir leid, tut mir leid! Es tut mir wirklich sehr leid. Nur drei Brocken Eisen, das reicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370517
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370517,
					"content": "#*seufz* Ich kann es nur dir anvertrauen, {F#Reisende}{M#Reisender}. Keine Sorge, ich werde dich bezahlen und dich nicht umsonst arbeiten lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370514,
					"content": "Lass mich ein paar Brocken Eisen holen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				}
			]
		},
