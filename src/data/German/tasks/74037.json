			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Edel"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740370301,
					"content": "Die Rohre hier müssen ausgetauscht werden ... die Ventile ... und die Reinigungsprobleme ... wirklich eine Reihe von Problemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370302
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370302,
					"content": "Hm? Was wollt ihr von mir? Es sieht auch nicht so aus, als hätte euch Estelle geschickt, um den Brunnen zu reparieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370303
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370303,
					"content": "Über Remaudière ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370304
					]
				},
				{
					"id": 740370304,
					"content": "Du meinst ihn! He ... Seine Zauberei ist wirklich gewaltig. Er hat ein Ventil im unteren Rohr dieses Brunnens ruiniert und dabei den Ausguss zerbrochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370305
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370305,
					"content": "Haha, nur ein Scherz. In der Tat hat das verformte Ventil das gesamte Wassersystem verstopft, sodass wir den ganzen Brunnen aus Sicherheitsgründen vorübergehend abschalten mussten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370306
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370306,
					"content": "Aber warum der Auslauf zerbrochen ist, ist mir nicht ganz klar ... Das ist seltsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370307
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370307,
					"content": "Remaudière hat immer wieder gesagt, dass er gescholten werden würde, wenn der Brunnen nicht repariert würde ... Aber ich konnte keine Zeit finden, um mich sofort darum zu kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370308
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370308,
					"content": "Ich hatte heute endlich etwas Zeit und habe bei Estelle ein neues Ventil und einen neuen Auslauf bestellt. Ich wollte gerade in die Stadt, um sie zu holen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370309
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370309,
					"content": "Wenn du willst, kannst du mitkommen. Es sind ziemlich viele Sachen, und ich mache mir ein bisschen Sorgen, dass ich sie nicht allein tragen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				}
			]
		},
