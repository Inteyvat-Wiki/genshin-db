				]
			},
			"dialogs": [
				{
					"id": 740370801,
					"content": "Das ist der Brunnen, lass uns anfangen, er ist schon so lange außer Betrieb, es wird Zeit, ihn wieder in Gang zu bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370802
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370802,
					"content": "Die beiden beginnen fieberhaft zu arbeiten ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370803
					]
				},
				{
					"id": 740370803,
					"content": "Das Ventil ist installiert. Ich habe auch gerade eine Gesamtkontrolle durchgeführt. Es ist alles in Ordnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370804
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370804,
					"content": "Gut, dann nehmen wir etwas Abstand, dann öffne ich die Schleuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370805
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370805,
					"content": "Mal sehen ... die Hauptschleuse ist da drüben, die Nebenschleuse muss auch betätigt werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370806
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370806,
					"content": "Wartet einen Moment, ich gehe jetzt und öffne die Schleusen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370807
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370807,
					"content": "Wer hat eigentlich dieses System entworfen, und warum sind die Schleusen so weit draußen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370808
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370808,
					"content": "Edel lief schnell zu den Schleusen und kam einige Zeit später zurück ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370809
					]
				},
				{
					"id": 740370809,
					"content": "Ach, die Schleusen sind so schwer zu öffnen, ich bin erschöpft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370810
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370810,
					"content": "Lasst uns noch ein bisschen warten, das Wasser wird bald kommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370811
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370811,
					"content": "Nach einem stumpfen Rauschen nahm der Brunnen wieder seinen normalen Betrieb auf ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370812
					]
				},
				{
					"id": 740370812,
					"content": "Es ist prima, dass der Brunnen wieder funktioniert ... Auch wenn Keratry die Sache an jenem Abend erwähnen würde, kann ich auch so tun, als wüsste ich nichts davon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370813,
						740370814
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370813,
					"content": "Mach in Zukunft nicht wieder einfach Zaubertricks!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370815
					]
				},
				{
					"id": 740370815,
					"content": "Das hat nicht einmal mit Zauberei zu tun ... Jedenfalls danke ich dir. Hier ist ein kleines Geschenk von mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370816
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370816,
					"content": "Und die Zahlung, die ich dir vorhin versprochen habe, habe ich auch dort reingelegt. Danke für deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370817
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370817,
					"content": "Und ... auch euch vielen Dank, Edel und Estelle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370818
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370818,
					"content": "Das ist doch mein Job, nichts zu danken. Und das nächste Mal bringst du deine Schwester nicht mehr so spät nachts raus ... ähem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370819
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370819,
					"content": "Bruder, wieso bist du denn auch hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370820
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370820,
					"content": "Keratry? Was machst du hier, bist du nicht ... mit Mama und Papa spazieren gegangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370821
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370821,
					"content": "Hehe ... Ich bin abgehauen, als sie nicht aufgepasst haben. Ich wollte sehen, wie es um den Brunnen steht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370822
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370822,
					"content": "Hast du den Brunnen gestern nicht mit einem Zaubertrick angehalten? Ich dachte, das wäre heute immer noch so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370823
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370823,
					"content": "Haha ... das ... haha ... Zauber hält immer nur eine bestimmte Zeit, das weißt du doch, oder? Und er ist auch nur in dieser bestimmten Zeit von Nutzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370824
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370824,
					"content": "Oh ... dann will ich den Zaubertrick nochmal sehen! Bruder, kannst du diesen Brunnen jetzt wieder stoppen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370825
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370825,
					"content": "Hm ... *hust* Keratry, es gibt jetzt hier immer noch viele Fußgänger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370826
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370826,
					"content": "Wenn ich den Brunnen jetzt stoppe, werden andere Leute, die ihn gern sehen wollen, wohl ziemlich ungehalten sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370827
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370827,
					"content": "Dann ... kommen wir später wieder! Und bringen wir Mama und Papa mit, sie möchten deinen Zaubertrick bestimmt auch sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370828
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370828,
					"content": "Ah?! Nein, hm ... Liebe kleine Schwester, diesen Brunnenzaubertrick ... beherrsche ich noch nicht ganz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370829
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370829,
					"content": "Ich glaube nicht, dass Mama und Papa einen schlecht ausgeführten, halbfertigen Zaubertrick sehen wollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370830
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370830,
					"content": "Also, Keratry, erzähl ihnen jetzt noch nichts davon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370831
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370831,
					"content": "Ich werde sie damit überraschen, sobald ich diesen Zaubertrick komplett beherrsche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370832
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370832,
					"content": "Klasse! Mama und Papa werden ihn lieben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370833
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370833,
					"content": "Ja, sie werden ihn lieben. Jetzt lass uns erstmal nach Hause gehen und ich ... ich kann dir einen neuen Zaubertrick zeigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370814,
					"content": "Zauberei und Wunder haben ihren Preis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370822
					]
				}
			]
		}
	]
}