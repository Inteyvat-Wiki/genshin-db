			"dialogs": [
				{
					"id": 740370101,
					"content": "Warum hat Edel diesen Brunnen noch nicht repariert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370102
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370102,
					"content": "Wenn er nicht repariert wird, wird Keratry alle Welt darüber in Kenntnis setzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370103
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370103,
					"content": "Ist der Brunnen kaputt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370104
					]
				},
				{
					"id": 740370104,
					"content": "Vor einiger Zeit war er noch in Ordnung, aber plötzlich gibt er kein Wasser mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370105
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370105,
					"content": "Außerdem ... er ging kaputt, als ich gerade einen Zaubertrick für Keratry vorführte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370106
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370106,
					"content": "Meine Eltern waren ins Opernhaus gegangen, also haben sie mich gebeten, zu Hause zu bleiben und Bücher zu lesen und mit meiner Schwester zu spielen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370107
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370107,
					"content": "Aber Keratry wollte hinausgehen und spielen. Ich habe mich überreden lassen und ging mit ihr hinaus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370108
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370108,
					"content": "Als wir zum Brunnen kamen, sagte Keratry plötzlich, sie wolle hier warten, bis unsere Eltern aus dem Opernhaus kommen, und dann mit ihnen zusammen nach Hause gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370109
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370109,
					"content": "Es schien keine schlechte Idee zu sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370110
					]
				},
				{
					"id": 740370110,
					"content": "Ja, ihr wart sowieso hierher gewandert. Wenn eure Eltern herausgekommen wären, hätten sie euch vielleicht sogar für ein schönes Essen ins Restaurant bringen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740370111,
					"content": "Es war aber spät in der Nacht ... Wenn meine Eltern wüssten, dass ich meine Schwester heimlich bis spät in die Nacht zum Spielen mitgenommen habe, würden sie mich ausschimpfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370112
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370112,
					"content": "Also habe ich Keratry angelogen und ihr erklärt, dass ich einen Zaubertrick kenne, mit dem man den Brunnen, der Wasser ausspuckt, zum Stillstand bringen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370113
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370113,
					"content": "Eigentlich habe ich nur das Intervall berechnet, in dem das Wasser aus dem Brunnen sprudelte, und es benutzt, um Keratry zu bespaßen und sie dazu zu bringen, nach Hause zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370114
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370114,
					"content": "Der Brunnen hörte zu dem von mir errechneten Zeitpunkt auf, zu sprudeln, und Keratry ließ sich von meiner „Zauberkunst“ täuschen und bat mich inständig, nach Hause zu gehen und ihr diesen Trick beizubringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370115
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370115,
					"content": "Ich nahm sie also mit nach Hause, spielte ein bisschen mit ihr, brachte sie ins Bett und ging in mein Zimmer. Meine Eltern kamen nach einer Weile auch nach Hause, und alles sah normal aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370116
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370116,
					"content": "Aber als ich am nächsten Tag für meinen Vater die Zeitung kaufen ging, stellte ich fest, dass der Brunnen immer noch nicht funktionierte ... Er war einfach kaputt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370117,
						740370118
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370117,
					"content": "Deine Zauberkunst ist sehr mächtig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370119
					]
				},
				{
					"id": 740370119,
					"content": "Lach mich bitte nicht aus! Wenn Keratry meinen Eltern davon erzählt, werde ich völlig erledigt sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370120
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370120,
					"content": "„Ach nein? Der Brunnen auf dem Platz ist plötzlich kaputt, Liebster, was ist denn da los?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370121
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370121,
					"content": "„Wirklich ... das ist seltsam. Der Brunnen war noch in Ordnung, als wir in jener Nacht in der Oper waren.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370122
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370122,
					"content": "„Ich weiß! Es war ein Zaubertrick meines Bruders, um den Brunnen zu stoppen! Stimmt’s, Bruder?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370123,
						740370124
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370123,
					"content": "Gut gespielt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370125
					]
				},
				{
					"id": 740370125,
					"content": "Und dann würde die Sache herauskommen, bei der ich spät nachts mit meiner Schwester ausging, und meine Eltern würden mir eine Standpauke halten, dass ich die nächsten zwei Monate nicht mehr froh würde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370126
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370126,
					"content": "Aber Paimon glaubt, es gibt einen Verwalter für diesen Brunnen, oder? Wenn er kaputt ist, warum rufst du nicht einfach jemanden an, der ihn repariert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740370127,
					"content": "Ich habe mit Edel gesprochen, der sich um den Brunnen kümmert, und er hat mir versprochen, ihn so schnell wie möglich zu reparieren, aber ... bis heute ist er nicht gekommen, um ihn zu reparieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370128
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370128,
					"content": "Ich kann es bald nicht mehr verbergen, bald wird mein Ende kommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370129,
						740370130
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370129,
					"content": "Ich frage mal für dich herum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370131
					]
				},
				{
					"id": 740370131,
					"content": "Ach, wirklich? Du bist bereit, mir zu helfen? Dann gebe ich dir auch mein ... mein ganzes gespartes Taschengeld!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370132
					],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370132,
					"content": "Edel ist da drüben, geh schnell hinüber und frag ihn danach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Remaudière"
				},
				{
					"id": 740370130,
					"content": "He, keine Sorge, ich kann dir helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370131
					]
				},
				{
					"id": 740370124,
					"content": "Sehr bildhaft und lebensecht. Vollkommen nachvollziehbar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370125
					]
				},
				{
					"id": 740370118,
					"content": "Kein Wunder, du bist wirklich ein Zauberer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370133
					]
				},
				{
					"id": 740370133,
					"content": "Während du den Brunnen beobachtest, kommt jemand anderes ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
