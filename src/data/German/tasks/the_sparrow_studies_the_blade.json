			"dialogs": [
				{
					"id": 227011001,
					"content": "Ihr beide seid also fertig mit eurem Gespräch? Sieh mich nicht so an. Wenn er nicht will, dass ich zuhöre, höre ich nicht zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227011002
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 227011002,
					"content": "Ich jedem Fall bin ich mir sicher, dass er wieder über diese Guhua säuselt. Uh, in all der Zeit, die ich in kenne, war ihm nichts wichtig, außer Guhua ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227011003
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 227011003,
					"content": "Und das trotz allem, was ich mache und versuche ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227011004
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 227011004,
					"content": "Egal, was für einen Unterschied macht es, es dir zu erzählen? Was machst du überhaupt noch hier? Solltest du ihm nicht bei etwas helfen? Na los, fort mit dir!",
					"roleType": "TALK_ROLE_NPC",
