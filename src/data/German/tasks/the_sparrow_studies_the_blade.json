			"dialogs": [
				{
					"id": 227010901,
					"content": "Que‘er und ich haben seit Kindheitstagen zusammen Kampfkünste trainiert. Sie ist wie eine Schwester für mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010902
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010902,
					"content": "Und trotzdem verblüfft sie mich mehr und mehr, je älter sie wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010903
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010903,
					"content": "Die Dinge waren viel einfacher, als wir Kinder waren ...",
