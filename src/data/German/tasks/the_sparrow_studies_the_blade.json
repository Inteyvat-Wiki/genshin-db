			"dialogs": [
				{
					"id": 227010101,
					"content": "Halt, Freund.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010102
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010102,
					"content": "Ich kann aus dem Selbstbewusstsein in deiner Haltung und der Dynamik in deinen Schritten lesen, dass wir verwandte Seelen sind, Kampfsportler ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2270102,
			"completionStepIds": [
				2270101,
				2270106
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270101",
							"2"
						],
						"stepId": 2270101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010201,
					"content": "Was willst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010202
					]
				},
				{
					"id": 227010202,
					"content": "He! Zeig ihm etwas mehr Respekt, wenn du mit ihm sprichst, verstanden!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010203
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 227010203,
					"content": "Bitte, das ist nicht nötigt ... Es war tatsächlich ich, der die Unterhaltung mit ihnen angefangen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010204,
					"content": "Hmpf. Na ja, solange es nur nicht schon wieder nichtsnutzige Mitläufer und Adeptensucher sind, die unseren Ort stehlen wollen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010205
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 227010205,
					"content": "Ja, toll, danke für deine Sorge ... Ich denke, es wird schon passen ... Mach doch ein wohlverdientes Nickerchen, während ich ein paar Worte mit unserem neuen Freund wechsle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010206
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010206,
					"content": "Aber ... es gibt sicher nichts, was du ihnen sagen würdest, vor mir aber nicht sagen kannst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010207
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 227010207,
					"content": "Ich würde dich nur langweilen, es ist wirklich nichts, woran du interessiert wärst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010208
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010208,
					"content": "Hmpf, na gut, ich habe den Hinweis verstanden. Du willst wieder über die Guhua-Schule sprechen ... In Ordnung. Wenn du nicht willst, dass ich zuhöre, werde ich dich alleine lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010209
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 227010209,
					"content": "Mein Freund. Hier drüben, wenn du zu mir kommen willst. Dann können wir uns etwas länger unterhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
