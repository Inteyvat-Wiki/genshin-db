		{
			"id": 2270104,
			"completionStepIds": [
				2270103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270103",
							"2"
						],
						"stepId": 2270103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010401,
					"content": "Genau, hier passt es gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010402,
					"content": "Um was geht es hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010403
					]
				},
				{
					"id": 227010403,
					"content": "*seuf* Es geht um sie ... Die kleine Que’er, meine Kleine. Wir waren immer unzertrennbar beim Kampfkunsttraining, wie Form und Schatten. Ihre Fähigkeiten sind den meinen keineswegs unterlegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010404
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010404,
					"content": "Wir sind hierhergekommen, um Rat von den Adepten zu erhalten, aber die Reise war mühsam und mein Begleiter war wie ein Leierkasten, der nicht anhält. Einige Tage vorher wurde sie durch die Kälte krank und hat nun Halsschmerzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010405
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010405,
					"content": "Ich sehe, dass du von großer Stärke bist. Daher ersuche ich dich demütig, zur Spitze der Klippe zu reisen, auf der du drei Qingxin-Blumen für mich finden mögest, welche in heißem Wasser ziehen sollen, um dem schmerzenden Hals von Que’er etwas Linderung zu bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010406,
						227010408
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010406,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010407
					]
				},
				{
					"id": 227010407,
					"content": "Freund, es sei dir gedankt. Que‘er ist eine lebhafte Seele und ich traue mich nicht, sie alleine zu lassen, während ich geht, um Medizin zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010408,
					"content": "Aber warum machst du es hinter ihrem Rücken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010409
					]
				},
				{
					"id": 227010409,
					"content": "Wie ich sehe, amüsiert dich das sehr. Que‘er hat einen lebhaften Geist und ist nicht bereit zu akzeptieren, dass sie im Vergleich zu den anderen um sie herum einen Nachteil hat. Ganz unabhängig von den Umständen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010410
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010410,
					"content": "Würde ich in Hörreichweite zu ihr erwähnen, Medizin für sie zu pflücken, würde sie den Vorschlag ohne nochmal darüber nachzudenken ablehnen. Daher muss ich ohne ihr Wissen handeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010411
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010411,
					"content": "Außerdem traue ich mich nicht, sie hier allein zu lassen, während ich losgehe und nach Medizin suche. Daher muss ich dich um Hilfe bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2270105,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
