					"Sun Yu",
					"Kleine Que’er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010501,
					"content": "Du bist zurückgekehrt! Was die Angelegenheit betrifft, die ich dir anvertraut habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010502
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010502,
					"content": "Ja, hier sind sie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010503
					]
				},
				{
					"id": 227010503,
					"content": "Das soll ausreichen. Freund, ich danke dir, bitte nimm dafür dieses kleine Geschenk an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010504
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010504,
					"content": "Hm? Wofür sind all diese Qingxin-Blumen gedacht? Oh nein, hast du wieder Kopfschmerzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleine Que’er"
				}
			]
		},
		{
			"id": 2270106,
			"completionStepIds": [
				2270105
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270105",
							"2"
						],
						"stepId": 2270105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu",
					"Kleine Que’er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010601,
					"content": "Ja, sie sind für seine Kopfschmerzen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010602
					]
				},
				{
					"id": 227010602,
					"content": "Aber ich wäre gerne für dich losgezogen, um Medizin zu pflücken ... Warum muss das jemand machen, der zufällig vorbeikommt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010603
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 227010603,
					"content": "Wir wissen außerdem nichts über sie oder ihren Hintergrund. Was, wenn ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010604
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 227010604,
					"content": "... Das ist genug, Que‘er. Sie haben uns geholfen, oder etwa nicht? Wir haben keinen Streit mit ihnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010605
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010605,
					"content": "Danke nochmal. Bitte nimm das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010606
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010606,
					"content": "Ja, nimm sie und geh los. Lass ihn nicht draußen im Kalten, wenn er Kopfweh hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010607
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 227010607,
					"content": "Schnell, raus aus dem Wind mit dir! Ich werde dir etwas süßen Tee zubereiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleine Que’er"
				}
			]
		},
		{
			"id": 2270107,
			"completionStepIds": [
				2270105
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270105",
							"2"
						],
						"stepId": 2270105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu",
					"Kleine Que’er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010701,
					"content": "Sie sind tatsächlich gut für den Hals.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010702
					]
				},
				{
					"id": 227010702,
					"content": "Ähm! Mein guter Freund, ich wage es zu sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010703
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010703,
					"content": "... Sagst du, ich wäre schwach? Oh, also du fühlst das kleinste bisschen Wind und nimmst an, ich hätte Halsweh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010704
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 227010704,
					"content": "Na ja, glücklicherweise gehen die Qingxin-Blumen nicht ein. Denn sie können bei seinem Kopfweh helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010705
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 227010705,
					"content": "Que’er, hör mal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010706
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010706,
					"content": "Komm schon, wir bringen dich weg vom Wind und an einen Ort, an dem du die Füße hochlegen kannst. Ich werde dir etwas süßen Tee zubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010707
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 227010707,
					"content": "Und du ... nimm diese und verschwinde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleine Que’er"
				}
			]
		},
