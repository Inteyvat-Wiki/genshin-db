				"objectNames": [
					"Puca"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740450601,
					"content": "Wir sehen uns wieder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450602
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450602,
					"content": "Wollt ihr etwas über die Erzadern wissen? Was immer es ist, fragt mich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450603
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450603,
					"content": "Obwohl Puca es nicht unbedingt weiß ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450604,
						740450607,
						740450609
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450604,
					"content": "Über wertvolle Edelsteine ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450605
					]
				},
				{
					"id": 740450605,
					"content": "Obwohl es in der nahen Erzader viele glänzende, schöne Steine gibt, sind sie noch weit davon entfernt, echte Edelsteine zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450606
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450606,
					"content": "Wenn ich auch echte Edelsteine finden könnte, wäre ich vielleicht in der Lage, meine eigene Edelsteinwerkstatt zu haben, so wie Sluasi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450607,
					"content": "Über die Verwendung des Erzes ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450608
					]
				},
				{
					"id": 740450608,
					"content": "Ähm ... Ich habe nie darüber nachgedacht ... Ich sammle einfach alle Arten von Steinen, weil ich sie schön finde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450609,
					"content": "Ich habe keine weiteren Fragen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450610
					]
				},
				{
					"id": 740450610,
					"content": "Hehe, danke, dass ihr herkommt, um Puca zu besuchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				}
			]
		}
	]
