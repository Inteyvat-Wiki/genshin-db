			},
			"dialogs": [
				{
					"id": 740450201,
					"content": "Puca, wir sind zurück! Wir haben dein „Andenken“ gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450202,
					"content": "Ihr gebt Puca das gefundene „Andenken“.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450203
					]
				},
				{
					"id": 740450203,
					"content": "Ja, das ist es, danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450204
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450204,
					"content": "Aber während wir nach dem „Andenken“ gesucht haben, haben wir auch das hier gefunden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450205,
					"content": "So einen Stein haben wir noch nie gesehen. Paimon dachte, es könnte ein wertvoller Stein sein, also hat Paimon ihn mitgebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450206,
					"content": "Paimon erinnert sich, dass du gesagt hast, dass du dort immer nach schönen Steinen suchst, also musst du so etwas schon einmal gesehen haben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450207,
					"content": "Mal sehen ... Er ist wirklich hübsch! Aber ... es ist kein wertvoller Stein, sondern nur ein gewöhnlicher normaler Stein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450208
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450208,
					"content": "Man findet solches Erz eigentlich nirgendwo anders, aber hier auf der Erzader ist er überall zu finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450209
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450209,
					"content": "Es ist also ein ganz normales Erz. Paimon dachte, es wäre eine Menge Geld wert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450210,
					"content": "Es sieht nicht so aus, als hätte es irgendeine andere Verwendung, also werfen wir es einfach irgendwo weg ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450211,
						740450212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450211,
					"content": "Aber die Leute da draußen haben es vielleicht noch nicht gesehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				},
				{
					"id": 740450213,
					"content": "Ach so, du meinst, wenn wir es draußen verkaufen, bekommen wir vielleicht einen guten Preis dafür?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450214,
					"content": "Es stimmt, dass Leute von außerhalb nicht auf die Idee kämen, im Dorf der Melusinen Bergbau zu betreiben, und wahrscheinlich haben sie diese Art von Erz auch noch nie gesehen ... Wie klug von dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450215,
					"content": "Wenn das so ist, dann lasst uns diesen Stein zum Hof von Fontaine bringen und ihn den Händlern dort zeigen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450216,
					"content": "Falls ihr mehr über das Erz wissen wollt, könnt ihr auch jederzeit zu mir kommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450217
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450217,
					"content": "Auch wenn ich keine eigene Edelsteinwerkstatt wie meine Schwester habe ... und auch nicht viel über die Bewertung und Verarbeitung weiß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450218
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450218,
					"content": "Ich sammle lieber alle Arten von interessanten Steinen als nur die teuren Edelsteine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450219
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450219,
					"content": "Ich weiß also eine Menge über die Erzadern hier in der Gegend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450220
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450220,
					"content": "Oh! Alles klar. Danke, Puca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450212,
					"content": "Aber wenn dieses Erz nur hier zu finden ist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				}
			]
		},
