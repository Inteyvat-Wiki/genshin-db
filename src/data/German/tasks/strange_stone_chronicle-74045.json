				]
			},
			"dialogs": [
				{
					"id": 740450101,
					"content": "Puca, was machst du denn schon wieder hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450102,
					"content": "Paimon glaubt nicht, dass es hier noch mehr Monster gibt, aber Paimon weiß nicht, ob es noch andere Gefahren gibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450103,
					"content": "Es wäre besser, wenn du nicht allein herumlaufen würdest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450104,
					"content": "#Paimon und {NICKNAME}, ich laufe nicht herum ... Ich bin eigentlich hier, um nach meinem „Andenken“ zu suchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450105
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450105,
					"content": "Hä? Hast du dein „Andenken“ verloren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450106,
					"content": "Ja ... Ich glaube, ich habe es an der Stelle verloren, an der ich Steine sammle ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450107
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450107,
					"content": "Hm ... Du hast es vielleicht dort versehentlich fallen lassen, als du das letzte Mal gefangen warst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450108,
					"content": "*schluchz* Ich glaube, da habe ich es verloren ... Ich war damals so verängstigt, dass ich nicht einmal daran gedacht habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450109
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450109,
					"content": "Es ist immer noch beängstigend, jetzt daran zu denken, aber das „Andenken“ ist wichtig und ich muss es zurückbekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450110
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450110,
					"content": "Hm ... Aber es wäre zu gefährlich, wenn Puca allein dorthin gehen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450111,
					"content": "#{NICKNAME}, wir gehen noch einmal an denselben Ort zurück und holen das „Andenken“ für Puca! Geh einfach nach Hause und warte auf uns, Puca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450112,
						740450113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450112,
					"content": "Überlass das uns.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				},
				{
					"id": 740450114,
					"content": "#Vielen Dank, {NICKNAME} und Paimon! Ich werde zu Hause bleiben und auf euch warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450113,
					"content": "Das ist auch eine gute Gelegenheit, diesen Ort zu erkunden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				}
			]
		},
