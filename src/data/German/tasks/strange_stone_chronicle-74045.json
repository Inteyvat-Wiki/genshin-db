						],
						"pointId": 340300142
					}
				]
			},
			"dialogs": [
				{
					"id": 740450401,
					"content": "Willkommen, wir haben das beste Angebot an Edelsteinen und Kunsthandwerk am ganzen Hof von Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450402
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450402,
					"content": "Gibt es etwas, das ihr gern anschauen möchtet? Wenn ihr hier nichts findet, was ihr sucht, beschreibt es mir einfach und ich werde mein Bestes tun, um euch zu helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450403
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450403,
					"content": "Wir haben ein seltenes Erz ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450404
					]
				},
				{
					"id": 740450404,
					"content": "Ja, da du das umfangreichste Edelsteingeschäft hast, musst du doch den Wert unseres Erzes kennen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450405,
					"content": "Oh, ihr seid also hier, um Erz zu verkaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450406
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450406,
					"content": "Dann seid ihr bei mir genau richtig, denn meine Preise sind unschlagbar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450407
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450407,
					"content": "Also, was für eine Art von Erz ist es denn ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450408
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450408,
					"content": "Du gibst Chesil das seltsame Erz, das ihr vorhin gefunden habt, zur Bewertung ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450409
					]
				},
				{
					"id": 740450409,
					"content": "Das ... Ich hätte nicht erwartet, dass es ein Erz ist, das sogar ich noch nie gesehen habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450410
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450410,
					"content": "Aber mit dieser seltsamen Farbe und der glatten Oberflächenstruktur ... Das muss ein sehr seltenes Gut sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450411
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450411,
					"content": "Es tut mir leid, ich bin mir nicht sicher, um welche Art von Erz es sich handelt. Was ist denn das bloß?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450412,
						740450414,
						740450416
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450412,
					"content": "Ich weiß es auch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450413
					]
				},
				{
					"id": 740450413,
					"content": "Seid ihr deshalb zu mir gekommen, um es zu identifizieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450419,
					"content": "Aber es ist eine Schande, dass es nur ein einziges Stück dieser Art von Erz gibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450420
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450420,
					"content": "Wenn wir genug Vorräte hätten, hätten wir Schmuckstücke herstellen können, die Fontaine im Sturm erobern würden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450421
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450421,
					"content": "(Paimon erinnert sich, dass Puca sagte, dass solche Steine überall auf der Erzader zu finden sind. Wenn wir sie also fragen ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450422,
						740450424,
						740450427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450422,
					"content": "Wir haben noch eine Menge solcher Erze.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450423
					]
				},
				{
					"id": 740450423,
					"content": "Wirklich? Das ist großartig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450430,
					"content": "In diesem Fall würde ich gerne das Erz kaufen, das ihr habt, und ich würde auch gerne mehr Erz aus euren Quellen kaufen, um eine Reihe von Kunstwerken herzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450431
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450431,
					"content": "Natürlich werde ich euch im Voraus bezahlen, solange ihr mir beim nächsten Mal mehr Erz bringen könnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450432
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450432,
					"content": "Ich denke, das ist ein faires Geschäft. Was meint ihr dazu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450433
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450433,
					"content": "Hehe, Paimon denkt auch, dass es ein gutes Geschäft ist, also abgemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450434,
					"content": "Das ist wirklich gut. Hier ist die Anzahlung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450435
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450435,
					"content": "Was für einen Schmuck kann man aus solchen Steinen machen? Haha, ich freue mich schon darauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450436
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450436,
					"content": "Ich werde also hier sein und auf eure gute Nachricht warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450424,
					"content": "Aber die Quelle ist ein Geschäftsgeheimnis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450425
					]
				},
				{
					"id": 740450425,
					"content": "Klar, natürlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450426
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450426,
					"content": "Solange es eine Bezugsquelle gibt, ist das für mich gut genug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450427,
					"content": "In „Elynas“ gibt es eigentlich reichlich davon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450428
					]
				},
				{
					"id": 740450428,
					"content": "He, warum erzählst du es ihm einfach?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450429,
					"content": "Hast du sie in „Elynas“ gefunden? Es stimmt, dass normalerweise niemand dorthin geht, um nach Erzadern zu suchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450414,
					"content": "Vielleicht heißt es „Paimonerz“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450415
					]
				},
				{
					"id": 740450415,
					"content": "He! Paimons Name gehört zu Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450416,
					"content": "Es heißt „schillerndes Kristallgold“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450417
					]
				},
				{
					"id": 740450417,
					"content": "Na, hast du dir das gerade ausgedacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450418,
					"content": "So ein besonderer Name passt gut zu seinem besonderen Aussehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "Chesil"
				}
			]
		},
