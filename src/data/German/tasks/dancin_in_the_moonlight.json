					"content": "Kümmer dich um das Licht, hier gibt es nichts, wobei ich deine Hilfe brauche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640702
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640702,
					"content": "<color=#00E1FFFF>Beleuchte die linke Seite des Gesichts und die Konturen des Rückens!</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
