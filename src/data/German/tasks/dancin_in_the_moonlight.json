					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750641504,
					"content": "Ihr habt ja auch nie darum gebeten, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641505
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641505,
					"content": "Wie sollten wir auch ... Du hast uns ja nie davon erzählt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641507,
					"content": "#Schön, euch wiederzusehen! {M#Herr}{F#Fräulein} {NICKNAME}, und natürlich Paimonchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641508
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641508,
					"content": "Haha! Ich wusste doch, dass wir uns wiedersehen würden! Perfekt, ich brauche nämlich eure Hilfe bei etwas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641509
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641509,
					"content": "An diesem Ort? Ist es etwas Schwieriges?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641510,
					"content": "Nicht allzu schwer, ihr werdet es gleich sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641511
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641511,
					"content": "Mit großer Geschicklichkeit springt Magnifico aus seinem Heißluftballon und holt seine Kamera und das Stativ aus seinem Gepäck.\\nMit flinker Hand setzt er alles auf freier Fläche zusammen und steht bald stolz vor euch.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750641506
					]
				},
				{
					"id": 750641506,
					"content": "Hehe, macht mal Platz, ich werde jetzt landen!",
					"roleType": "TALK_ROLE_NPC",
