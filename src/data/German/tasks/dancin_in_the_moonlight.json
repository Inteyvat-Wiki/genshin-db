					}
				]
			},
			"dialogs": [
				{
					"id": 750640601,
					"content": "Haha, ausgezeichnet! Bleib schön ruhig stehen, mein kleines Model ... Ja, so klug bist du! Drei, zwei, eins, bitte lächeln!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640602
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640602,
					"content": "Seht mal, was für ein Meisterwerk! Und wer hat das gemacht? Ich hab’s gemacht! Wer hat’s gemacht? Magnifico de la Magnificans, jaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640603
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640603,
					"content": "Danke, danke euch vielmals! Haha! Hier ist der Restbetrag, den ich euch noch schulde! Oh ... und auch noch das hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640604
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640604,
					"content": "Wah ... der Restbetrag!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640605,
					"content": "Hä? Nur eine Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640606,
					"content": "Sensationell ... Jetzt betritt unser wahrer Hauptdarsteller die Bühne! Nur keine Scheu, zeige dich als der Star, der du bist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640607
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640607,
					"content": "Puh ... geschafft! Hier, nehmt diese Kopie als Geschenk an ... und bedenkt, dass ihr dieses Meisterwerk erhaltet, bevor irgendeine Galerie es erhalten wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640608,
						750640610
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640608,
					"content": "Danke, wir werden es in Ehren halten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640609
					]
				},
				{
					"id": 750640609,
					"content": "Aber ... der Restbetrag ... der Restbetrag ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640613,
					"content": "Als Nächstes gehe ich zu diesem Ort ... Hier, ich markiere ihn auf deiner Karte. Hehe, vielleicht laufen wir uns ja bald wieder über den Weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640614
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640614,
					"content": "Wer weiß, vielleicht brauche ich das nächste Mal wieder eure Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640615
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640615,
					"content": "He, tu nicht so, als wäre so etwas selbstverständlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640616,
					"content": "Haha, es liegt nicht an mir, das zu entscheiden. Es war das Schicksal, ja, das Schicksal hat uns zusammengeführt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640617
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640617,
					"content": "Lebt wohl, und möge das Glück mit euch sein, Freunde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640618
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640618,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640619
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640619,
					"content": "Magnifico packt seine Sachen zusammen und springt in den Heißluftballon.\\nIhr seht, wie der Ballon erst wild hin und her schaukelt, was Magnifico herzhaft lachen lässt. Dann beruhigt er sich wieder und schwebt in die Ferne.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750640610,
					"content": "Sieht nicht so aus, als wäre es viel wert ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640611
					]
				},
				{
					"id": 750640611,
					"content": "*brüll*? *brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640612
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640612,
					"content": "Ja ... Paimon ist auch enttäuscht ... Der Restbetrag hätte doch etwas höher sein sollen als die Anzahlung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640613
					],
					"speakerTitle": "Paimon"
				}
			]
		},
