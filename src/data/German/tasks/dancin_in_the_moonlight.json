			},
			"dialogs": [
				{
					"id": 750640801,
					"content": "„Louis, Louis!“ ... Boah! Ihr habt mich fast zu Tode erschreckt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640802
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640802,
					"content": "Na, hast du es dir anders überlegt? Oder wolltest du nur Hallo sagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640803,
						750640806
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640803,
					"content": "Um Hallo zu sagen und nebenbei ein bisschen zu helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640804
					]
				},
				{
					"id": 750640804,
					"content": "*brüll*~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640805
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640805,
					"content": "Haha, hervorragend! Dann lasst uns anfangen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640806,
					"content": "Wir sind nur auf der Durchreise.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640807
					]
				},
				{
					"id": 750640807,
					"content": "Gut, dann viel Glück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				}
			]
		},
