			"dialogs": [
				{
					"id": 750641501,
					"content": "Ich hatte gerade das Gefühl, dass ich meinen Namen höre, und tatsächlich, da seid ihr! Haha, was für ein Zufall!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641502
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641502,
					"content": "Waah! Wie konnten wir nur vergessen, dass du einen Heißluftballon hast! Du lässt uns ja nie mitfliegen, du Geizhals!",
					"roleType": "TALK_ROLE_NPC",
