			"dialogs": [
				{
					"id": 750640412,
					"content": "Tada! Seht nur, ein Wunderwerk aus Licht und Schatten ... Fontaines neuester Triumph der Ingenieurskunst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640413
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640413,
					"content": "Was? Das kennen wir doch schon! Außerdem hast du uns noch gar nicht gesagt, wobei wir helfen sollen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640414,
						750640416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640414,
					"content": "Genau, rück einfach raus damit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640415
					]
				},
				{
					"id": 750640415,
					"content": "Wie es aussieht, willst du, dass wir dir beim Fotografieren helfen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640418,
					"content": "Oh ... Selbstverständlich! Hier habt ihr die Anzahlung. Nehmt sie bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640419
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640419,
					"content": "Warte. Das ist eine riesengroße Summe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640420,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640421
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640421,
					"content": "Wie ihr gesehen habt, benötige ich einige Aufnahmen von Sauriern, aber keine dieser statischen Bilder von drei Ansichten wie in Tierillustrationen ... Ich suche nach etwas, das vor Lebendigkeit sprüht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640422
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640422,
					"content": "Äh, ja, klar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640423,
					"content": "Andererseits ... „mehr Lebendigkeit“ bedeutet auch „weniger folgsam.“ Wenn es euch genehm ist, könntet ihr tapferen Abenteurer mir dabei helfen, die perfekten Bilder zu machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640424
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640424,
					"content": "Ähm, ja, sicher!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640425,
					"content": "Natürlich müsst ihr euch zu nichts zwingen, das eure Fähigkeiten übersteigt, aber ich denke schon, dass ihr mich zumindest vor Angriffen durch Lebewesen aus der Umgebung beschützen könnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640426
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640426,
					"content": "Also behaltet die Anzahlung ... Und ob ihr mir nun helft oder nicht, überlasse ich euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640427
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640427,
					"content": "Waah ... Das ist ja eine Menge Mora, die Tasche ist ganz schön schwer ... Bist du sicher, dass das alles für uns ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640428,
					"content": "Glaubt ihr, ich würde euch reinlegen? Oder soll ich die Summe nochmal nachzählen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640429
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640429,
					"content": "Haha! Da hast du die richtigen gefunden! Paimons Künste im Zähmen von Sauriern sind nämlich in ganz Natlan bekannt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640430,
					"content": "#Also keine Sorge. Solange {NICKNAME} und Paimon da sind, wird jeder Saurier, den du zähmen möchtest, gezähmt werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640431,
					"content": "Tepetlisaurier? Kinderspiel! Qucusaurier? Ein Klacks! Iktomisaurier? Lächerlich einfach ... Äh, noch Koholasaurier, Yumkasaurier, Tachankasaurier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640432,
						750640433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640432,
					"content": "Tachankasaurier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640434
					]
				},
				{
					"id": 750640434,
					"content": "... Großkopfsaurier, Kurzarmsaurier, Glubschaugensaurier, Superschrecksaurier, So-lala-Schrecksaurier, Seltsamsaurier, Normalosaurier, Dünnsaurier, Pummelsaurier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640435,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640436,
						750640437
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640436,
					"content": "Was redest du da, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640438
					]
				},
				{
					"id": 750640438,
					"content": "Und ... Brüllsaurier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640439,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640440
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640440,
					"content": "Und der Wauuusaurier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640441
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640441,
					"content": "Wauuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640442
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640442,
					"content": "Egal, welche, wir kommen mit allen klar! Vertrau uns, wir sind Großmeister im Saurierbändigen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640443,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640444,
						750640447
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640444,
					"content": "*seufz* Na gut ... wir werden dir helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640445
					]
				},
				{
					"id": 750640445,
					"content": "#Bei so einer stattlichen Anzahlung haben wir gar keine andere Wahl, als zu helfen. Stimmt’s {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640446,
					"content": "Toll! Ausgezeichnet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640447,
					"content": "Tut mir leid, ich habe schon etwas anderes zu tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640448
					]
				},
				{
					"id": 750640448,
					"content": "Aber wir haben doch schon die Anzahlung genommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640449
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640449,
					"content": "Haha, alles gut! Nehmt euch die Zeit, die ihr braucht. Es ist ja nicht so, dass ich ohne eure Hilfe völlig hilflos wäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640437,
					"content": "Hör auf, Paimon. Hörst du dir eigentlich selbst zu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640438
					]
				},
				{
					"id": 750640433,
					"content": "Jetzt mal langsam ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640434
					]
				},
				{
					"id": 750640416,
					"content": "Zahl erstmal, dann helfe ich dir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640417
					]
				},
				{
					"id": 750640417,
					"content": "Wir sind sowas von lässig, also erstmal die Mora rüberwachsen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640418
					],
					"speakerTitle": "Paimon"
				}
			]
		},
