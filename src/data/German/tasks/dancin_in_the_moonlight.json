			"dialogs": [
				{
					"id": 750641101,
					"content": "Hmm ... als Nächstes, ein Iktomisaurier im Mondschein ... Ja, das wird leicht, aber die ideale Beleuchtung zu finden, könnte etwas kniffelig werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641102
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641102,
					"content": "#Ah ... Haha! Jetzt bist du dran, {REALNAME[ID(2)|SHOWHOST(true)]}, mein kleiner Freund!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641103
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641103,
					"content": "Klein? Pfft! Er ist sogar größer als du!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641104,
					"content": "*brüll*? *brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750641105,
					"content": "Sehr gut, sehr gut ... Genau der richtige Moment ... Haha, mein Meisterwerk ist fast vollendet ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641106
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641106,
					"content": "Dann sieh zu, dass du ein gutes Bild schießt, genau wie von den Mädchen aus Fontaine! Hehe, so geht doch das Filmzitat, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641107,
					"content": "*brüll*, *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750641108,
					"content": "Haha, entspannt euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641109
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641109,
					"content": "Hach! Dieser Winkel! Einfach perfekt! Dieses Mondlicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641110
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641110,
					"content": "Wartet ... Lass mich kurz nachsehen ... Ich benötige noch zwei weitere Lichtquellen. Eine soll das Profil des Iktomisauriers betonen, um den Kontrast zwischen warmem Licht und der nächtlichen Kulisse hervorzuheben ... Nur so entsteht eine mystische Atmosphäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641111
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641111,
					"content": "Die andere Lichtquelle muss den Rücken des Iktomisauriers beleuchten ... Der Grund ist nicht kompliziert, aber es ist absolut notwendig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641112
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641112,
					"content": "Ja ... Genau so ... Haha! Perfekt! Wie in einem Traum ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641113
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641113,
					"content": "Hm? Was zum Kuckuck!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641114
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641114,
					"content": "Es tut mir leid, die Konzentration der Elemente in der Luft hier ist wohl anders als in Fontaine. Irgendwas stimmt mit der Maschine nicht ... Keine Panik, ich werde es gleich überprüfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641115
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641115,
					"content": "*summ* *summ* ... Ähm ... Hier ist es nicht ... Und da auch nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641116
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641116,
					"content": "Ach du! Mist! Zum Henker! Argh! Du verwöhnter, verzogener Nichtsnutz! Arrrgh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641117
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641117,
					"content": "Du ... Du ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641118
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641118,
					"content": "He, jetzt beruhig dich mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641119,
						750641120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641119,
					"content": "Das Ding qualmt ja schon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750641122
					]
				},
				{
					"id": 750641122,
					"content": "Puh ... Jetzt dürfte es ... wohl völlig kaputt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641123
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641123,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641124,
					"content": "He, schau mich nicht so an, wenigstens fühle ich mich jetzt besser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641125
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641125,
					"content": "*seufz* Tja, wie du siehst, ist unser künstliches Licht hinüber ... Und dabei habe ich dafür so viel Mora investiert. Eine Enttäuschung, fast wie meine Ex-Frau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641126
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641126,
					"content": "He, mach mal halblang! Keine Panik, wir helfen dir doch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641127,
					"content": "*seufz* ... Bitte entschuldigt ... Puh, was wollte ich noch gleich? Ach ja, es wird eine warme Lichtquelle benötigt, die auf die <color=#00E1FFFF>linke Profilseite des Iktomisauriers</color> gerichtet ist, sowie eine weitere, um die <color=#00E1FFFF>Kontur seines Rückens</color> zu erhellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641128
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641128,
					"content": "Kein Problem! Fangen wir an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641129,
					"content": "Und so fängt Magnifico wieder an, an seiner Kamera herumzufummeln, während es euch überlassen ist, über die geeignete Beleuchtung nachzudenken ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750641120,
					"content": "Immer mit der Ruhe! Seid ihr drauf und dran, euch scheiden zu lassen!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750641121
					]
				},
				{
					"id": 750641121,
					"content": "Was!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641122
					],
					"speakerTitle": "Paimon"
				}
			]
		},
