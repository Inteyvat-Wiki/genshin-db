			"dialogs": [
				{
					"id": 750641401,
					"content": "Moment mal ... Wieso bist du verschwunden, wenn der Iktomisaurier da ist? Und wenn du zurückkommst, ist er plötzlich weg?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641402
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641402,
					"content": "Heißt das etwa ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641403
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641403,
					"content": "#Ganz genau, {M#er}{F#sie} ist kurz zur Toilette gegangen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641404,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641405
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641405,
					"content": "Äh, überleg mal, wir können doch nicht alle gleichzeitig aufs Klo gehen! Das wäre ja mega peinlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641406,
					"content": "#Stimmt ... Haha, natürlich könnte {NICKNAME} sich niemals in einen Saurier verwandeln! Aber ehrlich gesagt, wäre es auch nicht schlecht, wenn das ginge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				}
			]
		},
