			"dialogs": [
				{
					"id": 220470301,
					"content": "Was ist los? Du schienst beim Schießen einen Fehler gemacht zu haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470302
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470302,
					"content": "Kann man die Zielscheibe erneut aufstellen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470303
					]
				},
				{
					"id": 220470303,
					"content": "Kein Problem, ich gehe und stelle sie auf und du kannst später direkt dorthin gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouji"
				}
			]
		},
