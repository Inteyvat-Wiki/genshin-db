			"dialogs": [
				{
					"id": 220470401,
					"content": "Deine Bogenschießkünste sind so hervorragend wie früher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470402
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470402,
					"content": "Hast du es klar genug gesehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470403
					]
				},
				{
					"id": 220470403,
					"content": "Ja, sowohl die Art, wie man den Bogen hält, als auch die Art, wie man ihn zieht ... Ich habe mir alles genau angesehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470404
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470404,
					"content": "Aber was soll ich sagen ... Je mehr ich deine Vorführungen sehe, desto mehr spüre ich die Kluft zwischen mir und dir ... *seufz* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470405
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470405,
					"content": "Lassen wir es erst einmal dabei. Bitte nimm dies mit und ich bedanke mich für deine Bereitschaft, mir das alles zu demonstrieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470406
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470406,
					"content": "Ich gehe später wieder zum Training und setze mein nächstes Ziel auf ... 7 von 10 Pfeilen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouji"
				}
			]
		}
	]
