			},
			"dialogs": [
				{
					"id": 220470101,
					"content": "Wieder verfehlt ... Was ist das Problem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470102
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470102,
					"content": "Du übst immer noch Bogenschießen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470103
					]
				},
				{
					"id": 220470103,
					"content": "Du bist es ... Danke für die Bogenschießvorführung beim letzten Mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470104
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470104,
					"content": "Dank dir bin ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470105,
						220470106
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470105,
					"content": "Ein Meister geworden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470107
					]
				},
				{
					"id": 220470107,
					"content": "Hm, nein, noch nicht so gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470108
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470108,
					"content": "Allerdings habe ich es jetzt geschafft, fünf der zehn Pfeile, die ich geschossen habe, ins Ziel zu bringen ... Alles dank deiner Demonstration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470109
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470109,
					"content": "Ich bin noch weit von den Anforderungen des Ausbilders entfernt, aber ich werde weiter hart arbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470110
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470110,
					"content": "Übrigens, wenn du schon mal hier bist, kannst du mir das noch einmal vorführen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470111
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470111,
					"content": "Mit deiner Demonstration werde ich auf jeden Fall schneller Fortschritte machen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470112,
						220470114
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470112,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470113
					]
				},
				{
					"id": 220470113,
					"content": "Danke, ich werde sicherlich besser werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470120
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470120,
					"content": "Ich zähle auf dich für die Demonstration und ich werde sie sicher sorgfältig studieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470114,
					"content": "Hast du alle Probleme vom letzten Mal gelöst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470115
					]
				},
				{
					"id": 220470115,
					"content": "Meinst du die ... schlechte Haltung, mangelnde Kraft, kein fester Griff am Bogen ... diese Art von Problemen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470116
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470116,
					"content": "Ich arbeite noch an denen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470117
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470117,
					"content": "Aber abgesehen von diesen Problemen ist das, was mich mehr beunruhigt ... Wenn ich in den Kampf ziehe, werde ich dann immer noch in der Lage sein, die Fähigkeiten zu nutzen, die ich gelernt habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470118
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470118,
					"content": "Ähem, aber ich muss noch an meinen Kampfkünsten arbeiten, bevor ich mir darüber Gedanken machen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470119
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470119,
					"content": "Ich zähle auf dich für die Demonstration und ich werde sie sicher sorgfältig studieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470106,
					"content": "Ein Distanzschütze geworden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470107
					]
				}
			]
		},
