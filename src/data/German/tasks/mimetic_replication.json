				"points": []
			},
			"dialogs": [
				{
					"id": 736920101,
					"content": "#Ah ... Hallo, {F#Reisende}{M#Reisender}, du bist wohl auch wegen der Akademiemesse hier, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920102
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920102,
					"content": "Wenn du Interesse hast, kannst du das von unserem Amurta-Institut vorbereitete Spiel ausprobieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920103
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920103,
					"content": "Was für ein Spiel ist das?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920104
					]
				},
				{
					"id": 736920104,
					"content": "Das Spiel heißt „Mimetische Replikation“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920105
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920105,
					"content": "In diesem Spiel werde ich dir das reguläre Verhalten einiger Tiere vorstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920106
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920106,
					"content": "Natürlich sind diese Verhaltensmuster vereinfacht und verallgemeinert worden, um sie leichter verständlich zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920107
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920107,
					"content": "Du brauchst nur die von uns vorbereiteten Modelle zu benutzen, um die Verhaltensweisen der entsprechenden Tiere nachzuahmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920108,
						736920109
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920108,
					"content": "Das hört sich einfach an ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920110
					]
				},
				{
					"id": 736920110,
					"content": "Ja. Die Formulierung „Tiere haben ein reguläres Verhalten“ ist leicht zu verstehen und zu begreifen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920111
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920111,
					"content": "Doch hinter dieser anscheinend einfachen Aussage steckt ein unergründliches Geheimnis, das es weiterhin zu erforschen gilt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920112
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920112,
					"content": "Aber lassen wir die akademische Sichtweise für den Moment beiseite und genießen wir einfach die natürlichen Verhaltensweisen der Tiere in aller Ruhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920113,
						736920115
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920113,
					"content": "Ich möchte es mal ausprobieren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920114
					]
				},
				{
					"id": 736920114,
					"content": "Gut, bitte komm hier lang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920115,
					"content": "Ich habe noch etwas zu tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920116
					]
				},
				{
					"id": 736920116,
					"content": "Kein Problem, unser Stand bleibt sowieso während der gesamten Dauer der Akademiemesse geöffnet. Also komm einfach vorbei, wenn du spielen willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920109,
					"content": "Das klingt doch nicht schwer ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920110
					]
				}
			]
		}
	]
}