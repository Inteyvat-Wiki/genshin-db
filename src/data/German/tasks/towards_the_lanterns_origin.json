			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010201,
					"content": "Endlich sind wir in <color=#00E1FFFF>Liyue</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010202,
					"content": "Du, ich muss dich mal was fragen. Für wie viel gibst du das lustige Ding, das da neben dir schwebt, ab?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010203,
						400010205
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010203,
					"content": "Sie ist nicht zu verkaufen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010204
					]
				},
				{
					"id": 400010204,
					"content": "Paimon ist nicht zu verkaufen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010209,
					"content": "Hahahaha! Ich habe leider ein paar finanzielle Schwierigkeiten und kann mir das bestimmt nicht leisten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010210
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010210,
					"content": "Ich bin auch nur ein ziemlich bescheidener Händler. Mit solchen Schätzen habe ich normalerweise nichts am Hut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010211
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010211,
					"content": "Du klingst echt merkwürdig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010212,
					"content": "Ach, sag doch sowas nicht. Willst du ein Bonbon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010213
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010213,
					"content": "#{NICKNAME}, ich finde, wir können ihm vertrauen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010214,
					"content": "Aber ihr seid doch sicher auch wegen des Laternenrituals nach Liyue unterwegs, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010215
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010215,
					"content": "Die Mingxiao-Laterne dieses Jahr ist wirklich ein Prachtexemplar. Der Plaustrit, mit dem sie fliegen soll, ist nämlich der größte seit zwanzig Jahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010216
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010216,
					"content": "Der ist so groß, dass man schon überlegt, ob die Sagen wahr sind und es wirklich eine schwebende Stadt im Himmel gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010217
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010217,
					"content": "Darunter müsste sich ein Plaustrit in ähnlicher Größe befinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010218
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010218,
					"content": "Das wäre ja voll der Wahnsinn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010219,
					"content": "Hahahaha! Ich heiße euch jedenfalls herzlich willkommen in Liyue! Ich kann zwar nicht für den <color=#00E1FFFF>Hafen</color> sprechen, aber ihr könnt jederzeit wieder in meinen Laden kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010205,
					"content": "Für kein Geld der Welt würde ich sie abgeben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010206
					]
				},
				{
					"id": 400010206,
					"content": "Du machst mich ja ganz verlegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010207,
					"content": "Wie viel würdest du denn bieten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010208,
					"content": "Das hab ich jetzt nicht gehört!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4000103,
			"completionStepIds": [
				4000103
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000103",
							"2"
						],
						"stepId": 4000103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010301,
					"content": "#{NICKNAME}, guck doch! Dieser Stein schwebt wirklich in der Luft! Die Schnur ist sogar ganz straff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010302,
					"content": "Wenn er nicht angeleint wäre, würde er wahrscheinlich immer weiter nach oben fliegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010303,
					"content": "Das ist ein Plaustrit, wie er für die Mingxiao-Laterne benutzt wird. Der ganze Laternenmarkt dreht sich nur darum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010304
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010304,
					"content": "Oh, darf ich fragen, wer du bist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010305,
					"content": "Ich bin Jiangzhou, verantwortlich für die Aufsicht über den Baufortschritt der Mingxiao-Laterne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010306
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010306,
					"content": "Man sieht euch an, dass ihr das erste Mal zum Laternenritual in Liyue seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010307
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010307,
					"content": "Genau, wie hast du das gemerkt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010308,
					"content": "#Ich kann mich nicht an {F#eine Reisende}{M#einen Reisenden} mit einem lustigen Maskottchen erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010309
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010309,
					"content": "Ihr wisst sicher nicht viel über das Fest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010310
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010310,
					"content": "Also, die Mingxiao-Laterne ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010311
					]
				},
				{
					"id": 400010311,
					"content": "Die Menschen lassen während des Festes Laternen aufsteigen. Die große aber, die von allen mit vereinten Kräften gebaut wird, heißt Mingxiao-Laterne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010312
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010312,
					"content": "Der Laternenmarkt wird einmal im Jahr von den Händlern der verschiedensten Bereiche in Liyue aufgebaut, nicht etwa um Geld zu verdienen, sondern um genügend Material für die Mingxiao-Laterne zusammenzubringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010313
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010313,
					"content": "Wenn ihr wollt, könnt ihr auch euern Teil dazu beitragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010314
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010314,
					"content": "Springt dabei etwas für uns raus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010315,
					"content": "Die Mingxiao-Laterne wird deinen guten Willen spüren. Beim ersten Vollmond im neuen Jahr, wenn wir das Alte verabschieden und das Neue begrüßen, wird sie dir einen Wunsch erfüllen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010316
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010316,
					"content": "Also nichts Handfestes, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010317,
					"content": "Hach, musst du so direkt sein? Man sollte mit den Füßen auf dem Boden bleiben, während man die Sterne bewundert, und seine Träume nicht vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010318
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010318,
					"content": "Aber wenn man dabei hilft, die Mingxiao-Laterne zu bauen, wird es dafür auf dem <color=#00E1FFFF>Laternenmarkt</color> auch eine Belohnung geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010319
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010319,
					"content": "Für die ganze Arbeit soll man ja auch etwas bekommen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010320,
					"content": "#{NICKNAME}, machen wir mit! Wir können mit den Leuten vom <color=#00E1FFFF>Laternenmarkt</color> sprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4000106,
			"completionStepIds": [
				4000106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000106",
							"2"
						],
						"stepId": 4000106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010601,
					"content": "Die Mingxiao-Laterne dieses Jahr ist dem Fürsten des ziehenden Himmels gewidmet ... Er war immer ein Angeber. Ich bin mir sicher, es wird ihm sehr gefallen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010602,
						400010611
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010602,
					"content": "Wer ist der Fürst des ziehenden Himmels?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010603
					]
				},
				{
					"id": 400010603,
					"content": "Dieses Jahr wird die Mingxiao-Laterne eine Ebenbild seiner selbst sein, wenn sie fertig ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010604
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010604,
					"content": "Na ja, das ist der Plan. Ich hoffe, sie machen das Geweih groß genug. Es war schließlich sein Stolz und seine Freude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010605
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010605,
					"content": "Die Geschichte besagt, dass das Geweih aus eben der Essenz der göttlichen Kraft von Rex Lapis gemacht wurde, wodurch es zum härtesten Material in ganz Liyue geworden ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010606
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010606,
					"content": "Aber dann geschah der schicksalhafte Kampf ... Die Götter lieferten sich einen Schlagabtausch und die Berge drohten einzustürzen. Um nicht die Dorfbewohner am Fuße des Berges zu treffen, ließ der Adept sein Geweih von seinem Freund abtrennen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010607
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010607,
					"content": "Er nutzte das blutverschmierte Geweih als Keil, um den Berg zu stützen. Und als wenn dieses Opfer nicht groß genug gewesen wäre, kämpfte er weiter, bis sein Blut erschöpft und sein Leben vorbei war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010608
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010608,
					"content": "Dank ihm steht der Tianheng-Berg noch immer stolz bis zu diesem Tage. Und das Blut, das er in der Schlacht verloren hat, ist zum Bishui-Fluss geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010609
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010609,
					"content": "Hehe ... Ob du die Geschichte glaubst oder nicht. Ich bin glücklich, dass du mir dabei zuhören willst, wie ich sie erzähle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010610
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010610,
					"content": "Sicherlich ist der Grund, warum das Laternenritual existiert, dass die Leute über die Jahre beschlossen haben, als Freunde zusammenzukommen, statt isoliert zu bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010611,
					"content": "Tschüs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010612
					]
				},
				{
					"id": 400010612,
					"content": "Bis bald! Möge sich das Feuer der Tugend ausbreiten und nie erlöschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				}
			]
		},
