			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130301,
					"content": "*seufz* Wie soll ich ohne Hammer oder Meißel arbeiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130302,
					"content": "Hast du etwa ein Problem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130303
					]
				},
				{
					"id": 722130303,
					"content": "Oh, du bist es. Na ja ... Ich war unvorsichtig. Ich habe mein Werkzeug nicht richtig geprüft, als wir hierherkamen. Und als ich gerade in meine Arbeit vertieft war, zerbrach ich versehentlich meinen Hammer und Meißel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130304
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130304,
					"content": "Ich möchte zurück zur Insel Narukami, um welche zu kaufen, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130305
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130305,
					"content": "Wie sage ich das ... Ich bin es wohl eher gewohnt, solche Arbeiten in einem Rutsch zu erledigen, weißt du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130306
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130306,
					"content": "Meine Werkzeuge mögen zwar kaputt sein, aber ich kann immer noch ein paar Messungen vornehmen und mir überlegen, wie ich weiterarbeiten möchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130307
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130307,
					"content": "Wenn ich jetzt losgehen und zur Insel Narukami reisen würde, um Werkzeug zu besorgen, müsste ich mich wohl neu mit dem „Gefühl“ dieses Werkes vertraut machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130308
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130308,
					"content": "Zudem ist die Beschaffenheit dieses Steins sehr hart. Wenn wir normale Werkzeuge verwenden, gehen sie ziemlich schnell kaputt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130309
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130309,
					"content": "Hmm, weißt du was ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130310
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130310,
					"content": "#{F#Reisende}{M#Reisender}, könntest du mir 3 Brocken Eisen bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130311
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130311,
					"content": "Ich plane, einige Werkzeuge selbst herzustellen, die der Aufgabe gewachsen sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130312,
						722130314
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130312,
					"content": "Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130313
					]
				},
				{
					"id": 722130313,
					"content": "Toll! Dann liegt es an dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130314,
					"content": "Willst du sie selbst schmieden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130315
					]
				},
				{
					"id": 722130315,
					"content": "Komm schon, ich habe in Tatarasuna gearbeitet. Ich weiß also das ein oder andere über das Schmieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130316
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130316,
					"content": "Ich sollte aber wohl nicht irgendeinen Schmelzofen im Heiligtum anwerfen. Ich kann mir vorstellen, dass die Priesterin darüber nicht erfreut wäre. Immerhin ist sie eine Katze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130317
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130317,
					"content": "Wie auch immer, bitte hilf mir, drei Brocken Eisen zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
		{
