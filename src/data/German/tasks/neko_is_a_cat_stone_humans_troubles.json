					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				}
			]
		},
		{
			"id": 7221303,
			"completionStepIds": [
				7221302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
