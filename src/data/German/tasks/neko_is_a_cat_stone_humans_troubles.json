			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"„Neko“",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130101,
					"content": "„Vergnügung“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130102
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722130102,
					"content": "Wie steht es um die Statue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130103
					]
				},
				{
					"id": 722130103,
					"content": "Dieser Steinmensch ist sehr geschickt, miau, miau, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130104
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722130104,
					"content": "Bist du schon fertig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130105
					]
				},
				{
					"id": 722130105,
					"content": "Nein, aber bevor ich es merkte, hatte er einen großen, großen Stein mitgebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130106
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722130106,
					"content": "Dann begann er darauf zu klopfen – poch, poch, poch – und murmelte dabei Dinge über eine „Schäfin“ und ihre „Vergnügung“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130107
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722130107,
					"content": "Apropos, ich möchte wissen: Was ist eine „Schäfin“ und was ist ihre „Vergnügung“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130108
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722130108,
					"content": "Ich glaube, du meinst „Chefin“ und „Vergütung“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130109
					]
				},
				{
					"id": 722130109,
					"content": "Im Grunde genommen, da du ihn gebeten hast, etwas zu tun, sollte er etwas als Gegenleistung bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130110,
					"content": "Ah, ist das so? Die Menschen sind also bei solchen Dingen sehr eigen ... Na gut. Ich werde ihm erlauben, meine Ohren zu kratzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130111
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722130111,
					"content": "Äh, Paimon findet, dass das nicht genug ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130112,
					"content": "Ist es nicht? Hmm, dann sollte ich ihm vielleicht etwas zu essen geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130113
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722130113,
					"content": "Ich glaube, was er will, sind Mora ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130114
					]
				},
				{
					"id": 722130114,
					"content": "Mora? Ist dieses Zeugs nicht dazu da, in die Spendenkästchen gesteckt zu werden? Wie merkwürdig, dass Menschen sich über solche Dinge Gedanken machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130115
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722130115,
					"content": "Na ja, eine Vergütung ist eigentlich sehr wichtig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130116
					]
				},
				{
					"id": 722130116,
					"content": "Hmpf. Ich werde deinen Worten vertrauen, weil du mir bisher geholfen hast. Ich werde mit dem Steinmenschen sprechen, wenn wir zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130117
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722130117,
					"content": "Der Steinmensch macht jedoch nicht mehr „poch, poch, poch“. Vielmehr scheint er einen kurzen Holzstab zu tragen, wer weiß, wofür ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130118
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722130118,
					"content": "Ein Holzstab? Werden Statuen nicht mit Hammer, Meißel und so weiter bearbeitet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130119,
					"content": "Sind seine Werkzeuge etwa kaputtgegangen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130120
					]
				},
				{
					"id": 722130120,
					"content": "#Oje. Los komm, {NICKNAME}, lasst uns Herrn Ooshima finden. Klingt, als bräuchte er etwas Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7221302,
