				}
			]
		},
		{
			"id": 7221305,
			"completionStepIds": [
				7221305
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221305",
							"2"
						],
						"stepId": 7221305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130501,
					"content": "Wunderbar! Das wird reichen, denke ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130502
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130502,
					"content": "Ich werde mir draußen einen geeigneten Ort suchen, um einen Schmelzofen aufzustellen, und dann fange ich an, meine Werkzeuge herzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130503
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130503,
					"content": "Sag einfach der Priesterin Bescheid, ja? Ich packe hier drüben ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
		{
			"id": 7221306,
			"completionStepIds": [
				7221304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221304",
							"2"
						],
						"stepId": 7221304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Neko“",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130601,
					"content": "Miau, miau, miau. Stimmt etwas nicht? Keine Sorge, ich werde eine passende „Vergnügung“ zaubern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130602,
						722130603
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722130602,
					"content": "Eine „VerGÜTung“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130605
					]
				},
				{
					"id": 722130605,
					"content": "Äh, vergiss es. Eigentlich ist der Steinmensch ... Herr Ooshimas Werkzeuge sind zerbrochen, aber wir haben ihm die Materialien für die Reparatur gegeben, also sollte es keine Probleme geben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130606,
					"content": "Hm? Probleme, sagst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130607,
						722130608
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722130607,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130609
					]
				},
				{
					"id": 722130609,
					"content": "Das ist gut. Ich freue mich darauf, diesen Stein zu erblicken, ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130610
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722130610,
					"content": "Hibiki meinte, dass etwas Gutes geschehen wird, sobald die Statue nach meinem Ebenbild fertig ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130611
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722130611,
					"content": "Ah, ich bin ganz aufgeregt! Was wird denn Gutes geschehen? Vielleicht kehrt Hibiki sogar zurück ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722130608,
					"content": "Nein, es gibt keinerlei Probleme. Alles läuft gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130609
					]
				},
				{
					"id": 722130603,
					"content": "Wie viel wird es denn kosten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130604
