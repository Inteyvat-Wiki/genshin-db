			},
			"dialogs": [
				{
					"id": 742230401,
					"content": "Ich hätte nicht gedacht ... dass es sich auf diese Weise lösen lässt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230402
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230402,
					"content": "Wirklich beeindruckend, hast du etwa früher in der Armee des Königs der Götter gedient?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230403
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230404
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230404,
					"content": "Auch der Tribun ist voll des Lobes für deine Leistung. Ich muss wohl mein Training intensivieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venier"
				}
			]
		},
