				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742230201,
					"content": "Einhundertsechsunddreißig ... Gut, noch vierzehn Mal und dann ist Pause!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230202
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230202,
					"content": "Brauchst du Hilfe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230203
					]
				},
				{
					"id": 742230203,
					"content": "Hilfe? Oh, nein danke. Warum sollte man beim Training die Hilfe anderer brauchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230204
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230204,
					"content": "Nur durch das Stählen meiner Physis kann ich, so wie dieser Tribun hier, der Legion Athanatoi beitreten und ein ehrenhafter Soldat werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230205
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230205,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230206
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230206,
					"content": "Ich habe euch noch nicht vorgestellt. Das hier ist mein Ausbilder. Nur durch seine Beurteilung kann ich mich für eine Beförderung qualifizieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230207,
						742230210
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230207,
					"content": "Ist das nicht eine Statue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230208
					]
				},
				{
					"id": 742230208,
					"content": "#Was redest du da, {M#Bürger}{F#Bürgerin}? Sehen nicht alle Menschen aus Remuria so aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230209
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230209,
					"content": "Nun, bist du bereit für eine Herausforderung? Wenn es dir gelingt, diese Steinsäulen gleichzeitig zu zerschmettern, hast du den ersten Teil der Prüfungen bestanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230213,
					"content": "Unterschätze nicht die Steinsäulen! Ich habe so lange trainiert und kann gerade mal mit einem Schlag eine davon zerschlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230210,
					"content": "Seine Beurteilung? Also muss man einen Test bestehen oder so?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230211
					]
				},
				{
					"id": 742230211,
					"content": "Natürlich, und zwar eine Prüfung der Kampffähigkeit. Auch wenn man durch eine Beförderung Unsterblichkeit erlangt, so muss man sich seine Kampffähigkeiten dennoch selbst antrainieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230212
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230212,
					"content": "Nun, bist du bereit für eine Herausforderung? Wenn es dir gelingt, diese Steinsäulen gleichzeitig zu zerschmettern, hast du den ersten Teil der Prüfungen bestanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "Venier"
				}
			]
		},
