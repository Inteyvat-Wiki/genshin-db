			"dialogs": [
				{
					"id": 50130801,
					"content": "Das Gebiet der Kinder der Echos ist sicher. Die Monster sind alle erledigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130802
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 50130802,
					"content": "Ich hab mich um den Geschwürstein des Abgrunds gekümmert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130803
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 50130803,
					"content": "Hier bei den Menschen der Quellen ist auch alles gut. Wir haben es geschafft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130804
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50130804,
					"content": "Die Meister des Nachtwinds sind ebenfalls sicher. Soll ich den Blumenfeder-Klan unterstützen gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130805
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 50130805,
					"content": "Die Lage sieht immer noch ziemlich düster aus da drüben. Ich bin bereits auf dem Weg dorthin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130806
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50130806,
					"content": "Nicht nötig. Ich habe mich schon darum gekümmert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130807
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 50130807,
					"content": "Jetzt schon!? Aber du warst doch gerade noch in der Arena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50130808,
					"content": "Tja, nun, du hast ja keine Ahnung, wie lange es mich schon juckt, ein paar Schädel einzuschlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130809
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 50130809,
					"content": "Oh ... na gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50130810,
					"content": "Iansan, was sollen wir mit dem Kollektiv der Fülle machen? Euer Zuhause ist weit von der Arena entfernt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130811
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50130811,
					"content": "Ach, kein Grund zur Sorge. Ich habe es gerade von Varesa gehört. Sie sagt, dass sie jetzt in Sicherheit sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130812
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50130812,
					"content": "Klingt, als seien alle Regionen gesichert. Die Kräfte des Abgrunds werden schwächer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130813
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50130813,
					"content": "Ja, genau! Ihr einziger Plan war es, uns zahlenmäßig zu überwältigen, und das wird nicht funktionieren. Und jetzt, wo wir die Ode der Auferstehung auf unserer Seite haben, wird das eh nicht mehr funktionieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50130814,
					"content": "Moment ... Der Abgrund schickt eine große Einheit in Richtung der Arena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130815
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50130815,
					"content": "Ich vermute, sie haben erkannt, dass die Ode der Auferstehung das Blatt gewendet hat. Sie werden nun versuchen, das heilige Feuer zu zerstören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130816
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50130816,
					"content": "Das werden wir nicht zulassen. Freunde, sammeln wir uns in der Arena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130817
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50130817,
					"content": "Weitere Geschwürsteine des Abgrunds sind aufgetaucht, alle in der Nähe der Arena. Wir sollten uns aufteilen und sie beseitigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130818
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 50130818,
					"content": "Oh, und wir brauchen jemanden, der den Haupteingang bewacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130819
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 50130819,
					"content": "Überlasst das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50130820
					]
				},
				{
					"id": 50130820,
					"content": "Nun gut. Dies ist die letzte Schlacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		}
	]
}