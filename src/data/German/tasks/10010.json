					"nextDialogs": [
						100100806
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100806,
					"content": "Ein kleiner Hut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100807,
					"content": "Ein Hut für Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100808
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100808,
					"content": "Im Dodo-Clan verdienen nur die coolsten und besten Dodocos im ganzen Land die Anerkennung des Dodo-Königs!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100809
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100809,
					"content": "Ihre Aufgabe ist es, allen anderen Dodocos zu helfen und sie zu beschützen, deshalb gibt ihnen der Dodo-König einen besonderen Hut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100810
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100810,
					"content": "So können die anderen Dodocos sie erkennen und wissen, an wen sie sich wenden können, wenn sie Hilfe brauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100811
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100811,
					"content": "Oh! Jetzt ist dein Dodoco also einer dieser besonderen Dodocos mit Hut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100812,
					"content": "Genau! Mit dem Hut ist Dodoco jetzt eine Dodo-Zauberin! Sie kann mit ihrer besonderen Funkenmagie noch mehr Menschen helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100813
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100813,
					"content": "Klee ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100814
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100814,
					"content": "Der Ritterorden hat mich darüber informiert, dass im Wald vor der Stadt Explosionen zu hören waren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100815
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100815,
					"content": "#Ähm, Ehrenritter{F#in}, Paimon ... Bitte helft mir doch ein wenig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100816
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100816,
					"content": "Ah, das liegt daran, dass wir dort drüben ein Hilichurl-Lager und auch einen Haufen Schleime beseitigt haben. Außerdem waren wir mit Klees Aufgabe beschäftigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100817,
					"content": "Genau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100818
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100818,
					"content": "Und was die Fische hier angeht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100819
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100819,
					"content": "Ich ... habe sie vielleicht weggesprengt. Aber das war nur, weil Monster im See waren! Ich habe das nicht mit Absicht gemacht! Das war nicht so wie die anderen Male ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100820
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100820,
					"content": "Verstehe. Dann waren die anderen Male wohl mit Absicht, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100821
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100821,
					"content": "Ähm, waren sie nicht ... nicht mit Absicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100822
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100822,
					"content": "*seufz* ... Ich habe auf dem Weg hierher das zerstörte Lager bemerkt und die Monster am Ufer des Sternfallsees entlangfliehen sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100823
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100823,
					"content": "#Gehe ich recht in der Annahme, dass das der ganze Schaden ist, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100824,
						100100826
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100824,
					"content": "Den Rest hat Paimon gemacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100825
					]
				},
				{
					"id": 100100825,
					"content": "... Ja. Du kennst ja Paimon, sie erledigt Monster mit einem einzigen Schlag! So toll ist Paimon eben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100827,
					"content": "Klee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100828
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100828,
					"content": "Komm mit mir. Lass uns zurückgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100829
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100829,
					"content": "*wimmer* ... Muss Klee schon wieder in die Arrestzelle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100830
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100830,
					"content": "#Nun, da {NICKNAME} für dich bürgt, muss deine Strafe wohl ... eine Mahlzeit beim „Hirschjäger“ sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100831
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100831,
					"content": "Du warst den ganzen Tag unterwegs. Du hast bestimmt Hunger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100832
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100832,
					"content": "Du bist die Beste, Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100833
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100833,
					"content": "Ihr beide seid natürlich auch herzlich willkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100834
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100834,
					"content": "Hehe, super! Paimon hat schon so lange Lust auf süß mariniertes Hühnchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100835
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100835,
					"content": "Jean lädt dich, Paimon und Klee zu einem Essen im „Hirschjäger“ ein ...\\nAh, und natürlich auch Dodoco, die frisch gekrönte „Dodo-Zauberin“.\\nDamit findet die Prüfung einen erfolgreichen Abschluss.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 100100826,
					"content": "Das war der ganze Schaden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100827
					]
				}
