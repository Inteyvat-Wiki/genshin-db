				},
				{
					"id": 100100803,
					"content": "Aber das bedeutet ... Wir haben die Prüfung bestanden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100804
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100804,
					"content": "Hehe, genau! Und jetzt schauen wir mal, was in dieser Kiste ist ...",
					"roleType": "TALK_ROLE_NPC",
