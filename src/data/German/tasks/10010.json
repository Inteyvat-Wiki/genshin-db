			},
			"dialogs": [
				{
					"id": 100100301,
					"content": "Was soll das ganze komische Zeug hier? Und warum gibt es so viele Hilichurle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100302,
					"content": "Hmm, vielleicht haben die Hilichurle das alles hierher gebracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100303,
					"content": "Oooh, ich wette, hier finden wir die Geheimnisse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100304
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100304,
					"content": "Fast, aber im Zettel war von „Hindernissen“ die Rede, und nicht von „Geheimnissen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100305,
					"content": "Und was auch immer wir suchen, soll hinter all den „Hindernissen“ vergraben sein ... He, gibt es hier noch andere Hinweise?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100306,
					"content": "Gibt es kein Dodoco-Gerät, das uns hier helfen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100307,
					"content": "Äh ... nein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100308
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100308,
					"content": "Was sollen wir dann tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100309,
					"content": "Hmm ... Mama sagt immer, wenn man auf ein Problem stößt, sollte man versuchen, es zu lösen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100310
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100310,
					"content": "Dann lass uns diese Hindernisse aus dem Weg räumen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100311
					]
				},
				{
					"id": 100100311,
					"content": "Ja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		},
