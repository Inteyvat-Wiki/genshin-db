			"dialogs": [
				{
					"id": 100100501,
					"content": "Also gut, die Hilichurle und die Barrieren wären damit erledigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100502,
					"content": "Und wir haben den Wald nicht in Brand gesetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100503,
					"content": "Ich war besonders vorsichtig mit der Bimm-Bamm-Bombe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100504
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100504,
					"content": "Ich werde in letzter Zeit immer seltener in die Arrestzelle geschickt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100505
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100505,
					"content": "Gut gemacht, Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100506,
					"content": "Vielleicht musst du bald gar nicht mehr hingehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100507,
					"content": "Na ja, wenn Meisterin Jean Klee nur die Arrestzelle in die Luft sprengen lassen würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100508
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100508,
					"content": "Das ist nicht wirklich das, was Paimon im Sinn hatte ... Moment mal, was ist mit dem Prozess? Haben wir etwas Neues erfahren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100509,
					"content": "Genau! Das habe ich in dem Loch gefunden, das die Bimm-Bamm-Bombe nach der Explosion hinterlassen hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100510
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100510,
					"content": "Huch, noch eine Notiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100511,
					"content": "Ja, und das ist wieder Mamas Handschrift ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100512
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100512,
					"content": "„Nun denn, Dodoco hat möglicherweise alle Hindernisse weggesprengt – wobei der direkteste Weg manchmal der eleganteste ist. Auf jeden Fall ist Dodoco zur zweiten Stufe der Prüfung gelangt ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100513,
					"content": "„Das war zufälligerweise auch die letzte Station. Selbst die energiegeladensten Kinder müssen sich schließlich ihre Kräfte einteilen. Also ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100514,
					"content": "„Dodoco ging zum Ufer eines Sees heruntergefallener Sterne, bestand die letzte Prüfung und erhielt ihre Belohnung. Aber konnte es wirklich so einfach sein ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100515,
					"content": "Hmm, „ein See heruntergefallener Sterne“ ... Das muss der Sternfallsee sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100516,
					"content": "Lass uns nachsehen, was wir finden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100517,
					"content": "Ja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100518
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100518,
					"content": "Paimon ist ja so neugierig, was das für eine Belohnung sein wird. Hoffentlich ist es irgendein toller Schatz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
