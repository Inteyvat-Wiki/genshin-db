						100100802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100802,
					"content": "Die Notiz hat angedeutet, dass es nicht so einfach sein würde. Wahrscheinlich wegen diesen Monstern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
