					"nextDialogs": [
						751200304
					],
					"speakerTitle": "Pulmari",
					"speakerSubtitle": "Trainingsexpertin der „Meister des Nachtwinds“"
				},
				{
					"id": 751200304,
					"content": "Die erforderliche Zahl ist noch nicht erreicht. Hättest du Zeit, mir zu helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751200302,
						751200303
					],
					"speakerTitle": "Pulmari",
					"speakerSubtitle": "Trainingsexpertin der „Meister des Nachtwinds“"
				},
				{
					"id": 751200302,
					"content": "Fangen wir an!",
