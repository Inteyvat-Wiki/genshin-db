				"points": []
			},
			"dialogs": [
				{
					"id": 751200101,
					"content": "Auch wenn es möglich ist, aus luftiger Höhe zu springen, bleibt die Wahl des geeigneten Landeplatzes von entscheidender Bedeutung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751200104
					],
					"speakerTitle": "Bitsin",
					"speakerSubtitle": "Trainingsexperte der „Meister des Nachtwinds“"
				},
				{
					"id": 751200104,
					"content": "#Die „Recken-Herausforderung“ ist genau dafür gedacht, egal wie hoch du bist, du musst immer auf deine Füße achten ... He du, Krieger{F#in} aus fremden Landen, willst du es mal versuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751200102,
						751200103
					],
					"speakerTitle": "Bitsin",
					"speakerSubtitle": "Trainingsexperte der „Meister des Nachtwinds“"
				},
				{
					"id": 751200102,
					"content": "Fangen wir an!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [],
					"speakerSubtitle": "Trainingsexpertin von „Kinder der Echos“"
				},
				{
					"id": 751200103,
					"content": "Gib mir einen Moment, um mich vorzubereiten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [],
					"speakerSubtitle": "Trainingsexpertin von „Kinder der Echos“"
				}
			]
		},
		{
