					"Kinne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751200201,
					"content": "#Hmm? Krieger{F#in} aus der Fremde, möchtest du die „Recken-Herausforderung“ wagen? Ich habe die Intervalle angepasst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751200204
					],
					"speakerTitle": "Kinne",
					"speakerSubtitle": "Trainingsexpertin der „Meister des Nachtwinds“"
				},
				{
					"id": 751200204,
					"content": "Was es genau mit den Intervallen auf sich hat, erfährst du, wenn du es ausprobierst. Na, wie wäre es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751200202,
						751200203
					],
					"speakerTitle": "Kinne",
					"speakerSubtitle": "Trainingsexpertin der „Meister des Nachtwinds“"
				},
				{
					"id": 751200202,
					"content": "Fangen wir an!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 751200203,
					"content": "Gib mir einen Moment, um mich vorzubereiten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
