						],
						"stepId": 2002025,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200201001,
					"content": "Du bist zurück. Wie geht es dir? Hast du es geschafft, diese Bilder zu kriegen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201002
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201002,
					"content": "Ich habe sie alle hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200201003
					]
				},
				{
					"id": 200201003,
					"content": "Oho! Wie hast du es geschafft, alles so schnell zu fotografieren? Das ist beeindruckend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201004
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201004,
					"content": "#Vielen Dank, {F#Reisende}{M#Reisender}! Nun ... hier ist mein Vorschlag ... Als Dankeschön möchte ich dir ein schönes Gericht mit eigenen Händen zubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201005
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201005,
					"content": "Wie ist das? Sieht nicht schlecht aus, also genieße es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201006
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201006,
					"content": "Ich werde zurückgehen und weiter Notizen machen. Nun ... mit diesen Pflanzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201007
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201007,
					"content": "Ich werde Jack fragen müssen, ob er weiß, wie man botanische Exemplare herstellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201008
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201008,
					"content": "Anstelle eines Exemplars wird die Cecilia in eine Vase gestellt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
