				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200200101,
					"content": "Ah, so ist das also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200102,
					"content": "Bruder, weißt du, wofür diese Pflanzen außer zum Kochen verwendet werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200103
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200103,
					"content": "Woher soll ich das wissen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200200104,
					"content": "Ich weiß nur, wo ich sie pflücken kann und ob sie essbar sind oder nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200200105,
					"content": "Keine Sorge, Bruder, ich werde nur Pflanzen sammeln und mich nicht in die Nähe der Monster begeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200106,
					"content": "Pass auf dich auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200200107,
					"content": "Ich weiß. Ich komme dann heute spät zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200108,
						200200109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200108,
					"content": "Trainierst du noch?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				},
				{
					"id": 200200110,
					"content": "#{F#Reisende}{M#Reisender}! Du kommst gerade rechtzeitig, denn ich werde gleich auf das Feld gehen, um die Pflanzen zu beobachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200111
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200111,
					"content": "Onkel Cyrus sagte mir, dass Abenteurer oft in der Wildnis schlafen und dass die Suche nach Nahrung eine wichtige Fähigkeit ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200112
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200112,
					"content": "Ich werde also zunächst die Pflanzen in der freien Natur beobachten, ihre Verbreitungsorte und Merkmale aufzeichnen und sie mir dann langsam einprägen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200113
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200113,
					"content": "Auf diese Weise weiß ich bei der Nahrungssuche in der freien Natur zumindest, welche Pflanzen ich essen kann und welche ich nicht essen sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200114,
					"content": "Aber ... es nur in Worten zu beschreiben, ist einfach nicht intuitiv genug, denke ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200115
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200115,
					"content": "#{F#Reisende}{M#Reisender}, ich habe gehört, dass du einen sogenannten „Fotoapparat“ hast, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200116,
					"content": "Kannst du mir bitte helfen, die Wachstumsbedingungen einiger Pflanzen mit diesem „Fotoapparat“ aufzuzeichnen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200117
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200117,
					"content": "Klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200118
					]
				},
				{
					"id": 200200118,
					"content": "Dann hilf mir doch bitte, den Überblick über die Wasserlilie, das Lampenkraut und die Cecilia zu behalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200119
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200119,
					"content": "Dann pflückst du diese drei Pflanzen und bringst sie zu mir, ich mache davon Exemplare und behalte sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200120
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200120,
					"content": "Dokumentarische Bilder aus dem Umfeld des Pflanzenanbaus, authentische Pflanzenexemplare und detaillierte schriftliche Beschreibungen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200121
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200121,
					"content": "Der Teil der Pflanzenkunde meines Abenteurerhandbuchs wird eine tolle Lektüre sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200122
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200122,
					"content": "#Dann zähle ich auf dich, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200123
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200123,
					"content": "Bis zu diesem Frühjahr sollte es in Quellingen reichlich Wasserlilie geben und das Lampenkraut ist in Wolfenlauf zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200124
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200124,
					"content": "Cecilia findet man natürlich an der Sterngreifklippe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200125
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200125,
					"content": "Ich muss an einen anderen Ort gehen, um die Pflanzen weiter zu beobachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200126
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200126,
					"content": "Wenn du Fotos hast, treffen wir uns in der Stadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200109,
					"content": "Wie läuft dein Training?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				}
			]
		},
		{
			"id": 2002010,
			"completionStepIds": [
				2002025,
				2002026
