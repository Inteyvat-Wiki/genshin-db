			},
			"dialogs": [
				{
					"id": 223050201,
					"content": "Im Jademysterium haben wir eine große Auswahl an unbearbeiteten Steinen. Manch einem wird schwindlig allein beim Anblick all der Kostbarkeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050202
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050202,
					"content": "Ich habe die Steine grob eingeteilt. Was für einen hättest du denn gern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
			]
		},
		{
			"id": 2230503,
			"completionStepIds": [
				2230503
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
