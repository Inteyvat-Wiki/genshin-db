					"nextDialogs": [
						223050602
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050602,
					"content": "Manche finden auch sofort einen, den sie unbedingt haben wollen. Andere wollen schon genauer hinsehen und achten auf jedes Detail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050603
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050603,
					"content": "Ich kann dir die Entscheidung natürlich nicht abnehmen. Die Steine sind hier. Du kannst sie <color=#00E1FFFF>genauer betrachten</color> oder einfach auf dein <color=#00E1FFFF>Bauchgefühl hören</color>.",
					"roleType": "TALK_ROLE_NPC",
