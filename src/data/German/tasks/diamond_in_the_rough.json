					"Shitou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050501,
					"content": "Einen für 600 Mora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050502
					]
				},
				{
					"id": 223050502,
					"content": "Ja, hoi, du traust dich was! Mit dieser Einstellung wirst du noch viel Geld machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050503
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050503,
					"content": "Komm mit mir und such dir einen von diesen hübschen hier aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050504
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050504,
					"content": "Keine Eile, all diese Steine sind von höchster Qualität. Du wirst es nicht bereuen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050505
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050505,
					"content": "Sag mir, wenn du dir einen ausgesucht hast, damit ich ihn für dich öffnen kann. Du musst dir die Hände nicht selbst dreckig machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
			]
		},
