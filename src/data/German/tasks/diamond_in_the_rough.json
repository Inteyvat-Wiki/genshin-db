			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shitou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050101,
					"content": "#Hallo, {F#meine Liebe}{M#mein Lieber}! Willst du dein Glück mit einem Stein versuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050102,
						223050104,
						223050108
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050102,
					"content": "Ich nehme einen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050103
					]
				},
				{
					"id": 223050103,
					"content": "#Ausgezeichnet! {F#Verehrte Kundin}{M#Verehrter Kunde}, dir steht das Glück heute auf die Stirn geschrieben. Du wirst sicher ein Vermögen machen, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050116
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050116,
					"content": "#Folge mir bitte, {F#verehrte Kundin}{M#verehrter Kunde}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050104,
					"content": "Was für ein Stein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050105
					]
				},
				{
					"id": 223050105,
					"content": "Natürlich spreche ich von den unverarbeiteten Steinen hier in meinem Laden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050106
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050106,
					"content": "Wenn du einen öffnest und Jade darin findest, bekommst du eine entsprechende Menge Mora von mir. Wenn du nichts findest, bekommst du dementsprechend auch nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050107
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050107,
					"content": "Du solltest es einfach einmal versuchen. Dann erklärt sich alles ganz von selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050102,
						22305108
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050108,
					"content": "Wo kommen diese Steine her?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050109
					]
				},
				{
					"id": 223050109,
					"content": "Diese wunderschönen Steinchen hier in unserem Laden stammen alle aus der Spitze der großen Kluft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050110
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050110,
					"content": "Hehe, wenn du mir nicht glaubst, kann ich dich vergewissern, dass wir im „Jademysterium“ schon seit Generationen mit aus Jade gefertigten Objekten unser Geld verdienen. Wir wissen genau, welche Steine wertvoll sind und welche nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050111
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050111,
					"content": "Diese Zeiten gehören aber der Vergangenheit an, seit der Rat für Allgemeine Angelegenheiten die Große Kluft stillgelegt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050112
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050112,
					"content": "Mit der Schließung des Standorts kommt kein neues Material mehr rein. Bei jedem Verkauf verlieren wir also auch etwas. Dabei sind diese Steine unbearbeitet wertvoller als fertige Jadegegenstände.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050113
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050113,
					"content": "Deswegen habe ich überlegt, dass ich die Steine hier im Laden auch gleich unbearbeitet verkaufen kann. Da spare ich mir nicht nur einen Arbeitsschritt. Der Kunde hat beim Öffnen des Steins auch noch das Gefühl, etwas selbst zu vollbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050114
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050114,
					"content": "Du solltest es einfach selbst einmal versuchen. Dann verstehst du, was ich meine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050115
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050115,
					"content": "Ich nehme einen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050116
					]
				}
			]
		},
		{
