					"nextDialogs": [
						223051503
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051503,
					"content": "Wie genau man auch hinsieht, von außen betrachtet sind das alles nur harmlose Steine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051504
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051504,
					"content": "Wie es drinnen aussehen könnte, vermag ich auch nur grob zu schätzen. Wie viel er wirklich wert ist, bleibt eine Überraschung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051505
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051505,
					"content": "Denn hellsehen kann ich nicht. Was passiert, wenn man den Stein zerteilt, kann keiner völlig sicher sagen. Es ist und bleibt eine Sache des Glücks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051506
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051506,
					"content": "Hat man Pech, sieht es drinnen aus wie draußen. Hat man aber Glück, findet man selbst bei einem Spaziergang einen Stein, in dem sich Nachtjade befindet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051507
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051507,
					"content": "Wenn ich mir aber eine Bemerkung erlauben darf: Ich habe das Gefühl, dass heute dein Glückstag ist, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
