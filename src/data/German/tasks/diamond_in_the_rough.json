						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shitou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050301,
					"content": "Einen für 200 Mora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050302
					]
				},
				{
					"id": 223050302,
					"content": "Du bist ja zurückhaltend! Aber gut, such dir einen aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050303
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050303,
					"content": "Da hast du aber genau hingeguckt. Tja, 200 Mora sind auch Geld.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050304
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050304,
					"content": "Wenn du dir einen ausgesucht hast, werde ich ihn für dich öffnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
			]
		},
		{
			"id": 2230504,
			"completionStepIds": [
				2230504
