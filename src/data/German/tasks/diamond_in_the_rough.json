					"nextDialogs": [
						223051002
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051002,
					"content": "Aber das macht nichts. Den Spaß war es doch wert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051003
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051003,
					"content": "Hast du nicht gesagt, die wären alle gut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223051004
					]
				},
				{
					"id": 223051004,
					"content": "Natürlich sind alle gut. Hast du schon einmal von schlechten Steinen gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051005
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051005,
					"content": "Mach dir nichts draus. Manchmal wähle auch ich den falschen aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051006
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051006,
					"content": "Ich nehm ihn fürs Erste. Wenn du weitermachen willst, machen wir weiter. Am Ende rechnen wir ab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051007
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051007,
					"content": "<color=#00E1FFFF>Dann werde ich dir geben, was dir zusteht</color>. Wenn wir einzeln abrechnen, kommen wir eher durcheinander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051008
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051008,
					"content": "Was denkst du? Willst du noch ein paar Steine haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
