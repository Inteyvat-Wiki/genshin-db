			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shitou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050401,
					"content": "Einen für 400 Mora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050402
					]
				},
				{
					"id": 223050402,
					"content": "Ah, ich sehe, du weißt, was du willst. Bei der mittleren Preisklasse kann man nicht viel falsch machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050403
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050403,
					"content": "Komm her, such dir einen von diesen Steinen hier aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050404
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050404,
					"content": "Lass dir Zeit, sie laufen nicht weg. Sag mir Bescheid, wenn du dich entschieden hast. Ich werde den Stein dann für dich öffnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
			]
		},
		{
			"id": 2230505,
			"completionStepIds": [
				2230505
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
