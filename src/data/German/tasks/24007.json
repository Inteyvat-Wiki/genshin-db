			"dialogs": [
				{
					"id": 240070301,
					"content": "Aha! Dieses Zahnrad ist vollständig. Schaut, es hat sogar noch ein ganzes Lager.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070302
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070302,
					"content": "Hervorragend, das kann man noch benutzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
