			},
			"dialogs": [
				{
					"id": 240070101,
					"content": "Lovi? Hast du etwas Tolles entdeckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070102,
					"content": "Nichts, hier gibt es gar nichts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070103
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070103,
					"content": "Was macht ihr da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070104
					]
				},
				{
					"id": 240070104,
					"content": "Wir sind gerade auf „Schatzsuche“. Hehe ... Willst du mitmachen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070105,
						240070108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070105,
					"content": "Schatzsuche?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070106
					]
				},
				{
					"id": 240070106,
					"content": "Hör nicht auf Verut, er übertreibt. Wir wollen nur ein paar brauchbare Bauteile sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070107
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070107,
					"content": "Diese Bauteile sind also Schätze. Hmm? Hier sollte etwas sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070114
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070114,
					"content": "Nun, anscheinend gibt es hier nichts, vielleicht woanders?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070115
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070115,
					"content": "Los! Gehen wir noch etwas weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070116,
						240070117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070116,
					"content": "Ich komme mit euch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070118,
					"content": "Ah, du klingst schon wie mein Bruder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070119
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070119,
					"content": "Dann lasst uns weitergehen. Ich erinnere mich, dass in dem Wasser dort ein Haufen Bauteile liegt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070117,
					"content": "Geht nirgendwo hin, wo es gefährlich ist, verstanden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070108,
					"content": "Wieso ist Aurèle nicht hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070109
					]
				},
				{
					"id": 240070109,
					"content": "Mein Bruder ist zu Herrn Delerue in die Stadt gegangen. Er sagte, er bräuchte Hilfe bei ein paar Fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070110
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070110,
					"content": "Und wir müssen brav sein und dürfen nicht herumrennen ... Also sind wir auf „Schatzsuche“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070111
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070111,
					"content": "Hehe, willst du mitmachen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070112
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070112,
					"content": "Hör nicht auf Verut, er übertreibt. Wir wollen nur ein paar brauchbare Bauteile sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070113
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070113,
					"content": "Diese Bauteile sind also Schätze. Hmm? Hier sollte etwas sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070114
