			"dialogs": [
				{
					"id": 240070501,
					"content": "Mal sehen ... Das Zahnrad geht noch. Und wenn man das Lager aufmacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070502
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070502,
					"content": "Wofür brauchst du denn das Zeug?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070503
					]
				},
				{
					"id": 240070503,
					"content": "Ich möchte eine Uhrwerk-Puppe bauen ... Eigentlich habe ich mir schon die ganze Zeit das notwendige Wissen angeeignet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070504
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070504,
					"content": "Wenn ich alles gelernt habe, baue ich einen riesigen Uhrwerk-Mecha und überrasche Papa damit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070505
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070505,
					"content": "Ich habe viele Bücher in Papas Zimmer gelesen und ein paar einfache Komponenten nach deren Anleitung gebaut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070506
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070506,
					"content": "Ich muss mich nur noch etwas mehr anstrengen, dann kriege ich den Uhrwerk-Mecha, den ich mir vorstelle, garantiert fertig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070507
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070507,
					"content": "Aber in der Stadt kann ich mich nicht mit Uhrwerken und Mechanismen beschäftigen, Papa würde es sofort rauskriegen und dann wäre es ja keine Überraschung mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070508
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070508,
					"content": "So ist dies der Geheimstützpunkt für Lovi geworden, an dem sie mit Uhrwerk-Mecha experimentieren kann. Und ich bin ihr Assistent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070509
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070509,
					"content": "Genug geredet, Assistent! Jetzt wird geforscht! Heute müssen wir einen beweglichen mechanischen Arm bauen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070510
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070510,
					"content": "Jawohl! Jetzt wird geforscht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		}
