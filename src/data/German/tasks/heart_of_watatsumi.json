					"Tsuyuko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721490301,
					"content": "Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490302
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490302,
					"content": "Fräulein Tsuyuko?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490303
					]
				},
				{
					"id": 721490303,
					"content": "Oh, Entschuldigung, ich war gerade ganz in meinen Gedanken verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490304
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490304,
					"content": "Dank deiner Hilfe halten wir nun den Schlüssel zur mondbeschienenen Tiefe in den Händen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490305
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490305,
					"content": "Der Schlüssel zur mondbefrierenden Tiefe, was bitte? Was soll das überhaupt sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490306,
					"content": "Haha, nenn ihn einfach „Schlüssel der Tiefe“. Wir bestehen ja nicht darauf, dass Fremdlinge immer den richtigen Namen für alles wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490307
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490307,
					"content": "Wir brauchen den Schlüssel, um den Zugang zu Enkanomiya zu öffnen. Er wurde aus dem vergossenen Blut unseres Omikami höchstpersönlich gegossen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490308
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490308,
					"content": "... Zumindest der Legende nach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490309
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490309,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490310,
					"content": "Mysteriös, mysteriös ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490311
					]
				},
				{
					"id": 721490311,
					"content": "Haha! Das ist ganz und gar nicht mysteriös! Ganz im Gegenteil sogar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490312
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490312,
					"content": "Na ja, jetzt müssen wir nur der göttlichen Priesterin Bericht erstatten, auf ihre Zustimmung warten und dann noch den korrekten Fluss der Geistenergie abwarten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490313
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490313,
					"content": "Und dann können wir nach Enkanomiya aufbrechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490314
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490314,
					"content": "Warte, wofür haben wir denn dann all das gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490315,
					"content": "Na ja, es ist ja nicht so, dass ihr aus dieser Reise keine Vorteile gezogen habt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490316
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490316,
					"content": "Ich meine ... Ihr habt euch die fortwährende Freundschaft des Sangonomiya-Schreins gesichert! Watatsumi wird euch zu jeder Zeit wieder mit offenen Armen empfangen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490317
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490317,
					"content": "Wie wäre es mit etwas konkreteren Informationen als diesen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490318,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490319
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490319,
					"content": "Die Aufzeichnungen besagen, dass die Geisterperlen auf die Beschwörungen von jemandem antworten, der rein ist, und dass der Schlüssel sich nur für die zusammensetzt, deren Herz so klar wie das Wasser selbst ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490320
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490320,
					"content": "Ich glaube generell nicht unbedingt an das, was solche Texte sagen, aber ich glaube daran, dass du die Situation auf Watatsumi retten kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490321
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490321,
					"content": "Na ja, wenn es dann Zeit wird nach Enkanomiya zu gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490322,
						721490323
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490322,
					"content": "Dann treffen wir uns wieder, hm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490325
					]
				},
				{
					"id": 721490325,
					"content": "Nun denn, bis bald.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490323,
					"content": "Wirst du eine weitere Weissagung durchführen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490324
					]
				},
				{
					"id": 721490324,
					"content": "Hehe, meine Trefferquote für Weissagungen ist ziemlich hoch. Ich bin sicher, dass wir uns wiedersehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490325
					],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
