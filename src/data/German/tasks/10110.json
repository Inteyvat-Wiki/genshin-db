			"dialogs": [
				{
					"id": 101100703,
					"content": "Jean! Was macht Jean hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100704,
					"content": "Ist Jean Ellins imaginärer Freund?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100705,
						101100707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100705,
					"content": "Ellin ist ein gewissenhaftes Kind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100706
					]
				},
				{
					"id": 101100706,
					"content": "Sie ist also entschlossen, ein Ritter zu werden, dass sie ... Ja, das ist irgendwie komisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100709,
					"content": "Hmm? Oh, hallo. Was macht ihr denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100710
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100710,
					"content": "Trainiert ihr immer hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100711,
					"content": "Darauf kannst du wetten. Heute habe ich Stanley von seinen Abenteuern erzählen hören. Es war unglaublich! Es hat mich richtig in Aufregung versetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100712
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100712,
					"content": "Ich hoffe, ich kann eines Tages so herausragend sein wie er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100713
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100713,
					"content": "Damit du Schulter an Schulter mit Jean kämpfen kannst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100714,
					"content": "I... Ich meine, offensichtlich will ich Ritter werden! ... Und wenn ich mit Jean selbst ein Abenteuer bestreiten muss ... Nun, umso besser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100715
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100715,
					"content": "Es scheint, als würde Ellin Jean wirklich bewundern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100716,
						101100717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100716,
					"content": "Daran ist nichts Falsches.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100718
					]
				},
				{
					"id": 101100718,
					"content": "Danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100719
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100719,
					"content": "Ich habe mir gedacht, dass ich nicht jeden Tag die Gelegenheit habe, in der Gesellschaft des Ehrenritters zu sein ... Würdest du etwas mit mir mit dem <color=#00E1FFFF>Schwert trainieren</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100717,
					"content": "Ich bin überzeugt, du schaffst das, Ellin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100718
					]
				},
				{
					"id": 101100707,
					"content": "Ellin ist wirklich entschlossen, ein Ritter zu werden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100708
					]
				},
				{
					"id": 101100708,
					"content": "Ja, sie ist so gewissenhaft ... erschreckend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100709
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1011009,
