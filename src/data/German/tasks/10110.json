				"points": []
			},
			"dialogs": [
				{
					"id": 101100404,
					"content": "Die Sache mit dem Wein ist, dass du ihn in der Taverne trinken musst, weil du sonst den halben Spaß verpasst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100405
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 101100405,
					"content": "Mir scheint, als würdest du einen Weg finden, dich zu unterhalten, selbst wenn du allein daheim trinken würdest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100406
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101100406,
					"content": "Haha, wenn ich es nicht besser wüsste, würde ich sagen, dass du dich absichtlich unzivilisiert verhältst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100407
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 101100407,
					"content": "Trink auf meinem Gelände einfach verantwortungsvoll ... in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100408
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101100408,
					"content": "Oh? Und wenn ich einen über den Durst trinke? Was passiert dann? Wirfst du mich dann zusammen mit dem Müll raus? Ist es das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100409
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 101100409,
					"content": "„Dich rauswerfen“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100410
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101100410,
					"content": "Du weißt schon ... so wie du Vaters Vermächtnis rausgeworfen hast? Du hast seine Villa verkauft, oder hast du das etwa vergessen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100411
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 101100411,
					"content": "Ich sehe keinen Grund dafür, mich an Dinge zu klammern, die keinen Zweck mehr haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100412
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101100412,
					"content": "Wirklich? Dann gehe ich davon aus, dass du dich auch ganz schnell von einer ganz bestimmten Vase getrennt hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100413
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 101100413,
					"content": "Entschuldige, ich erinnere mich nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100414
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101100414,
					"content": "Das ist seltsam, denn Meister Diluc hat definitiv eine Vase zu Hause — eine schöne, unverkennbare, in der Tat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100415
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 101100415,
					"content": "Sieht so aus, als würde sich unser Verdacht bestätigen ... Erwachsene scheinen keine eingebildeten Freunde zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100416,
					"content": "Wie gesagt – ein Mangel an kindlicher Neugier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100417,
					"content": "Anscheinend sind Erwachsene überall gleich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100418
					]
				},
				{
					"id": 101100418,
					"content": "Also hören die Leute einfach auf zu träumen, wenn sie erwachsen werden? Also Paimon will nie erwachsen werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100419,
					"content": "Also ... Dies wirft eine interessante Frage auf: In welchem Alter genau verschwinden die eingebildeten Freunde der Menschen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100420,
					"content": "Lass uns ... gehen und das überprüfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
