				"points": []
			},
			"dialogs": [
				{
					"id": 101100901,
					"content": "Puh! Danke, es ist klar, dass ich bei meinem Training noch einen langen Weg vor mir habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100902
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100902,
					"content": "So bescheiden! Ich persönlich denke, dass du schon ein ganz schöner Profi darin bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100903
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100903,
					"content": "Na ja, ich bin vom Training erschöpft, also braucht meine Fitness noch etwas Arbeit. Aber eines Tages ... Werde ich alle Trainingsholzpfähle in Mondstadt zerschlagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100904
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100904,
					"content": "Ellin, Ellin, sie ist unser Mädchen! Wenn sie es nicht kann ... ähm, Hilichurl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100905,
					"content": "Danke ... Verdammt, ich habe mich hier so lange aufgehalten, dass ich ganz vergessen habe, dass ich heute noch etwas erledigen sollte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100906
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100906,
					"content": "Hmm ... Aber ich bin so erschöpft vom Training, dass ich mich kaum bewegen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100907
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100907,
					"content": "Ehrenritter, könntest du Jack eine Nachricht überbringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100908,
						101100913
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100908,
					"content": "Wer ist Jack?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100909
					]
				},
				{
					"id": 101100909,
					"content": "Er ist ein Freund von mir. Ist vor Kurzem ein Abenteurer geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100910
					],
