			"dialogs": [
				{
					"id": 101100304,
					"content": "Auf k... keinen Fall!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100305,
					"content": "Nun. Das ... kam unerwartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100306
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100306,
					"content": "Timmies eingebildeter Freund ist ein R... Ruinenwächter!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100307,
						101100308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100307,
					"content": "Bi... Bilde ich mir Dinge ein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100309
					]
				},
				{
					"id": 101100309,
					"content": "Paimon flippt gerade aus ... Das Ding wird uns sicher angreifen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100310,
					"content": "Haha ... Was sagst du, verschieben wir unser Gespräch mit Timmie vorerst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100311,
						101100312
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100311,
					"content": "Paimon, es ist Zeit, den Spruch zu sagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100313
					]
				},
				{
					"id": 101100313,
					"content": "Huch! Paimon hat einen Lieblingsspruch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100314,
					"content": "Der eine darüber, wie wir das Gebiet vor uns später erkunden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100315
					]
				},
				{
					"id": 101100315,
					"content": "Echt? Oh, na gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100316,
					"content": "Jetzt hör doch! Die Gegend sehen wir uns am besten später an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100312,
					"content": "Den Spruch, den du so gerne sagst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100313
					]
				},
				{
					"id": 101100308,
					"content": "Was ist das denn für ein Riese?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100309
					]
				}
			]
		},
