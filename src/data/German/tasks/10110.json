			"trigger": {
				"objectNames": [
					"Nora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101100101,
					"content": "#{NICKNAME}, guck mal da drüben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100102,
					"content": "Sie ... Sie steht da so ganz allein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100103,
					"content": "Dabei spricht sie doch mit jemandem! Guck mal, sie lacht sogar! Aaah, ist das unheimlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100104,
					"content": "Als ich klein war, habe ich mir auch Freunde vorgestellt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100105
					]
				},
				{
					"id": 101100105,
					"content": "#Was? {NICKNAME}, du hast früher auch sowas gemacht?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100106,
					"content": "Hast du halluziniert? Oder meinst du echte unsichtbare Freunde, die mit dir gespielt haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100107,
						101100109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100107,
					"content": "Mit „vorgestellt“ meine ich in meiner Fantasie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100108
					]
				},
				{
					"id": 101100108,
					"content": "In deiner Fantasie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100111,
					"content": "Ach so! Du meinst eingebildete Freunde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100112,
					"content": "Und wie sieht dein eingebildeter Freund aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100113,
						101100114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100113,
					"content": "Du, das ist schon sehr lange her.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100115,
					"content": "Aha ... Eingebildete Freunde verschwinden also, wenn man groß wird?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100116,
						101100117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100116,
					"content": "Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100118,
					"content": "#Ich hätte ihn nur zu gern kennengelernt. Glaubst du, dass {F#dein Bruder}{M#deine Schwester} auch einen eingebildeten Freund hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100119,
					"content": "Klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100120
					]
				},
				{
					"id": 101100120,
					"content": "Menno! Habt ihr ein Glück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100121,
					"content": "Kennst du dieses Spiel aus Liyue? Das spielt man normalerweise mit vier Leuten, aber ihr könntet das zu zweit schaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100122,
					"content": "#{F#Reisende}{M#Reisender}! Was für ein Glück, dass ich dich hier treffe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100123
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100123,
					"content": "Straßenmusikant, du schon wieder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100124,
					"content": "Haha, ja! Lisa hat nämlich einige tolle Apparate gebastelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100125
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100125,
					"content": "Paimon kriegt Angst, wenn Lisa neue Apparate bastelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100126,
					"content": "He, sprich nicht so über die nette Dame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100127,
					"content": "Um diesen Apparat hier fertigzustellen, musste sie einige gefährliche Materialien aus Sumeru anliefern lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100128
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100128,
					"content": "Gefährlich, sagst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100129,
						101100131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100129,
					"content": "Ein Monokel mit einem Spürgerät?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100130
					]
				},
				{
					"id": 101100130,
					"content": "Genau! Sieht zwar aus wie ein gewöhnliches Monokel, ist aber ein sogenannter Nirnama-Detektor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100133,
					"content": "Lisa kann ihn leider nicht selbst verwenden. Deswegen leih ich ihn mir ein wenig zum Spaß aus und helfe ihr ihn zu testen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100134
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100134,
					"content": "Ach so? Was ist denn mit Lisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100135,
					"content": "Na ja, vielleicht fehlt ihr einfach das Kindliche? Oder es gibt einen anderen Grund.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100136
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100136,
					"content": "Wenn ihr es genau wissen wollt, könnt ihr sie ja selbst fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100137
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100137,
					"content": "#Und, Venti, kannst du ihn sehen? Sag uns, wie {F#ihr}{M#sein} eingebildeter Freund aussieht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100138,
					"content": "Also ich verrate nichts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100139
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100139,
					"content": "Wie auch immer, hier. Probier ihn mal aus. Kannst du Noras eingebildeten Freund sehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100140
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100140,
					"content": "Und? Siehst du ihn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100141,
						101100142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100141,
					"content": "Ja! Das funktioniert ja wirklich!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100143,
					"content": "Du kannst also tatsächlich damit sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100144
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100144,
					"content": "Ach Mann, Paimon will auch! ... Aber das Ding ist nicht in Paimons Größe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100145,
					"content": "#Dann eben so, {NICKNAME}! Jetzt hängt alles an dir. Sehen wir mal, wie die eingebildeten Freunde der <color=#00E1FFFF>anderen</color> aussehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100142,
					"content": "Sieht aus, als würden sie sich gut verstehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100131,
					"content": "Sieht trotzdem stinknormal aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100132
					]
				},
				{
					"id": 101100132,
					"content": "Ja, nicht wahr? Da stimm ich dir zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100117,
					"content": "Bedauerlicherweise ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100114,
					"content": "Er ist jetzt unsichtbar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100109,
					"content": "Das sind Freunde, die nicht wirklich existieren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100110
					]
				},
				{
					"id": 101100110,
					"content": "Nicht existieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1011002,
			"completionStepIds": [
				1011002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011002",
							"2"
						],
						"stepId": 1011002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101100203,
					"content": "Sieh nur, da ist hier eingebildeter Freund schon ... eine schwebende Pflanze ... eine Zauselfrucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100204,
					"content": "Eingebildete Freunde können auch Pflanzen sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100205,
					"content": "#Huhu, {F#Reisende}{M#Reisender}, Barde! Wie geht’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100206,
						101100207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100206,
					"content": "Hallo, dürfen wir dir ein paar Fragen stellen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100208
					]
				},
				{
					"id": 101100208,
					"content": "Aber sicher doch. Wie kann ich euch dienen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100209,
						101100212
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100209,
					"content": "Wer ist denn dein Freund neben dir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100210
					]
				},
				{
					"id": 101100210,
					"content": "Was? Du kannst Zausel sehen? Andere sind dazu nicht in der Lage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100211
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100211,
					"content": "Zausel ist mein bester Freund. Wir sind zusammen aufgewachsen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100216
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100216,
					"content": "(Hmpf ... Paimon bleibt nicht gern außen vor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100217,
					"content": "Flora, warum ist dein Freund eine Zauselfrucht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100218
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100218,
					"content": "Warum denn nicht? Ich finde es toll, mit einer fliegenden Pflanze befreundet zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100219
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100219,
					"content": "Fliegende Pflanze? Freund? Was soll das alles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100220,
					"content": "Mnehe, stell dir einfach vor, wie Wind aufkommt und ihr, dein Freund und du, einfach abheben könnt! Ihr könntet so weit fliegen, wie ihr wolltet. Das wäre doch großartig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100221
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100221,
					"content": "Würde der Wind euch nicht einfach davonblasen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100222,
					"content": "Tjahaha, manch einer würde das vielleicht so bezeichnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100223
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100223,
					"content": "Ich habe überhaupt erst erfahren, dass es so eine Pflanze gibt, weil mir jemand von seinen Abenteuern erzählt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100224
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100224,
					"content": "Sein Name war Stanley, wenn ich mich nicht irre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100225,
						101100226
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100225,
					"content": "Oh, dem sind wir schon einmal begegnet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100227
					]
				},
				{
					"id": 101100227,
					"content": "Stanley ist ein Abenteurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100228
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100228,
					"content": "Und du kannst an den Geschichten, die er erzählt, erkennen, dass er ein Experte darin ist! Hehehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100229
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100229,
					"content": "„Die erstaunlichen Abenteuer von Stanley” sind in Mondstadt sehr bekannt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100230
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100230,
					"content": "Er ist im Moment in der Stadt. Du solltest ihn fragen, ob er dir ein paar seiner Geschichten erzählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100231
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100231,
					"content": "Das klingt nach einer lustigen Idee für nächstes Mal! Aber im Moment haben wir noch andere Dinge zu erledigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100226,
					"content": "Niemand, den ich kenne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100227
					]
				},
				{
					"id": 101100212,
					"content": "Seid ihr ... Geschwister?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100213
					]
				},
				{
					"id": 101100213,
					"content": "Zausel und ich? Hihi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100214
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100214,
					"content": "Zausel ist mein bester Freund. Wir wohnen zusammen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100215
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100215,
					"content": "Zausel, sag den anderen hallo! Sie können dich sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100216
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100207,
					"content": "Hallo, hast du einen Augenblick für uns Zeit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100208
					]
				}
			]
		},
