			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Mona",
					"Kaedehara Kazuha",
					"Fischl",
					"Oz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400750801,
					"content": "Oh, wir sind wieder draußen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400750802,
					"content": "Mona, der Abenteurer ... Ist es wahr, dass er gestorben ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750803
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750803,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750804
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750804,
					"content": "Ich habe ihn nur einmal getroffen. Das ist jetzt schon über drei Jahre her, also ... sollte er eigentlich nicht mehr am Leben sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750805
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750805,
					"content": "Besteht nicht die Möglichkeit, dass er noch am Leben ist und du es falsch wahrgesagt hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400750806,
					"content": "Das ist doch ungerecht, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400750807
					]
				},
				{
					"id": 400750807,
					"content": "Wenn es um die negativen Dinge geht, dann lehnt man sie alle ab, und von den guten Dingen ist man überzeugt. So etwas kann man nicht als Wahrsagerei bezeichnen, sondern nur als Selbstgefälligkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750808
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750808,
					"content": "Als tägliche Unterhaltung ist das natürlich in Ordnung, aber meine Studien können keine Lügen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750809
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750809,
					"content": "Meine eigenen Schlussfolgerungen zu leugnen, hieße, die Astrologie zu verachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750810
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750810,
					"content": "Grausam, aber leider wahr. Das Schicksal ist tatsächlich so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750811
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400750811,
					"content": "Normalerweise sage ich so etwas nicht, aber jetzt, wo ich es erwähne, hoffe ich, dass ihr Astrologie nicht mit der Lotterieaktion der Straßenhändler verwechselt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750812
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750812,
					"content": "Wir studieren Astrologie nicht, um jemanden glücklich zu machen, indem wir uns den ganzen Tag Schmeicheleien anhören. Die Astrologen sind dazu da, die Wahrheit zu prüfen und die Wahrheit der Welt zu verkünden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750813
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750813,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750814
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750814,
					"content": "Ah! Deshalb finde ich, dass Astrologie ein lästiger Beruf ist! Großartigkeit und Ärger können zu gut zusammenkommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750815
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750815,
					"content": "Warum dieser plötzliche Aufruhr? Du bist nicht die Art von Mensch, die meine Freundschaft nicht wert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750816
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750816,
					"content": "Was das Fräulein meint, ist, dass es eine Freude ist, mit dir befreundet zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750817
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400750817,
					"content": "Nein, ist es nicht! Das habe ich nicht gesagt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750818
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750818,
					"content": "Oz, was ist los mit dir? Du hast immer mehr Lust, meine Worte zu verdrehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750819
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750819,
					"content": "Ups, warum ist das so? Mache ich mir zu viele Gedanken darüber, dass das Fräulein Ihre besten Freunde beleidigt und sich ständig entschuldigen muss?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750820
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400750820,
					"content": "Ich bin nicht so sachkundig und du bist die einzige Astrologin, die ich kenne. Aber du wirkst auf mich auch so gut und überhaupt nicht unausstehlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750821
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750821,
					"content": "Diejenigen, die willkürlich Leute nach Geheimnissen fragen und die Ergebnisse, die ihnen nicht gefallen, bestreiten, müssen über sich selbst nachdenken. So einfach ist das Schicksal nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750822
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750822,
					"content": "Wenn das Schicksal etwas wäre, dem man mit ein paar Worten ausweichen könnte, gäbe es keinen Abschied auf Erden. Mona, sei nicht traurig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750823
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400750823,
					"content": "Es reicht, wenn man seinem Herzen folgt und nie vergisst, was das Richtige ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750824
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400750824,
					"content": "Ähm, also ... Es gibt keinen Grund, sich so um mich zu kümmern, ich bin taff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750825
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750825,
					"content": "Warum sind deine Ohren dann rot?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400750826
					]
				},
				{
					"id": 400750826,
					"content": "Ähm, ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750827
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750827,
					"content": "... Nun, das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750828
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750828,
					"content": "Ich danke euch allen ... vielmals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750829
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750829,
					"content": "Ich kann dich nicht deutlich hören, bitte ich dich, deine Hochachtung und deinen Segen für die Prinzessin laut auszusprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750830
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750830,
					"content": "Nun, Eure Hoheit, anstatt zu kämpfen, solltet Ihr Euch zu dem neuen Ort begeben, der sich im Teich spiegelt, und die anderen Splitter bergen. Ohne die können wir nicht in die Illusion eindringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750831
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750831,
					"content": "Nur Euer scharfes Auge, mein Fräulein, kann Geheimnisse aufspüren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750832
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400750832,
					"content": "In diesem Fall, nun ja, werde ich an den Strand begeben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750833
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750833,
					"content": "Auf geht’s, Mona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750834
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750834,
					"content": "Oh, na gut! Los geht’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750835
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750835,
					"content": "... Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		}
	]
}