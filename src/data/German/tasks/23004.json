			"dialogs": [
				{
					"id": 230040701,
					"content": "Super! Das ist es! Also habe ich es wirklich im Lager gelassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040702
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040702,
					"content": "Es lag unter Steine begraben. Es gab wohl einen Erdrutsch im Lager und das Futter wurde davongetragen. Wir haben wirklich eine Weile gesucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230040703,
					"content": "Wirklich? Wie konnte dort ein Erdrutsch passieren? Da war es doch immer sicher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040704
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040704,
					"content": "Ach genau! Als ich dort zeltete, konnte ich nachts oft seltsame Geräusche hören. Und an meinem Zelt schlich oft irgendetwas vorbei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040705
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040705,
					"content": "Meine Schlängelchen waren ganz wachsam und weckten mich jedes Mal. Aber als ich nachsah, konnte ich nichts entdecken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040706
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040706,
					"content": "Aber egal, Schluss mit dem Gerede. Ich bin euch wirklich dankbar. Bitte nehmt dies als Lohn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
