			"dialogs": [
				{
					"id": 230040901,
					"content": "Super! Das ist es! Also habe ich es wirklich im Lager gelassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040902
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040902,
					"content": "Wieso ist das Lager von Ranken eingeschlossen? Hast du keine Angst, im Schlaf verletzt zu werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230040903,
					"content": "Überhaupt nicht. Ich habe früher oft in der Wildnis übernachtet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040904
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040904,
					"content": "Und als ich dieses Lager errichtet habe, gab es noch gar nicht so viele Ranken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040905
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040905,
					"content": "Ist es schon lange her, dass du den Wald verlassen hast?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230040906
					]
				},
				{
					"id": 230040906,
					"content": "Ja, das liegt schon einige Zeit zurück. Wie lange es her ist ... Daran kann ich mich nicht mehr erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040907
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040907,
					"content": "Hahaha, mittlerweile bin ich ein wenig aus der Übung, was das Aufschlagen von Lagern angeht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040908
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040908,
					"content": "Die Lager, die ich früher angelegt habe, sind heute zum größten Teil verfallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040909
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040909,
					"content": "Ich frage mich, wie mein Leben heute aussehen würde, wenn ich im Regenwald geblieben wäre ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040910
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040910,
					"content": "... Entschuldigung, ich rede zu viel. Bitte nehmt dies als Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
