				"objectNames": [
					"Gulabgir"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230042001,
					"content": "Hä? Diese Perle ... Was ... Wo habt ihr sie gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042002
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042002,
					"content": "Sie war in einem Krug im Lager. Hast du sie dort gelassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042003,
					"content": "Die habe ich früher in meinen Shows benutzt. Während ich die Flöte spielte, balancierten meine Racker sie auf dem Kopf, und dann richteten sie sich auf und tanzten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042004
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042004,
					"content": "Aber mit dem Trick habe ich damals nicht viel verdient und ich habe auch schon sehr lange nicht mehr aufgeführt. Deshalb habe ich nicht einmal gemerkt, dass die Perle fehlt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042005
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042005,
					"content": "Aber jedenfalls vielen Dank, dass ihr mir die Perle wiedergebracht habt. Bitte nehmt dies als Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
