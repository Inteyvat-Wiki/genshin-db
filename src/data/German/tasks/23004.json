			"dialogs": [
				{
					"id": 230040801,
					"content": "Super! Das ist es! Also habe ich es wirklich im Lager gelassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040802
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040802,
					"content": "In Bezug auf das Lager ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230040803
					]
				},
				{
					"id": 230040803,
					"content": "Wirklich? Könnte dies das Werk von Wildtieren gewesen sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040804
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040804,
					"content": "Da du es gerade erwähnst ... Das Futter, das ich zuvor hergestellt habe, hat Pilzbestien und Vögel angelockt ... Dass es nun einige Wildtiere anzieht, ist also nicht ungewöhnlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040805
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040805,
					"content": "Hm ... Vielleicht sollte ich mein Futter verkaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040806
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040806,
					"content": "Wenn das läuft, könnte ich mehr Geld verdienen als mit meinen Vorführungen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040807
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040807,
					"content": "Oh, ich rede zu viel, hehe. Jedenfalls danke ich euch. Bitte nehmt dies als Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
