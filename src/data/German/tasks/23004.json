				{
					"id": 230041206,
					"content": "Aber seit sie einige Kinder auf Futtersuche erschreckt haben, möchte ich sie nicht mehr allein rauslassen. Jetzt bereite ich das Futter für sie vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041207
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041207,
					"content": "*seufz* ... Seitdem ich sie füttere, sind sie so träge geworden. Und fressen wollen sie auch nichts anderes mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041208
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041208,
					"content": "Ooh ... kostenloses Essen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041209,
						230041210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041209,
					"content": "Lecker!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041211
					]
				},
				{
					"id": 230041211,
					"content": "Wir kennen den Geschmack noch nicht. Schau nicht so gierig, du kriegst nichts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041212,
					"content": "Das Essen kriegt Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041213,
					"content": "Eine klare Ansage ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041214
					]
				},
				{
					"id": 230041214,
					"content": "Ich musste das Futter in einem meiner Lager gelassen haben, als ich Kräuter sammeln gegangen bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041215
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041215,
					"content": "Aber ich kann nicht danach suchen gehen, ich muss auf meine kleinen Racker aufpassen, damit sie nicht ausbüxen und Leute erschrecken, wenn sie großen Hunger bekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041216
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041216,
					"content": "#{F#Reisende}{M#Reisender}, könntest du bitte zum Lager gehen und das Futter holen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041217,
						230041220,
						230041222
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041217,
					"content": "Überlass es mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041218
					]
				},
				{
					"id": 230041218,
					"content": "Herzlichen Dank. Ich fürchte, etwas Unerwartetes könnte passieren, wenn ich selbst mit diesen Rackern suchen gehen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041219
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041219,
					"content": "Nicht auszudenken, wenn sie neugierig würden und für Tage im Wald verschwänden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041225
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041225,
					"content": "#Wie auch immer, danke für die Hilfe, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041226
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041226,
					"content": "Ich habe das Lager auf der Karte markiert, wo ich mich kürzlich aufgehalten habe. Schau bitte mal vorbei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041220,
					"content": "Aber dort gibt es doch keine anderen Schlangen ... oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041221
					]
				},
				{
					"id": 230041221,
					"content": "Auf keinen Fall! Ich passe immer auf, dass sich in der Nähe meiner Lager keine Schlangennester befinden, um Ärger zu vermeiden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041225
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041222,
					"content": "Hast du viele Lager?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041223
					]
				},
				{
					"id": 230041223,
					"content": "Als ich damals noch im Regenwald gelebt habe, habe ich mehrere Lager angelegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041224
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041224,
					"content": "Heute lebe ich zwar nicht mehr länger im Regenwald ... Aber ich nutze die Lager immer noch zum Rasten, wenn ich im Wald auf die Kräutersuche gehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041225
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041210,
					"content": "Sehr gut!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041211
					]
				},
				{
					"id": 230041203,
					"content": "Changsheng würde es nicht gefallen, so bezeichnet zu werden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041204
					]
				}
			]
		},
