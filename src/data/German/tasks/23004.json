			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gulabgir"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230042201,
					"content": "Oh? Die Mützchen ... Haha, ich habe sie damals für meine Schlängelchen gemacht. Wie konnte ich sie auch vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042202
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042202,
					"content": "Ich habe für jede Schlange eine Schlafmütze gemacht, um die Kinder anzulocken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042203
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042203,
					"content": "Rot für Jori, grün für Amum, gelb für Gana und blau für Drak ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042204
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042204,
					"content": "Das klingt ja niedlich. Das muss eine tolle Show sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042205,
					"content": "Am Anfang lief alles gut, aber sobald die Schlangen ihre Mäuler aufmachen, fangen die Kinder an, zu heulen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042206
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042206,
					"content": "Aber genug geredet. Bitte nehmt dies als Belohnung. Es kommt von Herzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
