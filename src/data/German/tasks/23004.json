					"Gulabgir"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230042401,
					"content": "Ach! Ist das etwa das Klettergerüst, das ich für die Schlangen gemacht habe? Das habe ich wirklich vermisst, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042402
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042402,
					"content": "Was ist denn ein Klettergerüst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042403,
					"content": "Ein Spielzeug, auf dem die Schlängelchen herumkriechen und -klettern können. Sie können ja nicht ständig auf mir herumturnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042404
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042404,
					"content": "Ich danke euch, dass ihr es mir wiedergebracht habt. Bitte nehmt diese Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042405
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042405,
					"content": "Ist das mein Entwurf? Das weckt Erinnerungen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		}
	]
