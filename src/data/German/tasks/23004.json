			"dialogs": [
				{
					"id": 230040501,
					"content": "Super! Das ist es! Also habe ich es wirklich im Lager gelassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040502
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040502,
					"content": "Als wir dort waren, bedienten sich auch einige Pilzbestien daran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230040503,
					"content": "#Pilzbestien ... Puh, ich bin froh, dass ich nicht selbst gegangen bin. Vielen Dank, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040504
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040504,
					"content": "Ich bin euch sehr dankbar. Bitte nehmt dies als Lohn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040505
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040505,
					"content": "Lasst es euch schmecken, meine Schlängelchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
