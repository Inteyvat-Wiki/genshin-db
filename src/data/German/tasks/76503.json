			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flins"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765030101,
					"content": "#Oh? {NICKNAME} und Paimon? Ich hätte nicht erwartet, euch an einem so abgelegenen Ort wiederzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030102,
					"content": "Seid ihr einer Spur gefolgt oder habt ihr euch zufällig hierher verirrt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030103,
						765030104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030103,
					"content": "Wir erkunden einfach nur die Umgebung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030105
					]
				},
				{
					"id": 765030105,
					"content": "So ist das also. Vom Deck dieses Schiffswracks aus kann man die gewaltige Silhouette des Versuchs- und Konstruktionsbüros zu Kuuvahki sehen. Es sieht aus wie eine schlummernde Bestie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030106,
					"content": "Ja, allein der Anblick aus der Ferne ist schon sehr einschüchternd. Wer weiß, wie viele Geheimnisse darin verborgen sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765030107,
					"content": "Hm, es kann euch bei eurer Suche nach ganz besonderen Motiven jede Menge Inspiration bieten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030108,
					"content": "Schließlich entstehen an der Grenze zwischen Licht und Dunkelheit oft die faszinierendsten Geschichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030109
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030109,
					"content": "Hehe, Flins, du hast da immer diese blaue Laterne an deiner Seite. Da steckt doch sicher eine gute Geschichte dahinter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765030110,
					"content": "Übrigens, musst du heute nicht an ... äh ... jenem Ort Wache halten? Bist du im Urlaub? Oder auf Patrouille?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765030111,
					"content": "Man könnte sagen, dass beides zutrifft. Es ist die ewige Pflicht von uns „Ratniki“ nach Unheil Ausschau zu halten, das aus den Schatten kriechen könnte. Egal, wo wir uns auch befinden, dürfen wir in unserer Wachsamkeit nicht nachlässig werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030112
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030112,
					"content": "Momentan geht es hier jedoch recht friedlich zu. Ihr solltet euch also keine allzu großen Sorgen machen und könnt beruhigt eurem kreativen Schaffen nachgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030113,
						765030114
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030113,
					"content": "Das ist eine seltene Gelegenheit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030115
					]
				},
				{
					"id": 765030115,
					"content": "Ihr wollt mich fotografieren? Das überrascht mich ein wenig. Ehrlich gesagt bin ich es nicht gewohnt, vor der Kamera zu stehen und zum Objekt der Begutachtung zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030116
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030116,
					"content": "Das könnt ihr sicher verstehen. Ich bin es eher gewohnt, mit stummen Grabsteinen als Nachbarn und dem Flüstern der Verstorbenen als Begleitung zu leben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030117
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030117,
					"content": "Doch eine so aufrichtige Bitte von Freunden abzulehnen, wäre unhöflich, und es wäre ungebührlich, Gäste so zu behandeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030118
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030118,
					"content": "Bitte, fühlt euch frei, die Momente festzuhalten, die ihr für bewahrenswert haltet. Ich freue mich, eurem künstlerischen Schaffen eine kleine, unbedeutende Inspiration hinzufügen zu können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030114,
					"content": "Darf ich ein Foto von dir machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030115
					]
				},
				{
					"id": 765030104,
					"content": "Wir suchen einfach nur nach Motiven für unsere Aufnahmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030105
					]
				}
			]
		},
