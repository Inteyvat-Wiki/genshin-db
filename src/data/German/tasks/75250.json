			"dialogs": [
				{
					"id": 752500101,
					"content": "Die Besucher, die Puppen gekauft haben, gehen einer nach dem anderen. In diesem Moment betreten einige ungebetene Gäste den Alpaka-Park ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500102
					]
				},
				{
					"id": 752500102,
					"content": "Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500103
					]
				},
				{
					"id": 752500103,
					"content": "Die Räuber-Fatui von gestern? Ihr seid es! Was ... Was wollt ihr hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500104
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500104,
					"content": "Keine Sorge, ich bin hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752500105
					]
				},
				{
					"id": 752500105,
					"content": "Nein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500106
					]
				},
				{
					"id": 752500106,
					"content": "Der Anführer der Fatua winkt und holt einen Zettel heraus. Du klappst ihn auf und siehst eine krakelige Nachricht:",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500107
					]
				},
				{
					"id": 752500112,
					"content": "„Der Griff gestern in die Tasche war also, um Geld hineinzulegen ...?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500113
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500113,
					"content": "Oh nein, es tut mir so leid ... ich habe euch völlig falsch eingeschätzt ... Entschuldigt bitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500114
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500114,
					"content": "Nehmt die Plüschtiere ruhig alle mit, bitte! Das ist mein Dank für euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500115
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500115,
					"content": "Der Anführer der Fatui schüttelt den Kopf und zeigt mit den Fingern nur eine „Drei“.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500116
					]
				},
				{
					"id": 752500116,
					"content": "Ich verstehe ... Ihr seid genauso beeindruckende Krieger wie die Helden von Natlan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500117
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500117,
					"content": "Dann suche ich euch die drei Plüschtiere aus, die farblich am besten zu euch passen. Danke euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aloha"
				}
			]
		},
