			"dialogs": [
				{
					"id": 761680101,
					"content": "Tja ... ohne duftendes Brot habe ich einfach keine Energie für die Patrouille ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680102
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680102,
					"content": "Was machst du denn hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761680103
					]
				},
				{
					"id": 761680103,
					"content": "Ich bereite gerade die Vorräte für die Patrouille vor, aber es sieht so aus, als wäre mein Lieblingsgericht Fungus-Fantasie nicht mehr auf Lager.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680104
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680104,
					"content": "Das ist ein neues Brot, das Fräulein Beryna kürzlich gebacken hat. Alle mögen es so sehr, dass es in unserem Lager einfach nicht lange auf Vorrat bleibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680105
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680105,
					"content": "Ach, wenn ich daran denke, dass ich keine Fungus-Fantasie mehr essen kann, verliere ich sofort jede Motivation ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680106
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680106,
					"content": "Ich glaube, ich weiß, wie man das zubereitet ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761680107
					]
				},
				{
					"id": 761680107,
					"content": "Im Ernst? Das ist ja super, mein Freund!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680108
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680108,
					"content": "Wenn das so ist, könntest du mir ein paar Portionen Fungus-Fantasie machen? Keine Sorge, ich lasse dich nicht umsonst arbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lantainen"
				}
			]
		},
