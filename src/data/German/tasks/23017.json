			"dialogs": [
				{
					"id": 230170301,
					"content": "Hmm ... Diese Abzeichen sollten für meine Experimente ausreichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170302,
					"content": "Hier ist deine Bezahlung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170303,
					"content": "#{F#Reisende}{M#Reisender}, was soll dieser Blick? Du jagst mir Angst ein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170304
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170304,
					"content": "*hust!* Ich mache mich an die Arbeit, ich mache mich sofort an die Arbeit ...",
					"roleType": "TALK_ROLE_NPC",
