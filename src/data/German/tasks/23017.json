						],
						"stepId": 2301701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230170101,
					"content": "#Rei... {F#Reisende}{M#Reisender}! Du kommst gerade rechtzeitig! Ich gehe nach meiner Kaffeepause mit Kaia zurück an die Arbeit. Darf ich vorstellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170102,
					"content": "Das ist also die Person, von der du gesprochen hast? Es ist mir ein Vergnügen. Ich bin Kaia, eine ... ähm ... Tänzerin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170104
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170104,
					"content": "Hallo, Garcia hat dich vorher schon einmal erwähnt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230170105
					]
				},
				{
					"id": 230170105,
					"content": "Hehe, wirklich? Das macht mich sehr fröhlich. Ich dachte, er hätte nichts anderes als seine Maschine und Lutong im Sinn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170106
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170106,
					"content": "Du kannst mich aus der Gleichung nehmen, Fräulein. Ich bin mir sicher, Herr Garcia wird das gutheißen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170107,
					"content": "Auf keinen Fall! Ohne dich wird Garcia seinen letzten Cent ausgeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170108
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170108,
					"content": "Dem kann ich nicht zustimmen, Fräulein. Ich bin mir sicher, dass Herr Garcia jederzeit für zwei Kaffees aufkommen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170109
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170109,
					"content": "Drei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170110,
					"content": "Deine Großzügigkeit erstaunt mich immer wieder, Herr Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170111,
					"content": "#Zu... Zurück zum Thema! {F#Reisende}{M#Reisender}, ich suche immer noch nach den Abzeichen, die die Schatzräuber bei sich tragen. Falls du welche findest, kannst du sie mir verkaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170112
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170112,
					"content": "Ich habe ... in letzter Zeit etwas Geld verdient. Du musst dir um deine Bezahlung keine Sorgen machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
		{
