				"objectNames": [
					"Kaia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230175001,
					"content": "Hallo? Ähm ... wie kann ich helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175002
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175002,
					"content": "Woher kennst du Garcia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230175003
					]
				},
				{
					"id": 230175003,
					"content": "Ganz schön direkt! Typisch für Abenteurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175004
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175004,
					"content": "Ich habe Garcia kennengelernt ... als er vom Leiter meiner Theatergruppe zur Buchhaltung angestellt wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175005
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175005,
					"content": "Hahaha, um ehrlich zu sein, habe ich noch nie jemanden gesehen, der so wenig zu unserer Theatergruppe passt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175006
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175006,
					"content": "Wir haben Musik gespielt, getanzt, getrunken und gesungen, aber er und Lutong brüteten still über ihre Buchführung in der Ecke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175007
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175007,
					"content": "Einmal habe ich ihn in sehr merkwürdiger Kleidung gesehen, die scheinbar mit irgendwelchen Mustern versehen worden war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175008
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175008,
					"content": "Ich war neugierig und fragte ihn nach der Aufzeichnung. Er meinte, sie sei ein Schema für seine Maschine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175009
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175009,
					"content": "Er hatte weder Papier noch Stift zur Hand, als er sich mit jemandem über seine Maschine unterhielt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175010
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175010,
					"content": "Also zeichnete er das Schema mit einem Stück Kohle auf seiner Kleidung zur Erklärung auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175011
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175011,
					"content": "Danach unterhielten wir uns öfter über seine schmutzige Kleidung und seine Maschine ... Natürlich sprach er die meiste Zeit, ich habe nur zugehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175012
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175012,
					"content": "Hehe, er ist ein merkwürdiger Kauz, aber gleichzeitig ... ein richtiger Charmeur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaia"
				}
			]
		},
