			"dialogs": [
				{
					"id": 220170201,
					"content": "#{F#Reisende}{M#Reisender}, könntest du ein paar Romane für mich besorgen? Shigeru und ich müssen eine wichtige Diskussion führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170202
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170202,
					"content": "Hmpf. Wenn ich ihn schreiben lasse, wie es ihm gefällt, wird er die Romane mit Sicherheit ruinieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shigeru"
				}
			]
		},
		{
			"id": 2201703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
