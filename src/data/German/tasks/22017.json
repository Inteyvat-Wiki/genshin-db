			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Junkichi",
					"Shigeru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170101,
					"content": "Ich bin fertig! Es ist mir egal, wie sehr du bettelst! Ich höre auf, ein Schriftsteller zu sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170102
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170102,
					"content": "Archonten ... das ist das siebte Mal, dass du mir mit einem Streik gedroht hast ... und nicht ein einziges Mal war es eine ernsthafte Drohung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170103
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170103,
					"content": "Worüber streitet ihr euch dieses Mal ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170104
					]
				},
				{
					"id": 220170104,
					"content": "#Endlich bist du da, {F#Reisende}{M#Reisender}! Du musst mir helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170105
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170105,
					"content": "Seitdem du dich das letzte Mal auf seine Seite gestellt hast, geht er über Bord. Er hat Dutzende von Regeln für mich aufgestellt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170106
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170106,
					"content": "Von der Namensgebung bis zum Plotdesign. Er will ein Set von ... Schreibstandards machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170107
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170107,
					"content": "Wie soll ich denn so schreiben!? Warum schreibt er es dann nicht einfach!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170108
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170108,
					"content": "Dies sind Prinzipien des Schreibens, die ich aus erfolgreichen Romanen extrahiert habe. Es sind bewährte und wahre Richtlinien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170109
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170109,
					"content": "Das bedeutet, dass ich die Formel anderer Romane auf meine Arbeit übertrage. Schreibe ich meinen eigenen Roman, oder kopiere ich den von jemand anderem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170110
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170110,
					"content": "Ich würde nie so starr schreiben ... Wenn du so etwas willst, solltest du es selbst schreiben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170111
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170111,
					"content": "Außerdem, gibt es nicht schon eine Menge dieser Romane, die im Verlagshaus Yae verrotten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170112
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170112,
					"content": "Das ist nur schlechte Vermarktung, nicht der Roman selbst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170113
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170113,
					"content": "Das hatte nichts mit der Verkaufsstrategie zu tun. Es liegt rein an der Art und Weise, wie diese Autoren ihre Romane geschrieben haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170114,
					"content": "Du kennst sie vielleicht nicht alle, aber ich, als Autor, habe jedes Buch gelesen, das vom Verlagshaus Yae veröffentlicht wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170115
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170115,
					"content": "#{F#Reisende}{M#Reisender}, könntest du ein paar Romane für mich besorgen? Shigeru und ich müssen eine wichtige Diskussion führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170116,
						220170117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170116,
					"content": "Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220170117,
					"content": "Welche Romane sollte ich mitbringen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170118
					]
				},
				{
					"id": 220170118,
					"content": "Bring mir einfach die Romane, die ich herumliegen habe. Ich benutze sie oft als Warnung für mich selbst ... was ich nicht schreiben sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
