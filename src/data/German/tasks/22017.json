				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170301,
					"content": "#{F#Reisende}{M#Reisender}, hast du die Romane mitgebracht? Lass uns einen Blick darauf werfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
			"id": 2201704,
			"completionStepIds": [
				2201706
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201706",
							"2"
						],
						"stepId": 2201706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170401,
					"content": "Ich erinnere mich an dieses Buch. Dieser Spannungsroman war lange Zeit sehr beliebt, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170402
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170402,
					"content": "Der Grund für seinen Erfolg liegt in den cleveren Rätseln und der Handlungsstruktur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170403
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170403,
					"content": "Obwohl viele Leser gesagt haben, dass ein Teil der Handlung nicht nachvollziehbar ist, hat sich der Autor dennoch an seine eigenen Prinzipien gehalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170404
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170404,
					"content": "Das ist der Grund, warum sich dieser Roman von anderen Spannungsromanen abhebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170405
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170405,
					"content": "Aber hat dieser Roman nicht auch eine solide Basis? Ein solider Schauplatz, der nicht so leicht verändert werden kann, ist der Schlüssel, um die Handlung dieser Art von Spannungsroman zu unterstützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170406
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170406,
					"content": "#Äh ... na ja ... {F#Reisende}{M#Reisender}, gibt es noch andere Bücher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
			"id": 2201705,
			"completionStepIds": [
				2201705
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201705",
							"2"
						],
						"stepId": 2201705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170501,
					"content": "Dieses hier also! Ich erinnere mich, dass es hervorragend geschrieben war und die Handlung gut durchdacht war. Es wurde von den Redakteuren hoch gelobt. Auch die Verkaufszahlen waren sehr gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170502
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170502,
					"content": "wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170503
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170503,
					"content": "Es war so sehr in der starren Handlung und den starren Hintergründen gefangen, dass es keinen Platz für eine Erweiterung der Geschichte hatte. Am Ende wurde es für die Leser nur noch repetitiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170504
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170504,
					"content": "Er verlor nach und nach Leser, weil es ihm an frischen Geschichten fehlte. Am Ende verlor er all seine Leser und verpuffte kläglich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170505
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170505,
					"content": "Ob es nun die Hintergründe oder die Handlung sind, wenn du dich einengen lässt, werden alle deine Geschichten gleich aussehen. Du wirst stagnieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170506
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170506,
					"content": "Ich will nicht, dass mein Roman so ist! Das Wichtigste, was eine Geschichte haben sollte, ist Leben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170507
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170507,
					"content": "Wenn ... Wenn der Autor selbst nicht an seiner eigenen Geschichte interessiert ist, wie kann er dann den Leser die gleiche Leidenschaft spüren lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170508
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170508,
					"content": "Shigeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170509
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170509,
					"content": "Ich verstehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170510
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170510,
					"content": "Ich wusste nicht, dass du so viel über diese Dinge nachdenkst. Kein Wunder, dass du einen Roman wie „Onibudou“ geschrieben hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170511
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170511,
					"content": "Ich möchte deine Kreativität nicht einschränken, aber ich habe schon zu viele Autoren gesehen, die ihre Arbeit wegen ihrer übertriebenen Fantasie ruiniert haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170512
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170512,
					"content": "Junkichi, was hältst du von Kreativität als Schriftsteller?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170513
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170513,
					"content": "Ich glaube, dass es der Wunsch ist, etwas zu erschaffen. Ein Autor, der kein Verlangen hat, etwas zu erschaffen, wird nicht in der Lage sein, Worte zu schreiben, die Leser anziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170514
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170514,
					"content": "Meiner Meinung nach ist es für einen Schriftsteller noch wichtiger, sich beim Ausdrücken dieses kreativen Wunsches zurückzuhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170515,
						220170516
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170515,
					"content": "Ihr zwei könnt immer noch keinen Konsens finden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170517
					]
				},
				{
					"id": 220170517,
					"content": "Shigeru, ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170518
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170518,
					"content": "Aber ich bin nicht der Autor dieses Romans. Du bist es. Ich bin nur ein Redakteur, der dir helfen muss, ihn zu beenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170519
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170519,
					"content": "Wenn du auf deine Ideen bestehst, dann gestalte sie so, wie du willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170520
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170520,
					"content": "Ich kann nicht sagen, dass ich dir zustimme. Aber ich werde versuchen, dich zu verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170521
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170521,
					"content": "Ah ... danke, Shigeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170522
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170522,
					"content": "Gern geschehen. Natürlich verstehe ich, woher du kommst. Aber du musst auch meine Position verstehen. Zum Beispiel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170523
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170523,
					"content": "Was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170524
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170524,
					"content": "Zum Beispiel, es ist schon wieder ein Tag vergangen. Wo ist dein Manuskript!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170516,
					"content": "Ich denke, er ist nicht überzeugt ...",
