			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830101,
					"content": "Es muss einfach so sein, weil es ein schlechter Tag ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830102
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830102,
					"content": "W... Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830103
					]
				},
				{
					"id": 722830103,
					"content": "Die Ergebnisse meines Schießtrainings werden von Tag zu Tag schlechter und bei diesem Tempo werde ich diesen Pfeil eines Tages in mein Knie stecken können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830104
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830104,
					"content": "Warum übst du das Bogenschießen an einem Ort wie diesem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830105
					]
				},
				{
					"id": 722830105,
					"content": "Das war auf Anraten der Jibashiri, obwohl ich mich jetzt frage, ob sie eine Vorliebe dafür haben, Menschen leiden zu sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830106
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830106,
					"content": "Weißt du übrigens etwas über die Unagizucht? Ich glaube nicht, dass das Bogenschießen eine große Zukunft hat. Warum also nicht etwas anderes ausprobieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830107
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830107,
					"content": "Hat die Unagizucht etwas mit Bogenschießen zu tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830108
					]
				},
				{
					"id": 722830108,
					"content": "Ups, das tut mir leid, aber du scheinst nichts über die Unagizucht zu wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830109
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830109,
					"content": "Das erste, was du tun musst, um einen Unagi zu bekommen, ist, die Jungfische zu fangen, aber sie sind so klein, dass es schwer ist, sie mit dem bloßen Auge zu unterscheiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830110
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830110,
					"content": "Ich dachte, da Bogenschützen Ziele auf große Entfernungen treffen können, muss ihr Sehvermögen sehr gut sein. Also ging ich zu einem vertrauten Jibashiri und fragte ihn, was ich tun sollte, um meine Sehkraft zu verbessern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830111
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830111,
					"content": "„Akashi, nur wenn du ein solides Fundament hast, kannst du die nächste Stufe erreichen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830112
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830112,
					"content": "„Du musst natürlich mit einem stationären Ziel beginnen, denn es hat keinen Sinn, sich ihm zu sehr zu nähern.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830113
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830113,
					"content": "Ich habe auf ihn gehört und hier Bogenschießen geübt, aber bis jetzt habe ich es nicht ein einziges Mal geschafft. Kann man ein Ziel wirklich aus so großer Entfernung treffen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830114
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830114,
					"content": "Übrigens: Willst du es versuchen? Stell dich einfach auf die Platte vor dir, dann siehst du das Ziel, und wenn du alle triffst, bist du erfolgreich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830115
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830115,
					"content": "Gut, schau mir zu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830116
					]
				},
				{
					"id": 722830116,
					"content": "Dann lass mich sehen, was du tun kannst! Vergiss nicht, zu mir zu kommen, wenn du es geschafft hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akashi"
				}
			]
		},
		{
			"id": 7228302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228302",
							"2"
						],
						"stepId": 7228302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830201,
					"content": "Du hast das Ziel auch verfehlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830202
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830202,
					"content": "Es scheint, als ob das Glück uns heute wirklich nicht hold ist. Es muss etwas Schlimmes sein, das dich beeinträchtigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830203,
					"content": "Warum versuchen wir es nicht noch ein paar Mal? Das Ziel wird sowieso nicht wegschwimmen wie ein Unagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "Akashi"
				}
			]
		},
		{
			"id": 7228303,
			"completionStepIds": [
				7228303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228303",
							"2"
						],
						"stepId": 7228303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830301,
					"content": "Du hast es geschafft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830302
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830302,
					"content": "Aber ich sehe, dass du einen guten Schuss hast, also schätze ich, dass du ein alter Hase bist. Ein halb ausgebildeter Bogenschütze wie ich kann auch nach ein paar Jahren Training nicht so gut sein wie du.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830303
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830303,
					"content": "Und ich habe schon seit Ewigkeiten keinen lebenden Unagi mehr gesehen, weil ich jeden Tag in diesem Höllenloch Bogenschießen übe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830304
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830304,
					"content": "Übrigens, magst du auch Unagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830305,
						722830306
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830305,
					"content": "Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				},
				{
					"id": 722830307,
					"content": "Ist das so? Weil ich Unagi so sehr liebe, wollte ich selbst versuchen, sie zu züchten. Findest du nicht auch, dass sie süß aussehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830308
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830308,
					"content": "Natürlich ist ein Unagi auf einem Essteller noch schöner. So schön anzuschauen und so lecker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830309
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830309,
					"content": "Aber ist es nicht zu viel verlangt, Unagi zu züchten, weil man sie mag, und Bogenschießen zu üben, um sie zu züchten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830310
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830310,
					"content": "Am Ende bevorzuge ich die freien Unagi, also vergiss die Zucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830311
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830311,
					"content": "Übrigens, vielen Dank für deine Hilfe bei der Demonstration! Die hier gehören dir. Viel Glück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830306,
					"content": "Nicht wirklich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				}
			]
		}
	]
}