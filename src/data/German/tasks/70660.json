			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gygax"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706600201,
					"content": "Hallo, hast du Lust, Windflucht einmal auszuprobieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600202,
						706600217
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600202,
					"content": "Was ist Windflucht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600203
					]
				},
				{
					"id": 706600203,
					"content": "Gut, dass du fragst. Windflucht ist ein Spiel rund um die Geschichte von Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600204
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600204,
					"content": "Du hast sicher schon von den Aristokraten gehört, die in Mondstadt lebten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600205
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600205,
					"content": "Sie waren absolute Wilde. Worte können dem nicht gerecht werden, wie die Menschen durch ihre Hand gelitten haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600206
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600206,
					"content": "Um sich gegen ihre Tyrannei zu wehren, schloss sich eine Gruppe mutiger Bürger zusammen und gründete eine geheime Widerstandsorganisation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600207
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600207,
					"content": "Diese tapferen Kämpfer für die Gerechtigkeit wurden in der ganzen Stadt aktiv. Sie wurden den Aristokraten ein großer Dorn im Auge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600208
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600208,
					"content": "Aber die Aristokraten schlugen zurück, indem sie schnell ihre eigene Gruppe von Handlangern ausbildeten, um die Rebellen zu unterdrücken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600209
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600209,
					"content": "Und so lieferten sich die Rebellen ein Duell nach dem anderen mit den Schergen der Aristokraten, überall in der Stadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600210
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600210,
					"content": "Windflucht ist inspiriert von dieser epischen Sage aus der Geschichte Mondstadts! Und es war früher ziemlich beliebt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600211
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600211,
					"content": "Nur früher war das so?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600212
					]
				},
				{
					"id": 706600212,
					"content": "Traurigerweise, ja. Junge Leute scheinen sich heutzutage nicht sehr für das Spiel zu interessieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600213
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600213,
					"content": "Aber ich kann nicht zulassen, dass Windflucht in Vergessenheit gerät. Also habe ich die Regeln ein wenig geändert, um den Einstieg zu erleichtern und mehr Spaß zu bieten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600214
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600214,
					"content": "Ich habe auch eine ganze Ladung brandneuer Karten eingebaut. Hoffentlich kann ich auf diese Weise mehr Leute zum Spielen bringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600217,
					"content": "Über die „Windflucht“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600218
					]
				},
				{
					"id": 706600218,
					"content": "Ich habe schon einmal Leute rekrutiert, um Windflucht auszuprobieren, und ich war beeindruckt, wie geschickt einige dieser Leute waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600219
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600219,
					"content": "Aber abgesehen von ihnen gibt es immer noch eine ganze Reihe von Leuten, die mir sagen, dass dieses Spiel schwer ist, weil entweder die Rebellen nur schwer weglaufen können oder die Jäger niemanden finden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600220
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600220,
					"content": "Andere haben sich bei mir beschwert, dass man, wenn man das Spiel gut spielen will, sich mit jedem Detail jeder Karte vertraut machen muss, und dass das einfach zu anstrengend ist, und sie wollen, dass ich das Spiel vereinfache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600221
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600221,
					"content": "Leider weiß ich nicht, ob sie recht haben, also dachte ich, ich würde eine andere Gruppe von Leuten anwerben, um es auszuprobieren und ihre Meinung zu hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				}
			]
		},
		{
