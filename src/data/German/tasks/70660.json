			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706600101,
					"content": "#Hallo, {F#Reisende}{M#Reisender}. Ich hoffe, deine Abenteuer verlaufen reibungslos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600102,
						706600105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600102,
					"content": "Ziemlich reibungslos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600103
					]
				},
				{
					"id": 706600103,
					"content": "#Wenn du fleißig so weitermachst, wirst du es noch weit als Abenteurer{F#in} bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600104,
					"content": "Übrigens, wenn du Interesse hast, kannst du zu Gygax gehen und die neue „Windflucht“ ausprobieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600108,
					"content": "Hat das was mit der Abenteurergilde zu tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600109
					]
				},
				{
					"id": 706600109,
					"content": "Nun ... weil Herr Gygax der Gilde einen Auftrag erteilt hat, in dem er uns bittet, ihm dabei zu helfen, Leute zu rekrutieren, die die Windflucht ausprobieren wollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600110,
					"content": "So gesehen hat es was mit der Gilde zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600111,
					"content": "Wie auch immer, geh rüber und probiere es aus, wenn du willst. Laut den Abenteurern, die es ausprobiert haben, macht es ziemlich viel Spaß ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600105,
					"content": "Hast du eine Mission für mich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600106
					]
				},
				{
					"id": 706600106,
					"content": "Mission ... nein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600107,
					"content": "Aber wenn du Interesse hast, kannst du zu Gygax gehen und die neue „Windflucht“ ausprobieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600108
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 7066002,
			"completionStepIds": [
				7066002,
				7066005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
