			"dialogs": [
				{
					"id": 735200301,
					"content": "Hier ist eine Baumhöhle, aber sie ist leer, nichts drin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200302,
					"content": "Hä? Halt, hier ist ein Zettel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200303,
					"content": "„Guter Nara hat Arakasyapa Lesen und Schreiben beigebracht, Arakasyapa jetzt guten Nara beschützen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200304,
					"content": "Was bedeutet das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
