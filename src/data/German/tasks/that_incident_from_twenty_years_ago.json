			"dialogs": [
				{
					"id": 735200101,
					"content": "Habt ihr zwei beschlossen, Informationen von mir zu kaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200102
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200102,
					"content": "Hm ... Paimon ist wirklich ein wenig neugierig auf deine Informationen, aber zuerst musst du uns den Preis verraten! Wenn er zu hoch ist, kaufen wir nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200103,
					"content": "Eine Million Mora, nicht verhandelbar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200104
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200104,
					"content": "So teuer! Dann vergiss es! Für eine Million Mora kann man so viel leckeres Essen kaufen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200105,
					"content": "Moment, ich schaue noch mal nach ... Oh! Kleine Paimon ist die tausendste Kundin des Tages, also kann sie die speziellen Informationen im Wert von einer Million Mora gratis bekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200106
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200106,
					"content": "Was? Wirklich?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200107,
					"content": "Warte, ist das etwa eine Kundenfalle? Der erste Satz ist gratis und der zweite kostet dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200108,
					"content": "Wenn du nicht interessiert bist, dann eben nicht! Der Nächste bitte! Der Nächste ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200109
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200109,
					"content": "Nein, nein, Paimon lag falsch, wir wollen es hören!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200110,
					"content": "Der erste Teil von Doris exklusiven Informationen! Ihr erinnert euch doch noch an die Krone des Wissens, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200111
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200111,
					"content": "Natürlich, sie soll nur von dem Champion getragen werden dürfen, klingt sehr kostbar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200112,
					"content": "In der Tat. Sachin hat die Krone der Akademie gespendet, sie ist eine äußerst wertvolle Antiquität.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200113
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200113,
					"content": "Aber ... die Akademie hatte diese Krone einst verloren, nachdem sie die Spende erhalten hatte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200114
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200114,
					"content": "Wie? Warum haben wir davon nichts gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200115,
					"content": "Haha ... Wenn das jeder wüsste, wäre es dann eine „exklusive Information“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200116
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200116,
					"content": "Diese Information ist natürlich nicht nur leeres Gerede, es gibt Augenzeugen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200117
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200117,
					"content": "In der Vorstadt gibt es einen Jungen namens Kashmer, wenn ihr wollt, könnt ihr ihn fragen gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200118
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200118,
					"content": "Das Codewort lautet ... „Vor zwanzig Jahren“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				}
			]
		},
