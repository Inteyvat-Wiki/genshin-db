					"Kashmer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735200203,
					"content": "„Vor zwanzig Jahren“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200204
					]
				},
				{
					"id": 735200204,
					"content": "... Ich sollte das wohl nicht überall herumposaunen. Letztens habe ich bei ein paar Gläschen ein wenig zu viel geplaudert und jetzt fragt mich jeder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200205
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200205,
					"content": "Aber wenn ihr so spitz darauf seid, erzähle ich es euch noch einmal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200206
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200206,
					"content": "Vor zwanzig Jahren war ich noch ein sechsjähriger Bengel, ich hatte schon vollkommen vergessen, was damals passiert ist. Aber vor einiger Zeit las ich das Tagebuch, das ich als Kind geführt hatte. Erst da erinnerte ich mich wieder vage an die damaligen Ereignisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200207
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200207,
					"content": "Auch in diesem Jahr fand die Interinstitutionelle Meisterschaft statt. Sie bestand aus drei Runden und die dritte wurde außerhalb der Stadt ausgetragen. Ich flehte meine Mutter an, mit mir zuzuschauen, aber sie wollte nicht. Da bin ich heimlich rausgeschlichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200208
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200208,
					"content": "Und dann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200209,
					"content": "Und dann habe ich mich draußen verlaufen. Da war kein Mensch in der Wildnis. Ich bekam immer mehr Angst und konnte nicht aufhören, zu weinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200210
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200210,
					"content": "Da sah ich auf einmal seltsame Kreaturen ... Ich weiß nicht mehr, wie sie aussahen, ich weiß nur noch, dass ich damals bei ihrem Anblick gleich aufhörte zu weinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200211
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200211,
					"content": "Seltsame Kreaturen ... Sind das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200212,
					"content": "(Die Aranara.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200213
					]
				},
				{
					"id": 735200213,
					"content": "Sie brachten mich zum Wettkampfgelände, aber leider waren wir zu spät, der Wettkampf war längst beendet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200214
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200214,
					"content": "Ich war so enttäuscht. Da sah ich plötzlich ein wunderliches Wesen, das langsam eine Krone hinter sich herzog.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200215
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200215,
					"content": "Die Krone war wunderschön, sie glänzte im Mondschein. Ich musste ihr einfach folgen. Ich sah, wie das wunderliche Kerlchen die Krone in einer Baumhöhle versteckte und dann urplötzlich verschwand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200216
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200216,
					"content": "Ich wollte die Krone unbedingt berühren, aber da hörte ich meine Mutter von fern rufen. Sie hatte mein Verschwinden bemerkt und die Nachbarn zusammengerufen, um nach mir zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200217
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200217,
					"content": "Ich hatte die Krone schließlich nicht berührt. Erst als ich erwachsen war, sah ich die „Krone des Wissens“ bei der Interinstitutionellen Meisterschaft und mir wurde klar, dass es dieselbe Krone war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200218
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200218,
					"content": "Also ... Weißt du noch, wo die Krone damals versteckt wurde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200219,
					"content": "Es muss im Avidya-Wald gewesen sein, aber ich bin danach mehrere Male dort gewesen, um sie zu suchen. Ich fand keinen einzigen Hinweis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200220
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200220,
					"content": "Selbst wenn ich etwas gesagt hätte, mir hätte doch niemand geglaubt. Ach, ich kann mich ja selbst nicht richtig erinnern, vielleicht hatte ich das damals ja nur geträumt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200221
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200221,
					"content": "#Hm ... {NICKNAME}, sollen wir sie suchen gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
