			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Azalai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330201,
					"content": "*seufz* Noch eine andere Lieferung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330202
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330202,
					"content": "Über Raefs Waren ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330203
					]
				},
				{
					"id": 732330203,
					"content": "Du meinst die Waren, die Raef bei mir bestellt hat? Ich habe gerade eine Lieferung bekommen, sie hat alles, was er braucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330204
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330204,
					"content": "Aber er hat viel eingekauft ... Bist du gekommen, um seine Ware abzuholen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330205,
						732330206
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330205,
					"content": "Sehr ... Sehr schwer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330207
					]
				},
				{
					"id": 732330207,
					"content": "Außer dem Blumentopf hat er verschiedene Samen, Dünger und Gärtnerutensilien gekauft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330208
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330208,
					"content": "Zusammen sind die Dinge nicht leicht. Schaffst du das alles alleine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330209,
						732330210
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330209,
					"content": "Ich werde zurechtkommen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330211
					]
				},
				{
					"id": 732330211,
					"content": "Wenn das so ist ... Ich packe seine Bestellung ein. Du leistest ihm einen großen Gefallen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330210,
					"content": "Ich habe es ihm versprochen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330211
					]
				},
				{
					"id": 732330206,
					"content": "Wie ... Wie viel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330207
					]
				}
			]
		},
		{
			"id": 7323303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
