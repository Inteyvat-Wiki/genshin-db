			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raef"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330301,
					"content": "#{F#Reisende}{M#Reisender}! Hast du die Sachen mitgebracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				}
			]
		},
		{
			"id": 7323304,
			"completionStepIds": [
				7323307
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7323307",
							"2"
						],
						"stepId": 7323307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raef"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330401,
					"content": "#Das ist alles! Ich danke dir, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330402,
						732330403
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330402,
					"content": "Möchtest du einen Blumenladen eröffnen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				},
				{
					"id": 732330404,
					"content": "Ah, ich wollte ... mehr auf einmal kaufen, damit ich nicht ständig neu einkaufen muss ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330405
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330405,
					"content": "Ruh dich kurz aus! Ich pflanze zuerst die Samen und dünge den Boden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330406
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330406,
					"content": "Raef pflanzt die Samen in den Topf ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732330407
					]
				},
				{
					"id": 732330407,
					"content": "In Ordnung! Das sollte reichen. Nermin braucht nur die Blume zu gießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330408
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330408,
					"content": "#{F#Reisende}{M#Reisender}, könntest du mir bitte helfen ... diesen Blumentopf zu Nermin zu bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330409
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330409,
					"content": "Warum gehst du nicht selbst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330410
					]
				},
				{
					"id": 732330410,
					"content": "Ich muss auf die Kreuzung aufpassen. Wenn wir Waren oder Getreide geliefert bekommen, muss sie jemand aus dem Dorf abnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330411
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330411,
					"content": "Die Temperatur in der Umgebung ... Du solltest es selbst schon gemerkt haben. Wenn das nicht zügig geht, geht die Ware vor Hitze ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330412
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330412,
					"content": "#Ich bitte dich, {F#Reisende}{M#Reisender}! Nermin wohnt hier in der Nähe. Du musst ihr nur diesen Blumentopf bringen. Für den Rest lasse ich mir etwas anderes einfallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330403,
					"content": "Warum hast du so viel gekauft?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				}
			]
		},
		{
			"id": 7323305,
			"completionStepIds": [
				7323305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7323305",
							"2"
						],
						"stepId": 7323305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330501,
					"content": "Jemand im Haus hört etwas ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732330502
					]
				},
				{
					"id": 732330502,
					"content": "Hallo, gibt es etwas, womit ich dir helfen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330503
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330503,
					"content": "Über diesen Blumentopf ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330504
					]
				},
				{
					"id": 732330504,
					"content": "Das hat ... Raef mir geschenkt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330505
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330505,
					"content": "In diesem Topf sind Blumen? Wirklich? Danke, dass du sie gebracht hast. Der Topf gefällt mir sehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330506
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330506,
					"content": "Aber ... kann ich mich wirklich gut um sie kümmern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330507
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330507,
					"content": "Du hast noch nie Blumen angepflanzt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330508
					]
				},
				{
					"id": 732330508,
					"content": "Ich ... Ich bin nicht besonders begabt, was Pflanzen angeht. Viele Pflanzen sind unter meiner Obhut vertrocknet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330509
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330509,
					"content": "Ich glaube, dass die Blumen sogar noch zerbrechlicher sein müssen. Wenn ich sie im brennenden Wind der Wüste wieder verdorren lasse ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330510
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330510,
					"content": "Ah, nein! Die Blumen sind bei mir, also werde ich mich richtig um sie kümmern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330511
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330511,
					"content": "Oma Kulsoom weiß bestimmt, wie man das Problem lösen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				}
			]
		},
		{
			"id": 7323306,
			"completionStepIds": [
				7323306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
