			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raef"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330601,
					"content": "#{F#Reisende}{M#Reisender}, du bist wieder da! Danke für deine Hilfe ... Was hat Nermin dazu gesagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330602,
						732330605
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330602,
					"content": "Sie hat Angst, dass die Blumen vertrocknen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330603
					]
				},
				{
					"id": 732330603,
					"content": "Ach, das ... werde ich mit ihr zusammen angehen. Im schlimmsten Fall fragen wir jemanden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330604
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330604,
					"content": "Im schlimmsten Fall ... suche ich etwas, was leicht zu pflanzen ist und nicht leicht vertrocknet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330608,
					"content": "#Ähem, jedenfalls ... danke ich dir für deine Hilfe, {F#Reisende}{M#Reisender}. Hier ist die versprochene Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330609
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330609,
					"content": "Ich bringe Nermin gleich die anderen Sachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330610
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330610,
					"content": "Warte, haben diese Gärtnerutensilien etwa keine Bedienungsanleitung? Ich habe keine Ahnung, wie man sie benutzt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330605,
					"content": "Du hast ihr noch nie Blumen geschenkt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330606
					]
				},
				{
					"id": 732330606,
					"content": "So kann man das nicht sagen ... Nur früher habe ich blühende Blumen bestellt, die bei ihrer Ankunft im Dorf bereits vertrocknet waren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330607
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330607,
					"content": "Deshalb wollte ich ihr diesmal neu gepflanzte Blumen schenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "Raef"
				}
			]
		},
