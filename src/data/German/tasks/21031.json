					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310407
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210310407,
					"content": "Das ist seltsam. Könnte es sein, dass ein vorbeikommender Abenteurer diese Monster niedergeschlagen hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310408
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210310408,
					"content": "Wie auch immer, ich danke dir, dass du mir geholfen hast, das Gebiet zu inspizieren, und bitte dich, diese Zahlung anzunehmen.",
