			"dialogs": [
				{
					"id": 210310101,
					"content": "Wir müssen noch einen Weg finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310102
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210310102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310103
					]
				},
				{
					"id": 210310103,
					"content": "Du bist es, ach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310104
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210310104,
					"content": "Das Geschäft im Gasthaus hat sich in letzter Zeit verbessert und es kommen immer mehr Leute, um zu übernachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310105
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210310105,
					"content": "Manche kommen allein, um Ruhe und Frieden zu finden, andere kommen mit ihren Familien zu Besuch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310106
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210310106,
					"content": "Ich freue mich zwar, dass es dem Gasthaus gutgeht, aber leider treiben sich hier auch viele Monster herum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310107
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210310107,
					"content": "Wenn Kinder spielen oder ältere Menschen spazieren gehen und den Monstern begegnen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310108
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210310108,
					"content": "Bevor etwas Schlimmes passiert, sollte ich die Monster um das Gasthaus beseitigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310109
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210310109,
					"content": "Aber es ist unmöglich für mich allein, all diese Monster zu besiegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310110
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210310110,
					"content": "#{F#Reisende}{M#Reisender}, kannst du mir helfen? Die Belohnung wird sicherlich nicht gering sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310111,
						210310112
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210310111,
					"content": "Ich werde das machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310115
					]
				},
				{
					"id": 210310115,
					"content": "Dann möchte ich ich dich bitten, dies zu tun. Ich habe schon einige Monsterlager gesehen, und dort gibt es eine ganze Reihe gefährlicher Monster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310116
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210310116,
					"content": "Außerdem hatte sich eine andere Gruppe von Monstern in die Nähe des Gasthauses geschlichen und ein Lager aufgeschlagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310117
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210310117,
					"content": "Ufff ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310118
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210310118,
					"content": "Ich sage dir was, überlasse die gefährlichen Monster mir, du hilfst mir nur, mit denen in der Umgebung des Gasthauses fertig zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310119
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210310119,
					"content": "Wenn wir die Monster losgeworden sind, treffen wir uns wieder im Gasthaus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310120
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210310120,
					"content": "Diese Monster gehen einem wirklich auf die Nerven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210310112,
					"content": "Du solltest gute Fähigkeiten haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310113
					]
				},
				{
					"id": 210310113,
					"content": "Ich? Nun ... du hast recht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310114
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 210310114,
					"content": "Aber es ist unmöglich für mich allein, all diese Monster zu besiegen ...",
					"roleType": "TALK_ROLE_NPC",
