				"points": []
			},
			"dialogs": [
				{
					"id": 718140401,
					"content": "Hallo, wie kann ich dir helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140402
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140402,
					"content": "Ich habe das hier aus dem Meer gefischt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718140403
					]
				},
				{
					"id": 718140403,
					"content": "Hm? Lass mich einen Blick darauf werfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140404
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140404,
					"content": "Ja, das kommt in der Tat aus dem Jadegemach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140405
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140405,
					"content": "Aber worum handelt es sich denn genau?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718140406
					]
				},
				{
					"id": 718140406,
					"content": "Der Inhalt umfasst mehrere Dokumente und eine Ankündigung, die noch überprüft werden muss. Wenn man bedenkt, wie gut sie noch erhalten sind ... Das ist wahrlich unerwartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140407
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140407,
					"content": "Dennoch sollte uns dieser Fund etwas Arbeit sparen. Das Saubermachen nach diesem Schlamassel hat sich tatsächlich als nicht enden wollende Fleißarbeit erwiesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140408
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140408,
					"content": "Trotzdem danke, dass du uns das gebracht hast. Nimm dies als ein Zeichen unserer Wertschätzung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baiwen"
				}
			]
		},
