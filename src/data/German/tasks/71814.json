			"dialogs": [
				{
					"id": 718140301,
					"content": "Hast du die Säuberung abgeschlossen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140302
					],
					"speakerTitle": "Kun"
				},
				{
					"id": 718140302,
					"content": "Ich habe das hier gefunden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718140303
					]
				},
				{
					"id": 718140303,
					"content": "Hmm ... Ich nehme an, du kannst diese Mora einfach behalten. Es ist nicht viel, also kannst du sie wohl als Entschädigung für deine Hilfe behalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140304
					],
					"speakerTitle": "Kun"
				},
				{
					"id": 718140304,
					"content": "Diese Kiste hingegen ist mir unbekannt. Vielleicht solltest du sie an Baiwen weitergeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140305
					],
					"speakerTitle": "Kun"
				},
				{
					"id": 718140305,
					"content": "Zurzeit kümmert sie sich um einige Geschäfte im Yuehai-Pavillon. Möglicherweise weiß sie, worum es sich dabei handelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kun"
				}
			]
		},
		{
