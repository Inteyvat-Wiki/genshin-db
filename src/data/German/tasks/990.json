					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 9901508,
					"content": "Hast du dich bereits eingewöhnt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901509
					]
				},
				{
					"id": 9901519,
					"content": "Möchtest du dich ein wenig unterhalten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901520
					]
				},
				{
					"id": 9901536,
					"content": "Möchtest du etwas unternehmen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901537
					]
				},
				{
					"id": 9901509,
					"content": "Klar, ich finde es ganz toll hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901510
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901510,
					"content": "Die Aussicht auf Mondstadt ist etwas völlig Neues für mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901511
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901511,
					"content": "Wenn du Singen übst, dann sing aus voller Kehle. Mach dir keine Sorgen, dass du andere stören könntest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901512
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901512,
					"content": "Barbaras Stimme stört bestimmt keinen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901513
					]
				},
				{
					"id": 9901516,
					"content": "Das ist ja großartig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901517
					]
				},
				{
					"id": 9901513,
					"content": "Uff ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901514
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901514,
					"content": "Danke für deine netten Worte. Aber ich ... muss trotzdem etwas auf die Gefühle von anderen achten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901515
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901515,
					"content": "Ich freue mich sehr über deine Einladung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901516
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901517,
					"content": "Das stimmt, ich freue mich sehr über deine Einladung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901518
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901518,
					"content": "Ich möchte noch ein wenig länger hier bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901520,
					"content": "Ja gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901521
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901521,
					"content": "Hehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901522
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901522,
					"content": "Wieso lachst du denn auf einmal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901523
					]
				},
				{
					"id": 9901524,
					"content": "Ich habe nur gerade festgestellt, dass ich mit meinen Freunden schon lange nicht mehr so frei geredet habe wie jetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901525
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901525,
					"content": "Da fühlte ich mich auf einmal sehr glücklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901526
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901526,
					"content": "Barbara ist wohl leicht zufrieden zu stellen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901527
					]
				},
				{
					"id": 9901530,
					"content": "Barbara denkt an erster Stelle immer an andere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901531
					]
				},
				{
					"id": 9901527,
					"content": "Ah, ehm, glaubst du das wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901528
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901528,
					"content": "Anscheinend, ist das aber nichts Schlechtes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901529
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901529,
					"content": "Wenn man leicht glücklich zu machen ist, hat man viel mehr Energie und diese kann man dann auch noch an andere weitergeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901530
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901531,
					"content": "Aber ist das nicht selbstverständlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901532
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901532,
					"content": "Ich habe immer die Unterstützung der anderen bekommen und ich möchte etwas an die Leute mit meiner Anstrengung zurückgeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901533
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901533,
					"content": "Keine Frage, das ist Barbara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901534
					]
				},
				{
					"id": 9901534,
					"content": "Hach, du solltest mich wirklich nicht die ganze Zeit loben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901535
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901535,
					"content": "Nur durch Kritik kann Fortschritt entstehen, oder nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901537,
					"content": "In der letzten Zeit habe ich ein neues Lied geübt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901538
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901538,
					"content": "Über einige Details bin ich mir jedoch nicht ganz klar ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901539
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901539,
					"content": "Magst du mit mir vielleicht die Strophe singen? Gibt es vielleicht noch Verbesserungsvorschläge für die Tanzschritte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901540
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901541,
					"content": "Ich werde dir mein „volles Programm“ zeigen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901542
					]
				},
				{
					"id": 9901542,
					"content": "Es wäre mir eine Ehre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901543
					]
				},
				{
					"id": 9901540,
					"content": "Wenn es dir nichts ausmacht, kannst du dir meine Aufführung ansehen und mir danach ein paar Ratschläge geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901541
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901543,
					"content": "Danke ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901544
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901544,
					"content": "Ok, sollte ich etwas falsch machen, lach mich bitte nicht aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901545
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901545,
					"content": "Ich habe lange darüber nachgedacht und jetzt muss ich den Mut aufbringen es dir vorzuführen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901546
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901547,
					"content": "Ich werde nicht lachen, versprochen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901548
					]
				},
				{
					"id": 9901546,
					"content": "Solltest du über mich lachen, wüsste ich gar nicht wo ich mich so schnell verstecken sollte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901547
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901549,
					"content": "Puh ... gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901550
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901550,
					"content": "Also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901551
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901551,
					"content": "Die Darbietung beginnt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				}
			]
		},
