	"talks": [
		{
			"id": 301101,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301101",
							"2"
						],
						"stepId": 301101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110101,
					"content": "... Es ist immer noch der gleiche Tag!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110102,
					"content": "Sieht aus, als sei es nicht so einfach wie gedacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110103
					]
				},
				{
					"id": 30110103,
					"content": "Nahida, du wusstest doch gestern schon, dass das „Samsara“ nicht aufhören würde! Warum hast du es uns nicht gleich gesagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110104,
					"content": "Was hätte es denn gebracht, dass ich es euch gesagt hätte? Ihr hättet die Nacht mit neuen Sorgen verbracht, denn der Morgen ist immer noch nicht in Sicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110105,
					"content": "Daher ... habe ich euch dieses Fünkchen Hoffnung gelassen. Dazu gibt es nur selten eine Gelegenheit. Vielleicht könnte es euren Gedanken auf die Sprünge helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110106
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110106,
					"content": "Das stimmt ... Nahida macht sich wirklich Gedanken um uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110107,
					"content": "Selbstverständlich, zumindest in letzter Zeit, seid ihr mein Ein und Alles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110108
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110108,
					"content": "Oh ... Warum auf einmal so emotional?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110109,
					"content": "Hehehe ... Ich meine, auch wenn ich euch beide beauftragt habe, das Rätsel zu lösen, seid ihr es auch, die mich als einzige sehen und spüren können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110110
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110110,
					"content": "Anders ausgedrückt, ohne euch, wüsste niemand, dass es mich gibt. Deshalb seid ihr alles für mich, versteht ihr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110111
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110111,
					"content": "Nahida sagt wieder ein paar sehr verwirrende Dinge ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110112,
					"content": "#Jetzt reicht es mit der Rede! {NICKNAME}, hast du nach den gestrigen Ereignissen zur aktuellen Situation neue Erkenntnisse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110113
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110113,
					"content": "Die „Zeitschleifentheorie“ hat sich als falsch entpuppt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110114
					]
				},
				{
					"id": 30110114,
					"content": "He, warum wirfst du unsere früheren Gedanken einfach so über Bord?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110115,
						30110116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110115,
					"content": "Wegen Dehyas kämpferischer Weiterentwicklung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110117
					]
				},
				{
					"id": 30110117,
					"content": "Oh, das stimmt ... Das ist Paimon auch schon aufgefallen. Eine einfache Zeitschleife sollte den körperlichen Zustand komplett zurücksetzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110118,
					"content": "Und was ist dann eure neue Theorie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110116,
					"content": "Und auch wegen der Verschlechterung von Dunyarzads Zustand ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110117
					]
				}
			]
		},
		{
			"id": 301102,
			"completionStepIds": [
				301102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301102",
							"2"
						],
						"stepId": 301102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110201,
					"content": "... Hier seid ihr also. Ich haben euch endlich gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110202,
					"content": "Heute hat sich Dehya auch nicht verletzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110203,
					"content": "Verletzt? Wie verletzt? Unterschätze mich nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110204
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110204,
					"content": "Mit deinem neuen Großschwert kannst du doch nicht so gut umgehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110205,
					"content": "Ehrlich gesagt, finde ich es auch ziemlich seltsam. Es fühlte sich in meinen Händen plötzlich so vertraut an ... Einen Moment, woher wisst ihr das mit meinem Großschwert? Das habe ich euch doch bestimmt nicht erzählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110206
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110206,
					"content": "Oh, erklär du es dieses Mal. Paimon hat das schon zu oft getan ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110207,
						30110208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110207,
					"content": "Dehya muss das gar nicht wirklich verstehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110209
					]
				},
				{
					"id": 30110209,
					"content": "Ja, du hast recht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110210,
					"content": "Der Grund, warum du jetzt so gut mit deinem Großschwert umgehen kannst, ist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110211,
						30110212
					]
				},
				{
					"id": 30110211,
					"content": "Dass wir immer wieder das Sabzeruz-Fest erleben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110213
					]
				},
				{
					"id": 30110213,
					"content": "... Was ist passiert, als ich weg war? Wurdet ihr von einer seltsamen Gestalt bekehrt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110214,
					"content": "Ah, mach dir da keine Gedanken. Akzeptier es einfach als wahr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110215,
					"content": "... Na gut, ich verstehe, was ihr meint. Ihr meint, mein Körpergedächtnis hat sich schon vollkommen an dieses Schwert gewöhnt, nur in meinem Kopf kann ich davon nichts finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110216
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110216,
					"content": "Genau, jeden Tag vergessen wir wieder alles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110217,
					"content": "Ich muss dir widersprechen. Das ist wirklich unmöglich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110218
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110218,
					"content": "Ach so? Warum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110219,
					"content": "Wenn Tag für Tag das Sabzeruz-Fest stattfindet und nur unsere Erinnerungen verschwinden. Was ist dann mit all den verbrauchten Waren, dem ausgegeben Geld und den verzehrten Nahrungsmitteln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110220
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110220,
					"content": "Dann sollte mein Geldbeutel doch inzwischen völlig leer sein, das kann ich doch nicht übersehen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110221
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110221,
					"content": "Daran habe ich auch gedacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110222,
						30110223
					]
				},
				{
					"id": 30110222,
					"content": "Wenn wirklich die Weisen dahinter stecken ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110224
					]
				},
				{
					"id": 30110224,
					"content": "Also ... Akasha verwenden, um die täglichen Aktivitäten der Menschen der Stadt aufzuzeichnen und dann deren Ressourcen zu nutzen, um zum Anfang dieses Tages zurückzukommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110225,
					"content": "Auch wenn es nicht allzu wahrscheinlich klingt, ist es möglicherweise dennoch möglich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110226,
					"content": "Das kann nicht sein, dafür habe ich einen Beweis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110227
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110227,
					"content": "Ein Beweis? Wo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110228,
					"content": "*seufz* Ihr meint es mit diesem merkwürdigen Gerede also wirklich ernst ... Na gut, dann lasst mich euch noch ein wenig begleiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110229
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110229,
					"content": "Folgt mir, Fräulein Dunyarzad sollte auch mitkommen. Ich kann ihre Sicherheit an diesem Ort noch nicht garantieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110223,
					"content": "Wenn sie die Daten aus Akasha und die Ressourcen der ganzen Stadt nutzen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110224
					]
				},
				{
					"id": 30110212,
					"content": "Jede Nacht verschwindet die Erinnerung an den vorherigen Tag.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110213
					]
				},
				{
					"id": 30110208,
					"content": "Kommen wir direkt zum Wichtigsten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110209
					]
				}
			]
		},
		{
			"id": 301103,
			"completionStepIds": [
				301103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301103",
							"2"
						],
						"stepId": 301103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110301,
					"content": "Hier ist es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110302
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110302,
					"content": "Was ist das? Deine Übungspuppe für Übungen mit dem Schwert? Was soll damit sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110303,
					"content": "Seht ihr die Spuren da oben? Die habe ich in den vergangenen Tagen gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110304
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110304,
					"content": "Angenommen, die Weisen kämen nicht jeden Tag, um sie auszutauschen, dann sollte sie doch mittlerweile völlig kaputtgeschlagen sein, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110305
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110305,
					"content": "Richtig, und wenn sie die Puppe doch jeden Tag austauschen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110306,
					"content": "Dann müssten die Weisen jedes Mal auf einer neuen Übungspuppe die bei meinen vorherigen Übungen entstandenen Schwertspuren nachmachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110307
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110307,
					"content": "Auf jeden Fall bin ich auch eine Kriegerin. In meiner Kampfkunstschule wird ein besonders hoher Wert auf „Kontrolle“ gelegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110308
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110308,
					"content": "Bei jedem Schwertschwung kontrolliere ich Kraft, Winkel und Eintrittspunkt sehr sorgfältig. Deshalb kann ich mich an jede Einkerbung da oben genau erinnern und auch an meinen Gemütszustand bei jedem Schwerthieb.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110309
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110309,
					"content": "So wie es heißt, kein Kämpfer sei einem anderen gleich, so kann auch kein Mensch zweimal einen komplett gleichen Schwerthieb ausführen. Es ist also völlig unmöglich, meine Schwerthiebe vollkommen nachzuahmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110310
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110310,
					"content": "Unmöglich? Und was, wenn man sie mit irgendeinem Präzisionsinstrument Stück für Stück „eingravieren“ würde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110311,
					"content": "Es heißt oft, das Bild eines Fotoapparates könne niemals das Landschaftsbild eines Malers erreichen, schließlich fehle Ersterem die Seele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110312
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110312,
					"content": "Bei mir ist das genauso. Eingravierte Spuren eines Schwerthiebs und die Spuren eines Schwerthiebs, der die Krönung der Kampfkunst darstellt ... Mit bloßem Auge kann ich ihre Unterschiede erkennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110313,
						30110314
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110313,
					"content": "... Nachvollziehbar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110315
					]
				},
				{
					"id": 30110315,
					"content": "Puh ... Damit sollten jetzt alle Zweifel vom Tisch sein. He, ist das nicht dieses bei den Gelehrten in letzter Zeit so beliebte Spiel, das „Gedankenverdrehen“? Scheint unerwartet unterhaltsam zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110316
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110316,
					"content": "Na gut, wie ich sehe, ist es schon spät. Ich bringe Fräulein Dunyarzad jetzt zu Nilou. Bis dann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110317
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110317,
					"content": "*seufz* ... Heißt das, wir waren mit unserer Theorie von der „Erinnerungslöschung“ wieder auf dem Holzweg?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110318,
					"content": "Aber zumindest haben wir doch zu einem Teilergebnis gekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110319,
						30110320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110319,
					"content": "Wir befinden uns keineswegs in einer Zeitschleife.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110321
					]
				},
				{
					"id": 30110321,
					"content": "Ja, stimmt. Was wäre denn noch denkbar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110322,
						30110323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110322,
					"content": "Mal überlegen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110324
					]
				},
				{
					"id": 30110324,
					"content": "Faul? Paimon findet an allem, was in letzter Zeit passiert ist, ist etwas faul ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110325,
					"content": "Warum ... haben wir nie darüber nachgedacht, die Stadt zu verlassen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110326
					]
				},
				{
					"id": 30110326,
					"content": "Was? Die Stadt verlassen ... Genau! Warum ist uns nie eingefallen, etwas so einfaches auszuprobieren? Wenn wir schauen, ob wir immer noch am gleichen Tag festhängen, wenn wir die Stadt verlassen, dann können wir gleich ganz viele Dinge sicherstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110327,
					"content": "Es ist wirklich unglaublich, sind wir bis jetzt die ganze Zeit mit einem Brett vor dem Kopf herumgelaufen oder waren immer so müde, dass das uns nicht eingefallen ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110328,
						30110329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110328,
					"content": "Wirklich merkwürdig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110330
					]
				},
				{
					"id": 30110330,
					"content": "Vielleicht sollten wir erst einmal Nahida darüber befragen, wie es damit aussieht, die Stadt zu verlassen. Vielleicht übersehen wir gerade etwas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110329,
					"content": "Das hätte uns wirklich früher einfallen können.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110330
					]
				},
				{
					"id": 30110323,
					"content": "Irgendwas kommt mir auf einmal faul vor ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110324
					]
				},
				{
					"id": 30110320,
					"content": "Wir befinden uns nicht in der Realität.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110321
					]
				},
				{
					"id": 30110314,
					"content": "Dann können wir diese Möglichkeit wohl ausschließen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110315
					]
				}
			]
		},
		{
			"id": 301104,
			"completionStepIds": [
				301104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301104",
							"2"
						],
						"stepId": 301104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110401,
					"content": "Nahida, wir sind zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110402,
					"content": "Heute seid ihr aber früh zurück. Habt ihr etwas Neues?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110403
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110403,
					"content": "Das kann man so sagen. Wir haben festgestellt, dass die Zeit sich nicht wiederholt und dass das hier nicht die Realität sein sollte ... Aber uns sind auch neue Fragen gekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110404,
						30110405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110404,
					"content": "Was wäre, wenn wir die Stadt verlassen würden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				},
				{
					"id": 30110406,
					"content": "Die Stadt verlassen ... Mir scheint, als hättet ihr schon zweimal einen Plan zum Verlassen der Stadt erwähnt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110407
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110407,
					"content": "!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110408
					]
				},
				{
					"id": 30110408,
					"content": "Darüber haben wir gesprochen?! Warum können wir uns gar nicht daran erinnern? Und was ist dann passiert? Was haben wir gesagt, als wir dann zurückgekehrt waren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110409,
					"content": "Lasst mich kurz nachdenken ... Ihr habt mir anscheinend nie gesagt, was aus euren Plänen, die Stadt zu verlassen, geworden ist. Oh, genauer gesagt, ihr seid bei den zwei Malen nicht zurückgekehrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110410
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110410,
					"content": "Andererseits gab es auch sonst nicht wenige Nächte, an denen ihr nachts nicht zurückgekommen seid. Deshalb hatte ich das damals nicht als Beweis für irgendetwas angesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110411
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110411,
					"content": "Es kommt wirklich vor, dass wir, wenn wir etwas untersuchen, die Zeit völlig vergessen und dann urplötzlich der nächste Tag anbricht. Aber wir können uns wirklich überhaupt nicht daran erinnern, wie du sagst, die Stadt verlassen zu wollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110412,
					"content": "Wenn das so ist, ist das wirklich seltsam. In der Theorie sollte ich all eure Erinnerung wachrufen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110413,
						30110414
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110413,
					"content": "Dann versuchen wir es morgen noch einmal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110415,
					"content": "Ja! Hier muss irgendetwas faul sein. Morgen müssen wir herausfinden, was es ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110416,
					"content": "*tick* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110414,
					"content": "Vielleicht bringt gerade das den Durchbruch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110405,
					"content": "Haben wir wirklich noch nie versucht, die Stadt zu verlassen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				}
			]
		},
