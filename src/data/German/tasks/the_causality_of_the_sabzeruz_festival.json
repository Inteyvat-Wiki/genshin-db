			"dialogs": [
				{
					"id": 30111113,
					"content": "Ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111101,
						30111102
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111101,
					"content": "Die Zeit läuft nicht in einer Schleife ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111103
					]
				},
				{
					"id": 30111103,
					"content": "Ja. Wahrscheinlich ist das Geräusch von Akasha jede Nacht das Löschen der Erinnerungen dieses Tages ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111104,
					"content": "Deshalb glauben alle beim Aufwachen, dass sie das Sabzeruz-Fest noch nicht begangen hätten. Obwohl es eindeutig „Morgen“ ist, glauben sie dennoch, es sei „Gestern“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111105,
					"content": "Aber die Körpererinnerungen sind dennoch unauslöschlich, weshalb Dehya immer besser mit ihrem neuen Großschwert umzugehen lernt! Jetzt macht alles Sinn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111106,
					"content": "... Das ist eine brillante Schlussfolgerung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111107
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111107,
					"content": "Aber stimmt sie denn, Nahida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111108,
					"content": "Einfach ausgedrückt wäre das so, als würde man einen Pyro-Kristallschmetterling einfangen und ihn wie ein Glühwürmchen zur Beleuchtung verwenden. Die Gewichtung liegt zu stark auf dem „Glühen“ und zu wenig auf dem „Wesen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111109
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111109,
					"content": "Das ist aber gar nicht einfach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111110,
					"content": "Stimmt es also immer noch nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111111
					]
				},
				{
					"id": 30111111,
					"content": "Am besten geht ihr noch einmal zu Dehya und unterhaltet euch mit ihr, vielleicht kriegt ihr so etwas Neues heraus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111112
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111112,
					"content": "Na gut, immerhin stammt unsere neueste Spur auch von ihr ... Wollen wir gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111102,
					"content": "Und unsere Erinnerung wird jeden Tag gelöscht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111103
					]
				}
			]
		},
