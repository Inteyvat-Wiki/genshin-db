						760150206
					]
				},
				{
					"id": 760150206,
					"content": "Wenn es sein muss. Aber zuerst musst du mit uns trinken und singen. Wenn wir erst mal Freunde sind, kannst du sitzen, wo du willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150207
					],
					"speakerTitle": "Lautes Phantom"
				},
				{
					"id": 760150207,
					"content": "Du kannst doch singen, oder? Juhu, los jetzt ... Wir singen eine Zeile und du die nächste ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150208
					],
					"speakerTitle": "Lautes Phantom"
				},
				{
					"id": 760150208,
					"content": "„Die Tanzmusik der Nachbarn lässt mein Tanzbein erwachen, oh!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150209
					],
					"speakerTitle": "Lautes Phantom"
				},
				{
					"id": 760150209,
					"content": "„Alle lächeln, und meine Saiten erklingen dazu.“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150210
					]
				},
				{
					"id": 760150210,
					"content": "„Alle tanzen, alle sind froh!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150211
					],
					"speakerTitle": "Lautes Phantom"
				},
				{
					"id": 760150211,
					"content": "„Kommt, alle zusammen im Takt, joho!“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150212
					]
				},
				{
					"id": 760150212,
					"content": "Haha, ganz genau! Genau so! Du lernst schnell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150213
					],
					"speakerTitle": "Lautes Phantom"
				},
				{
					"id": 760150213,
					"content": "Mein Name ist ███. So, jetzt kennen wir uns. Setz dich also auf den Stuhl, wenn du willst – ich bin schließlich nicht geizig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150214
					],
					"speakerTitle": "Lautes Phantom"
				},
				{
					"id": 760150214,
					"content": "Du bist auch ein Ratnik, was? Keine Sorge, das Bier geht auf mich. Vielleicht sehen wir uns ja beim Training wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150215,
						760150216
					],
					"speakerTitle": "Lautes Phantom"
				},
				{
					"id": 760150215,
					"content": "Danke ... auch wenn ich das nicht trinken könnte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150217,
					"content": "Also dann, ich sollte jetzt patrouillieren gehen. Man sieht sich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lautes Phantom"
				},
				{
					"id": 760150216,
					"content": "Freut mich. Ich heiße Flins.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150205,
					"content": "Und wenn ich hier sitzen möchte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150206
					]
				}
			]
		},
