			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lautes Phantom"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760150101,
					"content": "Wer bist du? Das ist mein Stuhl. Jeder in der Taverne weiß das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150102
					],
					"speakerTitle": "Lautes Phantom"
				},
				{
					"id": 760150102,
					"content": "Bist du neu auf der Insel oder was? Du solltest nicht einfach den Platz eines anderen einnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150103
					],
					"speakerTitle": "Lautes Phantom"
				},
				{
					"id": 760150103,
					"content": "Und wo bleibt mein Bier? Aber zackig jetzt, ich muss gleich auf Patrouille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150104,
						760150105
					],
					"speakerTitle": "Lautes Phantom"
				},
				{
					"id": 760150104,
					"content": "Taverne? Bier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				},
				{
					"id": 760150106,
					"content": "Wenn es sein muss. Aber zuerst musst du mit uns trinken und singen. Wenn wir erst mal Freunde sind, kannst du sitzen, wo du willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150107
					],
					"speakerTitle": "Lautes Phantom"
				},
				{
					"id": 760150107,
					"content": "Du kannst doch singen, oder? Juhu, los jetzt ... Wir singen eine Zeile und du die nächste ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150108
					],
					"speakerTitle": "Lautes Phantom"
				},
				{
					"id": 760150108,
					"content": "„Die Tanzmusik der Nachbarn lässt mein Tanzbein erwachen, oh!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150109,
						760150110,
						760150111
					],
					"speakerTitle": "Lautes Phantom"
				},
				{
					"id": 760150109,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150112,
					"content": "#Nein, nein, nein! Komm schon, du {F#Spielverderberin}{M#Spielverderber}. Jeder aus Nod-Krai kennt doch dieses Lied.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150113
					],
					"speakerTitle": "Lautes Phantom"
				},
				{
					"id": 760150113,
					"content": "Wenn du weder singen noch Spaß haben kannst, wirst du nie dazugehören, weißt du? Und wenn die Wilde Jagd kommt und du ohne Kameraden dastehst, bist du erledigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150114
					],
					"speakerTitle": "Lautes Phantom"
				},
				{
					"id": 760150114,
					"content": "Komm erst wieder, wenn du das Lied gelernt hast. Joho! Noch ein Bier, los!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lautes Phantom"
				},
				{
					"id": 760150110,
					"content": "„Meine Freundin Paimon bringt mich ständig zum Lachen!“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150111,
					"content": "„Die Inselgeister umtanzen den Stuhl und lassen es krachen!“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150105,
					"content": "Lass mich doch für eine Weile hier sitzen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				}
			]
		},
