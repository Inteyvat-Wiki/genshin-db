			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aramis"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030101,
					"content": "Oh, was soll ich nur tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030102
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030102,
					"content": "Kann ich bei irgendetwas helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030103
					]
				},
				{
					"id": 700030103,
					"content": "Wenn das Windblumenfest stattfindet, bringen die Menschen den Götterstatuen immer alle Arten von Blumen dar. Dann entsteht ein Windstoß und sie fliegen in alle Richtungen davon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030104
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030104,
					"content": "Wir haben nicht wenig Aufwand betrieben, um diese verwelkten Blumen wegzuputzen. Ich komme zwar mit den Blumen und Blättern auf dem Platz zurecht, aber gegen die, die auf Dächer und Stadtmauern landen, kann ich nicht viel tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030105
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030105,
					"content": "Das machen meine alten Knie nicht mehr mit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030106
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030106,
					"content": "Ich werde dir helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030107
					]
				},
				{
					"id": 700030107,
					"content": "Das würdest du echt tun? Oh, das ist wundervoll. Diese verwelkten Blumen sind recht auffallend. Man sollte sie sofort erkennen können, wenn man auf ein Dach steigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
				}
			]
		},
