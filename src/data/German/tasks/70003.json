			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verloren gegangene Katze"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030501,
					"content": "Hm, es war wohl wirklich eine Katze. Ich frage mich, warum sie hier ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700030502,
					"content": "Miau ... Miaaaauu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030503,
						700030504
					],
					"speakerTitle": "Verloren gegangene Katze"
				},
				{
					"id": 700030503,
					"content": "Miaumiau, miau?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				},
				{
					"id": 700030505,
					"content": "Miaumiau, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030506
					],
					"speakerTitle": "Verloren gegangene Katze"
				},
				{
					"id": 700030506,
					"content": "Ähm, es tut mir leid, dir das mitteilen zu müssen, aber Paimon versteht nicht ein Wort ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700030507,
					"content": "Holen wir sie erstmal mit runter. Vielleicht weiß Aramis, wo sie hingehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700030504,
					"content": "Hast du dich verirrt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				}
			]
		},
		{
			"id": 7000306,
			"completionStepIds": [
				7000308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000308",
							"2"
						],
						"stepId": 7000308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aramis"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030601,
					"content": "Tut mir leid, ich habe sie noch nie vorher gesehen, sonst würde ich mich sicher erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030602
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030602,
					"content": "Oh, ich verstehe ... Das kleine Schätzchen liebt die Blumen. Vielleicht hat sie sie bis hierher verfolgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030603
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030603,
					"content": "Sucht jemand nach einer Katze?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030604
					]
				},
				{
					"id": 700030604,
					"content": "Miau ... miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030605
					],
					"speakerTitle": "Verloren gegangene Katze"
				},
				{
					"id": 700030605,
					"content": "Ist das ... Schmetterling?! Oh, du bist es wirklich! Wo bist du nur gewesen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030606
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030606,
					"content": "Auf dem Dach.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030607
					]
				},
				{
					"id": 700030607,
					"content": "Es ist also, wie ich dachte ... Vielen Dank. Schmetterling jagt so gern Blumen nach. Jetzt, da hier in der Stadt überall Blumen sind, ist sie in letzter Zeit richtig anstrengend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030608
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030608,
					"content": "Vielen Dank noch einmal. Euer nächstes Getränk geht auf mich, wenn ihr wieder bei Zum Katzenschwanz seid. Na ja, zumindest die alkoholfreien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030609,
						700030610
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030609,
					"content": "Jetzt geht das wieder los ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				},
				{
					"id": 700030611,
					"content": "Haha ... Danke nochmal. Man sieht sich, und frohes Windblumenfest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030612
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030612,
					"content": "Na ja, ich hätte nie gedacht, dass Katzen sich auch vom Windblumenfest angezogen fühlen. Was für ein geschäftiges Fest ... Gut, dass du diese Katze gefunden hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030613
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030613,
					"content": "Wenn du mich gefragt hättest, dort hinaufzuklettern, um sie zu retten, dann hätten meine Knie wohl den Geist aufgegeben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030614
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030614,
					"content": "Vielen Dank für deine Hilfsbereitschaft. Diese Kleinigkeit ist für deine Mühen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030610,
					"content": "Das heben wir uns dann fürs nächste Mal auf, schätze ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				}
			]
		}
	]
}