				},
				{
					"id": 751031103,
					"content": "Ich habe reichlich Fisch vorbereitet! Wenn wir alle Wassertreiblinge anlocken könnten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751031104
