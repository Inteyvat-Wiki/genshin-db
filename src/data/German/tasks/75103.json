			},
			"dialogs": [
				{
					"id": 751030801,
					"content": "Waaah, so viel Fisch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030802,
					"content": "Ah, bitte nicht anfassen! Das ist dazu da, um die Wassertreiblinge anzulocken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030803
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030803,
					"content": "Was, die Wassertreiblinge anlocken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030804,
					"content": "Ja, Iwai und ich warten darauf, dass diese Wassertreiblinge ans Ufer kommen. Wir haben sonst nichts anderes zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030805
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030805,
					"content": "*brüüüllll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030806
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030806,
					"content": "Schon gut, schon gut, Iwai ist ein braves Kind, nicht wahr? Habe Geduld, sei nicht voreilig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030807
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030807,
					"content": "Oje ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030808
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030808,
					"content": "Jedenfalls, wir wollten hier eigentlich nur spielen. Abgesehen von Onkel Rongo kommt hier normalerweise niemand her, deshalb ist das unser geheimer Stützpunkt ... Oder so ähnlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030809
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030809,
					"content": "Aber heute sind uns die Wassertreiblinge überraschenderweise voraus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030810
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030810,
					"content": "Deshalb habe ich diesen Fisch vorbereitet, um die Wassertreiblinge anzulocken. Wassertreiblinge mögen nämlich Fisch sehr gerne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030811,
						751030812
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030811,
					"content": "Aber die Wassertreiblinge scheinen nicht angelockt zu werden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030816
					]
				},
				{
					"id": 751030816,
					"content": "Ja, das stimmt. Vielleicht liegt es daran, dass sie zu weit weg sind und den Geruch des Fisches nicht riechen können? Wenn wir sie irgendwie zuerst ans Ufer locken könnten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030817
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030817,
					"content": "*seufz*, wenn es Onkel Rongo wäre, würde er wahrscheinlich so etwas sagen wie: <color=#00E1FFFF>„Man muss sie einfach ans Ufer stoßen!“</color> ... Aber leider sind Iwai und ich zu schwach und würden nur zurückgestoßen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030818
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030818,
					"content": "#Hm ... {NICKNAME}, wie wäre es, wenn wir es versuchen? Wenn wir die Wassertreiblinge ans Ufer locken, werden sie vielleicht vom Fisch angezogen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030812,
					"content": "Ach so! Paimon ist also eigentlich auch ein Wassertreibling ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030813
					]
				},
				{
					"id": 751030813,
					"content": "Rund und kugelig, mag Fisch ... Verstehe, tatsächlich ein Wassertreibling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030814
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030814,
					"content": "Ja, ja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030815
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030815,
					"content": "Ganz und gar nicht! Davon abgesehen, diese Wassertreiblinge werden überhaupt nicht angelockt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030818
					],
					"speakerTitle": "Paimon"
				}
			]
		},
