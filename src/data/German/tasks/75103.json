					}
				]
			},
			"dialogs": [
				{
					"id": 751030101,
					"content": "Waaah, so viel Fisch! Was macht ihr hier so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030102,
					"content": "#Hä? Oh, hallo! {M#großer blonder Bruder}{F#große blonde Schwester}, und die Weiße ... die Weiße ... Äh, das müsste das Schwesterchen sein, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030103
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030103,
					"content": "Iwai und ich warten hier, bis diese Wassertreiblinge ans Ufer kommen. Wir haben sonst nichts anderes zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030104
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030104,
					"content": "Was, ihr wartet bis die Wassertreiblinge ans Ufer kommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030105,
					"content": "*brüüüllll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030106
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030106,
					"content": "Schon gut, schon gut, Iwai ist ein braves Kind, nicht wahr? Habe Geduld, sei nicht voreilig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030107
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030107,
					"content": "Oje ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030108
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030108,
					"content": "Jedenfalls, wir wollten hier eigentlich nur spielen. Abgesehen von Onkel Rongo kommt hier normalerweise niemand her, deshalb ist das unser geheimer Stützpunkt! So ungefähr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030109
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030109,
					"content": "Aber heute sind uns die Wassertreiblinge überraschenderweise voraus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030110
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030110,
					"content": "Deshalb habe ich diesen Fisch vorbereitet, um die Wassertreiblinge anzulocken. Wassertreiblinge mögen nämlich Fisch sehr gerne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030111,
						751030112
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030111,
					"content": "Aber die Wassertreiblinge scheinen nicht angelockt zu werden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030116
					]
				},
				{
					"id": 751030116,
					"content": "Ja, das stimmt. Vielleicht liegt es daran, dass sie zu weit weg sind und den Geruch des Fisches nicht riechen können? Wenn wir sie irgendwie zuerst ans Ufer locken könnten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030117
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030117,
					"content": "*seufz*, wenn es Onkel Rongo wäre, würde er wahrscheinlich so etwas sagen wie: <color=#00E1FFFF>„Man muss sie einfach ans Ufer stoßen!“</color> ... Aber leider sind Iwai und ich zu schwach und würden nur zurückgestoßen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030118,
					"content": "#Hm ... {NICKNAME}, wie wäre es, wenn wir es versuchen? Wenn wir die Wassertreiblinge ans Ufer locken, werden sie vielleicht vom Fisch angezogen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030112,
					"content": "Ach so! Paimon ist also eigentlich auch ein Wassertreibling ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030113
					]
				},
				{
					"id": 751030113,
					"content": "Rund und kugelig, mag Fisch ... Verstehe, tatsächlich ein Wassertreibling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030114
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030114,
					"content": "Ja, ja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030115
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030115,
					"content": "Ganz und gar nicht! Davon abgesehen, diese Wassertreiblinge werden überhaupt nicht angelockt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "Paimon"
				}
			]
		},
