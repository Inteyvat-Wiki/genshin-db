						751030215
					]
				},
				{
					"id": 751030215,
					"content": "Aber, vielleicht waren sie vorher zu weit weg und haben den Fisch, den ich vorbereitet hatte, gar nicht gesehen. Nachdem du sie ans Ufer gelockt hast, wurden sie sofort angezogen!",
					"roleType": "TALK_ROLE_NPC",
