				},
				{
					"id": 400340602,
					"content": "Wuff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340603
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400340603,
					"content": "Was ... Was ist das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340604,
						400340606,
						400340608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340604,
					"content": "„Huthund“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340605
					]
				},
				{
					"id": 400340605,
					"content": "Hä? Was ist das für ein Spitzname?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340609,
					"content": "Auf jeden Fall scheint er nicht die Absicht zu haben, uns anzugreifen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340610
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340610,
					"content": "Wuff, wuff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340611
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400340611,
					"content": "Oooh, er ist entkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340612,
					"content": "Er schaute zu uns zurück, während er weglief. Will er vielleicht, dass wir ihm folgen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340613
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340613,
					"content": "Lass uns ihm schnell folgen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340614
					]
				},
				{
					"id": 400340614,
					"content": "Nun, vielleicht liegt die Wahrheit vor uns ... Vielleicht ist es genau so, wie Sango es vorausgesagt hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340606,
					"content": "Klingenwelpe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340607
					]
				},
				{
					"id": 400340607,
					"content": "Das heißt Huthund!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340609
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340608,
					"content": "Schwarzer Schatten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340609
					]
				}
			]
		},
		{
			"id": 4003409,
			"completionStepIds": [
				4003409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
