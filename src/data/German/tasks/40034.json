				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340901,
					"content": "#Puh, endlich ist es vorbei. Paimon versteht wirklich nicht, wie der Kampf so plötzlich begonnen hat. Kageroumaru schien anfänglich doch ziemlich freundlich zu sein. Gott sei Dank ist {NICKNAME} da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340902,
					"content": "#Huch, warum folgt er {NICKNAME} nur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340903,
					"content": "Wuff, wuff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340904
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400340904,
					"content": "Das Bellen klang wie ein bisschen Freude, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340905
					]
				},
				{
					"id": 400340905,
					"content": "Wie hast du das rausgehört? Paimon ist immer noch verwirrt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340906,
					"content": "#Wenn meine Vermutung richtig ist, ist Kageroumaru jetzt der Ninken von {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340907
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340907,
					"content": "Hä?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340908,
					"content": "Was?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340909
					]
				},
				{
					"id": 400340909,
					"content": "Ich habe nur wenig über die Methode gehört, wie man sich einen Ninken anschafft. Es heißt, dass ein Ninja, der sich einen Ninken ausgesucht hat, diesen besiegen muss, um die Zustimmung des Ninken zu erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340910
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340910,
					"content": "Ninjas sehnen sich nach mächtigen Partnern, ebenso wie die Ninken, und nur mit gegenseitiger Anerkennung kann die Verbindung abgeschlossen werden. Das scheint in der Tat der Fall zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340911
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340911,
					"content": "#Aber {NICKNAME} ist kein Ninja ... und ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340912,
					"content": "Oh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340913,
					"content": "Was ist Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340914
					]
				},
				{
					"id": 400340914,
					"content": "#{NICKNAME}, du musst Paimon erst etwas versprechen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340915,
					"content": "Was denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340916
					]
				},
				{
					"id": 400340916,
					"content": "Versprich es Paimon zuerst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340917,
					"content": "Na gut. Ich verspreche es dir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340918
					]
				},
				{
					"id": 400340918,
					"content": "Auch wenn du jetzt Kageroumaru als Partner hast, darfst du nicht vergessen, dass Paimon deine beste Gefährtin ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340919,
					"content": "Ja, Paimon ist meine allerbeste Freundin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340920
					]
				},
				{
					"id": 400340920,
					"content": "Super!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340921,
						400340922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340921,
					"content": "Im Vergleich zu Katzen und Hunden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340923
					]
				},
				{
					"id": 400340923,
					"content": "Ehehe! Wir werden immer die besten der besten Kumpel sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340924,
					"content": "Hmm. Schön zu sehen, dass ihr beide euch so gut versteht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340925
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340925,
					"content": "Aber wenn Kageroumaru so stark war, warum hat diese Person dann vorher einen Brief hinterlassen, damit sich jemand anderes um ihn kümmert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340926
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340926,
					"content": "#Das weiß Paimon! {NICKNAME} ist stark, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340927,
					"content": "#{F#Sie}{M#Er} hat in der Tat eine großartige Stärke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340928
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340928,
					"content": "#Aber wenn eines Tages etwas passiert und Paimon sich von {NICKNAME} trennen muss, wird Paimon auch sehr besorgt sein. Es geht nicht wirklich darum, ob {NICKNAME} stark ist oder nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340929
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340929,
					"content": "#Aber Paimon will kein Unglück heraufbeschwören! Jedenfalls nur eine Analogie! Paimon und {NICKNAME} sind die besten Freunde und wir werden uns nie trennen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340930,
					"content": "Paimon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340931
					]
				},
				{
					"id": 400340931,
					"content": "Die Argumentation von Paimon ist stichhaltig. Die einzige Frage, die sich daraus ergibt, ist, warum dieser Hund die Tiere der Dorfbewohner entführt und sie behält.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340932
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340932,
					"content": "Mhm ... ähm ... das weiß Paimon auch nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340933
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340933,
					"content": "#Leider kann auch Kageroumaru nicht sprechen, sonst hätte ich {NICKNAME} gebeten, das herauszufinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340934,
					"content": "Lass uns Sango suchen gehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340935
					]
				},
				{
					"id": 400340935,
					"content": "Gute Idee! Es ist Zeit, ihren Verstand zu benutzen. Also gehen wir sie suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340936
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340936,
					"content": "Gut, dann bringe ich diese Kleintiere zurück und wir treffen uns dann in der Detektei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340922,
					"content": "Auf Paimon kann man sich verlassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340923
					]
				}
			]
		},
		{
			"id": 4003410,
			"completionStepIds": [
				4003410
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003410",
							"2"
						],
						"stepId": 4003410,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400341001,
					"content": "Sango, wir sind zurück. Die Sache ist so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341002
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341002,
					"content": "Ach so. Ich kann wahrscheinlich verstehen, warum Kageroumaru die kleinen Tiere bewachte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341003
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341003,
					"content": "Er wollte diese kleinen Tiere stärker machen, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341004
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341004,
					"content": "Er war schwach, als er klein war, und wurde dann stark, richtig? Er wollte auch andere kleine Tiere durch Training dazu bringen, so stark wie er zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341005
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341005,
					"content": "#Später erkannte er {F#die Reisende}{M#den Reisenden} als seinen Herrn an, nachdem er {F#deren}{M#dessen} Bereitschaft gesehen hatte, die Schwachen zu beschützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341006
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341006,
					"content": "Das liegt auch an seinem Mitgefühl für die Schwachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341007
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341007,
					"content": "Aber das ist nur meine Schlussfolgerung aus den Hinweisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341008
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341008,
					"content": "Was die tatsächliche Situation angeht, so ist es meiner Meinung nach nicht weit entfernt. Aber da Kageroumaru nicht sprechen kann, gibt es keine Möglichkeit, eine eindeutige Antwort zu bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341009
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341009,
					"content": "Sango redet auch sehr vernünftig! Nicht schlecht für eine Intelligenzbestie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341010,
					"content": "Wuff, wuff, wuff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341011
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400341011,
					"content": "Oooh, bestätigst du auch, was Sango gesagt hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341012,
					"content": "Glaub nicht, dass ich dir bei deiner nächsten Mission einen Rabatt gewähre, wenn du mir schmeichelst. Aber dieser Fall ist abgeschlossen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341013
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341013,
					"content": "#Ich danke euch, {NICKNAME} und Paimon, dass dieser Fall dank euch abgeschlossen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341014
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341014,
					"content": "Ach ja, fast hätte ich es vergessen, was haltet ihr von dem „Netz der Ubiquität“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341015,
						400341016
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341015,
					"content": "Das ist prima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341017
					]
				},
				{
					"id": 400341017,
					"content": "Ja, das werde ich mir notieren. Ich werde mit meinem Freund darüber sprechen, danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341018
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341018,
					"content": "#Bitte sehr! Solltest du in Zukunft Probleme haben, kannst du dich gern an uns wenden! {NICKNAME} ist großartig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341019,
					"content": "#{F#Die}{M#Der} Reisende ist in der Tat stark, aber es ist nicht nötig, so höflich mit mir zu reden, schließlich sind Gefühle der Feind der Wahrheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341016,
					"content": "Immer besorgt, dass es kaputtgeht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341017
					]
				}
			]
		},
		{
			"id": 4003411,
			"completionStepIds": [
				4003411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003411",
							"2"
						],
						"stepId": 4003411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kageroumaru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400341101,
					"content": "Uff, endlich haben wir aufgeholt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341102,
					"content": "Hm? Vor ihm liegt ... ein Brief.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341103
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341103,
					"content": "Mal sehen, das ist die einzige Spur, die wir im Moment haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341104,
					"content": "Hmm! Mal sehen, was da drin steht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341105,
					"content": "„An denjenigen, der Glück ...“, ähm, es ist zu beschädigt, um es klar zu lesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341106,
					"content": "Vielleicht heißt es, „an denjenigen, der Glück hat“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341107,
					"content": "Ach ja, und dann steht darauf noch ... „Unsere Familie ist auf die Ausbildung von Ninken spezialisiert und hat Ninja viele, viele zuverlässige Begleiter beschert.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341108,
					"content": "„Der Einberufungsbefehl ist da und ich fürchte, es wird nicht einfach werden. Ich bereue nichts in meinem Leben, aber das Einzige, worüber ich mir Sorgen mache, ist Kageroumaru.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341109,
					"content": "„Als er klein war, war er zu schwach, und als die Ninja kamen, um den Vertrag abzuschließen, wurde er zurückgelassen. Aber das ist in Ordnung, als Trainerin gebe ich keinen Hund auf.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341110,
					"content": "„Nachdem er Tag für Tag hart gearbeitet hat, ist Kageroumaru wirklich immer stärker geworden. Es ist nur schade, dass er mit keinem Ninja einen Vertrag abschließen will.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341111,
					"content": "„Obwohl der Krieg noch nicht begonnen hat, wird das Drängen der Polizeistation immer dringender, und ich habe keine Zeit für etwas anderes, und die Zeit ist gekommen, in der ich gehen muss.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341112,
					"content": "„Ich kann nur diesen Brief zurücklassen. Falls jemand diesen Ort später finden kann, kümmere dich bitte für mich um Kageroumaru.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341113,
					"content": "„Er hat eine Narbe im Gesicht, die aus seiner Jugend stammt, und seine Aura unterscheidet sich von der eines normalen Hundes, sodass er sehr gut erkennbar ist.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341114,
					"content": "Der in dem Brief erwähnte Kageroumaru ist vermutlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341115,
					"content": "Der, der uns hierher gebracht hat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341116
					]
				},
				{
					"id": 400341116,
					"content": "Der Wiedererkennungswert ist in der Tat sehr hoch! Es gibt eine weitere Zeile auf dem Brief, mal sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341117,
					"content": "„Ich weiß, dass es eine undankbare Bitte ist, aber es gibt wirklich keine andere Möglichkeit, es zu tun. Und wenn er in Zukunft bereit ist, einen Vertrag abzuschließen und jemanden, der ihm gefällt, hierher bringen kann, dann ist die Methode des Vertragsabschlusses ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341118,
					"content": "Ups, das Wichtigste ist durchgestrichen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341119,
					"content": "Wahrscheinlich hätten sie es nicht für möglich gehalten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341120
					]
				},
				{
					"id": 400341120,
					"content": "In der Tat wollte Kageroumaru zunächst mit niemandem einen Vertrag abschließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341121,
					"content": "Wuff, wuff ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341122
					],
					"speakerTitle": "Kageroumaru"
