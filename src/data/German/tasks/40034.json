					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340102,
					"content": "Huch, ihr seid da wie erwartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340103
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340103,
					"content": "Was Ryuuji betrifft, so ist er nach den bisher gesammelten Hinweisen und meinen Überlegungen bereits zur Insel Yashiori gegangen, um dort Untersuchungen durchzuführen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340104
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340104,
					"content": "Ich habe den Weg auf deiner Karte markiert, wenn du dich beeilst solltest du ihn noch antreffen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340105
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340105,
					"content": "Was soll denn die plötzliche Eile? Hat Ryuuji nicht vorher in der Detektei auf uns gewartet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340106,
					"content": "Weil es dem Ende zugeht. Lasst uns schnell loslegen und die Wahrheit ans Licht bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340107
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340107,
					"content": "#Jetzt, da du das sagst, ist Paimon auch aufgeregt! Lass uns loslegen, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4003402,
			"completionStepIds": [
				4003402
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003402",
							"2"
						],
						"stepId": 4003402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340201,
					"content": "Ryuuji! Wir sind da!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340202,
					"content": "Ah, ihr seid es. Sango hat mich gebeten, zuerst vorbeizukommen, um das zu untersuchen, und sagte, ihr würdet später vorbeikommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340203
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340203,
					"content": "Nun, sie hat uns gesagt, dass du hier sein würdest! Wie laufen die Ermittlungen, Ryuuji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340204,
					"content": "Warum gibt es hier so viele Käfige mit kleinen Tieren darin? Wo sind die Leute denn hin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340205,
					"content": "Sie sind gerade weggegangen, es war eine Schatzräubergruppe. Sango erzählte mir, dass sie planen, Hunde zu stehlen, um sie zu „Schatzsuchhunden“ auszubilden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340206,
						400340208
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340206,
					"content": "Wie Schatzmader?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340207
					]
				},
				{
					"id": 400340207,
					"content": "Ja, genau wie Schatzmader. Nur scheiterte der Marder, weil er zu frech und ungehorsam war. Diesmal haben sie es auf den treueren „Hund“ abgesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340210
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340210,
					"content": "Ich habe schon viele Aufträge in Zusammenhang mit Schatzräubergruppen bearbeitet. Wenn ich so darüber nachdenke, hatte Sango tatsächlich recht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340211
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340211,
					"content": "So wie Menschen Fußspuren haben, hinterlassen auch Organisationen ihre eigenen, einzigartigen Spuren. Im Laufe des Geschehens verirren sich noch andere Tiere und werden gefangen, aber die Spuren führen letztendlich zu der Schatzräuber-Gruppe, die den Schatz gestohlen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340212
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340212,
					"content": "Nachdem ich mich über die damals verfügbaren Lösungen informiert hatte, habe ich dann hier nachgeforscht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340213
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340213,
					"content": "Es ist jedoch überraschend, dass sie keine einzige Wache hier zurückgelassen haben. Im Vergleich zu früheren Fällen sind die Täter diesmal viel leichtsinniger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340214
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340214,
					"content": "#Was für eine Gruppe von unvorsichtigen Bösewichten! Aber, {NICKNAME}, du bist müde von den ganzen Kämpfen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340215,
						400340216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340215,
					"content": "Während sie also weg sind ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340217
					]
				},
				{
					"id": 400340217,
					"content": "So machen wir es! He, wir haben den gleichen Gedanken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340216,
					"content": "Wir schmuggeln sie raus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340217
					]
				},
				{
					"id": 400340208,
					"content": "Wie Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340209
					]
				},
				{
					"id": 400340209,
					"content": "He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340210
					],
					"speakerTitle": "Paimon"
				}
			]
		},
