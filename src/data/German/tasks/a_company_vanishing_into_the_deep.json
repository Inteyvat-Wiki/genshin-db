			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620128,
					"content": "Und?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620131
					]
				},
				{
					"id": 710620131,
					"content": "Danach werden wir den Ort evakuieren, das verspreche ich im Namen unserer Ehre und unserer Vorfahren, die Snezhnaya verteidigt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620132
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620132,
					"content": "Igitt ... Dieser arme Kleine, wie hungrig er ist ... Wie erbärmlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620133
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620133,
					"content": "Hör auf, du bist nicht besser ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620134
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620134,
					"content": "Wir kamen mit vierundsechzig Leuten an, vierundsechzig Leute! Jetzt sind nur noch vier hungrige Mäuler übrig, wogegen können wir uns noch verschwören?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620135
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620135,
					"content": "Wah ... Wie habt ihr euch nur in so einen Schlamassel gebracht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620136,
					"content": "Das ist ein anderes Thema ... Und ohne Nahrung sind die letzten Mitglieder der neunten Kompanie in Gefahr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
