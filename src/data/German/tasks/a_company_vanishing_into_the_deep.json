			},
			"dialogs": [
				{
					"id": 710621001,
					"content": "Und überhaupt, vielen Dank, dass du deine Nahrung geteilt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621002
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621002,
					"content": "Wir werden einen Weg hier raus finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
		{
			"id": 7106211,
			"completionStepIds": [
				7106207
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106207",
							"2"
						],
						"stepId": 7106207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton",
					"Radomir",
					"Danila",
					"Temur"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710621101,
					"content": "Ihr seid zurück, wie war es, gibt es neue Nachrichten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621102
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621102,
					"content": "Die Nachschubstation wurde aufgegeben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621103
					]
				},
				{
					"id": 710621103,
					"content": "So ist das also. Habt ihr etwas gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621104
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621104,
					"content": "Liyue heißt euch nicht mehr willkommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621105
					]
				},
				{
					"id": 710621105,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621106
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621106,
					"content": "Gibt es darüber hinaus irgendwelche Neuigkeiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621107
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621107,
					"content": "Nun ... Wir haben auch einen Brief gefunden, der anscheinend für dich hinterlassen wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710621108,
					"content": "Hier ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621109
					]
				},
				{
					"id": 710621109,
					"content": "Der Brief ging eine Zeit lang unter den Mitgliedern der Fatui um ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710621110
					]
				},
				{
					"id": 710621110,
					"content": "Ah, das ist der junge Yanbo. Ich verstehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621111
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621111,
					"content": "Was ist hier los? Haben sich die Millelithen zurückgezogen? Zeig mir das auch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621112
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621112,
					"content": "*seufz* Was ist los mit ihnen? Wir kämpfen für sie! Sind wir nicht Verbündete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621113
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710621113,
					"content": "Es gibt keine Verbündeten mehr. Keine Zusammenarbeit mehr ... Ausgerechnet wir, die Fatui, hatten die diplomatischen Beziehungen zu Liyue abgebrochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621131
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621131,
					"content": "Das ist Verrat! Wir sind von den Leute in Liyue verraten worden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621132
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710621132,
					"content": "Vielleicht gilt für die Menschen in Liyue das Gegenteil? Wir, die Fatui, sind es, die sie verraten haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621114
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621114,
					"content": "Das kann nicht sein! Wir sind hier, um das Volk von Liyue zu beschützen! Weißt du noch, was der Kapitan-Poruchik sagte, bevor wir aufbrachen? „Diese Expedition hat nichts mit irgendwelchen kleinlichen Machenschaften zu tun!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621115
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710621115,
					"content": "Aber wir können die kleinlichen Machenschaften nicht aufhalten ... Wir können sie nicht kontrollieren, Danila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621116
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710621116,
					"content": "Na gut, ich habe verstanden. Puh ... Ich habe beschlossen, dass wir hier raus müssen, je früher, desto besser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621117
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621117,
					"content": "Das ist in Ordnung, ich übernehme die volle Verantwortung. Wenn es einen Deserteur unter uns gibt ... Wenn es einen Deserteur gibt, der die neunte Kompanie in Verruf bringt, dann bin ich das, und nur ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621118
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621118,
					"content": "Danila hat recht, wir sind hier, um die Leute von Liyue vor der pechschwarzen Katastrophe zu schützen, wir können nicht einfach in Schande abreisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621119
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621119,
					"content": "Meinst du, dass das der richtige Zeitpunkt ist, um über persönlichen Stolz zu sprechen, Mirka? Siehst du das nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621120
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621120,
					"content": "Die Leute in Liyue brauchen unseren Schutz nicht und sie heißen uns nicht willkommen! Sie haben sogar unsere hochmütigen Kameraden besiegt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621121,
						710621122
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621121,
					"content": "Ja, ihr habt das Vertrauen des Volkes von Liyue missbraucht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				},
				{
					"id": 710621123,
					"content": "Bereiten wir uns auf die Evakuierung vor und achten wir darauf, dass wir so leise wie möglich gehen, ohne die örtlichen Millelithen zu alarmieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621124
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621124,
					"content": "Der Kapitan-Poruchik sagte, dass wir bereit sein sollten, unser Leben hier zu geben, also zumindest ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621125
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621125,
					"content": "Der Kapitan-Poruchik sagte, dass er nicht zulassen werde, dass auch nur ein Menschenopfer sinnlos sei! Er sagte, er wolle nicht, dass ich die Kompanie verliere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621126
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621126,
					"content": "Zumindest sind wir noch am Leben, was bedeutet, dass die neunte Kompanie noch existiert, verstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621127
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621127,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621128
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621128,
					"content": "Verstanden, Kompanieführer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621129
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621129,
					"content": "Gut, hat sonst noch jemand eine Frage? Ich möchte keine Einwände hören. Weggetreten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621130
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621130,
					"content": "#Wie auch immer, {NICKNAME}, vielen Dank für deine Hilfe. Bitte nimm diese Mora und Vorräte mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621122,
					"content": "Ihr denkt wohl an euren Ausweg.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				}
			]
		},
