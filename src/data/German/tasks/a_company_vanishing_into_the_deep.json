	"talks": [
		{
			"id": 7106201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106201",
							"2"
						],
						"stepId": 7106201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620101,
					"content": "Puh ... Entschuldige, dass ich euch aufhalte, wenn ihr es eilig habt. Ich bin Serzhant Anton Melnikov, der ... stellvertretende Kompanieführer der neunten Kompanie. Nenn mich einfach Anton.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620102
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620102,
					"content": "Das sind Danila, Temur, Radomir und ... äh, Romanski, der im Moment nicht hier ist, er ist im ... Sanitätslager.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620103
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620103,
					"content": "Es gibt keinen Romanski mehr, kein Sanitätslager mehr, Antoha ... Er hat es heute Morgen nicht geschafft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620104
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620104,
					"content": "Danila, Danila ... Wie oft habe ich dir schon gesagt, dass ich der Kompanieführer bin, nenn mich Serzhant Anton!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620105
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620105,
					"content": "Ha! Kompanieführer! Serzhant! Antoha, du ... seit der Kapitan-Poruchik verschwunden ist, führst du dich immer so auf! Ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620106
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620106,
					"content": "Das reicht, Temur, alter Junge ... Du bist dumm vor Hunger. Spare deine Kraft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620107
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620107,
					"content": "Das heißt stellvertretender Kompanieführer, Antoha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620149
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620149,
					"content": "„Stellvertretender Kompanieführer“! „Stellvertretender Kompanieführer“! Wie lange müssen wir dieses Spiel noch mitmachen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620150
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620150,
					"content": "Ich sage dir, Temur, du bist so hungrig, dass du nicht mehr richtig nachdenken kannst. Also wie wäre es, wenn du meine Faust kostest? Vielleicht ist dein Kopf dann etwas klarer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620151
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620151,
					"content": "Ja klar, komm doch! Lass mich dir auch eine Geschmacksprobe geben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620152
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620152,
					"content": "Großartig, jetzt ist es an der Zeit, unseren Verstand und unsere Geduld zu fressen ... Nachdem wir unser letztes Stück Bewusstsein verdaut haben, wird nur noch sehr wenig von dem, was wir „uns“ nennen, in dieser Welt übrig bleiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620108
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620108,
					"content": "Ähem ... Seid still! Wollt ihr kämpfen? Wenn ihr kämpfen wollt, dann geht hin und kämpft! Bekämpft die Dinge, die aus dem schwarzen Schlamm kommen! Geht mit knurrendem Magen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620109
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620109,
					"content": "Wenn wir überleben wollen, wenn wir hier rauskommen wollen, müssen wir zusammenhalten! Zwingt mich nicht, es noch einmal zu wiederholen, verstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620110
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620110,
					"content": "Eins, zwei und jetzt alle! Niemand außer uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620111
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620111,
					"content": "Niemand außer uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620112
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620112,
					"content": "Niemand außer uns ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620113
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620153
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620153,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620114
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620114,
					"content": "Wie du sehen kannst, mein Freund, sind wir etwas ... ähm, nicht in Kampfform. Immerhin hat es in letzter Zeit einen kleinen Rückschlag gegeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620115
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620115,
					"content": "Hm ... ein „kleiner Rückschlag“! Er kommt ganz nach dem Kapitan-Poruchik ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620116
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620116,
					"content": "Wenn der Kapitan-Poruchik nicht da ist, bin ich der Kompanieführer! Spart euch euren Atem und haltet den Mund!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620117
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620117,
					"content": "Tut mir leid ... mein Freund, wir brauchen jetzt dringend deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
		{
			"id": 7106202,
			"completionStepIds": [],
