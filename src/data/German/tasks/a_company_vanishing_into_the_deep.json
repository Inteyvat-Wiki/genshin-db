			},
			"dialogs": [
				{
					"id": 710620139,
					"content": "(Abbruch der Kommunikation) Deine Mütze gefällt mir nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7106216,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7106205",
							"1"
						]
					},
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7106202",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620118,
					"content": "Seit wann sind wir „Freunde“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620121
					]
				},
				{
					"id": 710620121,
					"content": "Nachschub, Waffen, Informationen oder Mora? An all dem mangelt es uns nicht. All dies kann als Bezahlung angeboten werden, wenn du bereit bist zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620122
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620122,
					"content": "Sieh mal, unser Bettler-Kompanieführer selbst hat die erniedrigendste Aufgabe übernommen ... Wie wunderbar. Das bisschen Ehre, die wir noch haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620123
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620123,
					"content": "Du solltest auch den Sarkasmus weglassen, Sarkasmus füllt den Magen nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620124
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620124,
					"content": "„Schließt euch uns an und lasst unsere Stiefel die Erde wie Donner erschüttern. Wir werden diejenigen, die uns zum Stern der weißen Nacht folgen werden, niemals im Stich lassen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620125
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620125,
					"content": "Jemand soll ihn zum Schweigen bringen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620126
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620126,
					"content": "Nun ... So schlecht sie auch alle sind, es ist ziemlich traurig, sie so zu sehen. Alle sind so hungrig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620127,
					"content": "Es ist eine Schande, das zu sagen ... aber wie du siehst, können wir nicht mehr kämpfen ... Wir sind nur ein paar Leute, die um Essen bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
		{
			"id": 7106217,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7106205",
							"1"
						]
					},
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7106202",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620119,
					"content": "Warum soll ich euch helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620121
					]
				},
				{
					"id": 710620121,
					"content": "Nachschub, Waffen, Informationen oder Mora? An all dem mangelt es uns nicht. All dies kann als Bezahlung angeboten werden, wenn du bereit bist zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620122
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620122,
					"content": "Sieh mal, unser Bettler-Kompanieführer selbst hat die erniedrigendste Aufgabe übernommen ... Wie wunderbar. Das bisschen Ehre, die wir noch haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620123
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620123,
					"content": "Du solltest auch den Sarkasmus weglassen, Sarkasmus füllt den Magen nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620124
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620124,
					"content": "„Schließt euch uns an und lasst unsere Stiefel die Erde wie Donner erschüttern. Wir werden diejenigen, die uns zum Stern der weißen Nacht folgen werden, niemals im Stich lassen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620125
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620125,
					"content": "Jemand soll ihn zum Schweigen bringen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620126
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620126,
					"content": "Nun ... So schlecht sie auch alle sind, es ist ziemlich traurig, sie so zu sehen. Alle sind so hungrig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620127,
					"content": "Es ist eine Schande, das zu sagen ... aber wie du siehst, können wir nicht mehr kämpfen ... Wir sind nur ein paar Leute, die um Essen bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
		{
			"id": 7106218,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_OR",
