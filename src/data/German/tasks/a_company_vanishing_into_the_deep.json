			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620137,
					"content": "Sagt uns erst euer Ziel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620140
					]
				},
				{
					"id": 710620140,
					"content": "Lass es mich so sagen, egal, was du von uns hältst. Unser Auftrag zielte auf die Quelle der Katastrophe der Großen Kluft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620141
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620141,
					"content": "Was für eine Katastrophe ... Ist die Große Kluft nicht in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620142,
					"content": "Die Katastrophe von vor fünfhundert Jahren war nur das Vorspiel für den Krieg. Der Krieg gegen den dunklen Feind geht weiter und eines der Schlachtfelder liegt unter unseren Füßen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620143
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620143,
					"content": "Leider ist unser Serzhant Kompanieführer hungrig genug, um große Töne zu spucken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620144
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620144,
					"content": "Er war schon immer ein großer Redner ... aber das ist das erste Mal, dass er Unsinn redet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620145
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620145,
					"content": "Vergiss es, vergiss es ... Was Antoha damit sagen wollte, ist, dass ... ihr, die Leute von Liyue, nicht unsere Feinde sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620146
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620146,
					"content": "Zumindest nicht der Feind unserer neunten Kompanie in dieser Mission ... aber das gilt nicht unbedingt für die anderen in der Gegend versprengten Männer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620147
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620147,
					"content": "Aus Menschlichkeit werde ich dir helfen, aber das gilt nicht für jedes Mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620148
					]
				},
				{
					"id": 710620148,
					"content": "Danke ... Danke euch! Das werden wir nicht vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
