			},
			"dialogs": [
				{
					"id": 710620202,
					"content": "Bitte nimm unsere Bitte in Betracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620201
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620201,
					"content": "Hier ist das Essen, das ihr wolltet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7106207,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106203",
							"2"
						],
						"stepId": 7106203,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"7106202"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Anton",
					"Danila",
					"Temur",
					"Radomir"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620701,
					"content": "Diese Typen sind so schwach, zwei Tritte und sie sind erledigt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620702,
					"content": "Bitte aufhören! Bitte hört auf zu treten! Gebt uns einfach etwas zu essen und wir tun, was ihr wollt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620703
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620703,
					"content": "Hm ... Diese Typen sehen aus, als hätten sie wirklich Hunger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620704,
						710620705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620704,
					"content": "Sagt uns erst euer Ziel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				},
				{
					"id": 710620706,
					"content": "Lass es mich so sagen, egal, was du von uns hältst. Unser Auftrag zielte auf die Quelle der Katastrophe der Großen Kluft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620707
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620707,
					"content": "Was für eine Katastrophe ... Ist die Große Kluft nicht in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620708,
					"content": "Die Katastrophe von vor fünfhundert Jahren war nur das Vorspiel für den Krieg. Der Krieg gegen den großen Feind geht weiter und eines der Schlachtfelder liegt unter unseren Füßen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620709
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620709,
					"content": "Leider ist unser Serzhant Kompanieführer hungrig genug, um große Töne zu spucken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620710
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620710,
					"content": "Er war schon immer ein großer Redner ... aber das ist das erste Mal, dass er Unsinn redet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620711
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620711,
					"content": "Vergiss es, vergiss es ... Was Antoha damit sagen wollte, ist, dass ... ihr, die Leute von Liyue, nicht unsere Feinde sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620712
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620712,
					"content": "Zumindest nicht der Feind unserer Gruppe ... aber das gilt nicht unbedingt für die anderen in der Gegend versprengten Männer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620713
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620713,
					"content": "Na gut ... Ich werde dir helfen, aber das ist nur eine Ausnahme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710620705,
					"content": "Wie soll ich euch vertrauen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				}
			]
		},
		{
			"id": 7106209,
			"completionStepIds": [
				7106205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106205",
							"2"
						],
						"stepId": 7106205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton",
					"Danila",
					"Temur",
					"Radomir",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620901,
					"content": "*seufz* ... Das tut mir so leid. Wir hatten eine kleine ... Panne in unserem Kommandonetzwerk ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620902
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620902,
					"content": "„Kleine“! „Panne“? Wir kämpfen völlig unterlegen! Wir sehen zu, wie Außenseiter unsere eigenen Kameraden ausschalten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620903
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620903,
					"content": "Was noch? Sollen wir zulassen, dass sie uns verprügeln und uns unser Essen wegnehmen? Ich schlage vor, du schluckst erst herunter, was du im Mund hast, bevor du sprichst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620904
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620904,
					"content": "Antoha, hör auf, es herunterzuspielen. Unsere Befehlskette ist ausgelöscht worden. Sie ist weg! Alle ranghöheren Offziere sind entweder verschwunden oder wurden getötet ... Das lässt uns keine andere Wahl, als uns zurückzuziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620905
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620905,
					"content": "Doch viele waren noch nicht bereit, sich zurückzuziehen ... Sie ziehen es vor, die Überreste ihrer Offiziere zu bewachen und zu kämpfen, bis der letzte Mann fällt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620906
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620906,
					"content": "Sie hungern bis zum letzten Mann ... Gemäß der Kooperationsvereinbarung wurde unsere Nahrung und Befehle von den Oberen geliefert, aber wir hörten lange Zeit nichts von ihnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620907
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620907,
					"content": "Es stimmt, dass unsere Loyalität gegenüber den Fatui und den Elf nicht in Frage gestellt werden darf, aber wir sind nicht dumm ... Was diese Situation angeht, ist es das Beste, sich zurückzuziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620908
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620908,
					"content": "Was sind also eure Pläne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620909
					]
				},
				{
					"id": 710620909,
					"content": "Nun ... Ich weiß, dass dies wahrscheinlich nichts mit dir zu tun hat. Wenn du umkehrst und gehen willst, ist das deine Sache, aber wir sind in einer verzweifelten Lage und brauchen deine Hilfe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620910,
						710620912
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620910,
					"content": "Ich muss darüber nachdenken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620911
					]
				},
				{
					"id": 710620911,
					"content": "Also ... Bitte sei vorsichtig auf dem Weg. Die anderen Kameraden, die noch da sind, werden nicht so freundlich sein wie wir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620913
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620913,
					"content": "Es ist sehr unpassend, dir das mitzuteilen, aber ... es gibt eine Nachschubstation in der Nähe der Oberfläche. Sie ist für die Übermittlung von Lieferungen für uns verantwortlich und manchmal auch für die Übermittlung von Befehlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620914
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620914,
					"content": "Einige meiner Kameraden waren schon früher hochgeschickt worden, um Nahrungsmitteltransporte anzufordern, aber sie kehrten nicht zurück ... Ich konnte es mir nicht leisten, ein weiteres Risiko einzugehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620915
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620915,
					"content": "Und von der Nachschubstation ist schon lange niemand mehr heruntergekommen ... Wir hoffen, dass du sie für uns auskundschaften kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620916,
						710620917
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620916,
					"content": "Lass mich darüber nachdenken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620918,
					"content": "Es tut mir leid, dich zu stören, aber ich muss wissen, was da oben vor sich geht ... Ansonsten ist es keine gute Idee, etwas Unüberlegtes zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620919
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620919,
					"content": "Na los! Sag nicht so viele schlimme Dinge! Wir werden aufpassen, wenn wir dort vorbeikommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620917,
					"content": "Ich werde helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620912,
					"content": "Was brauchst du von mir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620913
					]
				}
			]
		},
		{
			"id": 7106210,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
