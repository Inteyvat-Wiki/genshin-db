				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330101,
					"content": "Oh ... Die Szene ist genau in der Mitte der Bühne ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330102,
					"content": "Was machen die beiden da ... Es sieht so aus, als ob der eine etwas sagt und der andere ruhig auf dem Boden sitzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330103,
					"content": "Paimon versteht! Dies muss eine Szene des Geschichtenerzählens sein! Es muss Schlafenszeit für sie sein, also erzählt sie eine Geschichte für die Person, die auf dem Boden sitzt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330104,
					"content": "Hören die Fatui auch gern Gutenachtgeschichten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330105
					]
				},
				{
					"id": 790330105,
					"content": "Vielleicht gibt es auch ein paar unter den Fatui, die dieses Bedürfnis haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330106,
					"content": "Agafya, Persikov hat uns befohlen, einige Tests zum Signalempfang durchzuführen. Sieht aus, als müssten wir alle vier gehen ... Wenn Chevka davon hörte, würde er wieder wütend werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330107,
					"content": "Komm schon, Yakov, das sind Befehle von oben, Chevka wird dir deshalb nicht böse sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330108,
					"content": "*seufz* Wenn du wirklich so viel Angst hast, kann ich dich auch zum Gespräch mit Chevka begleiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330109,
					"content": "Sie hat also doch keine Geschichte erzählt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330110,
					"content": "Aber dieser Schnipsel kommt irgendwie aus dem Nichts. Wir können nicht erkennen, was überhaupt los ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7903302,
			"completionStepIds": [
				7903307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7903307",
							"2"
						],
						"stepId": 7903307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330201,
					"content": "Wie kann eine solche Meeresschnecke vom Boden des Brunnens aufschwimmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330202,
						790330203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330202,
					"content": "Schließlich werden die Meeresschnecken von den Illusionen beeinflusst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				},
				{
					"id": 790330204,
					"content": "#Ja, wirklich ein Wunder ... Ah, eine neue Szene, {NICKNAME}, schau! Da beugt sich jemand ... Ooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330205,
					"content": "#{NICKNAME}, beweg dich nicht! Hinter dir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330206,
						790330207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330206,
					"content": "Is... Ist es etwas Gruseliges ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330208,
					"content": "Ah, bei einem genaueren Blick ist es nur eine Szene aus der Meeresschnecke. Es ist wirklich erschreckend zu sehen, wie es plötzlich hinter dir auftaucht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330209,
					"content": "Zwei Signalprüfgeräte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330210,
					"content": "Weißt du, ich habe ehrlich gesagt gedacht, dass er dieses Mal in ernsthaften Schwierigkeiten steckt. Wer hätte gedacht, dass nur etwas lästigere Arbeit dabei rauskommt! Das war eine Erleichterung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330211,
					"content": "Ha! Du hättest sehen sollen, wie viel Angst er davor hatte, von dir gescholten zu werden. Es war fast so, als würde ein kleiner Bruder bei dem Gedanken, dass sein älterer Bruder mit ihm schimpft, niederkauern. Meinst du, er hat nur Angst, uns zu enttäuschen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330212,
					"content": "Ich meine, wir sind nur ein Trupp ... aber manchmal fühlt es sich so an, als wären wir auch eine Familie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330213,
					"content": "Familie, hm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330214,
					"content": "Paimon hat das Gefühl, dass wir gerade etwas belauscht haben, was wir nicht hätten tun sollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330215,
					"content": "Um ehrlich zu sein, scheinen diese Fatui gar nicht so schlecht zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330207,
					"content": "Paimon, mach mir keine Angst!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330203,
					"content": "Wahrscheinlich gab es eine Luftblase in der Schale ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				}
			]
		},
		{
			"id": 7903303,
			"completionStepIds": [
				7903305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7903305",
							"2"
						],
						"stepId": 7903305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330301,
					"content": "Es sieht so aus, als wären da zwei Personen auf dem Boden liegend ... Schauen sie sich die Sterne am Himmel an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330302,
					"content": "Paimon findet, dass es eine seltsame Szene ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330303,
					"content": "Yakov, was hat der Kommandant zu dir gesagt, dass du so niedergeschlagen bist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330304,
					"content": "Nun, die Wellen waren wirklich kabbelig, also bin ich ausgerutscht und gefallen, während ich den Apparat trug. Zum Glück war ich schnell genug, um ihn zu retten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330305,
					"content": "Aber der Kommandant hat mir trotzdem ein Ohr abgekaut und unserem Trupp befohlen, den Signalempfang zu testen. Ich meine, das ist die härteste Arbeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330306,
					"content": "Ach komm schon, sei nicht so niedergeschlagen. Wir haben so etwas schon hundertmal gemacht. He, Kopf hoch! Iss erstmal etwas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330307,
					"content": "Welche Art von Essen meinten sie, als sie auf einen so hohen Ort zeigten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330308,
					"content": "Oder diese Meeresschnecke wurde irgendwie in einem falschen Winkel angebracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}