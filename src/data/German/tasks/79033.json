	"talks": [
		{
			"id": 7903301,
			"completionStepIds": [
				7903306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7903306",
							"2"
						],
						"stepId": 7903306,
						"stateName": "QUEST_STATE_UNFINISHED"
