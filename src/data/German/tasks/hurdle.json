			},
			"dialogs": [
				{
					"id": 3880101,
					"content": "Das ist die <color=#00E1FFFF>Windbarriere</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3880102,
					"content": "Paimons Güte! Das sieht wirklich total gefährlich aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3880103,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880104
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3880104,
					"content": "Diese hölzerne Leier ist zwar alles, was ich habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880105
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3880105,
					"content": "Aber ich brauche Der Himmel nicht, um die Barriere zu durch... Was? Was ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880106
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3880106,
					"content": "Feinde in Sicht! Alle Mann vorbereiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		},
		{
