			"dialogs": [
				{
					"id": 3880301,
					"content": "Seltsam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880302
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3880302,
					"content": "Hilichurle ... halten sich normalerweise nicht an Orten auf, an denen elementare Kräfte so intensiv wirken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880303
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3880303,
					"content": "Für ihre Körper ist das eine große Anstrengung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880304
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3880304,
					"content": "Der Orden des Abgrunds muss sie heimlich steuern. Aber wie hätte er wissen sollen, dass wir herkommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880305
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3880305,
					"content": "Wahrscheinlich verteilt er seine Streitkräfte so, dass sie unsere Bewegungen einschränken können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880306
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3880306,
					"content": "Wir sollten uns beeilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880307
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3880307,
					"content": "Diesmal ist der Wind mein einziger Zuhörer. Da kann ich wohl ruhig etwas schneller spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
