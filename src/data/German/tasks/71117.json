			"dialogs": [
				{
					"id": 711170401,
					"content": "Oh ... auf dieser Steintafel steht geschrieben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711170402,
					"content": "Man muss nur ein Stück rohes Fleisch in den Fluss werfen und schon wird ein alter Freund heraufbeschworen, den man lang nicht mehr gesehen hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170403,
						711170406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711170403,
					"content": "Kann Paimon auch verstehen, was die Inschrift besagt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711170404
					]
				},
				{
					"id": 711170404,
					"content": "Du sollst Paimon nicht unterschätzen! Mach dir einen Reim aus dem, was du verstehst, dann bekommst du schon ungefähr die Bedeutung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711170405,
					"content": "Schau, Paimon kann die letzten beiden Zeilen lesen, also ist es genau die richtige Bedeutung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711170408,
					"content": "Auf jeden Fall werfen wir das rohe Fleisch in den Fluss. Wer weiß, vielleicht taucht ja ein Adept auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711170406,
					"content": "Hm ... Es geht wohl eher darum, einem Freund zu gedenken, indem man Essen ins Wasser wirft ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711170407
					]
				},
				{
					"id": 711170407,
					"content": "Wirklich? ... Paimons Interpretation ist jedenfalls auch nicht falsch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170408
					],
					"speakerTitle": "Paimon"
				}
			]
		}
