			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hongyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210101,
					"content": "Wie ist es nur dazu gekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210102
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210102,
					"content": "Stimmt etwas nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210103
					]
				},
				{
					"id": 718210103,
					"content": "Die Laternen lösen sich nach dem Laternenritual nicht einfach in Luft auf, weißt du? Sie müssen manuell geborgen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210104
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210104,
					"content": "Natürlich sieht es ziemlich hübsch aus, wenn sie so majestätisch durch die Lüfte schweben, aber sie können sich auch zu einer echten Plage entwickeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210105
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210105,
					"content": "Wenn der Schirm einer Laterne nicht ordentlich gebaut ist, zerbricht sie mitten in der Luft und lässt nur einen Klumpen von Plaustrit zurück, der dann überall zu Boden geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210106
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210106,
					"content": "Manche Laternen werden auch vom Wind fortgeweht und bleiben dann in irgendwelchen Nischen hängen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210107
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210107,
					"content": "Während das erste Szenario zu Sicherheitsproblemen führt, wird beim zweiten Szenario unsere Stadtlandschaft verschmutzt. Daher beauftragt der Rat für Allgemeine Angelegenheiten normalerweise jedes Jahr eine Person, die für die Bergung der Laternen verantwortlich ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210108
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210108,
					"content": "Und wie es der Zufall so will, bin ich dieses Jahr an der Reihe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210109
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210109,
					"content": "Aber die Menge an Laternen, die beim Fest aufgestiegen sind, ist schier gewaltig ... Ich bin erledigt, wenn ich die alle am Tag nach dem Ende der Feierlichkeiten bergen muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210110
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210110,
					"content": "Die einzig praktikable Möglichkeit ist also, die beschädigten und verloren gegangenen Laternen nach und nach zu entfernen, nachdem sie von den Leuten losgeschickt wurden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210111
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210111,
					"content": "Und selbst dann bezweifle ich, dass ich sie alle alleine einsammeln kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210112
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210112,
					"content": "#{F#Reisende}{M#Reisender}, würde es dir was ausmachen, an ein paar Orte zu gehen und nachzusehen, ob dort Laternen geborgen werden müssen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210113
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210113,
					"content": "Ich werde es natürlich tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210114
					]
				},
				{
					"id": 718210114,
					"content": "Ich habe die Orte auf deiner Karte markiert. Vielen Dank für deine Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hongyu"
				}
			]
		},
		{
			"id": 7182102,
			"completionStepIds": [
				7182108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182108",
							"2"
						],
						"stepId": 7182108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flinke Faust Ling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210201,
					"content": "Das ist unfair!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210202
					],
					"speakerTitle": "Flinke Faust Ling"
				},
				{
					"id": 718210202,
					"content": "Was machst du hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210203
					]
				},
				{
					"id": 718210203,
					"content": "Ich ... Ach, ich fange lieber ganz von vorne an. Mein Meister hat vor Kurzem eine neue Tritt-Technik entwickelt. Ungeheuer kraftvoll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210204
					],
					"speakerTitle": "Flinke Faust Ling"
				},
				{
					"id": 718210204,
					"content": "Aber er behauptet, ich würde nicht ernsthaft genug trainieren und müsste noch an meinen Grundlagen arbeiten. Er will mir seine neue Technik einfach nicht beibringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210205
					],
					"speakerTitle": "Flinke Faust Ling"
				},
				{
					"id": 718210205,
					"content": "Ich hatte vor, das Laternenritual zu meinem Vorteil zu nutzen und ihm eine hübsche Laterne zu schenken, um ihn so ein wenig zu erweichen. Ein Stimmungswandel könnte ja vielleicht einen ganzen Gesinnungswandel auslösen, und dann würde er mir seine Technik beibringen, nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210206
					],
					"speakerTitle": "Flinke Faust Ling"
				},
				{
					"id": 718210206,
					"content": "Aber ich konnte kein Plaustrit auftreiben. Und als ich dann diese Laterne sah, die dort hängengeblieben ist, wollte ich mir das Plaustrit holen, das drinnen ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210207
					],
					"speakerTitle": "Flinke Faust Ling"
				},
				{
					"id": 718210207,
					"content": "Du hast selber gesehen, was dann passiert ist ... Ach, ich verdiene diese Laterne einfach nicht. Du kannst sie haben, wenn du willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210208
					],
					"speakerTitle": "Flinke Faust Ling"
				},
				{
					"id": 718210208,
					"content": "Die Begegnung mit diesen Monstern hat mir deutlich gezeigt, dass meine Kampfkunst-Grundlagen ganz schon zu wünschen übriglassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flinke Faust Ling"
				}
			]
		},
		{
			"id": 7182103,
			"completionStepIds": [
				7182110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
