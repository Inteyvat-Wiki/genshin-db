			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hongyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210301,
					"content": "Hast du schon alle Orte überprüft, die ich für dich markiert habe? Konntest du bereits irgendwelche Laternen bergen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210302
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210302,
					"content": "Insgesamt drei Laternen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210303
					]
				},
				{
					"id": 718210303,
					"content": "Vielen Dank. Es hätte viel Arbeit für mich bedeutet, die Laternen an diesen Orten zu bergen. Ganz zu schweigen davon, dass mich jede kleine Reise fix und fertig macht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210304
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210304,
					"content": "Mit deiner Hilfe kann ich mich nun aber endlich in Frieden ausruhen. Nimm also bitte dies hier für deine Bemühungen an. Du hast es dir mehr als verdient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hongyu"
				}
			]
		},
		{
			"id": 7182104,
			"completionStepIds": [],
