			"dialogs": [
				{
					"id": 718210401,
					"content": "Sie lassen sie aufsteigen, sie holen sie zurück, und so weiter und so fort. Bin ich etwa der Einzige, dem auffällt, wie sinnlos das alles ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hongyu"
				}
			]
		},
