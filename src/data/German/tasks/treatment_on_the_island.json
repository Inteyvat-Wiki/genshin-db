				"objectNames": [
					"Yasumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380401,
					"content": "#Vielen Dank, {NICKNAME}. Es tut mir leid, wenn ich dich störe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380402,
						721380403
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380402,
					"content": "Nein, schon gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380404
					]
				},
				{
					"id": 721380404,
					"content": "Ich habe ein neues Rezept mit den Kräutern gemischt, die du gesammelt hast. Aber ich habe keine Testpersonen, um die Wirksamkeit der Medizin zu beurteilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380405
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380405,
					"content": "#{NICKNAME}, kannst du bitte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380406
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380406,
					"content": "Bitte sage es mir geradeheraus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380407
					]
				},
				{
					"id": 721380407,
					"content": "#{NICKNAME}, kannst du Zeuge von der Wirksamkeit des Medikaments an mir werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380408
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380408,
					"content": "Das neue Rezept ist noch instabil und es gibt nun keine Möglichkeit, die schlimmsten Folgen vorherzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380409
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380409,
					"content": "Also hoffe ich, dass wenigstens jemand meinen Erfolg miterlebt ... der die Konsequenzen des Misserfolges für mich tragen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380410
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380410,
					"content": "Oh ... Na gut ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721380403,
					"content": "Du bist zu nett.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380404
					]
				}
			]
		},
		{
			"id": 7213805,
			"completionStepIds": [
				7213806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
