	"talks": [
		{
			"id": 7213801,
			"completionStepIds": [
				7213801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213801",
							"2"
						],
						"stepId": 7213801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Yasumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380101,
					"content": "Oooh! Ich bin ... keine verdächtige Person. Ich bin nur ein lokaler Arzt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380102
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380102,
					"content": "Wenn ihr mir nicht glaubt, kann ich euch zu mir nach Hause bringen. Wenn ihr etwas möchtet, nehmt ihr es. Bitte lasst mich einfach gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380103
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380103,
					"content": "Oder bringt mich zu eurem General Kujou! Er kennt mich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380104,
						721380105
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380104,
					"content": "Vielleicht ist das ein Missverständnis ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				},
				{
					"id": 721380106,
					"content": "He! Ihr seht nicht aus wie jemand aus der Bakufu-Armee ... oder aus Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380107
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380107,
					"content": "Seid ihr ... Fremde? Warum seid ihr hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380108,
						721380109
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380108,
					"content": "Hm ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380110,
					"content": "Oh ... Ihr solltet jedenfalls so schnell wie möglich von hier verschwinden. Die Insel Yashiori ist jetzt sehr gefährlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380111
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380111,
					"content": "Bislang gibt es keine Anzeichen dafür, dass die „Tatarigami“ verschwinden werden. Die Tenryou-Verwaltung wird sich noch nicht zurückziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380112
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380112,
					"content": "Die Insel ist nicht mehr bewohnbar, geschweige denn für Besichtigungen geeignet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380113
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380113,
					"content": "#Wenn du {F#eine Fremde}{M#ein Fremder} bist, {F#die}{M#der} geflohen ist, um sich der Verhaftung der Verwaltung zu entziehen, gehst du nach Westen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380144
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380144,
					"content": "Die Tenryou-Verwaltung nimmt keine unbekannten Flüchtlinge auf. Aber die Piraten nehmen dich vielleicht auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380114,
						721380115
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380114,
					"content": "Was ist passiert auf der Insel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380116,
					"content": "Hm ... Sieh dir selbst an, was die Stadtmenschen und die Sangonomiya mit uns gemacht haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380117
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380117,
					"content": "Zuerst war es die Explosion in Tatarasuna. Der Himmel war in dieser Nacht mit seltsamen Farben gefärbt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380140
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380140,
					"content": "Viele Verwandte und Freunde verloren ihre Arbeit und leben in Armut. Viele andere wurden schwer verletzt und waren schrecklich anzusehen, als sie endlich nach Hause kamen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380141
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380141,
					"content": "Viele Freunde ... haben es nicht geschafft, zu entkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380118
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380118,
					"content": "Dann zerstörten die Menschen aus Sangonomiya die Omamori, die die Überreste der Schlange unterdrückten. „Tatarigami“ brachen aus und jeder auf der Insel floh in aller Eile. Manche sind sogar tot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380119
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380119,
					"content": "Die seltsamen Krankheiten, die die „Tatarigami“ mit sich gebracht haben, verbreiten sich ebenfalls. Viele der Bewohner hier wurden sehr krank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380142
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380142,
					"content": "Ich fürchte, es wird sich früher oder später auf die Lager beider Armeen ausbreiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380143
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380143,
					"content": "Was ist das für ein Ort?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380120
					]
				},
				{
					"id": 721380120,
					"content": "Hier wurde ursprünglich Erz hergestellt, mit dem der Jadestahl in Inazuma produziert wurde. Solange das Erz nicht zur Neige ging, konnten wir bequem leben, ohne von den Herrschaften in der Stadt eingeengt zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380121
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380121,
					"content": "Und jetzt? Man findet kaum noch einen Lebenden auf der Insel ... Ich meine, „Menschen“ wie mich, die normal sprechen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380122
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380122,
					"content": "Warum gehst du nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380123
					]
				},
				{
					"id": 721380123,
					"content": "Ihr denkt, ich will nicht weggehen? Dieser Herr der Tenryou-Verwaltung hat mich schon mal eingeladen ... Er sollte noch in der Armee sein und die Schlachten leiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380124
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380124,
					"content": "„Du hast medizinische Fähigkeiten. Du bist anders als normale Menschen. Es ist gefährlich für dich, auf der Insel zu bleiben. Warum kommst du nicht, um Mediziner in meiner Armee zu werden? Ich kann dich meinem Vater empfehlen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380145
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380145,
					"content": "Das hat er zumindest gesagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380125
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380125,
					"content": "Vor dem Krieg war es eine Ehre, Kommissare in Narukami zu behandeln. Als Landarzt habe ich von dieser Ehre nicht einmal geträumt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380126
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380126,
					"content": "Aber jetzt ... Denke darüber nach. Dem Verwalter würde es nicht an guten Ärzten um seine Person herum mangeln. Aber was ist mit der Insel Yashiori? Die einzige Person, auf die die Kranken hier zählen können, bin ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380127
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380127,
					"content": "Also werde ich nicht weggehen. Ich werde nicht nur die Soldaten jeder Seite behandeln. Mein einziger Feind sind die „Tatarigami“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380128
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380128,
					"content": "Kann ich dir bei irgendetwas helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380129
					]
				},
				{
					"id": 721380129,
					"content": "Nein ... Na ja, ich brauche wohl doch Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380130
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380130,
					"content": "Ich brauche spezielle Heilkräuter, um Medizin gegen die seltsamen Krankheiten zu machen, die die „Tatarigami“ verursachen. Ich weiß nicht, wie es klappen wird ... Aber ein Versuch ist immer gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380131
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380131,
					"content": "Aber ... Die Heilkräuter wurden durch die „Tatarigami“ verseucht und sie sind vor allem in gefährlichen Umgebungen verbreitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380146
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380146,
					"content": "Getrennt durch Fluss und Meer, verfolgt von Monstern überall und das Eindringen der Tatarigami ist auch hier besonders intensiv ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380132
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380132,
					"content": "Mit meinem Mut und meinen Fertigkeiten wird es schwer für mich, damit umzugehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380133
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380133,
					"content": "Und als Arzt wage ich es nicht, ein solches Risiko einzugehen, um die Heilkräuter zu sammeln. Ich konnte nur langsam wirkende konservative Behandlungen anwenden ... Nach langer Zeit konnte ich noch keine neuen Rezepte mischen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380134
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380134,
					"content": "#Fremde{M#r}, wie ich sehe, hast du einen „Windgleiter“ dabei. Du musst {F#eine erfahrene Reisende}{M#ein erfahrener Reisender} sein. Du wirst leicht mit solchen Gefahren umgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380135
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380135,
					"content": "Ich hoffe also, dass du mir helfen kannst, an diesen Stellen die richtigen Heilkräuter zu sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380136
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380136,
					"content": "Triff mich hier, sobald du die Heilkräuter gesammelt hast. Mach dir keine Sorgen wegen der Belohnung. Ich habe noch ein paar Ersparnisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380137
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380137,
					"content": "Obwohl es ein Auftrag von einem Fremden ist, hoffe ich, dass du ihn berücksichtigen wirst. Danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380138
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380138,
					"content": "Übrigens, sei bitte vorsichtig auf dem Weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380115,
					"content": "Du siehst niedergeschlagen aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380109,
					"content": "Es ist eine lange Geschichte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380105,
					"content": "Wirklich verdächtig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				}
			]
		},
		{
			"id": 7213802,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
