				"objectNames": [
					"Yasumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380501,
					"content": "Ach ... Ach ... Mein Herz ist fast herausgesprungen. Danke, dass du mir das Leben gerettet hast. Ich werde es nicht vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380502
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380502,
					"content": "Dies ist ein normales Phänomen. Die von den „Tatarigami“ infizierten Kreaturen werden unbewusst von einer unglücklichen Quelle angezogen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380503
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380503,
					"content": "Da die Verschreibung mit viel Energie der „Tatarigami“ durchsetzt ist, ist es normal, diese anzuziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380504
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380504,
					"content": "Nun, ich meine, ich weiß jetzt, wie ich die Rezepte verbessern kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380505
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380505,
					"content": "Aber der letzte Misserfolg hat einige frische Kräuter vergeudet. Ich brauche daher noch ein paar Kräuter, um mein Rezept weiter zu mischen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380506
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380506,
					"content": "#Bei deiner kommenden Reise, {NICKNAME}, achte bitte auf die Kräuter auf der Insel. Lass sie einfach in dem Bambuskorb vor dem Haus liegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380511
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380511,
					"content": "Ich werde dir die Belohnung geben, wie ich es versprochen habe. Aber ich hoffe, dass du noch eine Weile wartest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380507
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380507,
					"content": "#{NICKNAME}, es ist in Ordnung, wenn du beschäftigt bist. Vielleicht kann ich andere finden, die mir helfen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380508,
						721380509
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380508,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380510
					]
				},
				{
					"id": 721380510,
					"content": "#Tschüs, {F#Reisende}{M#Reisender} {NICKNAME}. Ich hoffe, du hast eine sichere Reise auf Yashiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380509,
					"content": "Ich werde darauf aufpassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380510
					]
				}
			]
		},
