			},
			"dialogs": [
				{
					"id": 721380701,
					"content": "Uff! Ach ... ha ... ha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380702,
						721380703
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380702,
					"content": "Wie geht es dir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380704
					]
				},
				{
					"id": 721380704,
					"content": "Ach ... Ach, es schmeckt bitter und meine Zunge ist taub geworden. Die lokale Lähmung könnte durch die „Tatarigami“ verursacht werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380705
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380705,
					"content": "Es schmeckt furchtbar. Aber scheint harmlos zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380706
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380706,
					"content": "Es kann lange dauern, bis die Nebenwirkungen des Medikaments zu beobachten sind. Ich weiß nicht ... Was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380707
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380707,
					"content": "#Sie ... sie kommen auf uns zu! {NICKNAME}! Werdet sie los!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380703,
					"content": "Sieht nicht sehr lecker aus ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380704
					]
				}
			]
		}
