					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"7213802"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yasumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380201,
					"content": "Ah, du bist hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380202
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380202,
					"content": "Hast du die Kräuter gesammelt, die ich erwähnt habe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				}
			]
		},
		{
			"id": 7213803,
			"completionStepIds": [
				7213807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213807",
							"2"
						],
						"stepId": 7213807,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213802",
							"3"
						],
						"stepId": 7213802,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yasumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380301,
					"content": "Ja, ja, der Stiel und die Blätter sind intakt. Und sie sind noch frisch ... Danke. Ich danke dir vielmals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380302
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380302,
					"content": "Das ist alles, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380303
					]
				},
				{
					"id": 721380303,
					"content": "Gut, ja. Das ist genug. Jetzt kann ich mit den Recherchen zu dem neuen Rezept beginnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380304
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380304,
					"content": "Nochmals vielen Dank für deine Mühe. Hier ist die Belohnung, die ich dir versprochen habe. Ich hoffe, du nimmst sie an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380305
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380305,
					"content": "#Übrigens, Fremde{M#r} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380306
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380306,
					"content": "Ah, entschuldige. Ich habe dich so sehr beunruhigt, aber ich weiß immer noch nicht, wie ich dich nennen soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380307
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380307,
					"content": "#Nenn mich einfach {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380308
					]
				},
				{
					"id": 721380308,
					"content": "#{NICKNAME}, wenn du daran interessiert bist, mir wieder zu helfen, komm bitte später zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380309
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380309,
					"content": "Natürlich werde ich dir eine gerechte Belohnung geben. Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				}
			]
		},
		{
			"id": 7213804,
			"completionStepIds": [],
