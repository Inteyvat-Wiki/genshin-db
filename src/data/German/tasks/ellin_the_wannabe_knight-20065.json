			},
			"dialogs": [
				{
					"id": 200650101,
					"content": "So ein Mist! Was soll ich denn jetzt tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650102,
					"content": "Was tust du denn hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200650103
					]
				},
				{
					"id": 200650103,
					"content": "Ich trainiere für die nächste Ritterauswahl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650104,
					"content": "Aber na ja, ich bin natürlich nicht so stark wie Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650105,
					"content": "Ich glaube, ich sollte mich eher an die Technik als an die Stärke halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650106,
					"content": "Beispielsweise denke ich darüber nach, wie ich all die Holzpfähle mit einem Schlag abschlagen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650107,
					"content": "Diese Holzpfähle sind richtig stabil. Da darf man nicht zu zaghaft sein. Mein Vater hat da wirklich einen Volltreffer gelandet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
		{
			"id": 2006502,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
