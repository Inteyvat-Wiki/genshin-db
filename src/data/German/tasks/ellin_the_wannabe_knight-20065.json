					"nextDialogs": [
						200650302
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650302,
					"content": "Darauf wäre ich nie im Leben gekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650303
					],
					"speakerTitle": "Ellin"
				},
				{
