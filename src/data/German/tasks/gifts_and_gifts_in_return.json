			"dialogs": [
				{
					"id": 750351201,
					"content": "Als Paimon die Säulen draußen sah, hat Paimon es sich schon gedacht, aber Paimon hätte nicht erwartet, dass wir hierherkommen würden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351202,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351203,
					"content": "#Es sieht so aus, als ob {REALNAME[ID(2)|SHOWHOST(true)]} diesen Ort wirklich mag. Bevor wir dich trafen, warst du bestimmt schon eine lange Zeit hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351204,
					"content": "Paimon fragt sich, ob die Lichtsäulen draußen verschwinden werden, wenn wir später hinausgehen ... Aber zuerst räumen wir ein bisschen auf und ruhen uns hier aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351205,
					"content": "#Zusammen mit Paimon und {REALNAME[ID(2)|SHOWHOST(true)]} räumt ihr hier alles auf.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750351206
					]
				},
				{
					"id": 750351206,
					"content": "Hehe, jetzt sieht es ganz gut aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351207,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351208,
					"content": "#Hm, seit wir hierher zurückgekommen sind, sieht {REALNAME[ID(2)|SHOWHOST(true)]} ein wenig aufgeregt aus. Gibt es etwas, das du Paimon und {NICKNAME} sagen möchtest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351209,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351210,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351211
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351211,
					"content": "Was? Sollen wir uns umdrehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351212,
					"content": "Gibt es etwa eine Überraschung? Hehe, dieser Kerl ist so durchschaubar wie eine Seifenblase, er ist wie ein offenes Buch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351213,
					"content": "Dann spielen wir mal mit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351214,
					"content": "#Du und Paimon dreht euch um und hört ständig „Kling-Klang“-Geräusche.\\nKeine Ahnung, was {REALNAME[ID(2)|SHOWHOST(true)]} da treibt ...\\nNach einer Weile gibt {REALNAME[ID(2)|SHOWHOST(true)]} ein lautes Brüllen von sich! Das soll wahrscheinlich das Zeichen sein, dass ihr euch wieder umdrehen sollt ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750351215
					]
				},
				{
					"id": 750351215,
					"content": "So viel Zeug!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351216,
					"content": "Lass Paimon mal sehen, besonders gerade Zweige, runde Steine ... und Essen. Farbe und Gerüche sind echt seltsam. Unklar, wie viele Tage sie schon dort liegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351217,
					"content": "#Hast du all diese Dinge sorgfältig gesammelt und willst sie Paimon und {NICKNAME} schenken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351218,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351219
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351219,
					"content": "Aber Gerichte, die zu lange stehen, sollte man nicht essen, egal ob wir oder du, sonst bekommt man Bauchschmerzen, also sollten wir die erstmal entsorgen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351220,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351221,
						750351223
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351221,
					"content": "Aber dieser Zweig ist großartig!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351222
					]
				},
				{
					"id": 750351222,
					"content": "Ja, es fühlt sich an, als ob man ihn wie ein Schwert schwingen könnte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351225,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351226
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351226,
					"content": "Haha, wir nehmen sie alle an! Hehe, Paimon legt sie in das Seitenfach von Paimons kleinem Schatz-Inventar, vielleicht können wir sie irgendwann gebrauchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351227,
					"content": "#Hm, da uns {REALNAME[ID(2)|SHOWHOST(true)]} Sachen geschenkt hat, sollten wir {REALNAME[ID(2)|SHOWHOST(true)]} auch etwas als Gegenleistung geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351228,
					"content": "Lass Paimon mal sehen, was Paimon in ihrer kleinen Kasse hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351229,
						750351231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351229,
					"content": "Es ist selten, dich so großzügig zu sehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351230
					]
				},
				{
					"id": 750351230,
					"content": "#Es ist schließlich eine Herzensangelegenheit für {REALNAME[ID(2)|SHOWHOST(true)]}. Das muss gewürdigt werden! Außerdem, die Sachen sind so schwer, dass Paimon fast nicht mehr fliegen kann, also gibt Paimon ihm auch ein paar Dinge ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351233,
					"content": "#Tadaa! Es ist ein glitzernder Edelstein, magst du ihn, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351234,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351235
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351235,
					"content": "Oh, du freust dich so sehr, wir haben das Richtige geschenkt ... Waaah, Vorsicht, lass ihn nicht fallen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351236,
					"content": "#... Paimon hat das Gefühl, dass {REALNAME[ID(2)|SHOWHOST(true)]} ihn so schnell verlieren wird, wenn er ihn so hält.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351237,
					"content": "Vielleicht sollten wir zu den „Kinder der Echos“ gehen und einen professionellen Edelsteinhandwerker bitten, ihn zu bearbeiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351231,
					"content": "Was hat Paimon heimlich vor mir versteckt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351232
					]
				},
				{
					"id": 750351232,
					"content": "#Paimon hat doch gesagt, dass es Paimons geheimer kleiner Schatz ist. Selbst dem besten Freund kann man nicht alles erzählen. Jedenfalls reicht es aus, um {REALNAME[ID(2)|SHOWHOST(true)]} ein Geschenk zu machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351223,
					"content": "Dieser Stein ist wirklich rund!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351224
					]
				},
				{
					"id": 750351224,
					"content": "#So rund und glänzend, hehe, auch wenn Paimon und {NICKNAME} so viele Flüsse überquert haben, haben wir selten so einen runden Stein gesehen. Ein echtes Juwel unter den Steinen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351225
