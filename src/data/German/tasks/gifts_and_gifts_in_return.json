			"dialogs": [
				{
					"id": 750350601,
					"content": "Die Vögel sind zurück auf dem Baum ... Haben sie vor, mit meinen Werkzeugen ein Nest zu bauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350602
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350602,
					"content": "Du bist wirklich mutig. Ich zähle darauf, dass du mir meine Werkzeuge zurückbringst. Ohne sie kann ich nicht leben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulahaw"
				}
			]
