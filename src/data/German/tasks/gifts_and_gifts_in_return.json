			},
			"dialogs": [
				{
					"id": 750350301,
					"content": "Ah, ihr seid da. Meister Kulahaw hat den bearbeiteten Edelstein im Laden gelassen. Er hat mir aufgetragen, ihn euch persönlich zu überbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350302
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350302,
					"content": "Hm? Meister Kulahaw ist heute auch nicht da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350303,
					"content": "Ja, er ist wieder einmal unterwegs, um Inspiration zu sammeln. Übrigens hat er auch ein paar Schlösser angefertigt, die er bei sich trägt, um zu verhindern, dass seine Werkzeuge gestohlen werden. Echt seltsam ... Wer würde unsere Schneidewerkzeuge stehlen? Und an wen könnten sie verkauft werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350304
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350304,
					"content": "Ach, das ist nicht der Fall. Eigentlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350305,
					"content": "(Imix scheint nicht zu wissen, dass die Vögel Meister Kulahaw ausgeraubt haben. Wir sollten das Geheimnis für ihn bewahren ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350306,
					"content": "Ei... Eigentlich ... gibt es Leute, die glauben, sie könnten so gute Arbeit leisten wie Meister Kulahaw, wenn sie seine Werkzeuge benutzen. Haha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350307,
					"content": "Ähem, zurück zum Thema ... Dann nehmen wir den Edelstein! Oh, wie schön! Paimon liebt seine Form, was für ein wahres Meisterwerk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350308,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350309,
					"content": "#Und {REALNAME[ID(2)|SHOWHOST(true)]} scheint er auch zu gefallen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350310,
					"content": "#Ich danke euch im Namen von {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350311
					]
				},
				{
					"id": 750350311,
					"content": "Hehe, solange es eurem kleinen Saurier gefällt! Ich werde Meister Kulahaw eure Komplimente übermitteln. Bitte kommt wieder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				}
			]
		},
