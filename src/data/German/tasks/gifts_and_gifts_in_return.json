			},
			"dialogs": [
				{
					"id": 750350401,
					"content": "Herzlich willkommen! Wenn du Edelsteine verarbeiten willst, bist du hier richtig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350402
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350402,
					"content": "Hallo! Wir haben hier einen Edelstein, den wir gern maßgefertigt haben möchten. Er ist für unseren kleinen Tepetlisaurier. Hier, dieser hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350403,
					"content": "Oh! Dieser Edelstein ist wirklich etwas Seltenes! Die Größe ist schon recht außergewöhnlich und dazu noch die Qualität ... wirklich kristallklar ... Aber das würde auch die Maßanfertigung erschweren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350404
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350404,
					"content": "Hmpf, Paimon weiß schon, wie dein nächster Satz lautet. Du brauchst wohl eine Extragebühr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350405,
					"content": "Nein, nein, wir sind ein ehrliches Geschäft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350406
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350406,
					"content": "Unser Geschäft ist auf die Kunst der Edelsteinbearbeitung spezialisiert. Wenn wir auf einen guten Edelstein stoßen, polieren wir ihn lieber umsonst, als die Chance zu verpassen, ihn zu bearbeiten. Unser Ziel ist es, unseren Namen mit dem Edelstein in die Welt hinauszutragen. Die Kunden auszunutzen ist etwas, was wir niemals tun würden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350407
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350407,
					"content": "Aber so wie ein guter Handwerker immer auf der Suche nach einem guten Edelstein ist, braucht ein guter Edelstein auch einen guten Handwerker. Ich kenne genau den richtigen Edelstein-Meister, der diesen Edelstein perfekt verarbeiten kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350408
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350408,
					"content": "Wunderbar, dann lass doch bitte diesen Edelstein-Meister kommen und ihn sich ansehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350409,
					"content": "Sicher, aber ihr müsst im Voraus einen Termin machen, wenn ihr mit ihm sprechen wollt. An den Tagen, an denen er keine Termine hat, ist er immer draußen in der Wildnis auf der Suche nach Inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350410
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350410,
					"content": "Auf der Suche nach Inspiration?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350411
					]
				},
				{
					"id": 750350411,
					"content": "Ja. Meister Kulahaw ist selbst unter Handwerksmeistern ziemlich einzigartig. Er ist der Meinung, dass ein guter Handwerker nicht nur wissen sollte, wie man die Entwürfe auf den Skizzen liest, sondern er sollte auch in der Lage sein, die Schönheiten der Natur zu verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350412
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350412,
					"content": "Er lernt zum Beispiel Poliertechniken von den Wellen auf der Seeoberfläche und kreiert Laubsägearbeiten, die auf der Form der sich bewegenden Wolken basieren ... Auf diese Weise sammelt er Inspirationen aus der Natur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350413
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350413,
					"content": "Uff ... Paimon kann sich nicht vorstellen, wie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350414,
					"content": "Wenn ihr es aber wirklich eilig habt, könnt ihr ihn auch dort suchen, wo er nach Inspirationen sucht! Er hat mir gesagt, wo er hingeht, bevor er gegangen ist. Ich kann es für euch auf eurer Karte markieren, wenn ihr wollt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				}
			]
		},
