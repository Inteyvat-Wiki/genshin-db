			"dialogs": [
				{
					"id": 750350101,
					"content": "Entschuldigung ... Bist du Meister Kulahaw?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350102,
					"content": "Das ist tatsächlich mein Name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350103
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350103,
					"content": "Hehe, du bist also der Edelstein-Meister, der auf der Suche nach Inspiration ist! Es war Imix, die uns empfohlen hat, zu dir zu kommen. Übrigens haben wir gesehen, dass du den Baum angestarrt hast. War das auch eine Art, sich inspirieren zu lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350104,
					"content": "Ähm, eigentlich ... Egal, es ist nicht mehr wichtig ... *seufz* ... Gibt es etwas, wobei ich euch helfen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350105
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350105,
					"content": "#Wir haben hier einen wunderschönen Edelstein und wir wünschen uns, dass du ihn für {REALNAME[ID(2)|SHOWHOST(true)]} verarbeiten kannst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350106,
					"content": "#Hehe, {REALNAME[ID(2)|SHOWHOST(true)]}, zeig ihm den Edelstein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350107,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350108,
					"content": "Ehhhh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350109,
					"content": "#Du hörst das Flattern der Vogelflügel ...\\nAls das Chaos vorbei ist, bemerkst du gleich, dass der Edelstein in der Pranke von {REALNAME[ID(2)|SHOWHOST(true)]} weg ist.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750350110
					]
				},
				{
					"id": 750350110,
					"content": "*brüll* *brüll* !!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350111,
					"content": "Waaah! Moment mal, wo ist der Edelstein?! Wie kann ein so großer Edelstein einfach so verschwinden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350112,
					"content": "Ein Vogel scheint ihn gestohlen zu haben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350113
					]
				},
				{
					"id": 750350113,
					"content": "Was? Die Vögel hier klauen Sachen? Sie haben wirklich keine Manieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350114,
					"content": "*brüll*! *brüll*!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350115,
					"content": "Ähm, das wollte ich auch gerade sagen. Aber auch wenn ihr euren Edelstein noch hättet, kann ich nichts für euch tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350116
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350116,
					"content": "... Denn auch meine Werkzeuge wurden von diesen verfluchten Vögeln gestohlen! Gerade habe ich mir die Vögel einen nach dem anderen genau angesehen, um zu sehen, welcher mein Werkzeug in seinen schmutzigen Krallen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350117
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350117,
					"content": "#Paimon würde nicht glauben, dass so etwas passieren könnte, wenn wir nicht auch ausgeraubt worden wären ... {NICKNAME}, die Vögel hier sind böse! Holen wir uns schnell unseren Edelstein zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350118,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350119,
					"content": "Und meine Werkzeuge auch ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulahaw"
				}
			]
		},
