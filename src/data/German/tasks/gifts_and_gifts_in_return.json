			"dialogs": [
				{
					"id": 750350801,
					"content": "Oh, oh, oh! Meine Werkzeuge sind wieder da! Gott sei Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350802
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350802,
					"content": "Aha, was für ein schöner Edelstein. Ich konnte ihn nicht richtig sehen, bevor die Vögel ihn weggeschnappt haben ... Eine fleischige gelbe Farbe, wie eine Vogelklaue ... Igitt, nein, ich sollte ihn nicht mit diesen heimtückischen Bälgern vergleichen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350803
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350803,
					"content": "Wie die Morgendämmerung, wenn die Sonne gerade aufgeht, dieser morgendliche Himmel ... Ja, das ist eine schöne Beschreibung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350804,
						750350806
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350804,
					"content": "Deine Metaphern sind aber keines Experten würdig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350805
					]
				},
				{
					"id": 750350805,
					"content": "Ich bin doch kein Geschichtenerzähler, ach, es reicht, wenn ich mich an die schönen Farben der Natur erinnere ... Ein schöner Ausdruck ist nicht mein Steckenpferd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350808
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350808,
					"content": "Überlass den Edelstein mir. Wie ich vorhin sagte, ich werde ihn kostenlos für euch bearbeiten, als Dankeschön dafür, dass ihr meine Werkzeuge gefunden habt. Zeitlich gesehen ... Kommt in zwei Tagen in den Edelsteinladen, um ihn abzuholen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350806,
					"content": "Ist das die Bedeutung von „Inspirationsausflug“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350807
					]
				},
				{
					"id": 750350807,
					"content": "Oh? Du hast auch schon vom Inspirationsausflug gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350808
					],
					"speakerTitle": "Kulahaw"
				}
			]
		},
