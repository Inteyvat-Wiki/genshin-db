			"dialogs": [
				{
					"id": 250290101,
					"content": "Kleiner, nicht den Kopf hängen lassen! Sobald du dich erholt hast, kannst du weiter üben! Dann wirst du ganz schnell den Gipfel erstürmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290102
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290102,
					"content": "*brüüüll* ... *brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290103
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290103,
					"content": "Du hast doch bestimmt Hunger? Hm ... Ich bringe dir etwas zum Essen, ja!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290104
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290104,
					"content": "*brüll* ... *brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290105
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290105,
					"content": "Was machst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290106
					]
				},
				{
					"id": 250290106,
					"content": "Ich spiele hier mit meinem Kumpel Qica. Der ist noch winzig, aber Mama meint, wenn er mal groß ist, wird er genauso stark wie die anderen Yumkasaurier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290107
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290107,
					"content": "*brüll* ... *brüüüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290108
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290108,
					"content": "Sei nicht traurig. Du bist eben noch schwach und hattest ja auch eine Verletzung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290109
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290109,
					"content": "Meine Mama sagt, wenn du gut isst und mit mir fleißig trainierst, wirst du bald wieder gesund sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290110
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290110,
					"content": "*brüll*? *brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290111,
						250290113
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290111,
					"content": "(Qica streicheln)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290112
					]
				},
				{
					"id": 250290112,
					"content": "*brüüüll* ... *brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290119
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290119,
					"content": "*seufz* Genug geredet. Jetzt gibt’s erst mal was zu essen, bevor wir trainieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290120
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290120,
					"content": "Diese Trockenfrüchte sind eine Spezialität von meiner Mama. Sie röstet sie erst in der Pfanne und gibt dann jede Menge feine Gewürze dazu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290121
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290121,
					"content": "Und dann noch ordentlich Zucker und Blütenblätter ... Schmeckt einfach fantastisch! Hier, ich geb dir was ab ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290122
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290122,
					"content": "Wo sind denn die Früchte? Die waren doch eben noch im Beutel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290123
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290123,
					"content": "... *brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290124
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290124,
					"content": "Boah! Qica! Hast du alles aufgefuttert? Ich habe doch gesagt, nicht so viel mampfen, sonst kannst du nicht mehr laufen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290125
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290125,
					"content": "... *brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290126,
						250290127
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290126,
					"content": "Appetit zu haben, ist schon mal gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290128
					]
				},
				{
					"id": 250290128,
					"content": "*brüll* ... *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290129
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290129,
					"content": "Echt? Dann will ich auch wie Qica viel essen, schnell groß werden und Mama unterstützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290130
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290130,
					"content": "Gut, dann lass uns mit dem Training anfangen, Qica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290131
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290131,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290132
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290132,
					"content": "Mal sehen ... Heute trainieren wir das Bergsteigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290133
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290133,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290134
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290134,
					"content": "Es wird wie beim letzten Mal, gar nicht so schwer. Komm schon, Qica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290135
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290135,
					"content": "... *brüll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290136
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290136,
					"content": "Ach, Onkel Yawar hat gesagt, dass wir ein vernünftiges „Trainingsziel“ brauchen, wenn wir ernsthaft trainieren wollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290137
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290137,
					"content": "Wäre toll, wenn ich einen richtig erfahrenen Abenteurer finde, der mir dabei hilft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290138,
						250290139
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290138,
					"content": "#Ich bin schon ein{F#e} halbwegs erfahrene{M#r} Abenteurer{F#in}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290140
					]
				},
				{
					"id": 250290140,
					"content": "#Echt? Also ... {M#großer Bursche}{F#junge Dame}, würdest du mir helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290141,
						250290142
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290141,
					"content": "Soll ich mit euch bergsteigen gehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290143
					]
				},
				{
					"id": 250290143,
					"content": "Nein, nein, wenn du so gut bist, können wir doch gar nicht mit dir mithalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290144
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290144,
					"content": "Wir bleiben hier unten, schauen dir zu und stoppen die Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290145
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290145,
					"content": "#Leg dich ins Zeug, {M#großer Bursche}{F#junge Dame}, und klettere so schnell wie möglich auf den Gipfel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290146
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290146,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290142,
					"content": "Na gut, folgt mir. Wir fangen gleich an!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290143
					]
				},
				{
					"id": 250290139,
					"content": "#{F#Die Abenteurerin}{M#Der Abenteurer}, {F#die}{M#den} du suchst, steht direkt vor dir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290140
					]
				},
				{
					"id": 250290127,
					"content": "Wer viel isst, der wächst auch schnell.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290128
					]
				},
				{
					"id": 250290113,
					"content": "Wie hat er sich verletzt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290114
					]
				},
				{
					"id": 250290114,
					"content": "Keine Ahnung ... vielleicht weiß es Mama. Als sie Qica hergebracht hat, war er schon krank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290115
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290115,
					"content": "Qica konnte nichts essen und war schwach. Ich musste ihm jeden Tag Medizin ins Wasser geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290116
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290116,
					"content": "Obwohl er wieder gesund wurde, ist er immer noch schwach. Er kann nicht wie die anderen Yumkasaurier an den Klippen herumtollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290117
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290117,
					"content": "Deswegen ist er immer traurig, also will ich ihm helfen! Damit er gesund wird und ... stärker als die anderen Yumkasaurier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290118
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290118,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290119
					],
					"speakerTitle": "Qica"
				}
			]
		},
