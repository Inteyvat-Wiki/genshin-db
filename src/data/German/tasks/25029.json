			"dialogs": [
				{
					"id": 250290301,
					"content": "#{M#Großer Bursche}{F#Junge Dame}, du bist echt toll! Du kletterst genauso schnell wie Mayta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290302,
						250290304
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290302,
					"content": "Es ... gab da ein paar Patzer ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290303
					]
				},
				{
					"id": 250290303,
					"content": "#Patzer? Du könntest also noch schneller klettern, {M#großer Bursche}{F#junge Dame}? Du bist wirklich {F#eine erfahrene Abenteurerin}{M#ein erfahrener Abenteurer} ...",
