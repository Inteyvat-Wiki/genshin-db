			"dialogs": [
				{
					"id": 250290201,
					"content": "He, Kleiner, hast du heute gut gefuttert? Hast du Kraft zum Trainieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290202
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290202,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290203
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290203,
					"content": "Uii, so viel Energie? Klasse! Heute legen wir noch einen Zahn zu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290204
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290204,
					"content": "Los, zusammen reißen wir das!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290206
					]
				},
				{
					"id": 250290206,
					"content": "#Hallo, {M#großer Bursche}{F#junge Dame}! Wir trainieren hier gerade fürs Bergsteigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290207
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290207,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290208
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290208,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290209,
						250290212
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290209,
					"content": "Und, wie läuft das Training?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290210
					]
				},
				{
					"id": 250290210,
					"content": "Na ja ... ich würde sagen, wir machen Fortschritte. Qica hat es viel weiter nach oben geschafft als beim letzten Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290211
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290211,
					"content": "Es ist nur so, dass Qica immer noch nicht so gut klettern kann, als ob er noch etwas Übung bräuchte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290216
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290216,
					"content": "#{M#Großer Bursche}{F#Junge Dame}, kannst du uns das nochmal vorführen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290217,
						250290221
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290217,
					"content": "Gern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290218
					]
				},
				{
					"id": 250290218,
					"content": "#Vielen Dank! Diesmal werde ich genau auf deine Bewegungen achten, {M#großer Bursche}{F#junge Dame}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290219
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290219,
					"content": "Qica, du musst auch die Augen aufsperren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290220
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290220,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290223
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290223,
					"content": "#Dann bitte, {M#großer Bursche}{F#junge Dame}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290224
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290224,
					"content": "Wir bleiben hier unten, schauen dir zu und stoppen die Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290225
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290225,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290221,
					"content": "Achtet diesmal genau auf meine Bewegungen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290222
					]
				},
				{
					"id": 250290222,
					"content": "Klar, Qica und ich werden ganz genau hinschauen. Diesmal verpassen wir nichts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290223
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290212,
					"content": "Scheint, als wäre er wieder auf dem Damm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290213
					]
				},
				{
					"id": 250290213,
					"content": "Natürlich! Sogar Mama hat gesagt, ich kümmere mich prima um Qica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290214
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290214,
					"content": "Qica hat große Fortschritte gemacht, er ist viel höher geklettert als beim letzten Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290215
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290215,
					"content": "Es ist nur so, dass Qica immer noch nicht so gut klettern kann, als ob er noch etwas Übung bräuchte ...",
					"roleType": "TALK_ROLE_NPC",
