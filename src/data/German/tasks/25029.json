					"nextDialogs": [
						250290306
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290306,
					"content": "Wenn wir diese Kletterzeit als Maßstab nehmen ... hm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290307
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290307,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290308
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290308,
					"content": "... Haha, das ist wohl noch etwas zu schwer für dich, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290309
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290309,
					"content": "Macht nichts, ich gehe später mit der Kletterzeit von dir zu Mayta. Vielleicht kann er mir helfen, einen ... vernünftigen Trainingsplan zu erstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290310
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290310,
					"content": "#{M#Großer Bursche}{F#Junge Dame}, danke für deine Hilfe, dieser Cacahuatl ist für dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290311
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290311,
					"content": "Wir haben ihn gerade selbst gepflückt. Er ist superfrisch und du kannst damit superleckere Schokolade machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290312
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290312,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290313
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290313,
					"content": "Dann mal los! Ich weiß nicht, ob Mayta im Stamm ist. Hoffentlich ist er nicht wieder klettern gegangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290304,
					"content": "Wer ist Mayta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290305
					]
				},
				{
					"id": 250290305,
					"content": "Er ist ein guter Freund von mir und ein wahrer Profi im Klettern. Außer Schwester Roca kann ihm beim Klettern kaum jemand das Wasser reichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290306
					],
					"speakerTitle": "Tlatem"
				}
