				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721690101,
					"content": "Der Name des Gerichts ist wirklich typisch für Julie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690102
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690102,
					"content": "Nun, als ich es zum ersten Mal sah, dachte ich, es sei ein Mondstadt-Gericht, aber ich wusste nicht, dass es eigentlich eine lokale Inazuma-Spezialität ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690103
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690103,
					"content": "Wenn der Name so einprägsam ist, muss es auch lecker sein. Xudong, bitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690104,
						721690105
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690104,
					"content": "So sieht man sich wieder.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690106
					]
				},
				{
					"id": 721690106,
					"content": "#Juhu! {F#Reisende}{M#Reisender}, he, ich sagte doch, wir sehen uns wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690107,
					"content": "Xudong hat gerade ein neues Rezept aus der Stadt bekommen! Es heißt „Krebsrogen-Kourayaki“. Wie findest du den Namen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690108
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690108,
					"content": "Die Zubereitung dieses Gerichts ist nicht kompliziert. Aber dieses Gericht erfordert eine Menge Krebse ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690109
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690109,
					"content": "Ich habe ein paar normale Krebse und bin auf der Suche nach ein paar ... speziellen Krebsen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690110
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690110,
					"content": "Spezielle Krebse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690111
					]
				},
				{
					"id": 721690111,
					"content": "Richtig, Krebse, die unter der Donner-Sakura leben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690112
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690112,
					"content": "Du kannst genauso gut sagen ... Krebse, die vom Blitz getroffen wurden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690113
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690113,
					"content": "Hahahaha, jedenfalls bin ich neugierig, die Krebse, die in dieser Umgebung leben ... wie wäre die Textur beim Essen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690114,
					"content": "Aber ... wir haben uns nicht in die Nähe des Donner-Sakura-Baums getraut, weil daneben immer wieder Blitze einschlugen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690115,
					"content": "In dem Buch, das ich habe, steht ... wie schon gesagt, dass man zuerst den „Donner-Sakura-Zweig“ berühren muss, um etwas namens „Elektrogranum“ an sich haften zu lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690116
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690116,
					"content": "Auf diese Weise wirst du nicht von Blitzen getroffen, die neben dem Donner-Sakura-Baum einschlagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690117
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690117,
					"content": "Aber du hast das Geräusch des Donners an diesem Baum gehört und mit einer so lückenhaften Aufzeichnung würde ich es nicht wagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690118,
					"content": "Aber wenn du schnell genug läufst, sollte es dir doch gut ergehen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690119,
					"content": "Ich sage dir ... so schnell, wie du laufen kannst, bist du auch schneller als der Blitz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690120
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690120,
					"content": "Dann sind wir draußen und benutzen einen Ast oder etwas anderes, um die Krebse herauszuzwicken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690121
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690121,
					"content": "Ich sage dir, wir graben einfach ein Loch direkt daneben und ziehen das Wasser zusammen mit den Krebsen heraus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690122
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690122,
					"content": "Hahahaha ... jeder äußert seine eigene Meinung, schön, schön, schön.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690123
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690123,
					"content": "#{F#Reisende}{M#Reisender}, wenn du Lust hast, versuch doch auch, Krebse an diesem Donner-Sakura-Baum zu fangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690124,
					"content": "Wenn du welche fängst, bring sie zu mir und ich mache ein großes Essen, um dir ordentlich zu danken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690125
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690125,
					"content": "Oh ja, warte eine Sekunde ... Nimm diese Köder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690126
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690126,
					"content": "Wenn du dort Krebse fangen willst, beginne damit, diese Köder zu benutzen, um sie anzulocken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690127
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690127,
					"content": "Das sollte dir auch beim Fang von Krebsen einige Mühe ersparen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690128
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690128,
					"content": "Ein Krebs, der in der Nähe der Donner-Sakura lebt ... na ja, ich frage mich, wie er wirklich schmeckt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690105,
					"content": "Gibt es etwas Gutes zu essen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690106
					]
				}
			]
		},
		{
			"id": 7216902,
