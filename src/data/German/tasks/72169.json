					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721690201,
					"content": "#Wie geht es, {F#Reisende}{M#Reisender}, wie ist deine Ausbeute?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690202,
					"content": "Juhu! Der Krebs sieht echt gut aus. Du hast wirklich das Zeug dafür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690203,
					"content": "Nun, da du alle Zutaten hast, lass uns mit der Vorbereitung des Kochens beginnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690204,
					"content": "#Ich mache mich bereit, {F#Reisende}{M#Reisender}. Gib mir nur eine Sekunde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 7216903,
