			"dialogs": [
				{
					"id": 721690301,
					"content": "Kourayaki ... Warum heißt das überhaupt so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690302,
					"content": "Vergiss es, lass es uns einfach zubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690303
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690303,
					"content": "Es ist vollbracht! Dies ist das „Krebsrogen-Kourayaki“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690304,
					"content": "Ich nehme eine Portion! Hmmm ... Das hier wird reichen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690305
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690305,
					"content": "Gib mir eine kleinere, ich kann keine große aufessen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690306
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690306,
					"content": "#Hier, das hier ist für dich, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690307
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690307,
					"content": "Und dieses „Krebsrogen-Kourayaki“-Rezept habe ich auch für dich kopiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690308,
					"content": "Es ist ein ziemlich einfaches Gericht, also versuche es selbst, wenn du Zeit hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690311
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690311,
					"content": "Wir werden uns wahrscheinlich als Nächstes nach <color=#00E1FFFF>Yashiori</color> begeben. Suche uns dort auf, wenn du die Zeit dazu hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690309,
					"content": "Nun, ich muss auch etwas essen gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690310
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690310,
					"content": "He! Julie! Hebe einen für mich auf. Iss nicht alles auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
