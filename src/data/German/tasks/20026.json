			"dialogs": [
				{
					"id": 200260101,
					"content": "Bestellung außer Haus",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260102,
					"content": "#{F#Reisende}{M#Reisender}, du kommst genau richtig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260103,
					"content": "Was? Du bist nur hier zum Essen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260104,
					"content": "Ja, ich weiß. Aber ich brauche wirklich deine Hilfe. Danach bekommst du ein leckeres Gericht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260105,
					"content": "Ernest vom Weingut Morgenröte bestellt oft bei uns. Er hat immer sehr, sagen wir, interessante Sonderwünsche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260106
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260106,
					"content": "Dieses Mal hat er <color=#00E1FFFF>frittierte Rettichbällchen</color> bestellt, will aber noch ein Ei dazu. Dummerweise sind uns die Eier ausgegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260107,
					"content": "Ich wäre dir sehr verbunden, wenn du uns zwei Eier bringen würdest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260108,
						200260111
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260108,
					"content": "Gern, aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260109
					]
				},
				{
					"id": 200260109,
					"content": "Auf dem Windstieg solltest du viele Vogeleier finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260110
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260110,
					"content": "Danke, ich weiß das zu schätzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260111,
					"content": "Ich bin so hungrig! Ich wollte eigentlich nur etwas essen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260112
					]
				},
				{
					"id": 200260112,
					"content": "Auf dem Windstieg solltest du viele Vogeleier finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260113
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260113,
					"content": "Wenn du damit fertig bist, werde ich dich, ja, auf ein Spezialgericht beim Hirschjäger einladen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
