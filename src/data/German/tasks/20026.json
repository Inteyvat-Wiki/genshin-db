					"nextDialogs": [
						200260203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260203,
					"content": "Die <color=#00E1FFFF>frittierten Rettichbällchen</color> sind fertig! Bring sie schnell zu Ernest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260204
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260204,
					"content": "Guck nicht so! Ich weiß doch, dass du hungrig bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260205
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260205,
					"content": "Sobald du wieder hier bist, wartet ein besonderes Gericht vom Hirschjäger auf dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
