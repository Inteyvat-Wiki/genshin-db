					"nextDialogs": [
						200260302
					]
				},
				{
					"id": 200260302,
					"content": "Oh! Das sind die <color=#00E1FFFF>frittierten Rettichbällchen</color>, so wie ich sie wollte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260303
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 200260303,
					"content": "Mit dem Ei ist der Geschmack wirklich eine ganze Ecke besser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260304
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 200260304,
					"content": "Hahaha! Ich weiß immer, wie man ein Gericht aufpeppen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260305
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 200260305,
					"content": "Ach ja, dein Geld. Nochmals vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
