					"content": "Jack ist beim <color=#00E1FFFF>Tempel des Löwen</color>. Vergiss nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
		{
			"id": 1011104,
			"completionStepIds": [
				1011104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011104",
							"2"
						],
						"stepId": 1011104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Stanley",
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110401,
					"content": "*keuch*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110402
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110402,
					"content": "Ich war mir so sicher, dass ich sterben würde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110403
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110403,
					"content": "Um ehrlich zu sein, das hätte so oder so ausgehen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110404,
					"content": "Also, du bist Jack der Abenteurer, nehme ich an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110405,
					"content": "Ja ... und wer bist du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110406,
					"content": "Wir sind auf der Suche nach dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110407,
					"content": "Ellin hat eine Nachricht für dich. Sie sagte, dass sie sich heute nicht mit dir treffen kann, um euer nächstes gemeinsames Abenteuer zu besprechen. Sie wird sich ein anderes Mal mit dir treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110408,
					"content": "Ah, ich verstehe ... Es tut mir leid, dass ihr den ganzen Weg gekommen seid, um mich zu finden ... und mich dann retten musstet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110409
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110409,
					"content": "Huch! Ich verstehe nicht, was die ganze Aufregung darum soll. Es war nichts, womit ich, Stanley, nicht alleine hätte fertig werden können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110410
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110410,
					"content": "Ooh, du bist Stanley? Du bist dieser legendäre Abenteurer? In ganz Mondstadt bekannt? Der einst bis zum Mare Jivari vorgedrungen ist!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110411,
					"content": "Hehehe, genau der!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110412
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110412,
					"content": "Hahaha! Ich muss sagen, es ist eine Ehre, eine Legende wie dich zu treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110413
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110413,
					"content": "Nun dann, wie würdet ihr alle gerne fortfahren? Zurück oder weiter rein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110414,
						101110417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110414,
					"content": "Stanley, was denkst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110415
					]
				},
				{
					"id": 101110415,
					"content": "Hehehe, nun ... Ich denke, ihr seid jetzt in den sicheren Händen von Stanley, dem großen Entdecker und der Legende von Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110416
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110416,
					"content": "Warum sollten wir also umkehren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110419,
					"content": "Gut, der Antrag wurde einstimmig angenommen! Gehen wir weiter rein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110417,
					"content": "Jack, was denkst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110418
					]
				},
				{
					"id": 101110418,
					"content": "Ich denke, wir sollten weitermachen. Mit Stanley an unserer Seite werden wir keine Probleme haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 1011106,
			"completionStepIds": [
				1011106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011106",
							"2"
						],
						"stepId": 1011106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110601,
					"content": "Reisender, ich glaube, ich habe eine kleine Entdeckung gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110602,
					"content": "Könnte ich dich darum bitten, noch einmal den Nirnama-Detektor zu verwenden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110603
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110603,
					"content": "Was? Stanley hat einen eingebildeten Freund?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110604,
					"content": "Es scheint, als wäre sein eingebildeter Freund ein erfahrener Krieger ... von Kopf bis Fuß mit Narben bedeckt und einem Blick voller Entschlossenheit auf seinem Gesicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110605,
						101110608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110605,
					"content": "Er passt zu Stanleys Beschreibung von sich selbst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110606
					]
				},
				{
					"id": 101110606,
					"content": "Du meinst, dass sein eingebildeter Freund eine idealisierte Version von sich selbst ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110607,
					"content": "Interessanter Gedanke! Aber ist das wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110611
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110611,
					"content": "Bitte entschuldigt mich, ich gehe jetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110612
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110612,
					"content": "Tschüs, Stanley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110613
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110613,
					"content": "Hast du noch Zeit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110614
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110614,
					"content": "Was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110615
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110615,
					"content": "Vor ein paar Tagen hat Stanley sich betrunken und mir ein Geheimnis verraten – etwas, das er noch nie jemandem erzählt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110616
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110616,
					"content": "Die Waffen, die er vor all den Jahren auf sein Abenteuer mitnahm ... waren keine geringeren als die, die einst die größte Heldin von Mondstadt, Vennessa persönlich, geschwungen hat. Das <color=#00E1FFFF>Schwert des Heldenmuts</color> und der <color=#00E1FFFF>Schild des Siegeswillens</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110617
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110617,
					"content": "Ich weiß nicht, ob du mir glaubst, aber ... anscheinend sind Schwert und Schild immer noch hier in Mondstadt, in der <color=#00E1FFFF>Dadaupa-Schlucht</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110618
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110618,
					"content": "Da ihr die Experten darin seid ... Könntet ihr mich begleiten und versuchen, diese beiden legendären Waffen zu holen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110619,
						101110621
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110619,
					"content": "Stanley war wirklich im Besitz dieser Waffen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110620
					]
				},
				{
					"id": 101110620,
					"content": "Darauf kannst du wetten! Wir reden hier von Stanley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110623,
					"content": "Wenn ich nur etwas in die Hände bekommen könnte, das beeindruckend genug ist, um meiner Familie zu zeigen, wozu ich in der Lage bin, dann können sie sich vielleicht endlich mit dem Gedanken anfreunden, dass ich ein Abenteurer werde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110624
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110624,
					"content": "Im Moment bin ich nur ein Anfänger, meine Fähigkeiten sind begrenzt und meine Eltern unterstützen mich kein bisschen bei meinen Zielen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110625
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110625,
					"content": "Also, was sagt ihr? Helft ihr mir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110626
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110626,
					"content": "Ich kann mich nicht dazu überwinden, es Stanley zu erzählen, weil meine Gründe so egoistisch sind ... Aber ich schwöre, ich gebe ihm die Waffen zurück, sobald ich fertig bin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110627
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110627,
					"content": "Ach, armer Jack ... Lass uns ihm helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110628,
						101110629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110628,
					"content": "Na, dann werde ich mal ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110630,
					"content": "Venti, kommst du auch mit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110631,
					"content": "Hmm ... Ich weiß es nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110632
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110632,
					"content": "Oh, noch eine Sache: Ich habe eine Flasche seltenen, erlesenen Wein, den ich mir vor ein paar Jahren bringen ließ. Hilf mir, diese Waffen zu finden und er gehört euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110633
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110633,
					"content": "Zur <color=#00E1FFFF>Dadaupa-Schlucht</color>, oder? Beeilen wir uns, wir sollten keine Zeit verlieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110629,
					"content": "Schwer, nach dieser traurigen Geschichte nein zu sagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110621,
					"content": "Warum hat er sie dann in der Wildnis zurückgelassen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110622
					]
				},
				{
					"id": 101110622,
					"content": "Ich weiß nicht. Herausragende Personen haben immer ihren Macken, stimmt’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110608,
					"content": "Ich wusste, dass seine Geschichte komisch ist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110609
					]
				},
				{
					"id": 101110609,
					"content": "Oh? Das hast du auch gedacht, was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110610
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110610,
					"content": "Das finde ich auch. Er hat nicht die ganze Geschichte erzählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110611
					],
					"speakerTitle": "Venti"
				}
			]
		}
	]
}