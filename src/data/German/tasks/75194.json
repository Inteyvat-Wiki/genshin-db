			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kulemana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940401,
					"content": "Puh ... Gut, dass die Situation am Vulkan nicht so schlimm war wie befürchtet. Jetzt können alle endlich beruhigt schlafen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940402
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940402,
					"content": "Das verdanken wir euch! Wärt ihr nicht bereit gewesen, trotz früherer Missverständnisse zu helfen, wäre diese Sache sicher nicht so glimpflich ausgegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940403
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940403,
					"content": "Nehmt bitte diese Vergütung an. Sie repräsentiert meine persönliche Entschuldigung und Dankbarkeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940404
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940404,
					"content": "Hehe, wenn du es so sagst, dann nehmen wir das gerne an!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940405
					]
				},
				{
					"id": 751940405,
					"content": "Was hast du als Nächstes vor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940406
					]
				},
				{
					"id": 751940406,
					"content": "Ich habe noch einige Waren im Lager. Mit denen kann ich sicherlich etwas Geld verdienen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940407
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940407,
					"content": "Haha, diesmal gibt es keine Dringlichkeit, deshalb werde ich natürlich ehrlich Geschäfte machen! Also macht euch keine Sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				}
			]
		},
		{
			"id": 7519405,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
