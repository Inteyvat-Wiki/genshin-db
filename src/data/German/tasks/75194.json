				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kulemana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940501,
					"content": "Zehn, zwanzig ... Ich habe sie für so viel Geld verkauft, dass wir in nächster Zeit nicht in Geldnot geraten sollten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940502,
						751940510
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940502,
					"content": "Willst du nicht noch mehr verdienen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940503
					]
				},
				{
					"id": 751940503,
					"content": "Haha, ich gebe mich zufrieden und höre jetzt auf! Wenn du nicht nachsichtig mit meiner kleinen List gewesen wärst und mir nicht geholfen hättest, hätte ich wohl wegen ein paar Jadestücken echt in Schwierigkeiten gesteckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940504
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940504,
					"content": "Außerdem ist es langweilig, den ganzen Tag nur auf Geld zu starren. Für mich ist Geldverdienen nur ein Hobby, das Beobachten des Vulkans ist mein Leben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940505
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940505,
					"content": "Geld kann man wieder verdienen, wenn es weg ist, aber wenn keine Vorwarnungen für Vulkanausbrüche geben könnten, wäre der Schaden unermesslich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940506
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940506,
					"content": "Gibt die Kammer des Sprechers euch keine Mittel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940507
					]
				},
				{
					"id": 751940507,
					"content": "Wir haben keine beantragt. Schließlich sind ihre üblichen Aufgaben bereits mehr als genug, um die Kammer des Sprechers und die Häuptlinge zu beschäftigen. Wie könnten wir ihnen jetzt noch zusätzliche Lasten aufbürden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940508
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940508,
					"content": "Meine Reisebegleiter und ich sind da ganz anders. Normalerweise reisen wir als Gruppe umher und verdienen nebenbei unser Reisegeld. Wir sind diesen Lebensstil längst gewohnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940509
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940509,
					"content": "Für uns ist es keine große Sache, während unserer Reise über den Vulkan zu wachen, genauso wie es für euch ist, während eurer Reise anderen in Not zu helfen! Es ist schon ein Teil der Reise selbst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940510,
					"content": "Auf Wiedersehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940511
					]
				},
				{
					"id": 751940511,
					"content": "Mach’s gut, hehe, bis zum nächsten Mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				}
			]
		},
		{
			"id": 7519406,
