			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kulemana",
					"Paimon"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2944.732,
							203.779,
							9785.503
						],
						"pointId": 11062
					},
					{
						"sceneId": 3,
						"position": [
							-2946.541,
							203.922,
							9783.725
						],
						"pointId": 11325
					},
					{
						"sceneId": 3,
						"position": [
							-2945.759,
							203.869,
							9785.573
						],
						"pointId": 11326
					}
				]
			},
			"dialogs": [
				{
					"id": 751940101,
					"content": "Moment, nicht so schnell, das sind Waren, also Finger weg, wenn du nichts kaufen willst! Hm ...? Du, ja, Blondschopf, genau du, nicht weglaufen, lass noch mal einen Blick auf dich werfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940102
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940102,
					"content": "#Hm, genau wie ich dachte ... Haare hell wie die Sonne und Augen tief wie das Königreich der Nacht. Ich schätze ... Nein, ich bin sicher, dass du eines Tages {F#eine große Heldin}{M#ein großer Held} sein wirst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940103
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940103,
					"content": "#Komm, komm, komm! Hier habe ich eine Sammlung wunderbarer Jadeschmuckstücke, die verschiedenste Melodien in sich bergen und genau zu {F#einer Heldin}{M#einem Helden} wie dir passen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940104
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940104,
					"content": "Aber schließlich sind die wirklich unbezahlbare Schätze. Wenn jemand anderes sie kaufen will, werde ich von ihm mindestens zehn Millionen Mora verlangen. Aber ich kann sehen, dass das Schicksal diese Juwelen mit dir verbunden hat, also gebe ich dir einen neunzigprozentigen Rabatt. Bist du zufrieden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940105
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940105,
					"content": "Boah! Ein neunzigprozentiger Rabatt! Das ist ja ein Schnäppchen! Moment ... Das sind immer noch mehr als eine Million Mora! Das ist ja viel zu teuer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940106,
					"content": "Leider kann ich wirklich nichts mehr tun. Ich verkaufe sie bereits zu dem Preis, zu dem ich sie gekauft habe! Immerhin haben wir kleinen Händler es auch nicht leicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940107,
						751940108
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940107,
					"content": "So sollte man sein Geld aber nicht verdienen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				},
				{
					"id": 751940109,
					"content": "Oh, ah ... Ihr habt also schon alles gehört. Haha ... Ach, meine Angewohnheit, mit mir selbst zu reden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940110
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940110,
					"content": "*seufz* Nun, dann gibt es ja nichts mehr zu verbergen. Ich habe diese Jade einfach gefunden und sie ist diesen Preis bestimmt nicht wert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940111
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940111,
					"content": "Aber ich musste es versuchen! Wie ihr gehört habt, gehen uns die Mittel aus und wir können es uns nicht einmal leisten, ein paar Helfer einzustellen, um die Daten in den Bojen zu sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940112
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940112,
					"content": "Dann vergiss die Bojen einfach! Besser als eine Betrügerin zu sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940113,
					"content": "Das geht nicht ... Für andere Organisationen bedeutet der Mangel an Mitteln nichts anderes als Inaktivität, aber unsere übernimmt auch die ehrenamtliche Aufgabe, den Vulkan im Auge zu behalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940114
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940114,
					"content": "Wir platzieren Bojen, um vulkanische Aktivitäten zu erfassen, indem wir Daten wie die Wassertemperatur ermitteln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940115
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940115,
					"content": "Im Moment nimmt die Aktivität des Vulkans zu, und die Bergung der Bojen muss schneller erfolgen, sonst könnte etwas Schreckliches passieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940116
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940116,
					"content": "Da ich verletzt bin, kann ich die Bojen nicht selbst bergen, geschweige denn die Daten darin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940117
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940117,
					"content": "#{NICKNAME}, sollen wir ihr helfen? Schließlich geht es bei der Sache mit dem Vulkan um die Sicherheit aller. Wir können das doch nicht einfach ignorieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940118,
					"content": "Wi... Wirklich? Wenn ihr mir helft, gebe ich euch diese Jadestücke als Vergütung! Ist das in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940119,
						751940120
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940119,
					"content": "Ich dachte, du sagtest, es sei eine Millionen-Mora-Aufgabe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940121,
					"content": "Sei versichert, auch wenn es nicht viel ist, es wird sicherlich neben der Jade noch eine weitere Vergütung geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940122
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940122,
					"content": "Hehe, es ist auch in Ordnung, wenn es nur Jaden gibt! Immerhin machen wir das für alle in der Nähe des Vulkans! Überlass es einfach uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940123,
						751940124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940123,
					"content": "Dann fangen wir mal an.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 751940124,
					"content": "Ich muss mich noch kurz fertig machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940125
					]
				},
				{
					"id": 751940125,
					"content": "Ich bin bereit! Es kann jederzeit losgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940120,
					"content": "Hmm ... Wir bekommen also nur ein paar Jaden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940108,
					"content": "Du hast vorhin von Helfern gesprochen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				}
			]
		},
		{
			"id": 7519404,
			"completionStepIds": [
				7519404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
