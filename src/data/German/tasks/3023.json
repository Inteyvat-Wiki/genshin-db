			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alhaitham"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30230201,
					"content": "Immer mit der Ruhe. Der Wald wurde nicht an einem Tag geschaffen, wir brauchen Zeit, um uns vorzubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230202
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230202,
					"content": "Wir müssen in Ruhe überlegen und sicherstellen, dass der Plan Hand und Fuß hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230203
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230203,
					"content": "Sagte er und begann wieder zu lesen, auweia! Du bist einfach faul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230204,
					"content": "Soll ich dir ein Buch leihen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230205
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230205,
					"content": "Lieber nicht, deine Bücher sind alle nichts für Paimon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230206,
					"content": "Ich habe nur gescherzt. Meine Bücher sind wirklich nichts für dich, ich würde sie dir gar nicht leihen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230207
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230207,
					"content": "Arrg! Du machst Paimon rasend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 302303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
