			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30230401,
					"content": "Die letzten Tage waren eine der größten Herausforderungen, die ich je angenommen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230402
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230402,
					"content": "Außerdem ist es unglaublich, dass bei dieser harten Arbeit finanziell nichts für mich herausspringen soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230403
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230403,
					"content": "Denke an das gute daran, vielleicht bekommst du eine große Belohnung, wenn das alles vorbei ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230404,
					"content": "Da hast du auch wieder recht. Hm, wenn du über Nacht reich würdest, was würdest du damit anfangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230405
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230405,
					"content": "Paimon würde sich ganz, ganz viele Delikatessen kaufen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230406,
					"content": "Ist das alles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230407
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230407,
					"content": "Hm ... Und etwas Leckeres zu trinken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230408,
					"content": "Haha, wie putzig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230409
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230409,
					"content": "Dann werde ich für diese schönen Wünsche auch helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230410
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230410,
					"content": "Ich hoffe, dass alles, was wir in Zukunft tun, die Welt zu einem besseren Ort machen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dehya"
				}
			]
		}
	]
