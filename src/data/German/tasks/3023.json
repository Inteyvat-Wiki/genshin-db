			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Candace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30230301,
					"content": "Wenn ich etwas für euch tun kann, lass es mich wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230302
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 30230302,
					"content": "Ich kann das Aaru-Dorf zwar nicht verlassen, aber wenn ich euch sehe, ich weiß nicht warum ... schlägt mein Herz schneller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230303
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 30230303,
					"content": "Ich war noch nie so aufgeregt wie heute, nicht einmal, als ich mich allein einem Kampf stellen musste ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230304
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 30230304,
					"content": "Vielleicht ist das die Kraft der Kameradschaft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Candace"
				}
			]
		},
		{
			"id": 302304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
