							"2"
						],
						"stepId": 4135704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413570201,
					"content": "Oh, du bist schnell von Begriff. Gut, jetzt, da du es verstehst, kannst du es richtig versuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570202
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570202,
					"content": "Ist es schwierig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570203
					]
				},
				{
					"id": 413570203,
					"content": "Nein. Du weißt doch schon, wie man die Laternen dreht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570204
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570204,
					"content": "Du musst die Laternen so drehen, dass die Bilder, die sie auf den Schirm werden, ein ganzes Bild ergeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570212
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570212,
					"content": "Ich kann dir verraten, was die Bilder ergeben, doch du musst herausfinden, wie sie zu drehen sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570205
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570205,
					"content": "Und wenn sie sich überlappen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570206
					]
				},
				{
					"id": 413570206,
					"content": "Vielleicht ist dir aufgefallen, dass auf diese Schirme eine Karte von Liyue gemalt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570207
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570207,
					"content": "Wenn du die Bilder aufeinander abstimmst und auf die Karte wirfst, zeigen sie einen besonderen Schatz der Abenteurergilde an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570208
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570208,
					"content": "Viele Mitglieder der Gilde bemühen sich fleißig, all die Schätze zu verstecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570213
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570213,
					"content": "Die Truhe aber ... ist genauso wie diese Truhen hier. Sobald du den Standort kennt, findest du sie ganz leicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570209
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570209,
					"content": "Das heutige Bild ist eine <color=#00E1FFFF>Glaslilie</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570210
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570210,
					"content": "Eine Sache noch, die Bilder auf dem Leuchtschirm sind nur nachts klar zu sehen. Komm also her, wenn es dunkel ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570211
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570211,
					"content": "Zudem hat die Abenteurergilde einen Experten mit der Anfertigung dieser Laternen beauftragt. Es sind wahre Kunstwerke, also sie sieh dir gut an, damit sie zur Geltung gelangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
