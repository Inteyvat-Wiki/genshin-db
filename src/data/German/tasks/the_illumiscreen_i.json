				{
					"id": 413570301,
					"content": "Wie lief die Schatzsuche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570302
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570302,
					"content": "Hab alle gefunden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570303
					]
				},
				{
					"id": 413570303,
					"content": "Alle? Du hast wirklich ein Näschen für Schätze. Die meisten Leute können nicht einmal die Laternen drehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570304
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570304,
					"content": "Da du alle Schätze gefunden hast ... nimm bitte deinen Preis entgegen. Frohes Laternenritual!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
