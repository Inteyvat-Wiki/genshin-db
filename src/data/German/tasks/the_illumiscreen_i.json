				"points": []
			},
			"dialogs": [
				{
					"id": 413570101,
					"content": "Probiere den Leuchtschirm aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570102
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570102,
					"content": "Was für einen Schirm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570103
					]
				},
				{
					"id": 413570103,
					"content": "Den Leuchtschirm. Was meinst du? Komm schon, es ist ganz einfach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570104
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570104,
					"content": "Siehst du diese Schirme? Und diese drei Laternen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570105
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570105,
					"content": "Diese Laternen sind Maßanfertigungen. Wenn du sie entzündest, werfen sie alle möglichen Bilder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570106
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570106,
					"content": "Und wenn du alle drei in der richtigen Richtung drehst, bilden die drei Bilder zusammen ein ganzes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570107
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570107,
					"content": "Hmm, vielleicht erkläre ich es nicht gut genug ... Wie wäre es damit? Dreh zuerst die Laternen, anschließend sage ich dir dann genauer, wie alles funktioniert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
		{
			"id": 4135702,
			"completionStepIds": [
				4135704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
