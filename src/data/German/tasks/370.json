				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3700201,
					"content": "Was? Ist das nicht Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700202,
					"content": "Sie scheint mit jemandem zu reden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700203,
					"content": "Lassen wir sie zu Ende sprechen und sagen dann hallo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700204,
					"content": "... Deswegen sind wir überhaupt erst hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700205
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700205,
					"content": "Seid Ihr unfähig, Sturmschrecken loszuwerden, solltest Ihr den „Fatui“ die Verteidigung von Mondstadt überlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700206
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700206,
					"content": "Für die Fatui ist diese Angelegenheit gar kein Problem. Wir können dieses Ungeheuer jederzeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700207
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700207,
					"content": "„Ungeheuer“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700208
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700208,
					"content": "Ja. Worauf wollt Ihr hinaus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700209
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700209,
					"content": "Also wirklich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700210,
					"content": "Ich hatte erwartet, dass die Diplomaten Eures werten Landes eine professionellere Einstellung hätten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700211
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700211,
					"content": "Ihr wollt einen der Vier Winde von Mondstadt umbringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700212
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700212,
					"content": "Ich will nicht, dass jemand solche Worte vor einem Ritter des Ordo Favonius in den Mund nimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700213
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700213,
					"content": "Hehehe, so abwegig sind meine Worte nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700214
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700214,
					"content": "Nun gut, beenden wir die heutigen Verhandlungen fürs Erste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700215
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700215,
					"content": "Wir haben diesmal einige konstruktive Vorschläge ausgetauscht, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700216
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700216,
					"content": "Ich werde ... alles genaustens festhalten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700217
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700217,
					"content": "#Oh, {NICKNAME}, du bist zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700218
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700218,
					"content": "Vielen Dank für deine Hilfe! Der Kreislauf der Elemente um die Stadt herum ist wieder normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700219
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700219,
					"content": "Nach Sturmschreckens letztem Angriff haben wir für den Moment die Lage unter Kontrolle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700220
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700220,
					"content": "Mittlerweile wird es aber schwierig, dem Druck der Delegation standzuhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700221
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700221,
					"content": "Die Delegation?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700222,
					"content": "Etwa Diplomaten? Aus Liyue oder Inazuma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700223,
					"content": "Aus Snezhnaya. Sie verehren den Kryo-Archon, einen der sieben Götter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700224
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700224,
					"content": "Ihre Diplomaten haben einen besonderen Namen: die Fatui. Hast du schon einmal von ihnen gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700225
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700225,
					"content": "Oh, die Fatui! Ja, von denen hat Paimon gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700226,
					"content": "Einen guten Ruf haben sie aber nicht gerade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700227,
					"content": "Ich denke nicht, dass es richtig ist, Sturmschrecken zu töten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700228
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700228,
					"content": "Außerdem sind die Fatui, die vom Kryo-Archon angeführt werden, auf die Macht derer aus, die zum Anemo-Archon gehören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700229
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700229,
					"content": "Allein deswegen zweifle ich an ihren guten Absichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700230
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700230,
					"content": "Da wir gerade von Macht sprechen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700231
					]
				},
				{
					"id": 3700231,
					"content": "#Was gibt es denn, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700232
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700232,
					"content": "Es gibt da etwas, das ich dem Ritterorden gern zeigen würde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700233
					]
				},
				{
					"id": 3700233,
					"content": "Tatsächlich? Dann gehen wir am besten zurück zum Hauptquartier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700234
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700234,
					"content": "Wir sollten derart wichtige Angelegenheiten ... nicht an einem solchen Ort besprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		},
		{
			"id": 37005,
			"completionStepIds": [
				37005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37005",
							"2"
						],
						"stepId": 37005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3700401,
					"content": "Das ist ein Kristall mit einer besonderen Kraft ... Lisa, könnt Ihr seine Zusammensetzung analysieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700402
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700402,
					"content": "Hmm, lasst mich sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700403
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700403,
					"content": "Ich sehe einige Unreinheiten im Kristall. Aber wenn ich ihn mir genauer ansehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700404
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700404,
					"content": "Es tut mir leid. Ich kann mich so nicht konzentrieren. Gebt mir etwas Zeit, ich werde mich im verbotenen Bereich der Bibliothek umsehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700405
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700405,
					"content": "Wenn das so ist, Lisa, überlasse ich Euch die Recherchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700406
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700406,
					"content": "Verstanden. Ich werde mich melden, sobald es Neuigkeiten gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700407
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700407,
					"content": "Ihr solltet Euch aber keine allzu großen Hoffnungen machen, dass ich etwas in diesen uralten Aufzeichnungen dazu finden werde. Davon abgesehen ... Aua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700408
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700408,
					"content": "Eieiei, das tat weh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700409
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700409,
					"content": "Diese Unreinheiten im Kristall ... Sobald ich mich nähere, spüre ich einen stechenden Schmerz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700410
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700410,
					"content": "Ach ich verstehe ... Es reagiert auf das „göttliche Auge“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700411
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700411,
					"content": "Diese Unreinheiten und die elementaren Kräfte in uns stoßen sich gegenseitig ab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700412
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700413,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700414
					]
				},
				{
					"id": 3700412,
					"content": "#Doch eins ist seltsam. {NICKNAME} hat auch elementare Kräfte. Beeinflusst wird er von dem Kristall aber nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700413
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700415,
					"content": "#{F#Süße}{M#Süßer}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700417
					]
				},
				{
					"id": 3700416,
					"content": "So machen wir das.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700417
					]
				},
				{
					"id": 3700414,
					"content": "#Jedenfalls sollte unser{F#e Süße}{M# Süßer} den Kristall vorerst behalten. Bei uns richtet er sicher mehr Schaden an, als er Nutzen bringt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700415,
						3700416
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700417,
					"content": "Das ist wirklich faszinierend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700418
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700418,
					"content": "Weißt du eigentlich ... wieso du so etwas Besonderes bist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700419
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700420,
					"content": "Das hatte ich mir gedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700421
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700421,
					"content": "#{NICKNAME}, im Namen des Ordo Favonius bitte ich dich ein weiteres Mal um deine Hilfe:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700422
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700422,
					"content": "Bitte akzeptiere deine Ernennung zum Ehrenritter des Ordo Favonius ... sowie den Dank des stellvertretenden Großmeisters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700423
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700424,
					"content": "Ehrenritter ... des Ordo Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700426,
					"content": "Bitte hilf uns dabei, dieses Rätsel zu lösen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700427
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700427,
					"content": "Das von Sturmschrecken verursachte Chaos und dieser komische Kristall ... Die Antwort hinter all dem stellt möglicherweise eine Gefahr für den Frieden in Mondstadt dar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700428
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700428,
					"content": "Möge der Wind deine Augen öffnen, damit du die Wahrheit siehst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700429
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700429,
					"content": "Wenn du etwas Neues entdeckt hast, treffen wir uns wieder hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 4820221,
					"content": "Flieg einfach entlang der <color=#00E1FFFF>markierten Strecke</color> bis zum Endpunkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "Amber"
				}
			]
		}
	]
}