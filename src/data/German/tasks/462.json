			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620401,
					"content": "Lass Paimon mal sehen! Was ist denn drin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620402,
					"content": "„Sie liebt ihn überhaupt nicht. Die Leidenschaft der sprudelnden Quelle ist nur eine Fassade. Erst in eisiger Stille zeigt sie ihr wahres Gesicht.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620407,
					"content": "Auch dieses Mal ist eine Karte dabei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620403,
					"content": "Wie jetzt? Noch mehr Rätsel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620404,
					"content": "Paimon kann nicht mehr, Paimon ist schwindlig ... zu viel nachgedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620405,
					"content": "Wann hast du denn nachgedacht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620406
					]
				},
				{
					"id": 4620406,
					"content": "Jetzt musst du jedenfalls den Rest machen, hihi. Wenn du wirklich nicht weiterweißt, kannst du mit Kaeya sprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 46205,
			"completionStepIds": [
				46205
			],
