			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620301,
					"content": "Hach ... Warum musste ich <color=#00E1FFFF>ihm</color> nur helfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620302
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620302,
					"content": "Ihm? Wen meinst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620303,
					"content": "Wirklich vielen lieben Dank! Das hätte leicht schiefgehen können. Ihr habt mehr drauf als diese Ritter des Ordo Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620304
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620304,
					"content": "#Ach, das war noch gar nichts. {NICKNAME} hier hat als {F#Reisende}{M#Reisender} täglich mit größeren Schwierigkeiten zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620305,
					"content": "#{F#Reisende}{M#Reisender}? Dann musst du das wohl sein. Wer hätte gedacht, dass meine <color=#00E1FFFF>Kontaktperson</color> mir das Leben retten würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620306
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620306,
					"content": "Ach, du bist unsere Informantin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620307,
					"content": "Hehehe ... Ich habe erst überlegt, wie ich euch danken könnte. Aber jetzt kann ich euch die Informationen auch ohne Entgelt geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620308
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620308,
					"content": "Für jemanden, der sein Geld als Informant verdient, sind Freunde unermesslich wichtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620309,
						4620311
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620309,
					"content": "Ist das auch wirklich in Ordnung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620310
					]
				},
				{
					"id": 4620310,
					"content": "Aber natürlich! Ihr habt mir schließlich das Leben gerettet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620312
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620312,
					"content": "He, was für ein Glück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620313,
					"content": "Aber irgendwie auch schade ... Kaeya wollte das schließlich aus eigener Tasche zahlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620314,
					"content": "Na gut, hier sind die Informationen über die Ruinen von Arcadia:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620315
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620315,
					"content": "„In der Stadt auf dem See wohnen drei sechsarmige Riesen, zwei davon beschützen die Statue, eine den Schatz der Götter.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620316
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620316,
					"content": "Wie? War das alles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620325,
					"content": "Bei den Aufzeichnungen war auch noch diese Karte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620317
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620317,
					"content": "Hm ... Ist das eine richtige Schatzkarte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620318,
					"content": "Jetzt haben wir endlich eine Spur, aber trotzdem fühlt Paimon sich nicht schlauer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620319,
					"content": "#Für {NICKNAME} mit {F#ihrer}{M#seiner} überragenden Intelligenz sollte das aber kein Problem darstellen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620320,
						4620321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620320,
					"content": "Da hast du vollkommen recht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620322,
					"content": "Na ja, wenn dir nichts einfällt, können wir auch noch Kaeya fragen. Er scheint auch nicht ganz auf den Kopf gefallen zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620326,
					"content": "Ich überlasse dir die Aufzeichnung erst einmal. Dann kannst du sie dir jederzeit ansehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620327
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620327,
					"content": "Hehe, vielen Dank, Vile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620323,
					"content": "„In der Stadt auf dem See wohnen drei sechsarmige Riesen, zwei davon beschützen die Statue, eine den Schatz der Götter.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620324,
					"content": "Was soll das nur bedeuten? Wenn wir Kaeya deswegen nicht erst belästigen wollen, sollten wir uns besser anstrengen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620321,
					"content": "Ja ... schon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620311,
					"content": "Dann danke ich dir recht herzlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620312
					]
				}
			]
		},
