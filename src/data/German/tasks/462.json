			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620501,
					"content": "#{NICKNAME}! Ihr seid zurück! Außerdem scheint ihr Spuren gefunden zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620502
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620502,
					"content": "Wir haben zwar etwas, aber das macht die Sache eher noch komplizierter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620503,
					"content": "„In der Stadt auf dem See wohnen drei sechsarmige Riesen, zwei davon beschützen die Statue, eine den Schatz der Götter.“ Was soll das denn heißen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620504,
					"content": "Ein Rätsel also ... Wie gewöhnlich. Lasst mich nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620505
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620505,
					"content": "Die Stadt im See ist sicherlich Mondstadt ... Sechsarmig? Was gibt es denn hier mit sechs Armen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620506
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620506,
					"content": "Geht es um Krebse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620507
					]
				},
				{
					"id": 4620507,
					"content": "Die sechsarmigen Riesen sind also monströse Krebse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620508,
					"content": "Mal davon abgesehen, dass ich noch nie so große Krebse gesehen habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620509
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620509,
					"content": "Krebse haben acht Beine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620516
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620516,
					"content": "Sind damit Windmühlen gemeint?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620517
					]
				},
				{
					"id": 4620517,
					"content": "Das müssten doch ... Windmühlen sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620518
					]
				},
				{
					"id": 4620518,
					"content": "Du bist einfach Weltklasse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620519
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620519,
					"content": "An den Windmühlen sind immer genau sechs Arme. Das passt also perfekt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620510
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620510,
					"content": "Oooh! Jetzt, da du es sagst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620511,
					"content": "Der Rest ist ziemlich einfach. Von den drei Windmühlen sind zwei nahe an der Statue. Das sind die zwei Riesen, die die Statue beschützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620512
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620512,
					"content": "Die andere Statue beschützt dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620513
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620513,
					"content": "Den Schatz! Seht ihr, ich weiß es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620514,
					"content": "Hehehe ... Hoffentlich klappt das auch so einfach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620515
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620515,
					"content": "#Komm schon, {NICKNAME}. Gehen wir schnell zu der Windmühle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 46207,
			"completionStepIds": [
				46207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46207",
							"2"
						],
						"stepId": 46207,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_NOT_EQUAL",
						"rawParams": [
							"46206",
							"3"
						],
						"stepId": 46206,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620701,
					"content": "„Sie liebt ihn überhaupt nicht. Die Leidenschaft der sprudelnden Quelle ist nur eine Fassade. Erst in eisiger Stille zeigt sie ihr wahres Gesicht.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620702
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620702,
					"content": "Fällt euch da etwas auf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620703,
					"content": "Das habt ihr sicher nicht aus einem Liebesroman gerissen, den ihr irgendwo gefunden habt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620704
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620704,
					"content": "Dann ist das gar nicht echt? Kein Wunder, dass jemand so klug wie Paimon das Rätsel nicht lösen konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620705,
					"content": "Hahaha, ich mache doch nur Spaß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620706
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620706,
					"content": "Hmpf ... Jetzt seid mal bitte ernst bei der Sache, Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620707,
					"content": "Haha, dieses Rätsel ist schon etwas schwieriger. Quelle ... Ob hier Quellingen gemeint ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620708
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620717,
					"content": "Vielleicht wenn jemand in der Quelle badet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620724,
					"content": "Ist der Wasserstand immer gleich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620708,
					"content": "„Die Leidenschaft der sprudelnden Quelle“ ... Wann ist denn eine Quelle leidenschaftlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620709
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620718,
					"content": "Solch unmoralisches Verhalten ist mittlerweile ziemlich selten in Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620719,
					"content": "Findest du etwa Gefallen daran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620720,
					"content": "Ach, mein Fehler. Ich sollte mich nicht um die Freizeitbeschäftigungen anderer kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620721,
					"content": "#He, was denkst du nur von {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620723,
					"content": "Hmm ... Ist der Wasserstand manchmal hoch und manchmal niedrig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620722,
					"content": "Alles ist möglich. Dann wäre die Leidenschaft aber nicht mehr von der Quelle, sondern von den Menschen, die darin baden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620725,
					"content": "Du hast recht! Vielleicht bei dem Wasserfall?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620726,
					"content": "Die Lösung des Rätsels ist gewiss der Wasserfall in den Bergen hinter Quellingen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620727,
					"content": "Nur dort zeigt die Quelle, die Mondstadt ihr Wasser gibt, ihre leidenschaftliche Seite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620709,
					"content": "Das „wahre Gesicht“ ist dann sicher der Gipfel des Abhangs links vom Wasserfall. Auf meiner Patrouille habe ich einmal nach oben geschaut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620710
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620710,
					"content": "Die „eisige Stille“ hat sicher mit der Kryo-Kraft zu tun, die man mit dem Göttlichen Auge kontrollieren kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620711
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620712,
					"content": "Vielen Dank für die Hilfe, Kaeya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620713
					]
				},
				{
					"id": 4620711,
					"content": "Du solltest jemanden bei dir haben, der die <color=#00E1FFFF>Kryo-Kraft kontrollieren</color> kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620712
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620713,
					"content": "Nicht der Rede wert. Wenn man als Ritter des Ordo Favonius nicht einmal Rätsel raten kann, wie soll man dann erst die Machenschaften von Verbrechern aufdecken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620714
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620714,
					"content": "Dann werden wir gleich nach Quellingen gehen und Euch mit Euren Machenschaften allein lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620715,
					"content": "Wie bitte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620716
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620716,
					"content": "Ach, ich meine natürlich, dass wir Euch die Aufdeckung dieser Machenschaften überlassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
