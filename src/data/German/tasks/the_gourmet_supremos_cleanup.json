			"dialogs": [
				{
					"id": 738050101,
					"content": "#{F#Reisende}{M#Reisender}, warte mal, hier ist ein Brief für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050102
					],
					"speakerTitle": "Maryam"
				},
				{
					"id": 738050102,
					"content": "Brief an mich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050103
					]
				},
				{
					"id": 738050103,
					"content": "Der Mann namens Xudong, der aus Liyue stammt, hat ihn dir hinterlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050104,
						738050105
					],
					"speakerTitle": "Maryam"
				},
				{
					"id": 738050104,
					"content": "Wo ist er?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050106
					]
				},
				{
					"id": 738050106,
					"content": "Das weiß ich aber nicht. Ich weiß nur, dass er neulich in Eile vorbeigekommen ist und diesen Brief hinterlassen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050107
					],
					"speakerTitle": "Maryam"
				},
				{
					"id": 738050107,
					"content": "Er bat mich, dir den Brief zu geben. Er bot sogar an zu zahlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050108
					],
					"speakerTitle": "Maryam"
				},
				{
					"id": 738050108,
					"content": "Xudong ... in Eile? Was machte ihn so nervös?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 738050109,
					"content": "Könnte es sein ... dass der Bösewicht wieder Ärger suchte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050110,
						738050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 738050110,
					"content": "Lesen wir zuerst den Brief.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050112
					]
				},
				{
					"id": 738050112,
					"content": "Gut ... Mal sehen, was er geschrieben hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 738050111,
					"content": "Vielleicht sagt er uns im Brief, was los ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050112
					]
				},
				{
					"id": 738050105,
					"content": "Warum hat er mir einen Brief hinterlassen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050106
					]
				}
			]
		}
	]
