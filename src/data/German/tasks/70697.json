			"dialogs": [
				{
					"id": 706970101,
					"content": "#{NICKNAME}! Was für eine Überraschung, euch hier in Mondstadt zu treffen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970102
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970102,
					"content": "Ich war noch nie an einem Ort mit so einem Klima. Wirklich kalt! Aber trotzdem, was für ein Erlebnis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970103
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970103,
					"content": "Ich hatte zum ersten Mal eine Schneeballschlacht und habe meinen ersten Schneemann gebaut ... Oh, und die Comics sind auch eine schöne Überraschung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970104
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970104,
					"content": "„Chronik der Flammenkrieger“ ist ziemlich beliebt in Inazuma. Aber ich hätte nicht erwartet, dass dieses Werk auch so viele Leser hier anzieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970105
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970105,
					"content": "Ich hatte vorhin ein tolles Gespräch mit einigen Fans aus Natlan. Das hat mich wirklich inspiriert, also ... habe ich schließlich einen Figuren-Stand gebaut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970106,
					"content": "... Entschuldige, lass mich kurz nachfragen: Hast du schon mal von „Chronik der Flammenkrieger“ gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970107
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970107,
					"content": "Du erzählst Yoimiya von der „Legion der Flammenkrieger“ ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706970108
					]
				},
				{
					"id": 706970108,
					"content": "Echt? Deine Freunde mögen es auch! Was für ein Zufall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970109,
					"content": "Dann schenke ich euch diesen Figurenaufsteller von Fietena. Sie wird sich in der „Legion der Flammenkrieger“ wie zu Hause fühlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		}
	]
}