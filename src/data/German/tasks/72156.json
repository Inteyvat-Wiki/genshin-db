			"dialogs": [
				{
					"id": 721560101,
					"content": "Gut! Nun ist der zweite „Schutzstein“ versiegelt. Noch zwei Schutzsteine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721560102
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721560102,
					"content": "Sehen wir uns einmal die beiden letzten Schutzsteine an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721560103
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721560103,
					"content": "Wenn wir alle Schutzsteine versiegeln können, sollte sich dieser Sturm legen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721560104
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721560104,
					"content": "Dann legen wir besser damit los.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721560105
					]
				},
				{
					"id": 721560105,
					"content": "Hoffentlich hat uns diese „Neko“ auch wirklich die Wahrheit gesagt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721560106
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721560106,
					"content": "Nun, was den Sturm angeht, ist das unser einzig echter Anhaltspunkt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721560107
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721560107,
					"content": "Was auch immer der Fall sein mag, sehen wir uns einfach mal die Schutzsteine an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721560108,
						721560109
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721560108,
					"content": "Ja, nichts wie los.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721560110
					]
				},
				{
					"id": 721560110,
					"content": "Der Sturm und diese Schutzsteine ... Das wird ein äußerst umfangreicher Bericht, den wir später für die Gilde schreiben müssen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721560109,
					"content": "Lass uns wenigstens näher an sie herankommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721560110
					]
				}
			]
		}
