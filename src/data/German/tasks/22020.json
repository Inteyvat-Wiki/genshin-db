				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200101,
					"content": "#Hm, was für ein Zufall, nicht wahr, {F#Reisende}{M#Reisender}? Sango hatte recht damit, dass wir uns wieder treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200102,
					"content": "Was bringt dich hierher?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200103
					]
				},
				{
					"id": 220200103,
					"content": "Sango hat mich gebeten, die letzte Arbeit zu beenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200104,
					"content": "Dazu gehört einfach, dass du den Doushin etwas Nachtisch bringst, um ihnen für ihre Hilfe zu danken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200105,
						220200106
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200105,
					"content": "Sie sollten uns dankbar sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				},
				{
					"id": 220200107,
					"content": "Das ist wahr. Nun, es ist nur eine Ausrede, um unsere Beziehung zu ihnen zu verbessern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200108
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200108,
					"content": "Schließlich könnte unsere Detektei ihre Hilfe eines Tages brauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200109,
						220200110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200109,
					"content": "Es klingt genau wie Sango ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200111,
					"content": "Haha, ja. Deine Intuition ist so scharf wie immer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200112
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200112,
					"content": "Was hältst du persönlich von all dem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200113
					]
				},
				{
					"id": 220200113,
					"content": "Ich? Amano und Andou ... Wir waren mal Kollegen, da ist es normal, dass man mit einem Dessert ein bisschen Freundlichkeit zeigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200114,
					"content": "Aber ... Sango hat mich auch gebeten, heute eine andere Sache zu untersuchen, also ist die Zeit ein bisschen eng ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200115,
					"content": "#{F#Reisende}{M#Reisender}, könntest du mir bitte helfen, diese Desserts an drei Personen auszuliefern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200116,
						220200118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200116,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200117
					]
				},
				{
					"id": 220200117,
					"content": "Danke für deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200121,
					"content": "Hier sind drei Pakete mit Desserts für Amano, Andou und Herrn Owada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200122
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200122,
					"content": "Herr Owada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200123
					]
				},
				{
					"id": 220200123,
					"content": "Er ist auch mein ... ehemaliger Kollege. Er war gut zu mir, bevor ich die Polizei verlassen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200124
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200124,
					"content": "Er hat uns auch schon bei dem Serieneinbruchsfall mit der Polizei geholfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200125
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200125,
					"content": "#Dann überlasse ich es dir, {F#Reisende}{M#Reisender}. Nachdem du die Desserts abgeliefert hast, treffen wir uns wieder hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200118,
					"content": "Ich denke, es wäre besser für dich, wenn du sie abliefern würdest.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200119
					]
				},
				{
					"id": 220200119,
					"content": "Aber ... Sangos Bitte ist wichtiger ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200120
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200120,
					"content": "Ich werde später Zeit finden, die drei zu besuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200110,
					"content": "Sango muss dir das beigebracht haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200106,
					"content": "Waren es nicht wir, die ihnen geholfen haben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				}
			]
		},
		{
			"id": 2202002,
			"completionStepIds": [
				2202002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202002",
							"2"
						],
						"stepId": 2202002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amano",
					"Andou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200201,
					"content": "#Oh, du bist es, {F#Reisende}{M#Reisender}. Was machst du denn hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200202
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200202,
					"content": "Das ist für dich von Ryuuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200203
					]
				},
				{
					"id": 220200203,
					"content": "Oh? Lass mal sehen ... Oho, Sakuramochi ... Ah, dieser Junge Ryuuji, er musste wirklich nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200204
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200204,
					"content": "#He, Andou. Hör auf so vorsichtig zu sein. {F#Die}{M#Der} Reisende mag fremd sein, aber {F#sie}{M#er} hat uns gerade geholfen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200205
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200205,
					"content": "Ich bin überrascht, dass Ryuuji sich noch daran erinnert, was wir mögen. Sein Kollege zu sein hat sicher seine Vorteile ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200206
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200206,
					"content": "Habt ihr mit Ryuuji zusammengearbeitet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200207
					]
				},
				{
					"id": 220200207,
					"content": "Hmm? Er hat es euch gegenüber nicht erwähnt? Wir haben für kurze Zeit mit ihm gearbeitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200208
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200208,
					"content": "Aber er wurde plötzlich in einen bestimmten Vorfall verwickelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200209
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200209,
					"content": "Dank Sango wurde der wahre Schuldige gefasst und Ryuuji wurde entlastet. Später verließ er das Polizeirevier und ging zur Arbeit für Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200210
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200210,
					"content": "Das ist alles was ich weiß ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200211
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200211,
					"content": "Na gut, ich denke, das reicht soweit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200212
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220200212,
					"content": "Stimmt. Jedenfalls hatte er es mit Sango viel leichter als mit uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200213
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200213,
					"content": "Wenn ich könnte, würde ich auch gerne ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200214
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200214,
					"content": "*seufz* Du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200215
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220200215,
					"content": "#Ähem! Übrigens, danke, {F#Reisende}{M#Reisender}. Ich werde diese Desserts nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200216
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200216,
					"content": "Grüß Ryuuji und Sango von mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amano"
				}
			]
		},
		{
			"id": 2202003,
			"completionStepIds": [
				2202003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202003",
							"2"
						],
						"stepId": 2202003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Owada",
					"Uesugi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200301,
					"content": "#Hmm? Du bist ... {F#die}{M#der} Reisende, richtig? Ich habe gehört, wie Amano dich erwähnt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200302
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200302,
					"content": "Gibt es etwas, das du gerne mit mir besprechen möchtest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200303
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200303,
					"content": "Das ist von Ryuuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200304
					]
				},
				{
					"id": 220200304,
					"content": "Oh, das sind Sakuramochi ... Nun denn, ich kann sie nicht einfach so essen. Ich muss einen schönen Ort finden, um sie zu genießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200305
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200305,
					"content": "Uesugi, bitte übernimm doch für mich. Wenn jemand kommt, um mich zu sehen, sag ihm, er soll einen Moment warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200306
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200306,
					"content": "Aber es ist Arbeitszeit, Herr Owada ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200307
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 220200307,
					"content": "Hahaha, es ist schon gut. Ich gehe nur kurz an die frische Luft. Ich bin bald wieder da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200308
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200308,
					"content": "*seufz*... Aber bitte komm bald wieder. Wenn einer von den hohen Tieren vorbeikommt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200309
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 220200309,
					"content": "Keine Sorge, wir haben gerade einen Fall gelöst, also wenn jemand kommt, wird er hier sein, um uns zu loben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200310
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200310,
					"content": "Dann überlasse ich es dir, Uesugi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200311
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200311,
					"content": "#{F#Reisende}{M#Reisender}, geh ein Stück mit mir. Ich kenne einen perfekten Ort, um diese Sakuramochi zu genießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Owada"
				}
			]
		},
		{
			"id": 2202004,
			"completionStepIds": [
				2202005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202005",
							"2"
						],
						"stepId": 2202005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Owada"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200404,
					"content": "Ah ... dieser Ort ist schön, nicht wahr? Ich komme oft hierher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200405
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200405,
					"content": "Die Aussicht ist schön und die Luft ist frisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200406
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200406,
					"content": "Wenn du mich etwas fragen möchtest, ist jetzt die Zeit dafür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200407,
						220200409
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200407,
					"content": "Bist du auch Ryuujis ehemaliger Kollege?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200408
					]
				},
				{
					"id": 220200408,
					"content": "Hat Ryuuji dir das erzählt? Ja, Ryuuji und ich haben einmal zusammen gearbeitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200411
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200411,
					"content": "Ich weiß nicht, ob Ryuuji erwähnt hat, was damals passiert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200412
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200412,
					"content": "Einfach gesagt, Ryuuji war zu impulsiv. Am Ende lief er in eine Falle und wurde zum Sündenbock.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200413
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200413,
					"content": "Ich habe für ihn gebürgt, aber der Richter hat trotzdem darauf bestanden, ihn zu verurteilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200414
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200414,
					"content": "Ich habe viele Leute gebeten, bei der Untersuchung zu helfen, aber sie kamen entweder mit leeren Händen zurück oder sagten mir, dass ich die Untersuchung nicht fortsetzen sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200415
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200415,
					"content": "Hehe, damals ... Wie soll ich es sagen ... Ich habe die Warnung beherzigt und nicht weiter nachgeforscht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200416
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200416,
					"content": "Es ist ein Geheimnis, das jeder kennt, genau wie die Tatsache, dass Ryuuji zu Unrecht beschuldigt wurde. Also macht es mir nichts aus, es dir zu erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200417
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200417,
					"content": "Aber da jeder weiß ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200418
					]
				},
				{
					"id": 220200418,
					"content": "Ah, es ist genau, weil jeder weiß, dass niemand es wagt, sich einzumischen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200419
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200419,
					"content": "Glücklicherweise kam ein Detektiv, der nicht auf dem Laufenden war, zufällig dienstlich auf die Polizeiwache und interessierte sich für den Fall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200420
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200420,
					"content": "Dank dieses Detektivs wurde der Fall endlich gelöst und Ryuujis Name reingewaschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200421
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200421,
					"content": "Ryuuji verließ die Polizeiwache und arbeitete von da an für diesen Detektiv. Das ist die ganze Geschichte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200422
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200422,
					"content": "Warum erzählst du mir das?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200423
					]
				},
				{
					"id": 220200423,
					"content": "Wer hat dich gebeten, mir dieses Geschenk zu machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200424
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200424,
					"content": "Ryuuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200425
					]
				},
				{
					"id": 220200425,
					"content": "Ich bin mir sicher, dass dieses Geschenk Sangos Werk war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200426
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200426,
					"content": "In Anbetracht von Ryuujis Charakter, wenn Sango ihn gebeten hätte, das Geschenk persönlich zu überbringen, hätte er es mir in tadellosem Zustand übergeben, selbst wenn ich in einem Meer aus Feuer gefangen wäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200427
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200427,
					"content": "Aber Ryuuji hat dich gebeten, mir das Geschenk zu überbringen, was bedeutet, dass Sango ihn gebeten hat, dich das machen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200428
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200428,
					"content": "Sango wollte also, dass ich es weiß?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200429
					]
				},
				{
					"id": 220200429,
					"content": "#Hahaha, du bist auch nicht dumm. Deine Anwesenheit hier bedeutet, dass Sango mir sagt: „Ich habe {F#eine neue Helferin}{M#einen neuen Helfer}.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200430
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200430,
					"content": "Es scheint, dass sie noch nicht über das, was damals passiert ist, hinweg ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200431
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200431,
					"content": "Eigentlich ist das nicht überraschend. Immerhin ... hat sie die wahre Person, die diese Falle gestellt hat, noch nicht gefunden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200432
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200432,
					"content": "Nun, ich habe dir alles gesagt, was ich weiß. Du kannst selbst entscheiden, ob du dich Sango anschließen willst oder nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200433
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200433,
					"content": "Oh, und danke Ryuuji für die Sakuramochi für mich. Ich habe sie sehr genossen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200409,
					"content": "Warum hat Ryuuji die Polizei verlassen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200410
					]
				},
				{
					"id": 220200410,
					"content": "Es war seine eigene Entscheidung zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200411
					],
					"speakerTitle": "Owada"
				}
			]
		},
		{
			"id": 2202005,
			"completionStepIds": [
				2202006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202006",
							"2"
						],
						"stepId": 2202006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200501,
					"content": "#Entschuldige, dass ich dich belästigt habe, {F#Reisende}{M#Reisender}. Hast du die Geschenke an alle verteilt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200502,
						220200503
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200502,
					"content": "Hat Sango das alles arrangiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200504
					]
				},
				{
					"id": 220200504,
					"content": "Du hast es herausgefunden? Tut mir leid ... Es war Sangos Idee, dich dazu zu bringen, die zu liefern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200505
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200505,
					"content": "Sango sagte, dass du unentbehrlich sein wirst, wenn es darum geht, diesen Fall zu lösen und den wahren Schuldigen aufzudecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200506,
						220200510
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200506,
					"content": "Ist der Fall immer noch nicht vollständig gelöst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200507
					]
				},
				{
					"id": 220200507,
					"content": "Noch nicht. Sango sagte, dass damals alles perfekt auf den „Schuldigen“ hingedeutet hatte. Zu perfekt, um genau zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200508
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200508,
					"content": "Als Sango mit ihren Ermittlungen begann, fielen ihr alle Hinweise, Motive und Beweise direkt in die Hände und wiesen auf diesen „Täter“ hin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200509
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200509,
					"content": "Diese Person wurde am Ende von der Polizei als Schuldiger festgehalten, aber Sango glaubte, dass der wahre Schuldige jemand anderes war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200514,
					"content": "Ich denke, der Grund, warum sie mich in ihr Büro mitnahm, war die Chance, diesen Fall zu lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200515
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200515,
					"content": "Aber was kann ich tun, um zu helfen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200516
					]
				},
				{
					"id": 220200516,
					"content": "Sangos Gedanken ... Ich kann sie nicht lesen. Aber sie hat mir gegenüber erwähnt, dass sie vielleicht einen Tunnelblick bekommt, weil sie so lange in Inazuma war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200517
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200517,
					"content": "Wenn wir jemanden hätten, der sich auskennt und einen frischen Blick hat, der uns hilft, könnte es vielleicht einen Durchbruch geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200518
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200518,
					"content": "#{F#Reisende}{M#Reisender}, Sango glaubt vielleicht, dass du {F#diejenige bist, die}{M#derjenige bist, der} ihr helfen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200519,
						220200521
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200519,
					"content": "Also bin ich jetzt wohl auch ein Detektiv?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200520
					]
				},
				{
					"id": 220200520,
					"content": "Wenn du bereit bist, uns zu helfen, dann bist du es natürlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200523,
					"content": "Du hast unserer Detektei so sehr geholfen, also bitte akzeptiere die Zahlung dieses Mal im Voraus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200524
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200524,
					"content": "Hat Sango dir auch gesagt, dass du das alles sagen sollst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200525
					]
				},
				{
					"id": 220200525,
					"content": "Nein, das sind alles meine eigenen Worte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200526
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200526,
					"content": "Nochmals vielen Dank für deine Hilfe. Du kannst gern öfter vorbeikommen. Ich bin mir sicher, dass auch Sango deine Anwesenheit begrüßen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200521,
					"content": "Ich nehme an, dass dieser Fall viel einbringt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200522
					]
				},
				{
					"id": 220200522,
					"content": "Ich kann dir keine Zahl nennen, aber die Bezahlung wird sicher gut genug sein, da bin ich mir sicher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200510,
					"content": "Ist dieser Fall das perfekte Verbrechen, von dem Sango gesprochen hat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200511
					]
				},
				{
					"id": 220200511,
					"content": "In der Tat. Sango hat mir einmal erzählt, dass damals alles perfekt auf den „Täter“ hingedeutet hat. Zu perfekt, um genau zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200512
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200512,
					"content": "Als Sango mit ihren Ermittlungen begann, fielen ihr alle Hinweise, Motive und Beweise direkt in die Hände und wiesen auf diesen „Täter“ hin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200513
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200513,
					"content": "Diese Person wurde am Ende von der Polizei als Schuldiger festgehalten, aber Sango glaubte, dass der wahre Schuldige jemand anderes war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200503,
					"content": "Du hättest mir einfach sagen können, was passiert ist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200504
					]
				}
			]
		},
		{
