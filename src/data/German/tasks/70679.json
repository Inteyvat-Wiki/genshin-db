			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gygax"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706790101,
					"content": "Hallo, wie geht es euch? Was für ein Zufall, dass wir uns wiedersehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790102,
						706790104
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790102,
					"content": "Entschuldigung, du bist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790103
					]
				},
				{
					"id": 706790103,
					"content": "Ich bin Gygax! Windflucht, erinnerst du dich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790106,
					"content": "Ach ja, du bist es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706790107,
					"content": "Ich erinnere mich an alles!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790108
					]
				},
				{
					"id": 706790108,
					"content": "Du siehst so aus, als würdest du dich überhaupt nicht erinnern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790109
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790109,
					"content": "Aber egal, bitte schau hier. An „Windflucht“ erinnerst du dich bestimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790110
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790110,
					"content": "Du hattest doch eine Menge Vorschläge für mich, als du mir das letzte Mal dabei geholfen hast, es zu testen. Das hat sehr geholfen, im Grunde habe ich jeden davon übernommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790111
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790111,
					"content": "Ich habe nochmal die Spielregeln und die Weise, wie man ... Nun, einfach gesagt, ich habe einige Verbesserungen vorgenommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790112,
						706790113
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790112,
					"content": "Aber es wird doch nicht zu kompliziert geworden sein, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790114,
					"content": "Keine Sorge. Du wirst lieben, was ich mir ausgedacht habe. Lass mich es dir nur kurz erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790115
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790115,
					"content": "Zuallererst habe ich in dieser brandneuen Windflucht zum ersten Mal etwas hinzugefügt, was ich „Signalgerät“ nenne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790116
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790116,
					"content": "Die Rebellen gewinnen, wenn sie vier „Signalgeräte“ aktivieren und damit den Jäger besiegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790117
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790117,
					"content": "Aber das, was ein Jäger tun muss, ist immer noch dasselbe: Er muss alle Rebellen gefangen nehmen, um gewinnen zu können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790118
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790118,
					"content": "Aber bei dieser Windflucht werden die Rebellen nicht sofort besiegt, wenn sie von einem Jäger gefangen werden, sondern werden an einen Ort namens „Überwachungsgebiet“ geschickt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790119
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790119,
					"content": "Damit ein Rebell aus dem „Überwachungsgebiet“ entkommen kann, muss etwas Zeit vergehen oder ein anderer Rebell dabei helfen. Dann darf der erwischte Rebell weiterspielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790120
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790120,
					"content": "Wenn aber jemand, der schon einmal gefangen worden ist, wieder gefangen wird ... muss er dieses Mal ganz ausgeschlossen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790121,
						706790122
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790121,
					"content": "Klingt schon recht kompliziert ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790123,
					"content": "Immer mit der Ruhe. Es klingt vielleicht kompliziert, aber wenn du erst einmal ein paar Runden gespielt hast, wirst du das alles schon verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790124,
						706790126
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790124,
					"content": "Na gut, ich versuch’s.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790125
					]
				},
				{
					"id": 706790125,
					"content": "Gut! Komm bitte hier rüber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790126,
					"content": "Ich habe noch zu tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790127
					]
				},
				{
					"id": 706790127,
					"content": "Kein Problem. Komm wieder, wenn du Zeit hast. Ich werde noch eine Weile hier sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790122,
					"content": "So viele neue Regeln ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790113,
					"content": "Du hast doch jetzt nicht irgendwelche komischen Spielweisen hinzugefügt, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790104,
					"content": "Du bist ... der Windflucht-Mann!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790105
					]
				},
				{
					"id": 706790105,
					"content": "Ich heiße Gygax! Aber du hast auch recht, mir wäre es lieber, wenn Windflucht bekannter wäre als ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "Gygax"
				}
			]
		}
	]
}