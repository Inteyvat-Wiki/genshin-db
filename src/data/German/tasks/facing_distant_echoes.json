			},
			"dialogs": [
				{
					"id": 726550101,
					"content": "Anscheinend haben wir endlich unser Ziel gefunden! Super! Jetzt kann ich wieder schlafen gehen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550102
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550102,
					"content": "Was? Das soll alles sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550103,
					"content": "Ähm, na ja ... Ich meinte, da wir nun so nah dran sind, sollten wir uns jetzt diese Ruinenmaschine schnappen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550104
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550104,
					"content": "Paimon dachte schon, du gehst jetzt wieder zurück aufs Schiff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550105,
					"content": "*seufz* Ach, was soll’s. Folgen wir ihm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7265502,
			"completionStepIds": [
				7265503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
