			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muzhen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726550201,
					"content": "Haha, hier ist es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550202
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550202,
					"content": "Kaum zu glauben, dass hier auch unterirdische Ruinen sind ... *schluck*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550203,
						726550204
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550203,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550205
					]
				},
				{
					"id": 726550205,
					"content": "Nein, alles ist gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550206
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550206,
					"content": "Du siehst nicht gut aus. Fühlst du dich nicht wohl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550207,
					"content": "Haha! Normalerweise gehe ich nicht von Bord, daher ist dieser Ruineneingang ... nun ja, ein ziemlich beeindruckender Anblick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550208
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550208,
					"content": "Wirklich? Paimon findet ihn gar nicht so beeindruckend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550209,
					"content": "#So oder so muss die Aufgabe erfüllt werden. Du bist doch bestimmt auch neugierig, welche Schätze uns darin erwarten, nicht wahr, {F#Reisende}{M#Reisender}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550210
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550210,
					"content": "Würdest du also mit all deiner Erfahrung und deinen Fähigkeiten die Führung übernehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550211
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550211,
					"content": "Ein hoffnungsloser Fall ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550212
					]
				},
				{
					"id": 726550212,
					"content": "#Das ist er! Komm, {F#Reisende}{M#Reisender}, schnell hin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550204,
					"content": "Hast du etwas rausgefunden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550205
					]
				}
			]
		},
		{
			"id": 7265503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
