			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muzhen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726550301,
					"content": "Hmm? Musst du dich erst noch aufwärmen oder was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550302,
						726550303
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550302,
					"content": "Kannst du mir irgendwas über diese Ruinen sagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550304
					]
				},
				{
					"id": 726550304,
					"content": "Nun, ich bin kein Historiker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550305
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550305,
					"content": "Aber ich glaube, dass diese Ruinen mit der großen Katastrophe vor fünfhundert Jahren zusammenhängen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550306
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550306,
					"content": "Als Kind habe ich oft gehört, wie alte Seefahrer diese Geschichte erzählt haben. Sie sagten, dass weder Land noch Meer dem Abgrund entkommen konnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550307
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550307,
					"content": "Aber ich habe sie als Horrorgeschichten abgetan, die man den Kindern erzählt, um ihnen Angst einzujagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550308
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550308,
					"content": "Ich glaube schließlich nur an das, was ich auch sehen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550303,
					"content": "Weißt du etwas über diese mysteriösen Maschinen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550304
					]
				}
			]
		}
	]
}