			"dialogs": [
				{
					"id": 760320201,
					"content": "He du, weißt du eigentlich, was mit Eindringlingen wie dir passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320202
					],
					"speakerTitle": "Fatui-Oprichniki"
				},
				{
					"id": 760320202,
					"content": "... Sieht so aus, als würde ich es gerade erfahren! Hört mal, das ist alles noch ziemlich neu für mich. Wie wär’s ... ihr gebt mir noch eine Chance, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320203
					],
					"speakerTitle": "Verdächtige Person"
				},
				{
					"id": 760320203,
					"content": "Nur ein Versuch, in Ordnung? Ich verspreche euch, beim nächsten Mal werdet ihr mich nicht erwischen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320204
					],
					"speakerTitle": "Verdächtige Person"
				},
				{
					"id": 760320204,
					"content": "Das soll doch wohl ein Witz sein? <color=#00E1FFFF>Ihr diebischen Ratten</color>, wir lassen keine einzige von euch entkommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320205
					],
					"speakerTitle": "Fatui-Oprichniki"
				},
				{
					"id": 760320205,
					"content": "Hört mal! Gerade jetzt macht sich dieses Mädchen möglicherweise mit all dem Zeug davon! Hab ihr echt die Zeit, mit jemandem wie mir zu diskutieren?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320206
					],
					"speakerTitle": "Verdächtige Person"
				},
				{
					"id": 760320206,
					"content": "Was mit ihr passiert, geht dich nichts an. Ergib dich jetzt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fatui-Oprichniki"
				}
			]
		}
	]
