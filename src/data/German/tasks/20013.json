				"points": []
			},
			"dialogs": [
				{
					"id": 200130301,
					"content": "#Vielen Dank, {F#Reisende}{M#Reisender}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130302
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130302,
					"content": "Eigentlich wollte ich mich dort umsehen, wo Stanley seine Abenteuer verlebt hat. Wer konnte denn ahnen, dass ich auf dem Weg von einer Horde Monster angegriffen werde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130303
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130303,
					"content": "Ich bin einfach zu schwach. Wenn Stanley hier wäre, könnte er es locker mit diesen Kerlen aufnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130304
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130304,
					"content": "Warum gehen wir nicht zusammen auf ein Abenteuer? Hm, lieber nicht. Ich muss auch mal etwas selber machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130305,
					"content": "Ich werde nun weitergehen. Ich kann dir das hier geben. Davon habe ich eine Menge auf dem Weg gepflückt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130306,
					"content": "Vielleicht kannst du ja etwas damit anfangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		}
	]
