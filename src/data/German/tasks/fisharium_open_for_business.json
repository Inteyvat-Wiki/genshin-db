				]
			},
			"dialogs": [
				{
					"id": 747020101,
					"content": "He, ihr habt in letzter Zeit so viele Fische mitgebracht. Das Aquarium sieht langsam wie ein echter Lebensraum im Ozean aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020102,
					"content": "Hehe, wir sind praktisch schon Profi-Fischlein-Fänger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020103,
					"content": "Ihr scheint sehr stolz auf eure Arbeit zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020104,
					"content": "Und ob! Aber hinter diesem Erfolgsgefühl steckt noch etwas anderes ... Eher etwas wie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020105,
						747020106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020105,
					"content": "Bedauern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020107
					]
				},
				{
					"id": 747020107,
					"content": "Ja, genau! So fühlt sich Paimon tief im Inneren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020108,
					"content": "Wieso das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020109,
					"content": "Paimon ist sich nicht sicher ... Es fühlt sich einfach so an, als würde etwas fehlen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020110,
						747020112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020110,
					"content": "Vielleicht ein Restaurant?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020111
					]
				},
				{
					"id": 747020111,
					"content": "He! Sag sowas nicht! Wie kann man es übers Herz bringen, so schöne Fischlein zu essen?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020114,
					"content": "Uns fehlen Besucher, die vorbeikommen und unsere großartige Arbeit bewundern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020115,
					"content": "Du meinst ... Du möchtest das Aquarium für Besucher öffnen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020116,
					"content": "Wäre das denn nicht in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020117,
						747020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020117,
					"content": "Machst du dir Sorgen, dass es zu laut wird?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020119,
					"content": "Wenn das so ist, überlass einfach alles uns! Wir kümmern uns um die Werbung und alle alltäglichen Dinge. Du konzentrierst dich einfach auf deine eigene Arbeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020120,
					"content": "Wenn es das ist, was ihr beiden wollt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020121
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020121,
					"content": "Wir können die Einnahmen im Verhältnis 30:70 aufteilen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020122
					]
				},
				{
					"id": 747020122,
					"content": "#Hä ...? Wir bekommen nur 70{NON_BREAK_SPACE}Prozent?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020123,
					"content": "#Nein, Sandrone bekommt 70{NON_BREAK_SPACE}Prozent.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020124
					]
				},
				{
					"id": 747020124,
					"content": "Ach ja, natürlich ... Sandrone hat dieses Boot schließlich gemietet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020125,
					"content": "Uff, das lässt mich wie eine Art gierige Vermieterin klingen. Ihr macht die Arbeit, also solltet ihr den Löwenanteil bekommen. Ich bin nicht so geizig wie Pantalone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020126
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020126,
					"content": "Das heißt also ... Du gibst uns grünes Licht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020127,
					"content": "Klar, ihr habt meinen Segen. Passt nur auf, dass es meiner Forschung nicht im Weg steht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020128
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020128,
					"content": "Juhu! Das Wingalet-Blubb-Blubb-Unterwasserspaß-Fischarium ist offiziell eröffnet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020129,
					"content": "*seufz* Natürlich hast du dir schon einen Namen ausgedacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020118,
					"content": "Machst du dir Sorgen, dass es viele Probleme verursacht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020112,
					"content": "Vielleicht Besucher?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020113
					]
				},
				{
					"id": 747020113,
					"content": "Oh! Das ist es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020106,
					"content": "Einsamkeit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020107
					]
				}
			]
		}
	]
}