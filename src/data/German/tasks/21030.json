				"points": []
			},
			"dialogs": [
				{
					"id": 210300201,
					"content": "#{F#Reisende}{M#Reisender}, wie ist die Lage dort?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300202
					],
					"speakerTitle": "Herr Zhang"
				},
				{
					"id": 210300202,
					"content": "Dort ist es vorerst sicher.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300203
					]
				},
				{
					"id": 210300203,
					"content": "#Nicht schlecht, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300204
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210300204,
					"content": "Papa hat gesagt, dass sie auch ein paar Leute anheuern, um uns zu beschützen, wenn wir unterwegs sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300205
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210300205,
					"content": "Ich hoffe, die Leute sind genauso gut wie du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300206
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210300206,
					"content": "Onkel Schmied, kannst du damit den Bergbau fortsetzen und dann das Eisen weiter herstellen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300207
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210300207,
					"content": "Hahaha, das ist sicher, ich bin gleich bereit, wieder Erz abzubauen, und dann komme ich später zurück, damit ich mich wieder an die Arbeit machen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300208
					],
					"speakerTitle": "Herr Zhang"
				},
				{
					"id": 210300208,
					"content": "Aber die Menge an Erz, die ich allein tragen kann, ist begrenzt ... Ich hoffe, dass an diesem Ort keine weiteren Monster auftauchen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herr Zhang"
				}
			]
		},
