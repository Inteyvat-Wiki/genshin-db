			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kleiner Meng",
					"Herr Zhang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210300101,
					"content": "Was? Dieses Erz ... Ist es auch anders als dieses?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300102
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210300102,
					"content": "Natürlich. Außerdem sind die Qualität und der Preis der aus diesen beiden Erzarten hergestellten Produkte völlig unterschiedlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300103
					],
					"speakerTitle": "Herr Zhang"
				},
				{
					"id": 210300103,
					"content": "Aha ... Aber wieso gibt es von beiden Erzen nur noch so wenig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300104
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210300104,
					"content": "Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300105
					],
					"speakerTitle": "Herr Zhang"
				},
				{
					"id": 210300105,
					"content": "Was macht ihr da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300106
					]
				},
				{
					"id": 210300106,
					"content": "Hallo, ich helfe meinem Vater, das bestellte Eisen zu überprüfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300107
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210300107,
					"content": "Der Onkel Schmied war so nett und hat mir sogar versprochen, dass er mir ein kleines Schwert machen würde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300108
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210300108,
					"content": "Er sagte jedoch, dass das Geschäft in letzter Zeit nicht genügend Rohstoffe habe und die von Papa bestellten Eisenwaren möglicherweise warten müssen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300109
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210300109,
					"content": "Ich weiß nicht, wann ich mein kleines Schwert machen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300110
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210300110,
					"content": "Leider lässt sich das nicht ändern, denn der Laden hat in letzter Zeit viel Kundschaft bekommen und das Erz ist fast aufgebraucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300111
					],
					"speakerTitle": "Herr Zhang"
				},
				{
					"id": 210300111,
					"content": "In den mineralienreichen Gebieten leben auch viele Monster und ich traue mich nicht hinein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300112
					],
					"speakerTitle": "Herr Zhang"
				},
				{
					"id": 210300112,
					"content": "Ich werde einfach warten müssen, bis ich diese Zeit hinter mir habe, bevor ich einen Abenteurer anheuere, der mich beim Bergbau begleitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300113
					],
					"speakerTitle": "Herr Zhang"
				},
				{
					"id": 210300113,
					"content": "Aber wann wird das sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300114
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210300114,
					"content": "#{NICKNAME}, ich habe von vielen über deine Geschichte gehört. Bist du nicht gut darin, Monster zu bekämpfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300115
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210300115,
					"content": "Kannst du helfen? Bitte, bitte, bitte, bitte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300116,
						210300117
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210300116,
					"content": "Ich werde das machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				},
				{
					"id": 210300118,
					"content": "#{F#Reisende}{M#Reisender}, willst du sehen, was da los ist? Dann werde ich mal meine üblichen Abbaustellen für dich markieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300119
					],
					"speakerTitle": "Herr Zhang"
				},
				{
					"id": 210300119,
					"content": "Das war’s, das sind die Orte. Seid vorsichtig, wenn ihr dort hingeht, denn es gibt dort viele Monster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300120
					],
					"speakerTitle": "Herr Zhang"
				},
				{
					"id": 210300120,
					"content": "Dann zähle ich auf dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210300117,
					"content": "Ich, ähm ... werde mal sehen, was ich tun kann.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				}
			]
		},
		{
