			"dialogs": [
				{
					"id": 715360301,
					"content": "#So funktioniert es also ... Diese Glückwunschkarte ist wunderschön, {NICKNAME}. Danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360302
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360302,
					"content": "Nun, ich werde später noch ein paar mehr machen, wie du es mir beigebracht hast, und sie den Leuten im Dorf zusammen mit den Geschenken geben. Darüber werden sie sich bestimmt freuen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360303
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360303,
					"content": "Und das von dir angefertigte Exemplar werde ich allerdings selbst in Ehren halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Candace"
				}
			]
		}
