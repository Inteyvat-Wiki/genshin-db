			},
			"dialogs": [
				{
					"id": 715360101,
					"content": "#Frohes Laternenritual, {NICKNAME}! Ich habe gehört, dass du Dehya mit ihrer Glückwunschkarte geholfen hast. Sie ist wunderschön, danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360102
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360102,
					"content": "Ist jetzt alles in deinem Dorf in Ordnung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360103
					]
				},
				{
					"id": 715360103,
					"content": "Ja, dank der Hilfe von Dehya und den anderen ist das Dorf jetzt gut bewacht und ich kann beruhigt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360104
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360104,
					"content": "Nutze die Zeit, um mal zur Ruhe zu kommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360105
					]
				},
				{
					"id": 715360105,
					"content": "Ja, das werde ich. Dehya sagte auch, dass sie das Dorf Qiaoying in ein paar Tagen besuchen möchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360106
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360106,
					"content": "Sie sagte, dass die Landschaft sehr schön ist und dort auch guter Tee produziert wird, ein perfektes Geschenk für die Leute in meinem Dorf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360107
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360107,
					"content": "Ich wollte auch ein paar Glückwunschkarten für sie anfertigen, wie es in Liyue Tradition ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360108
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360108,
					"content": "Aber Dehya hat unseren Terminkalender so vollgepackt, dass wir hier immer viel zu tun haben. Ich bin mir nicht sicher, ob ich noch Zeit dafür hab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360109
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360109,
					"content": "Dehya hat mir erzählt, dass du sehr gut darin bist, Glückwunschkarten zu basteln. Kannst du mir zeigen, wie man das macht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360110
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360110,
					"content": "Ja, das mach ich gern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
