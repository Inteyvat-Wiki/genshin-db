				"points": []
			},
			"dialogs": [
				{
					"id": 752650301,
					"content": "He, Freundchen! Ich habe richtig gute Sachen hier ... was, schon wieder ihr?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650302
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650302,
					"content": "Ich habe doch gesagt: Nichts für euch! Verschwindet endlich und stört mich nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650303
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650303,
					"content": "Du ... willst du dich jetzt entschuldigen, oder müssen wir nachhelfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650304,
					"content": "Was stimmt mit euch nicht?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650305
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650305,
					"content": "Du verkaufst Fälschungen, stimmt’s?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650306
					]
				},
				{
					"id": 752650306,
					"content": "Ha! Und wenn schon? Kümmert euch um euren Kram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manou"
				}
			]
		},
