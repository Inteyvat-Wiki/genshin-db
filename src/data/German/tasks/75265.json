				"objectNames": [
					"Manou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752650101,
					"content": "He, Freundchen! Ich habe richtig gute Sachen hier – top Qualität, super Preis! Wollt ihr mal gucken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650102
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650102,
					"content": "Hm? Sind das nicht diese Koholasaurier-Plüschtiere? Die habe ich doch auf dem Leichtbrise-Markt gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650103,
					"content": "Na, du hast echt ein gutes Auge! Aber bei mir kriegst du das Ding zum halben Preis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650104
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650104,
					"content": "Warum so günstig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650105
					]
				},
				{
					"id": 752650105,
					"content": "Hehe, das ist mein Geheimnis. Ich habe halt meine Quellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650106
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650106,
					"content": "Aber die Farben sehen irgendwie komisch aus. Sind das Fälschungen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650107,
					"content": "Fälschungen?! Du hast doch null Ahnung, du kleiner Dummkopf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650108
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650108,
					"content": "Los, los, verzieht euch! Euch verkaufe ich nichts mehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manou"
				}
			]
		},
		{
