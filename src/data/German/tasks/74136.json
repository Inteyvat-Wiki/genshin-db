			},
			"dialogs": [
				{
					"id": 741360901,
					"content": "Die Schergen vom Forschungsinstitut! Wie viel haben Choiseul und Raimondo euch gezahlt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360902,
						741360903
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360902,
					"content": "Sie haben mir nur einen Titel verliehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360904
					]
				},
				{
					"id": 741360904,
					"content": "Du ... Du ... Hör mir zu, lass mich gehen, mein „Feldgenerator“ ist nahezu fertig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360905
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360905,
					"content": "Wenn es mir gelingt, ihn erfolgreich mit dem Arkhium-Energiekern zu verbinden, dann ... dann bin ich der größte Ingenieur für kinetische Energie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360906
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360906,
					"content": "... Du stiehlst die Früchte der Arbeit anderer und willst damit auch noch zum größten Ingenieur werden. Wirklich schamlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360907
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360907,
					"content": "Endlich verstehe ich, warum Ed... warum Herr Edwin damals nie dazu bereit war, dich an der Kernforschung teilnehmen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360908
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360908,
					"content": "Edwin hat den Nutzen dieses Dings nie erkannt! Auch du bist vom Forschungsinstitut ... Du kennst den Wert davon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360909
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360909,
					"content": "Hilf mir, ich kann ... ich kann mit dir zusammen daran arbeiten. Wenn die Zeit gekommen ist, wird sich niemand mit unserem Ruhm messen können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360910
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360910,
					"content": "Edwin, Raimondo, Choiseul ... sie alle werden uns nicht mehr zurückhalten können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360911,
						741360912
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360911,
					"content": "Anscheinend hat Raimondo die Wahrheit gesagt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360913
					]
				},
				{
					"id": 741360913,
					"content": "Die Erfolge von ... Herrn Edwin gehören dem Forschungsinstitut. Ich bin nur hier, um sie zurückzuholen. Alles andere ... ist für mich nicht von Interesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360914
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360914,
					"content": "Fräulein Fusilier ... nutzt nun plötzlich eine andere Anrede für Edwin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360915,
					"content": "Begeh keinen Fehler! Du weißt nicht, welch große Belohnungen Herr Concini für uns bereithält!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360916
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360916,
					"content": "Selbst wenn du für Edwin zehntausend Jahre lang Botengänge erledigst, wirst du nicht so viel verdienen! Edwin und das Forschungsinstitut wollen uns nur ausnutzen ... Wir müssen an uns selbst denken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360917
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360917,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360918
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360918,
					"content": "Gut, genug mit dem Geschwätz. Du, halt deinen Mund.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360919
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360919,
					"content": "Und wer bist du nun schon wieder?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360920
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360920,
					"content": "Der Beschützer des Lumidouce-Hafens. Wenn du noch ein Wort mehr sagst, dann setzt es was.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360921
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360921,
					"content": "#{NICKNAME}, hilf mir dabei, ihn zu fesseln und diesen Kerl mitzunehmen. Wir sollten zurückkehren und unseren Auftrag abschließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360912,
					"content": "Es muss hart für dich gewesen sein, so lange zu schauspielern, Herr Nacker.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360913
					]
				},
				{
					"id": 741360903,
					"content": "Keine einzige Mora, ich erfülle nur meine Pflicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360904
					]
				}
			]
		},
		{
