			"dialogs": [
				{
					"id": 741361001,
					"content": "Edwin ... Ich wusste es doch gleich! Du hast sie hierhergeführt ... Du beneidest mich! Du fürchtest, dass meine Forschungserfolge die deinen übertreffen werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361002
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361002,
					"content": "Ja, ich beneide dich wirklich um deine ahnungslose und selbstgefällige Art. Kein Wunder, dass du früher im Forschungsinstitut so gut zurechtgekommen bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361003
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361003,
					"content": "Wenn Choiseul das sehen könnte, dann würde er bestimmt in Ohnmacht fallen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361004,
						741361005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361004,
					"content": "Und es wäre am besten, wenn er nicht mehr daraus aufwachen würde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361006
					]
				},
				{
					"id": 741361006,
					"content": "Kehr du brav mit ihnen ins Forschungsinstitut zurück und bekenne deine Fehler. Ich werde die Forschung fortsetzen ... Du hast meine Forschungsgeräte doch wohl nicht beschädigt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361007,
						741361008
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361007,
					"content": "Wer sagt, dass du zu deiner Forschung zurückkehren kannst?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361009
					]
				},
				{
					"id": 741361009,
					"content": "Was wollt ihr denn noch von mir? Ihr wollt mich doch nicht etwa ins Forschungsinstitut bringen? Wie könnte ich dann meine Forschung fortsetzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361010
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361010,
					"content": "Raimondo, dieser Idiot, hat das Forschungsinstitut sicher ins Chaos gestützt. Und dann ist da noch Choiseul, dieser Trottel, liebe Güte ... Ich bekomme Kopfschmerzen, wenn ich nur daran denke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361011
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361011,
					"content": "Du warst es doch, der das Forschungsinstitut ins Chaos gestützt hat. Schieb jetzt nicht anderen die Schuld zu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361012,
					"content": "Ich? Ach ja? Das Forschungsinstitut hat mir die alleinige Schuld an der Explosion des Zentrallaboratoriums zugeschoben, richtig? Dabei war ich damals doch gar nicht im Forschungsinstitut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361013
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361013,
					"content": "Im Forschungsinstitut herrscht kein Mangel an Idioten und es reicht, eine Kaffeetasse umzukippen, um Forschungsapparate lahmzulegen. Da ist es doch kein Wunder, dass es zu einer solchen Explosion gekommen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361014
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361014,
					"content": "Und warum erklärst du ihnen dann nicht einfach, wie es wirklich ist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361015
					]
				},
				{
					"id": 741361015,
					"content": "Erklären? Ich werde nicht für sie den Sündenbock spielen. Ich habe noch viele Forschungsarbeiten zu erledigen und kann es mir nicht leisten, meine Zeit zu vergeuden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361016
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361016,
					"content": "Und deswegen hast du dich mit diesem Kerl namens Concini zusammengetan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361017
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361017,
					"content": "Oh, Concini ist auch ziemlich unfähig ... Er kann nicht einmal einen Präzisionsapparat kaufen. Ich muss mich um alles selbst kümmern. Zum Glück ist er bereit, Geld auszugeben, sodass meine Forschung reibungslos verläuft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361018
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361018,
					"content": "Aber ich hätte nicht vermutet, dass unser lieber Herr Nacker hier mit diesem Kernprototyp auftauchen würde, der nicht einmal über die vollständigen Funktionen verfügt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361019
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361019,
					"content": "Ich habe ihn bereits umgebaut! Die von mir verwendete Technik wirst du niemals entwickeln können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361020
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361020,
					"content": "Hahaha. Herr Nacker, Concini ist nicht hier, bei wem willst also Eindruck schinden? Du machst dir doch nur selbst etwas vor. Hast du denn kein bisschen Selbstachtung als Forscher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361021
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361021,
					"content": "Du ...! Diese unvollständigen Funktionen sind nur deswegen unvollständig, weil du nicht weißt, wie du sie ergänzen kannst! Ich hingegen weiß es, ich kann es vollbringen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361022
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361022,
					"content": "Ach ja? Dann nimm dieses Stück Müll mit zurück ins Forschungsinstitut und treibe weiter deine Spielchen. Ich habe mich um wichtigere Dinge zu kümmern. Ich überlasse diese Sache dir, Fusi... irgendwas, oder wie auch immer du heißen magst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361023
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361023,
					"content": "Warum streiten sich diese beiden unablässig miteinander, als ob sie ganz alleine auf der Welt wären ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361024,
					"content": "... Genug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361025
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361025,
					"content": "Was soll das? Könntest du aufhören, meine Zeit zu verschwenden? Ich muss meine Arbeit fortsetzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361026
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361026,
					"content": "Ich habe gesagt ... genug!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361027
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361027,
					"content": "Edwin Eastinghouse! Du bist der Hauptverantwortliche für die Explosion im Forschungsinstitut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361028
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361028,
					"content": "Nacker! Du hast das Eigentum des Forschungsinstituts gestohlen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361029
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361029,
					"content": "Und hast eine weitere Explosion im Forschungsinstitut herbeigeführt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361030
					]
				},
				{
					"id": 741361030,
					"content": "Ihr habt den Interessen des Forschungsinstituts geschadet ... Als Sonderermittlerin des Forschungsinstitut Fontaine werde ich euch alle zurück ins Forschungsinstitut bringen, wo weitere Maßnahmen gegen euch eingeleitet werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361031
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361031,
					"content": "Argh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361032
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361032,
					"content": "Ach, komm schon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361033
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361033,
					"content": "Lemarcq und ich werden dabei helfen, diese beiden zu überstellen. Nach all dieser Zeit der harten Arbeit ... wird das Forschungsinstitut uns sicher belohnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361034
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361034,
					"content": "Und denkt daran, auf dem Weg den Mund zu halten. Andernfalls werdet ihr schon vorzeitig zum Endpunkt eurer Reise gelangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361008,
					"content": "Du bleibst mal schön hier!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361009
					]
				},
				{
					"id": 741361005,
					"content": "Ich falle auch gleich in Ohnmacht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361006
					]
				}
			]
		},
