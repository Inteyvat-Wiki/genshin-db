			},
			"dialogs": [
				{
					"id": 741361101,
					"content": "#Fräulein Fusilier! {NICKNAME}, ihr seid zurück! Ihr habt sicher alles erledigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361102
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361102,
					"content": "Oh, nein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361103
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361103,
					"content": "Oje! Herr Choiseul fällt gleich noch wirklich in Ohnmacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361104,
					"content": "Ich hätte nicht gedacht, dass du wieder zurück ins Forschungsinstitut kommen würdest, Choiseul. Ich habe angenommen, dass du den Rest deines Lebens mit Stempeln verbringen würdest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361105
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361105,
					"content": "Das ... Das ist unmöglich! Meine Güte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361106
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361106,
					"content": "Raimondo, wie fühlt es sich an, meine Arbeit zu übernehmen? Gibt es etwas, von dem du mir berichten möchtest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361107
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361107,
					"content": "... Was für ein wundervolles Wiedersehen, Herr Edwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361108
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361108,
					"content": "Ha! Wenn ich mich hier so umsehe, bist du wirklich gut für Aufräumarbeiten geeignet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361109
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361109,
					"content": "... Hmpf. Wirklich Ordnung hat er jedoch nicht gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361110
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361110,
					"content": "Es bist hauptsächlich du, der die Ordnung stört.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361111
					]
				},
				{
					"id": 741361111,
					"content": "#Ich danke euch vielmals, dass ihr die beiden zurückgebracht habt, {M#ehrenamtlicher Spitzenforscher}{F#ehrenamtliche Spitzenforscherin} {NICKNAME} und Fräulein Fusilier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361112
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361112,
					"content": "Das Unglück und Chaos im Forschungsinstitut Fontaine werden heute ein für alle Mal ihr Ende finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361113
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361113,
					"content": "Hahaha, das Forschungsinstitut Fontaine wird in eine Todesstille verfallen, ohne jegliche Impulse der Inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361114
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361114,
					"content": "Du hast schon für genügend „Impulse der Inspiration“ im Forschungsinstitut Fontaine gesorgt. Es wird Zeit, dass hier wieder ein wenig Ruhe einkehrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361115
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361115,
					"content": "Raimondo Havenport, du verstehst nichts von Forschung und bist nicht in der Lage, das Forschungsinstituts für kinetische Energie Fontaine zu leiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361116
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361116,
					"content": "Doch ich verstehe etwas davon, einen geordneten und regulären Betrieb im Forschungsinstituts für kinetische Energie Fontaine zu etablieren, Edwin Eastinghouse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361117
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361117,
					"content": "Was du nun tun musst, ist, dich von Arkhium und Forschung fernzuhalten, das wäre für alle nur von Vorteil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361118
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361118,
					"content": "Nach einer Weile sind die Leute von Maison Gardiennage eingetroffen, um Nacker und Edwin abzuführen. Damit wurden sie nun endlich endgültig aus dem Forschungsinstitut Fontaine entfernt ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741361119
					]
				},
				{
					"id": 741361119,
					"content": "Dem Himmel sei Dank, ich bin nun endlich aus diesem Albtraum erwacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361120
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361120,
					"content": "Ihr seid Herr Chaussivert und Herr Lemarcq, nicht wahr? Ich habe bereits davon gehört, dass ihr die Arbeit unseres Instituts unterstützt habt. Ein angemessenes Dankesgeschenk ist bereits in Vorbereitung. Ich bitte euch, hier ein wenig zu warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361121
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361121,
					"content": "Hahaha, ich hätte nicht gedacht, dass jemandem wie mir einmal die Wertschätzung des Forschungsinstituts zuteilwerden würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361122
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361122,
					"content": "Rede nicht so über dich selbst! Du bist aufrichtig, warmherzig und ein wirklich guter Mensch! Vielleicht werden wir dich in Zukunft wieder um Hilfe bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361123
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361123,
					"content": "#Und du ... {M#ehrenamtlicher Spitzenforscher}{F#ehrenamtliche Spitzenforscherin}, du hast dem Forschungsinstitut wieder einen großen Gefallen erwiesen. Wie sollen wir dir nur danken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361124,
						741361125
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361124,
					"content": "Es würde reichen, wenn ihr keine Explosionen mehr verursachen würdet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361128
					]
				},
				{
					"id": 741361128,
					"content": "Hm, apropos ... Was ist mit Fräulein Fusilier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361129,
					"content": "... Wir sollten dem Fräulein erst einmal Zeit geben, sich zu beruhigen. Wie es aussieht, wurde das Bild, das sie von Edwin Eastinghouse hatte, nun schließlich zerstört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361130
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361130,
					"content": "Edwin und Nacker müssen ebenfalls ein wenig zur Ruhe kommen ... Hoffentlich werden sie schon bald ein klareres Bild von sich selbst bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361131
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361131,
					"content": "Werden sie den Rest ihres Lebens im Fort Méropide verbringen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361132
					]
				},
				{
					"id": 741361132,
					"content": "Wenn man bedenkt, wie gefährlich sie sind, dann hoffe ich, dass sie jenen Ort niemals wieder verlassen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361133
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361133,
					"content": "Aber wenn ich mir die aktuelle Situation im Forschungsinstitut Fontaine vor Auge führe ... *seufz* Ich hoffe, ich werde auf keine Probleme stoßen, bei denen ich auf ihre Hilfe angewiesen sein werde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361134
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361134,
					"content": "#Ich möchte dir noch einmal im Namen des Forschungsinstituts Fontaine danken, {M#ehrenamtlicher Spitzenforscher}{F#ehrenamtliche Spitzenforscherin}. Wenn du noch irgendwelche Fragen hast, kannst du dich jederzeit an mich wenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361125,
					"content": "Wie wäre es, wenn ihr meinen Titel noch weiter hochstufen würdet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361126
					]
				},
				{
					"id": 741361126,
					"content": "Hm, theoretisch ist dein derzeitiger Titel bereits der Höchste ... Aber ich kann versuchen, für dich einen Sondertitel zu beantragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361127
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361127,
					"content": "#Wie zum Beispiel ... {M#vorsitzender ehrenamtlicher Spitzenforscher}{F#vorsitzende ehrenamtliche Spitzenforscherin}? Hahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361128
					],
					"speakerTitle": "Choiseul"
				}
			]
		},
		{
