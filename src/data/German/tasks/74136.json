			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Edwin Eastinghouse",
					"Lemarcq"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741363401,
					"content": "Warum bist ... Ähem, du bist wirklich zurückgekehrt. Siehst du, ich wusste doch gleich, dass ihr nichts finden werdet, auch wenn ihr das Gebiet fünfmal absucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363402
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363402,
					"content": "Es wird euch wirklich nicht gelingen. Setzt euch lieber und trinkt eine Tasse Tee. Ich habe gerade passenderweise fünf Teetassen gekauft ... und mehrere Teeschalen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363403
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363403,
					"content": "Du scheinst die Zahl Fünf ja wirklich sehr gerne zu mögen, Herr Edwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363404
					],
					"speakerTitle": "Lemarcq"
				},
				{
					"id": 741363404,
					"content": "Ah, es ist wirklich eine magische Zahl. Bei richtiger Verwendung kann sie das Tor der Inspiration öffnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363405
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363405,
					"content": "Da wir gerade davon reden, es gibt fünf Türen zur unendlichen Inspiration und man muss den Türgriff mindestens fünfmal drehen ... Fünf! Verstehst du? Fünfmal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363406
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363406,
					"content": "Tut mir leid, ich würde dir jetzt wirklich gerne fünf Schläge erteilen. Wie wäre es, wenn du jetzt erst einmal den Mund hältst, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lemarcq"
				}
			]
		}
	]
}