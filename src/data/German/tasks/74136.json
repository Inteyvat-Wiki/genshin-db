			"dialogs": [
				{
					"id": 741360401,
					"content": "Er hat also dauernd das Wort „fünf“ wiederholt, um uns einen Hinweis auf das Rätsel zu geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360402,
					"content": "Das hätte er uns doch auch einfach gleich sagen können. Warum hat er es so kompliziert gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360403,
					"content": "Tss, wer kann schon sagen, was dieser Kerl im Schilde führt ... Aber scheinbar wollte er uns die ganze Zeit dazu bringen, Nacker zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360404
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360404,
					"content": "Die Taucheranzüge sind gleich neben dem Haus, ganz so, als ob sie speziell für uns vorbereitet worden wären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360405,
						741360406
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360405,
					"content": "Es sieht also danach aus, als ob er uns gefunden hätte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360407
					]
				},
				{
					"id": 741360407,
					"content": "Keinen Forschungswert ... Ich ... Ich habe so viel Mühe investiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360408
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360408,
					"content": "Fräulein Fusilier ... hatte die ganze Zeit vor sich hin gemurmelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360409,
					"content": "#Aber ... {NICKNAME}, kommt es dir nicht auch so vor, als ob wir beobachten werden? Paimon hat irgendwie ein komisches Gefühl ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360410,
					"content": "... Ich gehe voran. Mal sehen, was da drin ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360406,
					"content": "Wie auch immer, wir müssen uns zunächst um Nacker kümmern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360407
					]
				}
			]
		},
