			},
			"dialogs": [
				{
					"id": 741360601,
					"content": "Ein großer leerer Raum, in dem sich ... nichts zu befinden scheint. War das alles umsonst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360602,
					"content": "Die Pflanzen hier wurden gezielt entfernt und die Schnittspuren sind ebenfalls noch frisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360603
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360603,
					"content": "... Und ich habe noch extra für ihn diese Mühen auf mich genommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360604
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360604,
					"content": "Jedenfalls werde ich erstmal alleine nach unten gehen und mich umsehen. Ihr bleibt beim Fräulein vom Forschungsinstitut, sollte die Lage gefährlich werden ... dann bringt sie schleunigst von hier weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360605
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360605,
					"content": "Aber hier ist rein gar nichts. Ich kann mir nicht vorstellen, dass es allzu gefährlich werden sollte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360606
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360606,
					"content": "*knirsch* ... *knarz* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360607
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360607,
					"content": "Waah! Vorsicht! Da kommt was!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
