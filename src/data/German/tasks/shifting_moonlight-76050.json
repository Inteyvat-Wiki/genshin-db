						760500903
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500903,
					"content": "Hehe, das heißt wohl, dass wir es gut gemacht haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500904,
					"content": "Sie sind wirklich so weich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500905
					]
				},
				{
					"id": 760500905,
					"content": "Moment, wir bekommen eine Belohnung, obwohl wir falsch lagen? Hm, na ja ... Gegen einen Trostpreis hat Paimon nichts einzuwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500906,
					"content": "So eine brave kleine Kuuhenki ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500907
					]
				},
				{
					"id": 760500907,
					"content": "Die Kuuhenki scheinen dich zu mögen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500908
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760500908,
					"content": "Ich spüre das ... In deiner Gegenwart sind sie ganz entspannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500909
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760500909,
					"content": "Genau wie Rauhorn-Hirschkälber gerne im Mondlicht baden, fühlen sich Kuuhenki von dem, was dein Herz ausstrahlt, angezogen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500910
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760500910,
					"content": "Ah? Und was wäre das genau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500911,
					"content": "Eine gewisse Freundlichkeit und Sanftheit, nehme ich an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				}
			]
		}
	]
