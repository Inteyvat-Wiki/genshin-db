			"dialogs": [
				{
					"id": 760500101,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500102
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500102,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500103
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500103,
					"content": "Ooh, hier geht es ja heute richtig lebhaft zu! Die ganzen Kuuhenki tanzen um Columbina herum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500104,
					"content": "Hm, aber warte mal ... Das ist doch kein Tanzen. Sieht eher danach aus, als versuchen sie ... sie unter einem Haufen Niedlichkeit lebendig zu begraben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500105,
					"content": "Hel... Helft mir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500106
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760500106,
					"content": "Gib mir deine Hand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500107
					]
				},
				{
					"id": 760500107,
					"content": "Puhh ... Danke ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500108
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760500108,
					"content": "Warum haben die Kuuhenki das denn gerade gemacht ...? Sie sind doch sonst nicht so energiegeladen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500109,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500110
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500110,
					"content": "Na ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500111
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760500111,
					"content": "Ich habe mit den Kleinen ein Spiel gespielt, und sie scheinen daran richtig Spaß gehabt zu haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500112
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760500112,
					"content": "Wuseln nach dem Spielen so um dich herum ... Wie Welpen irgendwie, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500113,
					"content": "Vielleicht zeigen sie so ihre Dankbarkeit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500114
					]
				},
				{
					"id": 760500114,
					"content": "Mhh ... Nur, dass sich ihre Dankbarkeit diesmal eher angefühlt hat, als wäre ich in eine unerwartete Schneewehe geraten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500115
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760500115,
					"content": "Das sagst du jetzt zwar so, aber Paimon wettet, dass du keine Gelegenheit auslässt, sie richtig zu verhätscheln!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500116,
					"content": "Jedenfalls, wollt ihr zwei es denn mal versuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500117,
						760500119
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760500117,
					"content": "Du meinst ... uns so von ihnen umzingeln zu lassen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500118
					]
				},
				{
					"id": 760500118,
					"content": "Hm ... Das kriegen wir hin. Du musst nur die richtige Antwort finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500121
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760500121,
					"content": "Oh, klar doch. Es wäre spannend zu erfahren, welches Spiel die Kuuhenki so ausflippen lassen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500122,
					"content": "Los jetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500123
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760500123,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500124
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500124,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500119,
					"content": "Du meinst ... ein Spiel mit den Kuuhenki spielen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500120
					]
				},
				{
					"id": 760500120,
					"content": "Ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500121
					],
					"speakerTitle": "„Columbina“"
				}
			]
