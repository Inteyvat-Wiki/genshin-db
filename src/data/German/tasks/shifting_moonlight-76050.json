			"dialogs": [
				{
					"id": 760500301,
					"content": "Du musst einfach nur das Bild erraten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500302
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760500302,
					"content": "Hä? Ab... Aber ... das ist viel zu abstrakt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500303,
					"content": "Hast du denn gerade tatsächlich die richtige Antwort gefunden, Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500304,
					"content": "Nein, ich lag öfter daneben als richtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500305
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760500305,
					"content": "#Hm, Paimon gibt lieber auf, solange sie noch vorn liegt ... Warum rätst du nicht mal, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500306,
						760500310,
						760500315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500306,
					"content": "Es ist ... ein Rauhorn-Hirsch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500307
					]
				},
				{
					"id": 760500307,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500308
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500308,
					"content": "Oha, diese Reaktion muss ja bedeuten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500309,
					"content": "Glückwunsch, deine Antwort ist korrekt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760500310,
					"content": "Es ist ... ein Langhalsnashorn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500311
					]
				},
				{
					"id": 760500311,
					"content": "Uff! Ein Langhalsnashorn mit einer schwerwiegenden Halsverletzung vielleicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500312,
					"content": "Hmm ... So eine Kreatur habe ich noch nie zuvor gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500313
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760500313,
					"content": "Die richtige Antwort war „Rauhorn-Hirsch“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500314
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760500314,
					"content": "Kommt wieder zurück, ihr Kleinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760500315,
					"content": "Eine Harpune mit einer nach hinten gebogenen Zinke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500316
					]
				},
				{
					"id": 760500316,
					"content": "Du hast echt eine blühende Fantasie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500317,
					"content": "Heh ... Eine amüsante Antwort, so viel ist sicher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500318
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760500318,
					"content": "Die richtige Antwort war „Rauhorn-Hirsch“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500319
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760500319,
