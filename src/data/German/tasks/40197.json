			"dialogs": [
				{
					"id": 401970101,
					"content": "Jetzt, da wir so weit gekommen sind, brauchen wir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970102,
					"content": "Eine Prise Salz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970103
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970103,
					"content": "Eigentlich eine Prise Pfeffer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970104,
					"content": "Ah, genial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970105
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970105,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970106,
					"content": "Ihr redet doch nicht zufällig über eine neue Dessertkarte, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970107,
					"content": "Pfeffer passt nicht wirklich zu einem Dessert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970108
					]
				},
				{
					"id": 401970108,
					"content": "Nicht Desserts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970109
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970109,
					"content": "Wir reden über das Drehbuch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970110
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970110,
					"content": "Äh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970111
					]
				},
				{
					"id": 401970111,
					"content": "#Mein{F#e} liebe{M#r} Partner{F#in}, Fotograf{F#in}, angehende{M#r} Regisseur{F#in} ... Unsere Kreativität muss mit der überschäumenden Begeisterung unserer Fans Schritt halten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970112,
					"content": "Auf meiner Bühne ist kein Platz für langweilige Drehbücher! Wendungen in der Geschichte müssen das Publikum heftig wie eine Pfefferwolke treffen und sie vor Überraschung niesen lassen. HATSCHI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970113,
					"content": "Dasselbe gilt genauso für die Gastronomie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970114
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970114,
					"content": "Ich habe einmal Fräulein Émilie sagen hören, dass Pfeffer in Parfüms verwendet werden kann. Vielleicht kann ich ja auch einen Weg finden, ihn in Süßspeisen einzusetzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970115
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970115,
					"content": "Hmm ... Ein pfeffriger Kick, der die zarte Süße der Sahne ergänzt, möglicherweise ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970116,
					"content": "Waah! Die beiden sind echt ein gutes Team ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970117,
					"content": "Allerdings kann sich Paimon nur schwer vorstellen, wie ein Kuchen mit Pfeffer schmecken könnte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970118,
					"content": "Na aber sowas, was haben wir denn hier? Escoffier backt einen neuen Kuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970119
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970119,
					"content": "Ja, und sie experimentiert mit ein paar neuen Ideen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970120
					]
				},
				{
					"id": 401970120,
					"content": "Ui, wie aufregend! Sag mir unbedingt Bescheid, wenn es so weit ist. Das würde ich nur zu gern probieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970121
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970121,
					"content": "Liegt es nur an Paimon, oder sind alle noch begeisterter, jetzt wo die Arbeit abgeschlossen ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970122,
					"content": "Warum sollten sie denn nicht? Wenn sich die harte Arbeit auszahlt ... dann ist es Zeit, auf den Putz zu hauen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970123,
					"content": "Es ist wie bei einer frischen Portion Macarons — du solltest dich von der Angst vor Süße nicht davon abhalten lassen, so viel Füllung hinzuzufügen, wie du möchtest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970124
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970124,
					"content": "Denn wenn es einen Moment gibt, wo man nicht mit Zucker sparen sollte, dann ist es bei Macarons!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970125
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970125,
					"content": "Her mit dem Zucker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970126
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970126,
					"content": "Her mit dem Zucker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970127
					],
					"speakerTitle": "Lépine-Pauline"
				},
				{
					"id": 401970127,
					"content": "... Äh, warum eigentlich so viel Zucker?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970128
					],
					"speakerTitle": "Lépine-Pauline"
				},
				{
					"id": 401970128,
					"content": "Lépine-Pauline, da bist du ja! Ist es fertig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970129
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970129,
					"content": "Natürlich! Alles lief genau nach Plan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970130
					],
					"speakerTitle": "Lépine-Pauline"
				},
				{
					"id": 401970130,
					"content": "Huch? Warst du mit einem wichtigen Auftrag beschäftigt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970131,
					"content": "Ja, so ist es! Hier, bitte nimm das!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970132
					],
					"speakerTitle": "Lépine-Pauline"
				},
				{
					"id": 401970132,
					"content": "Was ist das ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970133
					]
				},
				{
					"id": 401970133,
					"content": "Oh waah! Das ist ja eine Panoramaansicht vom Vergnügungspark, mit Illustrationen von jedem darauf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970134,
					"content": "Hehe, da das Filmtasieland so ein riesiger Erfolg war, haben wir beschlossen, ein besonderes Andenken daran zu schaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970135
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970135,
					"content": "Wir haben dieses Filmtasieland gemeinsam, Stein für Stein, aufgebaut. Deshalb haben wir auch beschlossen, diese Karte zusammen zu zeichnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970136
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970136,
					"content": "Ehrlich gesagt, verdanken wir das hauptsächlich Fräulein Lépine-Pauline. Sie ist ja schließlich unsere Zeichenexpertin. Aber wir haben alle unser Bestes gegeben, damit jeder von uns seine ganz eigene Handschrift hinterlässt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970137
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970137,
					"content": "Genauso ist es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970138
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970138,
					"content": "#Und außerdem möchte ich dir, {NICKNAME}, ein ganz besonderes Privileg anbieten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970139
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970139,
					"content": "Du darfst meinem Porträt einen Schnurrbart hinzufügen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				}
			]
		},
