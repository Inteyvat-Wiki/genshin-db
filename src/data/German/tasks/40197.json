			},
			"dialogs": [
				{
					"id": 401970201,
					"content": "Super! Wie wäre es mit einem <color=#C4D6EAFF>weißen</color>?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970202
					]
				},
				{
					"id": 401970202,
					"content": "Sahnegeschmack, also? Sehr traditionell, aber auch ... sehr lecker! Mhm, du hast meine Erlaubnis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970401
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970401,
					"content": "#Also dann! Jetzt bist du {M#der stolze Besitzer}{F#die stolze Besitzerin} dieser Gedenkkarte und kannst darauf die verschiedensten Schnurrbärte mit allen möglichen Geschmacksrichtungen zeichnen. Ganz, wie es dir gefällt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970402
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970402,
					"content": "Hehe, das klingt nach einer ziemlich leckeren Karte. Wir werden sie gut aufbewahren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970403,
					"content": "Wunderbar! Eure Zufriedenheit steht bei uns an erster Stelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970404
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970404,
					"content": "Alles ist in bester Ordnung. Jetzt ist es Zeit zum Entspannen. Vergiss die Arbeit und genieße einfach den Park!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				}
			]
		},
