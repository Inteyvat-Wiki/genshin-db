				"points": []
			},
			"dialogs": [
				{
					"id": 727340101,
					"content": "Undiszipliniert, unelegant, ungeschickt, uninspiriert und völlig unharmonisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340102
					],
					"speakerTitle": "„Goldkrötenzauberer“"
				},
				{
					"id": 727340102,
					"content": "Was murmelst du denn? Bewertest du mit diesen Wörtern deine Kameraden, die wir besiegt haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340104
					],
					"speakerTitle": "„Goldkrötenzauberer“"
				},
				{
					"id": 727340104,
					"content": "Ich rede von eurem Kampfstil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340105
					],
					"speakerTitle": "„Goldkrötenzauberer“"
				},
				{
					"id": 727340105,
					"content": "Was? Wurdest du von einem Gespenst oder so was am Kopf getroffen? Ich bin nicht hier, um ein Gedicht zu vortragen! Das Allerwichtigste sind Hingabe, Wille und Stärke! Wagst du es, mir gegenüberzutreten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340106,
					"content": "Du bringst mir ein paar schlechte Erinnerungen zurück ... Ich will nicht gegen einen rüpelhaften Typen wie dich kämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340107
					],
					"speakerTitle": "„Goldkrötenzauberer“"
				},
				{
					"id": 727340107,
					"content": "#Hmm, {M#dieser blonde Herr}{F#diese blonde Frau} sieht leicht zu besiegen aus ... Also, ich will {M#ihn}{F#sie} herausfordern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340108
					],
					"speakerTitle": "„Goldkrötenzauberer“"
				},
				{
					"id": 727340108,
					"content": "Pff ... Hahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340109,
					"content": "#{M#Mein Freund}{F#Meine Freundin}, hast du gehört, was er gerade gesagt hat? Er hält dich für schwach! Lass ihn deine Fähigkeit richtig kennen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340110,
						727340111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340110,
					"content": "Haha, sehr gerne!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727340112
					]
				},
				{
					"id": 727340112,
					"content": "Paimon versteht es nicht. Diese Leute haben ihre Gegner überhaupt nicht recherchiert! Sie kommen einer nach dem anderen und helfen uns, Siegesabzeichen zu vermehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727340113,
					"content": "Die Truppe von „Marschall Hanakado“ ist echt ein Durcheinander! In Sachen Strategie sind sie uns dreien nicht gewachsen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727340111,
					"content": "*schluchz* Bitte schikaniere mich nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727340112
					]
				}
			]
		}
	]
