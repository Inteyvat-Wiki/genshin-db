					"Vahid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220360201,
					"content": "Also, sag mir wie man den Dünger verwendet ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360202
					]
				},
				{
					"id": 220360202,
					"content": "Ach ja, richtig, ich habe es dir noch nicht erklärt. Die Dünger, die du dort hinbringst, müssen auf eine bestimmte Art und Weise verwendet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360203
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360203,
					"content": "Also, mal sehen ... laut Handbuch sollte die Reihenfolge ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360204
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360204,
					"content": "Du musst zuerst <color=#37FFFF>Wasser</color> zu den Düngemitteln geben, bevor du einige <color=#37FFFF>zerkleinerte Blätter</color> hinzufügst. Schließlich <color=#37FFFF>mische sie gut</color> und säe sie auf dem Feld aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360205
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360205,
					"content": "Mach es nicht falsch, sonst kann es zu Problemen kommen, die den Eindruck unserer Kunden von uns beeinflussen. Unser zukünftiges Geschäft steht auf dem Spiel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360206,
						220360208
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360206,
					"content": "Gut, ich habe mir es gemerkt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360207
					]
				},
				{
					"id": 220360207,
					"content": "Dann zähle ich auf dich. Sobald du dem Kunden den anahitianischen Segen geliefert hast, gehört seine erste Zahlung dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360208,
					"content": "Kannst du den Vorgang noch einmal wiederholen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360209
					]
				},
				{
					"id": 220360209,
					"content": "Du musst zuerst <color=#37FFFF>Wasser</color> zu den Düngemitteln geben, bevor du einige <color=#37FFFF>zerkleinerte Blätter</color> hinzufügst. Schließlich <color=#37FFFF>mische sie gut</color> und säe sie auf dem Feld aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360210
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360210,
					"content": "#Ich zähle auf dich, {F#Reisende}{M#Reisender} ... Lass uns alle hart arbeiten. Mit etwas Glück könnte das Geschäft diesen Monat gut werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				}
			]
		},
