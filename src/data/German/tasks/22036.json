			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vahid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220360101,
					"content": "Dieses Geschäft ist so hart. Alle meine Waren sind gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360102
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360102,
					"content": "Aber warum will hier niemand etwas kaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360103
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360103,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360104
					]
				},
				{
					"id": 220360104,
					"content": "#Oh, du bist es, {F#Reisende}{M#Reisender}. *seufz* Vergiss es. Ich kann immer noch keinen Dünger verkaufen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360105
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360105,
					"content": "Hast du nicht Alrani, die dir hilft?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360106
					]
				},
				{
					"id": 220360106,
					"content": "Sie hat mir ein wenig geholfen. Aber das Problem ist, dass keiner von uns weiß, wie man diese Waren vermarktet. Wir können nur darauf warten, dass die Kunden auftauchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360107
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360107,
					"content": "Und du weißt um die Situation bei Ritou. Niemand kauft etwas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360108
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360108,
					"content": "Deshalb besuchte ich die Herren von der Händlergilde, um sie um Hilfe zu bitten, und sie schlugen vor, dass wir etwas tun sollten, das sich Vermarktung nennt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360109
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360109,
					"content": "Im Klartext: Sie wollen, dass wir mit den Kunden mehr über die Wirkung der Dünger und die Theorie dahinter sprechen. Wir sollen auch mehr datengetriebene Werbung machen und einen Dienst namens „kostenlose Tests“ anbieten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360110
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360110,
					"content": "Aber ... Ich verstehe solche komplexen Dinge wirklich nicht. Und ich bin nicht derjenige, der sich diese Dünger ausgedacht hat, also wie soll ich das erklären?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360111
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360111,
					"content": "Wie auch immer, selbst wenn es nur darum geht, die Anweisungen zu rezitieren, glaube ich, dass ich trotzdem herumlaufen und etwas Werbung machen muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360112
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360112,
					"content": "#Alrani ist bereits da draußen und wirbt für unsere Waren. Ich werde später auch noch rausgehen. {F#Reisende}{M#Reisender}, könntest du uns bitte helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360113,
						220360116
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360113,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360114
					]
				},
				{
					"id": 220360114,
					"content": "#Ausgezeichnet! Wir zählen auf dich, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360115
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360115,
					"content": "Der Ort, zu dem du gehst, heißt Dorf Konda. Er ist nicht weit von hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360119,
					"content": "Es gibt einen Herrn namens Konda Densuke, der sich für unsere Düngemittel interessiert hat. Er kam auch in den Laden und plauderte vorhin mit mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360120
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360120,
					"content": "Wenn du bei ihm für einige unserer Waren werben könntest und ihm eine kostenlose Probe anbietest, kauft er vielleicht ein paar Dünger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360116,
					"content": "Wo ist Alrani hingegangen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360117
					]
				},
				{
					"id": 220360117,
					"content": "Sie sagte, dass sie einige Materialien sammeln muss und dass sie ziemlich weit weg muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360118
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360118,
					"content": "Der Ort, zu dem du gehst, heißt Dorf Konda. Er ist nicht weit von hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "Vahid"
				}
			]
		},
		{
			"id": 2203602,
			"completionStepIds": [
				2203602,
				2203608
			],
			"beginWay": "TALK_BEGIN_NONE",
