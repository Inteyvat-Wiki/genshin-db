			},
			"dialogs": [
				{
					"id": 220360501,
					"content": "Wir treffen uns wieder. Was würdest du dieses Mal gerne wissen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360502,
						220360503
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360502,
					"content": "Ich bin dieses Mal nicht hier, um Fragen zu stellen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360504
					]
				},
				{
					"id": 220360504,
					"content": "Oh, hat Vahid dich geschickt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360505
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360505,
					"content": "Ich habe von einem neuartigen Düngerladen in Ritou gehört. Deshalb bin ich gekommen, um Herrn Vahid zu treffen und seinen Dünger zu testen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360506
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360506,
					"content": "Wenn es funktioniert und die Ernteproduktion erhöht, könnte es Hoffnung für die Wiederherstellung des Dorfes Konda geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360507
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360507,
					"content": "He, ich schätze, es liegt immer noch an einem alten Relikt wie mir, das Dorf zu restaurieren. Diese jungen Burschen aus dem Dorf ... Hmpf! Auf die kann man nicht zählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360508
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360508,
					"content": "Na gut, dann sag mir. Wie soll ich diese Dünger verwenden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360509,
						220360510,
						220360511
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360509,
					"content": "Zuerst das Wasser hinzufügen und dann die zerkleinerten Blätter, am Ende mischen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360512
					]
				},
				{
					"id": 220360512,
					"content": "So ein kompliziertes Verfahren für diese Dünger ... Alles klar, ich hab’s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360510,
					"content": "Zuerst die zerkleinerten Blätter hinzufügen, dann mischen und am Ende Wasser hinzufügen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360512
					]
				},
				{
					"id": 220360511,
					"content": "Zuerst die zerkleinerten Blätter hinzufügen und dann Wasser, am Ende mischen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360512
					]
				},
				{
					"id": 220360503,
					"content": "Ich bin hier, um darüber zu sprechen, wie man die Dünger verwendet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360504
					]
				}
			]
		},
