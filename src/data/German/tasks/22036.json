				},
				{
					"id": 220360407,
					"content": "Dann zähle ich auf dich. Sobald du dem Kunden den anahitianischen Segen geliefert hast, gehört seine erste Zahlung dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360408,
					"content": "Kannst du den Vorgang noch einmal wiederholen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360409
					]
				},
				{
					"id": 220360409,
					"content": "Du musst zuerst <color=#37FFFF>zerkleinerte Blätter</color> zu den Düngemitteln geben, bevor du <color=#37FFFF>etwas Wasser</color> hinzufügst. Schließlich <color=#37FFFF>mische sie gut</color> und säe sie auf dem Feld aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360410
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360410,
					"content": "#Ich zähle auf dich, {F#Reisende}{M#Reisender} ... Lass uns alle hart arbeiten. Mit etwas Glück könnte das Geschäft diesen Monat gut werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				}
			]
		},
