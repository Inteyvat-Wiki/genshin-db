	"talks": [
		{
			"id": 7614501,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614502",
							"2"
						],
						"stepId": 7614502,
						"stateName": "QUEST_STATE_UNFINISHED"
