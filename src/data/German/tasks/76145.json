				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450101,
					"content": "Die Geschäfte laufen wirklich schlecht ... Vielleicht sollte ich etwas Geld zusammenkratzen und mir einen Marktstand in Nasha mieten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450113,
						761450102,
						761450115
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450113,
					"content": "Hast du denn was Gutes im Angebot?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450114
					]
				},
				{
					"id": 761450114,
					"content": "Das sind alles kleine Sachen, die ich aus Natlan mitgebracht habe. Such dir einfach aus, was dir gefällt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450102,
					"content": "Wer bist du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450103
					]
				},
				{
					"id": 761450103,
					"content": "Ach, ein Kunde! Hallo, ich bin Kuzmich, ein Händler aus Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450104
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450104,
					"content": "Eigentlich mache ich nur ein paar kleine Geschäfte während meiner Reise, um die Reisekosten zu decken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450105
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450105,
					"content": "Aber als ich durch Natlan kam, waren die Leute dort so gastfreundlich, dass ich mich im Eifer des Gefechts dazu hinreißen ließ ... Wenn ich diese Waren jetzt nicht alle verkaufe, kann ich mir nicht mal mehr die Rückfahrkarte leisten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450106,
						761450110
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450106,
					"content": "Du willst zurück nach Snezhnaya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450107
					]
				},
				{
					"id": 761450107,
					"content": "Ja, sobald ich diese Waren verkauft habe, werde ich mir ein Zugticket kaufen und zurückfahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450108
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450108,
					"content": "Zwar schneit es dort das ganze Jahr über, und überall ist es bitterkalt – da kann man eigentlich nur in der Stadt hocken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450109
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450109,
					"content": "Aber nach so langer Zeit auf Achse vermisse ich die Tage, an denen ich zu Hause den ganzen Tag schlafen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450110,
					"content": "Hier scheint es kaum Geschäftsmöglichkeiten zu geben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450111
					]
				},
				{
					"id": 761450111,
					"content": "Aber wenn ich einen Stand in der Stadt mieten möchte, muss ich mir Geld von der Bank des Nordens leihen. Ich habe gehört, dass die Filiale in Nasha keinen guten Ruf hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450112
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450112,
					"content": "Ach was soll’s, hier ist wenigstens viel los. Die Ware verkauft sich von selbst, wenn nur genug Leute vorbeikommen, denkst du nicht auch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450115,
					"content": "Tut mir leid, ich muss jetzt gehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450116
					]
				},
				{
					"id": 761450116,
					"content": "Ach, warum gehst du denn schon? Willst du nicht wenigstens mal schauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614503,
			"completionStepIds": [
				7614503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614503",
							"2"
						],
						"stepId": 7614503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450301,
					"content": "Ach du meine Güte, ich hätte nicht gedacht, dass ich wirklich alles verkaufe! Sieht so aus, als hätte ich doch ein gutes Händchen fürs Geschäft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450302
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450302,
					"content": "Als Nächstes werde ich die Lichthüter dort bitten, mich durch den Schreckschattensumpf zu begleiten. Danach sollte der Weg nach Norden frei sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450303
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450303,
					"content": "Vielleicht finde ich auf dem Rückweg auch noch die ein oder andere gute Geschäftsmöglichkeit ... Dann lass uns hier erstmal Abschied nehmen, bis wir uns wiedersehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614504",
							"2"
						],
						"stepId": 7614504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450401,
					"content": "Was für ein Zufall, dass wir uns wiedersehen! Möchtest du etwas kaufen? Die neuen Waren verkaufen sich recht schlecht ... Also bitte, hilf mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450407,
						761450402,
						761450409
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450407,
					"content": "Mal sehen, ob du was Gutes hast.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450408
					]
				},
				{
					"id": 761450408,
					"content": "Das sind alles lokale Spezialitäten. Keine Sorge, ich mach dir den besten Preis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450402,
					"content": "Warum hast du schon wieder neue Waren eingekauft?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450403
					]
				},
				{
					"id": 761450403,
					"content": "Na ja, wie soll ich das erklären ... Im Geschäftsleben muss man die Gelegenheit beim Schopfe packen. In Piramida habe ich ein gutes Angebot gefunden – eine Ladung Waren, die schnell verkauft werden musste, und das zu einem Sonderpreis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450404
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450404,
					"content": "In der Aufregung habe ich total vergessen, dass ich eigentlich nach Hause wollte, und habe alles gekauft. Tja, und dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450405
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450405,
					"content": "Rate mal, warum er es so eilig hatte, die Sachen loszuwerden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450406
					]
				},
				{
					"id": 761450406,
					"content": "Ach, mach dich doch nicht lustig über mich. Schau lieber mal, ob du hier etwas findest, das du gebrauchen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450409,
					"content": "Tut mir leid, ich muss gehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450410
					]
				},
				{
					"id": 761450410,
					"content": "Willst du nicht noch mal schauen? Es gibt bestimmt etwas, das du brauchst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614506,
			"completionStepIds": [
				7614506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614506",
							"2"
						],
						"stepId": 7614506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450601,
					"content": "Juhu, endlich bin ich meine ganze Ware losgeworden! Die Strategie „geringer Gewinn, hoher Umsatz“ war wohl doch die richtige.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450602
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450602,
					"content": "Eigentlich sollte ich jetzt nach Snezhnaya zurückkehren, aber ich habe gerade mal genug für die Reisekosten verdient ... Ich bin mit leeren Taschen hergekommen und möchte nicht wieder mit leeren Taschen zurückgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450603
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450603,
					"content": "Ach, jedenfalls danke, dass du mein Geschäft unterstützt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614507,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614507",
							"2"
						],
						"stepId": 7614507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450701,
					"content": "Ach herrje, das Schicksal ist wirklich wunderbar, dass wir uns hier wieder treffen. Na, wie wäre es? Willst du einen Blick werfen? Diesmal habe ich viele tolle Sachen dabei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450709,
						761450702,
						761450706,
						761450711
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450709,
					"content": "Dann lass mal sehen, was du Gutes hast.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450710
					]
				},
				{
					"id": 761450710,
					"content": "He, das ist alles alte Ausrüstung, die die Fatui aussortiert haben. Sowas findest du sonst nirgendwo! Wenn du etwas willst, dann nimm’s ruhig mit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450702,
					"content": "Warst du nicht schon wieder zurück nach Snezhnaya gegangen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450703
					]
				},
				{
					"id": 761450703,
					"content": "Um ehrlich zu sein, meine Heimat ist Novokitezhgrad, und meine ganze Familie arbeitet im Bergbau. Die sind alle noch störrischer als die Domovoy. Als ich sagte, ich wolle auf Handelsreise losziehen, waren sie strikt dagegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450704
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450704,
					"content": "Bevor ich aufbrach, prahlte ich damit, dass ich mit einem großen Vermögen zurückkehren würde ... Aber wer hätte gedacht, dass ich am Ende kaum genug für die Rückreise haben würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450705
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450705,
					"content": "Das große Geld ist jetzt wohl vom Tisch, aber lass mich wenigstens ein bisschen was verdienen, damit ich nicht mit leeren Händen nach Hause gehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450706,
					"content": "Was machst du denn im Gebiet der Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450707
					]
				},
				{
					"id": 761450707,
					"content": "Ach was, ich bin ein gesetzestreuer Bürger Snezhnayas. Wenn ich einen Fatui sehe, fühle ich mich wie zu Hause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450708
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450708,
					"content": "Die Ausrüstung, die ich hier habe, ist alte Ware von ihnen, die sie mir zur Entsorgung anvertraut haben. So etwas findest du nirgendwo anders, das gibt’s nur bei mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450711,
					"content": "Nein danke, ich gehe jetzt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450712
					]
				},
				{
					"id": 761450712,
					"content": "Das ist wirklich schade ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614509,
			"completionStepIds": [
				7614509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614509",
							"2"
						],
						"stepId": 7614509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450901,
					"content": "Vielen Dank! Dank dir muss ich nicht mit hängendem Kopf nach Hause gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450902
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450902,
					"content": "Jetzt müssen wir uns wirklich verabschieden. Du hast so viel bei mir gekauft, da können wir uns doch wohl als Freunde bezeichnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450903
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450903,
					"content": "Wenn du die Chance hast, mal nach Snezhnaya zu kommen, dann besuche mich doch gerne in Novokitezhgrad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		}
	]
}