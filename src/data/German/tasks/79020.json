					"nextDialogs": [
						790200506
					]
				},
				{
					"id": 790200506,
					"content": "Ach, das ist es? Dann müssen wir nur noch vier Kreise auf die Karte zeichnen und ... äh, eigentlich, wie lang ist überhaupt ein Radius von mehreren „großen Schiffen“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200507,
					"content": "Nehmen wir uns ein paar Schiffe zum Vorbild, die wir schon gesehen haben ...",
