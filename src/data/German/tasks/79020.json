			"dialogs": [
				{
					"id": 790200101,
					"content": "Lass es Paimon sehen! Hmm ... Das sieht aus, als könnte es eine Art Schatzkarte sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200102,
					"content": "Wirklich?",
