					"nextDialogs": [
						790200103
					]
				},
				{
					"id": 790200103,
					"content": "He! Paimon irrt sich nie, wenn Paimon auf der Suche nach einem Schatz ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200116,
					"content": "Es scheint, als hätte die Ako-Domeki-Piratenbande dieses Bild hinterlassen. Paimon hat das Gefühl, dass wir schon mal von der Bande gehört haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200104,
					"content": "Und sieh dir das an! „Der Schatz ist versteckt ...“ Siehst du? Es gibt wirklich einen Schatz zu finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200105,
					"content": "Lass uns weiterlesen! „... wurde in vier Teile aufgeteilt ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200106,
					"content": "Sie haben also etwas in vier Teile aufgeteilt, hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200107,
						790200108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200107,
					"content": "Es gibt also vier Schätze?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200109
					]
				},
				{
					"id": 790200109,
					"content": "Paimon ist sich nicht sicher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200110,
					"content": "Aber wie dem auch sei, hier steht, dass etwas „inmitten der Riffe der vier großen Inseln“ platziert wurde. Das sollte sich auf die Riffe bei den vier Inseln des Goldapfelarchipels beziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200111,
					"content": "Moment, sind wir nicht genau auf einem dieser Riffe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200112,
					"content": "Hm, das bedeutet, dass es vier Hinweise geben muss ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200113
					]
				},
				{
					"id": 790200113,
					"content": "Und sie sollten in der Nähe der Riffe auf den vier Inseln sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200114,
					"content": "Hmmm, Inseln ... Das muss sich doch auf die vier größten Inseln des Archipels beziehen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200115,
					"content": "Lass uns die anderen drei Inseln ausprobieren und sehen, was wir finden können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
