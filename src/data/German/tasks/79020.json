					"nextDialogs": [
						790200605
					]
				},
				{
					"id": 790200605,
					"content": "Ja! Sind die nicht nur wegen des Apparats aufgetaucht? Könnten sie diesen Schatz also wirklich versteckt haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200606,
					"content": "Vielleicht wollte der Schatz selbst gefunden werden ...",
