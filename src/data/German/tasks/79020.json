					"speakerTitle": "Paimon"
				},
				{
					"id": 790200502,
					"content": "Hmm ... Paimon kann nicht erkennen, wo dieser Schatz versteckt sein soll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200503,
					"content": "Was bedeuten diese Begriffe „Radius“ und „Zentrum“ überhaupt?",
