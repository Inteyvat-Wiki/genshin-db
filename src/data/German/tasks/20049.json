				"objectNames": [
					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200490101,
					"content": "Ich hätte jetzt gern Gläschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490102
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490102,
					"content": "Wenn mich Eury aber dabei erwischt, ist es aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490103
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490103,
					"content": "Was ist denn passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490104
					]
				},
				{
					"id": 200490104,
					"content": "Oh, nichts weiter ... Ich würde nur gern einen trinken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490105
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490105,
					"content": "Meine Frau Eury hält es nicht aus, wenn ich trinke. Deswegen rühre ich das Zeug nicht an, solange ich zu Hause bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490106
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490106,
					"content": "Deswegen kann ich nur mal raus ein paar Gläschen trinken, wenn sie gerade einkaufen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490107
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490107,
					"content": "Du scheinst ja echt gern zu trinken ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490108
					]
				},
				{
					"id": 200490108,
					"content": "Was willst du damit sagen? Wie könnte man in Mondstadt leben und nichts trinken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490109
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490109,
					"content": "Meinst du, du könntest Eury ein bisschen ablenken, damit ich noch ein paar trinken kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490110
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490110,
					"content": "Wenn sie beim Einkaufen eine zu große Auswahl hat, zögert sie sehr lange und kann sich nicht entscheiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490111
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490111,
					"content": "Solange sie sich nicht entscheiden kann, wird sie immer weiter überlegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490112,
						200490114
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490112,
					"content": "Na gut ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490113
					]
				},
				{
					"id": 200490113,
					"content": "Hahaha! Vielen Dank! Der Wein möge immer für euch fließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490114,
					"content": "Wie lange hast du denn vor zu trinken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490115
					]
				},
				{
					"id": 200490115,
					"content": "Hahaha, das kommt ganz darauf an, wie lange du sie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490116
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490116,
					"content": "Nein, nein, nein ... Solange ich ganz in Ruhe einen Becher voll trinken kann, ist das in Ordnung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490117
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490117,
					"content": "Das ist das Versprechen eines Stammgastes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
