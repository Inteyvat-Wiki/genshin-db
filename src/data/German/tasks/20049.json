			"dialogs": [
				{
					"id": 200490201,
					"content": "Dämmerfrüchte, Äpfel ... was nehm ich denn heute?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490202
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490202,
					"content": "Hach, wenn Nimrod hier wäre, würde ich einfach nehmen, was er gern hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490203
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490203,
					"content": "Entschuldigung, Eury. Die Dämmerfrüchte sind schon ausverkauft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490204
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490204,
					"content": "Ach so? Na, dann kann ich sowieso nur Äpfel kaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490205
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490205,
					"content": "Hmm, Eury, diese Äpfel sehen nicht mehr ganz so frisch aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490206
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490206,
					"content": "Meinst du? Aber ich habe doch eh keine Wahl mehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490207
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490207,
					"content": "Wir können dir helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200490208,
					"content": "Ihr? Wieso ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490209
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490209,
					"content": "Wir übernehmen das.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490210
					]
				},
				{
					"id": 200490210,
					"content": "Keine Sorge! Wir werden mit frischen <color=#00E1FFFF>Dämmerfrüchten</color> zurückkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200490211,
					"content": "Oh, das ist lieb von euch. Danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490212
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490212,
					"content": "Das passt doch! Nimrod hat Dämmerfrüchte lieber. Dann warte ich hier auf euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eury"
				}
			]
		},
