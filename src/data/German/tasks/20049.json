			"dialogs": [
				{
					"id": 200490801,
					"content": "Ihr ... ihr seid zurück? Was hat Eury denn gesagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490802
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490802,
					"content": "Ohoho, der hat ja eine Riesenfahne! Wollte er nicht nur ein Glas trinken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200490803,
					"content": "Eury ist immer noch da und zögert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490804
					]
				},
				{
					"id": 200490804,
					"content": "Gut ... sehr gut! Dann kann ich ja in Ruhe weitertrinken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490805
					],
					"speakerTitle": "Nimrod"
				},
				{
