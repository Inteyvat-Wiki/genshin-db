			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Melo Lombroso",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741810101,
					"content": "Frau Melo! Was machst du hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810102,
					"content": "Oh? Ihr seid es ... Ich habe gehört, dass mein unfähiger Ehemann hier ein kleines Nest hat. Daher wollte ich mal vorbeikommen und schauen, wie es ihm geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810103
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810103,
					"content": "Ich hätte nicht damit gerechnet, dass ich das hier finde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810104
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810104,
					"content": "Er hat also noch dieses Bild bei sich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810105
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810105,
					"content": "Hehe, du bist Onkel Rocher immer noch sehr wichtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810106,
					"content": "Früher, als wir dir bezüglich Zweifel hatten, war es nur Onkel Rocher, der voller Entschlossenheit gesagt hat, dass du auf keinen Fall eine Verbrecherin bist! Auch wenn Paimon nicht weiß, warum er damals so von seiner Meinung überzeugt war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810107,
					"content": "Vielleicht liegt es daran, dass er ein echter Mann ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810108
					]
				},
				{
					"id": 741810108,
					"content": "Ah? Ist das dein Ernst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810109
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810109,
					"content": "Ja, absolut! Hat er außerdem nicht mal gesagt, dass er deinen Anhänger beim Glücksspiel verloren hat? In Wirklichkeit war das gelogen! Es war ihm nur peinlich, die Wahrheit zu sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810110,
					"content": "Das war mir eigentlich schon lange klar und ich habe diese Geschichte auch nie geglaubt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810111
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810111,
					"content": "Was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810112,
					"content": "Mein Ehemann hat einige Schwächen. Er ist etwas feige, ein bisschen ängstlich und ein wenig ungeschickt. Aber ich weiß, dass er ein aufrichtiger Mensch ist. Er mag vielleicht von anderen übers Ohr gehauen worden sein, aber er ist auf keinen Fall ein Glücksspieler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810113
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810113,
					"content": "Ich habe es vor ihm nicht offen ausgesprochen. Ich wollte nur warten, bis er mir gegenüber von sich aus reinen Tisch macht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810114
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810114,
					"content": "Super ... Sehr gut ... Leider wissen wir nicht, wo er jetzt ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810115,
					"content": "(Pst ... Schaut mal dort. Ich bin felsenfest überzeugt, dass er sich in der Kiste dort versteckt.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810116
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810116,
					"content": "(Äh?!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810117,
					"content": "(*hust* ... Genau wie früher. Wenn wir streiten, versteckt er sich heimlich im Kleiderschrank und denkt, ich wüsste es nicht!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810118
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810118,
					"content": "(Soll ich ihn herausrufen?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810119
					]
				},
				{
					"id": 741810119,
					"content": "(Mach dir nicht die Mühe. Ich will heute mal sehen, wie lange er sich darin versteckt.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810120
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810120,
					"content": "Übrigens gibt es aber noch eine Sache, um die ich euch bitten möchte. Falls ihr auf die Ermittler Curve und Talochard trefft, ihnen etwas mitzuteilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810121
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810121,
					"content": "Ich habe einige Zimmer aufgeräumt und heiße sie willkommen, jederzeit für eine Weile hierzubleiben. Natürlich heißt euch die Familie Lombroso auch willkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810122
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810122,
					"content": "#{NICKNAME}, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810123,
					"content": "In Ordnung, kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810124
					]
				},
				{
					"id": 741810124,
					"content": "In Ordnung. Wir werden dich nicht weiter stören! Hoffentlich kommt Onkel Rocher bald heraus, um sich seiner Verantwortung zu stellen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810125,
					"content": "Danke. Ich wünsche euch auch, dass ihr, ganz gleich auf was für Probleme ihr stoßt, eine Lösung finden werdet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Melo Lombroso"
				}
			]
		},
