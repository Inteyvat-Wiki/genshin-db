	"talks": [
		{
			"id": 200301,
			"completionStepIds": [
				200301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200301",
							"2"
						],
						"stepId": 200301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030101,
					"content": "Nun, wo wir schon mal hier sind, wo ist Thoma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030102,
					"content": "*seufz* Paimon sieht ihn nirgends, glaubst du, er hat sein Versprechen, uns zu treffen, vergessen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030103,
					"content": "Wer hat sein Versprechen vergessen? Ich dachte schon, du hättest mich vergessen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030104
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030104,
					"content": "W... W... Was!? Redet der Hund mit uns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030105,
					"content": "Hahaha, entspann dich, kein Grund, so überrascht auszusehen. Ich nehme an, du siehst mich das erste Mal in dieser Form?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030106,
						20030107
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030106,
					"content": "Du bist also ein ... Hund?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				},
				{
					"id": 20030108,
					"content": "Du hast also nichts dergleichen gesehen, als du in Liyue warst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030109
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030109,
					"content": "Jetzt, wo du es erwähnst, scheint das plötzlich weniger ungewöhnlich zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030110,
						20030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030110,
					"content": "Aber es passt trotzdem nicht wirklich zusammen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030112,
					"content": "Hahaha. Schon gut, schon gut. Ich hatte meinen Spaß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030113
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030113,
					"content": "He! Gleich verpasst Paimon dir einen fiesen Spitznamen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030114,
					"content": "Nun ja ... da ich so lange auf euch warten musste, musste ich irgendwie die Zeit totschlagen ... so wie auf Ritou ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030115
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030115,
					"content": "Also habe ich mir diese lustige kleine Begrüßung ausgedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030116
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030116,
					"content": "Aber im Ernst, ich möchte mich bei euch für den kleinen „Test“ von vorher bedanken. Leider war er nötig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030117
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030117,
					"content": "So konnten wir entscheiden, ob ihr würdig seid, vor Kamisato zu treten, und ob ihr den Mut aufbringt, euch mit uns dem Blitz zu stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030118
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030118,
					"content": "Glaub ja nicht, dass Paimon dir vergibt, nur weil du plötzlich einen ernsten Ton anschlägst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030119,
					"content": "Haha ... Tut mir leid, hab ich es übertrieben? Ich bitte um Entschuldigung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030120,
						20030121
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030120,
					"content": "Und, wie haben wir uns in dem „Test“ geschlagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030122,
					"content": "Ihr denkt immer schon, dass ihr „über den Regeln“ steht, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030123
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030123,
					"content": "Das liegt natürlich daran, dass ihr so zielstrebig und entschlossen seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030124
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030124,
					"content": "Vor langer Zeit hatten wir einen Freund, der ganz ähnlich war ... doch als der Blitz ihn traf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030125,
						20030126
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030125,
					"content": "Du meinst Kazuhas Freund ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030127,
					"content": "Ah, ihr kennt die Geschichte also, hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030128
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030128,
					"content": "Sein Licht scheint immer noch hell ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030129
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030129,
					"content": "Dürfen wir also vor Shirasagi Himegimi treten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030130
					]
				},
				{
					"id": 20030130,
					"content": "Selbstverständlich. Ich bringe euch zur Kamisato-Residenz, wo sich die Yashiro-Verwaltung befindet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030131
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030131,
					"content": "Doch zuvor würde ich mit euch beiden gerne an einen anderen Ort gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030132
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030132,
					"content": "Ach ja? Wohin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030133,
					"content": "Begleitet mich zur Statue des Allgegenwärtigen. Sie ist zwar noch nicht fertig, man kann sie jedoch von so gut wie jedem Ort auf Narukami sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030126,
					"content": "Du meinst, er starb in einem Duell vor dem Thron ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030121,
					"content": "„Den Mut aufbringen, uns dem Blitz zu stellen“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030111,
					"content": "Ich erkenne einen Hund, wenn ich ihn sehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030107,
					"content": "Wo ist der menschlich aussehende Thoma hin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				}
			]
		},
		{
			"id": 200302,
			"completionStepIds": [
				200302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200302",
							"2"
						],
						"stepId": 200302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030201,
					"content": "Ganz schön düster hier. Vermutlich kommen nur wenige Besucher an diesen Ort, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030202,
					"content": "Spielen Paimons Augen verrückt oder sind diese Dinger Teil der Statue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030203,
					"content": "Göttliche Augen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030204
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030204,
					"content": "Göttliche Augen! Du meinst, alle durch das Augenhatz-Dekret gesammelten Göttlichen Augen sind in diese Statue eingebettet?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030206,
					"content": "Warum erließ der Shougun das Augenhatz-Dekret?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030207
					]
				},
				{
					"id": 20030205,
					"content": "Ihr habt also bereits vom Augenhatz-Dekret gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030206
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030207,
					"content": "Bevor ich es erkläre, sollte ich euch ins Gedächtnis rufen, dass Mondstadt die Stadt der Freiheit ist und Liyue die Stadt der Verträge ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030208
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030208,
					"content": "Inazuma hingegen ... ist bekannt als das Ewige Reich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030209
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030209,
					"content": "Der Shougun Raiden ist nicht nur ihr mächtigster Herrscher, sondern auch ihre Gottheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030210
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030210,
					"content": "Die besagte „Ewigkeit“ ... besteht in ihrer endlos unveränderlichen Herrschaft über Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030211
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030211,
					"content": "Um die Staatsangelegenheiten zu regeln, greift sie auf die Dreierverwaltung zurück. Mit dem Sakoku-Dekret schränkt sie die Freiheit der Bevölkerung ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030212
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030212,
					"content": "Der Shougun wünscht, dass Inazuma im Stillstand verbleibt, damit der Fluss der Zeit ohne Störung permanent von Anfang bis Ende strömen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030213
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030213,
					"content": "Jede Gottheit scheint ihren eigenen Willen zu haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030214,
					"content": "Das ist natürlich nur meine eigene begrenzte Sichtweise. Was den Grund für das jüngste Augenhatz-Dekret betrifft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030215
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030215,
					"content": "Vermutlich glaubt der Shougun, dass das Göttliche Auge den Leuten die Macht zur Veränderung gibt. Dies würde ihrer ewigen Herrschaft zuwiderlaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030216
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030216,
					"content": "So oder so hat der Shougun Raiden die Tenryou-Verwaltung damit beauftragt, das Reich nach Göttlichen Augen zu durchforsten, um jedes davon in diese Statue einzubetten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030217
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030217,
					"content": "Diese Statue des Allgegenwärtigen ist das Symbol für Inazumas Ewigkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030218
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030218,
					"content": "Aber handelt der Shougun Raiden dann nicht total ... selbstsüchtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030219,
					"content": "Haha, nur ein Fremder würde es wagen, den Shougun Raiden so offen zu tadeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030220
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030220,
					"content": "Und doch ... stimme ich zu. Das Augenhatz-Dekret sollte es nicht geben. Seit seinem Erlass ist Herrin Kamisato zum Kampf verpflichtet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030221
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030235,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030223,
					"content": "Was war das ... gerade für ein Geräusch?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030224
					]
				},
				{
					"id": 20030221,
					"content": "#Huch? Was ist los, {NICKNAME}? Was ziehst du für ein Gesicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030222,
					"content": "Geräusch? Was für ein Geräusch? Ich habe nichts gehört ... Ist etwas passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030223
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030225,
					"content": "Ich konnte den Klang des ... Strebens der Menschen hören.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030226
					]
				},
				{
					"id": 20030224,
					"content": "Ja, du hast die Statue berührt, und dann ... was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030226,
					"content": "„Strebens“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030227
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030227,
					"content": "Hmm ... das würde zu dem Spruch passen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030228
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030228,
					"content": "Habt ihr davon gehört? Wenn ein Streben ein gewisses Maß erreicht, betrachten die Götter es mit Wohlwollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030229
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030229,
					"content": "So entstehen die Göttlichen Augen ... Anders gesagt, das Göttliche Auge einer Person steht für ihr Streben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030230
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030230,
					"content": "Und wenn das stimmt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030231
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030232,
					"content": "Ein Göttliches Auge steht also für das Streben, nicht für Macht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030233
					]
				},
				{
					"id": 20030231,
					"content": "... ist das Streben dieser Leute stärker als gedacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030232
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030233,
					"content": "So ist es. Zeit für unseren nächsten Halt auf Narukami, die Kamisato-Residenz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030234
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030234,
					"content": "Puh, endlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200303,
