			"dialogs": [
				{
					"id": 20030501,
					"content": "Dem Schreiben zufolge sind wir hier richtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030502,
					"content": "Tut mir leid, aber wir bedienen nicht jedermann. Ihr müsst leider wieder gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030503
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030503,
					"content": "Moment! Wir sind nicht jedermann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030504,
					"content": "Wenn das so ist ... seid ihr umherstreifende Fremde, die sich hier eingeschlichen haben ... zumindest seid ihr so gekleidet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030505
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030505,
					"content": "Ist unsere Kleidung wirklich so ... Oh! Äh ... Was Paimon damit sagen wollte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030506,
					"content": "Hier ist unsere Einladung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030507
					]
				},
				{
					"id": 20030507,
					"content": "Hmm, das Siegel der Yashiro-Verwaltung ... dieses Schreiben muss von Thoma stammen. Ihr seid also nicht irgendwer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030508
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030508,
					"content": "Dann heiße ich euch in der Teestube Komore willkommen, einem für die Yashiro-Verwaltung sicheren Ort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030509
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030509,
					"content": "Das klingt doch schon besser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
