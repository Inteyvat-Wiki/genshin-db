				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030401,
					"content": "Hier leben also die hohen Tiere von Inazuma, was? Paimon hätte etwas ... Schickeres erwartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030402,
						20030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030402,
					"content": "Das Jadegemach lässt sich schwer übertreffen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030404
					]
				},
				{
					"id": 20030404,
					"content": "Willkommen in der Kamisato-Residenz, verehrte Gäste. Herrin Kamisato ist erfreut, endlich eure Bekanntschaft zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030405
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030405,
					"content": "Meinst du damit diese Shirasagi Himegimi, von der du ständig redest? Wo ist sie denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030406,
					"content": "Ähem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030407
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030407,
					"content": "Oh ... hinter dem Schirm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030408,
					"content": "Ja, als Spross der Yashiro-Verwaltung ist Herrin Kamisato es gewohnt, ihre Gäste so zu empfangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030409
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030409,
					"content": "Seht es als altehrwürdige Tradition der Yashiro-Verwaltung. Vergebt mir, falls es euch nicht genehm ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030410,
						20030411
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030410,
					"content": "Ich verstehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030412
					]
				},
				{
					"id": 20030412,
					"content": "Hat Sinn, schließlich ist sie eine höchst bedeutende Person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030413,
					"content": "Bitte vergebt mir, dass ich euch auf so unhöfliche Weise empfange ... zumal ihr eine so lange aufreibende Seefahrt hinter euch habt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030414
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030414,
					"content": "Ich habe euch mit großer Vorfreude erwartet. Thoma versichert mir, dass ihr in der Tat dazu in der Lage seid, den Zeitstrom zu verändern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030415
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030415,
					"content": "In der Gegenwart leiden die Sehnsüchte der Leute unter dem sinnlosen Augenhatz-Dekret, das ihre Wünsche mit Füßen tritt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030416,
					"content": "Obwohl die Yashiro-Verwaltung dem Shougun untersteht, sind wir dem Volk eng verbunden, da wir in Ausübung unserer Pflicht in engem Austausch mit ihm stehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030417
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030417,
					"content": "Die Macht einer Verwaltung steigt und fällt mit dem Vertrauen des Volkes. Darum können wir diese Lage nicht gleichgültig hinnehmen, denn es geht um unser eigenes Schicksal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030418
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030418,
					"content": "#{F#Reisende}{M#Reisender}, gewähre uns deine Kraft, dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030419,
						20030420
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030419,
					"content": "Ich will bloß den Shougun Raiden treffen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030421
					]
				},
				{
					"id": 20030421,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030422
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030422,
					"content": "Meine Dame, es ist wie ich sagte ... dies führt zu nichts ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030423
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030423,
					"content": "Ich werde jetzt gehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030424
					]
				},
				{
					"id": 20030424,
					"content": "Nein, bitte ... wartet! Bitte ... geht nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030425
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030425,
					"content": "*seufz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030426
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030426,
					"content": "Was?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030427
					]
				},
				{
					"id": 20030427,
					"content": "Ich stelle euch dem Shougun Raiden vor, unter einer Bedingung ... Ihr müsst mir drei kleine Wünsche erfüllen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030428
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030428,
					"content": "Wie lauten deine Wünsche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030429,
					"content": "Es geht um drei Leute, denen ihr Göttliches Auge genommen wurde ... Vielleicht versteht ihr es besser, sobald ihr ihnen begegnet seid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030430
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030430,
					"content": "Ein Krieger, der ein Dorf bewacht, ein ehemaliger Samurai, der das Augenhatz-Dekret mit ausführte, und ein Schwertmeister, der zu den Besten der Welt gehören will ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030431,
					"content": "Richtig. Bitte gebt alles, um ihnen zu helfen. Ich erwarte hier eure Rückkehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030432,
						20030433
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030432,
					"content": "Ich werde tun wie geheißen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030434
					]
				},
				{
					"id": 20030434,
					"content": "Hehe ... dann bin ich euch Dank schuldig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030435
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030435,
					"content": "Halte durch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030433,
					"content": "Ganz schön viel verlangt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030434
					]
				},
				{
					"id": 20030420,
					"content": "Ich will keine Rebellion anzetteln.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030421
					]
				},
				{
					"id": 20030411,
					"content": "(Das ist irgendwie enttäuschend ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030412
					]
				},
				{
					"id": 20030403,
					"content": "Das Weingut Morgenröte lässt sich schwer übertreffen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030404
					]
				}
			]
		},
