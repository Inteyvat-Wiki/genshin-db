			"dialogs": [
				{
					"id": 220440301,
					"content": "Das passt, danke dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440302,
					"content": "Ich werde später daran arbeiten ... Mal sehen, wie ich das Holz so schnitzen kann, dass es wie Naku-Kraut aussieht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440303
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440303,
					"content": "Wenn ich doch nur besser dekorieren könnte und mehr Abwechslung hätte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440304
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440304,
					"content": "Vielleicht kann die Dekoration auch separat verkauft werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		}
