			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220440101,
					"content": "#{F#Reisende}{M#Reisender}, was tust du hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440102
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440102,
					"content": "Wie kommt deine Arbeit voran?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440103
					]
				},
				{
					"id": 220440103,
					"content": "Hahahaha, es ging gut, aber die Größe der Holzschnitzerei muss kontrolliert werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440104
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440104,
					"content": "Schließlich war es meine ursprüngliche Idee, dass diese Holzschnitzereien idealerweise nicht größer als die Größe einer menschlichen Hand sein sollten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440105
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440105,
					"content": "So sind sie handlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440106
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440106,
					"content": "Und zusätzlich dazu ... wollte ich noch ein paar „Dekorationen“ machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440107
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440107,
					"content": "Wenn ich früher Leute bei der Herstellung von Holzschnitzereien beobachtet habe, haben sie nicht nur die Holzschnitzerei selbst hergestellt, sondern auch einige kleine Dekorationen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440108
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440108,
					"content": "Zum Beispiel Blumen, Tiere oder ein Sockel mit floralem Muster ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440109
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440109,
					"content": "Ich würde auch gerne einen Sockel mit Dekorationen für eine meiner kleinen Holzskulpturen wie diese machen ... obwohl aufgrund der Größe eine Holzskulptur nur mit einer Dekoration kommen sollte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440110
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440110,
					"content": "Aber ich dachte, ich mache die Dekorationen einfach abnehmbar. Dann kann ich die Dekorationen, die die Gäste wollten, darauf anbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440111
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440111,
					"content": "Ich wollte mit einfachen Dekorationen anfangen, um zu üben, wie ... Naku-Kraut und andere Pflanzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440112
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440112,
					"content": "Kannst du mir bitte helfen, drei „Naku-Kräuter“ für meine Referenz zu sammeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440113,
						220440114
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440113,
					"content": "Werde ich machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440117
					]
				},
				{
					"id": 220440117,
					"content": "#Dann zähle ich auf dich, {F#Reisende}{M#Reisender}. Wenn du das Naku-Kraut hast, bringe es schnell zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440114,
					"content": "Warum drei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440115
					]
				},
				{
					"id": 220440115,
					"content": "Mit drei Pflanzen kann ich drei verschiedene Zustände von der Naku-Kraut gleichzeitig beobachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440116
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440116,
					"content": "So werde ich bestimmt ein gutes Ergebnis haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440117
					],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
