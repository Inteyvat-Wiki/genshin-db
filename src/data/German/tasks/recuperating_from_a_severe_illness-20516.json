					"content": "Von hier aus kann man das gesamte Mondstadt überblicken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160502
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160502,
					"content": "Erkälte dich nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160503
					]
				},
				{
					"id": 205160503,
					"content": "Was? Da hast du mich aber erschreckt! Wo kommst du denn so plötzlich her und wie hast du mich gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160504
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160504,
					"content": "Ich dachte immer, niemand könnte diesen Ort finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160505
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160505,
					"content": "Ach, das hat dir bestimmt Schwester Grace verraten, sie ist immer hier in der Nähe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160506
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160506,
					"content": "Die Medizin, die ich früher nehmen musste, wurde auch oft von ihr gebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160507
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160507,
					"content": "Schwester Grace ist wirklich ein guter Mensch, aber ich möchte nicht für immer in Mondstadt bleiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160508
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160508,
					"content": "Schon gut, ich weiß ja, dass mein Bruder mich sucht, ich gehe gleich schon zurück. Mein Bruder wird sich schon nicht sorgen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
