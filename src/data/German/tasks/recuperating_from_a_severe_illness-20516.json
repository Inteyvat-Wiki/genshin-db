			},
			"dialogs": [
				{
					"id": 205160201,
					"content": "Von hier aus kann man das gesamte Mondstadt überblicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160202,
					"content": "Erkälte dich nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160203
					]
				},
				{
					"id": 205160203,
					"content": "Was? Da hast du mich aber erschreckt! Wo kommst du denn so plötzlich her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160204,
					"content": "Sucht mein Bruder etwa schon wieder nach mir? *seufz* Hier findet er mich sowieso nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160205,
					"content": "Ist ja gut, ist ja gut, einen Moment noch, dann gehe ich schon nach Hause. Mein Bruder wird sich schon nicht sorgen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2051603,
