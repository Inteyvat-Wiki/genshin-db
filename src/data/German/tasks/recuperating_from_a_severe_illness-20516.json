			"dialogs": [
				{
					"id": 205160301,
					"content": "Hast du Anna gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160302,
					"content": "Sie ist auf der Hand der Statue des Windgottes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160303
					]
				},
				{
					"id": 205160303,
					"content": "Auf der Hand der Statue des Windgottes?! Wie ist sie denn da nur wieder hochgekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160304,
					"content": "Ich gehe sofort zu ihr, die kriegt eine Lektion erteilt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160305,
					"content": "Danke für deine Mühe, dies ist für dich, nimm es bitte an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
		{
			"id": 2051604,
			"completionStepIds": [
				2051604
			],
