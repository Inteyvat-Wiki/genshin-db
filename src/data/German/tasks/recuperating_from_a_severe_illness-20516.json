					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205160101,
					"content": "Dieses Mädchen, wo steckt sie denn nun schon wieder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160102,
					"content": "Ist Anna schon wieder raus zum Spielen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160103
					]
				},
				{
					"id": 205160103,
					"content": "Du scheinst überhaupt nicht überrascht zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160104,
					"content": "Anna hört fast gar nicht mehr auf mich. Ich drehe mich nur einmal um und schon ist sie weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160105,
					"content": "Sie ist noch nicht wieder völlig gesund. Bitte hilf mir sie zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160106,
						205160108,
						205160111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160106,
					"content": "Geht klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160107
					]
				},
				{
					"id": 205160107,
					"content": "Danke sehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160115,
					"content": "Da fällt mir ein, Anna hat mir mal gesagt, sie wollte sich schon immer einmal die Statue des Windgottes ansehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160116,
					"content": "Ich erinnere mich, Schwester Grace war oft dort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160117,
					"content": "Du kannst sie erstmal fragen gehen, vielleicht hat sie etwas mitbekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160108,
					"content": "Hast du schon gesucht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160109
					]
				},
				{
					"id": 205160109,
					"content": "Natürlich habe ich das, sogar außerhalb der Stadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160110,
					"content": "Nur gefunden habe ich sie nicht. Ich kann nur dich um Hilfe bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160111,
					"content": "Was isst Anna denn gern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160112
					]
				},
				{
					"id": 205160112,
					"content": "Sie isst gern ... He! Ich hab doch gesagt, du sollst meine Schwester nicht wie eine Katze behandeln!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160113,
					"content": "Außerdem gibt es vieles, das sie isst, da kann ich nicht mitzählen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160114,
					"content": "Finde sie bitte schnell, ich warte genau hier auf dich. Ich bin schon ganz erschöpft nach einer Runde Suchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "Anthony"
				}
			]
		},
		{
