				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205160401,
					"content": "Dieses Kind, sie ist doch krank. Wie geht das nur ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160402
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160402,
					"content": "Entschuldigung, hast du hier zufällig ein Mädchen gesehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160403
					]
				},
				{
					"id": 205160403,
					"content": "Hm ... Du suchst doch bestimmt nach Anna. Guck mal dort oben, sie befindet sich auf der Hand der Statue des Windgottes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160404
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160404,
					"content": "Als sie vorbeigerannt ist, habe ich mir noch so gedacht, wie kann sie denn auf einmal so rennen, wo es ihr gesundheitlich doch nicht so gut geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160405
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160405,
					"content": "Ich bin einfach nur sprachlos. Wie kann sie denn einfach auf die Statue des Windgottes klettern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160406
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160406,
					"content": "Du ... bist nicht wütend?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160407
					]
				},
				{
					"id": 205160407,
					"content": "Wütend? Natürlich schon ein bisschen, aber sie war immer so krank und hat viel gelitten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160408
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160408,
					"content": "Jetzt, da ich sehe, wie gesund sie ist, wie soll ich sagen, da kann ich einfach nicht sauer sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160409
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160409,
					"content": "Obwohl es da oben bestimmt gewaltig zieht. Sie soll sich ja nicht erkälten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
