						411460102
					]
				},
				{
					"id": 411460102,
					"content": "Vielen Dank. Es ist viel zu weit weg, und wir haben zu wenig Personal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411460103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411460103,
					"content": "Ach so, bitte sei vorsichtig. <color=#00E1FFFF>Renn nicht zu schnell und verzichte auf den Windgleiter. Klettern solltest du auch nicht ...</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411460104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411460104,
					"content": "Wenn du unterwegs zu oft stolperst, ist das schlecht für die Fleischsoße und die Nudeln ... Dann wird der Kunde das Gericht ablehnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
