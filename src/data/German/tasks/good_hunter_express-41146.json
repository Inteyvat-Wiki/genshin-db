			"dialogs": [
				{
					"id": 411460301,
					"content": "Ich habe gehört, es gibt eine Sonderbestellung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411460302
					]
				},
				{
					"id": 411460302,
					"content": "Stimmt, ein gewisser ... Angelo hat einmal Feurige Nudeln bestellt und auch bereits bezahlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411460303
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411460303,
					"content": "Er hat darum gebeten, sie bei der Glanzkronschlucht auszuliefern. Aber das ist ziemlich weit entfernt, und ich kenne niemanden, den ich hinschicken kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411460304
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411460304,
					"content": "Wäre es in Ordnung für dich, die Nudeln auszuliefern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
