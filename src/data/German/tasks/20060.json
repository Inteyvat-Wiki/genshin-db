				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600501,
					"content": "Oh, hallo! Hältst du da Zuckerblumen in der Hand? Es klingt vielleicht etwas überstürzt, aber könnte ich dir eine abkaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600502
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600502,
					"content": "Mein Vater hustet so viel und ich habe Jilliana darum gebeten, mir Hustenmedizin herzustellen. Sie hat aber keine Zutaten mehr dafür ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600503,
						200600506
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600503,
					"content": "Ich bin auch auf dem Weg, Medizin zu besorgen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600504
					]
				},
				{
					"id": 200600504,
					"content": "Oh, das habe ich nicht gewusst. Entschuldige bitte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600505
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600505,
					"content": "Ich will dich nicht aufhalten. Geh schnell zur Kathedrale! Jilliana ist noch da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600506,
					"content": "Zuckerblumen sind leicht zu finden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600507
					]
				},
				{
					"id": 200600507,
					"content": "Oh ... na gut. Ich muss hier am Tor Wache stehen. Deswegen kann ich nicht auf die Suche gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600508
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600508,
					"content": "Ich musste sogar meine Mittagspause opfern, um Jilliana zu fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600509
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600509,
					"content": "Schon gut, du siehst aus, als wolltest du auch Medizin machen lassen ... Dann geh mal lieber schnell zur Kathedrale. Jilliana müsste immer noch da sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guy"
				}
			]
		},
		{
			"id": 2006006,
