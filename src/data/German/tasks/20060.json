			},
			"dialogs": [
				{
					"id": 200600901,
					"content": "Wann geht dieser Husten denn endlich weg?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600902,
						200600904
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600902,
					"content": "Hier ist deine Medizin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600903
					]
				},
				{
					"id": 200600903,
					"content": "Oh, vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600907
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600907,
					"content": "Ich schäme mich regelrecht. Mein Sohn kämpft für uns und ich bin keinerlei Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600908
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600908,
					"content": "Ich kann höchstens dafür sorgen, dass er nicht auch noch von mir belästigt wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600909
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600909,
