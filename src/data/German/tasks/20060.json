			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tunner"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600101,
					"content": "Willkommen! Kennst du zufälligerweise meinen Sohn Guy? *hust* *hust*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600102
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600102,
					"content": "Was ist denn los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600103
					]
				},
				{
					"id": 200600103,
					"content": "Ach, nichts. Das ist schon länger so und wird auch nicht besser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600104
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600104,
					"content": "Ich war auch in der <color=#00E1FFFF>Kathedrale</color>. Die Schwestern dort können mich aber nicht auf der Stelle heilen, sondern nur Medizin verschreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600105
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600105,
					"content": "Ich bin ja auch alt und kann nicht mehr so viel laufen. Früher habe ich Moco und Hillie geschickt, meine Medizin zubereiten zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600106
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600106,
					"content": "Aber heute haben die beiden keine Zeit ... *hust* ... ich habe <color=#00E1FFFF>Jilliana</color> schon Bescheid gesagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600107
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600107,
					"content": "Jemand muss einfach die Zutaten hinbringen, damit sie die Medizin zubereiten kann. <color=#00E1FFFF>Drei Zuckerblumen</color> sind schon ausreichend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600108,
						200600110
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600108,
					"content": "In Ordnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600109
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600109,
					"content": "*hust* Dankeschön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600112,
					"content": "Es geht ja nur um drei Zuckerblumen. Damit kannst du zu Schwester Jilliana in der Kathedrale gehen. <color=#00E1FFFF>Lass Guy aber um Himmels Willen nichts davon wissen!</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600113
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600113,
					"content": "Die Kathedrale soll Beziehungen zum Ordo Favonius haben. Du solltest aufpassen, was du sagst, weil Guy ein Teil des Ordens ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600114
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600114,
					"content": "Wenn du jetzt meinetwegen noch etwas Unpassendes sagtest, wäre das schrecklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600115
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600115,
					"content": "Ach, tut mir das leid! Jetzt habe ich dich so lange bequasselt. Geh schon und pass auf dich auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600110,
					"content": "Guy könnte doch auch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600111
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600111,
					"content": "Meine Güte, das Kind kämpft weitab von der Heimat. Da können wir es doch nicht auch noch damit belästigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "Tunner"
				}
			]
		},
		{
