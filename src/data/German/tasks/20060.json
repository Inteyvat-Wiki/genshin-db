					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600301,
					"content": "Das sollte genug sein. Gehen wir damit zu <color=#00E1FFFF>Schwester Jilliana</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2006004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600401,
					"content": "Ach, warte mal. Sieht aus, als hätten wir schon genug Zuckerblumen dabei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200600402,
					"content": "Wir können sie sofort zu <color=#00E1FFFF>Schwester Jilliana</color> bringen. Oder brauchen wir noch mehr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2006005,
			"completionStepIds": [
				2006006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2006006",
							"2"
