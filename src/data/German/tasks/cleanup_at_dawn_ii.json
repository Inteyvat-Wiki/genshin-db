				"points": []
			},
			"dialogs": [
				{
					"id": 201040301,
					"content": "Warum hast du das denn gemacht?! Du hast den Heuhaufen verbrannt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040302
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040302,
					"content": "Ganz toll, vielen Dank ... jetzt wird Adelinde sicher ausflippen - und dazu wird sie uns definitiv auch noch rauswerfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040303
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040303,
					"content": "Es war ein Unfall ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040304
					]
				},
				{
					"id": 201040304,
					"content": "Uh, wir hätten sie einfach eines nach dem anderen herausnehmen sollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040305
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040305,
					"content": "Verflucht ... Es gibt davon keinen Weg zurück ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040306
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040306,
					"content": "Ich, äh ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040307
					]
				},
				{
					"id": 201040307,
					"content": "Reisender, du machst dich besser aus dem Staub. Das war unsere Verantwortung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040308
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040308,
					"content": "Es ist unsere Schuld, uns von jemandem helfen zu lassen, der nichts über das Saubermachen weiß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040309
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040309,
					"content": "Was wird Adelinde machen, wenn sie es herausfindet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040310
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040310,
					"content": "Sie wird so sauer sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hillie"
				}
			]
		},
