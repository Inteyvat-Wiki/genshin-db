			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Moco"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201040101,
					"content": "Was sollen wir jetzt tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040102
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040102,
					"content": "Adelinde wird so was von austicken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040103
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040103,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040104
					]
				},
				{
					"id": 201040104,
					"content": "Also, Adelinde hat uns gebeten, im Bereich rund um das Weingut für Ordnung zu sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040105
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040105,
					"content": "An den meisten Stellen ist es in Ordnung, aber es sind überall diese Heuhaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040106
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040106,
					"content": "Connor meinte, er bewahrt sie hier auf, weil er sie für etwas braucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040107
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040107,
					"content": "Sie sind ziemlich eng gebunden, deswegen weht der Wind sie zumindest nicht fort. Trotzdem wurde ein Haufen Blätter in das Heu hineingeblasen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040108
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040108,
					"content": "Wir haben wirklich hart daran gearbeitet, aber wir haben es trotzdem nicht geschafft, alle Blätter herauszuholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040109
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040109,
					"content": "Wenn wir in diesem Tempo weitermachen, wird Adelinde, die Leiterin der Hausmädchen, ausflippen ... Was sollen wir tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040110,
						201040112
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040110,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040111
					]
				},
				{
					"id": 201040111,
					"content": "Ernsthaft? Du bist fantastisch! Danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040112,
					"content": "Es ist also schwierig, die Blätter loszuwerden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040113
					]
				},
				{
					"id": 201040113,
					"content": "Wenn sie sich unter das Heu gemischt haben, dann ja. Wir müssen sie eins nach dem anderen herausnehmen, was ewig dauert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040114
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040114,
					"content": "Falls du eine besser Idee hast, sind meine Ohren gespitzt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hillie"
				}
			]
		},
		{
			"id": 2010402,
			"completionStepIds": [
				2010404
			],
