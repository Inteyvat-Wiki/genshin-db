					"Moco"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201040201,
					"content": "Und wie ist die Lage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040202
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040202,
					"content": "Hast du alle gekriegt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040203
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040203,
					"content": "Jeden einzelnen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040204
					]
				},
				{
					"id": 201040204,
					"content": "Oh mein Gott, du bist toll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040205
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040205,
					"content": "Reisender, du bist der beste Mensch auf der Welt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040206
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040206,
					"content": "Danke! Jetzt wird uns Adelinde nicht mehr auf die Nerven gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040207
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040207,
					"content": "Bitte, nimm dieses Geschenk zum Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040208
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040208,
					"content": "Richtig, wir müssen nun andere Orte säubern. Danke! Bis bald.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moco"
				}
			]
		},
		{
