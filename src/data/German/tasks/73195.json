				{
					"id": 731951001,
					"content": "„Weiß jemand, wo ich einen guten Geschichtenerzähler aufgabeln kann? Jemand, der eine Geschichte jedes Mal genau gleich wiedergeben kann.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951002
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731951002,
					"content": "„Ich werde von einem schrecklichen Dschinn heimgesucht. Er hat mir mit dem Tod gedroht, wenn ich ihm nicht jeden Tag genau dieselbe Geschichte haargenau gleich erzähle. Das geht schon einen Monat so und mein Gehirn wird durch diese Folter zu Brei ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951003
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731951003,
					"content": "„Was für ein seltsames Erlebnis. Ich habe von einem Geschichtenerzähler namens Maddah im Puspa-Kaffeehaus gehört. Vielleicht kann er dir helfen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anschlagtafel"
				}
			]
		},
		{
			"id": 7319511,
			"completionStepIds": [
				7319511
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319511",
							"2"
						],
						"stepId": 7319511,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951101,
					"content": "„Ich war in so vielen Ländern und habe unzählige Aufführungen gesehen. Nilou ist zweifellos die Nummer eins in Teyvat. Aber die Pedanten der Akademie können sie nicht wertschätzen und beschweren sich sogar über sie! Sie besudeln die Kunst!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951102
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731951102,
					"content": "„Nach meiner Erfahrung in Mondstadt sollten wir einen Fanclub für Nilou gründen. Dann können diese Kunstbanausen sie nicht länger beleidigen!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951103
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731951103,
					"content": "„Ein Fanclub ... Gehört das zum Flair von Mondstadt? Aber eine vollendete Vorführung ist das Werk der gemeinsamen Anstrengungen einer ganzen Gruppe. Die ganze Aufmerksamkeit auf eine einzelne Person zu richten, ist einfach nicht fair.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951104
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731951104,
					"content": "„Außerdem bin ich der festen Ansicht, dass die Kunst allein ausreicht, um alle an sich zu binden. Ich freue mich sehr, dass du Nilous Vorstellung magst.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951105
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731951105,
					"content": "„Von der eleganten Handschrift zu urteilen solltest du eine junge Dame sein. Ich finde es großartig, dass es jemanden gibt, der mein Interesse an Tanzaufführungen teilt. Darf ich fragen, ob du Zeit für eine Tasse Kaffee hättest?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951106
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731951106,
					"content": "„Tut mir leid, ich bin sehr beschäftigt. Bitte wende dich an meinen Manager, falls du Hilfe brauchst.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951107
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731951107,
					"content": "„Der Typ wurde abgewiesen. Die letzte Nachricht wurde eindeutig von einem Grobian eines Mannes geschrieben ... wahrscheinlich der Leibwächter einer reichen Dame.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anschlagtafel"
				}
			]
		},
		{
			"id": 7319512,
			"completionStepIds": [
				7319512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319512",
							"2"
						],
						"stepId": 7319512,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951201,
					"content": "„Zauberflaschen zu verkaufen! Zauberflaschen mit Dschinn! Bitte hinterlasse deine Zahlung hier. Eine Mora und dein Traum wird wahr.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951202
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731951202,
					"content": "„Zauberflaschen, die jeden Wusch erfüllen! Für nur eine Mora.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951203
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731951203,
					"content": "„Ich bin ein Dschinn. Gib mir eine Mora und ich kann deine Träume verwirklichen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951204
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731951204,
					"content": "„Die Halle von Regzar untersucht derzeit die letzte Serie von Betrugsfällen. Bitte bleib ruhig.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951205
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731951205,
					"content": "„Alle Opfer können sich bei weiteren Fragen für nur eine Mora beraten lassen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anschlagtafel"
				}
			]
		},
		{
			"id": 7319513,
			"completionStepIds": [
				7319513
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319513",
							"2"
						],
						"stepId": 7319513,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951301,
					"content": "„Seit ich Waldhüter bin und meine gesamte Zeit im Wald verbringe, bin ich kurz davor, mich mit Dämmerseglern zu unterhalten.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951302
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731951302,
					"content": "„Wenn ich sie nur verstehen könnte, dann wäre mir nicht so langweilig wie jetzt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anschlagtafel"
				}
			]
		},
		{
			"id": 7319514,
			"completionStepIds": [
				7319514
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319514",
							"2"
						],
						"stepId": 7319514,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951401,
					"content": "„Eigentlich gibt es da eine anständige Söldnerin namens ‚Feuermähne‘ oder so ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951402
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731951402,
					"content": "„Ich habe sie immer als Leibwächter eingestellt, wenn ich geschäftlich zur See gefahren bin. Ob Schatzräuber oder Millelithen, sie konnte es mit allen aufnehmen und ich hatte nichts zu befürchten. Ich habe ein Vermögen dank ihr gemacht.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951403
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731951403,
					"content": "„Aber sie nimmt keine Aufträge mehr an und ich habe gehört, dass es immer mehr Monster auf dem Weg nach Liyue gibt ... Wenn das so weitergeht, muss ich mein Geld in die Börse Kalimi stecken.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951404
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731951404,
					"content": "„Du klingst nicht wie jemand, der anständige Geschäfte macht ... Aber ich habe gehört, dass diese ‚Feuermähne‘ einen großen Auftrag von den Homayani angenommen hat. Da musst du dich etwas gedulden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951405
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731951405,
					"content": "„Und ich gebe dir einen kleinen Ratschlag mit. Dein Geld ist besser in einhundert Teppiche investiert als in die Börse Kalimi!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951406
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731951406,
					"content": "„Da hast du absolut recht! Bitte komme zu meinem Laden und bekomme einhundert Teppiche! Ich kann dir den Nutzen von jedem einzelnen Teppich im Detail erklären!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anschlagtafel"
				}
			]
		},
		{
			"id": 7319515,
			"completionStepIds": [
				7319515
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
