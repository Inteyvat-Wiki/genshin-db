						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319517",
							"2"
						],
						"stepId": 7319517,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951701,
					"content": "„Die Stadt der Weisheit gehört uns, ebenso wie das Dickicht der Unwissenheit. Die Baumwipfel sind übersät mit Schätzen aus dem Reich der verlorenen Träume.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anschlagtafel"
				}
			]
