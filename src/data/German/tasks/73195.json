			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951501,
					"content": "Falls du jemandem mit leerem Blick oder jemandem, der vor sich hin murmelt, im Wald begegnen, sind das Gelehrte im „Satyavada-Stadium“. Bitte stör sie nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951502
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731951502,
					"content": "Falls du in irgendeiner Weise gestört oder dich belästigt fühlst, bitte melde dich beim Mahamata, der sich ordnungsgemäß um die Angelegenheit kümmern wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anschlagtafel"
				}
			]
		},
		{
			"id": 7319516,
			"completionStepIds": [
				7319516
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
