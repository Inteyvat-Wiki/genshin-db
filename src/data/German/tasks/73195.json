			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951601,
					"content": "„Ich habe gehört, dass sich Diwan früher für uns normale Bürger aus der Unterstadt eingesetzt hat, aber jetzt gehorcht er nur noch dem Mahamata.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951602
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731951602,
					"content": "„Wie dieser Vizier, er ist ein absoluter Niemand! Die Großen erinnern sich nur an ihn, wenn die Mahamata einen Sündenbock brauchen!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951603
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731951603,
					"content": "Die Leitung der Akademie für alle Verwaltungsorgane basiert auf die Lehren der Höheren Herrin Rukkhadevata. Solche Verleumdungen sind verboten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anschlagtafel"
				}
			]
		},
		{
			"id": 7319517,
			"completionStepIds": [
				7319517
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
