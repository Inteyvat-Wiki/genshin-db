			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950101,
					"content": "Die Ankündigungstafel wurde vom Herrn Vizier eingeführt, um Bekanntgaben zu wichtigen Angelegenheiten in Sumeru zu machen. In Zusammenhang stehende Fragen oder Zweifel können hier ebenfalls hinterlassen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anschlagtafel"
				}
			]
		},
		{
			"id": 7319502,
			"completionStepIds": [
				7319502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319502",
							"2"
						],
						"stepId": 7319502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950201,
					"content": "„Bekanntmachung: Suche nach Experten, die einen Rishboland-Tiger unschädlich machen können ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950202
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731950202,
					"content": "Der offizielle Inhalt der Bekanntmachung wurde mit einem Pinsel übermalt. Daneben steht in krakliger, kindlicher Handschrift ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950203
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731950203,
					"content": "„Raja will doch nur mit allem spielen!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anschlagtafel"
				}
			]
		},
		{
			"id": 7319503,
			"completionStepIds": [
				7319503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319503",
							"2"
						],
						"stepId": 7319503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950301,
					"content": "„Solltest du nach dem Verzehr von Pilzen tanzende Feen sehen, ist dies ein normales Phänomen. Bitte sei nicht beunruhigt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950302
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731950302,
					"content": "„Aber sollten die Pflanzen um dich herum anfangen zu sprechen, such bitte sofort Hilfe beim nächsten Waldhüter.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anschlagtafel"
				}
			]
		},
		{
			"id": 7319504,
			"completionStepIds": [
				7319504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319504",
							"2"
						],
						"stepId": 7319504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950401,
					"content": "„Aus unbekannten Gründen hat sich die ‚Verwelkung‘ im gesamten Wald sowohl in Menge als auch in Oberfläche ausgedehnt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950402
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731950402,
					"content": "„Die ‚Verwelkung‘ lässt nicht nur Pflanzen verdorren, sondern kostet auch Tieren und Menschen das Leben. Die Waldhütermeister haben hierfür ‚verunreinigte Gebiete‘ gekennzeichnet, bitte halte dich entfernt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950403
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731950403,
					"content": "„Solltest du eine neue Verwelkungsstelle im Wald bemerken, wende dich bitte an den nächsten Waldhüter für eine professionelle Behandlung.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anschlagtafel"
				}
			]
		},
		{
			"id": 7319505,
			"completionStepIds": [
				7319505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319505",
							"2"
						],
						"stepId": 7319505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950501,
					"content": "Die Matra haben bei ihren letzten Inspektionen der örtlichen Basare mehrere Fälle von illegalem Handel mit Wissenskonserven aufgedeckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950502
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731950502,
					"content": "Der Handel mit Wissenskonserven wird strengstens von der Akademie untersagt. Jeglicher Verstoß wird strengstens bestraft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950503
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731950503,
					"content": "Die Akademie haftet nicht für die Konsequenzen, die sich aus der illegalen Nutzung von Wissenskonserven ergeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anschlagtafel"
				}
			]
		},
		{
			"id": 7319506,
			"completionStepIds": [
				7319506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319506",
							"2"
						],
						"stepId": 7319506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950601,
					"content": "„Das alljährliche Sabzeruz-Fest steht vor der Tür! Wie letztes Jahr wird der Große Basar ein großes Fest veranstalten.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950602
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731950602,
					"content": "„Um die Atmosphäre noch festlicher zu gestalten, hat unser Fräulein einen Zuschuss für alle teilnehmenden Händler vorbereitet.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950603
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731950603,
					"content": "„Feiern wir den Geburtstag der Niederen Herrin Kusanali!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anschlagtafel"
				}
			]
		},
		{
			"id": 7319507,
			"completionStepIds": [
				7319507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319507",
							"2"
						],
						"stepId": 7319507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950701,
					"content": "„Unser Fräulein ist ausgerissen und immer noch nicht zurückgekehrt. Wenn du ein junges Mädchen mit braunen Haaren mit einem blau-violetten Kleid siehst, wende dich bitte unverzüglich an die Familie Homayani. Wir werden dich für deine Hilfe gebührend entschädigen!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950702
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731950702,
					"content": "„Falls unser Fräulein selbst die Vermisstenmeldung sieht, bitte melde dich sofort bei deiner Familie. Der Herr und die Frau machen sich große Sorgen um dich.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anschlagtafel"
				}
			]
		},
		{
			"id": 7319508,
			"completionStepIds": [
				7319508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319508",
							"2"
						],
						"stepId": 7319508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950801,
					"content": "„Er ist wieder da! Mein Herr Al-Ahmar ist wieder da!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950802
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731950802,
					"content": "„Der Tag seiner Rückkehr ist der Tag, an dem ihr mit den Blättern auf dem Kopf mit eurer Vergeltung rechnen könnt!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950803
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731950803,
					"content": "Diese Nachricht ist falsch. Wir untersuchen zurzeit die Quelle des Gerüchts. Alle hiesigen und auswärtigen Angelegenheiten in Sumeru werden regelmäßig im Akasha veröffentlicht. Bitte vertrau keinen Gerüchten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anschlagtafel"
				}
			]
		},
		{
			"id": 7319509,
			"completionStepIds": [
				7319509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319509",
							"2"
						],
						"stepId": 7319509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950901,
					"content": "„Mein Freund, steckst du in Schwierigkeiten? Der allmächtige Herr Sangemah Bay ist hier, um dir die Rede und Antwort zu stehen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950902
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731950902,
					"content": "„Es kostet dich nur ein paar Mora und deine Probleme lösen sich in Luft auf.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950903
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731950903,
					"content": "„Handle, bevor es zu spät ist! Kontaktdetails ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950904
					],
					"speakerTitle": "Anschlagtafel"
				},
				{
					"id": 731950904,
					"content": "Die Ankündigungstafel wurde vom Herrn Vizier eingeführt, um die Markttransaktionen zu regulieren. Bitte veröffentlich keine Werbung hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anschlagtafel"
				}
			]
		},
