			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Gygax"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706590101,
					"content": "Hallo, hast du Lust, Windflucht einmal auszuprobieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590102
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590102,
					"content": "Was ist Windflucht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590103
					]
				},
				{
					"id": 706590103,
					"content": "Gut, dass du fragst. Windflucht ist ein Spiel rund um die Geschichte von Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590104
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590104,
					"content": "Du hast sicher schon von den Aristokraten gehört, die in Mondstadt lebten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590105
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590105,
					"content": "Sie waren absolute Wilde. Worte können dem nicht gerecht werden, wie die Menschen durch ihre Hand gelitten haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590106
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590106,
					"content": "Um sich gegen ihre Tyrannei zu wehren, schloss sich eine Gruppe mutiger Bürger zusammen und gründete eine geheime Widerstandsorganisation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590107
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590107,
					"content": "Diese tapferen Kämpfer für die Gerechtigkeit wurden in der ganzen Stadt aktiv. Sie wurden den Aristokraten ein großer Dorn im Auge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590108
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590108,
					"content": "Aber die Aristokraten schlugen zurück, indem sie schnell ihre eigene Gruppe von Handlangern ausbildeten, um die Rebellen zu unterdrücken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590109
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590109,
					"content": "Und so lieferten sich die Rebellen ein Duell nach dem anderen mit den Schergen der Aristokraten, überall in der Stadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590110
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590110,
					"content": "Windflucht ist inspiriert von dieser epischen Sage aus der Geschichte Mondstadts! Und es war früher ziemlich beliebt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590111
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590111,
					"content": "Nur früher war das so?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590112
					]
				},
				{
					"id": 706590112,
					"content": "Traurigerweise, ja. Junge Leute scheinen sich heutzutage nicht sehr für das Spiel zu interessieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590113
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590113,
					"content": "Aber ich kann nicht zulassen, dass Windflucht in Vergessenheit gerät. Also habe ich die Regeln ein wenig geändert, um den Einstieg zu erleichtern und mehr Spaß zu bieten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590114
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590114,
					"content": "Ich habe auch eine ganze Ladung brandneuer Karten eingebaut. Hoffentlich kann ich auf diese Weise mehr Leute zum Spielen bringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				}
			]
		},
		{
			"id": 7065903,
