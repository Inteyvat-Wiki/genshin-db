			},
			"dialogs": [
				{
					"id": 706590301,
					"content": "Hehe. Wie auch immer, du hast genug von mir gehört ... Du solltest es ausprobieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590302,
						706590303
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590302,
					"content": "Windflucht spielen",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 706590303,
					"content": "Verlassen",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590304
					]
				},
				{
					"id": 706590304,
					"content": "Na gut, wenn du jemals Interesse hast, es auszuprobieren, weißt du, wo du mich findest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				}
			]
		}
	]
