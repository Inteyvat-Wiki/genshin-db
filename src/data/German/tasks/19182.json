				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191823901,
					"content": "(Mérieux’ Name taucht in manchen früheren Zeitungsausschnitten auf, aber hauptsächlich in Artikeln, die „eine Reihe lauwarmer Empfänge für eine experimentelle Kunstform“ und „leere Sitzplätze bei avantgardistischem Theater trotz akademischer Würdigung“ beklagen ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191823902
					],
					"speakerTitle": "Die Notizen untersuchen"
				},
				{
					"id": 191823902,
					"content": "(In weniger lang zurückliegenden Jahren preisen viele Berichte Mérieux als Regisseur mit Weitblick, einen der Großen seiner Epoche ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191823903
					],
					"speakerTitle": "Die Notizen untersuchen"
				},
				{
					"id": 191823903,
					"content": "(Die Artikel wurden von einer bunten Schar von Autoren aus allerlei Fachgebieten geschrieben. Unter ihnen sind Corentin und Amaury die Wortführer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Die Notizen untersuchen"
				}
			]
