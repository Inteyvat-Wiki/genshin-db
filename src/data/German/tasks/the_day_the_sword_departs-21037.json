			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kleine Que’er",
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370401,
					"content": "*wimmer* Zhiruo, ist ... ist er absichtlich gegangen? ... Er will mich nur verlassen! *heul*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370402
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 210370402,
					"content": "Que’er, ihr seid die ganze Zeit zusammen, wie soll er denn deine Gefühle nicht begriffen haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370403
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370403,
					"content": "Dass er Liyue verlässt und in die Ferne reist, wird schon seine Gründe haben. Was wäre denn falsch daran mit ihm zusammen zu reisen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370404
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370404,
					"content": "Ich will Liyue nicht verlassen! Ist es etwa schlecht, wenn wir beide hier bleiben? Die Guhua-Schule ... Mir könnte nichts weniger wichtig sein als seine Guhua-Schule ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370405
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 210370405,
					"content": "Warum sagst du ihm das dann nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370406
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370406,
					"content": "Ich ... Ich ... Die Guhua-Schule ist alles, an das er denkt ... Wenn ich ihm das sagen würde, würde er mich bestimmt nicht mehr mögen und dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370407
					],
					"speakerTitle": "Kleine Que’er"
				},
				{
					"id": 210370407,
					"content": "*seufz* Que’er ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
