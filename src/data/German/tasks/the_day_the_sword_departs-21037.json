			},
			"dialogs": [
				{
					"id": 210370201,
					"content": "#{F#Reisende}{M#Reisender}, hast du mir die Erde zurückgebracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370202
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370202,
					"content": "Hier ist die Erde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 2103703,
			"completionStepIds": [
				2103705
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
