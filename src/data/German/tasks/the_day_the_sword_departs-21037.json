			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370301,
					"content": "Vielen Dank, das sollte reichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370302,
						210370305
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370302,
					"content": "Du siehst ziemlich niedergeschlagen aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370303
					]
				},
				{
					"id": 210370303,
					"content": "Oh? Hahaha, nein ... nein ... Tut mir leid, ich wollte nicht, dass du dich um mich sorgst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370304
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370304,
					"content": "Es ist nur, dass ich mich wirklich nur sehr schwer von meinem langen Leben in Liyue trennen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370305,
					"content": "Wann brecht ihr auf?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370306
					]
				},
				{
					"id": 210370306,
					"content": "Wir brechen auf, sobald alle Vorräte vorbereitet sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370307
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370307,
					"content": "Ach ja, die Abenteurerin, mit der ich damals zur Großen Kluft gegangen bin, wird auch mitkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370308
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370308,
					"content": "Als sie hörte, dass ich zu Fontaine gehen würde, sagte sie, dass sie auch daran interessiert sei und beschloss, mit uns zu kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370309
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370309,
					"content": "Der Geschäftsreisende ist auf jeden Fall sehr glücklich, dass die Abenteurerin mitkommt und ihn beschützen wird ... Aber ehrlich gesagt bin ich wirklich nicht gut dabei, mit so temperamentvollen Menschen zu reden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370310
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370310,
					"content": "Kaum zu glauben, dass ich auch einmal meine Heimat weit hinter mir lassen werde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2103704,
