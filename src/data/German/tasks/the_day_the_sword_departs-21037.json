			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370101,
					"content": "Liyue ... Oh, Liyue, wer weiß, wann ich dich wieder sehen werde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370102
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370102,
					"content": "Was ist mit dir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370103
					]
				},
				{
					"id": 210370103,
					"content": "#{F#Reisende}{M#Reisender}, du bist es ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370104
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370104,
					"content": "Es ist so. Der Plan für meine Reise nach Fontaine steht endlich fest, in ein paar Tagen werde ich mit diesem Geschäftsreisenden aufbrechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370105
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370105,
					"content": "Jetzt muss er noch ein paar geschäftliche Angelegenheiten regeln und ich möchte diese Zeit nutzen, um alles ordentlich zu packen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370106,
						210370107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370106,
					"content": "Wirst du nicht noch ein letztes Mal zum Jueyun-Karst gehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370108
					]
				},
				{
					"id": 210370108,
					"content": "Hehe, ich würde es zwar gern tun, aber ich glaube, dann könnte ich es wirklich nicht mehr übers Herz bringen, Liyue zu verlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370109,
					"content": "Es reicht mir, hier noch ein wenig von der Stadt zu sehen. Ich habe hier so lange gelebt und bei diesem Abschied weiß ich nicht, wie lange es dauern wird, bis ich wiederkehre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370110,
					"content": "Ach ja, Que’er ... Sie ... Sie hat nicht zugestimmt mit mir zu reisen, aber ich habe Zhiruo schon gebeten, gut auf sie aufzupassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370111
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370111,
					"content": "Ich habe ihr auch etwas von meinen Ersparnissen hinterlassen ... Sie ist klüger als ich und weiß, auf sich selbst zu achten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370112
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370112,
					"content": "... Vielleicht wird sie mich eines Tages verstehen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370113
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370113,
					"content": "#Apropos, {F#Reisende}{M#Reisender}, es gibt noch eine allerletzte Sache, um die ich dich bitten möchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370114
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370114,
					"content": "Könntest du mir ein bisschen „Erde“ bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370115,
						210370116
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370115,
					"content": "Das sollte kein Problem sein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370117
					]
				},
				{
					"id": 210370117,
					"content": "Ist es denn ungewöhnlich, wenn man gern einen Teil der Heimat auf fernen Reisen mitnehmen möchte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370118
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370118,
					"content": "Wenn ich ein bisschen von der Erde Liyues bei mir trage, kann ich immer sagen, dass ich nicht jede Verbindung zur Heimat verloren habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370119
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370119,
					"content": "Warum holst du sie dann nicht selbst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370120
					]
				},
				{
					"id": 210370120,
					"content": "Hahaha ... Habe ich das nicht schon gesagt? Wenn ich mir die Umgebung hier wirklich nochmal ansehen würde, kämen all meine Erinnerungen wieder hoch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370121
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370121,
					"content": "Und dann würde sich mein Mut, die Heimat zu verlassen, bestimmt in alle Winde zerstreuen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370122
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370122,
					"content": "#Deshalb betreue ich dich damit, dich um die Beschaffung der Erde zu kümmern, {F#Reisende}{M#Reisender}. Ich markiere den Ort auf deiner Karte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370123
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370123,
					"content": "Was soll an diesem Ort so besonders sein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370124
					]
				},
				{
					"id": 210370124,
					"content": "Ähem ... Also ... Ich habe dort oft mit Que’er den Schwertkampf geübt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370125
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370125,
					"content": "#Also! Ich bitte dich darum, die Erde für mich zu besorgen, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370116,
					"content": "Was möchtest du mit der Erde machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370117
					]
				},
				{
					"id": 210370107,
					"content": "Wirst du die Umgebung hier nicht noch ein letztes Mal anschauen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370108
					]
				}
			]
		},
		{
