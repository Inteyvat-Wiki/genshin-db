			"dialogs": [
				{
					"id": 760910702,
					"content": "Mal sehen ... Ja genau! Das sind sie, vielen Dank. Hier drin sind viele Beweismittel gegen die Fatui aufgezeichnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910703
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910703,
					"content": "... Beweismittel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910704,
					"content": "Schau dir die Einrichtungen an, die sie auf der Insel Paha gebaut haben, und all die Maschinen, die sie mitgebracht haben ... Das war doch ursprünglich das Zuhause vieler Tiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910705
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910705,
					"content": "Ich komme gerade vom Punainenhiekka-Teich zurück. Es muss an den Maschinen der Fatui liegen, dass die Quallen dort kaum noch überleben können ... Ich muss alle darüber informieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910706
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910706,
					"content": "So ist das also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910709,
					"content": "Ach ja, wenn ihr mit anderen darüber sprecht, müsst ihr unbedingt sagen, dass es von Semyon kommt, also von mir. Schließlich braucht es noch Zeit, bis der Artikel fertig geschrieben und in der Zeitung veröffentlicht ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910710
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910710,
					"content": "Ich überlasse euch diese Notizen. Ich muss schnell zurück und den Inhalt der anderen Notizen ordnen, um daraus einen Artikel zu schreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910701
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910701,
					"content": "Jedenfalls vielen Dank und auf Wiedersehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
