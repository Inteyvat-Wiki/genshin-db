			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910101,
					"content": "Eine fliegende Fee! Meine Notizen ... Meine wichtigen Notizen wurden von den Fatui beschlagnahmt. Kannst du mir helfen, sie wiederzufinden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910102
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910102,
					"content": "Auch wenn Paimon keine Fee ist ... bei sowas Kleinem kann Paimon schon helfen. Aber sag mal, warum haben die Fatui die Notizen eines Kindes beschlagnahmt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910103,
					"content": "Vielleicht haben sie Angst, dass ich den Inhalt der Notizen öffentlich mache ... Wenn ihr mir helft, die Notizen zurückzubekommen, werde ich euch dieses Geheimnis verraten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910105
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910105,
					"content": "Darüber können wir später sprechen. Bitte helft mir erstmal, meine <color=#00E1FFFF>Notizen wiederzufinden</color>. Vielleicht gibt es noch ein paar <color=#00E1FFFF>verstreute, lose Seiten</color> aus dem Notizbuch dort drüben, wo die Fatui sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
		{
			"id": 7609102,
			"completionStepIds": [
				7609107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
