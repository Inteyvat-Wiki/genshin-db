			"dialogs": [
				{
					"id": 700730401,
					"content": "Dann will ich dich mal nicht weiter stören.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730402
					]
				},
				{
					"id": 700730402,
					"content": "Wohin du auch gehst, die Pilze werden dich beschützen.",
