			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730101,
					"content": "Mit dem Kerl da würde ich gern ein Kräftemessen veranstalten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730102
					]
				},
				{
					"id": 700730102,
					"content": "Vortrefflich! Mein Gebieter muss seinen göttlichen Leib immer wieder strecken, damit die herabfallenden Pilzstücke noch köstlicher schmecken! Bitte gib alles und lass keine Gnade walten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730201,
					"content": "O mein Gebieter, Mahavasudeva{RUBY#[D]Abkömmling des weltenschenkenden Herrn}-Yava, möge dein Jivas{RUBY#[D]Wurzel des Lebens}thaya tief in den Felsgrund dieses Landes sinken. Möge dein Geschmack den eines jeden Gottes unter dem Himmel übertreffen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730301,
					"content": "Was soll das denn darstellen ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730302
					]
				},
				{
					"id": 700730302,
					"content": "Eine wahrhaft gesegnete Frage! Dies ist der verehrte Sprössling des weltenschenkenden{RUBY#[S]Bifrons} Herrn, ein heiliger Pilz, geboren aus vollkommenem Geschmack.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730303
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730303,
					"content": "Nagahvaya ruft stets die Herrin der Pflanzen und den Herrn des Blumen{RUBY#[D]Pushpavatika}gartens an. Makani Khagan betet ewig zum Herrn des Sandes. Aber frag sie selbst. Welcher der drei großen Herrscher schmeckt besser als mein Herr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730304
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730304,
					"content": "Höre! Kein Leid zuzufügen, das ist der rechte Pfad. Wäre nicht das göttliche Fleisch unseres Herrn, so müssten wir das Leben von Tieren, Vögeln und Pflanzen nehmen, nur um zu überleben ... Ach, wie jämmerlich das doch wäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730305
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730305,
					"content": "Wahrlich ein Glück. Als der Herr des Raums mich vom Boden fortführte, reiste auch seine Ji{RUBY#[D]Sporen}va mit mir. Und wie ihr seht, sind sie bis heute gewachsen und haben mir diesen herrlichen und wunderbaren Geschmack verliehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
