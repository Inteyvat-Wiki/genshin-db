			"dialogs": [
				{
					"id": 740851401,
					"content": "Endlich ist die Unreinheit weg. Unglaublich, dass Pahsiv solch eine erstaunliche Fähigkeit hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851402,
					"content": "Nun ... Ah, warte ... Da leuchtete etwas auf dem Boden auf ... Eine Formation oder so!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851403,
					"content": "Aah! Garme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851404,
					"content": "Lila ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851405
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851405,
					"content": "Pahsiv, mach dir keine Sorgen! Wir werden dich beschützen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851406,
					"content": "Warte mal! Pahsiv, wohin gehst du? Lauf nicht weg! Es ist hier gefährlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
