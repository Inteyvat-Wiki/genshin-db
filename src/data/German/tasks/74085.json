				{
					"id": 740851903,
					"content": "Das stimmt ... Boah! Schau dir den großen Baum an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851904,
					"content": "Echt schön! So sah er eigentlich aus! Wenn Pahsiv ihn sehen würde, würde sie sich sicher auch freuen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851905,
					"content": "#Paimon! Pahsiv! {NICKNAME}! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851906
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851906,
					"content": "Pahsiv? Super! Wo warst du gerade eben? Wir haben uns Sorgen um dich gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851907,
					"content": "Keine Spur, Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851908
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851908,
					"content": "Ah ... Kiste, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851909
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851909,
					"content": "Äh? Sind das ... Schatztruhen? Hast du Schatztruhen gesucht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851910,
					"content": "Pahsiv! Aber, Goldenes, Rundes, Melusine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851911
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851911,
					"content": "Mora hast du nicht gefunden? Das macht absolut nichts! Alleine diese Schatztruhen reichen völlig aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851912,
					"content": "Paimon ist ganz gerührt, dass du dich daran erinnert hast, was Paimon gesagt hat. Danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851913,
					"content": "Dan...ke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851916
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851916,
					"content": "Danke bedeutet Pahsiv!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851917
					]
				},
				{
					"id": 740851917,
					"content": "#Paimon, danke! {NICKNAME}, danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851918
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851918,
					"content": "#Paimon, gut Ding! {NICKNAME}, gut Ding!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851919
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851919,
					"content": "Pahsiv! Gut Ding!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851920
					]
				},
				{
					"id": 740851920,
					"content": "Pahsiv! Gut Ding!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851921,
					"content": "#{NICKNAME}, wenn wir Zeit haben, sollten wir in Zukunft öfter vorbeischauen und Pahsiv besuchen! Und wir sollten ihr mehr Wörter beibringen, so wie es „nur wie nett“ getan hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851922,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851923
					]
				},
				{
					"id": 740851923,
					"content": "Pahsiv, was meinst du? Wie wäre es, wenn wir dich in Zukunft wieder besuchen? Hä?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851924,
					"content": "Sie ist schon wieder verschwunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851925,
					"content": "Keine Spur, Pahsiv!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851926
					]
				},
				{
					"id": 740851926,
					"content": "Echt unglaublich! Paimon hat noch nie eine Melusine wie sie gesehen ... Oder man sollte sagen, sie ist gar nicht wie eine Melusine, sondern eher wie eine geheimnisvolle Wildfee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851927,
					"content": "Aber vielleicht ist das der Grund, warum sie heimlich das böse lila Ding im Auge behalten kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851928,
					"content": "He! Pahsiv! Bis dann! Wenn es ein nächstes Mal gibt, werden wir dir beibringen, wie man sich verabschiedet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
