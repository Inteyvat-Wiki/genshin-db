			"dialogs": [
				{
					"id": 740851001,
					"content": "Wurzel ... Wurzel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851002
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851002,
					"content": "Endlich sind wir da! Argh, hier gibt es so viele Unreinheiten ... Obwohl niemand hier zu sein scheint, findet Paimon, dass es hier eine Art vertrautes böses Gefühl gibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851003,
					"content": "Trauerweide ... Wurzel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851004
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851004,
					"content": "Sind das die Wurzeln des großen Baumes von vorhin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851005,
					"content": "Paimon versteht. Kein Wunder, dass der große Baum so wirkte, als wäre er verwelkt. Seine Wurzeln sind verdorben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851006,
					"content": "Wurzel ... Melusine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851007
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851007,
					"content": "#{NICKNAME}, beseitigen wir erst die Unreinheiten ... Paimon glaubt, dass sie die Wurzeln zerstören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
