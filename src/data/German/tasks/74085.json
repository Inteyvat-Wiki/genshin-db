			"dialogs": [
				{
					"id": 740850201,
					"content": "Schlüssel, Statue, Schlüssel, Statue, Schlüssel, Statue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850202
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850202,
					"content": "Ähm ... Meinst du etwa, dass die Schlüssel in die Statuen gesteckt werden sollen? So stimmt es genau, drei Schlüssel für drei Statuen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850203,
					"content": "Sollen wir es mal versuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850204,
					"content": "Was passiert, nachdem der Schlüssel hineingesteckt wird?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850205
					]
				},
				{
					"id": 740850205,
					"content": "Öffnen Tor, Tor öffnen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850206
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850206,
					"content": "Tor? Wo? Und was befindet sich hinter dem Tor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850207,
					"content": "Wurzel, Erinnyes, sehr tief ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850208
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850208,
					"content": "Das Tor führt zur Wurzel von Erinnyes?! Pahsiv, du ... du weißt wirklich eine Menge Sachen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850209,
					"content": "Pahsiv, schützen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850210
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850210,
					"content": "Gibt es noch etwas, was wir wissen müssen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850211
					]
				},
				{
					"id": 740850211,
					"content": "... Ah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850212
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850212,
					"content": "Nun, Nachrichten, Informationen. Je mehr, desto besser. Je mehr wir wissen, desto sicherer können wir sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850213,
					"content": "Infor...mationen? Infor...mationen ... Pahsiv! Informationen, sehr viel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850214
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850214,
					"content": "Sehr gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850215,
					"content": "Erinnyes, Informationen, sehr viel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850216
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850216,
					"content": "Ähm ... Es gibt viele Informationen, mhm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850217,
					"content": "Informationen, Wasseradern, sehr viel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850218
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850218,
					"content": "Ähm ... Es gibt viele Wasseradern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850219,
					"content": "Wasseradern, nur wie nett, sehr viel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850220
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850220,
					"content": "Mhm ... Hmm?! Nur wie nett, sehr viel?! Warte mal, Paimon versteht nicht ganz ... Du meinst, es gibt viele von dieser Person? Beherrscht sie etwa eine Doppelgänger-Magie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850221,
					"content": "Melusine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850222
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850222,
					"content": "Wasseradern, nur wie nett, schmecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850223
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850223,
					"content": "Böse, nur wie nett, spüren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850224
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850224,
					"content": "„Nur wie nett“ schmeckt das Böse in den Wasseradern? Was ist das für ein sonderbarer Geschmack ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850225,
					"content": "Diese Person kann die Informationen in den Wasseradern wahrnehmen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850226
					]
				},
				{
					"id": 740850226,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850227
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850227,
					"content": "Trauerweide, sammeln. Nebelpfad, erledigen. Quelle, senden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850228
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850228,
					"content": "Wurzel, Wasseradern, Zentrum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850229
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850229,
					"content": "Ist Erinnyes ein Informationszentrum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850230
					]
				},
				{
					"id": 740850230,
					"content": "Willst du sagen, dass ganz Erinnyes ein Informationszentrum dieser Person ist? Und sie kann dadurch böse Dinge wahrnehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850231,
					"content": "#Paimon schlau! {NICKNAME} schlau! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850232
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850232,
					"content": "Oha! Wer könnte „nur wie nett“ sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850233,
					"content": "Fontaine, nur wie nett, schützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850234
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850234,
					"content": "Aber, nur wie nett, sehr beschäftigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850235
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850235,
					"content": "Lila, Wurzel heimlich gehen. Lila, heimlich machen, Wurzel kaputt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850236
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850236,
					"content": "Pahsiv, heimlich schauen. Pahsiv, Steinplatte heimlich kratzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850237
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850237,
					"content": "Ah, du hast also die Worte von der Steinplatte weggekratzt! Sollte damit dieser Typ von seinen Taten abgehalten werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850238,
					"content": "Pahsiv! Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850239
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850239,
					"content": "Lila, immer noch Wurzel gehen. Lila, sehr stark.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850240
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850240,
					"content": "Hat er einen anderen Weg gefunden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850241
					]
				},
				{
					"id": 740850241,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850242
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850242,
					"content": "Mit diesem Typ ist anscheinend wirklich nicht gut Kirschen essen ... Wenn die Wurzel zerstört ist und das Informationssystem funktionsunfähig wird, wird das Wahrnehmungsvermögen von „nur wie nett“ beeinträchtigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850243,
					"content": "Pahsiv, Verantwortung! Pahsiv, schützen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850244
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850244,
					"content": "#{NICKNAME}, hellen. Paimon, hellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850245
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850245,
					"content": "#{NICKNAME}, wir dürfen nicht länger warten! Wir müssen ihr sofort hellen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850246,
					"content": "Pahsiv! Mach jetzt das Tor auf!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850247
					]
				},
				{
					"id": 740850247,
					"content": "Super! Es ist Zeit, aufzubrechen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
