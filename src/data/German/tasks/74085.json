					"nextDialogs": [
						740851203
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851203,
					"content": "Pahsiv streckt die Hand aus und bedeckt deinen Bauch. Wärme strömt aus ihrer Handfläche.\\nDu spürst, dass eine Fähigkeit von dir verstärkt wird.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740851204
					]
				},
				{
					"id": 740851204,
					"content": "Pahsiv, müde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851205
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851205,
					"content": "#Hm? Was hat Pahsiv getan? {NICKNAME}, du siehst erfrischt und voller Energie aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
