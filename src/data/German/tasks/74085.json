			"dialogs": [
				{
					"id": 740851701,
					"content": "#Puh ... Endlich haben wir sie besiegt. Wir haben buchstäblich ins Garmnest gestochen. {NICKNAME}, geht es dir gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851702,
						740851703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851702,
					"content": "Ich kann immer noch einen ganzen Tag kämpfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851704
					]
				},
				{
					"id": 740851704,
					"content": "Hehe, Paimon findet, dass du überhaupt nicht übertreibst! Nun, die Wurzel ist anscheinend dabei, sich zu erholen. Die Probleme hier sollten also gelöst sein, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851705,
					"content": "Aber was ist gerade passiert? Warum kommt eine Drachenechse zur Hilfe und wo ist Pahsiv hin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851706,
					"content": "Hallo! Pahsiv! Bist du da? Kannst du Paimon hören?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851707,
					"content": "Na gut, sie scheint wirklich weg zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851708,
					"content": "Sie trägt viele Geheimnisse mit sich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851709
					]
				},
				{
					"id": 740851709,
					"content": "Hm ... Was für eine geheimnisvolle Melusine. Obwohl wir keine Belohnung wollten, kommt es Paimon doch etwas seltsam vor, dass sie einfach verschwunden ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851710,
					"content": "Warum ist es seltsam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851711
					]
				},
				{
					"id": 740851711,
					"content": "Es ist ... wie bei einem Gericht, das du immer geliebt hast, und eines Tages sagt es dir plötzlich, „Unsere Beziehung ist vorbei“, genauso seltsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851712,
						740851713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851712,
					"content": "Oh, das ist sehr traurig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851714
					]
				},
				{
					"id": 740851714,
					"content": "So fühlt es sich jedenfalls an. Aber könnte es sein, dass Pahsiv verletzt ist? Sie sah gerade so müde aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851715,
					"content": "Wir sehen uns ein wenig um.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851716
					]
				},
				{
					"id": 740851716,
					"content": "Ja! Paimon stimmt zu, dass wir nach ihr suchen sollten. Es wäre schlimm, wenn sie wirklich allein in Schwierigkeiten steckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851717,
					"content": "Warte mal ... Was ist los?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851718,
					"content": "Gerade als ihr in der Nähe nach Pahsiv sucht, strömt Wasser in die Höhle. Sofort werdet ihr von der Strömung mitgerissen.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 740851713,
					"content": "Es ist schon seltsam, dass ein Gericht sprechen kann, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851714
					]
				},
				{
					"id": 740851703,
					"content": "Meine Hände tun mir nur ein bisschen weh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851718
					]
				}
			]
		},
