			"dialogs": [
				{
					"id": 766550101,
					"content": "Flins! Du bist auch gekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766550102,
					"content": "Ich muss mich immerhin bei euch beiden bedanken. Nach der Wartung sieht der Leuchtturm jetzt viel besser aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550103,
					"content": "Ach, kein Problem. Aber egal, wie sehr wir uns auch um den Leuchtturm kümmern, es ist immer noch so dunkel hier und es gibt weiterhin Bereiche, die der Leuchtturm nicht erreichen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766550104,
					"content": "Ja. Anders als draußen, scheint die Zeit auf dem Friedhof stehengeblieben zu sein – in der Nacht, in der der Kampf endete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550105,
					"content": "Ich hatte eigentlich nicht vor, die Umgebung hier zu verändern, aber ihr habt das Licht des Leuchtturms entzündet und somit den Lauf der Zeit vorangetrieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550106,
						766550108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550106,
					"content": "Wird das dein Leben beeinflussen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550107
					]
				},
				{
					"id": 766550107,
					"content": "Falls deine Frage ist, ob mir dies Unannehmlichkeiten bereitet, kann ich entschieden mit Nein antworten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550110,
					"content": "Das Leben verläuft in Zyklen. Selbst ohne uns würden die Geister dieser Insel nach und nach vergehen und in den Fluss der Elemente zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550111
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550111,
					"content": "Macht euch also keine Sorgen, dass der Leuchtturm die Insel nicht vollständig erleuchten kann. Mit dem Verschwinden der Geister wird auch der Nebel, der diesen Ort umhüllt, verblassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550112
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550112,
					"content": "Irgendwann wird die Sonne aufgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550108,
					"content": "Tut uns leid, war nicht mit Absicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550109
					]
				},
				{
					"id": 766550109,
					"content": "Kein Grund, sich zu entschuldigen. Ich bin solchen Veränderungen nicht abgeneigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "Flins"
				}
			]
		}
	]
