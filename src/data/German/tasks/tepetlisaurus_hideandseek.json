			"dialogs": [
				{
					"id": 750250101,
					"content": "Wah, was ist das für ein geheimnisvoller Ort? So viele kleine Tepetlisaurier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250102,
					"content": "Ist das etwa ein ... Treffpunkt für Tepetlisaurier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250103,
					"content": "*brüll*! ... *brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250104
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250104,
					"content": "#Es ist selten, dass man so viele von seiner Art trifft. {REALNAME[ID(2)|SHOWHOST(true)]} sieht auch ganz aufgeregt aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250105,
					"content": "*brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250106
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250106,
					"content": "#Oh, willst du dort mit ihnen spielen? Hm, {NICKNAME}, wenn Paimon darüber nachdenkt, hat {REALNAME[ID(2)|SHOWHOST(true)]} wirklich selten mit anderen kleinen Tepetlisaurier Kontakt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250107,
						750250108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250107,
					"content": "Pass auf dich auf, ja!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250109
					]
				},
				{
					"id": 750250109,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250110,
					"content": "#Auch wenn Paimon sich etwas Sorgen macht, suchen wir uns jetzt einen Platz zum Hinsetzen, essen etwas und reden, während wir auf {REALNAME[ID(2)|SHOWHOST(true)]} warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250111,
					"content": "#Du und Paimon findet in der Nähe einen schönen Rastplatz und wartet, bis {REALNAME[ID(2)|SHOWHOST(true)]} vom Spielen zurückkommt.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750250112
					]
				},
				{
					"id": 750250112,
					"content": "Doch die Wartezeit zieht sich etwas hin ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750250113
					]
				},
				{
					"id": 750250113,
					"content": "#... Hm, warum ist {REALNAME[ID(2)|SHOWHOST(true)]} denn immer noch nicht zurück?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250114,
					"content": "Es wird doch wohl nichts passiert sein ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250115,
					"content": "Vielleicht haben sie zu ausgelassen gespielt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250116
					]
				},
				{
					"id": 750250116,
					"content": "Wenn das stimmt, müssen wir ihm ins Gewissen reden, immerhin wird es schon dunkel und er ist noch nicht zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250117,
					"content": "Hm ... Los, lass uns nach ihm suchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250108,
					"content": "Bleib nich zu lang weg!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250109
					]
				}
			]
		},
