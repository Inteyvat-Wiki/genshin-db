				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710890101,
					"content": "Ooh, das ist ein wirklich langer Brief. Sieht aus, als hätte Zhiqiong ihn hier vergessen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710890102,
					"content": "Er gehört ihr, ja ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890103
					]
				},
				{
					"id": 710890103,
					"content": "Uff, wo ist sie hin!? Lass uns erst Jinwu erzählen, was passiert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7108902,
			"completionStepIds": [
				7108903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108903",
							"2"
						],
						"stepId": 7108903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710890201,
					"content": "Jinwu, wir haben dies gefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710890202,
					"content": "Schon gut, schon gut, entspann dich. Was hast du gefunden? Hat es etwas mit dem Aufenthaltsort von Zhiqiong zu tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890203
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890203,
					"content": "Es ist ein Brief, den sie zurückgelassen hat. Sie sagt, dass sie tiefer in den Abgrund gegangen ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890204
					]
				},
				{
					"id": 710890204,
					"content": "... Vielen Dank. Lass mich schnell sehen, was sie geschrieben hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890205
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890205,
					"content": "Jinwu liest den Brief sorgfältig.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710890206
					]
				},
				{
					"id": 710890206,
					"content": "Dieses Mädchen ... Ich habe mich noch nie mit so großen Problemen beschäftigt, also kann ich ihre Lebensentscheidungen nicht wirklich kritisieren. Aber vielleicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890207
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890207,
					"content": "Vielleicht habe ich ihre Entdeckungen nicht rechtzeitig wahrgenommen oder ihr nicht so viel Respekt und Verständnis entgegengebracht, wie ich es hätte tun sollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890208
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890208,
					"content": "Es wäre unermesslich schwieriger gewesen, unsere Erkundung ohne ihre Karten abzuschließen ... Aber ich machte mir nur Sorgen um ihre Gesundheit, anstatt mich auf ihre harte Arbeit zu konzentrieren und auf das, wofür sie so viel getan hatte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890209
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890209,
					"content": "Ach, wie konnte ich nur übersehen, dass ihre Arbeit immer anders war als die von uns Bergleuten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890210
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890210,
					"content": "Sie will einfach nicht vergessen werden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890211
					]
				},
				{
					"id": 710890211,
					"content": "Tun wir das nicht alle, die nicht von den Göttern begünstigt sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890212
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890212,
					"content": "Tun wir das nicht alle ... Aber war schon mal jemand so besessen wie sie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890213
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890213,
					"content": "Und doch, wenn ich an den Moment denke, in dem ich jeden Gedanken daran aufgegeben habe, großartig zu werden ... wenn ich merke, dass ich mich zu sehr an den Alltag gewöhnt habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890214
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890214,
					"content": "Ich habe das Gefühl, dass ich nicht das Recht habe, über Zhiqiong zu urteilen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		}
	]
}