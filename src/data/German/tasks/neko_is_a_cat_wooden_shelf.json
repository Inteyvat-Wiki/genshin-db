			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Taisuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090201,
					"content": "Das Gebetsregal sieht so aus, als wäre es seit sehr langer Zeit kaputt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090202
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090202,
					"content": "Was machst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090203
					]
				},
				{
					"id": 722090203,
					"content": "#Oh, hallo, {F#Reisende}{M#Reisender}. Frau Etsuko und ich untersuchen gerade den Bereich um diesen Schrein herum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090204
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090204,
					"content": "Auch wenn die verschiedenen Einrichtungen des Schreins schon vor langer Zeit verfallen sind ... verfügt der Schrein noch immer über sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090205
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090205,
					"content": "Menschen aus Dörfern in der Nähe müssen alle zu diesem Ort gekommen sein, um ihren Respekt zu zollen. Ich vermute, dass die Ruine etwas mit dem verlassenen Dorf Koseki zu tun hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				}
			]
		},
		{
			"id": 7220903,
			"completionStepIds": [
				7220904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220904",
							"2"
						],
						"stepId": 7220904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Neko“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090301,
					"content": "Miau, miau, miau ... Das Holzregal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090302
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090302,
					"content": "Ich habe es repariert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090303
					]
				},
				{
					"id": 722090303,
					"content": "Oho! Hast du das also? Ah, dieser Schrein sieht jetzt noch mehr nach einem aus! Miau, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090304
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090304,
					"content": "Nun, dann geh und erzähle den zwei grünen Menschen, dass das Regal repariert wurde und dass sie jetzt Holzblöcke daran hängen können. Und während sie das tun, können sie einige andere Leute mitbringen und beten und das Kästchen mit Mora füllen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090305
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090305,
					"content": "Wirst du es ihnen nicht selbst sagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090306
					]
				},
				{
					"id": 722090306,
					"content": "Nein! D... Dieser grüne, große Mensch ist sehr furchterregend. E... Er kann die Gedanken von Katzen lesen ... Meine Verkleidung kann seinen scharfen Augen nicht standhalten! Miau, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090307
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090307,
					"content": "Ganz zu schweigen davon, dass ich jedes Mal viel zu aufgeregt bin, wenn er mit mir spricht ... Miau, miau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				}
			]
		},
		{
			"id": 7220904,
			"completionStepIds": [
				7220905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220905",
							"2"
						],
						"stepId": 7220905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Taisuke",
					"Etsuko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090401,
					"content": "#Hallo, {F#Reisende}{M#Reisender}. Was kann ich für dich tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090402
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090402,
					"content": "Das Gebetsregal wurde repariert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090403
					]
				},
				{
					"id": 722090403,
					"content": "Wurde es? Du hast es repariert? Du bist eine gütige Seele, nicht wahr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090404
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090404,
					"content": "Ich wurde von der übergangsmäßigen Oberpriesterin beauftragt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090405
					]
				},
				{
					"id": 722090405,
					"content": "N... Neko hat dich dazu beauftragt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090406
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090406,
					"content": "Sind ihr unsere Handlungen also aufgefallen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090407,
						722090408
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090407,
					"content": "Würde ich nicht so ganz sagen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090409
					]
				},
				{
					"id": 722090409,
					"content": "Fräulein Etsuko! Gehen wir rüber zum Gebetsregal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090410
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090410,
					"content": "Zuerst das Spendenkästchen, nun das Gebetsregal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090411
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090411,
					"content": "Die übergangsmäßige Oberpriesterin meint es wirklich ernst damit, den Schrein zu reparieren, oder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090412
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090412,
					"content": "Aber die Einwohner dieser Regionen sind alle vor Langem ausgewandert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090413
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090413,
					"content": "Kurz gesagt, keiner auf dieser Insel kommt zu dem Schrein, um seinen Respekt zu zollen außer uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090414
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090414,
					"content": "Was versuchst du da zu sagen, Fräulein Etsuko?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090415
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090415,
					"content": "... Hat die vorläufige Oberpriesterin das schon festgestellt? Welches Motiv hat sie, um den Schrein zu reparieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090416
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090416,
					"content": "... Schon gut. Vielleicht spricht hier nur mein Verdacht aus mir. Wir können hinüber zu dem Gebetsregal gehen, kein Problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090417
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090417,
					"content": "Aber ich würde sagen, dass Wachehalten die richtige Wahl bleibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090418
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090418,
					"content": "Fräulein Etsuko, Frau Neko ist nur eine Katze ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090408,
					"content": "Das kann man so sagen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090409
					]
				}
			]
		},
		{
			"id": 7220905,
