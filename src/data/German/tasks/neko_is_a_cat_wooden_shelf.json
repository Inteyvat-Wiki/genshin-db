				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"„Neko“",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090101,
					"content": "Ein weiterer ruhiger Tag heute ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090102
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090102,
					"content": "Ah, du bist also angekommen. Ich habe letzte Nacht sehr gut geschlafen, nachdem du den Schrein gesäubert hast ... miau, miau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090103
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090103,
					"content": "Diese zwei Leute in Grün kamen gestern auch auf einen Spaziergang vorbei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090104
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090104,
					"content": "Abgesehen von ihnen kamen keine anderen Menschen, um ihren Respekt hier zu zollen. Sehr seltsam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090105
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090105,
					"content": "Aber als diese zwei grünen Menschen vorbeikamen, schienen sie recht interessiert an dem Holzregal dort, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090106
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090106,
					"content": "Ich erinnere mich daran, wie Hibiki das Regal selbst ein „Holzpferd“ nannte. Und diese kleinen Holzblöcke „Holzpferdregale“. Es schien, als wären viele Menschen ihretwegen zum Schrein gekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090107
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090107,
					"content": "Hmm ... Heißt das, dass Menschen Holz lieben? Es ist wahr, dass viele Besucher zu diesem Holzregal gegangen sind, um kleine Holzblöcke aufzuhängen, nachdem sie einige Mora gespendet hatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090108
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090108,
					"content": "Ich denke nicht, dass es um das Holz geht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090109
					]
				},
				{
					"id": 722090109,
					"content": "Ist das so? Haben sie es dann gemacht, weil sie Pferde lieben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090110,
						722090111
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090110,
					"content": "Was soll denn das heißen? Pferde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090112
					]
				},
				{
					"id": 722090112,
					"content": "Was auch immer der Fall sein sollte, das Regal ist kaputt und die Holzblöcke sind tatsächlich weniger geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090113
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090113,
					"content": "Ich weiß nicht, was Menschen mit Holz oder Pferden wollen, aber ein Schrein braucht das dann auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090114
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090114,
					"content": "Es muss daran liegen, dass das Regal kaputt ist, dass niemand mehr kommt. Das Holz oben ist weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090115
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090115,
					"content": "Daher muss ich euch um noch etwas bitten, nämlich das Holzregal zu reparieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090116,
						722090121
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090116,
					"content": "Na ja, überlass das uns.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090117
					]
				},
				{
					"id": 722090117,
					"content": "Jetzt, da du es erwähnst: Wir sollten etwas Material übrig haben vom Reparieren des Spendenkästchens, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090118,
					"content": "Bei solchen Dingen kann ich mir nicht ganz sicher sein ... Warum liebt ihr Menschen überhaupt Holz so sehr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090119
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090119,
					"content": "Ah, weißt du was, vergiss es ... Paimon erinnert sich daran, dass wir einige übrig haben. Suchen wir ein bisschen herum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090120,
					"content": "Wie auch immer, ich werde die Angelegenheit mit dem Holzregal dir überlassen. Der Schrein kann sich ja schließlich nicht um sich selbst kümmern, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090129
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090129,
					"content": "Sobald die Kiste und das Regal repariert sind, sollten mehr Betende hierherkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090121,
					"content": "Wie lange verfällt dieses Ding schon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090122
					]
				},
				{
					"id": 722090122,
					"content": "Sehr lang. Es ist auseinandergefallen, bevor das Kästchen auseinandergefallen ist. Und das Kästchen ist vor Jahren auseinandergefallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090123
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090123,
					"content": "Also weißt du es gar nicht, oder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090124,
					"content": "Ha! Ich achte nicht so genau darauf, wie oft die Sonne auf- oder untergeht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090125
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090125,
					"content": "Na ja, wir sollten ein paar Dinge übrig haben von der Reparatur des Spendenkästchens, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090126,
					"content": "Bei solchen Dingen kann ich mir nicht ganz sicher sein ... Warum liebt ihr Menschen überhaupt Holz so sehr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090127
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090127,
					"content": "Ah, weißt du was, vergiss es ... Paimon erinnert sich daran, dass wir einige übrig haben. Suchen wir ein bisschen herum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090128,
					"content": "Wie auch immer, ich werde die Angelegenheit mit dem Holzregal dir überlassen. Der Schrein kann sich ja schließlich nicht um sich selbst kümmern, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090129
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090111,
					"content": "Ich glaube, dass es auch damit nichts zu tun hat ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090112
					]
				}
			]
		},
		{
			"id": 7220902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
