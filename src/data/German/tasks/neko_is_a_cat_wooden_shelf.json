			},
			"dialogs": [
				{
					"id": 722090601,
					"content": "Ich habe gesehen, dass diese zwei grünen Menschen Vorbereitungen treffen, Holzpferde aufzustellen. Ihr seid wirklich ein verlässliches Paar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090602
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090602,
					"content": "Na ja, sobald sie fertig sind, werden sie – da bin ich mir sicher – andere Menschen informieren, welche diesen Schrein besuchen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090603
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090603,
					"content": "Miau, miau, miau ... Es scheint, als wäre, neben der „Säuberung“ und der Reparatur dieser Kiste das Gebetsregal auch sehr wichtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090604
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090604,
					"content": "Gut, sehr gut. Miau, miau, miau! Wenn es so weitergeht, wird der Schrein sicherlich bald zu seiner alten Lebendigkeit zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090605
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090605,
					"content": "Warum willst du den Schrein überhaupt restaurieren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090606
					]
				},
				{
					"id": 722090606,
					"content": "Miau, miau ... Ja, warum nur ... Ich bin schließlich die vorläufige Oberpriesterin. Es ist meine Pflicht, für den Schrein zu sorgen, damit viele Leute hier Respekt zollen, um diesen Schrein in einen lebhaften Ort zu verwandeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090607
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090607,
					"content": "Und Hibiki wäre auch ganz traurig, sollte sie zurückkehren und den Schrein ganz heruntergekommen vorfinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090608
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090608,
					"content": "Miau, miau, aber mit deiner Hilfe, wird er sicher in kürzester Zeit zu seiner ehemaligen Pracht zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090609
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722090609,
					"content": "Ich benötige vielleicht noch von Zeit zu Zeit deine Hilfe, miau. Lehne nicht ab, wenn die Zeit gekommen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				}
			]
		},
