				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090501,
					"content": "Gute Arbeit bei der Reparatur des Gebetsregals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090502,
						722090503
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090502,
					"content": "Danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090504
					]
				},
				{
					"id": 722090504,
					"content": "Aber die Gebetstafeln ... Man kann überhaupt nicht sehen, was auf ihnen steht. Wie lange ist es her, dass ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090505
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090505,
					"content": "Fräulein Etsuko! Ich habe einige Holzbretter in der Nähe gefunden und ich, äh, habe uns einige Gebetstafeln geschnitzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090506
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090506,
					"content": "Nachdem das Gebetsregal repariert wurde, braucht es schließlich einige Gebetstafeln, die daran hängen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090507
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090507,
					"content": "Hast du irgendwelche Wünsche, Fräulein Etsuko? Ich kann sie für dich aufmalen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090508
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090508,
					"content": "Eine Gebetstafel bei diesem Schrein aufzuhängen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090509
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090509,
					"content": "Hehe, was für ein interessanter Gedanke. Gib mir eine dieser Tafeln, ich werde mich selbst um das Bemalen kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090510
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090510,
					"content": "Na ja, sieht so aus, als bereiteten sie es vor, einige Gebetstafeln aufzuhängen, hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090511,
					"content": "Na, los, wir erzählen es Neko. Sie wird es sicherlich mögen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090503,
					"content": "Ich kenne den ein oder anderen Trick.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090504
					]
				}
			]
		},
