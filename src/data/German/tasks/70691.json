			"dialogs": [
				{
					"id": 706910101,
					"content": "#Ehrenritter{F#in}! Hier, hier drüben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910102,
					"content": "Klee hat einige neue Freunde gefunden! Willst du mit uns spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910103,
					"content": "Sie haben uns ein neues Spiel namens „Schneeflucht“ beigebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910104,
					"content": "Die Regeln sind nicht schwer. Es ist nur eine besondere Art von Versteckspiel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910105,
					"content": "Oh! Klee, Yaoyao und Sayu, ihr seid jetzt Freunde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910106,
					"content": "Wenn man nach dem Namen des Spiels geht, klingt es wie eine alternative Version von „Windflucht“! Zusammen mit euch zu spielen wird bestimmt super lustig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910107,
						706910108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910107,
					"content": "Versteckspiel! Klingt toll!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				},
				{
					"id": 706910109,
					"content": "Hatschi ... Auch wenn es im Lager nicht mehr so kalt ist, werde ich trotzdem ein bisschen schläfrig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910110
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910110,
					"content": "#Hm? Halluziniere ich etwa? Oder habe ich {NICKNAME} und Paimon gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910111
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910111,
					"content": "#Mit deinen Augen ist alles in Ordnung. {NICKNAME} und Paimon sind wirklich hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910112,
						706910113
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910112,
					"content": "Hallo, Yaoyao und Sayu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910114,
					"content": "Einfach losspielen und Spaß haben! Dann wird auch keiner mehr müde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910115,
					"content": "Hat diese super ernste Aoi nicht sogar gesagt, dass es für deine Fähigkeiten gut wäre, wenn du öfter in den verschneiten Bergen unterwegs wärst, Sayu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910116
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910116,
					"content": "Uff, ich kann nicht glauben, dass ihr euch daran erinnert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910117
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910117,
					"content": "Na gut ... Wenn ich gegen meine Kollegen verliere, oder schlimmer noch, gegen den Super-Ninken ... dann erwischen sie mich in der Zukunft garantiert jedes Mal beim Faulenzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910118
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910118,
					"content": "Sieht so aus, als müsste ich diese Trainingsreise wohl wirklich ernst nehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910119
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910119,
					"content": "Keine Sorge! Ich habe ein neues Gemüse-Schmorgericht gemacht, mit Jueyun-Peperoni und einer guten Prise Pfefferpulver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910120
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910120,
					"content": "Iss vorher ein paar Bissen, dann frierst du beim ganzen Versteckspiel nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910121
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910121,
					"content": "Super! Dann esse ich gleich eine ganze Schüssel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910122
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910122,
					"content": "Paimon will auch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910123,
					"content": "Also: das Versteckspiel in den Schneebergen startet jetzt gleich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910124
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910124,
					"content": "Juhu! Überall nur Weiß hier im Schneegebirge, wenn Paimon sich versteckt, findet Paimon bestimmt keiner so schnell!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910113,
					"content": "Wollt ihr mit uns Verstecken spielen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910108,
					"content": "Lass mich auch Klees neue Freunde kennenlernen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				}
			]
		}
	]
}