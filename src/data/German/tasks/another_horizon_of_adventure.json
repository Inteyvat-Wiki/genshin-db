					"nextDialogs": [
						746670205
					]
				},
				{
					"id": 746670205,
					"content": "Gibt es etwas, bei dem ich euch helfen kann? Möchtet ihr einen Auftrag annehmen oder platzieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746670206
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 746670206,
					"content": "Ich wollte nur kurz vorbeischauen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746670207
					]
				},
				{
					"id": 746670207,
					"content": "Gut ... Wenn ihr irgendwelche Fragen über die Gilde habt, könnt ihr gerne zu mir kommen.",
