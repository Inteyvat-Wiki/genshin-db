					"nextDialogs": [
						746670208
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 746670208,
					"content": "Ich werde dir gern den bestmöglichen Dienst bieten und alle Fragen beantworten, die ich beantworten kann.",
