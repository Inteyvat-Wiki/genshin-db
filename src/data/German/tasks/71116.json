						],
						"pointId": 311500175
					}
				]
			},
			"dialogs": [
				{
					"id": 711160801,
					"content": "#Der Weg hat sich wirklich gelohnt! Wer hätte gedacht, dass uns ein so dicker Fisch ins Netz geht und wir obendrein {F#die berühmte Reisende}{M#den berühmten Reisenden} treffen würden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160802
					],
					"speakerTitle": "Eiserner Chuan’er"
				},
				{
					"id": 711160802,
					"content": "Ihr kennt uns!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160803
					]
				},
				{
					"id": 711160803,
					"content": "#Selbstverständlich, {F#Reisende}{M#Reisender}, ich habe Verwandte, die im Hafen von Liyue leben und schon viel von euren Geschichten gehört. Deswegen habe ich euch gleich erkannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160804
					],
					"speakerTitle": "Eiserner Dou’er"
				},
				{
					"id": 711160804,
					"content": "Es waren damals nur zu viele Leute dabei und ich wollte mich nicht verplappern und sie entwischen lassen. Darum habe ich es nicht erklärt. Entschuldigt bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160805
					],
					"speakerTitle": "Eiserner Dou’er"
				},
				{
					"id": 711160805,
					"content": "Wir sind also nicht in einen illegalen Handel zwischen Banden geplatzt, sondern in eine Operation der Millelithen, um Verbrecher festzunehmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160806,
					"content": "Haha, stimmt. Wir haben diese illegalen Salzschmuggler schon eine ganze Weile beobachtet. Erst kürzlich erhielten wir zufällig Hilfe, sodass wir in die inneren Kreise vordringen konnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160807
					],
					"speakerTitle": "Eiserner Chuan’er"
				},
				{
					"id": 711160807,
					"content": "Nach mehr als einem Monat Wartezeit haben wir heute endlich die Gelegenheit ergriffen, die Eisensalzbande und den dicken Fisch aus Fontaine mit einem Schlag zu fangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160808
					],
					"speakerTitle": "Eiserner Chuan’er"
				},
				{
					"id": 711160808,
					"content": "#Kaum zu fassen, beinahe wären wir im Wasser ertränkt worden. Dieser Kerl geht wirklich völlig skrupellos vor, welch ein Glück, dass {F#die Reisende}{M#der Reisende} zu Hilfe kam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160809
					],
					"speakerTitle": "Eiserner Dou’er"
				},
				{
					"id": 711160809,
					"content": "#So oder so, {F#Reisende}{M#Reisender}, ich habe euch ein Festessen versprochen, das ich wohl nicht einlösen kann. Aber dafür gebe ich euch hiermit einige Mora. Bitte nehmt sie an euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160810
					],
					"speakerTitle": "Eiserner Dou’er"
				},
				{
					"id": 711160810,
					"content": "Kein Grund, bescheiden zu sein, ihr zwei. Wer anderen hilft, hat eine Belohnung verdient. Wir alle sollten uns an unseren Vertrag halten, ansonsten wird es immer weniger Menschen geben, die sich hilfsbereit erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160811
					],
					"speakerTitle": "Eiserner Dou’er"
				},
				{
					"id": 711160811,
					"content": "Na gut, wir müssen uns auch noch um andere Dinge kümmern, also wollen wir nicht noch mehr von eurer Zeit stehlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160812
					],
					"speakerTitle": "Eiserner Chuan’er"
				},
				{
					"id": 711160812,
					"content": "... Ich wünsche euch weiterhin gutes Gelingen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eiserner Chuan’er"
				}
			]
		},
		{
			"id": 7111651,
