			"dialogs": [
				{
					"id": 711160401,
					"content": "Johnnie, wir sind doch Freunde. Ich weiß, dass du in letzter Zeit viel durchgemacht hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160402
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160402,
					"content": "Wenn es ein Problem gibt, dann rede mit mir darüber. Andernfalls sorgt es doch nur ... für Verstimmungen, meinst du nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160403
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160403,
					"content": "He, weißt du, unser Geschäft läuft anders als sonst. Die Spina di Rosula hat in letzter Zeit Oberwasser bekommen und einige unserer Brüder bekommen kalte Füße und sehen ihre Felle davonschwimmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160404
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160404,
					"content": "Die „Vögelchen“ rufen jetzt schon jammervoll nach Essen. Wenn das so weitergeht, werden sie bald gar nichts mehr zu beißen haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160405
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160405,
					"content": "Unser Geschäft läuft prächtig. Das ist nur vernünftig. Wenn ihr uns aber etwas mehr abgebt ... werdet ihr in Zukunft viele Gelegenheiten haben, unsere Dankbarkeit zu erfahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160406
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160406,
					"content": "Andernfalls ... haha, Eiserner Ming, ihr solltet nicht alle Eier in einen Korb legen. Es dürfte für euch nicht schwierig sein, neue Freunde zu finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160407
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160407,
					"content": "Nun, das ist also der Preis, den du verlangst, Johnnie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160408
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160408,
					"content": "Hast du mit diesem Preis irgendein Problem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160409
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160409,
					"content": "Du Windbeutel aus Fontaine! Sag direkt, was du vorhast! Wen willst du mit so wenig Mora über den Tisch ziehen!? Mach nicht so viel heiße Luft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160410
					],
					"speakerTitle": "Eiserner Chuan’er"
				},
				{
					"id": 711160410,
					"content": "Halt die Schnauze, du!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160411
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160411,
					"content": "Johnnie, wenn ich meine Waren an den Klan Don Pesci verkaufe, bekomme ich für eine Kiste achtundfünfzigtausend. Verkaufe ich sie an den Klan De Niro, bekomme ich siebzigtausend. Beide sind namhafte Syndikate der Halbwelt am Lumidouce-Hafen, das muss ich dir nicht sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160412
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160412,
					"content": "Wenn ich meine Waren an dich verkaufe, bekommst du drei Kisten für nur zehntausend und das frei Haus ... Und warum? Weil ich dich als Freund schätze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160413
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160413,
					"content": "Ich will nicht weiter große Reden schwingen ... Bestimmt möchte Johnnie noch ein wenig nachdenken! Lass uns irgendwo etwas trinken gehen, dann besprechen wir es noch einmal, was meinst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160414
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160414,
					"content": "Hehe, nicht nötig. Ich weiß, dass die Leute aus Liyue viel Wert auf Verträge legen und diese Verträge sollen in erster Linie gerecht sein. Aber ich habe noch nie gehört, dass persönliche Neigungen über der Gerechtigkeit stehen sollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160415
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160415,
					"content": "Hehe, Johnnie! So viel Gewicht auf den Geist der Verträge zu legen ... meine Jungs können sich von dir ein Scheibchen abschneiden, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160416
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160416,
					"content": "Allerdings möchte ich in dieser Angelegenheit erst einmal sehen, wie viel Achtung ihr dem Vertrag entgegenbringt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160417
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160417,
					"content": "Aber natürlich! Was du sagst, ist vollkommen richtig. Die altehrwürdigen Verträge Liyues verdienen wirklich höchste Wertschätzung. Ich sollte wohl etwas mehr Respekt zeigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160418
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160418,
					"content": "Walker, denkst du, man könnte den Preis für jede Ware um ... eine Mora erhöhen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160419
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160419,
					"content": "Das ist mehr als angemessen, Herr Johnnie. Diese Leute aus Liyue müssen sich so abrackern, da ist es nur recht und billig, wenn sie noch zusätzlich eine Mora für jede Warensendung verdienen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160420
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160420,
					"content": "Ihr Dampfplauderer aus Fontaine! Wovon redet ihr eigentlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160421
					],
					"speakerTitle": "Eiserner Chuan’er"
				},
				{
					"id": 711160421,
					"content": "Freunde, ihr habt noch nicht gemerkt, wie entgegenkommend wir sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160422
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160422,
					"content": "Johnnie, seid ihr wirklich entschlossen, die Vereinbarung zu brechen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160423
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160423,
					"content": "Hm? Wirklich? Walker, glaubst du, dass es so ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160424
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160424,
					"content": "Herr Johnnie, wenn du mich fragst ... Das Meer ist so groß und weit, das sollte eine kleine Garnele doch auch wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160425
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160425,
					"content": "Walker, ich schäme mich für dich. Wie kannst du unseren Freund aus Liyue so vor den Kopf stoßen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160426
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160426,
					"content": "Schließlich werden wir eines Tages ihre Jagdgründe übernehmen. Sollten wir da nicht etwas taktvoller und dankbarer sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160427
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160427,
					"content": "Es tut mir leid, Herr Johnnie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160428
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160428,
					"content": "Ihr Hohlbratzen! Ich kann nicht glauben, dass ihr auf diese Idee gekommen seid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160429
					],
					"speakerTitle": "Eiserner Chuan’er"
				},
				{
					"id": 711160429,
					"content": "Warum fluchst du wie ein Seemann?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160430
					]
				},
				{
					"id": 711160430,
					"content": "Hä? Wer seid ihr beide denn ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160431
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160431,
					"content": "Hehe, riskieren eigentlich alle Kinder aus Liyue gern eine dicke Lippe? Walker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160432
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160432,
					"content": "He! Was wollt ihr Wichtel überhaupt!? Ich geb euch ein paar Mora, geht euch eine Milchflasche mit Schnuller kaufen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160433
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160433,
					"content": "Ihr! Habt ihr denn überhaupt keinen Anstand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160434,
					"content": "Wer seid ihr zwei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160435,
						711160436
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160435,
					"content": "Wir sind hier, um ein Festmahl abzustauben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				},
				{
					"id": 711160437,
					"content": "Hahahaha! Wenn du so redest ... hat Eiserner Ming euch geschickt, um zu helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160438
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160438,
					"content": "Eiserner Ming hatte also auch schon etwas mit uns vor!? Hmpf, wir sind nicht völlig unvorbereitet. Walker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160439
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160439,
					"content": "Auf geht’s, Brüder! Es ist an der Zeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160440
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160440,
					"content": "Was!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160441
					],
					"speakerTitle": "Eiserner Chuan’er"
				},
				{
					"id": 711160441,
					"content": "Oh weh! Was ist denn hier los? Anscheinend sind unsere Leute doch in der Überzahl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160442
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160442,
					"content": "Eiserner Ming, es tut mir leid, ich habe zuvor meinen Untergebenen einige Arbeiten aufgetragen. Die Leute, die du im Lager zurückgelassen hast, sollten inzwischen schon ausgeschaltet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160443
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160443,
					"content": "Du kannst dich unbesorgt von uns verabschieden. Wir kümmern uns um dein Geschäft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160444
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160444,
					"content": "Johnnie ... Du willst die Mora unserer Eisensalzbande einsacken ... So einfach wird das nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160445
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160445,
					"content": "Dann solltest du deinen Worten auch Taten folgen lassen, auf geht’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160436,
					"content": "Wir sind hier, um gewisse Leute nach Hause zu bringen, damit sie ihre Nuckelflasche bekommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				}
			]
		},
