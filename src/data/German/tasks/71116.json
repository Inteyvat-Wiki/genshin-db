						],
						"pointId": 311500088
					}
				]
			},
			"dialogs": [
				{
					"id": 711160202,
					"content": "Liebe Freunde und Weggefährten, ich weiß nicht, wie ich euch dafür danken soll. Wenn ihr jemals etwas brauchst, braucht ihr mich nur zu fragen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160203
					],
					"speakerTitle": "Eiserner Dou’er"
				},
				{
					"id": 711160203,
					"content": "Oh! Du bist ja höflich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160204,
						711160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160204,
					"content": "Mal unter uns: Ich bin aktuell echt ohne Mora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160205
					]
				},
				{
					"id": 711160205,
					"content": "Du brauchst Mora? Haha, das ist kein Problem, aber es könnte ein klein wenig anstrengend werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160206
					],
					"speakerTitle": "Eiserner Dou’er"
				},
				{
					"id": 711160206,
					"content": "Uns wurden sämtliche Mora von dem „Kopf“ abgeknöpft. Und jetzt stehen wir mit leeren Händen da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "Eiserner Dou’er"
				},
				{
					"id": 711160210,
					"content": "Mit dem „Kopf“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160211
					]
				},
				{
					"id": 711160211,
					"content": "Ja, von unserer Eisensalzbande. Er ist dort unterhalb der Klippe und steckt mit einer Bande aus Fontaine die Köpfe zusammen, um Salz oder so zu schmuggeln. Er hat uns hiergelassen, damit wir das Nest bewachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160212
					],
					"speakerTitle": "Eiserner Dou’er"
				},
				{
					"id": 711160212,
					"content": "Ihr habt das gerade auch gesehen, oder? Diese Mistkäfer aus Fontaine haben die Gelegenheit abgepasst, als unser Kopf der Bande im Gespräch war. Sie haben sich reingeschlichen und uns den Hintern verkloppt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160213
					],
					"speakerTitle": "Eiserner Dou’er"
				},
				{
					"id": 711160213,
					"content": "Oh weh ... den Hintern verkloppt ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160214,
					"content": "Oooh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160215
					]
				},
				{
					"id": 711160215,
					"content": "Freundchen, ihr habt mich für einen ahnungslosen Neuling gehalten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160216
					],
					"speakerTitle": "Eiserner Dou’er"
				},
				{
					"id": 711160216,
					"content": "Wir kriegen bereits nasse Füße. Am Ende könnte sogar der Kopf der Bande in einen üblen Hinterhalt geraten. Freunde, kann ich euch beim Wort nehmen ... Werdet ihr uns noch einmal helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160217
					],
					"speakerTitle": "Eiserner Dou’er"
				},
				{
					"id": 711160217,
					"content": "Wenn dem Kopf der Bande nichts passiert, wird es ein großes Festmahl für euch geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160218
					],
					"speakerTitle": "Eiserner Dou’er"
				},
				{
					"id": 711160218,
					"content": "Wo ist er denn? Ich möchte erst einmal nachsehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160219
					]
				},
				{
					"id": 711160219,
					"content": "Gleich da drüben unterhalb der Klippe am Ufer. Wenn ihr hingeht, werdet ihr ihn sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160220
					],
					"speakerTitle": "Eiserner Dou’er"
				},
				{
					"id": 711160220,
					"content": "Freunde, geht schon mal voraus, ich zähle auf euch! Ich mache noch klar Schiff und komme dann nach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eiserner Dou’er"
				},
				{
					"id": 711160207,
					"content": "Wem Unrecht widerfahren ist, dem soll tatkräftig geholfen werden!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160208
					]
				},
				{
					"id": 711160208,
					"content": "Welch edler Sinn für Gerechtigkeit! So seid ihr beiden eben. Ich wollte gerade etwas vorschlagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160209
					],
					"speakerTitle": "Eiserner Dou’er"
				},
				{
					"id": 711160209,
					"content": "Ich fürchte, es könnte Probleme mit dem „Kopf“ da drüben geben. Ihr könntet behilflich sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "Eiserner Dou’er"
				}
			]
		},
