				]
			},
			"dialogs": [
				{
					"id": 711160601,
					"content": "Es sei euch gedankt, ihr beiden edlen Kämpfer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160602
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160602,
					"content": "Nichts zu danken! Egal, wo man Handel treibt, die Vertragsbedingungen müssen eingehalten werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160603,
					"content": "Hehe, die kleine Kämpferin hat recht. Es scheint, ihr beiden seid über unseren Handel durchaus im Bilde!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160604
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160604,
					"content": "Eiserner Dou’er hat uns alles erzählt. Sie sagte etwas davon, dass ihr hier seid, um Salz zu schmuddeln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160605,
					"content": "Aber was bedeutet es eigentlich, Salz zu schmuddeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160606,
					"content": "Es scheint sich um ein nicht ganz ordnungsgemäßes Geschäft zu handeln.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160607
					]
				},
				{
					"id": 711160607,
					"content": "Und da das so ist, muss ich euch beiden edlen Kämpfern meinen aufrichtigen Dank aussprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160608
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160608,
					"content": "Achtung! Fesselt sie und werft sie ins Meer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160609
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160609,
					"content": "Denkt daran, ihnen ein paar mehr Steine anzubinden. Die beiden haben es gut mit unserer Eisensalzbande gemeint, also sollen sie nicht unnötig leiden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160610
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160610,
					"content": "Was!? ... Wa... Was willst du uns antun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160611,
					"content": "Du kleine edle Kämpferin. Hast du nicht eben noch alles verstanden? In Liyue werden Verträge streng befolgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160612
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160612,
					"content": "Wer einen zwielichtigen Handel der Banden mitbekommt, muss natürlich mit dem Schlimmsten rechnen. Diese Vertragsklausel dürfte nun wirklich jedem bekannt sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160613
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160613,
					"content": "Was für eine Vertragsklausel soll das denn sein!? Wenn du auf diese Art Gutes mit Bösen vergelten willst, ist das überhaupt nicht vertragsgemäß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160614,
					"content": "Stellt meine Gutmütigkeit nicht auf die Probe. Wenn ich selbst Hand anlegen muss, werdet ihr nichts mehr zu lachen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160615,
						711160616
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160615,
					"content": "Weißt du eigentlich, wer vor dir steht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				},
				{
					"id": 711160617,
					"content": "Schluss mit dem Unsinn! Eiserner Dou’er! Eiserner Chuan’er! Worauf wartet ihr noch!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160618
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160618,
					"content": "Boss, du bist immer noch so grausam und ehrlos wie eh und je.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160619
					],
					"speakerTitle": "Eiserner Chuan’er"
				},
				{
					"id": 711160619,
					"content": "Unsere Mühen waren nicht vergeblich. Einen wie dich lassen wir auf keinen Fall weiter in Liyue sein Unwesen treiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160626
					],
					"speakerTitle": "Eiserner Dou’er"
				},
				{
					"id": 711160626,
					"content": "Netz einholen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160620
					],
					"speakerTitle": "Eiserner Dou’er"
				},
				{
					"id": 711160620,
					"content": "Wa... Was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160621
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160621,
					"content": "Eiserner Ming, du Mistkerl! Sperr deine Augen auf! Hast du vergessen, wer vor dir steht!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160622
					],
					"speakerTitle": "Eiserner Dou’er"
				},
				{
					"id": 711160622,
					"content": "Mi... Millelithen!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160623
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160623,
					"content": "He! Was ist hier los!? Was ist plötzlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160624,
					"content": "Ich dachte, ihr wärt nur einige Grünschnäbel. Wer konnte ahnen, dass ihr in Diensten der „Falkenkrallen“ steht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160625
					],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160625,
					"content": "Glaubt nicht, dass ich einfach so aufgebe! Euch werd ich es zeigen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eiserner Ming"
				},
				{
					"id": 711160616,
					"content": "Ohoho! Jetzt bekomme ich aber Angst!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				}
			]
		},
		{
			"id": 7111608,
