			"dialogs": [
				{
					"id": 3572401,
					"content": "Hier geht es zum <color=#00E1FFFF>Ritterorden</color>. Den solltest du dir ansehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 35801,
			"completionStepIds": [
				35802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"35802",
							"2"
						],
						"stepId": 35802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3580101,
					"content": "Und so hat sich das Ganze abgespielt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3580102,
					"content": "Mondstadt heißt euch herzlich willkommen! Dank sei den Winden, die euch hergeführt haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580103
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580103,
					"content": "Ich bin Jean, der stellvertretende Großmeister. Dies ist Lisa, die Bibliothekarin des Ritterordens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580104
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580104,
					"content": "Ach, seid ihr Süßen hergekommen, um uns unter die Arme zu greifen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580105,
					"content": "Wie niedlich ihr seid!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580106,
					"content": "Nur allzu schade, dass ihr in solchen Zeiten zu uns stoßt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580107,
					"content": "Seit Sturmschrecken wieder erwacht ist, treibt er sich in der Nähe der Stadt herum und stiftet Unheil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580108,
					"content": "Der Fluss der Elemente wurde gestört. Dieser empfindliche Kreislauf ähnelt nun mehr einem Wollknäuel in den Pfoten einer Katze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580109,
					"content": "Für einen Magier ist dies das Schlimmste, was passieren kann. Meine Haut ist ganz rau und meine Laune könnte nicht schlechter sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580110,
					"content": "Wenn es diese Störung nicht gäbe, könnte der Ritterorden euch natürlich mehr als nur ein paar Zettel mit einer Vermisstenanzeige bieten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580111
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580111,
					"content": "Wir möchten euch bitten, eine Weile in Mondstadt zu bleiben. Der Ordo Favonius wird sich um euer Problem kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580112,
						3580114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580112,
					"content": "Ich werde das natürlich nicht allein dem Ritterorden überlassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580113
					]
				},
				{
					"id": 3580113,
					"content": "Paimon wird auch helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3580116,
					"content": "Nun denn, wir sollten unser Vorgehen planen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580117
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3580117,
					"content": "Da Sturmschrecken Mondstadt nun direkt angreift, haben wir die Möglichkeit, schwere Geschütze aufzufahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580118,
					"content": "Lisa konnte mit ihrer Magie der Quelle des Orkans auf die Spur kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580119
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580119,
					"content": "Tatsächlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580120
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3580120,
					"content": "Sie liegt in den <color=#00E1FFFF>Tempeln der „Vier Winde“</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580121
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580121,
					"content": "Dass Sturmschrecken Stürme solchen Ausmaßes überhaupt erschaffen kann, liegt an der dort zurückgebliebenen Kraft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580122
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580122,
					"content": "Unser Ziel sind nun <color=#00E1FFFF>drei</color> dieser vier verlassenen Tempel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580123
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580123,
					"content": "Ich denke, jeder weiß, warum wir uns drei Tempel vornehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580124,
					"content": "Nein ... Paimon nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580125,
						3580126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3580125,
					"content": "Für Einheimische ist das sicher klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580127,
					"content": "Meine lieben Ritter des Ordo Favonius, die Zeit spielt gegen uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580128
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580128,
					"content": "Ein großer Sturm zieht auf. Es bringt nichts, allein eine Abwehrhaltung einzunehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580129
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580129,
					"content": "Wir müssen handeln, bevor es zu spät ist. Lasst uns zu den <color=#00E1FFFF>Tempelruinen</color> aufbrechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580126,
					"content": "Wir kümmern uns später darum ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580114,
					"content": "Super! Gebt Bescheid, wenn es etwas Neues gibt. Wo kann ich schlafen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580115
					]
				},
				{
					"id": 3580115,
					"content": "He, nicht so faul! Wir sollten unseren Teil beisteuern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}