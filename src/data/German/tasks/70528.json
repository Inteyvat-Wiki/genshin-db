			},
			"dialogs": [
				{
					"id": 705280401,
					"content": "Kann die Gilde wirklich so viel Arbeit bewältigen? *seufz* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280402
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280402,
					"content": "#Oh, {F#Reisende}{M#Reisender}! Entschuldige, ich war abgelenkt. Mich beschäftigen einige Gilden-Angelegenheiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280403
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280403,
					"content": "Du bist sicher zum Windblumenfest in Mondstadt, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280404
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280404,
					"content": "Wir von der Abenteurergilde haben ein spaßiges kleines Spiel vorbereitet, bei dem jeder, der mitspielt, eine Belohnung erhält!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280405
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280405,
					"content": "Wie klingt es? Lust, es zu probieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280406
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280406,
					"content": "Lass mich es dir zuerst vorstellen. Der Erfinder des Spiels nennt es „Blumenschach“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280407
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280407,
					"content": "Er meint, er sei von den wehenden Blütenblättern und dem Wind inspiriert worden, der sie antrieb ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280408
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280408,
					"content": "Und das Spiel soll die Romantik der Jagd nach diesen Blütenblättern nachahmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280409,
						705280410
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280409,
					"content": "Klingt ziemlich romantisch ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				},
				{
					"id": 705280411,
					"content": "Er ist ein Barde ... es mangelt ihm also nicht an Vorstellungskraft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280412
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280412,
					"content": "Einfach ausgedrückt, muss der Spieler bei diesem Spiel so viele „Windblumenballons“ wie möglich auf dem Spielbrett sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280413
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280413,
					"content": "Während des Sammelns musst du allen möglichen Hindernissen ausweichen ... und natürlich gibt es auf dem Brett diverse Gegenstände, die dir helfen können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280414
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280414,
					"content": "Der Erfinder hat sogar eine ganze Anleitung mit detaillierten Informationen zum Spiel verfasst. Du kannst sie später gern lesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280415
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280415,
					"content": "Wenn du Interesse hast, kannst du es gerne ausprobieren. Spiel einfach mit und du bekommst eine Belohnung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280410,
					"content": "Klingt ziemlich kompliziert ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				}
			]
		}
	]
}