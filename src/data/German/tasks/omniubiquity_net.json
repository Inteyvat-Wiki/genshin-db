			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720501,
					"content": "Hast du Wakamurasaki besucht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720502
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720502,
					"content": "In Bezug auf das „Netz der Omniubiquität“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720503
					]
				},
				{
					"id": 726720503,
					"content": "Das „Netz der Omniubiquität“ ... das ist ein guter Name, aber diese Technik ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720504
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720504,
					"content": "Kann diese Technik wirklich die essenzielle Gestalt eines Menschen festhalten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720505
					]
				},
				{
					"id": 726720505,
					"content": "Nun ... auf keinen Fall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720506
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720506,
					"content": "Diese Onmyoudou-Technik ist nur aufgezeichnet, die genaue Art und Weise, wie sie ausgeführt wird, ist vor einer langen Zeit verloren gegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720507
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720507,
					"content": "Die Technik, die ich Wakamurasaki gegeben habe, kann nur die essenzielle Form eines kleinen Tieres hervorbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720508
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720508,
					"content": "Warum hast du es dann Wakamurasaki gesagt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720509
					]
				},
				{
					"id": 726720509,
					"content": "Ach das. Ich möchte nur, dass Wakamurasaki mir hilft, eine Botschaft zu verbreiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720510
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720510,
					"content": "„Die Detektei Bantan Sango bat jemanden, ein Netz zu entwickeln, das die Menschen dazu bringt, die Wahrheit zu sagen, und das das Kamuna-Onmyoudou als Kernstück verwendet.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720511
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720511,
					"content": "Das lange verschollene Kamuna-Onmyoudou, die Detektei Bantan Sango und das Netz, das die göttliche Form der kleinen Tiere enthält.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720512
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720512,
					"content": "Die Kombination dieser Elemente reicht aus, um eine „Straßenlegende“ zu schaffen, die fantastisch klingt und sich echt anfühlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720513
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720513,
					"content": "Obwohl diese „Straßenlegende“ nur eine kurze Geschichte für den einfachen Mann ist, ist sie viel mehr als eine Geschichte für die Gefangenen, die Geister in ihren Herzen tragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720514
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720514,
					"content": "Ach so!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720515
					]
				},
				{
					"id": 726720515,
					"content": "Der andere Grund ist ... Wer hat Wakamurasaki gesagt, dass sie mich immer wieder bedrängen soll, ihr die „mächtigste Onmyoudou-Technik“ zu geben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720516
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720516,
					"content": "Ich habe gesagt, dass ich sowas nicht habe, aber sie wollte nicht auf mich hören. Ich hatte wirklich keine andere Wahl, als diese Onmyoudou-Technik anzuwenden, um sie wegzulocken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720517
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720517,
					"content": "Was, wenn Wakamurasaki das niemand anderem sagt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720518
					]
				},
				{
					"id": 726720518,
					"content": "Nein. Sie hat noch nie ein Geheimnis behalten können. Ich kenne sie einfach zu gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720519
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720519,
					"content": "Ich bin froh, dass du diese Reise für mich gemacht hast, also gebe ich dir das als Bezahlung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720520
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720520,
					"content": "Ich hoffe, Wakamurasaki kommt nicht zu mir zurück, um eine weitere Onmyoudou-Technik zu lernen, ich bin Detektiv, kein Onmyoudou-Meister ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
