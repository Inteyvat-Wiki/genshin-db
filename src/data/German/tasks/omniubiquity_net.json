			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wakamurasaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720401,
					"content": "Wie funktioniert das Netz für dich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720402
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720402,
					"content": "Es ging nach einmaligem Gebrauch kaputt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720403
					]
				},
				{
					"id": 726720403,
					"content": "Nun ... Das lässt sich nicht ändern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720404
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720404,
					"content": "Wie ich schon sagte, kann diese Technik die essenzielle Form eines kleinen Tieres festhalten, aber wenn man die essenzielle Form erhalten oder wieder die Form eines kleinen Tieres annehmen will, braucht man eine andere Methode.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720405
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720405,
					"content": "Ich habe diese Kunst in das „Netz der Omniubiquität“ integriert und das Medium für die Bewahrung der essenziellen Form sowie für die Manifestation der Form ist das Netz selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720406
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720406,
					"content": "Wie kompliziert ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720407
					]
				},
				{
					"id": 726720407,
					"content": "Einfach ausgedrückt: Ein Netz kann nur einmal verwendet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720408
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720408,
					"content": "Das ist ein Problem, das ich bisher noch nicht gelöst habe, und es wäre zu teuer, wenn das Medium nicht wiederverwendet werden könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720409
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720409,
					"content": "Ich werde weiter an diesem Netz arbeiten und versuchen, dieses Problem so schnell wie möglich zu lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720410
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720410,
					"content": "Wenn du noch ein „Netz der Omniubiquität“ brauchst, komm einfach zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720411
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720411,
					"content": "Obwohl diese Netze derzeit nur einige kleine Tiere fangen können, ist ihr Herstellungsprozess wirklich schwierig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720412
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720412,
					"content": "Wenn du also das nächste Mal so etwas haben willst, musst du mir dann eine kleine Gebühr für die Herstellung zahlen, hehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720413
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720413,
					"content": "#Entspann dich, du bist {F#eine Freundin}{M#ein Freund} von Sango. Ich werde dir einen guten Preis machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wakamurasaki"
				}
			]
		},
		{
			"id": 7267205,
			"completionStepIds": [
				7267205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
