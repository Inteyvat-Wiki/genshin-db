				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720101,
					"content": "Wakamurasaki ... Ich hätte ihr wirklich nicht von ihm erzählen sollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720102
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720103
					]
				},
				{
					"id": 726720103,
					"content": "#{F#Reisende}{M#Reisender}, du bist es. Erinnerst du dich an das „Netz der Ubiquität“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720104
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720104,
					"content": "Nachdem wir das letzte Ereignis geklärt hatten, habe ich meiner Freundin auch von dir erzählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720105
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720105,
					"content": "Ihr Name ist Wakamurasaki und sie ist eine ... nun ja ... sie sagt, sie sei eine „Entwicklerin“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720106
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720106,
					"content": "Wakamurasaki schien inspiriert zu sein, als sie hörte, wie du dieses Netz benutztest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720107
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720107,
					"content": "Sie drängt mich immer wieder, ihr zu helfen, neue Techniken zu finden, um ihre fortgesetzte Transformation des „Netzes der Ubiquität“ zu erleichtern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720108
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720108,
					"content": "Ich hatte keine Wahl, also griff ich zu diesem alten Buch und fand eine neue Technik für sie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720109
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720109,
					"content": "#{F#Reisende}{M#Reisender}, wenn du Interesse hast, geh rüber zu Wakamurasaki, vielleicht hat sie das Netz inzwischen umgebaut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 7267202,
			"completionStepIds": [
				7267202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267202",
							"2"
						],
						"stepId": 7267202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wakamurasaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720201,
					"content": "So ist es fast abgeschlossen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720202
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720202,
					"content": "Bist du Wakamurasaki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720203
					]
				},
				{
					"id": 726720203,
					"content": "Das bin ich. Gibt es etwas Bestimmtes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720204
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720204,
					"content": "In Bezug auf das „Netz der Ubiquität“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720205
					]
				},
				{
					"id": 726720205,
					"content": "#Was? Ich erinnere mich, du musst {F#die}{M#der} Reisende sein, richtig? Sango hat dich erwähnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720206
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720206,
					"content": "Die Art und Weise, wie du mit dem „Netz der Ubiquität“ umgehst, ist wirklich ausgefuchst und inspiriert mich sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720207
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720207,
					"content": "Ich habe gehört, dass du es umgestaltest.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720208
					]
				},
				{
					"id": 726720208,
					"content": "Das ist richtig. Sango hat mir einen ganz neuen Onmyoudou-Kunststil verpasst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720209
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720209,
					"content": "Ich habe das Netz mit diesem Kunststil erneut umgewandelt und jetzt heißt es „Netz der Omniubiquität“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720210
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720210,
					"content": "Sango zufolge kann diese Kunst die essenzielle Form eines Wesens festhalten und dann einen Gegenstand als Medium benutzen, um die Form dieses Wesens wieder anzunehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720211
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720211,
					"content": "Sie sagte auch, dass diese Onmyoudou-Technik, wenn sie bis zum Äußersten weiterentwickelt würde, sogar die essenzielle Form eines Menschen festhalten könnte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720212
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720212,
					"content": "Diese Form, sobald sie eingefangen wurde, kann Fragen beantworten und wird niemals lügen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720213
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720213,
					"content": "Diese Art von Magie kann als das stärkste Werkzeug für einen Detektiv wie Sango angesehen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720214
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720214,
					"content": "Ich schätze, deshalb war sie bereit, mir diese Technik zu geben und mich das Netz transformieren zu lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720215
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720215,
					"content": "Ah! Erzähl das nicht herum! Weil du ein Freund von Sango bist, erzähle ich dir das alles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720216,
						726720217
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720216,
					"content": "So stark ist das?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				},
				{
					"id": 726720218,
					"content": "Äh ... noch nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720219
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720219,
					"content": "Egal, wie ich es umgestalte, das Netz kann im Moment nur die essenzielle Form von kleinen Tieren halten und ist für Menschen völlig nutzlos ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720220
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720220,
					"content": "#{F#Reisende}{M#Reisender}, probier du auch dieses Netz aus, vielleicht ... wird mir die Art und Weise, wie du es benutzt, etwas Inspiration geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720221
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720221,
					"content": "Hier, dieses Netz ist für dich. Der Name dieses Netzes ist „Netz der Omniubiquität“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720222
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720222,
					"content": "Versuch doch mal, mit diesem Netz ein paar kleine Tiere zu fangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720217,
					"content": "Wurde es bereits erfolgreich transformiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				}
			]
		},
		{
			"id": 7267204,
			"completionStepIds": [
				7267204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
