			"dialogs": [
				{
					"id": 752580101,
					"content": "Hä? Wieso liegt hier jemand ohnmächtig am Boden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580102,
					"content": "He! Alles in Ordnung bei dir? Hörst du Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580103,
					"content": "Ihr richtet den Mann vorsichtig auf, und langsam kommt er wieder zu sich ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752580104
					]
				},
				{
					"id": 752580104,
					"content": "Aua ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580105,
						752580106
					],
					"speakerTitle": "Bewusstloser Mitarbeiter"
				},
				{
					"id": 752580105,
					"content": "He, hast du einen über den Durst getrunken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				},
				{
					"id": 752580107,
					"content": "Boah, mir dreht sich alles ... was ist überhaupt passiert ... Moment mal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580108
					],
					"speakerTitle": "Bewusstloser Mitarbeiter"
				},
				{
					"id": 752580108,
					"content": "Jetzt fällt’s mir wieder ein! Mich hat jemand niedergeschlagen ... aber ich habe nicht gesehen, wer es war. Moment mal ... das wart doch nicht etwa ihr?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580109
					],
					"speakerTitle": "Bewusstloser Mitarbeiter"
				},
				{
					"id": 752580109,
					"content": "Na hör mal! Wir sind doch gerade die, die dir helfen! Jetzt tu mal nicht so, als wäre das eine Abzocke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580110,
					"content": "Ooh, Entschuldigung! Ähm ... ich arbeite in „Honigbrau“ und war gerade unterwegs zum Hafen im Norden, um eine Lieferung abzugeben. Ja ... der Händler aus Nod-Krai hat bei uns ein paar Aphimead bestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580111
					],
					"speakerTitle": "Bewusstloser Mitarbeiter"
				},
				{
					"id": 752580111,
					"content": "Ach! Wo ist meine Ware?! Mein Aphimead ist weg! Wurde es etwa geklaut?! Moment ... das wart doch nicht etwa ihr?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580112
					],
					"speakerTitle": "Bewusstloser Mitarbeiter"
				},
				{
					"id": 752580112,
					"content": "Wir haben dir doch gerade erst aufgeholfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580113,
					"content": "Ach ja, klar, Entschuldigung! Mir dreht sich gerade immer noch der Kopf ... Vielen Dank, aber ich muss sofort zurück zur Taverne und das melden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580114
					],
					"speakerTitle": "Bewusstloser Mitarbeiter"
				},
				{
					"id": 752580114,
					"content": "Falls es wirklich Räuber sind, geht am besten nicht zum Hafen im Norden, das könnte gefährlich werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bewusstloser Mitarbeiter"
				},
				{
					"id": 752580106,
					"content": "Brauchst du Hilfe, um nach Hause zu kommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				}
			]
		}
	]
}