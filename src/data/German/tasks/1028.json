			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanfei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10280401,
					"content": "Hm? Wie komisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280402
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280402,
					"content": "Wir ... Warum sind wir wieder hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280403,
					"content": "Sind wir nicht vorher schon hier vorbeigelaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280404
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280404,
					"content": "Ja, es ist unser Ausgangspunkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280405
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280405,
					"content": "Aber wir haben nichts falsch gemacht. Wir sind Richtung Ausgang gelaufen, ohne umzukehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280406
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280406,
					"content": "Den Eindruck habe ich auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280407
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280407,
					"content": "#{F#Reisende}{M#Reisender}, bist du auch sicher, dass wir nicht den falschen Weg gelaufen sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280408
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280408,
					"content": "Ja, ich glaube nicht, dass wir falsch gegangen sind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280409
					]
				},
				{
					"id": 10280409,
					"content": "Seltsam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280410,
					"content": "Es ist ein Gerücht in Inazuma im Umlauf, dass ein Geschäftsmann, der nachts unterwegs war, einem Bakedanuki in die Falle gegangen war und dann die ganze Nacht im Kreis ging und bis zum Morgengrauen nicht herausfand ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280411
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280411,
					"content": "Das ist die sogenannte Geisterbesessenheit. Das weiß Paimon auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280412,
					"content": "Alle scheinen das zu kennen. Sehr schön. Ich glaube, dass wir auf so etwas Seltsames gestoßen sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280413
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280413,
					"content": "Das ist aber kein Problem. Ich habe einen Helfer, der böse Geister austreiben kann, wenn so etwas passiert. Es ist an der Zeit, ihn zu rufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280414
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280414,
					"content": "Itto, ein Oni, hat tatsächlich einen Helfer, der Geister austreiben kann? Er hat sooo ein großes Herz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280415,
					"content": "Seine Begriffsstutzigkeit ist der Grund, warum der Boss ein gutes Leben hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280416
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280416,
					"content": "Komm schon, Ushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280417
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280417,
					"content": "Muh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280418
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280418,
					"content": "Das ist ein inoffizielles Mitglied unserer Arataki-Bande, Ushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280419
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280419,
					"content": "Muh, muh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280420
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280420,
					"content": "Ushi sagt hallo zu allen. Ihr könnt ihn Ushi oder Bruder Ushi nennen. Ushi ist gut darin, den richtigen Weg zu finden. Daher lassen wir ihn uns führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280421
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280421,
					"content": "Es gibt noch ein inoffizielles Mitglied ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280422
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280422,
					"content": "Er macht mir keinen zuverlässigen Eindruck.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280423
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280423,
					"content": "Wer weiß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280424
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280424,
					"content": "Leg los, Ushi! Finde einen Weg für uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280425
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280425,
					"content": "Muh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280426
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280426,
					"content": "Ushi beginnt sich umzusehen, ob es einen versteckten Ausgang gibt ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10280427
					]
				},
				{
					"id": 10280427,
					"content": "Muh ... Muh, muh ... Muh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280428
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280428,
					"content": "Hm? Oh, oh ... Ah?! Das kann doch nicht sein?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280429
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280429,
					"content": "Was ist los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280430,
					"content": "Ushi sagt, dass er überall gesucht hat. Aber es gibt überhaupt keinen Ausgang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280431
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280431,
					"content": "Aber da wir reinkommen konnten, müssen wir doch auch irgendwie rauskönnen. Das darf doch nicht wahr sein ... Lass mich mal versuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280432
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280432,
					"content": "Habt ihr das bemerkt? Zuerst dachten wir, wir wären von oben heruntergefallen. Da war dieser Ausgang, dieses Loch, über unseren Köpfen ... Jetzt ist auch der Ausgang verschwunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280433
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280433,
					"content": "Wie kann das sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280434
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280434,
					"content": "Es scheint, dass diese unterirdischen Strukturen komplexer sind, als wir dachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280435
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280435,
					"content": "... Ich werde mich mal umsehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280436
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280436,
					"content": "Überall sind Felswände. Könnte es sein ... Könnte es sein, dass wir uns falsch erinnert haben? Wir sind vielleicht überhaupt nicht von hier hinuntergestürzt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280437,
					"content": "He, hast du Angst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280438
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280438,
					"content": "Paimon ist nicht so ängstlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280439,
					"content": "Muh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280440
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280440,
					"content": "Ushi glaubt auch, dass du Angst hast. Ist schon gut. Sag einfach, wenn du Angst hast. Wir werden dich beschützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280441
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280441,
					"content": "Paimon, ich bin da.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280442
					]
				},
				{
					"id": 10280442,
					"content": "#Es bringt ja nichts, stehen zu bleiben. Lasst uns einen Weg finden. Shinobu, du begleitest meine Wohltäterin. Ich gehe mit {NICKNAME} und Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280443
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280443,
					"content": "Gut, alle sollten achtgeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280444
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280444,
					"content": "Das mit der Wohltäterin ist übertrieben. Nenn mich einfach Yanfei. Itto ist wohlverdient Boss der Bande. Du hast großartige Führungsstärke gezeigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280445
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280445,
					"content": "Ach, du übertreibst. Nenn mich einfach Itto. Da wir alle Gefährten sind, sollten wir gut aufeinander aufpassen. Paimon, ich kann deine Augen bedecken, wenn du Angst hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280446
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280446,
					"content": "Die Leute teilen sich auf und durchsuchen die Umgebung, aber ohne Erfolg ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10280447
					]
				},
				{
					"id": 10280447,
					"content": "... Schade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280448
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280448,
					"content": "Es gibt wirklich keinen Ausgang ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280449
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280449,
					"content": "Muh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280450
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280450,
					"content": "Ich glaube, mit diesem Ort stimmt etwas nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280451
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280451,
					"content": "Boss, wie sieht es bei euch aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280452
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280452,
					"content": "Kein Erfolg.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280453
					]
				},
				{
					"id": 10280453,
					"content": "Und eben gerade habe ich aus dem Augenwinkel einige Gestalten gesehen, glaube ich ... Sind es wirklich Geister?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280454
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280454,
					"content": "Obwohl die Atmosphäre jetzt sehr seltsam ist, muss Paimon trotzdem fragen ... Itto, bist du nicht selbst ein Oni, also ein Geist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280455
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280455,
					"content": "Nein! Ich meine, dieses immer wieder aufflackernde und verlöschende Licht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280456
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280456,
					"content": "Hm? Itto, hast du eigentlich ... Angst vor Geistern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280457
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280457,
					"content": "Ah. Erwischt, Boss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280458
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280458,
					"content": "Nein, keinesfalls! Erzählt keinen Unsinn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280459
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280459,
					"content": "Hihi, wenn Paimon dich so sieht, hat Paimon plötzlich keine Angst mehr ... He, Kuhhirte, wenn du Angst hast, kann Paimon dir die Augen zuhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280460
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280460,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280461
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280461,
					"content": "Sieht so aus, als müsste ich mir eine andere Beschäftigung suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280462
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280462,
					"content": "(Hm? Shinobu geht zur Seite, sie scheint ein paar Steine gefunden zu haben und holt Zweige und Lavendelmelonen aus der Tasche ... Hmm?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280463
					]
				},
				{
					"id": 10280463,
					"content": "Noch etwas Salz ... und etwas Pfeffer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280464
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280464,
					"content": "Röstest du Lavendelmelonen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280465
					]
				},
				{
					"id": 10280465,
					"content": "Ja. Geröstete Lavendelmelonen sind köstlich. Ihr könnt sie nachher probieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280466
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280466,
					"content": "Gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280467
					]
				},
				{
					"id": 10280467,
					"content": "Ooh ... Süß oder salzig, was magst du lieber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280468
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280468,
					"content": "Beides ist gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280469
					]
				},
				{
					"id": 10280469,
					"content": "Na, dann probiere doch beides. Gerade in einer solchen Situation braucht man eine stabile Psyche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280470
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280470,
					"content": "Wenn ich richtig liege, gibt es hier ein Geheimnis, das ich und der Boss eigentlich nicht wissen dürfen. Aber keine Sorge. Ich passe auf, dass der Boss eure vertraulichen Gespräche nicht stört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280471
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280471,
					"content": "Oha! Hier wird gerade gegrillt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280472
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280472,
					"content": "Möchtest du auch probieren, Yanfei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280473
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280473,
					"content": "Ich habe keinen Hunger. Guten Appetit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280474
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280474,
					"content": "Übrigens, Shinobu, ich hab dich schon lange nicht mehr gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280475
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280475,
					"content": "Stimmt. Letztes Mal kamst du als Aushilfslehrerin, als ich in Liyue studierte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280476
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280476,
					"content": "Aushilfslehrerin ... Ja, stimmt. Das war ein Winter, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280477
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280477,
					"content": "Ja. Alle fanden deine Vorlesungen sehr interessant. Ich sollte dich also ... Frau Lehrerin nennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280478
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280478,
					"content": "Hmmm, das ist ein wirklich schöner Name, gefällt mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280479
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280479,
					"content": "Ich habe nicht damit gerechnet, so etwas mit meiner Schülerin zu erleben. Das scheint auch eine Fügung zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280480
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280480,
					"content": "Yanfei kann auch Vorlesungen halten, echt erstaunlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280481
					]
				},
				{
					"id": 10280481,
					"content": "Sie ist humorvoll. Ihr Unterricht ist unterhaltsam und bei Studenten sehr beliebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280482
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280482,
					"content": "Hahaha, du schmeichelst mir, Schülerin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280483
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280483,
					"content": "Jetzt sind alle hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280484
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280484,
					"content": "Yelan, wir haben getrennt die Gegend durchgesucht, aber keinen Ausgang in der Nähe gefunden. Und du? Irgendwelche Erfolge?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280485
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280485,
					"content": "Nein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280486
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280486,
					"content": "Außerdem ... Ich will das eigentlich nicht sagen. Aber ihr solltet euch mental vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280487
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280487,
					"content": "Wenn wir keinen Ausgang finden, müssen wir wahrscheinlich einige Zeit unter der Erde bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280488
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280488,
					"content": "... Denke ich auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280489
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280489,
					"content": "... Verstanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280490
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280490,
					"content": "Logischerweise kann es keinen unterirdischen Raum geben, der nur betreten, aber nicht verlassen werden kann ... Ich werde weitersuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280491
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280491,
					"content": "Wenn ihr einen möglichen Ausgang findet, denkt bitte daran, vorsichtig zu sein, wenn ihr ihn erkundet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280492
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280492,
					"content": "(Übrigens, Xiao ist auch hier. Er meinte, dass wir ihn in einer schwierigen Situation rufen könnten.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280493
					]
				},
				{
					"id": 10280493,
					"content": "(... Ja, das ist vielleicht eine Lösung.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280494
					]
				},
				{
					"id": 10280494,
					"content": "He, du siehst so ernst aus. Wieso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280495
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280495,
					"content": "Erinnerst du dich nicht, dass Xiao auch hier ist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280496
					]
				},
				{
					"id": 10280496,
					"content": "Xiao ... Ja, stimmt! Willst du ihn um Hilfe bitten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280497
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280497,
					"content": "Ich denke, wir können es versuchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280498
					]
				},
				{
					"id": 10280498,
					"content": "Gut, probier es aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280499
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280499,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280500
					]
				},
				{
					"id": 10280500,
					"content": "Xiao, könnt Ihr mich hören?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280501
					]
				},
				{
					"id": 10280501,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280502,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280503
					]
				},
				{
					"id": 10280503,
					"content": "Xiao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280504
					]
				},
				{
					"id": 10280504,
					"content": "Keine Antwort ... Paimon dachte, Xiao würde vorbeikommen, egal, wo er gerade ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280505,
					"content": "Könnte es sein, dass nicht einmal Xiao uns spüren kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280506,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280507
					]
				},
				{
					"id": 10280507,
					"content": "(Wenn ja, was würde das bedeuten? Was geht in diesem Untergrund ... Seltsames vor sich?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
