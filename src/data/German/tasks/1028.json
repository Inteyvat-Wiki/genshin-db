			},
			"dialogs": [
				{
					"id": 10280601,
					"content": "Ich hatte nicht damit gerechnet, dass wir an diesem Ort festsitzen würden. Es ist wirklich sehr schwer, hier rauszukommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280602
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280602,
					"content": "Ich habe umfassende Kenntnisse, jedoch nur innerhalb des Rechtsbereiches. Ich habe jedoch keine Kenntnisse zum Thema „Ausbruch aus dem Gefängnis“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280603
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280603,
					"content": "Ich habe mit meinem Vater auch eine Vereinbarung getroffen, „ein glückliches Leben“ zu führen ... Zumindest darf ich nicht deprimiert sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280604
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280604,
					"content": "Andererseits ist es eine gute Sache, an einen neuen Ort zu kommen, meinen Horizont zu erweitern, und alte Freunde wiederzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280605
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280605,
					"content": "Genau ... Ja, das ist eine gute Sache. Hm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanfei"
				}
			]
		},
		{
