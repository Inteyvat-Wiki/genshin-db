			},
			"dialogs": [
				{
					"id": 722441201,
					"content": "Aah ... du liest gern, Piramumon, und es wird oft gesagt, dass es einen Ort jenseits des Himmels gibt, und damals habe ich nicht daran geglaubt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441202
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441202,
					"content": "Jedes Mal lache ich nur und schüttle den Kopf über deine wildesten Launen. Oh, dass ich dir geglaubt hätte, dass ich dir geglaubt hätte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441203
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441203,
					"content": "Du sagst, dass du, wenn du die Chance hast, dem Dainichi Mikoshi zu entkommen, dich in das Land jenseits des Himmels wagen würdest ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441204
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441204,
					"content": "Jetzt, da dich niemand mehr bindet, geh weiter, Piramumon, geh weiter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441205
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441205,
					"content": "Und, Orupeusu, Orupeusu, ich würde dich gern wieder singen hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441206
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441206,
					"content": "Dich singen zu hören, deine reine, klare Stimme zu hören, wer würde da nicht im Stillen und im Herzen mitsingen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441207
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441207,
					"content": "Am Vorabend des Festes der wiederkehrenden Sonne wolltest du plötzlich die Stimme von mir hören und wolltest, dass ich zu dir spreche und singe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441208
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441208,
					"content": "Du sagtest, dass es egal ist, egal wie ich singe, du würdest nicht lachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441209
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441209,
					"content": "Wusstest du damals schon, dass das Fest der wiederkehrenden Sonne tatsächlich dein letzter Tag war?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441210
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441210,
					"content": "Aber am Ende bin ich immer noch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441211
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441211,
					"content": "Clymene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441212
					]
				},
				{
					"id": 722441212,
					"content": "#Tut mir leid, Reisende{M#r}, ich habe die Beherrschung verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441213
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441213,
					"content": "Eine Dame, die dem Sonnenkind dient, muss sich sauber und makellos halten ... Sie darf für den Rest ihres Lebens keinen anderen heiraten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441214
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441214,
					"content": "Deshalb habe ich in meinem Leben nie ein eigenes Kind bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441215
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441215,
					"content": "Diese Kinder, denen ich gedient und die ich aufwachsen gesehen habe, sind mir irgendwie wie meine eigene Kinder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441216
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441216,
					"content": "#Danke, Reisende{M#r}, dass du das Zaumzeug zurückgebracht hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441217
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441217,
					"content": "Dieses Zaumzeug ist durch die Hände eines jeden Sonnenkinds gegangen, und die Erinnerungen, die es trägt, reichen aus, um die fehlende Seele zu ersetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441218
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441218,
					"content": "Allerdings sind diese Erinnerungen zweiseitig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441219,
						722441220
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441219,
					"content": "Zweiseitig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				},
				{
					"id": 722441221,
					"content": "Natürlich gibt es zwei Arten von Erinnerungen: die eigene und die der anderen über sich selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441222
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441222,
					"content": "Ergänzend zu ihrer Existenz, beide über dem Zaumzeug, die Erinnerung an die Sonnenkinder selbst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441223
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441223,
					"content": "Ebenso wie die Erinnerung an sie als die Kinder, die von Byakuyakoku beschuldigt wurden, an die, die zu Kindern der Sünde wurden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441224
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441224,
					"content": "Die Erinnerung meinerseits reicht nicht aus, um ihre Seelen wieder aufzufüllen, also muss ich mich auf die Erinnerung der Menschen in Byakuyakoku verlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441225
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441225,
					"content": "Die Kinder, denen diese Sünden angelastet werden sollten, wurden von Byakuyakoku nur erneut in Erinnerung gerufen und hinterließen ihre hinterbliebenen Schatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441226
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441226,
					"content": "#Vielen Dank, Reisende{M#r} ... Mein großer Wunsch ist erfüllt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441227
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441227,
					"content": "Und schließlich ... ein wenig ... Seelenfrieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441228
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441228,
					"content": "Endlich wieder mit diesen Kindern zusammen sein zu können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441220,
					"content": "Erinnerungen haben Seiten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				}
			]
		},
