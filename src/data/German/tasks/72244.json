			"dialogs": [
				{
					"id": 722440501,
					"content": "#{F#Reisende}{M#Reisender}, hast du das Zaumzeug gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440502
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440502,
					"content": "Kann ich das Zaumzeug sehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				}
			]
		},
		{
			"id": 7224406,
			"completionStepIds": [
				7224415
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224415",
							"2"
						],
						"stepId": 7224415,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clymene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440601,
					"content": "Aah, das ist in der Tat, ja, in der Tat das Göttliche Zaumzeug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440602
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440602,
					"content": "#Ich hätte nie gedacht, dass ich es noch einmal sehen würde, aber wo hast du es gefunden, Reisende{M#r}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440603
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440603,
					"content": "Bei Aberaku ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440604
					]
				},
				{
					"id": 722440604,
					"content": "Bei Aberaku no Mikoto persönlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440605
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440605,
					"content": "Ich erinnere mich, dass er eine große Persönlichkeit war, als Byakuyakoku gegründet wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440606
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440606,
					"content": "Später soll er jedoch versucht haben, den Thron des Königs der Weißen Nacht, des Sonnenkinds, an sich zu reißen, und wurde als Verschwörer angesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440607
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440607,
					"content": "Ah ... Da du ihm dieses Zaumzeug abgenommen hast, scheint es, als stecke eine versteckte Absicht dahinter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440608
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440608,
					"content": "Oh, das Zaumzeug, hier im Licht des Tages wieder aufzutauchen ... Das ist mein Schicksal ... Ich habe mich nach ... den Gesichtern dieser Kinder gesehnt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440609
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440609,
					"content": "Auf diese Weise habe ich endlich eine Chance, mich zu rehabilitieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440610
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440610,
					"content": "#Reisende{M#r}, wirf dieses Zaumzeug in den Teich bei dem Locus der Seelenführung. Mit diesem Zaumzeug wirst du die verbleibenden Seelen wiederfinden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440611
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440611,
					"content": "Oh ... damit sie auf dem Weg ins Jenseits seelisch und geistig frei sind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				}
			]
		},
		{
			"id": 7224411,
			"completionStepIds": [
				7224423
			],
