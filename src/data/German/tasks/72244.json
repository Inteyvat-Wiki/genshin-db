				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440201,
					"content": "#Die Sonnenkinder ... Es gibt sieben von ihnen. O Reisende{M#r}, bitte erweise ihnen vor ihren königlichen Grabsteinen die Ehre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				}
			]
		},
		{
			"id": 7224403,
			"completionStepIds": [
				7224410
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224410",
							"2"
						],
						"stepId": 7224410,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clymene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440301,
					"content": "Und so wurden die sieben Seelenlichter angezündet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440302
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440302,
					"content": "Es scheint, dass du ihnen die Ehre erwiesen hast. Ich bin dir für deine Hilfe dankbar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440303
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440303,
					"content": "So ist es nun an mir, euch den Weg zum Locus der Seelenführung zu öffnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440304
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440304,
					"content": "#O Reisende{M#r} aus einem fremden Land, obwohl ich dir durch meine selbstsüchtigen Gedanken viel Ärger bereitet habe ... möchte ich trotzdem, dass du den Ritus des Requiems miterlebst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440305
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440305,
					"content": "Bitte folge diesem Weg und ich werde für dich da sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				}
			]
		},
		{
			"id": 7224404,
			"completionStepIds": [
				7224413
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224413",
							"2"
						],
						"stepId": 7224413,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clymene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440401,
					"content": "#{F#Reisende}{M#Reisender}, du bist ja wieder da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440402
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440402,
					"content": "Dies ist der Locus der Seelenführung und hier liegen meine letzten Gedanken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440403
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440403,
					"content": "Wenn ein Sonnenkind ein bestimmtes Alter erreicht, betritt er gemäß dem Ritual am Tag seiner Geburt das Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440404,
						722440405
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440404,
					"content": "Er betritt das Dainichi Mikoshi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440406
					]
				},
				{
					"id": 722440406,
					"content": "Ja, der sogenannte Eintritt in das Dainichi Mikoshi ist das „Fest der wiederkehrenden Sonne“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440407
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440407,
					"content": "Das Sonnenkind entsteigt dem Dainichi Mikoshi und kehrt zur Sonne zurück, bevor er von sterblicher Verderbnis befallen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440408
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440408,
					"content": "... Die Temperatur des Dainichi Mikoshi ist so hoch, dass sie Byakuyakoku durchglühen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440409
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440409,
					"content": "Unter den Sonnenkindern sind diejenigen, die schließlich an den Locus der Seelenführung zurückkehren, bereits verstümmelte Seelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440410
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440410,
					"content": "Aber ich denke immer noch, dass vielleicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440411
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440411,
					"content": "Vielleicht was?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440412
					]
				},
				{
					"id": 722440412,
					"content": "Wenn ich den Locus der Seelenführung öffne, kann ich vielleicht die restlichen Seelen durch ihre eigenen Erinnerungen auffüllen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440426
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440426,
					"content": "Lass es mich probieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440427
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440427,
					"content": "Piramumon, Orupeusu, ich bin hier. Kommt ihr nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440428
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440428,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440429
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440429,
					"content": "Und, wie ist die Lage?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440430
					]
				},
				{
					"id": 722440430,
					"content": "Von den sieben Sonnenkindern wurden leider nur Piramumon und Orupeusu von mir aufgezogen, und wenn selbst sie nicht bereit sind, zu antworten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440413
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440413,
					"content": "Es scheint, dass mein Gedächtnis allein noch nicht ausreicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440414
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440414,
					"content": "Wenn es doch nur etwas gäbe, das man als Medium benutzen könnte, wenn ich doch nur das Zaumzeug gäbe, das das Sonnenkind in seiner richtigen Form symbolisiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440415
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440415,
					"content": "Es ist schade, dass das Zaumzeug vor so langer Zeit verloren gegangen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440416
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440416,
					"content": "Leider hasst dieses Land, Byakuyakoku, diese Kinder immer noch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440417
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440417,
					"content": "Es scheint, dass der Versuch, ihre Seelen zu befreien, doch nur ein wahnhafter Wunsch ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440418
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440418,
					"content": "#... Reisende{M#r}, kann ich dich ein letztes Mal bitten, mir zu helfen, herauszufinden, wo das Göttliche Zaumzeug ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440419
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440419,
					"content": "Allerdings ist die Wahrscheinlichkeit, es zu finden, auch nicht hoch. Du hast bereits viel geholfen und es scheint ein wenig dreist zu sein, noch mehr zu verlangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440420
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440420,
					"content": "Wobei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440421,
						722440422
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440421,
					"content": "Ich verstehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440423,
					"content": "Vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440424
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440424,
					"content": "Das Zaumzeug ist jedoch seit Langem verloren gegangen und es besteht keine Eile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440425
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440425,
					"content": "Wenn du Neuigkeiten hast, komm zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440422,
					"content": "Ich gebe mein Bestes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440405,
					"content": "Das heißt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440426
					]
				}
			]
		},
