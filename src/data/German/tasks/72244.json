			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Clymene",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440101,
					"content": "Hm? Seltsam. Ich habe schon lange nicht mehr so wie ihr angezogene Leute gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440102
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440102,
					"content": "Auch die Art und Weise, wie ihr sprecht und euch verhaltet, scheint nicht die eines Staatsangehörigen von Byakuyakoku zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440103
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440103,
					"content": "Es ist schwer zu glauben, dass es sich um Reisende handelt, die aus einem fremden Land hierhergekommen sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440104
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440104,
					"content": "Genau wie du sagst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440105
					]
				},
				{
					"id": 722440105,
					"content": "Ich hatte keine Ahnung, dass es in Byakuyakoku einen Durchgang von der Welt außerhalb gibt ... Was für eine Überraschung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440106
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440106,
					"content": "Um es milde auszudrücken, ich bin seit meiner Geburt in Byakuyakoku und habe noch nie jemanden von der Welt außerhalb gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440107
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440107,
					"content": "Vor einiger Zeit sagte mir jemand, er wolle einen Blick in den Himmel werfen, und ich hielt das für einen Scherz ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440108
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440108,
					"content": "*seufz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440109
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440109,
					"content": "#O Reisende{M#r}, ich habe in der Tat eine Bitte zu äußern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440110
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440110,
					"content": "In verschiedenen Teilen von Byakuyakoku gibt es sieben königliche Grabsteine, auf denen die Reliquien der „Sonnenk{RUBY#[S]Phaethonen}inder“ eingraviert sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440111
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440111,
					"content": "Sonnenkinder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440112,
					"content": "Dainichi Mikoshi von Byakuyakoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440113
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440113,
					"content": "Alle paar Jahre wird ein Kind als Sonnenkind ausgewählt, um das Land zu regieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440114
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440114,
					"content": "Es gibt sieben Sonnenkinder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440115
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440115,
					"content": "Es ist schwierig, Reisende aus fremden Ländern in Byakuyakoku zu treffen, also geht bitte und erweist ihnen vor ihren Gräbern die Ehre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440116
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440116,
					"content": "Aber warum sollten wir Außenseiter sie verehren dürfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440117,
					"content": "Ist es nicht generell besser, wenn Bekannte zur Verehrung gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440118,
					"content": "In der Regel ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440119
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440119,
					"content": "Leider ist es nur so, dass kein Bewohner von Byakuyakoku sie verehren möchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440120
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440120,
					"content": "Selbst die königlichen Gräber werden schon lange nicht mehr verehrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440121
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440121,
					"content": "Aber warum ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440122,
					"content": "Ist es möglich, dass keiner der Bürger dieses Landes diese Sonnenkinder mag?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440123,
					"content": "Sie hassen sie sogar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440124
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440124,
					"content": "Wie ich bereits sagte, werden die Sonnenkinder schon als Sonnenkinder geboren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440125
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440125,
					"content": "Wie kann ein solches Kind das Land regieren, wenn doch die Erwachsenen, die hinter den Sonnenkindern stehen, die Fäden in der Hand halten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440126
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440126,
					"content": "Die Sonnenkinder sind nur Marionetten, die ihnen ausgeliefert sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440127
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440127,
					"content": "Nur ... diese Herren waren unersättlich, sie schröpften die Menschen und manipulierten die Sonnenkinder, um viele grausame Dinge zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440128
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440128,
					"content": "Daraufhin war das Volk empört und machte die Sonnenkinder für viele Fehler verantwortlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440129
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440129,
					"content": "Wie konnte das passieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440130,
					"content": "Die Sonnenkinder sind unschuldig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440131,
					"content": "Nein, nicht ganz ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440132
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440132,
					"content": "Für das Volk von Byakuyakoku ist ihre Unwissenheit, die der Sonnenkinder, der größte Fehler von allen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440133
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440133,
					"content": "Kann eine Person wirklich als unschuldig an einer Sünde bezeichnet werden, die sie aus Unwissenheit begangen hat und die einer anderen Person schadet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440134
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440134,
					"content": "Ich fürchte, das ist schwierig, denn der angerichtete Schaden ist irreversibel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440135,
						722440136
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440135,
					"content": "Nun ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				},
				{
					"id": 722440137,
					"content": "Nun, du kannst ... dies als meine persönliche Sentimentalität betrachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440138
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440138,
					"content": "Mein Name ist Clymene und ich bin die Frau, die für das Sonnenkind im Dainichi Mikoshi verantwortlich ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440139
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440139,
					"content": "Obwohl sie wissen, dass das, was sie tun, falsch ist und dass sie in jeder Hinsicht manipuliert werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440140
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440140,
					"content": "Schließlich sind sie die Kinder, mit denen ich aufgewachsen bin, und ich habe Mitleid mit ihnen und trauere um sie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440141
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440141,
					"content": "Aber es ist nur ... ich kann sie nicht hassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440142
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440142,
					"content": "Und obwohl meine Position es mir erlaubt, täglich in Kontakt mit dem Sonnenkind zu sein, bin ich durch die strenge Überwachung um mich herum eingeschränkt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440143
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440143,
					"content": "Ich darf den Mund nicht öffnen, um ein einziges Wort zu sagen, wenn ich in ihrer Nähe bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440144
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440144,
					"content": "Diese Kinder, wenn niemand da war, wenn sie verloren und hilflos waren. Sie sagten so viel zu mir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440145
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440145,
					"content": "Ich war nicht in der Lage, eine Antwort zu geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440146
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440146,
					"content": "Wenn ich nur, ach, wenn ich nur den Mut gehabt hätte, mein Leben aufs Spiel zu setzen und ihnen etwas zu sagen, dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440147
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440147,
					"content": "Vielleicht ... wäre alles anders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440148
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440148,
					"content": "Bitte, bis zum heutigen Tag habe ich kein Gesicht, um sie zu sehen, also muss ich ihnen hier meinen Respekt zollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440149
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440149,
					"content": "#Bitte hilf mir noch einmal in der Angelegenheit der Verehrung, Reisende{M#r}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440150
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440150,
					"content": "Eine einzige Sango-Perle vor ihre Gräber zu legen, ist alles, was ich verlange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440153
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440153,
					"content": "Auf diese Weise können die Seelenlichter auf dem Steinschrein hier angezündet werden, um den Weg zu dem Locus der Seelenführung zu öffnen und um für ihre Ruhe zu beten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440151
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440151,
					"content": "In Ordnung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440152
					]
				},
				{
					"id": 722440152,
					"content": "... Gut, dann schulde ich euch etwas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440136,
					"content": "Warum sollte man sich die Mühe der Verehrung machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				}
			]
		},
		{
			"id": 7224402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
