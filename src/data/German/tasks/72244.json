			},
			"dialogs": [
				{
					"id": 722441101,
					"content": "#Eins, zwei, drei ... Nun, {NICKNAME}, es scheint so, wir allen sieben Grabsteinen den Respekt erwiesen hätten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722441102,
					"content": "Lasst uns zum Steinschrein zurückkehren und dem Geist, der dort wartet, davon erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224412,
