					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230290101,
					"content": "Es ist auch schon Zeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290102,
					"content": "Forschst du immer noch zu den Wurzeln des Heiligen Baumes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290103
					]
				},
				{
					"id": 230290103,
					"content": "#{F#Reisende}{M#Reisender}, jedes Mal kommst du so zufällig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290104,
					"content": "Danke für alles, was du getan hast. Der Heilige Baum ist in sehr guter Verfassung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290105,
					"content": "Ich habe mit Ladep darüber gesprochen und ich denke, dass diese gute Situation noch lange anhalten wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290106,
					"content": "So haben wir endlich Zeit, uns auf unsere Abhandlung vorzubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290107
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290107,
					"content": "Und siehe da, ich hatte mir von Pharez einen „Fotoapparat“ geliehen und war auf dem Weg, den Heiligen Baum zu dokumentieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290108
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290108,
					"content": "#{F#Reisende}{M#Reisender}, warum hilfst du mir nicht auch, einen Ort aufzusuchen, um den Heiligen Baum in seiner Gesamtheit aufzuzeichnen. Ich markiere den Ort für dich auf der Karte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290109,
						230290110
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290109,
					"content": "Überlasse es mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230290110,
					"content": "Warum gehst du nicht selbst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290111
					]
				},
				{
					"id": 230290111,
					"content": "Äh, da ... da drüben ... ist es zu hoch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290112
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290112,
					"content": "Ich bekomme jedes Mal Angst, wenn ich alleine hochgehe ... Ich habe immer das Gefühl, dass der Wind mich oder mein Manuskript wegblasen wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290113
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290113,
					"content": "#Normalerweise geht Pharez darüber, um den Überblick zu behalten, aber heute scheint er mit etwas anderem beschäftigt zu sein. Deswegen bitte ich um deine Hilfe, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		},
		{
