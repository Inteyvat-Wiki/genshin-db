			"dialogs": [
				{
					"id": 230290401,
					"content": "Hast du den Heiligen Baum in Gänze aufgenommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290402
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290402,
					"content": "Natürlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290403
					]
				},
				{
					"id": 230290403,
					"content": "Oh! Zeig mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290404
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290404,
					"content": "Wirklich schön, toller Winkel und klare Aufnahme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290405
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290405,
					"content": "#Hier ist deine Zahlung. Danke für deine Hilfe, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290406
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290406,
					"content": "Keine Probleme mit dem Hauptstamm ... und die Umrisse der umliegenden Äste haben sich nicht verändert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290407
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290407,
					"content": "Jetzt müssen Ladep und Pharez nur noch die Daten sammeln und dann können wir zum nächsten Thema übergehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		}
	]
