			"dialogs": [
				{
					"id": 741660501,
					"content": "Hier ist die Theatergruppe Drei Scheine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660502
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660502,
					"content": "Hä? Das war’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660503,
					"content": "Habt ihr nicht irgendwelche Assoziationen? Wenn man von einer Theatergruppe redet, denkt man natürlich an Theater! Wenn man über Theater spricht, denkt man an Romantik! Wenn man an Romantik denkt, denkt man an Liebe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660504
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660504,
					"content": "Ein Gerücht besagt, dass man den Liebsten seines Lebens findet, wenn man jeden Tag hierherkommt und sich die Vorstellung ansieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660505
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660505,
					"content": "Gibt es ein solches Gerücht? Wenn das wahr ist, sollten dann nicht viele Menschen hier sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660506,
					"content": "Theoretisch ist das richtig. Aber es gibt eine Bedingung: Du darfst weder ein Häftling noch eine Wache vom Fort Méropide sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660507
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660507,
					"content": "Dann kann niemand seinen Liebsten treffen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660508,
					"content": "Vielleicht liegt darin das eigentliche Problem. Auf jeden Fall gehen wir zum nächsten Ziel über!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Seltsamer Mensch"
				}
			]
		},
