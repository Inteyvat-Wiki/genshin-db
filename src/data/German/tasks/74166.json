			"dialogs": [
				{
					"id": 741660301,
					"content": "Und? Habt ihr alles besprochen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660302
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660302,
					"content": "Versprich uns, dass es kostenlos sein muss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660303,
					"content": "Natürlich, natürlich, auf jeden Fall „kostenlos“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660304
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660304,
					"content": "Kommt, folgt mir auf eine Reise im Fort Méropide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Seltsamer Mensch"
				}
			]
		},
		{
