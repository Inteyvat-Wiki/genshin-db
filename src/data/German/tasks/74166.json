				]
			},
			"dialogs": [
				{
					"id": 741660401,
					"content": "Hier ist die Tauschscheinkantine vom Fort Méropide, wo jeder eine Wohlfahrtsmahlzeit pro Tag erhält.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660402
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660402,
					"content": "Das Problem ist nur, dass alles, was dir vorgesetzt wird, vom Schicksal bestimmt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660403
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660403,
					"content": "Hm, ist das alles? Paimon meint, dass man diese Informationen leicht am ersten Tag hier bekommen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660404,
					"content": "Seid beruhigt, ich habe hier eine versteckte Information. Es heißt, dass man Bran ein Geheimwort sagen kann, wenn man seine Wohlfahrtsmahlzeit erhält, dann bekommt man ein legendäres mysteriöses Essen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660405
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660405,
					"content": "Ah, wirklich? Wie heißt das Geheimwort?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660406,
					"content": "Leider weiß ich das nicht. Das Geheimwort findet ihr am besten später selbst heraus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660407
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660407,
					"content": "Das ist Paimons Satz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660408,
					"content": "Vergiss die Details. Also, gehen wir weiter zur nächsten Station, der Theatergruppe Drei Scheine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Seltsamer Mensch"
				}
			]
		},
