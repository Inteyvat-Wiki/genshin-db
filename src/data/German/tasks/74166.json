				]
			},
			"dialogs": [
				{
					"id": 741660201,
					"content": "#He, {M#junger Herr}{F#junges Fräulein}. Genau, du, komm bitte her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660202
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660202,
					"content": "Hm? Sprichst du mit uns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660203,
					"content": "Oh, ihr beide, ihr seid neu, oder? Ihr kennt Fort Méropide noch nicht, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660204
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660204,
					"content": "Herzlichen Glückwunsch, dass ihr heute mich, den freundlichsten „Einwohner“ im Fort Méropide, kennengelernt habt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660205
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660205,
					"content": "Ich möchte euch heute herumführen, damit ihr euch im Fort Méropide zurechtfindet. Natürlich ist alles „kostenlos“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660206
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660206,
					"content": "Ich kenne diesen Ort eigentlich ganz gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660207
					]
				},
				{
					"id": 741660207,
					"content": "Ah, sag das nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660208
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660208,
					"content": "Vielleicht denkst du, dass du hier alles gut kennst, aber ich bin sicher, dass du mit meiner Führung alle möglichen Dinge entdecken kannst, die dir vorher nicht aufgefallen sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660209
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660209,
					"content": "Ich habe gelernt, dass es auf der Welt nichts umsonst gibt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660210
					]
				},
				{
					"id": 741660210,
					"content": "Doch. Ich sagte doch, dass ich der freundlichste „Einwohner“ im Fort Méropide bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660211
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660211,
					"content": "Hm, Paimon findet diese Person sehr seltsam. Warum ist er so enthusiastisch, sobald wir uns zum ersten Mal treffen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660212,
					"content": "Meine Freunde, seid nicht skeptisch. Na, wie wäre es, wenn ihr das besprecht? Ich bleibe hier, bis ihr eure Entscheidung trefft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660213
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660213,
					"content": "Wenn ihr es besprochen habt, kommt zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Seltsamer Mensch"
				}
			]
		},
