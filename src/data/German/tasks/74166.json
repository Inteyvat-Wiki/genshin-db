			"dialogs": [
				{
					"id": 741660601,
					"content": "Hier ist ... der Aufzug zum Produktionstrakt vom Fort Méropide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660602
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660602,
					"content": "Hier sollte es keine seltsamen Gerüchte geben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660603,
					"content": "Nein, hier gibt’s nichts. Es ist einfach so, dass ich diesen Ort wirklich hasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660604
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660604,
					"content": "Was? Warum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660605,
					"content": "Weil ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660606
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660606,
					"content": "Weil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660607,
					"content": "Weil ich nicht arbeiten will!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660608
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660608,
					"content": "Weil ich nicht arbeiten wollte, habe ich ein Brot gestohlen, als ich sehr hungrig war. Deshalb wurde ich verurteilt und kam hierher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660609
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660609,
					"content": "Aber warum muss ich auch arbeiten, wenn ich schon im Fort Méropide bin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660610
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660610,
					"content": "„Jede Arbeit kann mich umwerfen!“ Das ist mein Lebensmotto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660611
					],
					"speakerTitle": "Seltsamer Mensch"
				},
				{
					"id": 741660611,
					"content": "Boah, Paimon glaubt, dass er verrückt wird, wenn er weiter hier bleibt! He, lass uns schnell zum nächsten Ort gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
