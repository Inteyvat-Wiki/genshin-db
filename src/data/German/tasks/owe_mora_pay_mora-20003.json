			"dialogs": [
				{
					"id": 200030501,
					"content": "Mona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030502,
					"content": "Mona, deine Miete ist fällig!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030503
					]
				},
				{
					"id": 200030503,
					"content": "... Scheint nicht da zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030504,
					"content": "Seltsam, ist sie nicht normalerweise in ihrem Zimmer? Hatte sie heute eine Besorgung zu machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030505,
					"content": "Könnte ... es etwa sein?! Hatte Mona in ihrem Zimmer so gehungert und einfach nicht die Kraft gehabt, zur Tür zu kommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030506,
						200030507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030506,
					"content": "Wohl eher nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
					]
				},
				{
					"id": 200030508,
					"content": "Wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030509,
					"content": "Aber wo sollen wir Mona finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030507,
					"content": "Sie hat bereits gesagt, dass sie über Möglichkeiten nachgedacht hat, Geld zu verdienen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
					]
				}
			]
		},
