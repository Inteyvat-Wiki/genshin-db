			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Goth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200030101,
					"content": "Ich muss wohl selbst hinlaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030102
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030102,
					"content": "Meine alten Knochen werden auseinanderfallen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030103
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030103,
					"content": "Was gibt es?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030104
					]
				},
				{
					"id": 200030104,
					"content": "#{F#Reisende}{M#Reisender}? Es ist nicht gerade ein Notfall, aber ich kann es nicht wirklich schaffen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030105
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030105,
					"content": "Du weißt ja, dass diese Fatui mein Hotel komplett belegt haben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030106
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030106,
					"content": "Nachdem sie das Hotel gebucht hatten, musste ich als Inhaber des Grand Hotel Goth natürlich auch zur Seite stehen und mich um sie kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030107
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030107,
					"content": "Hilfe bei der Kontaktaufnahme mit Lieferanten von Zutaten, bei der Reparatur von kaputten Geräten und anderen Dingen. Das ist alles mein Bier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030108
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030108,
					"content": "Einige der Tische und Stühle im Hotel sind in letzter Zeit kaputtgegangen, und ich muss mich mit dem Schreiner in Verbindung setzen, um das richtige Holz zu schicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030109
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030109,
					"content": "Und die Miete für ein paar Häuser in der Stadt ist verfallen ... und dieser Junge Marvin ist den ganzen Tag weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030110
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030110,
					"content": "Ich weiß nicht, wie viele Jahre meine alten Knochen noch durchhalten werden und wann Marvin es endlich kapieren wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030111,
						200030112
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030111,
					"content": "Ich helfe dir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030113
					]
				},
				{
					"id": 200030113,
					"content": "Möchtest du ... Möchtest du mir helfen? Wenn der Junge Marvin nur halb so fürsorglich wäre wie du, wäre ich nicht so erschöpft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030114
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030114,
					"content": "Dann besorge mir bitte eine Ladung Tannenholz und eine Ladung Birkenholz, die ich schnell dem Schreiner geben muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030112,
					"content": "Ruh dich hier erstmal aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030113
					]
				}
			]
		},
