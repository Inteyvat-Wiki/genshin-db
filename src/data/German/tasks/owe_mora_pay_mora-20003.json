						200030602
					]
				},
				{
					"id": 200030602,
					"content": "Die Bibliothek ... hmmm! Die Bibliothek des Ordens ist besonders groß, und Mona könnte sich dorthin begeben, um Informationen zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030603,
					"content": "Gehen wir also hin und sehen mal nach!",
					"roleType": "TALK_ROLE_NPC",
