					"nextDialogs": [
						200031005
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 200031005,
					"content": "Ich war beeindruckt, wie oft sie in die Bibliothek kam, um sich für einen Tag Materialien auszuleihen.",
