					"nextDialogs": [
						200031006
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 200031006,
					"content": "Allerdings war sie in letzter Zeit nicht oft in der Bibliothek, also glaube ich nicht, dass du sie hier finden wirst ...",
