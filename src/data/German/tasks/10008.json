					}
				]
			},
			"dialogs": [
				{
					"id": 100080301,
					"content": "Das war knapp! Zum Glück waren die Wölfe da, um zu helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080302,
					"content": "Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080303
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080303,
					"content": "Sie haben die Garme für uns abgefangen und sie sogar vertrieben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080304,
					"content": "Aber das ist kein ... Wolfsproblem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080305
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080305,
					"content": "Hehe, du tust das, um deinem Lupical zu helfen, oder? Sie wollen auch, dass du in Sicherheit bist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080306,
					"content": "Paimon wettet, dass sie zum Wolfskönig gegangen sind und gesagt haben: „Hör zu! Das ist nicht nur das Problem unseres Lupicals. Das ist ein Problem für die ganze Welt!“ ... Und dann sind sie losgerannt, um zu helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080307,
					"content": "Hm, „Lupical“ ist ... „Lupical“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080308
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080308,
					"content": "Ich bin ein Mensch, aber ich muss kein Wolf sein, um „Lupical“ zu sein. Ich ... möchte ihnen nur helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080309
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080309,
					"content": "Gut gesagt, Razor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080310,
					"content": "Vielleicht hat Lupus Boreas dem Rudel erlaubt zu helfen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080311
					]
				},
				{
					"id": 100080311,
					"content": "Weil er dein Herz kennt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080312
					]
				},
				{
					"id": 100080312,
					"content": "Du ... meinst das wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080313
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080313,
					"content": "Ja, absolut! Und jetzt los! Lasst uns den Wölfen in den Hintern treten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1000806,
			"completionStepIds": [
				1000806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
