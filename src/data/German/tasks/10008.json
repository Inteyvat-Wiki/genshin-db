			"dialogs": [
				{
					"id": 100080601,
					"content": "Wir haben es geschafft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080602,
					"content": "Danke ... für deine Hilfe. Ich dachte, ich muss Lupical alleine beschützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080603
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080603,
					"content": "Aber Lupical auch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080604
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080604,
					"content": "Wir sind hier, weil wir uns um dich sorgen, genauso wie du dich um uns sorgst! Das macht uns doch zu Lupical, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080605,
					"content": "Richtig ... Wir sind und bleiben immer Lupical.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080606
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080606,
					"content": "Hehe, und jetzt wird es keine Eindringlinge mehr in Wolvendom geben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080607,
					"content": "Nein ... Dunkle Wolfsrudel, sie zerreißen den Himmel. Sie ... könnten wiederkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080608
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080608,
					"content": "Aber, ich und Lupical werden sie jagen ... egal wie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080609
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080609,
					"content": "... Vergiss uns nicht, ja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080610
					]
				},
				{
					"id": 100080610,
					"content": "Ja, wenn du Hilfe brauchst, sag einfach Bescheid! Wir sind für dich da!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080611,
					"content": "Ich ... danke euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080612
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080612,
					"content": "Auuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080613
					],
					"speakerTitle": "Fernes Heulen"
				},
				{
					"id": 100080613,
					"content": "Sie ... rufen nach mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080614
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080614,
					"content": "Hehe, es hört sich an, als wollten sie sichergehen, dass du in Sicherheit bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080615,
					"content": "Dann ... sollte ich gehen. Danke ... für die Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080616
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080616,
					"content": "Keine Ursache! Dafür sind Lupical doch da!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080617
					]
				},
				{
					"id": 100080617,
					"content": "Nachdem Wolvendom vorerst sicher ist, verabschiedet sich Razor von dir und verschwindet im Wald.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						100080618
					]
				},
				{
					"id": 100080618,
					"content": "Im dichten Blätterwald bemerkst du mehrere Augenpaare, die ihn warm anblicken und darauf warten, ihn zu Hause willkommen zu heißen.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
