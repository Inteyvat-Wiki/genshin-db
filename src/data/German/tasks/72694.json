			},
			"dialogs": [
				{
					"id": 726940501,
					"content": "Wenn ich so viel Mora durch den Verkauf eines dieser Dinger bekommen kann, dann muss ich nur zwangzigtausend davon verkaufen, um meine Schulden zurückzuzahlen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940502
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940502,
					"content": "Ich kann endlich meine Schulden begleichen ... Was gibt’s? Du scheinst Fragen zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940503,
						726940505
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940503,
					"content": "Was willst du verkaufen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940504
					]
				},
				{
					"id": 726940504,
					"content": "Spielzeug, aber ... Leider sind die Spielzeuge noch nicht fertig. Bitte komm wieder, wenn ich sie hier habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940505,
					"content": "Na gut ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940506
					]
				},
				{
					"id": 726940506,
					"content": "Wenn du keine weiteren Fragen hast, dann belästige mich nicht. Ich bin mit den wichtigen Vorbereitungen für meine Waren beschäftigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				}
			]
		}
	]
}