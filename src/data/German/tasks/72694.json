				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940101,
					"content": "#{F#Reisende}{M#Reisender} und Paimon, ihr seid genau richtig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940102,
					"content": "Wofür genau richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940103,
					"content": "Für einen Auftrag, der zu euch passt! Ich wollte mich gerade bei euch melden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940104,
					"content": "Ein Auftrag, der für uns geeignet ist ... Sag Paimon nicht, dass du willst, dass wir nach Dingen suchen oder Hilichurle vertreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940105,
						726940106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940105,
					"content": "Oder den Müll auf dem Dach aufsammeln ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				},
				{
					"id": 726940107,
					"content": "Oh, nein, nein. Der Auftrag ist tatsächlich für euch geeignet und mit „geeignet“ meine ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940108,
					"content": "Es macht Spaß und es gibt auch reiche Belohnungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940109,
					"content": "Reiche belohnt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940110,
					"content": "Spaß zu haben, scheint Paimon nicht wichtig zu sein, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940111
					]
				},
				{
					"id": 726940111,
					"content": "Na... Natürlich ist Spaß zu haben auch wichtig! Also, worum geht es bei dieser Mission?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940112,
					"content": "Der Auftraggeber ist ein Spielzeughändler aus Fontaine. Sein Name ist Bertrand. Er ist nach Inazuma gekommen, um Spielzeug zu verkaufen, und sucht derzeit einen Assistenten, der ihm bei der Spielzeugherstellung hilft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940113,
					"content": "Er ist schließlich ein Geschäftsmann. Das erklärt, warum er sehr großzügige Belohnungen versprochen hat, als er die Anfrage bei der Abenteurergilde gestellt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940114,
					"content": "Aber irgendwie kann er Ritou im Moment nicht verlassen. Bitte geht und fragt ihn nach den Details des Auftrags.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940115,
					"content": "Klar, wir fahren nach Ritou und suchen sofort nach ihm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940106,
					"content": "Oder ein paar verdächtig aussehende Waren zu transportieren ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				}
			]
		},
		{
			"id": 7269402,
			"completionStepIds": [
				7269402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269402",
							"2"
						],
						"stepId": 7269402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940201,
					"content": "Haha! Es ist jetzt alles bereit! Ich werde jedes Spielzeug für Tausende von Mora verkaufen. Dann, wenn Zehntausende davon verkauft sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940202
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940202,
					"content": "Ich kann leicht zig Millionen verdienen ... Hehehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940203
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940203,
					"content": "Hallo, bist du Bertrand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940204,
					"content": "Ah ja, das bin ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940205
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940205,
					"content": "Seid ihr zwei Spielzeugkäufer, die von meinem Geschäft Wind bekommen haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940206
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940206,
					"content": "Schade, dass ich euch noch kein Spielzeug verkaufen kann, denn ich habe noch nicht mit der Massenproduktion begonnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940207
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940207,
					"content": "Aber keine Sorge, die Produktionslinie wird ab sofort aufgebaut. Ihr könnt euch anmelden und eine Anzahlung leisten, falls ihr interessiert seid. Ich werde euch informieren, wenn die Spielzeuge fertig sind, und dann könnt ihr den Restbetrag bezahlen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940208
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940208,
					"content": "Immer mit der Ruhe! Wir sind nicht hier, um dein Spielzeug zu kaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940209,
					"content": "Oh, ihr seid keine Spielzeugkäufer ... Wenn ihr also etwas zu sagen habt, sagt es mir schnell. Verschwendet nicht meine Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940210
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940210,
					"content": "Und fasst euch kurz, meine Zeit ist kostbar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940211
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940211,
					"content": "Oh ... Was für ein Gesinnungswandel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940212,
						726940213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940212,
					"content": "Wir sind hier, um zu helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940214
					]
				},
				{
					"id": 726940214,
					"content": "Ah, ihr seid also die Assistenten, die von der Abenteurergilde geschickt wurden! Herzlich willkommen! Das hättet ihr mir auch früher sagen können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940215
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940215,
					"content": "Ja, ich habe diese Anfrage gestellt. Wie soll ich euch beide ansprechen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940216
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940216,
					"content": "(Wieder ein plötzlicher Gesinnungswandel ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940217,
					"content": "Paimon ist ... Äh, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940218,
					"content": "Und was ist mit dir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940219
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940219,
					"content": "#{NICKNAME} ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940220
					]
				},
				{
					"id": 726940220,
					"content": "#{NICKNAME}? Ich glaube, ich habe diesen Namen schon einmal gehört. Warst du auch mal ... gesucht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940221,
						726940223
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940221,
					"content": "Mehr als einmal, um genau zu sein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940222
					]
				},
				{
					"id": 726940222,
					"content": "Ich habe deinen Namen vielleicht schon gehört, als die Tenryou-Verwaltung mich ... ähm, mich gebeten hat, ein paar Fragen zu beantworten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940225
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940225,
					"content": "Was in aller Welt hast du getan, dass die Tenryou-Verwaltung dich verhaftet hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940226,
					"content": "*seufz* Es war keine große Sache. Ich habe nur etwas übersehen, als ich die letzte Ladung Spielzeug gemacht habe ... Es war wirklich ein kleiner Fehler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940227
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940227,
					"content": "Keine große Sache?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940228,
					"content": "Ein kleiner Fehler?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940229
					]
				},
				{
					"id": 726940229,
					"content": "Hehe, diese Spielzeuge würden explodieren, wenn du etwas in ihnen auslöst. Das ist alles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940230
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940230,
					"content": "Explodieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940231,
					"content": "Das ist wirklich keine große Sache. Keiner wurde deswegen verletzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940232
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940232,
					"content": "Aber die Doushin von der Tenryou-Verwaltung hatten meine Spielzeuge trotzdem ohne zu zögern beschlagnahmt ... So wie ich das sehe, könnte man diese Spielzeuge immer noch als hübsche Bomben verkaufen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940233
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940233,
					"content": "*seufz* Als ich ankam, lieh ich mir ein paar Mora von der Internationalen Handelsvereinigung, um mein Geschäft zu eröffnen. Wer hätte gedacht, dass ich am Ende in Ritou eingesperrt sein würde und andere Gebiete in Inazuma nicht betreten darf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940234
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940234,
					"content": "Du hast es offensichtlich kommen sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940235,
					"content": "Moment mal, da du der Internationalen Handelsvereinigung Geld schuldest, wie willst du uns bezahlen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940236,
					"content": "Ihr könnt beruhigt sein, ich habe nicht mein ganzes Geld ausgegeben und ich kann meine Schulden begleichen, sobald ich wieder in der Lage bin, Spielzeug zu produzieren und es zu verkaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940237
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940237,
					"content": "Dann kann ich euch wie versprochen reich belohnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940238
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940238,
					"content": "... Wird das wirklich funktionieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940239,
					"content": "Hab etwas Vertrauen in Inazumas Spielzeugmarkt! Meine Spielzeuge waren sehr beliebt, bevor die Leute merkten, dass sie explodieren können ... Und weißt du was? Diese Spielzeuge wurden danach sogar noch beliebter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940240
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940240,
					"content": "Wenn mein Plan trotzdem scheitert, werde ich meine Schuld begleichen, indem ich Kurisu alle Spielzeuge schenke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940241
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940241,
					"content": "Bitte helft mir dabei, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940242
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940242,
					"content": "Aber womit sollen wir dir helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940243,
					"content": "Nun, alle meine Spielzeuge werden von dieser Maschine hergestellt, die ich gebaut habe. Sie heißt „Einzigartige, nie versagende, ingenieurmäßige Maschine mit Ofenantrieb der zweiten Generation“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940244
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940244,
					"content": "Da wir gerade von meiner „einzigartigen, nie versagenden, ingenieurmäßigen Maschine mit Ofenantrieb der zweiten Generation“ sprechen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940245
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940245,
					"content": "Was für ein Zungenbrecher ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940246
					]
				},
				{
					"id": 726940246,
					"content": "Ja, lass Paimon darüber nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940247,
					"content": "Nennen wir sie die „Große Maschine“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940248,
					"content": "Moment mal, dieser Name ist zu kurz! Er scheint überhaupt nicht zu beeindrucken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940249
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940249,
					"content": "Je kürzer, desto leichter zu merken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940250
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940250,
					"content": "„Die Große Maschine“ ... Hmm, Paimon findet, dass sich das sehr gut anhört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940251
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940251,
					"content": "*seufz* ... Gut, man hat mir tatsächlich gesagt, dass ich einen schlechten Geschmack bei Namen habe. Ich vertraue euch, nur dieses eine Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940252
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940252,
					"content": "Paimons Geschmack bei Namen ist auch nicht gerade besser ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940253
					]
				},
				{
					"id": 726940253,
					"content": "He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940254,
					"content": "Hahaha, wie auch immer, meine Große Maschine kann automatisch die hinzugefügten Materialien analysieren und dann die am besten geeignete Methode wählen, um sie zusammenzusetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940255
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940255,
					"content": "Aber beim letzten Mal habe ich ein paar seltsame Vorrichtungen eingebaut, durch die die Spielzeuge explodiert sind. Dieses Mal habe ich über den Fehler nachgedacht und die Maschine neu gebaut ... Theoretisch sollte sie in Ordnung sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940256
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940256,
					"content": "Theoretisch also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940257,
					"content": "Deshalb brauche ich Leute, die alles testen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940258
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940258,
					"content": "Insgesamt umfasst der Sammelprozess drei Schritte: Sammeln von Rohmaterial, Aufladung und Aktivierung des Kerns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940259
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940259,
					"content": "Wir müssen Dinge wie Erze, Früchte und Blumen als Grundstoffe sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940260
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940260,
					"content": "Als Nächstes durchfluten wir die Materialien mit elementarer Energie, damit der Prozess voranschreiten kann. Und schließlich versorgen wir die Materialien mit der Energie, die aus den Kernen der elementaren Lebensformen stammt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940261
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940261,
					"content": "Heute probieren wir den ersten Schritt aus, das Sammeln von Rohmaterial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940262
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940262,
					"content": "Hier, nimm dieses Materialsammelgerät. Denke daran, alles, was du sammelst, direkt in den Sammler zu legen, damit es nicht durch andere Elemente verunreinigt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940263
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940263,
					"content": "Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940264
					]
				},
				{
					"id": 726940264,
					"content": "Danke. Lass mich das Gerät ein letztes Mal einstellen. Ich zähle auf dich, um die Materialien zu sammeln!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940223,
					"content": "„Auch“ gesucht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940224
					]
				},
				{
					"id": 726940224,
					"content": "Haha, das ist eine lange Geschichte. Ich wurde einmal wegen eines kleinen Unfalls von der Tenryou-Verwaltung verhaftet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940225
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940213,
					"content": "Du hast eine Anfrage bei der Abenteurergilde gestellt, stimmt’s?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940214
					]
				}
			]
		},
		{
			"id": 7269403,
			"completionStepIds": [],
