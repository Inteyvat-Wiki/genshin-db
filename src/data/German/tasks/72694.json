			},
			"dialogs": [
				{
					"id": 726940301,
					"content": "Hast du die Materialien mit dem Sammelgerät gesammelt? Die Ausgangsmaterialien spielen eine entscheidende Rolle bei der Gestaltung der Spielzeuge. Sei vorsichtig mit deiner Wahl, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				}
			]
		},
		{
			"id": 7269404,
			"completionStepIds": [
				7269404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269404",
							"2"
						],
						"stepId": 7269404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940401,
					"content": "Wie läuft’s? Hast du schon Materialien gesammelt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940402
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940402,
					"content": "Sie sind alle im Sammler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940403
					]
				},
				{
					"id": 726940403,
					"content": "Na gut, dann füge ich die Materialien zu meiner einzigartigen, nie versagenden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940404
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940404,
					"content": "Das ist die „Große Maschine“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940405,
					"content": "Gut. Lass mich die Materialien der Großen Maschine hinzufügen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940406
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940406,
					"content": "Bertrand verbindet den Sammler mit der Großen Maschine.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726940407
					]
				},
				{
					"id": 726940407,
					"content": "Ooh! Und was kommt als Nächstes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940408,
					"content": "Wird die Maschine „tuck, tuck, tuck“ machen und dann das Spielzeug mit „Knistern und Krachen“ ausschütten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940409,
					"content": "Hahaha, das ist total ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940410
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940410,
					"content": "Unmöglich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940411
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940411,
					"content": "Was denkst du gerade? Das ist nur der erste Schritt der drei Prozesse. Wir sind weit davon entfernt, alles erledigt zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940412
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940412,
					"content": "Paimon hat es verstanden, wir müssen also alle Prozesse abschließen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940413,
					"content": "Ja, wir brauchen alle drei Prozesse, um das Spielzeug herzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940414,
						726940415
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940414,
					"content": "Ganz schön viel verlangt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940416
					]
				},
				{
					"id": 726940416,
					"content": "Hör dir mal zu, immer willst du eine schnelle Lösung. Es braucht Geduld, um Spielzeug herzustellen. Wir müssen jeden Prozess mit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940417
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940417,
					"content": "Womit? Oh, Paimon hat es verstanden. Wir stellen schließlich Spielzeug her, also müssen wir jeden Prozess mit echter Leidenschaft erfüllen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940418,
					"content": "Ja, meine Leidenschaft für Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940419
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940419,
					"content": "Äh ... Das war zwar nicht das, was Paimon gedacht hat, aber Paimon teilt diese Meinung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940420,
					"content": "He ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940421
					]
				},
				{
					"id": 726940421,
					"content": "Hehe, Paimon hat nur versucht, sich zu unterhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940422,
					"content": "Was machen wir als Nächstes, Bertrand? Sollen wir mit den folgenden Prozessen weitermachen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940423,
					"content": "Keine Eile. Da ich die Maschine erst kürzlich eingestellt habe und dieses spezielle Verfahren noch nicht getestet wurde, muss ich prüfen, ob es mit den Materialien gut funktioniert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940424
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940424,
					"content": "Das braucht etwas Zeit. Bitte kommt später wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940415,
					"content": "Das ist so viel Arbeit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940416
					]
				}
			]
		},
		{
			"id": 7269405,
