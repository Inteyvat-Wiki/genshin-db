			"dialogs": [
				{
					"id": 760860101,
					"content": "Nachthimmel ... der Mond ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760860102
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760860102,
					"content": "Sie scheint wieder „Mondschach“ spielen zu wollen. Lasst uns zu ihr gehen und mit ihr spielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760860103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760860103,
					"content": "Hm? Ihr seid es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760860104
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760860104,
					"content": "Möchtest du eine Partie spielen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760860105
					]
				},
				{
					"id": 760860105,
					"content": "Gerne. Ich bereite den Nachthimmel für dich vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				}
			]
		},
