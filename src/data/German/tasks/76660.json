			"dialogs": [
				{
					"id": 766600101,
					"content": "#Willkommen, Abenteurer{F#in}. Soll ich für dich nach den heutigen Missionen sehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600102,
						766600103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 766600102,
					"content": "So fühlt es sich doch am vertrautesten an ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600104
					]
				},
				{
					"id": 766600104,
					"content": "Ähm, bist du ... in Eile? Womit kann ich dir behilflich sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600105,
						766600106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 766600105,
					"content": "Ach, nein, so ist es nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600107
					]
				},
				{
					"id": 766600107,
					"content": "Wir freuen uns einfach, dich zu sehen! Hehe, du bist einfach die Beste, Katheryne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766600108,
					"content": "Danke für eure Freundlichkeit ... Verzeihung, ich fürchte, ich habe euren Humor nicht ganz verstanden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 766600109,
					"content": "Aber wie dem auch sei, willkommen in Nod-Krai, einem Land voller Möglichkeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 766600110,
					"content": "Ich bin mir sicher, dass du hier großartige Abenteuer erleben und unvergleichliche Schätze finden wirst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 766600111,
					"content": "#Mögest du gesegnet sein, Abenteurer{F#in}. Setze deine Abenteurer fort. Ad astra abyssosque! Zu den Sternen und Abgründen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 766600106,
					"content": "Wir ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600107
					]
				},
				{
					"id": 766600103,
					"content": "Zum Glück bist du es, Katheryne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600104
					]
				}
			]
