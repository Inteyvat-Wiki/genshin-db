			"dialogs": [
				{
					"id": 190940701,
					"content": "... Mit Kaeya ist recht schwierig auszukommen, aber der kostenlose Wein ist wirklich gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190940702
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 190940702,
					"content": "Venti, du kannst dich weigern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190940703
					]
				},
				{
					"id": 190940703,
					"content": "Ich verstehe die Regeln der Favonius-Kathedrale in Bezug auf den Chorgesang nicht wirklich, aber das ist schon in Ordnung. Solange sie die Musik wirklich genießen, kann ich mithelfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190940704,
						190940705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 190940704,
					"content": "Das klingt nach ziemlich viel Arbeit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190940706
					]
				},
				{
					"id": 190940706,
					"content": "Nun gut, ich bin glücklich, die Ordensschwester ist glücklich, das Publikum ist glücklich, ist doch toll, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 190940705,
					"content": "Ist der Grund wirklich nicht der Wein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190940706
					]
				}
			]
		},
