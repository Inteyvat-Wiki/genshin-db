			"dialogs": [
				{
					"id": 762260101,
					"content": "Sieh mal, Maalaus, wir haben alle deine Bilder zurückgeholt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260102,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260103
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 762260103,
					"content": "Hehe, keine Ursache. In den Bildern steckt schließlich auch ein bisschen von uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260104,
					"content": "Seit wann versteht Paimon, was Maalaus sagt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260105
					]
				},
				{
					"id": 762260105,
					"content": "Ach was, Paimon war doch schon sooo oft mit dir im Silbermondhof! Da ist es doch klar, dass Paimon versteht, was Maalaus meint.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260106,
					"content": "Und wie sind die Bilder laut Maalaus verschwunden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260107
					]
				},
				{
					"id": 762260107,
					"content": "Äh ... also ... warte mal, Paimon übersetzt das kurz ... Maalaus sagt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260108,
					"content": "Vielleicht haben andere Kuuhenki sie gestohlen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260109,
					"content": "Hmm ... Oder diese seltsamen Transportmaschinen auf dem Mond haben sie einfach eingesammelt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260110,
					"content": "Hmm ... Es könnte auch sein, dass Columbina sie gestohlen hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260111,
					"content": "Das ist doch absolut unmöglich!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260112
					]
				},
				{
					"id": 762260112,
					"content": "Hä? Stimmt ... Hat Paimon das etwa falsch verstanden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260113,
					"content": "Das war also nur wild geraten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260114
					]
				},
				{
					"id": 762260114,
					"content": "Hehe, eine Fremdsprache zu lernen, ist doch nicht so einfach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260115,
					"content": "Alles, was Paimon braucht, ist eine gute Lehrerin. Wenn sich die Gelegenheit ergibt, bittet Paimon Columbina darum, Paimon alles richtig beizubringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
