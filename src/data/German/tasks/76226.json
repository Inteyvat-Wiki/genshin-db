			"dialogs": [
				{
					"id": 762260201,
					"content": "Hä? Ist das nicht Maalaus? Paimon hätte wirklich nicht erwartet, dass wir uns auf dem Mond treffen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260202,
					"content": "Es war bestimmt Columbina, die dich hierher gebracht hat, oder? Sie hat doch gesagt, dass sie deine Bilder auf dem Mond ausstellen will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260203,
					"content": "Ach ja ... wo wir gerade davon sprechen ... wo sind eigentlich deine Bilder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260204,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260205
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 762260205,
					"content": "Was ist los? Sind ... die Bilder etwa verschwunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260206,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260207
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 762260207,
					"content": "Wie kann das sein? Wir sind doch hier auf dem Mond ... die Bilder können doch nicht geklaut worden sein?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260208,
					"content": "Wie auch immer, wir sollten Maalaus erst mal helfen, die Bilder zu suchen. Vielleicht wurden sie ja einfach nur irgendwo hier in der Nähe liegengelassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
