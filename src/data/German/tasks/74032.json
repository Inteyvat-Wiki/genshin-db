				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lechlade"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320401,
					"content": "Wir sind wieder da. Der Arzt ließ uns das hier dir geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320402,
					"content": "Lechlade nimmt das „Reine Wasser“ und trinkt es ganz aus.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740320403
					]
				},
				{
					"id": 740320403,
					"content": "Ich fühle mich viel besser! Die Vitalität ist zurück in meinem Körper!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320404,
						740320406
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320404,
					"content": "So schnell?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320405
					]
				},
				{
					"id": 740320405,
					"content": "Das wirkt aber echt schnell!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320408,
					"content": "Arderne ist wirklich ein qualifizierter Arzt. Seine Medizin ist sehr wirksam. Und ich bin im Gegenteil ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320409
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320409,
					"content": "Was die gelbgrünen Steine betrifft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320410,
					"content": "Sie sind ein großes Problem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320411
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320411,
					"content": "Äh ... Anscheinend sind die Kopfschmerzen kuriert, aber das andere Problem ist wohl noch nicht gelöst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320412,
					"content": "Jetzt kann ich weiterarbeiten. Ich danke euch, dass ihr den Weg auf euch genommen habt. Nehmt diese Tauschscheine, sie sind ein kleines Geschenk von mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320413
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320413,
					"content": "Möget ihr gesund bleiben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320406,
					"content": "Ich glaube, du bist gar nicht krank ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320407
					]
				},
				{
					"id": 740320407,
					"content": "Die Krankheit ist echt und die Medizin ist auch echt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320408
					],
					"speakerTitle": "Lechlade"
				}
			]
		},
