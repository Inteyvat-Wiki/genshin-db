			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Lechlade"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320201,
					"content": "Diese gelbgrünen Steine ... Mit ihnen muss etwas nicht stimmen ... Ich werde hier sterben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320202
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320202,
					"content": "Äh ... Geht es dir gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320203,
					"content": "... Auf lange Sicht wird es uns allen „gut gehen“. Es ist nur so, dass es mir zuerst „gut gehen“ wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320204,
						740320206
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320204,
					"content": "Wenn alles gut ist, dann tschüs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320205
					]
				},
				{
					"id": 740320205,
					"content": "Nein, warte! Das hört sich doch nicht so an, als ginge es ihm wirklich gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320208,
					"content": "Nein, mir geht es wirklich gut. Wenn es ein Problem gäbe, dann wäre es wohl schon zu spät, etwas zu tun ... *schluchz* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320209
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320209,
					"content": "Also gibt es nun etwas, oder nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320210
					]
				},
				{
					"id": 740320210,
					"content": "Paimon ist nun verwirrt ... Kannst du es nicht klarer ausdrücken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320211,
					"content": "Um es klar zu sagen, in letzter Zeit bekomme ich Kopfschmerzen, kalte Hände und Füße und gelegentliches Herzrasen, immer wenn ich den Produktionstrakt betrete ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320212
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320212,
					"content": "Mit mir geht es bestimmt zu Ende! Versteht ihr, was ich meine? Ich werde sterben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320213
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320213,
					"content": "Es muss an diesen gelbgrünen Steinen liegen ... Das sind sehr böse Steine! Sicherlich wisst ihr schon, oder? Das Zentrallaboratorium des Forschungsinstituts Fontaine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320214
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320214,
					"content": "Argh, diese gelbgrünen Steine, sie haben alles ruiniert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320215,
						740320216
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320215,
					"content": "Du solltest besser zum Arzt gehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320217
					]
				},
				{
					"id": 740320217,
					"content": "Ich bin selbst Arzt! Oh, nein, ich bin kein Arzt mehr ... Ich habe meine Approbation verloren und darf nicht mehr Patienten behandeln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320218
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320218,
					"content": "Ich flehe euch an, findet einen richtigen Arzt, einen approbierten Arzt, und lasst ihn mich retten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320219
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320219,
					"content": "#Hmm, er scheint schwer krank zu sein ... {NICKNAME}, komm, wir gehen einen Arzt suchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320216,
					"content": "Wie wäre es, wenn du dich in der Klinik ein wenig ausruhst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320217
					]
				},
				{
					"id": 740320206,
					"content": "Du scheinst mit dem Wort „gut“ etwas anderes zu meinen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320207
					]
				},
				{
					"id": 740320207,
					"content": "Das hört sich überhaupt nicht so an, als ginge es dir wirklich gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320208
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7403203,
			"completionStepIds": [
				7403203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7403203",
							"2"
						],
						"stepId": 7403203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arderne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320301,
					"content": "Ist euch etwas zugestoßen? Oder ist jemand anderes in Schwierigkeiten? Ihr seht beide gesund aus, also muss es jemand anderes sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320302
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320302,
					"content": "Tatsächlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320303,
					"content": "Ihr erklärt ihm Lechlades Situation ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740320304
					]
				},
				{
					"id": 740320304,
					"content": "Er schon wieder ... Das ist sein altes Leiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320305
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320305,
					"content": "Gibt es eine Heilung dafür?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320306
					]
				},
				{
					"id": 740320306,
					"content": "Meinst du seine Kopfschmerzen oder seine Paranoia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320307
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320307,
					"content": "Hä? Das heißt, er hat überhaupt keine Krankheit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320308,
					"content": "Den Ergebnissen der bisherigen Untersuchungen zufolge hat er keine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320309
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320309,
					"content": "Man sagt, er habe einen Patienten falsch diagnostiziert, als er noch draußen war, und einige frühe Symptome übersehen, was dazu führte, dass der Patient ... *seufz* Na ja, vielleicht ist er deswegen seitdem etwas paranoid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320310
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320310,
					"content": "Gegenüber anderen so, und noch schlimmer, wenn es um sich selbst geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320311
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320311,
					"content": "Also sind diese gelbgrünen Steine kein Problem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320312
					]
				},
				{
					"id": 740320312,
					"content": "Siehst du nicht, dass alle anderen außer ihm gesund und munter sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320313
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320313,
					"content": "Aber dennoch sollten wir es nicht unbeachtet lassen. Bitte bringt ihm das hier mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320314
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320314,
					"content": "Ist ... Ist das nicht „Reines Wasser“? Bist du sicher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320315,
					"content": "Oh, ihr wisst also, was das ist. Kein Problem, zumindest schadet es der Gesundheit nicht und kann ihn sogar aufmuntern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320316,
						740320318
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320316,
					"content": "Wird er das nicht erkennen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320317
					]
				},
				{
					"id": 740320317,
					"content": "Soweit ich weiß, lehnt er derlei Getränke ab. Aber ich habe ihm schon einmal einige Getränke gegeben und ihm gesagt, sie seien Heiltränke, und er zeigte tatsächlich mehr Vitalität, nachdem er sie getrunken hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320322
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320322,
					"content": "Na gut, dann bringen wir ihm erst einmal das hier mit. Falls es nicht hilft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320323,
					"content": "Dann lasst ihn sich eine Weile in die Klinik legen. Sagt ihm, das ist ein ärztlicher Rat. Er wird gehorchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320324
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320324,
					"content": "#Gut, {NICKNAME}, dann gehen wir zurück zu ihm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320318,
					"content": "Warum gibst du ihm nicht einfach Fonta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320319
					]
				},
				{
					"id": 740320319,
					"content": "Nun, hier gibt es niemanden, der den Geschmack von Fonta nicht kennt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320320
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320320,
					"content": "Aber soweit ich weiß, hat er „Reines Wasser“ noch nicht probiert. Schließlich ist dessen Verbreitung relativ begrenzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320321
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320321,
					"content": "Ich habe ihm schon einmal welche gegeben und ihm gesagt, sie seien Heiltränke, und er zeigte tatsächlich mehr Vitalität, nachdem er sie getrunken hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320322
					],
					"speakerTitle": "Arderne"
				}
			]
		},
		{
			"id": 7403204,
			"completionStepIds": [
				7403204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
