			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710051201,
					"content": "„Gier, Nostalgie, Träume, Eifersucht, Zorn, Wollust, Selbstherrlichkeit, Wetteifer, Streit ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051202
					],
					"speakerTitle": "Inschrift"
				},
				{
					"id": 710051202,
					"content": "„Diese neun Begierden der Sterblichen mögen die Welt heilen oder ihr großen Schaden zufügen. Ihr Feuer wird niemals erlöschen, und niemals vergehen ... So errichten wir neun Säulen, um Frieden zu bringen, damit die Konflikte, die diese Welt plagen, ein Ende finden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051203
					],
					"speakerTitle": "Inschrift"
				},
				{
					"id": 710051203,
					"content": "„Wenn jemand, der nach uns kommt, diese Säulen zerbricht und eintritt, wird der Krieg die Welt erneut verzehren.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051204
					],
					"speakerTitle": "Inschrift"
				},
				{
					"id": 710051204,
					"content": "„O die Ihr diese Tafel lest, nehmt den Schatz in Anspruch, der darin liegt, und bringt Frieden nach Liyue.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inschrift"
				}
			]
		},
