				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bolai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050301,
					"content": "Kannst du uns helfen, diese Antiquität zu begutachten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050302
					]
				},
				{
					"id": 710050302,
					"content": "Antiquitäten und Kuriositäten? Ich kenne mich nicht allzu gut aus, aber ich schaue sie mir an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050303
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050303,
					"content": "Dieser Ring ... Hm, er ist besetzt mit einem Jade-Edelstein, und dazu noch von hoher Qualität. Allein der Edelstein wäre schon eine Menge wert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050304
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050304,
					"content": "Darauf ist auch eine Inschrift: „Das Unheil wütet auf der ganzen Welt, und alle Menschen erleiden Höllenqualen ...“ Wo hast du diesen Ring gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050305
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050305,
					"content": "In einer Ruine am Abhang von Cuijue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050306
					]
				},
				{
					"id": 710050306,
					"content": "Der Abhang von Cuijue, hm ... Tss tss, was für eine Schande. Der Jueyun-Karst ist auch in der Nähe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050307
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050307,
					"content": "Wenn dieser Ring aus einer Ruine im Jueyun-Karst stammt, würde er sicherlich einen hohen Preis erzielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050308
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050308,
					"content": "Leider fällt ohne jede geschichtliche Quelle der Preis für diesen hier sehr stark. Aber es ist von guter Qualität. Ich bin sicher, dass irgendjemand ihn trotzdem haben möchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050309
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050309,
					"content": "Wie wäre es damit? Ich biete dir <color=#00E1FFFF>180.000 Mora</color> für diesen Ring und dazu ein paar kleine Zugaben. Würdest du ihn mir verkaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
		{
			"id": 7100504,
