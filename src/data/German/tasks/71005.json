			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050101,
					"content": "„Das Unheil aller Welten quillt aus dem Bösen im Herzen der Menschen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050102
					],
					"speakerTitle": "Inschrift"
				},
				{
					"id": 710050102,
					"content": "„Neun Säulen errichten wir hier, um den Streit zu ersticken, damit wir nie wieder Armeen gegeneinander erheben können ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inschrift"
				}
			]
		},
		{
			"id": 7100502,
			"completionStepIds": [
				7100531
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7100531",
							"2"
						],
						"stepId": 7100531,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050201,
					"content": "Diese Ruine bereitet Paimon Angst. Aber das sollte das Ende sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710050202,
					"content": "Und wir haben auch einige Schätze für unsere Mühen erhalten - sogar diesen Ring haben wir bekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710050203,
					"content": "Finden wir jemanden, der ein <color=#00E1FFFF>Auge für Antiquitäten</color> hat und finden wir heraus, für wie viel wir das verkaufen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7100503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
