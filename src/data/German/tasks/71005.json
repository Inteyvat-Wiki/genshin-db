				"objectNames": [
					"Bolai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050501,
					"content": "Mal nachdenken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050502
					]
				},
				{
					"id": 710050502,
					"content": "Du ... Na gut. Überlege es dir. Vielleicht ist mein Angebot nicht das beste, das du bisher bekommen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050503
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050503,
					"content": "Aber wenn es ums Geschäft geht, tust du gut, wenn du ihn mir verkaufst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050504
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050504,
					"content": "Denk darüber nach. Dieser Ring wird ständig den Besitzer wechseln. Wenn du ihn mir jetzt verkaufst, meinst du nicht, dass ich dich in alle weiteren Geschäfte einweihen werde, die in der Zukunft stattfinden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050505
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050505,
					"content": "Außerdem wäre ich durchaus gewillt, noch ein paar Dinge hinzuzufügen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050506
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050506,
					"content": "Denk sorgfältig darüber nach. Falls du dich zum Verkauf entscheiden solltest, komm jederzeit zu mir zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
