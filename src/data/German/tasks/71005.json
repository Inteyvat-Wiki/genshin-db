					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050901,
					"content": "Kannst du uns helfen, diese Antiquität zu begutachten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050902
					]
				},
				{
					"id": 710050902,
					"content": "Eine Antiquität? Dann bist du hier genau richtig. Ich würde sagen, dass ich in ganz Liyue der gerechteste im Schätzen solcher Dinge bin. Lass mich mal sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050903
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050903,
					"content": "Hmm, sowohl der Edelstein als auch das Band sind von ausgezeichneter Qualität, und es ist uralt ... Dennoch ist alles sehr gut erhalten - sehr ungewöhnlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050904
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050904,
					"content": "Trotzdem habe ich den Satz „Das Unheil wütet auf der ganzen Welt, und alle Menschen erleiden Höllenqualen ...“ noch nie gehört ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050905
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050905,
					"content": "Egal. Wo hast du diesen Ring gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050906
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050906,
					"content": "In einer Ruine am Abhang von Cuijue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050907
					]
				},
				{
					"id": 710050907,
					"content": "Du ... Du besitzt ein gutes Händchen dafür, nicht wahr? Nicht viele trauen sich dorthin, um nach Schätzen zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050908
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050908,
					"content": "Waren diese Ruinen zufällig von neun Säulen mit einer Steintafel in der Mitte umringt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050909
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050909,
					"content": "Guck nicht so überrascht. Viele Leute, die mit mir Geschäfte machen wollen, haben diesen Ort erwähnt. Sie behaupten immer, dass eine so große Anordnung eine Art Schatz verbergen muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050910
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050910,
					"content": "Sie behaupten sogar, dass diese Säulen und diese Ruine von den Vorfahren von Liyue errichtet wurden, um Konflikte zu unterdrücken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050911
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050911,
					"content": "Aber ich vermute, dass das nur eine Legende ist. Wenn neun Steinsäulen den Konflikt beilegen könnten, wäre diese Welt schließlich schon lange zum Frieden gekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050912
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050912,
					"content": "Aber ganz gleich, ob diese Legende wahr ist oder nicht, dieser Ring wurde in dieser Ruine gefunden und muss daher irgendwie mit dieser Legende zu tun haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050913
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050913,
					"content": "Er hat einen Namen, eine passende Geschichte, und er ist auch von guter Qualität. Es wird einen guten Preis einbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050914
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050914,
					"content": "Ganz ruhig, ich werde nicht fragen, wie du da hineingekommen bist. Ich betreibe nur Geschäfte. Alles andere geht mich nichts an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050915
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050915,
					"content": "Alles in allem würde ich sagen, dass dieser Ring <color=#00E1FFFF>200.000 Mora</color> wert ist. Was meinst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
