			},
			"dialogs": [
				{
					"id": 710050401,
					"content": "Verkauft.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050402
					]
				},
				{
					"id": 710050402,
					"content": "Herrlich! Sehr entschlossen. Hier ist das Geld. Er gehört dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050403
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050403,
					"content": "Ah, dieser Ring ist ein echter Schatz ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050404
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050404,
					"content": "Es muss noch weitere solcher Edelsteine in diesen Ruinen geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
		{
			"id": 7100505,
			"completionStepIds": [
				7100535
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
