			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850801,
					"content": "Herzlichen Glückwunsch! Dies ist dein Flugschein. Ab jetzt bist du legal in Mondstadt unterwegs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850802
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850802,
					"content": "Deine Flugtechnik ist so toll. Du hättest gar nicht durchfallen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850803,
						4850804
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850803,
					"content": "Ja, es war einfach.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850805
					]
				},
				{
					"id": 4850805,
					"content": "Genau! Ich werde dich für die nächsten Flugmeisterschaften von Mondstadt anmelden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850806
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850806,
					"content": "Ich bin so schnell, dass es keinen gibt, der mich einholen kann. Deshalb bin ich immer allein unterwegs und das ist echt langweilig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850807,
						4850808
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850807,
					"content": "Toll! Dann werde ich die Meisterschaften gewinnen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850809
					]
				},
				{
					"id": 4850809,
					"content": "Du nimmst große Worte in den Mund! Hehehe ... Ganz offensichtlich weißt du noch gar nicht, wie verrückt die Flugmeisterschaften sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850810
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850810,
					"content": "Na gut, bevor ich dich mit großem Vorsprung besiege, hoffe ich, dass du legal, frei und fröhlich mit deinem Windgleiter durch die Lüfte fliegst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850811
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850811,
					"content": "Beachte auf jeden Fall die Flugvorschriften von Mondstadt! Sonst wird dir der Flugschein entzogen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850812
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850812,
					"content": "Dieser Satz klingt rein gar nicht überzeugend, wenn er aus deinem Mund kommt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850808,
					"content": "Dann wirst du keine Chance auf den Meistertitel haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850809
					]
				},
				{
					"id": 4850804,
					"content": "Es war schon ziemlich schwierig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850805
					]
				}
			]
		},
