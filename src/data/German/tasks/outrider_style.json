			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4851101,
					"content": "Hier gibt es nur diesen einen Weg. Der komische Vogel muss also dort sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851102,
					"content": "Sieht aus, als könnte man nur mit dem Windgleiter weiterkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851103,
					"content": "Aber dort unten sind so viele Monster. Sie werden uns sicher angreifen, sobald wir losgeflogen sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4851104,
					"content": "Wenn wir es schaffen wollen, müssen wir <color=#00E1FFFF>gleichzeitig fliegen und angreifen</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851105,
					"content": "#Stimmt ja, {NICKNAME}. Ein Teil deiner Prüfung steht doch noch offen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851106,
					"content": "Ja, aber was soll das jetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4851107,
					"content": "#Wie wäre es, wenn wir das gleich als Prüfungsthema für {NICKNAME} bestimmen würden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851108,
					"content": "Ist das Prüfungsthema wirklich richtig so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4851109,
					"content": "#Sagen wir, es ist eine Sonderausführung der Prüfung für {NICKNAME}, die an die vorherrschenden Verhältnisse angepasst ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851110,
					"content": "#Schließlich ist {F#sie die Heldin, die}{M#er der Held, der} Mondstadt gerettet hat. Da ist eine stinknormale Prüfung eh nicht angemessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851112,
					"content": "Ich werde die Prüfung schaffen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4851113,
					"content": "Ich werde den komischen Vogel fangen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4851111,
					"content": "#{NICKNAME}, was denkst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851114,
					"content": "Hehe, gute Antwort!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851115,
					"content": "#Dann flieg los, {NICKNAME}. <color=#00E1FFFF>Besiege alle Feinde</color> und schon hast du den komischen Vogel und deinen Flugschein so gut wie in der Hand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		}
	]
