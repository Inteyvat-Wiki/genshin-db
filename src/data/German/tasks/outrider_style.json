			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850301,
					"content": "Hier geht es wohl nicht weiter ... Der Kerl muss sich hier versteckt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850302
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850302,
					"content": "Amber, sieh mal da!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850303,
					"content": "Ihr habt mich tatsächlich eingeholt, aber was soll’s ... Hm? Was soll denn das Mädchen hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850304
					],
					"speakerTitle": "Komischer Vogel"
				},
				{
					"id": 4850304,
					"content": "Du bist also der „komische Vogel“! Du entkommst uns nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850305
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850305,
					"content": "Hahaha! Das brauche ich gar nicht, weil ihr es überhaupt nicht schafft herüberzukommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850306
					],
					"speakerTitle": "Komischer Vogel"
				},
				{
					"id": 4850306,
					"content": "Puh, dieser Abgrund ist wirklich steil ... und echt weit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850307
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850307,
					"content": "He, kleines Mädchen! Warum gehst du nicht zurück und petzt? Vielleicht kommt dann der Großmeister und holt mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850308
					],
					"speakerTitle": "Komischer Vogel"
				},
				{
					"id": 4850308,
					"content": "Willst du mich, die Kundschafterin des Ordo Favonius provozieren? Du wirst schon sehen, wenn ich hinüberfliege und dich festnehme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850309,
						4850310
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850309,
					"content": "Beruhige dich wieder.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				},
				{
					"id": 4850311,
					"content": "Hm, da hast du recht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850312
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850312,
					"content": "So ein Mist! Er steht direkt vor uns. Ich würde am liebsten gleich hinüberfliegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850313
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850313,
					"content": "Wie ist der komische Vogel aber dorthin gekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850314,
						4850317,
						4850319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850314,
					"content": "Vielleicht gibt es ja eine Vorrichtung dafür.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850315
					]
				},
				{
					"id": 4850315,
					"content": "Ich kann keine Spur von irgendeiner Vorrichtung sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850316
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850316,
					"content": "Außerdem gibt es hier in der Gegend keine Stelle, wo man eine solche Vorrichtung bauen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850322,
					"content": "Tschüs, ihr Idioten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850323
					],
					"speakerTitle": "Komischer Vogel"
				},
				{
					"id": 4850323,
					"content": "Nein, er haut ab!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850324,
					"content": "Wir zögern zu lange! Es gibt einfach keinen anderen Weg, als hinüberzufliegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850325
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850325,
					"content": "Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850326,
					"content": "Keine Angst, ich bin die Flugmeisterin von Mondstadt. Wenn der komische Vogel es schafft, dann schaffe ich es auch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850327
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850327,
					"content": "He, Kundschafterin, wenn du sterben willst, kannst du auch gleich ohne Windgleiter von der großen Statue in Mondstadt springen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850328,
						4850329
					],
					"speakerTitle": "Komischer Vogel"
				},
				{
					"id": 4850328,
					"content": "Ich stimme Amber zu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850330,
					"content": "#Das stimmt allerdings ... {NICKNAME}, wir können alle Möglichkeiten außer Fliegen komplett ausschließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850331,
					"content": "#{NICKNAME}, weißt du noch, dass ich dir das falsche Buch gegeben habe und nicht den Flugratgeber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850332
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850332,
					"content": "„Die ersten Vögel konnten nicht fliegen. Die Fähigkeit zu fliegen ist die Belohnung für ihren Mut, in den Abgrund zu springen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850333
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850333,
					"content": "Und jetzt sei mein Zeuge!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850334
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850334,
					"content": "Du schaffst das, Kundschafterin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850335
					]
				},
				{
					"id": 4850335,
					"content": "Jawohl! Jetzt zeigen wir diesem Kerl, aus welchem Holz ein Kundschafter geschnitzt ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850336
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850336,
					"content": "Nein, jetzt mach keine Dummheiten! Du schaffst es doch nie bis hier. Geh brav zurück, kleines Mädchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850337
					],
					"speakerTitle": "Komischer Vogel"
				},
				{
					"id": 4850337,
					"content": "Findest du das wirklich? Hm, was ist das? Wenn man genau hinhört, ist da so ein Geräusch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850338
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850338,
					"content": "Der Wind sagt, ich werde es schaffen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850329,
					"content": "Es braucht zwar Überwindung, aber es ist zu schaffen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850317,
					"content": "Ist es eine Art Elementarmagie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850318
					]
				},
				{
					"id": 4850318,
					"content": "#{NICKNAME}, kannst du mit deinem Elementarblick etwas sehen? ... Nein? Wäre auch zu schön gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850319,
					"content": "Hat er einen Haken oder etwas anderes Spitzes benutzt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850320
					]
				},
				{
					"id": 4850320,
					"content": "Man kann ja noch nicht einmal dorthin fliegen. Dann kann man erst recht nichts hinwerfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850321,
					"content": "Sieht auch nicht aus, als wäre da irgendwo eine Befestigung gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850310,
					"content": "Du hast mir doch beigebracht, dass man sich immer gut umsehen sollte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				}
			]
		},
		{
			"id": 48506,
			"completionStepIds": [
				48506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48506",
							"2"
						],
						"stepId": 48506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850601,
					"content": "Wir haben den komischen Vogel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850602
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850602,
					"content": "Das Windfeld spürt man nur, wenn man schon in der Luft ist. Es ist das einzige hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850603
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850603,
					"content": "Der komische Vogel hätte Selbstmord begangen, wenn er in diese Richtung geflohen wäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850604
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850604,
					"content": "Wenn er wirklich hätte fliehen wollen, hätte er wieder denselben Weg zurück nehmen und an uns vorbeigehen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850605
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850605,
					"content": "Deswegen hat er die ganze Zeit so getan, als wäre er im Vorteil. Er wollte einfach nur, dass wir umdrehen, damit er abhauen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850606,
					"content": "Er hat einfach nicht damit gerechnet, dass mit uns nicht zu spaßen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850607,
					"content": "#{NICKNAME} hat es richtig erkannt: „Wenn du das Unmögliche ausgeschlossen hast, dann ist das, was übrig bleibt, die Wahrheit, wie unwahrscheinlich sie auch ist.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850608
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850608,
					"content": "Zum richtigen Fliegen braucht man schließlich drei Teile Technik und sieben Teile Bauchgefühl. Die restlichen 90 Prozent müssen mit Mut aufgefüllt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850609
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850609,
					"content": "Was du eben getan hast, sah mehr nach 99 Prozent Mut aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850610,
					"content": "Hach ja, ganz wie in meiner eigenen Flugscheinprüfung ... Ich war zwar total aufgeregt, habe dann aber den Flugschein ohne Probleme erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850611
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850611,
					"content": "Bei den Prüfungen danach hatte ich nie wieder dieses aufregende Gefühl. Da hat immer etwas gefehlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850612
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850612,
					"content": "Warte mal ... Du hast doch den Flugschein bekommen. Wofür waren die Prüfungen danach?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850613,
					"content": "Na ja, in Mondstadt ist es an so vielen Stellen verboten zu fliegen oder zu landen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850614
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850614,
					"content": "Mein Flugschein wird mir immer wieder entzogen. Mittlerweile muss ich die Prüfung schon an die 15-mal gemacht haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850615
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850615,
					"content": "Aber jedes Mal schaffe ich es beim ersten Anlauf. Mein kleiner Flugratgeber scheint Wunder zu wirken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850616
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850616,
					"content": "#{NICKNAME}, besorgen wir uns bei Gelegenheit den echten Ratgeber bei Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850617,
						4850618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850617,
					"content": "In Ordnung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850619
					]
				},
				{
					"id": 4850619,
					"content": "Ich werde den komischen Vogel jetzt zurück nach Mondstadt bringen. Damit werde ich erst einmal beschäftigt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850620
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850620,
					"content": "Sobald du wieder in Mondstadt bist, solltest du in der Kathedrale nach mir suchen. Dann werde ich dir den Flugschein ausstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850618,
					"content": "Jean hat immer viel zu tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850619
					]
				}
			]
		},
		{
			"id": 48508,
			"completionStepIds": [
				48508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48508",
