					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745240401,
					"content": "#Ach, wenn das nicht {F#die Kleine}{M#der Kleine} ist! Hast du etwa von meinen heutigen Plänen erfahren und bist extra hergekommen, um mich zu sehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240402,
						745240403
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240402,
					"content": "Warst du gerade beim Shogun, Miko?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				},
				{
					"id": 745240404,
					"content": "Hehe, du hast eine feine Nase. Ich habe nur ein paar Süßigkeiten und die aktuell angesagteste kurze Erzählung für eine Freundin mitgebracht, die nicht gern rausgeht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240405
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240405,
					"content": "Liest Ei jetzt auch solche Dinge?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240406
					]
				},
				{
					"id": 745240406,
					"content": "Sie möchte dadurch einen Eindruck davon bekommen, wie sich die Freizeitgestaltung und Interessen der Menschen in Inazuma in letzter Zeit entwickelt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240407
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240407,
					"content": "Gerade eben hat sie noch mit mir darüber diskutiert. Anfangs analysierte sie noch ganz ernst den Inhalt der Geschichte und die darin erkennbaren Vorlieben der Leser ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240408
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240408,
					"content": "... aber dann fragte sie mich plötzlich ganz neugierig: „Also, wie geht es mit dem Protagonisten am Ende aus?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240409
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240409,
					"content": "Hehe, offenbar kann selbst Ei dem Reiz einer guten Geschichte nicht widerstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240410,
						745240411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240410,
					"content": "Dein Gesichtsausdruck gerade ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240412,
					"content": "Oh? Also das ist der wahre Grund für deinen heutigen Besuch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240413
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240413,
					"content": "Verstehe. Du vermisst mich bestimmt oft auf deiner Reise und möchtest deshalb ein paar Fotos als Andenken machen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240414
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240414,
					"content": "Dann überlasse ich es dir. Such einfach einen guten Winkel aus, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240411,
					"content": "Das ist definitiv einen Schnappschuss wert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240403,
					"content": "Ich rieche etwas Süßes ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				}
			]
		}
	]
}