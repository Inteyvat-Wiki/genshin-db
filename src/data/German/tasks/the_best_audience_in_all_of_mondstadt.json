						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630201,
					"content": "Wann werde ich wohl endlich auch ein großer Abenteurer sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630202
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630202,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630203
					]
				},
				{
					"id": 200630203,
					"content": "Oh, du bist es. Cyrus hat mir gestern eine Abenteuergeschichte erzählt. Diesmal ging es um die <color=#00E1FFFF>Windblickberge</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630204
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630204,
					"content": "Er hat Folgendes gesagt: „Dieser enorme Schild war wie ein Gebilde aus einem Albtraum. So fest ich auch zuschlug, der Schild schien keinen Kratzer abzubekommen. Währenddessen schielte mich das Monster hinter dem Schild an und fletschte seine Zähne.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630205
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630205,
					"content": "Wie gern ich diesen Holzschild sehen würde, der allen Angriffen standhält!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630206
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630206,
					"content": "Ich habe aber noch so viel zu tun, dass ich einfach keine Zeit dafür habe. Was muss das wohl für ein Monster sein, das einen solchen Gegenstand besitzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630207
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630207,
					"content": "Bist du auch daran interessiert, die Wahrheit über dieses Monster herauszufinden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630208,
						200630210
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630208,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630209
					]
				},
				{
					"id": 200630209,
					"content": "Vielen Dank! Du bist großartig! Erzähl mir alles, wenn du wieder hier bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630210,
					"content": "Wir können doch auch zusammen gehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630211
					]
				},
				{
					"id": 200630211,
					"content": "Zusammen? Tut mir leid, ich habe noch so viel für die Abenteurergilde zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630212
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630212,
					"content": "Bei diesen Abenteuern macht man einfach zu wenig Geld. Deswegen bin ich nicht nur dort beschäftigt, sondern erledige auch alle möglichen Arbeiten für andere Leute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630213
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630213,
					"content": "Beispielsweise helfe ich Draff bei den Wildschweinen, suche hin und wieder nach Margarets Katze und bringe Flora frische Blumen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630214
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630214,
					"content": "Hahaha! Ich hatte auch nicht erwartet, dass derartige „Abenteuer“ auf mich warten würden, als ich der Abenteurergilde beitrat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2006303,
			"completionStepIds": [
				2006301
			],
