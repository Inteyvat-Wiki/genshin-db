					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630301,
					"content": "Ich würde so gern auf ein echtes Abenteuer gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630302
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630302,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630303
					]
				},
				{
					"id": 200630303,
					"content": "Gestern hat mir Stanley schon wieder eine Geschichte erzählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630304
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630304,
					"content": "Er hatte einiges getrunken und deswegen keine klaren Worte fassen können. Aber die Geschichte hat sich in der Nähe des <color=#00E1FFFF>Weinguts Morgenröte</color> abgespielt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630305,
					"content": "Er hat ungefähr Folgendes erzählt: „Eiskristalle standen vom Körper dieses unbeschreiblichen Monsters ab, als wollte es damit noch furchteinflößender wirken. Meine Knie zitterten, während ich wild mit meiner Waffe herumfuchtelte. Mit einigen Schlägen konnte ich ihm ein paar Eissplitter abschlagen, die mich regelrecht verzauberten.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630306,
					"content": "Was muss das für ein Monster sein, das selbst Stanley in Furcht erstarren lässt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630307
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630307,
					"content": "Das würde ich mir nur zu gern selbst ansehen. Aber ich würde dann auch nur schreiend davonlaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630308
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630308,
					"content": "Aber für dich wäre das doch sicher kein Problem. Hast du Lust, mal nach diesem Monster zu sehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630309,
						200630311
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630309,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630310
					]
				},
				{
					"id": 200630310,
					"content": "Dankeschön! Erzähl mir, wie es war, sobald du wieder hier bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630311,
					"content": "Gehen wir doch gemeinsam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630312
					]
				},
				{
					"id": 200630312,
					"content": "Das würde ich ja gern. Aber so, wie es gerade in der Abenteurergilde aussieht ... Du weißt es ja selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630313
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630313,
					"content": "Cyrus scheint sich auch bald zurückziehen zu wollen und erzählt ständig, dass er in Quellingen einen ruhigen Lebensabend verbringen will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630314
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630314,
					"content": "Herman hat seit der Geburt seiner Tochter keinen Fuß mehr aus Mondstadt getan. Er war ein ausgezeichneter Abenteurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630315
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630315,
					"content": "Und Stanley ist jetzt schon so lange in Rente, dass er sicher nicht mehr auf Abenteuer gehen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630316
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630316,
					"content": "Um die laufenden Kosten zu begleichen, hat die Gilde jetzt angefangen, die komischsten Aufträge anzunehmen. Aber nicht mal dafür finden sich noch genug Leute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630317
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630317,
					"content": "Ich muss einfach mehr arbeiten und kann das nicht alles Bennett allein überlassen. Er hat schon genug zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
