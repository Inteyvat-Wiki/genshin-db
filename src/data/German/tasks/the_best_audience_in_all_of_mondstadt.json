				"points": []
			},
			"dialogs": [
				{
					"id": 200631201,
					"content": "Jack, hör mir doch mal zu. So war das gar nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631202
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 200631202,
					"content": "Aber ... Oh, du bist zurück! Und? Hast du das Monster gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631203
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631203,
					"content": "Gefunden ja ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200631204
					]
				},
				{
					"id": 200631204,
					"content": "Nur ein Pyro-Schleim? Das glaub ich nicht! Stanley hat mir doch genau davon erzählt. Das war völlig anders!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631205
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631205,
					"content": "Gut, dass Stanley gerade hier ist! Stanley, sag ihnen, wie es wirklich war!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631206
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631206,
					"content": "Du weißt schon, es geht um das in Flammen stehende Monster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631207
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631207,
					"content": "Ach das, ja, also, an dem Abend habe ich ein wenig zu viel getrunken. Ich erinnere mich kaum noch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631208
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 200631208,
					"content": "Ach, gar kein Problem. Ich habe alles aufgeschrieben. Da geht nichts verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631209
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631209,
					"content": "Wirklich? Toll, Jack, aber mir fällt da eine andere Geschichte ein, von der du sicher noch nicht gehört hast. Vor vielen, vielen Jahren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Stanley"
				}
			]
		},
