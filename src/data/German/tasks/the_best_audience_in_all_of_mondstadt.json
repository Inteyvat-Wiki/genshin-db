			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630101,
					"content": "Ich würde es so gern mit eigenen Augen sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630102
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630102,
					"content": "Was willst du sehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630103
					]
				},
				{
					"id": 200630103,
					"content": "Meine Güte, hast du mich erschreckt! Seit wann bist du hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630104
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630104,
					"content": "Na, jedenfalls hat Stanley gestern einen ordentlichen Schluck getrunken und mir erzählt, welche Abenteuer er so erlebt hat. Das war in der <color=#00E1FFFF>Dadaupa-Schlucht</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630105
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630105,
					"content": "Da hat er Folgendes erzählt: „Dieses furchteinflößende Ungeheuer stand in Flammen und bewegte seinen monströsen formlosen Körper in meine Richtung. Egal wie sehr ich zuschlug oder es anbrüllte, dieses Ungeheuer sah mich mit seinen schrecklich großen Augen an, als wollte es mich allein mit seinem Blick töten.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630106
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630106,
					"content": "Ich war zwar nicht dabei, aber wenn selbst Stanley sagt, dass dieser Kampf für ihn aussichtslos schien, muss das ein unglaublich aufregendes Abenteuer gewesen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630107
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630107,
					"content": "Ach, was würde ich dafür geben, einmal dieses Ungeheuer sehen zu dürfen, das sogar Stanley in Angst versetzt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630108
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630108,
					"content": "Bei meinem Talent könnte ich in diesem Moment aber auch nur noch weglaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630109
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630109,
					"content": "Aber vielleicht hast du ja Lust, nach diesem Ungeheuer zu suchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630110,
						200630112
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630110,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630111
					]
				},
				{
					"id": 200630111,
					"content": "Das wäre echt klasse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630112,
					"content": "Ich könnte mit dir zusammen suchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630113
					]
				},
				{
					"id": 200630113,
					"content": "Also ich hätte wirklich große Lust, mitzukommen. Leider wartet eine Menge anderer Dinge auf mich, die ich erledigen muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630114
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630114,
					"content": "Und diese Dinge,na ja, ... Ich sag es mal so: Allein die Aufträge der Abenteurergilde reichen nicht, um meinen Lebensunterhalt zu sichern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630115
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630115,
					"content": "Deswegen helfe ich auch oft den Anwohnern und suche Katzen, rupfe Unkraut und so weiter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630116
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630116,
					"content": "Deswegen überlasse ich dieses große Abenteuer dir. Sobald du das Ungeheuer gefunden hast, kannst du mir ausführlich darüber berichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2006302,
			"completionStepIds": [
				2006301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
