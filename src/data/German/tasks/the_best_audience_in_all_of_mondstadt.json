			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200631601,
					"content": "Komm schon, es tut mir echt leid. Bitte sieh mich nicht so an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631602
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631602,
					"content": "Ein Hilichurl also ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200631603
					]
				},
				{
					"id": 200631603,
					"content": "Ja, du hast ja recht. Es war nur ein Hilichurl. Aber die Geschichte brauchte noch etwas Pfiff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631604
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631604,
					"content": "Ich versuche es mal zu erklären. Du weißt doch auch, dass alle jungen Leute in Mondstadt dem Ordo Favonius beitreten wollen. Kaum einer hat noch Lust, etwas mit der Abenteurergilde zu tun zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631605
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631605,
					"content": "Ist ja auch verständlich! Der Ordo Favonius kämpft gegen Drachen und dergleichen, während die Abenteurergilde mit Hilichurlen und anderen niederen Kreaturen beschäftigt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631606
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631606,
					"content": "Wenn wir nicht ein paar aufregende Geschichten zu erzählen haben, wird sich keiner mehr finden, der sich auch nur in die Nähe der Abenteurergilde wagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631607
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631607,
					"content": "Natürlich weiß ich, dass das nichts bringt. Aber ich bin auch nicht mehr der Jüngste und mittlerweile nicht mehr persönlich gegen solche Riesenmonster kämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631608
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631608,
					"content": "Was soll nur aus der Abenteurergilde in Mondstadt werden, sobald ich mich zurückgezogen habe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		}
	]
