					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200631001,
					"content": "„Eiskristalle standen vom Körper dieses unbeschreiblichen Monsters ab, als wollte es damit noch furchteinflößender wirken. Meine Knie zitterten, während ich wild mit meiner Waffe herumfuchtelte. Mit einigen Schlägen konnte ich ihm ein paar Eissplitter abschlagen, die mich regelrecht verzauberten.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631002
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631002,
					"content": "So ungefähr hat mir Stanley seine Geschichte geschildert. Er war zu der Zeit schon heftig betrunken und hat nur gelallt. Nachdem er wieder nüchtern war, hat er aber weiter davon gesprochen. Ich bin mir nicht mehr sicher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631003
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631003,
					"content": "Gegen diese Eiskristalle muss er aber Feuer verwendet haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631004
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631004,
					"content": "Was für ein mächtiges Feuer muss man gegen diese Bestie aber anwenden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2006312,
