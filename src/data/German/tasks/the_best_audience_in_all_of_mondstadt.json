			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630601,
					"content": "„Dieses furchteinflößende Ungeheuer stand in Flammen und bewegte seinen monströsen formlosen Körper in meine Richtung. Egal wie sehr ich zuschlug oder es anbrüllte, dieses Ungeheuer sah mich mit seinen schrecklich großen Augen an, als wollte es mich allein mit seinem Blick töten.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630602
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630602,
					"content": "So hat mir Stanley dieses Monster beschrieben. Dann hat er gemeint, dass er zunächst die Flammen, in das das Monster getaucht war, gelöscht hat, bevor er es erledigt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630603
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630603,
					"content": "Aber er wollte einfach nicht mit den Einzelheiten herausrücken, wie er das Feuer löschen konnte. Vielleicht hatte Stanley ja eine geheime Technik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2006308,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
