			"dialogs": [
				{
					"id": 200631401,
					"content": "Herrje, ich glaube, ich hatte wieder einen zu viel ... Mein Kopf fängt wieder an weh zu tun und mein Gedächtnis wird schwammig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631402
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 200631402,
					"content": "Keine Sorge, ich habe schon jemanden geschickt, um nach dem Monster zu schauen. Hast du es gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631403
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631403,
					"content": "Gefunden ja ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200631404
					]
				},
				{
					"id": 200631404,
					"content": "Ein Kryo-Schleim? Das klingt ganz und gar nicht nach der Geschichte, die Stanley erzählt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631405
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631405,
					"content": "Du warst sicher am falschen Ort. Stanley, sieh dir das mal an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631406,
					"content": "Ähem, tja ... He, mir fällt gerade eine weitere Geschichte ein. Willst du sie hören, Jack?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631407
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 200631407,
					"content": "Aber was ist mit dem Kryo-Schleim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631408
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631408,
					"content": "Ich garantiere dir, dass du diese Geschichte noch nie gehört hast! Damals war ich noch ein Jungspund und ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Stanley"
				}
			]
		},
		{
