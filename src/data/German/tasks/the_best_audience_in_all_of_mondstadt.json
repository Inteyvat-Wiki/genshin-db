			},
			"dialogs": [
				{
					"id": 200631301,
					"content": "Jack, Abenteuer muss man selbst erlebt haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631302
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631302,
					"content": "Ich versteh schon, aber ... Du bist ja zurück! Und? Hast du das Monster gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631303
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631303,
					"content": "Ja, hab ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200631304
					]
				},
				{
					"id": 200631304,
					"content": "Super! Es muss ... Was? Einfach nur ein Hilichurl mit einem profanen Schild?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631305,
					"content": "Das ist unmöglich! Cyrus muss von etwas Anderem gesprochen haben. Bist du dir sicher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631306,
					"content": "Cyrus ist glücklicherweise gerade hier. Cyrus, was sagst du dazu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631307
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631307,
					"content": "Ach das, ja ... Das war sicher nicht das Monster, von dem ich gesprochen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631308
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631308,
					"content": "Ähm, warum blinzelt uns Cyrus so wild zu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200631309,
					"content": "Hahaha! Macht nichts. Stellt euch mal vor, es gäbe wirklich so schreckliche Monster! Dann würde ich doch selbst keinen Fuß mehr außerhalb von Mondstadt tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631310
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631310,
					"content": "Trotzdem danke für deine Mühe! Ich kümmere mich mal lieber um etwas anderes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Stanley"
				}
			]
		},
