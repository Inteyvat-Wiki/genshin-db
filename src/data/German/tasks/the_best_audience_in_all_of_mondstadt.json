			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630801,
					"content": "„Dieser enorme Schild war wie ein Gebilde aus einem Albtraum. So fest ich auch zuschlug, der Schild schien keinen Kratzer abzubekommen. Währenddessen schielte mich das Monster hinter dem Schild an und fletschte seine Zähne.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630802
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630802,
					"content": "Das hat Cyrus jedenfalls gesagt. Ich erinnere mich noch gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630803
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630803,
					"content": "Er fügte hinzu, dass das Wichtigste im Kampf gegen das Monster war, sich eine gute Strategie auszudenken, den Schild zu zerstören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630804
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630804,
					"content": "Ansonsten hat man einfach keine Chance gegen dieses Monster. Hebt es einmal seinen Schild, kann man draufhauen, wie man will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630805
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630805,
					"content": "Cyrus hat darauf hingewiesen, dass dieses Monster hinter seinem Schild nur darauf wartet, dass sein Gegner ermüdet, um mit einer grausamen Attacke zu antworten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630806
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630806,
					"content": "Allein weil Cyrus ein derartiges Monster besiegen kann, ist er schon ein unübertroffener Abenteurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630807
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630807,
					"content": "Bedauerlicherweise werde ich wohl keine Gelegenheit dazu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2006310,
