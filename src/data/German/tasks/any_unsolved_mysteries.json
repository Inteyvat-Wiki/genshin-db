			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705170101,
					"content": "Dieser Ort sieht ziemlich normal aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170102,
					"content": "Hier wird es wohl nichts zu essen geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170103,
						705170104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170103,
					"content": "Gib dich nicht zu früh zu erkennen, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170105
					]
				},
				{
					"id": 705170105,
					"content": "*hüstel* Nun, weißt du, Geheimnisse zu erforschen ist Arbeit, die hungrig macht! Das weiß jeder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170106,
					"content": "Und außerdem haben wir in letzter Zeit viel gegrillt, um Zeit zu sparen. Hast du das nicht schon satt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170107,
					"content": "Wenn wir ein paar Meeresschnecken finden, können wir sie mit etwas Obst schmoren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170108,
					"content": "Sie werden frisch, süß und frühlingshaft sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170109,
						705170111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170109,
					"content": "Das klingt ziemlich schrecklich. Nichts für mich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170110
					]
				},
				{
					"id": 705170110,
					"content": "Komm schon, probier es aus! Es könnte dir eine ganz neue kulinarische Welt eröffnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170113,
					"content": "#Warte einen Moment! Sieh mal da drüben, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170114,
					"content": "Das ist seltsam, dass dieses Gerät plötzlich auftaucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170115,
					"content": "Und in der Nähe ist auch etwas Gepäck. Ist das die Ausrüstung von Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170116,
					"content": "Du hast den Nagel auf den Kopf getroffen, Paimon. Respekt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170117
					]
				},
				{
					"id": 705170117,
					"content": "Nicht wahr? Paimon hat ins Schwarze getroffen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170118,
					"content": "Warte einen Moment. An dieser Entdeckung ist nichts Gutes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170119,
					"content": "Wenn das eine Angelegenheit der Fatui ist, dann muss da ein Plan dahinterstecken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170120,
					"content": "Wenn wir die Sache auf sich beruhen lassen, könnten die Dinge irgendwann außer Kontrolle geraten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170121,
					"content": "Wie dem auch sei, lass uns erst einmal sehen, was wir mit diesem Gerät machen können. Wenn du meinst, dass wir das tun sollten, dann lass uns einen Blick in die Ausrüstung der Fatui werfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170122,
					"content": "#Lass uns das so machen, wie wir es immer machen, {NICKNAME}, und dann können wir nach etwas zu essen suchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170111,
					"content": "Das klingt so, wie du schmecken würdest, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170112
					]
				},
				{
					"id": 705170112,
					"content": "He! Paimon ist keine Meeresfrucht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170104,
					"content": "Nun, das erklärt deine Begeisterung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170105
					]
				}
			]
		}
	]
}