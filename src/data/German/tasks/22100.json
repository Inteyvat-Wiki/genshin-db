			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai’an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221000101,
					"content": "Hm, was nun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000102
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221000102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000103
					]
				},
				{
					"id": 221000103,
					"content": "Hier ein Gasthaus zu führen, ist nicht leicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000104
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221000104,
					"content": "Hier im Dihua-Moor gibt es viele Pflanzen, Schätze, aber auch Monster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000105
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221000105,
					"content": "Dank den Millelithen gibt es zumindest kaum mehr Monster hier in der Gegend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000106
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221000106,
					"content": "Seit Kurzem tauchen sie aber doch wieder gehäuft auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000107
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221000107,
					"content": "Sie trauen sich zwar nicht ganz bis zum Gasthaus, aber ich habe kein gutes Gefühl dabei, sie jeden Tag zu sehen. Für die Gäste wird das auch kein Vergnügen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000108
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221000108,
					"content": "Falls du dich mal in der Gegend umsehen möchtest, könntest du dich vielleicht gleich um die Monster in der Nähe des Gasthauses kümmern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000109,
						221000110
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221000109,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000111
					]
				},
				{
					"id": 221000111,
					"content": "Hahaha, du hast es erfasst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221000114,
					"content": "Es tut mir natürlich leid, einen Gast darum zu bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000115
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221000115,
					"content": "Deswegen ist für dich auf jeden Fall eine Belohnung drin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000116
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221000116,
					"content": "Ich danke dir schon im Voraus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221000110,
					"content": "Die machen doch sicher Ärger.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000112
					]
				},
				{
					"id": 221000112,
					"content": "Aber wie du schon sagst, mit diesen Monstern hier hat man keine Ruhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000113
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221000113,
					"content": "Besonders einer unserer Gäste hat etwas gegen Unordnung. Sobald er merkt, dass etwas nicht im Reinen ist, macht er gewaltig Stress.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "Huai’an"
				}
			]
		},
		{
			"id": 2210002,
