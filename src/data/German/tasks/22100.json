			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai’an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221000201,
					"content": "Und wie sieht es mit den Monstern in der Umgebung aus? Hast du sie beseitigt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000202
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221000202,
					"content": "Noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000203
					]
				},
				{
					"id": 221000203,
					"content": "Es besteht ja auch keine Eile. Diese Monster wandern die ganze Zeit umher und wollen sowieso nirgends hin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000204
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221000204,
					"content": "Wenn sich eins von diesen Monstern aber doch einmal herverlaufen würde, würde es sich eine Menge Unfug hier anstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000205
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221000205,
					"content": "Selbst wenn das Dihua-Moor nicht auf den Kopf gestellt wird, muss ich doch befürchten, dass das Gasthaus mehrere Tage lang schließen muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				}
			]
		},
