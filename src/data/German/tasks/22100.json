			"dialogs": [
				{
					"id": 221000301,
					"content": "Und wie sieht es mit den Monstern in der Umgebung aus? Hast du sie beseitigt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000302
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221000302,
					"content": "Ja, sie sind Geschichte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000303
					]
				},
				{
					"id": 221000303,
					"content": "Perfekt, danke dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000304
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221000304,
					"content": "Hier hast du die versprochene Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000305
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221000305,
					"content": "Jetzt müsste erst einmal Ruhe sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000306
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221000306,
					"content": "Von welchem Gast ich da gesprochen habe? Hm, da solltest du lieber die Inhaberin fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				}
			]
		}
	]
