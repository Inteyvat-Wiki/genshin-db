				"objectNames": [
					"„Neko“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220480101,
					"content": "Der Schrein ist unordentlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480102
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220480102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480103
					]
				},
				{
					"id": 220480103,
					"content": "Aha, genau zur richtigen Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480104
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220480104,
					"content": "Um den Schrein herum herrscht wieder ein ziemliches Durcheinander, mit Blättern, die sich auf dem Boden sammeln. Es ist so hässlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480105
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220480105,
					"content": "So kann man nicht die Menschen empfangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480106
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220480106,
					"content": "Kannst du mir wie beim letzten Mal wieder helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480107,
						220480112
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220480107,
					"content": "Wo sind Taisuke und Etsuko? Sie sind doch dafür da.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480108
					]
				},
				{
					"id": 220480108,
					"content": "Ich werde mir nicht die Mühe machen, mit den beiden grünen Menschen zu reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480109
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220480109,
					"content": "Dieser große Mensch sieht mich immer komisch an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480110
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220480110,
					"content": "Dieser andere grüne Mensch scheint faul zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480111
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220480111,
					"content": "Wie auch immer, es sind nicht zuverlässige Menschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480115
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220480115,
					"content": "Na ja, ich brauche also deine Hilfe. Wie letztes Mal, benutze den Knüppel, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480116,
						220480117
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220480116,
					"content": "Alles klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480118
					]
				},
				{
					"id": 220480118,
					"content": "Also, vielen Dank im Voraus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480119
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220480119,
					"content": "Ich warte hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220480117,
					"content": "Ich verstehe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480118
					]
				},
				{
					"id": 220480112,
					"content": "Was ist mit Ooshima ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480113
					]
				},
				{
					"id": 220480113,
					"content": "Der Stein-Mensch ist immer beschäftigt. Er scheint ständig auf etwas herumzuklopfen. Wer weiß, was er da macht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480114
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220480114,
					"content": "Seine Arbeit scheint schon fertig zu sein, aber irgendwie macht er dennoch weiter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480115
					],
					"speakerTitle": "„Neko“"
				}
			]
		},
