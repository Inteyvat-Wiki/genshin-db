			"dialogs": [
				{
					"id": 220480301,
					"content": "Seid ihr fertig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480302
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220480302,
					"content": "Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480303
					]
				},
				{
					"id": 220480303,
					"content": "Gut, ihr seid zuverlässig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480304
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220480304,
					"content": "Der Schrein wird auch immer lebendiger. Hibiki wird sich freuen, wenn sie zurückkommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480305
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220480305,
					"content": "Ich muss auch alles perfekt vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				}
			]
		}
	]
