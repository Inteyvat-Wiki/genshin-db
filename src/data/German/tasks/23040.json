					"Habachi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230401002,
					"content": "#Puh ... Aah ... Vielen Dank, {F#Reisende}{M#Reisender}. Hättest du nicht Hand angelegt, wären diese Waren bestimmt nicht zu retten gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401003,
						230401005
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401003,
					"content": "Du hast gut gekämpft.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230401004
					]
				},
				{
					"id": 230401004,
					"content": "Hehe, danke für das Lob. Aber es ist nicht ganz einfach für mich, ganz allein gegen so viele Schatzräuber zu kämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401007
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401007,
					"content": "*seufz* Meine Kampfkunst ist nichts Besonderes. Wenn Fräulein Candace hier wäre, würden die Schatzräuber jetzt schon am Boden kriechen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401008
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401008,
					"content": "Ah, entschuldige, das ist nicht der Zeitpunkt, um über so etwas zu reden. Ich muss diese Waren zurück ins Dorf bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401009
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401009,
					"content": "#{F#Reisende}{M#Reisender}, hier ist es nicht sicher. Du gehst besser auch zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401010
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401010,
					"content": "Aber wie kommt es, dass diese Gruppe von Schatzräubern so gut informiert sein kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401005,
					"content": "Bist du allein gekommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230401006
					]
				},
				{
					"id": 230401006,
					"content": "Es sind noch weitere Wächter mit mir aus dem Dorf gegangen. Aber die sind in eine andere Richtung gelaufen, um die Waren zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401007
					],
					"speakerTitle": "Habachi"
				}
			]
		}
	]
