				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400701,
					"content": "#{M#Reisender}{F#Reisende}, hast du die Waren geholt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400702
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400702,
					"content": "Ja, hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400703
					]
				},
				{
					"id": 230400703,
					"content": "Sehr gut, leg die Waren einfach dort hin. Vielen Dank für deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400704
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400704,
					"content": "Herr Habachi ist schon ins Lager gegangen, um die anderen Waren zu überprüfen, und ich werde mich erst einmal um diese Nahrung kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400705
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400705,
					"content": "*seufz* Ich hoffe, diese Nahrung hat nicht allzu viel Schaden genommen ...",
					"roleType": "TALK_ROLE_NPC",
