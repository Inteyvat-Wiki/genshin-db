			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400801,
					"content": "#{F#Reisende}{M#Reisender}! Du kommst gerade recht. Bitte gehe schnell zu Herrn Habachi und helfe ihm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400802,
						230400803
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400802,
					"content": "Was ist passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400804
					]
				},
				{
					"id": 230400804,
					"content": "*seufz* Eine Ladung Waren wurde außerhalb des Dorfs von den Schatzräubern abgefangen und alle verfügbaren Wachen sind losgezogen, um Beistand zu leisten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400805
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400805,
					"content": "Habachi sagte, dass wir trotzdem zu wenig Männer hätten, also griff er selbst zu seiner Waffe und ist aus dem Dorf gegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400806
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400806,
					"content": "Aber es heißt, diesmal seien zu viele Schatzräuber gekommen. Herr Habachi kann sich möglicherweise nicht alleine um sie kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400807
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400807,
					"content": "#{F#Reisende}{M#Reisender}, ich habe dir auf der Karte aufgezeichnet, wohin er gegangen ist. Bitte gehe hin und hilf ihm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400808,
						230400810
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400808,
					"content": "Ich breche sofort auf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400809
					]
				},
				{
					"id": 230400809,
					"content": "#Ich zähle auf dich, {F#Reisende}{M#Reisender}. Hoffentlich wird Habachi nichts zustoßen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400810,
					"content": "Wie sieht es mit seinen Kampfkünsten aus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400811
					]
				},
				{
					"id": 230400811,
					"content": "Sich um ein oder zwei Schatzräuber zu kümmern, sollte kein Problem für ihn sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400812
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400812,
					"content": "Aber wie ich gehört habe, ist die Liefergruppe dieses Mal in einen Hinterhalt einer ganzen Truppe von Schatzräubern geraten. Wäre nicht einer der Männer der Gruppe schnell ins Dorf zurückgekehrt, um uns zu warnen, würde niemand wissen, dass die Gruppe überfallen wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400813
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400813,
					"content": "Ah, wäre Fräulein Candace nicht auswärts unterwegs, dann hätten die Schatzräuber es nicht gewagt, Ärger zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400814
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400814,
					"content": "Sie müssen auf ihre Abreise gewartet haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400815
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400815,
					"content": "#{F#Reisende}{M#Reisender}, ich bitte dich. Gehe rasch zu Herrn Habachi und hilf ihm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400803,
					"content": "Warum bist du so nervös?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400804
					]
				}
			]
		},
