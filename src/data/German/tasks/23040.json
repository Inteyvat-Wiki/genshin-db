				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400201,
					"content": "Ach ... Diese Rotgeier, das nimmt ja gar kein Ende ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400202
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400202,
					"content": "Was ist passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400203
					]
				},
				{
					"id": 230400203,
					"content": "#Du bist ... {M#der}{F#die} Reisende, richtig? Ich hörte, wie Ebeid von dir gesprochen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400204
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400204,
					"content": "#Hehe, auf einmal kommt {M#ein Reisender}{F#eine Reisende} hierher, um unser Dorf zu besuchen. Das hätte ich wirklich nicht erwartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400205
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400205,
					"content": "Oh, hast du Habachi getroffen? Er ist immer so streng ... Falls ihr euch unterhaltet und es zu Meinungsverschiedenheiten kommt, habe bitte etwas Nachsicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400206
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400206,
					"content": "Schließlich ... liegen viele Vorräte unseres Dorfs in diesem Lager, nicht nur Lebensmittel, sondern auch Kleidung, Waffen und sogar Wertsachen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400207
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400207,
					"content": "Im Dorf gibt es nur so wenige junge Leute, die sowohl das Dorf bewachen als auch den Dorfbewohnern bei verschiedenen Dingen helfen ... Herr Habachi ist immer der Einzige, der auf das Lagerhaus aufpasst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400208
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400208,
					"content": "Ich kann ihm nicht viel helfen, außer für die Buchhaltung und die Inventur ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400209
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400209,
					"content": "Du hast vorhin von Rotgeiern gesprochen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400210
					]
				},
				{
					"id": 230400210,
					"content": "Ach, diese kleinen Störenfriede. Vor einiger Zeit wurde eine Ladung getrocknetes Fleisch in das Lager gebracht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400211
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400211,
					"content": "Ich weiß nicht, woher der Geruch kam, aber hin und wieder flogen ein paar Rotgeier vorbei und ließen sich auf dem Berg neben dem Lagerhaus nieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400212
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400212,
					"content": "Sie konnten das getrocknete Fleisch aus dem Lager nicht herauspicken, aber immer wenn jemand vor ihnen zu essen begann, flogen die Rotgeier plötzlich herunter und griffen an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400213
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400213,
					"content": "Die Wachen im Dorf haben keine Zeit, sie unschädlich zu machen, und Herr Habachi kann sich auch nicht darum kümmern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400214
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400214,
					"content": "#{M#Reisender}{F#Reisende}, hast du Zeit, für uns die Rotgeier unschädlich zu machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400215,
						230400217
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400215,
					"content": "Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400216
					]
				},
				{
					"id": 230400216,
					"content": "Ich danke dir vielmals. Diese Rotgeier sind sehr angriffslustig. Komme ihnen nicht zu nahe ... Wenn du es mit Pfeil und Bogen versuchst, sollte das die sicherste Methode sein, sie loszuwerden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400217,
					"content": "Was haben sie denn bisher attackiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400218
					]
				},
				{
					"id": 230400218,
					"content": "Vorbeikommende Güter, zum Trocknen aufgehängtes Fleisch und die Brotdose von Herrn Habachi ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400219
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400219,
					"content": "Wenn Herr Habachi auf seinem Posten zu Mittag isst, kommen immer die Rotgeier und schnappen ihm das ganze Fleisch weg, wenn er nicht aufpasst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400220
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400220,
					"content": "Da er Wache halten muss, kann er die Rotgeier nicht in die Schranken weisen, also schaut er ihnen beim Wegfliegen zu und isst das, was noch übrig ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400221
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400221,
					"content": "#Ich bitte dich, {M#Reisender}{F#Reisende}, gehe rasch hin und mach diese Rotgeier unschädlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				}
			]
		},
		{
