			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400401,
					"content": "Hast du die Rotgeier alle unschädlich gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400402,
						230400403
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400402,
					"content": "Ja, alles erledigt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				},
				{
					"id": 230400404,
					"content": "Vielen Dank! So kann Herr Habachi endlich in Ruhe sein Essen genießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400405
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400405,
					"content": "Ach ja, bitte nimm dies als Belohnung an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400406
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400406,
					"content": "Hm, welche Waren sollen heute noch eingelagert werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400403,
					"content": "Sie werden nicht so bald wiederkommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				}
			]
		},
		{
			"id": 2304005,
			"completionStepIds": [
				2304005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304005",
							"2"
						],
						"stepId": 2304005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400501,
					"content": "Ach, wann wird Herr Habachi sich endlich einmal ausruhen können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400502
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400502,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400503
					]
				},
				{
					"id": 230400503,
					"content": "#{M#Reisender}{F#Reisende}, du kommst gerade recht. Bitte tu uns einen Gefallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400504
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400504,
					"content": "Gerade wird eine Ladung getrocknete Nahrung von außerhalb ins Dorf geliefert. Herr Habachi möchte sie ins Lager bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400505
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400505,
					"content": "Aber eine Gruppe Rotgeier hat von der Nahrung Wind bekommen und kam plötzlich in einem Schwarm herunter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400506
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400506,
					"content": "Obwohl andere Wachen schnell herbeikamen, um die Rotgeier zu vertreiben, hatten sie die Trockennahrung überall verstreut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400507
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400507,
					"content": "#Andere sind bereits losgezogen, um die anderen Liefertrupps zu warnen, und Herr Habachi ist damit beschäftigt, die Nahrung zu bergen, die noch in gutem Zustand ist ... {M#Reisender}{F#Reisende}, kannst du uns behilflich sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400508,
						230400510
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400508,
					"content": "Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400509
					]
				},
				{
					"id": 230400509,
					"content": "Dann verlasse ich mich auf dich. Tut mir leid, ich muss gleich eine weitere Ladung Waren ins Lager bringen und ich schaffe es wirklich nicht alleine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400510,
					"content": "Geht es Herrn Habachi gut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400511
					]
				},
				{
					"id": 230400511,
					"content": "*seufz* Ich habe ihm vorgeschlagen, sich eine Weile auszuruhen, aber er hat abgelehnt. Er sagte, dass er nach dem Sammeln der Nahrung noch einmal die Inventur im Lager machen wolle. Wenn das so weitergeht, fürchte ich, dass sein Körper bald nicht mehr mithalten kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400512
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400512,
					"content": "#Die Waren sollten sich in der Nähe des weißen Aufzugs befinden ... {M#Reisender}{F#Reisende}, bitte hilf uns, die Waren zu bergen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				}
			]
		},
		{
			"id": 2304006,
			"completionStepIds": [],
