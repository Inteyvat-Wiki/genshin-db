						],
						"pointId": 11834
					}
				]
			},
			"dialogs": [
				{
					"id": 150480101,
					"content": "... Wir können dich dieses Risiko nicht eingehen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480102
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480102,
					"content": "Aber das ist nicht das, was du vorhin gesagt hast ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480103
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480103,
					"content": "Wir entschuldigen uns aufrichtig. Wir stehen zwar unter Zeitdruck, aber die Sicherheit unserer Besucher hat Vorrang. Wir hoffen auf dein Verständnis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480104
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480104,
					"content": "Oh, du kommst zur rechten Zeit! Kannst du mir helfen, diesen Herrn umzustimmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480105
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480105,
					"content": "Sie brauchten jemanden für die Tests und es gelang mir, meine Abenteuererfahrung unter Beweis zu stellen und deutlich zu machen, dass ich bereit war, jedes Risiko einzugehen. Alles verlief so reibungslos ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480106
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480106,
					"content": "Aber als er von all den Beinaheunfällen hörte, die ich in der Vergangenheit hatte, weigerte er sich strikt, mich daran teilnehmen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480107
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480107,
					"content": "Lieber Gast, ich schätze deinen Enthusiasmus, das tue ich wirklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480108
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480108,
					"content": "Aber wenn du dazu neigst, in Flüsse zu fallen, selbst wenn du über solide Steinbrücken gehst, wäre es vielleicht besser, etwas anderes zu versuchen, das etwas ... entspannter ist? Wie wäre es zum Beispiel mit einem dieser Strandkörbe dort drüben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480109
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480109,
					"content": "*seufz* Aber ... ich bin wirklich ein Abenteurer, und ich bin auch für den Test qualifiziert! Es ist nur so, dass ... ich in der Vergangenheit etwas Pech hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480110
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480110,
					"content": "Ich möchte wirklich helfen. Bitte glaube mir, wenn ich sage, dass du dich auf mich verlassen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480111,
						150480112
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480111,
					"content": "Ich kann für ihn bürgen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				},
				{
					"id": 150480113,
					"content": "#Nun, wenn Natlans {F#große Retterin}{M#großer Retter} das sagt ... Wie wäre es, wenn dein Asha-Begleiter die erste Testrunde an deiner Stelle absolviert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480114
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480114,
					"content": "Du kannst vom Rand aus zuschauen und dich mit der Route vertraut machen. Wenn alles reibungslos verläuft, kannst du an der zweiten Testrunde teilnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480115
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480115,
					"content": "Asha, klingt das gut für dich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480116
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480116,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480117
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480117,
					"content": "Also gut! Dann überlasse ich das dir, Partner!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480112,
					"content": "Er hat mein volles Vertrauen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				}
			]
		},
