				},
				{
					"id": 150480302,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480303
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480303,
					"content": "Gut gemacht, Asha! Deine Sportlichkeit hat mich wirklich umgehauen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480304
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480304,
					"content": "Jetzt ist Bennett an der Reihe, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480305,
					"content": "Stimmt genau! Ich habe mich aufgewärmt, meine Dehnübungen beendet und bin bereit für Aktion! Vertrau mir, ich schaffe das!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480306
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480306,
					"content": "Sei aber vorsichtig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480307
					]
				},
				{
					"id": 150480307,
					"content": "Keine Sorge, das werde ich! Danke für deine Fürsorge!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				}
			]
		},
