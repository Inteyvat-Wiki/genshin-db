			},
			"dialogs": [
				{
					"id": 150480601,
					"content": "Gut. Nur noch ein bisschen weiter. Bleib jetzt ruhig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480602
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480602,
					"content": "Moment, was? Warum fliegt das Ziel weg!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480603
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480603,
					"content": "Habe ich mich gerade selbst verhext? Oder hat mich mein Glück endgültig verlassen? ... Nein, komm schon, ich darf jetzt nicht die Hoffnung verlieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480604
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480604,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480605
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480605,
					"content": "Stimmt, ich kann dem Asha immer folgen! Solange wir noch miteinander verbunden sind, werden wir einen Weg finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				}
			]
		},
		{
			"id": 1504808,
