						150480402
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480402,
					"content": "Du sagst also ... Du wärst bereit, mir den Weg zu weisen und mich zu coachen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480403
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480403,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480404
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480404,
					"content": "Du bist der Beste! Jetzt fühle ich mich noch selbstbewusster als vorher! Nach dir, Coach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480405
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480405,
					"content": "Los, Asha! Los, Bennett!",
