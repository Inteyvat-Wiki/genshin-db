					}
				]
			},
			"dialogs": [
				{
					"id": 150480801,
					"content": "Puh, mein Herz rast so schnell ... Ich werde eine Weile brauchen, um mich selbst wiederzufinden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480802
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480802,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480803
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480803,
					"content": "Einen Applaus für Bennett und den Asha! Ihr seid so eine tolle Mannschaft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480804,
					"content": "Besonders die Art und Weise, wie ihr am Ende zusammengearbeitet haben. Eure besondere Verbundenheit hat den Unterschied ausgemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480805,
					"content": "Ihr habt gemeinsam das Unglück abgewendet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480806
					]
				},
				{
					"id": 150480806,
					"content": "Ja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480807
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480807,
					"content": "#Und vor allem dir, {NICKNAME}, bin ich zu großem Dank verpflichtet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480808
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480808,
					"content": "Wenn du nicht an mich geglaubt und mir geholfen hättest, die Mitarbeiter zu überzeugen, hätte ich nie die Chance gehabt, die Herausforderung überhaupt zu bestehen ... geschweige denn, mich ihr an der Seite des Ashas zu stellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480809
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480809,
					"content": "Herr Bennett, die letzte Sicherheitsprüfung ist damit abgeschlossen. Jetzt kann „Asha rennt“ offiziell eröffnet werden. Wir wissen deine Hilfe sehr zu schätzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480810
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480810,
					"content": "Hast du das gehört, Asha? Wir haben es geschafft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480811
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480811,
					"content": "Ich werde mir deinen Namen merken, Bennett – der tapfere und gutherzige Abenteurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480812
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480812,
					"content": "Ich weiß, dass dieses Abenteuer noch nicht vorbei ist, aber allein der Gedanke, mich von ihm zu verabschieden, wird immer unerträglicher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480813
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480813,
					"content": "Asha, ich werde dich wirklich vermissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480814
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480814,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480815
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480815,
					"content": "Hehe, nein ... Wenn überhaupt, sollte ich hier derjenige sein, der dich beruhigt! Als Leiter unserer Abenteuertruppe ist es meine Aufgabe, mich um dich zu kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480816
					],
					"speakerTitle": "Bennett"
				},
