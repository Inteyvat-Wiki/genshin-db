					"nextDialogs": [
						150480817
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480817,
					"content": "Seltsam, ich bin wohl zu aufgeregt ... Meine Augen fühlen sich plötzlich ganz warm an und ich werde sogar ein bisschen sprachlos. Haha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480818
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480818,
					"content": "Ich werde Herrn Venti fragen müssen, wie ich meine Gefühle in solchen Momenten ausdrücken kann. Immerhin ist er der beste Dichter, den ich kenne ...",
					"roleType": "TALK_ROLE_NPC",
