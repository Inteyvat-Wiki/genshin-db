					"nextDialogs": [
						708160303
					]
				},
				{
					"id": 708160303,
					"content": "Oh, was für eine Erleichterung. Ich habe immer diese Karte verwendet, also habe ich viele Markierungen eingetragen. Sie zu verlieren wäre eine Katastrophe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708160304
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 708160304,
					"content": "Und wenn ich wirklich mein Handbuch verloren hätte, weiß ich nicht, wie ich Katheryne um ein neues gefragt hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708160305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 708160305,
					"content": "Ich meine, was für ein Witz. Ein Abenteurer, der sein Handbuch auf einem Abenteuer verliert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708160306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 708160306,
					"content": "Danke, ich werde diese Dinge von nun an in meiner Nähe behalten. Bitte nimm dies als Zeichen meiner Anerkennung.",
