			"dialogs": [
				{
					"id": 750360401,
					"content": "Gut, das sollte tief genug sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360402,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360403
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360403,
					"content": "Hm ... Was Natlan am meisten von anderen Regionen unterscheidet, ist ... das Phlogiston! Vielleicht könnten wir dem Samen etwas Phlogiston geben und sehen, was passiert!",
