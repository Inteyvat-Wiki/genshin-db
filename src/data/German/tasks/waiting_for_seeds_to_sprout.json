			"dialogs": [
				{
					"id": 750360201,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, was hast du da gegraben? Etwas Gutes gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360202,
					"content": "Oh, ist es ein wertvoller Schatz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360203,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360204,
					"content": "Hm ... Lass Paimon mal sehen, das hier sieht aus wie eine Art von Samen ... Wer hätte gedacht, dass man so etwas in diesem wüstenartigen Gebiet finden würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360205,
					"content": "*brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360206,
					"content": "Allerdings sieht er nicht sehr wertvoll aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360207,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360208,
						750360209
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360208,
					"content": "Samen enthalten unendliche Möglichkeiten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360210
					]
				},
				{
					"id": 750360210,
					"content": "Aber dieser Ort sieht total verlassen aus ... Der Boden ist so hart, kann dieser Samen wirklich noch aufgehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360211,
					"content": "*brüll* ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360212,
					"content": "Ah, bist du traurig? Nun, Paimon könnte sich auch irren, denn manche Samen sprießen einfach nicht von selbst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360213,
					"content": "Na ja, pflanzen wir ihn erst einmal wieder ein. Vielleicht hat er einfach noch nicht gekeimt. Vielleicht war das Loch nicht gut gegraben, oder er hat nicht genug Nährstoffe bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360214,
					"content": "Er könnte also wachsen, wenn wir ihn richtig pflanzen! Hehe, was könnte daraus wachsen? Eine riesige Kornfrucht vielleicht? Ein Cacahuatl mit einem superstarken Aroma wäre auch toll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360215,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360216
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360216,
					"content": "Oder vielleicht eine Vaniloqua ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360217
					]
				},
				{
					"id": 750360217,
					"content": "He! Falscher Zeitpunkt, um ein Spielverderber zu sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360218,
					"content": "Doch welche Nährstoffe brauchen die Pflanzen aus Natlan? ... Wie auch immer, lasst uns ihn jetzt einpflanzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360209,
					"content": "Er könnte sich zu etwas Beeindruckendem entwickeln!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360210
					]
				}
			]
		},
