			"dialogs": [
				{
					"id": 750360801,
					"content": "Oh, sprieß, sprieß, kleiner Samen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360802,
					"content": "Du wirst eine wunderschöne Blume!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360803,
					"content": "... Äh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360804,
					"content": "Hmm ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360805
					]
				},
				{
					"id": 750360805,
					"content": "#Ach, {NICKNAME}, das Phlogiston ist weg, der Samen muss das alles absorbiert haben. Aber ... warum zeigt er überhaupt keine Veränderungen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360806,
					"content": "*brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360807,
						750360811
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360807,
					"content": "Er braucht Zeit, um zu wachsen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360808
					]
				},
				{
					"id": 750360808,
					"content": "Oh, richtig, da hast du wohl recht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360809,
					"content": "Löwenzahnsamen brauchen nur einen leichten Windstoß, um mit ihren kleinen weißen Schirmen fortzureisen und Wolfshaken können auf dem Rücken der Wölfchen an Orte reiten, die weit von ihrer Heimat entfernt sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360810,
					"content": "Samen sind sehr hartnäckig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360815,
					"content": "Nun, in diesem Fall lassen wir ihn erst einmal in Ruhe. Wir kommen später noch einmal wieder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360816,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360811,
					"content": "Vielleicht hat der Samen nur Angst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360812
					]
				},
				{
					"id": 750360812,
					"content": "W... Wirklich? Na ja, Paimon ist ein bisschen zu ungeduldig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360813,
					"content": "#Der Samen wurde von {REALNAME[ID(2)|SHOWHOST(true)]} ausgegraben und dann wurden seine Nährstoffe von fliegenden Insekten gestohlen, bevor er von einigen lauten Monstern gestört wurde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360814,
					"content": "Das Geräusch eines Kampfes muss für Samen so beängstigend sein wie das Geräusch von Sturm und Donner. Er hat so viel Angst, dass er sich in der Erde versteckt und nicht wagt, sich auch nur ein bisschen zu bewegen ... Ja, das muss der Fall sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "Paimon"
				}
			]
		},
