			},
			"dialogs": [
				{
					"id": 732170801,
					"content": "Als größtes Gasthaus in Ormos bieten wir unseren Reisenden und Touristen aufmerksame Dienstleistungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170802
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732170802,
					"content": "Für Studenten und Absolventen der Akademie bieten wir einen Sonderrabatt an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170803
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732170803,
					"content": "Bitte wende dich an die Wikala-Karawanserei, falls du Hilfe bei der Lagerung deiner Waren benötigst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
