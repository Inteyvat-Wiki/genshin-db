			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170101,
					"content": "Die Ankündigungstafel wurde vom Hafenleiter von Ormos eingeführt, um Bekanntgaben zu wichtigen Angelegenheiten in Ormos zu machen. Fragen oder Zweifel können hier ebenfalls hinterlassen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321702,
			"completionStepIds": [
				7321702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321702",
							"2"
						],
						"stepId": 7321702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170201,
					"content": "„Kämpfst du immer noch mit der Formatierung deiner Abhandlung? Brauchst du Inspiration für deine Abhandlung? Zeit für eine neue Herangehensweise!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170202
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732170202,
					"content": "„Ich habe Redelehre als Hauptfach studiert und beherrsche sowohl die Stoffkunde als auch die Baulehre. Ich beantworte auch gern Fragen zur Verfassung von Abhandlungen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170203
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732170203,
					"content": "„Es wird Zeit, dich von deinen Schmerzen zu befreien. Frage im Gasthaus nach Herrn Amandeep. Dienstgebühr verhandelbar.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170204
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732170204,
					"content": "„Arbeitest du auch als Auftragsschreiber?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170205
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732170205,
					"content": "„Nein, die Inspektorin toleriert ein solches Verhalten nicht.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170206
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732170206,
					"content": "„In der Tat. Konzentriere dich auf dein Studium und komme nicht vom rechten Weg ab.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321703,
			"completionStepIds": [
				7321703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321703",
							"2"
						],
						"stepId": 7321703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170301,
					"content": "Hast du schon mal von der Schwebetechnik gehört? Hast du schon mal jemanden fliegen sehen? Möchtest du die Geheimnisse der fliegenden Packtiere entdecken? Dann verpasse nicht den ersten Auftritt der Künstlergruppe „Fontaine-Flieger“ in Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170302
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732170302,
					"content": "Herzlich Willkommen! Die Vorstellung läuft! Für nur fünf Mora kannst du dieser einzigartigen Kunstform beiwohnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170303
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732170303,
					"content": "„Es war wundervoll! So etwas habe ich noch nie gesehen, nicht einmal in Fontaine!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321704,
			"completionStepIds": [
				7321704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321704",
							"2"
						],
						"stepId": 7321704,
