			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170601,
					"content": "Derzeit finden Ermittlungen zur Schmugglerei am Hafen statt. Alle Waren, die den Hafen passieren, müssen registriert und überprüft werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170602
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732170602,
					"content": "Alle nicht registrierten und geschmuggelten Waren werden konfisziert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170603
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732170603,
					"content": "Der Frachteigentümer trägt die Verantwortung über jegliche Konsequenzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321707,
			"completionStepIds": [
