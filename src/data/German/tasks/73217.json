			"dialogs": [
				{
					"id": 732170701,
					"content": "Seeungeheuer gesichtet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170702
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732170702,
					"content": "In letzter Zeit haben wir eine erhöhte Aktivität von Seeungeheuern beobachtet. Schiffe, die den Hafen verlassen, sollten die Warnungen des Leuchtturms von Pharos beachten oder sich im Voraus über die maritime Situation durch Akasha erkundigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170703
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732170703,
					"content": "Wende dich bei Fragen bitte an den Leuchtturmwächter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321708,
