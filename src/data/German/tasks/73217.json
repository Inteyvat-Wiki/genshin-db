			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170501,
					"content": "Alle Schiffe, die in den Hafen einlaufen, müssen sich beim Hafenleiter mit den Daten des Eigentümers und dem Grund für das Einlaufen registrieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170502
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732170502,
					"content": "Handelsschiffe müssen außerdem weitere Details zu Fracht angeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170503
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732170503,
					"content": "Handelsschiffen ist die Abladung oder der Handel ihrer Fracht ohne Registrierung strengstens untersagt. Jeglicher Verstoß wird streng bestraft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321706,
			"completionStepIds": [
				7321706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
