			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171901,
					"content": "„Die Route nach Ritou wurde erneut eröffnet. Wir laden dich herzlich ein, dich unserem Handel anzuschließen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171902
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171902,
					"content": "„Wir haben die Genehmigung des Hafenleiters zum Handel von wilden Pilzen zwischen Sumeru und Inazuma erhalten. Wir heißen eine Zusammenarbeit mit Pilzhändlern willkommen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171903
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171903,
					"content": "„Du kannst dich auch gerne mit uns in Verbindung setzen, wenn du auf deiner Reise nach Inazuma auf Probleme oder Schwierigkeiten stößt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
