							"7321709",
							"2"
						],
						"stepId": 7321709,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170901,
					"content": "„Die Dienstleistung im Gasthaus Shapur ist ausgezeichnet, aber die Schallisolierung ist schrecklich.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170902
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732170902,
					"content": "„Ich habe hier gewohnt, um mich auf die Prüfung vorzubereiten, weil es günstiger in Ormos ist. Nun werde ich wohl doch nach Sumeru umziehen müssen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170903
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732170903,
					"content": "„Wenn ich die Prüfung dieses Jahr wieder nicht bestehe, bleibt mir nichts anderes übrig, als Bauer in meiner Heimat zu werden. Vielleicht kann ich ein paar ‚anahitianische Segen‘ mitnehmen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321710,
			"completionStepIds": [
				7321710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321710",
							"2"
						],
						"stepId": 7321710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171001,
					"content": "„Die gesendeten Mahamata sind einer nutzloser als der letzte. Sie können keine einzige meiner Fragen beantworten.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171002
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171002,
					"content": "„Und jetzt, da wir Zugang zu Akasha haben, können sich diese Amateure nicht einmal mit mir messen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171003
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171003,
					"content": "„Die einzige Ausnahme ist der Archivar, den wir nicht so häufig zu Gesicht bekommen. Beim letzten Mal hat er uns sogar geholfen, den Transportplan in Ordnung zu bringen. Es scheint, dass nicht alle Beamten der Akademie so dumme Pilze sind.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321711,
			"completionStepIds": [
				7321711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321711",
							"2"
						],
						"stepId": 7321711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171101,
					"content": "„Seit Cyno zum Mahamatra geworden ist, habe ich zwar immer mehr Verantwortung, aber er hat mir die Last von den Schultern genommen, da ich mich nicht mehr mit den Schulen und ihren mühsamen Machtkämpfen abplagen muss.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171102
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171102,
					"content": "„Sonst könnte mich nicht während meiner Forschungsreise auf die faule Haut legen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171103
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171103,
					"content": "„Ich habe keine Ahnung, wo sich Cyno herumtreibt. Ich schätze, wenn ich das hier schreibe, werde ich nicht von ihm erwischt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171104
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171104,
					"content": "„Ich habe alles gesehen. Melde dich vor morgen Mittag bei mir und hole deine gerechte Strafe ab.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171105
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171105,
					"content": "„Verschwende bloß nicht meine Zeit.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321712,
			"completionStepIds": [
				7321712
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321712",
							"2"
						],
						"stepId": 7321712,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171201,
					"content": "Unsere Gilde spezialisiert sich auf den Handel mit Edelsteinprodukten und exquisiten Erzen, die in Liyue produziert werden. In langfristiger Zusammenarbeit mit mehreren Flotten sind unsere Versorgungskanäle stabil und unsere Vorräte ausreichend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171202
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171202,
					"content": "Außerdem haben wir eine Handvoll stilvoller Seidenstoffe im Angebot. Kauf jetzt, ehe sie vergriffen sind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171203
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171203,
					"content": "Bitte kontaktiere uns, wenn du einen guten Lieferkanal für Sumeru-Teppiche, Kräuter, Edelsteinprodukte und Brokate unterhältst. Lass uns Geschäfte und Freundschaften schließen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321713,
			"completionStepIds": [
				7321713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321713",
							"2"
						],
						"stepId": 7321713,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171301,
					"content": "„Letzten Monat bin ich in ein Land gesegelt, dessen König noch nie ein Pferd gesehen hat. Kannst du das glauben?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171302
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171302,
					"content": "„Also habe ich beschlossen, dort ein paar Packtiere als Pferde zu verkaufen, haha. Wenn ich das Geschäft abschließe, werde ich vielleicht auch zum König!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171303
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171303,
					"content": "„Was ist ein König?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171304
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171304,
					"content": "„Ein Beamter wie ein Navbed oder ein Vizier, aber mit viel mehr Macht. Ziemlich gleichgestellt mit den legendären neunundzwanzig Dey ... Meine Güte, das ist so schwer zu beschreiben.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171305
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171305,
					"content": "„Das hast du nur erfunden, nicht wahr?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321714,
			"completionStepIds": [
				7321714
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321714",
							"2"
						],
						"stepId": 7321714,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171401,
					"content": "„Anstatt den langweiligen Predigten der Weisen zu lauschen, warum nicht ein Glas Blumenwein einschenken und dich auf eine Reise begeben, um die sieben Weltmeere zu erobern?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321715,
			"completionStepIds": [
				7321715
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321715",
							"2"
						],
						"stepId": 7321715,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171501,
					"content": "An alle Matrosen, Reisende, Händler und Hafenbewohner: Hier wird die Hafenordnung bekannt gegeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171502
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171502,
					"content": "Bitte wende dich bei Streitfragen an den Friedensrichter Shyam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321716,
			"completionStepIds": [
				7321716
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321716",
							"2"
						],
						"stepId": 7321716,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171601,
					"content": "„Du solltest die alten Märkte von Ormos anstelle des sogenannten Großen Basars in Sumeru besuchen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171602
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171602,
					"content": "„Der Große Basar hat seine Eigenschaften dank der Mahamata verloren. Stattdessen pflegen wir hier die echten Traditionen von Sumeru.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171603
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171603,
					"content": "„Aber natürlich musst du trotzdem ins Theater Zubayr gehen, wenn du eine Tanzaufführung sehen möchtest.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171604
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171604,
					"content": "„Landeier bleiben eben Landeier. Die Stadt Sumeru wurde von Gelehrten entworfen, die Zonen von allen Stadtteilen werden von der Wissenschaft untermauert.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171605
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171605,
					"content": "„Ich sehe schon, jemand redet hier nur Schwachsinn. Die chaotischen Straßen von Ormos sind in ihren Augen irgendwie zu Schätzen geworden!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171606
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171606,
					"content": "„Was war das? Die Menschen reden allerlei Unsinn!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321717,
			"completionStepIds": [
				7321717
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321717",
							"2"
						],
						"stepId": 7321717,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171701,
					"content": "„Es ist peinlich, dies auszusprechen. Wir waren früher Arbeiter, die die Handelsschiffe gewartet haben und uns unseren Unterhalt mit den Fertigkeiten verdient haben, die von Generation zu Generation an uns weitergegeben wurden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171702
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171702,
					"content": "„Aber vor geraumer Zeit hat das Akasha neue Technologien aufgenommen und unsere jahrelange Erfahrung ist vollkommen wertlos. Junge Menschen können neue Dinge durch das Akasha lernen, aber wir älteren Leute haben keine andere Wahl. Wir müssen unseren Job wechseln.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171703
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171703,
					"content": "„Der Archivar hat zwar gesagt, dass wir unser Glück auf dem Meer versuchen können, aber wir haben gerade kein Geld dafür. Falls jemand Arbeit für uns hat, wir stehen allzeit bereit.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171704
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171704,
					"content": "„Trau dem Archivar nicht über den Weg. Ich habe zufällig eine Kundin, die gerade Handwerker braucht. Ich werde sie euch vorstellen. Nimm das Geld hier und vergiss das Meer.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171705
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171705,
					"content": "„Ich wünschte, du würdest weniger bedeutungslose Dinge tun. Manche Leute sind erfolgreich und andere fallen auf dem Weg, so funktioniert eben die Welt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171706
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171706,
					"content": "„Hier kommt der große Archivar wieder mit seiner Mystik. Warum ich das alles tue? Weil es mich glücklich macht!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171707
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171707,
					"content": "„Und vergiss du nicht, dass auch gegenseitige Hilfe, Gerechtigkeit und rechtschaffener Zorn die Welt antreiben, nicht ein solcher Unsinn wie ‚der Stärkere überlebt‘!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171708
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171708,
					"content": "„Versteh das nicht falsch! Ich habe deine Aussagen nie geleugnet, aber du kapierst überhaupt nicht, was ich dir sagen möchte! Ende des Gesprächs.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171709
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171709,
					"content": "„Es bereitet mir Kopfschmerzen, mich mit impulsiven Menschen wie dir zu streiten ... Übrigens, wo ist dein eigenes Budget? Sag mir ja nicht, dass du die Fördermittel der Akademie für diesen Kram ausgegeben hast.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171710
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171710,
					"content": "„‚Die Armen leiden unter dem Reichtum der Reichen, deshalb sollten die Reichen ihren Reichtum verteilen.‘ Das sind die Worte des Weisen Zolfikar.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171711
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171711,
					"content": "„Das hat er nicht gesagt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171712
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171712,
					"content": "„Hat er wohl.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171713
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171713,
					"content": "„Nein, hat er nicht. Diesen Monat bezahlst du selbst für deine Getränke.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171714
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171714,
					"content": "„Ich streite mich nicht darüber mit dir. Aber gib mir einen Monat, er hat es wohl gesagt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321718,
			"completionStepIds": [
				7321718
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321718",
							"2"
						],
						"stepId": 7321718,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171801,
					"content": "„Unsere Kompanie hat eine neue Route nach Dornmannshaven erschlossen. Wir laden dich herzlich ein, dich unserem Obsthandel anzuschließen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171802
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171802,
					"content": "„Warte, ist es bei der langen Reise nach Mondstadt überhaupt möglich, Obst zu importieren? Wenn du Spirituosen meinst, daran könnte ich interessiert sein.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171803
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171803,
					"content": "„Jeder kann auf den Gedanken kommen, Wein aus Mondstadt zu importieren, aber Obst? Nur ich treibe ein solches Geschäft. Deshalb ist Obst eine großartige Geschäftsmöglichkeit!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171804
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732171804,
					"content": "„Außerdem muss nicht unbedingt ein Import aus Mondstadt stattfinden ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
