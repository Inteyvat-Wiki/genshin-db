					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170401,
					"content": "Besonderer Hinweis: Die „Goldbrigaden“ sind die einzige zugelassene Söldnerorganisation in Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170402
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732170402,
					"content": "Bitte bleibe Fremden gegenüber misstrauisch, damit du nicht von Unbekannten um die Prämie betrogen wirst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170403
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732170403,
					"content": "Wenn du Leibwächter oder Sicherheitspersonal einstellen möchtest oder andere Aufträge hast, wende dich bitte an den Truppenführer Feroz vom „Regiment der Dreißig“ in Ormos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321705,
			"completionStepIds": [
				7321705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
