			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721260101,
					"content": "Verdammt ... Was soll ich nun tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260102
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260102,
					"content": "Was ist passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260103
					]
				},
				{
					"id": 721260103,
					"content": "Du ... Ich bin so froh, dass du hier bist ... Nachdem du mir die Blumensamen gegeben hattest, habe ich angefangen, Blumen zu pflanzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260104
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260104,
					"content": "Aber bevor ich viel pflanzen konnte, tauchte plötzlich eine Gruppe von Monstern auf. Sie blieben immer wieder in der Gegend, wo ich die Blumen pflanzen wollte. Ich habe Angst davor, hinüberzugehen, um Blumen zu pflanzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260105
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260105,
					"content": "Wenn sie weiterhin hierbleiben, können sie die Gegend zerstören, wo die Blumen gepflanzt wurden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260106
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260106,
					"content": "Kannst du diese Monster für mich verjagen? Ich ... Ich möchte nur Blumen pflanzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260107,
						721260109
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260107,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260108
					]
				},
				{
					"id": 721260108,
					"content": "Wirklich? Vielen Dank! Danke für deine Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260109,
					"content": "Warum willst du denn Blumen züchten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260110
					]
				},
				{
					"id": 721260110,
					"content": "Ich denke, der Grund, warum die Leute nicht nach Tatarasuna zurückkommen wollen, ist, dass sie sich Sorgen machen, dass dieser Ort nicht mehr für das Leben geeignet ist, nach der Sache mit dem „Mikage-Hochofen“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260111
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260111,
					"content": "Ich kann nicht jeden einzeln überreden. Aber wenn ich hier wieder viele schöne Blumen pflanzen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260112
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260112,
					"content": "Vielleicht reicht es, um alle davon zu überzeugen, dass Tatarasuna bereits sicher ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260113
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260113,
					"content": "Und ... Ha, außer der Blumenbepflanzung habe ich keine anderen Mittel, um Leute zu überzeugen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260114
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260114,
					"content": "Also bitte, bitte hilf mir, diese Monster zu verjagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
