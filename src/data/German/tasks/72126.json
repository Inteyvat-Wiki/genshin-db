			"dialogs": [
				{
					"id": 721260301,
					"content": "Hast du die Monster verjagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260302
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260302,
					"content": "Ja. Alle verjagt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260303
					]
				},
				{
					"id": 721260303,
					"content": "Vielen Dank. Nun kann ich weiter Blumen züchten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260304
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260304,
					"content": "Ach, ja, bitte nimm dies. Es tut mir leid, dass ich dir nichts Besseres geben kann ... Jedenfalls danke, dass du mir geholfen hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
