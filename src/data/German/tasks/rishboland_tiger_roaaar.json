			"dialogs": [
				{
					"id": 730420601,
					"content": "Das war echt lustig! Mit dem goldenen Nara zu spielen, macht echt Spaß! Aber der Nara ist richtig schnell und stark, wie ein echter Rishboland-Tiger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420602
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420602,
					"content": "#Mit anderen Aranara und einem echten Rishboland-Tiger zu spielen, macht auch Spaß. Aber mit {F#meiner neuen Nara-Freundin}{M#meinem neuen Nara-Freund} zu spielen, macht am meisten Spaß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420603
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420603,
					"content": "Warum sollte der Rishboland-Tiger die Aranara fangen wollen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730420604
					]
				},
				{
					"id": 730420604,
					"content": "Der Rishboland-Tiger und die Aranara sind Freunde und Freunde spielen zusammen. Aber ich habe gemerkt, dass Nara Angst vor dem Rishboland-Tiger haben, also hat sich Arakanta ein neues Spiel für das Utsava-Fest ausgedacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420605
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420605,
					"content": "Danke, Nara. Ich schenke dem goldenen Nara Aranara-Blume!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakanta"
				}
			]
		}
