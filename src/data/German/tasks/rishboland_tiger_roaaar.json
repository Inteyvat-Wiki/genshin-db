			"dialogs": [
				{
					"id": 730420101,
					"content": "Goldener Nara, Arakanta hat schon sehr viel von dir gehört. Du bist ein guter Nara, möchtest du ein Spiel mit Arakanta spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420102
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420102,
					"content": "Arakantas Spiel ist ganz einfach und macht Spaß! Ich erkläre dem Nara die Regeln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420103
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420103,
					"content": "Arakanta macht ganz viele Dendro-Teilchen. Das sind die „Aranara“, die sich im Kreis verstecken. Der Nara ist der große und furchterregende „Rishboland-Tiger“ und muss die „Aranara“ fangen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420104
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420104,
					"content": "Wenn der „Rishboland-Tiger“ alle „Aranara“ in „kurzer Zeit“ fangen kann, hat der Nara „gewonnen“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420105
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420105,
					"content": "Wie sieht’s aus, möchte der Nara jetzt mit Arakanta spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakanta"
				}
			]
		},
