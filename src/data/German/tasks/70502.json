				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Luka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020101,
					"content": "#Hallo, ich nehme an, du bist {F#die}{M#der} berühmte Reisende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020102,
						705020103
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020102,
					"content": "Das bin ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				},
				{
					"id": 705020104,
					"content": "He, Paimon ist auch noch da! Paimon ist die superberühmte Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020105,
					"content": "So sieht es aus. Die Engelsgabe hat kürzlich eine „Wirt-Schnupperwoche“ veranstaltet und ich dachte, das könnte dich interessieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020106
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020106,
					"content": "Einfach ausgedrückt: Du kannst deine eigenen Getränke mischen ... oder was auch immer du willst, mit allen Zutaten, die du willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020107
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020107,
					"content": "Das fertige Produkt steht dir auch zum unbegrenzten Verzehr zur Verfügung, solange es nicht verschwendet wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020108
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020108,
					"content": "Unbegrenzter Verzehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020109,
					"content": "Außerdem wirst du gut bezahlt, wenn du die Kunden glücklich machen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020110
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020110,
					"content": "Oh, sogar Bezahlung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020111,
					"content": "Paimon ist komplett verloren ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020112
					]
				},
				{
					"id": 705020112,
					"content": "Lass und teilnehmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020113,
					"content": "Obwohl es sich um eine „Schnupperwoche“ handelt, besteht eigentlich keine Anwesenheitspflicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020114
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020114,
					"content": "Es ist in Ordnung, wenn du dich jetzt noch nicht entscheiden kannst, du kannst es erst einmal ausprobieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020115
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020115,
					"content": "Was meinst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020103,
					"content": "Gibt es irgendetwas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				}
			]
		},
		{
			"id": 7050202,
			"completionStepIds": [
				7050203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050203",
							"2"
						],
						"stepId": 7050203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charles"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020201,
					"content": "Ah, du bist es. Was möchtest du heute trinken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020202
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020202,
					"content": "Hallo, Charles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020203
					]
				},
				{
					"id": 705020203,
					"content": "Charles, wir sind hier, um Wirte zu werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020204,
					"content": "Als Wirt ... Ah, Luka hat euch also rekrutiert? Er hat so ein Glück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020205
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020205,
					"content": "#{NICKNAME}, ich vertraue auf deine Fähigkeit, mit Problemen umzugehen, aber Wirt zu sein ist nun einmal ein technischer Beruf und ich hoffe, du nimmst ihn nicht auf die leichte Schulter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020206
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020206,
					"content": "Das Verhältnis der Zutaten, die Art und Weise, wie sie gemischt werden ... all das hat Auswirkungen auf die Qualität des Produkts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020207
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020207,
					"content": "#Mach dir keine Sorgen. {F#Sie}{M#Er} ist {F#eine fantastische Köchin}{M#ein fantastischer Koch}. Kochen und Getränkemachen haben viel gemein, weißt du!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020208,
					"content": "Ah, ja, eine Sache noch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020209
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020209,
					"content": "Bei einer früheren Aktion mischte ein Praktikant nach eigenem Verständnis drei Spirituosen. Allein ein Glas davon reichte aus, um einen Gast ohnmächtig auf den Boden fallen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020210
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020210,
					"content": "Seitdem haben wir uns gescheut, Neuankömmlingen alkoholhaltiges Material anzubieten, wir bitten daher um Nachsicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020211
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020211,
					"content": "Verstehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020212
					]
				},
				{
					"id": 705020212,
					"content": "Gut, das war’s dann auch schon. Die Techniken und Tricks werden während der Zubereitung vermittelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charles"
				}
			]
		},
		{
			"id": 7050203,
			"completionStepIds": [
				7050205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
