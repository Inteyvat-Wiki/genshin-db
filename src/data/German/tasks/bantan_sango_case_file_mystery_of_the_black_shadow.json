			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310801,
					"content": "Großartig, das ist sehr hilfreich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310802
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310802,
					"content": "#Paimon sagte doch, dass {NICKNAME} jemand ganz Tolles ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310803,
					"content": "Hast du jetzt die richtige Anzahl von Tieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310804,
					"content": "Lasst mich mal sehen ... Es fehlen immer noch welche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310805
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310805,
					"content": "Wie kann das sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310806,
					"content": "Ich sehe dies hier als trotzdem als Erfolg an. Wir wurden nicht vom „schwarzen Schatten“ angegriffen und haben sogar einige Tiere retten können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310807
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310807,
					"content": "Auf diese Weise gerät die Untersuchung des Falles nicht mehr ins Stocken. Es ist nur schade, dass es im Moment auch keine anderen Hinweise gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310808
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310808,
					"content": "Ich sage dir was, ich werde meine Ermittlungen fortsetzen. Du kannst dich zunächst um andere Dinge kümmern, und wir treffen uns dann in der Detektei Bantan Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310809
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310809,
					"content": "Ja, gut, einverstanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4003151,
