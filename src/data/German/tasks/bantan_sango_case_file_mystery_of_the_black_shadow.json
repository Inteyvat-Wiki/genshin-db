			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310301,
					"content": "Nach den bisherigen Ermittlungen ist es hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310302
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310302,
					"content": "Oh, hier gibt es wirklich eine Menge kleiner Tiere! Haben die sich alle verlaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310303,
					"content": "Das ist ... ein Hund?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310304,
					"content": "Sind es tatsächlich die Hunde, die den Ort bewachen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310305,
					"content": "So sieht es also aus. Das ist komisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310306
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310306,
					"content": "Ryuuji, was ist mit dir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310307,
					"content": "... Damals war es dieser „schwarze Schatten“, der mich in Windeseile erledigte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310308,
						400310310
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310308,
					"content": "Er ist stark.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310309
					]
				},
				{
					"id": 400310309,
					"content": "Nein, nein, nein, du brauchst mich nicht zu trösten ... Ich bin einfach zu schwach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310312
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310312,
					"content": "Wie auch immer, sieh dir diese aufrechte Haltung an, die Arroganz ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310313,
					"content": "Nun ... dieses Aussehen erinnert an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310314,
						400310315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310314,
					"content": "Die Teestube Komore ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310316
					]
				},
				{
					"id": 400310316,
					"content": "Das ist richtig! Daran habe ich auch gedacht, zuerst dachten wir, er könnte tatsächlich sprechen! Schade, dass er nicht sprechen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310317,
					"content": "Der Inhaber der Teestube Komore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310318
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310318,
					"content": "Ryuuji kennt ihn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310319,
					"content": "Ich habe nur davon gehört. Es sieht zwar ein bisschen so aus, aber man sollte es nicht auf die leichte Schulter nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310320
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310320,
					"content": "Schließlich hat Taroumaru viel Kontakt mit der menschlichen Gesellschaft gehabt und ist freundlich zu allen. Bei diesem Hund hingegen kennen wir die Geschichte nicht, also ist es besser, vorsichtig zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310321
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310321,
					"content": "Ha, das stimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310322,
					"content": "Das ist nur eine Erfahrung, die ich bei meinen Ermittlungen gemacht habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310323
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310323,
					"content": "Aber es macht wirklich keinen Sinn ... Warum sollte der Hund die Tiere einsammeln und auf sie aufpassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310324,
					"content": "Hierfür sind möglicherweise weitere Hinweise erforderlich. Jetzt geht es erst einmal darum, die kleinen Tiere zu retten, deren Besitzer bereits sehr besorgt sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310325
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310325,
					"content": "#{NICKNAME}, hier kommst du ins Spiel. Sobald du die Tiere gefunden hast, werde ich mich um den Rest kümmern. Ich werde sie so schnell wie möglich nach Hause bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310326
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310326,
					"content": "Wollen wir das nicht zusammen machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310327
					]
				},
				{
					"id": 400310327,
					"content": "Das ist kein Gegner, den man gemeinsam bewältigen kann. Die Stärke des Gegners ist unvorhersehbar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310328
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310328,
					"content": "Hast du in diesem Fall schon Erfahrungen mit „Einschleichen“ gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310329,
						400310330,
						400310331
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310329,
					"content": "Es hat Versuche gegeben, die „Heilige Leier Der Himmel“ zu stehlen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310332,
					"content": "Das ist wirklich faszinierend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310333
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310333,
					"content": "Auf jeden Fall sollte es uns möglich sein, die Tiere erfolgreich zu retten, wenn wir Konflikte mit den Wächtern vermeiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310334
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310334,
					"content": "Ich habe im Vorfeld einige Hilfsmittel aufgestellt, welche die Aufmerksamkeit des Gegners auf sich ziehen sollen. Ich hoffe, sie können dir helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310335
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310335,
					"content": "Nun, es liegt in deinen Händen. Ich werde hierbleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310330,
					"content": "Nachdem ich durch die Adeptenzeremonie entkommen bin ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310331,
					"content": "Ich habe Beamte auf Ritou beschattet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310315,
					"content": "Taroumaru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310316
					]
				},
				{
					"id": 400310310,
					"content": "Ryuuji ist schwach.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310311
					]
				},
				{
					"id": 400310311,
					"content": "He! Der Hund war einfach zu stark! Auch Paimon würde keine Chance gegen so einen starken Gegner haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310312
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4003105,
			"completionStepIds": [
				4003105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
