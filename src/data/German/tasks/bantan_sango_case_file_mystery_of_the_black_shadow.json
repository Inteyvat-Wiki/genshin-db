			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310101,
					"content": "#{F#Reisende}{M#Reisender}, du kommst rechtzeitig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310102,
					"content": "Dieser Anfang ist vertraut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310103,
						400310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310103,
					"content": "Der nächste Satz ist sicherlich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				},
				{
					"id": 400310105,
					"content": "#Nicht schlecht für {F#eine erfahrene Abenteurerin}{M#einen erfahrenen Abenteurer}. Wie du sagtest, es gibt eine neue Mission für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310106,
					"content": "Die Detektei Bantan Sango braucht Personal und bittet um deine Hilfe bei der Untersuchung des „seltsamen Falls des massenhaften Verschwindens von Kleintieren“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310107,
					"content": "Kleintiere suchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310108,
					"content": "#Ist es wirklich nötig, dass {NICKNAME} für etwas so Einfaches aufbricht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310109,
						400310110,
						400310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310109,
					"content": "Kein Problem, ich habe auch schon Essen geliefert ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310113,
					"content": "Außerdem, ist „Bantan Sango“ nicht eine Detektei, die Fälle aufklärt? Warum braucht sie Abenteurer für sowas ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310114,
					"content": "Es ist so: Sango braucht einen erfahrenen Abenteurer, der mit Ryuuji auf Reisen geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310115,
					"content": "Also, mal sehen ... Sie bat mich, das zu sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310116,
					"content": "„Die Haustiere vieler Menschen sind bei diesem Vorfall verschwunden, und wir haben viele Aufträge erhalten. Wenn wir das Problem lösen können, können wir eine sehr großzügige Zahlung erhalten.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310117,
					"content": "#Sehr großzügig ... Hmmmmm, also, {NICKNAME}, ich denke ... armen kleinen Kreaturen, die nicht zu ihren Besitzern zurückkehren können, muss geholfen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310118,
					"content": "Und Missionen, egal wie groß oder klein, sind immer gut für Wachstum und Fortschritt, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310119,
					"content": "Du bist so leicht zu durchschauen, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310120
					]
				},
				{
					"id": 400310120,
					"content": "Wie auch immer, lass uns zu Sango gehen und sie suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310110,
					"content": "Kein Problem, ich habe auch schon Fahrzeuge repariert ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310111,
					"content": "Kein Problem, ich habe auch schon Sturmschrecken besiegt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310112
					]
				},
				{
					"id": 400310112,
					"content": "Der Sieg über Sturmschrecken ist eine „einfache Sache“? Du bist wahrhaftig unglaublich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310104,
					"content": "Gibt es neue Missionen für mich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				}
			]
		},
		{
			"id": 4003102,
			"completionStepIds": [
				4003102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003102",
							"2"
						],
						"stepId": 4003102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango",
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310202,
					"content": "Nicht schlecht, du bist früher gekommen als erwartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310203
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310203,
					"content": "Das ist sicher! Wir kamen sofort, als wir über die Belohnung ... von dem Bericht über die vermissten Tiere hörten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310204,
					"content": "#Was ist hier eigentlich los? Solange ich mit {NICKNAME} hier bin, wird jedes Dilemma problemlos gelöst werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310205,
					"content": "Ich mache die Arbeit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310206
					]
				},
				{
					"id": 400310206,
					"content": "Paimon feuert dich an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310207,
					"content": "Sehr temperamentvoll. Also, die Sache ist die. In letzter Zeit sind plötzlich mehrere Aufträge aufgetaucht, in denen wir gebeten wurden, verlorene Tiere zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310208
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310208,
					"content": "Bei den meisten dieser Kleintiere handelt es sich um Haustiere, die nicht von alleine weggelaufen wären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310209
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310209,
					"content": "Es stimmt zwar, dass es in Inazuma einige Geschichten über seltsame Kräfte gibt, aber alles hat seine Ursache und Wirkung, und es gibt kein Rätsel, das sich nicht mit Logik lösen lässt. Unsere Untersuchungen vor Ort in den letzten Tagen haben dies bestätigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310210
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310210,
					"content": "Ich mache die Arbeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310211
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310211,
					"content": "Paimon wird dich anfeuern!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310212
					]
				},
				{
					"id": 400310212,
					"content": "Waaah?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310213,
					"content": "Nein, danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310214
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310214,
					"content": "In den letzten Tagen habe ich die Spur der vermissten Tiere verfolgt und einige Lager in der Wildnis gefunden. Es gab einige, die mit Monstern besetzt waren, was kein allzu großes Problem darstellte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310215
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310215,
					"content": "Als ich jedoch versuchte, die gefangenen Tiere in einem der Lager zu befreien ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310216
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310216,
					"content": "... wurde er aber „von einer Wolke schwarzer Schatten angegriffen, die plötzlich auftauchte“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310217
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310217,
					"content": "Als ich aufwachte, war nichts mehr im Lager.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310218
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310218,
					"content": "Tja, sieht nicht gut für unseren Ryuuji aus, was? *seufz* Was ist aus dem Ryuuji geworden, der gebrüllt hat wie der böse Oni Torachiyo selbst, als er den Verursacher des Vorfalls „Sanbongatana Kinpachi“ besiegte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310219
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310219,
					"content": "Und er klammerte sich an mir und schrie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310220
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310220,
					"content": "Warte, halt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310221
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310221,
					"content": "Und was geschah dann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310222,
						400310223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310222,
					"content": "Klären wir zunächst den Sachverhalt, um den es geht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310227
					]
				},
				{
					"id": 400310227,
					"content": "Kurzum, wir brauchen erfahrene Abenteurer wie dich, die mitkommen und die kleinen Kreaturen retten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310228
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310228,
					"content": "Wenn ihr hier seid, könnt ihr euch mehr oder weniger umeinander kümmern, selbst wenn Ryuuji ausgeknockt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310229
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310229,
					"content": "Warum probierst du es nicht selbst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310230,
					"content": "Ich? Ich bin eine Intelligenzperson, und das Wichtigste ist, dass ich meinen Verstand benutze. Für mich ist der Körper nur ein Accessoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310231
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310231,
					"content": "(Oooha, ihre Faulheit ist so gerechtfertigt.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310232,
					"content": "Und natürlich wirst du nicht umsonst arbeiten, der versprochene Lohn ist nicht gering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310233
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310233,
					"content": "Lohn! Gut, los geht’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310234,
						400310235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310234,
					"content": "Paimon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310236
					]
				},
				{
					"id": 400310236,
					"content": "Wartet, bevor ihr geht, nehmt das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310237
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310237,
					"content": "Hm? Was ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310238,
					"content": "Dies ist das <color=#00E1FFFF>„Netz der Ubiquität“</color>. Ich habe einen Freund gebeten, dieses praktische Hilfsmittel nach dem im Buch beschriebenen „Kamuna-Onmyoudou“ herzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310239
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310239,
					"content": "Obwohl sie nicht stark genug sind, um Kriminelle zu überwältigen, lassen sich die Tiere mit dem richtigen Zielen wahrscheinlich leicht einfangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310240
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310240,
					"content": "Damit sollte es ein Kinderspiel sein, die vermissten Tiere zurückzubringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310241
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310241,
					"content": "Aah, damit ist das viel einfacher! Du bist so nett.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310242,
					"content": "Kein Grund, mir so viele Komplimente zu machen, ich will nur nicht, dass ihr es vermasselt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310243
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310243,
					"content": "Ryuuji, geh mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310244
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310244,
					"content": "Jawohl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310245
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310245,
					"content": "Ich habe in den letzten Tagen wieder Spuren von vermissten Tieren gefunden. Kommt mit mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310246,
						400310247
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310246,
					"content": "Dann lass uns losgehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310248
					]
				},
				{
					"id": 400310248,
					"content": "Bis bald.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310247,
					"content": "Danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310248
					]
				},
				{
					"id": 400310235,
					"content": "Paimon ist motiviert ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310236
					]
				},
				{
					"id": 400310223,
					"content": "Und was geschah dann?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310224
					]
				},
				{
					"id": 400310224,
					"content": "Herrje, Interesse an den Ereignissen, die wir gelöst haben? Damals ging es in etwa so. Der normalerweise liebenswürdige Wachtmeister Kinpachi, der ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310225
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310225,
					"content": "Klären wir zunächst den Sachverhalt, um den es geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310226
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310226,
					"content": "Tut mir leid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310227
					],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 4003103,
			"completionStepIds": [
				4003103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003103",
							"2"
						],
						"stepId": 4003103,
						"stateName": "QUEST_STATE_UNFINISHED"
