			},
			"dialogs": [
				{
					"id": 400315101,
					"content": "#{NICKNAME}? Kann ich dir weiterhelfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315102,
						400315107,
						400315110
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315102,
					"content": "Wegen des „Netzes der Ubiquität“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315103
					]
				},
				{
					"id": 400315103,
					"content": "Dieses hier ... war ursprünglich für Ryuuji gedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315104
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315104,
					"content": "Schließlich ist unser Beruf nicht ganz ungefährlich. Ryuuji wurde mehrmals verletzt und wollte deshalb jemanden beauftragen, ein handliches Werkzeug zu bauen, das „einen Verbrecher aus der Ferne überwältigen kann“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315105
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315105,
					"content": "Damals las ich auch viele alte Bücher, um dieses Netz zu entwerfen, und beauftragte dann einen Freund, es herzustellen. Aber am Ende hatte das fertige Produkt nur die Macht, ein kleines Tier zu kontrollieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315106
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315106,
					"content": "In jedem Fall ist es gut, dass du es benutzen konntest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315107,
					"content": "Wegen des Vorfalls „Sanbongatana Kinpachi“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315108
					]
				},
				{
					"id": 400315108,
					"content": "Bist du sehr daran interessiert? Es ist so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315109
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315109,
					"content": "... Wenn ich es mir recht überlege, schien Ryuuji nicht darüber sprechen zu wollen, was zu diesem Zeitpunkt vor sich ging. Es ist besser, es sein zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315110,
					"content": "Ich geh dann mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315111
					]
				},
				{
					"id": 400315111,
					"content": "Bis bald.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 4003152,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
