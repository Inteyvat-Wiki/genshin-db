				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310501,
					"content": "Super! Ich habe dein Geschick gesehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310502
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310502,
					"content": "#{NICKNAME} ist großartig, es ist ein Kinderspiel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310503,
					"content": "Gut, nun zum nächsten Ziel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310504
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310504,
					"content": "Gibt es noch welche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310505,
					"content": "Ja, natürlich. Nach der Anzahl der Aufträge zu urteilen, die Sango erhalten hat, ist dies der größte Fall von vermissten Tieren in der Geschichte von Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310506
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310506,
					"content": "... Allerdings ist es nicht üblich, dass so viele kleine Tiere gleichzeitig verschwinden. Dieser Vorfall ist in jeder Hinsicht ungewöhnlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310507
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310507,
					"content": "Ich war der Spur bereits an anderer Stelle gefolgt und hatte die gefangenen Tiere gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310508
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310508,
					"content": "Wollen wir uns wieder „einschleichen“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310509
					]
				},
				{
					"id": 400310509,
					"content": "Dieses Mal nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310510
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310510,
					"content": "Keine Sorge, aufgrund deiner Fähigkeiten sollte es kein schwieriger Gegner sein, du wirst es merken, wenn du dort bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 4003108,
			"completionStepIds": [
				4003108
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
