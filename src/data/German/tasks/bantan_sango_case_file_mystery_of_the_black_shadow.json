			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400315201,
					"content": "Was passiert, nachdem wir die Tiere gefangen haben, überlass einfach mir. Ich bringe sie so schnell wie möglich nach Hause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315202,
						400315207,
						400315210
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315202,
					"content": "Über den „schwarzen Schatten“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315203
					]
				},
				{
					"id": 400315203,
					"content": "Ich habe bereits Gerüchte gehört, dass eine mysteriöse Organisation „Ninken“ ausbildet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315204
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315204,
					"content": "Es heißt, dass ein Ninken mit dem Codenamen „Inujin“ heimlich zahllose Monster vernichtet hat, die für Inazuma schädlich sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315205
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315205,
					"content": "... Natürlich ist es nur eine Legende. Dieser „schwarze Schatten“ könnte aber auch der legendäre Ninken sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315206,
					"content": "... Egal, es fühlt sich immer wie eine Ausrede an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315207,
					"content": "Über „das, was Aufmerksamkeit auf sich zieht“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315208
					]
				},
				{
					"id": 400315208,
					"content": "Es gab keine Möglichkeit, die Tiere aus seinem Blickfeld zu bekommen, aber während der Erkundung fand ich die Gelegenheit, einige Rauchmechanismen einzusetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315209
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315209,
					"content": "Die Aktivierung der Vorrichtung sollte vorübergehend seine Aufmerksamkeit erregen. Ich hoffe, das hilft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315210,
					"content": "Bin bald zurück.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315211
					]
				},
				{
					"id": 400315211,
					"content": "Nun, es liegt in deinen Händen. Ich werde hierbleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		}
	]
}