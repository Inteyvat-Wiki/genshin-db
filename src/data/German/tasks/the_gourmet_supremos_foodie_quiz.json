					"nextDialogs": [
						220220703
					]
				},
				{
					"id": 220220703,
					"content": "Xudong sagte nur, dass er die Gerichte billiger machen wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
