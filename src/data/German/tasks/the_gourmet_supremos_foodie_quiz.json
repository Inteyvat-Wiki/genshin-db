			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220220101,
					"content": "Dieses Rezept sollte wie folgt aussehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220102
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220102,
					"content": "Was tust du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220103
					]
				},
				{
					"id": 220220103,
					"content": "Ich bin dabei, Rezepte zu sortieren. Leider kann ich mich an einige nicht mehr genau erinnern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220104,
						220220106
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220104,
					"content": "Warum fragst du nicht Xudong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220105
					]
				},
				{
					"id": 220220105,
					"content": "Xudong ... Er und seine „kreativen Gerichte“ sind der Hauptgrund, warum ich mich nicht an sie erinnern kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220109,
					"content": "Jedes Mal, wenn er ein neues Rezept in die Finger bekommt, hält er sich höchstens ein oder zwei Tage an das Rezept.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220110
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220110,
					"content": "Dann ... versucht er verschiedene Dinge, um sie zu verändern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220111,
						220220113
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220111,
					"content": "Warum sollte er das tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220112
					]
				},
				{
					"id": 220220112,
					"content": "Laut ihm ist es, um sie weniger teuer zu machen ... Aber ich bin mir nicht ganz sicher, warum er das alles gemacht hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220118,
					"content": "Aber egal, die Ergebnisse sprechen für sich. Er war tatsächlich erfolgreich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220119
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220119,
					"content": "Der Geschmack ist ähnlich wie beim Original, aber die Kosten sind lächerlich gering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220120
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220120,
					"content": "Seine komischen Kochmethoden sind der Grund, warum ich bereit war, mit ihm zu arbeiten. Und ich denke, der Grund, warum er bereit war, mich einzustellen, sind meine Fähigkeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220121,
						220220123
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220121,
					"content": "Also, was soll ich für dich tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220122
					]
				},
				{
					"id": 220220122,
					"content": "Ah ... hoppla! Ich war so damit beschäftigt, über Xudong zu reden, dass ich fast das eigentliche Thema vergessen habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220128,
					"content": "Xudong hat mich damit genervt, die Rezepte zu ändern. Er hat direkt auf sie geschrieben und gezeichnet ... So sind einige Rezepte schwerer zu lesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220129
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220129,
					"content": "Ich möchte diese Rezepte genau so wie sie waren wiederherstellen und eine Kopie speichern, für den Fall, dass das richtige Rezept benötigt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220130
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220130,
					"content": "#{F#Reisende}{M#Reisender}, wenn du dich noch an sie erinnerst, könntest du mir helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220131,
						220220132
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220131,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220133,
					"content": "Danke! So, ich werde die durcheinander geratenen Rezepte aussortieren und du kannst die unklaren Teile korrigieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220132,
					"content": "Ja, natürlich. Ich habe mich durch Teyvat gefressen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220123,
					"content": "Deine Fähigkeiten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220124
					]
				},
				{
					"id": 220220124,
					"content": "Habe ich es dir nicht gesagt? Mein Forschungsthema an der Akademie ist die „ultimative Würze“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220125
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220125,
					"content": "Einfacher gesagt, versuche ich, ein Supergewürz zu kreieren, das jedes Essen lecker machen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220126
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220126,
					"content": "Das ist der Grund, warum ich hier draußen bin, um Informationen über verschiedene Küchen zu sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220127
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220127,
					"content": "Ähem, ich habe zu lange geredet. Lass uns zurück zu den Rezepten kommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220113,
					"content": "Wie genau hat er sie verändert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220114
					]
				},
				{
					"id": 220220114,
					"content": "Nun ... seine Art ist anders als andere. Die meisten Köche versuchen, das Rezept reichhaltiger zu machen, damit das Gericht zu einem höheren Preis verkauft werden kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220115
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220115,
					"content": "Aber Xudong scheint ein ganz anderes Prinzip zu haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220116
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220116,
					"content": "Zum Beispiel hat er Kartoffeln, Pilze und einige andere billige Gemüsesorten verwendet, um ein vegetarisches Gericht zu machen, das irgendwie nach kalten Geflügelhäppchen schmeckte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220117
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220117,
					"content": "Es gibt auch diese vereinfachte Version von der Versuchung der Adepten, die mit Kartoffeln, Reis, Lotosfrucht, Jueyun-Peperoni, Teig und rohem Fleisch zubereitet wird. Die Textur und der Geschmack sind dem Originalgericht irgendwie ähnlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220106,
					"content": "Warte! Seid ihr nicht die vielseitigen Feinschmecker?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220107
					]
				},
				{
					"id": 220220107,
					"content": "Bitte erwähne diesen Namen mir gegenüber nicht mehr. Diese Worte werden niemals in meiner Arbeit erscheinen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220108
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220108,
					"content": "Außerdem sind Xudong und seine „kreativen Gerichte“ der Hauptgrund, warum ich mir diese Rezepte nicht merken kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "Parvaneh"
				}
			]
		},
		{
