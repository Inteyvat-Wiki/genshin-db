			"dialogs": [
				{
					"id": 220220501,
					"content": "Es gibt ein Gericht namens Spieß mit drei Aromen in Inazuma ... Seit Onkel Munehisa Xudong dieses Gericht beigebracht hat, arbeitet er hart daran ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220502
