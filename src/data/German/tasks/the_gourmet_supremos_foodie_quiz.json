			},
			"dialogs": [
				{
					"id": 220220401,
					"content": "In Liyue gibt es ein Gericht namens Bambussuppe mit Fleischeinlage. Sie soll sehr delikat sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220402
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220402,
					"content": "Xudong ... er hat auch das geändert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220403
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220403,
					"content": "„Goldfischkraut hacken und mit Champignons kochen. Füge Salz und Zucker hinzu. Die Suppe wird wie Schinken schmecken.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220404
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220404,
					"content": "Wer würde diese Dinge zusammen kochen!? Und selbst wenn die Suppe nach Schinken schmecken würde, ist es ja nicht so, dass da welcher drin wäre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220405
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220405,
					"content": "#Vergiss es ... {F#Reisende}{M#Reisender}, was ich fragen möchte, ist: Was ist außer rohem Fleisch noch in der Bambussuppe mit Fleischeinlage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220406,
						220220407,
						220220408,
						220220409
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220406,
					"content": "Vogeleier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220411
					]
				},
				{
					"id": 220220411,
					"content": "Hmm ... Ist das so? Lass es mich erst aufschreiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220407,
					"content": "Fisch.",
