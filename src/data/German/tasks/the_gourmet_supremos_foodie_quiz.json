			"dialogs": [
				{
					"id": 220220301,
					"content": "Es gibt ein berühmtes Gericht namens Tianshu-Braten in Liyue, mal sehen ... Äh, Xudong hat hier auch etwas hingekritzelt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220302
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220302,
					"content": "„Geschälte Kartoffeln dämpfen, im heißen Zustand pürieren, Öl und Salz hinzufügen. Dann in eine Schüssel geben und mit einer dicken Soße übergießen. Der erste Biss ist wie weiches Fleisch.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220303
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220303,
					"content": "Der erste Biss ... heißt das, dass man das nach ein paar weiteren Bissen erkennen kann? Komm schon, das wird nur diejenigen täuschen, die noch nie echten Tianshu-Braten gegessen haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220304
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220304,
					"content": "#Vergiss es ... {F#Reisende}{M#Reisender}, was ich fragen möchte, ist: Was ist außer rohem Fleisch, Zucker und Matsutake noch im Tianshu-Braten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220305,
						220220306,
						220220308,
						220220309
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220305,
					"content": "Glasglöckchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220310
					]
				},
				{
					"id": 220220310,
					"content": "Hmm ... Ist das so? Lass es mich erst aufschreiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220306,
					"content": "Qingxin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220307
					]
				},
				{
					"id": 220220307,
					"content": "Hmm ... Ist das so? Lass es mich erst aufschreiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220308,
					"content": "Goldfischkraut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220310
					]
				},
				{
					"id": 220220309,
					"content": "Wasserlilien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220310
					]
				}
			]
		},
