					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220502,
					"content": "Ich kann nicht glauben, dass er so viele Notizen gemacht hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220503
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220503,
					"content": "„Das Wort Spieß ist ein so wunderbarer Name. Alles kann auf einen Spieß aufgespießt werden ...“",
