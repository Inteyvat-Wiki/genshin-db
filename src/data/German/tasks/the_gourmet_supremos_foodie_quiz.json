			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220220201,
					"content": "In Mondstadt gibt es ein Gericht namens Apfelschmorfleisch aus dem Norden. Hmm, Xudong hat hier wieder einen Haufen Unsinn aufgeschrieben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220202
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220202,
					"content": "„Butter ist teuer und rohes Fleisch ist schwer zu lagern. Warum nicht den Teig kneten, das Gluten auswaschen, dämpfen und mit Obst und Gemüse würzen, um ihm einen herzhaften Geschmack zu geben?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220203
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220203,
					"content": "Dieser Kerl ... Wieso ist Butter teuer? Und warum nicht einfach frisches Fleisch kaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220204
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220204,
					"content": "#Vergiss es ... {F#Reisende}{M#Reisender}, was ich fragen möchte, ist: Was ist außer Äpfeln, Butter und rohem Fleisch noch im Apfelschmorfleisch aus dem Norden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220205,
						220220206,
						220220208,
						220220209
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220205,
					"content": "Mandeln.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
					"id": 220220210,
					"content": "Hmm ... Ist das so? Lass es mich erst aufschreiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220206,
					"content": "Pfeffer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220207
					]
				},
				{
					"id": 220220207,
					"content": "Hmm ... Ist das so? Lass es mich erst aufschreiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220208,
					"content": "Jueyun-Peperoni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
					"id": 220220209,
					"content": "Schinken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				}
			]
		},
		{
