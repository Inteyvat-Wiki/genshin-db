			"dialogs": [
				{
					"id": 760390101,
					"content": "Laut Notfallplan – wenn das Warnsignal ausgelöst wird – schickt das Hauptquartier uns, die Spezialunterstützungseinheit „Sumrak“, zur Verstärkung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760390102
					],
					"speakerTitle": "Verirrtes Phantom"
				},
				{
					"id": 760390102,
					"content": "Der Nebel ist hier zu dicht. Wir können den Leuchtturm nicht sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760390103
					],
					"speakerTitle": "Verirrtes Phantom"
				},
				{
					"id": 760390103,
					"content": "Kommandant ... Ich höre Schritte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760390104
					],
					"speakerTitle": "Verirrtes Phantom"
				},
				{
					"id": 760390104,
					"content": "Bist du ein Lichthüter, der auf dieser Insel stationiert ist ... Bitte antworte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760390105,
						760390106
					],
					"speakerTitle": "Verirrtes Phantom"
				},
				{
					"id": 760390105,
					"content": "Richtig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760390107
					]
				},
				{
					"id": 760390106,
					"content": "Der Leuchtturm ist im Nordosten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760390107
					]
				},
				{
					"id": 760390107,
					"content": "Da stimmt etwas nicht ... Bleibt auf der Hut ...",
