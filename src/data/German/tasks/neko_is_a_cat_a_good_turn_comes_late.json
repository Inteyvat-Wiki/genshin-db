			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"„Neko“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160101,
					"content": "Du bist da. Der Steinmensch meint, dass er fast fertig ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160102
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160102,
					"content": "Begleite mich. Der Steinmensch ist gleich da drüben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				}
			]
		},
		{
			"id": 7221602,
			"completionStepIds": [
				7221602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"2"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei",
					"„Neko“",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160201,
					"content": "Puh. Fast fertig. Das war ein gewaltiges Unterfangen, wenn ich das so sagen darf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160202
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160202,
					"content": "Oh! Du bist es. Und die Frau Priesterin ist auch da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160203
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160203,
					"content": "Wie geht’s? Ist die Statue fertig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160204
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160204,
					"content": "Ja, sie ist fertig, wie ihr seht, hehe! Ich habe extra noch einen letzten Fleck nicht bearbeitet ... und auf die Rückkehr der Frau Priesterin gewartet, bevor ich mich darum kümmere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160205
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160205,
					"content": "Wie aufmerksam!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160206
					]
				},
				{
					"id": 722160206,
					"content": "Natürlich! Statuen für Schreine haben schließlich etwas ganz Formelles an sich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160207
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160207,
					"content": "Miau, miau, ist das Klopfen auf Stein so was Wichtiges?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160208
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160208,
					"content": "Nun, wie soll ich sagen ... Für gewöhnlich stellen unsere Skulpturen wichtige Dinge oder Persönlichkeiten dar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160209
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160209,
					"content": "Paimon, du solltest wahrscheinlich eine Skulptur in Form einer Mahlzeit in Auftrag geben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160210
					]
				},
				{
					"id": 722160210,
					"content": "He! Das ist nicht nett!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722160211,
					"content": "Das heißt also ... Du verewigst gute Dinge in Stein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160212
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160212,
					"content": "Hahaha! Na ja, ich finde, „gut“ reicht noch nicht! Statuen sind ja schließlich „Erinnerungen für die Ewigkeit“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160213
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160213,
					"content": "Nein, nein. Das ist keine „Erinnerung für die Ewigkeit“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160214
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160214,
					"content": "Meine Wenigkeit wünscht sich nur, dass Hibiki diese Statue sieht, sollte sie zurückkehren und nicht herfinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160215
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160215,
					"content": "Dann wird sie wissen, wo sie hinmuss, und sich nicht verirren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160216
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160216,
					"content": "O... Oh, verstehe. Frau Priesterin, diese „Hibiki“ ist dir wirklich wichtig, hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160217
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160217,
					"content": "Neko ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160218
					]
				},
				{
					"id": 722160218,
					"content": "Hibiki wird irgendwann wieder zurückkommen. Außerdem haben sie und Domeki gemeint, dass etwas Gutes geschehen wird, sobald diese Statue fertig ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160219
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160219,
					"content": "Nun denn, Steinmensch. Brauchst du mich noch für etwas anderes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160220
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160220,
					"content": "Na ja, nicht wirklich ... Aber da du schon einmal hier bist, Frau Priesterin, kann ich mich jetzt um den letzten Fleck kümmern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160221
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160221,
					"content": "Drei ... zwei ... eins!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160222
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160222,
					"content": "W... Was ist mit dieser Wolke los ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160223,
						722160224
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160223,
					"content": "Sie hat die Form einer Katze angenommen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160225
					]
				},
				{
					"id": 722160225,
					"content": "Das ist Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160226
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160226,
					"content": "Hä?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160227
					]
				},
				{
					"id": 722160227,
					"content": "Hibiki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160228
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160228,
					"content": "Miau, miau, miau! Das war bestimmt Hibiki! Etwas Gutes ist geschehen, genauso, wie sie gesagt hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160229
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160229,
					"content": "Es ist genauso, wie sie gesagt hat. Genauso, wie sie es mir gesagt hat! Etwas Gutes würde geschehen, sobald diese Statue fertig ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160230
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160230,
					"content": "Wunderbar, das ist wunderbar! Sie hat die Wahrheit gesagt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160231
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160231,
					"content": "Ja, sie wird bestimmt zurückkehren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160232
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160232,
					"content": "Hu... Hurra! Hahaha, ich weiß nicht, was los ist, aber so, wie sich die Frau Priesterin freut, ist es bestimmt was Gutes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160233
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160233,
					"content": "Neko ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160234
					]
				},
				{
					"id": 722160234,
					"content": "Mit deiner Hilfe wurde der Schrein wieder schön.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160235
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160235,
					"content": "Das Spendenkästchen ist repariert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160236
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160236,
					"content": "Das Gebetsregal ist repariert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160237
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160237,
					"content": "Die Statue ist auch fertig! Jetzt wird Hibiki ganz bestimmt zurückkehren, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160238
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160238,
					"content": "Und Domeki, Janome und alle Freunde Hibikis auch! Sie werden mit ihr zurückkehren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160239
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160239,
					"content": "Du ... Du bist ein guter Mensch! Besser als dieses Essen! Hibiki wird dich mit Sicherheit gut leiden können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160240
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160240,
					"content": "Ich muss die ganzen kleinen Bengel zusammenrufen und Pläne für ihre Rückkehr machen. Und ... ja, natürlich, natürlich, die vielen Besucher des Schreins. Ich werde auch diesbezüglich Anweisungen geben müssen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160241
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160241,
					"content": "Und dann gibt es noch die ganzen anderen Angelegenheiten, um die man sich vorher kümmern muss ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160242
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160242,
					"content": "Oh, Hibiki ... Miau, miau, miau! Das ist wunderbar, wunderbar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722160224,
					"content": "Was zum ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160225
					]
				}
			]
		},
		{
			"id": 7221603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"3"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160301,
					"content": "Haha, die Frau Priesterin ist außer sich vor Freude. Diese „Hibiki“ muss ziemlich wichtig sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160302,
					"content": "Nur schade, dass wir nicht wissen, wo sie ist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7221604,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"3"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Etsuko",
					"Taisuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160401,
					"content": "Stimmt, „Hibiki“, „Asase-Schrein“, „Domeki“ ... diese Namen sind ziemlich besorgniserregend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160402,
						722160407
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160402,
					"content": "Und wo kommt ihr zwei her?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160403
					]
				},
				{
					"id": 722160403,
					"content": "Na ja, ihr habt so einen Radau veranstaltet, natürlich sind wir rübergekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160404
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160404,
					"content": "Trotzdem, ich glaube, dass ihr etwas wissen solltet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160405
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160405,
					"content": "Taisuke, wärst du so gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160406
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160406,
					"content": "Ah, stimmt. Natürlich, Fräulein Etsuko. Also, was wir euch zu sagen haben ... betrifft die Insel Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160408
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160408,
					"content": "Die Geschichte der Insel ist ziemlich obskur und die Gilde hat zwar versucht, Genaueres herauszufinden, aber wir haben nicht viel entdeckt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160409
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160409,
					"content": "Wir haben mit Müh und Not herausgefunden, dass die Insel vor mehreren hundert Jahren ein Versammlungsort für Piraten war. Dann wurden sie vom Bakufu vertrieben und die Einwohner umgesiedelt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160410
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160410,
					"content": "Wenn ich mich nicht irre, handelte es sich bei diesem „Domeki“ wahrscheinlich um den Anführer der Piraten, „Ako Domeki“, der das Bakufu frontal bekämpfte. Sein Name taucht in den Aufzeichnungen auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160411
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160411,
					"content": "Laut diesen Aufzeichnungen führte dieser Ako Domeki seine Piratenflotte in einer Seeschlacht gegen das Bakufu an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160412
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160412,
					"content": "Sie wurden schnell bezwungen und mussten sich auf die Insel Seirai zurückziehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160413
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160413,
					"content": "Aber als ihn die Flotte des Bakufu verfolgte, begann es auf Seirai plötzlich zu stürmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160414
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160414,
					"content": "Ako Domekis Flotte und die des Bakufu gerieten in den Sturm ... und sie gingen verschollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160415
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160415,
					"content": "Ein Sturm ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160416
					]
				},
				{
					"id": 722160416,
					"content": "Ich erzähle weiter. Das größte Rätsel ist natürlich, wie dieser Sturm so plötzlich auftreten konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160417
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160417,
					"content": "Obwohl Ako Domekis Flotte auch in diesen Sturm geriet und fast gekentert wäre, ging die Bakufu-Flotte ebenfalls verschollen und die paar verbleibenden Schiffe mussten sich auf die Insel Narakumi zurückziehen. Es dauerte eine ganze Weile, bis die Flotte wieder aufgebaut war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160418
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160418,
					"content": "Der Zeitpunkt des Sturms war einfach zu perfekt. Als ob ... ihn jemand kontrolliert hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160419
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160419,
					"content": "Ihr habt doch die Schutzsteine auf dieser Insel gesehen. Jemand hat ihr Siegel bewusst entfernt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160420
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160420,
					"content": "Und als wir sie wieder versiegelten, herrschte auf der Insel wieder Ruhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160421
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160421,
					"content": "Ich will ja keine voreiligen Schlüsse ziehen, aber mein Bauch sagt mir, dass diese Vorfälle eindeutig miteinander verbunden sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160422
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160422,
					"content": "Na ja, wir könnten Frau Neko fragen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160423
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160423,
					"content": "Vergiss es. Laut den Aufzeichnungen wird Domeki seither vermisst ... Na ja, zumindest heißt es das, aber wenn er in diesen Sturm geriet, ist er wahrscheinlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160424
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160424,
					"content": "Wir erkunden diese Insel noch etwas weiter und sammeln mehr Informationen über diesen Vorfall. Und danach erstatten wir der Gilde Bericht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160425
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160425,
					"content": "Wer weiß? Vielleicht haben wir irgendwann mal wieder das Vergnügen, zusammenzuarbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160426
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160426,
					"content": "Ich freue mich darauf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160427
					]
				},
				{
					"id": 722160427,
					"content": "Das beruht auf Gegenseitigkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160428
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160428,
					"content": "Na dann, Taisuke, brechen wir auf. Auf uns warten ein paar Entdeckungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160429
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160429,
					"content": "Ähm, Fräulein Etsuko, wegen Frau Neko ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160430
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160430,
					"content": "Du kannst diese Katze natürlich weiterhin so behandeln wie vorher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160431
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160431,
					"content": "Achte einfach auf deine Worte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160432
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160432,
					"content": "Sie ist im Augenblick glücklich. Lass ihr die Freude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160433
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160433,
					"content": "Verstanden. Haha, Fräulein Etsuko, du bist wirklich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160434
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160434,
					"content": "Ich versuche nur, unsere Mission effizienter durchzuführen. Komm, machen wir uns an die Arbeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160435
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160435,
					"content": "Seirai ... Diese Insel steckt wohl immer noch voller Geheimnisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160407,
					"content": "Was wollt ihr uns sagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160408
					]
				}
			]
		}
	]
}