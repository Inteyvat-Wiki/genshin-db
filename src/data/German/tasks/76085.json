					}
				]
			},
			"dialogs": [
				{
					"id": 760520401,
					"content": "Hm, so etwas habe ich schon einmal gerochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520402
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520402,
					"content": "Oh, wirklich? Wo denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520403,
					"content": "In Sandrones Zimmer. Sie hatte ein Getränk, das genauso gerochen hat. Das Aroma hat mein Interesse geweckt, und als sie es bemerkte ... hielt sie das Glas eine gefühlte Ewigkeit in der Hand, ohne es auszutrinken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520404
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520404,
					"content": "Es war, als ... würde sie warten, dass ich danach frage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520405
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520405,
					"content": "Und ... hast du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520406
					]
				},
				{
					"id": 760520406,
					"content": "Ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520407
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520407,
					"content": "Was hast du gefragt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520408,
					"content": "Solltest du nicht eher Motoröl trinken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520409
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520409,
					"content": "Und ... wie hat sie geantwortet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520410
					]
				},
				{
					"id": 760520410,
					"content": "Na ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520411
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520411,
					"content": "Sie sagte etwas sehr Unangenehmes. Das muss jetzt hier nicht wiederholt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520412
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520412,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520413
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520413,
					"content": "Du hast schon nach einem einzigen Schluck das Interesse verloren?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520414,
					"content": "Entschuldigung, es war etwas bitter ... insgesamt nicht sehr gut. Kein Wunder, dass Sandrone so angesäuert aussah, als sie es trank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520415
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520415,
					"content": "Paimon glaubt, dass das dafür womöglich noch andere Gründe gab ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
