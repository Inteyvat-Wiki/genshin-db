			"dialogs": [
				{
					"id": 760850601,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850602
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760850602,
					"content": "Das Getränk diesmal schmeckt wirklich gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850603
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760850603,
					"content": "Das ist bis jetzt mein Lieblingsgetränk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850604
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760850604,
					"content": "Wahh! Endlich haben wir einen Geschmack gefunden, der Columbia gefällt. Das rührt Paimon wirklich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850605,
					"content": "Oh, das ... tut mir leid?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850606
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760850606,
					"content": "Also kurz gesagt: Es sollte nicht vordergründig bitter schmecken, nicht direkt mit Saft hergestellt sein, und ohne Milch scheint es besser zu sein als mit Milch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850608
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760850608,
					"content": "Das ist also das Rezept für „nicht schwer“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850609
					]
				},
				{
					"id": 760850609,
					"content": "Aber gut, dass wir jetzt eine Art Muster haben. So weißt du in Zukunft, wie du es mischen musst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850610,
					"content": "... in Zukunft?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850611
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760850611,
					"content": "Na klar, wir sind doch Freunde! Wenn du wieder was trinken willst, musst du uns einfach nur Bescheid sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850612,
					"content": "Du hast doch wohl nicht etwa die ganze Zeit nicht ausgetrunken, weil du dachtest, dass es nach diesem Glas nichts mehr gibt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850613,
					"content": "... Hm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850614
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760850614,
					"content": "Keine Sorge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850615
					]
				},
				{
					"id": 760850615,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850616
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760850616,
					"content": "Danke für die Bewirtung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				}
			]
		},
