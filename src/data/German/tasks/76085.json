			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Columbina“"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2155.005,
							109.349,
							11195.66
						],
						"pointId": 360300006
					}
				]
			},
			"dialogs": [
				{
					"id": 760520201,
					"content": "Nun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520202
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520202,
					"content": "Also, was denkst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520203,
					"content": "Es erinnert mich an eine Zeit, die schon lange vergangen ist, als ich noch bei den Nachkommen des Frostmonds gelebt habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520204
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520204,
					"content": "Die Leute brühten immer eine Art Tee aus frischer Minze, Gewürzen und getrockneten Beeren auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520205
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520205,
					"content": "Immer, wenn ich an ihren Häusern vorbeiging, waberte ein subtiles, fruchtiges Aroma aus den Fenstern heraus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520206
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520206,
					"content": "Hast du jemals gekostet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520207,
					"content": "Ich wollte, aber hatte nie Gelegenheit dazu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520208
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520208,
					"content": "Oh, warum nicht ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520209,
					"content": "Wenn eine „Göttin“ an deiner Tür klopft und fragt „Dürfte ich deinen Tee probieren?“ ... Da würde niemand wagen, den „rustikalen Tee“ anzubieten, den man eigentlich für den eigenen Gebrauch zusammengemischt hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520210
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520210,
					"content": "Ah ... Ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520211,
					"content": "Was ich am Ende bekommen habe, war eher eine „Darreichung“ für die Göttlichen, in einer prunkvollen Verpackung und mit allem drum und dran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520212
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520212,
					"content": "Nicht, dass es schlecht geschmeckt hätte ... Aber es fehlte dieses Gefühl nach ... „Zuhause“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520213
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520213,
					"content": "Also da können wir was machen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520214
					]
				},
				{
					"id": 760520214,
					"content": "Nun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520215
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520215,
					"content": "Der Geschmack ist entzückend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520216
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520216,
					"content": "... Wobei ich sagen muss, dass der Gedanke, Milch beizumischen, auf mich ziemlich unkonventionell wirkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520217
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520217,
					"content": "Also, nun ja, das ist ein Rezept aus Mondstadt. Die Leute dort lieben es, Milch, Sahne und Zucker in ihren Tee zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520218,
					"content": "Das ist neu für mich ... aber im guten Sinne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520219
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520219,
					"content": "Puh, schön, dass es dir schmeckt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520220,
					"content": "Mhh ... Danke dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520221
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760520221,
					"content": "Es scheint, als wäre Mondlicht nicht das einzige Medium, durch das man einen Blick in die Vergangenheit werfen kann. Sogar so etwas Simples wie der Geschmack eines Getränks kann lange vergessene Erinnerungen neu erwecken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				}
			]
		},
		{
