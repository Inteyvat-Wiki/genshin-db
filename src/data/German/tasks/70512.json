				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120501,
					"content": "Aaah! Wo kommen auf einmal so viele Monster her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120502,
					"content": "Moment ... Ist das nicht Meister Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120503,
					"content": "Er sieht ein wenig anders aus als sonst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120504,
					"content": "Schau, wie scharfsinnig und energiegeladen er wirkt! Das ist also der „Pyro-Ritter“, wenn er das Feuer frei gibt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120505,
						705120506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120505,
					"content": "Das muss Diluc sein, wie er früher hier kämpfte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120507
					]
				},
				{
					"id": 705120507,
					"content": "Du hast recht. Wenn man genau hinsieht, wirkt Diluc viel jünger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120508,
					"content": "Aber was ist damals passiert? Warum hat Diluc hier gekämpft?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120509,
					"content": "Hmm ... Am besten fragen wir ihn selbst, wenn wir ihn sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120510,
					"content": "#Was sollen wir tun, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120511,
						705120512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120511,
					"content": "Wir sollten nicht vorschnell handeln.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120513
					]
				},
				{
					"id": 705120513,
					"content": "Na gut, dann sehen wir erstmal wie sich der Diluc von damals geschlagen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120512,
					"content": "Wir sollten erstmal beobachten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120513
					]
				},
				{
					"id": 705120506,
					"content": "Der Fluss der Elemente hat das damalige Geschehen aufgezeichnet und zeigt es nun erneut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120507
					]
				}
			]
		},
		{
			"id": 7051207,
			"completionStepIds": [
				7051207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051207",
							"2"
						],
						"stepId": 7051207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120701,
					"content": "Es ist vorbei. Diluc hat so einfach gewonnen, manche Dinge ändern sich wohl nie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120702,
					"content": "Aber was wir gesehen haben, waren nur ein paar Trugbilder aus der Vergangenheit. Es sieht so aus, als gäbe es hier eigentlich keine Gefahr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120703,
						705120704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120703,
					"content": "Der Diluc unserer Zeit war bestimmt schon hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120705
					]
				},
				{
					"id": 705120705,
					"content": "Das heißt, Diluc ist hier schon fertig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120706,
					"content": "Werden Monster auftauchen, wenn wir noch einmal diese seltsame Elementanhäufung berühren? Und der Diluc von damals?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120707,
					"content": "Wenn es so ist wie bei den Elementanhäufungen, denen wir früher begegnet sind, dann müsste das seltsame Phänomen nach Besiegen aller Monster verschwinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120708,
						705120709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120708,
					"content": "Interessierst du dich sehr für den Diluc von damals?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120710
					]
				},
				{
					"id": 705120710,
					"content": "Weder noch, es beunruhigt Paimon nur ein wenig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120711,
					"content": "Stell dir vor, ein neugieriger Passant käme vorbei und würde etwas von der Aufregung mitbekommen und ein Monster springt mit einem „Ah!“ hervor und zieht ihm mit einem „Klonk!“ eins über die Rübe, das wäre furchtbar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120712,
					"content": "Warum diese seltsamen Lautmalereien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120713
					]
				},
				{
					"id": 705120713,
					"content": "Weil es so noch gefährlicher klingt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120714,
					"content": "Auf jeden Fall haben wir uns ursprünglich vorgenommen, Diluc zu helfen. Da sollten wir gründlich sein, also lass uns sicherstellen, dass hier wirklich keine Gefahr droht, bevor wir gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120715,
					"content": "Du hast ein sehr starkes Verantwortungsbewusstsein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120716
					]
				},
				{
					"id": 705120716,
					"content": "Hihi ... Nicht wirklich, ich will nur diesen leckeren Traubensaft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120717,
					"content": "#Komm schon, {NICKNAME}. Wenn du dich noch ein wenig anstrengst, gibt Paimon dir auch noch ein wenig vom Traubensaft ab!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120709,
					"content": "Oder sind es die Elementaranomalien, die dich interessieren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120710
					]
				},
				{
					"id": 705120704,
					"content": "Falls es hier noch ein paar Angreifer gibt, dann sind das nur kümmerliche Überreste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120705
					]
				}
			]
		},
