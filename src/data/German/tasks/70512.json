			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Adelinde"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120201,
					"content": "Einen wunderschönen Tag, die beiden. Lange nicht gesehen, ihr seht so fantastisch aus wie eh und je.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120202
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120202,
					"content": "Guten Tag, Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120203,
					"content": "Was verschafft uns die Ehre? Habt ihr etwas Wichtiges mit Meister Diluc zu besprechen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120204,
						705120205
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120204,
					"content": "Eigentlich geht es nur um Traubensaft ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				},
				{
					"id": 705120206,
					"content": "Das stimmt. Adelinde, da wir dich getroffen haben, könntest du uns vielleicht direkt dabei helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120207,
					"content": "Adelinde, bis jetzt haben wir immer den Sonderangebots-Traubensaft des Weinguts verpasst, weshalb wir dieses Mal zum Vorbestellen gekommen sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120208,
					"content": "Wir zahlen auch gern ein wenig mehr im Voraus, wenn ihr uns dann nur eine Flasche lasst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120209,
					"content": "Alles gar kein Problem, wir brauchen auch keine Vorauszahlung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120210
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120210,
					"content": "Ich muss euch aber bitten, kurz zu warten. Der Sonderangebots-Traubensaft des Weinguts Morgenröte braucht einiges an Vorbereitungszeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120211
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120211,
					"content": "Jeden Sommer wählt Meister Diluc zwei Fässer mit besonders hochwertigen Trauben aus, um damit den Sonderangebots-Traubensaft zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120212
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120212,
					"content": "Wer verkauft denn ein sehr gutes Produkt zu einem geringen Preis? „Besonders hochwertige Trauben“ klingt doch entschieden nach etwas Teurem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120213,
					"content": "Das hat mir der Meister nicht genau erklärt. Seine Motive könnte ich höchstens erraten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120214
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120214,
					"content": "Ein Sonderangebot ist letztendlich eine Methode, um mithilfe des ausgezeichneten Preises noch mehr Kunden anzuziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120215
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120215,
					"content": "Vielleicht hofft er so, den Saft noch beliebter zu machen und den Leuten eine weitere Wahlmöglichkeit bei Getränken zu bieten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120216
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120216,
					"content": "Es wäre die beste Alternative für jene, die gern ein wenig zu tief ins Glas schauen. So würden sie nicht sturzbetrunken Radau machen und jene, die auf Alkohol verzichten, hätten eine weitere Gaumenfreude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120217,
						705120218
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120217,
					"content": "Würde das dem Geschäft als Weingut nicht schaden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120219,
					"content": "Meister Diluc kommt es nicht so sehr aufs Geld an. Wahrscheinlich ist es ihm ein gesunder Umgang mit Alkohol wichtiger als die ungezügelte Gier nach Profit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120220
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120220,
					"content": "Stellt euch vor, ein schönes Glas Wein zu genießen, dabei gleichzeitig einen klaren Verstand zu bewahren und niemandem Ärger zu machen ... Wäre das nicht optimal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120221
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120221,
					"content": "Ah, Meister Diluc ist wirklich ein Feingeist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120222,
					"content": "Heißt das, Diluc wählt jetzt die Trauben dieses Jahrgangs aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120223,
					"content": "Noch nicht. Wir müssen erst abwarten, dass er ein paar Probleme löst, bevor er damit anfangen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120224
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120224,
					"content": "Falls ihr euch sehr dafür interessiert, wird euch der Meister vielleicht dazu einladen, um eure Meinung zu hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120225
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120225,
					"content": "Was für „Probleme“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120226
					]
				},
				{
					"id": 705120226,
					"content": "Wie ihr beide wisst, bekommt der Meister häufig Wind davon, wenn sich ein paar unmanierliche Gäste sich in Mondstadt zeigen und nimmt es auf sich, sie „willkommen zu heißen“. Diesmal ist es genauso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120227
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120227,
					"content": "Er sollte irgendwo in der Nähe der Falkenküste sein, daher lade ich euch ein, zuerst im Weingut Platz zu nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120228
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120228,
					"content": "Ich muss noch am Eingang auf ein paar Gäste warten, Hillie und Moco werden sich um euch kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120229
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120229,
					"content": "Un... Unmanierlich? Paimon ist nicht ganz klar, was Fräulein Adelinde meint ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120230,
						705120234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120230,
					"content": "Ich denke, es geht dabei um Dilucs „Nebentätigkeit“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120231
					]
				},
				{
					"id": 705120231,
					"content": "He? Meinst du etwa den dunk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120232,
					"content": "Ääh ... Meinst du etwa, dass der Orden des Abgrunds wieder sein Unwesen treibt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120233,
					"content": "Als Kameraden von Meister Diluc können wir nicht einfach herumsitzen und nichts tun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120238,
					"content": "Es wäre wunderbar, wenn ihr bereit wärt, ihm zu helfen. Außerdem seid ihr Vertraute des Meisters, die ihre Stärke bereits bewiesen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120239
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120239,
					"content": "Vielen Dank, dass ihr so bereitwillig eure Hilfe anbietet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120240
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120240,
					"content": "Das macht doch nichts! Wenn Meister Diluc früher zurückkommen kann, dann können wir unseren Sonderangebots-Wein noch früher genießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120241,
					"content": "#{NICKNAME}, lass uns jetzt zur Falkenküste aufbrechen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120234,
					"content": "Lass uns zuerst im Weingut auf Diluc warten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120235
					]
				},
				{
					"id": 705120235,
					"content": "Hmm ... Also Paimon findet es ziemlich unpassend hier zu warten, während Diluc draußen schuften muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120236,
					"content": "Lass uns lieber zur Falkenküste und nachschauen, ob wir Diluc bei seinen Problemen helfen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120237,
					"content": "Auch wenn Meister Diluc sehr stark ist, kann ein wenig Hilfe nie schaden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120218,
					"content": "Ist das der Einstieg in ein anderes Geschäftsfeld?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120205,
					"content": "Nichts Besonderes ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				}
			]
		},
		{
			"id": 7051204,
			"completionStepIds": [
				7051204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051204",
							"2"
						],
						"stepId": 7051204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120401,
					"content": "Das sieht nicht nach Dilucs Zelt aus, ob es das Zelt eines Abenteurers ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120402,
					"content": "Sind das da ein Zettel und ein Notizbuch? Schauen wir mal da rein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120403,
					"content": "„Held der Nacht, das seltsame Phänomen von einst ist erneut aufgetreten.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120404
					],
					"speakerTitle": "Untersuchen"
				},
				{
					"id": 705120404,
					"content": "„Obwohl du das damalige Problem vollkommen gelöst hattest, wurde der Fluss der Elemente nun erneut angeregt und entlässt erneut Monster wie damals aufgezeichnet.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120405
					],
					"speakerTitle": "Untersuchen"
				},
				{
					"id": 705120405,
					"content": "„Ich bin mir sicher, dass du bei der ersten Gelegenheit kommen wirst, um dich um die bedrohlichsten Monster zu kümmern.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120406
					],
					"speakerTitle": "Untersuchen"
				},
				{
					"id": 705120406,
					"content": "„Daher werde ich zuerst wie vorgesehen, die dafür nötigen Kräfte kontaktieren.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120407
					],
					"speakerTitle": "Untersuchen"
				},
				{
					"id": 705120407,
					"content": "Hmm ... Der Schreibstil auf diesem Zettel klingt sehr nach einer Person, die Diluc sehr gut kennt, wir könnten sie „Dilucs Freund“ nennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120408,
					"content": "Er muss hier etwas Furchtbares festgestellt haben und verschwunden sein, nachdem er Diluc die Notizen hinterlassen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120409,
					"content": "Ist es nicht ziemlich unverantwortlich diesen Zettel hier zurückzulassen, wo jeder ihn sehen kann? Und das Notizbuch hat er auch hiergelassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120410,
					"content": "Aber wenn Paimon es sich recht überlegt ... Diese merkwürdige Elementanhäufung am Strand ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120411,
					"content": "Das muss das darin erwähnte „seltsame Phänomen“ sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120412
					]
				},
				{
					"id": 705120412,
					"content": "Aber hier gibt es keine Monster und alles scheint hier in Ordnung zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120413,
					"content": "#{NICKNAME}, möchtest du dir das Notizbuch von Dilucs Freund nochmal anschauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120414,
					"content": "Falls nicht, dann lass uns direkt hingehen und noch etwas genauer nachschauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7051205,
			"completionStepIds": [
				7051205
			],
