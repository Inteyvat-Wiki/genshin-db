				{
					"id": 705120801,
					"content": "Grüßt den Meister von mir, falls ihr ihn seht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120802
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120802,
					"content": "Seid bitte vorsichtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120803
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120803,
					"content": "Wie der Meister zu sagen pflegt: „Selbst wenn der Sieg zum Greifen nah scheint, darf man seine Deckung nicht aufgeben.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
