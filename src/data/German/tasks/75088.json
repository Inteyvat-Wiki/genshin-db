				"points": []
			},
			"dialogs": [
				{
					"id": 750880601,
					"content": "Ah, du bist es! Vielen Dank für die Fragmente der „Schillernden Inschrift“, die du mir gebracht hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880602
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880602,
					"content": "Aber die Fortschritte bei der Entschlüsselung sind etwas enttäuschend. Es scheint ähnlich wie bei den Phlogiston-Kerblinien zu sein, aber es ist wirklich viel komplizierter als gedacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880603
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880603,
					"content": "Es gibt keinen Ausweg mehr, ich muss es einfach entschlüsseln! Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				}
			]
		}
	]
}