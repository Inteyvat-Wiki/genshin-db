			"dialogs": [
				{
					"id": 750880101,
					"content": "Wie sieht es aus, habt ihr die Fragmente der „Schillernden Inschrift“ gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				}
			]
		},
		{
			"id": 7508802,
			"completionStepIds": [
				7508802
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7508802",
							"2"
						],
						"stepId": 7508802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chuno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880201,
					"content": "Haha, beeindruckend! Jetzt kann ich die Goldmuster auf der „Schillernden Inschrift“ entschlüsseln ... Die Belohnung, die Belohnung wird sicher meine sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880202
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880202,
					"content": "In anderen Worten: Wenn wir auch dieses Mal scheitern, gibt es überhaupt keine finanzielle Unterstützung mehr, und Erfolg oder Misserfolg hängen davon ab!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880203
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880203,
					"content": "Ach, übrigens, hier ist eure Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				}
			]
		},
		{
			"id": 7508803,
			"completionStepIds": [
				7508803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7508803",
							"2"
						],
						"stepId": 7508803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chuno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880301,
					"content": "Hm, wenn ich genug Proben hätte, dann könnte es vielleicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880302
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880302,
					"content": "Oh, hier gibt es einen seltsamen Kerl, der vor sich hin murmelt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880303,
					"content": "Leute wie mich gibt es überall in Natlan, es ist eher seltsam, dass ihr hier seid ... Wenn ihr nichts Wichtiges habt, stört mich bitte nicht bei meiner Forschung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880304
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880304,
					"content": "Mein monatliches Budget ist überschritten, also muss ich einige Forschungsaufträge des Vereins annehmen, um meine Ausgaben auszugleichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880305
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880305,
					"content": "Ach so, man kann also durch Forschung auch Geld verdienen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880306,
					"content": "Ja, der „Verein für Saurierrelikte“ ist so organisiert, dass Belohnungen angeboten werden, um die Forscher zu motivieren, unterschiedliche Forschungsthemen zu bearbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880307
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880307,
					"content": "Diesmal werde ich die Herausforderung annehmen, die „Schillernde Inschrift“ zu entschlüsseln ... Man sagt, dass es eine riesige Aufgabe ist, die noch niemand geschafft hat, und man kann dafür eine Menge Mora bekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880308
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880308,
					"content": "Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880309
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880309,
					"content": "Aber was ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880310,
					"content": "Um die „Schillernde Inschrift“ zu entschlüsseln, ist es erforderlich, zunächst genügend Fragmente der „Schillernden Inschrift“ zu sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880311
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880311,
					"content": "... Wie wäre es, wenn ihr mir die Fragmente der „Schillernden Inschrift“ besorgt, im Gegenzug biete ich euch eine Erstattung an. Was haltet ihr davon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880312
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880312,
					"content": "Ihr seht aus wie erfahrene Abenteurer. Wahrscheinlich bekommt ihr regelmäßig solche Missionen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880313
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880313,
					"content": "Klar, das ist durchaus machbar, aber du hast diesen Monat doch schon dein Budget überschritten, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880314,
					"content": "Ich habe mein Budget ohnehin schon überschritten, wie viel es genau ist, ist jetzt nicht mehr so wichtig ... Hauptsache ich bekomme die Fragmente der „Schillernden Inschrift“ und entschlüssel sie, dann gibt’s eine Menge Mora zu verdienen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880315,
						750880316
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880315,
					"content": "Wir sind nur dafür zuständig, die Fragmente zu finden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				},
				{
					"id": 750880317,
					"content": "Ihr müsst nur sicherstellen, dass ihr „echte“ Fragmente bekommt. Übrigens, es ärgert mich wirklich, dass mir in diesem Monat ein Händler die Fälschungen aus der geheimen Ruine verkauft hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880318
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880318,
					"content": "Der Händler hat mich um eine große Menge Mora betrogen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880319
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880319,
					"content": "Aha, das ist also der Grund für die Überschreitung deines Budgets ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880320,
					"content": "Nun, ich werde die Fragmente der „Schillernden Inschrift“ nutzen, um mein Blatt zu wenden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880321
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880321,
					"content": "Bitte kümmert euch um die Suche nach den Fragmenten! Wenn ihr welche findet, bringt sie mir unbedingt hierher!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880322
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880322,
					"content": "Es ist nicht notwendig, zu viele zu sammeln. Drei ... Nein, vier Stück wären ausreichend! Mehr kann ich mir leider nicht leisten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880316,
					"content": "Wir können nicht garantieren, dass die Fragmente auch wirklich nützlich sind ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				}
			]
		},
		{
			"id": 7508806,
