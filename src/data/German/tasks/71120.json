			"dialogs": [
				{
					"id": 711209101,
					"content": "Ihr schon wieder!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209102
					],
					"speakerTitle": "Sitzender Tiger"
				},
				{
					"id": 711209102,
					"content": "Haltet eure Neugier im Zaum, Freunde! Ihr tut so, als hättet ihr uns nicht gesehen und wir tun so, als hätten wir euch nicht gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209103,
						711209111
					],
					"speakerTitle": "Gewundene Schlange"
				},
				{
					"id": 711209103,
					"content": "Was bewacht ihr hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209104
					]
				},
				{
					"id": 711209104,
					"content": "Freunde, ratet mal, wofür wir bezahlt werden!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209105
					],
					"speakerTitle": "Gewundene Schlange"
				},
				{
					"id": 711209105,
					"content": "Wofür denn!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209106,
					"content": "Hehe ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209107
					],
					"speakerTitle": "Gewundene Schlange"
				},
				{
					"id": 711209107,
					"content": "(Ich verrate es nur euch beiden, aber ihr dürft es niemandem weitersagen ... kommt näher. Ich sage es euch ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209108
					],
					"speakerTitle": "Gewundene Schlange"
				},
				{
					"id": 711209108,
					"content": "(Ja! Paimon ist ganz Ohr!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209109,
					"content": "Um Nasenbohrer wie euch zum Teufel zu jagen!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209110
					],
					"speakerTitle": "Gewundene Schlange"
				},
				{
					"id": 711209110,
					"content": "Waaaaah!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209111,
					"content": "Da kommt ein komisches Geräusch aus der Höhle ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209112
					]
				},
				{
					"id": 711209112,
					"content": "Ich habe gefurzt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209113
					],
					"speakerTitle": "Sitzender Tiger"
				},
				{
					"id": 711209113,
					"content": "Uh ... Stimmt, er hat gefurzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209114
					],
					"speakerTitle": "Gewundene Schlange"
				},
				{
					"id": 711209114,
					"content": "Da... Dann ist alles wieder dufte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
