			"dialogs": [
				{
					"id": 711200101,
					"content": "He, verschwindet! Das ist das Gebiet des Meisters!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200102
					],
					"speakerTitle": "Sitzender Tiger"
				},
				{
					"id": 711200102,
					"content": "Waah, das ist gemein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200103,
						711200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711200103,
					"content": "Was seid ihr für Leute?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200104
					]
				},
				{
					"id": 711200104,
					"content": "Es kommt auf dich an. Wenn du dich benimmst, sind wir freundlich! Wenn du zu viel herumschnüffelst, dann können wir ganz ungemütlich werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200105
					],
					"speakerTitle": "Gewundene Schlange"
				},
				{
					"id": 711200105,
					"content": "Nehmt euch gefälligst in Acht und verschwindet dahin, wo ihr hergekommen seid!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "Sitzender Tiger"
				},
				{
					"id": 711200109,
					"content": "Mit euch ist wirklich was ganz faul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711200110,
					"content": "Faul? Ach ... Wir sind hier eben die Torhüter. Die Art, wie ihr eure Nasen in Dinge steckt, die euch nichts angehen, ist erst recht suspekt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200111
					],
					"speakerTitle": "Gewundene Schlange"
				},
				{
					"id": 711200111,
					"content": "Schon gut, es reicht! Lasst uns in Frieden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sitzender Tiger"
				},
				{
					"id": 711200106,
					"content": "Welchem „Meister“ soll das Gebiet hier denn gehören?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200107
					]
				},
				{
					"id": 711200107,
					"content": "Welchem „Meister“? Hmpf ... Wenn ich es dir sage, wirst du Panik schieben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200108
					],
					"speakerTitle": "Sitzender Tiger"
				},
				{
					"id": 711200108,
					"content": "Es ist nur zu deinem Besten, Freundchen! Nach Dingen, die du nicht wissen sollst, fragst du besser gar nicht erst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "Gewundene Schlange"
				}
			]
		},
		{
