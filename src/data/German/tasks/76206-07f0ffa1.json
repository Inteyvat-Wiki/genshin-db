			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Castiglione"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762060101,
					"content": "Ach Kanou, hör auf herumzurennen und mach deinen Paravent fertig. Überleg lieber erst mal, wie du deinen Wasserfall malen willst. Um Egerias willen, wer nutzt denn bitte die verstreute Perspektive für einen Wasserfall ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060102
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060102,
					"content": "... Hm? Ah, Entschuldigung, ein neues Gesicht. Wegen der Schritte dachte ich, es wäre Kanou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060103
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060103,
					"content": "Was machst du denn hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762060104
					]
				},
				{
					"id": 762060104,
					"content": "Wie du siehst, male ich gerade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060105
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060105,
					"content": "Nur damit du mich nicht falsch verstehst, lass mich eines klarstellen: Ich bin zwar gut darin, Tiere zu malen, aber meine Tiere sind nicht zum Essen gedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060106
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060106,
					"content": "Hä? Man kann deine Malerei also essen?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762060107,
					"content": "Die gemalte Person steht vor mir und das Tier im Bild kann natürlich auch auf dem Teller landen ... Aber auch wenn das so ist, hoffe ich doch sehr, dass du nicht wie Jinggui aus Liyue bist und mich nur bittest, Fisch zu malen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060108
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060108,
					"content": "Kunst – die ehrwürdige Kunst! Unabhängig von der Epoche sollte ihr Zweck die Erlösung der menschlichen Seele und die Kultivierung des moralischen Charakters sein, indem sie uns durch Wahrheit, Güte und Schönheit zu höheren spirituellen Sphären führt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060109
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060109,
					"content": "Wenn man zum Beispiel den höchsten Gipfel eines Berges erklimmt, ist die Aussicht ganz natürlich und echt. So ist die Kunst, die ich verfolge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060110
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060110,
					"content": "Hm ... Wenn es nur so dahingesagt wird, verstehst du es wahrscheinlich nicht richtig. Wie wäre es damit: Ich male dir eine schwebende Plattform. Du steigst einfach drauf und erlebst es selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Castiglione"
				}
			]
		}
	]
}