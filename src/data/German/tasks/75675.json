			"dialogs": [
				{
					"id": 756750101,
					"content": "He! Ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750102
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750102,
					"content": "Mein Kopf ist schon voller Musik! Tanzen, tanzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750103
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750103,
					"content": "Hin und her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750104
					],
					"speakerTitle": "Sedile"
				},
				{
					"id": 756750104,
					"content": "So fröhlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750105
					],
					"speakerTitle": "Manaia"
				},
				{
					"id": 756750105,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750106
					],
					"speakerTitle": "Moo"
				},
				{
					"id": 756750106,
					"content": "Und ich habe sogar noch was dazuverdient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750107
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750107,
					"content": "Hä? Wann ist das denn passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750108
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750108,
					"content": "Fräulein Nusta hatte alle Hände voll zu tun, also habe ich mir die Zeit genommen, ihrem Lehrling zu helfen und ein paar Monsterhöhlen auszuräumen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750109
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750109,
					"content": "In Natlan machen der Kampf und das Tanzen gleich viel Spaß. Ich mag das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750110
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750110,
					"content": "Tut mir echt leid für die Umstände, Marine. Mein Plan war eigentlich, die Neulinge mehr trainieren zu lassen. Ich hätte nicht gedacht, dass sie diesen Auftrag noch nicht allein schaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750111
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750111,
					"content": "Wenn ich zurück bin, nehme ich sie extra hart dran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750112
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750112,
					"content": "Kein Problem, sie haben auch toll gekämpft. Man hätte nur nicht erwartet, dass im Nest siebenmal so viele Monster lauern wie vorher geschätzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750113
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750113,
					"content": "Der Blumenfeder-Klan hat echt viel gegeben. Ich habe jetzt genug Geld zusammen, um ein Geschenk für Aeval zu kaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750114
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750114,
					"content": "Aber deine Urlaubszeit ist wohl auch fast vorbei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750115
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750115,
					"content": "Ich habe noch ein paar Tage Spaß, dann buche ich ein Schiffsticket und kümmere mich um die Rückreise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750116
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750116,
					"content": "Keine Eile, wir können noch tanzen. Roxane, Letellier, Chênée und Fréjus streiten sich in letzter Zeit um die Aufträge. Da halte ich mich lieber raus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750117
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750117,
					"content": "Dann einfach weiter tanzen und weiter Spaß haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750118
					],
					"speakerTitle": "Sedile"
				},
				{
					"id": 756750118,
					"content": "Wenn du müde bist, dann iss! Wenn du satt bist, dann schlaf! Ganz ohne Sorgen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750119
					],
					"speakerTitle": "Manaia"
				},
				{
					"id": 756750119,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750120
					],
					"speakerTitle": "Moo"
				},
				{
					"id": 756750120,
					"content": "Die Melusinen und der kleine Koholasaurier stellen sich in einer Reihe auf und hüpfen zur Bühne.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756750121
					]
				},
				{
					"id": 756750121,
					"content": "Was für eine niedliche Gruppe von Gästen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750122
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750122,
					"content": "Hehe, du hast also auch Spaß, Nusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750123,
						756750124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756750123,
					"content": "Dein Lächeln ist viel entspannter und unbeschwerter geworden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				},
				{
					"id": 756750125,
					"content": "Wirklich? Dann muss ich ab jetzt unbedingt zu jeder „Tanzparty“ kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750126
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750126,
					"content": "Ich möchte, dass die Jüngeren, die mich bei jedem Treffen gleich „große Schwester“ oder sogar „Tante“ nennen ... eines Tages merken, dass ich im Herzen viel jünger bin als sie alle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750127
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750127,
					"content": "Zukünftige „Tanzpartys“ sollten genauso sein, und am besten viel öfter stattfinden! Vielleicht sogar jeden Monat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750124,
					"content": "Du siehst auf einmal ein ganzes Stück jünger aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				}
			]
		}
	]
}