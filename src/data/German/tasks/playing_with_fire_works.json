			"dialogs": [
				{
					"id": 220490301,
					"content": "Du bist zurück. Wie war’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490302,
						220490304
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490302,
					"content": "Sehr schön!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490303
					]
				},
				{
					"id": 220490303,
					"content": "Super!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490306,
					"content": "Nun, es ist Zeit für mich, zu gehen und den Laden aufzuräumen, die Zahl der Leute, die kommen, um Feuerwerk zu kaufen, hat in letzter Zeit wirklich zugenommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490307
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490307,
					"content": "Aber sie ist immer noch nicht zurückgekehrt und ich habe keine Ahnung, wohin sie gegangen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490304,
					"content": "Wir hatten nicht genug ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490305
					]
				},
				{
					"id": 220490305,
					"content": "Hat es euch gut gefallen? Das ist gut, das nächste Mal kommt ihr wieder und nehmt wieder welche zum Spielen mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				}
			]
		}
