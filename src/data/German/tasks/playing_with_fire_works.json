			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Naganohara Ryuunosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220490101,
					"content": "Oh, wenn das nicht der neue Kumpel meines kleinen Mädchens ist? Bist du wieder hier, um mit ihr rumzuhängen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490102,
						220490105
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490102,
					"content": "Läuft das Geschäft?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490103
					]
				},
				{
					"id": 220490103,
					"content": "Sehr gut, sehr gut! Hahahaha, das liegt alles daran, dass mein Mädchen das Feuerwerk so gut gemacht hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490104
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490104,
					"content": "Seid ihr heute wegen ihr da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490107
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490107,
					"content": "Sie ist raus, um Zutaten zu sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490108
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490108,
					"content": "Wo ist sie hin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490109
					]
				},
				{
					"id": 220490109,
					"content": "W... Was? Wie bitte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490110
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490110,
					"content": "Wo ist Yoimiya?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490111
					]
				},
				{
					"id": 220490111,
					"content": "Oh, ich weiß nicht ... Ich habe das Mädchen vielleicht falsch verstanden, ich kann sie nicht wirklich gut hören ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490112
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490112,
					"content": "Was wollt ihr von ihr? Wollt ihr ein Feuerwerk kaufen und ein wenig Spaß haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490113,
						220490116
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490113,
					"content": "Wir wollen mit ihr spielen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490114
					]
				},
				{
					"id": 220490114,
					"content": "Tja, diesmal wirst du sie wohl nicht finden. Man weiß nie, wann sie zurückkommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490115
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490115,
					"content": "Bevor sie gegangen ist, hat sie ein paar neue Feuerwerkskörper gemacht und sie in den Laden gestellt, also nimm sie und hab Spaß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490118
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490118,
					"content": "Wo ist das Zeug nur hin? Im Zimmer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490119,
						220490120
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490119,
					"content": "Ist das wirklich in Ordnung so?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490121
					]
				},
				{
					"id": 220490121,
					"content": "Schon gut, schon gut, es gibt genug Vorrat im Laden. Ihr könnt zum Spaß welche nehmen, es ist keine große Sache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490122
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490122,
					"content": "Außerdem wollte mein Mädchen jemanden dazu bringen, diese neuen Feuerwerkskörper auszuprobieren, und ihr seid heute gerade rechtzeitig vorbeigekommen, um sie auszuprobieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490123
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490123,
					"content": "Fühlt euch einfach wie zu Hause und nehmt diese Feuerwerkskörper. Kommt später zurück und erzählt mir, wie sie waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490124
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490124,
					"content": "Ich werde es ihr dann weitersagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490125
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490125,
					"content": "Sie wird sich freuen, wenn sie weiß, dass ihr das Feuerwerk ausprobiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490126
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490126,
					"content": "Ihr müsst es außerhalb der Stadt tun. Das Feuerwerk in der Stadt wird wieder viele Menschen anlocken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490120,
					"content": "Wir haben ihr auch nicht Bescheid gesagt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490121
					]
				},
				{
					"id": 220490116,
					"content": "Zeit für ein Feuerwerk!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490117
					]
				},
				{
					"id": 220490117,
					"content": "Bevor sie gegangen ist, hat sie ein paar neue Feuerwerkskörper gemacht und sie in den Laden gestellt, also nimm sie und hab Spaß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490118
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490105,
					"content": "Ist Yoimiya da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490106
					]
				},
				{
					"id": 220490106,
					"content": "Seid ihr heute wegen ihr da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490107
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				}
			]
