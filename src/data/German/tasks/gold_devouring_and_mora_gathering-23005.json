			},
			"dialogs": [
				{
					"id": 230050901,
					"content": "Dieses Gericht mutet etwas merkwürdig an ... Aber egal, ich muss mich an die Arbeit machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050902
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050902,
					"content": "#Vielen Dank, {F#Reisende}{M#Reisender}! Dann sehen wir uns später!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
