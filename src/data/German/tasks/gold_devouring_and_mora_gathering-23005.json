			},
			"dialogs": [
				{
					"id": 230050801,
					"content": "Die Qualität scheint recht gut zu sein. Ob ich dieses Mal wohl einen guten Profit machen werde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
