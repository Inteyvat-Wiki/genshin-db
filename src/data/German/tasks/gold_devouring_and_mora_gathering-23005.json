			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050201,
					"content": "Hmm ... Nicht schlecht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050202
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050202,
					"content": "Du hast wohl wirklich eine Menge Geld gemacht!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050203
					]
				},
				{
					"id": 230050203,
					"content": "#Ah, {F#Reisende}{M#Reisender}! Dank dir habe ich dieses Mal einen kleinen Profit gemacht. Anscheinend hat das „Gold-Gericht“ tatsächlich gewisse Wirkung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050204
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050204,
					"content": "Allerdings besteht kein großer Unterschied zu dem Profit, den ich normalerweise bei Transaktionen mache ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050205
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050205,
					"content": "Das ist nicht, wie ein „Gold-Gericht“ funktionieren sollte. Habe ich etwa das falsche Essen verspeist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050206
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050206,
					"content": "#{M#Reisender}{F#Reisende}, versuchen wir es einfach noch einmal. Willst du mir ein weiteres Mal bei der Auswahl eines „Gold-Gerichtes“ helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050207
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050207,
					"content": "Genau wie zuvor, wähle einfach aus <color=#00E1FFFF>Mora-Medaillon</color>, <color=#00E1FFFF>Butterhühnchen</color> und <color=#00E1FFFF>„Hochgestapeltes“</color> eins aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300503",
							"2"
						],
						"stepId": 2300503,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"2300503"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050301,
					"content": "Letztes Mal gab’s nur geringen Profit, jetzt kommt der große! <color=#00E1FFFF>Mora-Medaillon</color>, <color=#00E1FFFF>Butterhühnchen</color> oder <color=#00E1FFFF>„Hochgestapeltes“</color>. Welches wählst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300504,
			"completionStepIds": [
				2300504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300504",
							"2"
						],
						"stepId": 2300504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050401,
					"content": "Uhm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050402
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050402,
					"content": "Hallo! Hatim, wie läuft’s bei dir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050403,
					"content": "Ah ... Ihr seid es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050404
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050404,
					"content": "Ich nehme an, ihr könnt an meinem langen Gesicht ablesen, wie es so bei mir so läuft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050405
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050405,
					"content": "Um ehrlich zu sein, bisher habe ich die Hälfte meines Geldes verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050406
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050406,
					"content": "Sehr seltsam ... Wie kann das nur sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050407
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050407,
					"content": "Aber andererseits ... habe ich die Vermutung, dass das ein Vorzeichen für einen bevorstehenden Marktboom sein könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050408
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050408,
					"content": "Genau wie Menschen zuerst die Beine anwinkeln müssen, um hoch in die Luft zu springen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050409
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050409,
					"content": "Und das Gleiche gilt auch für den Markt für Terminkontrakte. Derzeit ist der gesamte Markt im Keller, doch schon bald wird er sich wieder sprunghaft erholen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050410
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050410,
					"content": "Mit anderen Worten, das ist der perfekte Augenblick, um auf Schnäppchenjagd zu gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050411,
						230050412
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050411,
					"content": "Womöglich ist er noch nicht im Keller, sondern erst im Erdgeschoss.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050413
					]
				},
				{
					"id": 230050413,
					"content": "Nein, ich bin mir sicher, dass das eine seltene Gelegenheit ist, und ich darf mir keine Chance entgehen lassen, noch reicher zu werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050414
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050414,
					"content": "Das wäre Hatim, dem Krösus von Kalimi, nicht würdig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050415
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050415,
					"content": "Willst du mir ein weiteres Mal helfen und ein „Gold-Gericht“ für mich auswählen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050416
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050416,
					"content": "Ist es wieder eine Wahl zwischen den gleichen drei Gerichten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050417,
					"content": "Ähm ... Nein! Da das ja eine Schnäppchenjagd ist, benötige ich ein ganz besonderes Gericht, das den Markt in eine positive Richtung drehen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050418
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050418,
					"content": "Ich habe gehört, in Mondstadt gibt es einen reichen Mann, dessen Getränkewirtschaft sehr gut gehen soll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050419
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050419,
					"content": "Du meinst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050420
					]
				},
				{
					"id": 230050420,
					"content": "Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050421,
					"content": "Aber woher kennst du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050422,
					"content": "Haha, ich kenne doch auch „Hochgestapeltes“. Wie sollte ich ihn da nicht kennen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050423
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050423,
					"content": "Er besitzt eine Taverne, in der etwas Wunderbares verkauft wird, das „Apfelschorle“ genannt wird. Wenn ich etwas davon trinken könnte, würde ich vielleicht etwas von dem Glück des Erfolgs bekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050424
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050424,
					"content": "Bitte beschafft mir etwas von dieser Apfelschorle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050412,
					"content": "Die Beine anzuwinkeln, kann auch in einem Sturz enden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050413
					]
				}
			]
		},
