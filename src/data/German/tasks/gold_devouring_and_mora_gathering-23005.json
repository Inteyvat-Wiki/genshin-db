			},
			"dialogs": [
				{
					"id": 230050701,
					"content": "Gut! Ein Gericht von außerordentlicher Qualität! Dieses Mal werden die von mir gekauften Terminkontrakte sicher in die Höhe schießen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
