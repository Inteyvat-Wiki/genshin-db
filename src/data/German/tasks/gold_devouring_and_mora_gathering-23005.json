			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050601,
					"content": "Ist das die Apfelschorle jenes Krösus? Oh, sie hat einen außerordentlichen Duft, der einem einen klaren Verstand verschafft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050602
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050602,
					"content": "Sehr gut! Das wird dem Markt sicher in eine positive Richtung drehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050603
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050603,
					"content": "Ich werde eure Hilfe nicht vergessen! Bis zum nächsten Mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300507,
			"completionStepIds": [
				2300507
			],
			"beginWay": "TALK_BEGIN_AUTO",
