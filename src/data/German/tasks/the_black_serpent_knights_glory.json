				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80071001,
					"content": "Das war ... der Geist von Halfdan ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071002,
					"content": "Hier ist mehr als eine unheimliche Kraft versammelt. Es wäre nicht verwunderlich, Geister zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071003
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071003,
					"content": "Wenn du aber weiter in die Tiefe gehen willst, sei vorsichtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071004
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071004,
					"content": "*hust*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071005
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071005,
					"content": "Nun, wir werden vorsichtig sein. Übrigens, kommt Dain nicht mit uns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071006,
					"content": "Der Apparat hat mich genauso traumatisiert und ich brauche ein wenig Zeit, um mich zu erholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071007
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071007,
					"content": "Verstehe ... Nein, Paimon hat es längst bemerkt ... Du hast dich einfach durchgebissen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071008,
					"content": "Es ist auch an der Zeit, sich zu erholen, Dain ... Gönn dir eine Pause oder so!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071009,
					"content": "Pause? Das ist nicht das Wort, das in meinem Wortschatz vorkommen sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071010
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071010,
					"content": "Ich habe viele wichtige Dinge zu tun. Das Projekt „Webstuhl des Schicksals“ ist noch in Arbeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071011
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071011,
					"content": "Ich habe sogar den Verdacht, dass der zunehmende Apparat hier auch mit diesem Plan zusammenhängt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071012,
						80071013
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071012,
					"content": "Ich werde auch die Augen offen halten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80071014
					]
				},
				{
					"id": 80071014,
					"content": "Vielen Dank für dein Verständnis, mein „Auftraggeber“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071015
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071015,
					"content": "Ich hoffe nur, dass du bei unserem nächsten Treffen nicht auf der „anderen Seite“ stehst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071016
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071016,
					"content": "He, ist Dain nicht ein bisschen nachtragend, wenn er das am Ende sagt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071017,
					"content": "#Auch wenn wir {M#deine Schwester}{F#deinen Bruder} immer noch nicht wiedergesehen haben, ist das eine Menge nützlicher Informationen, die wir wissen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071018,
					"content": "Reist einfach weiter und ihr werdet euch immer wieder treffen und versöhnen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071019,
					"content": "Ach ja, erinnerst du dich noch, als wir hierherkamen, um den seltsamen Aufenthaltsort der Hilichurle zu erkunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071020,
					"content": "Das sollte genug sein, um dem Bergmann zu berichten. Aber ... Es scheint ein bisschen schwierig zu sein, was man dazu sagen soll. Was hier passiert, ist ein bisschen zu kompliziert für den normalen Menschen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071021,
					"content": "Wie auch immer, vergiss die Mission nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071013,
					"content": "Ich werde mich wieder mit dir unterhalten, wenn du dich erholt hast.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80071014
					]
				}
			]
		},
