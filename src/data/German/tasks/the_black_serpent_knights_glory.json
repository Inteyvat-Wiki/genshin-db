			"trigger": {
				"objectNames": [
					"Abgrundpriester"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80070101,
					"content": "Ich dachte, Halfdans Seele würde sich im Nu in Luft auflösen ... Es ist erstaunlich, wie stark seine Seele ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070102
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070102,
					"content": "Du stehst im Weg! Geh aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070103
					],
					"speakerTitle": "Abgrundpriester"
				},
				{
					"id": 80070103,
					"content": "Wo schaust du hin? Eine seltene Gelegenheit für dich, mich endlich loszuwerden, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070104
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070104,
					"content": "Dainsleif!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070105
					],
					"speakerTitle": "Abgrundpriester"
				},
				{
					"id": 80070105,
					"content": "Macht ihn fertig und schaltet den Apparat ab!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800703,
			"completionStepIds": [
				800703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800703",
							"2"
						],
						"stepId": 800703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80070301,
					"content": "Was sollen wir tun, der Abgrundpriester ist weg, aber der Apparat ist noch im Gange ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070302,
					"content": "Halfdan ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070303,
						80070304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070303,
					"content": "Lasst mich seinen Platz einnehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				},
				{
					"id": 80070305,
					"content": "Niemals! Solange der Apparat aktiviert bleibt, können wir, die Verfluchten, unsere eigentliche Kraft nicht einsetzen. Nur du kannst es mit dem Abgrund aufnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070306,
					"content": "Wenn du seine Hingabe schätzt, verschwende hier keine Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070307
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070307,
					"content": "Siehst du all die Lichter und Portale hier? Sie müssen die Energieeinheiten anderswo verstreut haben. Geh und überprüfe die Situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070308
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070308,
					"content": "Sollen wir durch die Portale des Abgrunds? ... He, warte auf Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070304,
					"content": "Ich werde nicht von der Läuterungswirkung des Fluchs betroffen sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				}
			]
		},
		{
			"id": 800709,
			"completionStepIds": [
				800709
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
