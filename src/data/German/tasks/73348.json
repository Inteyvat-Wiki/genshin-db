			"dialogs": [
				{
					"id": 733480901,
					"content": "*seufz* Mit so wenigen Finanzmitteln, wie kann ich da mit meiner Forschung vorankommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480902,
						733480903
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480902,
					"content": "Ähm, Entschuldigung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480904
					]
				},
				{
					"id": 733480904,
					"content": "Ein Gelehrte der Purbiruni-Schule? Oh, du willst Sadife besuchen, richtig? Es ist ziemlich selten, dass jemand ihn besucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480905
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480905,
					"content": "Er ist nun geschäftlich in der Akademie und sollte in der Nähe sein ... Was willst du von ihm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480906
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480906,
					"content": "Über Khedives Empfehlungsschreiben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480907
					]
				},
				{
					"id": 733480907,
					"content": "Khedive? Hat er seine Forschungen abgeschlossen? Wie schön, wenn man Geld hat. Dann kann man eine ganze Expeditionsgruppe anheuern, die einen bei der Feldforschung begleitet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480908
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480908,
					"content": "Ich konnte nicht einmal eine Forschungsförderung für meine Feldforschung beantragen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480909
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480909,
					"content": "Kennst du Khedive?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480910
					]
				},
				{
					"id": 733480910,
					"content": "Ja, natürlich. Gelehrte wie wir, die mit der Finanzierung zu kämpfen haben und nicht sehr gut darin sind, Geld zu verdienen, haben schon viel über seine Finanzkraft gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480911
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480911,
					"content": "Oha, Khedive ... Sind Gelehrten in der Schule, wo er ist, alle so reich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480912,
					"content": "Werden wir also viele Belohnungen bekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480913,
					"content": "Nein. Dieser Khedive ist ein Sonderfall, bitte mach dir keine falschen Vorstellungen von den Purbiruni- und Pursina-Gelehrten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480914
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480914,
					"content": "Besonders, wenn man im Hauptfach Astrologie und in den Nebenfächern Geschichte und Biologie hat ... Mit diesen Forschungsgebieten kann man sich nicht einmal um eine Finanzierung bewerben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480915
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480915,
					"content": "Und sie sagen dann noch so was wie „Die Weisheit soll man nicht verkaufen“ ...",
