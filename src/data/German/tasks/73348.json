			"dialogs": [
				{
					"id": 733480101,
					"content": "Aber ... wenn diese Proben nicht verfügbar sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480102,
						733480103
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480102,
					"content": "Über die Purbiruni-Schule ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				},
				{
					"id": 733480104,
					"content": "Genau. Ich bin der aktuelle „Herbad“ der Purbiruni-Schule. Was kann ich für euch tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480105
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480105,
					"content": "Geht es um akademische Fragen? Aber du siehst nicht wirklich wie ein Gelehrter der Akademie aus. Deine Kleidung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480106
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480106,
					"content": "Über Khedives Empfehlungsschreiben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480107
					]
				},
				{
					"id": 733480107,
					"content": "Ist das ... ein persönlicher Brief von Khedive? Einen Moment, lasst mich ihn lesen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480108
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480108,
					"content": "Nun, es scheint, dass seine Forschung in der großen Kluft wie am Schnürchen läuft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480109
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480109,
					"content": "... Pilzforschungen ... Hydrologische Untersuchung ... uralte Fossilien ... besondere geologische Umgebungen ... Proben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480110
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480110,
					"content": "Sehr gut, sehr gut, sehr gut! Sein wissenschaftlicher Instinkt und seine Fertigkeiten der Erkundigung sind wie immer großartig. Auf jeden Fall hat er mich nicht enttäuscht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480111
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480111,
					"content": "Hmpf ... Zwar gebe ich das vor Außenstehenden nur ungern zu, aber die akademischen Fähigkeiten der Pursina-Gelehrten sind immer vertrauenswürdig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480112
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480112,
					"content": "Khedive hat in seinem Brief mehrfach betont, dass du ihm ungemein geholfen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480113
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480113,
					"content": "Mit deiner Hilfe war seine Forschung ... „so geschmeidig wie ein Tiger mit Flügeln“ gelaufen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480114,
						733480115
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480114,
					"content": "Das muss nicht noch einmal wiederholt werden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480116,
					"content": "Wirklich? *hust* Verstehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480117
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480117,
					"content": "Wenn er an die Akademie zurückkehrt, muss die akademische Geschichte der Pursina-Schule mit noch mehr Ruhm erfüllt werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480118
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480118,
					"content": "Hm ... und die ewige Freundschaft zwischen unseren beiden Schulen wird sicher noch weiter wachsen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480119
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480119,
					"content": "#Kurz gesagt! Bitte nimm meinen Dank an, {M#Reisender}{F#Reisende}, im Namen von Purbiruni und Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480120
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480120,
					"content": "In seinem Brief hat er mich übrigens auch gebeten, einige Dankesgeschenke für dich vorzubereiten ... Bitte warte einen Moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480121
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480121,
					"content": "Bei dem Dankesgeschenk handelt es sich doch nicht um noch einen Brief, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480122
					]
				},
				{
					"id": 733480122,
					"content": "Natürlich nicht! Du hast Khedive auf seiner Expedition begleitet und fleißig gearbeitet, natürlich muss ich dich in Mora entlohnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480123
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480123,
					"content": "Aber ... bitte verzeih mir, ich hatte es heute sehr eilig und habe nicht viel Mora dabei. Wenn es geht, dann warte bitte hier auf mich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480124
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480124,
					"content": "Obwohl auch er ein Gelehrter ist, der auf die eigene Schule stolz ist ... ist er doch so überhaupt nicht wie Khedive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480125,
					"content": "Er wirkt, um ehrlich zu sein, relativ arm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480126,
					"content": "Wie ... Wie kannst du so etwas sagen! Wir von der Purbiruni-Schule stammen alle aus einer Blutlinie von Gelehrten und könnten niemals in finanzielle Schwierigkeiten geraten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480127
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480127,
					"content": "Es ist nur so, dass wir den größten Teil unseres Vermögens in unsere Forschung investiert haben ... Wenn es um andere Dinge als die Forschung geht, ist unser Budget etwas knapper bemessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480128
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480128,
					"content": "Dies hat unsere Forschung jedoch nicht behindert. Vielmehr können wir den Weg zur Weisheit klarer sehen, weil wir nicht von materiellen Wünschen geblendet sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480129
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480129,
					"content": "Ich werde jetzt zurückgehen und dir deine Belohnung vorbereiten. Aber vorher habe ich noch eine Bitte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480130
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480130,
					"content": "#Wie ich in Khedives Brief gelesen habe, bist du sehr stark, im Kampf äußerst erfahren und {F#eine außergewöhnliche Abenteurerin}{M#ein außergewöhnlicher Abenteurer} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480131
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480131,
					"content": "Also ... wärst du bereit, mir zu helfen? Vor kurzem bin ich allein in die Wüste gegangen, um die Geologie eines Gebiets zu erforschen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480132
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480132,
					"content": "Und ... weil ich nicht viel Geld hatte, habe ich keine Eskorte engagiert. Ich dachte, wenn ich mich beeile, schnell hin und zurück zu kommen, sollte es nicht gefährlich sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480133
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480133,
					"content": "Aber wir hatten das Pech, auf dem Rückweg von der Expedition von Schatzräubern überfallen zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480134
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480134,
					"content": "Ich habe es zwar geschafft, unversehrt zur Stadt zurückzukehren, aber die Truhe mit all meinen geologischen Proben und Notizen ist dabei verloren gegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480135
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480135,
					"content": "Für Händler und Schatzräuber ist die Truhe nichts wert ... Aber in meinen Augen ist der Inhalt dieser Truhe einfach unersetzlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480136
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480136,
					"content": "#Bisher hatte ich kein Glück, einen Abenteurer zu finden, der gewillt war, mir zu helfen ... {F#Reisende}{M#Reisender}, würdest du mir diesen Gefallen tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480137,
						733480138
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480137,
					"content": "Ich helfe gern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480139,
					"content": "Vielen Dank! Ich wüsste nicht, was ich ohne dich tun würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480140
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480140,
					"content": "Ich markiere dir den Ort des Angriffs auf deiner Karte. Die Truhe müsste dort in der Nähe sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480138,
					"content": "Das mach ich doch glatt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480115,
					"content": "Das habe ich schon von ihm gehört ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480103,
					"content": "Bist du ein Gelehrter der Purbiruni-Schule?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				}
			]
		},
