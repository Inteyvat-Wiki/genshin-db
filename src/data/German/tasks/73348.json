						],
						"pointId": 600100252
					},
					{
						"sceneId": 6,
						"position": [
							192.401,
							460.499,
							624.217
						],
						"pointId": 600100253
					},
					{
						"sceneId": 6,
						"position": [
							192.631,
							460.346,
							623.552
						],
						"pointId": 600100254
					}
				]
			},
			"dialogs": [
				{
					"id": 733480401,
					"content": "Ah, du bist zurück. Hast du den Gelehrten der Purbiruni-Schule gefunden? Ich hoffe, es gab nicht zu viele Schwierigkeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480402,
						733480403
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480402,
					"content": "Gefunden schon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				},
				{
					"id": 733480404,
					"content": "Hm? Warum redest du so um den heißen Brei herum? Stimmt was nicht? Macht dir jemand Schwierigkeiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480405
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480405,
					"content": "Du erzählst Khedive genaustens, was mit Sadife passiert ist ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733480406
					]
				},
				{
					"id": 733480406,
					"content": "Sadife ... Er war schon immer ein bekannter Sturkopf und manchmal wussten selbst die Mentoren nicht, was sie mit ihm machen sollten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480407,
					"content": "Er lehnte auch alle Hilfe ab und bestand darauf, seine eigene Forschung zu betreiben, angeblich um sie „absolut unverfälscht“ zu halten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480408,
					"content": "Ein richtiges Beispiel für den Satz „Die Weisheit soll man nicht verkaufen“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480409,
					"content": "Dies ist das Forschungsprinzip der Gelehrten der Purbiruni-Schule ... Haha, wir, die Pursina-Schule, sind nicht so pedantisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480410
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480410,
					"content": "Hm ... Vielleicht ist es nicht ganz richtig, es so zu formulieren. Schließlich bin ich reich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480411,
						733480412
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480411,
					"content": "Wie verdienst du dein Geld?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480413,
					"content": "Warum schaust du so skeptisch? Ich habe auch hart für dieses Geld geschuftet. Weißt du eigentlich, wie viel Mühe Termingeschäfte machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480414,
						733480415
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480414,
					"content": "Te... Termingeschäfte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480416,
					"content": "Bei Termingeschäften muss man das Volumen der gehandelten Waren, aber auch die Markttrends im Auge behalten und schließlich die richtigen Investitionsentscheidungen treffen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480417
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480417,
					"content": "Am Anfang habe ich nur zum Spaß ein bisschen Geld investiert und wollte nicht, dass es meine Forschung beeinträchtigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480418
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480418,
					"content": "Aber wer wusste schon ... *seufz* Wer hätte das ahnen können! Ich habe so viel verdient, dass ich keine andere Wahl hatte, als das Geld wieder in der Börse anzulegen, und so habe ich noch mehr verdient ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480419
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480419,
					"content": "Meine Hauptaufgabe ist es, ein Gelehrter zu sein! Ich will forschen, ich will akademisch arbeiten! Ich will akademische Erfolge, nicht den Erfolg der Mora! Das sage ich mir auch immer wieder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480420
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480420,
					"content": "Aber solange ich in Sumeru bleibe, kann ich nicht umhin, ständig in die Börse zu gehen und Termingeschäfte zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480421
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480421,
					"content": "Ich bekomme immer mehr Mora auf mein Konto, aber ich komme mit meiner akademischen Forschung nicht voran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480422
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480422,
					"content": "Und deshalb habe ich eine ganze Expeditionsgruppe angeheuert, um die Große Kluft zu erkunden! Nur wenn ich da bleibe, wo es keine Börse gibt, kann ich meine akademische Forschung in Ruhe betreiben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480423
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480423,
					"content": "Wenn die Forschung nicht zum Erfolg führt, dann ... komme ich aus der großen Kluft nicht mehr heraus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480415,
					"content": "Du machst Geld mit Termingeschäften?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480412,
					"content": "Warum bist du so reich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480403,
					"content": "Es ist etwas passiert ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				}
			]
		},
