				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4880001,
					"content": "Lisa, bringt Ihr etwa die Steuerunterlagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880002,
					"content": "#He, {F#meine Süße}{M#mein Süßer}, ganz recht. Ich habe gehört, dass Jean krank ist. Da kann ich den ganzen Schreibkram doch gleich übernehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880003
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880003,
					"content": "Das passt doch! Wenn es nichts weiter für uns zu tun gibt, machen wir uns einfach wieder auf den Weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880004,
					"content": "Oh, wartet bitte noch. Charles möchte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880005
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880005,
					"content": "Wenn Ihr erlaubt, Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880006
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880006,
					"content": "Eben haben wir eine neue Order bekommen. Unsere Lagerbestände sind aber äußerst gering. Die Lieferungen aus dem Weingut hängen ziemlich hinterher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880007
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880007,
					"content": "Wenn es euch keine Umstände bereitet, würde ich euch bitten, <color=#00E1FFFF>nach den Waren zu sehen</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880008
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880008,
					"content": "Ist die Bestellung wirklich so dringend?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880009,
					"content": "Da kann ich nichts machen. Die Bestellung kam wirklich gerade erst bei uns an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880010
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880010,
					"content": "Ganz genau, Charles hat recht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880011
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880011,
					"content": "Na gut, dann sehen wir mal nach.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880012
					]
				},
				{
					"id": 4880012,
					"content": "In Ordnung, aber das nächste Mal werden wir eingeladen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880013
					]
				},
				{
					"id": 4880013,
					"content": "Mehehe, wenn Diluc das nächste Mal hier ist, wird er euch bestimmt einladen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880014
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880014,
					"content": "Das klingt doch schon nach einer Verhandlungsbasis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 48801,
			"completionStepIds": [
				48801
