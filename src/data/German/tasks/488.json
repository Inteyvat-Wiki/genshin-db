					"content": "Danke, mein Freund. Ohne dich wäre das ein großer Schlamassel geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880302
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880302,
					"content": "Ich werde den Herrschaften auf dem Weingut natürlich erzählen, wie sehr du geholfen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ernest"
