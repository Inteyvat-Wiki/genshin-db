			"trigger": {
				"objectNames": [
					"Ernest"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4880101,
					"content": "Die Waren sind also hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880102,
					"content": "Seid ihr hier, um mir zu helfen? Endlich ist jemand da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880103
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880103,
					"content": "Ich habe schon so lange auf dem Weingut gearbeitet.Aber das ist das erste Mal, dass ich von Hilichurlen ausgeraubt wurde. Eine Schande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880104
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880104,
					"content": "Noch etwas später und es wäre wirklich heikel geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880105
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880105,
					"content": "#Ach, das sind doch nur Hilichurle. {NICKNAME} verhaut die im Schlaf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880106,
					"content": "Dann ist ja gut. Ich überlasse euch diesen <color=#00E1FFFF>Transportballon</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880107
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880107,
					"content": "Es geht nicht nur darum, den Hilichurlen eins auszuwischen. Die <color=#00E1FFFF>Waren müssen unbedingt heil bleiben</color>. Ich habe nämlich nicht die Mittel, sie zu ersetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880108
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880108,
					"content": "Ich werde dort vorn auf euch warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880109
					],
					"speakerTitle": "Ernest"
				}
			]
		},
