			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300401,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300402
					]
				},
				{
					"id": 411300402,
					"content": "Super! Ich rufe die anderen, wir werden unverzüglich aufbrechen. Je schneller wir reagieren, umso besser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300403
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300403,
					"content": "Treffen wir uns wieder hier, sobald alle beseitigt wurden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		},
		{
			"id": 4113005,
