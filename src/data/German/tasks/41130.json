				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300101,
					"content": "#{F#Reisende}{M#Reisender}, hier drüben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300102
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300103
					]
				},
				{
					"id": 411300103,
					"content": "Es geht wieder um das Qingce-Dorf. Diese gefallene Sterne lassen die Monster rund um das Dorf verrückt spielen. Sie toben auf den Straßen herum. Das Qingce-Dorf steht kurz davor, umzingelt zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300106
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300106,
					"content": "Solange wir das Qingce-Dorf schützen, wird niemandem etwas zustoßen. Allerdings müssen die Vorräte aus der Stadt irgendwie hineingebracht werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300107
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300107,
					"content": "Aufgrund der aktuellen Lage kann der Rat für Allgemeine Angelegenheiten nur wenige Truppen schicken, um den Transport der Vorräte zu beschützen. Gegen eine große Gruppe von Monstern hätten sie keine Chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300108
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300108,
					"content": "Ich habe mit meinen Dorfleuten darüber nachgedacht ... wir können uns zwar nicht weit vom Qingce-Dorf entfernen, aber die Monster in seiner Nähe können wir bekämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300109
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300109,
					"content": "Auf diese Weise können wir den Transport beschützen. Unsere Späher melden jedoch, dass sich an vielen Orten Monster zusammenscharren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300110
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300110,
					"content": "Wir können all diese Monster unmöglich rechtzeitig selbst beseitigen. Und falls wir zu lange dafür brauchen, könnte dem Qingce-Dorf etwas zustoßen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300111
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300111,
					"content": "#Würdest du einen Teil der Monster für uns ausschalten, {F#Reisende}{M#Reisender}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		},
		{
			"id": 4113002,
			"completionStepIds": [
				4113003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113003",
							"2"
						],
						"stepId": 4113003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300201,
					"content": "Das wird nicht reichen ... Wir brauchen Verstärkung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300202
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300202,
					"content": "Ich habe die Monster beseitigt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300203
					]
				},
				{
					"id": 411300203,
					"content": "Vielen herzlichen Dank, aber ich befürchte, es gibt noch einen Notfall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300204
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300204,
					"content": "Ich hatte angenommen, die Monster bei Qingce-Dorf wären von der gewöhnlichen Sorte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300205
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300205,
					"content": "Nachdem ich einige Truppen anführte, um ein Monsterlager zu säubern, wollten wir eine Verschnaufpause einlegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300206
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300206,
					"content": "Doch da stürmte ein Steinhaut-Lawachurl aus dem nahen Wald auf uns zu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300207
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300207,
					"content": "Bevor wir reagieren konnte, hatte es schon angegriffen. Viele wurden verletzt ... und wir mussten uns zurückziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300208
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300208,
					"content": "Das Monster ist eine zu große Bedrohung, um es zu verschonen, doch die anderen Trupps sind noch nicht von ihren Zielen zurückgekehrt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300209
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300209,
					"content": "#Würdest du uns helfen dieses Monster zu besiegen, {F#Reisende}{M#Reisender}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300210,
						411300212
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300210,
					"content": "Ihr könnt auf mich zählen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300211
					]
				},
				{
					"id": 411300211,
					"content": "Das werden wir, danke. Es tut mir wirklich leid ... Eigentlich hätten wir das erledigen sollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300212,
					"content": "Wie geht es den Verletzten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300213
					]
				},
				{
					"id": 411300213,
					"content": "Wir konnten rechtzeitig Hilfe holen, es ist also niemand ernsthaft verletzt ... Doch sie werden eine Weile bewegungsunfähig sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300214
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300214,
					"content": "#Daher befürchte ich, dass alles bei dir liegt, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300215
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300215,
					"content": "Es tut mir sehr leid. Eigentlich war das unsere Pflicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		},
		{
