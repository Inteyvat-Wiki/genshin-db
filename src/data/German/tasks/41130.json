			"dialogs": [
				{
					"id": 411300501,
					"content": "Ich habe noch Dringenderes zu erledigen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300502
					]
				},
				{
					"id": 411300502,
					"content": "Ähm ... Na gut. Uns fällt schon etwas anderes ein, um mit diesen Monstern fertigzuwerden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		},
		{
			"id": 4113006,
			"completionStepIds": [
				4113012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113012",
							"2"
						],
						"stepId": 4113012,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300601,
					"content": "Wie ist es gelaufen? Hast du dieses Monster besiegt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300602
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300602,
					"content": "Ja klar, habe ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300603
					]
				},
				{
					"id": 411300603,
					"content": "Fantastisch ... Dann haben wir endlich Ruhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300604
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300604,
					"content": "#Danke für deine Hilfe, {F#Reisende}{M#Reisender}. Nimm dies als Zeichen unserer Anerkennung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300605
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300605,
					"content": "Trotzdem bleibt das alles verdächtig. Warum sollte so eine Kreatur plötzlich beim Qingce-Dorf auftauchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300606
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300606,
					"content": "Wie dem auch sei, ich muss diese Sache dem Rat für Allgemeine Angelegenheiten melden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300607
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300607,
					"content": "Hoffentlich können sie uns mehr Verstärkung senden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		}
	]
