					}
				]
			},
			"dialogs": [
				{
					"id": 747010101,
					"content": "Häh? Warum hat Paimon das Gefühl, dass hier plötzlich ein Becken mehr ist? Was steht auf dem Schild da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010102,
					"content": "„Gefahr! Abstand halten!“ Was bedeutet das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010103,
					"content": "Es bedeutet genau das, was da steht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010104,
					"content": "Waah! Sandrone ... Du hast Paimon erschreckt! Hast du dieses Schild hier aufgestellt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010105,
					"content": "Ja. Mit der Absicht, neugierige Katzen auf Abstand zu halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010106,
					"content": "Was ist an diesem Becken so besonders?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010107,
					"content": "Darin wimmelt es von Piranhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010108,
					"content": "Was?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010109,
					"content": "Haha, nur ein Scherz. Sag mir nicht, dass du das wirklich geglaubt hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010110,
					"content": "Ich habe herausgefunden, dass ein paar der Fische im Aquarium ihr Revier vehement verteidigen und ziemlich aggressiv werden können. Also habe ich sie hierher umgesetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010111,
					"content": "Erschrick Paimon doch nicht so! Also ist dieser Ort so etwas wie eine spezielle Quarantänezone für aggressive Fischlein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010112,
					"content": "Genau, das Wasser in diesem Becken ist viel tiefer und es bietet viel mehr Platz. Das hilft dabei, die eher revierbezogenen Fische zu beruhigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010113
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010113,
					"content": "Ich habe außerdem Sigewinne im Fort Méropide um einen speziellen Köder gebeten, damit sie sich ein bisschen beruhigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010114,
					"content": "Oha ... Dir liegt das Wohl der Fischlein also wirklich am Herzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010115,
					"content": "Ich glaube, niemand möchte sehen, wie hier im Aquarium ein Blutbad passiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010116,
					"content": "Da hast du recht! Wie dem auch sei, warum überlässt du das nicht uns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010117,
					"content": "Wenn ihr darauf besteht. Wenn sich die Fische im Becken wohl genug fühlen, um an die Oberfläche zu schwimmen, bedeutet das, dass sie auf dem Weg der Besserung sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010118,
					"content": "Wenn sie also alle entspannt und glücklich sind, können wir sie wieder ins Aquarium setzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010119,
					"content": "Wo ihr sie unterbringt, ist ganz euch überlassen. Ich bin nur dafür verantwortlich, die Störenfriede herauszufischen und sie überhaupt erst hierher zu bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010120
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010120,
					"content": "Verstanden! Aber das Schild ist viel zu gruselig. Vielleicht können wir es durch etwas ersetzen, das ein bisschen weniger ... Angst macht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010121,
					"content": "Hmm ... Wenn du willst. Es sind eure Fische, also überlasse ich es euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
}