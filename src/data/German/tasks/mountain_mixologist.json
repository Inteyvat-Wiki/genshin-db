				"objectNames": [
					"Georg"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230201,
					"content": "Oh! Ihr seid wieder da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230202
					],
					"speakerTitle": "Georg"
				},
				{
					"id": 705230202,
					"content": "Seid ihr wieder hier, um eine Bestellung für einen ausländischen Gast aufzugeben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230203
					],
					"speakerTitle": "Georg"
				},
				{
					"id": 705230203,
					"content": "Genau. Diesmal brauchen wir hundert Kisten „Festtagssaft“ für Guanchui, den Koch vom Qingce-Dorf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230204,
					"content": "Wir sind aufs Feilschen vorbereitet, Herr Georg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230205,
						705230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230205,
					"content": "Klingt, als wäre das ein Handelskrieg ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				},
				{
					"id": 705230207,
					"content": "Oh! Was für ein Elan! Dann lasst mich mal euren Spürsinn sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Georg"
				},
				{
					"id": 705230206,
					"content": "Nimm das, Herr Georg!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				}
			]
		},
		{
			"id": 7052303,
			"completionStepIds": [
				7052303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7052303",
							"2"
						],
						"stepId": 7052303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guanchui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230301,
					"content": "Herr Guanchui, wir sind zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230302,
					"content": "Wir haben deine hundert Kisten „Festtagssaft“ bestellt, hier ist dein Beleg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230303,
					"content": "Sehr schön! Ihr habt mir wirklich sehr geholfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230304
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230304,
					"content": "Ich möchte diesen frischen „Festtagssaft“ eingehend untersuchen und ihn im genau richtigen Verhältnis mit dem Tee mischen, um den besten Geschmack zu erzielen. Damit sollen meine Kumpel bei ihrer Feldarbeit richtig Kraft bekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230305
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230305,
					"content": "Hm, das klingt ein wenig nach den Spezialgetränken der Tavernen, aber geht das denn auch mit ... Tee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230306,
					"content": "Keine Sorge, ich habe eine Zeit lang als Koch im Ausland gearbeitet. Auf diese Weise kann ich die Kosten und den Geschmack am besten ausbalancieren. Ich habe schon sehr viel gemixt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230307
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230307,
					"content": "Das möchte ich auch einmal probieren ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230308
					]
				},
				{
					"id": 705230308,
					"content": "Wenn ihr das nächste Mal ins Qingce-Dorf kommt, denn werde ich euch das Resultat vorsetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230309
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230309,
					"content": "#Gut! Dann darf {NICKNAME} zuerst kosten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230310,
					"content": "Du schaffst es, Koch-Wirt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230311
					]
				},
				{
					"id": 705230311,
					"content": "Ich danke euch! Kommt öfters vorbei, wenn ihr Zeit habt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				}
			]
		},
		{
			"id": 7052304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
