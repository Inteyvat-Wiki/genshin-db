							"7052302",
							"2"
						],
						"stepId": 7052302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guanchui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230401,
					"content": "Die Spezialgetränke dieses Weinlesefests harmonieren sehr gut mit dem Tee, der mit dem Bergquellwasser aus Qingce-Dorf gebrüht wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230402
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230402,
					"content": "Ich danke euch beiden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230403,
						705230407,
						705230415
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230403,
					"content": "Erzähl mir von dir ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230404
					]
				},
				{
					"id": 705230404,
					"content": "Es ist noch nicht lang her, seit meine Kumpel und ich wieder ins Dorf gezogen sind. Ich bin dafür zuständig, für meine Kumpel zu kochen und ihnen das Essen aufs Feld zu bringen, wenn sie arbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230405
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230405,
					"content": "Aber die meisten meiner Gerichte sind nur einfache Sattmacher, sie sind nicht geeignet, um Gäste zu bewirten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230406
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230406,
					"content": "Das Qingce-Dorf ist zwar nicht so belebt, aber dafür gibt es viele Delikatessen. Du wirst es wissen, wenn du dich hier umschaust!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230407,
					"content": "Über den Tee ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230408
					]
				},
				{
					"id": 705230408,
					"content": "Die Arbeit auf dem Feld kann einen ganz schön durstig machen. Meine Kumpel können an einem halben Tag eine große Kanne Tee trinken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230409
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230409,
					"content": "Vom Feld ist es eine ganze Strecke bis zum Teestand, das ist viel zu umständlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230410
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230410,
					"content": "Und Onkel Kai ist ein alter Mann, den kann ich nicht losschicken, um meinen Kumpel den Tee zu bringen, deshalb muss ich das selbst machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230411
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230411,
					"content": "Meine Kumpel und ich haben vorher woanders gearbeitet, also ist uns der Tee hier ein bisschen zu fade. Manchmal wollen sie eben etwas Kräftigeres trinken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230412
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230412,
					"content": "Deshalb gebe ich dem Tee Getränke hinzu und verleihe ihm einen frischeren Geschmack, haha, es ist wie eine Würze für das Leben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230413
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230413,
					"content": "Oh, ich mache den Tee natürlich nur für meine Kumpel, ich will ja nicht Onkel Kais Geschäft kapern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230414
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230414,
					"content": "In unserer Freizeit sitzen wir auch an Onkel Kais Teestand und helfen ihm bei diesem und jenem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230415,
					"content": "Wir kommen bald wieder.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230416
					]
				},
				{
					"id": 705230416,
					"content": "Super! Ich warte auf eure guten Nachrichten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				}
			]
		},
		{
			"id": 7052321,
