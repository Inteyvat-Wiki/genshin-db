			"dialogs": [
				{
					"id": 705232101,
					"content": "Nein, so geht das nicht, das ist zu wenig! Auch wenn die Bestellmenge steigt, sollte der Einzelpreis einer Kiste nicht so stark sinken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Georg"
				}
			]
		},
