			},
			"dialogs": [
				{
					"id": 705230101,
					"content": "Gäste von außerhalb? Willkommen im Qingce-Dorf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230102,
						705230103
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230102,
					"content": "Hallo ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230104
					]
				},
				{
					"id": 705230104,
					"content": "Paimon sagt’s, Paimon sagt’s! Wir stellen uns zuerst selbst vor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230105,
					"content": "#Das ist {F#die allmächtige Reisende}{M#der allmächtige Reisende} {NICKNAME} und {F#ihre}{M#seine} tolle Begleitung ist Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230106,
					"content": "Wir helfen unseren nicht ortsansässigen Gästen bei der Bestellung von speziellen Getränken des Weinfests und haben deinen Auftrag gesehen, sodass wir direkt mit dir sprechen wollten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230107,
					"content": "So ist es also, ich mag diese Direktheit! Dann komme ich auch zur Sache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230109
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230109,
					"content": "Ich bin Guanchui, ein Koch. Ich möchte <color=#00E1FFFF>hundert Kisten „Festtagssaft“</color> für einen Früchtetee kaufen und meine Kumpel damit aufheitern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230110
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230110,
					"content": "Also gut! Wir machen uns an die Arbeit! Bitte stell uns dein Budget zur Verfügung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230111,
					"content": "Es ist schon alles vorbereitet. Bitte nehmt dieses „Weingelee“! Nach der Bestellung muss noch etwas übrig sein, das soll der Lohn für eure fleißige und vorzügliche Arbeit sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230112
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230112,
					"content": "Wir nehmen das und machen uns gleich auf den Weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230113,
					"content": "Großartig! Ich warte auf gute Nachrichten von euch beiden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230114,
						705230115
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230114,
					"content": "Das war ein schneller Austausch ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230116
					]
				},
				{
					"id": 705230116,
					"content": "#Wach auf, {NICKNAME}, lass uns gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230117,
					"content": "Wenn du etwas sagen willst, dann warte, bis wir die Bestellung gemacht haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230118,
					"content": "Je eher wir unsere Arbeit gemacht haben, desto eher können wir unseren Laden eröffnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230119,
					"content": "Laden eröffnen, Laden eröffnen, la la la ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230115,
					"content": "Und Paimon war auf der gleichen Welle ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230116
					]
				},
				{
					"id": 705230103,
					"content": "Entschuldigung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230104
					]
				}
			]
		},
		{
			"id": 7052302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
