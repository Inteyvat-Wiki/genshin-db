			"dialogs": [
				{
					"id": 230360601,
					"content": "Sehr gut. Jetzt geht’s ans Angeln. Dieses Mal werde ich sicher einen großen Fisch rausholen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360602
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360602,
					"content": "Kayvan stellt den Köder her und beginnt zu angeln ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230360603
					]
				},
				{
					"id": 230360603,
					"content": "Nach einer kurzen Zeit zieht Kayvan eine nasse Kiste aus dem Wasser ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230360604
					]
				},
				{
					"id": 230360604,
					"content": "Lass mich mal sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360605
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360605,
					"content": "Hä? Was ist darin ... Das scheinen wieder vermisste Sachen zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360606,
						230360607
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360606,
					"content": "Typisch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360608
					]
				},
				{
					"id": 230360608,
					"content": "Hm ... Seit Herr Kayvan den Gelehrten aufgesucht hatte, um seine Köder zu verbessern, angelten wir die ganze Zeit draußen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360609
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360609,
					"content": "Aber bei jedem Versuch ... hat Herr Kayvan seltsame Dinge rausgeholt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360610
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360610,
					"content": "Unter anderem vermisste Gegenstände, Erz vom Grund des Flusses, Päckchen, die von einem Boot gefallen sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360611
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360611,
					"content": "Sogar ein Abenteurer, der ins Wasser gefallen war, schaffte es, Herrn Kayvans Schnur zu ergreifen und ans Ufer zu klettern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360612
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360612,
					"content": "Aber wir konnten nicht einen einzigen Fisch fangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360613
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360613,
					"content": "Meine Angelkarriere ist zu Ende ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360614
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360614,
					"content": "Herr Kayvan! Sei nicht enttäuscht. Sch... Schau, der Besitzer dieses Dings ist sicher in Sorge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360615
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360615,
					"content": "Er ist bestimmt froh darüber, dass du seine verlorenen Sachen rausgeholt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360616
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360616,
					"content": "Wir bringen diese verlorenen Sachen zur Abenteurergilde, vielleicht bekommen wir ja eine Belohnung dafür!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360617
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360617,
					"content": "Aber! Ich will! Ich will wirklich nur ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360618
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360618,
					"content": "... einen Fisch fangen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360607,
					"content": "„Wieder“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360608
					]
				}
			]
		},
