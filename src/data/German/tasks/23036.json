					"Helbet",
					"Kayvan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230360101,
					"content": "Herr Kayvan, versuche es noch einmal mit dem neuen Köder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360102
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360102,
					"content": "Ich habe es schon unzählige Male versucht, es ist immer dasselbe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360103,
					"content": "Hä? Ihr zwei angelt wieder zusammen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230360104,
					"content": "#{F#Reisende}{M#Reisender}, wir treffen uns wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360105
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360105,
					"content": "Hallo ihr zwei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360106,
						230360107
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360106,
					"content": "Hast du herausgefunden, warum die Fische nicht anbeißen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				},
				{
					"id": 230360108,
					"content": "Haha, gar nichts. Der Gelehrte und ich haben versucht, die Angel und den Köder und sogar die Technik zu verbessern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360109
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360109,
					"content": "Ich weiß nicht, wie viele Gewässer und Winkel wir ausprobiert haben ... Ich habe sogar versucht, in einem Teich voller Fische zu angeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360110
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360110,
					"content": "Aber egal, was ich tat, ich habe nur Sachen gefangen, die alles außer Fisch sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360111
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360111,
					"content": "Keine Sorge, Herr Kayvan. Hat der Gelehrte nicht versprochen, weiterzuforschen? Er wird bestimmt den Grund herausfinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360112
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360112,
					"content": "Schau, er hat einen neuen Köder für dich entwickelt und mich gebeten, bei dir zu bleiben und alle Informationen über deine Angelei aufzuzeichnen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360113
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360113,
					"content": "Ich hoffe wirklich, dass er es herausfindet ... Aber bis dahin angle ich besser weiter auf meine Art.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360114
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360114,
					"content": "#{F#Reisende}{M#Reisender}, hättest du Zeit, noch mehr Material für meine Köder zu finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360107,
					"content": "Konntest du etwas von dem Gelehrten erfahren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				}
			]
		},
