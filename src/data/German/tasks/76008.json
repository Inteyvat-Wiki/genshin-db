				]
			},
			"dialogs": [
				{
					"id": 760080101,
					"content": "Ah, möge das Mondlicht euren Weg erleuchten! Seid ihr auch hier, um zu Frau Kuu{RUBY#[S]Mondmädchen}tar zu beten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080102
					],
					"speakerTitle": "Eveliina"
				},
				{
					"id": 760080102,
					"content": "Beten ... meinst du hier vor der Statue? Die Statue ist übrigens echt riesig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760080103,
					"content": "Hehe, schön, oder? Diese „Neumondskulptur“ wurde angeblich vor fünfhundert Jahren von der Mondkantorin persönlich gemeißelt. Sie stellt die ursprüngliche Gestalt von Kuu{RUBY#[S]Mondmädchen}tar dar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080104
					],
					"speakerTitle": "Eveliina"
				},
				{
					"id": 760080104,
					"content": "Was die Geburt von Frau Kuu{RUBY#[S]Mondmädchen}tar und ihre wundersamen Taten in der Welt unter dem Mond betrifft ... als einfacher Priester werde ich euch nicht zu viele Details darüber erzählen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080105
					],
					"speakerTitle": "Eveliina"
				},
				{
					"id": 760080105,
					"content": "Kurz gesagt, hier ist auch das Ende des Pilgerwegs, auf dem man Kuu{RUBY#[S]Mondmädchen}tar seine Gebete darbringt. Selbst wenn ihr beiden nicht zum Beten da seid, hoffe ich, dass ihr ihren Segen spürt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080106
					],
					"speakerTitle": "Eveliina"
				},
				{
					"id": 760080106,
					"content": "So ist das also ... Äh, warte mal! Hier ist schon das Ende? Was hat es denn dann mit dieser toll aussehenden Säule da auf sich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760080107,
					"content": "Haha ... das ist eigentlich gar keine Säule. Darunter befindet sich der „Hof der ersten Verkündung“, ein altes Heiligtum, das vor fünfhundert Jahren auf Befehl der ehrwürdigen Mondkantorin versiegelt wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080108
					],
					"speakerTitle": "Eveliina"
				},
				{
					"id": 760080108,
					"content": "In gewisser Weise ... ist es wohl ein verbotener Ort für die „Nachkommen des Frostmonds“? Und weil er von der Mondkantorin versiegelt wurde, kann niemand mehr hinein, also solltest du dich besser davon fernhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080109
					],
					"speakerTitle": "Eveliina"
				},
				{
					"id": 760080109,
					"content": "Und dieses große Ding da oben ... das ist tatsächlich letztens vom Himmel gefallen. Dank Kuu{RUBY#[S]Mondmädchen}tars Gnade wurde niemand von den herunterfallenden Splittern verletzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080110
					],
					"speakerTitle": "Eveliina"
				},
				{
					"id": 760080110,
					"content": "Äh, Splitter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760080111,
					"content": "Ja, als das große Ding herunterfiel, sind mehrere Brocken davon abgefallen. Einer von ihnen landete im <color=#00E1FFFF>Lager da unten</color> ... Ihr habt es bestimmt auch gesehen, als ihr hergekommen seid, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080112
					],
					"speakerTitle": "Eveliina"
				},
				{
					"id": 760080112,
					"content": "Die anderen, etwas größeren Bruchstücke sind meiner Erinnerung nach hauptsächlich Richtung <color=#00E1FFFF>Westen</color> gefallen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080113
					],
					"speakerTitle": "Eveliina"
				},
				{
					"id": 760080113,
					"content": "Jedenfalls seid ihr bestimmt durch die Weisungen der ehrwürdigen Kuutar hierhergeführt worden. Auch wenn ihr nicht zum Beten gekommen seid, möge das Mondlicht euren weiteren Weg segnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eveliina"
				}
			]
		}
	]
}