			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3081301,
					"content": "Die ganze Zeit hier draußen macht mich ganz wirr. Man spürt, dass der Fluss der Elemente vollkommen durcheinander geraten ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081302
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081302,
					"content": "Gehen wir lieber schnell in den Tempel. Dann wird es auch uns besser gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
		{
			"id": 30814,
			"completionStepIds": [
				30814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
