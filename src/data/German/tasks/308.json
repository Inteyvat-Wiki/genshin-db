			"dialogs": [
				{
					"id": 3081101,
					"content": "#He, {F#meine Süße}{M#mein Süßer}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081102,
					"content": "Ich bin ganz gerührt, dass du uns bei so gefährlichen Unternehmungen unterstützt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081103
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081103,
					"content": "Solltest du etwas nicht ganz verstehen, kannst du mich jederzeit fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081104,
						3081108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081104,
					"content": "Wofür ist ein Bibliothekar zuständig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081105
					]
				},
				{
					"id": 3081105,
					"content": "Das ist eine gute Frage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081106,
					"content": "Im Prinzip für alles, wofür man weder Muskeln noch Kopf braucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081107,
					"content": "Was bleibt denn da noch übrig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3081111,
					"content": "Das solltet ihr auch tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081108,
					"content": "Was macht denn eine Bibliothekarin bei den Ruinen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081109
					]
				},
				{
					"id": 3081109,
					"content": "Das ist eine gute Frage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081110,
					"content": "Jean vertraut mir einfach sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081111
					],
					"speakerTitle": "Lisa"
				}
			]
		},
