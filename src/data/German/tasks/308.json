			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3081401,
					"content": "Drache des Ostens, Löwe des Südens, Wolf des Nordens, Falke des Westens ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081402
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081402,
					"content": "Dies sind die Vier Winde, die Beschützer von Mondstadt. Sie gehören zu Barbartos, dem Anemo-Archon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081403
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081403,
					"content": "Dvalin – das ist der eigentliche Name von Sturmschrecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081404
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081404,
					"content": "Bevor er von den Menschen so bezeichnet wurde, war er der „Drache des Ostens“ von den Vier Winden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081405
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081405,
					"content": "Dvalin kann jetzt nur die Kraft der anderen drei nutzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081406
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081406,
					"content": "Denn seine eigene Kraft hatte er schon längst aufgebraucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081407,
						3081408
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081407,
					"content": "Warum verhält er sich überhaupt so?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081409
					]
				},
				{
					"id": 3081409,
					"content": "Ich vermute, es liegt am Hass.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081410
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081410,
					"content": "Hass?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3081411,
					"content": "Der Hass Mondstadt gegenüber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081412
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081412,
					"content": "Dieser Hass hat ihn noch mächtiger als den Wind selbst gemacht. Auf diese Weise wurde er zu Sturmschrecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081413
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081413,
					"content": "Wie konnte einer der Vier Winde nur so einen Hass entwickeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3081414,
					"content": "Und die Stadt angreifen, die er eigentlich beschützen sollte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3081415,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081416
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081416,
					"content": "Als Bewohner von Mondstadt ist die Frage nicht leicht zu beantworten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081417
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081417,
					"content": "Du kannst dir das gern durchlesen. Hier geht es darum, was vor Jahrhunderten geschehen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081408,
					"content": "Warum macht er nicht einmal davor Halt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081409
					]
				}
			]
		}
	]
}