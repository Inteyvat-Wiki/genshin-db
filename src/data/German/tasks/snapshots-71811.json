						718110602
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 718110602,
					"content": "Es geht um den Fotoapparat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110603
					]
				},
				{
					"id": 718110603,
					"content": "Ah, stimmt, genau. Ich ging zur Händlergilde Feiyun, um sie zu bitten, hier ein Foto für mich zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110604
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 718110604,
					"content": "Wie ist es? Wurde das Bild bereits ausgedruckt? Ich will es mir mal ansehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110605
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 718110605,
					"content": "Oh, das ist gar nicht schlecht. Danke, dass du den Weg hierher gefunden hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teekenner Liu Su"
				}
			]
		},
