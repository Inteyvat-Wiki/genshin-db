			"dialogs": [
				{
					"id": 718110501,
					"content": "Oh? Worum geht es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110502
					],
					"speakerTitle": "Oma Shan"
				},
				{
					"id": 718110502,
					"content": "Es geht um den Fotoapparat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110503
					]
				},
				{
					"id": 718110503,
					"content": "Der Fotoapparat ... Ah, ja, ich war vor ein paar Tagen bei der Händlergilde Feiyun und habe sie gebeten, hierherzukommen, um ein Foto für mich zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110504
					],
					"speakerTitle": "Oma Shan"
				},
				{
					"id": 718110504,
					"content": "Bist du nur gekommen, um diese Bilder zu überbringen? Ich danke dir. Ich danke dir vielmals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oma Shan"
				}
			]
		},
