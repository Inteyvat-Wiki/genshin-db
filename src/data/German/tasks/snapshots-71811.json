			"dialogs": [
				{
					"id": 718110412,
					"content": "Es geht um den Fotoapparat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110401
					]
				},
				{
					"id": 718110401,
					"content": "Konntest du die Bilder liefern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110402
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110402,
					"content": "Alles erledigt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110403
					]
				},
				{
					"id": 718110403,
					"content": "Vielen Dank, vielen Dank. Es tut mir leid, dass ich deine Zeit in Anspruch nehme, aber wir halten uns hier kaum über Wasser ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110404
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110404,
					"content": "Ah, ja. Bitte nimm diesen Fotoapparat als Dank für deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110405,
						718110406
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110405,
					"content": "Das kann ich doch nicht annehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				},
				{
					"id": 718110407,
					"content": "Das ist kein Problem. Ich meine, du hast uns doch geholfen, oder nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110408
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110408,
					"content": "Das ist auch nicht gerade ein besonders teurer Gegenstand. Es ist nur ein Muster, das uns unsere Partner in Fontaine gegeben haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110409
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110409,
					"content": "Es gibt zwar einige Unterschiede zum offiziellen Modell ... aber die Grundfunktionen sind alle vorhanden. Für deine Bedürfnisse wird er definitiv ausreichend sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110410
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110410,
					"content": "Und wenn er dir gefällt, kannst du uns auch hier und da mit etwas Werbung helfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110411
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110411,
					"content": "Ähm ... Trotzdem vielen Dank für deine Hilfe und nimm bitte diesen Fotoapparat mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110406,
					"content": "Der musst doch wahnsinnig teuer sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				}
			]
		},
