			"dialogs": [
				{
					"id": 220430301,
					"content": "Diese sollten ausreichend sein. Es tut mir leid, dass ich dich um Hilfe bitten musste. Bitte nimm das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430302,
					"content": "Wenn ich gut im Holzschnitzen werde, werde ich dir eine meiner besten Holzschnitzereien geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430303
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430303,
					"content": "Wie soll das nächste Exemplar von der vorläufigen Oberpriesterin aussehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		}
