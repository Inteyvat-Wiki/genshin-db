			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220430101,
					"content": "Wie ist das Holz wieder ausgegangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430102
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430102,
					"content": "#Oh! {F#Reisende}{M#Reisender}, du kommst gerade rechtzeitig, möchtest du mir einen Gefallen tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430103,
						220430104
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430103,
					"content": "In welcher Weise?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430105
					]
				},
				{
					"id": 220430105,
					"content": "In letzter Zeit habe ich versucht, einige sehr kleine Holzskulpturen nach dem Vorbild von der vorläufigen Oberpriesterin zu schnitzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430106
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430106,
					"content": "Ich dachte, dass ich, wenn ich besser im Schnitzen werde, diese Holzschnitzereien zurück nach Narukami bringen würde und sehen würde, ob ich sie verkaufen könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430107
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430107,
					"content": "Wenn es geht, sollte es ein regelmäßiges Einkommen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430108,
						220430111
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430108,
					"content": "Du kannst es sicher verkaufen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430109
					]
				},
				{
					"id": 220430109,
					"content": "Danke für die Worte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430110
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430110,
					"content": "Aber ich habe auch Vertrauen in den Charme der vorläufigen Oberpriesterin, hehehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430118
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430118,
					"content": "Ah ... Genug davon jetzt, kommen wir zur Sache ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430119
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430119,
					"content": "Tatsächlich ist mir in letzter Zeit ein wenig das Holz ausgegangen, mit dem ich das Schnitzen üben kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430120
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430120,
					"content": "#{F#Reisende}{M#Reisender}, kannst du bitte nach draußen gehen und zehn Stück „Otogi-Holz“ für mich sammeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430121,
						220430123
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430121,
					"content": "Werde ich machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430122
					]
				},
				{
					"id": 220430122,
					"content": "Danke, das wäre wirklich eine große Erleichterung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430126
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430126,
					"content": "Sobald du das alles eingesammelt hast, bring die Sachen direkt hierher zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430123,
					"content": "So viele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430124
					]
				},
				{
					"id": 220430124,
					"content": "Schließlich habe ich gerade erst angefangen, das Schnitzen zu üben ... Es ist immer gut, ein paar zusätzliche Materialien zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430125
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430125,
					"content": "#Dann zähle ich auf dich, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430126
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430111,
					"content": "Warum hast du plötzlich mit der Holzschnitzerei angefangen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430112
					]
				},
				{
					"id": 220430112,
					"content": "Weißt du, was unsere vorläufige Oberpriesterin mir als „Vergütung“ gegeben hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430113
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430113,
					"content": "Es sind ein paar ... Flaschen und Gläser, solche Sachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430114
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430114,
					"content": "Sie sahen ein bisschen alt aus, aber als ich sie zurückbrachte, um es jemandem zu zeigen, stellte ich fest, dass sie tatsächlich ziemlich alt waren und für ein bisschen Geld verkauft werden konnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430115
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430115,
					"content": "Aber der Prozess, diese Dinge für Geld zu verkaufen, war mühsam und erschöpfte mich jedes Mal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430116
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430116,
					"content": "Außerdem ist das Einkommen nicht stabil ... Wenn der Tag kommt, an dem die vorläufige Oberpriesterin diese Dinge nicht mehr finden kann, bin ich wieder arbeitslos ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430117
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430117,
					"content": "Ich versuche also, Wege zu finden, um einen neuen Geschäftszweig zu erschließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430118
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430104,
					"content": "Was machst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430105
					]
				}
			]
		},
