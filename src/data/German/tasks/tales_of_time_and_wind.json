			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100070401,
					"content": "Diese Insel ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070402
					]
				},
				{
					"id": 100070402,
					"content": "Ist sie etwas Besonderes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070403
					]
				},
				{
					"id": 100070403,
					"content": "#Nicht immer. Einst war sie eine Insel wie jede andere{NON_BREAK_SPACE}– eine gewöhnliche, bescheidene Ansammlung von Sand und Kies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070404,
					"content": "Bis der Wind die Samen der Geschichten hierher trug und die Zeit sie heranwachsen ließ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070405,
					"content": "Und mit der Zeit brachte der Wind neue Geschichten hervor, die durch die Zeit zu Legenden wurden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070406
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070406,
					"content": "#Also, damit ... erlaube mir, dich „wirklich“ auf dieser von der Zeit begünstigten Insel willkommen zu heißen, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070407,
					"content": "Dies ist der Ort, an dem sich in ferner Vergangenheit Zeit und Wind trafen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070408,
					"content": "Wah, wah, wah ... Du klingst plötzlich so ernst, du taktloser Straßenmusikant. Paimon ist sich auch nicht mehr sicher, ob Paimon diesem Gespräch noch folgen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070409,
					"content": "Hehe, keine Sorge, liebe Paimon! Die besten Geschichten beginnen immer mit ein wenig Spannung und Intrigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
