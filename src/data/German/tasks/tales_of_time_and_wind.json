			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100071001,
					"content": "Es war einmal, da rief ich im Namen des Volkes von Mondstadt die ersten Winde der Freiheit herbei. Mit der Hilfe dieser Winde wurde die Freiheit all jenen zurückgegeben, denen sie zustand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1000711,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"1504501",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100071101,
					"content": "Ich habe dir das doch schon mal erzählt, erinnerst du dich? Wie ich im Tempel der Tausend Winde auf die „Zeit“ traf und Hilfe erhielt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071102,
					"content": "Nun, es war die Hilfe der Zeit, die es den ersten Winden der Freiheit ermöglichte, so stark zu wehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1000712,
			"completionStepIds": [
				1000703
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100071201,
					"content": "Aber solch starke Windböen eignen sich eher dafür, alles wegzufegen, als etwas beim Wachsen zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071202,
					"content": "Nachdem also einige Krisen in Mondstadt gelöst waren, machte ich die Winde sanfter – gerade stark genug, um die Menschen in Zeiten der Not zu unterstützen, ohne sie von den Füßen zu reißen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071203,
						100071204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071203,
					"content": "Und dieses Mal bist du hier ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100071205
					]
				},
				{
					"id": 100071205,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071206,
					"content": "In der Ferne sammeln sich Schatten. Ich bin mir sicher, du hast es auch gespürt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071207,
					"content": "Ich habe von der Konfrontation zwischen dem Pyro-Archon und Ronova, der Herrscherin des Todes, gehört und davon, was mit dem „Capitano“ der Elf der Fatui, geschehen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071208,
					"content": "Und dabei haben wir noch gar nicht erwähnt, dass die Aktivitäten des Abgrunds immer näher an Mondstadt heranrücken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071209
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071209,
					"content": "Ich fürchte, die bevorstehende Krise könnte die Fähigkeiten der Menschen allein übersteigen ... Angesichts dessen muss ich vorbereitet sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071210
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071210,
					"content": "Es ist die Pflicht des Anemo-Archons, in Zeiten der Not einzugreifen. Als solcher werde ich, Barbatos, einen Wind herbeirufen, der stark genug ist, um jeden kommenden Sturm zu vertreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071211
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071211,
					"content": "Aber wenn ich einen so starken Sturm in Mondstadt aufkommen lasse, würde das dort alles auf den Kopf stellen – Kleidung, Hüte und die Blumen auf den Balkonen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071212,
					"content": "Deshalb habe ich diesen Ort gewählt — hier, wo ich einst eine Ode an die Zeit dargebracht habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071213,
					"content": "Wer weiß, vielleicht schenkt die Zeit dieser Insel gerade wegen meiner wunderschönen, wunderschönen Musik besondere Gunst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071214
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071214,
					"content": "Moment mal ... Ist dieser Ort wirklich so besonders? So sieht er aber gar nicht aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100071215,
					"content": "Es gibt Ebbe und Flut, Vögel kommen und gehen ... Es scheint einfach ... normal zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100071216,
					"content": "Die Zeit hinterlässt nicht nur sichtbare Spuren. Sie ist wie ... eine reife Dämmerfrucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071217
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071217,
					"content": "Wenn die äußere Schale intakt bleibt, ist es für einen normalen Menschen fast unmöglich zu erkennen, ob die Frucht innen reif ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071218
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071218,
					"content": "Aber selbst das kleinste Loch in dieser Schale führt dazu, dass die Frucht von dieser Stelle aus zu faulen beginnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071219
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071219,
					"content": "In den Händen der Zeit ruhend, zeigt diese Insel nicht einen einzigen „Makel“ auf ihrer „Schale“. So bleibt der Einfluss der Zeit auf ihr wahres Wesen allen verborgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071220
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071220,
					"content": "Im Grunde genommen werden natürlich alle Dinge, denen die Gunst der Zeit fehlt, irgendwann ausgelöscht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071221
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071221,
					"content": "Aber mit der Kraft, die hier noch verbleibt, kann ich die Zeit nutzen, um eine Grenze um den Wind zu ziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071222
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071222,
					"content": "Auf diese Weise wird die Außenwelt nichts davon bemerken, egal, wie stark der Sturm ist, den ich hier entfessle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071223
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071223,
					"content": "#Da ich dich um Hilfe bitte, sollte ich natürlich auch eine Gegenleistung anbieten. Deshalb habe ich dich hierher eingeladen, {NICKNAME} ... damit wir gemeinsam eine Ode an die Zeit spielen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071224
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071224,
					"content": "#Sag mir einfach Bescheid, wenn du bereit bist, {NICKNAME}. Oh, und ich kann dir ein Instrument leihen, falls du eins brauchst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071204,
					"content": "... um genau was zu tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100071205
					]
				}
			]
		},
		{
			"id": 1000713,
