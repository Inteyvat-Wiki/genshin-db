				]
			},
			"dialogs": [
				{
					"id": 100070301,
					"content": "Paimon dachte, wir müssten super weit fliegen, aber anscheinend sind wir direkt vor der Stadt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1000704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
