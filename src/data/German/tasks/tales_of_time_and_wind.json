			"dialogs": [
				{
					"id": 100071401,
					"content": "Vorher gibt es noch etwas, das ich erledigen muss ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100071402
					]
				},
				{
					"id": 100071402,
					"content": "Keine Sorge. Komm einfach zu mir, wenn du so weit bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
