			"dialogs": [
				{
					"id": 100070101,
					"content": "... Dann nehme ich das mal als ein Ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070102,
					"content": "Venti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070103
					]
				},
				{
					"id": 100070103,
					"content": "#Ah, na endlich! Da bist du ja, {NICKNAME}! Sag mal, hast du vielleicht eine Nachricht für mich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070104,
						100070105
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070104,
					"content": "Eine Nachricht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070106
					]
				},
				{
					"id": 100070106,
					"content": "„In diesem Lexikon steht keine einzige Prophezeiung über dich.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070107
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070107,
					"content": "Das wolltest du doch gerade sagen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070108,
						100070109
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070108,
					"content": "Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070110
					]
				},
				{
					"id": 100070110,
					"content": "#Oh? Nur einen Moment, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070111
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070111,
					"content": "Hmm ... Deine Neugier scheint so stark wie eh und je zu sein, Barbeloth. Aber leider wird meine „Zukunft“ wohl nicht in deinem Lexikon zu finden sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070112
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070112,
					"content": "Der Wind mag es zwar zulassen, dass Pusteblumen seine Form nachzeichnen und Dichter ihn in Verse fassen, doch seiner Natur entspricht es kaum, eingefangen zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070113
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070113,
					"content": "Also, liebe Barbeloth, leg bitte deinen Stift beiseite. Worte, die der Wind trägt, sind nicht dafür bestimmt, auf Papier festgehalten zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070114
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070114,
					"content": "Wenn du dich wirklich für diese Legende interessierst, lass mich sie in ein Gedicht verwandeln. Ich werde es euch bei unserer nächsten Teeparty gerne vortragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070115
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070115,
					"content": "Barbeloth? Sie ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070116
					]
				},
				{
					"id": 100070116,
					"content": "Hahaha, Barbeloth war schon immer eine vernünftige Person, und ich glaube, sie hat meine Bitte erhört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070117
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070117,
					"content": "Daher sollte unser Gespräch jetzt ohne Unterbrechungen verlaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070118
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070118,
					"content": "Moment mal, Barbeloth hat uns gerade belauscht? P... Paimon hat gar nichts bemerkt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070119,
					"content": "Nun ja, sie ist eine Hexe des Hexenzirkels. Die haben alle ein paar Tricks auf Lager.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070120
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070120,
					"content": "Aber du hast es sofort bemerkt und sie sogar dazu gebracht, uns in Ruhe zu lassen. Macht dich das nicht zum wahren Meister hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070121,
					"content": "Hmm ... Wenn ich die verschiedenen praktischen Faktoren berücksichtige, würde ich mich als Meister bezeichnen – mit Einschränkungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070122
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070122,
					"content": "Da machst du schon wieder diese geheimnisvollen Andeutungen. Tja, wie auch immer, in diesem Lexikon stand jedenfalls kein einziges Wort über dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070123,
						100070124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070123,
					"content": "Ja, sie hat einfach ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070125
					]
				},
				{
					"id": 100070125,
					"content": "Dass du hier bist, reicht schon. Barbeloths „Prophezeiung“ über mich mag zwar „unvollständig“ sein, aber nicht „falsch“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070126
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070126,
					"content": "Ich muss etwas erledigen und könnte dabei tatsächlich deine Hilfe gebrauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070127,
						100070128
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070127,
					"content": "Worum geht es?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070129
					]
				},
				{
					"id": 100070129,
					"content": "Hehe, auf dich ist wie immer Verlass. In dem Fall ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070130
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070130,
					"content": "#Könntest du später mit mir ein Lied spielen, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070131,
						100070132
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070131,
					"content": "Häh? Ich meine, klar ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070133
					]
				},
				{
					"id": 100070133,
					"content": "Jap. Das ist alles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070134
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070134,
					"content": "Aber keine Sorge. Dies ist keine Aufführung, bei der das Schicksal eines wichtigen Ereignisses auf dem Spiel steht ... Es ist einfach nur ein Duett unter Freunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070135
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070135,
					"content": "Als ich dieses Lied das letzte Mal gespielt habe, war der heulende Sturm mein einziges Publikum, und die Noten wurden in alle Richtungen zerstreut, sodass nur Bruchstücke der Melodie zurückblieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070136
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070136,
					"content": "Aber jetzt, mit dir als Freund an meiner Seite, warum sollte der Wind allein Zeuge dieser Musik sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070137
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070137,
					"content": "Außerdem glaube ich, dass meine Hände viel ruhiger sein werden, wenn ich mit einem zuverlässigen Freund wie dir zusammen spiele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070138
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070138,
					"content": "Ich werde mein Bestes geben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070139
					]
				},
				{
					"id": 100070139,
					"content": "Mehr verlange ich nicht. Machen wir uns jetzt auf zum Aufführungsort. Wenn wir dem Wind folgen, sind wir im Nu da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070132,
					"content": "Aber ist das alles, was ich machen soll?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070133
					]
				},
				{
					"id": 100070128,
					"content": "Du kannst dich auf mich verlassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070129
					]
				},
				{
					"id": 100070124,
					"content": "... gesagt, dass ich hier warten soll.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070125
					]
				},
				{
					"id": 100070109,
					"content": "Die Hexen wollten aber sowieso, dass ich dich aufsuche.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070110
					]
				},
				{
					"id": 100070105,
					"content": "Eigentlich ... ähm ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070106
					]
				}
			]
		},
