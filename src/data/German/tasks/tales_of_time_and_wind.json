					"content": "Wir sind bereit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100071302
					]
				},
				{
					"id": 100071302,
					"content": "Prima. Dann lasst uns anfangen.",
					"roleType": "TALK_ROLE_NPC",
