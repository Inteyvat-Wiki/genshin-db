				]
			},
			"dialogs": [
				{
					"id": 100070701,
					"content": "#In Ordnung, das wäre geschafft. Das war eine ausgezeichnete Vorstellung, {NICKNAME}. Vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070702
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070702,
					"content": "Diese Kraft, die du gerade entfesselt hast ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070703
					]
				},
				{
					"id": 100070703,
					"content": "Ah, mach dir keine Sorgen. Diese Kraft gehörte nur mir allein. Ich hatte keine Hilfe von außen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070704
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070704,
					"content": "Stell es dir vor wie ... das Stimmen eines Musikinstruments, damit es noch schönere Melodien spielen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070705,
					"content": "Ha, du hast also doch ein paar Tricks auf Lager! Was verbirgst du noch vor uns, hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070706,
					"content": "Ach, Paimon. Wie viele Tricks könnte ich schon haben? Ich habe ja schließlich nur zwei Ärmel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070707,
					"content": "Du weißt genau, dass Paimon das nicht so gemeint hat, du taktloser Straßenmusikant!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070708,
					"content": "Hahaha, ich hab so ein Gefühl, dass der Wind heute ziemlich stark weht. Wir sollten nach Mondstadt zurückkehren und den Leuten sagen, sie sollen ihre Hüte festhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1000710,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
