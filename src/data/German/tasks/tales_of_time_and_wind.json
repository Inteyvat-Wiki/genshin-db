			"dialogs": [
				{
					"id": 100070501,
					"content": "Ah, wie es scheint, hat unsere Musik einige im Publikum dazu bewegt, auf die Bühne zu kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070502
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070502,
					"content": "Aber das verstößt gegen die Konzertregeln, also geleiten wir sie hinaus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1000707,
			"completionStepIds": [
