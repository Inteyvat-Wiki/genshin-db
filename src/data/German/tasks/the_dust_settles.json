			"dialogs": [
				{
					"id": 761150301,
					"content": "Ein Mensch, der nichts anderes kennt, als es dem gestrigen Selbst gleichzutun, erbärmlich ... und wie erwartet, ziemlich langweilig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150302
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150302,
					"content": "Er hat doch so lange keine bösen Sachen gemacht, und am Ende trotzdem ... Vielleicht ist er von Natur aus ein böser Mensch, der sich nie ändert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150303,
						761150304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150303,
					"content": "Gutes zu tun ist offensichtlich schwerer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150305
					]
				},
				{
					"id": 761150305,
					"content": "Die Wahl lag immer bei ihm. Selbst eben hätte er eingestehen und bereuen können. Aber er hat sich wieder falsch entschieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150306
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150306,
					"content": "Jeder falsche Zug hat ihn in diese ausweglose Lage gebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150307
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150307,
					"content": "#Nun, immerhin ist wieder ein Kopfgeldauftrag erledigt. Die Beweise gehen wie vereinbart von {NICKNAME} an Leszek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150308
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150308,
					"content": "#Mit der Chefin und {NICKNAME} an der Seite kann man echt beruhigt sein! Dieses Mal mach ich wirklich Urlaub!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150309
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150309,
					"content": "Hehe, deine Pause ist vorbei, also wird’s Zeit, dass du wieder an die Arbeit gehst, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150310
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150310,
					"content": "Ahhhh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150304,
					"content": "Er hat falsche Entscheidungen getroffen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150305
					]
				}
			]
		}
	]
}