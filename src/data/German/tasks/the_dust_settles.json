				]
			},
			"dialogs": [
				{
					"id": 761150201,
					"content": "... Ich hab euch doch nichts getan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150202
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150202,
					"content": "Anscheinend weißt du genau, warum wir hier sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150203
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150203,
					"content": "... Das ist alles Vergangenheit. Jetzt will ich nur noch ein ruhiges Leben führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150204
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150204,
					"content": "Indem du anderen die Identität stiehlst? Erst Juhani, aber das ist dir nicht gelungen, und dann Derwent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150205
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150205,
					"content": "Aber so eine billige Maskerade fliegt früher oder später auf. Es wird kein weiteres Opfer mehr geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150206
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150206,
					"content": "... Juhani? Seine Identität soll ich zu stehlen versucht haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150207
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150207,
					"content": "Die gehört nicht ihm ... warum sollte sie ihm gehören? Nur weil er besser aussieht und sich gut bei Leuten einschleimen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150208
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150208,
					"content": "Wir sind doch gleich! ... Was er mir weggenommen hat, gehörte von Anfang an mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150209
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150209,
					"content": "Und was ist mit Derwent und dem reisenden Händler? Was haben sie dir getan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150210
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150210,
					"content": "... Sie? Sie haben Fragen gestellt, die sie besser nicht gestellt hätten. Genau wie ihr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150211
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150211,
					"content": "Sterbt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Derwent"
				}
			]
		},
