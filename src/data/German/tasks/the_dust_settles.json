			"dialogs": [
				{
					"id": 761150101,
					"content": "Huch? Nefer und Jahoda! Warum seid ihr denn hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150102,
					"content": "Natürlich wegen unserer Arbeit. Wir haben die Person gefunden, auf die das Kopfgeld ausgesetzt wurde und auf die es bisher keine Hinweise gab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150103,
					"content": "Du hörst dir Jahodas Zusammenfassung über die Kopfgeldzielperson „Kinnbrecher“ Hark an sowie die Informationen, die das „Kuratorium der Geheimnisse“ bisher dazu sammeln konnte ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761150104
					]
				},
				{
					"id": 761150104,
					"content": "Kommen wir gleich zur Schlussfolgerung. Der wahre Einsiedler Derwent wurde höchstwahrscheinlich schon getötet, und derjenige, der jetzt die Hütte des Einsiedlers besetzt hat, ist unsere Zielperson „Kinnbrecher“ Hark.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150105,
					"content": "Das Tagebuchfragment, das Jahoda gefunden hat, kann ebenfalls als Beweis dienen: Derwent hat ihn aufgenommen, obwohl er die ganze Wahrheit bereits kannte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150106,
					"content": "Es überrascht nicht, dass Hark in alte Muster zurückfiel. Nachdem er Derwent getötet hatte, stahl er auch noch dessen Identität.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150107,
					"content": "Auch wenn wir bei den Nachforschungen sein Gesicht nicht zu sehen bekamen, konnte der Kerl in der Hütte unmöglich Herr Derwent sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150108
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150108,
					"content": "Und solange er sich als Einsiedler ausgibt, schöpfen die Leute auch bei seltsamem Verhalten keinen Verdacht. Diese Maske ist sicher nicht für die Selbstkultivierung gedacht, sondern um die Narbe am Kinn zu verbergen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150109
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150109,
					"content": "Und was den verschwundenen reisenden Händler angeht, im schlimmsten Fall ist er wohl auch schon tot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150110,
					"content": "So viele böse Taten und dann auch noch zweimal Gutherzigkeit mit Undank vergolten ... was für ein Schurke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150111,
					"content": "Ich vermute, dass der Diebstahl der Sachen der Karawane „Wandernder Kreis“ wirklich nichts mit Hark zu tun hatte. Das Motiv wäre viel zu schwach gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150112,
					"content": "Er hat in diesen zehn Jahren nie die Regeln gebrochen. Waren die gestohlenen Waren wirklich so wertvoll, dass er alles aufs Spiel gesetzt hätte? Wohl kaum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150113
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150113,
					"content": "Dann stellen wir mal ein paar Vermutungen an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150114
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150114,
					"content": "Es ist bekannt, dass er nach dem Vorfall zum Wrack der Atlas zurückkehrte und dort Schatzjäger angriff. Gerät man in Schwierigkeiten, zieht es einen instinktiv zurück zum Ausgangspunkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150115
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150115,
					"content": "Als er noch Steuermann auf der Atlas war, waren ihm Ruhm und Reichtum sicher. Aber was war, nachdem er der Karawane „Wandernder Kreis“ beigetreten ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150116,
					"content": "Obwohl er sich zehn Jahre lang an die Regeln hielt, richteten die Leute bei jedem Diebstahl sofort misstrauische Blicke und Worte gegen ihn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150117
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150117,
					"content": "Noch schwerer war für ihn zu ertragen, dass Juhani, der aus demselben Umfeld stammte und früher ein Niemand war, sich jetzt bestens zurechtfand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150118
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150118,
					"content": "Selbst als er Juhani direkt beschuldigte, hat ihm keiner geglaubt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150119,
					"content": "Von Enttäuschung und Wut getrieben, machte er seinen ersten Fehler. Dieses Ereignis wurde zum Wendepunkt in seinem Leben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150120
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150120,
					"content": "Was später in der Hütte des Einsiedlers geschah, war wohl ziemlich ähnlich ... selbst ein kleiner Streit konnte zu einem tödlichen Konflikt ausarten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150121
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150121,
					"content": "#{NICKNAME}, so einen gefährlichen Kerl können wir doch nicht einfach weiter machen lassen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150122,
						761150123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150122,
					"content": "Gib mir die Chance, ihn auszuschalten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150124
					]
				},
				{
					"id": 761150124,
					"content": "#Da sich {NICKNAME} freiwillig gemeldet hat, gönnen wir Jahoda mal eine Pause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150125
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150125,
					"content": "Ich hab doch vorher auch viel nachgeforscht! Sieh’s einfach als kleinen Urlaub für mich an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150126
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150126,
					"content": "Ob die Vermutung stimmt, sehen wir, sobald wir ihm gegenüberstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150123,
					"content": "Und wenn’s nur für die Belohnung ist, überlass ihn mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150124
					]
				}
			]
		},
