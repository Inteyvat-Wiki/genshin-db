			"dialogs": [
				{
					"id": 705430101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430102
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430102,
					"content": "... Miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430103
					],
					"speakerTitle": "„Grauball“"
				},
				{
					"id": 705430103,
					"content": "... Ihr seid es. Ich ... spreche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430104,
					"content": "Sprechen ... Sprichst du mit Grauball, Razor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430105,
					"content": "Miau, miau miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430106
					],
					"speakerTitle": "„Grauball“"
				},
				{
					"id": 705430106,
					"content": "Grauball will anscheinend sagen ... „das stimmt“, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430107,
					"content": "Schnuppert einen bekannten Duft, sucht Freunde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430108,
					"content": "Sehr gut, zufrieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430109
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430109,
					"content": "Miau, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430110
					],
					"speakerTitle": "„Grauball“"
				},
				{
					"id": 705430110,
					"content": "Der Duft zieht die Freunde an, du bist auch da, glücklich. Du duftest nach Wind und Regen, sehr vertraut ... Der Duft der Katze ... auch vertraut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430111
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430111,
					"content": "Paimon, süßer Duft. Gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430112
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430112,
					"content": "Hä!? Ob das der Duft von den Eierkuchen ist, die Valerina uns gegeben hat? Ha... hat Paimon so viel davon gegessen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430113,
						705430114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430113,
					"content": "Ich hab dir die Hälfte von meinem gegeben, erinnerst du dich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				},
				{
					"id": 705430115,
					"content": "Das war Paimon gar nicht aufgefallen ... Hach. Das kommt nur daher, weil die Eierkuchen so lecker sind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430116,
					"content": "Hehe, Paimon möchte auch süß mariniertes Hühnchen und Steak mit Kartoffelpuffern essen ... und dazu Apfelschorle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430117,
					"content": "#Dann steht das auf unserem Speiseplan! {NICKNAME}, los, lass uns zu Valerina gehen und bestellen! Razor, du kommst auch mit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430118,
					"content": "Danke ... Danke sehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430119
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430119,
					"content": "Grauball hat mir ganz viele ... Nüsse gebracht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430120
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430120,
					"content": "Und das Fleisch aus der Schachtel ... Ich bin ... satt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430121
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430121,
					"content": "Hört sich an, als hätte Fräulein Valerina es bestellt ... Sag bloß, Grauball hat das gelieferte Essen Razor mitgebracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430122,
					"content": "Miau miau, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430123
					],
					"speakerTitle": "„Grauball“"
				},
				{
					"id": 705430123,
					"content": "Paimon hat nicht geahnt, dass sich umgekehrt die Katzen hier im Flauschigen Katzenschloss um die Kunden kümmern würden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430124,
					"content": "Es scheint, Razor ist wirklich ein wahrer Katzenflüsterer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430114,
					"content": "Na ja, du kannst auch dreimal so viel verdrücken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				}
			]
		}
	]
}