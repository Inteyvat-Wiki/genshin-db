			"trigger": {
				"objectNames": [
					"Daimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722700101,
					"content": "Ich bin einer der letzten Jibashiri, Daimon. Recke von Sangonomiya, ich erkenne die Ehre deiner Herausforderung an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700102
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700102,
					"content": "Tapferkeit ist die Fähigkeit, alle Feinde mit allen Mitteln zu besiegen. Du musst nur alle deine Feinde besiegen und die „Flammen der hohen Pforte“ befreien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700103
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700103,
					"content": "Übrigens sind die Feinde hier alle imaginäre Bilder. Sie sind das Ergebnis des Zusammenspiels zwischen der Sonnenflammenillusion und dem Eindruck eines mächtigen Feindes, den man in sich selbst spürt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700104
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700104,
					"content": "Dennoch kann der kleinste Fehltritt zu Verletzungen oder sogar zum Zusammenbruch führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700105
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700105,
					"content": "Ich werde oben im Drei-Welten-Turm auf dich warten, bis du die Herausforderung gemeistert hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daimon"
				}
			]
		},
		{
			"id": 7227002,
