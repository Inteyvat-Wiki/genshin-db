			"dialogs": [
				{
					"id": 722700301,
					"content": "Sehr schön! Vernichte alle Feinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700302
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700302,
					"content": "Du bist so mutig, dass man dich als „einmalig in Tokoyo“ bezeichnen kann! Ich, einer der letzten der Jibashiri, Daimon, erkenne hiermit deine Tapferkeit an.",
					"roleType": "TALK_ROLE_NPC",
