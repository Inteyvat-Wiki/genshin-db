			"dialogs": [
				{
					"id": 722700201,
					"content": "Recke aus Sangonomiya, hast du die Herausforderung bereits gemeistert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700202
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700202,
					"content": "Wenn du Tapferkeit suchst, dann nutze alle Mittel, um alle Feinde zu besiegen, die sich dir in den Weg stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daimon"
				}
			]
		},
