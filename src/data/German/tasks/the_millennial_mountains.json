			"dialogs": [
				{
					"id": 710640802,
					"content": "Über den Kelch der netten Kameradschaft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640801
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640801,
					"content": "Über den „Kelch der netten Kameradschaft“? Ich habe gehört, dass er seine Würde wiedererlangen wird, selbst wenn er von Banditen erbeutet wird und zu einem niedrigen Gast an einer bescheidenen Tafel wird ... Aber was bedeutet das überhaupt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang"
				}
			]
		},
