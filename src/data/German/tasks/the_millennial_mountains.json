			"dialogs": [
				{
					"id": 710640702,
					"content": "Über die Sonnenuhr der langen Jahre ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640701
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640701,
					"content": "Es heißt, dass die „Sonnenuhr der langen Jahre“ allen Menschen auf der Welt in Erinnerung bleiben wird und ihren Glanz nicht verliert, auch wenn sie eine Zeit lang einsam bleibt ... Vielleicht ist sie nie verloren gegangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang"
				}
			]
		},
