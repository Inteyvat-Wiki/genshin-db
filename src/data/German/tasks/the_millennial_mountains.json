			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640201,
					"content": "(Eine kleine Steintafel mit der folgenden Inschrift ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640202
					],
					"speakerTitle": "Steintafel"
				},
				{
					"id": 710640202,
					"content": "... „Die Schlacht von der Großen Kluft hat mich mit allen Gliedmaßen gelähmt, sodass ich es diktieren, aufzeichnen und hier eingravieren lassen musste.“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640203
					],
					"speakerTitle": "Steintafel"
				},
				{
					"id": 710640203,
					"content": "... „Obwohl ich die Schlacht überlebt habe, kann ich keine Nacht schlafen, wenn ich an meine gefallenen Kameraden denke. Ich hasse es, dass ich nicht mit euch allen gehen konnte.“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640204
					],
					"speakerTitle": "Steintafel"
				},
				{
					"id": 710640204,
					"content": "... „Als Rex Lapis dies hörte, tadelte er ihn, und er kam zur Vernunft.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640205
					],
					"speakerTitle": "Steintafel"
				},
				{
					"id": 710640205,
					"content": "... „Rex Lapis war so freundlich, die Rüstung der Millelithen zurückzugeben, aber ich dachte, ich könnte mich nicht revanchieren, also habe ich sie hier gelassen, damit sie von jemandem genommen wird, der mein Schicksal teilt.“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640206
					],
					"speakerTitle": "Steintafel"
				},
				{
					"id": 710640206,
					"content": "... „Meine Herrschaften, in diesem Leben war es uns nicht vergönnt, also lasst uns im nächsten Leben wieder Gefährten sein, und dann werden wir gemeinsam einen Becher Wein trinken und gegen die Feinde von Liyue kämpfen.“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Steintafel"
				}
			]
		},
		{
			"id": 7106403,
			"completionStepIds": [
				7106411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106411",
							"2"
						],
						"stepId": 7106411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640301,
					"content": "Ich hätte nie gedacht, dass du ihn finden würdest ... Ist das der „Schatz der Millelithen“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640302
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640302,
					"content": "Ich weiß nicht, was sich darin befindet, aber ... ich fürchte, die Millelithen, die diesen Schatz damals zurückgelassen haben, sind ebenfalls sehr erfreut, dass du ihn gefunden hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640303
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640303,
					"content": "Fünfhundert Jahre sind seit dieser Katastrophe vergangen ... Wenn ich daran denke, dass dieser Ort einst Schauplatz einer so heftigen Schlacht war, in der sich unzählige unserer Vorfahren geopfert haben, komme ich nicht umhin, mich zu wundern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640304
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640304,
					"content": "Hat einer der Menschen, die an der Seite des Herrschers über die Felsen in die Schlacht zogen, gedacht, dass sich die Menschen über die Jahrhunderte hinweg an sie erinnern würden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640305
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640305,
					"content": "Haben sie jemals an ihren Pflichten gezweifelt oder diese vernachlässigt? Und wie konnten diejenigen, die nie ein Göttliches Auge erlangten, einem Gott treu bleiben, der ihnen nie seine Gunst schenkte, selbst bis zum Tod?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640306,
						710640307
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640306,
					"content": "Ihr Gott wich nie von ihrer Seite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				},
				{
					"id": 710640308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640309
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640309,
					"content": "Ja, du hast recht. Die mit Göttlichen Augen, die ohne ... Wir alle arbeiten auf eine Zukunft mit grenzenlosem Potenzial hin. Ich meine, das nennt man Motivation, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640310
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640310,
					"content": "Wir sind alle gleich. Wir sind nicht wegen der guten Zeiten in der Vergangenheit oder wegen einer Selbstverwirklichung in der Gegenwart hier ... Aber wir tun dies, um uns gegenseitig dabei zu unterstützen, etwas von uns selbst in den Zeiten, in denen wir leben, zurückzulassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640311
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640311,
					"content": "Vielleicht wird die Große Kluft eines fernen Tages auch zu unserem Gedenkstein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640314
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640314,
					"content": "Die Gruben und Täler, der Schweiß von Generationen von Bergleuten ... Sie alle zeugen von dem harten Weg, den wir gewählt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640312
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640312,
					"content": "Genau wie dieser Gedenkstein wird dieser Ort auch in hundert oder sogar tausend Jahren noch da sein, als Zeugnis dafür, dass die Opfer, die hier gebracht wurden, nicht umsonst waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640313
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640313,
					"content": "Hehe, das werde ich natürlich nicht mehr erleben, aber wenn eines Tages jemand hierher kommt, um auf uns arme Bergleute anzustoßen, lange nachdem wir weg sind, wäre das mehr als genug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640307,
					"content": "Sie waren auch ihren eigenen Entscheidungen treu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				}
			]
		},
