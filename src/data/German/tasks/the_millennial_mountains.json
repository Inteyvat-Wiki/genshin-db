			"dialogs": [
				{
					"id": 710640401,
					"content": "Die Opfergaben sind der „Helm“, die „Feder“, der „Kelch“, die „Sonnenuhr“, die „Blüte“ und die „Lanze“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640402
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640402,
					"content": "Aber bis zum heutigen Tag hat niemand sie alle gefunden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang"
				}
			]
		},
