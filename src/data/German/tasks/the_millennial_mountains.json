			"dialogs": [
				{
					"id": 710640602,
					"content": "Über die Feder des hohen Himmels ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640601
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640601,
					"content": "Ich habe gehört, dass man die „Feder des hohen Himmels“ nur von einem fliegenden Falken auf einem Berggipfel erhalten kann. Aber in meinem ganzen Leben habe ich noch niemanden gesehen, der imstande war, einem Falken die Federn auszurupfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang"
				}
			]
		},
