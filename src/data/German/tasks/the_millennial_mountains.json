			"dialogs": [
				{
					"id": 710640502,
					"content": "Über die Blume des fernen Blicks ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640501
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640501,
					"content": "Ich habe gehört, dass die Blume des fernen Blicks nur mit den scheinbar verrückten, aber tatsächlich ehrgeizigen Begierden verkehrt, weshalb sie so weit von den Sterblichen entfernt ist ... hm ... Was für eine Blume könnte das sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang"
				}
			]
		},
