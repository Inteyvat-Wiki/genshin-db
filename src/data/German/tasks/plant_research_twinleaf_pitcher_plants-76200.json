			"dialogs": [
				{
					"id": 762000201,
					"content": "Junge Dame, darf ich dich kurz stören? Ich wollte fragen, ob du hier in der Nähe eine Tigerstreifenkatze gesehen hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000202
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000202,
					"content": "Eine Tigerstreifenkatze? Ich glaube nicht. Hast du eine gesehen, Lumi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000203
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000203,
					"content": "Jaho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000204
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 762000204,
					"content": "Lumi hat wohl auch keine Ahnung ... Habt ihr eure Katze verloren? Ich kann helfen, sie zu suchen! Ich kenne mich in der Umgebung hier ganz gut aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000205
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000205,
					"content": "He, Jukka! Wir haben doch gar kein Geld übrig, um Abenteurer anzuheuern. Außerdem ist das nur eine blöde Katze. Im schlimmsten Fall haben wir eben keine mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000206
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000206,
					"content": "Marja, sag so etwas nicht. Wenn sie das hört, wird sie traurig sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000207
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000207,
					"content": "Sie kann uns doch gar nicht hören! Wenn sie das könnte, hätte sie uns nach dem ganzen Rufen ja geantwortet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000208
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000208,
					"content": "Für so eine Kleinigkeit braucht ihr keine Auftragsgebühr zu zahlen. Außerdem wollte ich in der Nähe sowieso gerade einige Untersuchungen anstellen, also erledige ich das einfach nebenbei. Gehen wir, Lumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000209
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000209,
					"content": "(Vor Kurzem war hier noch gar nichts, aber jetzt wachsen hier plötzlich so viele Doppelblatt-Kannenpflanzen ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000210
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000210,
					"content": "(Vielleicht hat ein Tier die Samen der Doppelblatt-Kannenpflanze hergebracht, aber einfach so wuchern lassen kann ich sie nicht ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
