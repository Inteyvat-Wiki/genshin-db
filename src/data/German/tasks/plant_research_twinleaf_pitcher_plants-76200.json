			},
			"dialogs": [
				{
					"id": 762000501,
					"content": "Lumi, glaubst du auch, dass sie genau hier ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000502
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000502,
					"content": "Ja-hoho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000503
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 762000503,
					"content": "Ich habe die gefangene Tigerstreifenkatze gerettet ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762000504
					]
				},
				{
					"id": 762000504,
					"content": "Du bist es also, die sie suchen, was? Äußerlich scheinst du unverletzt zu sein, aber wenn wir später gekommen wären ... wer weiß, was passiert wäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000505
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000505,
					"content": "Wie auch immer, suchen wir erst mal deinen Gefährten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
