			},
			"dialogs": [
				{
					"id": 762000801,
					"content": "Dumme Katze ... wo steckt sie nur ... Huch? Du hast sie gefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000802
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000802,
					"content": "Sie steckt bei der Doppelblatt-Kannenpflanze da drüben fest. Das ist zwar eine Pflanze, aber ein fleischfressendes Ungetüm. Die Verdauung eines Mondschein-Glühwürmchens dauert nur ein paar Tage ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000803
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000803,
					"content": "Zum Glück haben wir sie rechtzeitig entdeckt. Sie ist nur ein wenig geschwächt. Wären wir später gekommen, wäre es wohl zu spät gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000804
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000804,
					"content": "So gefährlich ist das also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000805
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000805,
					"content": "Sie ist doch selbst schuld, dass sie da reingekrochen ist ... Was für eine dumme Katze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000806
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000806,
					"content": "Fairerweise kann man ihr keinen Vorwurf machen. Die Doppelblatt-Kannenpflanze verströmt einen speziellen Geruch. Auf Menschen hat er keine Wirkung, aber Insekten und Ähnliches werden davon angezogen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000807
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000807,
					"content": "Genauso jagen Doppelblatt-Kannenpflanzen. Hier gibt es ungewöhnlich viele von ihnen, was sogar Einfluss auf kleine Tiere hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000808
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000808,
					"content": "Oh ... Oh, jedenfalls ist es bestimmt nichts Gutes, dass diese Pflanzen so seltsam wuchern, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000809
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000809,
					"content": "Hm, wenn wir nichts dagegen tun, könnte das gefährlich werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000810
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000810,
					"content": "Alles klar, überlass uns das Jäten. Jukka, du hilfst auch mit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000811
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000811,
					"content": "Dem Fiesling, der der blöden Katze so lange das Leben schwer gemacht hat, müssen wir es ordentlich heimzahlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000812
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000812,
					"content": "Zusammen mit zwei Schatzjägern habt ihr die in dieser Gegend ungewöhnlich wuchernden Doppelblatt-Kannenpflanzen beseitigt ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762000813
					]
				},
				{
					"id": 762000813,
					"content": "Puh – endlich ist es zu Ende. Wir sollten auch zurück nach Nasha ... Danke, Kleines, dass du uns bei der Suche nach dieser blöden Katze geholfen hast. Ohne dich hätte sie ewig festgesessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000814
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000814,
					"content": "Aber wenn ich so darüber nachdenke: Wenn Marja vorhin nicht so laut geschrien hätte, hätten wir sie vielleicht schon viel früher gefunden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000815
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000815,
					"content": "Halt ... Halt doch den Mund! Jedenfalls ist sie jetzt wohlbehalten zurück, ist das nicht genug?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000816
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000816,
					"content": "(Obwohl sie sie ständig „blöde Katze“ nennt, sorgt sie sich doch sehr um ihre Kameradin.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000817
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000817,
					"content": "Ja, die Hauptsache ist, dass es ihr gut geht. Die Wildnis ist gefährlich. Passt gut auf euch auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000818
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000818,
					"content": "Danke dir, das werden wir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000819
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000819,
					"content": "Ich wünsche dir auch viel Erfolg bei deinen Forschungsuntersuchungen. Bis dann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marja"
				}
			]
		},
