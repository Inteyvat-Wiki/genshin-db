					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140201,
					"content": "Gibt es noch etwas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 708140202,
					"content": "Hast du deinen Einhänder gefunden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140203
					]
				},
				{
					"id": 708140203,
					"content": "...Huh, dass du dich noch daran erinnern kannst. Unglücklicherweise nicht, nein. Ich habe immer noch keinen blassen Schimmer, wo es sein könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140204
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 708140204,
					"content": "Ich scheint, als sei ich noch am Anfang und würde darauf warten, dass etwas passiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140205
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 708140205,
					"content": "Wenn irgendetwas zu diesem Thema auftaucht, werde ich vielleicht nach dir suchen. Wenn das geschieht, werde ich auf dich zählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140206
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 7081403,
			"completionStepIds": [
				7081401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7081401",
							"2"
						],
						"stepId": 7081401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140301,
					"content": "B - Bist du ein Abenteurer? Bist du hier, um Aufträge anzunehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140302
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140302,
					"content": "Äh, bitte ... warte einen Moment, lass mich sehen, was ich hier habe ... „Tempo-Gleiter“, „Überlebensführer für draußen“, „Freikletterlehrer gesucht“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140303
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140303,
					"content": "Das klingt nicht gerade nach der Abenteurergilde ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140304
					]
				},
				{
					"id": 708140304,
					"content": "Ich weiß. Und Lan sagt das gleiche! Aber die Abenteuer, über die ich in Büchern gelesen habe, waren alle so ähnlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140305
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140305,
					"content": "Wenn ich diese Aufträge nicht vergebe, was sollte ich dann vergeben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140306
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140306,
					"content": "Vielleicht etwas wie „vermöble Monster“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140307
					]
				},
				{
					"id": 708140307,
					"content": "Ist ... ist das nicht gefährlich? Ich meine, es gibt viele von ihnen in der Nähe von Lisha und sie sind eine Gefahr für Passanten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140308
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140308,
					"content": "Aber normale Leute haben keine Chance gegen sie. Sie könnten dabei sogar verletzt werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140309,
						708140311
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140309,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140310
					]
				},
				{
					"id": 708140310,
					"content": "Kannst du wirklich? Na ja ... Gut, dann überlasse ich es deinen Händen. Ich gehe zurück und bespreche die passende Zahlung für deine Dienste mit Lan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140311,
					"content": "Abenteurer sind alles außer gewöhnlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140312
					]
				},
				{
					"id": 708140312,
					"content": "Ist das so ... N... na ja, dann lasse ich dich es erledigen. Ich werde deine Bezahlung später mit Lan besprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
		{
			"id": 7081404,
