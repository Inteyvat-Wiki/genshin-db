					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140701,
					"content": "Hast du die Aufträge abgeschlossen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140702
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140702,
					"content": "Na klar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140703
					]
				},
				{
					"id": 708140703,
					"content": "Oh ... Das ist also die Stärke eines Abenteurers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140704
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140704,
					"content": "Mmh, kannst du vielleicht, wenn du nichts dagegen hast, einige Fragen von mir zu Abenteurern und Aufträgen beantworten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140705
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140705,
					"content": "Welche anderen Aufträge, außer Monster zu besiegen, nehmen Abenteurer an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140706,
						708140707,
						708140708
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140706,
					"content": "Wir helfen Menschen auch, Karren und Häuser zu reparieren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140709
					]
				},
				{
					"id": 708140709,
					"content": "Oha, heißt das nicht einfach, dass ihr Abenteurer alles macht? Hätte ich nicht gedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140710
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140710,
					"content": "Danke! Das werde ich mir sicherlich merken ... Ah ja, richtig. Hier ist deine Rückzahlung, bitte nimm sie. Sie ist so großzügig wie es geht, weißt du.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140711
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140711,
					"content": "Das nächste Mal, wenn du Aufträge von mir annimmst, sorge ich dafür, dass du die Besten kriegst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140707,
					"content": "Wir helfen Menschen dabei, Blumen zu pflücken und Fische zu fangen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140709
					]
				},
				{
					"id": 708140708,
					"content": "Wir liefern Essen und spielen mit Kindern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140709
					]
				}
			]
		}
	]
}