			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140501,
					"content": "Äh? Du bist schon zurück? Hast du den Auftrag abgeschlossen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140502
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140502,
					"content": "Erledigt, und erledigt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140503
					]
				},
				{
					"id": 708140503,
					"content": "Dass ist ... wirklich beeindruckend. Ich bin zur Gilde zurückgegangen, um unsere Aufträge basierend auf dem, den ich dir gegeben habe, neu zu organisieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140504
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140504,
					"content": "Es gab einen ganzen Berg an Aufträgen zum Besiegen von Monstern. Abenteurer machen solche Dinge also die ganze Zeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140505
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140505,
					"content": "Aber außer zu Monstern gab es Berichte, dass Schatzräuber auf den Straßen gesichtet wurden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140506
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140506,
					"content": "Ist es also wirklich etwas, was die Abenteurergilde tun sollte? Es scheint, als würde dies eher in das Aufgabenportfolio der Millelithen passen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140507,
						708140509
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140507,
					"content": "Wir können es übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140508
					]
				},
				{
					"id": 708140508,
					"content": "Was? Abenteurer können wohl wirklich alles machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140511,
					"content": "Na ja, dann werde ich mal eine angemessene Entlohnung für dich vorbereiten. Also nimm diesen Auftrag bitte auch an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140512
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140512,
					"content": "Was, schon wieder einer? Wir haben noch nicht unsere ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708140513,
					"content": "Es wird mehr Vergütung geben! Ich habe das schon mit Lan besprochen. Solange du also den nächsten Auftrag erfüllst, wirst du weiter bezahlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140514
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140514,
					"content": "Na, das klingt doch schon besser.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140515
					]
				},
				{
					"id": 708140515,
					"content": "Ich zähle auf dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140516
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140516,
					"content": "Na, das sind zwei erledigte Aufträge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140517
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140517,
					"content": "Die geheime Methode von Lan, „Abenteurer dazu zu bringen, Aufträge gern anzunehmen“, funktioniert wirklich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140509,
					"content": "Wenn die Bezahlung stimmt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140510
					]
				},
				{
					"id": 708140510,
					"content": "Abenteurer sind wirklich eindrucksvoll ... Es scheint, als könntest du fast alles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "Tiantian"
				}
			]
		},
