			"dialogs": [
				{
					"id": 708140401,
					"content": "Machen alle Abenteurer diese gefährlichen Dinge?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140402
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140402,
					"content": "Aber was, wenn sie verletzt werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
		{
			"id": 7081405,
			"completionStepIds": [
