			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Glory"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360201,
					"content": "Du bist zurück! Hast du die Löwenzahnsamen gesammelt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360202
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360202,
					"content": "Ja, ich habe sie bei mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360203
					]
				},
				{
					"id": 200360203,
					"content": "Danke! Kannst du die Samen auf meine Handfläche legen? Ich sehe sie ja nicht und habe Angst, dass ich sie verliere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360204
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360204,
					"content": "Sind das genug?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360205
					]
				},
				{
					"id": 200360205,
					"content": "Lege sie auf meine Handfläche. Erst dann kann ich sie fühlen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360206
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360206,
					"content": "Ja, das sind genug. Ich möchte ihnen alles sagen, was sie an Godwin übermitteln sollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360207
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360207,
					"content": "Ähm, würdest du bitte deine Ohren zuhalten? Das geht nur mich und meinen Liebsten etwas an. Aber du wirst sicher auch schon eine solche Erfahrung gemacht haben, hihi ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360208
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360208,
					"content": "Fertig. Bringe die Löwenzahnsamen jetzt bitte nach oben auf die Statue des Windgottes und lass sie von dort aus fliegen. Der Gott wird sich persönlich darum kümmern, sie an ihr Ziel zu bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360209
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360209,
					"content": "Möge der Gott des Windes sie zu Godwin bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		},
		{
			"id": 2003603,
			"completionStepIds": [
				2003606
