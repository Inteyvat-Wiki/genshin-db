			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Glory"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360101,
					"content": "Godwin, was treibst du nur so lange?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360102
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360102,
					"content": "Hallo ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360103
					]
				},
				{
					"id": 200360103,
					"content": "#Diese Stimme ... Wenn das nicht {F#die}{M#der} Reisende ist! Dem Gott des Windes sei Dank! Seine Winde müssen dich hergebracht haben. Bitte, höre dir an, was ich zu sagen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360104
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360104,
					"content": "Also ... mein Freund, Godwin, ist Ritter des Ordo Favonius und hat Mondstadt schon vor langer Zeit verlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360105
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360105,
					"content": "Ich habe so lange nichts mehr von ihm gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360106
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360106,
					"content": "Ich mache mir Sorgen um Godwin. Er muss gegen diese gemeinen Hilichurle und den Orden des Abgrunds – von dem hat er mir erzählt – kämpfen. Was ist, wenn er verletzt ist? Außerdem ist er schon so lange fort. Vielleicht ist er ja längst auf einer seiner Missionen einer hübschen Dame begegnet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360107
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360107,
					"content": "Oh, es tut mir leid! Ich rede immer zu viel! Meine Mutter sagt immer, dass der Löwenzahn die Gedanken der Menschen an weit entfernte Orte tragen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360108
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360108,
					"content": "Deshalb bitte ich dich nun ... Würdest du mir drei Löwenzahnsamen auf dem Windstieg sammeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360109,
						200360110
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360109,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360111
					]
				},
				{
					"id": 200360111,
					"content": "Danke dir! Möge der Gott des Windes dich segnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360110,
					"content": "Ich habe noch zu tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360112
					]
				},
				{
					"id": 200360112,
					"content": "#Warte bitte! Ich flehe dich an! Für eine{F# Reisende}{M#n Reisenden} wie dich muss das doch ein Kinderspiel sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		},
		{
			"id": 2003602,
			"completionStepIds": [
				2003604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
