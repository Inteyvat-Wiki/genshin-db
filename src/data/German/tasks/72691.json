			"dialogs": [
				{
					"id": 726910201,
					"content": "Ah, du bist es. Bist du mit den Fotos fertig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910202
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910202,
					"content": "Noch nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910203
					]
				},
				{
					"id": 726910203,
					"content": "Denke daran, dass du nur <color=#00E1FFFF>vier</color> Fotos von regionalen Besonderheiten aus Inazuma machen musst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
		{
			"id": 7269103,
