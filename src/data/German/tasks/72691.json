			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ootomo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726910101,
					"content": "#{F#Junge Frau}{M#Junger Mann}, ich sehe, dass du schon seit einiger Zeit in dieser Gegend hin und her läufst. Ich glaube, du musst jemand sein, der die Eleganz der Künste zu schätzen weiß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910102
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910102,
					"content": "Es gibt eine Frage der Eleganz, bei der ich deine Hilfe brauche. Könntest du mir dabei helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910103
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910103,
					"content": "Bitte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910104
					]
				},
				{
					"id": 726910104,
					"content": "Obwohl ich diesen Mann, Lenne, den Barden von Mondstadt, gerade erst hier kennengelernt habe, sind wir schon schnell Freunde geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910105
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910105,
					"content": "Ootomo hat recht. Wir kennen uns erst seit ein paar Tagen, aber ich habe schon den größten Respekt vor seinem großen Wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910106
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910106,
					"content": "Hehe, du bist echt zu nett, Lenne. Auf jeden Fall haben wir uns durch die Poesie angefreundet und nutzen die Gelegenheit, ein paar gemeinsame Werke zu schreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910107
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910107,
					"content": "Und da Lenne die ganze Mühe auf sich genommen hat, um nach Inazuma zu kommen, möchte er wirklich ein bisschen von diesem Inazuma-Stil in seine Arbeit einbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910108
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910108,
					"content": "In der Tat. Leider war mein Reiseplan viel zu eng gefasst. Ich hatte keine Zeit, mir die Sehenswürdigkeiten anzuschauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910109
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910109,
					"content": "Also, was kann ich für dich tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910110
					]
				},
				{
					"id": 726910110,
					"content": "Hör zu, das Thema des Gedichts, das ich schreiben möchte, ist „Heimweh“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910111
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910111,
					"content": "Wenn ein Reisender die Landschaften in einem fernen Land sieht, kann er nicht anders, als sich an sein eigenes Land zu erinnern. Deshalb möchte ich einige Elemente in mein Gedicht einbauen, die diesen fernen Ort symbolisieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910112
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910112,
					"content": "Kannst du mir helfen, ein paar Fotos zu machen, von denen ich mich inspirieren lassen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910113
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910113,
					"content": "Inazuma sollte eine große Anzahl von einzigartigen Sehenswürdigkeiten haben, oder? Wenn du zum Beispiel von Mondstadt sprichst, denkt jeder sofort an Löwenzahn oder Windmühlenastern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910114
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910114,
					"content": "Oh, jetzt hat Paimon es verstanden. Wenn das so ist, lass uns ein paar Fotos von Inazumas regionalen Besonderheiten machen! Damit wird es gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726910115,
					"content": "In der Tat, ich würde in eurer Schuld stehen! Erlaubt mir auch, eine Kopie meines halbfertigen Gedichts zu schreiben, nur damit ihr es als Referenzmaterial verwenden könnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910116
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910116,
					"content": "Was die Anzahl der Bilder angeht, die ich brauche, denke ich, dass <color=#00E1FFFF>vier</color>, die jeweils unterschiedliche Inhalte zeigen, ausreichen. Ich übernehme auch alle Reisekosten, die euch dabei entstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910117
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910117,
					"content": "#Nun, {NICKNAME}, da Lennes Wunsch klar zu sein scheint, lass uns sofort aufbrechen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
