			"dialogs": [
				{
					"id": 726910301,
					"content": "Ah, du bist es. Bist du mit den Fotos fertig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910302
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910302,
					"content": "Ich habe sie aufgenommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910303
					]
				},
				{
					"id": 726910303,
					"content": "Wunderbar! Du hast meinen Dank. Lass mich mal gucken ... Herrje, so etwas habe ich noch nie gesehen! ... Und ach, dieses Bild ist wunderbar! Das hier scheint auch sehr bemerkenswert zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910304
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910304,
					"content": "#{M#Mein Lieber}{F#Meine Liebe}, deine Fotos sind eine echte Inspiration! Vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910305
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910305,
					"content": "Ich habe versucht, verschiedene Strophen in Anlehnung an die Bilder zu schreiben, die du mir zur Verfügung gestellt hast. Ich bin ziemlich hin- und hergerissen, welche ich verwenden soll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910306
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910306,
					"content": "Ich bin echt ziemlich neugierig. Wenn du es wärst, welche würdest du verwenden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
