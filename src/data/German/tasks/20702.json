			"dialogs": [
				{
					"id": 207020101,
					"content": "Wie gehts dir, Ehrenritter? Hast du das Handbuch des Ordo Favonius sorgfältig gelesen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207020102
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 207020102,
					"content": "Wie beim letzten Mal habe ich hier einige Fragen an dich. Diese Fragen decken einige Inhalte des Handbuchs ab, aber auch Fragen zum gesunden Menschenverstand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207020103
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 207020103,
					"content": "Je nachdem, wie ihr die Prüfung abschließt, werdet ihr auch noch ein Belohnungsgeschenk von mir erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Swan"
				}
			]
		},
