						],
						"pointId": 311400056
					}
				]
			},
			"dialogs": [
				{
					"id": 700500501,
					"content": "... Siehst du. Paimon sagte doch, es ist nur ein gewöhnliches Kätzchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500502,
					"content": "Ist das so ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500503
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500503,
					"content": "Miau? Miau ... Miau, miau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500504,
						700500506
					],
					"speakerTitle": "Verwirrtes Kätzchen"
				},
				{
					"id": 700500504,
					"content": "Entschuldigung, hast du schon einmal von Xuanwen-Bestien gehört?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500505
					]
				},
				{
					"id": 700500505,
					"content": "Miau ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "Verwirrtes Kätzchen"
				},
				{
					"id": 700500508,
					"content": "Das Kätzchen dreht sich um und läuft ratlos weg ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500509
					]
				},
				{
					"id": 700500509,
					"content": "Trotzdem ... Meinst du, dieses Kätzchen könnte das Junge von einer Xuanwen-Bestie sein? Sie versteckt sich so lange in Qiaoying, bis sie ausgewachsen ist und fegt dann alle Teebäume mit einem Streich weg ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500510
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500510,
					"content": "Fräulein Guijarro, du schon wieder ... Ich sagte dir bereits, dass Xuanwen-Bestien nicht solche sanftmütigen Geschöpfe sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500511
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500511,
					"content": "Ah, Fräulein Hung Fan! Das trifft sich gut. Was führt dich hierher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500512
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500512,
					"content": "Hach ... Bitte sprich bei uns hier nicht ständig von Kriminalgeschichten. Was, wenn die Kinder sie für echt halten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500513
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500513,
					"content": "Kennt ihr euch?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500514
					]
				},
				{
					"id": 700500514,
					"content": "Ja. Als ich hier ankam, bat ich diese junge Dame, mir mit meinem Gepäck zu helfen. Ich befragte sie auch ausführlich zu allen Dingen, die mit der örtlichen Folklore zusammenhängen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500515
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500515,
					"content": "Ich habe schon hundertmal gesagt, dass Xuanwen-Bestien nicht im Dorf auftauchen werden. Aber Fräulein Guijarro will mir einfach nicht glauben, und redet stattdessen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500516
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500516,
					"content": "Auch wenn sie nicht auftauchen, gibt es andere Methoden, Informationen über sie zu sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500517
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500517,
					"content": "Da geht es wieder los ... *seufz* Fräulein Guijarro, ich kann dich nicht davon abhalten, aber mein Rat ist, dass du dich auf keinen Fall außerhalb des Dorfs herumtreiben solltest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500518
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500518,
					"content": "Die Xuanwen-Bestien sind wirklich existierende wilde Tiere ... *seufz* Bitte verlasse auf gar keinen Fall allein das Dorf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500519
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500519,
					"content": "Hung Fan geht fort. Sie wirkt noch erschöpfter als das Kätzchen von vorhin ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500520
					]
				},
				{
					"id": 700500520,
					"content": "Na gut, wenn Fräulein Hung Fan das sagt, müssen wir eben woanders nach dem Material suchen gehen. Los, folgt mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500506,
					"content": "Tut mir leid, wir suchen eigentlich nach jemand anderem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500507
					]
				},
				{
					"id": 700500507,
					"content": "Miau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "Verwirrtes Kätzchen"
				}
			]
		},
		{
			"id": 7005006,
			"completionStepIds": [
				7005006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7005006",
							"2"
						],
						"stepId": 7005006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guijarro"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2276.275,
							287.313,
							1542.857
						],
						"pointId": 311400058
					}
				]
			},
			"dialogs": [
				{
					"id": 700500601,
					"content": "Was hältst du von diesem ... ähm ... diesem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500602
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500602,
					"content": "Teekessel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500603
					]
				},
				{
					"id": 700500603,
					"content": "Ganz genau! Dieser Tee ... Kessel? Jedenfalls ... Das ist schon ein ausgefallenes Teil! Außerdem steht er mitten im Dorf, er muss also eine besondere Bedeutung haben, wenn du mich fragst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500604
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500604,
					"content": "Hm ... Sagt mal, was, wenn sich die Xuanwen-Bestie die ganze Zeit über da drin versteckt hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500605,
						700500606
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500605,
					"content": "Dann würdest du eher eine Fantasiegeschichte schreiben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				},
				{
					"id": 700500607,
					"content": "Und als Nächstes würdest du wohl auch Adepten und ähnliche Elemente in den Roman aufnehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500608,
					"content": "Ich weiß nicht, ob sich dieses Sujet für einen Kriminalroman eignet ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500609
					]
				},
				{
					"id": 700500609,
					"content": "... Hmm, ihr macht wirklich interessante Gesichtsausdrücke. Denkt ihr vielleicht, ein Kriminalroman, der sich um eine Xuanwen-Bestie dreht, wäre zu absurd, um ernst genommen zu werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500610
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500610,
					"content": "Also, ähm ... ja, schon? Jedenfalls kann man mit so einem Thema doch nicht die Handlung in einem Krimi vorantreiben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500611,
					"content": "Warte. Sag bloß, du ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500612
					]
				},
				{
					"id": 700500612,
					"content": "#Haha, wie scharfsinnig, {NICKNAME}! Du wirst deinem Ruhm wirklich gerecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500613
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500613,
					"content": "Genau! Ich möchte gerade ein Buch über einen Kriminalfall schreiben, der „so absurd ist, dass er nicht geschehen kann“. Die Reaktionen von Fräulein Hung Fan und euch sind wirklich bemerkenswert. Ich werde sie in den Roman aufnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500614
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500614,
					"content": "Was die Xuanwen-Bestie angeht ... Sie wird mein „Übeltäter“ sein. Ein Geschöpf, das der Legende nach die Bösewichte aus dem Dorf verschlingt, das aber niemand je zu Gesicht bekam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500615
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500615,
					"content": "An einem Feiertag wird ein Dorfbewohner tot in der Wildnis aufgefunden. Offenbar durch den Angriff eines wilden Tieres ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500616
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500616,
					"content": "Doch am nächsten Tag, auf den Feierlichkeiten, trifft die Hauptfigur auf das Opfer, das eigentlich schon tot sein sollte, woraufhin eine weitere Leiche gefunden wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500617
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500617,
					"content": "Und dann? Und dann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500618,
					"content": "Das habe ich mir noch nicht überlegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500619
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500619,
					"content": "... Ich muss jetzt los.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500620
					]
				},
				{
					"id": 700500620,
					"content": "Ach, komm schon! Sobald ich fertig bin, sende ich euch beiden signierte Exemplare. Eigentlich möchte ich euch noch um einen großen Gefallen bitten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500621
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500621,
					"content": "Fräulein Hung Fan sagte, ich darf auf keinen Fall das Dorf alleine verlassen, richtig? Diesen Rat werde ich unbedingt befolgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500622
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500622,
					"content": "Und jetzt, wo ihr hier seid ... bin ich nicht mehr „allein“! Das heißt, ich kann mich endlich außerhalb des Dorfs umschauen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500623
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500623,
					"content": "Selbstverständlich werde ich nicht allzu weit gehen! Also, wollt ihr mir helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500624,
						700500625
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500624,
					"content": "Na gut ... Damit du deine Geschichte beenden kannst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500627
					]
				},
				{
					"id": 700500627,
					"content": "Also, dann. Gehen wir dorthin. Es gibt da einen Ort, den ich mir ansehen möchte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500625,
					"content": "Die Bezahlung muss aber nach den allgemeinen Regeln erfolgen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500626
					]
				},
				{
					"id": 700500626,
					"content": "Natürlich. Keine Sorge!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500627
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500606,
					"content": "Dann wäre es wohl keine Kriminalgeschichte mehr ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				}
			]
		},
		{
