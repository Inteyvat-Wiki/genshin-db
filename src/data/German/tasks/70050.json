						],
						"pointId": 311400065
					}
				]
			},
			"dialogs": [
				{
					"id": 700501501,
					"content": "... In diesem Zustand sollte die Figur nicht allein ins Dorf zurückkommen können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501502
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501502,
					"content": "Fräulein Guijarro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501503,
					"content": "Helfen wir ihr zuerst auf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501504
					]
				},
				{
					"id": 700501504,
					"content": "Ihr helft Guijarro auf, sodass sie stabil auf dem Boden sitzt ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501505
					]
				},
				{
					"id": 700501505,
					"content": "So fühlt es sich also an ... Es ist wirklich anstrengend. Ich fühle mich nicht nur körperlich erschöpft, auch mein Geist ist schwerfällig geworden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501506
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501506,
					"content": "Das heißt, du hast deine Inspirationen erfolgreich gesammelt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501507
					]
				},
				{
					"id": 700501507,
					"content": "Natürlich, sehr erfolgreich. Endlich weiß ich, wie es sich anfühlt, eine Nacht lang in der Wildnis gefesselt zu verbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501508
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501508,
					"content": "Deine Hauptfigur ist ziemlich hart im Nehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501509,
					"content": "Das stimmt. Ich habe mir auch eine Methode überlegt, wie die Hauptfigur die Xuanwen-Bestie fortjagen kann. Wenn die Geschichte mit diesem Trick endet, wäre das bestimmt ... bestimmt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501510
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501510,
					"content": "Ooh! Was gibt es denn für einen großartigen Trick?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501511,
					"content": "Bestimmt ... beeindruckend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501512
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501512,
					"content": "Guijarro fällt wieder in Ohnmacht ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501513
					]
				},
