						],
						"stepId": 7005010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2228.768,
							286.695,
							1534.213
						],
						"pointId": 311400066
					}
				]
			},
			"dialogs": [
				{
					"id": 700501001,
					"content": "Ah? Wohin ist denn Fräulein Guijarro gegangen? Gerade war sie noch hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501002,
						700501003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501002,
					"content": "Wahrscheinlich wurde sie von einer Xuanwen-Bestie entführt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501004
					]
				},
				{
					"id": 700501004,
					"content": "Sag doch nicht so furchtbare Dinge! Sie ist bestimmt irgendwo hingerannt, während sie mit den Gedanken bei der Handlung des Romans war. Lass uns in der Umgebung nach ihr suchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501005,
					"content": "Die Teefelder dort sind recht hoch gelegen. Lass uns da mit dem Suchen beginnen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501006
					]
				},
				{
					"id": 700501006,
					"content": "Gute Idee! Beginnen wir unsere Suche von einem erhöhten Punkt aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501003,
					"content": "Ob sich ihr Roman bewahrheitet hat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501004
					]
				}
			]
		},
		{
			"id": 7005012,
			"completionStepIds": [
				7005012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7005012",
							"2"
						],
						"stepId": 7005012,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guijarro"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2304.876,
							292.814,
							1561.417
						],
						"pointId": 311400064
					}
				]
			},
			"dialogs": [
				{
					"id": 700501201,
					"content": "Fräulein Guijarro! Wie bist du denn hier gelandet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501202,
					"content": "... Nein, nein. Ich kann sie nicht einfach so den Hinweis finden lassen. Und wie sollte jemand noch klar denken können, der den ganzen Abend hier angebunden war?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501203
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501203,
					"content": "Boah, sie ist völlig in Gedanken. Vielleicht hat sie jetzt die richtige Inspiration gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501204,
					"content": "Es ist wohl eher eine Schreibblockade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501205
					]
				},
				{
					"id": 700501205,
					"content": "#... {NICKNAME}, Paimon, ihr kommt gerade recht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501206
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501206,
					"content": "Könntet ihr mich an einen Holzpfahl binden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501207
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501207,
					"content": "H... Hat sie das wirklich gerade gesagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501208,
					"content": "Ich bitte euch beide. Fesselt meine beiden Hände zusammen und bindet mich dann mit erhobenen Armen an einen Baum. Sie sind sowieso alle aus Holz, also macht es keinen Unterschied.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501209
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501209,
					"content": "Ich möchte nicht zum Verdächtigen in deinem Roman werden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501210
					]
				},
				{
					"id": 700501210,
					"content": "Keine Sorge. Ich habe bereits eine schriftliche Vollmacht unterzeichnet. Für sämtlich Unwägbarkeiten in diesem Zeitraum trage ich die volle Verantwortung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501211
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501211,
					"content": "Das ist nicht das Problem! Warum willst du denn plötzlich, dass wir dich fesseln? Du hast doch nichts verbrochen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501212,
					"content": "Aber die Hauptfigur in meinem Roman wird von den Dorfbewohnern an den Händen aufgehängt und eine ganze Nacht lang in der Wildnis zurückgelassen, in Erwartung des Urteils der Xuanwen-Bestie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501213
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501213,
					"content": "Später in der Handlung wird die Hauptfigur, welche diese Situation bereits vorausgeahnt hat, mit einem Trick überleben, die Nacht in Sicherheit verbringen und daraufhin die ganze Wahrheit ans Licht bringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501214
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501214,
					"content": "... Nur habe ich keine Vorstellung davon, wie sich ein Mensch fühlen muss, der eine ganze Nacht angebunden war. Ebenso wenig wie er denkt, spricht, oder sich bewegt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501215
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501215,
					"content": "Deswegen brauche ich euch beide, damit ihr mich hier die ganze Nacht festhaltet. Auf diese Art kann ich all jene Gefühle selbst erfahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501216,
						700501217
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501216,
					"content": "Nein. Das ist viel zu gefährlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501218
					]
				},
				{
					"id": 700501218,
					"content": "... Also, na ja. Die gibt es schon, aber sie wäre nicht so effektiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501219
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501219,
					"content": "Ich könnte stattdessen meine Hände hochheben und hier die ganze Nacht stehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501220
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501220,
					"content": "Oder ... du schreibst diesen Roman einfach nicht. Was du vorhast, könnte die Leute auf falsche Gedanken bringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501221,
					"content": "Du willst deine Hauptfigur aber wirklich durch die Mangel drehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501222
					]
				},
				{
					"id": 700501222,
					"content": "Ich bitte euch! Das ist der entscheidende Schritt! Mein Roman wird schon bald fertiggestellt sein! Auf diese Weise macht ihr euch keiner Straftat schuldig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501223
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501223,
					"content": "Das hatten wir sowieso nicht vor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501224,
					"content": "Ja! Ja!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501225
					]
				},
				{
					"id": 700501225,
					"content": "Ach ... Also, es ist doch gar nicht so schwierig. Ihr müsst nur in meiner Nähe Wache stehen, damit ich nicht von jemandem entführt oder von einem wilden Tier geraubt werde, während ich meine Inspirationen sammle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501226
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501226,
					"content": "Schauen wir mal ... Für die Atmosphäre, die wir im Roman erzeugen wollen, sollten wir an den höchsten Platz gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501227
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501227,
					"content": "Ah? He! Warte auf uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501228,
					"content": "Ihr steigt mit Guijarro zur höchsten Selle der Teefelder ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501229
					]
				},
				{
					"id": 700501229,
					"content": "Puh, es ... ist ganz schön kalt. Aber ... dafür fühlt es sich sehr immersiv an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501230
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501230,
					"content": "Willst du wirklich die ganze Nacht lang hier mit deinen Händen in der Luft stehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501231,
					"content": "Ganz richtig. Ich habe mich schon entschieden. Um einen Roman zu schreiben, muss man Opfer bringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501232
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501232,
					"content": "Bitte steht in der Zwischenzeit hier Wache. Nur diese eine Nacht ... Eine Nacht genügt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501217,
					"content": "Gibt es keine ungefährlichere Methode, das zu tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501218
					]
				}
			]
		},
		{
			"id": 7005015,
			"completionStepIds": [
				7005015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
