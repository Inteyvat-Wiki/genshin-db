						],
						"pointId": 311400061
					}
				]
			},
			"dialogs": [
				{
					"id": 700500801,
					"content": "Das sind also Laternen? Die sehen aus wie Fische ... Wie faszinierend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500802
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500802,
					"content": "Und mit diesen Griffen kann man die Laterne hochheben? Bei dieser zerlegbaren Konstruktion können, wenn man es schlau anstellt, einige Teile hinzugefügt werden, ohne dass jemand es merkt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500803
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500803,
					"content": "Darin ist reichlich Platz. Es bietet leicht genügend Raum für einige ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500804
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500804,
					"content": "Stopp! Behalte diese Ideen für dich!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500805
					]
				},
				{
					"id": 700500805,
					"content": "Äh? ... Oh! Hahaha ... Ich habe bei diesem interessanten Anblick wohl versehentlich laut gedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500806
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500806,
					"content": "Hmm. Ja, ich bin mir sicher, dass Laternen meinem Roman unbedingt mehr Textur geben werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500807
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500807,
					"content": "#{NICKNAME}, könntest du bitte dort hingehen und ein Foto von dieser großen Fischlaterne machen? Ich hätte gern einige Bilder als Referenz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500808,
						700500809
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500808,
					"content": "So werden sich meine Fähigkeiten der Fotografie weiter verbessern ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				},
				{
					"id": 700500810,
					"content": "Dann übernimmst du das Fotografieren ... Ach ja. Denk bitte daran, ein Bild von der gesamten Laterne zu machen. Das ist sehr wichtig für mich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500811
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500811,
					"content": "... Es dürfte interessant sein, eine Intrige zu spinnen, die sich um Maße dreht. Aber wie lässt sich nur das Problem mit dem Gewicht lösen ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500809,
					"content": "Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				}
			]
		},
		{
			"id": 7005010,
			"completionStepIds": [
				7005010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7005010",
