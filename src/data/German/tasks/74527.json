			},
			"dialogs": [
				{
					"id": 745270401,
					"content": "#Ach, du bist es, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270402,
						745270403
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270402,
					"content": "Escoffier, lange nicht gesehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				},
				{
					"id": 745270404,
					"content": "Heute bin ich nicht fürs Kochen verantwortlich, ich verkoste nur ein paar Gerichte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270405
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270405,
					"content": "Savanna möchte ein neues Gericht auf die Karte setzen und hat mich um meine Meinung gebeten. Aber dieses Gericht ... es ist bereits der fünfte Versuch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270406
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270406,
					"content": "Entweder liegt sie mit der Garzeit ein paar Sekunden daneben, wodurch die Textur der Zutaten beeinträchtigt wird, oder die Gewürze sind zu stark dosiert und übertönen den eigentlichen Geschmack.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270407
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270407,
					"content": "Du bist also immer noch so streng, Escoffier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270408
					]
				},
				{
					"id": 745270408,
					"content": "Natürlich! Kochen ist nun mal eine Wissenschaft, und das Essen schmeckt nicht anders, nur weil sie meine Freundin ist. Gerade weil ich Verantwortung für sie und die Gäste habe, muss ich umso strenger sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270409,
						745270410
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270409,
					"content": "Ich hätte da eine kleine Bitte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270411,
					"content": "... Ausgerechnet jetzt? Wenn das Foto für die Öffentlichkeit bestimmt ist, würde ich dir eine andere Zeit vorschlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270412
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270412,
					"content": "Wir müssen die Szenerie sorgfältig auswählen und Licht sowie Winkel genau anpassen, damit alles perfekt aussieht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270413,
						745270414
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270413,
					"content": "Ich möchte einfach nur ein paar schöne Erinnerungsfotos für meine Freunde machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270415,
					"content": "... Na gut. Bis sie mit ihrem sechsten Versuch fertig ist, haben wir ja noch etwas Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270416
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270416,
					"content": "Dann lass uns mal sehen, was besser zur Geltung kommt – dein neues Objektiv oder das neue Gericht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270414,
					"content": "Außerdem kann ich das neue Objektiv testen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270410,
					"content": "Darf ich ein Foto von dir machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270403,
					"content": "Entwickelst du gerade neue Rezepte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				}
			]
		}
	]
