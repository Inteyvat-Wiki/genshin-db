			},
			"dialogs": [
				{
					"id": 220100701,
					"content": "Das Tsukumomono-Geschäft verkauft alle Arten von Waren, die den Gegenständen ähneln, die der Protagonist während seines Abenteuers gesammelt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100702
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100702,
					"content": "Ich meine, Aoi sagt immer, dass „des einen Müll der Schatz des anderen ist“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100703
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100703,
					"content": "Hmm ... Es scheint, als ob herauszufinden, was der Käufer schätzt, der Schlüssel zum Verkauf von Waren zu einem hohen Preis ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100704
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100704,
					"content": "Aber wenn ich es so schreibe, muss ich Zeit damit verbringen, die Psychologie zu beschreiben. Das passt nicht zum Thema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100705
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100705,
					"content": "Warum mache ich den Protagonisten nicht einfach zu einem Hellseher, der die Bedürfnisse des Käufers erahnen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100706,
						220100708
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100706,
					"content": "Du kannst der Figur nicht plötzlich Eigenschaften hinzufügen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100707
					]
				},
				{
					"id": 220100707,
					"content": "Das ist Charakterentwicklung. Es ist in Ordnung. Mach dir keine Sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100710
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100710,
					"content": "Nun, da haben wir es also! Ich weiß, was ich schreiben soll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100711
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100711,
					"content": "#{F#Reisende}{M#Reisender}, lass uns zurückgehen. Ich werde Shigeru von meiner Idee erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100708,
					"content": "Wo ist die Grundlage für die Handlung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100709
					]
				},
				{
					"id": 220100709,
					"content": "Handlungsbasis ... hmm, ich denke darüber nach, während ich schreibe. Es sollte kein Problem sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100710
					],
					"speakerTitle": "Junkichi"
				}
			]
		},
