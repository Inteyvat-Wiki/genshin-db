						"stepId": 2201005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Junkichi",
					"Shigeru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220100916,
					"content": "Eigentlich ist Junkichis Idee nicht schlecht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100917
					]
				},
				{
					"id": 220100917,
					"content": "Nicht schlecht? Wenn er es so schreibt, verwirrt er sogar sich selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100918
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100918,
					"content": "Hahaha, siehst du? Der Reisende ist auf meiner Seite. Das bedeutet, dass meine Idee ansprechend ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100919
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100919,
					"content": "Das Wichtigste an einem Roman ist eine spannende und attraktive Handlung. Ich schreibe mit diesem Gedanken im Hinterkopf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100920
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100920,
					"content": "*seufz* Du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100921
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100921,
					"content": "Mach dir keine Sorgen darüber. Ich weiß, was ich tue. Es wird auf jeden Fall einhelliges Lob bekommen. Du wirst es sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
			"id": 2201013,
			"completionStepIds": [
				2201007
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201005",
							"2"
						],
						"stepId": 2201005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Junkichi",
					"Shigeru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220100922,
					"content": "Eigentlich klingt Shigeru viel vernünftiger ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100923
					]
				},
				{
					"id": 220100923,
					"content": "Vernünftig? Vernünftigkeit ist kein Ersatz für eine gute Handlung. Eine vernünftige Handlung wäre langweilig ohne eine fesselnde Geschichte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100924
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100924,
					"content": "Du ... und wenn es an der Zeit ist, die Geschichte abzuschließen, wirst du verrückt werden bei dem Versuch, die losen Enden zu verknüpfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100925
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100925,
					"content": "Ich habe mir Notizen gemacht. Wir werden keine Probleme haben, die Geschichte zu beenden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100926
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100926,
					"content": "Du musst dir Notizen machen, um dich an alle Details zu erinnern. Erwartest du von den Lesern, dass sie sich auch Notizen machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100927
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100927,
					"content": "Uh ... Na ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100928
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100928,
					"content": "Ich sage nicht, dass du keine neuen Merkmale hinzufügen kannst. Du musst nur darauf achten, wie viele es sind und wann sie hinzugefügt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100929
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100929,
					"content": "Einen Roman zu schreiben ist wie einen Marathon zu laufen. Wenn du dich am Anfang zu sehr anstrengst, wirst du später erschöpft sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100930
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100930,
					"content": "Der Schlüssel zu einem erfolgreichen Roman ist es, sich stetig vorwärts zu bewegen, einen Schritt nach dem anderen. Vertraue mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100931
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100931,
					"content": "Na gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		}
	]
}