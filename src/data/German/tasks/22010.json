					"content": "In dem Kapitel, an dem ich gerade arbeite, bereitet sich der Hauptcharakter auf den nächsten großen Kampf vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100202
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100202,
					"content": "Er braucht eine mächtige Waffe ... Lass mich nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100203
					],
					"speakerTitle": "Junkichi"
				},
				{
