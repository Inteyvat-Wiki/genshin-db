			"dialogs": [
				{
					"id": 220100901,
					"content": "Ich fand Inspiration in Amenomas Schmiede!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100902
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100902,
					"content": "Wirklich? Hm. Du hast es tatsächlich geschafft. Nun, wunderbar. Erzähl mir davon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100903
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100903,
					"content": "Eines Nachts wird die Hauptfigur plötzlich erleuchtet und erlangt die großartige Alchimie-Fähigkeit Schwertauferstehung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100904
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100904,
					"content": "Er kann eine rostige Klinge in eine mächtige Waffe verwandeln, indem er einfach ihren neuen Namen sagt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100905
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100905,
					"content": "So wird er ... Warte, was ist los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100906
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100906,
					"content": "He ... machst du das wirklich schon wieder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100907,
						220100908
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100907,
					"content": "Schon wieder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100909
					]
				},
				{
					"id": 220100909,
					"content": "Willst du ernsthaft neue Charaktereigenschaften hinzufügen, um die Geschichte wieder fortzusetzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100910
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100910,
					"content": "Und du wirst noch kompliziertere Eigenschaften auf diese Eigenschaften tackern, bis du das neue Kapitel fertig hast, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100911
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100911,
					"content": "Egal wie sehr du die Figur magst, hör auf ihr zu viele Fähigkeiten zu geben! Die Leser werden sonst verwirrt sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100912
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100912,
					"content": "Das war schon immer mein Stil. Ich denke, es ist interessant. Die Leser werden es lieben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100913
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100913,
					"content": "Komm mir nicht damit. Du weißt, dass die Leser langsam verwirrt werden von allem, was du dir ausdenkst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100914
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100914,
					"content": "Ich bin fertig damit, mit dir zu reden. Deine Ideen sind zu langweilig. Lass uns die Meinung des Reisenden hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100915
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100915,
					"content": "#{F#Reisende}{M#Reisender}, was denkst du, wer hat recht, ich oder Shigeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100908,
