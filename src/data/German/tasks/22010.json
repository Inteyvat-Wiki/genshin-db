			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220100101,
					"content": "Junkichi, der Abgabetermin für das Manuskript ist morgen. Keine Verzögerungen mehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100102
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100102,
					"content": "Es hat keinen Sinn, mich zu drängen! Ich stecke an einem kritischen Punkt in der Geschichte fest und habe eine Schreibblockade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100103
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100103,
					"content": "Worüber streitet ihr euch denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100104
					]
				},
				{
					"id": 220100104,
					"content": "#Reisende{M#r}! Genau die Stimme der Vernunft, die wir brauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100105
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100105,
					"content": "Ich bin Shigeru, ein Redakteur im Yae Verlagshaus. Das ist Junkichi, der Schriftsteller, für den ich zuständig bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100106
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100106,
					"content": "Sein neuer Roman, „Onibudou“, ist sehr beliebt. Aber er hält nie seine Deadlines ein. Manchmal verzögert er sich sogar um Wochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100107
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100107,
					"content": "Und er ist natürlich wieder dabei. Wenn er sein Manuskript nicht bis morgen abgibt, werde ich die Ausgabe dieses Monats nicht in den Druck bringen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100108
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100108,
					"content": "Warum verschieben wir die Ausgabe nicht? Unsere treuen Leser werden trotzdem dafür bezahlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100109
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100109,
					"content": "Mach dich nicht lächerlich. Wenn er nicht regelmäßig aktualisiert wird, geht der Ruf des Romans den Bach runter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100110
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100110,
					"content": "Aber ich habe im Moment einfach keine Inspiration und ich werde nicht irgendein Müllkapitel schreiben. Es muss einfach eine interessante Geschichte sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100111
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100111,
					"content": "Aber alle anderen Schreiber sind im Grunde genommen fertig. Du bist der Einzige, der noch übrig ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100112
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100112,
					"content": "Vielleicht braucht Junkichi wirklich nur ein bisschen Inspiration ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100113
					]
				},
				{
					"id": 220100113,
					"content": "Das ist richtig! Mein Freund hier versteht mich. Ich brauche Inspiration!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100114,
					"content": "Ich werde herumgehen und nach welchen Ausschau halten. Ich bin mir sicher, dass mir etwas einfallen wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100115
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100115,
					"content": "He! Das ist die Ausrede, die du beim letzten Mal benutzt hast, um es aufzuschieben. Wir werden das nicht noch einmal machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100116
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100116,
					"content": "Dieses Mal lüge ich nicht. Komm schon, vertrau mir nur dieses eine Mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100117,
					"content": "Hmm ... Na gut. Gut. Aber das ist das letzte Mal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100118
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100118,
					"content": "Keine weiteren Verzögerungen! Hast du das verstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100119
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100119,
					"content": "Na gut, ich weiß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100120
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100120,
					"content": "Puh ... Diesmal kann ich es wohl nicht aufschieben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100121,
						220100122
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100121,
					"content": "Lass uns etwas Material besorgen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220100122,
					"content": "Nun, dann wird es Zeit, sich etwas Inspiration zu holen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100123
					]
				},
				{
					"id": 220100123,
					"content": "Wäre es so einfach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100124
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100124,
					"content": "Aber wir müssen es irgendwie schaffen, sonst stellt Shigeru mein Haus auf den Kopf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
