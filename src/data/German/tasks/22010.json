			"dialogs": [
				{
					"id": 220100301,
					"content": "In dem Kapitel, an dem ich gerade arbeite, versucht die Hauptfigur, die Gegenstände zu verkaufen, die er während seines Abenteuers gesammelt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100302
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100302,
					"content": "Dazu gehört der Umgang mit verschiedenen Typen von Käufern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100303
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100303,
					"content": "Hmm ... Dann lass uns zum Tsukumomono-Geschäft gehen.",
