			"dialogs": [
				{
					"id": 220100801,
					"content": "Die Doushin bewahren den Frieden in Hanamizaka. Kein Verbrecher kann ihrer Wache entkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100802
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100802,
					"content": "In der Geschichte haben die Ritter des Feindes die gleichen Aufgaben wie die Doushin. Aber um es interessant zu machen, machen wir sie zehnmal so stark.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100803,
						220100805
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100803,
					"content": "Das ist so eine willkürliche Zahl!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100804
					]
				},
				{
					"id": 220100804,
					"content": "Zahlenwaagen sind die klarste Sache der Welt. Das wird uns helfen zu zeigen, wie mächtig die Hauptfigur ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100806
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100806,
					"content": "Nun, ich werde ... dem Protagonisten die Beherrschung von Verkleidungen geben. Zum Beispiel kann er sein Aussehen und seine Stimme frei verändern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100807
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100807,
					"content": "Ist das eine neue Ereigenschaft? ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100808
					]
				},
				{
					"id": 220100808,
					"content": "Dies ist die versteckte Fähigkeit des Hauptcharakters. Eine Begegnung mit bestimmten Feinden ist der beste Zeitpunkt, um sie zu enthüllen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100809
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100809,
					"content": "He, das hast du dir gerade ausgedacht, richtig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100810
					]
				},
				{
					"id": 220100810,
					"content": "Nein ... Das war die ganze Zeit mein Plan. Komm schon, jetzt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100811
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100811,
					"content": "Wie auch immer, lass uns einfach damit weitermachen. Zeit, Shigeru von meiner Idee zu erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100805,
					"content": "Und wie wird die Hauptfigur dieses Rätsel lösen? ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100806
					]
				}
			]
		},
