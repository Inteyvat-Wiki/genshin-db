				{
					"id": 220101110,
					"content": "Egal wie sehr du den Protagonisten magst, hör auf ihm so viele Fähigkeiten zu geben! Die Leser werden sonst verwirrt sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101111
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220101111,
					"content": "Das war schon immer mein Stil. Ich denke, es ist interessant. Die Leser werden es lieben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101112
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220101112,
					"content": "Komm mir nicht damit. Du weißt, dass die Leser langsam verwirrt werden von dem Zeug, das du dir ausdenkst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101113
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220101113,
					"content": "#Ich bin fertig damit, mit dir zu reden. Deine Ideen sind zu langweilig. Lass uns stattdessen die Meinung {M#des}{F#der} Reisenden hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220101114,
					"content": "#{F#Reisende}{M#Reisender}, was denkst du, wer hat recht, ich oder Shigeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220101107,
					"content": "Was?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220101108
					]
				}
			]
		},
		{
			"id": 2201012,
			"completionStepIds": [
				2201006
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201005",
