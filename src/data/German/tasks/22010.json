			},
			"dialogs": [
				{
					"id": 220100401,
					"content": "In dem Kapitel, an dem ich gerade arbeite, macht sich die Hauptfigur alleine auf den Weg in feindliches Gebiet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100402
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100402,
					"content": "Das Sammeln von Informationen ist entscheidend für den Kampf gegen den Feind. Wie soll ich das schreiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100403
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100403,
					"content": "Hmm ... schauen wir uns den Doushin bei der Arbeit an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
