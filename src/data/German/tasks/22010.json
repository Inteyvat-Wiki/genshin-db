				"points": []
			},
			"dialogs": [
				{
					"id": 220100601,
					"content": "Funken fliegen, wenn Hämmer auf Ambosse prallen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100602
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100602,
					"content": "Amenomas Schmiede ist ein solcher Ort voller Leidenschaft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100603
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100603,
					"content": "Schmiede verwandeln rohe Knüppel und Erze mit solch einfachen Werkzeugen in mächtige Waffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100604
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100604,
					"content": "Wenn die Alchimie beim Schmieden verwendet wird, wäre es dann nicht möglich, unzerstörbare Waffen zu erschaffen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100605,
						220100606
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100605,
					"content": "Die Alchimie kann das nicht tun ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100608
					]
				},
				{
					"id": 220100608,
					"content": "Ja! Das ist eine gute Idee. Der Hauptcharakter soll die stärkste Waffe haben! Eine, die mit Alchimie geschmiedet wurde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100609
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100609,
					"content": "Diese Waffe muss einen fantastischen Namen haben ... und eine fantastische Hintergrundgeschichte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100610
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100610,
					"content": "So machen wir das!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100611
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100611,
					"content": "#{F#Reisende}{M#Reisender}, lass uns zurückgehen. Ich werde Shigeru von meiner Idee erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100606,
					"content": "Ich glaube, du verstehst die Alchimie nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100607
					]
				},
				{
					"id": 220100607,
					"content": "Wie meinst du das? Ist Alchimie nicht die Art von Dingen, die das Unmögliche möglich machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100608
					],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
			"id": 2201007,
			"completionStepIds": [
