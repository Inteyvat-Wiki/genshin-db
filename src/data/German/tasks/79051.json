			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790510101,
					"content": "Hier ist ein Tagebuch und es scheint in gutem Zustand zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510102
					],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790510102,
					"content": "Puh ... Was für eine Erleichterung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510103
					],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790510103,
					"content": "Die emotionale Blockade des Malers ist vollständig aufgelöst und seine Maltechnik hat sich verbessert. Er wird sicherlich etwas Großes vollbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510104
					],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790510104,
					"content": "Allerdings findet Paimon es schon ein wenig traurig. Er ist schließlich gegangen und hat seine „Tröpfchen“-Freunde zurückgelassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510105,
						790510106
					],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790510105,
					"content": "Künstler sind keine Freunde von Nachbildungen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				},
				{
					"id": 790510107,
					"content": "Stimmt, Paimon kann das versehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510108
					],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790510108,
					"content": "Es gibt da aber etwas, dass Paimon noch nicht ganz verstanden hat. Er hat erwähnt, dass das von ihm hinterlassene Wandgemälde verzerrt und verschoben werden könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510109
					],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790510109,
					"content": "Aber trotz des vorherigen heftigen Vorfalls scheint das Problem mit der Verschiebung des Wandgemäldes nicht besonders schwerwiegend zu sein ... Warum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510110,
						790510111
					],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790510110,
					"content": "Das liegt an diesen „Tröpfchen“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510112,
					"content": "So ist das also! Kein Wunder, dass die „Tröpfchen“ so sehr mit dem „Bündellichtwerfer“ und der Reparierung des Wandgemäldes so vertraut sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510113
					],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790510113,
					"content": "*schluchz* Oh ... Paimon ist davon berührt, dass die „Tröpfchen“, obwohl sie nicht sonderlich intelligent erscheinen, doch so fürsorglich und treu sind, wie gute Freunde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790510111,
					"content": "Sie beschützen das Wandgemälde ihres Freundes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510106,
					"content": "Seinen einzigartigen Stil zu bewahren, hat auch etwas für sich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				}
			]
		},
