						],
						"pointId": 230
					}
				]
			},
			"dialogs": [
				{
					"id": 701110301,
					"content": "Was soll das denn? Das war ja bloß falscher Alarm! Nach dem ganzen Theater ist es am Ende nur ein Feuerwerkskörper ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110302,
					"content": "W... Welch ein Glanz ... Als ich ihrer Exzellenz, der allmächtigen Narukami Ogosho, in die Schlacht folgte, habe ich noch nie solch blendende Feuerblumen gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110303
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110303,
					"content": "Verstehe. Das ist also das wundersame Schauspiel, das mir Hoheit Yu Huangyi zeigen wollte ... Ich fühle mich zutiefst geehrt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110304
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110304,
					"content": "„Dunkle Nacht wie schwarze Jade, Blumen leuchten unter dem Wolkenhimmel; der Leib treibt wie Bläschen auf dem Wasser. Ein Augenblick verweht und Stille kehrt ein, Sterne scheiden sich vom Regen, verstreut in der Leere ...“ Hach, wie elegant ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110305
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110305,
					"content": "Paimon weiß zwar nicht, was genau daran so „elegant“ sein soll ... Aber Hauptsache, alles ist in Ordnung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}