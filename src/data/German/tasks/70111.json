				]
			},
			"dialogs": [
				{
					"id": 701110101,
					"content": "#{F#Edle Reisende}{M#Edler Reisender}, bitte warte einen Augenblick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110102
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110102,
					"content": "Um es kurz zu machen, ich habe eine Bitte. Vor einigen Tagen sandte mir Seine Hoheit Yu Huangyi aus Liyue einen seltenen Schatz zu, doch hat er mich bis heute nicht erreicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110103
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110103,
					"content": "Ich habe den Verdacht, dass der Wächter dieses Ortes ihn unterschlug. Wenn du die „Kostbarkeit“ findest, von der Hoheit Yu Huangyi sprach, könntest du sie für mich zurückholen? Ich werde mich selbstverständlich angemessen erkenntlich zeigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				}
			]
		},
		{
			"id": 7011102,
			"completionStepIds": [
				7011102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7011102",
							"2"
						],
						"stepId": 7011102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soga Sumidanoryu Sakon Shigehira"
				],
				"points": [
					{
						"sceneId": 103,
						"position": [
							322.275,
							205.963,
							571.86
						],
						"pointId": 229
					}
				]
			},
			"dialogs": [
				{
					"id": 701110201,
					"content": "Wir sind zurück! Ist das die „Kostbarkeit“, von der du sprachst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110202,
					"content": "Oh, habt meinen herzlichsten Dank! Meine Wenigkeit kann euch gar nicht genug danken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110203
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110203,
					"content": "Also gut, die Angelegenheit duldet keinen Aufschub. Wollen wir sie öffnen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110204
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110204,
					"content": "Das ... Das ist ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110205
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110205,
					"content": "Waaah! Explodiert das Ding gleich?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110206,
					"content": "Seine Hoheit Yu Huangyi würde mir doch nichts antun ... Ist es möglich, dass es von dem Wächter gefunden und zu einer sogenannten „Bombe“ umgebaut wurde?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110207
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110207,
					"content": "Es ist eine Schande, aber mein bescheidenes Wissen reicht nicht aus, um diese „Bombe“ zu entschärfen ... Ich habe keine Wahl, ich muss sie hinauswerfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110208
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110208,
					"content": "Keine Sorge! Ich erinnere mich noch daran, dass eine Hoheit aus „Hyperborea“ mir einst erklärte, wie man die heilige „Bombe“ zu werfen hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110209
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110209,
					"content": "„Zähle bis drei, nicht mehr und nicht weniger. Zähle weder bis vier, noch bis zwei – fünf ist zu viel. Wenn die Zahl, die du zählst, drei ist ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110210
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110210,
					"content": "Zu viel Gerede! Wenn du sie nicht sofort wirfst, explodiert sie wirklich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7011103,
			"completionStepIds": [
				7011103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
