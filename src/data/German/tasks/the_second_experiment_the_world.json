			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440141,
					"content": "Ich bin zurück. Habt ihr etwas Interessantes gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440142,
						110440144
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440142,
					"content": "Ich habe keine Ahnung, wozu alles gut ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440143
					]
				},
				{
					"id": 110440143,
					"content": "Keine Sorge, das ist alles für alchimistische Zwecke, man müsste schon sehr einfallsreich sein, um die Gegenstände für den täglichen Gebrauch umzumünzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440146
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440146,
					"content": "Na ja, dann widmen wir uns wieder unserer Forschung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440101
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440101,
					"content": "Unsere Welten könnten sich sehr voneinander unterscheiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440102
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440102,
					"content": "Teyvat zum Beispiel. Hier können diejenigen mit Göttlichen Augen die Elemente manipulieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440103,
					"content": "Aber es könnten durchaus Welten existieren, in denen nur eine Person dazu in der Lage ist. Oder alle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440104,
					"content": "#Deshalb, {NICKNAME}, sollten wir mal die Elemente außen vor lassen ... Besitzt du irgendwelche ... einzigartigen Fähigkeiten? Fähigkeiten, die es in dieser Welt nicht gibt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440105
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440105,
					"content": "Ich glaube, diese Frage bedarf wieder derselben Vorgehensweise wie beim letzten Mal. In anderen Worten: Es wird Zeit für das nächste Experiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440106,
						110440107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440106,
					"content": "Muss ich wieder gegen Schleime kämpfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440108
					]
				},
				{
					"id": 110440108,
					"content": "Nein, nein! Dieses Mal wird alles viel einfacher sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440109,
					"content": "Siehst du diese Säule? Brich sie mit deiner Willenskraft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440110,
						110440113
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440110,
					"content": "Tut mir leid. Ich schaff das einfach nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440111
					]
				},
				{
					"id": 110440111,
					"content": "Das war alles, was du aufbieten konntest? Hmm ... Dann kann man wohl nichts machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440112
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440112,
					"content": "Wieso ist er so enttäuscht? Ich meine, ist das nicht ohnehin ... unmöglich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440116,
					"content": "Ah! Hast du je versucht, deine Elementarkraft mit Essen anzuwenden? Ich meine nicht, um es zu kochen ... sondern eher, dass du deine Kraft in die Zutaten fließen lässt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440117,
					"content": "Mich würde interessieren, wie sich der Geschmack und die Konsistenz dadurch verändern. Vielleicht wird das Essen sogar ... mehr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440118,
						110440119
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440118,
					"content": "Alchimisten haben echt eine lebhafte Vorstellungskraft.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440120
					]
				},
				{
					"id": 110440120,
					"content": "Haha, mein Interesse an Dingen überrascht andere wohl manchmal ein wenig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440121
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440121,
					"content": "Aber warum kochst du uns nicht einfach eine Sonnenscheinsprotte? Ich habe gerade das Rezept fertiggestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440151
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440151,
					"content": "Kochen? Paimon hätte sich auf mehr verrücktes Wissenschaftlerzeugs gefreut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440122,
					"content": "Das Rezept ist nicht nur ein Grundnahrungsmittel für mich, es ist höchst nahrhaft und es wert, damit herumzuexperimentieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440123
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440123,
					"content": "Hmpf. Paimon wettet, dass du einfach nur hungrig bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440124,
					"content": "Es klingt aber lecker ... Na gut, Paimon ist einverstanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440125,
						110440126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440125,
					"content": "Ich weiß, worauf du hinauswillst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440127
					]
				},
				{
					"id": 110440127,
					"content": "Mhm! Gute Freunde sind sich einig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440128,
					"content": "Ich lasse dich dann mal walten und freue mich auf das Ergebnis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440130
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440130,
					"content": "Sollte etwas übrig bleiben, kann sich Timaeus vielleicht um die Reste kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440131
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440131,
					"content": "Äh ... Paimon glaubt nicht, dass wir dieses ... Problem haben werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440126,
					"content": "Ich spare eine Flosse oder zwei für dich auf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440127
					]
				},
				{
					"id": 110440119,
					"content": "Bist du sicher, dass du nicht gerade nur ein wenig hungrig bist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440120
					]
				},
				{
					"id": 110440113,
					"content": "Paimon, probier du mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440114
					]
				},
				{
					"id": 110440114,
					"content": "Glaubst du, dass Paimon das schafft?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440115,
					"content": "Das war alles, was du aufbieten konntest? Hmm ... Dann kann man wohl nichts machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440107,
					"content": "Ich habe genug getrunken, danke ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440108
					]
				},
				{
					"id": 110440144,
					"content": "Es herrscht ein ziemliches Durcheinander.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440145
					]
				},
				{
					"id": 110440145,
					"content": "Hmm. Das stimmt. Ich würde gerne mal richtig aufräumen. Aber die Experimente haben Vorrang ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440146
					],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 1104403,
			"completionStepIds": [
				1104403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104403",
							"2"
						],
						"stepId": 1104403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440320,
					"content": "Donnerlittchen, ihr habt sie gefunden? Unglaublich! Tausend Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440321,
					"content": "Ich frage mich, dieser „Elementarblick“ ... Hast du die Gegenstände damit gefunden? Und auch mich hier in den Bergen, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440322
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440322,
					"content": "Jepp! Das zählt wohl irgendwie als Superkraft, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440323,
					"content": "Leider kommt der Elementarblick zwar sehr selten vor, aber er ist nichts Neues in Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440324
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440324,
					"content": "Nur eine Kraft, die es in dieser Welt noch nie gab, würde meiner Forschung wirklich dienen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440325
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440325,
					"content": "Das heißt also ... wir sind schon wieder gescheitert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440326,
					"content": "Kopf hoch. Etwas anderes habe ich gar nicht erwartet. Außerdem habe ich doch diese Gegenstände wieder. Wenn du mich fragst, war das schon ein Erfolg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440301
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440301,
					"content": "Deine Eingebung, dass die Gegenstände Spuren von Elementen aufweisen könnten, war übrigens äußerst klug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440302
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440302,
					"content": "Na gut. Bis jetzt haben wir uns auf deine Identität außerhalb unserer Welt konzentriert. Die Forschung in Bezug auf deine Identität als ein Teil von uns hat gerade erst begonnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440303,
						110440304
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440303,
					"content": "Bis zum bitteren Ende.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440305
					]
				},
				{
					"id": 110440305,
					"content": "Im Wesentlichen zeigen sich die Unterschiede der Menschen in unseren intellektuellen und körperlichen Fähigkeiten. Beginnen wir mit den körperlichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440306,
					"content": "Kannst du von hier aus sehen, was Saccharose macht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440307
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440307,
					"content": "Nein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440308
					]
				},
				{
					"id": 110440308,
					"content": "Und wenn du hier springen und auf dieser Klippe da landen würdest ... die da drüben ... Würdest du sie dann sehen können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440309,
					"content": "Nein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440310
					]
				},
				{
					"id": 110440310,
					"content": "Und wenn du diesen Berg hier mit einem Hieb in Grund und Boden stampfen würdest, könntest du sie dann sehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440311,
						110440312
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440311,
					"content": "Nein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440313
					]
				},
				{
					"id": 110440313,
					"content": "Hmm, dann sollte ich keine zu hohen Erwartungen stellen. Trotzdem, mit einem Experiment können wir vielleicht tiefere Einblicke gewinnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440314,
					"content": "Ich kenne einen Ort, der sich perfekt für einen körperlichen Test eignet. Folgt mir bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440312,
					"content": "Klingt, als würden wir immer noch nach Superkräften suchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440313
					]
				},
				{
					"id": 110440304,
					"content": "Ich will hier raus ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440305
					]
				}
			]
		},
		{
			"id": 1104405,
			"completionStepIds": [
				1104405,
				1104416
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104416",
							"2"
						],
						"stepId": 1104416,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440501,
					"content": "Hmm. Das Gericht ist ziemlich durchschnittlich geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440502,
					"content": "Was jedoch die Vermehrungstheorie betrifft, war das Ganze wohl ein Reinfall. Anscheinend bereitet Essen in deiner und meiner Welt dieselben Probleme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440503,
					"content": "Außer ... Könnte es sein, dass deinen einzigartigen Fähigkeiten ob der Naturgesetze dieser Welt Grenzen gesetzt werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440504,
					"content": "Wir wussten einfach nicht, wie man Elementarkraft in Essen fließen lässt. Das ist ein bisschen komplizierter als zu würzen, weißt du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440505,
					"content": "Keine Sorge, immerhin haben wir die Zutaten gut verwertet. Kein Grund, den Kopf hängen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440506
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440506,
					"content": "Und hier ist deine Portion. Lass es dir schmecken! Ich kann etwas für dich einpacken, wenn du möchtest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440507
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440507,
					"content": "Hurra! Danke! Freut mich, dass du daran gedacht hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440508,
						110440509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440508,
					"content": "Paimon hat einen neuen besten Freund.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				},
				{
					"id": 110440510,
					"content": "Eure Freundschaft ist nicht zu übersehen. Paimon hat während des ganzen Experiments mit Argusaugen über dich und deine Sicherheit gewacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440511
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440511,
					"content": "Nicht, dass sie im Ernstfall viel tun hätte können, aber trotzdem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440512
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440512,
					"content": "He! Vor einer Sekunde warst du noch nett!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440513,
					"content": "Aber du hast leckere Rezepte, deshalb drückt Paimon ein Auge zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440514,
					"content": "Und du hast recht, wir sind gute Freunde. Du hast doch auch gute Freunde, oder? Gute Schüler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440515,
					"content": "Ähm, ja! Ich habe in dieser Hinsicht wohl auch Glück. Jedenfalls sollten wir das nächste Experiment in Angriff nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440516
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440516,
					"content": "Hier liegen allerhand alchimistische Gegenstände herum, hier den Überblick zu behalten, ist selbst in guten Zeiten eine Herausforderung. Vor Kurzem habe ich eine ganze Ladung weggeräumt und kann mich nicht mehr erinnern, wohin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440517,
					"content": "Die meisten Sachen habe ich wieder gefunden, aber zwei Phiolen fehlen immer noch: das Anemo-Kristallschmetterling-Elementarextrakt und das Elektro-Hypostase-Pulver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440518,
					"content": "Paimon hat gerade erst aufgegessen und du willst, dass wir schon wieder was sammeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440519,
					"content": "Keine Sorge, wenn ihr die Sachen nicht findet, kann ich sie ersetzen. Aber es würde mir etwas Mühe sparen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440520
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440520,
					"content": "Wenn du eine „Superkraft“ hättest wie ... ähm ... Nachtsicht oder wenn du Schwingungen erkennen könntest, würden verlorene Gegenstände der Vergangenheit angehören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440521,
					"content": "Ich habe sie bestimmt irgendwo hier verloren, wo du gerade geschaut hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440522
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440522,
					"content": "Also ... Sollten wir gründlich suchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440523,
					"content": "Die Gegenstände sollten Spuren von Elementen aufweisen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440524
					]
				},
				{
					"id": 110440524,
					"content": "Oh, ja! Du könntest deinen Elementarblick einsetzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440509,
					"content": "Kommt selten vor, dass sich jemand so um Paimon kümmert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				}
			]
		},
