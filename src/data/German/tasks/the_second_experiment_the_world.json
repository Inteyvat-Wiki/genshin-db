				{
					"id": 110440515,
					"content": "Ähm, ja! Ich habe in dieser Hinsicht wohl auch Glück. Jedenfalls sollten wir das nächste Experiment in Angriff nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440516
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440516,
					"content": "Hier liegen allerhand alchimistische Gegenstände herum, hier den Überblick zu behalten, ist selbst in guten Zeiten eine Herausforderung. Vor Kurzem habe ich eine ganze Ladung weggeräumt und kann mich nicht mehr erinnern, wohin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440517,
					"content": "Die meisten Sachen habe ich wieder gefunden, aber zwei Phiolen fehlen immer noch: das Anemo-Kristallschmetterling-Elementarextrakt und das Elektro-Hypostase-Pulver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440518,
					"content": "Paimon hat gerade erst aufgegessen und du willst, dass wir schon wieder was sammeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440519,
					"content": "Keine Sorge, wenn ihr die Sachen nicht findet, kann ich sie ersetzen. Aber es würde mir etwas Mühe sparen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440520
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440520,
					"content": "Wenn du eine „Superkraft“ hättest wie ... ähm ... Nachtsicht oder wenn du Schwingungen erkennen könntest, würden verlorene Gegenstände der Vergangenheit angehören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440521,
					"content": "Ich habe sie bestimmt irgendwo hier verloren, wo du gerade geschaut hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440522
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440522,
					"content": "Also ... Sollten wir gründlich suchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440523,
					"content": "Die Gegenstände sollten Spuren von Elementen aufweisen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440524
					]
				},
				{
					"id": 110440524,
					"content": "Oh, ja! Du könntest deinen Elementarblick einsetzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440509,
					"content": "Kommt selten vor, dass sich jemand so um Paimon kümmert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				}
			]
		}
	]
}