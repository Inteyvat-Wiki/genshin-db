				"points": []
			},
			"dialogs": [
				{
					"id": 742490201,
					"content": "Ahhh! Ich werde nie genug von einer entspannten Runde Tee am Nachmittag bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490202,
						742490203
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490202,
					"content": "(Lass uns noch ein Weilchen so sitzen bleiben.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490204,
					"content": "Ach ... Wenn man Spaß hat, vergeht die Zeit wirklich wie im Fluge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490203,
					"content": "Ich glaube, es wird Zeit, dass ich mit dem Aufräumen anfange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
}