				]
			},
			"dialogs": [
				{
					"id": 742490101,
					"content": "Es tut mir einfach schrecklich leid, dir schon wieder die ganze Arbeit zu überlassen, Fräulein Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490102,
					"content": "Das macht doch nichts. Das ist das Mindeste, was ich nach eurer Hilfe neulich bei der Fontainale tun kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490103,
					"content": "Ach, ich bitte dich! Die Schauspieler waren die wahren Stars.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490104,
					"content": "Hast du nicht vor, selbst wieder aufzutreten, Fräulein Furina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490105
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490105,
					"content": "Nun ... Man soll ja niemals nie sagen ... Aber im Moment arbeite ich lieber hinter den Kulissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490106
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490106,
					"content": "Um ehrlich zu sein, wusste selbst ich, als ich noch in Fontaine lebte, wer du bist – der allseits beliebte Superstar Furina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490107,
					"content": "Ugh, bitte nicht! Was auch immer du tust, sag nicht, dass du „mit meinen Auftritten aufgewachsen bist“ ... Das ist mir so unangenehm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490108,
					"content": "Oh, da brauchst du dir keine Sorgen zu machen. Ich wollte nur sagen, dass ich bei meiner Abreise aus Fontaine die Ehre hatte, dich so zu sehen, wie du damals warst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490109,
					"content": "Aber jetzt, wo ich dich nach all der Zeit wiedersehe, glaube ich, dass mir deine jetzige Art besser gefällt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490110,
					"content": "Hm ...? Meine jetzige Art?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490111,
					"content": "Ja, auf der Bühne wirkst du immer ziemlich angespannt, aber jetzt scheinst du viel lockerer zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490112,
					"content": "Haha ... Danke, dass du das sagst. Ich genieße das Leben in letzter Zeit tatsächlich viel mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490113,
					"content": "Und was ist mit dir, Fräulein Guillotin? Bist du mit deinem jetzigen Lebensstil zufrieden? Ich meine, im Vergleich zu damals, als du Fontaine verlassen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490114,
					"content": "Alles läuft gut, aber ich denke, das liegt vor allem daran, dass ich meine Einstellung geändert habe. Ehrlich gesagt habe ich Fontaine schon immer gemocht, und es hat sich immer wie mein Zuhause angefühlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490115
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490115,
					"content": "Ich sage nicht, dass es besser als andere Nationen ist, aber ich verbinde so viele Erinnerungen damit. Das Leben hier kann so ruhig wie stilles Wasser sein, aber es kann auch voller neuartiger Veränderungen stecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490116,
					"content": "In letzter Zeit habe ich gelernt, die schönen Seiten des Lebens zu sehen. Ich nehme an, dass die Menschen an anderen Orten ihre Heimat ganz ähnlich sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490117
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490117,
					"content": "Ohh ... Wie schön du das gesagt hast, Fräulein Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490118
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490118,
					"content": "Das ist vielleicht ein kleiner Verstoß gegen die Etikette einer Teegesellschaft, aber ... Stoßen wir doch an. Und zwar auf Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490119
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490119,
					"content": "Haha ... Auf unsere Heimat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
		{
