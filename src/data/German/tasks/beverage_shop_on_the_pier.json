			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220101,
					"content": "Willkommen, was möchtet ihr zwei trinken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220102
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220102,
					"content": "Ihr seht nicht so aus, als ob ihr von hier seid. Ich weiß nicht, ob mein Tee euch schmecken wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220103
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220103,
					"content": "Ich mache euch erst einmal eine Kanne weißen Yunlai-Tee. Wenn ihr es nicht gewohnt seid, könnt ihr später wiederkommen. Bis dahin sollte ich jemanden gefunden haben, der auf dem Weinlesefest der Mondstadt eine Auswahl an Getränkespezialitäten für mich besorgen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220104,
						705220105
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220104,
					"content": "Dankeschön, aber wir sind keine Gäste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220106
					]
				},
				{
					"id": 705220106,
					"content": "Oh ja, wir sind zuverlässige Gehilfen! Wir haben gehört, dass du einen Auftrag auf dem Weinfest ausgeschrieben hast, und einen Kenner suchst, der Getränke für dich bestellt, also sind wir zu dir gekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220107,
					"content": "Sag uns einfach, welche Getränke du bestellen möchtest, und wir werden die Bestellung für dich aufgeben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220108,
					"content": "Um für Gäste etwas zu bestellen ... seid ihr extra nach Liyue gekommen? Ihr seid ja wirklich zu freundlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220109
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220109,
					"content": "Und ich hatte schon befürchtet, dass niemand so eine schwere Aufgabe übernehmen will ... Also, ich zähle auf euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220110
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220110,
					"content": "Ich habe von Matrosen, die in Mondstadt waren, gehört, dass „Minzbeere“, das Spezialgetränk der <color=#00E1FFFF>Taverne Zum Katzenschwanz</color>, erfrischend und beruhigend zugleich sein soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220111
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220111,
					"content": "Deshalb möchte ich <color=#00E1FFFF>fünfundsechzig Kisten „Minzbeere“</color> bestellen und sie zusammen mit den anderen Getränken an die Seeleute verkaufen. Das hält sie bei guter Laune und ermöglicht es ihnen, effizient zu arbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220112
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220112,
					"content": "Früher haben die Händler von Mondstadt nach meinen Bedürfnissen Äquivalente für mich vorbereitet. Dieses Mal habe ich mich entsprechend der Gewohnheiten des Weinlesefests rechtzeitig mit „Weingelee“ eingedeckt, ich gebe es dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220113
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220113,
					"content": "Mein Beschaffungsmittel ist großzügig berechnet, der Überschuss soll der Lohn für eure Mühe sein, auch wenn es nicht reicht, euch meinen Dank auszudrücken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220114,
						705220115
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220114,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220116
					]
				},
				{
					"id": 705220116,
					"content": "#Keine Sorge. Also fünfundsechzig Kisten „Minzbeere“! Überlass die Bestellung {NICKNAME} und Paimon, wir sind schon Experten darin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220117,
					"content": "Wir sind bald zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220115,
					"content": "Nur eine Kleinigkeit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220116
					]
				},
				{
					"id": 705220105,
					"content": "Wir sind hier, um beim Einkauf von Getränken zu helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220106
					]
				}
			]
		},
		{
			"id": 7052202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7052202",
							"2"
						],
						"stepId": 7052202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diane"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220201,
					"content": "Willkommen am Stand der Taverne „Zum Katzenschwanz“! Gibt es etwas, das ihr zwei gerne kaufen möchtet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220202
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220202,
					"content": "Hallo, Fräulein Diane. Wir sind mit einer großen Bestellung zu dir gekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220203,
					"content": "Ihr erklärt Diane, was Quqing kaufen möchte.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705220204
					]
				},
				{
					"id": 705220204,
					"content": "Oh? Der neue Laden an der nördlichen Anlegestelle in Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220205
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220205,
					"content": "Die Matrosen vom Dornmannshaven haben auch von der Inhaberin gesprochen. Ich glaube, Margaret hat auch Rohmaterialien bei ihr gekauft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220206
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220206,
					"content": "Als Quqing kürzlich an der Anlegestelle Getränke an die Matrosen verkauft hat, hat sie diese auch gebeten, für das Quellwasser aus dem Qingce-Dorf zu werben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220207
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220207,
					"content": "Sie kauft das Wasser aus dem Qingce-Dorf zu einem hohen Preis und verkauft es dort, wo es gebraucht wird. Dabei macht sie nur einen minimalen Gewinn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220208
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220208,
					"content": "Durch ihre Vermittlung können Auswärtige mit dem Quellwasser aus dem Qingce-Dorf einzigartige Weine herstellen und die Alten aus dem Qingce-Dorf verdienen auch gut dabei. Zwei Fliegen mit einer Klappe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220209
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220209,
					"content": "Also gibt es auch eine Hintergrundgeschichte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220210
					]
				},
				{
					"id": 705220210,
					"content": "Frau Quqing ist wirklich ein guter Mensch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220211,
					"content": "Ja, vielleicht wird die Taverne Zum Katzenschwanz langfristig mit ihr zusammenarbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220212
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220212,
					"content": "Also, zurück zum Geschäft. Wie viel wollt ihr für so viele „Minzbeere“ ausgeben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diane"
				}
			]
		},
		{
			"id": 7052203,
			"completionStepIds": [
				7052203
			],
