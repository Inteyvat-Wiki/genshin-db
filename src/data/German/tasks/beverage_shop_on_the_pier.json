			"dialogs": [
				{
					"id": 705222101,
					"content": "Äh ... Ihr macht Witze, oder? Aber wir machen hier Geschäfte, bitte kommt mir nicht mit so lächerlichen Zahlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diane"
				}
			]
		},
		{
			"id": 7052222,
