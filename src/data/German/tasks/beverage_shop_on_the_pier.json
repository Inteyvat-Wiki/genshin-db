			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220401,
					"content": "Ich zähle auf euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220402
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220402,
					"content": "Mit diesen Spezialgetränken können die Matrosen ihren Durst löschen und der neue Geschmack wird sie wieder aufpäppeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220403,
						705220406,
						705220409
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220403,
					"content": "Geschmack?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220404
					]
				},
				{
					"id": 705220404,
					"content": "Die Matrosen haben unterschiedliche Geschmäcker. Manche mögen leichten Tee, manche mögen süßsauren Fruchtsaft ... Wenn man immer das Gleiche trinkt, wird es einem langweilig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220405
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220405,
					"content": "Deshalb stocke ich mein Angebot öfters mit Getränken verschiedener Geschmacksrichtungen auf, um die Wünsche der Matrosen zu befriedigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220406,
					"content": "Über den Laden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220407
					]
				},
				{
					"id": 705220407,
					"content": "Weil mir die Matrosen einen großen Gefallen getan haben, habe ich kürzlich hier an der Anlegestelle einen Laden eröffnet und biete ihnen Getränke an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220408
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220408,
					"content": "Aber ich bin nicht sehr erfahren und der Laden läuft nicht so gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220409,
					"content": "Wir sehen uns später!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220410
					]
				},
				{
					"id": 705220410,
					"content": "Auf Wiedersehen! Gute Reise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quqing"
				}
			]
		},
		{
			"id": 7052221,
