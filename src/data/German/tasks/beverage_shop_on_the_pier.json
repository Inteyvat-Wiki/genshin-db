			},
			"dialogs": [
				{
					"id": 705222201,
					"content": "Tut mir leid, aber dieses Angebot ist mir noch zu gering, wenn Fräulein Margaret das hört, wird sie mich anpfeifen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
