			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yoimiya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120140101,
					"content": "Ich glaube, ich bleibe noch ein bisschen länger hier. Die Schau ist in meinem Herzen noch nicht ganz vorbei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140102
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140102,
					"content": "Oh, aber wenn du plaudern möchtest, bin ich gerne dazu bereit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140103,
						120140108,
						120140115
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140103,
					"content": "Hast du danach noch etwas vor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140104
					]
				},
				{
					"id": 120140104,
					"content": "Matsuzaka und die anderen warten immer noch auf mich, damit wir den Großen Mujina-Youkai jagen können. Ich bin wie eine große Schwester für sie, also kann ich mein Wort nicht brechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140105
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140105,
					"content": "Außerdem möchte ich alle fragen, was sie von dem Feuerwerk halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140106,
					"content": "Und in den nächsten Tagen möchte ich mich auch bei allen für ihre Unterstützung bedanken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140107
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140107,
					"content": "Das schließt dich und Paimon natürlich auch ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140108,
					"content": "Ist Feuerwerk teuer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140109
					]
				},
				{
					"id": 120140109,
					"content": "Für euch Jungs ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140110
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140110,
					"content": "Ich mache es umsonst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140111
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140111,
					"content": "Immerhin habe ich es dir irgendwie aufgezwungen. Ganz zu schweigen davon, dass ich dich mitgeschleppt und dir auf dem Weg dorthin jede Menge Ärger bereitet habe. Hehe, ich würde mich schlecht fühlen, wenn ich dir irgendwelche Mora berechnen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140112
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140112,
					"content": "Bist du sicher? Ich fühle mich schlecht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140113
					]
				},
				{
					"id": 120140113,
					"content": "#Es ist in Ordnung. Schau, wie wäre es, wenn wir einen Handel machten: Wenn du {F#deinen Bruder}{M#deine Schwester} gefunden hast, sagst du {F#ihm}{M#ihr}, dass {F#er}{M#sie} zu Naganoharas Feuerwerksartikel kommen soll, wenn {F#er}{M#sie} Feuerwerk braucht. Auf diese Weise bekomme ich einen weiteren Kunden. Klingt das gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140114
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140114,
					"content": "#Außerdem wäre es schön, {F#ihn}{M#sie} kennenzulernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140115,
					"content": "Was ist, wenn die Tenryou-Verwaltung dir noch mehr Ärger macht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140116
					]
				},
				{
					"id": 120140116,
					"content": "Ich werde ihnen wieder in den Hintern treten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140117
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140117,
					"content": "Hahaha, ich mache nur Spaß. Habe ich dir nicht erzählt, dass meine Familie viel mit der Verwaltung zu tun hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140118
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140118,
					"content": "Wir haben es leicht genug. Schlimmstenfalls müssen wir uns entschuldigen, lächeln und eine Strafe zahlen. Das wäre nicht das Ende der Welt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140119
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140119,
					"content": "Ihr zwei solltet allerdings vorsichtig sein. Ohne die gleichen Verbindungen könnt ihr es euch nicht leisten, so leichtsinnig zu sein wie ich, hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		}
	]
}