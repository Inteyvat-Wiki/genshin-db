				{
					"id": 210290101,
					"content": "Juhu! Wie ... Wie konnte es wieder scheitern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210290102
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210290102,
					"content": "Was tust du denn hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210290103
					]
				},
				{
					"id": 210290103,
					"content": "Du bist es, hallo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210290104
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210290104,
					"content": "Hast du mir beim letzten Mal nicht beigebracht, wie man kocht? Ich versuche, dieses Gericht zuzubereiten, aber ... bisher ist es mir nicht gelungen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210290105
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210290105,
					"content": "Vielleicht liegt es daran, dass ich nicht die richtigen Kochzutaten verwende ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210290106
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210290106,
					"content": "Kannst du es mir nochmal zeigen?",
