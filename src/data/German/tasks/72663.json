			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726630101,
					"content": "Da bist du ja. Tut mir leid, dich schon wieder belästigen zu müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630102
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630102,
					"content": "Du siehst ziemlich glücklich aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630103
					]
				},
				{
					"id": 726630103,
					"content": "Haha, ich habe die Sache durchdacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630104
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630104,
					"content": "Vielleicht kann man manche Dinge einfach nicht erzwingen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630105
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630105,
					"content": "Kannst du mich heute Abend zum westlichen Strand begleiten? Ich habe etwas für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630106
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630106,
					"content": "Oh, etwa eine Art Meeresschatz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630107,
					"content": "Du wirst dann schon sehen, was es ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		},
		{
			"id": 7266302,
			"completionStepIds": [
				7266304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266304",
							"2"
						],
						"stepId": 7266304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726630201,
					"content": "Da sind wir. Hier ist mein Vater in dem Jahr das letzte Mal zur See gefahren. Es war auch genau so eine Nacht wie heute ... und danach habe ich ihn nie wieder gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630202
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630202,
					"content": "Du vermisst ihn sehr, oder? Wünschst du dir, deinen Vater wiederzusehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630203,
					"content": "Haha, ich vermisse ihn wirklich, aber echte Seemänner müssen irgendwann zur See zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630204
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630204,
					"content": "Aber mein Wunsch ist es, als Fischerin meinen Vater zu übertreffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630205
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630205,
					"content": "Als ich jung war, wollte ich immer mit meinem Vater segeln gehen, doch er hat mich immer wieder mit meiner Mutter nach Hause geschickt. Manchmal hat er sogar den Sohn vom Nachbarn mitgenommen, aber er war nie bereit, mich mitzunehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630206
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630206,
					"content": "Er sagte immer: „Momiji, treib dich nicht am Strand herum, mach etwas, was Mädchen machen sollten“. Oder er sagte: „Nimm das Geld und kauf dir ein Kleid, lauf nicht immer zum Boot“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630207
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630207,
					"content": "Doch ich verstand nicht warum. Was sind Sachen, die „Mädchen machen sollten“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630208
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630208,
					"content": "Ich kann Süßigkeiten kaufen, Blumen pflücken und eine kleine Prinzessin sein,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630209
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630209,
					"content": "aber ich kann keine Abenteuer erleben, weit auf das Meer hinaus segeln und den Ozean erkunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630210
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630210,
					"content": "Je mehr mein Vater nicht wollte, dass ich es mache, desto mehr wollte ich es. Nachdem mein Vater gegangen war, wurde ich Fischerin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630211
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630211,
					"content": "Die Meere, die er nicht erkunden konnte, die werde ich dann eben erkunden. Die großen Fische, die er nicht fangen konnte? Die fange ich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630212
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630212,
					"content": "Ich pflege die Fischereitechniken der Kujirai-Familie. Ich trage den Namen der Kujirai-Familie als Fischerin weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630213
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630213,
					"content": "Selbst wenn die Legende des „Mond-Leviathans“ nur eine Legende ist, ich höre nicht auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630214
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630214,
					"content": "Ich glaube fest an deinen Erfolg.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630215
					]
				},
				{
					"id": 726630215,
					"content": "Danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630216
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630216,
					"content": "Da der göttliche Fisch nicht auftaucht, werde ich meine Wünsche an das Meer übergeben. Ich denke, mein Vater wird sie sehen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630217
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630217,
					"content": "Hast du auch Wünsche? Machen wir es zusammen! Schreib deine Wünsche auf, steck sie in eine Flaschenpost und schmeiß sie mit aller Kraft über Bord. Eines Tages werden sie wahr werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630218
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630218,
					"content": "Oho! Klappt das wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630219,
					"content": "Aber Paimon hat so viele Wünsche, welchen soll Paimon da nur aufschreiben ... Paimon ist hin- und hergerissen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630220,
					"content": "Entschuldigt, dass ich euch in dieser Zeit belästigen muss! Ich weiß gar nicht, wie ich euch danken soll. Hier sind ein paar Geschenke, ich hoffe, das ist in Ordnung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630221
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630221,
					"content": "Oh, schau mal, was ist das denn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630222,
					"content": "Was für ein großer Fischschwarm! Sie leuchten sogar ... und sie scheinen unsere Flaschenpost zu mögen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630223,
					"content": "Wenn sich diese Kerlchen an einer Stelle sammeln, sieht es aus wie ein großer Mond im Meer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630224,
					"content": "Diese ... Diese Fische, das sind „Mondflossen“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630225
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630225,
					"content": "Oh! Ich verstehe ... Ich verstehe! Das ist also der „Mond-Leviathan“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630226
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630226,
					"content": "Hä? Das ist der „Mond-Leviathan“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630227,
					"content": "Ja, ich könnte niemals vergessen, wie der Schatten damals ausgesehen hat. Diese kleinen Punkte aus Mondlicht ... Damals tauchte der „Mond-Leviathan“ auch auf, als Jiawei seine Flaschenpost ins Meer warf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630228
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630228,
					"content": "Kein Wunder, dass auch nach all diesen Jahren niemand in der Lage war, den „Mond-Leviathan“ zu fangen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630229
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630229,
					"content": "Es stellt sich heraus, dass es nur ein Schwarm „Mondflossen“ ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630230
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630230,
					"content": "Diese „Mondflossen“ ... Wer hätte gedacht, dass sie so auf normale Flaschenpost stehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630231
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630231,
					"content": "Hehe, vielleicht mögen sie die Wünsche, die die Menschen in die Flaschen stecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630232,
					"content": "Haha! Vielleicht! Nun denn, seht zu, wie Kujirai Momiji sie alle fangen wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630233
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630233,
					"content": "Wir möchten mitkommen, lass uns helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630234,
					"content": "Wenn das so ist, möchte ich euch diese Angelrute geben. Sie wurde speziell von der Kujirai-Familie angefertigt, um den „Mond-Leviathan“ zu fangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630235
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630235,
					"content": "Obwohl das meine Dankbarkeit euch gegenüber nicht einmal im geringsten widerspiegelt, ist es doch ein kleines Zeichen dieser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630236
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630236,
					"content": "Fangen wir all die „Mondflossen“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		}
	]
}