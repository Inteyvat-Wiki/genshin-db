			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuzu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130301,
					"content": "Hallo, was ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130302
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130302,
					"content": "Hallo zusammen. Hast du zufälligerweise „Onibudou“ gelesen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130303
					]
				},
				{
					"id": 220130303,
					"content": "Hm? Habe ich und ich mochte es, aber ... Wie soll ich es sagen? Die Handlung wirkt in letzter Zeit etwas seltsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130304
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130304,
					"content": "Der Protagonist erhält ständig neue Fähigkeiten und kann mit ihnen den Gegner sofort besiegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130305
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130305,
					"content": "Ich mochte „Onibudou“ wegen der cleveren Methoden, die der Protagonist anwandte, um seine Feinde zu besiegen, aber jetzt ... fühlt es sich an, als ob der Autor einfach nur faul wäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130306
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130306,
					"content": "Außerdem werden die meisten Fähigkeiten, die der Protagonist bekommt, nur einmal benutzt. Das lässt die Geschichte so ... oberflächlich erscheinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130307
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130307,
					"content": "Ich weiß wirklich nicht, was sich der Autor dabei denkt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130308
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130308,
					"content": "Ähem ... nun ... lass uns noch ein paar Leute fragen, oder? Das muss ein merkwürdiger Fall sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
			"id": 2201304,
			"completionStepIds": [
				2201303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201303",
							"2"
						],
						"stepId": 2201303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hasegawa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130401,
					"content": "Hallo, gibt es etwas, womit ich dir helfen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130402
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130402,
					"content": "Ja, das gibt es. Hast du jemals „Onibudou“ gelesen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130403
					]
				},
				{
					"id": 220130403,
					"content": "Ja, das habe ich! Es ist ein sehr interessanter Roman. Die Figuren und die Handlung sind wunderbar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130404
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130404,
					"content": "Aber ... Ich habe das Gefühl, dass der Autor in letzter Zeit etwas nachgelassen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130405
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130405,
					"content": "Oh ... Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130406
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130406,
					"content": "Es gibt all diese neuen Kräfte, die plötzlich auftauchen, ohne dass jemals zuvor darauf Bezug genommen wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130407
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130407,
					"content": "Obwohl es „Erwachen“ genannt wird, wirkt es einfach nur billig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130408
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130408,
					"content": "Ich finde einfach, dass diese Art von billiger Handlung den Protagonisten auch billig aussehen lässt. Ich hoffe wirklich, dass der Autor diesen Kurs noch einmal überdenkt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130409
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130409,
					"content": "#{F#Reisende}{M#Reisender}, lass uns ... lass uns jemand anderen fragen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
			"id": 2201305,
			"completionStepIds": [
				2201304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
