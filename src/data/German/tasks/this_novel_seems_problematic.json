			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130501,
					"content": "Hallo, bist du bereit für eine Unterhaltung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130502
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130502,
					"content": "In der Tat. Hast du zufälligerweise „Onibudou“ gelesen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130503
					]
				},
				{
					"id": 220130503,
					"content": "Ich schon. Ich mag den Protagonisten auch sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130504
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130504,
					"content": "Aber in letzter Zeit fällt es mir schwer, es zu lesen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130505
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130505,
					"content": "Wieso schwer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130506
					]
				},
				{
					"id": 220130506,
					"content": "In den letzten Kapiteln wurde der Protagonist plötzlich mit all diesen neuen Fähigkeiten beschenkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130507
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130507,
					"content": "Die Geschichte verbringt viel Zeit damit, darüber zu sprechen, wie diese Fähigkeiten erwacht sind und wie sie genutzt werden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130508
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130508,
					"content": "Und die Namen dieser Fähigkeiten werden immer schwieriger zu folgen. Ich kann mich an keine von ihnen erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130509
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130509,
					"content": "Wenn ich weiterlese, glaube ich nicht, dass ich der Geschichte folgen kann, ohne diese Fähigkeiten zu verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130510
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130510,
					"content": "*seufz* Ich habe darüber nachgedacht, dem Buch eine Pause zu gönnen und zu etwas zu wechseln, das etwas leichter zu folgen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130511
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130511,
					"content": "Äh ... Lass uns ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130512
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130512,
					"content": "Lass uns zurückgehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130513
					]
				},
				{
					"id": 220130513,
					"content": "Gut ... Ich verstehe nicht, warum das passiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
