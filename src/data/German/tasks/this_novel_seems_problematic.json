	"talks": [
		{
			"id": 2201301,
			"completionStepIds": [
				2201301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201301",
							"2"
						],
						"stepId": 2201301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130101,
					"content": "Hast du die Lesermeldungen gelesen? Unsere Bewertungen sind in letzter Zeit stark gesunken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130102
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130102,
					"content": "Mach dir keine Sorgen. Das ist nur die Ruhe vor dem großen Höhepunkt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130103
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130103,
					"content": "Wenn der entscheidende Handlungspunkt enthüllt wird, werden wir einen echten Umschwung in diesen Rezensionen sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130104
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130104,
					"content": "Und was nützt das, wenn dein Roman schon lange vor deiner Ankunft gestrichen wird?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130105
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130105,
					"content": "Was ist hier los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130106
					]
				},
				{
					"id": 220130106,
					"content": "#{F#Reisende}{M#Reisender}, gut, dass du da bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130107
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130107,
					"content": "Junkichi hat dem Protagonisten in „Onibudou“ noch viel mehr wilde Fähigkeiten hinzugefügt. Seit seinem „Inspirationstrip“ kommt eins zum anderen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130108
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130108,
					"content": "Das Verlagshaus Yae hat eine Menge negative Meldungen von Lesern erhalten, die sagen, dass sie nicht verstehen, warum diese Fähigkeiten auftauchen. Sie denken, dass der Autor die Geschichte nicht ernst nimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130109
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130109,
					"content": "Sie wissen nicht, wovon sie reden. Ich schreibe einfach weiter, irgendwann werden sie es kapieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130110
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130110,
					"content": "Wie ich schon sagte, dein Roman wird gestrichen, bevor du zu diesem Punkt kommst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130111
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130111,
					"content": "Ach, was soll’s ... Soweit ich mich erinnere, gibt es ein paar Leser von „Onibudou“ in dieser Gegend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130112
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130112,
					"content": "Warum gehst du nicht hin und fragst sie, ob deine Idee durchgeht oder nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130113
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130113,
					"content": "#Gut! Ich bin mir sicher, dass sie es trotzdem bekommen werden. {F#Reisende}{M#Reisender}, komm mit mir. Ich werde einen Zeugen brauchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130114,
					"content": "#Ja, das klingt gut. Nimm {F#die Reisende}{M#den Reisenden} mit. Auf diese Weise kannst du später nicht leugnen, was sie sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130115
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130115,
					"content": "Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130116
					]
				},
				{
					"id": 220130116,
					"content": "Gut, lasst uns loslegen. Ich bin sicher, meine Leser werden mich verstehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130117,
					"content": "Wie viele Merkmale wurden hinzugefügt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130118
					]
				},
				{
					"id": 220130118,
					"content": "Nur ... nur ein bisschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130119
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130119,
					"content": "„Ein bisschen“? Der Protagonist wird bald mehr Fähigkeiten haben als jeder andere in der Geschichte zusammen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130120
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130120,
					"content": "Ähem! Lass uns loslegen. Ich bin mir sicher, dass meine Leser es kapieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
