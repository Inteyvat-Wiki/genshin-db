				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130601,
					"content": "Na gut, und wie ist es gelaufen? Hast du die Erwartungen der Leser ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130602
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130602,
					"content": "Warte, warum sieht er so deprimiert aus ... was für Rückmeldungen hast du bekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130603
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130603,
					"content": "*seufz* ... Also, Junkichi, wirst du die Rückmeldungen jetzt annehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130604
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130604,
					"content": "Ich kann es nicht glauben ... Wie konnte das passieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130605
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130605,
					"content": "Sind meine Ideen ... und mein Schreiben ... nicht interessant genug?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130606
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130606,
					"content": "Wie ich schon sagte, kann es gefährlich sein, die Handlung voranzutreiben, nur indem man dem Protagonisten neue Kräfte gibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130607
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130607,
					"content": "Die neuen Eigenschaften sind vielleicht momentan beliebt, aber sobald die Neuheit nachlässt, werden sich die Leser langweilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130608
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130608,
					"content": "Hier spricht die jahrelange Erfahrung aus dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130609
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130609,
					"content": "Ich weiß ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130610
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130610,
					"content": "Es ist aber noch nicht zu spät, das zu ändern ... Wir können die Kritiken der vorherigen Kapitel nicht rückgängig machen, aber wir können die folgenden Kapitel wieder auf eine solide Basis stellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130611
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130611,
					"content": "#Danke, {F#Reisende}{M#Reisender}. Es ist tatsächlich besser, ihn jetzt einen Schlag einstecken zu lassen. Wenn er weiter so schreiben würde, wäre er insgesamt definitiv schlechter dran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130612
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130612,
					"content": "Also, danke schön. Das ist deine Bezahlung. Bitte nimm es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shigeru"
				}
			]
		}
	]
}