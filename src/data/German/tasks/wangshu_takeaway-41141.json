					"content": "Ich habe gehört, es gibt eine Sonderbestellung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411410302
					]
				},
				{
					"id": 411410302,
					"content": "Das stimmt. Hier wohnt ein Gast namens Lingguan. Sie hat vor einer Weile Mandeltofu bestellt und bereits bezahlt. Wir sollen es an einen Ort nördlich des Dihua-Moors bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411410303
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 411410303,
					"content": "Aber da wir im Gasthaus alle Hände voll zu tun haben, konnte ich das Essen nicht selbst liefern. Wenn du mir helfen könntest, wäre das großartig. Du wirst auch angemessen entschädigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lächelnder Yanxiao"
				}
			]
