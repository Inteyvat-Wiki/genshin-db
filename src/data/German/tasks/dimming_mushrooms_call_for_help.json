			"dialogs": [
				{
					"id": 710610501,
					"content": "He, großer Pilzkopf, wir sind wieder da. Uns sind deine – ähm, wie nennst du es – oh, deine Segnungen der Weisheit ausgegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610503,
					"content": "Aber wir haben es geschafft, die Risse zu stopfen. Jetzt ist das Problem gelöst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610504,
					"content": "#Zum Lob von {NICKNAME}, zum Lob von Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610505
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610505,
					"content": "Möge man den gestrigen Tag nicht bedauern und alles Gute für den kommenden Morgen wünschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610506
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610506,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610507
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610507,
					"content": "Es sieht so aus, als ob der große Pilzkopf wieder schläft, also sollten wir ihn besser nicht stören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
