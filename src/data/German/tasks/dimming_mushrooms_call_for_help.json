			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710610201,
					"content": "Ihr gebt etwas der Energie des „Katalysators“ an Xamaran ab.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610202
					]
				},
				{
					"id": 710610202,
					"content": "Waah, der große Pilzkopf leuchtet! Müsste es jetzt nicht „leuchtender großer Pilzkopf“ heißen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610203,
					"content": "#Zum Lob von {NICKNAME}, zum Lob von Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610204
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610204,
					"content": "#Dank {NICKNAME}, dank Paimon hat Xamaran den Glanz des Lebens zurückgewonnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610205
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610205,
					"content": "Aber seid nicht unvorsichtig, denn Xamaran weiß, dass die Quelle der bösen Energie immer noch da ist und jederzeit zurückkommen kann, um ihn heimzusuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610206
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610206,
					"content": "Was tun wir dann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610207,
					"content": "Woher kommt dieser schwarze Schlamm? Ist das die „böse Energie“, von der der große Pilzkopf gesprochen hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7106103,
			"completionStepIds": [
				7106110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
