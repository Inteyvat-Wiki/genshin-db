					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710610301,
					"content": "#Zum Lob von {NICKNAME}, zum Lob von Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610302
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610302,
					"content": "Die Rufe von Xamaran blieben lange Zeit unbeantwortet. Die Vielbeiner und die Vierbeiner natürlich, aber auch die Zweibeiner ignorierten die Hilferufe Xamarans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610303
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610303,
					"content": "#Nur die wirklich Weisen werden dem Ruf von Xamaran folgen. Paimon ist weise und {NICKNAME} ist es auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610304
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610304,
					"content": "Die besten der Zweibeiner verdienen den Dank von Xamaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610323
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610323,
					"content": "Hmpf, Paimon die Weise sollte nicht unterschätzt werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610305,
					"content": "Gar kein Problem!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610306
					]
				},
				{
					"id": 710610306,
					"content": "#Es ist zu erwarten, dass {NICKNAME} und Paimon mit der Zeit auch mit Xamaran und Xamarans Angehörigen vergleichbar werden könnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610307
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610307,
					"content": "Moment, was meint der große Pilzkopf damit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610308,
					"content": "Ein Vielbeiner ist einem Vierbeiner unterlegen, ein Vierbeiner einem Zweibeiner und natürlich ein Zweibeiner einem Beinlosen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610309
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610309,
					"content": "#Obwohl {NICKNAME} und Paimon angeborene Mängel haben, ist es vielleicht nicht unmöglich, den Lauf des Schicksals mit Hingabe und erworbener Anstrengung zu ändern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610310
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610310,
					"content": "Er ist doch nur ein leuchtender großer Pilz, wie kann er nur so arrogant sein! Paimon fragt sich, ob man leuchtende Pilze kochen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610311,
						710610312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610311,
					"content": "Ein Spieß mit Pilzen und Hühnchen, das wäre gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610312,
					"content": "Hübsche Pilze sind trügerisch und müssen giftig sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610313,
					"content": "Paimon hat einen großen Appetit. Heute isst Paimon Pilze, morgen isst Paimon Pilze und nach hundert Tagen gibt es keine Paimon mehr in Paimon, nur noch Pilze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610314
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610314,
					"content": "#Uääh, {NICKNAME}, der große Pilzkopf redet so schrecklich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610315,
					"content": "Oh, Paimon versteht keinen Humor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610316
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610316,
					"content": "Das ist überhaupt kein Humor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610317,
					"content": "Xamaran ist zwar frei von der bösen Energie, aber seine Angehörigen leiden immer noch. Der heutige Xamaran ist zu schwach, um den Schwachen Schutz zu gewähren, wie es in der Vergangenheit der Fall war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610318
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610318,
					"content": "#Xamaran fleht {NICKNAME} an, Gnade walten zu lassen und die Schwachen zu retten, die sich nicht selbst helfen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610319
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610319,
					"content": "#Meinst du, es gibt noch mehr kranke Pilze? {NICKNAME}, werden wir helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610320,
						710610321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610320,
					"content": "Da wir schon hier sind ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610322
					]
				},
				{
					"id": 710610321,
					"content": "Wenn es passt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610322
					]
				},
				{
					"id": 710610322,
					"content": "Dann lass uns losgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610207,
					"content": "Woher kommt dieser schwarze Schlamm? Ist das die „böse Energie“, von der der große Pilzkopf gesprochen hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7106104,
