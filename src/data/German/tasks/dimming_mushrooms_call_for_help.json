			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710610401,
					"content": "#Zum Lob von {NICKNAME}, zum Lob von Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610402
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610402,
					"content": "Es ist peinlich, das zuzugeben, aber das Zweibeinervolk hat ein Sprichwort: „Eine helfende Hand muss die Dinge zu Ende bringen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610403,
						710610405
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610403,
					"content": "Du meinst, mehr Besorgungen machen, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610404
					]
				},
				{
					"id": 710610405,
					"content": "Aber trifft das Sprichwort der Menschen wirklich auf Pilze zu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610406
					]
				},
				{
					"id": 710610404,
					"content": "Du verdienst den Titel „die Weise“ unter den Zweibeinern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610406,
					"content": "Wir sind alle Lebewesen, die in den Segnungen der Erde baden. Da ist es nur natürlich, dass wir uns gegenseitig helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610407,
					"content": "Bitte nimm dies, die Segnungen der Weisheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610408
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610408,
					"content": "Du erhältst die Segnungen der Weisheit.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610409
					]
				},
				{
					"id": 710610409,
					"content": "Uh ... Was ist das? Es sieht so verdächtig aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610410,
					"content": "Xamaran riecht den anhaltenden Geruch der bösen Energie in der Luft, kann aber nicht sagen, woher er kommt. Suche entlang des Wassers und du wirst sie finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610411
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610411,
					"content": "#Die Angehörigen von Xamaran werden sich des Problems annehmen, wenn {NICKNAME} die „Segnungen der Weisheit“ gegen die Quelle der bösen Energie einsetzen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610412,
						710610413
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610412,
					"content": "Die Quelle der bösen Energie ... Das ist in der Tat etwas, das man nicht unbeaufsichtigt lassen kann.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610413,
					"content": "... Aber warum kümmerst du dich nicht selbst darum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610414,
					"content": "#{NICKNAME} ist humorvoller als Paimon. Xamaran hat keine Beine und {NICKNAME} hat welche, also wird die Arbeit mit den Beinen natürlich mit den Beinen erledigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610415
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610415,
					"content": "Außerdem hat Xamaran eine wichtigere Aufgabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610416
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610416,
					"content": "Und was meinst du damit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610417
					]
				},
				{
					"id": 710610417,
					"content": "Xamaran hat zu viel Kraft verbraucht. Es war ein angenehmes Gespräch mit euch beiden, aber Xamaran muss sich jetzt ausruhen, um die Kraft zu sammeln, damit man die böse Energie abwehren und seinen Angehörigen einen Unterschlupf zum Gedeihen bieten kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610418
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610418,
					"content": "#Alles Glück wünsch ich {NICKNAME} und Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610419
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610419,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610420
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610420,
					"content": "He! Großer Pilzkopf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610421,
					"content": "#{NICKNAME}, es sieht so aus, als ob der große Pilzkopf schläft, lass uns gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610207,
					"content": "Woher kommt dieser schwarze Schlamm? Ist das die „böse Energie“, von der der große Pilzkopf gesprochen hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
