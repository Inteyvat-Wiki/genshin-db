			"dialogs": [
				{
					"id": 230060401,
					"content": "Hast du die Umgebung schon gereinigt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060402
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060402,
					"content": "Ja, das habe ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060403
					]
				},
				{
					"id": 230060403,
					"content": "#Ich kann dir nicht genug danken, {M#Reisender}{F#Reisende}. Bitte nimm dies als deine Bezahlung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060404
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060404,
					"content": "Übrigens, in letzter Zeit hat sich Herr Gurgen wieder zur Arbeit gezwungen. Ich sollte vielleicht mehr Zeit damit verbringen, zu versuchen, ihn umzustimmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060405
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060405,
					"content": "Es gibt so viele Dinge, um die ich mich in nächster Zeit kümmern muss, deshalb muss ich dich vielleicht noch mit kommenden Reinigungsarbeiten belästigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				}
			]
		},
