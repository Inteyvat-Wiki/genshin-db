				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Golshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230060101,
					"content": "Ach, wie sollen wir hier jemanden finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060102
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060102,
					"content": "Stimmt etwas nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060103
					]
				},
				{
					"id": 230060103,
					"content": "#Oh! Hallo, {M#Reisender}{F#Reisende}. Entschuldige, aber benötigst du eine Heilbehandlung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060104,
						230060105
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060104,
					"content": "Wir kommen nur zufällig hier vorbei ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				},
				{
					"id": 230060106,
					"content": "Hehe ... Ist das so offensichtlich? Nun, ich mache mir über etwas Sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060107
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060107,
					"content": "Ich weiß nicht warum, aber in letzter Zeit bekommen wir immer mehr Anfragen für eine Heilbehandlung im „Bimarstan“, fast unser gesamtes Personal hat alle Hände voll zu tun, um sich um die Patienten zu kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060108
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060108,
					"content": "Trotzdem bestand Doktor Zakariya darauf, dass ich einen Weg finde, die Umgebung sauber zu halten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060109
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060109,
					"content": "Er sagte, nur wenn das Krankenhaus und die Patienten sauber gehalten würden, könnten sie den Segen der Göttin der Pflanzen erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060110
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060110,
					"content": "Oje, aber im Moment gibt es keine zusätzlichen Helfer. Ich kann ja schlecht die Patienten mit leichten Symptomen bitten, auszuhelfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060111,
						230060113
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060111,
					"content": "Wie wäre es, wenn du mir das überlässt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060112
					]
				},
				{
					"id": 230060112,
					"content": "Du würdest helfen? Das ist sehr nett von dir! Ich werde dir eine Bezahlung geben. Aber mach dir keine zu großen Hoffnungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060123,
					"content": "Ach, möge die Göttin der Pflanzen die Menschen vor Krankheit bewahren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060113,
					"content": "Kannst du nicht einfach jemanden einstellen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060114
					]
				},
				{
					"id": 230060114,
					"content": "Schließlich haben wir hier nur Patienten. Es gibt nicht viele, die hier freiwillig arbeiten möchten. Unsere Mittel sind auch begrenzt, deshalb können wir einfach nicht viele Leute einstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060115
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060115,
					"content": "Normalerweise würden wir in Schichten für die Reinigung arbeiten, aber momentan ist viel los, deshalb ist niemand frei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060116
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060116,
					"content": "#{M#Reisender}{F#Reisende}, könntest du ... könntest du mir diesen Gefallen tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060117
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060117,
					"content": "Wir werden dich bezahlen! Aber ... es wird nicht allzu viel sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060118
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060118,
					"content": "Die Krankheiten hier ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060119
					]
				},
				{
					"id": 230060119,
					"content": "Die meisten Patienten hier haben nur kleinere Beschwerden wie Kopfschmerzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060120
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060120,
					"content": "Doktor Zakariya hat den Leuten schon oft erklärt, dass diese Krankheiten nicht so beängstigend sind, wie sie denken, aber keiner glaubt ihm das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060121
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060121,
					"content": "Ich glaube, es ist nicht die Krankheit selbst, vor der die Menschen Angst haben, sondern die Tatsache, dass sie eine haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060122
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060122,
					"content": "#Dann überlasse ich dir das Saubermachen, {M#Reisender}{F#Reisende}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060105,
					"content": "Nur weil du so besorgt aussiehst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				}
			]
		},
