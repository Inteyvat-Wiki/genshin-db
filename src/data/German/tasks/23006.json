	"talks": [
		{
			"id": 2300601,
			"completionStepIds": [
				2300601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300601",
							"2"
						],
						"stepId": 2300601,
						"stateName": "QUEST_STATE_UNFINISHED"
