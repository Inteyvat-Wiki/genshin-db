			"dialogs": [
				{
					"id": 230060301,
					"content": "#{M#Reisender}{F#Reisende}, gibt es noch etwas, das du mich fragen willst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060302,
						230060306
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060302,
					"content": "Über Doktor Zakariya ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060303
					]
				},
				{
					"id": 230060303,
					"content": "Doktor Zakariya ist ein großartiger Arzt und ein treuer Anhänger der Göttin der Pflanzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060304
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060304,
					"content": "Er behandelt Patienten oft rund um die Uhr und hat dabei sogar selbst zum Essen kaum Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060305
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060305,
					"content": "Doktor Zakariya sagte auch, dass es seine Pflicht wäre, die Segnungen der Göttin der Pflanzen an noch mehr Menschen weiterzugeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060306,
					"content": "Spielt der Segen der Göttin der Pflanzen wirklich so eine große Rolle bei eurer Heilkunst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060307
					]
				},
				{
					"id": 230060307,
					"content": "Um genau zu sein, steht die gesamte „Heilung von Krankheiten“ unter dem Segen der Göttin der Pflanzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060308
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060308,
					"content": "Die Göttin der Pflanzen hat uns mit der Fähigkeit gesegnet, Heilmittel für Patienten zu finden und Kräuter zur Behandlung von Krankheiten anzubauen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060309
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060309,
					"content": "Wir danken der Göttin der Pflanzen für den Segen. Mögen alle von Krankheiten verschont bleiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				}
			]
		},
