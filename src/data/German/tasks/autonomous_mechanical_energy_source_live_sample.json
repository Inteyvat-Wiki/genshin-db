			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hosseini"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700280301,
					"content": "Und wie läuft’s? Arbeiten die Lichtnägel ordnungsgemäß?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280302
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280302,
					"content": "Alles normal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280303
					]
				},
				{
					"id": 700280303,
					"content": "Also, wenn alles in Ordnung ist, ist das der beste Fall, und hoffentlich gibt es auch in Zukunft keine Pannen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280304
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280304,
					"content": "Sobald ein spezieller Apparat im Wirkungsbereich der Lichtnägel auftaucht, wird seine Energiezufuhr unterbrochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280305
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280305,
					"content": "Dieses Mal solltest du in der Lage sein, es zu besiegen, loszulassen, mach das so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280306
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280306,
					"content": "Ich glaube an deine Stärke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				}
			]
		}
	]
}