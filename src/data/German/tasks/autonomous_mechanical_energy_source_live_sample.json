			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hosseini"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700280101,
					"content": "Dank deiner Versuchsdaten ist die endgültige Kalibrierung der „Pursina-Lichtnägel“ abgeschlossen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280102,
					"content": "Jetzt habe ich volles Vertrauen, dass sie beständig laufen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280103,
					"content": "Indem wir die „Pursina-Lichtnägel“ an einem Ort platzieren, der von der Eigenheit frequentiert wird, können wir ihre Energieversorgung unterbrechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280104,
					"content": "Sobald die Lichtnägel aktiviert sind, kann sich der Körper nicht mehr wiederholt selbst reparieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280105,
						700280107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280105,
					"content": "Danke dir für deine Hilfe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280106
					]
				},
				{
					"id": 700280106,
					"content": "Das Verdienst liegt nicht bei mir, sondern bei dem Wissen, das unsere Vorfahren uns hinterlassen haben und für das wir dankbar sein sollten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280109,
					"content": "Ohne die Anleitung durch dieses Wissen wäre ich nicht in der Lage gewesen, einen Weg zu finden, diesen besonderen Mechanismus in irgendeiner Weise zu bändigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280110,
					"content": "Alles, was wir tun, hängt vom Wissen ab. Wissen ist die wichtigste Ressource auf dieser Welt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280111,
					"content": "Das hört sich schwer zu verstehen an.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280112
					]
				},
				{
					"id": 700280112,
					"content": "Es ist nur natürlich, dass du diese grundlegendste Wahrheit nicht verstehst. Du bist schließlich nicht mit der höchsten Weisheit durchdrungen worden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280113
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280113,
					"content": "Es hat viel Arbeit gekostet, die „Pursina-Lichtnägel“ zu reparieren, und ich habe mich eine Zeit lang ein bisschen aufgeregt, haha, ich habe mich ein bisschen hinreißen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280114
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280114,
					"content": "Wir hatten nur noch eine letzte Aufgabe vorzubereiten, nämlich nach Seirai zu fahren, um die „Pursina-Lichtnägel“ aufzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280115
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280115,
					"content": "In diesem Fall kann ich leider nicht helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280116
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280116,
					"content": "Nach den örtlichen Vorschriften von Inazuma dürfen sich Leute wie ich, die noch nicht einmal das Aufenthaltsverfahren abgeschlossen haben, nicht frei bewegen, also musst du den Auftrag machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280117
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280117,
					"content": "Ich verstehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280118
					]
				},
				{
					"id": 700280118,
					"content": "Dann hängt es von dir ab. Ich schlage vor, dass du nichts überstürzt, nachdem die Einrichtung abgeschlossen ist, und einfach beobachtest, ob alles in Ordnung ist, bevor du mit mir sprichst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280119
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280119,
					"content": "Zu deiner Sicherheit sollten wir vorsichtig sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280107,
					"content": "Danke an die Macht der Technik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280108
					]
				},
				{
					"id": 700280108,
					"content": "Wir sollten dankbar sein für das Wissen, das uns unsere Vorfahren hinterlassen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280109
					],
					"speakerTitle": "Hosseini"
				}
			]
		},
		{
			"id": 7002803,
			"completionStepIds": [
				7002803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
