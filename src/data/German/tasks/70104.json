			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Esther"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701040201,
					"content": "Hast du meine Messbaken gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040202
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040202,
					"content": "Das habe ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040203
					]
				},
				{
					"id": 701040203,
					"content": "Lass mich sehen ... Ja, das sind sie, genau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040204
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040204,
					"content": "Ah, sieh sie dir nur an ... Diese Monster waren ganz offensichtlich nicht gerade behutsam mit ihnen. Aber zum Glück sind sie nicht völlig ruiniert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040205
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040205,
					"content": "*seufz* Ich werde sie aber wohl in naher Zukunft nicht mehr benutzen ... Ah, da kann man wohl nichts mehr machen. Ich werde mich mit einer kleineren Erhebung begnügen müssen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040206
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040206,
					"content": "Ich habe noch ein paar andere Messbaken hier. Würdest du sie für mich auf dem Berg aufstellen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040207,
						701040209
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040207,
					"content": "Wo genau?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040208
					]
				},
				{
					"id": 701040208,
					"content": "Ist das ein Ja? Ich betrachte das als ein Ja! Danke! Ich werde die Stelle auf der Karte für dich markieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040215
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040215,
					"content": "So, das ist jetzt eindeutig markiert. Stelle die Baken einfach in dort in die Nähe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040216
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040216,
					"content": "Achte darauf, dass du sie an hohen Stellen aufstellst. Je höher die Lage, desto genauer ist die Vermessung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040209,
					"content": "Warum kannst du es nicht selbst erledigen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040210
					]
				},
				{
					"id": 701040210,
					"content": "Ich traue mich das nicht ... Wenn nicht mal ein ganzer Forschertrupp diesen Monstern Paroli bieten kann, werde ich ganz sicher nicht allein zurück nach oben gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040211
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040211,
					"content": "Ich finde derzeit keine anderen Forscher, die eine Reise dorthin unternehmen wollen, aber ich kann das auch nicht unbegrenzt verzögern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040212
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040212,
					"content": "Du bist die einzige Chance, die ich habe. Da du es das letzte Mal so problemlos geschafft hast, meine Messbaken zurückzuholen, denke ich, dass du der Aufgabe mehr als gewachsen bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040213
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040213,
					"content": "Nochmals vielen Dank. Ich entschädige dich dafür bestimmt gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040214
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040214,
					"content": "Warte, ich markiere diese Stelle auf der Karte für dich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040215
					],
					"speakerTitle": "Esther"
				}
			]
		},
