			},
			"dialogs": [
				{
					"id": 701040301,
					"content": "Sind alle Baken an ihrem Platz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040302
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040302,
					"content": "Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040303
					]
				},
				{
					"id": 701040303,
					"content": "Wunderbar, das ist eine große Hilfe. Nimm das, und meinen Dank nochmals für alles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040304
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040304,
					"content": "Puh, mit so wenigen Messbaken für die Studie weiß ich nicht, ob ich in der Lage sein werde, irgendetwas Interessantes herauszufinden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esther"
				}
			]
		},
