			"dialogs": [
				{
					"id": 207412001,
					"content": "Hast du die Löwenzahnsamen verteilt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207412002,
						207412003
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207412002,
					"content": "Genau das habe ich gemacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207412005
					]
				},
				{
					"id": 207412005,
					"content": "Ungeachtet dessen hoffe ich, dass Barbatos meine Stimme hören wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207412006
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207412006,
					"content": "Danke für deine Hilfsbereitschaft. Bitte nimm das für deine Mühen - und möge der Anemo-Archon dich beschützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 207412003,
					"content": "Der Wind wird sie weit verteilen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207412004
					]
				},
				{
					"id": 207412004,
					"content": "Das ist wunderbar. Es sollte für Barbatos einfach zu bemerken sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207412005
