			"dialogs": [
				{
					"id": 207411001,
					"content": "Hast du die Löwenzahnsamen gesammelt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411002
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411002,
					"content": "Ich habe sie gleich hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207411003
					]
				},
				{
					"id": 207411003,
					"content": "Danke, diese sollte genügen. Warte bitte einen Moment hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411004
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411004,
					"content": "O Barbatos, bitte hör mich an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411005
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411005,
					"content": "Oh, sie ist so ... fromm. So ... viele Worte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207411006,
					"content": "Wer hätte gedacht, dass dieser Straßenmusikant zuhört ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207411007,
					"content": "Na gut. Bitte nimm diese Löwenzahnsamen. Hilf mir, hochzugehen und sie zu verteilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411008
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411008,
					"content": "Ich sollte das wirklich selbst machen, aber mit meinen körperlichen Fähigkeiten hätte ich wahrscheinlich Schwierigkeiten, herunterzukommen, selbst wenn ich hochklettern könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411009
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411009,
					"content": "Ich zähle also auf dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
