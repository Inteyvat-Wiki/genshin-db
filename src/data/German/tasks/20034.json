			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200340301,
					"content": "Bennett, so zuverlässig wie immer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340302
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340302,
					"content": "Fischl ... Und wie immer haben ihre Worte eine Menge Pepp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340303,
						200340308
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340303,
					"content": "Wegen Bennett ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340304
					]
				},
				{
					"id": 200340304,
					"content": "Du sprichst über Bennett?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340305
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340305,
					"content": "Als ich der Gilde beitrat, beantwortete Bennett viele Fragen und half mir sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340306
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340306,
					"content": "Aber ich habe gehört, dass Bennett immer sehr viel Pech hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340307
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340307,
					"content": "Es ist so ungerecht, dass jemand, der offensichtlich so nett ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340313,
					"content": "#Vielen Dank, {F#Reisende}{M#Reisender}, ich werde zurückgehen und der Gilde Bericht erstatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340314
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340314,
					"content": "Aber warum begleite ich tagelang Transportballons ... Gibt es keinen anderen Auftrag in der Gilde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340308,
					"content": "Wegen Fischl ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340309
					]
				},
				{
					"id": 200340309,
					"content": "Fischl ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340310
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340310,
					"content": "Sie ist auch sehr zuverlässig! Sie ist eine gute Bogenschützin und hat schon viele Aufträge ausgeführt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340311
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340311,
					"content": "Obwohl ich das, was sie sagt, nicht ganz verstehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340312
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340312,
					"content": "Aber sie ist auch eine ... sehr erfahrene Abenteurerin! Nein, nein, eine Ermittlerin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2003404,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
