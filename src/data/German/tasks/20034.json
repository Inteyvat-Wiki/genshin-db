			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna",
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200340101,
					"content": "Gut ... Ich versuche auch, den Auftrag heute zu beenden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340102,
						200340106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340102,
					"content": "Was für eine Motivation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340103
					]
				},
				{
					"id": 200340103,
					"content": "Das ist sicher. Es macht Spaß, ein Abenteurer zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340104,
					"content": "Aber ... hehe, es gibt immer noch eine Menge Dinge, mit denen ich nicht vertraut bin, wenn ich einen Auftrag ausführe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340105,
					"content": "#{F#Reisende}{M#Reisender}, könntest du mich bitte zu einem weiteren Auftrag begleiten? Ich würde dich gern noch etwas anderes fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340108
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340108,
					"content": "Also los geht’s, der heutige Auftrag lautet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340109,
					"content": "Begleite den Transportballon ... Schon wieder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340106,
					"content": "Soll ich mitkommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340107
					]
				},
				{
					"id": 200340107,
					"content": "Ist das in Ordnung? He, ich habe eine Menge Fragen, die ich dir gern stellen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340108
					],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2003402,
			"completionStepIds": [
				2003406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003405",
							"3"
						],
						"stepId": 2003405,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003406",
							"2"
						],
						"stepId": 2003406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bennett",
					"Fischl",
					"Anna",
					"Oz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200340201,
					"content": "Fischl, du bist zu schnell gerannt. Es ist gefährlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340202
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340202,
					"content": "Mein Blitz des heiligen Urteils wird nicht zulassen, dass das Böse wächst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340203
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340203,
					"content": "Hier sind Fischl und Bennett, hallo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340204,
					"content": "#Anna und {F#die}{M#der} Reisende, seid ihr im Auftrag der Gilde hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340205
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340205,
					"content": "Es ist das Schicksal, dass dich hierher führt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340206
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340206,
					"content": "Die Dame war überrascht, dich an einem Ort wie diesem zu sehen, und hat sich gefreut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340207
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 200340207,
					"content": "Ich begleite Anna bei ihrer Mission.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340208
					]
				},
				{
					"id": 200340208,
					"content": "#Ja, {F#die}{M#der} Reisende und ich eskortieren hier Transportballons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340209
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340209,
					"content": "Doch plötzlich sahen wir eine Gruppe von Schatzräubern auf uns zustürmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340210
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340210,
					"content": "Entschuldigung, ich bin daran Schuld ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340211
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340211,
					"content": "Ursprünglich hatten Fischl und ich den Auftrag erhalten, eine Gruppe von Schatzräubern aufzuspüren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340212
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340212,
					"content": "Oz hatte es geschafft, zu erfassen, wohin sie gingen, und wir wollten sie gerade einholen ... als ich über einen Ast auf der Straße stolperte und mit einem Schlag herausfiel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340213
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340213,
					"content": "Diese Gruppe von Schatzräubern bemerkte die Aufregung, drehte sich um und rannte davon, und wir mussten sie verfolgen und verfolgen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340214
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340214,
					"content": "Es gibt keinen Grund zur Beunruhigung. Das fahle violette Licht der Strafe und der Sünde ist dazu bestimmt, das Schicksal der Bösen zu besiegeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340215
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340215,
					"content": "#Aber Fräulein, es war {F#die}{M#der} Reisende, {F#die}{M#der} sich einmischte, um die Bösen zu fangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340216
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 200340216,
					"content": "Oz! Oz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340217
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340217,
					"content": "Trotzdem danke ich euch, dass ihr euch dieses Mal in den Weg gestellt habt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340218
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340218,
					"content": "Sieht aus, als hätte ich doch einen ziemlich guten Tag gehabt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340219
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340219,
					"content": "Ich hoffe, es wird euch helfen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340220
					]
				},
				{
					"id": 200340220,
					"content": "He, wir werden diese Gruppe von Schatzräubern zurück zur Gilde bringen, also seid vorsichtig auf dem Weg zu eurem Auftrag, und passt vor allem auf, wo ihr hintretet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				}
			]
		},
		{
			"id": 2003403,
			"completionStepIds": [
				2003407
