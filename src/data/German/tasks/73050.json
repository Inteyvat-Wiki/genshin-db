				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arapandu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500101,
					"content": "#Nara {NICKNAME} und Paimon! Dank eurer Hilfe ist die Varuna-Maschine jetzt in einem guten Zustand, wie auch das Ashavan-Reich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500102
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500102,
					"content": "Die Aranara kehren zurück nach Vanarana, um das Utsava-Fest zu feiern, so wie die Vögel zu ihren Nestern zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500103
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730500103,
					"content": "Der grimmige Regen wird wieder sanft und so kann sich auch Aranakula wieder beruhigt um die Baumschule kümmern, Viparyas ziehen, fröhliche Viparyas ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500104
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730500104,
					"content": "Fröhliche Viparyas erzeugen fröhliche Lichter und fröhliche Lichter schmücken ein fröhliches Utsava-Fest ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500105
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730500105,
					"content": "#Nara {NICKNAME} und Paimon, die Baumschule ist jetzt gut und das Utsava-Fest voller Freude. Danke dafür, dass ihr geholfen habt, die Varuna-Maschine zu heilen und Aranakula zurückzubringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500106
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730500106,
					"content": "Toll! Hehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730500107,
					"content": "Also, da macht mich etwas neugierig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500108
					]
				},
				{
					"id": 730500108,
					"content": "Warum wird Nara Varuna Nara Varuna genannt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500109
					]
				},
				{
					"id": 730500109,
					"content": "Oh, na weil dieser Nara uns geholfen hat, die Varuna-Maschine zu heilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500110
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500110,
					"content": "#Aber was ist dann {M#ihr}{F#sein} richtiger Name?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500111
					]
				},
				{
					"id": 730500111,
					"content": "#Ähm, das weiß ich auch nicht. Nara Varuna hat uns nie {M#ihren}{F#seinen} richtigen Namen genannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500112,
						730500113
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500112,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500114
					]
				},
				{
					"id": 730500114,
					"content": "#Nara {NICKNAME} hat uns auch sehr geholfen. Du bist ein tapferer Nara und hast viele Schwierigkeiten überwunden. Wir sind so glücklich, dass wir das Utsava-Fest zusammen feiern können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500115
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730500115,
					"content": "#Wir haben etwas für Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500116
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730500116,
					"content": "Damit drücken Aranara ihren Dank aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500117
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500117,
					"content": "#Das wird Nara {NICKNAME} sicher gefallen und Paimon auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500118
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730500118,
					"content": "Hier ist die Blume von Aranara für den tapferen Nara und für Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500119
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730500119,
					"content": "#Arakara hat auch Blume. Sie ist keine Viparyas, aber sie ist für Nara {NICKNAME} und Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500120
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730500120,
					"content": "#Nara {NICKNAME} und Paimon, danke für alles, was ihr für Vana getan habt. Die Aranara werden ihre Freunde niemals vergessen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500113,
					"content": "Verstanden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500114
					]
				}
			]
		},
		{
			"id": 7305002,
