			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Ararycan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500201,
					"content": "#Nara {NICKNAME} und Paimon! Die Bösewichte, die Vana „krank“ machen wollten, sind nicht zurückgekommen. Keine Sorge!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500202
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730500202,
					"content": "#Nur dank der Hilfe von Nara {NICKNAME} und Paimon konnte Ararycan Vana beschützen. Deshalb hat Ararycan Blume für Nara {NICKNAME} und Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500203
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730500203,
					"content": "Freunde von Ararycan, nehmt diese Blume!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ararycan"
				}
			]
		},
		{
			"id": 7305003,
			"completionStepIds": [
				7305003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
