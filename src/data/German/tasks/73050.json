			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Aranaga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500301,
					"content": "Utsava-Fest ... Ein nostalgisches Gefühl ... Hm? Weißes Fliegerchen ... und der goldene Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500302
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730500302,
					"content": "#{F#Die Nara-Freundin}{M#Der Nara-Freund} und die Freundin von {F#der Nara-Freundin}{M#dem Nara-Freund}. Ich hoffe, ihr habt Spaß auf dem Utsava-Fest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500303
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730500303,
					"content": "Die Freunde von meinen Freunden sind auch meine Freunde. Der goldene Nara und das fliegendes Weißfell sind beide Aragarus Freunde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				}
			]
		}
	]
}