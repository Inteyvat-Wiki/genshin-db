			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arabalika",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730160301,
					"content": "Ein Nara und ... fliegendes Ding?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160302
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160302,
					"content": "#Richtig, wir sind die fliegende Paimon und {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160303,
					"content": "Und du bist sicher Arabalika und du scheinst auch überhaupt keine Angst vor uns zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160304,
					"content": "Der goldene Nara riecht nach Arapandu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160305
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160305,
					"content": "Ah, ja, Arapandu hat uns tatsächlich hierher geschickt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160306,
					"content": "Ich spüre keine Gefahr. Wenn ihr mich angreifen wollt, solltet ihr es tun, solange sich der große Eisenbrocken noch bewegen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160307
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160307,
					"content": "Ja, das nennt man wohl „einen Aranara treten, wenn er schon am Boden liegt“ ... Nein! So etwas können wir nicht tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160308,
					"content": "Warum nicht? Wenn ich der Gegner bin, ist es doch eine gute Sache, den Gegner hereinzulegen. So machen es die Tiere bei der Jagd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160309
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160309,
					"content": "Ooh ... Das ergibt Sinn ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160310,
					"content": "Paimon ist verwirrt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160311
					]
				},
				{
					"id": 730160311,
					"content": "Jedenfalls, Egal! Wir können auf keinen Fall „einen Aranara treten, wenn er schon am Boden liegt“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160312,
					"content": "Weil Aranara Freunde sind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160313
					]
				},
				{
					"id": 730160313,
					"content": "#Ja, das ist es! Weil Aranara Freunde sind! Paimon und {NICKNAME} können unseren Freunden nichts antun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160314,
					"content": "Bäh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160315
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160315,
					"content": "Ähm ... Warum scheint er damit nicht zufrieden zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160316,
						730160318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160316,
					"content": "Paimon hat keinen guten ersten Eindruck gemacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160317
					]
				},
				{
					"id": 730160317,
					"content": "Paimon ist aber auch der Meinung, dass sie nichts falsch gemacht hat ... Hmm ... Aranara sind so launisch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160320,
					"content": "Ja, Arapandu hat davon erzählt, dass Arabalikas „Ararakalari“ sehr stark ist. Es war sicher mithilfe von „Ararakalari“ , dass er die Ruinenwächter besiegen konnte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160321,
					"content": "Kennt Paimon Ararakalari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160322
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160322,
					"content": "... Oh, oh! Natürlich weiß Paimon bescheid! Das ist es doch! Ähm ... wirklich stark! Es ist eine Kraft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160323,
					"content": "Pfui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160324
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160324,
					"content": "Ah! Paimon fühlt sich mal wieder nicht ernstgenommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160325,
					"content": "Zurück zur Sache.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160326
					]
				},
				{
					"id": 730160326,
					"content": "Ja ... Wir sind hier, um die Varuna-Maschine zu heilen! Hier müssten auch ihre „Äste“ und „Blätter“ sein. Aber wir haben sie noch nicht gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160327,
					"content": "Warum „Äste“ und „Blätter“, wohl eher „Wurzeln“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160328
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160328,
					"content": "Hä? Echt? Aber Arapandu hat gesagt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160329,
					"content": "Durch dieses „Wurzelwerk“, das ganz Vana durchzieht, kann die Varuna-Maschine ihre Kraft ziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160330
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160330,
					"content": "Oh ... Das scheint Sinn zu ergeben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160331,
					"content": "Außerdem sind die „Wurzeln“ im Boden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160332
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160332,
					"content": "Diese Steine und die Eisenbrocken gehören nicht den Aranara. Wenn du runtergehen möchtest, musst du erst einmal die Eisenbrocken zerschlagen. Sie sind sehr stark, aber der goldene Nara ist auch nicht gerade schwach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160333
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160333,
					"content": "#Absolut, {NICKNAME} weiß schon gar nicht mehr, wie viele große Eisenbrocken {M#er}{F#sie} schon zerschlagen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160334,
					"content": "Was? Na dann zeig Arabalika mal, was der Nara so drauf hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160335
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160335,
					"content": "Hä? Wie hat er sich nur im Boden vergraben? Ach! Ist er etwa schon zum Ruinenwächter rübergegangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160336,
					"content": "#{NICKNAME}, lass uns ihn schnell einholen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160318,
					"content": "Wahrscheinlich ist er zu allen so.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160319
					]
				},
				{
					"id": 730160319,
					"content": "Wie kann das sein? Nach außen hin ist er so liebenswert, aber ein Temperament ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160320
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301607,
			"completionStepIds": [
				7301607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301607",
							"2"
						],
						"stepId": 7301607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arabalika",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730160701,
					"content": "Wir haben den großen Eisenbrocken schon zerschlagen, jetzt muss nur noch das Wasser ablaufen, dann können wir in den Untergrund hinabsteigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160702
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160702,
					"content": "Aber wir waren schon lange nicht mehr hier, jetzt ist alles anders. Vielleicht gibt es im Untergrund noch mehr große Eisenbrocken. Ich kann Eisen riechen. Schlechter Geruch, also muss man vorsichtig sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160703
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160703,
					"content": "#Nara {NICKNAME} hat viele Fähigkeiten, keine Sorge. Aber Paimon ist so schwach wie Aranakula. Paimon muss aufpassen, dass sie nicht von den Pilzen verspeist wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160704
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160704,
					"content": "Oh ... Arabalika ist so stark! Wir haben schon viele Aranara getroffen, aber Paimon glaubt nicht, dass einer von ihnen ein Ruinenwächter mit einem Schlag besiegen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160705,
					"content": "Paimon weiß zu wenig über die Aranara. Aradasha würde einen großen Eisenbrocken im Handumdrehen besiegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160706
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160706,
					"content": "Aradashas Ararakalari war in der Vergangenheit sehr mächtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160707
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160707,
					"content": "In der Vergangenheit? Und jetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160708,
					"content": "Jetzt? Aradasha ist nicht im Jetzt. Daher muss Arabalika umso härter sein Ararakalari trainieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160709
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160709,
					"content": "Vielleicht kann Paimon auch „Ararakalari“ lernen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160710,
						730160714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160710,
					"content": "Also kann ich das Kämpfen in Zukunft Paimon überlassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160711
					]
				},
				{
					"id": 730160711,
					"content": "#Hehe, lass Paimon dann auf {NICKNAME} aufpassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160712,
					"content": "Streng dich an, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160713
					]
				},
				{
					"id": 730160713,
					"content": "Überlasse es Paimon! Überlasse Paimon alles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160718,
					"content": "Paimon ist ein großer Träumer, keine Ahnung ob das gut oder schlecht ist. Wir müssen jetzt eine Vorrichtung aus Steine finden, um das Wasser zu entfernen, sonst können wir nicht in den Untergrund gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160719
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160719,
					"content": "Aranara kann sich in die Erde bohren, aber nicht ins Wasser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160720
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160720,
					"content": "#Gut, {NICKNAME}, wir werden uns hier umsehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160714,
					"content": "Paimon kann das eigentlich nicht lernen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160715
					]
				},
				{
					"id": 730160715,
					"content": "Wenn Paimon es lernen will, kann Paimon es auch sicher lernen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160716,
					"content": "Alle, die so etwas sagen werden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160717
					]
				},
				{
					"id": 730160717,
					"content": "Sollte Paimon Arabalika bitten, Paimon zu lehren, nachdem wir gegessen und uns an einem sicheren Ort ausgeruht haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160718
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301610,
			"completionStepIds": [
				7301610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301610",
							"2"
						],
						"stepId": 7301610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arabalika"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730161001,
					"content": "Es scheint ... kaputt zu sein! Es bewegt sich nicht mehr ... Das hat Paimon Angst gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161002,
					"content": "Haha, das ist nur ein rostiger Eisenbrocken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161003,
					"content": "Vana ist jetzt ein gefährlicher Ort. Paimon wird große Probleme bekommen, wenn sie nicht vorsichtig ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161004
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161004,
					"content": "Oh ... Arabalika ist so streng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161005,
					"content": "Paimon, du bist einfach zu undiszipliniert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161006
					]
				},
				{
					"id": 730161006,
					"content": "Wirklich? A... Also wenn Paimon so diszipliniert wird wie Arabalika, wird Paimon auch so stark wie er sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161007,
					"content": "Paimon, du solltest mit dir selbst strenger sein und nicht mit anderen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161008
					]
				},
				{
					"id": 730161008,
					"content": "Gut, dann wird Paimon viel strenger mit ihr sein ... ab morgen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161009,
					"content": "Da die steinerne „Äste“ nun hier ist, müssen wir nur ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161010,
					"content": "Die drei Steine finden und sie in diese Richtung ausrichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161011
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161011,
					"content": "Er ... Er hat Paimons Worte aus dem Munde genommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161012,
					"content": "Apropos, Arabalika spricht ganz anders als Arapandu. Er verwendet überhaupt keine Metaphern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161013,
						730161015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161013,
					"content": "Das ist aber einfacher zu verstehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161014
					]
				},
				{
					"id": 730161014,
					"content": "Es ist wirklich direkter und einfacher zu verstehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161017,
					"content": "Weil Arapandu sehr viel und Arabalika sehr wenig denkt. Ich weiß nur, wie man schützt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161018
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161018,
					"content": "Arapandu beschützte einst Vana mit Nara Varuna. Sie vertrieben den dunklen, unbekannten, schmutzigen Schlamm und heilten die Varuna-Maschine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161019
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161019,
					"content": "#Es ist schon lange her, dass Nara Varuna Vana verlassen hat. Vielleicht kommt {M#sie}{F#er} auch nie mehr zum Utsava-Fest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161020
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161020,
					"content": "Arapandu weiß es schon. Es ist lange her, lange genug, damit aus einem kleinen Samen ein großer Baum werden kann. Der Nara, der damals Vana verließ, wird nie wieder zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161021
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161021,
					"content": "Aber Arapandu will die Varuna-Maschine wieder heilen. Für Vana, für das Utsava-Fest und für Nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161022
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161022,
					"content": "So ist das also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161023
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161023,
					"content": "#Arabalika hat Nara Varuna nie getroffen, aber ganz Vana weiß, was {M#sie}{F#er} getan hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161024
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161024,
					"content": "Arabalika wird nicht so viel denken wie Arapandu. Arabalika weiß nur, dass er stark werden muss, um Aranara und Vana zu beschützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161025
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161025,
					"content": "Nara Varuna ist nicht mehr hier, aber Aranara kann immer noch die Varuna-Maschine heilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161026
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161026,
					"content": "#Ja! Paimon und {NICKNAME} werden auch helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161027
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161027,
					"content": "#Irgendetwas stimmt hier mit dem Geruch nach Eisen nicht. Nara {NICKNAME}, das überlasse ich dir. Ich warte hier auf euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161028
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161028,
					"content": "Paimon fragt sich, was Arabalika gespürt hat ... Aber Paimon ist sich sicher, dass Aranara mehr über den Wald weiß als wir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161029,
					"content": "#{NICKNAME}, lass uns hier nach den drei verstreuten „Blättern“ umsehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161015,
					"content": "Es lässt ihn weniger wie einen Aranara erscheinen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161016
					]
				},
				{
					"id": 730161016,
					"content": "Aber, was bedeutet das eigentlich „wie Aranara“? Hmm ... Paimon versteht es nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161017
					],
					"speakerTitle": "Paimon"
				}
			]
		},
