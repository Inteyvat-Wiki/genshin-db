			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arabalika"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730161501,
					"content": "Puh ... Wirklich angsteinflößend! Zum Glück hat uns Arabalika geholfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161502,
					"content": "Wie ich gesagt habe, Paimon wird Probleme bekommen, wenn sie nicht vorsichtig ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161503
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161503,
					"content": "Öh ... Es tut Paimon leid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161504,
					"content": "Wenn es einen Wächter in den Ruinen gibt, wird er natürlich aufwachen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161505
					]
				},
				{
					"id": 730161505,
					"content": "Stimmt. Das bedeutet wohl „seinem Namen alle Ehre machen“! Schließlich sind wir für ihn die Fremdlinge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161506,
					"content": "#Nara {NICKNAME} und Paimon sind Fremdlinge in Vana, aber Arabalika ist es nicht. Der riesige Eisenbrocken hat sich also geirrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161507
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161507,
					"content": "Wenn der riesige Eisenbrocken sich geirrt hat, dann wird Arabalika ihm lehren, was richtig ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161508
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161508,
					"content": "Ähm ... Paimon wird in Zukunft gut sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161509,
					"content": "Paimon, ich nehme dich beim Wort.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161510
					]
				},
				{
					"id": 730161510,
					"content": "Natürlich! Ab morgen ... nein, ab jetzt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161511,
					"content": "#Nur Aranara kann hier die Steine erwecken. Nara {NICKNAME} und Paimon, überlasst Arabalika den Rest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161512
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161512,
					"content": "Ooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161513,
					"content": "Wir sind der Heilung der Varuna-Maschine einen Schritt näher gekommen! Wenn sie geheilt ist, wird es nicht mehr so viele Sporen im Apam-Wald ... Allein der Gedanke an sie lässt Paimons Nase jucken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161514,
					"content": "Die Varuna-Maschine wird das Regenwasser reinigen, damit es keinen schwarzen Regen oder so viele „Sporen“ mehr gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161515
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161515,
					"content": "Aber ... Pilze sollte es immer noch geben. Paimon muss aufpassen, damit sie nicht wie Aranakula fast von Pilzen gefressen wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161516
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161516,
					"content": "Ja ... Paimon wird vorsichtig sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161517,
					"content": "#Arabalika wird hier nicht mehr benötigt. Ich werde zum „Ruheort“ zurückkehren, um nach Arapandu zu suchen. Nara {NICKNAME} und Paimon, kommt ihr mit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161518,
						730161520
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161518,
					"content": "Dann lass uns zusammen gehen.",
