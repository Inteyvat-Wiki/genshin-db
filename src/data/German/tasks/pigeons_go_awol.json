			"dialogs": [
				{
					"id": 200611001,
					"content": "Deine Tauben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200611002
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200611002,
					"content": "Wirklich? Hilichurle haben meine Tauben gefressen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200611003
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200611003,
					"content": "Hast du diesen Brief geschrieben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200611004
					]
				},
				{
					"id": 200611004,
					"content": "Brief? Oh, ja, danke! Den wollte ich eigentlich an Schwester Grace in Mondstadt schicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200611005
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200611005,
					"content": "Ist alles in Ordnung? Wenn du ihn gelesen hast, ist das nicht schlimm. Es geht nur um alte Kamellen.",
					"roleType": "TALK_ROLE_NPC",
