			},
			"dialogs": [
				{
					"id": 200610401,
					"content": "Es geht um die Tauben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610402
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610402,
					"content": "Jetzt werden die Tauben hoffentlich brav sein und ihre Briefe ausliefern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610403
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610403,
					"content": "Leider kann ich nicht nach ihnen sehen. Aber das hilft mir schon sehr weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610404
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610404,
					"content": "Als Dankeschön bekommst du das. Wenn du mal einen Brief verschicken willst, kannst du immer vorbeikommen und Hallo sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
		{
			"id": 2006105,
			"completionStepIds": [
				2006117
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
