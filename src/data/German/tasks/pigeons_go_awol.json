			"dialogs": [
				{
					"id": 200610901,
					"content": "He, deine Tauben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610902
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610902,
					"content": "Wirklich? Hilichurle haben meine Tauben gefressen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610903
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610903,
					"content": "Die Tauben waren aber wirklich ziemlich dick geworden ... Sie haben sicher ein ordentliches Festmahl hergemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610904
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610904,
					"content": "Ach, nichts. Ich meine ... Hm, jetzt muss ich wieder von vorn mit der Zucht anfangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
