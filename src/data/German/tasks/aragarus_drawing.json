			"trigger": {
				"objectNames": [
					"Aragaru",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730580201,
					"content": "Und, habt ihr etwas gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580202
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580202,
					"content": "Ähm ... Nichts als undeutliche Befehle und das hier! Eine getrocknete Blume!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580203,
					"content": "Oh! ... Kann ich es haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580204
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580204,
					"content": "Die Bösewichte haben sie hinterlassen, hast du keine Angst vor Gift ... oder sowas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580205,
					"content": "Keine Sorge, ich kenne diese Blume ... Ich sollte die Person kennen ... Bitte überlasse sie mir, in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580206
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580206,
					"content": "Nimm sie ruhig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580207
					]
				},
				{
					"id": 730580207,
					"content": "#Danke! Nara {NICKNAME} und weißes Fliegerchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580208
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580208,
					"content": "Aragaru hat die getrockneten Blümchen ins Mawtiyima-Dickicht gebracht ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7305804,
