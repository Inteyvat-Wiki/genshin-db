			},
			"dialogs": [
				{
					"id": 730580401,
					"content": "Lasst uns zum Versteck der bösen Nara gehen und herausfinden, was sie hier vorhaben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580402
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580402,
					"content": "Woher weißt du, dass jemand böse ist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580403
					]
				},
				{
					"id": 730580403,
					"content": "#Also, das weiß ich auch nicht so genau! Ich weiß nur, dass Nara {NICKNAME} und das weiße Fliegerchen garantiert nicht böse sind! Davon ist Aragaru überzeugt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				}
			]
		},
