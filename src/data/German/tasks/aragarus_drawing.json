			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aragaru",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730580101,
					"content": "Goldener Nara und weißes Fliegerchen! Wir begegnen uns schon wieder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580102
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580102,
					"content": "Aah! Bitte sag etwas, bevor du aus dem Nichts auftauchst! Du hast Paimon schon wieder einen Schrecken eingejagt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580103,
						730580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580103,
					"content": "Wir sind keine Bösewichte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				},
				{
					"id": 730580105,
					"content": "Hmm ... du hast recht ... Könnt ihr mir einen neuen Dienst erweisen, goldener Nara und weißes Fliegerchen, die nicht wie Bösewichte wirken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580106
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580106,
					"content": "#Es wäre mir eine Freude. Ich bin {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580107
					]
				},
				{
					"id": 730580107,
					"content": "Paimon ist Paimon, vergiss es diesmal nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580108,
					"content": "Diesmal? Ähm ... Ähem, ich bin Aragaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580109
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580109,
					"content": "#Wir waren hier zusammen, aber du hast alles vergessen ... Ach, schwer zu erklären! {NICKNAME}, sollen wir es ihm erklären?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580110,
					"content": "Ihr beschreibt Aragaru, was ihr während des Abenteuers erlebt habt.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730580111
					]
				},
				{
					"id": 730580111,
					"content": "Ist das so ... Ich erinnere mich gar nicht mehr, aber aus irgendeinem Grund möchte ich euch glauben ... Außerdem habt ihr meine Blume, ich spüre sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580112
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580112,
					"content": "Ah, übrigens! Die bösen Nara haben ein Lager aufgebaut. Sehen wir nach, was sie hinterlassen haben. Vielleicht bringen wir ihre Pläne in Erfahrung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580104,
					"content": "Wir haben die Bösewichte in die Flucht geschlagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				}
			]
		},
		{
			"id": 7305802,
			"completionStepIds": [
				7305804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
