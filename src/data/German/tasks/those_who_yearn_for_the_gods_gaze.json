			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teppei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140801,
					"content": "Teppei!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140802,
					"content": "Ah, ihr seid es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140803
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140803,
					"content": "Moment, ich stehe erst mal auf ... komisch, ich fühle mich so schwach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140804,
						20140805
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140804,
					"content": "Teppei ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140806
					]
				},
				{
					"id": 20140806,
					"content": "Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140807
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140807,
					"content": "Oh, ich hatte noch keine Zeit, dir das alles zu erzählen. Ich habe in letzter Zeit ein paar Errungenschaften erreicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140808
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140808,
					"content": "Die Bakufu-Armee per Schiff zu schlagen, die Samurai des Bakufu selbst abzuwehren, meine belagerten Gefährten zu retten, das hätte ich mir früher nie träumen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140809
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140809,
					"content": "Wenn ich nur ein bisschen stärker sein könnte. Ein bisschen stärker und ich könnte mehr tun ... Seltsam, wo ist meine „Geheimwaffe“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140810,
						20140811
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140810,
					"content": "Erzähl mir von deiner Waffe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140812
					]
				},
				{
					"id": 20140812,
					"content": "Seit ... wahrscheinlich kurz nachdem du zum Truppenführer von Schwertfisch II ernannt wurdest, traf ich einen geheimnisvollen Sponsor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140813
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140813,
					"content": "Sie gaben mir das. Dann erzählten sie mir, dass, wann immer ich stärker werden wollte, diese Geheimwaffe auf mich reagieren würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140814
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140814,
					"content": "Haha, das ist wie das „Göttliche Auge“, nicht wahr? Ich habe das Göttliche Auge nie benutzt, also weiß ich nicht, was der Unterschied ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140815
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140815,
					"content": "Dies ist ein Teuflisches Auge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140816
					]
				},
				{
					"id": 20140816,
					"content": "Ein Teuflisches Auge? Klingt nicht gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140817
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140817,
					"content": "Wo ist der Unterschied im Vergleich mit dem Göttlichen Auge?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140818
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140818,
					"content": "Es wird das Leben des Benutzers auszehren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140819
					]
				},
				{
					"id": 20140819,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140820
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140820,
					"content": "Ist das so ... Es ist doch ganz natürlich, dass so etwas Unbekanntes ein Risiko darstellt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140821
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140821,
					"content": "In den letzten Tagen bin ich immer müder geworden und habe ein vages Gefühl von Unglück im Herzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140822
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140822,
					"content": "Vorher war ich nur etwas müder nach dem Kampf, aber als ich heute zurückkam, konnte ich plötzlich nichts mehr klar sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140823
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140823,
					"content": "Schade, ich dachte, ich würde dich einholen ... haha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140824
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140824,
					"content": "Ich werde in der Tat nicht von den Göttern beobachtet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140825
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140825,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140826
					]
				},
				{
					"id": 20140826,
					"content": "#{NICKNAME}, kann ich dich um einen Gefallen bitten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140827
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140827,
					"content": "Wenn unsere Uniformen fertig sind, hilfst du mir und holst meine ab ... Wir ziehen sie gemeinsam an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140828
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140828,
					"content": "Was für einen Blick hast du da, Kumpel? Keine Sorge, gib mir eine Pause ... Ich ruhe mich eine Weile aus ... Vielleicht geht es mir dann besser ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140829
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140829,
					"content": "Teppei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140830
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140830,
					"content": "Die Fatui ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140831
					]
				},
				{
					"id": 20140831,
					"content": "#He, {NICKNAME}, wohin gehst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
