					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140201,
					"content": "Dies sollte der richtige Ort sein. Trotzdem, ich habe wirklich keine verdächtigen Typen gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140202,
					"content": "#Bedeutet das, dass sie sich versteckt haben? {NICKNAME}, schauen wir uns um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140203,
					"content": "Diese <color=#00E1FFFF>Elektro-Stelen</color>, fühlen sich ein wenig verdächtig an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 201405,
			"completionStepIds": [
				201405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201405",
							"2"
						],
						"stepId": 201405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teppei",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140501,
					"content": "Puh ... Endlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140502,
					"content": "Was für eine harte Nuss, aber warum gibt es hier einen Blitzhelm-Lawachurl? So groß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140503,
					"content": "Ich verstehe es nicht ... und die Atmosphäre hier ist ein bisschen seltsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140504,
					"content": "Wie auch immer, die Dinge sollten hier erledigt werden, lass uns einfach laufen ... He, Teppei, warum bist du auch hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140505,
					"content": "Ich bin auch überrascht, dass ihr hier nachforscht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140506
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140506,
					"content": "Ich war gerade von der Front zurückgekehrt, nachdem ich Nachschub transportiert hatte und wollte vorbeikommen, um die Nachbarschaft von Bedrohungen zu befreien. Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140507
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140507,
					"content": "Ist alles in Ordnung? Du siehst ein bisschen komisch aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140508,
					"content": "Es ist alles in Ordnung, ich glaube, ich habe mich erkältet, als ich vor zwei Tagen auf See war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140509
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140509,
					"content": "Als ich vorbeikam, hörte ich, dass vor kurzem jemand auf der Insel gelandet war, um sie zu untersuchen, und dachte, ich schaue mal vorbei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140510
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140510,
					"content": "Falls Gefahr droht, kann ich vielleicht einmal ein Held sein ... aber leider habe ich gerade euch getroffen, also bin ich wohl umsonst gekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140511
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140511,
					"content": "Teppei, findest du nicht auch, dass es an diesem Ort etwas seltsam ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140512,
					"content": "Nun ... in diesem Fall in der Tat ein wenig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140513
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140513,
					"content": "Vielleicht liegt es daran, dass die Aura der Tatarigami hier stärker ist, weil wir uns bereits in der Nähe der Überreste des Gottes Orobaxi befinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140514
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140514,
					"content": "Orobaxi ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140515,
					"content": "Schau, das sind die Überreste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140516
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140516,
					"content": "So große Schlangenknochen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140517,
					"content": "Es war Orobaxi, der unsere Vorfahren aus Enkanomiya an die Oberfläche brachte und die Insel Watatsumi zu dem machte, was sie heute ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140518
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140518,
					"content": "Unsere Vorfahren hatten ihn immer als Schutzgottheit betrachtet, aber während des Archontenkriegs fiel Orobaxi in die Insel Yashiori ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140519
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140519,
					"content": "Shougun Raiden selbst kam und tötete ihn mit einem „Musou no Hitotachi“. Dieser Schlag bildete auch das, was heute als „Musoujin-Schlucht“ bekannt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140520
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140520,
					"content": "Die „Musoujin-Schlucht“ wurde tatsächlich von Shougun Raiden erzeugt ... so mächtig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140521,
					"content": "Ja, aber der Archontenkrieg war außerordentlich brutal und die Insel Yashiori wurde in dieser Schlacht in Schutt und Asche gelegt. Es wird gesagt, dass der Shougun damals etwas verloren hat, was ihm lieb und teuer war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140522
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140522,
					"content": "Nach dem Tod von Orobaxi gab es viel Zwietracht zwischen Watatsumi und dem Bakufu. Doch dieses Mal formierte sich der Widerstand nicht um des Glaubens willen, sondern nur als Antwort auf das Augenhatz-Dekret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140523
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140523,
					"content": "Orobaxi zerstörte die Zivilisation und es war der Shougun, der sich erhob, um ihn aufzuhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140524
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140524,
					"content": "Jetzt, da der Shougun das Augenhatz-Dekret erlassen hat, um die Menschen ihrer Wünsche zu berauben, muss auch jemand sich erheben und den Shougun aufhalten ... ähem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140525
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140525,
					"content": "Ich gehe erst einmal, ich habe mich gerade um die Elite-Samurai der Bakufu-Armee gekümmert. Ich gehe zurück und ruhe mich aus, ich habe später noch andere Dinge zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140526
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140526,
					"content": "Du solltest dich auch beeilen und dich bei Sangonomiya melden. Es könnte immer noch eine Aura der Überreste der Tatarigami hier sein, und ein längerer Aufenthalt hier ist nicht gut für die Gesundheit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140527
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140527,
					"content": "*hust*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140528,
						20140529
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140528,
					"content": "Pass auf dich auf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				},
				{
					"id": 20140530,
					"content": "Keine Sorge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140531
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140531,
					"content": "Ich wusste nicht, dass Teppei bereits gegen die Samurai der Bakufu-Armee kämpfen konnte, aber er hat sehr viele Fortschritte gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140532,
					"content": "#{NICKNAME}, gehen wir zurück und melden uns bei <color=#00E1FFFF>Kokomi</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140529,
					"content": "Du auch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				}
			]
		},
		{
			"id": 201406,
			"completionStepIds": [
				201406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201406",
							"2"
						],
						"stepId": 201406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140601,
					"content": "Wir sind zurück ... He, Gorou ist auch hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140602,
					"content": "Ist etwas passiert? Ihre Gesichter sehen so ernst aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140603,
					"content": "Wie hoch ist die ungefähre Anzahl der Menschen, die diese Anomalie erleben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140604
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140604,
					"content": "Wir haben es noch nicht aufgezählt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140605
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140605,
					"content": "Hallo ... Ist hier etwas vorgefallen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140606,
					"content": "#{NICKNAME}, einige Widerstandskämpfer haben in letzter Zeit bizarre Alterungserscheinungen gezeigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140607
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140607,
					"content": "Ich habe sie zur Befragung hinzugezogen und herausgefunden, dass sie privat einige „Geheimwaffen“ von ihren Sponsoren bekommen hatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140608
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140608,
					"content": "Die meisten von ihnen sind konkurrenzfähig und extrem unglücklich mit dem Augenhatz-Dekret und haben diese Geheimwaffen im Stillen benutzt, seit sie sie bekommen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140609
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140609,
					"content": "Kein Wunder, dass der Krieg in letzter Zeit außergewöhnlich gut gelaufen ist ... aber das ist niemals der richtige Weg und muss so schnell wie möglich verboten werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140610
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140610,
					"content": "Gorou, hast du ihre sogenannte „Geheimwaffe“ bekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140611
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140611,
					"content": "Die meisten Leute mit Geheimwaffen weigerten sich, sie auszuhändigen, aber ich bekam trotzdem eine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140612
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140612,
					"content": "Das ist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140613
					]
				},
				{
					"id": 20140613,
					"content": "#{NICKNAME}, weißt du, was es ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140614
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140614,
					"content": "Das Teuflische Auge der Fatui ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140615
					]
				},
				{
					"id": 20140615,
					"content": "Die Identität des Sponsors ist also tatsächlich die der Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140616
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140616,
					"content": "Aber warum sollten sie das tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140617
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140617,
					"content": "Es bleibt keine Zeit, darüber nachzudenken, das Wichtigste ist jetzt, die Armee zu informieren, damit sie den Einsatz des Teuflischen Auges so schnell wie möglich einstellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140618
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140618,
					"content": "Alle Soldaten mit aktuellen Anomalien müssen behandelt werden, hoffentlich rechtzeitig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140619
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140619,
					"content": "#Warte, {NICKNAME}, da wir gerade von Soldaten mit Anomalien sprechen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140620,
					"content": "Teppei ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140621
					]
				},
				{
					"id": 20140621,
					"content": "Nein, ich hoffe, dass er nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140622,
					"content": "Lass uns zu ihm gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
