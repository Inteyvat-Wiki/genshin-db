			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Olaf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110030201,
					"content": "So ... kalt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030202
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030202,
					"content": "Er ist total unterkühlt! Wir müssen ihn schnell aufwärmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030203
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030203,
					"content": "Machen wir schnell ein Feuer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110030204,
					"content": "Am besten bereiten wir ihm eine heiße Suppe zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030205
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030205,
					"content": "#{NICKNAME}, ich werde hier auf ihn aufpassen. Kannst du ihm solange eine <color=#00E1FFFF>leckere Suppe</color> zubereiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030206
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030206,
					"content": "Wir sind doch an einem Hilichurl-Lager vorbeigekommen. Da gibt es mit Sicherheit eine Möglichkeit, eine Suppe zu kochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030207
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030207,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030208
					]
				},
				{
					"id": 110030208,
					"content": "Sehr gut. Komm zurück, sobald die Suppe fertig ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				}
			]
		},
		{
			"id": 1100304,
			"completionStepIds": [
				1100304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100304",
							"2"
						],
						"stepId": 1100304,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"108021",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Olaf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110030401,
					"content": "Ooh ... aah ... Schon viel besser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030402
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030402,
					"content": "Danke euch. Diese Suppe hat wirklich gutgetan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030403
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030403,
					"content": "Wie bist du denn so eingefroren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030404
					]
				},
				{
					"id": 110030404,
					"content": "Ich bin ursprünglich einem Wildschwein hinterhergerannt, das dann in diese Ruinen da gelaufen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030405
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030405,
					"content": "Dann bin ich hinterher und dummerweise auf einen richtig großen Fluxeisbaum gestoßen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030406
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030406,
					"content": "Ich war sofort erstarrt. Nachdem ich wieder zu Sinnen kam, bin ich sofort herausgerannt. Als ich hier ankam, konnte ich mich schon nicht mehr bewegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030407
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030407,
					"content": "Fluxeisbaum? Fangen jetzt schon die Bäume an, Leute zu verhauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030408
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030408,
					"content": "Ja, wirklich! Zuvor habe ich nur davon gehört. Jetzt war das erste Mal, dass ich einen selbst gesehen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030409
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030409,
					"content": "Das klingt ja gefährlich ... Dann sollten wir diesen Ruinen lieber nicht zu nahe kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110030410,
					"content": "Der könnte aber ein echter Leckerbissen sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030411,
						110030412
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030411,
					"content": "Hö?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030413
					]
				},
				{
					"id": 110030413,
					"content": "Gerade dann! Das ist die fehlende Zutat! Das wird alles ändern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030414
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030414,
					"content": "Jetzt beruhige dich mal. Sag mal, glaubst du, man kann so eine wilde Pflanze essen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110030415,
					"content": "Es gibt nur einen Weg, das herauszufinden. Jetzt kommt schon, schnell!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030416
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030416,
					"content": "Und schon ist sie weg ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030417,
						110030418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110030417,
					"content": "Wir müssen dann mal los.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030419
					]
				},
				{
					"id": 110030419,
					"content": "Kümmert euch nicht um mich. Ihr solltet ihr lieber hinterher. Das ist sehr gefährlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030418,
					"content": "Du solltest zurück nach Quellingen gehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030419
					]
				},
				{
					"id": 110030412,
					"content": "Sogar bei sowas kannst du ans Essen denken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030413
					]
				}
			]
		},
