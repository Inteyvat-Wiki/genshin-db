			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klotz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330601,
					"content": "Sieht super aus! Alles ist bereit, jetzt fehlt nur noch Ziwei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klotz"
				}
			]
		},
		{
			"id": 4133307,
			"completionStepIds": [
				4133309,
				4133310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133309",
							"2"
						],
						"stepId": 4133309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ziwei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330701,
					"content": "Aus diesem Blickwinkel ... sieht das Sternbild aus wie ein Hund. Jetzt fehlt mir noch ein passender Name ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330702
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330702,
					"content": "Oh, du bist es, Klotz. Was machst du hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330703
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330703,
					"content": "Ähm, also, es ist so ... Äh, I... Ich war gerade ein wenig im Freien spazieren, da bin ich über dieses hübsche Plätzchen gestolpert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330704
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330704,
					"content": "Ein hübsches Plätzchen? Meinst du zum Sternegucken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330705
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330705,
					"content": "Ja, so ist es! Ein hübsches Plätzchen zum Sternegucken. Und, um Laternen steigen zu lassen ... Ich habe schon eine für uns vorbereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330706
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330706,
					"content": "Und hier, ich habe auch ein Gedicht darauf verfasst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330707
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330707,
					"content": "„Die Funken fliegen, wo Schaufel und Meteoriten sich treffen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330708
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330708,
					"content": "Ja ... Nun, deinen Wunsch kenne ich zwar nicht wirklich, aber das Gedicht klingt faszinierend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330709
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330709,
					"content": "Doch du solltest anderen deinen Wunsch erst mitteilen, wenn die Laterne aufsteigt, sonst wird er sich nie erfüllen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330710
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330710,
					"content": "Also, was genau brauchst du von mir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330711
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330711,
					"content": "Also, ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330712,
						413330713
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330712,
					"content": "Er hat einen passenden Ort gefunden, um eine Laterne aufsteigen zu lassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				},
				{
					"id": 413330714,
					"content": "Eine Laterne aufsteigen lassen? Oh, tut mir leid ... aber eigentlich wollte ich dem Trubel mit all den Laternen aus dem Weg gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330715
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330715,
					"content": "Die ganzen Laternen verdecken mir die Sicht auf die Sterne. Ich wollte so weit wie möglich vom Fest entfernt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330716
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330716,
					"content": "Aber danke für das nette Angebot. Ich muss jetzt weiter, frohes Laternenritual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330717
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330717,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330718,
						413330719
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330718,
					"content": "Weg ist sie ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330720,
					"content": "Ist ... Ist schon gut. Mein Gedicht war wohl zu abstrakt. Ziwei hat es nicht verstanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330721
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330721,
					"content": "Keine Sorge, ich lasse mich nicht entmutigen. Eines Tages wird sie mich verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330722
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330722,
					"content": "#Danke jedenfalls für deine Hilfe, {F#Reisende}{M#Reisender}. Hier, das ist für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330723
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330723,
					"content": "Oh, ich sollte wenigstens die Laterne steigen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330719,
					"content": "Kopf hoch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330713,
					"content": "Wenn du sie heute Abend aufsteigen lassen willst, kannst du das mit ihm tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				}
			]
		},
