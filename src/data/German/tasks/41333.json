			"dialogs": [
				{
					"id": 413330501,
					"content": "Das sollte ausreichen. Suchen wir jetzt nach Ziwei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klotz"
				}
			]
		},
		{
			"id": 4133306,
			"completionStepIds": [
				4133308
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
