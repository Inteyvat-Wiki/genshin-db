			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klotz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330101,
					"content": "Der „Rätselhafte Adept im höchsten Himmel“, über allen schwebend. Er ist so wunderschön ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330102
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330102,
					"content": "Beobachtest du die Sterne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330103
					]
				},
				{
					"id": 413330103,
					"content": "Ja ... und nein. Es ist schließlich das Laternenritual. Es erscheint nur passend, so etwas Elegantes während dieser festlichen Zeiten anzublicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330104
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330104,
					"content": "Ich habe sogar gelernt, Poesie zu schreiben. Die anderen Jungs haben mir erzählt, dass die Mädchen heutzutage wirklich auf solche Dinge stehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330105
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330105,
					"content": "Ich bin mir sicher, dass Ziwei dazu bereit ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330106,
						413330107
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330106,
					"content": "Poesie zu lernen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330108
					]
				},
				{
					"id": 413330108,
					"content": "Hm, ähm, na ja. Ich habe viele Namen von Sternbildern von Ziwei gehört. *seufz* Sie sind alle so wunderschön ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330109
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330109,
					"content": "Darum muss ich mich irgendwie bei ihr bedanken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330110
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330110,
					"content": "Ich hatte an ein selbst verfasstes Gedicht für eine Laterne gedacht, um sie zusammen mit Ziwei fliegen zu lassen ... Mit Leckereien und Liedern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330111
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330111,
					"content": "Wenn das nicht hilft, weiß ich auch nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330112
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330112,
					"content": "Helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330113
					]
				},
				{
					"id": 413330113,
					"content": "Ähem, ich meinte ... Auf diese Weise können wir das Fest noch mehr genießen ... Ja, das ist es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330114
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330114,
					"content": "Jedenfalls brauche ich einen ruhigen, malerischen Ort abseits des Trubels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330115
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330115,
					"content": "Ich habe mich umgehört, bislang gibt es zwei Möglichkeiten. Hier, guck mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330116
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330116,
					"content": "Die anderen meinten, sie hätten dort bereits Laternen starten lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330117
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330117,
					"content": "Doch ich muss noch ein Gedicht verfassen ... und wenn ich stattdessen diese Orte überprüfe, dämpft das meine Kreativität.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330118
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330118,
					"content": "Würdest du diese beiden Plätze für mich überprüfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330119
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330119,
					"content": "Werde ich machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330120
					]
				},
				{
					"id": 413330120,
					"content": "Danke für deine Hilfe, ich zähle auf dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330107,
					"content": "Ziwei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330108
					]
				}
			]
		},
		{
			"id": 4133302,
			"completionStepIds": [
				4133304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133304",
							"2"
						],
						"stepId": 4133304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klotz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330201,
					"content": "„Ziwei stolpert über einen Brocken Eisen ...“ Nein, nein, das passt nicht. Das wäre zu dick aufgetragen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330202
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330202,
					"content": "Oh, seit wann bist du hier? Hast du dir diese beiden Plätze angesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330203
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330203,
					"content": "Haben wir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330204
					]
				},
				{
					"id": 413330204,
					"content": "Das ging ja fix. Lass mich sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330205
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330205,
					"content": "Gut, lass mich mal sehen ... Hmm, dieser Ort trumpft eher durch die unmittelbare Umgebung, während der andere eher durch die Landschaft überzeugt. Das erinnert mich an den Spruch: „Kein Berg ist zu hoch, kein ...“ Äh, dann hab ich den Text vergessen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330206
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330206,
					"content": "Wie auch immer ... Beide Plätze wissen zu beeindrucken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330207
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330207,
					"content": "#Ich hab’s! Jetzt weiß ich, welchen ich nehme ... Doch um eines muss ich dich noch bitten, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330208
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330208,
					"content": "Meine Freunde meinten, zu einem Treffen sollte man mit etwas zum Futtern erscheinen. Was sollte ich für Ziwei vorbereiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330209,
						413330211
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330209,
					"content": "Gegrillten Tigerfisch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330210
					]
				},
				{
					"id": 413330210,
					"content": "Gegrillter Tigerfisch, hmm ... Ist das nicht ein wenig zu ölig? Vielleicht lieber etwas Feineres, wie Mandeltofu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330212
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330212,
					"content": "Genau, Mandeltofu! Das wäre perfekt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330213
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330213,
					"content": "#{F#Reisende}{M#Reisender}, würdest du mir mit einer Portion Mandeltofu aushelfen? In der Zwischenzeit schreibe ich mein Gedicht. Wie geht die nächste Zeile ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330214
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330214,
					"content": "„Und unzählige Funken stoben“ ... Oh, das ist gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330211,
					"content": "Mandeltofu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330212
					]
				}
			]
		},
