			"dialogs": [
				{
					"id": 413330401,
					"content": "Wie? Bilde ich mir das ein ... oder riecht dieser Tofu komisch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330402
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330402,
					"content": "Das kann ich Ziwei unmöglich anbieten. Könntest du noch eine Portion besorgen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klotz"
