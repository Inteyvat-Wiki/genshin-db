			"dialogs": [
				{
					"id": 413330301,
					"content": "Oh, du bist zurück! Hast du den Mandeltofu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330302,
						413330303
					],
					"speakerTitle": "Klotz"
				},
				{
					"id": 413330302,
					"content": "Hier ist er.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 413330303,
					"content": "Ich brauche noch ein wenig Zeit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330304
					]
				},
				{
					"id": 413330304,
					"content": "Ah, nein, es ist nichts. Ich werde mich noch weiter mit diesem Gedicht beschäftigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klotz"
				}
			]
		},
