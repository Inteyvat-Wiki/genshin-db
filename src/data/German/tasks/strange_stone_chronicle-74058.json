			"dialogs": [
				{
					"id": 740580101,
					"content": "Puca, da sind wir wieder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580102,
					"content": "#Ah, {NICKNAME} und Paimon! Seid ihr hier, um mit Puca zu spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580103
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580103,
					"content": "Eigentlich nicht, hehe. Äh, Paimon erinnert sich, dass du gesagt hast, wir können dich nach den Erzadern und den Erzen hier in der Gegend fragen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580104,
					"content": "Ja! Ich habe alle schönen Steine hier in der Gegend gesammelt, nach welcher Art von Steinen sucht ihr denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580105
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580105,
					"content": "Hm, nach dem, den wir letztes Mal gefunden haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580106,
					"content": "Ihr erzählt Puca von dem seltsamen Erz, das ihr an den Edelsteinhändler am Hof von Fontaine verkauft habt ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740580107
					]
				},
				{
					"id": 740580107,
					"content": "Hä? Für die Außenwelt ist das also ein wertvoller Edelstein? Ich habe ihn meiner Schwester schon einmal gezeigt ... Ich verstehe nicht, was die Menschen da draußen denken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580108
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580108,
					"content": "Aber ich weiß noch, dass es viele Orte gibt, an denen solche Steine zu finden sind. Wenn ihr sie braucht, kann ich euch die Lage sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580109
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580109,
					"content": "Puca hat die Orte markiert, an denen ihr das seltsame Erz finden könnt.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740580110
					]
				},
				{
					"id": 740580110,
					"content": "Das ist fantastisch. Danke, Puca! Übrigens, hier sind die Mora, die Chesil uns im Voraus bezahlt hat. Mal sehen ... Ich kann dir die Hälfte davon geben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580111,
					"content": "Ach, das ist schon in Ordnung. So etwas können wir im Dorf sowieso nicht gebrauchen ... Ganz zu schweigen davon, dass ihr mir auch so viel geholfen habt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				}
			]
		},
