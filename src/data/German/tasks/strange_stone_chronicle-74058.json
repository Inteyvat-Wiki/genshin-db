						740580402
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580402,
					"content": "Habt ihr das Erz mitgebracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580403
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580403,
					"content": "Nein, noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740580404
					]
				},
				{
					"id": 740580404,
					"content": "Na gut, ich habe es auch nicht sehr eilig ... Die Handwerker arbeiten schließlich immer noch an der Erzprobe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580405
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580405,
					"content": "Aber wenn wir früher mehr davon bekommen, können die Handwerker vielleicht ein paar neue Inspirationen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580406
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580406,
					"content": "Also warte ich einfach mal auf eure gute Nachricht.",
					"roleType": "TALK_ROLE_NPC",
