			"dialogs": [
				{
					"id": 740580201,
					"content": "Unglaublich, dass es so viel gibt ... Das ist eine große Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580202
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580202,
					"content": "Obwohl es scheint, als wüsste der Handwerker nicht viel über die Eigenschaften dieser Art von Edelsteinen, deshalb ist etwas schiefgegangen ... Der letzte Edelstein, der zur Bearbeitung geschickt wurde, ist immer noch nicht fertig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580203
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580203,
					"content": "Aber das auch in Ordnung, ich vertraue meiner Entscheidung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580204
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580204,
					"content": "Ich werde aus ihnen die modischsten Schmuckstücke machen, und bis dahin werden sie Fontaine bestimmt im Sturm erobern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580205
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580205,
					"content": "Wenn ihr das nächste Mal kommt, könnt ihr das fertige Produkt schon sehen! Ich werde euch auch einige Muster als Belohnung geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580206
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580206,
					"content": "Aber vielleicht könnt ihr es schon bald an den Menschen mit Format sehen, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580207
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580207,
					"content": "Ich freue mich darauf, euch wiederzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chesil"
				}
			]
		},
