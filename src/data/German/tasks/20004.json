					"Goth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040401,
					"content": "Und, hast du diese ... äh ... deine Freundin gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040402
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040402,
					"content": "Das ist die Miete.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040403
					]
				},
				{
					"id": 200040403,
					"content": "Gut, gut, das ist genug Geld, danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040404
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040404,
					"content": "Aber was genau macht diese Freundin von euch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040405
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040405,
					"content": "Sie sieht so fähig aus und doch ist sie immer pleite ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				}
			]
		},
		{
			"id": 2000405,
			"completionStepIds": [
				2000405
			],
