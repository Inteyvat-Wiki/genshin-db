			]
		},
		{
			"id": 2000407,
			"completionStepIds": [
				2000407
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2000407",
							"2"
						],
						"stepId": 2000407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Goth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040701,
					"content": "Danke, das ist genug Holz, ich bringe es zum Schreiner ... Stimmt ja, ich muss ja noch die Miete kassieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040702
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040702,
					"content": "Leider frage ich mich, ob diese ... Astro... Astrologin ... was auch immer ... Mona ... diesmal zu Hause ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040703
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040703,
					"content": "Astrologin Mona Megistus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040704
					]
				},
				{
					"id": 200040704,
					"content": "Ja! Das ist der Name, huch ... Ich kann es mir wirklich nicht merken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040705
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040705,
					"content": "Hm? Hat Mona ihre Miete noch nicht bezahlt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200040706,
					"content": "Tja, alle anderen Mieter hatten ihre Miete bezahlt und sie war die Einzige, die noch übrig war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040707
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040707,
					"content": "Ich habe sie mehrmals besucht, aber sie ist nie zu Hause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040708
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040708,
					"content": "#{F#Reisende}{M#Reisender}, lauf bitte für mich hin und bitte sie, die Miete zu zahlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				}
			]
		},
