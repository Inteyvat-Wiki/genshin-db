				"points": []
			},
			"dialogs": [
				{
					"id": 200040501,
					"content": "Ihr seid zurück. Ist die Miete schon an Goth übergeben worden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040502
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040502,
					"content": "Wir haben ihm alles gegeben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040503
					]
				},
				{
					"id": 200040503,
					"content": "Das ist gut. Zum Glück ist die Miete nicht allzu hoch ... Das Geld reicht gerade noch so aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040504,
					"content": "Aber es sieht so aus, als müsste ich noch ein paar Tage lang Salat essen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 2000406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
