			"dialogs": [
				{
					"id": 200040601,
					"content": "Hast du das Holz bekommen? Nur eine Portion Tannenholz und eine Portion Birkenholz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
