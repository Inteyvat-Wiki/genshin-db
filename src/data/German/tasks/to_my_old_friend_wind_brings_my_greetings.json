			},
			"dialogs": [
				{
					"id": 400040901,
					"content": "He du, das ist der falsche Weg. Egal wo du hinwillst, du solltest dorthin gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040902
					],
					"speakerTitle": "Belle"
				},
				{
					"id": 400040902,
					"content": "Liegt dort nicht Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040903,
					"content": "Ja, dort geht es nach Liyue. Dafür gibt es hier gar nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040904
					],
					"speakerTitle": "Belle"
				},
				{
					"id": 400040904,
					"content": "Wenn ihr Hunger habt oder eine Bleibe für die Nacht sucht, könnt ihr zum Gasthaus Wangshu gehen. Die Preise sind gerechtfertigt und die Dienstleistungen sind Spitzenklasse. Auch die Aussicht ist grandios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040905
					],
					"speakerTitle": "Schlitzohr"
				},
				{
					"id": 400040905,
					"content": "Wir wollen den anonymen Brief sehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040906
					]
				},
				{
					"id": 400040906,
					"content": "Wie kommt es, dass du davon weißt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040907
					],
					"speakerTitle": "Belle"
				},
				{
					"id": 400040907,
					"content": "Das ... Das hat uns ein Adept von Liyue erzählt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040908,
					"content": "Du hättest dir ruhig mehr Mühe geben können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040909
					],
					"speakerTitle": "Belle"
				},
				{
					"id": 400040909,
					"content": "Das stimmt. Ich habe sie beauftragt, den Fall zu untersuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040910
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040910,
					"content": "Gibt es irgendein Problem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040911
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040911,
					"content": "Sssseid Ihr ... der Schützende Yaksha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040912
					],
					"speakerTitle": "Belle"
				},
				{
					"id": 400040912,
					"content": "Wieso gehst du beim Anblick eines Adepten gleich in Angriffshaltung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040913,
					"content": "Natürlich glaube ich Euch, dass Ihr ein Adept seid ... Ich möchte Euch lediglich dazu anhalten gründlich nachzudenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040914
					],
					"speakerTitle": "Schlitzohr"
				},
				{
					"id": 400040914,
					"content": "Sicher wisst Ihr, dass die Schatzräuber nichts Böses im Sinn haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040915
					],
					"speakerTitle": "Belle"
				},
				{
					"id": 400040915,
					"content": "Als Adept solltet Ihr Gnade walten lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040916
					],
					"speakerTitle": "Schlitzohr"
				},
				{
					"id": 400040916,
					"content": "Aber wenn Ihr kein Adept seid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040917
					],
					"speakerTitle": "Belle"
				},
				{
					"id": 400040917,
					"content": "Dann solltest du besser aufpassen, was du sagst, bevor meine Lanze noch jemandem ein Auge aussticht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Schlitzohr"
				}
			]
		}
	]
}