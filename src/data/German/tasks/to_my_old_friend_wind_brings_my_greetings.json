			},
			"dialogs": [
				{
					"id": 400040301,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040302
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040302,
					"content": "Bist du der Informant, von dem Kaeya gesprochen hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040303,
					"content": "Was für ein Informant?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040304
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040304,
					"content": "Du bist der einzige, der hier aufgetaucht ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040305,
					"content": "Hier? Wovon sprichst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040306
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040307,
					"content": "Betrunkene sprechen die Wahrheit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040308
					]
				},
				{
					"id": 400040310,
					"content": "Es, es liegt am Alkohol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040311
					]
				},
				{
					"id": 400040306,
					"content": "Mann, kannst du mal einen vollständigen Satz rausbringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040307,
						400040310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040308,
					"content": "Gut, wird sind von derselben Seite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040309
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040309,
					"content": "Was soll diese Geheimniskrämerei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040311,
					"content": "Hmmja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040312
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040312,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040313,
					"content": "Na ja, die Parole war zwar falsch, aber die Wahrheit wirst du wohl auch ohne Alkohol sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040314
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040314,
					"content": "Genau, wir sind von derselben Seite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040315
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040315,
					"content": "Was soll diese Geheimniskrämerei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040316,
					"content": "Was wollt ihr denn wissen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040317
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040317,
					"content": "Das ist folgendermaßen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040318,
					"content": "Ach so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040319
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040319,
					"content": "Weißt du vielleicht etwas, das damit zu tun haben könnte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040320,
					"content": "Ich glaube, dass das nichts mit den Schatzräubern zu tun hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040321
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040321,
					"content": "Es gibt einen guten Grund, weshalb die Schatzräuber so effizient grenzübergreifend agieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040322
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040322,
					"content": "Man kriegt, was man verdient. So heißt es jedenfalls. Die Schatzräuber sagen aber, dass man nur den richtigen Plan braucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040323
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040323,
					"content": "Liyue wird von den Adepten beschützt, besonders zur Zeit des Laternenrituals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040325
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040324,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040325,
					"content": "Beim Laternenritual zuzuschlagen, sowas würden wir – tut mir leid, ich bin so in meiner Rolle – sowas würden die Schatzräuber nie tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040326
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040326,
					"content": "Außerdem haben die Schatzräuber in Liyue zuletzt einen anonymen Brief erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040327
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040327,
					"content": "Einen anonymen Brief? Will da etwa jemand den Schatzräubern etwas in die Schuhe schieben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040328,
					"content": "Das weiß ich natürlich nicht. Sagen kann ich euch aber, wo ihr die Schatzräuber finden könnt, bei denen der Brief jetzt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040329
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040329,
					"content": "So, jetzt ist der Ort auf eurer Karte markiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040330
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040330,
					"content": "#Das hat sich doch gelohnt! {NICKNAME}, wir müssen unserer einzigen Spur unbedingt folgen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040331,
					"content": "Also, wenn nichts weiter ist, gehe ich wieder zu den Schatzräubern ... Ich meine, dann gehe ich wieder die Schatzräuber überwachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
		{
			"id": 4000408,
			"completionStepIds": [
				4000408
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
