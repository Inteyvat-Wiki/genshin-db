			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Belle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400040801,
					"content": "O großer Held! Allwissender Adept, habt Gnade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040802
					],
					"speakerTitle": "Belle"
				},
				{
					"id": 400040802,
					"content": "In diesem anonymen Brief steht nichts von Bedeutung! Das wird sich auch nicht ändern, wenn sich unsere Waffen kreuzen! Hier, nehmt ihn einfach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040803
					],
					"speakerTitle": "Schlitzohr"
				},
				{
					"id": 400040803,
					"content": "Gut, das habe ich mir von Anfang an gedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040804,
					"content": "#{NICKNAME}, sehen wir uns an, was in dem Brief steht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040805,
					"content": "Interessant ... Lassen wir die beiden hier doch zu dem Treffen gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040806
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040806,
					"content": "Der Verfasser des Briefs scheint die Festlichkeiten des Laternenrituals nutzen zu wollen, um einen Anschlag zu verüben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040807
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040807,
					"content": "Das klingt ja alles ganz gut. Mir ist egal, wer hingeht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040808
					],
					"speakerTitle": "Belle"
				},
				{
					"id": 400040808,
					"content": "Das Problem ist nur, dass wir uns nicht gerade ähneln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040809
					],
					"speakerTitle": "Schlitzohr"
				},
				{
					"id": 400040809,
					"content": "Mach dir da mal keine Sorgen. Mit einer guten Verkleidung lässt sich das arrangieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040810,
					"content": "Ich habe zwar so meine Bedenken. Aber mit einem Adepten im Boot dürfte nicht viel schiefgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040811
					],
					"speakerTitle": "Belle"
				},
				{
					"id": 400040811,
					"content": "Ja gut, dann hängt das Schicksal von Liyue jetzt an euch beiden. Die Schatzräuber haben auch kein Interesse daran, dass die ganze Hafenstadt untergeht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040812
					],
					"speakerTitle": "Schlitzohr"
				},
				{
					"id": 400040812,
					"content": "Sehr gut! Dann sollte ja alles geklärt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040813
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040813,
					"content": "Einen Moment noch ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040814
					]
				},
				{
					"id": 400040814,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040815
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040815,
					"content": "Wenn wir uns das nächste Mal treffen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040816
					]
				},
				{
					"id": 400040816,
					"content": "Ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040817
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040817,
					"content": "Dann wäre es gut, wenn wir uns dort treffen würden, wo man die Mingxiao-Laterne sehen kann.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040818
					]
				},
				{
					"id": 400040818,
					"content": "Ich mag es nicht, immer hin- und herlaufen zu müssen, besonders nicht in dieser Zeit des Jahres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040819
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040819,
					"content": "Ist das wirklich notwendig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040820
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040820,
					"content": "Ja, ist es!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040821
					]
				},
				{
					"id": 400040821,
					"content": "Ist gut ... Ich werde dort auf Nachricht von euch warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				}
			]
		},
		{
			"id": 4000409,
			"completionStepIds": [
				4000409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
