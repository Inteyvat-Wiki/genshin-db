			},
			"dialogs": [
				{
					"id": 721270201,
					"content": "Hast du die Zuckerblumen gepflückt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
		{
			"id": 7212703,
			"completionStepIds": [
				7212703
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212703",
							"2"
						],
						"stepId": 7212703,
						"stateName": "QUEST_STATE_UNFINISHED"
