			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721270101,
					"content": "Du bist hier. Siehst du die vielen blühenden Blumen? Sind sie schön?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270102,
						721270104
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270102,
					"content": "Sehr schön.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270103
					]
				},
				{
					"id": 721270103,
					"content": "Hehe ... Natürlich. Ich kümmere mich gut um sie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270106
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270106,
					"content": "Übrigens, kannst du mir wieder helfen? Die Blumen blühen jetzt so gut. Ich wollte ein paar Blumen pflücken, sie zu Trockenblumen machen und sie zusammen mit Briefen an diejenigen schicken, die noch nicht nach Tatarasuna zurückgekehrt sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270107
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270107,
					"content": "Aber ... Ich weiß nicht, ob es daran liegt, dass ich zu wenig Schlaf hatte. Ich bin gerade rausgegangen, um ein paar Blumen zu pflücken und ich bin schon so müde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270108
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270108,
					"content": "Kannst du mir bitte helfen, ein paar Zuckerblumen hier zu pflücken? Drei reichen aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270109,
						721270111
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270109,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270110
					]
				},
				{
					"id": 721270110,
					"content": "Dann überlasse ich dir die Aufgabe. Ich werde hier eine Pause machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270112
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270112,
					"content": "Ich möchte nur den herrlichen Duft von Zuckerblumen. Andere getrocknete Blumen werden auch in den Briefen enthalten sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270113
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270113,
					"content": "Ich glaube, dass diejenigen, die diesen Brief lesen, umgeben von einem so angenehmen Duft, zumindest in eine bessere Stimmung versetzt werden könnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270114
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270114,
					"content": "Dann überlasse ich dir die Aufgabe. Ich werde hier eine kurze Pause machen. Nachdem du die Blumen gepflückt hast, bringe sie mir bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270111,
					"content": "Zuckerblumen scheinen überall zu sein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270112
					]
				},
				{
					"id": 721270104,
					"content": "Wie lange hast du schon gepflanzt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270105
					]
				},
				{
					"id": 721270105,
					"content": "So lange ist es nicht. Es ist nur ... Ich schlafe einfach ein bisschen weniger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270106
					],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
		{
			"id": 7212702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
