				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721270301,
					"content": "Vielen Dank! Diese Zuckerblumen reichen aus. Ich werde später die getrockneten Blumen machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270302
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270302,
					"content": "Ach ja, ich habe ein kleines Geschenk für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270303
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270303,
					"content": "Hier, bitte nimm diese getrocknete Blume. Sie ist zwar etwas verwelkt ... Aber es ist eine sehr wertvolle Blume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270304,
						721270305
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270304,
					"content": "Danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270307
					]
				},
				{
					"id": 721270307,
					"content": "Dies ist die erste Blume, die in diesem Blumenmeer erblüht ist. Du hast mir geholfen, die Blumensamen zu finden. Deshalb möchte ich dir diese Blume schenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270308
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270308,
					"content": "Es ist zwar nichts sehr Wertvolles, aber ... Vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270309
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270309,
					"content": "Alle Leute werden zurückkehren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270310
					]
				},
				{
					"id": 721270310,
					"content": "Ja. Ich muss mehr Blumen pflanzen, damit alle mehr Blumen sehen können, wenn sie zurückkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270305,
					"content": "Gibt es etwas Besonderes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270306
					]
				},
				{
					"id": 721270306,
					"content": "Natürlich, sonst würde ich sie dir nicht extra geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270307
					],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		}
	]
}