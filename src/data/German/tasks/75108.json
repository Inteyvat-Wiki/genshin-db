			"dialogs": [
				{
					"id": 751080101,
					"content": "Wir sagten, wir würden kochen, aber was genau sollten wir machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080102,
					"content": "Wir haben doch einmal die Pummelrobbe „Weinbeere“ mit Fisch gefüttert. So ein Fischgericht wäre bestimmt eine gute Sache!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080103,
					"content": "#Paimon will, dass die Pummelrobbe und {REALNAME[ID(2)|SHOWHOST(true)]} es sich richtig gutgehen lassen. Dafür sollte „gegrillter Fisch in Minzsauce“ aus Natlan genau das Richtige sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080104,
						751080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080104,
					"content": "Das ist meine Spezialität.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				},
				{
					"id": 751080106,
					"content": "Na gut, dann fangen wir an. Paimon kann dir beratend zur Seite stehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080107,
						751080109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080107,
					"content": "Die Einschnitte etwas tiefer machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080108
					]
				},
				{
					"id": 751080108,
					"content": "Genau, so zieht der Geschmack besser ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080111,
					"content": "Ein wenig mehr Salz macht es umso köstlicher.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080112
					]
				},
				{
					"id": 751080112,
					"content": "#Mmh, das kräftige Aroma wird der Pummelrobbe und {REALNAME[ID(2)|SHOWHOST(true)]} bestimmt gefallen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080115,
					"content": "Mit der Minzsauce kann man ruhig großzügig sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080116
					]
				},
				{
					"id": 751080116,
					"content": "Dieser frische, kühle Geschmack ist bestimmt unwiderstehlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080119,
					"content": "Chilischoten dürfen auf keinen Fall fehlen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080120
					]
				},
				{
					"id": 751080120,
					"content": "Die richtige Prise Schärfe regt den Appetit an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080123,
					"content": "Heiß auf offener Flamme gegrillt, außen knusprig, innen zart!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080124
					]
				},
				{
					"id": 751080124,
					"content": "Haha, das klingt so lecker, dass Paimon das Wasser im Mund zusammenläuft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080127,
					"content": "#Nach einer aufregenden Kochstunde ist die Fischspezialität für {REALNAME[ID(2)|SHOWHOST(true)]} und die Pummelrobbe servierfertig ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 751080125,
					"content": "Langsam geröstet, butterzart und saftig!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080126
					]
				},
				{
					"id": 751080126,
					"content": "#Hui, unglaublich, die geheime Grillkunst von {NICKNAME} ... Wer weiß, vielleicht kann das eines Tages dein Markenzeichen werden, und du kannst es für deine Freunde zubereiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080121,
					"content": "Vielleicht reagieren die Lebewesen aus Fontaine empfindlich auf scharfes Essen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080122
					]
				},
				{
					"id": 751080122,
					"content": "Aber ganz ohne Chili fehlt irgendwas. Also lass uns doch einfach ein klein wenig dazugeben, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080117,
					"content": "Ob die frische Minze einem Wassertier wie der Pummelrobbe schmeckt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080118
					]
				},
				{
					"id": 751080118,
					"content": "Das hat doch damit nichts zu tun. Wenn die Pummelrobbe an Land kommt, wird sie ziemlich trocken und aufgewärmt sein, da kann ein bisschen Minzsauce doch zum Abkühlen helfen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080113,
					"content": "Der Geschmack ist intensiv genug, mehr Salz ist nicht nötig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080114
					]
				},
				{
					"id": 751080114,
					"content": "Genau, es kommen ja noch andere Gewürze, da muss man nicht viel Salz verwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080109,
					"content": "Die Schnitte etwas weniger tief machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080110
					]
				},
				{
					"id": 751080110,
					"content": "Auch nicht schlecht. Vielleicht wird der Geschmack dadurch milder und der natürliche Fischgeschmack bleibt drin. Das könnte der Pummelrobbe besser schmecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080105,
					"content": "Nicht meine Stärke, aber es wird schon klappen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				}
			]
		},
