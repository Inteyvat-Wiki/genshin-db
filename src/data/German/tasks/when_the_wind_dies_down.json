			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980101,
					"content": "Ah, ihr seid es ja wieder! Der Ehrenritter kehrt glorreich zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980102,
					"content": "#Hehe, {NICKNAME} hat Dvalin ordentlich eingeheizt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980103,
					"content": "Oh ja! Ihr seid gestern zurückgekehrt, nicht wahr? Jean ist schon vor euch wieder in Mondstadt angekommen und hat allen gesagt, was ihr geleistet habt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980104,
					"content": "Hmm, wann ich wohl mal die Chance habe, sowas Großes zu vollbringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980105,
						3980108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980105,
					"content": "Das haben wir doch nur dank deiner Unterstützung geschafft.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980106
					]
				},
				{
					"id": 3980106,
					"content": "Ach, Quatsch! Dass alles noch so friedlich ausgegangen ist, liegt voll und ganz an euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980107,
					"content": "Ich habe nur meine Pflichten als Kundschafterin erledigt, als ich euch nach Mondstadt begleitet habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980111,
					"content": "Haben wir doch gern gemacht! Aber sag mal, hast du hier auf uns gewartet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980112,
					"content": "Also ich muss diesmal zwar nicht raus, aber wichtig ist es trotzdem. Die ganze Aktion hat nämlich noch ein Nachspiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980113,
					"content": "Ein Nachspiel? Was ist denn in Mondstadt passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980114,
					"content": "Während Jean nicht hier war, haben sich einige Monster in der Nähe versammelt, um Mondstadt anzugreifen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980115,
					"content": "Glücklicherweise bin ich früh genug darauf aufmerksam geworden. Die Hilichurle bewegen sich immer weiter Richtung Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980116,
					"content": "Ach, Paimon weiß noch! Als wir uns das erste Mal gesehen haben, haben wir dir dabei geholfen, eins dieser Lager auszuradieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980117,
					"content": "Genau! Wenn wir nichts unternommen hätten, wäre Mondstadt jetzt schon in großer Gefahr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980118,
						3980121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980118,
					"content": "Gut, dass wir sie besiegt haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980119
					]
				},
				{
					"id": 3980119,
					"content": "Ja, die Lage ist aber immer noch angespannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980120,
					"content": "Hilichurle sollten eigentlich nicht die Fähigkeit haben, sich so gut zu organisieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980123,
					"content": "Deswegen vermuten wir, dass der Orden des Abgrunds dahintersteckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980124
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980124,
					"content": "Du meinst, sie haben die Hilichurle gesteuert? Wäre das auch Dvalin passiert, wenn wir ihn nicht befreit hätten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980125,
					"content": "Wahrscheinlich schon. Als Kundschafterin denke ich, dass wir uns ab jetzt mehr auf den Orden des Abgrunds konzentrieren sollten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980126,
					"content": "Ach, jetzt hab ich euch die Laune vermiest. Dabei seid ihr gerade erst von eurem großen Kampf zurückgekehrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980127
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980127,
					"content": "Stimmt ja, ich wollte euch doch auf eine Portion „Honigmöhren-Fleischpfanne“ einladen! Irgendwie sind wir in der ganzen Hektik davon abgekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980128
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980128,
					"content": "Dann nehmen wir diese Gelegenheit als Anlass zum Feiern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980129,
					"content": "Aber gern doch! Selbst wenn du es vergessen hättest, Paimon hätte dich auf jeden Fall wieder daran erinnert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980130,
					"content": "Hehe, ich habe auch lange keine Honigmöhren-Fleischpfanne mehr gehabt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980131
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980131,
					"content": "Geht schon mal zum <color=#00E1FFFF>Hirschjäger</color> und wartet da, bis ich fertig aufgeräumt habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980121,
					"content": "Was treibt die Hilichurle aber an?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980122
					]
				},
				{
					"id": 3980122,
					"content": "Echt seltsam ... Sie sollten eigentlich nicht die Fähigkeit haben, sich so gut zu organisieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980108,
					"content": "Du solltest diese „Chancen“ nicht überschätzen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980109
					]
				},
				{
					"id": 3980109,
					"content": "Ah, du hast recht. Schließlich ist es besser, wenn es gar nicht erst zu solchen Situationen kommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980110,
					"content": "Dank euch ist ja alles noch friedlich ausgegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "Amber"
				}
			]
		},
		{
