			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980901,
					"content": "Die Bedrohung durch den Drachen ist ja fürs Erste kein Problem mehr. Was habt ihr als Nächstes vor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980902
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980902,
					"content": "#Wir werden Mondstadt wohl verlassen und die anderen der sieben Städte nach {F#ihrem Bruder}{M#seiner Schwester} absuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980903,
					"content": "Oh, na, dann heißt es wohl Abschiednehmen fürs Erste ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980904,
						3980905
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980904,
					"content": "Ich verlasse Mondstadt auch nur ungern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980906
					]
				},
				{
					"id": 3980906,
					"content": "Denk einfach dran, solange der Wind weht, wirst du ein Mitglied des Ordo Favonius, ein Ehrenritter sein, egal wo du hingehst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980907,
						3980908
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980907,
					"content": "Möge der Wind uns führen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980909
					]
				},
				{
					"id": 3980909,
					"content": "Die Tore Mondstadts stehen immer für euch offen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980910
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980910,
					"content": "Aber jetzt haut rein, sonst wird das Essen noch kalt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980911
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980911,
					"content": "Mmmh, wie lecker! Deine Empfehlung war klasse! Da hat Paimon nicht umsonst gewartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980912,
					"content": "Das hoffe ich doch! Kochen kann ich zwar nicht, aber essen dafür umso besser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980913
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980913,
					"content": "Ach so, hätte ich jetzt fast vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980914
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980914,
					"content": "Jean wartet in der <color=#00E1FFFF>Kathedrale</color> auf dich. Anscheinend geht es um die Heilige Leier. Ich glaube, du solltest sie nicht zu lange warten lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980908,
					"content": "Ich werde bestimmt zurückkommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980909
					]
				},
				{
					"id": 3980905,
					"content": "Ich lasse den Ritterorden auch nur ungern zurück.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980906
					]
				}
			]
		},
