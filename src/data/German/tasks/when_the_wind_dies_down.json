			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980201,
					"content": "Das war also tatsächlich Dvalin, einer der Vier Winde! Wir dürfen nicht vergessen, welches Opfer er für uns hier in Mondstadt gebracht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980202
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980202,
					"content": "Wir haben solches Glück, dass dem Drachen des Ostens noch nichts geschehen ist, das man nicht mehr hätte rückgängig machen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980203
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980203,
					"content": "Gut, dass wir solche zuverlässigen Leute wie euch und Jean haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980204
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980204,
					"content": "Mit dem Ordo Favonius wird Mondstadt auch in Zukunft so friedlich und frei bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
