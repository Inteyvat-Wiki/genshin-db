			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980301,
					"content": "Vielen Dank! Endlich ist alles vorbei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980302
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980302,
					"content": "Angesichts dieser großen Gefahr waren die Handelswege ja nicht mehr sicher. Wenn Getreide und Obst nicht mehr geliefert werden können, ist das noch eine Sache. Wenn es aber um den Alkohol geht, hört der Spaß auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980303
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980303,
					"content": "Ich könnte mir eine Zukunft ohne Wein gar nicht vorstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980304
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980304,
					"content": "Hoffentlich sind die Handelswege bald wieder befahrbar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
