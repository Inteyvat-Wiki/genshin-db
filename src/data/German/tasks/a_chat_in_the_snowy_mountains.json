			"dialogs": [
				{
					"id": 701140101,
					"content": "Es kommt wirklich selten vor, dass Fräulein Sandrone die Zeit findet, Mondstadt zu besuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140102
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140102,
					"content": "Du hast mir bei der Erforschung des arithmetischen Feldes eine unschätzbare Hilfe geleistet. Ich wollte mich persönlich bei dir bedanken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140103,
					"content": "Du bist zu freundlich. Aber solche Dinge liegen weit außerhalb meines Fachgebiets. Der Verdienst für die Fertigstellung gehört ganz allein dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140104,
					"content": "Das war Teamarbeit. Hmm ... Da fällt mir ein: Wo ist Durin? Da du praktisch sein Vormund bist, dachte ich, er dürfe sich nicht allzu weit von deiner Seite entfernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140105
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140105,
					"content": "Da liegst du nicht ganz falsch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140106,
					"content": "Aber in letzter Zeit macht er Fortschritte im Umgang mit anderen, also versuche ich, ihn zu ermutigen, ein bisschen selbstständiger zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140107,
					"content": "Machst du dir keine Sorgen um ihn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140108,
					"content": "Ein bisschen. Wenn er früher allein war und mit jemandem zu tun hatte, dessen Persönlichkeit ... sagen wir mal eher „stark“ war, neigte er dazu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140109,
					"content": "Seltsame Angewohnheiten zu übernehmen? Ungewöhnliche sprachliche Macken nachzuahmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140110,
					"content": "Ganz genau. Dann nehme ich an, du hast schon mal etwas Ähnliches erlebt, Fräulein Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140111,
					"content": "Hmpf, musst du da denn überhaupt noch fragen? Ich bin quasi eine Expertin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140112,
					"content": "Normalerweise nehme ich nach einem Treffen mit Großmeister Varka Durin mit und besuche gemeinsam mit ihm Saccharose, um ihr bei der Forschung zu helfen. Das hilft ihm, seinen Fokus wiederzufinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140113
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140113,
					"content": "Aber wenn er zu viel Zeit mit der amtierenden Großmeisterin Jean verbracht hat, besuchen wir Klee, damit er wieder lernt, sich zu entspannen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140114
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140114,
					"content": "Klingt nach viel Arbeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140115
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140115,
					"content": "Ich kümmere mich nur um meine Familie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140116,
					"content": "Wie würdest du mit solchen Situationen umgehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140117,
					"content": "Ich? Ich habe keine Energie für so ein Chaos ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140118,
					"content": "Aber mir scheint, wenn jemand von Natur aus gut ist, wird er immer zu seinem wahren Ich zurückkehren, egal, wie sehr er beeinflusst wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140119
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140119,
					"content": "Hmm ... Eine ausgezeichnete Beobachtung. Vielleicht kann ich mir diese Denkweise ebenfalls zu eigen machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
