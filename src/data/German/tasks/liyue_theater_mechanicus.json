				"points": []
			},
			"dialogs": [
				{
					"id": 400000201,
					"content": "Hallo! Möchtest du eine Runde Theater der Vorrichtungen spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000202
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000202,
					"content": "Theater der Vorrichtungen? Was ist das?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000203
					]
				},
				{
					"id": 400000203,
					"content": "Oh, noch nie davon gehört? Dann erlaube mir, es dir vorzustellen. Theater der Vorrichtungen ist eine Art Brettspiel, das von meiner Wenigkeit erfunden wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000204
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000204,
					"content": "Siehst du diese Teile, die hier auf dem Tisch liegen? Das sind alles wichtige Gegenstände im Spiel des Theater der Vorrichtungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000205
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000205,
					"content": "Sieht ziemlich kompliziert aus ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000206
					]
				},
				{
					"id": 400000206,
					"content": "Es mag kompliziert wirken, aber wenn du ein paar Mal gespielt hast, wirst du den Dreh raus haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000207
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000207,
					"content": "Also, wie sieht es aus? Möchtest du es mal ausprobieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000208,
						400000209
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000208,
					"content": "Äh, wie viel kostet es, zu spielen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				},
				{
					"id": 400000210,
					"content": "Nein, ganz und gar nicht. Es ist ja schließlich das Laternenritual. Außerdem möchte ich die ersten Eindrücke von allen sammeln, die das Spiel ausprobieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000211
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000211,
					"content": "Das Spiel kostet dich also nur eine einzige Laterne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000212
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000212,
					"content": "Wenn du es ausprobieren möchtest, bring mir einfach eine Laterne und du bist startklar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000213
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000213,
					"content": "Komm schon, versuch’s mal! Ich lasse dich sogar die erste Runde umsonst spielen und du kannst deine Laterne behalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000209,
					"content": "Das muss ziemlich teuer sein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				}
			]
		},
