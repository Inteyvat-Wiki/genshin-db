				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180201,
					"content": "Du bist ja schon wieder zurück, du bist wirklich tatkräftig dabei. Ich beginne zu begreifen, wieso der Herr dir so vertraut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180202,
						205180204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180202,
					"content": "Die Belohnung, jetzt und hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180203
					]
				},
				{
					"id": 205180203,
					"content": "Eiskalt, hmm ... Hier ist deine Belohnung. Du musst mich auch verstehen, ich bin nur ein Mittelsmann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180204,
					"content": "Das ist wirklich sehr nett und großzügig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180205
					]
				},
				{
					"id": 205180205,
					"content": "Nichts zu danken, keine Ursache. Nimm diese Belohnung. Und ... es war mir eine Freude!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051803,
			"completionStepIds": [
				2051805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051805",
							"2"
						],
						"stepId": 2051805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180301,
					"content": "Diese Schatzräuber ... Versteckt euch nur! Ihr wollt sicher nicht, dass ich erfahre, wo ihr seid!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180302
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180302,
					"content": "Ich weiß, wo sich die Schatzräuber aufhalten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180303
					]
				},
				{
					"id": 205180303,
					"content": "Was? Woher weißt du das? Oha, diese Markierungen auf deiner Karte sind wirklich sehr detailliert. Wo hast du sie her? Vile? Wer hätte das gedacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180304
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180304,
					"content": "Das ist nicht einmal in der Nähe von der Position, die wir zuvor aufgebaut hatten. Was ist denn jetzt genau das Ziel der Schatzräuber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180305
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180305,
					"content": "Entschuldige, ich werde mir das aufschreiben ... Gut, ich weiß Bescheid. Wir werden sofort jemanden schicken und das überprüfen lassen. Wenn etwas Wahres dran ist, werden wir sie mit allen Kräften zurücktreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180306
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180306,
					"content": "Erneuten Dank! Du hast so viel für Mondstadt getan! Diese Schatzräuber werden uns nicht entkommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 2051804,
			"completionStepIds": [
				2051806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051806",
							"2"
						],
						"stepId": 2051806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180401,
					"content": "Du bist ja schon wieder zurück! Das war aber wirklich schnell. Ich beginne zu begreifen, wieso der Herr dich mit solchen Angelegenheiten betraut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180402
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180402,
					"content": "Ich habe die Angelegenheit dem Ordo Favonius übergeben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180403
					]
				},
				{
					"id": 205180403,
					"content": "Dem Ordo Favonius ... Dabei habe ich doch gesagt, dass ich befürchte, das könnte nach hinten losgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180404
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180404,
					"content": "Du willst dich also davor drücken. Tja, wenigstens hat mich der Herr vorgewarnt. Da konnte ich mich seelisch darauf einrichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180405
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180405,
					"content": "Kümmer dich einfach nicht mehr darum. Ich werde mich bald wieder auf die Socken machen müssen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180406
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180406,
					"content": "Allerdings meinte dieser Herr, dass dein Verhalten die Angelegenheit auf eine lustige Bahn lenken könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180407
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180407,
					"content": "Schließlich wäre es zu durchschaubar gewesen, wenn ich selbst von den Schatzräubern Bericht erstattet hätte. Außerdem ist der Herr nicht in der Position, selbst zum Orden zu gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180408
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180408,
					"content": "Na ja, geb ich dir mal das hier. Dieser Herr meinte, ich solle dir das dafür geben, dass du den „Wind in die richtige Richtung gelenkt“ hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051802",
							"2"
						],
						"stepId": 2051802,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051803",
							"2"
						],
						"stepId": 2051803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180501,
					"content": "Bist du immer noch bei den Vorbereitungen? Wir ziehen los, sobald du damit fertig bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180502,
						205180506
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180502,
					"content": "Wer ist dieser Herr nur?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180503
					]
				},
				{
					"id": 205180503,
					"content": "Egal wie viele Fragen du mir stellen wirst, ich werde dir nicht antworten. Das ist eine unserer Basisregeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180504
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180504,
					"content": "Sollte es einmal vorkommen, dass wir dennoch etwas verraten, dann auch nur, weil wir die Anordnung dazu bekommen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180505
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180505,
					"content": "Richtig, da kannst du dir Gedanken drüber machen, welche Anweisungen das notwendig machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180506,
					"content": "Was ist denn euer Ziel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180507
					]
				},
				{
					"id": 205180507,
					"content": "Ziel ... Hmm, was die Ziele des Herrn sind, das weiß ich auch nicht. Aber egal was seine Motive sind, der Schutz von Mondstadt gehört bestimmt nicht dazu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180508
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180508,
					"content": "Nun, das wird es wohl sein, in solchen Angelegenheiten wird er nicht auf einmal seinen Geschmack ändern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180509
					],
					"speakerTitle": "Vile"
