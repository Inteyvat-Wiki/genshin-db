			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710430101,
					"content": "„... Serzhant Anton fand eine große Glocke im Südosten ... Auf der Felswand stand das Wort ‚sie‘ geschrieben ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430102
					],
					"speakerTitle": "Tagebuch der Fatui"
				},
				{
					"id": 710430102,
					"content": "„... Ähnlich der großen Glocke, die der Kapitan-Poruchik vorhin in den Ruinen im Nordwesten gesehen hat, vielleicht ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430103
					],
					"speakerTitle": "Tagebuch der Fatui"
				},
				{
					"id": 710430103,
					"content": "„... Wir haben Snezhevna und Fadeyka geschickt, um die Glocken in den Ruinen auf beiden Seiten zu läuten ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430104
					],
					"speakerTitle": "Tagebuch der Fatui"
				},
				{
					"id": 710430104,
					"content": "„... Ein grässlicher Pfeifton hallte über die Felswand, als sich der schwarze Nebel auflöste. Unerklärliche Merkwürdigkeiten ... scheinen die Ankunft von jemandem zu signalisieren ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430105
					],
					"speakerTitle": "Tagebuch der Fatui"
				},
				{
					"id": 710430105,
					"content": "„... Zehn Männer wurden getötet, beide Pioniertrupps erlitten schwere Verluste und der Kapitan-Poruchik befahl den sofortigen Rückzug ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430106
					],
					"speakerTitle": "Tagebuch der Fatui"
				},
				{
					"id": 710430106,
					"content": "(Aus dem Tagebuch rutscht eine einfache Karte heraus, auf der zwei große Glocken im Nordwesten und Südosten eingezeichnet sind und zwei markante Totenköpfe.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tagebuch der Fatui"
				}
			]
		},
