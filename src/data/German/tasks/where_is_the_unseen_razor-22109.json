					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221090301,
					"content": "Wie sieht’s aus? Hast du sie vernichtet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090302
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090302,
					"content": "Ja, ich habe sie besiegt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090303
					]
				},
				{
					"id": 221090303,
					"content": "Sehr schön! Diese Hilichurle haben dir hoffentlich nicht allzu sehr zu schaffen gemacht? Na ja, ich frage ja nur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090304
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090304,
					"content": "Immer noch kein Zeichen von irgendwelchen Säbeln? Na, das war ja abzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090305
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090305,
					"content": "Aber gut, hier ist deine Belohnung. Danke dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090306
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090306,
					"content": "Was ist mit dir und diesen Säbeln?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090307
					]
				},
				{
					"id": 221090307,
					"content": "Dir kann ich es ja sagen ... Ich suche nach einem Säbel, der „Versteckte Klinge“ genannt wird. Er gehörte meinem Bruder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090308
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090308,
					"content": "Doch mein Bruder ist von uns gegangen. Dabei trug er seinen Säbel aber nicht bei sich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090309
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090309,
					"content": "Ich kann mir beim besten Willen nicht vorstellen, was passiert sein könnte, dass er seine Waffe nicht bei sich hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090310
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090310,
					"content": "Ich habe bis jetzt nicht die leiseste Ahnung, wo der Säbel sein könnte oder was meinem Bruder zugestoßen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090311
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090311,
					"content": "Ich denke, viel mehr musst du nicht wissen. Hier ist deine Belohnung. Du kannst dich wieder um deine eigenen Angelegenheiten kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		}
	]
}