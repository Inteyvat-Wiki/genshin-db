				"points": []
			},
			"dialogs": [
				{
					"id": 221090201,
					"content": "Wie sieht’s aus? Hast du sie vernichtet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090202,
					"content": "Noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090203
					]
				},
				{
					"id": 221090203,
					"content": "Bereitest du dich ein wenig zu gut vor oder bist du einfach nur faul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090204
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090204,
					"content": "Oder beides?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
		{
