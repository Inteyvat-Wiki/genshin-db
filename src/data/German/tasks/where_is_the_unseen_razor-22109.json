					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221090101,
					"content": "Immer noch nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090103
					]
				},
				{
					"id": 221090103,
					"content": "Ihr schon wieder! Die Aufträge der Gilde scheinen immer einfacher zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090104,
					"content": "Wenn ihr Lust habt, könnt ihr noch eine Privatmission für mich übernehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090105,
					"content": "Auf der Guili-Ebene gibt es einen Ort, an dem sich viele Hilichurle mit Pfeil und Bogen versammelt haben. Sie bereiten den Leuten, die einfach nur ihres Weges gehen wollen, Ärger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090106,
					"content": "Es sind zwar nur Hilichurle, aber dafür sind es wirklich viele. Sie haben sich eine erhöhte Position ausgesucht, sodass normale Abenteurer schon einige Schwierigkeiten bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090107
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090107,
					"content": "Du musst sie einfach schnell vernichten. Danach werde ich dir auch eine entsprechende Belohnung geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090108,
					"content": "Und denke daran, wenn du etwas findest, das mit Säbeln zu tun hat, kannst du es zu mir bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090109,
						221090110
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090109,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090111
					]
				},
				{
					"id": 221090111,
					"content": "Bist du nur zu jung oder einfach sehr mutig, dass du überhaupt nicht zögerst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090112,
					"content": "#Aber ist schon verständlich. Du bist eben {F#eine waschechte Abenteurerin}{M#ein waschechter Abenteurer}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090115,
					"content": "Langer Rede kurzer Sinn, geh und vernichte die Monster, sobald du bereit bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090110,
					"content": "Was haben Hilichurle mit Schwertern zu tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090113
					]
				},
				{
					"id": 221090113,
					"content": "Du musst einfach nur die Augen offenhalten. Wenn du etwas findest, bringst du es einfach. Wenn nicht, auch nicht schlimm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090114,
					"content": "Das Ziel der Mission ist einfach nur, die Hilichurle zu vernichten. Wenn du das geschafft hast, bekommst du auch deine Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
