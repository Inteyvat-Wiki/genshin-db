			"dialogs": [
				{
					"id": 711151201,
					"content": "Boah! Plö... Plötzlich sieht er ganz anders aus ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151202,
					"content": "Hehe, da die große Dame der Medizin mir diesen Baum anvertraut hat, kann ich ihm nicht tatenlos beim Verdorren zusehen! Vielen Dank, ihr gutherzigen Freunde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151203
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711151203,
					"content": "Du hast dich nicht einmal an den Spruch erinnert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151204,
					"content": "Auf diese Einzelheiten kommt es nicht an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151205
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711151205,
					"content": "Ach ja, wenn es euch interessiert, verrate ich euch ein Geheimnis! Bricht man einen Zweig ab und steckt ihn in das Medizingefäß vor dem Tor der Wohnstätte, so lässt sich das Steintor öffnen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				}
			]
		},
