					{
						"sceneId": 3,
						"position": [
							1565.445,
							176.293,
							1792.852
						],
						"pointId": 310100247
					}
				]
			},
			"dialogs": [
				{
					"id": 711150501,
					"content": "Puh ... Stimmt, genau der!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150502
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150502,
					"content": "Yaojun aus dieser Wohnstätte schmückte ehemals mit diesen Schmetterlingen den Eingang. Später wurde die Vorrichtung der Wohnstätte beschädigt. Diese bunten Schmetterlinge und die Medizingefäße ... dienten einst dazu, den Adeptenbaum zu nähren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150503
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150503,
					"content": "Adeptenbaum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150504,
					"content": "Hmm, genau! Der Adeptenbaum wurde damals von Yaojun eigenhändig gepflanzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150505
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150505,
					"content": "Er mag jetzt vertrocknet wirken, doch Yaojun ließ wissen, dass der Baum zu neuem Leben erwachen kann, solange die bunten Schmetterlinge nicht gänzlich verschwunden sind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150506
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150506,
					"content": "*seufz* Nachdem sie ihre menschliche Gestalt nicht mehr beibehalten konnte, war sie rasch fortgegangen. Wie es ihr jetzt wohl gehen mag?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150507
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150507,
					"content": "„... Während die bunten Schmetterlinge sich in den Medizingefäßen versammeln, wird der tote Baum zum Leben erweckt ...“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150508
					]
				},
				{
					"id": 711150508,
					"content": "Richtig! Richtig! Solange ... Aber, woher wisst ihr das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150509
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150509,
					"content": "Egal, das ist der springende Punkt! Alles, was man tun muss, ist, die bunten Schmetterlinge in diese Medizingefäße zu geben und sie dem verwelkten Baum als Nahrung darzureichen! Ich beauftrage euch damit, ihr edlen Menschen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
