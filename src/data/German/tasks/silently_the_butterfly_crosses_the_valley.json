				]
			},
			"dialogs": [
				{
					"id": 711150401,
					"content": "Oh ... Hm? Wer nimmt sich das Recht, meinen Schlaf zu stören ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150402
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150402,
					"content": "Hä!? Wer spricht da? Wie gruselig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150403,
					"content": "Waah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150404
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150404,
					"content": "Waaaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150405,
					"content": "Hahahahaha! Du solltest dich fürchten! Wäre ich nicht in diesem Stein gefangen, hätte ich dich schon längst verschlungen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150406
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150406,
					"content": "Was ...? Ah! Du bist also nur eine sprechende Steinstatue ... und gar kein Monster, wie Paimon dachte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150407,
					"content": "Pah! Was heißt hier „nur eine sprechende Statue?“!? Reicht das etwa nicht, um dich das Fürchten zu lehren!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150408
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150408,
					"content": "Öhm, ollen Statuen wie dir, sind wir schon oft über den Weg gelaufen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150409,
					"content": "Wa... Was! *seufz* Na dann. Es scheint, ich kann euch nicht erschrecken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150410
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150410,
					"content": "Warum willst du denn unbedingt die Leute erschrecken? Also wirklich. Du, eine total normale Steinstatue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150411,
					"content": "Hmpf! Wiewohl ich „nur eine Statue“ sein mag, so ist dieser Ort die Wohnstätte der großen Dame der Medizin. Und als dieselbe noch unter uns weilte, missfiel es ihr zutiefst, wenn jemand ihren häuslichen Frieden störte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150412
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150412,
					"content": "Und genau deswegen werde ich alle ekligen Störenfriede fortjagen! Völlig unerheblich, dass die große Dame der Medizin nicht mehr zugegen ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150413
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150413,
					"content": "Obschon sich eure Präsenz im Vergleich zu anderen Sterblichen ganz verschieden ausnimmt ... Und erschrecken lassen wollt ihr euch auch nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150414
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150414,
					"content": "Könntet ihr mir wohl einen Gefallen tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150415
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150415,
					"content": "Hmm? Wobei können wir dir denn helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150416,
					"content": "Hehe, seht mal, diese bunten Schmetterlinge! Seitdem die Herrin dieser Wohnstätte weggegangen ist, sind diese kleinen Freunde aufgetaucht und flattern überall herum ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150417
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150417,
					"content": "Psst ... Warte mal, auf deinem Kopf sitzt einer! Einen Moment. Lass Paimon ihn schnappen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
