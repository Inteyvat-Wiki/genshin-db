			"dialogs": [
				{
					"id": 711151101,
					"content": "He! Du Klugschwätzer! Wir haben schon alle bunten Schmetterlinge in diese Medizingefäße zurückgebracht und der Adeptenbaum schaut immer noch genau so aus wie vorher!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151102,
					"content": "Hmm ...? Wer wagt es, meinen Schlaf zu ... Ah, ihr Menschen seid es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151103
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711151103,
					"content": "Oho! Ich hatte nicht erwartet, dass ihr wirklich alle bunten Schmetterlinge finden würdet! Ich habe das nur zum Spaß gesagt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151104
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711151104,
					"content": "Nein, nein! Ich meine ... ich fühlte ebenfalls die Wallung der Adeptenkraft! Als Nächstes müssen wir nur den Spruch aufsagen, den die große Dame der Medizin hinterließ. Dann wird der Adeptenbaum zu neuem Leben erwachen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151105
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711151105,
					"content": "Wartet! Wie war noch gleich dieser Spruch ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151106
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711151106,
					"content": "„Das Holz, geboren im Winter, verwelkt über die Jahre seine Pracht. Der Frühling, der mir so gefällt, bringt wieder Duft und Harmonie in die Welt ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151107
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711151107,
					"content": "... Bunte Schmetterlinge ... sanft und ... den Rest hab ich vergessen. Es endet mit dem Wiederentstehen aller Dinge!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				}
			]
		},
