			},
			"dialogs": [
				{
					"id": 711150601,
					"content": "Puh ... Stimmt, genau der!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150602
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150602,
					"content": "Yaojun aus dieser Wohnstätte schmückte ehemals mit diesen Schmetterlingen den Eingang. Später wurde die Vorrichtung der Wohnstätte beschädigt. Diese bunten Schmetterlinge und die Medizingefäße dienten einst dazu, den Adeptenbaum zu nähren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150603
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150603,
					"content": "Adeptenbaum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150604,
					"content": "Hmm, genau! Der Adeptenbaum wurde damals von Yaojun eigenhändig gepflanzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150605
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150605,
					"content": "Er mag jetzt vertrocknet wirken, doch Yaojun ließ wissen, dass der Baum zu neuem Leben erwachen kann, solange die bunten Schmetterlinge nicht gänzlich verschwunden sind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150606
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150606,
					"content": "*seufz* Nachdem sie ihre menschliche Gestalt nicht mehr beibehalten konnte, war sie rasch fortgegangen. Wie es ihr jetzt wohl gehen mag?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150607
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150607,
					"content": "Also ... Was soll ich tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150608
					]
				},
				{
					"id": 711150608,
					"content": "Ah, verzeiht. Ich habe mich ein wenig von den Erinnerungen an meine Herrin überwältigen lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150609
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150609,
					"content": "Hehe, hört zu, Menschen! Wenn die bunten Schmetterlinge in diese Medizingefäße befördert werden, dann kann der verwelkte Baum wieder Nahrung erhalten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150610
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150610,
					"content": "Hmm, dies ist die Adepten-Vorrichtung, die von der großen Dame der Medizin konstruiert wurde. Ziemlich wundervoll, nicht!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150611,
						711150613
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150611,
					"content": "Ich werde mal sehen, was ich tun kann.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150612
					]
				},
				{
					"id": 711150612,
					"content": "Gut ... Dann hoffe ich auf euch, liebe Menschen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150613,
					"content": "Warum sind es bunte Schmetterlinge?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150614
					]
				},
				{
					"id": 711150614,
					"content": "Hmm? Ah richtig, warum ...? Vermutlich war die große Dame der Medizin diesen bunten Schmetterlingen sehr zugetan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150615
					],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				},
				{
					"id": 711150615,
					"content": "Ähm ... Jedenfalls, zähle ich darauf, dass ihr die Schmetterlinge in diese Medizingefäße bringen könnt, ihr guten Menschen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Gemächliche Adeptenstatue“"
				}
			]
		},
