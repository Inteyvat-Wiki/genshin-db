			"dialogs": [
				{
					"id": 733430201,
					"content": "Oha! Sorush, du bist einfach großartig. Du hast die Umgebung hier in einem Aufwasch wieder mit Lebenskraft gefüllt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733430202,
					"content": "Die Pari verfügen über wirklich erstaunliche Kräfte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733430203
					]
				},
				{
					"id": 733430203,
					"content": "Natürlich! Viele Pari wissen um den Weg, die „Sunyata-Blume“ wieder zu neuem Leben zu erwecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430204
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430204,
					"content": "Doch obwohl das „Zeichen von Apaosha“ ausgelöscht wurde, konnten die von Korrosion befallenen „Sunyata-Blumen“ nicht wiederhergestellt werden. Sie sind sehr geschwächt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430205
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430205,
					"content": "Ich glaube auch nicht, dass die anderen Blumenteiche verschont geblieben sind. Dies muss für Sefana sehr beunruhigend sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430206
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430206,
					"content": "Diese Sefana, von der du da sprichst, muss eine nette Pari sein, die sich emsig um die Blumen kümmert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733430207,
					"content": "#Wir sollten dieser Pari helfen, meinst du nicht auch, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733430208,
					"content": "Für mich ist das kein Problem, und es hilft Sefana. Mein „Yasnapati“, bitte achte gut auf die „Sunyata-Blumen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430209
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430209,
					"content": "Wenn ich das nächste Mal welche sehe, werde ich dir gleich Bescheid geben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733430210
					]
				},
				{
					"id": 733430210,
					"content": "Ja, lasst uns zusammen diese hübschen Blumen retten!",
