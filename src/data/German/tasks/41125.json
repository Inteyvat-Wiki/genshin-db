			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verwegener Pallad"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411250201,
					"content": "Anscheinend habe ich sie abgeschüttelt. Aber was zur Hölle geht hier vor ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250202
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 411250202,
					"content": "Bist du hier, um die gefallenen Sterne zu untersuchen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250203
					]
				},
				{
					"id": 411250203,
					"content": "Richtig. Ich nahm einen Auftrag von der Gilde an, um die gefallenen Sterne zu untersuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250204
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 411250204,
					"content": "Doch die Monster in der Nähe der gefallenen Sterne verhalten sich plötzlich auffällig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250205
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 411250205,
					"content": "Ihre Stärke, Bewegungen und alles mögliche sind komplett ungewöhnlich. Ihre Anzahl hat ebenfalls zugenommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250206
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 411250206,
					"content": "Da sie mich entdeckt haben, habe ich einige weniger bekannte Pfade genommen, um sie abzuschütteln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250207
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 411250207,
					"content": "Ich muss diese Abnormalitäten so rasch wie möglich Cyrus melden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250208
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 411250208,
					"content": "Ist dir sonst noch etwas aufgefallen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250209
					]
				},
				{
					"id": 411250209,
					"content": "Sonst noch etwas? Nun ja, recht viele Gelehrte weigern sich, in die Stadt zurückzukehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250210
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 411250210,
					"content": "Wie sehr ich sie auch überzeugen will, sie beharren darauf, ihre mit ihrer Forschung fortzufahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250211
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 411250211,
					"content": "Es gibt da draußen nicht genug Abenteurer, um sie alle paar Tage daran zu erinnern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250212
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 411250212,
					"content": "Es ist wirklich zu dumm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250213
					],
					"speakerTitle": "Verwegener Pallad"
				},
				{
					"id": 411250213,
					"content": "#Nun, {F#Reisende}{M#Reisender}, wenn es sonst nichts gibt, solltest du ebenfalls in der Stadt Schutz suchen. Uns bleibt keine Zeit, hier draußen herumzutrödeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verwegener Pallad"
				}
			]
		},
