					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411250101,
					"content": "*seufz* Wenn ich nur nachsehen könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250102
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250103
					]
				},
				{
					"id": 411250103,
					"content": "Ah, du bist es. Nun, es ist nicht wirklich etwas Besonderes ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250104
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250104,
					"content": "Hmm. Nein, es ist etwas wirklich Besonderes ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250105,
						411250108
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250105,
					"content": "Du meinst die gefallenen Sterne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250106
					]
				},
				{
					"id": 411250106,
					"content": "Ja! Bestimmt hast du sie gesehen, oder? Sie stürzen schon seit einer Weile vom Himmel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250107
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250107,
					"content": "Dem Gott Anemo sei Dank hat bislang keiner die Stadt getroffen. Vielleicht ist es auch nur blindes Glück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250113,
					"content": "Ein paar davon schlugen außerhalb der Stadt ein. Es heißt, wer sie berührt, der sinkt in einen tiefen Schlaf, aus dem er nicht mehr erwacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250114
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250114,
					"content": "Cyrus hat bereits viele Abenteurer damit beauftragt, die Meteoriten zu untersuchen. Andere wurden ausgeschickt, um die Leute in der Wildnis zu rufen, damit sie Schutz in der Stadt suchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250115
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250115,
					"content": "Die anderen sollen dem Ordo Favonius dabei helfen, die Einschlagsorte der gefallenen Sterne zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250116
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250116,
					"content": "Sie führen bei diesen gefallene Sternen eine Rettungsaktion durch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250117
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250117,
					"content": "Cyrus meinte, ich soll in der Stadt bleiben und denen helfen, die in tiefen Schlaf gesunken sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250118
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250118,
					"content": "Mag sein, dass meine Fähigkeiten noch nicht ausgereift sind ... Aber wenn ich immer nur diese Kleinigkeiten erledige, werde ich nie stärker werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250119
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250119,
					"content": "#*seufz* Wie dem auch sei, meine Pflichten muss ich gut erfüllen ... Kann ich dich trotzdem um einen Gefallen bitte, {F#Reisende}{M#Reisender}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250120
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250120,
					"content": "Ich möchte gerne einige Informationen über diese gefallenen Sterne beschaffen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250121,
						411250126
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250121,
					"content": "Was für Informationen benötigst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250122
					]
				},
				{
					"id": 411250122,
					"content": "Cyrus sagt immer, auf ein Abenteuer sollte man gut vorbereitet sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250123
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250123,
					"content": "Wenn ich ihn davon überzeugen könnte, dass ich die Lage voll erfasst und alle nötigen Vorbereitungen getroffen habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250124
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250124,
					"content": "Vielleicht teilt er mich dann einer der Untersuchungsgruppen zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250125
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250125,
					"content": "Doch momentan habe ich alle Hände voll zu tun, darum kann ich nicht selbst losziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250133,
					"content": "#Bitte, {F#Reisende}{M#Reisender}! Würdest du die Lage da draußen für mich untersuchen. Du musst nicht weit gehen, nur bis zum Flüsterwald. Das reicht schon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250134
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250134,
					"content": "Komm zu mir zurück, falls du etwas entdeckst. Ob ich nach draußen kann oder nicht ... hängt jetzt ganz von dir ab!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250126,
					"content": "Du willst dich also hinausschleichen und ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250127
					]
				},
				{
					"id": 411250127,
					"content": "Was? Hinausschleichen und ... Nein! Ganz und gar nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250128
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250128,
					"content": "Ich möchte gerne nach draußen, um die Lage zu untersuchen ... Aber es wichtig, in der Stadt Hilfe zu leisten! Ich kann meine Pflichten nicht einfach so vernachlässigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250129
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250129,
					"content": "Aber ... Na ja, Cyrus sagt immer, auf ein Abenteuer sollte man gut vorbereitet sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250130
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250130,
					"content": "Wenn ich ihn davon überzeugen könnte, dass ich die Lage voll erfasst und alle nötigen Vorbereitungen getroffen habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250131
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250131,
					"content": "Vielleicht teilt er mich dann einer der Untersuchungsgruppen zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250132
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250132,
					"content": "Doch momentan habe ich alle Hände voll zu tun, darum kann ich nicht selbst losziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250108,
					"content": "Du meinst die Jubiläumsaktion zum halben Preis beim Hirschjäger?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250109
					]
				},
				{
					"id": 411250109,
					"content": "Was?! Beim Hirschjäger gibt es eine Jubiläumsaktion? Wie konnte ich das verpassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250110
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250110,
					"content": "Äh, nein, warte! Das habe ich nicht gemeint ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250111
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250111,
					"content": "In letzter Zeit stürzen Sterne vom Himmel. Sicher hast du es mitbekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250112
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250112,
					"content": "Dem Gott des Windes sei Dank hat bislang keiner die Stadt getroffen. Vielleicht ist es auch nur blindes Glück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "Jack"
				}
			]
		},
