					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240301,
					"content": "Also, hast du die Laterne abgeliefert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240302
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240302,
					"content": "Ich denke ... wir können sie als geliefert betrachten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240303
					]
				},
				{
					"id": 718240303,
					"content": "Ich denke auch. Das sollte sie zumindest ein kleines bisschen aufheitern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240304,
					"content": "Ich frage mich, was für einen Wunsch das Kind wohl formulieren würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
