			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240201,
					"content": "#{F#Reisende}{M#Reisender}! Wie kann ich helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240202
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240202,
					"content": "Was die kleine Ming angeht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240203
					]
				},
				{
					"id": 718240203,
					"content": "Oh, sie? Seit dem Vorfall benimmt sie sich ziemlich gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240204
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240204,
					"content": "Aber das Kind tut mir leid. Immer, wenn in der Vergangenheit eine festliche Zeit vor der Tür stand, fühlte sie sich einsamer, je voller die Gaststätte wurde. Das führte dazu, dass sie Schwierigkeiten machte und die Gäste verängstigte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240205
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240205,
					"content": "Aber ich bin mir sicher, dass sie sich nur jemanden wünscht, der mit ihr spielt. Schließlich ist sie ja nur ein Kind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240206,
						718240207
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240206,
					"content": "Können wir ihr eine Laterne schicken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				},
				{
					"id": 718240208,
					"content": "Du möchtest ihr eine Laterne schicken? Das ist keine schlechte Idee. Das einzige Problem ist, dass sie recht schwierig zu finden ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240209
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240209,
					"content": "Wenn du nach ihr suchst, solltest du eine Laterne in der Nacht hoch oben auf einem der Bäume im nahegelegenen Wald aufhängen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240210
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240210,
					"content": "Auf diese Weise sollte sie sie sehen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240207,
					"content": "Ich frage mich, ob ihr eine Laterne gefallen würde ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				}
			]
		},
		{
			"id": 7182403,
			"completionStepIds": [
				7182413
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
