			"dialogs": [
				{
					"id": 718240601,
					"content": "Hier müsste es sein. Ich frage mich, wo sie ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718240602,
					"content": "Oh, du bist zurück. Du bist hier, um mit mir zu spielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240603
					],
					"speakerTitle": "Kleine Ming"
				},
				{
					"id": 718240603,
					"content": "Hehe, weißt du noch, was ich letztes Mal gesagt habe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240604
					],
					"speakerTitle": "Kleine Ming"
				},
				{
					"id": 718240604,
					"content": "Also dann, spielen wir ... Verstecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleine Ming"
				}
