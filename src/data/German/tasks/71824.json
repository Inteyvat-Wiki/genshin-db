			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lächelnder Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240101,
					"content": "Ich muss mich beeilen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240102
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 718240102,
					"content": "Läuft das Geschäft so gut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240103
					]
				},
				{
					"id": 718240103,
					"content": "Nein. Aber momentan findet das Laternenritual statt. Viele Leute sind in die Stadt zurückgekehrt, um die festliche Zeit dort zu verbringen, also haben wir Personalmangel. Ich erledige praktisch alles selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240104
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 718240104,
					"content": "Wir haben allerdings nicht allzu viele Gäste, so schlimm ist es also nicht. Ich kann es noch schaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240105
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 718240105,
					"content": "*keuch* Außerdem sollte ich dir für deine vorherige Hilfe danken. Ich glaube nicht, dass ich jemals wieder zu meiner Arbeit hätte zurückkehren können, wenn du nicht gewesen wärst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240106,
						718240107
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 718240106,
					"content": "Ah. Also neulich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				},
				{
					"id": 718240108,
					"content": "Nein! Definitiv nicht, glaub mir! Wenn sie hier wieder auftauchen würde, weiß ich nicht, ob mein Herz das schafft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240109
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 718240109,
					"content": "Wenn du wirklich Fragen über ... sie ... hast, solltest du einfach den Boss fragen. Ich weiß nichts, ich schwöre ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 718240107,
					"content": "Also, hat sie ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				}
			]
		},
		{
			"id": 7182402,
			"completionStepIds": [
				7182402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
