			"dialogs": [
				{
					"id": 220390401,
					"content": "Ah, das hast du also mitgebracht. Ja, ja, ich denke, dass diese Farben in der Tat eine ziemliche Neuheit sein werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390402
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390402,
					"content": "#Vielen Dank, dass du mir diese besorgt hast, {F#Reisende}{M#Reisender}. Ich werde sie gleich mal ausprobieren. Bitte nimm das als Entschädigung für deine Bemühungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390403
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390403,
					"content": "Ich frage mich, welche Farben wir bekommen werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				}
			]
