			"trigger": {
				"objectNames": [
					"Ogura Mio"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220390101,
					"content": "Das ist kein Weg, um lange Geschäfte zu machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390102
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390103
					]
				},
				{
					"id": 220390103,
					"content": "Ah, es tut mir leid. Ich war nur ein wenig in meinen eigenen Gedanken verloren. Willst du ein paar Klamotten kaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390104
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390104,
					"content": "Die hochwertigen Seiden aus Liyue sind weiterhin nicht auf Lager, aber wir haben noch die neuesten Kimonos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390105
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390105,
					"content": "Du hast früher Material von Liyue importiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390106
					]
				},
				{
					"id": 220390106,
					"content": "Ja. Früher konnten wir uns oft hochwertige Seide aus Liyue sichern, wie die, die die Händlergilde Feiyun aus Seidenblumen herstellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390107
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390107,
					"content": "Aber mit der aktuellen Situation hier, können wir schon seit einer Weile keine Seide mehr importieren. Wir müssen uns auf unseren Bestand verlassen, um den Betrieb aufrechtzuerhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390108
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390108,
					"content": "Jede Fuhre Seide, die wir hier verwenden, ist eine, die wir nicht zurückbekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390109
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390109,
					"content": "Ursprünglich hatte ich vor, selbst ein paar neue Kimono-Muster zu entwerfen oder einige neue Färbemittel zu verwenden, um neue Stoffe herzustellen und Kunden anzulocken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390110
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390110,
					"content": "Aber mir ist nichts eingefallen, was man als „neue“ Färbung bezeichnen könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390111
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390111,
					"content": "#In Anbetracht deiner vielen Reisen, {F#Reisende}{M#Reisender}, bin ich mir sicher, dass du schon eine Menge gesehen hast. Hast du irgendwelche Färbearbeiten gesehen, die du als „neuartig“ bezeichnen würdest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390112,
						220390116
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390112,
					"content": "Oh, ich habe schon einige gesehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390113
					]
				},
				{
					"id": 220390113,
					"content": "Ach, wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390114
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390114,
					"content": "Wenn du könntest, hilf mir bitte, meinen Horizont zu erweitern. Finde ein paar Basismaterialien, aus denen ich neue Arten von Farben herstellen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390115
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390115,
					"content": "Ich werde mich um die Bezahlung kümmern. Nochmals vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390116,
					"content": "Brauchst du nur Farbe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390117
					]
				},
				{
					"id": 220390117,
					"content": "Unter diesen Umständen ist das wohl das einzige, was ich im Moment tun kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390118
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390118,
					"content": "Wenn du ein solches Basismaterial kennst, aus dem „neue“ Farben hergestellt werden können, bringe es bitte zu mir. Ich werde für die nötige Bezahlung sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				}
			]
		},
