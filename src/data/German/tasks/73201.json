			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010101,
					"content": "Das ist die Nachrichtentafel des Puspa-Kaffeehauses. Aus verschiedenen Gründen bin ich zurzeit die stellvertretende Geschäftsführerin. Bei Fragen oder Anregungen kannst du hier gerne eine Nachricht hinterlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7320102,
			"completionStepIds": [
				7320102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320102",
							"2"
						],
						"stepId": 7320102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010201,
					"content": "„Die Legende von Antara geht diese Woche weiter!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010202
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732010202,
					"content": "„Erzählt von Maddah, dem Geschichtenerzähler des Puspa-Kaffeehauses! Bleib dran!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010203
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732010203,
					"content": "Herr Maddah ... Wir bieten dir eine weitere kostenlose Tasse Kaffee an, wenn du hier keine Werbung mehr für dich machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7320103,
			"completionStepIds": [
				7320103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320103",
							"2"
						],
						"stepId": 7320103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010301,
					"content": "„Hehe, Gata, hehe.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010302
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732010302,
					"content": "Gata scheint dich auch sehr zu mögen, Fräulein Nilou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7320104,
			"completionStepIds": [
				7320104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320104",
							"2"
						],
						"stepId": 7320104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010401,
					"content": "„Der Puspa-Kartenklub rekrutiert fortlaufend Mitglieder für „Geniale Beschwörung“!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010402
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732010402,
					"content": "„Wenn du gerne Spielaufbau und -techniken besprechen möchtest, komm zu mir an den Tisch!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010403
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732010403,
					"content": "Herr Nayab, wenn du Karten in unserem Laden spielen möchtest, solltest du zumindest einen Kaffee bestellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7320105,
			"completionStepIds": [
				7320105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320105",
							"2"
						],
						"stepId": 7320105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010501,
					"content": "„In letzter Zeit gab es eine Serie von Schmuggeleien mit Wissenskonserven.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010502
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732010502,
					"content": "„Sonderhinweis der Matra: Bitte nutzt die herkömmlichen Kanäle zum Wissenserwerb.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010503
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732010503,
					"content": "„Die widerrechtliche Erlangung von verbotenen Wissenschaften führt zum Entzug der Studienberechtigung an der Akademie. Bitte bleibt wachsam.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7320106,
			"completionStepIds": [
				7320106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320106",
							"2"
						],
						"stepId": 7320106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010601,
					"content": "„Die Atmosphäre hier ist viel netter als in der Taverne für einen Studenten, wenn man sich auf eine Prüfung vorbereitet.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010602
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732010602,
					"content": "„Es gibt Kaffee, der mich wach hält, und Studenten, die ich um Rat bitten kann.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010603
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732010603,
					"content": "„Selbst die Geschäftsführerin hat mir prohezeit, dass ich es dieses Jahr in die Akademie schaffe!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010604
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732010604,
					"content": "Mögen deine Wünsche wahr werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7320107,
			"completionStepIds": [
				7320107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320107",
							"2"
						],
						"stepId": 7320107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010701,
					"content": "„Aufpassen, Leute! Mein Freund ist mitten in der Nacht im Nordwestwald dem Raja begegnet! Zum Glück hat es heile zurückgeschafft, aber geht nachts ja nicht außer Haus!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7320108,
			"completionStepIds": [
				7320108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320108",
							"2"
						],
						"stepId": 7320108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010801,
					"content": "„Die neuesten Studienergebnisse der Gelehrtin Pursina zeigen, dass der Verzehr von Kaffee die kognitiven Fähigkeiten des Gehirns verbessert.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010802
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732010802,
					"content": "„Wenn du in der Akademie aufgenommen werden möchtest, solltest du öfter in diesem Kaffeehaus vorbeischauen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010803
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732010803,
					"content": "Ich bin dir sehr dankbar, dass du Werbung für unseren Laden schaltest, aber Kaffee verleiht nur ein bisschen mehr Energie für den Tag ... Außerdem könnte der Mahamata gegen unbegründete Aussagen wie diese vorgehen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7320109,
			"completionStepIds": [
				7320109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320109",
							"2"
						],
						"stepId": 7320109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010901,
					"content": "„Bitte denkt an meine Lektion, wenn ihr Karten in diesem Kaffeehaus spielt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010902
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732010902,
					"content": "„Ich hätte keine Karte bei ‚Geniale Beschwörung‘ erfinden dürfen, um meine Mitspieler zu hereinzulegen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010903
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732010903,
					"content": "„Herr Schakal hat mich eines Besseren belehrt. Ich habe meinen Fehler erkannt und möchte ihn hiermit eingestehen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010904
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732010904,
					"content": "„Die meisten Menschen können ihre Fehler nicht eingestehen. Aber ... wer ist dieser Herr Schakal?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7320110,
			"completionStepIds": [
				7320110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320110",
							"2"
						],
						"stepId": 7320110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011001,
					"content": "„Ich habe gehört, dass sich viele Banditen in der Wüste herumtreiben und viele Händler sich weigern dorthin zu gehen. Der Preis für Datteln könnte in die Höhe schnellen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011002
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732011002,
					"content": "„Großartig! Ich verkaufe meine Pilze und kaufe Datteln! Haha! Vielleicht ist das der Unternehmungsgeist der Familie Alkindi!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011003
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732011003,
					"content": "Zwar sehe ich gern, wie sich dein Vermögen vervielfacht, aber ich möchte darauf hinweisen, dass unser Geschäft für keinerlei Verluste verantwortlich ist, die aus den Informationen dieser Tafel entstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7320111,
			"completionStepIds": [
				7320111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320111",
							"2"
						],
						"stepId": 7320111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011101,
					"content": "„Seit ich mich aus dem ‚Regiment der Dreißig‘ zurückgezogen habe, trinke ich hier jeden Tag meinen Kaffee.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011102
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732011102,
					"content": "„Die stellvertretende Geschäftsführerin macht mir jeden Tag den gleichen Kaffee und der Geschichtenerzähler erzählt mir jeden Tag die gleiche Geschichte.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011103
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732011103,
					"content": "„Vielleicht ist eine solche Wiederholung die Essenz des Lebens in Sumeru.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7320112,
			"completionStepIds": [
				7320112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320112",
							"2"
						],
						"stepId": 7320112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011201,
					"content": "„Die Geschichten von Herrn Maddah klingen zwar etwas altmodisch, aber sein Rhythmus bleibt ungeschlagen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011202
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732011202,
					"content": "„Leider hat sich jeder inzwischen daran gewöhnt, seine Informationen aus Akasha zu besorgen, also wird eine solche ‚Raffinesse‘ in der Technik und künstlerische ‚Reife‘ häufig übersehen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011203
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732011203,
					"content": "„Dem stimme ich nicht zu. Keine Kunstform währt ewig. Der Tag, an dem ihr gesamter Wert ausgeschöpft ist, ist der Tag, an dem sie ausstirbt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011204
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732011204,
					"content": "„So wie überreife Früchte auf den Boden fallen und neue Pflanzen nähren.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011205
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732011205,
					"content": "„Deshalb kann ich Utilitaristen wie dich nicht ausstehen. Die Kunst ist eine Frucht der kostbaren Freizeit, sie kann nicht mit der Produktion und der Verwertung für den kommerziellen Bedarf verglichen werden!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011206
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732011206,
					"content": "„Menschen, die nur in der freien Zeit leben, sind wie Menschen, die auf einer kugelförmigen Erde leben, so etwas gibt es nicht. Warum benutzt du nicht deinen Verstand und denkst einen Moment nach? Kann es eine Produktionstätigkeit ohne kommerziellen Austausch geben?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011207
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732011207,
					"content": "„Was für faszinierende Theorien, die da aufeinander prallen ... Aber jetzt sollten wir zuerst Herrn Kavehs Rechnung für diesen Monat begleichen. Soll sie wie üblich auf Herrn Alhaithams Rechnung gesetzt werden?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011208
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732011208,
					"content": "„Nein, dieser verwöhnte Kerl soll den Schrecken einer kommerziellen Welt ausgesetzt werden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011209
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732011209,
					"content": "„Fräulein, bitte setze sie auf Herrn Sangemah Bays Rechnung. Schließlich geht Kunst nicht ohne Kaffee!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		},
		{
			"id": 7320113,
			"completionStepIds": [
				7320113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320113",
							"2"
						],
						"stepId": 7320113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011301,
					"content": "„Nach so vielen Jahren geht es hier immer noch so lebhaft zu! Jedes Mal, wenn ich in dieses Kaffeehaus komme, werde ich an jenen Nachmittag zurückversetzt, an dem ich mich mit ihm über die Interpretation eines einzigen Buchstabens gestritten habe.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011302
					],
					"speakerTitle": "Pinnwand"
				},
				{
					"id": 732011302,
					"content": "Das Kaffeehaus wäre nicht so lebhaft ohne dich. Bitte komme öfter vorbei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pinnwand"
				}
			]
		}
	]
}