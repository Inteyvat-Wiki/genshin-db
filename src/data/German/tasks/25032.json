	"talks": [
		{
			"id": 2503201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2503201",
							"2"
						],
						"stepId": 2503201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320101,
					"content": "Hmm ... Ein Bild inspiriert von einem Gedicht ... nein, nein, es sollte ein Gedicht inspiriert von einem Bild heißen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320102
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320102,
					"content": "Äh ... das klingt irgendwie auch nicht richtig. Beide Aussagen bedeuten wohl das Gleiche ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320103,
						250320104
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320103,
					"content": "Wovon sprichst du überhaupt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				},
				{
					"id": 250320105,
					"content": "Hallo! Genau, ich versuche ein Gedicht über die Landschaft von Natlan zu schreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320106
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320106,
					"content": "Aber ... um ehrlich zu sein, die Landschaft hier unterscheidet sich stark von der in Liyue, und ich kenne die historischen Begebenheiten von Natlan überhaupt nicht. Ich weiß gar nicht, wie ich zu schreiben anfangen soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320107
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320107,
					"content": "Und ich bin auch kein professioneller Poet, ich kann nicht einmal richtig reimen, geschweige denn ein humorvolles Gedicht schreiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320108
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320108,
					"content": "*seufz* Aber ich kann nicht einfach mit leeren Händen zurückkehren. Die Kollegen vom Rat für Allgemeine Angelegenheiten werden mich sonst auslachen und sagen: „Mehr als frische Luft hat er auf seinem Inspirationsausflug wohl nicht aufgeschnappt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320109
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320109,
					"content": "Du arbeitest im Rat für Allgemeine Angelegenheiten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320110
					]
				},
				{
					"id": 250320110,
					"content": "Gewissermaßen. Ich wurde vor Kurzem vom Rat engagiert, um Land zu vermessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320111
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320111,
					"content": "*seufz* Eigentlich heißt das nur, dass ich mit ein paar Leuten in Liyue rumgelaufen bin, um zu schauen, ob sich an den Böden und Gewässern etwas geändert hat und ob wir die Karten anpassen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320112
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320112,
					"content": "Nach so einer Tour war ich total erschöpft, keine Ahnung, wie viele Paar Schuhe ich abgenutzt habe ... Also habe ich mir Urlaub genommen, um den Kopf freizubekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320113
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320113,
					"content": "Ich weiß auch nicht mehr, was ich mir dabei gedacht habe, aber ich schrieb in den Urlaubsantrag: „Die Leidenschaft für Poesie erwacht in mir. Ich möchte auf Inspirationsausflug gehen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320114
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320114,
					"content": "Und dann hat der Verantwortliche im Rat das ernst genommen und mir geantwortet: „Viel Glück mit der Poesie!“ ... und mir tatsächlich zwei Wochen Urlaub genehmigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320115,
						250320117
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320115,
					"content": "Das ist doch großartig!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320116
					]
				},
				{
					"id": 250320116,
					"content": "Großartig? Der ganze Rat für Allgemeine Angelegenheiten weiß jetzt von meinem Urlaubsantrag!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320119,
					"content": "*seufz* Natlan ist wirklich spannend. Die Landschaft ist schön, das Essen ist vorzüglich und erst die vielen interessanten Tiere, besonders die Saurierbabys, sind echt niedlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320120
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320120,
					"content": "Nur habe ich bisher leider keinen einzigen Vers gedichtet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320121
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320121,
					"content": "Ich habe mir extra eine Kamera geliehen, um Material zu sammeln, und ich kann das Ding nicht mal richtig bedienen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320122
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320122,
					"content": "Natur- und Landschaftsaufnahmen gehen ja noch, aber sobald ich Läden oder Menschen fotografiere, sind die Bilder einfach unästhetisch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320123,
						250320124
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320123,
					"content": "Kann ich dir vielleicht helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320125,
					"content": "Du würdest mir helfen!? Dem Himmel sei Dank! ... Komme was wolle, ich brauche inspirierenden Stoff für ein Gedicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320126
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320126,
					"content": "Ich überlege mal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320124,
					"content": "Ich kann ziemlich gut fotografieren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320117,
					"content": "Und hast du es geschafft, ein Gedicht zu schreiben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320118
					]
				},
				{
					"id": 250320118,
					"content": "Ganz und gar nicht. Nur mein Urlaubsantrag war ein großer Erfolg. Der ganze Rat für Allgemeine Angelegenheiten weiß jetzt, dass ich in Natlan bin, um Gedichte zu schreiben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320104,
					"content": "Schreibst du Gedichte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				}
			]
		},
		{
			"id": 2503206,
