						250323002
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250323002,
					"content": "Ich habe auch ein paar zusätzliche Fotos gemacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250323003
					]
				},
				{
					"id": 250323003,
					"content": "Oha, du machst viel bessere Fotos als mein Assistent. Der braucht immer mehrere Versuche, um an den Vermessungsorten brauchbare Bilder zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250323004
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250323004,
					"content": "Wenn du mit mir Land vermessen würdest, würden wir bestimmt weniger Fotoapparate verschleißen.",
