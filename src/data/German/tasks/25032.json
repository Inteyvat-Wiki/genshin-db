			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320601,
					"content": "Da bist du ja wieder. Hast du die Fotos gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320602
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320602,
					"content": "Ich habe das Foto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320603
					]
				},
				{
					"id": 250320603,
					"content": "Oha, du machst viel bessere Fotos als mein Assistent. Der braucht immer mehrere Versuche, um an den Vermessungsorten brauchbare Bilder zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320604
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320604,
					"content": "Wenn du mit mir Land vermessen würdest, würden wir bestimmt weniger Fotoapparate verschleißen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320605
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320605,
					"content": "Kann man mit diesen Fotos wirklich Gedichte schreiben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320606
					]
				},
				{
					"id": 250320606,
					"content": "Ich ... denke schon. Nun, wenn ich wirklich nichts zustande bringe, mache ich eben Postkarten daraus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320607
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320607,
					"content": "Ich schreibe ein paar Sprüche wie „Schade, dass ihr nicht hier seid“ auf die Rückseite und lasse sie an den Rat schicken, dann kann keiner mehr etwas sagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320608
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320608,
					"content": "*hust* Aber das mache ich nur, wenn mir nichts mehr einfällt. Doch zuvor möchte ich überlegen, wie man ein gutes Gedicht schreibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320609
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320609,
					"content": "Ein Aufwallen ... Nein, Aufbrausen im Gezeitenwechsel der fünf Stämme ... Mist, wie viele Stämme gibt es noch mal in Natlan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				}
			]
		},
		{
			"id": 2503210,
			"completionStepIds": [
				2503201
			],
			"beginWay": "TALK_BEGIN_NONE",
