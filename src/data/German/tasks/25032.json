						],
						"stepId": 2503201,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"25032"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250321001,
					"content": "Ach, ja! Ich habe gehört, dass die Menschen der Quellen ganz besondere Ladenschilder haben. Ich habe von einem Instrumentenladen namens „Studio Djembe“ gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250321002
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250321002,
					"content": "Bitte hilf mir, ein Foto vom Studio Djembe in den frühen Morgenstunden zu machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				}
			]
		},
