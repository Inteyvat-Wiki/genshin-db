			},
			"dialogs": [
				{
					"id": 412109901,
					"content": "Albedos Geheimnis ist bestimmt etwas wirklich Außergewöhnliches. Aber wenn das so ist, warum die ganze Geheimniskrämerei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Saccharose"
				}
			]
		},
		{
			"id": 4121002,
			"completionStepIds": [
				4121002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121002",
							"2"
						],
						"stepId": 4121002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Saccharose"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100201,
					"content": "He, das ist doch Saccharose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100202,
					"content": "Bist du auch hier, um den Schneeberg zu erkunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100203,
					"content": "Aaah! I... Ihr habt mich erschreckt! Erschreckt mich doch bitte nicht so! Ich habe gerade über meinen Forschungsbericht gebrütet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100204
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412100204,
					"content": "Aber du stehst einfach nur hier und guckst Löcher in die Luft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100205,
					"content": "Ü... Überhaupt nicht! Ich habe nur angestrengt nachgedacht, wie ich die Unterart der Zuckerblume nennen könnte, die ich gezüchtet habe. Sie hat Samen, die viermal so groß sind wie die der normalen Zuckerblume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100206,
						412100207
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412100206,
					"content": "Viermal? Klingt lecker.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100208
					]
				},
				{
					"id": 412100208,
					"content": "Oh, interessiert dich das? Wunderbar! Nächstes Mal erlaube mir, dir die Früchte meiner Arbeit zu präsentieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100209
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412100209,
					"content": "Wie schade. Ich hätte ein paar Proben mitgebracht, wenn nicht ausgerechnet dieser Berg hier mein Ziel gewesen wäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100210
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412100210,
					"content": "Ja, hast du nicht in der Stadt nachgeforscht? Wie kommt es, dass du hier bist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100211,
					"content": "Timaeus und ich haben Albedo beim Organisieren der Forschungsdaten geholfen. Timaeus ist gerade aufgebrochen. Seid ihr ihm nicht begegnet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100212
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412100212,
					"content": "Nein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100213,
					"content": "Er meinte, er wäre in Sachen Daten nicht so gewitzt wie Albedo. Und zwar bei Weitem nicht, um ehrlich zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100214
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412100214,
					"content": "Es gibt da so einige Sachen, bei denen Albedo auf den ersten Blick erkennt, wie wichtig sie sind. Und wir brauchen ewig lange dafür. Ich fürchte, das beweist wohl, dass unser Wissen und unsere Erfahrung seinem Können nicht das Wasser reichen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100215
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412100215,
					"content": "Timaeus war aber ziemlich niedergeschlagen. Er meinte, er würde sich die Beine vertreten, deshalb kümmere ich mich gerade selbst um die unerledigten Dinge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100216
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412100216,
					"content": "(Fühlt sich irgendwie an, als hätte er sie einfach nur im Stich gelassen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100217
					]
				},
				{
					"id": 412100217,
					"content": "Ursprünglich wollte ich mich selbst umsehen, nachdem ich mich um das alles gekümmert habe, aber überraschenderweise habe ich ein paar interessante Daten aus diesen Berichten sammeln können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100218
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412100218,
					"content": "Aber, na ja ... *seufz* Vermutlich wird meine Suche nach Geheimnissen ein bisschen warten müssen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100219
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412100219,
					"content": "Geheimnisse? Oooh, was für Geheimnisse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100220,
					"content": "Hm? Oh. Sagt ... habt ihr zwei gerade ein bisschen Zeit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100221
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412100221,
					"content": "Zufällig haben wir gerade üüüberhaupt nichts vor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100222,
					"content": "Darf ich euch dann um einen Gefallen bitten? Um ehrlich zu sein, habe ich das Gefühl, dass Albedo ... mir und Timaeus etwas verheimlicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100223
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412100223,
					"content": "Aber ist er nicht euer Lehrer? Warum würde ein Lehrer etwas vor seinen Schülern verbergen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100224,
					"content": "Das stimmt schon. Aber ich habe trotzdem das Gefühl, dass er die ganze Zeit etwas verbirgt. Wenn ich raten müsste, würde ich sagen, dass es sich dabei um ein großes Geheimnis der Alchimie handelt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100225
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412100225,
					"content": "Moment mal, wie kannst du dir da so sicher sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100226,
					"content": "Timaeus und ich, wir beide widmen uns unserer alchimistischen Forschung mit Leidenschaft. Wenn es etwas Geringeres wäre, würde Albedo keinen Grund haben, es vor uns geheim zu halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100227
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412100227,
					"content": "Hmm ... du könntest recht haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100228,
					"content": "Würdet ihr mir helfen, herauszufinden, was Albedo verbirgt? Bitte! Ich ... Die Neugier bringt mich um!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100229
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412100229,
					"content": "Hmm ... was hältst du von der Sache?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100230,
						412100231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100230,
					"content": "Wenn es die Dame wünscht, sollten wir uns darum kümmern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100232
					]
				},
				{
					"id": 412100232,
					"content": "Ja! Danke, vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100233
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 412100233,
					"content": "Schon gut, schon gut. Sollen wir einen kleinen Ausflug machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100231,
					"content": "Außerdem bin ich selbst auch neugierig, was Albedo für ein Geheimnis hat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100232
					]
				},
				{
					"id": 412100207,
					"content": "Sind die essbar? Fragen über Fragen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100208
					]
				}
			]
		},
		{
			"id": 4121003,
			"completionStepIds": [
				4121004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121004",
							"2"
						],
						"stepId": 4121004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100301,
					"content": "Albedo ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100302,
					"content": "Hallo! Wir sind’s mal wieder.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100303
					]
				},
				{
					"id": 412100303,
					"content": "Hmm? Was führt euch hierher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100304
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100304,
					"content": "Habt ihr euch verirrt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100305
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100305,
					"content": "Ganz und gar nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100306,
						412100307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100306,
					"content": "Saccharose hat uns geschickt, wir sollen deine Geheimnisse herausfinden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100308
					]
				},
				{
					"id": 412100308,
					"content": "Geheimnis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100309,
					"content": "He! Was ist in dich gefahren?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100310,
					"content": "Wir hätten viel unauffälliger vorgehen müssen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100311,
					"content": "Na ja, wir hätten ihm so oder so nichts vorgemacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100312
					]
				},
				{
					"id": 412100312,
					"content": "Ähm ... das sagst du so einfach, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100313,
					"content": "Wie dem auch sei, ihr seid gerade rechtzeitig gekommen. Ich kann eure Hilfe nämlich tatsächlich auch gerade gut gebrauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100314,
					"content": "Hier, fang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100315
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100315,
					"content": "Hä? Was ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100316,
					"content": "Ein Schwert, wie du sehen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100317,
						412100318
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100317,
					"content": "Du schmiedest wohl gerne, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100319
					]
				},
				{
					"id": 412100319,
					"content": "Ich habe dieses Schwert nicht gefertigt. Aber ich habe es mit etwas Alchimie bearbeitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100320
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100320,
					"content": "Möchtest du es ausprobieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100321,
					"content": "Du gibst es mir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100322
					]
				},
				{
					"id": 412100322,
					"content": "Meine Forschung deutet darauf hin, dass das Schwert einige ... einzigartige Merkmale aufweist. Nur du kannst es verwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100323
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100323,
					"content": "Aber ich brauche die Daten ziemlich dringend ... dürfte ich dich deshalb bitten, es im Kampf zu nutzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100324
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100324,
					"content": "Moooment mal. Was soll das für ein Schwert sein, das nur eine Person nutzen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100325,
					"content": "Muss ich mit Nebenwirkungen rechnen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100326
					]
				},
				{
					"id": 412100326,
					"content": "Ah, du bist scharfsinnig. Das Schwert ist tatsächlich mit einem Fluch belegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100327
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100327,
					"content": "Ein normaler Mensch könnte es überhaupt nicht führen. Aber du bist die Ausnahme von der Regel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100328
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100328,
					"content": "Hä?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100329,
					"content": "Oder vielleicht sollte ich sagen, dass dir der Fluch nichts anhaben kann. Und da das so ist, wer könnte mir außer dir noch helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100330
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100330,
					"content": "Aber plaudern bringt uns nicht weiter. Suche ein paar Monster in der Gegend ... Manchmal geht nichts über die Praxis, wenn man etwas herausfinden will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100318,
					"content": "Muss man als Alchimist auch schmieden können?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100319
					]
				},
				{
					"id": 412100307,
					"content": "Saccharose meint, dass du ein unaussprechliches Geheimnis verbirgst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100308
					]
				}
			]
		},
		{
			"id": 4121004,
			"completionStepIds": [
				4121006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121006",
							"2"
						],
						"stepId": 4121006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bösartiger Mann"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100401,
					"content": "Hier drüben! Dieser Lump hat es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100402
					],
					"speakerTitle": "Bösartiger Mann"
				},
				{
					"id": 412100402,
					"content": "Gib es zurück, du Dieb!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100403
					],
					"speakerTitle": "Bösartiger Mann"
				},
				{
					"id": 412100403,
					"content": "Schatzräuber? Hier ist es so kalt und trotzdem treiben sich hier Schatzräuber herum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100404,
					"content": "Genug geredet! Rückt es raus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100405
					],
					"speakerTitle": "Bösartiger Mann"
				},
				{
					"id": 412100405,
					"content": "Achtung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 4121005,
			"completionStepIds": [
				4121008
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121008",
							"2"
						],
						"stepId": 4121008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100501,
					"content": "Na, das ist ja mal frech ... von Schatzräubern „Dieb“ genannt zu werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100502,
					"content": "Die waren ziemlich schnell da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100503,
						412100504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100503,
					"content": "Moment mal, bist du etwa dieser Dieb?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100505
					]
				},
				{
					"id": 412100505,
					"content": "Himmel, nein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100506
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100506,
					"content": "Sie haben wohl über sein Schwert gesprochen. Was ist hier los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100507,
					"content": "Warum schaut ihr mich so an? Ich habe das Schwert nicht gestohlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100508
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100508,
					"content": "Vor Kurzem haben die Ritter eine Bande Schatzräuber vor der Stadt gefasst. Ihre Schmuggelware wurde auch beschlagnahmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100509
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100509,
					"content": "Dieses Schwert war ein Teil davon. Wir hielten es für Diebesgut, aber niemand kam, um es zurückzufordern, und wir konnten nicht herausfinden, woher es kam. Und so rostete es in unserem Lager vor sich hin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100510
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100510,
					"content": "Ich habe es durch Zufall bemerkt, als ich im Lager war. Um die Wahrheit zu sagen, ein altes Schwert wie dieses würde zu sonst nicht mehr viel taugen als für alchimistische Zwecke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100511
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100511,
					"content": "Du hast es dir einfach so unter den Nagel gerissen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100512,
					"content": "Und ... was ist dann passiert? Du hast es einfach mitgenommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100513,
					"content": "Das habe ich. Und ursprünglich wollte ich es für ein paar Experimente verwenden, aber währenddessen habe ich zu meiner Überraschung herausgefunden, wo es wirklich herkommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100514
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100514,
					"content": "Diese zerbeulte Waffe war einst im Besitz eines mittlerweile verstorbenen Schmieds. Es ist ein legendäres magisches Schwert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100515,
					"content": "Ein magisches Schwert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100516,
					"content": "Es heißt, dass der Schmied kurz nachdem er die Waffe gefertigt hatte verschwand. Und die Waffe selbst geriet mit der Zeit in Vergessenheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100517,
					"content": "Da es letzten Endes in unserem Lager landete, kann man nur vermuten, dass es irgendwann von den Schatzräubern gestohlen wurde und seine wahre Natur bis vor Kurzem verborgen blieb.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100518,
					"content": "Der Schmied, der die Waffe gefertigt hat ... ist verschwunden? Irgendwie ist das ganz schön gruselig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100519,
					"content": "Kein Wunder, dass es verflucht ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100520,
					"content": "Genau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100521,
					"content": "Dass Menschen überhaupt so eine Waffe herstellen können ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100522
					]
				},
				{
					"id": 412100522,
					"content": "Kennst du die Geschichte von <color=#00E1FFFF>Durin</color> und diesem Berg?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100523
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100523,
					"content": "<color=#00E1FFFF>Durin</color> war ein schwarzer Drache, der Mondstadt terrorisierte, bevor er endlich mit vereinten Kräften von <color=#00E1FFFF>Dvalin</color> und dem <color=#00E1FFFF>Anemo-Archon Barbatos</color> besiegt wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100524
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100524,
					"content": "Nach einem heftigen Kampf stürzte Durin zu Boden in den hohen Schnee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100525
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100525,
					"content": "Der Schnee sammelt sich auf diesem Berg und schmilzt nie, was höchst seltsam ist. Da fragt man sich doch, ist Durin durch Zufall hier gestürzt oder war das Absicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100526
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100526,
					"content": "Absichtlich? Ist das überhaupt möglich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100527,
					"content": "Vielleicht wurde dieser Ort bewusst als Grab gewählt, damit das ätzende Gift aus dem Körper Durins durch die Macht des Schnees eingeschlossen bleibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100528
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100528,
					"content": "Ich würde Barbatos durchaus zutrauen, sich so etwas einfallen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100529
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100529,
					"content": "Huch! War Barbatos so ein scharfsinniger Gott?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100530,
					"content": "Na ja, das sind nur meine Vermutungen. Beweise habe ich dafür keine. Fest steht auf jeden Fall, dass dieser Berg und Durin untrennbar miteinander verbunden sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100531
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100531,
					"content": "Tatsächlich glaube ich, dass ebenjenes Schwert in deinen Händen Durins sterbliche Überreste enthält.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100532
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100532,
					"content": "Die Überreste eines Drachen?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100533,
					"content": "In der Tat. Die Augen, Klauen und Schuppen des toten Drachen ... zu Staub zermalmt, um die Klinge damit zu beschichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100534
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100534,
					"content": "Auf diese Weise sind Durins Verderbtheit und sein Gift in das Schwert eingedrungen und zur Quelle seiner Macht geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100535
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100535,
					"content": "So etwas kann nur ein Meister seines Fachs herstellen. Vermutlich hat sie der Schmied vor Freude, weil es ihm gelungen war, sie zu fertigen, gleich ausprobiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100536
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100536,
					"content": "Aber weil das Schwert im Kampf eingesetzt wurde, konnte die Verderbtheit durch den Griff der Klinge in seinen Körper sickern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100537
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100537,
					"content": "Gewöhnliche Sterbliche können so einer Macht nicht widerstehen. Der Schmied wurde bestimmt durch den Fluch in den Wahnsinn getrieben, floh und fand irgendwo an einem unbekannten Ort sein Ende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100538
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100538,
					"content": "Herrje ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100539,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100540
					]
				},
				{
					"id": 412100540,
					"content": "Du hast Dvalins Tränen gereinigt, mit dieser Fähigkeit sind nur die wenigsten gesegnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100541
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100541,
					"content": "Diese Fähigkeit hat dich davor beschützt, Verderbnis oder Gift zum Opfer zu fallen, und du kannst deren Effekte ganz und gar eliminieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100542
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100542,
					"content": "Deshalb kannst nur du dieses Schwert wirklich führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100543
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100543,
					"content": "Trotzdem ist das Schwert echt riesig ... Pfui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100544
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100544,
					"content": "E... Es leuchtet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100545
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100545,
					"content": "Ah, endlich. Hier beginnt das wahre Experiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100546
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100546,
					"content": "Das Schwert ist immer noch ziemlich schwach. Es ist jedoch in der Lage, Energie zu absorbieren, und dadurch wird es stets stärker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100547
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100547,
					"content": "Man könnte direkt sagen, es lebt irgendwie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100548
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100548,
					"content": "#Nun denn, {F#Reisende}{M#Reisender}! Nimm es mit und erlebe ein Abenteuer nach dem anderen mit ihm. Ich brauche deine Hilfe, damit es wächst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100549
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100549,
					"content": "Ich glaube, dass wir bald Ergebnisse sehen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100504,
					"content": "Du hast ihnen doch nichts geklaut, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100505
					]
				}
			]
		}
	]
}