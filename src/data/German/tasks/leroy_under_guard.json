			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Molli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510301,
					"content": "#Paimon, {NICKNAME}, ich habe Nana schon gefüttert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510302
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510302,
					"content": "Sehr schön! Und jetzt gehen wir zu Herrn Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510303,
					"content": "Aber ich mache mir Sorgen. Wird er rauskommen? Ich war kürzlich da, aber er hat nicht mit mir gesprochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510304
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510304,
					"content": "Ich habe an die Tür geklopft, bevor ihr gekommen seid, aber gerade als er herauskam, kam sein unheimlicher Schwiegersohn und zerrte ihn wieder hinein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510305
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510305,
					"content": "Der Mann gab mir dann ein paar Süßigkeiten und sagte mir, ich solle zu meinen Eltern zurückgehen. Dann schloss er die Tür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510306
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510306,
					"content": "Benoit ist ein so warmherziger Mann. Warum sind seine Familienmitglieder so kalt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510307,
					"content": "Der Schwiegersohn von Herrn Leroy sagte, er sei krank und könne mich nicht empfangen, aber ich fand, dass er gut aussah. Warum konnte er also nicht mit mir sprechen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510308
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510308,
					"content": "Fräulein Paimon, ich denke, es ist auch in Ordnung, wenn ich meinen Aufsatz nicht fertig schreiben kann. Ich mache mir im Moment mehr Sorgen um Herrn Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510309
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510309,
					"content": "Wenn er wirklich krank ist, muss es ihm jetzt schlecht gehen. Mama hat mir gesagt, dass wir uns gut um kranke Menschen kümmern müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510310
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510310,
					"content": "Könntet ihr also mit mir zu diesem Schwiegersohn gehen und ihn fragen, was für eine Krankheit sich Herr Leroy eingefangen hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510311
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510311,
					"content": "Dann kann ich nach Hause gehen und meine Eltern fragen, was ich tun soll. Ich frage mich, ob er zu viel Kuchen gegessen hat oder sich im Schlaf erkältet hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510312,
						741510313
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510312,
					"content": "Lass uns erst an die Tür klopfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				},
				{
					"id": 741510314,
					"content": "Ja, aber könntet ihr für mich mit diesem schrecklichen Schwiegersohn sprechen? Ich habe ein bisschen Angst vor ihm, er ist immer so wütend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510315
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510315,
					"content": "Keine Sorge, Molli, wir helfen dir dabei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510313,
					"content": "Wir haben doch vereinbart, wiederzukommen, oder nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				}
			]
		},
