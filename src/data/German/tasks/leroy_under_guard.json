			"dialogs": [
				{
					"id": 741511001,
					"content": "Die Beziehung zwischen dem Paar und Benoit hat etwas Ungewöhnliches an sich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511002
					]
				},
				{
					"id": 741511002,
					"content": "Als wir sie vor ein paar Tagen trafen, schien alles noch in Ordnung zu sein. Aber heute scheinen ihre Gespräche ... ein wenig seltsam zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511003,
						741511005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511003,
					"content": "Benoit wird von seinem Schwiegersohn bedroht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511004
					]
				},
				{
					"id": 741511004,
					"content": "Das kann sein. Dieser Schwiegersohn warf Benoit einen Blick zu, damit er zurück ins Haus ging, bevor wir ihn etwas fragen konnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511007,
					"content": "Hm, Paimon weiß jetzt ungefähr, warum Paimon das Gefühl hat, dass etwas Seltsames vor sich geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511005,
					"content": "Benoit wird von seiner Tochter bedroht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511006
					]
				},
				{
					"id": 741511006,
					"content": "Paimon hat das nicht bemerkt. Paimon findet nur die Art, wie sie spricht, irgendwie nervig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511007
					],
					"speakerTitle": "Paimon"
				}
			]
		},
