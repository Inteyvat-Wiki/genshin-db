			"dialogs": [
				{
					"id": 741511201,
					"content": "Nun, das ist alles, was ich bisher herausgefunden habe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511202
					]
				},
				{
					"id": 741511202,
					"content": "#{NICKNAME} ... Ähm ... Glaubst du, dass Benoit in Gefahr ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511203,
					"content": "Genau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511204
					]
				},
				{
					"id": 741511204,
					"content": "Ach, Paimon hat ein schlechtes Gefühl bei dieser Sache. Sollten wir den Fall an die Maison Gardiennage melden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511205,
						741511206,
						741511207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511205,
					"content": "Wir haben noch keinen Beweis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511208
					]
				},
				{
					"id": 741511208,
					"content": "Ja, da hast du recht. Schließlich haben wir vor, Benoit zu helfen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511209,
					"content": "Molli hat uns gebeten, Benoit zu sagen, dass seine Süßigkeiten sehr gut waren. Wir haben ihr unser Wort gegeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511210,
					"content": "Und das werden wir auch tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511211
					]
				},
				{
					"id": 741511211,
					"content": "Hehe, Paimon wusste, dass du dein Wort halten wirst! Und, hast du schon Pläne für unseren nächsten Schritt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511212,
					"content": "Es wird Zeit für Ermittlungen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511213
					]
				},
				{
					"id": 741511213,
					"content": "Ja, finden wir heraus, was dahintersteckt! ... Äh, aber was genau ermitteln wir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511214,
						741511215,
						741511216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511214,
					"content": "Die Identität dieses Paares.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511217
					]
				},
				{
					"id": 741511217,
					"content": "#Jawohl! Detektivin Paimon und {F#Detektivin}{M#Detektiv} {NICKNAME} werden alle Geheimnisse lüften!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511215,
					"content": "Das Ziel dieses Paares.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511217
					]
				},
				{
					"id": 741511216,
					"content": "Was Benoit von diesem Paar hält.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511217
					]
				},
				{
					"id": 741511206,
					"content": "Wir kennen die Wahrheit noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511208
					]
				},
				{
					"id": 741511207,
					"content": "Wir wissen nicht, was Benoit denkt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511208
					]
				}
			]
