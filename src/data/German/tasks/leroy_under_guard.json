			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 741500501,
					"content": "Wie hast du in letzter Zeit geschlafen, Vater? Leidest du immer noch an Schlaflosigkeit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500502
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500502,
					"content": "Es geht mir viel besser. Ich habe fast keine Albträume mehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500503
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500503,
					"content": "(Das Geplauder der Familie Leroy wird immer leiser ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Einmal klopfen"
				}
			]
		},
		{
			"id": 7415101,
			"completionStepIds": [
				7415101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415101",
							"2"
						],
						"stepId": 7415101,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415104",
							"3"
						],
						"stepId": 7415104,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Molli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510101,
					"content": "Oh, ihr seid es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510102
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510102,
					"content": "#Wir sind Paimon und {NICKNAME}, du kannst uns einfach beim Namen nennen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510103,
					"content": "Molli, bist du hier, um Benoit zu besuchen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510104
					]
				},
				{
					"id": 741510104,
					"content": "Richtig, aber ich konnte nicht einmal mit ihm sprechen ... *seufz* Sieht so aus, als würde ich meinen Aufsatz nicht beenden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510105
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510105,
					"content": "Aufsatz? Oh, Paimon erinnert sich! Du hast gute Taten vollbracht, weil du Material für deine Hausaufgaben brauchst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510106,
					"content": "He, das ist nicht wahr! Ich mag Herrn Leroy wirklich. Er ist wirklich ... flutschig? Ja, er ist flutschig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510107
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510107,
					"content": "Pff, was ist das denn für eine Beschreibung? Du meinst, er ist ein geselliger Mensch, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510108,
					"content": "Oh, Fräulein Paimon, bitte hilf mir! Sonst kann ich meinen Aufsatz nicht zu Ende schreiben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510109
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510109,
					"content": "Meine Tutorin sagte, dass mein Aufsatz darüber, wie ich Herrn Leroy half, seine Katze zu füttern, „von Rand zu Rand mit einem reinen Sinn für Volltätigkeit gefüllt war“, und sie wollte, dass ich noch einen schreibe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510110
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510110,
					"content": "„Volltätigkeit“? ... Ach, du meinst „Wohltätigkeit“, oder? Wie auch immer, Paimon hat es verstanden. Deshalb musstest du also zurückkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510111,
					"content": "Es ist zwar auch für meine Hausaufgaben, aber ich mag Herrn Leroy wirklich sehr! Er wollte, dass ich meine Eltern von ihm grüße, und das habe ich getan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510112
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510112,
					"content": "Aber sie waren nicht sehr erfreut, seinen Namen zu hören, und sie wollten auch nicht, dass ich ihn wieder besuche. Ich weiß nicht wirklich, warum ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510113
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510113,
					"content": "Nun, es ist sicher einfach, einige Materialien für einen Aufsatz zu sammeln. Du kannst die Katze einfach wieder füttern wie beim letzten Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510114,
					"content": "Das reicht nur für eine oder zwei Zeilen, ich brauche mehr Material.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510115
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510115,
					"content": "Wir begleiten dich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510116
					]
				},
				{
					"id": 741510116,
					"content": "Ja. Du wirst die Katze füttern und wir werden die Bereiche vor der Tür und hinter dem Haus reinigen, genau wie beim letzten Mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510117,
					"content": "Und wenn wir fertig sind, klopfen wir an die Tür und erzählen Benoit davon. Dann gibt es genug Dinge, über die du schreiben kannst, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510118,
					"content": "Ja, das wird reichen! Fräulein Paimon, du bist so schlau. Ich gehe jetzt die Katze füttern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Molli"
				}
			]
		},
		{
			"id": 7415103,
