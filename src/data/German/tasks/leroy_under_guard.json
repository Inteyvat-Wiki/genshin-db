			"dialogs": [
				{
					"id": 741511101,
					"content": "Die Art und Weise, wie dieses Paar mit Fremden umgeht, ist ziemlich merkwürdig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511102
					]
				},
				{
					"id": 741511102,
					"content": "Ja, vor so kurzer Zeit, als wir sie zum ersten Mal trafen, waren sie noch freundliche Leute. Und jetzt sind sie so unhöflich geworden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511103,
					"content": "Sie waren nur freundlich, wenn ihr Vater in der Nähe war.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511104
					]
				},
				{
					"id": 741511104,
					"content": "Hmm ... Stimmt, Paimon erinnert sich, dass dieser Schwiegersohn uns ungeduldig aufgefordert hat, nicht mehr zu kommen, gleich nachdem Benoit das Haus betreten hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511105,
					"content": "Sie geben nur vor, freundlich zu sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511106
					]
				},
				{
					"id": 741511106,
					"content": "Aber warum sollten sie vor ihrem Vater so tun? Es muss doch einen Grund dafür geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
