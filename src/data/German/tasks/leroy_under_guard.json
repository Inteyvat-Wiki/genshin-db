			"dialogs": [
				{
					"id": 741510901,
					"content": "Mit diesem Ehepaar stimmt etwas nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510902
					]
				},
				{
					"id": 741510902,
					"content": "Paimon findet das auch. Der Mann redet so viel und die Frau sagt kaum ein Wort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510903,
					"content": "Der Zeitpunkt ihres Erscheinens war zu gut gewählt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510904
					]
				},
				{
					"id": 741510904,
					"content": "Weil sie gerade auftauchten, als Benoit einen Helfer einstellen wollte, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510905,
					"content": "Fräulein Euphrasie sagte, er habe vor einem halben Jahr beschlossen, einen Helfer einzustellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510906,
					"content": "Doch dann wurde dieses Paar zu seinen Kindern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510907
					]
				},
				{
					"id": 741510907,
					"content": "Du hast recht. Das läuft alles viel zu künstlich ab ... Mit diesem Paar stimmt etwas ganz und gar nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
