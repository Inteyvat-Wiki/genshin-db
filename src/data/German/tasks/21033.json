				"objectNames": [
					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210330101,
					"content": "Ich habe eine Idee ... Aber vielleicht lohnt sie sich nicht besonders ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330102,
					"content": "Suchst du immer noch nach diesem Schwert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330103
					]
				},
				{
					"id": 210330103,
					"content": "#Hm? Ach, {F#Reisende}{M#Reisender}, du bist es ... Ja, ich suche immer noch nach der „Versteckten Klinge“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330104,
					"content": "Aber bis jetzt habe ich noch keine wertvollen Spuren, die darauf hindeuten gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330105,
					"content": "Aber das lässt sich nicht ändern ... Und in ganz Liyue nach einem Schwert zu suchen ist wirklich nicht einfach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330106,
					"content": "Jemand hat zu mir gesagt, dass dieses Schwert vielleicht schon früher von Monstern zerstört wurde ... Aber selbst wenn es so wäre, würde ich all seine Bruchstücke zusammensuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330107
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330107,
					"content": "Entschuldige, dass ich dich mit meinem Monolog so lange belastet habe. Den Ort dieses Auftrags habe ich bereits auf deiner Karte markiert. Ich zähle auf dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330108,
					"content": "Ich hoffe ... dass das Schwert nicht wirklich zerbrochen ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
