			"dialogs": [
				{
					"id": 210330401,
					"content": "#Wie ist es gelaufen, {F#Reisende}{M#Reisender}? Hast du etwas gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330402
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330402,
					"content": "Ich habe diesen Schwertgriff gefunden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 2103306,
			"completionStepIds": [
				2103306
			],
