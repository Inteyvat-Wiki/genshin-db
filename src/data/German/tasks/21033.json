			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210330403,
					"content": "Dieser Schwertgriff ... sieht immer noch intakt aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330404
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330404,
					"content": "Hat er etwas mit der „Versteckten Klinge“ zu tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330405
					]
				},
				{
					"id": 210330405,
					"content": "Das kann ich erst nach genauer Betrachtung sagen ... Oh, das habe ich dir noch gar nicht gesagt ... Ich habe erst vor Kurzem überall nach den Bruchstücken der Waffe gesucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330406
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330406,
					"content": "Vom Markt, aus der Wildnis und von Abenteurern habe ich viele Bruchstücke erhalten ... Ich hoffe, dass ich auf diese Weise eine Spur der „Versteckten Klinge“ stoßen könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330407
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330407,
					"content": "Doch bis jetzt konnte ich keine einzige Spur davon entdecken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330408
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330408,
					"content": "Das macht nichts, in Liyue sagt man „Der Glaube kann Berge versetzen“. Ich werde so lange weitersuchen, bis ich die „Versteckte Klinge“ gefunden habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330409
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330409,
					"content": "#Und hier ist deine Belohnung. Die hast du dir wirklich verdient, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		}
	]
