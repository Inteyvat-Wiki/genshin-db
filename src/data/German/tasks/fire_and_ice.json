			"dialogs": [
				{
					"id": 761830101,
					"content": "Danke für die Einladung, Sandrone. Die Leckereien schmecken genau so, wie ich es in Erinnerung habe. Das lässt mich wirklich an alte Zeiten zurückdenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830102
					],
					"speakerTitle": "„Arlecchino“"
				},
				{
					"id": 761830102,
					"content": "Gern geschehen. Wenn du möchtest, können wir uns öfter treffen, sobald ich wieder in Snezhnaya bin. Es wird genau wie in den alten Zeiten sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830103,
					"content": "Natürlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830104
					],
					"speakerTitle": "„Arlecchino“"
				},
				{
					"id": 761830104,
					"content": "Apropos Snezhnaya, wie läuft es bei dir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830105
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830105,
					"content": "Die Pläne Ihrer Majestät der Zarin haben erste Fortschritte gemacht, aber Projekt Stuzha lässt sich schwieriger umsetzen, als der Bürgermeister erwartet hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830106
					],
					"speakerTitle": "„Arlecchino“"
				},
				{
					"id": 761830106,
					"content": "Dann sieht es wohl so aus, als wären wir beide ab jetzt ziemlich beschäftigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830107,
					"content": "Aber wir sollten trotzdem noch Zeit haben, um ab und zu eine Tasse Tee zu trinken oder uns sogar eine Vorstellung der Korolevskiy-Theaterkompanie anzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830124
					],
					"speakerTitle": "„Arlecchino“"
				},
				{
					"id": 761830124,
					"content": "Allerdings. Wir sollten aber trotzdem noch Zeit haben, um ab und zu eine Pause für eine Tasse Tee einzulegen oder uns sogar eine Aufführung der Korolevskiy-Theaterkompanie anzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830108
					],
					"speakerTitle": "„Arlecchino“"
				},
				{
					"id": 761830108,
					"content": "Tanzt Odette noch Ballett?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830109,
					"content": "Ja. Jedes Mal, wenn ich sie sehe, scheint sie immer noch ein bisschen besser geworden zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830110
					],
					"speakerTitle": "„Arlecchino“"
				},
				{
					"id": 761830110,
					"content": "Erstaunlich. Ich würde sie gerne wieder auftreten sehen, wenn ich zurück bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830111,
					"content": "Ich finde das wirklich faszinierend. Obwohl sie ihr Handwerk bei Rosalyne gelernt hat, könnten die Temperamente und Stile der beiden nicht unterschiedlicher sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830112,
					"content": "Das ist nicht unbedingt etwas Schlechtes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830113
					],
					"speakerTitle": "„Arlecchino“"
				},
				{
					"id": 761830113,
					"content": "Stimmt ... Rosalyne tanzte mit feuriger Leidenschaft, während Odette so frostig und undurchsichtig ist wie ein massiver Eisblock.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830114,
					"content": "Sie scheint einiges mit sich herumzutragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830115
					],
					"speakerTitle": "„Arlecchino“"
				},
				{
					"id": 761830115,
					"content": "Und dennoch, wenn sie auf der Bühne steht, sind ihre Bewegungen so rein, als wäre ihr Herz frei von jedem noch so kleinen Makel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830116,
					"content": "Oder vielleicht hat sie all das an einem Ort verschlossen, wo niemand es sehen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830117
					],
					"speakerTitle": "„Arlecchino“"
				},
				{
					"id": 761830117,
					"content": "Vielleicht. Ist es am Ende nicht genau das, was Eis tut, nämlich Risse zuzufrieren? Aber sie ist nicht zerbrechlich, sie ist entschlossen. Ich würde überhaupt eher sagen, dass sie gefährlich ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830118,
					"content": "Zumindest in dieser Hinsicht ähnelt sie Rosalyne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830119
					],
					"speakerTitle": "„Arlecchino“"
				},
				{
					"id": 761830119,
					"content": "Weil sie gefährlich ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830120
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830120,
					"content": "Weil sie entschlossen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830121
					],
					"speakerTitle": "„Arlecchino“"
				},
				{
					"id": 761830121,
					"content": "Ich glaube, du hast recht. Kein Wunder, dass es Gerüchte gibt, sie sei die Favoritin, den Titel „La Signora“ zu erben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830122
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830122,
					"content": "Hah ... Wenn wir sie besser kennenlernen, könnten wir sie zu unseren Teegesellschaften einladen. Ich hoffe, sie lehnt nicht ab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830123
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830123,
					"content": "Das hoffe ich auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830124
					],
					"speakerTitle": "„Arlecchino“"
				}
			]
		},
