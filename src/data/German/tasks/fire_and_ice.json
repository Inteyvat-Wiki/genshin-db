					"„Arlecchino“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761830201,
					"content": "Es ist wichtig, sich ab und zu Zeit zum Entspannen zu nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830202,
						761830203
					],
					"speakerTitle": "„Arlecchino“"
				},
				{
					"id": 761830202,
					"content": "(Lass uns noch ein Weilchen so sitzen bleiben.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830204,
					"content": "Nun gut. Wir sehen uns in Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Arlecchino“"
				},
				{
					"id": 761830203,
					"content": "Ich glaube, es wird Zeit, dass ich mit dem Aufräumen anfange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
}