				"points": []
			},
			"dialogs": [
				{
					"id": 700160201,
					"content": "Yoyo dada! Mimi tomo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160202
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700160202,
					"content": "Mimi muhe du, du ya Wei zido dala si.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160203
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700160203,
					"content": "Mi mito nye. Mi mito du, du ya mito Wei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160204
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700160204,
					"content": "Er hat uns zu diesem Ort geführt. Er sagte, er hätte ihn hier schon einmal gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160205
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700160205,
					"content": "Valo! Tomo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700160206
					]
				},
				{
					"id": 700160206,
					"content": "Valo, valo ...",
