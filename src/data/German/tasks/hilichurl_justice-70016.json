			"dialogs": [
				{
					"id": 700160101,
					"content": "... Yaya dala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160102
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700160102,
					"content": "Mimi tomo, mimi mosi mita, Muhe mita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700160103,
					"content": "Mita ...? Gusha ... Dada ika odomu Plata mimi, mimi mosi gusha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160104
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700160104,
					"content": "Mimi tomo, mimi plata yaya ika! Mimi mani ye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700160105,
					"content": "Mani ...? Dada! Kundala zido mi, mi dada, mimi tomo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160106
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700160106,
					"content": "Scheint so, als würden sie wirklich in ein Gespräch kommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160107,
						700160108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700160107,
					"content": "Ziemlich außergewöhnlich, Fräulein Musk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700160109
					]
				},
				{
					"id": 700160109,
					"content": "Es redet einfach nicht gerne. Aber ich habe es trotzdem geschafft, die Informationen zu bekommen, die wir brauchten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160110
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700160110,
					"content": "Hilf ihm, die Feinde zu besiegen! So, jetzt bist du dran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700160111,
					"content": "Dada, Valo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700160108,
					"content": "Das war in der Tat eine sehr reibungslose Interaktion.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700160109
					]
				}
			]
		},
		{
