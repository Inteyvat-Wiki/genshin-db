				"points": []
			},
			"dialogs": [
				{
					"id": 400021501,
					"content": "Halt, nicht weiter! Hier ist der Sitz des ??? von Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021502
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021502,
					"content": "Wir möchten einen seltsamen Kerl melden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021503
					]
				},
				{
					"id": 400021503,
					"content": "Bei den leicht entzündlichen Materialien für die Mingxiao-Laterne hat sich so ein gruseliger Typ herumgetrieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021504,
					"content": "Wir können doch nicht zulassen, dass dem Stand mit dem eingelegten Allerlei etwas zustößt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021505,
					"content": "Oh, das klingt tatsächlich nach einem ernsten Fall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021506
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021506,
					"content": "Nicht wahr? Das Essen von Liyue ist die Seele der Stadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021507,
					"content": "Ähm, ich glaube, wir reden aneinander vorbei ... Dieser Mann, den du erwähnt ist, könnte wirklich gefährlich sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021508
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021508,
					"content": "Ich werde die Informationen sofort weiterleiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021509
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021509,
					"content": "Vielen Dank, dass ihr vorbeigekommen seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021510
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021510,
					"content": "Ihr müsst euch aber wirklich sorgfältig darum kümmern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}