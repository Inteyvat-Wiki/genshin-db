				"points": []
			},
			"dialogs": [
				{
					"id": 400020501,
					"content": "Oh, das sind ja wirklich ein ??? und ein ??? von hoher Qualität!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020502
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020502,
					"content": "Vielen Dank! Hier ist eure Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020503
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020503,
					"content": "Euer Fleiß wird in die Größe des Laternenritual einfließen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020504
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020504,
					"content": "Da ihr schon einmal zur Zeit des Laternenrituals hier seid, solltet ihr auf den Fortschritt der Mingxiao-Laterne achten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020505
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020505,
					"content": "Je weiter die Bauarbeiten vorankommen, desto schöner wird der Anblick an der Anlegestelle sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020506
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020506,
					"content": "#Das klingt toll! {NICKNAME}, wir sollten mal einen Blick drauf werfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4000214,
			"completionStepIds": [
				4000214
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
