			"trigger": {
				"objectNames": [
					"Huixin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400020201,
					"content": "Oh, ihr seid es! Vielen Dank für eure Spenden für das Laternenritual!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020202
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020202,
					"content": "Da ihr schon hier seid, ich habe da etwas für euch. Diesmal geht es nicht um eine Spende, sondern um An- und Verkauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020203
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020203,
					"content": "Oh? Gibt es diesmal eine richtige Belohnung? Dann würde Paimon sich schon dafür interessieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400020204,
					"content": "Haha, na, dann hört mal zu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020205
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020205,
					"content": "Um das Fest vorbereiten zu können, brauchen wir zwei besondere Plaustrite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020206
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020206,
					"content": "Einer muss ein Azurit sein. Sowas findet man hin und wieder im Norden auf dem Tianheng-Berg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020207
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020207,
					"content": "Im Wurzelsystem verbirgt sich ein gewöhnlicher Strauch mit einem Azurit. Manchmal entstehen dann auch Zauselfrüchte, wodurch die Samen durch die Luft schweben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020208
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020208,
					"content": "Der andere muss ein Cinnabarit sein. Für normale Menschen ist er aber sehr gefährlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020209
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020209,
					"content": "Auf der Guili-Ebene verwendet ein alter Ruinenjäger, der nicht mehr von selbst fliegen kann, einen Cinnabarit, um dennoch weiterhin zu schweben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020210
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020210,
					"content": "Aha! Ein Azurit und ein Cinnabarit also!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400020211,
					"content": "(Eigentlich nichts weiter als rote und blaue Plaustrite ... Die Namen haben sich bloß Händler für einen besseren Effekt einfallen lassen.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020212
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020212,
					"content": "Genau! Ihr müsst aber gut aufpassen, verstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huixin"
				}
			]
		},
