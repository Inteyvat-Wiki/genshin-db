				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400021001,
					"content": "Am letzten Tag Laternenrituals werden ganz viele Leute kommen, um sich die ??? anzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021002,
					"content": "Es kann nichts Gutes bedeuten, einen so seltsamen Typen an einem so gefährlichen Ort zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021003,
					"content": "Was ist, wenn er mit diesen entzündlichen Materialien herumgespielt hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021401
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021401,
					"content": "Sieht ganz nach einem Fall für die Behörden aus! Wir sollten zu Rat für Allgemeine Angelegenheiten von Liyue gehen, um den Vorfall zu melden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021406,
					"content": "Warum machst du dir solche Gedanken, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021407
					]
				},
				{
					"id": 400021407,
					"content": "Na ... Alle in Liyue geben ihr Bestes, damit jeder ein schönes Fest hat. Wenn da einfach jemand kommt und alles kaputtmacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021408,
					"content": "Die Wahrheit bitte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021409
					]
				},
				{
					"id": 400021409,
					"content": "Das eingelegte Allerlei, das man in der Nähe der Anlegestelle bekommt, ist echt lecker. Einmal gegessen wird man es nie mehr vergessen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021410,
					"content": "Wiederholst du gerade das Motto des Verkäufers?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021411
					]
				},
				{
					"id": 400021411,
					"content": "Ehehehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
