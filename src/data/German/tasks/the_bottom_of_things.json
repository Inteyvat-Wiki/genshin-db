				"points": []
			},
			"dialogs": [
				{
					"id": 1903201201,
					"content": "Uff. Ich bin geschafft. Endlich kann ich mich ausruhen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201202
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201202,
					"content": "Ich frage mich, ob ich die Sache ein wenig zu weit getrieben habe ... Ein paar Menschen waren außer sich vor Angst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201203
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201203,
					"content": "Wer bist du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201204
					]
				},
				{
					"id": 1903201204,
					"content": "Hä? He, du solltest nicht hier sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201205
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201205,
					"content": "*seufz* Egal. Vermutlich hast du ohnehin gehört, was ich gesagt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201206
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201206,
					"content": "Ich arbeite hier und tu so, als wäre ich ein Geist. Aber jetzt habe ich Pause, deshalb habe ich mein Kostüm ausgezogen. In dem Ding fühle ich mich wie in einer Sauna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201207,
						1903201208
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201207,
					"content": "Also gibt es hier keine echten Geister?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				},
				{
					"id": 1903201209,
					"content": "Natürlich, wie könnte es hier auch echte Geister geben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201210
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201210,
					"content": "Niemand will einen echten Geist sehen, weder wir noch die Teilnehmer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201211
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201211,
					"content": "Sie kommen wegen der Atmosphäre hierher oder besser gesagt wegen des Nervenkitzels ... Alle wollen die Chance haben, mal richtig aufgeregt zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201212
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201212,
					"content": "Wenn man fürchterliche Angst hat, sagt man dem anderen, was man sich sonst nie trauen würde. Darum geht es in der Probe des Mutes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201213,
						1903201214
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201213,
					"content": "Ich glaube, ich verstehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201215,
					"content": "Gut. Ich sollte jetzt wieder arbeiten. Ich wünsche dir und deinem Freund viel Spaß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201214,
					"content": "(Chongyun wird unheimlich enttäuscht sein.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201208,
					"content": "Das ist alles geplant, um die Besucher zu erschrecken, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				}
			]
		}
	]
}