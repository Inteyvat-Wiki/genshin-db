			"dialogs": [
				{
					"id": 766740101,
					"content": "Meine Güte, das Endergebnis hat ja all meine Erwartungen übertroffen ... Wenn tatsächlich jemand aus Versehen hier hereinspaziert, wird er mit Sicherheit von der Macht der Hexe überwältigt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740102,
						766740103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740102,
					"content": "Falls wirklich jemand zufällig hier landet ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766740104
					]
				},
				{
					"id": 766740104,
					"content": "Nun, das hängt ganz davon ab, was für Menschen sie sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740105
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740105,
					"content": "Wenn man nicht aufpasst, kann Hilfe zu Selbstgefälligkeit und Anspruchsdenken führen. Wenn es jemand wie du ist, der sich auf seine eigenen Fähigkeiten verlassen möchte, dann helfe ich gerne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740106,
					"content": "Aber wenn sie zu der Sorte gehören, die ihre ganze Hoffnung auf die Macht der Hexe setzt und selbst keinen Finger rührt ... Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740107
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740107,
					"content": "... W... Was bedeutet dieses „Hehe“? Würdest du sie wirklich in eine Statue verwandeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766740108,
					"content": "Nein, nichts dergleichen. Aber ich würde sie von hier zum nahe gelegenen Kuratorium der Geheimnisse führen. Ich bin mir sicher, dass Nefer besser mit ihnen umgehen kann als ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740109
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740109,
					"content": "Wer ernten will, ohne zu säen, der sollte auch den Preis dafür zahlen, findest du nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740103,
					"content": "Wirst du sie bei der Erfüllung ihrer Wünsche unterstützen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766740104
					]
				}
			]
		}
	]
