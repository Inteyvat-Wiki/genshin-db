				"objectNames": [
					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060401,
					"content": "Soll das alles sein, was die mächtigen Fatui draufhaben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060402
					]
				},
				{
					"id": 761060402,
					"content": "#Tss, gehört „frech“ heutzutage zu unserem Rekrutierungsprofil ...? Moment mal, du bist ja überhaupt kein{F#e} neue{M#r} Rekrut{F#in}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060403
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060403,
					"content": "Hast du etwa gedacht, du könntest dich einschleusen? Tja, Pech gehabt, ich hab dich durchschaut! Ergreift sie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610605,
			"completionStepIds": [
				7610601
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
