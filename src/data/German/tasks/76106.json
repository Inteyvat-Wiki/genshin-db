					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060501,
					"content": "Ich bin euer schlimmster Albtraum! Schön, euch kennenzulernen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060502
					]
				},
				{
					"id": 761060502,
					"content": "Ah, ein feindlicher Überfall ... An alle Einheiten: Angriff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610606,
