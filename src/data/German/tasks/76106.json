		},
		{
			"id": 7610602,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060201,
					"content": "... Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060202
					]
				},
				{
					"id": 761060202,
					"content": "Ich meine es nur gut mit dir, stöbere nicht im Konstruktionsbüro herum, vor allem nicht in der zweiten Etage! Zu viel Kontakt mit Kuuvahki kann alles Mögliche verursachen, von Kopfschmerzen bis hin zu totaler Übelkeit. Also sag nicht, ich hätte dich nicht gewarnt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060301,
					"content": "Tatsächlich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060302
					]
				},
				{
					"id": 761060302,
					"content": "Aber sicher! Jeder, der dort arbeitet, erhält eine Extraportion Apfelschorle. Denk mal drüber nach: Wenn es nicht schlecht für die Gesundheit wäre, warum sollten sie die Leute mit etwas so Gutem bestechen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060303
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060303,
					"content": "Außerdem habe ich es mit meinen eigenen Augen im Gebiet der Nachkommen des Frostmonds gesehen! Ihren Diakoninnen sind Hörner gewachsen, auf ihren Köpfen! Glaubst du ernsthaft, dass das normal ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060304
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060304,
					"content": "Verstehe ... Danke für die Warnung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060305
					]
				},
				{
					"id": 761060305,
					"content": "Das ist ja furchtbar! W... Werden wir dann auch zu Monstern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761060306,
					"content": "*seufz* Immer schicken sie die Grünschnäbel rein, um die riskanten Aufgaben zu erledigen ... Sei einfach vorsichtig und bleib nicht zu lange da drin, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610604,
			"completionStepIds": [
				7610601
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
