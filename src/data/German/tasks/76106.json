			},
			"dialogs": [
				{
					"id": 761060601,
					"content": "Ich habe dir gesagt, du sollst nicht zu lange da drin bleiben! Was rennst du hier immer noch so herum? Machst du dir keine Sorgen über die Nebenwirkungen des ganzen Kuuvahki?",
					"roleType": "TALK_ROLE_NPC",
