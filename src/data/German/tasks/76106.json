			"dialogs": [
				{
					"id": 761060701,
					"content": "Mach dir keinen Kopf, ich bin nicht so schwach wie du.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060702
					]
				},
				{
					"id": 761060702,
					"content": "#Was war das?! Gehört „frech“ heutzutage zu unserem Rekrutierungsprofil? Moment mal, du bist ja überhaupt kein{F#e} neue{M#r} Rekrut{F#in}! D... Du bist ein{F#e} Spion{F#in}! Festnehmen!",
