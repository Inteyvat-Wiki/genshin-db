			"dialogs": [
				{
					"id": 761060801,
					"content": "Entschuldigung, ich bin der falschen Route gefolgt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060802
					]
				},
				{
					"id": 761060802,
					"content": "Dies hier ist ein militärisches Sperrgebiet! Wenn du hier etwas zu erledigen hast, dann beeil dich. Und wenn nicht, dann sieh zu, dass du Land gewinnst.",
