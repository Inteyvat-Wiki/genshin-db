	"talks": [
		{
			"id": 7000102,
			"completionStepIds": [
				7000102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000102",
							"2"
						],
						"stepId": 7000102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010201,
					"content": "#Na, wenn das nicht {F#die Reisende}{M#der Reisende} ist. So trifft man sich wieder. Wie gefällt dir die Atmosphäre in der Stadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010202
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010202,
					"content": "Ziemlich gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010203
					]
				},
				{
					"id": 700010203,
					"content": "Freut mich, dass du das so siehst. Es passt zwar ... nicht ganz zur feierlichen Stimmung, aber vielleicht kannst du mir ja mit etwas helfen, das mit dem Fest zu tun hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010204,
					"content": "Na ja, genauer gesagt würde „dieser Herr“ gern deine Hilfe in Anspruch nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010205
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010205,
					"content": "Ich dachte, Leute laufen während des Windblumenfests nicht herum und suchen Hilfe bei Erledigungen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010206
					]
				},
				{
					"id": 700010206,
					"content": "Ach, komm schon. Diese Sache läuft nicht unter den gewöhnlichen Strukturen des Fests.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010207
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010207,
					"content": "Wie du sicherlich bemerkt hast, ist das Windblumenfest eine sehr geschäftige Zeit. Menschen kommen und gehen, alles ist drunter und drüber ... Fast jeder ist in festlicher Stimmung. Die Ritter sind zu sehr damit beschäftigt, alles in geordneten Bahnen zu halten, als dass sie auch noch auf etwas anderes Acht geben könnten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010208
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010208,
					"content": "Wehrlose Menschenmassen, überarbeitete Ritter ... Für die, die sich Schatzräuber nennen, ist das doch sicher eine tolle Gelegenheit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010209
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010209,
					"content": "Den Informationen dieses Herrn zufolge wurde die Stadt in ihrer Geschäftigkeit bereits von einigen Schatzräubern infiltriert. Sie befinden sich momentan bei den Geschäften und tun so, als würden sie das Fest genießen, obwohl sie in Wahrheit den Grundstein für zukünftige Machenschaften legen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010210
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010210,
					"content": "Wenn die Ritter jetzt eine großangelegte Suche beginnen würden, würde das nicht nur die Schatzräuber alarmieren, sondern auch die Atmosphäre ruinieren. Aber trotzdem können wir diese Kriminellen ja nicht einfach walten lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010211
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010211,
					"content": "Und da komme ich ins Spiel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010212
					]
				},
				{
					"id": 700010212,
					"content": "Natürlich. Dieser Herr hat in dieser Angelegenheit sogar speziell nach dir gefragt. Ihm zufolge bist du die beste Wahl für diese Arbeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010213
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010213,
					"content": "Gut, dann gehen wir die Sache mal an. Laut den Informationen, die ich gesammelt habe, tragen die infiltrierenden Schatzräuber alle <color=#00E1FFFF>eine Tasche</color>, um sich gegenseitig zu identifizieren, und sie nutzen einen <color=#00E1FFFF>Code</color>, um die Identität ihrer Kameraden zu bestätigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010214
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010214,
					"content": "<color=#00E1FFFF>Wenn der Wind die Blumen verweht, dann sollten die Umstehenden Acht geben.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010215,
						700010216
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010215,
					"content": "Ziemlich einfach zu merken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010217
					]
				},
				{
					"id": 700010217,
					"content": "Diejenigen, die diesen Code wiedergeben können, sind unsere Eindringlinge. Von ihnen solltest du den Standort ihrer Basis außerhalb der Stadt erfahren können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010218
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010218,
					"content": "Sobald du dieses Wissen hast, nutze bitte die Gelegenheit und kümmere dich um sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010219
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010219,
					"content": "Und die Ritter können dabei nicht helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010220
					]
				},
				{
					"id": 700010220,
					"content": "Aber sie sind doch jetzt schon am Ende ihrer Kräfte nur beim Versuch, die Ordnung während des Fests aufrechtzuerhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010221
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010221,
					"content": "In Zeiten wie diesen ist es die Pflicht beunruhigter Bürger ... ihnen etwas Arbeit abzunehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010222
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010222,
					"content": "Nun, wir zählen auf dich, Ehrenritter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010216,
					"content": "Klingt nach Schatzräuber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010217
					]
				}
			]
		},
		{
			"id": 7000103,
			"completionStepIds": [
				7000103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000103",
							"2"
						],
						"stepId": 7000103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verdächtiger Bürger"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010301,
					"content": "Wunderbar, hier ist so viel los!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010302
					],
					"speakerTitle": "Verdächtiger Bürger"
				},
				{
					"id": 700010302,
					"content": "Wenn der Wind die Blumen verweht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010303
					]
				},
				{
					"id": 700010303,
					"content": "Oh? Hm ... dann sollten die Umstehenden Acht geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010304
					],
					"speakerTitle": "Verdächtiger Bürger"
				},
				{
					"id": 700010304,
					"content": "Ah, du bist einer von uns. Du kommst gerade rechtzeitig! Ich habe mein Auge auf ein Paar sorglose Turteltäubchen geworfen. Wie wäre es, wenn wir uns ein paar Mora holen, hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010305
					],
					"speakerTitle": "Verdächtiger Bürger"
				},
				{
					"id": 700010305,
					"content": "Du ziehst ihre Aufmerksamkeit auf dich, ich kümmere mich um ihre Brieftasche. Danach gehen wir zurück zum Windstieg und treffen uns mit dem Rest. Wie es wohl bei ihnen läuft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010306
					],
					"speakerTitle": "Verdächtiger Bürger"
				},
				{
					"id": 700010306,
					"content": "Oh, sicher. Du wirst nur erst einen kleinen Spaziergang mit mir machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010307
					]
				},
				{
					"id": 700010307,
					"content": "Hä? Was? Du bist kein Schatzräuber! Wer bist du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010308
					],
					"speakerTitle": "Verdächtiger Bürger"
				},
				{
					"id": 700010308,
					"content": "Nur ein freundlicher Ritter aus der Nachbarschaft.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010309
					]
				},
				{
					"id": 700010309,
					"content": "Damit wäre einer in Gewahrsam der Ritter. Aber Paimon fragt sich, wie sie so schnell hierhergekommen sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700010310,
					"content": "Das ist nicht von allzu großer Bedeutung. Sie wollten sich in Windstieg treffen, richtig? Sehen wir uns das doch mal an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7000104,
			"completionStepIds": [
				7000106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
