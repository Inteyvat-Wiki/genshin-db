							"7000106",
							"2"
						],
						"stepId": 7000106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rastloser Bürger"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010401,
					"content": "Hm? Was ist los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010402
					],
					"speakerTitle": "Rastloser Bürger"
				},
				{
					"id": 700010402,
					"content": "Wenn der Wind die Blumen verweht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010403
					]
				},
				{
					"id": 700010403,
					"content": "Wind? Blumen? Meinst du Löwenzahn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010404
					],
					"speakerTitle": "Rastloser Bürger"
				},
				{
					"id": 700010404,
					"content": "Was ist damit? Ist doch ganz normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010405
					],
					"speakerTitle": "Rastloser Bürger"
				},
				{
					"id": 700010405,
					"content": "Wie auch immer, ich muss gehen. Tschüs!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700010406,
					"content": "Das scheint ein normaler Bürger gewesen zu sein. Fragen wir jemand anderen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7000105,
			"completionStepIds": [
				7000107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000107",
							"2"
						],
						"stepId": 7000107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mutloser Bürger"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010501,
					"content": "Ich frage mich, ob ich noch eine Chance habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010502
					],
					"speakerTitle": "Mutloser Bürger"
				},
				{
					"id": 700010502,
					"content": "Hm? Was gibt es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010503
					],
					"speakerTitle": "Mutloser Bürger"
				},
				{
					"id": 700010503,
					"content": "Wenn der Wind die Blumen verweht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010504
					]
				},
				{
					"id": 700010504,
					"content": "Ja, es ist wieder diese Zeit des Jahres. Ich weiß, ich weiß, ich sollte es genießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010505
					],
					"speakerTitle": "Mutloser Bürger"
				},
				{
					"id": 700010505,
					"content": "Das stimmt eigentlich. Warum sollte ich so niedergeschlagen sein, nur weil ich zurückgewiesen wurde? Das Fest ist noch nicht zu Ende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010506
					],
					"speakerTitle": "Mutloser Bürger"
				},
				{
					"id": 700010506,
					"content": "Danke für deine Worte. Ich werde mich ganz bestimmt zusammenreißen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010507
					],
					"speakerTitle": "Mutloser Bürger"
				},
				{
					"id": 700010507,
					"content": "Scheint, als hätte uns diese Person missverstanden. Aber wenigstens ist es kein Verdächtiger ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7000106,
			"completionStepIds": [
				7000111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000111",
							"2"
						],
						"stepId": 7000111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010601,
					"content": "Wie läuft die Sache mit den Schatzräubern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010602
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010602,
					"content": "Sie werden uns keine Schwierigkeiten bereiten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010603
					]
				},
				{
					"id": 700010603,
					"content": "Ah, wie vom Ehrenritter erwartet. Gut gemacht. Du hast den Schatzräuber vorhin auch toll ausgetrickst ... wie erwartet, dieser Herr hat nicht umsonst ein Auge auf dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010604
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010604,
					"content": "Entschuldige, hast du uns die ganze Zeit beobachtet?",
					"roleType": "TALK_ROLE_PLAYER",
