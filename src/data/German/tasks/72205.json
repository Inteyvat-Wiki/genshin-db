			},
			"dialogs": [
				{
					"id": 722050501,
					"content": "So sieht man sich wieder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050502
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050502,
					"content": "Hallo nochmal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050503,
						722050504
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050503,
					"content": "Hallo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				},
				{
					"id": 722050505,
					"content": "#Ja, ich bin noch hier! Weiß {NICKNAME}, wofür diese Steine sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050506
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050506,
					"content": "Hmpf, Kito weiß alles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050507,
						722050508
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050507,
					"content": "Keine Ahnung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050509,
					"content": "Großvater zufolge sind dies die Grabsteine, die die Geister der Toten anlocken sollen ... Die Geister, die nach dem Tod verloren und zurückgelassen werden, werden immer von diesen großen Steinen angezogen und erwachen hier aus ihren Träumen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050510
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050510,
					"content": "Dann wandern sie auf der Insel herum ... auf der Suche nach jemandem, der ihnen ihren Herzenswunsch erfüllen kann. Einmal gefunden, würden sie diese Person verfolgen ... bis der Wunsch in Erfüllung geht und sie von dem Mann mit dem Boot abgeholt werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050511
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050511,
					"content": "Einige von ihnen sind gute Geister, andere sind böse ... Also ja, wer nachts im Nebel spazieren geht, muss seinen Klannamen laut vor solchen Felsbrocken verkünden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050512
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050512,
					"content": "Diejenigen, die sich an ihre Vorfahren erinnern, haben immer mehr Mut als die einsamen Geister. Und wenn diese toten Geister von der Blutlinie der Lebenden erfahren, werden sie beschämt abziehen und nichts mehr verlangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050513
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050513,
					"content": "#Nun, da {NICKNAME} von außen kommt und keinen einschlägigen Klannamen hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050514
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050514,
					"content": "Was passiert dann, wenn böse Geister kommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050515
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050515,
					"content": "He, macht nichts. Habt keine Angst, ich kann euch beschützen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050516
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050516,
					"content": "Kina will auch mitmachen und die bösen Geister verscheuchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050508,
					"content": "Wofür?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050504,
					"content": "Du bist noch auf der Insel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				}
			]
		},
		{
			"id": 7220507,
