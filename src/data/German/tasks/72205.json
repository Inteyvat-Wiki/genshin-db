				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050101,
					"content": "Nun, es ist seltsam ... es war in meiner Tasche ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050102,
						722050103
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050102,
					"content": "Hallo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				},
				{
					"id": 722050104,
					"content": "Wenn du keins hast, geht es nicht ... du musst es zu Una bringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050105
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050105,
					"content": "Oma Una wird alt und kann sich an vieles nicht mehr erinnern ... und hat kürzlich begonnen, über ihre jüngeren Tage zu sprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050106
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050106,
					"content": "Sie sprach immer von „Blumen“ ... und sagte, es seien Blumen aus dem Nebel in Übersee, wunderschöne Blumen in verschiedenen Farben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050107
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050107,
					"content": "Dann hatte ich eines Tages einen Traum ... Ich träumte, dass sich der ganze Nebel auf der Insel lichtete und auf der anderen Seite des Meeres große, schöne Häuser standen ... nicht aus Holz, nicht aus Gold ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050108
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050108,
					"content": "Ich auch, ich auch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050109
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050109,
					"content": "In diesem Traum erklomm ich einen hohen Berg, kletterte auf einen großen Baum und pflückte viele schöne Blumen ... Ich hatte sie noch nie gesehen, aber ich wusste, dass es die Blumen waren, die Oma Una wollte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050110
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050110,
					"content": "Aber die Blumen waren zu viel und zu schwer, so dass ich vom Baum fiel und immer weiter fiel und weiter fiel ... und dann wachte ich aus dem Traum auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050111
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050111,
					"content": "Nicht, weil du gierig bist! Ich habe dir schon so oft gesagt, dass es genug ist, es ist genug! Und ich bin mit dir hingefallen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050112
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050112,
					"content": "Meine Taschen sind leer ... nichts ... wie kann ich so zu Una zurückkehren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050103,
					"content": "Brauchst du Hilfe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				}
			]
		},
		{
			"id": 7220503,
			"completionStepIds": [
				7220512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
