			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050301,
					"content": "#Hallo, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050302,
						722050303
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050302,
					"content": "Hallo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				},
				{
					"id": 722050304,
					"content": "Danke, dass du letztes Mal diese Blumen für mich gepflückt hast! Nur ... ich habe das Gefühl, dass etwas um mich herum nicht stimmt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050305
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050305,
					"content": "Dieses Gefühl habe ich auch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050306
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050306,
					"content": "Jedes Mal, wenn ich an einen anderen Ort gehe, treffe ich nur unglückliche Menschen ... die Leute können nicht hören, was andere sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050307
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050307,
					"content": "Und ja, jedes Mal, wenn ich eine schöne Blume sehe, pflücke ich sie und stecke sie in meine Tasche, und dann verschwindet sie ganz schnell ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050308,
						722050309
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050308,
					"content": "Das ist weil ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050310,
					"content": "Ist das so ... Ich verstehe das nicht ganz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050311
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050311,
					"content": "Ist es Zeit für den Aufbruch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050312
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050312,
					"content": "Der goldene Onkel sagte etwas Ähnliches ... aber wir können noch nicht mit ihm gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050313
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050313,
					"content": "Wir müssen Oma Una auch schöne Blumen bringen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050309,
					"content": "Es wird ... Zeit für den Aufbruch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050303,
					"content": "Du scheinst bei guter Fassung zu sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				}
			]
		},
		{
			"id": 7220505,
			"completionStepIds": [
				7220513
			],
