			"dialogs": [
				{
					"id": 726680101,
					"content": "Das ist toll. Irgendwie kann nun jeder, der den „Mond-Leviathan“ finden wollte, seine Wünsche als erfüllt ansehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680102,
					"content": "Bist du fertig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680103
					]
				},
				{
					"id": 726680103,
					"content": "Sieh an, sieh an, hat Jiawei da nicht eine ordentliche Frau gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680104,
					"content": "Und Nantuck ist durch sein Buch über den „Mond-Leviathan“ ein angesehener Schriftsteller geworden, obwohl der Inhalt nicht der Wahrheit entspricht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680105,
					"content": "Kujirai Momiji wurde zur berühmtesten Fischerin von Inazuma und schaffte, was ihr Vater nicht zu tun vermochte, nämlich den „Mond-Leviathan“ zu fangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680106,
					"content": "#Paimon hat das Gefühl, dass die Wünsche von {NICKNAME} auch wahr werden! Hihihi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680107,
					"content": "Was hat sich Paimon denn gerade gewünscht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680108
					]
				},
				{
					"id": 726680108,
					"content": "Darf Paimon nicht sagen! Darf Paimon nicht sagen! Wenn Paimon es laut sagt, dann geht es nicht in Erfüllung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680109,
					"content": "Der „Mond-Leviathan“ wird schon nicht so geizig mit den Wünschen sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680110
					]
				},
				{
					"id": 726680110,
					"content": "Hmm ... Also, hör gut zu! Paimon wird es nur einmal sagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680111,
					"content": "Paimons Wunsch ist es, dass dein Wunsch in Erfüllung geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680112,
					"content": "Ich hab dich nicht verstanden, was hast du gesagt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680113
					]
				},
				{
					"id": 726680113,
					"content": "Hmpf, Paimon wird sich nicht wiederholen! Paimon hat Lust auf Süßigkeiten. ♪ Lalala!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
