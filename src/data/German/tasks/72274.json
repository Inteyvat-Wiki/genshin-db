			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Fatui-Plänkler",
					"Rounin – Anbu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722740110,
					"content": "Sieht nicht einfach aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722740111,
					"content": "Pst, hör mal, das klingt, als würde da drüben jemand reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740101
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722740101,
					"content": "Meine Güte, dieses Weib hat bis jetzt noch kein Sterbenswörtchen gesagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740102
					],
					"speakerTitle": "Fatui-Plänkler"
				},
				{
					"id": 722740102,
					"content": "Keine Sorge, mein Herr. Überlass das mir! Ich kann sie zum Singen bringen! Ruh dich schön aus. Ich werde zum Kerker gehen und mich um sie kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740103
					],
					"speakerTitle": "Rounin – Anbu"
				},
				{
					"id": 722740103,
					"content": "Uns rennt die Zeit davon ... Der Lehrer will jetzt wissen, wie viel das Weib von unserem Plan schon herausgeschnüffelt hat. Wir müssen sie wie eine Zitrone ausquetschen. Sollten wir es nicht schaffen, sind wir mausetot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740104
					],
					"speakerTitle": "Fatui-Plänkler"
				},
				{
					"id": 722740104,
					"content": "Meine Güte, unser Herr regt sich richtig auf. Was hat die Frau überhaupt angestellt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740105
					],
					"speakerTitle": "Rounin – Anbu"
				},
				{
					"id": 722740105,
					"content": "Der Lehrer hat neulich einen Plan geschmiedet, in dem Lyudochka eine sehr wichtige Figur ist. Jetzt hat aber diese blöde Kuh Lyudochka kaltgemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740106
					],
					"speakerTitle": "Fatui-Plänkler"
				},
				{
					"id": 722740106,
					"content": "Als wir damals hineinstürmten, war das Feuer zum Glück noch nicht völlig ausgebrannt. Unser Lehrer, seinem Scharfblick erging nichts, hat sofort anhand der Kleidung die Identität von Lyudochka festgestellt. Ihm war dann glasklar, dass der Plan zu scheitern drohte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740107
					],
					"speakerTitle": "Fatui-Plänkler"
				},
				{
					"id": 722740107,
					"content": "Stark! Das frühzeitig zu erkennen, war für uns wirklich das Glück im Unglück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740108
					],
					"speakerTitle": "Rounin – Anbu"
				},
				{
					"id": 722740108,
					"content": "Aber wer weiß, wie viel diese Kuh schon über unseren Plan herausbekommen hat und ob sie unser Geheimnis den anderen vom Shuumatsuban mitgeteilt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740109
					],
					"speakerTitle": "Fatui-Plänkler"
				},
				{
					"id": 722740109,
					"content": "Es scheint, dass Fräulein Momoyo in dem Kerker da unten eingesperrt ist. Retten wir sie schnell!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7227402,
			"completionStepIds": [
				7227402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
