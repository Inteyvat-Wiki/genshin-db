				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fatui-Plänkler"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722740201,
					"content": "Ach, so ein Mist! Jemand hat unseren Plan ordentlich ausgepackt! Wir sind gerade erst in Inazuma gelandet und uns ist schon so ein Pech zugestoßen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740202
					],
					"speakerTitle": "Fatui-Plänkler"
				},
				{
					"id": 722740202,
					"content": "Ich habe aber gehört, dass unser Lehrer die Anweisung von oben bekommen hat, auf der Stelle nach Snezhnaya zurückzukehren. Und zugleich muss der Plan von Watatsumi aber trotz allem weiter fortgesetzt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740203
					],
					"speakerTitle": "Fatui-Plänkler"
				},
				{
					"id": 722740203,
					"content": "Ist der Lehrer nicht zu diktatorisch? Ich glaube nicht, dass er Arlecchino über diese Aufgabe Bericht erstattet hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740204
					],
					"speakerTitle": "Fatui-Plänkler"
				},
				{
					"id": 722740204,
					"content": "Das war wirklich nur die Idee des Lehrers. Ich habe ein schlechtes Gefühl bei der Sache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740205
					],
					"speakerTitle": "Fatui-Plänkler"
				},
				{
					"id": 722740205,
					"content": "Du meinst, wenn wir es nicht schaffen, wird der Lehrer uns die Schuld geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fatui-Plänkler"
				}
			]
		}
	]
}