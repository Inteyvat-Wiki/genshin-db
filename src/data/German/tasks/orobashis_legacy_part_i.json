				"objectNames": [
					"Kaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721290401,
					"content": "Nicht schlecht, Fremde! Die Wolken sind fast weg. Es scheint, als ob meine Vermutung richtig ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290402
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290402,
					"content": "Als Nächstes müssen die beiden Omamori vom Schlangenkopf und der Jakotsu-Mine noch repariert werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290403
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290403,
					"content": "Wenn es dich nicht stört, kümmere du dich bitte um die beiden Omamori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290404
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290404,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290405
					]
				},
				{
					"id": 721290405,
					"content": "Ich danke dir sehr für deine Hilfe. Obwohl ich keineswegs ein reicher Mann bin, verspreche ich, dass ich dich nicht schlecht entlohnen werde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290406
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290406,
					"content": "Ich weiß immer noch nicht, wann Hoffnung kommen wird. Aber der Tag, an dem Familie und Freunde nach Hause kommen, rückt wieder einen Tag näher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290407
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290407,
					"content": "Übrigens, du kannst mich auf der Westseite der Insel finden, wenn du fertig bist. Die Mumei-Festung wurde zuvor von Rebellen angegriffen und ich vermute, dass der Angriff mit diesen Veränderungen zusammenhängt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				}
			]
		},
