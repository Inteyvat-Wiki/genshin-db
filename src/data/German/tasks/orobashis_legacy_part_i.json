					"content": "Es scheint, dass den Omamori zwei kritische Komponenten fehlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290502
					],
					"speakerTitle": "Platzieren"
				},
				{
					"id": 721290502,
					"content": "(Ist es das?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7212906,
