				"points": []
			},
			"dialogs": [
				{
					"id": 721290201,
					"content": "Du beobachtest das Omamori. Plötzlich strömt dir eine seltsame Energie entgegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290202
					],
					"speakerTitle": "Omamori berühren"
				},
				{
					"id": 721290202,
					"content": "Du erkennst, dass es sich nicht gegen dich wehrt, sondern dich um etwas bittet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290203
					],
					"speakerTitle": "Omamori berühren"
				},
				{
					"id": 721290203,
					"content": "Dem Omamori scheint etwas zu fehlen. Suchen wir in der Nähe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290204,
					"content": "Untersuche die verteilten Spuren von Elementen in der Nähe mit dem Elementarblick. Vielleicht wirst du ja etwas finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
