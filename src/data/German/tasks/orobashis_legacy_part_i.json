			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721290101,
					"content": "Die seltsam geformte Steinlaterne scheint eine unheilvolle Energie auszustrahlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290102
					],
					"speakerTitle": "Betrachten"
				},
				{
					"id": 721290102,
					"content": "Diese Steinlaterne ist so seltsam ... Es ist so unheimlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290103,
					"content": "Oh, was steht denn da auf der Lampensäule?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290104,
					"content": "„Reisende auf der Durchreise: Wenn du Fragen zu Omamori hast, geh bitte in die Musoujin-Schlucht und sprich mit Herrn Kaji darüber.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290105
					],
					"speakerTitle": "Betrachten"
				},
				{
					"id": 721290105,
					"content": "Die Handschrift sieht sehr neu aus. Sie scheint erst kürzlich geschrieben worden zu sein. Es gibt einige Zeilen kleinerer Handschrift darunter, die vom Regen ausgewaschen wurden:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290106
					],
					"speakerTitle": "Betrachten"
				},
				{
					"id": 721290106,
					"content": "„ ... Bitte übermittle Herrn Kaji, wir haben es versucht ... Aber leider ... Vielleicht kann er es irgendwo in der Nähe finden ... “",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290107
					],
					"speakerTitle": "Betrachten"
				},
				{
					"id": 721290107,
					"content": "„ ... Bitte sag Herrn Kaji, dass er so schnell wie möglich in die Zuflucht kommen soll. Er wird von seiner Familie schmerzlich vermisst.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290108
					],
					"speakerTitle": "Betrachten"
				},
				{
					"id": 721290108,
					"content": "Herr Kaji scheint ziemlich besorgt über die Steinlaternen zu sein. Warum gehen wir nicht zur Musoujin-Schlucht und fragen ihn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7212902,
			"completionStepIds": [
				7212905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
