			},
			"dialogs": [
				{
					"id": 721290601,
					"content": "Was? Hast du das Omamori schon fertig repariert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290602,
						721290603
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290602,
					"content": "Noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290604
					]
				},
				{
					"id": 721290604,
					"content": "Schon gut. Keine Eile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290603,
					"content": "Ich arbeite noch dran.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290605
					]
				},
				{
					"id": 721290605,
					"content": "Es ist in Ordnung, wenn du es nicht reparieren kannst. Halte dich nicht zu lange an diesem gefährlichen Ort auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				}
			]
		}
