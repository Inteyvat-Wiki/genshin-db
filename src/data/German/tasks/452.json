			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4520201,
					"content": "Oh, dort vorn gibt’s Krawall!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520202
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520202,
					"content": "Das sind aber keine Wölfe, sondern Hilichurle, die die Waren plündern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520203,
					"content": "Oh, das kommt auch gar nicht so selten vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520204
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520204,
					"content": "Aber gut jetzt. Wir sollten lieber helfen gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
		{
			"id": 45203,
			"completionStepIds": [
				45205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45205",
							"2"
						],
						"stepId": 45205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Siegfria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4520301,
					"content": "Danke! Ich danke euch so sehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520302
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520302,
					"content": "War doch gar nichts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520303,
					"content": "Die Hilichurle haben in letzter Zeit immer öfter versucht, die die Autorität der Wölfe für sich zu nutzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520304
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520304,
					"content": "Das stimmt. Aber ich muss sagen, wenn du denkst, dass die Hilichurle ein fieser Haufen sind, dann wirst du die Wölfe noch schlimmer finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520305
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520305,
					"content": "Erst heute Vormittag haben sie Quellingen angegriffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520306
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520306,
					"content": "Was? Sie haben Quellingen angegriffen? Das fass ich nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520307
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520307,
					"content": "Doch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520308
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520308,
					"content": "Nachdem die Wölfe endlich verschwunden waren, dachte ich, dass ich mich endlich auf den Weg machen könnte. Und genau dann kamen die Hilichurle ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520309
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520309,
					"content": "Dann sollten wir uns schleunigst den Tatort ansehen, um eventuell vorhandene Spuren zu sichern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520310
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520310,
					"content": "Aber als erstes solltest du nachsehen, was es für Verluste gab und ob der Wagen noch funktioniert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520311
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520311,
					"content": "Ja, gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Siegfria"
				}
			]
		},
