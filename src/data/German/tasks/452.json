					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4520101,
					"content": "#Ah, Paimon und {NICKNAME}! Was macht ihr denn hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520102,
					"content": "Hallo, Amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520103,
						4520124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520103,
					"content": "Amber, wir würden gern mit dir über etwas sprechen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520104
					]
				},
				{
					"id": 4520104,
					"content": "Kennst du den Jungen von Wolfenlauf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520105,
					"content": "Hä?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520106,
					"content": "Da ist ein Junge, der sagt, dass er dich kennt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520107,
					"content": "Wovon sprichst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520108,
					"content": "Komisch ... Er hat gesagt, er wartet an eurem Treffpunkt auf dich. Hast du ihn etwa vergessen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520109,
					"content": "Ich glaube eher, dass du wieder zu viele lustige Pilze gegessen hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520110,
					"content": "Ich weiß überhaupt nicht, wovon ihr da redet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520111,
					"content": "Öh ... welche Farbe haben denn die Pilze, die man nicht essen sollte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520112,
					"content": "Lila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520113,
					"content": "Vor ein paar Tagen habe ich vielleicht welche gegessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520114,
					"content": "Aber darum geht es hier doch gar nicht! Ich bin im Vollbesitz meiner geistigen Kräfte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520115,
					"content": "Kennst du den Jungen, der mit den Wölfen zusammen im Wald lebt, denn wirklich nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520116,
					"content": "Wenn ich nur wüsste, was ihr da erzählt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520117
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520117,
					"content": "Aber da ihr gerade von Wölfen sprecht ... Ich bin da einer Sache auf der Spur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520118
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520118,
					"content": "Die Wölfe, die sonst nur in Wolfenlauf unterwegs waren, sind nun auch woanders angetroffen worden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520119
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520119,
					"content": "Sie sollen eine Karawane bei der „Säuferschlucht“ angegriffen haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520120,
					"content": "Wenn ihr Zeit hättet, könntet ihr doch nachsehen, was an der Sache dran ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520121,
						4520122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520121,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520123
					]
				},
				{
					"id": 4520123,
					"content": "Super! Auf euch kann man sich verlassen. Dann gehen wir gemeinsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520122,
					"content": "Wir werden uns sofort um diese Sache kümmern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520123
					]
				},
				{
					"id": 4520124,
					"content": "Hallo, wie geht’s?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520125
					]
				},
				{
					"id": 4520125,
					"content": "Ah, du siehst aus, als hättest du gerade nicht viel zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520126,
					"content": "Also eigentlich grüßt man zurück, wenn man ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520127,
					"content": "Ich bin in letzter Zeit etwas durcheinander. Die Pflichten eines Kundschafters enden nie, also ... Willst du helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520129,
					"content": "Hab ich’s doch gewusst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520130,
						4520131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520130,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520132
					]
				},
				{
					"id": 4520132,
					"content": "Vor Kurzem hat ein Rudel Wölfe eine Karawane in der „Säuferschlucht“ angegriffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520133
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520133,
					"content": "Ich bin mir nicht sicher, ob du weißt, dass Wölfe zwar gefährlich sind, aber dennoch ihren Prinzipien folgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520134
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520134,
					"content": "Die Wölfe von Mondstadt verlassen selten das Glanzkrongebirge und Wolfenlauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520135
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520135,
					"content": "Ja, Paimon hat gehört, dass das Gebiet noch sehr ursprünglich ist, es dort aber auch gewisse Regeln gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520136,
					"content": "Das stimmt. Es ist also ungewöhnlich, dass Wölfe in der Säuferschlucht auftauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520137
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520137,
					"content": "Da wir gerade von Wölfen sprechen: Hast du von dem Jungen in Wolfenlauf gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520138,
					"content": "Nein. Von so einem Jungen nahe Mondstadt habe ich nicht gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520139
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520139,
					"content": "Ach so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520140,
					"content": "„Rot und heiß“, war damit nicht Amber gemeint?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520141,
					"content": "Wovon sprichst du da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520142
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520142,
					"content": "Na, jedenfalls werde ich mich gleich auf den Weg zur Säuferschlucht machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520143
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520143,
					"content": "Ihr könnt doch gleich mitkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520131,
					"content": "Worum geht es denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520132
					]
				}
			]
		},
		{
			"id": 45202,
			"completionStepIds": [
				45203
