				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„La Signora“",
					"Paimon",
					"Shougun Raiden"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20190101,
					"content": "Einbrüche, einer nach dem anderen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190102
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190102,
					"content": "Wenn ich nicht gewusst hätte, dass dies der Tenshukaku ist, hätte ich gedacht, dass es eine Art Straßenfest oder so etwas ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190103
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190103,
					"content": "Jetzt müsste ein wenig Ruhe eingekehrt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190104
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190104,
					"content": "Ah! Sara wurde von La Signora ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20190105,
					"content": "Es ist an mir, die Menschen von Inazuma für ihre Fehler zu bestrafen. Du bist nicht dazu berechtigt, La Signora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190106
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20190106,
					"content": "Das tut mir leid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190107
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190107,
					"content": "La Signora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190108
					]
				},
				{
					"id": 20190108,
					"content": "Na gut, ich weiß, du kannst mich nicht vergessen. Kein Grund, meinen Namen ständig auf den Lippen zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190109
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190109,
					"content": "#Ich weiß auch, dass du einen Groll gegen mich hegst ... {F#Reisende}{M#Reisender}, es überrascht mich nicht, dich hier zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190110,
						20190111
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190110,
					"content": "Du verbreitest im Geheimen Teuflische Augen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				},
				{
					"id": 20190112,
					"content": "Ah, du bist also gekommen, um meine Verbrechen vor dem Shougun zu entlarven?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190113
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190113,
					"content": "Ich bin nur ein diplomatischer Abgesandter aus Snezhnaya, also weiß ich nicht, wovon du redest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190114
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190114,
					"content": "Sie nimmt uns nicht ernst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190115,
						20190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20190115,
					"content": "Für die Menschen, die ihr Göttliches Auge verloren haben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190117,
					"content": "Hör auf, über Leute und Dinge zu reden, die mich gar nicht interessieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190118
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190118,
					"content": "Kleine Figuren, deren Namen man sich nicht merken wird, werden zu Trittsteinen in dieser Revolution, um die „Ewigkeit“ zu erreichen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190119
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190119,
					"content": "Wäre es nicht schon ein großes Privileg für ihr kurzes Leben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190120
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190120,
					"content": "Hab ich recht, Shougun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190121
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190121,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190122,
						20190123
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20190122,
					"content": "Auch das Göttliche Herz von Venti ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190124,
					"content": "Du bist wirklich nachtragend, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190125
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190125,
					"content": "Das Ideal Ihrer Majestät ist das Edelste und Reinste, was es auf dieser Welt gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190126
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190126,
					"content": "Im Vergleich dazu sind das, was du sagtest ... nur „notwendige Opfer“, die keine Rolle spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190127
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190127,
					"content": "Nun, es wird Zeit für die Abrechnung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190128
					]
				},
				{
					"id": 20190128,
					"content": "Abrechnung? Hahahaha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190129
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190129,
					"content": "Ich bin auch ein wenig müde von diesem Gesicht von dir. Aber ich habe nicht erwartet, dass du so mutig bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190130
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190130,
					"content": "Bevor du etwas sagst, was du nicht zurücknehmen kannst, denke daran, dass du Inazumas meistgesuchter Verbrecher bist ... Ich schlage vor, du überlegst dir deine Umstände sehr genau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190131
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190131,
					"content": "Ist es Selbstmord, wenn man in den Tenshukaku eindringt und große Töne spuckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190132
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190132,
					"content": "Ich hoffe, du erkennst den Unterschied zwischen dir und mir, sei es im Status ... oder in der Stärke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190133
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190133,
					"content": "Ich werde ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190134
					]
				},
				{
					"id": 20190134,
					"content": "... dich zum „Duell vor dem Thron“ herausfordern!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190135
					]
				},
				{
					"id": 20190135,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190136
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190136,
					"content": "Gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190137
					],
					"speakerTitle": "Shougun Raiden"
				},
				{
					"id": 20190137,
					"content": "Ich kann es nicht glauben ... Hast du auch gelernt, die „Regeln“ dieses Reichs zu benutzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190138
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190138,
					"content": "Ich gebe zu, dass ich nie erwartet hätte, in die Situation zu geraten, in der wir uns beide auf gleicher Augenhöhe bekämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190139
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190139,
					"content": "Aber der Verlierer ... wird sterben, richtig? Hast du das durchdacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190140
					],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190140,
					"content": "#{NICKNAME} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20190141,
					"content": "Ooooh ... Dann lass mich mit dir bis zum Ende deines Lebens tanzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„La Signora“"
				},
				{
					"id": 20190123,
					"content": "Und für die Menschen in Liyue, die du in Gefahr gebracht hast ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190116,
					"content": "Um der Kameraden willen, die von Teuflischen Augen geplagt wurden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190111,
					"content": "Du versuchst, die Kontrolle über Inazuma zu übernehmen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				}
			]
		}
	]
}