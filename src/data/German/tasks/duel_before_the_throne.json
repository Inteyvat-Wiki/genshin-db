		{
			"id": 201901,
			"completionStepIds": [
				201901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201901",
							"2"
						],
						"stepId": 201901,
						"stateName": "QUEST_STATE_UNFINISHED"
