			"dialogs": [
				{
					"id": 752390101,
					"content": "Dieser Zhaka ... Der hat seine Arbeit nicht fertig gemacht und sich einfach aus dem Staub gemacht ... und wo die Puppen jetzt sind, weiß auch keiner! Ich schwör’s dir, den zeige ich an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390102
					],
					"speakerTitle": "Kanei"
				},
				{
					"id": 752390102,
					"content": "Was für Puppen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752390103
					]
				},
				{
					"id": 752390103,
					"content": "Es sind kleine Puppen in Form von Koholasauriern. Ich war gerade dabei, sie zu bemalen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390104
					],
					"speakerTitle": "Kanei"
				},
				{
					"id": 752390104,
					"content": "Aber mein Lehrling Zhaka hat sich schon ewig nicht mehr blicken lassen – drei von ihm sind noch halbfertig und ich habe keine Ahnung, wo er sie hingepackt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390105
					],
					"speakerTitle": "Kanei"
				},
				{
					"id": 752390105,
					"content": "Könntest du mir vielleicht helfen, die zu suchen? Sie müssten hier irgendwo in der Nähe rumliegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kanei"
				}
			]
		},
