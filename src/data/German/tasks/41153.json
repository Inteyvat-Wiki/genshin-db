			"dialogs": [
				{
					"id": 411530301,
					"content": "Ich habe gehört, es gibt eine Sonderbestellung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411530302
					]
				},
				{
					"id": 411530302,
					"content": "Dieser Tingfang hat gekochten Schwarzrückenbarsch bestellt. Er sollte zum Qingce-Dorf unterwegs sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411530303
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 411530303,
					"content": "Bei diesem gekochten Schwarzrückenbarsch ist die Suppe eine wesentliche Zutat. Du darfst also <color=#00E1FFFF>weder fliegen noch klettern,</color> sonst verschüttest du sie. Du solltest dich mit der Lieferung außerdem beeilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411530304
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 411530304,
					"content": "Falls dir unterwegs ein Malheur passiert, komm zu mir zurück. Dann gebe ich dir eine weitere Portion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lächelnder Yanxiao"
				}
			]
		},
