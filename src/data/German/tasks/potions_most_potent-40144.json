			},
			"dialogs": [
				{
					"id": 401440401,
					"content": "Oh, es scheint alles gut zu laufen. Du hast bereits deine erste Ladung Tränke verkauft. Gar kein schlechter Start.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440402
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440402,
					"content": "Welche Tränke du als Nächstes brauen solltest, müssen wir anhand der Nachrichten vom Markt entscheiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440403
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440403,
					"content": "Das bedeutet, dass man sich über die neusten Nachrichten und Trends auf dem Laufenden halten muss, um die Bedürfnisse der Menschen zu erfahren. Das ist eine wichtige Fähigkeit im Geschäftsleben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440404
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440404,
					"content": "Äh, das klingt irgendwie anstrengend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440405,
					"content": "Hehe ... Keine Sorge. Ich habe es bereits auf mich genommen, alle Neuigkeiten auf dem Markt für dich zusammenzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440406
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440406,
					"content": "Was meint ihr dazu? Habt ihr eine Idee, welche Art von Tränken ihr als Nächstes verkaufen solltet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440407
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440407,
					"content": "Versucht doch einmal, ein paar Kräuter anzubauen. Durch die bio-alchimistische Verarbeitung können den Kräutern verschiedene Wirkungen und Eigenschaften verliehen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440408
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440408,
					"content": "Die Verwendung verschiedener Kräuter beim Brauen verändert wiederum die Wirkung eines Tranks. Es gibt eine ganze Reihe von Kombinationen, die man ausprobieren kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440409
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440409,
					"content": "#Also, mein{F#e} Süße{M#r}, warum fängst du nicht an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
