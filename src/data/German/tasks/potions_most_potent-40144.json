			"dialogs": [
				{
					"id": 401440601,
					"content": "Es scheint, als hättest du den Dreh mit dem Anbau raus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440602
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440602,
					"content": "Ah, ich sollte wohl erwähnen, dass eine Ritterin der Logistiktruppe eingetroffen ist. Sie wird sich in Zukunft um die Beschaffung aller Vorräte kümmern. Du solltest dich gleich mit ihr unterhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440603
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440603,
					"content": "Und danach ist es an dir, zu glänzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440604
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440604,
					"content": "Wartet, was ist mit Euch?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440605
					]
				},
				{
					"id": 401440605,
					"content": "Ja! Sollten wir nicht alle glänzen? Du weißt schon, wir alle drei? Was ist mit Eurer Rolle bei all dem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440606,
					"content": "Meine Rolle? Natürlich war es meine Aufgabe, dafür zu sorgen, dass meine Süßen über alle geschäftlichen und alchimistischen Kenntnisse verfügen, die sie für ihren Erfolg benötigen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440607
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440607,
					"content": "Also gut, ich drücke euch die Daumen! Viel Glück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440608
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440608,
					"content": "Paimon wusste, dass das geschehen würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
