			},
			"dialogs": [
				{
					"id": 401440701,
					"content": "#Sei gegrüßt, Ehrenritter{F#in}! Sei gegrüßt, Paimon! Mein Name ist Freda. Ich bin eine Ritterin der Logistiktruppe. Es ist mir eine große Ehre, {F#die}{M#den} berühmte{M#n} {NICKNAME} und {F#ihre}{M#seine} treue Dienerin kennenzulernen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440702
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440702,
					"content": "#Wah, Paimons Ruhm verbreitet sich wirklich im ganzen Land, hehe! Eine kleine Korrektur allerdings. Paimon ist {F#ihre}{M#seine} Gefährtin, nicht {F#ihre}{M#seine} Dienerin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440703,
					"content": "Ah, ich bitte um Entschuldigung. Ich schätze, ich habe mich ein wenig mitreißen lassen, nachdem ich von euren Heldentaten gehört habe. Das ist ja wie aus einem Roman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440704
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440704,
					"content": "Ihr seid jetzt schon fast Legenden. Ich bin ein bisschen neidisch, ehrlich gesagt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440705
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440705,
					"content": "Ich würde gern wie einer dieser Ritter, von denen man in Geschichten liest, auf der Suche nach Abenteuern durch das Land ziehen! Das scheint ein wirklich aufregendes Leben zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440706,
						401440708
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440706,
					"content": "Vielleicht hast du eines Tages die Gelegenheit dazu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440707
					]
				},
				{
					"id": 401440707,
					"content": "Ja! Das hoffe ich zumindest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440710
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440710,
					"content": "Wie auch immer, wir müssen ein paar Vorbereitungen treffen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440711
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440711,
					"content": "Ich habe vom Stellvertretenden Großmeister den Auftrag erhalten, euer Unternehmen in jeder erdenklichen Weise zu unterstützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440712
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440712,
					"content": "Wenn ihr etwas braucht, lasst es mich einfach wissen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440713,
						401440715
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440713,
					"content": "Vorräte kaufen",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440714
					]
				},
				{
					"id": 401440714,
					"content": "Dann habt ihr Glück! Ich habe gerade eine neue Ladung an Vorräten bekommen! Schaut doch mal rein, ob euch etwas ins Auge fällt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440715,
					"content": "Tschüs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440716
					]
				},
				{
					"id": 401440716,
					"content": "Viel Erfolg bei eurem Unternehmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440708,
					"content": "Es geht nicht nur um Spaß und Aufregung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440709
					]
				},
				{
					"id": 401440709,
					"content": "Darauf wette ich. Die Ritter in den Geschichten geraten immer in alle möglichen Gefahren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440710
					],
					"speakerTitle": "Freda"
				}
			]
		},
