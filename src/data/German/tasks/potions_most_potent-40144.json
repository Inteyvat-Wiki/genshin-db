					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2515.331,
							202.81,
							-1136.838
						],
						"pointId": 300300740
					},
					{
						"sceneId": 3,
						"position": [
							2519.699,
							203.425,
							-1138.427
						],
						"pointId": 300300752
					},
					{
						"sceneId": 3,
						"position": [
							2518.407,
							203.41,
							-1139.256
						],
						"pointId": 300300753
					}
				]
			},
			"dialogs": [
				{
					"id": 401440201,
					"content": "Das hier ist der Laden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440202
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440202,
					"content": "Wah! Sieht aus, als hättet Ihr schon eine Menge Vorbereitungen getroffen! Habt Ihr das alles selbst gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440203,
					"content": "Das war eine Gruppenleistung. Ein ganzer Haufen von Rittern hat mitgeholfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440204
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440204,
					"content": "Jean besorgte das Startkapital für die Eröffnung des Ladens. Albedo und Saccharose lieferten die Zutaten und die Ausrüstung, die zum Brauen der Tränke benötigt wurden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440205
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440205,
					"content": "Und die Logistiktruppe kümmert sich um die Bereitstellung aller künftigen Lieferungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440206
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440206,
					"content": "Jetzt mit eurer Hilfe ist es, als wäre mir eine zusätzliche Last von den Schultern genommen worden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440207
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440207,
					"content": "Die Ritter haben in den letzten Tagen fleißig Werbung für unseren Laden gemacht. Sobald wir die letzten Vorbereitungen abgeschlossen haben, sollten wir also bereit sein, zu eröffnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440208
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440208,
					"content": "Na gut, dann wollen wir mal die Leute nicht warten lassen. Warum nimmst du nicht diese Zutaten und versuchst dich am Brauen eines Tranks?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
