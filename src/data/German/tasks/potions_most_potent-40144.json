							-19.315,
							0,
							14.928
						],
						"pointId": 238
					}
				]
			},
			"dialogs": [
				{
					"id": 401440101,
					"content": "#Oh, du bist es, {F#meine Süße}{M#mein Süßer}! Was verschafft mir die Ehre deines Besuchs?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440102,
					"content": "Bist du hier, um dich in der Bibliothek umzusehen oder um eine gewisse Person zu besuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440103,
						401440105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440103,
					"content": "Wir sind natürlich hier, um Euch zu besuchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440104
					]
				},
				{
					"id": 401440104,
					"content": "Hehe, so rücksichtsvoll wie immer, wie lieb.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440107,
					"content": "So ein Pech aber auch! Du hast mich doch tatsächlich mitten in einer wichtigen Arbeit erwischt. Ich werde dich ein anderes Mal zum Tee einladen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440108,
					"content": "Warte, Ihr seid wirklich beschäftigt ... mit richtiger Arbeit? So etwas sieht man nicht jeden Tag.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440109,
					"content": "Haha, du hast recht. Das letzte Mal, dass ich so sehr in die Forschung vertieft war, muss an der Akademie gewesen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440110,
					"content": "Ich habe schon lange nicht mehr so viel nachgedacht. Das ist ziemlich anstrengend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440111,
						401440112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440111,
					"content": "Schreibt Ihr gerade etwa an einer Abhandlung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440113,
					"content": "Hehe, wenn du so daran interessiert bist, warum machst du dann nicht einfach mit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440114
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440114,
					"content": "Was denkst du? Willst du mir helfen, meine Zeit als Studentin wieder zu erleben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440115,
					"content": "Es ist unhöflich, seine Arbeit von anderen machen zu lassen, wisst Ihr?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440116,
					"content": "#Ist das also ein Nein, {NICKNAME}? Es wäre eine ziemlich seltene Gelegenheit zur Zusammenarbeit ... Und du würdest natürlich großzügig entlohnt werden. Aber wenn du nicht willst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440117,
						401440118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440117,
					"content": "Ich bin ganz Ohr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440119,
					"content": "Wie du wahrscheinlich weißt, forscht der Ritterorden seit Langem auf dem Gebiet der Alchimie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440120,
					"content": "Die meisten dieser Forschungen wurden jedoch in einem Labor durchgeführt. Das Wissen der Öffentlichkeit über Alchimie ist ziemlich gering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440121
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440121,
					"content": "Das bedeutet, dass bis jetzt die meisten unserer Forschungen und Entdeckungen ziemlich weit weg vom täglichen Leben der Menschen geblieben sind. Wir haben viele Mora in die Forschung gesteckt, können aber nur wenig vorweisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440122
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440122,
					"content": "Als Jean diese Diskrepanz feststellte, beschloss sie, eine Initiative zu starten, bei der wir die Früchte unserer Arbeit mit den Menschen teilen würden. Im Moment bedeutet das, dass wir ihnen verschiedene Arten von alchimistischen Tränken vorstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440123
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440123,
					"content": "Zufälligerweise habe ich bereits einige Erfahrung mit dieser Arbeit. Auch wenn ich normalerweise in der Bibliothek arbeite, habe ich in der Vergangenheit bei der Verwaltung der Trankvorräte des Ritterordens geholfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440124
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440124,
					"content": "Das Tränkebrauen war damals auch eine meiner gewählten Fachrichtungen, sodass Jean dachte, ich sei die beste Person für diese Aufgabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440125
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440125,
					"content": "Aber um Tränke herzustellen, die praktisch genug sind, um den täglichen Bedarf der Menschen zu decken, mussten viele Anpassungen an den von uns verwendeten Zutaten vorgenommen werden, und auch der gesamte alchimistische Vorgang musste vereinfacht werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440126
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440126,
					"content": "Alles in allem entwickelte sich das, was als relativ einfaches Forschungsprojekt begann, bald zu etwas äußerst Kompliziertem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440127,
					"content": "Bittet Ihr uns also, Euch bei Euren Nachforschungen zu helfen? Denn Ihr, na ja, sprecht nicht gerade mit zwei Alchimie-Experten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440128,
					"content": "Hehe, keine Sorge. Ich habe bereits an die perfekte Aufgabe für euch beide gedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440129
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440129,
					"content": "Die alchimistischen Praktiken werden immer fortschrittlicher, aber es gibt immer noch eine Kluft zwischen unserer Forschung und der breiten Öffentlichkeit. Was wir wirklich brauchen, ist die Meinung der Menschen. Sonst werden wir nicht wirklich wissen, ob wir ihre Bedürfnisse befriedigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440130
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440130,
					"content": "Wenn wir aber Forschung betreiben und gleichzeitig die Meinung der Leute einholen wollen, müssen wir die Dinge effizienter angehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440131
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440131,
					"content": "Also dachte ich mir, dass es am besten wäre, einen Trankladen zu eröffnen! Auf diese Weise könnten wir uns weiterhin um die Alchimie kümmern und wären gleichzeitig in der Lage, mit der Öffentlichkeit in Kontakt zu treten und ihre Bedürfnisse zu verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440132
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440132,
					"content": "Oh! Damit könnte man zwei Fliegen mit einer Klappe schlagen! Kluge Idee, Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440133,
					"content": "#Und wer wäre besser geeignet, diese Aufgabe zu übernehmen, als die Elite in unseren Reihen ... {NICKNAME}, natürlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440134
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440134,
					"content": "Als ich an der Akademie war, haben sich die Studenten oft gegenseitig bei ihren Forschungsprojekten geholfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440135
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440135,
					"content": "Ich bin sicher, dass meine Süßen die Gelegenheit, diese Art von jugendlichem Enthusiasmus selbst zu erleben, nicht verpassen möchten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440136
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440136,
					"content": "Das hört sich ja alles ganz nett an, aber Paimon glaubt immer noch, dass Ihr Eure Arbeit nur nicht selber machen wollt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440137,
						401440139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440137,
					"content": "Wir können es einfach als einen Gefallen für Lisa betrachten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440138
					]
				},
				{
					"id": 401440138,
					"content": "Hehe, ich wusste, dass ich auf dich zählen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440141,
					"content": "Wenn unsere Arbeit getan ist, werde ich persönlich dafür sorgen, dass du großzügig entlohnt wirst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440142
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440142,
					"content": "Die ersten Vorbereitungen sind getroffen, gehen wir also in den Laden. Wir werden unser Gespräch fortführen, wenn wir dort sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440139,
					"content": "Ich bin immer für eine kleine Herausforderung zu haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440140
					]
				},
				{
					"id": 401440140,
					"content": "Ha! Ich mag deinen Enthusiasmus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440118,
					"content": "Worum geht es denn genau?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440112,
					"content": "Arbeitet Ihr gerade etwa an einem Forschungsprojekt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440105,
					"content": "Wir kamen nur zufällig vorbei ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440106
					]
				},
				{
					"id": 401440106,
					"content": "Und du hast beschlossen, auf dem Weg zu deinem Ziel für eine kleine Unterhaltung vorbeizuschauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "Lisa"
				}
			]
		},
		{
			"id": 4014402,
			"completionStepIds": [
				4014402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
