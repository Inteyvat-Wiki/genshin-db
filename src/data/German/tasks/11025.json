				"points": []
			},
			"dialogs": [
				{
					"id": 110240301,
					"content": "Ich werde eine Weile hierbleiben. Ich fürchte, dass die Momente, in denen wir in Erinnerungen schwelgen, seltener und seltener werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240302,
						110240305,
						110240308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240302,
					"content": "Die Göttin des Salzes tut mir ein wenig leid ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240303
					]
				},
				{
					"id": 110240303,
					"content": "Wir haben in den Zeiten des Archontenkriegs richtig und falsch nicht auf die gleiche Art bewertet wie heute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240304,
					"content": "Natürlich, so wie ich jetzt bin ... wünsche ich mir nur, dass sie in einer etwas freundlicheren Zeit gelebt hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240305,
					"content": "Werden diese Reliquien nicht die Macht von Osial wachsen lassen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240306
					]
				},
				{
					"id": 110240306,
					"content": "Obwohl der Salzkelch und -krug ihre eigene Macht haben, sind sie nichts vor Osial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240307
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240307,
					"content": "Obwohl ein Tag kommt, an dem er seine Kraft zurückerlangen und zurückkehren sollte ... Ha, ich glaube, dass er selbst dann wieder besiegt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240308,
					"content": "Was werdet Ihr nun tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240309
					]
				},
				{
					"id": 110240309,
					"content": "Das ist eine gute Frage. In der Vergangenheit hätte ich dir eine sehr spezifische Antwort gegeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240310
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240310,
					"content": "Aber jetzt ... Ich denke, ich werde meine Funktion als Berater des Bestattungsunternehmens Wangsheng weiterführen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240311,
					"content": "Aber falls dir diese Reise gefallen hat, warum kommst du das nächste Mal nicht mit, wenn ich versuche die Erinnerungen von Liyues Vergangenheit zu bewahren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		}
	]
}