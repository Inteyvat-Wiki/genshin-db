			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flins"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1547.264,
							258.616,
							9323.938
						],
						"pointId": 11761
					},
					{
						"sceneId": 3,
						"position": [
							1547.072,
							258.854,
							9322.94
						],
						"pointId": 13087
					},
					{
						"sceneId": 3,
						"position": [
							1547.907,
							258.402,
							9321.152
						],
						"pointId": 13088
					}
				]
			},
			"dialogs": [
				{
					"id": 60110201,
					"content": "Dieser Herr war wie ein Leuchtturm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110202,
					"content": "Hier lebte er, als wäre es eine Selbstverständlichkeit, und brachte Licht in das Leben seiner Mitmenschen, indem er ihnen Gnade erwies. Aber die Leute, die sich einmal an das Licht gewöhnt hatten, begannen, die Laterne zu ignorieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110203,
					"content": "Langsam, nach und nach, begann er auch so zu denken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110204,
					"content": "„Meine Taten sind keine große Sache. Ich habe keine gute Arbeit geleistet. Ich muss geduldig sein. Ich muss weiter warten ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110205,
					"content": "Vielleicht ist dieses Ende tragisch, aber ich bin weiterhin stolz darauf, wie er anderen den Weg gewiesen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110206
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110206,
					"content": "Jeder Schatten, der aus Licht entsteht, wird sich daran erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110207
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110207,
					"content": "Wie schade ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110208,
					"content": "Ich habe einmal die Geschichte einer Laternenfee gehört.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110209
					]
				},
				{
					"id": 60110209,
					"content": "Heh, davon habe ich auch schon gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110210,
						60110211
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110210,
					"content": "Und ich möchte ihm dasselbe sagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				},
				{
					"id": 60110212,
					"content": "Ist das so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110213
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110213,
					"content": "Na ja, du hast recht. Es mag so aussehen, als wären unsere Bemühungen umsonst gewesen, als hätte Rerir seine Ziele erreicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110214
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110214,
					"content": "Aber wir werden ihn bis zum Schluss verfolgen, auch wenn das Ergebnis nicht das ist, was wir uns wünschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110215
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110215,
					"content": "Es ist nicht unähnlich der Rolle eines Friedhofswächters ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110216
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110216,
					"content": "Wir versuchen nicht, die Toten wieder zum Leben zu erwecken, sondern ihnen Frieden zu gewähren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110217
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110217,
					"content": "Freut mich, dass du so denkst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110218
					]
				},
				{
					"id": 60110218,
					"content": "Ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110219
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110219,
					"content": "Was ... Was redet ihr beiden da? Könnt ihr Paimon das erklären?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110220,
					"content": "Nicht jetzt, Paimon. Ich erzähle es dir, wenn wir zurück sind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110221
					]
				},
				{
					"id": 60110221,
					"content": "Na gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110222,
					"content": "So oder so, die Laternenfee spielt bei diesen Beerdigungsriten nicht die Hauptrolle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110223
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110223,
					"content": "„Lichtträger, du hast mit deinem Blut den Weg zu Ruhm und Gerechtigkeit geebnet.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110224
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110224,
					"content": "„Auch wenn wir uns beeilen, auch wenn wir viele Wunden davontragen sollten, bleibe eine Weile und blicke zurück auf Liebe und Hass.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110225
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110225,
					"content": "„Bis die Welt ihre Augen in der Tiefe der Nacht schließt, bis eine Laterne langsam nur für dich angezündet wird, eine, die niemand sonst sehen kann.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110226
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110226,
					"content": "Vielen Dank für alles, Unteroffizier Sousi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110211,
					"content": "Es gibt keinen Grund, sich so sehr auf das Ergebnis zu fixieren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				}
			]
		},
