			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aino",
					"Flins"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1636.392,
							204.809,
							9954.635
						],
						"pointId": 13295
					},
					{
						"sceneId": 3,
						"position": [
							1636.554,
							204.804,
							9952.718
						],
						"pointId": 13296
					},
					{
						"sceneId": 3,
						"position": [
							1637.499,
							204.81,
							9954.46
						],
						"pointId": 13576
					}
				]
			},
			"dialogs": [
				{
					"id": 60110801,
					"content": "Flins? Ich sehe dich hier nicht oft. Schau dich ruhig um. Ich bin gerade beschäftigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110802
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110802,
					"content": "Nun, ich bin gekommen, um dich zu besuchen, Fräulein Aino. Hier – ich habe ein paar Snacks aus Nasha mitgebracht, mit ihrem traditionellen Buttergeschmack. Also, wo soll ich sie hinlegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110803
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110803,
					"content": "Psst! ... Ineffa könnte dich hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110804
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110804,
					"content": "... Also, was ist der Anlass? Willst du etwa sagen, dass die Lichthüter nach dem Vorfall mit der Kanone alle Vorfälle der Wilden Jagd übernehmen werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110805
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110805,
					"content": "Und ein Genie wie dich wegen Ergebnissen kritisieren, die keiner von uns vorhersehen konnte? So taktlos wären wir nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110806
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110806,
					"content": "Wenn wir das wirklich tun würden, wage ich zu behaupten, dass wir nie wieder technische Durchbrüche erleben würden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110807
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110807,
					"content": "Hmph. Du Schmeichler ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110808
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110808,
					"content": "Es freut mich, dass ich zu deiner Beruhigung beitragen konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110809
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110809,
					"content": "Wie auch immer, warum bist du eigentlich hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110810
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110810,
					"content": "Nun ja. Könntest du mir helfen, diese Laterne zu reparieren? Ich habe sie zwar nach Nasha gebracht, um sie reparieren zu lassen, aber sie ist während unseres letzten Kampfes wieder kaputtgegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110811
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110811,
					"content": "Du willst, dass ein Genie wie ich eine Laterne repariert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110812
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110812,
					"content": "Oh, bitte entschuldige. Vielleicht sollte diese Anfrage besser an Frau Ineffa gerichtet werden, genau wie die Snacks ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110813
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110813,
					"content": "W... W... Was ... Ich ... Ich meine, ich kann das absolut machen, kein Problem. Warte einfach dort. Ich bin fertig, bevor du „Fertig“ sagen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110814
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110814,
					"content": "Dann vielen Dank für deine Bemühungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110815
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110815,
					"content": "Und wenn dir das nächste Mal so etwas passiert, komm zuerst zu mir, verstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				}
			]
		},
