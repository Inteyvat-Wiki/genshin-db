			},
			"dialogs": [
				{
					"id": 60110701,
					"content": "... Interessant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110702
					],
					"speakerTitle": "Rächer von Solnari"
				},
				{
					"id": 60110702,
					"content": "Du bist mir bis hierher gefolgt. Warum zeigst du dich nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110703
					],
					"speakerTitle": "Rächer von Solnari"
				},
				{
					"id": 60110703,
					"content": "Haha, stimmt! Stimmt, du hast recht. Ich habe vergessen, mich vorzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110704
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60110704,
					"content": "Mein Name ist Varka, „Ritter des Nordwinds“ und Großmeister des Ordo Favonius.",
					"roleType": "TALK_ROLE_NPC",
