			"dialogs": [
				{
					"id": 60110101,
					"content": "Alle kommen zusammen und tauschen sich über das aus, was sie gesehen und gehört haben ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						60110102
					]
				},
				{
					"id": 60110102,
					"content": "Zum Glück konnten wir den Schaden begrenzen. Nur einige Bürger wurden verletzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110103,
					"content": "Aber der Rächer von Solnari hat jetzt einen vollständigen Körper erlangt, während wir noch nichts über seine Ziele wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110104
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110104,
					"content": "Es scheint, als hätten wir so etwas wie einen bösartigen Qucusaurier in die Freiheit entlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110105
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110105,
					"content": "... Entschuldigung. Ist denn hier niemand mit Qucusauriern vertraut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110106,
					"content": "P... Paimon weiß, was du meinst, aber diese Analogie scheint zu milde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110107,
					"content": "Er sagte, dass diese Welt für ihn keine Bedeutung habe. Es ist also möglich, dass er im Moment keinen Grund hat, uns zu bekämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110108,
					"content": "Wenn sein Ziel nur Rache ist, dann gibt es auch im Moment nichts, was wir tun können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110109,
					"content": "Ist es noch möglich, ähm, meine Kündigung einzureichen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110110,
					"content": "Nur Spaß, nur Spaß! Keine Sorge, Chefin, ich weiß, dass es jetzt kein Weglaufen mehr gibt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110111
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110111,
					"content": "Meine Kanone, mein ganzer Stolz, war also eher ein Hindernis als eine Hilfe ... Hmpf! Wisst ihr was? Ich werde sie demontieren. Und zwar jetzt gleich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110112,
						60110113
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110112,
					"content": "Es war nicht deine Schuld ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110114
					]
				},
				{
					"id": 60110114,
					"content": "Das stimmt, und sie funktioniert immer noch gut gegen gewöhnliche Anomalien der Wilden Jagd. Lass dich davon nicht unterkriegen, Aino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110115,
					"content": "Flins, du musst dich mit den Lichthütern um die Nachwirkungen kümmern. Keine Sorge, ich habe ihnen schon alles erklärt. Du bist in Sicherheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110116,
					"content": "Vielen Dank – für das und für alles, was du getan hast, um uns den Weg zur Wahrheit zu erleichtern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110117
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110117,
					"content": "Hättest du dich öfters in der Öffentlichkeit gezeigt, wärst du nicht so leicht zu isolieren gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110118
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110118,
					"content": "Heh. Verstehe. Ich werde darüber nachdenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110119
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110119,
					"content": "Ich nehme an, das ist einer der Vorteile, die ich durch die Übernahme Unteroffizier Sousis Position gewinnen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110120
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110120,
					"content": "Du meinst, du wirst befördert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110121,
					"content": "Er macht nur Spaß, Paimon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110122
					]
				},
				{
					"id": 60110122,
					"content": "Oh, warte mal. War Paimon die Einzige, der es nicht kapiert hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110123,
					"content": "#Nun, {NICKNAME}, wenn du einen Moment Zeit hättest, würdest du mit mir kommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110124
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110124,
					"content": "Ich möchte mich von diesem Herrn verabschieden, bevor er sich auf seine letzte Reise begibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110113,
					"content": "Und auch nicht die der Kanone ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110114
					]
				}
			]
		},
		{
			"id": 601102,
			"completionStepIds": [
				601102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
