					},
					{
						"sceneId": 3,
						"position": [
							1677.138,
							277.701,
							9397.254
						],
						"pointId": 11783
					},
					{
						"sceneId": 3,
						"position": [
							1678.174,
							277.675,
							9396.496
						],
						"pointId": 13093
					}
				]
			},
			"dialogs": [
				{
					"id": 60110601,
					"content": "Columbina! Was machst du hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110602,
					"content": "Hm? Wart ihr es nicht, die mir empfohlen haben, spazieren zu gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110603
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60110603,
					"content": "Ja, aber hast du keine Angst, dass die Fatui dich finden könnten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110604,
					"content": "Sandrone scheint kein Interesse an meiner Gefangennahme zu haben und die anderen werden es wahrscheinlich nicht riskieren, Kontakt aufzunehmen. Sie haben wichtigere Dinge zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110605
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60110605,
					"content": "(Rerir, wenn ich raten müsste ... Er ist eine Bedrohung für alle, die in Nod-Krai leben.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110606
					]
				},
				{
					"id": 60110606,
					"content": "Nun, es ist auf jeden Fall gut, spazieren zu gehen. Und, wie findest du es? Gefällt dir Nasha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110607,
					"content": "Hm ... Der Kuuvahki-Fluss ist etwas turbulent und die Menschen fühlen sich unwohl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110608
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60110608,
					"content": "Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110609
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60110609,
					"content": "Aber was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110610,
					"content": "Habt ihr die Speisen, die ihr mir gebracht habt, hier gekauft?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110611
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60110611,
					"content": "(Ist das ihr Ernst? Das ist es, was sie beschäftigt? Gebratenes Fleisch mit Beeren?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110612,
					"content": "Ähm, nun, wir können dich zum Essen mitnehmen, wenn du möchtest. Hier gibt es alle möglichen leckeren Sachen, die du zu Hause nicht finden wirst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110613,
					"content": "... Du bist heute ziemlich zurückhaltend. Hast du irgendwelche schwierigen Fragen im Kopf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60110614,
					"content": "Ich mache mir Gedanken über Rerir ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110615
					]
				},
				{
					"id": 60110615,
					"content": "Ich fürchte, ich konnte keinen Einblick in seine Pläne gewinnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110616
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60110616,
					"content": "Jetzt, da er Gestalt und Form angenommen hat, wäre es ein fataler Fehler, seine Macht zu unterschätzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110617
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60110617,
					"content": "Aber in seiner Kraft steckt eine Besessenheit, die an Manie grenzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110618
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60110618,
					"content": "Ich kann nicht sagen, ob diese Besessenheit auf die Monde oder auf etwas anderes gerichtet ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110619
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60110619,
					"content": "Vielleicht ist das Verständnis für das Thema seiner Besessenheit der Schlüssel, um ihn in Zukunft abzuwehren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60110620,
					"content": "Über die Fatui ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110621
					]
				},
				{
					"id": 60110621,
					"content": "Nun, Sandrones Tagesablauf ist sehr unregelmäßig, während „Il Dottore“ oft Leute herumkommandiert. Was Arlecchino angeht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110622
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60110622,
					"content": "Hm? War das nicht das, was du wissen wolltest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110623
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60110623,
					"content": "Na dann. Warst du schon einmal in ihrem Versuchs- und Konstruktionsbüro? Diese „Waffe“ wird eine Schlüsselrolle im Plan der Zarin spielen. Das habe ich jedenfalls gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110624
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60110624,
					"content": "Und wie sieht dieser Plan genau aus? Nun, ich kann nicht sagen, dass mich das interessiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110625,
						60110630
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60110625,
					"content": "Über mein Raumschiff ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110626
					]
				},
				{
					"id": 60110626,
					"content": "Ich könnte für dich in das Mark des Ewigen Mondes blicken, wenn du das möchtest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110627
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60110627,
					"content": "Aber nach unserem letzten Versuch vermute ich, dass dein Raumschiff absichtlich versteckt wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110628
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60110628,
					"content": "Vielleicht hat jemand bestimmte Wahrheiten, die er vor dir oder vor anderen verbergen möchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110629
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60110629,
					"content": "Und ich bezweifle, dass es viele gibt, die eine solche Leistung vollbringen könnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110620,
						60110630
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60110630,
					"content": "Ich habe keine weiteren Fragen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110631
					]
				},
				{
					"id": 60110631,
					"content": "Ich ... möchte immer noch auf den Mond zurückkehren, der mir gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110632
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60110632,
					"content": "Dort liegen die Antworten begraben. Das ... ist mein wahres „Zuhause“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				}
			]
		},
