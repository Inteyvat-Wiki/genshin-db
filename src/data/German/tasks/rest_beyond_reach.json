					"Aino"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 60111001,
					"content": "„Repariere meine Laterne“, sagt er. Ach bitte! Das dauert keine zehn Minuten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111002
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60111002,
					"content": "Wenn nur jeder wüsste, was er da eigentlich tut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111003
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60111003,
					"content": "Nehmen wir zum Beispiel diesen Hintsa. Wie um alles in der Welt schafft man es, aus zufälligen Bauteilen, die man reparieren soll, einen integrierten Controller für die Kanone UND die Barriere zu bauen? Uff, allein beim Gedanken daran bekomme ich Kopfschmerzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111004
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60111004,
					"content": "Ich habe ihm ordentlich die Meinung gesagt und ihn aufgefordert, er solle mir regelmäßig Berichte schicken. Ich muss wissen, woran er arbeitet! *seufz* Ja, ich meine, ich weiß, dass ich auch teilweise schuld bin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				}
			]
		},
		{
			"id": 601111,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
