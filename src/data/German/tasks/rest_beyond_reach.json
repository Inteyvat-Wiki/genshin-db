					}
				]
			},
			"dialogs": [
				{
					"id": 60110501,
					"content": "Chefin, also ... Erinnerst du dich an die Sache, zu der ich deine Meinung hören wollte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110502
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110502,
					"content": "Auf einer Skala von eins bis zehn: Wie viel Aufwand sollte das Kuratorium der Geheimnisse betreiben, wenn wir wieder mit anderen zusammenarbeiten würden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110503
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110503,
					"content": "Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110504
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110504,
					"content": "Ist das eins? Ist das nicht etwas niedrig ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110505
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110505,
					"content": "Rate noch einmal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110506
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110506,
					"content": "Moment mal, du meinst null? Aber dann wäre es ja nur noch eine Kooperation auf dem Papier, oder? Warum sollten wir uns dann überhaupt zusammentun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110507
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110507,
					"content": "*seufz* ... Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110508
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110508,
					"content": "Was ich damit sagen will, ist, dass es weder eine Ober- noch eine Untergrenze gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110509
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110509,
					"content": "Oh! Typisch für dich, Chefin, immer schon einen Schritt vorauszudenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110510
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110510,
					"content": "Moment mal, das ist doch keine Antwort, oder? Komm schon, gib mir einfach eine Zahl, Chefin, bitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
