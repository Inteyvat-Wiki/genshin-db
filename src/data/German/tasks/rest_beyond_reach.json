			"dialogs": [
				{
					"id": 60110401,
					"content": "Die Krumkake sind fertig. Genießt sie, solange sie noch warm sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110402
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110402,
					"content": "Vielen Dank, dass du daran gedacht hast, Fräulein Ineffa. Möge dieser Geschmack Zeugnis von unserer Freundschaft ablegen und möge sie Bestand haben, auch wenn Jahre vergehen sollten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110403
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110403,
					"content": "Verstanden. Allerdings befürchte ich, dass Krumkake nicht so lange haltbar sind. Nach höchstens einer Woche verschlechtert sich ihr Geschmack.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110404
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110404,
					"content": "Hehe, das ist nicht ganz das, was ich damit gemeint habe ... Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110405
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110405,
					"content": "Oh? Wir scheinen Gäste zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110406
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110406,
					"content": "Ah, sie müssen dem Duft der Krumkake gefolgt sein ... Ist schon in Ordnung, kommt näher. Ineffa ist eine Freundin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110407
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110407,
					"content": "Bestätigt. Ich kann sogar ein Omelett mit Getreideflocken basierend auf individuellen Vorlieben zubereiten, bevor ich es in Portionen zerteile, die dann mit allen geteilt werden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110408
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110409
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110409,
					"content": "Was sagen sie denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110410
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110410,
					"content": "Sie ... reden über deine Adresse. Sie würden gerne mit dir nach Hause gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		},
