					},
					{
						"sceneId": 3,
						"position": [
							1572.348,
							214.811,
							9438.882
						],
						"pointId": 13092
					}
				]
			},
			"dialogs": [
				{
					"id": 60110901,
					"content": "Hmm? Was führt euch hierher? Hätte nicht gedacht, euch hier wiederzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110902
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110902,
					"content": "Und wo warst du? Du bist doch nicht etwa weggelaufen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110903,
					"content": "Oh, natürlich nicht! Ich war nur geschäftlich woanders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110904
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110904,
					"content": "In der Tat war es alleine euch zu verdanken, dass mein kleiner Laden gerettet wurde. *schluchz* Ich bin euch dankbar. So dankbar ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110905
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110905,
					"content": "Schon gut, schon gut, du kannst jetzt mit dem Schauspielern aufhören ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110906
					]
				},
				{
					"id": 60110906,
					"content": "Was? Aber das habe ich doch überhaupt nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110907
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110907,
					"content": "Und habe ich euch nicht gesagt, dass meine Preise angemessen sind? Ah, aber ihr habt euch trotzdem an dieses Kuratorium der Geheimnisse gewandt, oder wie auch immer es heißt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110908
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110908,
					"content": "*seufz* Wenn sogar Stammkunden wie ihr mich so im Stich lasst, was bleibt einer Geschäftsfrau dann anderes übrig, als ihre Waren woanders hinzubringen ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110909
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110909,
					"content": "Du bist viel zu vorsichtig gegenüber dem Kuratorium ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110910
					]
				},
				{
					"id": 60110910,
					"content": "Und wie könnte ich das nicht sei, hm? Kleine Geschäfte im Ausland zu betreiben ist keine leichte Aufgabe – ganz zu schweigen von der enormen Konkurrenz, die dort herrscht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110911
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110911,
					"content": "Ach, vergiss es. Glück und Schicksal sind eins, also hat es keinen Sinn, sich zu beschweren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110912
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110912,
					"content": "Es ist nicht so, dass Nefer mir nach meiner Ankunft nie wegen unserer gemeinsamen Heimat einen Gefallen getan hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110913
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110913,
					"content": "Wenn überhaupt irgendetwas schuld ist, dann die Tatsache, dass ich so lange keine Gelegenheit gefunden habe, ihr einen großen Gefallen zu tun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110914
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110914,
					"content": "Also dann! Sollte sie jemals etwas brauchen, sorgt dafür ... nein, sorgt doppelt dafür, dass ihr mich zuerst informiert! Ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				}
			]
		},
