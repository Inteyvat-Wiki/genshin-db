			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flins"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 60111101,
					"content": "#Ah, schön, dich hier zu treffen, {NICKNAME}. Ich finde, meine Laterne hat sich nach diesem ziemlich heftigen Kampf eine gründliche Wartung verdient. Deshalb bin ich hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111102,
					"content": "Und danke, dass du meine Geheimnisse bewahrst, obwohl du so viel weißt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111103,
						60111104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111103,
					"content": "Ich hatte bisher keine Zeit, mich darum zu kümmern, aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60111105
					]
				},
				{
					"id": 60111105,
					"content": "Weil ich keinen Ärger mit den Starshyna bekommen wollte. Wenn sie meine eigene Laterne nicht orten konnten, vermute ich, dass meine Vorgesetzten mich zwingen würden, eine standardmäßige Ratnik-Laterne zu verwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111106,
					"content": "Ein Ratnik, der zwei Laternen trägt, stell dir das mal vor! Ein seltsamer Anblick, und dazu noch ästhetisch unattraktiv. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111104,
					"content": "Warum konnten die Lichthüter deine Laterne entdecken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60111105
					]
				}
			]
		}
	]
}