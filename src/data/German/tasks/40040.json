					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400102,
					"content": "„Schattenlaterne“? Habe noch nie was davon gehört ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400400103,
					"content": "Habt ihr Interesse an meiner „Schattenlaterne“? Sie ist interessant!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400104
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400104,
					"content": "Wenn man die Objekte in der „Schattenlaterne“ in die richtige Richtung dreht und ihre Schatten miteinander verschmelzen lässt, kann man unglaubliche Bilder sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400106
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400106,
					"content": "Wenn du daran interessiert bist, solltest du es vielleicht einmal selbst ausprobieren. Das Gerät ist da, probiert es aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400107
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400107,
					"content": "Ich hoffe, dass die „Schattenlaterne“ auch dir fantastische Bilder zeigen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400108
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400108,
					"content": "Hört sich nach Spaß an, also lass uns auch etwas Spaß haben!",
