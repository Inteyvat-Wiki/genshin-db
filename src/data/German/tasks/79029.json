						790290202
					],
					"speakerTitle": "Kapitän Nachtrabe"
				},
				{
					"id": 790290202,
					"content": "Ich werde vorausgehen und euch auf den Riffen die richtige Richtung zeigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290203
					],
					"speakerTitle": "Kapitän Nachtrabe"
				},
				{
					"id": 790290203,
					"content": "Also, siehst du diesen Fels dort? Ihr müsst zuerst dorthin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kapitän Nachtrabe"
				}
			]
		},
