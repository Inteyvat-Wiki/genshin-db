			"dialogs": [
				{
					"id": 790290101,
					"content": "Ist das dort eine Statue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290102,
					"content": "*seufz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290103
					],
					"speakerTitle": "Kapitän Nachtrabe"
				},
				{
					"id": 790290103,
					"content": "Hallo, warum seufzt du vor dieser Höhle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290112,
					"content": "Ich lebe seit Kurzem in dieser Höhle ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290113
					],
					"speakerTitle": "Kapitän Nachtrabe"
				},
				{
					"id": 790290113,
					"content": "In so einer Höhle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290114,
					"content": "Was soll ich machen! Plötzlich taucht auf der Insel eine Gruppe Schauspieler auf, sie sind so laut, dass ich nicht einmal schlafen kann ... Ich kann nirgendwo anders hin, wenigstens ist es hier ruhig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290104
					],
					"speakerTitle": "Kapitän Nachtrabe"
				},
				{
					"id": 790290104,
					"content": "Dann wieder! Plötzlich kam eine Bande von Hilichurle und sie besetzten mein Lager, also kann ich hier nur im kalten Wind stehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290105
					],
					"speakerTitle": "Kapitän Nachtrabe"
				},
				{
					"id": 790290105,
					"content": "Ach, ich schwöre feierlich, wenn mir nur jemand helfen könnte, würde ich ihm sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290106
					],
					"speakerTitle": "Kapitän Nachtrabe"
				},
				{
					"id": 790290106,
					"content": "Was würdest du ihm denn sagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290107,
					"content": "Ich würde ihm sagen, wo man einen Hinweis auf den legendären Piratenschatz finden kann, auch wenn ich nur einen der vier Teile davon kenne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290108
					],
					"speakerTitle": "Kapitän Nachtrabe"
				},
				{
					"id": 790290108,
					"content": "Einer der vier Teile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290109,
					"content": "Ihr scheint wohl auch nach dem Schatz zu suchen. Wie klingt das, ihr helft mir mit den Hilichurle da drinnen und ich sage euch, wo ihr den Hinweis findet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290110
					],
					"speakerTitle": "Kapitän Nachtrabe"
				},
				{
					"id": 790290110,
					"content": "Man sagt, wenn man die vier Hinweise hat, findet man den Schatz, den die Piraten einst hier zurückgelassen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290111
					],
					"speakerTitle": "Kapitän Nachtrabe"
				},
				{
					"id": 790290111,
					"content": "Nun, abgemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
