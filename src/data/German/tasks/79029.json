			"dialogs": [
				{
					"id": 790290801,
					"content": "Ihr habt die Hilichurle aufgeräumt? Ich bin euch unendlich dankbar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290802
					],
					"speakerTitle": "Kapitän Nachtrabe"
				},
				{
					"id": 790290802,
					"content": "Kommt, ich zeige euch, wie ihr durch den Nebel über der See kommt und den Hinweis finden könnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290803
					],
					"speakerTitle": "Kapitän Nachtrabe"
				},
				{
					"id": 790290803,
					"content": "Wenn ihr bereit seid, kommt zu mir auf die andere Seite des Riffs!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kapitän Nachtrabe"
