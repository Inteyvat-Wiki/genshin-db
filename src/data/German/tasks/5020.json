			},
			"dialogs": [
				{
					"id": 50202001,
					"content": "Atea ... ist eine Älteste, die ich sehr schätze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202002
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202002,
					"content": "Nachdem mein Großvater starb, wählten mich die Ältesten zum Stammesoberhaupt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202003
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202003,
					"content": "Ich habe immer alle möglichen verrückten Ideen, deshalb dachten alle, ich könnte unseren Stamm in eine andere Art von Zukunft führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202004
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202004,
					"content": "Aber lange Zeit wusste ich nicht, was ich tun sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202005
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202005,
					"content": "Aber Atea war immer da, um mich zu unterstützen. Selbst wenn ich Fehler machte, hat sie mir nie deswegen Vorwürfe gemacht. Sie half mir, zu verstehen, was falsch gelaufen war, und es beim nächsten Mal besser zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202006
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202006,
					"content": "Ich schätze sie sehr, deshalb ... werde ich mir ihre Lehren zu Herzen nehmen und hart daran arbeiten, der Häuptling zu werden, den unser Stamm verdient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amina"
				}
			]
		}
	]
}