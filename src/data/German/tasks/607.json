			"dialogs": [
				{
					"id": 6070101,
					"content": "Durchhalten! Holt einen weiteren Kleiderschrank her! Argh ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070102
					],
					"speakerTitle": "Parsley"
				},
				{
					"id": 6070102,
					"content": "Abscheuliche Monster! Das Immernachtreich wird solche Übeltaten nicht dulden ...",
