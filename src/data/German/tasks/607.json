			"dialogs": [
				{
					"id": 6070201,
					"content": "Fürchtet euch nicht. Die bösen Monster wurden in die Leere verbannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070202
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 6070202,
					"content": "Das Fräulein möchte damit sagen, dass ihr vorerst nicht nach draußen gehen solltet. Wir werden dieses Gebiet weiterhin beschützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070203
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 6070203,
					"content": "Danke! Vielen, vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070204
					],
					"speakerTitle": "Parsley"
				},
				{
					"id": 6070204,
					"content": "Aber, ähm ... ich habe noch nie einen Vogel gesehen, der, äh ... sprechen kann, hehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070205
					],
					"speakerTitle": "Parsley"
				},
				{
					"id": 6070205,
					"content": "Ach, keine Sorge. Ich bin der bescheidene Diener meines Fräuleins. Ich versichere dir, von mir geht keine Gefahr aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070206
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 6070206,
					"content": "Du kannst ihnen vertrauen. Das verspreche ich dir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						6070207
					]
				},
				{
					"id": 6070207,
					"content": "Ach nein. Natürlich! So habe ich das auch gar nicht gemeint. Ich habe mich nur ... versprochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070208
					],
					"speakerTitle": "Parsley"
				},
				{
					"id": 6070208,
					"content": "Hmpf, wie auch immer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070209
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 6070209,
					"content": "Meine Vasallen haben noch unerledigte Pflichten, oder? So gehet hin und vernichtet diese elenden Bestien. Der Segen der Prinzessin wird euren Pfad erhellen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fischl"
				}
			]
		},
