					"id": 708120401,
					"content": "Auf den Dächern und den Stadtmauern sollten nun drei Poster und ein Schild festhängen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708120402
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 708120402,
					"content": "Bitte bring diese Poster zu mir. Und zu dem Schild: Du kannst es einfach hier auf dem Boden lassen. Ich werde meine Kollegen anweisen, es dem entsprechenden Händler zu geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
