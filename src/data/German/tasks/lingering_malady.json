			"dialogs": [
				{
					"id": 708120501,
					"content": "Hast du sie alle gekriegt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708120502
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 708120502,
					"content": "Jawohl!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708120503
					]
				},
				{
					"id": 708120503,
					"content": "Mein tiefer Dank gilt dir. Ich werde diese Poster nehmen und sie gleich den passenden Händlern zurückgeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708120504
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 708120504,
					"content": "Und zu dem Schild. Es ist von der Engelsgabe. Ich habe bereits Charles benachrichtigt. Er wird jemanden schicken, um es zurückzuholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708120505
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 708120505,
					"content": "Dies ist eine kleine Entlohnung für deine Hilfe. Bitte nimm sie. Und ich, ich muss mich jetzt anderen Aufgaben widmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708120506
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 708120506,
					"content": "Obwohl dich der Sturm zurückgezogen hat, werden seine Auswirkungen uns noch eine Weile begleiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
				}
			]
		}
