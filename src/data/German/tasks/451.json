						4510502
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510502,
					"content": "Wölfe anders jagen, klappt immer. Aber Falle, lustig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510503
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510503,
					"content": "Erst Falle legen, dann Wildschwein jagen. Richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510504
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510504,
					"content": "Macht Bumm?",
					"roleType": "TALK_ROLE_NPC",
