			"dialogs": [
				{
					"id": 4510601,
					"content": "Hier! Wir haben es geschafft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510602,
					"content": "Danke. Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510603
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510603,
					"content": "Wir selber jagen, wir fangen fünf oder sechs. Wölfe heute Abend hungrig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510604
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510604,
					"content": "Ooooh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510605,
					"content": "Nicht schlimm. Danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510606
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510606,
					"content": "Anderer Ritter auch geholfen, rot und heiß. Du viel besser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510607
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510607,
					"content": "Sie hier, Wald brennen. Wildschweine alle weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510608
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510608,
					"content": "Muss gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510609
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510609,
					"content": "Hier nicht sicher. Aufpassen, bis bald!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510610
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510610,
					"content": "Das war ja ein merkwürdiger Bursche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510611,
					"content": "Er hat von einem Ritter gesprochen. Rot und heiß ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510612,
					"content": "#{NICKNAME}, hast du eine Ahnung, wer das sein könnte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
