			"dialogs": [
				{
					"id": 4510101,
					"content": "Wir sind hier in „Wolfenlauf“. Die Leute aus Mondstadt haben nur wenig mit diesem Ort zu tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510102,
					"content": "Er ist zwar nicht weit von Mondstadt entfernt, doch die Natur hat hier das Sagen. Hier ist alles noch sehr ursprünglich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510103,
					"content": "Hier überleben nur die Stärksten. Selbst Schleime werden hier riesengroß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510104,
					"content": "Guck mal! Solche Dinger wie die da drüben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510105,
					"content": "Sie haben uns entdeckt! Mach dich bereit!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 45103,
			"completionStepIds": [
				45104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
