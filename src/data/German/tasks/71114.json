			},
			"dialogs": [
				{
					"id": 711140901,
					"content": "*seufz* Wir hätten lieber zuerst in Qiaoying drehen sollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140902,
						711140903
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140902,
					"content": "Ist alles in Ordnung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				},
				{
					"id": 711140904,
					"content": "#{NICKNAME}, Paimon, herrje! Dank eurer Hilfe sind weder Ausrüstung noch Film verloren gegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140905
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140905,
					"content": "Aber wir sollten wohl das nächste Mal, wenn wir dort drehen, ein paar Abenteurer anheuern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140906
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140906,
					"content": "Also, wie läuft es mit eurem Film über den Tee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140907,
					"content": "Na ja ... Derzeit haben wir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140908
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140908,
					"content": "Eine tolle Eröffnungsszene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140909
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140909,
					"content": "Und eine tolle künstlerische Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140910
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140910,
					"content": "Also ... fangt ihr gerade erst an?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140911
					]
				},
				{
					"id": 711140911,
					"content": "*seufz* Wir ... sind im Moment etwas knapp bei Kasse und Herr Geiserts Honorar ist so hoch, wie sein Wissensschatz groß ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140912
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140912,
					"content": "Wir haben zwar ein paar kurze Filme gedreht und ein wenig verdient, aber so ein großer Dokumentarfilm geht echt ins Geld.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140913
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140913,
					"content": "Insbesondere, nachdem die Chefin eine Reihe von Sponsoren abgewiesen hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140914
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140914,
					"content": "Und sie hat eine Reihe von Anfragen zur Zusammenarbeit abgelehnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140915
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140915,
					"content": "Was wisst ihr denn schon!? Der Grund für all das war, weil wir einen Film nach unseren eigenen ästhetischen Vorstellungen drehen wollten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140916
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140916,
					"content": "Aber Chefin, haben wir nicht ursprünglich Filme gedreht, um Geld zu verdienen ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140917
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140917,
					"content": "Ich ... Denkt nicht so viel nach, sondern bereitet erst mal die Ausrüstung vor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140918
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140918,
					"content": "#{NICKNAME}, hier ist deine Vergütung. Danke, dass du stets so hilfsbereit bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140919
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140919,
					"content": "Wenn ich erst mit dem Film fertig bin, werde ich dich auf jeden Fall einladen, ihn anzuschauen, und anschließend lade ich dich zum Tee ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140920
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140920,
					"content": "Yifeng, Xingye, findet einen guten Ausleuchtungswinkel! Diesmal machen wir es mit einer einzigen Aufnahme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140921
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140921,
					"content": "Aber Chefin, es ist doch keine Kampfszene, die wir hier drehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140922
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140922,
					"content": "Hängt es etwa nicht gänzlich vom Schicksal ab, ob eine Szene in einer einzigen Aufnahme klappt!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140923
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140923,
					"content": "Je... Jedenfalls bauen wir erst die Ausrüstung auf! Wartet hier zuerst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140903,
					"content": "Sieht so aus, als hättet ihr nichts von eurer Ausrüstung verloren, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				}
			]
		},
