			},
			"dialogs": [
				{
					"id": 711149940,
					"content": "Nachdem ihr alle Schatzräuber verjagt habt, bringt ihr die Leute, die von ihnen bedrängt wurden, in einen nahe gelegenen Pavillon, damit sie sich ein wenig ausruhen können ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 711140801,
					"content": "Vielen, vielen Dank, du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140802
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140802,
					"content": "Frau Qiu ... bist du das?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140803
					]
				},
				{
					"id": 711140803,
					"content": "#{NICKNAME}! Was machst du denn hier? Das ist ja ... Jetzt schulde ich dir ja schon wieder einen Gefallen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140804
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140804,
					"content": "Wolltet ihr nicht in Fontaine lernen, wie man einen Film dreht? Wie kommt es, dass ihr schon wieder in Liyue seid?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140805,
					"content": "Habt ihr schon alles gelernt, was es zu lernen gibt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140806
					]
				},
				{
					"id": 711140806,
					"content": "Na ja ... Besser gesagt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140807
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140807,
					"content": "Wir mussten „erstmal etwas Geld verdienen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140808
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140808,
					"content": "Ihr zwei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140809
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140809,
					"content": "Herr Geisert ist ein echter Profi. Seine Ratschläge waren überaus hilfreich, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140810
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140810,
					"content": "Die Filme, die er uns drehen ließ, waren viel zu bedeutungsschwanger und konzeptionell. Und was konkrete Dinge und Handlungen angeht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140811
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140811,
					"content": "Um es in den Worten von Herrn Geisert auszudrücken: „Lass sie in den Hintergrund treten.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140812
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140812,
					"content": "Wir hingegen wollen einen Film drehen, der auf den Tee Qiaoyings aufmerksam macht. Hätten wir so weitergemacht, wäre aber das genaue Gegenteil eingetreten, deshalb ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140813
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140813,
					"content": "Deshalb habe ich beschlossen, vorerst eine Pause vom Filmstudium einzulegen, zurückzukommen und eine Dokumentation zu drehen. Ich wollte das Gelernte gern in die Praxis umsetzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140814
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140814,
					"content": "... Außerdem geht uns das Geld aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140815
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140815,
					"content": "D... Das wäre alles. Ich habe alles geplant. Wir müssen nur diese Dokumentation abdrehen, dann kriegen wir das Geld schon wieder rein, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140816
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140816,
					"content": "#Und dann haben uns diese Schatzräuber auf der Hängebrücke eingekesselt. Zum Glück kamst du zu unserer Rettung, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140817,
						711140818
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140817,
					"content": "Aber ist es hier nicht ein wenig weit weg von Qiaoying?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140819
					]
				},
				{
					"id": 711140818,
					"content": "Aber warum kommt ihr hierher, wenn ihr Qiaoying auf Film bannen wollt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140819
					]
				},
				{
					"id": 711140819,
					"content": "*seufz* Ich wollte ein paar spektakuläre Szenerien aufnehmen und sie in den Film einbauen, um das Ganze ein wenig aufzupeppen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140820
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140820,
					"content": "Wer hätte gedacht, dass die Dreharbeiten so fesselnd sein würden. Da haben uns die Schatzräuber erwischt und wir sind den ganzen Weg hierher gerannt, nur um dann doch von ihnen den Weg abgeschnitten zu bekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140821
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140821,
					"content": "Warte mal, dann sind diese professionellen Filmemacher, die Fräulein Woliu vorhin erwähnt hat, also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140822,
					"content": "Genau, das waren Frau Qiu und ihre Assistenten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140823
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140823,
					"content": "Fräulein Woliu, wo kommst du denn plötzlich her? Ich habe dich überhaupt nicht bemerkt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140824
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140824,
					"content": "Ich bin eben ziemlich gut im Verstecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140825
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140825,
					"content": "Ihr kennt euch also ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140826
					]
				},
				{
					"id": 711140826,
					"content": "Oh ja. Fräulein Woliu ist eine professionelle Hydrologin. Sie kennt die Gegend wie ihre Westentasche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140827
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140827,
					"content": "Wir haben sie oft um Ratschläge zu den besten Orten für Filmaufnahmen gebeten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140828
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140828,
					"content": "Wir wollten sie sogar bitten, unserem Filmteam beizutreten. Aber sie sagte, das müsse warten, bis sie Zeit habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140829
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140829,
					"content": "Chefin, also ... Ich glaube, wir haben bei unserer Flucht gerade unseren Koffer mit dem Film und der Ausrüstung zurückgelassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140830
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140830,
					"content": "Ich glaube ... dass einige der Aufnahmen, die wir gedreht haben, auch drinnen sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140831
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140831,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140832
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140832,
					"content": "#Woliu! {NICKNAME}! Paimon! Vielen Dank! Besucht mich mal in Qiaoying, wenn ihr Zeit habt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140833
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140833,
					"content": "So oder so ... Für die Rettung sollte es eine Belohnung geben. Ich werde alles vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140834
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140834,
					"content": "Wir sollten uns jetzt aber schnell verabschieden! Los, los, los! Wo hast du den Koffer hingestellt? Schnell jetzt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140835
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 711140835,
					"content": "Frau Qiu und die anderen verschwinden in Windeseile ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711140836
					]
				},
				{
					"id": 711140836,
					"content": "Der Koffer von Frau Qiu ... hat echt was auszustehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140837,
					"content": "Wie lautet noch das Sprichwort? „Gut Ding will Weile haben“. Frau Qiu wird schon einen anständigen Film auf die Beine stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140838
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140838,
					"content": "Also gut, erstmal eure Belohnung. Das letzte Gerät platziere ich später, und dann ... werde ich sicher noch Zeit finden, um mit Frau Qiu zu sprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140839
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140839,
					"content": "Sonst haben sie keine Ahnung, wo sie noch drehen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140840
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140840,
					"content": "Nun, sie sagten gerade, dass man sie in Qiaoying besuchen kann, richtig? ... Ich werde später zunächst dorthin gehen und nach ihnen suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Woliu"
				}
			]
		},
