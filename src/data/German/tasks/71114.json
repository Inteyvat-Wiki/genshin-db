						],
						"pointId": 7469
					}
				]
			},
			"dialogs": [
				{
					"id": 711140401,
					"content": "... Mit diesen Anpassungen sollte es klappen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140402
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140402,
					"content": "#{F#Reisende}{M#Reisender}, habt ihr die Geräte schon aufgestellt? Vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140403
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140403,
					"content": "Ihr bekommt eure Belohnung, kleinen Moment. Muss nur noch dieses Gerät hier aufstellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140404
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140404,
					"content": "Ich hätte es doch mit den anderen aufstellen können.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140405
					]
				},
				{
					"id": 711140405,
					"content": "Das ist sehr nett, aber dieses Gerät ist etwas speziell und erfordert ein wenig mehr Kalibrierung. Das wäre zu mühsam für euch gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140406
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140406,
					"content": "Lasst uns zu der Klippe dort drüben gehen und es in Position bringen, dann kann ich euch eure Belohnung geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140407
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140407,
					"content": "Klingt kompliziert ... Ist deine Arbeit immer so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140408,
					"content": "Jetzt brauche ich meine Geräte nur noch an Land platzieren ... auf einer Expedition musste ich einen Weg finden, eines von ihnen inmitten eines gewaltigen reißenden Stroms einzusetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140409
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140409,
					"content": "Hättest du nicht einfach ein Boot nehmen können?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140410
					]
				},
				{
					"id": 711140410,
					"content": "*seufz* Wenn es doch so einfach wäre, das Gerät einfach zu versenken. Dann hätte ich sicherlich ein Boot nehmen, dorthin fahren, das Gerät ins Wasser werfen und wieder verschwinden können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140411
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140411,
					"content": "Aber auf dieser Expedition musste ich die Stärke der Strömung messen. Ich musste also dieses spezielle Gerät ständig in der Mitte der Strömung platzieren. Es durfte weder auftauchen noch zu tief absinken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140412
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140412,
					"content": "Zum Glück gab es eine Hängebrücke über dem Fluss, ansonsten hätte ich jemanden bitten müssen, ein Seil zwischen zwei Bergen zu spannen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140413
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140413,
					"content": "Dann hätte ich das Gerät mit einem Seil befestigen müssen und es bis zur Mitte des Flusses ziehen müssen, bevor ich es hätte ablassen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140414
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140414,
					"content": "*räusper* ... Aber genug davon für den Moment, darum müssen wir uns im Moment auch nicht kümmern ... obwohl wir später noch eine Hängebrücke überqueren müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140415
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140415,
					"content": "Hier lang. Die Brücke ist nicht weit von hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Woliu"
				}
			]
		},
