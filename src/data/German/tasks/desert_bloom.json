			"dialogs": [
				{
					"id": 230410501,
					"content": "#{F#Reisende}{M#Reisender}, hast du das Wasser geholt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410502
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410502,
					"content": "Das könnte man so sagen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410503
					]
				},
				{
					"id": 230410503,
					"content": "Sehr gut, ich werde gleich die Blume gießen, bitte warte einen Moment ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410504
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410504,
					"content": "Nermin beginnt, die Blume zu gießen ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230410505
					]
				},
				{
					"id": 230410505,
					"content": "Puh ... Das sollte ausreichen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410506
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410506,
					"content": "Oma Kulsoom hat gesagt, dass man so lange gießen soll, bis unten am Topf Wasser zum Vorschein kommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410507
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410507,
					"content": "Auf diese Weise ist die Blumenerde gut befeuchtet und danach muss man alle drei Tage einmal gießen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410508
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410508,
					"content": "#Oh! Tut mir leid, ich habe mit mir selbst geredet ... Hier ist deine Belohnung, danke für deine Hilfe, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410509
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410509,
					"content": "Mit welchem Werkzeug sollte ich die Blätter beschneiden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				}
			]
		},
