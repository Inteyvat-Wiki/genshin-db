			"dialogs": [
				{
					"id": 230411001,
					"content": "Diese Minzbohnensuppe ... Hat Nermin die selbst gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230411002
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230411002,
					"content": "Sie war in letzter Zeit so geheimnistuerisch und hat Leute darum gebeten, ihr Pflanzentöpfe zu kaufen. Ich weiß aber nicht, was sie da eingepflanzt hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230411003
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230411003,
					"content": "Aber wenigstens ... hat Nermin nun etwas zu tun und hat nicht tagein, tagaus nur ihre gesundheitlichen Probleme im Kopf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230411004
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230411004,
					"content": "In Kürze wird hier noch eine Warenladung eintreffen, sobald ich sie ins Dorf gebracht habe, werde ich die Suppe essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230411005
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230411005,
					"content": "#Ah, richtig. Hier ist deine Belohnung. Danke, dass du mir die Suppe gebracht hast, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				}
			]
		},
