			},
			"dialogs": [
				{
					"id": 230410701,
					"content": "#{F#Reisende}{M#Reisender}, hast du das Kätzchen gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410702,
						230410703
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410702,
					"content": "Ich habe es gefüttert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410704
					]
				},
				{
					"id": 230410704,
					"content": "Sehr gut. Hoffentlich wird es nun meine Blätter in Ruhe lassen. In jedem Fall sollte ihm Katzenfutter ja besser schmecken als Blätter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410705
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410705,
					"content": "#Danke für deine Hilfe, {F#Reisende}{M#Reisender}. Und hier ist deine Belohnung, wie versprochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410706
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410706,
					"content": "Hoffentlich wird das Kätzchen nicht so schnell wieder Hunger bekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410703,
					"content": "Es sollte nun satt sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410704
					]
				}
			]
		},
