				{
					"id": 230410602,
					"content": "Miau? Miau, miau, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410603
					],
					"speakerTitle": "Faules Kätzchen"
				},
				{
					"id": 230410603,
					"content": "Boah! Wir sind keine schlechten Menschen, sei nicht so aufgeregt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230410604,
					"content": "Das sollte das Kätzchen sein, von dem Nermin gesprochen hat. Geben wir ihm etwas zu essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230410605,
					"content": "Unter den wachsamen Augen des Kätzchens stellst du das Futter vor ihm hin ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230410606
					]
				},
				{
					"id": 230410606,
					"content": "Es mag das Essen wirklich ... Das sollte reichen. Lass uns zurückgehen und es Nermin sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
