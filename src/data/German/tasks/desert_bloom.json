			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410101,
					"content": "Puh ... Das sollte ausreichen, um den Boden aufzulockern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410102
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410102,
					"content": "Du kümmerst dich immer noch um diese Blume?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410103
					]
				},
				{
					"id": 230410103,
					"content": "Ja, Oma Kulsoom hat mir viel über die Pflege von Blumen beigebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410104
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410104,
					"content": "Beispielsweise muss man für sie den Boden auflockern, zu bestimmten Zeiten die Blätter zurückschneiden und mit verschiedenen Methoden Insekten entfernen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410105
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410105,
					"content": "Und beim Gießen darf man ihnen nicht zu viel Wasser geben, sonst verfaulen ihre Wurzeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410106
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410106,
					"content": "Und ich habe noch gedacht, dass man sie jeden Tag gießen müsste, sodass der Boden immer feucht bleibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410107
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410107,
					"content": "Aber das ist gut so. So muss ich zumindest nicht jeden Tag Wasser holen gehen, immerhin ist die Wasserquelle ja wirklich weit von hier entfernt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410108
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410108,
					"content": "#Ich muss weiter die Blätter zurückschneiden. {F#Reisende}{M#Reisender}, könntest du mir einen Gefallen tun und mir eine kleine Kanne Wasser holen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410109
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410109,
					"content": "Ich habe das bereits mit Kazan besprochen. Er hat mir erlaubt, Wasser zu holen, um die Pflanzen zu gießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410110,
						230410111
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410110,
					"content": "Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410114
					]
				},
				{
					"id": 230410114,
					"content": "Die Kanne ist gleich da drüben. Aber pass beim Wasserholen bitte auf, dass du nicht zu viel Matsch mit hochholst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410111,
					"content": "Hast du das alles von Oma Kulsoom gelernt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410112
					]
				},
				{
					"id": 230410112,
					"content": "Hmm ... ja so ziemlich. Oma Kulsoom weiß wirklich viel. Ich gehe dauernd zu ihr, um sie nach Rat zu fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410113
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410113,
					"content": "#Nun verlasse ich mich auf dich, {F#Reisende}{M#Reisender}. Eine kleine Kanne Wasser sollte schon reichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410114
					],
					"speakerTitle": "Nermin"
				}
			]
		},
		{
			"id": 2304102,
			"completionStepIds": [
				2304101,
