				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410301,
					"content": "#{F#Reisende}{M#Reisender}, du kommst gerade richtig, um meine Minzbohnensuppe zu probieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410303
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410303,
					"content": "Diese Zutaten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410304
					]
				},
				{
					"id": 230410304,
					"content": "Einige davon habe ich mir von Leuten bringen lassen, aber die Minze habe ich selbst angepflanzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410305
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410305,
					"content": "Raef hat mir ja einen Satz an Gartenwerkzeugen und einen Haufen Dünger geschenkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410306
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410306,
					"content": "Es wäre Verschwendung gewesen, sie nur für eine Blume zu verwenden ... Also habe ich Azalai darum gebeten, mir einige Minzesamen zu kaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410307
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410307,
					"content": "Nachdem ich die Minzesamen eingepflanzt habe, habe ich mich genauso gut darum gekümmert wie um meine Blume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410308
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410308,
					"content": "Und nach einiger Zeit der Pflege ist meine Minze dann auch ohne Schwierigkeiten gewachsen und gereift ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410309
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410309,
					"content": "Ich habe etwas davon für meine „Minzbohnensuppe“ gepflückt. Und, was meinst du? Schmeckt sie dir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410310
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410310,
					"content": "Also ... Wo du ja gerade meine „Minzbohnensuppe“ gegessen hast, dann musst du mir jetzt auch einen Gefallen tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410311,
						230410312
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410311,
					"content": "Aber ich bin ja mit dem Essen noch gar nicht fertig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410313
					]
				},
				{
					"id": 230410313,
					"content": "Ach, ich mache doch nur Spaß! Ich werde dich gut dafür bezahlen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410314
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410314,
					"content": "Ich will dich nur darum bitten, mir drei „Zaytun-Pfirsiche“ zu bringen. Raef mag diese Früchte sehr gerne ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410315
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410315,
					"content": "Ich will sie für Raef in die Minzbohnensuppe geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410316
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410316,
					"content": "Da ich ja mittlerweile schon die Minzbohnensuppe zubereiten kann, brauche ich nur noch jemanden, der mir „Zaytun-Pfirsiche“ besorgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410317,
						230410319
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410317,
					"content": "Gut, ich verstehe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410318
					]
				},
				{
					"id": 230410318,
					"content": "Danke dir! Wenn du zurückkommst, wartet hier eine weitere Schüssel mit Minzbohnensuppe auf dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410321
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410321,
					"content": "#Ich überlasse die Sache also dir, {F#Reisende}{M#Reisender}. Beschaffe die „Zaytun-Pfirsiche“ und bring sie dann zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410319,
					"content": "Kann er die Suppe bei der Arbeit essen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410320
					]
				},
				{
					"id": 230410320,
					"content": "Es ist kein Problem, wenn er zwischendurch etwas isst, seine Arbeit ist ja jetzt auch nicht so stressig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410321
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410312,
					"content": "Pff, dann nimm deine Schüssel zurück!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410313
					]
				}
			]
		},
