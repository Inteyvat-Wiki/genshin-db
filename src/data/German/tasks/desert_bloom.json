			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410201,
					"content": "*schluchz* ... Da wurden ja schon wieder einige Blätter kaputt gebissen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410202
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410202,
					"content": "Was ist los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410203
					]
				},
				{
					"id": 230410203,
					"content": "#{F#Reisende}{M#Reisender}, schau mal! Hier war wieder ein Kätzchen und es hat Blätter angebissen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410204
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410204,
					"content": "Schau dir nur dieses Blatt an, und dieses ... und dieses hier! Ein ganzer Haufen voller abgebissener Blätter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410205,
						230410208
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410205,
					"content": "War das Kätzchen hungrig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410206
					]
				},
				{
					"id": 230410206,
					"content": "Das hat Raef auch gesagt. Er läuft sogar extra deswegen mit Futter herum, um überall Kätzchen zu füttern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410207
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410207,
					"content": "Aber am nächsten Tag werden die Blätter wieder von Kätzchen angebissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410210,
					"content": "Zurzeit beißt das Kätzchen nur in die Blätter, doch ich befürchte, dass es irgendwann auch damit anfängt, in die Stängel zu beißen ... Das wäre dann richtig schlimm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410211
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410211,
					"content": "Aber ich kann mich auch nicht dazu durchringen, es von hier zu vertreiben. Immerhin ist da draußen ja nur Wüste. Abgesehen vom Dorf gibt es keinen anderen Ort, zu dem es gehen könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410212
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410212,
					"content": "#{F#Reisende}{M#Reisender}, würdest du es für mich ein weiteres Mal füttern? Ich hoffe, dass es meine Blätter in Ruhe lässt, wenn es erst einmal satt ist. Immerhin sind die Blätter ja auch nicht wirklich lecker ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410213,
						230410214
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410213,
					"content": "Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410216
					]
				},
				{
					"id": 230410216,
					"content": "#Ich überlasse die Sache also dir, {F#Reisende}{M#Reisender}. Ich werde auf deiner Karte die Orte markieren, an denen sich das Kätzchen häufig aufhält ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410217
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410217,
					"content": "Ich werde hier bei der Blume Wache halten, falls ein anderes Kätzchen kommt, um die Blätter abzubeißen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410214,
					"content": "Ich komme mit Katzen gut klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410215
					]
				},
				{
					"id": 230410215,
					"content": "Sehr gut! Immer wenn ich die Krallen des Kätzchens sehe, befürchte ich, dass es mich plötzlich anspringen und kratzen wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410216
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410208,
					"content": "Macht das Kätzchen das ... zum Spaß?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410209
					]
				},
				{
					"id": 230410209,
					"content": "Ich weiß nicht, was Kätzchen gerne zum Spaß machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "Nermin"
				}
			]
		},
		{
			"id": 2304103,
			"completionStepIds": [
				2304101,
