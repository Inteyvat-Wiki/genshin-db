			},
			"dialogs": [
				{
					"id": 230410901,
					"content": "Danke! Zuerst muss ich sie in Stücke schneiden, um sie dann in die Minzbohnensuppe zu geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410902
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410902,
					"content": "Nermin beginnt, ihre spezielle Minzbohnensuppe zuzubereiten ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230410903
					]
				},
				{
					"id": 230410903,
					"content": "Fertig! Hmm ... Rein optisch scheint es keinen Unterschied zu der normalen Minzbohnensuppe zu geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410904
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410904,
					"content": "Aber der Geschmack wird sicher anders sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410905
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410905,
					"content": "#{F#Reisende}{M#Reisender}, darf ich dich darum bitten, diese Schüssel mit Minzbohnensuppe zu Raef zu bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410906
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410906,
					"content": "Ich muss auch noch einige Portionen für Oma Kulsoom machen. Ebeid und Hilmi haben auch gesagt, dass sie sie probieren wollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410907,
						230410909
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410907,
					"content": "Überanstreng dich nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410908
					]
				},
				{
					"id": 230410908,
					"content": "Nein, sicher nicht. Die paar Schüsseln von Minzbohnensuppe sind doch ein Klacks für mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410911
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410911,
					"content": "Also, bring Raef bitte die Minzbohnensuppe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410912
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410912,
					"content": "Ich muss auch noch ein paar Portionen für Nawaz und Ramiz zubereiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410909,
					"content": "Du steckst wirklich voller Tatkraft ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410910
					]
				},
				{
					"id": 230410910,
					"content": "Immerhin ... kann ich ja nun endlich etwas Nützliches machen, da muss ich die Gelegenheit natürlich gut ausnutzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410911
					],
					"speakerTitle": "Nermin"
				}
			]
		},
