			},
			"dialogs": [
				{
					"id": 751110101,
					"content": "Ich habe das vorhin abgeholt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751110102
					]
				},
				{
					"id": 751110102,
					"content": "Was? Hat wieder ein Idiot ein Paket verloren? Mal sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
		{
			"id": 7511102,
			"completionStepIds": [
				7511102
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7511102",
							"2"
						],
						"stepId": 7511102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110201,
					"content": "Hm ... Es scheint für Acat zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110202
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110202,
					"content": "... Und auch die Verpackung ist beschädigt. Wenn wir es senden, wie es jetzt ist, könnte der ganze Gegenstand kaputtgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110203
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110203,
					"content": "Ich muss noch die Pakete im Laden sortieren. Könntest du mir bitte helfen, ihr das zu schicken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110204
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110204,
					"content": "Sie ist die Inhaberin von „Fridas Farbpalette“. Ihr Laden befindet sich in der Arena des heiligen Feuers. Keine Sorge, du würdest das Schild ihres Ladens auf keinen Fall übersehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
		{
			"id": 7511103,
			"completionStepIds": [
				7511103
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7511103",
							"2"
						],
						"stepId": 7511103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110301,
					"content": "Das sieht aus wie die Handschrift von ... Chanca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110302
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110302,
					"content": "Das muss wieder ein Bestellungsbrief sein. Die Verpackung ist schon beschädigt, auf diese Weise können wir ihn nicht zustellen. Dieser Brief muss zurückgeschickt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110303
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110303,
					"content": "Ich muss noch die Pakete im Laden sortieren. Könntest du mir bitte helfen, ihr den Brief zurückzuschicken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110304
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110304,
					"content": "Sie ist die Inhaberin vom Gasthaus „Zur Müdigkeit“. Ihr Laden befindet sich bei der Arena des heiligen Feuers. Du wirst ihn sehen, sobald du dort bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
		{
			"id": 7511104,
			"completionStepIds": [
				7511104
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7511104",
							"2"
