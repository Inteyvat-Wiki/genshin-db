				"objectNames": [
					"Acat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751111401,
					"content": "Ja, das ist mein Paket. Jemand von den Kindern der Echos wollte Farben kaufen, konnte mir aber nicht sagen, welche Farbe er wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111402
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111402,
					"content": "Also wollte ich ihm ein paar Farbproben schicken und ihm sagen, er solle sich entscheiden, welche Farbe er haben möchte, bevor er das nächste Mal kommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111403
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111403,
					"content": "Ich schicke das besser gleich nochmal ab, bevor der Typ wieder mit seinen komischen Ideen kommt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111404
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111404,
					"content": "Ach ja, das ist für dich. Danke, dass du mir das Paket zurückgebracht hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Acat"
				}
			]
		},
