			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110501,
					"content": "... Dieser Brief ist von Fräulein Tirda, wenn ich mich nicht irre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110502
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110502,
					"content": "Wollte sie, dass es an ihren Stamm geschickt wird? Aber der Umschlag ist ... Wir können ihn nur zurückschicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110503
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110503,
					"content": "Ich muss noch die Pakete im Laden sortieren, könntest du mir bitte helfen, Fräulein Tirda den Brief zurückzuschicken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110504
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110504,
					"content": "Sie singt in der „Goldenen Abenddämmerung“. Du wirst sie dort finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
