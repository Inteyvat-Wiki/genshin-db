				"objectNames": [
					"Imix"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751111601,
					"content": "Waah! Ja, das ist das Paket, das ich verschickt habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111602
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 751111602,
					"content": "Oh, noch einmal Glück gehabt! Ich dachte schon, ich hätte es an die falsche Adresse geschickt ... Wenn das der Fall gewesen wäre, wäre ich erledigt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111603
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 751111603,
					"content": "Ich danke dir, ganz ehrlich! Bitte, die hier sind für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111604
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 751111604,
					"content": "Und ... bitte sag Fräulein Cheven nichts davon, bitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				}
			]
		},
