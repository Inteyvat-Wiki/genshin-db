					"Chanca"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751111501,
					"content": "Oh? Ja, das ist mein Bestellungsbrief. Ah, armes Ding, es hat wirklich Pech.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111502
					],
					"speakerTitle": "Chanca"
				},
				{
					"id": 751111502,
					"content": "Ich schreibe dann später noch einen, es ist nicht eilig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111503
					],
					"speakerTitle": "Chanca"
				},
				{
					"id": 751111503,
					"content": "Danke, dass du den Brief zurückgebracht hast. Du schwitzt ja! Komm, ich habe etwas zu trinken für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chanca"
				}
			]
		},
		{
			"id": 7511116,
			"completionStepIds": [
