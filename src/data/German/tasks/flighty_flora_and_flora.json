			"dialogs": [
				{
					"id": 207400401,
					"content": "Über diese Blumen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400402
					]
				},
				{
					"id": 207400402,
					"content": "Bist du fertig damit, die Blumen zu pflücken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400403
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400403,
					"content": "Ich habe sie gleich hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400404
					]
				},
				{
					"id": 207400404,
					"content": "Sie sind alle so frisch ... Danke dir! Mit diesen Blumen im Schaufenster, können wir sicher eine Menge Kunden anziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400405
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400405,
					"content": "Falls ich dich noch um etwas Kleines bitten darf ... der Wind hat auch alle Löwenzähne, die wir hatten, fortgeblasen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400406
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400406,
					"content": "Auch wenn Löwenzahn, der vom Wind davongetragen werden, nichts Schlechtes ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400407
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400407,
					"content": "Aber es erscheint trotzdem komisch, wenn ein Florist in Mondstadt keinen Löwenzahn hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400408
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400408,
					"content": "Löwenzahn kann nicht einfach gepflückt und zurückgebracht werden - er muss ganz neu aufgezogen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400409
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400409,
					"content": "Könntest du mir bitte dabei helfen, eine Ladung Löwenzahnsamen für mich zu holen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400410,
						207400412
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400410,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400411
					]
				},
				{
					"id": 207400411,
					"content": "Dann zähle ich auf dich. Ich erinnere mich, dass es viel Löwenzahn direkt vor Mondstadt gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400412,
					"content": "Wo soll ich mit der Suche beginnen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400413
					]
				},
				{
					"id": 207400413,
					"content": "Es gibt viel Löwenzahn vor der Stadt. Du solltest ihn leicht kriegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
