			"dialogs": [
				{
					"id": 207400501,
					"content": "Also, über diesen Löwenzahn ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400502
					]
				},
				{
					"id": 207400502,
					"content": "Hast du es geschafft, diesen Löwenzahn zu kriegen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400503
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400503,
					"content": "Ja, hier sind sie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400504
					]
				},
				{
					"id": 207400504,
					"content": "Dank dir. Das sollte ausreichen. Ich werde die Samen in diese Töpfe pflanzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400505
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400505,
					"content": "... Zusammen mit den Blumen, die du zuvor für mich gefunden hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400506
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400506,
					"content": "Ah, ja. Ich muss dir danken, oder? Das ist ein kleines Zeichen, bitte nimm es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400507
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400507,
					"content": "Jetzt muss ich schnell diese Pflanzen in diese Töpfe hier einpflanzen. Dann kommen die Löwenzahnsamen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
