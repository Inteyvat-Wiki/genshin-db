					"nextDialogs": [
						207400602
					]
				},
				{
					"id": 207400602,
					"content": "Du kannst Lampenkraut und Zuckerblumen im Flüsterwald finden. In Windstieg findest du Windmühlenastern und auf der Sterngreifklippe Cecilias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400603
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400603,
					"content": "In diesen Gegenden findest du sicherlich die frischesten Blumen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400604
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400604,
					"content": "Sobald du damit fertig bist, sie zu pflücken, bringe sie bitte so schnell wie möglich zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
