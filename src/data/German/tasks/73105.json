			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Niloofar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731053001,
					"content": "Hoffentlich bist du in Sicherheit, Alrani ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053002,
						731053005
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053002,
					"content": "Wie geht es Alrani an der Akademie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053003
					]
				},
				{
					"id": 731053003,
					"content": "Alrani ist eine sehr fleißige Studentin. Obwohl sie sich manchmal ... immer in merkwürdige Haarspaltereien verwickelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053004
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053004,
					"content": "Aber sie ist in jedem Fall eine fähige Studentin und ich glaube auch, dass sie definitiv eine fähige Gelehrte werden wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053005,
					"content": "Hat die Akademie hohe Anforderungen an die Aufsätze?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053006
					]
				},
				{
					"id": 731053006,
					"content": "Ehrlich gesagt, ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053007
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053007,
					"content": "Die Prüfung der Abhandlungen ist eine ... sehr komplizierte Angelegenheit. Außer, sich eine Forschungsrichtung zu überlegen, müssen die Quellen auch umfangreich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053008
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053008,
					"content": "Man muss auch die Anzahl ähnlicher Abhandlungen beachten und, ob das Forschungsthema zu Konflikten mit anderen führt. Nach dem Forschungsantrag können einem auch alle möglichen Schwierigkeiten begegnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053009
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053009,
					"content": "*seufz* Aber ich muss sagen, Alrani hat so viel Pech ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				}
			]
		},
		{
			"id": 7310531,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
