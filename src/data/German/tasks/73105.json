				"objectNames": [
					"Narzam"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731053101,
					"content": "Was nun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053102,
						731053108
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053102,
					"content": "Warum bist du zu ihr so ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053103
					]
				},
				{
					"id": 731053103,
					"content": "Zu Alrani so „nett“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053104
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053104,
					"content": "Das hast du falsch verstanden. Die Gründe, warum ich das so mache, sind sehr einfach. Erstens hat Alrani Geld bezahlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053105
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053105,
					"content": "Zweitens nehme ich nur Geld, keine Leben. Wenn ich sie in der Wildnis aussetze, verliere ich meinen guten Ruf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053106
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053106,
					"content": "Drittens ist sie sehr schlau und hat eine große Zukunft vor sich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053107
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053107,
					"content": "Ihr zu helfen, würde uns Schatzräuber vielleicht auch in einem besseren Licht dastehen lassen. Hmpf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053108,
					"content": "Wie viel Geld hat sie bezahlt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053109
					]
				},
				{
					"id": 731053109,
					"content": "Es ist kein kleiner Betrag. Sie sagte, es sei mit der Herstellung von irgendwelchem „Dünger“ verdientes Geld. Ich verstehe das nicht, habe auch kein Interesse daran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053110
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053110,
					"content": "Im Endeffekt hat sie mich bezahlt und ich helfe ihr vorübergehend. So einfach ist das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzam"
				}
			]
		},
