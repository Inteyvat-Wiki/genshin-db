			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Niloofar",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050101,
					"content": "Alrani ... Wo bist du nur hin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050102
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050102,
					"content": "Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050103
					]
				},
				{
					"id": 731050103,
					"content": "Hä? Dieser Name ... Paimon erinnert sich. Das ist doch die junge Frau, die immer Abhandlungen schreibt! Wir haben sie in Watatsumi getroffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050104,
					"content": "Richtig, sie sagte, sie habe die Akademie wegen der Sammlung von Inspirationen verlassen. Sie hätte jetzt zurück sein müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050105,
					"content": "Aber ... Diese Frau sieht verängstigt aus ... Wir sollten zu ihr gehen und fragen, was passiert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050106,
					"content": "Falls Alrani wirklich zurück an der Akademie ist, können wir auch gleich Hallo sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050107,
					"content": "Hallo, über Alrani ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050108
					]
				},
				{
					"id": 731050108,
					"content": "#Bist du {M#ein Abenteurer}{F#eine Abenteurerin} der Gilde?! Hast du herausgefunden, wo Alrani steckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050109
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050109,
					"content": "Ich weiß, dass ich oft gedrängt habe. Es tut mir wirklich leid, aber ich mache mir Sorgen um sie. Ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050110
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050110,
					"content": "Oh, immer mit der Ruhe. Wir sind nicht von der Abenteurergilde. Wir sind nur zufällig in der Gegend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050111,
					"content": "Darf ich fragen, wer du bist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050112
					]
				},
				{
					"id": 731050112,
					"content": "Ihr seid keine Abenteurer? Entschuldigt. Weil ich keine Neuigkeiten von der Gilde gehört habe, bin ich ... bin ich sehr besorgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050149
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050149,
					"content": "Du erzählst, was du mit Alrani erlebt hast ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050113
					]
				},
				{
					"id": 731050113,
					"content": "#Dann bist du also {F#die Reisende}{M#der Reisende}, von {F#der}{M#dem} Alrani die ganze Zeit spricht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050114
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050114,
					"content": "Ich bin Niloofar, Gelehrte an der Akademie ... Das habt ihr bestimmt sofort erkannt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050115
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050115,
					"content": "Obwohl ich eine Gelehrte bin, investiere ich jetzt den Großteil meiner Energie in das Unterrichten von Schülern in Forschung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050116
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050116,
					"content": "Alrani ist eine meiner Schülerinnen. Dieses Mädchen hat immer Schwierigkeiten mit dem Schreiben der Abhandlung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050117
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050117,
					"content": "Du ... Du bist Alranis Mentorin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050118
					]
				},
				{
					"id": 731050118,
					"content": "Alrani hat gesagt, dass ihr Mentor viele ihrer Abhandlungen für nicht ausreichend befunden hat und sie gezwungen war, sie nochmal neu zu schreiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050119,
					"content": "Nein, nein. Jetzt ist nicht die Zeit, um darüber zu sprechen. Was ist mit Alrani passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050120,
					"content": "Sie ... Sie ist verschwunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050121
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050121,
					"content": "Vor einer Weile kam Alrani ganz begeistert mit einer Abhandlung aus Inazuma zurück. Darin wurde Watatsumis Folklore untersucht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050122,
						731050123
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050122,
					"content": "Alrani hat so gewissenhaft recherchiert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				},
				{
					"id": 731050124,
					"content": "Ich kann sehen, dass diese Abhandlung sehr gut geschrieben ist. Sie ist in allen Belangen auf einem hohen Niveau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050125
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050125,
					"content": "Aber ... Aber sie kam zu spät zurück! Ich wollte, dass sie mir die Entwürfe im Voraus schickt, aber es kam keine Antwort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050126
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050126,
					"content": "Als sie mit der vollständigen Fassung ihrer Arbeit zurückkam, hatte jemand eine Arbeit mit genau demselben Thema eingereicht, die bereits die Vorprüfung bestanden hatte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050127
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050127,
					"content": "Obwohl ich verzweifelt versucht habe, ihr dabei zu helfen ... werden ihre Abhandlungen immer noch zurückgewiesen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050128
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050128,
					"content": "Warum? Alrani hat schon früh angefangen, Materialien zu sammeln. Wie kann das so lange gedauert haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050129,
					"content": "Warte, Inazuma ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050130,
					"content": "Das Sakoku-Dekret!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050131
					]
				},
				{
					"id": 731050131,
					"content": "Wie kann das sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050132,
					"content": "Ich weiß überhaupt nicht, wie ich ihr das sagen soll ... Ursprünglich hatte ich geplant, ein paar Tage abzuwarten und es ihr schonend beizubringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050133
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050133,
					"content": "Dann hat ihr irgendein Plappermaul alles erzählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050134
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050134,
					"content": "Danach ist sie verschwunden. Ich habe in der ganzen Akademie nach ihr abgesucht, aber konnte sie nirgends finden. Also habe ich bei der Abenteurergilde eine Mission in Auftrag geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050135
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050135,
					"content": "Aber die Abenteurer haben nur Alranis Notizbuch gefunden. Keine Spur von ihr selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050136
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050136,
					"content": "Jetzt sollten die Abenteurer noch überall nach Alrani suchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050137
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050137,
					"content": "Ich ... Ich weiß wirklich nicht, was ich tun soll. *wimmer* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050138,
						731050140
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050138,
					"content": "Ich werde auch mithelfen, nach Alrani zu suchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050139
					]
				},
				{
					"id": 731050139,
					"content": "Ja, wir helfen auch mit! Fangen wir dort an, wo das Notizbuch gefunden wurde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050142,
					"content": "Willst du mithelfen? Herzlichsten Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050143
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050143,
					"content": "Ich werde den Ort, an dem das Notizbuch gefunden wurde, auf deiner Karte markieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050144
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050144,
					"content": "Und deine Belohnung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050145,
						731050146
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050145,
					"content": "Reden wir später darüber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050147,
					"content": "Ach, danke! Ich werde hier auf Nachrichten von der Abenteurergilde warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050148
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050148,
					"content": "Hoffentlich bist du in Sicherheit, Alrani ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050146,
					"content": "Alrani wird mir sie geben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050140,
					"content": "Wo wurde das Notizbuch gefunden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050141
					]
				},
				{
					"id": 731050141,
					"content": "Wir helfen auch mit, nach Alrani zu suchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050123,
					"content": "Alrani hat sehr fleißig recherchiert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				}
			]
		},
		{
			"id": 7310505,
			"completionStepIds": [
				7310505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310505",
							"2"
						],
						"stepId": 7310505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gobley",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050501,
					"content": "Bitte hört auf, hört auf! Das ist alles ein Missverständnis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050502,
						731050505
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050502,
					"content": "Das ist kein Missverständnis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050503
					]
				},
				{
					"id": 731050503,
					"content": "Was habt ihr mit Alrani gemacht? Sagt die Wahrheit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050504,
					"content": "Sonst ... Sonst verpasst dir Paimon eine Tracht Prügel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050507,
					"content": "Nein, nein! Bitte hört mir zu. Das ist wirklich ein Missverständnis ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050508
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050508,
					"content": "Wie könnten wir es wagen, ihr etwas anzutun? Wir können ihr überhaupt nicht wehtun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050509,
						731050510
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050509,
					"content": "Was soll das heißen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050511,
					"content": "Das ist eine lange Geschichte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050512
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050512,
					"content": "Vor einer Weile waren wir sehr knapp bei Kasse, also haben wir mit unserer Chefin nachgedacht, um einen Weg zu finden, wie wir an Geld kommen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050513
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050513,
					"content": "Pff! Sicher nichts anderes als Rauben und Stehlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050514,
					"content": "N... Nun, das ist es, was Schatzräuber tun. Für uns gibt es keinen anderen Weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050515
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050515,
					"content": "Als wir im Lager Pläne schmiedeten, sahen wir plötzlich eine junge Frau mit einer großen Tasche auf das Lager zulaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050516
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050516,
					"content": "Sie sah vollkommen verzweifelt aus. Das hat uns einen ziemlichen Schrecken eingejagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050517
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050517,
					"content": "Bevor wir sie ansprechen konnten, setzte sich die junge Frau ans Lagerfeuer. Dann warf sie weinend einen Stapel Bücher ins Feuer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050518
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050518,
					"content": "Das war wirklich unheimlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050519,
						731050520
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050519,
					"content": "Ihr lasst euch von einer jungen Frau erschrecken ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050521,
					"content": "Oje, auch wenn wir Schatzräuber sind, tun wir doch niemandem weh. Meistens stehlen wir nur etwas oder heben Schätze ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050522
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050522,
					"content": "Bevor wir irgendwie reagieren konnten, warf sie uns schon einen Beutel Mora hin und wollte, dass wir sie einsperren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050523
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050523,
					"content": "Ähm, ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050524,
						731050525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050524,
					"content": "Das ist alles ein großes Durcheinander ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050526,
					"content": "Zu Beginn ... Traute sich niemand, sie anzufassen. Aber sie weigerte sich, zu essen und zu trinken, um zu erzwingen, dass wir sie einsperren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050527
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050527,
					"content": "Am Ende war es die Chefin, die uns dazu brachte, einen Käfig aus Ästen zu bauen und die junge Frau dort hinein zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050528,
						731050529
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050528,
					"content": "Ihre Chefin ist ja ganz nett ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050530,
					"content": "Nun, unsere Chefin hat immer Respekt vor gelehrten Leuten. Sie sagt immer, dass sie zur Schule gehen würde, wenn es die Möglichkeit gäbe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050531
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050531,
					"content": "Ähem, falls du es nicht glaubst ... Sie ist dort drüben. Geh und überzeuge dich selbst. Die Chefin ist bestimmt immer noch dabei, sie zu überzeugen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050532
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050532,
					"content": "Wenn du die junge Frau überreden könntest, zu gehen, wäre das eine große Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050529,
					"content": "Ihr wart sehr nett zu Alrani ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050525,
					"content": "Und dann habt ihr sie eingesperrt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050520,
					"content": "Seid ihr nicht Schatzräuber?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050510,
					"content": "Also ist Alrani bei euch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050505,
					"content": "Was habt ihr mit Alrani gemacht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050506
					]
				},
				{
					"id": 731050506,
					"content": "Sagt die Wahrheit! Sonst ... Sonst gibt’s Prügel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7310507,
			"completionStepIds": [
				7310507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310507",
							"2"
						],
						"stepId": 7310507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Narzam",
					"Alrani",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050701,
					"content": "Alrani! Kommst du jetzt raus oder nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050702
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050702,
					"content": "Ich komme nicht raus! Ich bin keine Gelehrte! Keine weiteren Forschungen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050703
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050703,
					"content": "Ich habe dir so viel Geld gegeben. Lass mich einfach in Ruhe, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050704
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050704,
					"content": "Dieses verrückte Mädchen ... Da ist Hopfen und Malz verloren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050705,
						731050706
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050705,
					"content": "Ähm ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050707
					]
				},
				{
					"id": 731050707,
					"content": "Hallo ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050708,
					"content": "Huch? Ihr seid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050709
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050709,
					"content": "#{F#Reisende}{M#Reisender}! *wimmer* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050710
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050710,
					"content": "Alrani, du bist ja tatsächlich hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050711,
						731050712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050711,
					"content": "Ein Glück! Dir ist nichts passiert ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050713
					]
				},
				{
					"id": 731050713,
					"content": "*wimmer* Sie ... Sie sind bedrohlich! Diese Abhandlung habe ich ganz klar zuerst geschrieben! Ich habe sie zuerst geschrieben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050714
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050714,
					"content": "Wäre ich in Inazuma nicht so lange aufgehalten worden, wäre meine Abhandlung früher angenommen worden! *schluchz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050715
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050715,
					"content": "Beruhige dich ... Willst du jetzt fortfahren, Abhandlungen zu schreiben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050716,
					"content": "Puh ... Puh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050717
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050717,
					"content": "Ich ... Ich schreibe einfach nicht mehr! ... Nur Idioten schreiben Abhandlungen! Ich lerne nicht mehr! Mir egal, was aus der Akademie wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050718
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050718,
					"content": "Stattdessen habe ich Narzam dafür bezahlt, mich zu beschützen. Wer will mich noch alles dazu bringen, wieder Abhandlungen zu schreiben?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050719
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050719,
					"content": "Hm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050720
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050720,
					"content": "Wer bist du ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050721
					]
				},
				{
					"id": 731050721,
					"content": "Ich bin Narzam. Ich arbeite als ... Das solltest du bereits wissen. Also werde ich dir keinen Unsinn erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050722
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050722,
					"content": "#Ich kenne dich. Du warst in letzter Zeit sehr aktiv in dieser Gegend, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050723
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050723,
					"content": "Wenn du auf der Mission bist, dieses Mädchen nach Hause zu bringen, dann geh nur und versuche, es zu überzeugen. Ich werde dich nicht daran hindern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050724
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050724,
					"content": "Hallo? Ich habe dich bezahlt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050725
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050725,
					"content": "Das Geld, das du bezahlt hast, reicht für nichts. Das reicht höchstens für ein paar Tage Verpflegung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050726
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050726,
					"content": "Ich werde auf keinen Fall wieder zurückkehren. Wenn ich zürückkehren würde, dann müsste ich wieder über Themen von Abhandlungen nachdenken und wieder überall Feldforschung betreiben. Mein Appetit würde mir vergehen und mir würden schlaflose Nächte blühen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050727
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050727,
					"content": "Ich könnte vielleicht von irgendwelchen komischen Leuten gefangen werden oder seltsamen Monstern in die Arme laufen. Dann bleibt keine Zeit, meine Abhandlung zu Ende zu schreiben, und ich verpasse den Tag, an dem ich ihn verteidigen soll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050728
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050728,
					"content": "*wimmer* ... Ich will nicht ... Ich will nicht ... Es ist immer noch besser, sich von Schatzräubern einsperren zu lassen ... *wimmer*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050729
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050729,
					"content": "#{F#Reisende}{M#Reisender}, du ... du hilfst mir, Frau Niloofar eine Nachricht zu überbringen ... Ich ... Ich schreibe dir eine Notiz ... Ich will wirklich nicht zurückgehen, verzeih mir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050738
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050738,
					"content": "Alrani begann wimmernd eine Notiz zu schreiben ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050730
					]
				},
				{
					"id": 731050730,
					"content": "Hier ... *wimmer* ... *schluchz* ... Warum nur gibt es diese Aufsätze auf dieser Welt ... *wimmer*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050731
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050731,
					"content": "... In Ordnung. Sei versichert, dass niemand kommen wird, um dich zu holen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050732
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050732,
					"content": "Alrani ... Ihre Stimmung scheint gerade sehr schwankend zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050733,
					"content": "Dann lass sie erstmal hier bleiben. Wir gehen jetzt zurück und überbringen Niloofar ihre Nachricht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050734,
						731050735
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050734,
					"content": "Aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050736
					]
				},
				{
					"id": 731050736,
					"content": "Du brauchst dir keine Sorgen zu machen. Es ist wie sie sagt. Sie hat mich schon bezahlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050737
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050737,
					"content": "Außerdem ... Außerdem haben wir endlich jemanden gefunden, der etwas gelernt hat. Sie wird noch von großem Nutzen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050735,
					"content": "Die Schatzräuber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050736
					]
				},
				{
					"id": 731050712,
					"content": "Niloofar hat uns von deiner Arbeit erzählt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050713
					]
				},
				{
					"id": 731050706,
					"content": "Darf ich stören ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050707
					]
				}
			]
		},
		{
			"id": 7310508,
			"completionStepIds": [
				7310508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310508",
							"2"
						],
						"stepId": 7310508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Niloofar",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050801,
					"content": "#{F#Reisende}{M#Reisender}! Wie ist es gelaufen? Hast du Alrani gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050802
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050802,
					"content": "Gefunden ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050823,
					"content": "Du erzählst Niloofar alles und übergibst ihr die Notiz von Alrani ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050803
					]
				},
				{
					"id": 731050803,
					"content": "Narzam? Wie kann es sie sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050804
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050804,
					"content": "Kennst du sie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050805,
					"content": "Ja ... Vielleicht nicht kennen, aber ich habe von ihr gehört. Sie ist ein merkwürdiges Mitglied der Schatzräuber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050806
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050806,
					"content": "Es heißt, dass sie den Menschen, die sie ausraubt, eine Frage stellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050807
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050807,
					"content": "Die Fragen reichen von Literatur bis zu den Elementen. Alles sehr verzwickt. Sogar ... Sogar „Gedankenverdrehen“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050808
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050808,
					"content": "Wenn du ihre Frage löst, gibt sie dir nicht nur alles zurück, was sie geplündert hat, sondern auch begleitet dich zurück in die Stadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050809
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050809,
					"content": "War sie schon immer so ein komischer Kauz ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050810,
						731050811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050810,
					"content": "Was für eine Rätselräuberin ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050812
					]
				},
				{
					"id": 731050812,
					"content": "Das weiß keiner. Ich weiß das auch nur, weil mein Mentor ihr früher in der Wildnis begegnet ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050813
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050813,
					"content": "Damals lautete Narzams Frage: „Womit kann man schnell genug einen riesigen, leeren Raum füllen?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050814
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050814,
					"content": "Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050815,
					"content": "Wind! Richtig? Bestimmt ist das richtig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050816,
					"content": "Ähm ... Kerzenlicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050817
					]
				},
				{
					"id": 731050817,
					"content": "Die Antwort meines Mentors war: „Die Elementarkräfte sind zu jeder Zeit an jedem Ort.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050818
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050818,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050819
					]
				},
				{
					"id": 731050819,
					"content": "Betrug!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050820,
					"content": "Hahaha ... Kurz gesagt, hat Narzam meinen Mentor sicher zurück in die Stadt geleitet und ihn höflich verabschiedet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050821
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050821,
					"content": "Falls sie bei Alrani ist, macht mir das keine großen Sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050822
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050822,
					"content": "Aber, dass Alrani immer dort bleibt, geht auch nicht. Ich muss mir einen Weg überlegen, ihr zu helfen, das Problem mit der Abhandlung zu lösen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050811,
					"content": "Was ist denn ihr Ziel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050812
					]
				}
			]
		},
		{
			"id": 7310530,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
