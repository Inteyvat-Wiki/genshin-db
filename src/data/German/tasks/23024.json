					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230240101,
					"content": "Endlich seid ihr beide hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240102
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240102,
					"content": "Es ist genau der richtige Zeitpunkt, alles stimmt bis ins Kleinste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240103
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240103,
					"content": "Warum so aufgeregt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240104
					]
				},
				{
					"id": 230240104,
					"content": "Heißt das etwa, dass die Rose nun anfängt, zu blühen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240105,
					"content": "#Richtig, haha! Das haben wir deiner Hilfe zu verdanken, {M#Reisender}{F#Reisende}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240106
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240106,
					"content": "Die Rose steht zwar noch nicht in voller Blüte, aber vom allgemeinen Wuchs her scheint sie sehr kräftig zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240107
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240107,
					"content": "#{M#Reisender}{F#Reisende}, wenn dich das interessiert, komm und schau es dir aus der Nähe an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240108
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240108,
					"content": "Haha, wer weiß, vielleicht blüht sie ja direkt vor euren Augen auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240109
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240109,
					"content": "Das sollte ich mir genauer ansehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240110
					]
				},
				{
					"id": 230240110,
					"content": "Wir... Wirklich? Sie erblüht so schnell?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240111,
					"content": "Ich freue mich so sehr darauf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2302402,
			"completionStepIds": [
				2302402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
