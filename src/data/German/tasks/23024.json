				"points": []
			},
			"dialogs": [
				{
					"id": 230240201,
					"content": "Ihr beiden, beugt euch bitte etwas näher herüber, dann könnt ihr alle Einzelheiten genau betrachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240202
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240202,
					"content": "Zusammen mit den beiden Kräutergärtnern beobachtest du die knospende Rose ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230240203
					]
				},
				{
					"id": 230240203,
					"content": "Keine Rührung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240204,
						230240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240204,
					"content": "Kein Zeichen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240206
					]
				},
				{
					"id": 230240206,
					"content": "Herrje ... vielleicht ist es der Rose zu peinlich, vor euren Augen aufzublühen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240207
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240207,
					"content": "Aber nach dem Wachstumsmuster von Rosen müsste sie spätestens morgen erblühen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240208
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240208,
					"content": "#{F#Reisende}{M#Reisender}, komm doch bitte morgen wieder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240205,
					"content": "Meine Beine werden schon taub ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240206
					]
				}
			]
		},
		{
			"id": 2302404,
			"completionStepIds": [
				2302404
