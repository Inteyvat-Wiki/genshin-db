			},
			"dialogs": [
				{
					"id": 230240701,
					"content": "#{M#Reisender}{F#Reisende}, du kommst gerade rechtzeitig, die Rose blüht endlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240702
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240702,
					"content": "Dank deiner Hilfe gedeiht diese Rose besser als alle, die ich je gesehen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240703
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240703,
					"content": "Die Ärzte vom „Bimarstan“ werden sicher begeistert sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240704
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240704,
					"content": "Wir haben keine Zeit zu verlieren, die Rose muss raus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240705
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240705,
					"content": "Warte, was ist da los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240706
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240706,
					"content": "Auf dem Blumenfeld bricht eine seltsame Unruhe aus ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230240707
					]
				},
				{
					"id": 230240707,
					"content": "Waaah! Das ist eine Vaniloqua! Wie ist die hierhergekommen?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240708,
					"content": "Oh nein! Das Blumenfeld! Sie verwüstet das Blumenfeld!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240709,
						230240710
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240709,
					"content": "Ich werde mich darum kümmern!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240711
					]
				},
				{
					"id": 230240711,
					"content": "Äh ... Was? Die Vaniloqua ... Wieso rennt sie denn weg?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240712,
					"content": "Wie ... Wie ist das nur möglich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240713
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240713,
					"content": "Die Rose, unser wichtigstes Heilkraut, hat sich in ein Monster verwandelt und ist abgehauen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240714,
						230240715
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240714,
					"content": "Das war gar keine „Verwandlung“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240716
					]
				},
				{
					"id": 230240716,
					"content": "Du meinst, die Vaniloqua war der Grund für das langsame Wachstum dieser Rose?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240717
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240717,
					"content": "Jetzt, da du’s sagst! Der Dünger war vollkommen nutzlos ... und die doppelte Menge Wasser ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240718
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240718,
					"content": "Wir ... Wir haben uns die ganze Zeit um diese Vaniloqua gekümmert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240719
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240719,
					"content": "Verdammt ... Wie ist sie nur zwischen die Blumen gekommen, ich habe es nicht einmal bemerkt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240720
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240720,
					"content": "Auch wir werden manchmal überlistet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240721
					]
				},
				{
					"id": 230240721,
					"content": "Oje, jetzt sind wir in ernsten Schwierigkeiten. Das Heilkräuterfeld wurde auch komplett verwüstet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240722
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240722,
					"content": "Uns bleibt nur, den Ärzten im „Bimarstan“ die Situation zu erklären und so schnell wie möglich eine neue Ladung anzupflanzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240715,
					"content": "Vielleicht war es von Anfang an ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240716
					]
				},
				{
					"id": 230240710,
