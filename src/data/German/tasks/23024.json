				"points": []
			},
			"dialogs": [
				{
					"id": 230240401,
					"content": "#{F#Reisende}{M#Reisender}, ihr kommt gerade richtig, die Rose blüht endlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240402
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240402,
					"content": "Dank deiner Hilfe gedeiht diese Rose besser als alle, die ich je gesehen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240403
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240403,
					"content": "Ich bin euch wirklich überaus dankbar. Bitte nimm dieses Geschenk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240404
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240404,
					"content": "Gratulation!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240405
					]
				},
				{
					"id": 230240405,
					"content": "Die Rose erblüht und unsere Herzen mit ihr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240406,
					"content": "Uff ... Damit können wir die Rosen doch noch rechtzeitig ins „Bimarstan“ liefern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240407
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240407,
					"content": "Ich hoffe, die Rose kann ihnen helfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
