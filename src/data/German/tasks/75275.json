					"nextDialogs": [
						752750304
					],
					"speakerTitle": "Steintafel"
				},
				{
					"id": 752750304,
					"content": "... auch wenn ich falle, bevor ich das vollende ... sollen die anderen weitermachen ... — Gloharry",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Steintafel"
