			"dialogs": [
				{
					"id": 752750201,
					"content": "(Eine alte Steintafel. Die Inschrift ist größtenteils verwittert.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752750202
					],
					"speakerTitle": "Steintafel"
				},
				{
					"id": 752750202,
					"content": "... Kiongozi ist nun seit über zehn Jahren fort ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752750203
					],
					"speakerTitle": "Steintafel"
				},
				{
					"id": 752750203,
					"content": "... Ein großer Sieg ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752750204
					],
					"speakerTitle": "Steintafel"
				},
				{
					"id": 752750204,
					"content": "... Dieser Altar wurde errichtet ... zum Gedenken an die Gefallenen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Steintafel"
				}
			]
		},
