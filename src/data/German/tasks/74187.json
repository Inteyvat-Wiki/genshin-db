			"dialogs": [
				{
					"id": 741870901,
					"content": "Es scheint, als hättest du unser vorheriges Problem erfolgreich gelöst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870902
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870902,
					"content": "Jetzt wirst du dich bestimmt auf den Weg zum nächsten Ziel machen, habe ich recht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870903
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870903,
					"content": "So ist es, Este, ich überlasse die Sache hier dir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870904
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741870904,
					"content": "Viel entscheidender ist es, auf die eigene innere Stimme zu hören, anstatt die Maßstäbe für Recht und Unrecht Phobos oder irgendeinem Harmosten zu überlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870905
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741870905,
					"content": "Der Sebastos hatte Phobos erschaffen, um uns aus der Knechtschaft des Schicksals zu befreien. Aber das blinde Vertrauen der Menschen stürzt uns in eine noch furchtbarere Unterjochung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870906
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741870906,
					"content": "In der Zukunft wirst du vielleicht vor einer ähnlichen Entscheidung stehen. Hoffentlich wirst du dann in der Lage sein, die richtige Wahl zu treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870907
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741870907,
					"content": "Herr Cassiodor, warum sprichst du plötzlich von diesen Dingen ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870908
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870908,
					"content": "Dennoch werde ich deine Worte beherzigen. Ich, Este, werde an meinem eigenen Sinn für Gerechtigkeit festhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870909
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870909,
					"content": "Sehr gut. Dann auf Wiedersehen. Ich hoffe, wir werden uns wieder begegnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Os"
				}
			]
		},
