			"dialogs": [
				{
					"id": 741870801,
					"content": "Bist du am Ende doch ein gerissener Barbar, der sich unter uns gemischt hat, um uns mit deinem Gerede zu täuschen!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870802
					],
