			"dialogs": [
				{
					"id": 741870201,
					"content": "He, du Dummkopf! Wie kommt es, dass immer noch so viele Schätze hier sind? Du lahme Schnecke ... wie lange soll das noch dauern!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870202
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870202,
					"content": "Nein, Boss! Diese Schätze sind einfach zu schwer! Wir haben schon einen ganzen Tag lang geschleppt, und es sind immer noch so viele hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870203
					],
					"speakerTitle": "Der Kerl, der „Dummkopf“ genannt wird"
				},
				{
					"id": 741870203,
					"content": "Was nutzt dir deine imposante Statur, wenn du dich so anstellst! Das sind Schätze, Mann, klar, dass die schwer sind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870204
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870204,
					"content": "Außerdem haben wir all diese Schätze den verfluchten Barbaren abgeluchst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870205
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870205,
					"content": "Es ist, als würde man Perlen vor die Säue werfen, würde man diesem Geschmeiß solche Reichtümer überlassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870206
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870206,
					"content": "Aber wenn wir diese Schätze alle zurück nach Remuria bringen wollen, bleibt uns nichts übrig, als weitere Schiffe hierher zu entsenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870207
					],
					"speakerTitle": "Der Kerl, der „Dummkopf“ genannt wird"
				},
				{
					"id": 741870207,
					"content": "Hast du eigentlich Grütze im Kopf? Mit Frachtschiffen des Reiches können wir solche Waren unmöglich transportieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870208
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870208,
					"content": "Wenn das so ist, zerstören wir doch, was wir nicht tragen können! Dann fällt es wenigstens nicht den Barbaren in die Hände!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870209
					],
					"speakerTitle": "Der Kerl, der „Dummkopf“ genannt wird"
				},
				{
					"id": 741870209,
					"content": "Hm, dieses Gespräch kommt Paimon irgendwie bekannt vor ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870210,
						741870211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870210,
					"content": "Als wir gerade in Petrichor ankamen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870212
					]
				},
				{
					"id": 741870212,
					"content": "Genau! Die Pechvögel von Abenteurern, die wir letztens verjagt haben, haben doch etwas Ähnliches gesagt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870213,
					"content": "Und diesmal klingt es noch übertriebener!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870214,
					"content": "Die Kerle werden sich doch nicht in Golems verwandelt haben, nachdem ihr Boot untergegangen war!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870215,
					"content": "Wie auch immer, es ist gruselig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870216,
					"content": "Seid ihr aus der neunten Legion? Was macht ihr hier? Die neunte Legion sollte doch bereits zum Fort Charybdis zurückbeordert sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870217
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870217,
					"content": "He, Este! Du wirst uns doch nicht den Spaß verderben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870218
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870218,
					"content": "Jedenfalls ist es leichter, mit diesen Barbaren fertig zu werden, als mit einer Ladung toter Fische. Also lass uns hier noch etwas unseren Spaß haben, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870219
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870219,
					"content": "Diese Schätze ... *seufz* Ich habe keine Ahnung, was für Anweisungen euer verantwortlicher Harmost gegeben hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870220
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870220,
					"content": "Aber hat uns nicht der Sebastos aufgetragen, diese unwissenden Stämme zu unterwerfen, um die Ketten ihres Schicksals zu sprengen? Was ihr da macht ... stellt ohne jeden Zweifel ein Verbrechen dar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870221
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870221,
					"content": "Ah? Aber unser Kommandant, der große Boethius, hat uns befohlen, diese Barbaren gnadenlos zu bestrafen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870222
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870222,
					"content": "Zudem wurden wir nicht gemaßregelt, was bedeutet, dass sowohl Phobos als auch der Sebastos unserem Vorgehen zustimmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870223
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870223,
					"content": "Was soll also dein Gerede von Verbrechen ...? Hast du vor, uns Ärger zu machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870224
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870224,
					"content": "Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870225
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870225,
					"content": "Hm, wie es aussieht, gibt es hier auch einen Este. Die Sache wird immer komischer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870226,
					"content": "Es scheint nun an der Zeit, die Frage von vorhin zu beantworten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870227
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741870227,
					"content": "Der Este, den ihr in der Stadt angetroffen habt, ist ein Nachkomme des Volkes von Remuria. Seine Vorfahren schlossen sich damals mit mir dem neu gegründeten Reich an und wurden zu gewöhnlichen Einwohnern Fontaines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870228
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741870228,
					"content": "Deswegen hätte die Sinfonie, die dafür gedacht ist, die Seelen der Menschen Fontaines zu fangen, auf ihn keine Wirkung. Die Melodie jedoch, die die Erinnerungen seiner Ahnen trägt, hat sich, da sie keinen Zufluchtsort fand, jener Statue angeschlossen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870229
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741870229,
					"content": "Dann ist es also so, dass der Este hier eigentlich der Ahn von dem Este in der Stadt und somit der echte gewitzte Este ist? Aber was ist mit den anderen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870230,
					"content": "Sie sind alle Seelen, die in alten Erinnerungen verloren gingen und jetzt hier herumirren. Lass uns hingehen und nachsehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870231
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741870231,
					"content": "Ihr geht zusammen mit Herrn Os hinüber ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741870232
					]
				},
				{
					"id": 741870232,
					"content": "Hallo, Este!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870233,
					"content": "Oh, hallo. Wer seid ihr denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870234
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870234,
					"content": "Ihr seht nicht wie Menschen von Remuria aus. Seid ihr etwa Barbaren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870235,
						741870236
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870235,
					"content": "Wir sind nur auf der Durchreise.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870237
					]
				},
				{
					"id": 741870237,
					"content": "Das hier ist ein sehr gefährliches Schlachtfeld. Wer auch immer ihr seid, verschwindet besser schleunigst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870238
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870238,
					"content": "Este, ich bin es. Lange nicht gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870239
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741870239,
					"content": "... Meine Güte, Herr Cassiodor! Man sieht selten, wie du dich in dieser Gestalt zeigst. Ich hätte dich beinahe nicht erkannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870240
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870240,
					"content": "Und die zwei hier ... sind doch wohl deine Gefolgsleute?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870241,
						741870242
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870241,
					"content": "So könnte man es sagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870245
					]
				},
				{
					"id": 741870245,
					"content": "Dennoch, Herr Cassiodor, was führt dich hierher? Hat dich der Sebastos nicht entsandt, um ... Argh, wieso fällt es mir nicht mehr ein. Ich träume doch nicht etwa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870246
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870246,
					"content": "Genau so scheint es zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870247
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741870247,
					"content": "Haha! Deine Witze sind die besten. Ich nehme an, der Sebastos hat dir wieder einen geheimen Auftrag anvertraut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870248
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870248,
					"content": "Gut geraten. Apropos, warum bewachen die Soldaten der neunten Legion diese Ketten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870249
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741870249,
					"content": "Ketten ... Du meinst diese Schätze? Es scheint, sie haben die beim Gefecht geplündert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870250
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870250,
					"content": "Obwohl der Sebastos den Krieg als ein notwendiges Übel ansah, um unsere ehrgeizigen Ziele zu erreichen, hat er diese grausamen Verhaltensweisen schon längst verboten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870251
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870251,
					"content": "Aber wie du weißt, ist das eine alltägliche Sache ... Wir eilen auf einem Weg in Richtung Dunkelheit, aber den Leuten ist das nicht bewusst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870252
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870252,
					"content": "Herr Cassiodor, was ist eigentlich passiert? Phobos sollte uns eigentlich Glück bringen, aber jetzt spüre ich nichts als unerklärliches Leid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870253
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870253,
					"content": "Auch ich suche nach einer Antwort auf diese Frage. Aber vermutlich müssen wir uns zuerst um die vorrangigen Dinge kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870254
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741870254,
					"content": "Ja, trotzdem sind diese Leute Mitglieder unserer Legion. Also lasst uns die Sache lieber friedlich klären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Este"
				},
				{
					"id": 741870242,
					"content": "#Tatsächlich bin ich Paimons Halter{F#in}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870243
					]
				},
				{
					"id": 741870243,
					"content": "... Hä?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870244
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870244,
					"content": "#Ähm, he! {NICKNAME}, mach die Sache nicht komplizierter als sie ist! {M#Er}{F#Sie} hat nur einen kleinen Witz gemacht. Sprich weiter, Este.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870236,
					"content": "Ja, ich habe auch eine barbarische Seite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870237
					]
				},
				{
					"id": 741870211,
					"content": "... und diese Schatzräuber trafen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870212
					]
				}
			]
		},
		{
			"id": 7418706,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
