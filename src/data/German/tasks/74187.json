					"Anführer der Truppe",
					"Der Kerl, der „Dummkopf“ genannt wird",
					"Este"
				],
				"points": [
					{
						"sceneId": 11,
						"position": [
							1641.498,
							588.635,
							4626.62
						],
						"pointId": 3
					}
				]
			},
			"dialogs": [
				{
					"id": 741870601,
					"content": "Ähem, Soldaten der neunten Legion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870602,
					"content": "Äh? Wer seid ihr denn? Ihr seid doch nicht etwa von Este zu Hilfe gerufen worden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870603,
						741870605,
						741870607
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870603,
					"content": "Das wurden wir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870604
					]
				},
				{
					"id": 741870604,
					"content": "Wir sind nicht einfach irgendwelche Helfer, sondern ziemlich starke! Wir sind zusammen mit Herrn Cassiodor hierhergekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870609,
					"content": "#(Offensichtlich haben {NICKNAME} und Paimon ein Talent für Schauspielerei.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870610
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741870610,
					"content": "Oh ... Der große Herr Cassiodor? Wie ich hörte, wollte der Sebastos ihn nach Aremorica schicken. Kann er denn so schnell schon wieder zurück sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870611
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870611,
					"content": "Also das ... eigentlich ist das hier neben uns ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870612,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870613
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741870613,
					"content": "Ähem ... Jedenfalls sind wir hier, um die Lage der Legionen an der Front zu begutachten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870614,
					"content": "Aha, das dachte ich mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870615
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870615,
					"content": "Obwohl wir uns noch nicht dem Großteil der Truppen auf dem Weg zum Fort Charybdis angeschlossen haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870616
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870616,
					"content": "... Ist es für die Nachhut nur vernünftig, sich um die abschließenden Aufräumarbeiten zu kümmern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870617
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870617,
					"content": "Ist das auch ein Befehl von Phobos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870618
					]
				},
				{
					"id": 741870618,
					"content": "Also ... Phobos sollte eigentlich jede unserer Handlungen anführen, aber seit unserer Ankunft hier, sind wir oft außerstande, die Melodie von Phobos zu vernehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870619
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870619,
					"content": "Also bleibt uns nichts, als nach der Order von Herrn Boethius vorzugehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870620,
						741870623
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870620,
					"content": "Also dieser unhöfliche Kerl ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870621
					]
				},
				{
					"id": 741870621,
					"content": "He, du! Jetzt hast du dich aber in der Wortwahl über Herrn Boethius vergriffen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870622
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870622,
					"content": "Als ehrwürdiger Harmost handelt Herr Boethius stets im Einklang mit den Anweisungen des Sebastos. Seine Anweisungen stehen auf der gleichen Stufe wie die Gesetze des Phobos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870626,
					"content": "Schon möglich, dass auch Phobos Fehler unterlaufen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870627
					]
				},
				{
					"id": 741870627,
					"content": "Bist du denn aus Remuria? Weißt du etwa nicht, dass es die unfehlbare Prophetin und der allmächtige Sebastos selbst waren, die Phobos erschaffen haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870628,
					"content": "Aber ihr habt die Melodie von Phobos doch nicht vernommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870629
					]
				},
				{
					"id": 741870629,
					"content": "Hm ... das stimmt, aber wem, außer Phobos, sollen wir denn sonst glauben ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870630
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870630,
					"content": "Wenn wir wirklich auf den Holzweg geraten sind, wieso bleibt er dann gleichgültig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870623,
					"content": "Der Sebastos hat euch nicht aufgetragen, unschuldige Menschen zu verletzen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870624
					]
				},
				{
					"id": 741870624,
					"content": "Unschuldige verletzen ... Zwar war es, bevor der Krieg begann, der Befehl des Sebastos, diesen zerbrechlichen Menschen Beistand zu leisten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870625
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870625,
					"content": "Doch nun erfährt unser Handeln durch Phobos eine stillschweigende Duldung. Kann es sein, dass Phobos’ Gesetze nicht mit dem heiligen Willen des Sebastos übereinstimmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870605,
					"content": "Wir sind Sondergesandte seiner Majestät, des Sebastos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870606
					]
				},
				{
					"id": 741870606,
					"content": "Sondergesandte? Oh ... stimmt schon. Wir sind zusammen mit Herrn Cassiodor hierhergekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870607,
					"content": "Wir sind Cassiodors Gefolgsleute.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870608
					]
				},
				{
					"id": 741870608,
					"content": "Stimmt, wir sind die Gefolgsleute des großen Cassiodor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				}
			]
		},
