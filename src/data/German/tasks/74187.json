				"points": []
			},
			"dialogs": [
				{
					"id": 741870701,
					"content": "Na gut ... Du hast recht, wir müssen wirklich unser Handeln überdenken. Aber ich weiß auch nicht, wie es dazu kommen konnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870702
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870702,
					"content": "Seit dem Ausbruch des Krieges habe ich ständig ein seltsames Gefühl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870703
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870703,
					"content": "Eigentlich strebten wir nur nach Freiheit und Glück, doch Phobos lenkte uns Schritt für Schritt an diesen Ort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870704
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870704,
					"content": "Könnte etwas schiefgelaufen sein ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870705
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870705,
					"content": "Falls ihr auf eurer Rückreise dem Sebastos begegnet, berichtet ihm bitte davon, wie die Situation hier ist, und lasst ihn von unseren Zweifeln wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870706
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870706,
					"content": "Damit tust du uns einen wirklich großen Gefallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870707
					],
					"speakerTitle": "Anführer der Truppe"
				},
				{
					"id": 741870707,
					"content": "Ja, das werden wir ganz bestimmt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
