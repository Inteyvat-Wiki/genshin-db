				]
			},
			"dialogs": [
				{
					"id": 708090301,
					"content": "(Im Vogelnest liegen viele lose Papierstreifen, auf denen scheinbar wirre Kritzeleien zu sehen sind ...)",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090302
					]
				},
				{
					"id": 708090302,
					"content": "Diese Papierschnipsel ... Haben sie die etwa extra zerrissen, um ihr Nest zu bauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090303,
					"content": "Da scheinen noch Wörter daraufzustehen. Sollen wir sie zusammensetzen und sehen, was darauf zu lesen ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090304,
					"content": "Am Ende müssen wir es also doch selbst zusammensetzen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090305
					]
				},
				{
					"id": 708090305,
					"content": "Bist du denn gar nicht neugierig? Vielleicht ist es eine Schatzkarte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090306,
					"content": "Unter Paimons ständigem Drängen setztest du die Papierschnipsel zusammen ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090307
					]
				},
				{
					"id": 708090307,
					"content": "Lass Paimon mal sehen ... Das ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090308,
					"content": "Das ... Ist das etwa ... ein „Verbrechensplan“?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090309,
						708090311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090309,
					"content": "Wessen Verbrechensplan würde denn von einem Vogel fortgetragen werden!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090310
					]
				},
				{
					"id": 708090310,
					"content": "Aber ... Aber in Romanen passiert so was doch ständig! Ein todsicherer Plan, der dann ausgerechnet an der unwahrscheinlichsten Stelle scheitert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090313,
					"content": "Sollen wir uns mal in der Taverne in der Nähe umhören? Vielleicht hat ja jemand etwas von „einem in naher Zukunft geplanten Verbrechen“ oder so was gehört ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090311,
					"content": "Es ist besser, auf das Unerwartete vorbereitet zu sein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090312
					]
				},
				{
					"id": 708090312,
					"content": "Du ... Du hast recht. Man muss auf alles vorbereitet sein ... Wenn wirklich jemand ein Verbrechen plant, ist es hinterher zu spät zum Bereuen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7080904,
			"completionStepIds": [
				7080907
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
