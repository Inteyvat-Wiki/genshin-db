				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lohen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708090501,
					"content": "Oh? Das klingt interessant, lass mal sehen ... Hmm, für die Kreativität gebe ich sechs Punkte, aber für die Umsetzbarkeit wohl eher vier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090502
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090502,
					"content": "Ist ... Ist das ein „Verbrechensplan“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090503,
					"content": "Haha. Eigentlich bin ich vom Lager hierhergelaufen, weil ich gehört habe, dass hier jemand seltsame „Verbrechenspläne“ ausheckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090504
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090504,
					"content": "... Aber nachdem ich diese Seite mit Notizen gesehen habe, weiß ich ungefähr, wie diese Gerüchte entstanden sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090505
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090505,
					"content": "Diesen „Verbrechensplan“ überlassen wir dem Ritterorden. Wenn du später Zeit hast, komm doch mal bei meinem Lager vorbei. Vielleicht gibt es ja ein unterhaltsames Spektakel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				}
			]
		}
	]
}