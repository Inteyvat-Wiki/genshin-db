				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Uchida Kotaro"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708090401,
					"content": "Das ... Das ist ... meine „Vorgehensweise“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090402
					],
					"speakerTitle": "Uchida Kotaro"
				},
				{
					"id": 708090402,
					"content": "#{NICKNAME}! Er hat es einfach zugegeben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090403,
					"content": "Ah! Bitte versteh das nicht falsch! Das ist nur ein Trick, den ich in meinen nächsten Roman schreiben wollte. Die Idee ist mir gekommen, als ich letztens etwas getrunken habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090404
					],
					"speakerTitle": "Uchida Kotaro"
				},
				{
					"id": 708090404,
					"content": "Doch als ich wieder nüchtern war, war die Seite verschwunden ... Ich dachte schon fast, ich hätte das alles nur geträumt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090405
					],
					"speakerTitle": "Uchida Kotaro"
				},
				{
					"id": 708090405,
					"content": "Jedenfalls, vielen Dank, dass du mir geholfen hast, sie wiederzufinden. Jetzt sollte mein Roman problemlos fertig werden. Wenn es so weit ist, schenke ich dir als Erstes ein Exemplar! Mit Signatur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uchida Kotaro"
				}
			]
		},
		{
			"id": 7080905,
			"completionStepIds": [
				7080906
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7080906",
							"2"
						],
						"stepId": 7080906,
						"stateName": "QUEST_STATE_UNFINISHED"
