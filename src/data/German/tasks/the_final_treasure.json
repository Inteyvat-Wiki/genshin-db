							"7902710",
							"2"
						],
						"stepId": 7902710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Fleischklops“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790271001,
					"content": "„Kosekimaru“, „Kosekimaru“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271002,
					"content": "Wir haben den Schatz gefunden! Schau, es ist ein Modell eines Piratenschiffs! Ausnahmsweise liegt dein Instinkt richtig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271003,
					"content": "Übrigens, was war die zweite Sache, die du uns vorhin mitteilen wolltest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271004,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271005
					],
					"speakerTitle": "„Fleischklops“"
				},
				{
					"id": 790271005,
					"content": "„Kosekimaru“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271006,
					"content": "(Das Schiff mit dem Namen „Kosekimaru“ antwortet nicht ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271007,
						790271008
					],
					"speakerTitle": "„Fleischklops“"
				},
				{
					"id": 790271007,
					"content": "Paimon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790271009
					]
				},
				{
					"id": 790271009,
					"content": "... Er sagte, er würden es uns mitteilen, wenn wir zurückkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271010,
					"content": "„Kosekimaru“ ... Du Lügner!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271008,
					"content": "„Kosekimaru“ kann nicht mehr sprechen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790271009
					]
				}
