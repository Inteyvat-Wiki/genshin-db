				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Fleischklops“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790270601,
					"content": "Das war knapp, Paimon hatte das Gefühl, wir würden gleich versinken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270602,
					"content": "„Kosekimaru“, fantastisch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270603,
					"content": "#Haha, ein sprechendes Boot ist nur ein Boot, es ist {NICKNAME} der geschickte Steuermann, der es durch das Gewitter schafft, der wirklich zählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270604,
						790270605
					],
					"speakerTitle": "„Fleischklops“"
				},
				{
					"id": 790270604,
					"content": "Möchtest du es noch einmal tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270606
					]
				},
				{
					"id": 790270606,
					"content": "Haha, lieber nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270607
					],
					"speakerTitle": "„Fleischklops“"
				},
				{
					"id": 790270607,
					"content": "Ich fürchte, das Gewitter vorhin war auf meinen Einfluss zurückzuführen. Es scheint also, dass die Umgebung des Meeres weniger stabil geworden ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270608
					],
					"speakerTitle": "„Fleischklops“"
				},
				{
					"id": 790270608,
					"content": "#Aber das ist auch gut so ... {NICKNAME}, Paimon, der Schatz ist da oben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270609
					],
					"speakerTitle": "„Fleischklops“"
				},
				{
					"id": 790270609,
					"content": "Ist das nicht der Ort, an dem wir das erste Mal nach dem Schatz gesucht haben? Und dort oben lag nur die kaputten Hälfte von „Kosekimaru“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270610,
					"content": "Diesmal muss es dort oben einen Schatz geben, es fühlt sich an wie ... wie heißt das Wort noch gleich, es ist wie ein „Piratenschiff-Instinkt“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270611
					],
					"speakerTitle": "„Fleischklops“"
				},
				{
					"id": 790270611,
					"content": "Übrigens ... Du sagtest, du hättest uns zwei Dinge zu sagen, richtig? Das eine ist, dass du dich an deinen Namen erinnert hast, und was ist das andere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270612,
					"content": "Hahaha, ich dachte schon, du hättest es vergessen. Ich sage es dir, wenn ihr zurückkommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Fleischklops“"
				},
				{
					"id": 790270605,
					"content": "Danke für das Kompliment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270607
					]
				}
			]
		},
		{
			"id": 7902710,
			"completionStepIds": [
				7902708,
				7902710
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
