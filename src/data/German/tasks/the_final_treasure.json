	"talks": [
		{
			"id": 7902701,
			"completionStepIds": [
				7902701
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902701",
							"2"
						],
						"stepId": 7902701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Fleischklops“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790270101,
					"content": "He, da seid ihr ja. Ich dachte, ihr fliegt jeden Tag mit euren Flügeln über die Inseln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270102
					],
					"speakerTitle": "„Fleischklops“"
				},
				{
					"id": 790270102,
					"content": "Und habt euren alten Kumpel „Fleischklops“ vergessen, der sich im Wasser wälzte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270103
					],
					"speakerTitle": "„Fleischklops“"
				},
				{
					"id": 790270103,
					"content": "Und da sind wir, um dich zu besuchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270104,
					"content": "Übrigens, was war es, bei dem du vorhin gesagt hast, dass du Hilfe brauchst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270105,
					"content": "Es ist eigentlich nichts Wichtiges ... Beim letzten Mal habt ihr mir geholfen, Teile meines Körpers zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270106
					],
					"speakerTitle": "„Fleischklops“"
				},
				{
					"id": 790270106,
					"content": "Ich weiß nicht, ob es daran liegt, dass sich einige meiner Wünsche erfüllt haben, oder daran, dass die Kraft in diesem Meer, die es mir erlaubt zu sprechen, schwächer geworden ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270107
					],
					"speakerTitle": "„Fleischklops“"
				},
				{
					"id": 790270107,
					"content": "In letzter Zeit bin ich selten wach und schlafe immer mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270108,
						790270109
					],
					"speakerTitle": "„Fleischklops“"
				},
				{
					"id": 790270108,
					"content": "Hat das etwas mit diesem Apparat zu tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270110
					]
				},
				{
					"id": 790270110,
					"content": "#Ich sehe, dank welchem Apparat ich in der Lage war, mich in deinen Wellenreiter zu verwandeln, {NICKNAME}, und auch mit dir zu sprechen und zu kommunizieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270111
					],
					"speakerTitle": "„Fleischklops“"
				},
				{
					"id": 790270111,
					"content": "Ah ... Wenn die Wirkung des Apparats vorbei ist, wird „Fleischklops“ nicht mehr sprechen können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270112,
					"content": "#{NICKNAME}, wir müssen uns schnell etwas einfallen lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270113,
					"content": "Haha, das ist nicht nötig, Paimon ... Ich bin sehr zufrieden, dass ich so mit euch reden kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270114
					],
					"speakerTitle": "„Fleischklops“"
				},
				{
					"id": 790270114,
					"content": "Nun ... Wenn man darüber nachdenkt, ist es ein Traum, ein Schiff zu sein und so frei mit euch kommunizieren zu können, wie ich es in den letzten paar Tagen getan habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270115
					],
					"speakerTitle": "„Fleischklops“"
				},
				{
					"id": 790270115,
					"content": "Aber ich möchte noch um eine Sache bitten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270116
					],
					"speakerTitle": "„Fleischklops“"
				},
				{
					"id": 790270116,
					"content": "Natürlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270117
					]
				},
				{
					"id": 790270117,
					"content": "Wie ich schon sagte, würde ich gerne mit euch allen eine Fahrt auf dem Meer machen, nachdem mein Körper gefunden wurde, aber da mein Körper bereits ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270125
					],
					"speakerTitle": "„Fleischklops“"
				},
				{
					"id": 790270125,
					"content": "Und der größte Teil des Schatzes wurde bereits weggenommen, sodass nichts Wertvolles für euch übrig blieb ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270118
					],
					"speakerTitle": "„Fleischklops“"
				},
				{
					"id": 790270118,
					"content": "Aber dieses Mal, das schwöre ich beim Namen des großen Piratenschiffes, wird es einen tollen großen Schatz geben! Betrachte dich noch einmal als von mir ausgetrickst und folge mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270119
					],
					"speakerTitle": "„Fleischklops“"
				},
				{
					"id": 790270119,
					"content": "#{NICKNAME}, „Fleischklops“ wird vielleicht bald nicht mehr sprechen können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270120,
					"content": "#Und ... da ist ein Schatz! Gehen wir gemeinsam hin, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270121,
						790270122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270121,
					"content": "Ein hoffnungsloser Fall ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270123
					]
				},
				{
					"id": 790270123,
					"content": "Gut, lasst uns in See stechen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270124,
					"content": "Also, dann komm bitte sofort an Bord!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Fleischklops“"
				},
				{
					"id": 790270122,
					"content": "Da du das gesagt hast ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270123
					]
				},
				{
					"id": 790270109,
					"content": "Du bist durch das Ausschalten der Maschine betroffen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270110
					]
				}
			]
		},
		{
			"id": 7902706,
			"completionStepIds": [
				7902706
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902706",
							"2"
						],
						"stepId": 7902706,
						"stateName": "QUEST_STATE_UNFINISHED"
