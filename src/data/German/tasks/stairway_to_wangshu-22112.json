			},
			"dialogs": [
				{
					"id": 221120201,
					"content": "Hast du die Bretter gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120202
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221120202,
					"content": "Noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120203
					]
				},
				{
					"id": 221120203,
					"content": "Sie sind unten außerhalb des Gasthauses. Du kannst sie nicht verfehlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120204
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221120204,
					"content": "Ich bleibe solange hier und passe auf, dass keinem ein Unglück passiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				}
			]
		},
