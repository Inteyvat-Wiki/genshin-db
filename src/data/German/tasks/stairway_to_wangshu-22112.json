			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai’an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221120501,
					"content": "Perfekt! Jetzt sollte keiner mehr Angst haben herunterzufallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120502
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221120502,
					"content": "Passt irgendwie nicht so zur eigentlichen Treppe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120503
					]
				},
				{
					"id": 221120503,
					"content": "Passt nicht, sagst du? Da kann ich nicht viel machen. Ich bin ja auch kein Profi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120504
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221120504,
					"content": "Aber warte, das war ja nur die eine Stelle. Eine andere muss noch repariert werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120505
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221120505,
					"content": "Für heute reicht es aber erst einmal. Das Gasthaus ist geöffnet und ich muss mich auch wieder um die Gäste kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120506
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221120506,
					"content": "Selbst mit Problemen bei der Treppe muss das Geschäft weiterlaufen. Danke für deine Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				}
			]
		}
	]
