			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai’an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221120101,
					"content": "Scheint wohl doch repariert werden zu müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120102
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221120102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120103
					]
				},
				{
					"id": 221120103,
					"content": "Oh, du bist es. Sieh selbst, die Treppe zum Gasthaus ist kaputt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120104
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221120104,
					"content": "Sieht richtig schlimm aus. Da könnte einer noch hinfallen und hinunterpurzeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120105
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221120105,
					"content": "Wie das passiert ist? Tja, eine Gruppe Monster hat versucht, zum Gasthaus zu gelangen. Ich habe sie verscheucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120106
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221120106,
					"content": "Ich hätte mich wohl ein wenig bremsen sollen. Einem richtig großen hab ich nämlich eine verpasst, dass er bis auf die Treppe geschleudert wurde. Da ging sie natürlich kaputt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120107
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221120107,
					"content": "Ich wollte sie zwar die ganze Zeit reparieren, habe aber nie die Zeit dafür gefunden. Jetzt kommen immer mehr Gäste, da muss die Treppe auf jeden Fall repariert werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120108
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221120108,
					"content": "Das geht auch ganz fix. Ich schaff das gut allein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120109
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221120109,
					"content": "Ich brauche aber ein paar Bretter dafür. Meinst du, du könntest mir welche besorgen? Ich bleibe solange hier, damit keiner aus Versehen hineintritt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120110,
						221120113
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221120110,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120111
					]
				},
				{
					"id": 221120111,
					"content": "Prima! Ich habe schon extra einige Bretter besorgt und unter das Gasthaus gestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120112
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221120112,
					"content": "Sieh dort einfach mal nach und bring ein paar mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221120113,
					"content": "Wird die Treppe später nicht eh wieder kaputtgehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120114
					]
				},
				{
					"id": 221120114,
					"content": "Das wird schon nicht passieren. Ich bin ja auch nicht mehr der Jüngste. Da passiert mir sowas sicher nicht noch einmal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120115
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221120115,
					"content": "Repariert werden muss die Treppe jetzt aber trotzdem. Dafür habe ich auch extra eine Fuhre Bretter gekauft, die ich unter das Gasthaus gestellt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120116
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221120116,
					"content": "Bring mir bitte ein paar davon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				}
			]
		},
		{
