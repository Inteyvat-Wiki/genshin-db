			"dialogs": [
				{
					"id": 221120301,
					"content": "Hast du die Bretter gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120302
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221120302,
					"content": "Ja, habe ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120303
					]
				},
				{
					"id": 221120303,
					"content": "Sieht gut aus! Das reicht sicher. Danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120304
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 221120304,
					"content": "Ich fange am besten gleich mit der Arbeit an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai’an"
				}
			]
		},
		{
			"id": 2211205,
			"completionStepIds": [
				2211205
