					"Beidou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20022401,
					"content": "Ich bleibe hier und erkläre die Situation. Bring uns einfach das Göttliche Auge zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20022402
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20022402,
					"content": "Die Zuschauer waren alle auf einen spannenden Kampf eingestellt. Ich kann nicht zulassen, dass sie enttäuscht zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beidou"
				}
			]
		},
		{
			"id": 200229,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
