			]
		},
		{
			"id": 200202,
			"completionStepIds": [
				200202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200202",
							"2"
						],
						"stepId": 200202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020201,
					"content": "Hm, warum ist er noch nicht hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020202
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020202,
					"content": "#Macht nichts, wir können damit beginnen, dass du zuerst deinen Auftritt hast, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020203,
					"content": "Alle mal herhören! Ich bitte um eure Aufmerksamkeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020204
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020204,
					"content": "Wir haben den Höhepunkt des Crux-Turniers erreicht. Das ist der letzte Kampf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020205
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020205,
					"content": "Wir sahen heute viele packende Kämpfe und endlich stehen nun die beiden Finalisten fest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020206
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020206,
					"content": "#Zuerst möchte ich unseren ersten Kämpfer vorstellen. Auch wenn nur wenige {F#sie}{M#ihn} je gesehen haben, ist {F#ihr}{M#sein} Ruhm bereits grenzenlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020207
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020207,
					"content": "#{F#Sie}{M#Er} ließ das Herz von Osial erzittern und {F#ihr}{M#sein} Name lässt selbst die Elf blass vor Angst werden ... Hier ist {F#die}{M#der} reisende Held{F#in} von Liyue, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020208
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020208,
					"content": "Ooooooooh!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020209
					],
					"speakerTitle": "Teilnehmer"
				},
				{
					"id": 20020209,
					"content": "Ich habe auf diesen Moment gewartet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020210
					],
					"speakerTitle": "Teilnehmer"
				},
				{
					"id": 20020210,
					"content": "#Ich glaube, dass jeder {F#ihren}{M#seinen} aufregenden Halbfinal-Kampf miterlebt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020211
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020211,
					"content": "Aber die heutige Finalrunde wird sicher noch einen draufsetzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020212
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020212,
					"content": "Was unseren anderen Kämpfer angeht ... Äh, er ist immer noch nicht da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020213
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020213,
					"content": "Warum braucht er denn so lange? Du kannst nicht einfach aufgeben, indem du nicht auftauchst, wie in den letzten Runden ... Das ist das Finale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020214
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020214,
					"content": "Ich bitte um Entschuldigung. Bleibt alle ruhig sitzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020215,
						20020216
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020215,
					"content": "Vielleicht hat er sich die Zeit falsch gemerkt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				},
				{
					"id": 20020217,
					"content": "Wir haben keine andere Wahl ... Wenn er nicht auftaucht, müssen wir den Kampf einfach verschieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020218
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020218,
					"content": "Warte einen Moment. Irgendetwas stimmt hier nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020219
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020219,
					"content": "Kapitän Beidou, vielleicht sollten wir nach dem Preis sehen. Die Kiste mit dem Göttlichen Auge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020220
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020220,
					"content": "#{NICKNAME}, komm mit uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020216,
					"content": "Vielleicht ist er zu eingeschüchtert, um zum Finale anzutreten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				}
			]
		},
		{
			"id": 200204,
			"completionStepIds": [
				200204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200204",
							"2"
						],
						"stepId": 200204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou",
					"Paimon",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020401,
					"content": "Lass mich mal sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020402
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020402,
					"content": "Es ist weg ... Das Göttliche Auge ist verschwunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020403
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020403,
					"content": "Hm. Hat es jemand gestohlen? Wer würde es wagen, so etwas am helllichten Tag zu tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020404,
					"content": "Wir wissen nicht genau, wann es gestohlen wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020405
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020405,
					"content": "Hm. Ich hätte nie gedacht, dass jemand hier den Mut hat, Kapitän Beidou zu hintergehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020406
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020406,
					"content": "Keine Sorge, selbst die geschicktesten Taschenspielertricks entgehen nicht dem wachsamen Blick der Natur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020407
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020407,
					"content": "Hmm ... Der Übeltäter hat erst vor Kurzem gehandelt und wird nicht weit gekommen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020408
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020408,
					"content": "Das Göttliche Auge war der Preis, den ich bekannt gegeben hatte, und es lag in meiner Verantwortung, es zu hüten. Ich werde es ganz sicher zurückbekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020409
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020409,
					"content": "Nun, wenn du darauf bestehst. Dann überlasse ich die Sache dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020410
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020410,
					"content": "Ich werde hierbleiben und versuchen, den Zuschauern, die gekommen sind, um das Spiel zu sehen, eine Erklärung zu geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020411
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020411,
					"content": "#Du solltest auch bitte mitkommen, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020412,
						20020413
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020412,
					"content": "Es scheint, dass wir nichts anderes tun können.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020414
					]
				},
				{
					"id": 20020414,
					"content": "Hm, aber wir sind auf einer Insel ... in welche Richtung könnte er gegangen sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020415,
					"content": "Komm mit mir. Ich kann spüren, dass der Wind kommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020413,
					"content": "Mein Gegner ist sowieso nicht aufgetaucht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020414
					]
				}
			]
		},
		{
			"id": 200209,
			"completionStepIds": [
				200209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200209",
							"2"
						],
						"stepId": 200209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fei",
					"Kaedehara Kazuha",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020901,
					"content": "Du hast mich eingeholt ... Wie ist das möglich!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020902
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020902,
					"content": "Ich hatte sogar ein Boot vorbereitet, um eine schnelle Flucht zu gewährleisten, und trotzdem hast du mich eingeholt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020903
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020903,
					"content": "Kein Boot kann es je mit der Geschwindigkeit des Windes aufnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020904
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020904,
					"content": "Der Wind? Wovon redest du denn? Oh, ich hab’s verstanden ... dein Göttliches Auge!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020905
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020905,
					"content": "Verflixt, wenn ich nur ein Göttliches Auge hätte ... Oder wenn ich dieses hier aktivieren könnte, dann würdest du mich nie fangen können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020906
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020906,
					"content": "Das hat nichts mit einem Göttlichen Auge zu tun. Du bist vielleicht geschickt darin, aus einer Menge zu verschwinden, aber es scheint, als wüsstest du nur wenig darüber, wie man sich vor den Blicken der Natur versteckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020907
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020907,
					"content": "Außerdem war dein gewählter Fluchtweg aus Gründen, die zu zahlreich sind, um darauf einzugehen, fehlerhaft und obendrein konnte ich dein prahlerisches und stolzes Lachen im Wind hören, als ich dich verfolgte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020908
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020908,
					"content": "Mit anderen Worten, du hast keines der grundlegenden Kriterien für einen großen Raub erfüllt: nämlich Geschwindigkeit, Heimlichkeit und Stil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020909
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020909,
					"content": "Du ... Du!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020910
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020910,
					"content": "Aber am enttäuschendsten ist der Zustand des Göttlichen Auges in deiner Hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020911
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020911,
					"content": "Es scheint, dass das Göttliche Auge nicht wahllos auf menschliche Wünsche eingeht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020912
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020912,
					"content": "Na schön, na schön! Ich gebe es zu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020913
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020913,
					"content": "Ich habe schon seit geraumer Zeit ein Auge auf dieses Göttliche Auge geworfen. Ich beschloss, mich anzumelden, nachdem ich gehört hatte, dass dieses Turnier voller lausiger Kämpfer war. Ich habe mich bis ins Finale vorgekämpft und ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020914
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020914,
					"content": "Aha, du solltest also unser Gegner sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020915,
					"content": "Ich hatte die ganze Zeit vor, den Wettbewerb allein durch mein Können zu gewinnen, aber dann bist du aufgetaucht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020916
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020916,
					"content": "Nachdem ich das Halbfinale gesehen hatte, wusste ich, dass ich keine Chance hatte. Aber ich wollte das Göttliche Auge nicht so einfach aufgeben, nachdem ich so weit gekommen war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020917
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020917,
					"content": "Da es sinnlos war, zu versuchen, dir im Kampf gegenüberzutreten, beschloss ich, meine Fähigkeiten zu nutzen, während alle Aufmerksamkeit auf dich und Beidou gerichtet war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020918
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020918,
					"content": "Ich war überzeugt, dass ich mich gut vorbereitet hatte. Aber irgendwie hast du es trotzdem geschafft, mit mir gleichzuziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020919,
						20020921,
						20020927
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020919,
					"content": "Du kannst jetzt nirgendwohin, gib es auf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020920
					]
				},
				{
					"id": 20020920,
					"content": "Ach ... Verflucht ... Das hatte anders laufen sollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020923
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020923,
					"content": "Es wird Konsequenzen haben, wenn du dich weiter wehrst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020924
					]
				},
				{
					"id": 20020924,
					"content": "Pfft! Ich erkenne eine leere Drohung sofort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020928,
					"content": "Gut, aber ich hoffe, ihr meint es ernst. Es wurde sowieso nicht aktiviert, als ich es nahm. Für mich ist es nur eine nutzlose Hülle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020929
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020929,
					"content": "Nach den Gesetzen des Meeres ist die Strafe für Diebstahl das Brechen der Arme des Täters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020930
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020930,
					"content": "Äh! Das ist nicht dein Ernst, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020931
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020931,
					"content": "Ganz zu schweigen davon, dass der Gegenstand, den du gestohlen hast, ein Preis war, du nicht zum Finale erschienen bist und du den Ruf des Kapitäns der Crux beschädigt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020932
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020932,
					"content": "Es scheint, dass es nur gerecht wäre, das Wort „Dieb“ mit einem heißen Eisen auf deine Stirn zu brennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020933
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020933,
					"content": "He, schon gut, so weit müssen wir doch nicht gehen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020934,
					"content": "Argh, ich hätte nie gedacht, dass du so grausam sein könntest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020935
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020935,
					"content": "Wenn mein Reden dazu führt, dann vergiss es. Ich werde einen Kampf riskieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020921,
					"content": "Gib mir das Göttliche Auge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020922
					]
				},
				{
					"id": 20020922,
					"content": "Nach allem, was ich durchgemacht habe, um es zu bekommen? Auf keinen Fall!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020925
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020925,
					"content": "Tu einfach, was wir sagen, und es wird keine weiteren Konsequenzen geben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020926
					]
				},
				{
					"id": 20020926,
					"content": "Ach, wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020927,
					"content": "Wenn du das Göttliche Auge aufgibst, lassen wir dich gehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020928
					]
				}
			]
		},
		{
			"id": 200211,
			"completionStepIds": [
				200211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200211",
							"2"
						],
						"stepId": 200211,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fei",
					"Kaedehara Kazuha",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20021101,
					"content": "Aaargh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021102
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20021102,
					"content": "Nein, nein! Mach, was du willst, aber bitte, brandmarke nicht meine Stirn, bitte!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021103
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20021103,
					"content": "Hm. Er hat bis zum bitteren Ende durchgehalten und nun droht der Tod ... und doch erweisen ihm die Götter nicht ihre Gunst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021104
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021104,
					"content": "Lege das Göttliche Aug nieder und gehe. Ich habe es mir anders überlegt — keine weitere Bestrafung für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021105
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021105,
					"content": "Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021106
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20021106,
					"content": "Was ist los mit dir? Willst du noch mehr Bestrafung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021107
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021107,
					"content": "Es liegt an dir. Solche Bereitschaft ist lobenswert und entspricht dem Weg der Samurai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021108
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021108,
					"content": "Nein, das ist nicht nötig. Danke, dass du mich freigelassen hast. Du bist wirklich großzügig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021110
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20021110,
					"content": "Hm, Paimon versteht das nicht. Wolltest du ihn nur erschrecken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021111,
					"content": "Es macht mir keine Freude, andere zu erschrecken. Ich habe nur alle Möglichkeiten getestet, während das Göttliche Auge in seinen Händen blieb.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021112
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021112,
					"content": "Wenn Menschen in die Enge getrieben werden, kommt ihre größte Stärke zum Vorschein. Ich dachte, es wäre eine Gelegenheit für ihn, das Göttliche Auge zu erwecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021113
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021113,
					"content": "Aber leider ist nichts passiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021114,
					"content": "Du hattest das also die ganze Zeit geplant?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021115
					]
				},
				{
					"id": 20021115,
					"content": "Ja, ich wollte wissen, ob es möglich ist, ein erloschenes Göttliches Auge wieder zu erwecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021116
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021116,
					"content": "Von dem Moment an, als er das Göttliche Auge gestohlen hatte, beschloss ich, ihn für dieses Experiment zu verwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021117
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021117,
					"content": "Ich habe in der Vergangenheit schon viele andere Methoden ausprobiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021190
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021190,
					"content": "Obwohl wenige Geschichten von einer „Wiedererweckung des herrenlosen Göttlichen Auges“ erzählen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021191
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021191,
					"content": "Nachdem ich gesehen habe, wie du mehrere Elemente beherrschst, dachte ich, dass nichts unmöglich ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021192
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021192,
					"content": "Komm, du kannst es versuchen. Mal sehen, ob du mir die Antwort geben kannst, die ich mir erhoffe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021118,
						20021119
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021118,
					"content": "Ich werde es versuchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021120
					]
				},
				{
					"id": 20021120,
					"content": "Hmm, das Göttliche Auge schien überhaupt nicht zu reagieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021121,
					"content": "Ich verstehe. Du bist also auch nicht in der Lage, das Göttliche Auge wiederzubeleben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021122
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021122,
					"content": "Macht nichts, das war zu erwarten. Ich nehme an, dieses Göttliche Auge gehört vorerst noch mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021123,
						20021124
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021123,
					"content": "Warum hängst du so an diesem Göttlichen Auge?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021125
					]
				},
				{
					"id": 20021125,
					"content": "Ja, was ist eigentlich die Geschichte hinter diesem Göttlichen Auge?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021126,
					"content": "Die Geschichte beginnt mit einem alten Freund ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021127
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021127,
					"content": "Vielleicht werde ich eines Tages feststellen, dass alles, was ich getan habe, bedeutungslos ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021128
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021128,
					"content": "Aber als wandernder Samurai finde ich nicht nur einen Sinn im Reisen und der weitläufigen Schönheit der Natur, die auf dem Weg liegt. Ich habe den „Weg des Kriegers“ immer noch in meinem Herzen bewahrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021129
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021129,
					"content": "Kazuha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021130,
					"content": "Hehe, das ist nur eine andere Art zu sagen, dass ich tue, was ich will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021131
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021131,
					"content": "Also gut. Es wird Zeit, dass wir zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021132,
						20021134
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021132,
					"content": "Los geht’s.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021133
					]
				},
				{
					"id": 20021133,
					"content": "Erlaubt mir, noch einmal den Wind für uns zu sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021134,
					"content": "Wenn du mehr reden willst, bin ich da und höre zu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021135
					]
				},
				{
					"id": 20021135,
					"content": "... lass dich von meinen Gefühlen nicht beunruhigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021136
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021136,
					"content": "Aber ich danke dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021124,
					"content": "Warum bist du so entschlossen, das Göttliche Auge wiederaufleben zu lassen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021125
					]
				},
				{
					"id": 20021119,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021120
					]
				}
			]
		},
		{
			"id": 200212,
			"completionStepIds": [
				200212
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200212",
							"2"
						],
						"stepId": 200212,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Zhuhan",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20021201,
					"content": "Hm? Ist Beidou schon weg? Vielleicht ist sie auf ihr Schiff zurückgekehrt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021202,
					"content": "Wenn du nach dem Kapitän suchst, Ningguang hat sie zu sich bestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021203
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021203,
					"content": "Es scheint, dass das Crux-Turnier dieses Mal außer Kontrolle geraten ist und ihre Aufmerksamkeit erregt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021204
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021204,
					"content": "Kapitän Beidou murmelte etwas darüber, dass Ningguang ein Spielverderber sei, als sie den Hafen von Liyue verließ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021205
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021205,
					"content": "Haha, es ist nicht ungewöhnlich, dass die beiden miteinander im Streit liegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021206
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021206,
					"content": "Trotzdem war Kapitän Beidou enttäuscht, dass sie die Ehrung eines neuen Siegers nicht miterleben konnte. Sie hatte sich schon seit geraumer Zeit darauf gefreut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021207
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021207,
					"content": "Derjenige, der das Göttliche Auge gestohlen hatte, sollte ursprünglich der Gegner dieses Helden in der letzten Runde sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021208
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021208,
					"content": "Er wusste, dass er keine Chance hatte, den Kampf zu gewinnen, und so kam ihm die boshafte Idee, den Preis zu stehlen, in den Sinn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021209,
					"content": "In diesem Fall kommt das Crux-Turnier zu einem eindeutigen Ergebnis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021210
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021210,
					"content": "Hä? Das ist also passiert!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021211
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021211,
					"content": "Wenn das der Fall ist, dann ist er laut den Regeln disqualifiziert ... und unser Held hier ist der Sieger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021212
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021212,
					"content": "Paimon dachte, wir würden gewinnen und so, aber nicht so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021213,
					"content": "Das macht nichts, wie man so schön sagt: „Ehre, wem Ehre gebührt.“ Ich bereite jetzt die Siegermedaille vor, um sie euch zu verleihen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021214
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021214,
					"content": "Werden wir jetzt nach Inazuma reisen können?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021215
					]
				},
				{
					"id": 20021215,
					"content": "Ja, ich glaube schon. Auch wenn Kapitän Beidou nicht mehr hier ist, werde ich dafür sorgen, dass sie davon erfährt. Sie ist eine Frau, die ihr Wort hält.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021216
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021216,
					"content": "Aber die Reise nach Inazuma ist eine tückische Reise. Ihr werdet während der gesamten Reise von einem ständigen Sturm geplagt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021217
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021217,
					"content": "Tatsächlich sind der unerbittliche Regen und Wind auch eine Verkörperung des Willens von Shougun Raiden, die Region zu isolieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021218
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021218,
					"content": "Moment mal, du willst sagen, dass sie das Wetter nur mit der Kraft ihres Willens ändern kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021219,
					"content": "Vergessen wir nicht, dass dies einer der sieben Archonten ist. Wenn Liyues Morax die Guyun-Türme formen konnte, indem er seine Steinspeere herabwarf, dann sollte es keine große Überraschung sein, dass der Shougun Raiden in der Lage ist, einen ewigen Sturm zu beschwören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021220
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021220,
					"content": "Es muss wohl kaum erwähnt werden, dass die Alcor etwas Zeit braucht, wenn ihr nach Inazuma reisen wollt. Ihr werdet benachrichtigt, sobald alle Vorbereitungen getroffen sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021221
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021221,
					"content": "In der Zwischenzeit beabsichtige ich, selbst eine Reise anzutreten. Ich werde durch die weiten Länder von Liyue reisen, in der Hoffnung, einen Weg zu finden, das Göttliche Auge zu erwecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021222
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021222,
					"content": "Paimon glaubt, dass du sicher einen Weg finden wirst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021223,
					"content": "Ich danke dir. Mögen sich unsere beiden Reisen als sinnvoll erweisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021224
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021224,
					"content": "Ein letztes Wort der Warnung. Der Teil eurer Reise, der vor dem Sturm liegt, könnte sich als der beschwerlichste erweisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
