				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Baiwen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20022901,
					"content": "Da hast du es, die Beweise sprechen für sich selbst. Kein Wunder, dass Ningguang so um die Sicherheit in diesem Gebiet besorgt war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20022902
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 20022902,
					"content": "Ich bezweifle, dass selbst Kapitän Beidou das unbeschadet überstehen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baiwen"
				}
			]
		},
		{
			"id": 200230,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
