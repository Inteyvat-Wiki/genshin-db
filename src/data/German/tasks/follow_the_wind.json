				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20023001,
					"content": "Du bist dran. Ich wünsche dir viel Glück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20023002
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20023002,
					"content": "Ich bin sehr gespannt auf das Ergebnis dieses Kampfes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
