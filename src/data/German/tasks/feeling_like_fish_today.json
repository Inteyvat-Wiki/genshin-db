			"dialogs": [
				{
					"id": 750150401,
					"content": "#Tada! Typisch {NICKNAME}, {F#sie}{M#er} hat diesen wilden Fisch eingefangen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150402,
					"content": "Ach, und wenn man die ganzen Köder auf einmal reinwirft und ein Fisch so viel davon frisst, bis er mit dem Bauch nach oben schwimmt, gilt das dann auch als Fischen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150403,
					"content": "*knurr* ... *brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150404
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150404,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, denkst du auch, dass es so funktioniert? Paimon kann die Erwartung in deinen Augen sehen! Hehe, das nächste Mal versuchen wir es gemeinsam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150405,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150406,
					"content": "#Ui! Er ist noch nicht durch, wir müssen warten, bis {NICKNAME} ihn zubereitet hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150407,
					"content": "Nachdem der Fisch fertig gegrillt wurde, schlagen sich alle die Bäuche voll.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150408
					]
				},
				{
					"id": 750150408,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150409
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150409,
					"content": "Paimon findet, dass dieser Fisch besonders lecker ist. Kein Wunder, den hat ja auch Paimon gefangen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150410,
					"content": "Typisch Paimon, in Zukunft überlasse ich das dir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150411
					]
				},
				{
					"id": 750150411,
					"content": "*seufz* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150412,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150413
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150413,
					"content": "#Glaube nur nicht, dass du dich durchfüttern lassen kannst. Wenn du Fisch fressen willst, musst du nächstes Mal auch mit anpacken, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150414,
					"content": "*brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150415
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150415,
					"content": "In solchen Momenten stellst du dich wieder dumm, du Lümmel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
