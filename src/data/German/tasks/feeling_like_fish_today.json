			"dialogs": [
				{
					"id": 750150501,
					"content": "Puh, endlich Ordnung, dann kann Paimon ja angeln gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150502,
					"content": "Ha, Paimon wird es euch zeigen und fängt bestimmt einen ganz großen Fisch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150503,
					"content": "Aber leider bleibt die Wasseroberfläche vollkommen still, es zeigen sich keinerlei Wellen.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150504
					]
				},
				{
					"id": 750150504,
					"content": "Hm ... Ist die Wasserqualität womöglich zu gut? Die Fische wollen einfach nicht rauskommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150505,
						750150508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150505,
					"content": "Der Sieg ist zum Greifen nahe, hehe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150506
					]
				},
				{
					"id": 750150506,
					"content": "So ist es, „Der Sieg ist nah!“ ... Nein, das ist erst der Anfang, bis zum Sieg ist es noch ein langer Weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150507,
					"content": "In so einem Moment darf man nicht wild drauflosjubeln!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150511,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150512,
					"content": "Du hast es geschafft! Du hast es geschafft!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150513
					]
				},
				{
					"id": 750150513,
					"content": "Herrje, du kannst doch in so einem Moment nicht anfangen, zu quasseln ... Also wirklich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150514,
					"content": "Was ist, was ist? Ui! Die Angelrute hat sich bewegt, mal sehen, was wir da Schönes haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150515,
					"content": "#Was, kein Fisch, es ist eine Flaschenpost. Und sie ist mit einer Schnur an dem Angelsteg angebunden ... {NICKNAME} hat ja öfters seltsame Dinge am Haken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150516,
					"content": "Man kann beim Angeln alles Mögliche fangen, nur keine Fische ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150517
					]
				},
				{
					"id": 750150517,
					"content": "#{NICKNAME}, du angelst doch auch ständig die seltsamsten Dinge. Zumindest hat Paimon etwas geangelt, mal schauen, was drin ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150518,
					"content": "Diese Angelsüchtigen sind wirklich furchtbar. Haben die beiden etwa gerade diesen Haufen Unrat hinterlassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150519,
					"content": "Wir sollten die Flasche zurückwerfen, sie scheint das Mittel zu sein, mit dem sie sich verständigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150520,
					"content": "Ah, Paimon hat das Gefühl, dass Paimon beim nächsten Mal bestimmt etwas rausholen wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150521,
					"content": "Die Angelrute biegt sich plötzlich und zittert heftig.\\nIm Wasser schwimmt ein „Prachtkerl“ und zieht wie wild am Haken.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150522
					]
				},
				{
					"id": 750150522,
					"content": "Endlich angebissen! Das muss ein großer Fisch sein, komm zu Paimon ... Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150523,
					"content": "Komm zu Paimon ... Ah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150524
					]
				},
				{
					"id": 750150524,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150525
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150525,
					"content": "#Du siehst, wie Paimon sich abrackert.\\n{REALNAME[ID(2)|SHOWHOST(true)]} und du eilt hinzu, um Paimon festzuhalten ...\\nAber am anderen Ende der Angelrute wird heftig gezogen!",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150526
					]
				},
				{
					"id": 750150526,
					"content": "Mit einem „Pling“ reißt der Fisch den Haken ab ...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150527
					]
				},
				{
					"id": 750150527,
					"content": "*schluchz*! Das muss ein mächtig großer Fisch gewesen sein, wenn er den Haken abreißen konnte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150528,
					"content": "Paimon ist so wütend ... Oh, er schwimmt ja noch an der Wasseroberfläche herum, wie kann er es wagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150529,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150530
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150530,
					"content": "Nein, das geht nicht, das Meer ist zu gefährlich und du kannst nicht so schnell schwimmen wie ein Fisch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150531
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150531,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150532
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150532,
					"content": "#Ach {NICKNAME}, wenn es doch nur eine andere Möglichkeit gäbe, diesen Fisch zu fangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150508,
					"content": "Nicht so hastig, immer mit der Ruhe!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150509
					]
				},
				{
					"id": 750150509,
					"content": "Hm, der Moment, in dem der Fisch den Köder schluckt, kommt genauso unvorhersehbar und plötzlich, wie eine Vaniloqua aus einer Zuckerblume herausplatzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150510,
					"content": "Da kann man nur konzentriert warten ... Und warten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150511
					],
					"speakerTitle": "Paimon"
				}
			]
		},
