			},
			"dialogs": [
				{
					"id": 400831601,
					"content": "Ich sehe, dass ihr es ernst meint. Das ist schön. Es wird Zeit, dass ich mein jahrelanges, strenges Training in die Tat umsetze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831602
					],
					"speakerTitle": "Schneemensch"
				},
				{
					"id": 400831602,
					"content": "Kommt! Werdet Zeuge meiner Pilzbestientruppe, die die Macht des Frosts beherrscht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Schneemensch"
