			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400830501,
					"content": "Miko! Tut uns leid! Wir hätten nicht gedacht, dass „Trommelkäppchen“ Souka mit seiner Attacke ausschalten würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830502,
						400830503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830502,
					"content": "#Paimon ... {F#Die Zähmerin}{M#Der Zähmer} bin ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830504
					]
				},
				{
					"id": 400830504,
					"content": "Oh? War Souka deprimiert? Gab sie überspitzte Kommentare wie „Unmöglich für Normalsterbliche“ von sich? Rollte sie auf dem Boden und heulte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830505
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830505,
					"content": "Du hast den Nagel auf den Kopf getroffen. Du kennst sie gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830506,
					"content": "So ist es besser. Souka wird ihre Niederlage zu wertvollem Material verarbeiten und alle möglichen Leiden des Protagonisten während seines Wachstums naturgetreu wiedergeben. Sie wird die Herzen der Leser für sich gewinnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830507
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830507,
					"content": "Was den überlegenen Bösewicht und den Pokal betrifft, wird sie sich von euch inspirieren lassen. Also lasst euch nicht von irgendwelchen Würstchen aus dem Wettbewerb werfen, klar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830508,
						400830509
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830508,
					"content": "Nein, jetzt bin ich jetzt der Bösewicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830510
					]
				},
				{
					"id": 400830510,
					"content": "Jetzt ist keine Zeit für solche Banalitäten! Miko, du musst dafür sorgen, dass Souka gnädig mit uns beim Schreiben verfährt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830511,
					"content": "#{NICKNAME}, Paimon und Yae ... *hust* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830512
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830512,
					"content": "Layla, ganz ruhig, Paimon fürchte, du wirst gleich ohnmächtig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830513,
					"content": "Mir geht es gut ... Ich habe dem Studenten der Lebenskunde einen Brief geschrieben, der unerwartet auf Anklang gestoßen ist. Ein paar Stunden später habe ich eine Antwort mit den angeforderten Unterlagen erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830514
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830514,
					"content": "Ich habe versucht, der „Wirbelnde Bestie“ etwas Essen vorzubereiten, indem ich die Anweisungen der Unterlagen befolge, aber sie schien sie nicht zu mögen. Vielleicht waren die Zutaten nicht richtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830515
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830515,
					"content": "Danach habe ich ein paar Verbesserungsvorschläge aufgeschrieben, darunter Zutaten, die „Trommelkäppchen“ gefallen könnten. Ich bin erst spät nachts ins Bett gefallen und bin heute in Atemnot ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830516
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830516,
					"content": "So schnell schon ein Ergebnis? Hocheffizient!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830517,
					"content": "(Atemnot ... wegen Schlafmangel?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830518
					]
				},
				{
					"id": 400830518,
					"content": "Wie geht es dir, Layla? Hast du dich gut um deine Kontrahenten gekümmert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830519
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830519,
					"content": "Jawohl! Dank deines Trainings hört die „Wirbelnde Bestie“ noch mehr auf mich! Sie reagiert so schnell, ich bin fast neidisch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830520
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830520,
					"content": "Aber auch der Druck ist groß, denn unsere Gegner sind auch merklich stärker. Ich muss meine „Wirbelnde Bestie“ weiter trainieren, um ins Viertelfinale zu kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830521
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830521,
					"content": "Das Problem ist nur ... dass ich alle Zutaten morgen früh um sieben Uhr beim „Alleshändler“ kaufen möchte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830522
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830522,
					"content": "Kleinigkeit. Ich gehe mit dir trainieren und was die Zutaten angeht, kannst du die beiden hier fragen. Sie werden häufig auf Botengänge geschickt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830523
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830523,
					"content": "Hört sich an, als ob ihr beiden Yae häufig Dienste erweist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830524,
						400830525
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830524,
					"content": "Es ist uns ein Vergnügen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830526
					]
				},
				{
					"id": 400830526,
					"content": "Ah, stimmt! Bitte beschreibe uns nicht als ungehobelte Bösewichte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830527,
					"content": "Keine Sorge, Layla. Sie haben sich gerade bei mir für ihren Sieg über Souka entschuldigt. Du kannst dir etwas zu trinken kaufen und wieder zu Atem kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830528
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830528,
					"content": "Dann danke ich euch vielmals!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830529
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830529,
					"content": "Hier ist die Adresse, an der ich mich mit dem „Alleshändler“ treffen soll. Die Zutaten sind alle aufgelistet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830530
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830530,
					"content": "Deine Höflichkeit ist fehl am Platz! Du hast die Eigenarten von „Trommelkäppchen“ auch erforscht, also wäscht eine Hand die andere. Geh schon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830531
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830531,
					"content": "Was unsere Diskussion zu den „unsicheren Faktoren“ des Wettkampfs betrifft, die wir nicht führen konnten ... Vielleicht sind die Materialien zur Kultivierung der Pilzbestien eine gute Einschnittstelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830532,
						400830533
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830532,
					"content": "„Blumengelee“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830534
					]
				},
				{
					"id": 400830534,
					"content": "#Hehe, das ist wie der Höhepunkt einer kurzen Erzählung: die Geheimuntersuchung. Kleine{M#r}, du bist doch immer neugierig darauf, oder? Woher kommt die Magie der „Weisheitsperle“ und des „Blumengelees“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830535
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830535,
					"content": "Außerdem könnte Haniyyahs impulsives Handeln zu größeren Problemen führen, wenn wir dem Wettkampf nicht auf die Spur kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830536
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830536,
					"content": "Oh ... Das Thema ist plötzlich so kompliziert. Paimon versteht nichts ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830537,
					"content": "Ich empfehle euch, vor Sonnenaufgang zu handeln. Zu dem Zeitpunkt sind die meisten Menschen müde. Vielleicht findet ihr wichtige Hinweise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830538
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830538,
					"content": "Möchtest du Mikos Rat wirklich befolgen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830539,
						400830540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830539,
					"content": "Das war der ursprüngliche Grund, um am Wettkampf teilzunehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830541
					]
				},
				{
					"id": 400830541,
					"content": "Das stimmt auch. Dann warten wir bis morgen früh und schauen uns am Kultivierungsplatz der Pilzbestien um ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830542
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830542,
					"content": "Wir gehen nur sicher, dass der Wettkampf vollkommen gesichert ist. Paimon wird „Trommelkäppchen“ nicht verdächtigen. Keine Sorge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830540,
					"content": "Damit wir uns mit unseren Kameraden verstehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830541
					]
				},
				{
					"id": 400830533,
					"content": "Hast du etwas gehört, Miko?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830534
					]
				},
				{
					"id": 400830525,
					"content": "Wenn wir nicht zustimmen, wird unser Image ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830526
					]
				},
				{
					"id": 400830509,
					"content": "Und Paimon ist noch viel schlimmer, denn Paimon ernährt sich vom Bösewicht!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830510
					]
				},
				{
					"id": 400830503,
					"content": "Ich sollte die Verantwortung tragen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830504
					]
				}
			]
		},
		{
			"id": 4008308,
			"completionStepIds": [
				4008308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
