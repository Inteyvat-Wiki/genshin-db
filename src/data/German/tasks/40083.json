				"objectNames": [
					"Souka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831701,
					"content": "Warum kann ich nicht gewinnen ... *schluchz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831702
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 400831702,
					"content": "Mit eurem Talent und euren Fähigkeiten als „Ehrengäste vom Tenshukaku“ kann ich es als Normalsterbliche nicht aufnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831703
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 400831703,
					"content": "Was sollen wir tun? Souka wirkt sehr angeschlagen ... Miko sagt zwar, dass es keine große Sache ist, aber wenn Miko sie so sieht, wird sie bestimmt wütend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831704,
					"content": "Paimon macht sich große Sorgen! Wir sollten uns bei Miko entschuldigen. „Trommelkäppchen“ muss auch Aufrichtigkeit zeigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4008318,
			"completionStepIds": [
				4008317
