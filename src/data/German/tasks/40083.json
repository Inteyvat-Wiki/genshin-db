		},
		{
			"id": 4008309,
			"completionStepIds": [
				4008309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008309",
							"2"
						],
						"stepId": 4008309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400830901,
					"content": "Laut Laylas Zettel sollten wir uns hier mit dem „Alleshändler“ treffen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830902,
					"content": "So wie ihr ausseht, sucht ihr den „Alleshändler“, oder? Willkommen, willkommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830903
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830903,
					"content": "Richtig, du kennst uns gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830904,
					"content": "Was, Dori? Bist du der „Alleshändler“, von dem Layla gesprochen hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830905,
					"content": "Was ist so komisch daran? „Herr Sangemah Bay verkauft die besten und vielfältigsten Produkte“, das wissen alle Inhaber und Besucher des Großen Basars.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830906
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830906,
					"content": "„Universell“, „allmächtig“ und so weiter ... sind mein Motto! Die anderen Händler müssen mir zuerst eine deftige Lizenzgebühr bezahlen, falls sie sich mein Motto zunutze machen wollen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830907
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830907,
					"content": "Ah, wir hätten es ahnen sollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830908,
					"content": "Also hat Layla euch geschickt, um ihre Besorgungen zu erledigen? Die Zähmermeisterschaft scheint ihre ganze Zeit zu beanspruchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830909
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830909,
					"content": "Du und Layla steht euch also ziemlich nahe, du kennst sie gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830910,
					"content": "Hehe! Das hat nichts damit zu tun. Layla hat zwar nichts Außergewöhnliches bei mir gekauft, aber trotzdem bezahlte sie einen hohen Preis für eine Studentin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830911
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830911,
					"content": "Natürlich erkundige ich mich nach ihr. Ich weiß, dass sie an diesem merkwürdigen Wettkampf teilnimmt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830912,
						400830913
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830912,
					"content": "Du weißt also etwas darüber, was vor sich geht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830914
					]
				},
				{
					"id": 400830914,
					"content": "Ah ... Ich finde nur manche Dinge merkwürdig. Ich habe hier ein paar Waren, die sich nicht verkaufen lassen. Ich überlasse sie euch gerne, bevor sie rosten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830915
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830915,
					"content": "Ähm ... Ein paar unvollständige Notizen und Komponenten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830916,
					"content": "Es soll sich um Apparate und Dokumente handeln, die der Veranstalter des Wettkampfs zerstören wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830917
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830917,
					"content": "Leider waren sie unvorsichtig. Manche Menschen prägt ein ungeheuerlicher Drang auf Reichtümer! Also haben sie die Reste eingesammelt und mir übergeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830918
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830918,
					"content": "Oh, wenn man genau hinsieht, wirkt das wie ein Rezept für „Blumengelee“ ... Die Apparatreste sehen einer „Weisheitsperle“ sehr ähnlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830919,
					"content": "Vielleicht handelt es sich um Versuchsprodukte. Behalten wir sie vorerst. Vielleicht entdeckt Miko irgendwelche Merkwürdigkeiten an ihnen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830920,
						400830921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830920,
					"content": "Jedenfalls können wir vorerst annehmen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830922
					]
				},
				{
					"id": 400830922,
					"content": "Also werden unsere anfänglichen Befürchtungen fast bestätigt ... Paimon wollte eigentlich unbekümmert mit „Trommelkäppchen“ spielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830923,
					"content": "Ich habe zwar keine Ahnung, was ihr da faselt, aber diese Sachen scheinen euch nützlich zu sein. Dann mache ich euch einen guten Preis. Sechzig Millionen Mora ist alles, was ich verlange!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830924
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830924,
					"content": "Was! Du bist viel zu gerissen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830925,
					"content": "Hehe, kleiner Scherz am Rande. An diesen Sachen interessiert sich wohl keiner außer euch und den Matra. Also schenke ich sie euch für eure Einkäufe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830926
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830926,
					"content": "Gebt mir Laylas Einkaufsliste. Sobald ich ihre Waren parat habe, werde ich sie liefern lassen. Ihr braucht sie nicht abholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830927
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830927,
					"content": "Paimon hatte schon Angst, dass unser Ausflug umsonst war! Selbst mit der Belohnung hätten wir die Summe nicht bezahlen können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830928,
					"content": "Das ist Laylas Einkaufsliste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830929
					]
				},
				{
					"id": 400830929,
					"content": "Ähm, Mehl mit Matsutake, abgestandene Konfitüre und Zaytun-Pfirsichsaft ... Essen Pilzbestien solche Dinge? Woher weiß Layla all dies ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830921,
					"content": "... Dass etwas nicht mit Kautilya stimmt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830922
					]
				},
				{
					"id": 400830913,
					"content": "Hast du irgendwelche Informationen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830914
					]
				}
			]
		},
		{
			"id": 4008313,
			"completionStepIds": [
				4008313
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008313",
							"2"
						],
						"stepId": 4008313,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831301,
					"content": "#{NICKNAME}, Paimon, ihr seid in die nächste Runde gekommen. Glückwunsch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831302
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831302,
					"content": "Oh! Layla, gut siehst du heute aus. Der „Wirbelnde Bestie“ scheint es auch blendend zu gehen! Ihr seid wohl heute siegreich hervorgegangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831303,
					"content": "Der Sieg war sehr knapp! Zum Glück habe ich vorher mit Yae trainiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831304
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831304,
					"content": "Gerade eben ist die Lieferung des „Alleshändlers“ eingetroffen! Vielen Dank! Ich werde mich ein wenig mit der „Wirbelnde Bestie“ ausruhen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831305
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831305,
					"content": "*hust* ... Ich habe keine Kraft mehr. Sprechen wir etwas leiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831306
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831306,
					"content": "Übrigens, wo steckt denn Miko?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831307,
					"content": "Yae hatte etwas Dringendes zu erledigen und ist mit Frau Souka und den anderen gegangen. Anscheinend zeigte ihnen ein Söldner des „Regiments der Dreißig“ den Weg ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831308
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831308,
					"content": "Als ich zurückgekommen bin, waren sie schon längst weg. Ihnen nachzulaufen, scheint auch ein wenig fehl am Platz ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831309,
						400831310
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831309,
					"content": "Vielleicht hat sie noch Arbeit vor sich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831311
					]
				},
				{
					"id": 400831311,
					"content": "Das kann auch sein. In letzter Zeit hat sich Miko mit dem Wettkampf beschäftigt. Manchmal muss sie auch ihrer Rolle als Chefredakteurin nachgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831312,
					"content": "Außerdem hat Miko gesagt, dass sie sich im Urlaub Inspiration suchen möchte. Vielleicht ist der Söldner ihr Reiseführer. Wir sollten uns keine großen Sorgen machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831313,
					"content": "Ja. Als Nächstes kommt das Viertelfinale, ein entscheidender Kampf ... Ich habe etwas Angst, aber trotzdem sollten wir alles geben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831314
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831314,
					"content": "Ja! Aus dieser Perspektive scheint unsere Qualifikation relativ einfach zu gelingen. Layla, gib dir Mühe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831315,
						400831316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831315,
					"content": "Wir dürfen auch nicht nachlassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831317
					]
				},
				{
					"id": 400831317,
					"content": "Richtig, wir müssen wachsam bleiben! Wir sollten Fotos von Doris Geschenk machen und zu den Fotos von heute Morgen legen. Wir könnten sie Miko beim nächsten Mal zeigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831316,
					"content": "Wir müssen an den Kämpfen teilnehmen und unserer Untersuchung nachgehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831317
					]
				},
				{
					"id": 400831310,
					"content": "Immerhin hat das „Verlagshaus Yae“ viel auf dem Schirm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831311
					]
				}
			]
		},
		{
			"id": 4008314,
			"completionStepIds": [
				4008307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008307",
							"2"
						],
						"stepId": 4008307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831401,
					"content": "Scheint ganz gewöhnliche „Blumengelees“ zu sein. Immerhin sollen sie allgemein präsentiert werden, selbst das Rezept ist da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831402,
						400831403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831402,
					"content": "Auch wenn die Zutaten verdächtig erscheinen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831404
					]
				},
				{
					"id": 400831404,
					"content": "Wir können sie nicht einfach schnappen und untersuchen, das wäre Diebstahl und wir würden disqualifiziert werden. Vielleicht werden wir sogar vom „Regiment der Dreißig“ geschnappt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831405,
					"content": "Genau, wir haben den Fotoapparat! Wir könnten Fotos von den „Blumengelees“ und dem Rezept machen und wichtige Informationen aufzeichnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831403,
					"content": "Normale Teilnehmer können nichts erkennen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831404
					]
				}
			]
		},
		{
			"id": 4008315,
			"completionStepIds": [
				4008302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008302",
							"2"
						],
						"stepId": 4008302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Souka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831501,
					"content": "Hallo, ich hätte nicht gedacht, dass ich euch so früh begegnen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831502
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 400831502,
					"content": "Tut mir leid, aber für meine Karriere als Schriftstellerin und für Chefredakteurin Yaes Anerkennung muss ich euch bezwingen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831503
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 400831503,
					"content": "Zeig uns, was du kannst!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831504
