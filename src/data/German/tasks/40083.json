				"objectNames": [
					"Haniyyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831901,
					"content": "Ihr habt das Rezept von „Blumengelee“ gefunden und es mit den Gelees als Beweis fotografiert.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400831902
					]
				},
				{
					"id": 400831902,
					"content": "Geschafft! Als Nächstes sollten wir uns einen Experten suchen, um sie einer Analyse zu unterziehen ... Aber die Zeit drängt, sollten wir zuerst die Einkäufe für Layla tätigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831903,
					"content": "Ha... Ha... Ha... Haniyyah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831904,
					"content": "Ihr habt wirklich hohe Ansprüche an euch selbst. Nicht jeder wird so früh hierherkommen, um seine Pilzbestien zu kultivieren. Kein Wunder, dass euch alles so leicht fällt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831905
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400831905,
					"content": "Haniyyah, unsere Diskussion war noch nicht am Ende! Deine Denkweise ist viel zu radikal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831906,
					"content": "Spar dir deine Worte. Falls ihr glaubt, dass ich falsch liege, müsst ihr mich zuerst besiegen und dann könnt ihr mir euren Standpunkt erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831907
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400831907,
					"content": "Sie hört uns überhaupt nicht zu ... Wie konnte es nur so weit kommen? Paimon dachte anfangs, wir kämen gut miteinander aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831908,
						400831909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831908,
					"content": "Gehen wir, die Zeit drängt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831910
					]
				},
				{
					"id": 400831910,
					"content": "Na gut ... „Trommelkäppchen“, keine Zeit für Sentimentalitäten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831909,
					"content": "Wir müssen sie auf ihre Weise überzeugen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831910
					]
				}
			]
		}
