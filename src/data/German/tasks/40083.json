			},
			"dialogs": [
				{
					"id": 400831801,
					"content": "Wie kann das sein ... Bin ich so schwach?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831802
					],
					"speakerTitle": "Schneemensch"
				},
				{
					"id": 400831802,
					"content": "Ähm, das war kein leichter Sieg ... Danke dir und deinen Kameraden, „Trommelkäppchen“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
