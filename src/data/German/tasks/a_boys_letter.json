			"dialogs": [
				{
					"id": 201020501,
					"content": "Also such bitte nach <color=#00E1FFFF>Löwenzahn</color>. Und beeil dich bitte, mein Brief ist schon fast fertig!",
					"roleType": "TALK_ROLE_NPC",
