			"dialogs": [
				{
					"id": 201020901,
					"content": "Gib den Brief Draff in Quellingen, keinem anderen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020902
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020902,
					"content": "Grace sagt, dass er ein guter Freund von Papa ist. Er weiß bestimmt, wo er den Brief hinschicken muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020903
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020903,
					"content": "Aber Grace meinte auch, dass er und Draff viel zu tun haben. Hmm, ob ich auch mal so sein werde, wenn ich groß bin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020904
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020904,
					"content": "Ach, das wird schon! Solange ich Papa helfen kann, macht das auch nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
