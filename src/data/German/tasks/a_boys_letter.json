	"talks": [
		{
			"id": 2010201,
			"completionStepIds": [
				2010201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010201",
							"2"
						],
						"stepId": 2010201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Draff"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020101,
					"content": "Hach, ich weiß auch nicht, was mit dem Kind los ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020102
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020103
					]
				},
				{
					"id": 201020103,
					"content": "Hm? Oh, genau richtig! Erinnerst du dich an den Brief vom letzten Mal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020104
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020104,
					"content": "Falls du Zeit hast, kannst du Grace diesen Brief bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020105,
						201020107
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020105,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020106
					]
				},
				{
					"id": 201020106,
					"content": "Danke sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020107,
					"content": "Warum ich denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020108
					]
				},
				{
					"id": 201020108,
					"content": "Wenn ich bedenke, was beim letzten Mal passiert ist, werde ich sicher keine Tauben mehr schicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020109
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020109,
					"content": "Und wenn ich persönlich nach Mondstadt gehe, begegne ich sicher diesem Kind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020110
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020110,
					"content": "Ach, frag lieber nicht weiter. Nimm einfach den Brief.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
		{
			"id": 2010202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010202",
							"2"
						],
						"stepId": 2010202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Draff"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020201,
					"content": "Huch, warum bist du noch nicht losgegangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020202,
						201020205
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020202,
					"content": "Sag mal, in dem Brief ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020203
					]
				},
				{
					"id": 201020203,
					"content": "Da geht’s um ein paar alte Geschichten. Hast du beim letzten Mal nicht reingesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020204
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020204,
					"content": "In dem Fall musst du dir das diesmal auch nicht antun. Ist alles nur Gewäsch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020205,
					"content": "Von welchem Kind hast du gesprochen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020206
					]
				},
				{
					"id": 201020206,
					"content": "Was kümmert dich das denn? Ich meine dieses Kind, das auf der Brücke die Tauben füttert. Weißt du noch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020207
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020207,
					"content": "Der kleine Timmie ... Ich kann ihm jedenfalls im Moment nicht über den Weg laufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020208
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020208,
					"content": "Zufrieden? Bring Grace doch bitte endlich den Brief. Sonst macht sie sich noch Sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
		{
			"id": 2010203,
			"completionStepIds": [
				2010202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010202",
							"2"
						],
						"stepId": 2010202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020301,
					"content": "Warum ist er immer noch nicht da? Ob wohl etwas passiert ist? Komisch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020302
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020302,
					"content": "Dieser Brief hier ist von Draff.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020303
					]
				},
				{
					"id": 201020303,
					"content": "Was? Wieso bringst du ihn dann her? Normalerweise kommt er mit den Tauben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020304
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020304,
					"content": "Den Tauben ist etwas zugestoßen? Hach, in Quellingen passieren täglich solche Sachen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020305
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020305,
					"content": "Danke, dass du mir den Brief gebracht hast! Ich werde dir ein kleines Dankeschön vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020306
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020306,
					"content": "Was steht denn in dem Brief?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020307
					]
				},
				{
					"id": 201020307,
					"content": "Hast du nicht reingesehen? Da stehen keine großen Geheimnisse drin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020308
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020308,
					"content": "Wie Draff es ausdrücken würde, es geht nur um alte Geschichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020309
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020309,
					"content": "Auch wenn wir diese alten Geschichten niemals vergessen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020310
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020310,
					"content": "Was sind das für alte Geschichten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020311
					]
				},
				{
					"id": 201020311,
					"content": "Willst du das wirklich wissen? Na gut, ich denke, ich kann dir vertrauen. Du darfst es aber niemandem sonst erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020312,
						201020313
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020312,
					"content": "Ich verspreche es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020316
					]
				},
				{
					"id": 201020316,
					"content": "Timmies Vater war ein guter Freund von Draff. Sie gingen zusammen jagen und trinken und unternahmen sonst auch viel gemeinsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020317
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020317,
					"content": "Der Ritterorden hat ihn unzählige Male gewarnt und auch die Ordensschwester Victoria hat häufig mit ihm gesprochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020318
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020318,
					"content": "Aber erst als Timmie zur Welt kam, hat sich sein Vater gebremst. Er hat sogar aufgehört zu trinken und fleißig gearbeitet, um ein wenig Geld zu sparen. Er meinte auch, dass er als Vater ein Vorbild sein müsste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020319
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020319,
					"content": "Das hat er solange durch die Gegend gebrüllt, bis Draff sogar aufhören wollte zu trinken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020320
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020320,
					"content": "Wenn die beiden es gar nicht mehr aushalten konnten, haben sie sich eine Apfelschorle besorgt und sie zusammen getrunken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020321
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020321,
					"content": "Doch eines Tages gab es einen Unfall bei der Jagd und Timmies Vater wurde schwer verletzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020322
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020322,
					"content": "Hilfe war zwar sofort zur Stelle, doch seine Wunden waren so groß, dass er nicht mehr gerettet werden konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020323
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020323,
					"content": "Draff bat mich daraufhin, mich um Timmie zu kümmern, und ging zurück nach Quellingen, um zu jagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020324
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020324,
					"content": "Jeden Monat schickt er einen Brief und etwas Geld, möchte Timmie aber nicht begegnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020325
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020325,
					"content": "In letzter Zeit sagt er aber immer wieder, dass er Timmie gern die Wahrheit erzählen würde. Ich frage mich, was genau damals abgelaufen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020326,
						201020332,
						201020336
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020326,
					"content": "Willst du denn nicht, dass Timmie die Wahrheit erfährt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020327
					]
				},
				{
					"id": 201020327,
					"content": "Ja, Timmie ist schließlich noch ein Kind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020328
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020328,
					"content": "Er erzählt zwar immer, dass er schon groß wäre, und kümmert sich auch um Nora und Glory.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020329
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020329,
					"content": "Aber wie könnte er eine solche grausame Wahrheit ertragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020330
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020330,
					"content": "Solange er nicht reif genug ist für diese Wahrheit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020331
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020331,
					"content": "Ich werde ihn auch belügen, wenn es sein muss, damit er eine schöne Kindheit haben kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020341,
					"content": "Natürlich wird Timmie auch erwachsen und stellt immer mehr Fragen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020342
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020342,
					"content": "Ich weiß bald nicht mehr, was ich ihm antworten soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020343
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020343,
					"content": "Nora sagt, dass Timmie sie früher immer an die Hand genommen hat und mit ihr herumgelaufen ist. Er wollte seinem Vater ein Geschenk vorbereiten und ihm einen Brief schicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020344
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020344,
					"content": "In der letzten Zeit ist Timmie aber nicht mehr so fröhlich und starrt nur in der Gegend herum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020345
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020345,
					"content": "Vielleicht könntest du ihn mal besuchen, wenn du Zeit hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020346,
						201020348
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020346,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020347
					]
				},
				{
					"id": 201020347,
					"content": "Danke sehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020348,
					"content": "Warum machst du das nicht selbst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020349
					]
				},
				{
					"id": 201020349,
					"content": "Das ist mir dann doch peinlich. Ich habe zwar gesagt, dass ich Timmie sicher nicht die Wahrheit sagen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020350
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020350,
					"content": "Aber wenn Timmie anfängt, vom Brief an seinen Vater zu erzählen, werd ich vielleicht doch noch weich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020351
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020351,
					"content": "Ich habe Angst, dass mir die Wahrheit doch eines Tages herausrutscht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020352
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020352,
					"content": "Das muss ich aber unbedingt vermeiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020353
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020353,
					"content": "Deswegen möchte ich, dass du stattdessen hingehst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020332,
					"content": "Du kannst ihm die Wahrheit nicht sein ganzes Leben lang vorenthalten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020333
					]
				},
				{
					"id": 201020333,
					"content": "Ja, ich weiß. Aber Timmie ist doch noch ein Kind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020334
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020334,
					"content": "Ich hoffe einfach, dass ich es solange schaffe, damit er noch eine schöne Kindheit haben kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020335
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020335,
					"content": "Auf diese Weise kann geschehen, was wolle, mit seinen Kindheitserinnerungen kann er sich immer trösten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020336,
					"content": "Was wäre so schlimm daran, wenn er die Wahrheit erfahren würde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020337
					]
				},
				{
					"id": 201020337,
					"content": "Tja, es ist verständlich, dass du so denkst. Du hast ja auch schon viel erlebt und bist mutig genug, stark genug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020338
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020338,
					"content": "#Du hast sicher viel durchmachen müssen, um zu so {F#einer bewundernswerten Dame}{M#einem bewundernswerten Herren} zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020339
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020339,
					"content": "Aber Timmie ist noch so klein. Vielleicht geht mich das ja gar nichts an, aber ich möchte einfach nicht, dass er zu viel durchmachen muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020340
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020340,
					"content": "Ich möchte ihm wenigstens eine Kindheit geben, an die er sich gern zurückerinnern wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020313,
					"content": "Ich werd mir Mühe geben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020314
					]
				},
				{
					"id": 201020314,
					"content": "#Ha, du bist mir ja eine{M#r} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020315
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020315,
					"content": "Aber ich denke, du bist kein schlechter Mensch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020316
					],
					"speakerTitle": "Grace"
				}
			]
		},
		{
			"id": 2010204,
			"completionStepIds": [
				2010203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
