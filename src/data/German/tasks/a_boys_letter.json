			},
			"dialogs": [
				{
					"id": 201020701,
					"content": "Hm, hast du ihm den Brief schon gebracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020702
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020702,
					"content": "Ja, diesen Brief hier hat Timmie seinem Vater geschrieben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020703
					]
				},
				{
					"id": 201020703,
					"content": "Seinem Vater ... Dann hat Grace dir sicher schon einiges erzählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020704
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020704,
					"content": "Diesen Brief ... kann ich leider nicht abschicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020705,
						201020708,
						201020712
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020705,
					"content": "Dann schickst du ihn eben nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020706
					]
				},
				{
					"id": 201020706,
					"content": "Ich wüsste auch gar nicht wie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020707
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020707,
					"content": "Mir bleibt nur, ihn für den Moment selbst aufzubewahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020717,
					"content": "Dann werde ich den Brief vorerst behalten. Tun wir so, als hätten wir den Brief abgeschickt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020718
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020718,
					"content": "Mein alter Freund hätte sicher Verständnis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020719
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020719,
					"content": "Danke und behalte das bitte für dich. Du wirst Timmie doch nichts sagen? Du bekommst auch etwas von mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020708,
					"content": "Verbrenn ihn einfach.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020709
					]
				},
				{
					"id": 201020709,
					"content": "Hahaha, du hast schon ein paar zu viele Abenteuer erlebt! Immer die effizienteste Variante ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020710
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020710,
					"content": "Ich bin allerdings kein Abenteurer, sondern ein einfacher Jäger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020711
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020711,
					"content": "Diesen Brief werde ich weder verbrennen noch öffnen. Ich werde ihn gut aufbewahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020712,
					"content": "Ich kann ihn aufbewahren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020713
					]
				},
				{
					"id": 201020713,
					"content": "Was willst du denn damit? Du glaubst doch nicht, dass mein alter Freund noch am Leben ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020714
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020714,
					"content": "Vielleicht begegnest du ihm ja tatsächlich, wenn du nur weit genug reist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020715
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020715,
					"content": "Ich war vorher auch noch voller Hoffnung und habe mich auf die Suche gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020716
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020716,
					"content": "Letzten Endes habe ich aber unser Schicksal anerkannt und mir eingestanden, dass mein alter Freund auf immer fort ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "Draff"
				}
			]
		},
