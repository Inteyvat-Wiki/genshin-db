			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timmie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020401,
					"content": "Immer noch keine Nachricht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020402,
						201020405
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020402,
					"content": "Fütterst du die Tauben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020403
					]
				},
				{
					"id": 201020403,
					"content": "Ich habe sie heute schon gefüttert. Danach habe ich sie weggescheucht, damit sie sich nicht vor dir fürchten müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020404
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020404,
					"content": "Im Moment schreibe ich nur einen Brief.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020407
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020407,
					"content": "Grace sagt, dass Papa einen Brief mit den Tauben schicken wird, wenn er Zeit hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020408
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020408,
					"content": "Aber bis jetzt hat er mir noch keinen geschickt. Vielleicht hat Papa ja wirklich so viel zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020409
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020409,
					"content": "Deswegen denk ich mir, dass ich ihm einfach einen schreiben sollte. Dann pack ich noch ein Geschenk mit dazu. Aber was wäre denn passend?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020410
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020410,
					"content": "<color=#00E1FFFF>Löwenzahn</color> wäre sicher gut! Grace meint, dass alle in Mondstadt Löwenzahn mögen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020411
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020411,
					"content": "Wenn du Zeit hast, kannst du mir ja etwas <color=#00E1FFFF>Löwenzahn</color> bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020412,
						201020414
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020412,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020413
					]
				},
				{
					"id": 201020413,
					"content": "Klasse! Du kannst ja doch ganz nett sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020414,
					"content": "Willst du ihm nicht lieber was anderes schenken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020415
					]
				},
				{
					"id": 201020415,
					"content": "Das würde ich gern. Aber was Schwereres können die Tauben doch nicht tragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020416
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020416,
					"content": "Und weil Papa ganz weit weg arbeitet, müssen die Tauben auch sehr weit fliegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020405,
					"content": "Was machst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020406
					]
				},
				{
					"id": 201020406,
					"content": "Ich schreibe meinem Papa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020407
					],
					"speakerTitle": "Timmie"
				}
			]
		},
