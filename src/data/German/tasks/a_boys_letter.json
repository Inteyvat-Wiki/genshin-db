			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timmie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020601,
					"content": "Hast du den Löwenzahn schon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020602
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020602,
					"content": "Ja, hier ist er.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020603
					]
				},
				{
					"id": 201020603,
					"content": "Klasse, das müsste genug sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020604
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020604,
					"content": "Tun wir den Löwenzahn in den Brief und verschließen ihn gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020605
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020605,
					"content": "Fertig! Papa wird sich bestimmt total freuen, wenn er den Brief bekommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020606
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020606,
					"content": "Für Briefe soll man aber echte Brieftauben verwenden, hab ich gehört ... Außerdem weiß ich Papas Adresse nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020607
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020607,
					"content": "Ach stimmt! Ich glaub, Grace hat mal erwähnt, dass Draff in Quellingen Brieftauben hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020608
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020608,
					"content": "Sie hat auch gesagt, dass Draff meinen Papa kennt. Dann weiß er bestimmt auch, wohin er die Brieftauben schicken muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020609
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020609,
					"content": "Kannst du Draff den Brief bringen, damit er ihn an Papa schicken kann? Das wäre supertoll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020610
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020610,
					"content": "Und du darfst ihn nicht heimlich lesen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
		},
		{
			"id": 2010207,
			"completionStepIds": [
				2010206
