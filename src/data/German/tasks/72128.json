			"trigger": {
				"objectNames": [
					"Takashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721280102,
					"content": "Ah, warte mal. Diese Truhen darf man nicht beliebig öffnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280103,
						721280105
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280103,
					"content": "Sind das deine Truhen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280104
					]
				},
				{
					"id": 721280104,
					"content": "Ja, natürlich. Ich habe diese Truhen absichtlich dorthingestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280106
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280106,
					"content": "Sie sind gefüllt mit allerlei Schätzen, die ich extra gesammelt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280107
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280107,
					"content": "Wenn du diese Truhen öffnen möchtest, ist das nicht unmöglich. Aber ... du musst mir etwas im Gegenzug geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280108,
						721280110
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280108,
					"content": "Mora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280109
					]
				},
				{
					"id": 721280109,
					"content": "Hahaha, es müssen nicht Mora sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280111
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280111,
					"content": "Was ich möchte, sind „Seeschnecken“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280112
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280112,
					"content": "Viele dieser Seeschnecken sind rund um den Strand zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280113
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280113,
					"content": "Wenn du die Truhen öffnen und die darin befindlichen Schätze bekommen möchtest, kannst du diese Seeschnecken dagegen eintauschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280114
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280114,
					"content": "Aber ... Ich werde dir nicht sagen, was in diesen Truhen ist und welche Schätze du bekommen kannst. Es ist abhängig von deinem Glück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280115
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280115,
					"content": "Wie sieht es aus? Wenn du diese Truhen öffnen möchtest, gibst du mir einfach diese Seeschnecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280110,
					"content": "Was möchtest du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280111
					]
				},
				{
					"id": 721280105,
					"content": "Was ist darin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280106
					]
				}
			]
		},
