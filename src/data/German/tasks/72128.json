			"dialogs": [
				{
					"id": 721280501,
					"content": "Du hast die Truhe geöffnet, oder? Hahaha, ich hoffe, du hast großes Glück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280502
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280502,
					"content": "Sammelst du diese Seeschnecken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280503
					]
				},
				{
					"id": 721280503,
					"content": "Du bist sehr scharfsinnig. Ja, ich sammle diese Seeschnecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280504
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280504,
					"content": "Aber den Grund für die Sammlung dieser Seeschnecken kann ich dir vorerst nicht erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280505,
						721280509
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280505,
					"content": "Gibt es etwas Besonderes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280506
					]
				},
				{
					"id": 721280506,
					"content": "Aus geschäftlicher Sicht ist das sicherlich etwas Besonderes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280507
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280507,
					"content": "„Seeschnecken, die einst von Tatarigami beeinflusst wurden“ ... Hahaha, die werden sicher einen guten Preis erzielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280508
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280508,
					"content": "Ah! Kurzum, wenn du mir diese Seeschnecken bringst, kannst du eine Truhe öffnen, verstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280511
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280511,
					"content": "Nun, du hast die Möglichkeit von heute schon verbraucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280512
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280512,
					"content": "Wenn du eine weitere Truhe öffnen möchtest, bring später weitere neue Seeschnecken zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280509,
					"content": "Wie verdächtig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280510
					]
				},
				{
					"id": 721280510,
					"content": "Es sind nur Seeschnecken. Sei nicht so paranoid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280511
					],
					"speakerTitle": "Takashi"
				}
			]
		},
