			"dialogs": [
				{
					"id": 721280401,
					"content": "Nicht schlecht! Das sind die Muscheln, die ich möchte. Suche dir eine Truhe aus und öffne sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280402,
						721280403
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280402,
					"content": "Nur eine Truhe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280404
					]
				},
				{
					"id": 721280404,
					"content": "Leider kannst du jeden Tag nur eine dieser Truhen öffnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280405
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280405,
					"content": "Na gut, such eine Truhe aus und öffne sie. Hehe, ich wünsche dir Glück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280403,
					"content": "Darf ich nicht alle öffnen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280404
					]
				}
			]
		},
		{
