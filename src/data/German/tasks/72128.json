			"dialogs": [
				{
					"id": 721280201,
					"content": "#Hm? Bist du {F#eine Reisende}{M#ein Reisender}? Hahaha, gerade rechtzeitig. Ich möchte etwas Tolles mit dir teilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280202
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280202,
					"content": "Meinst du diese Truhen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280203
					]
				},
				{
					"id": 721280203,
					"content": "Richtig. Es geht um die Truhen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280204
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280204,
					"content": "Sie sind gefüllt mit allerlei Schätzen, die ich extra gesammelt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280205
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280205,
					"content": "Gib mir einfach etwas und du kannst die Truhen öffnen, um die Schätze zu bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280206,
						721280208
					],
					"speakerTitle": "Takashi"
				},
				{
