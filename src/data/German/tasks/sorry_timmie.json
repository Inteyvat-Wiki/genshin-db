				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680101,
					"content": "Was mache ich denn jetzt am besten damit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680102
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680102,
					"content": "Was ist passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680103
					]
				},
				{
					"id": 200680103,
					"content": "Oh, du bist es. Du kommst genau im richtigen Moment. Timmie hat mir erzählt, was du mit den Enten angestellt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680104
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680104,
					"content": "Du ... Du ... Wie soll ich es ausdrücken? Es ist nicht so, als hätte ich nichts von deinen Taten gehört ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680105
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680105,
					"content": "Aber musstest du deinen Mut und deine Stärke wirklich auf diese Art einsetzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680106,
						200680107,
						200680108
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680106,
					"content": "Ich war zu hungrig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680109
					]
				},
				{
					"id": 200680109,
					"content": "Wenn du wirklich hungrig gewesen wärst, hättest du ein bisschen ehrlich arbeiten können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680110
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680110,
					"content": "Mit deinen Fähigkeiten hättest du sicherlich einen Platz in der Abenteurergilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680113,
					"content": "Ach, das ist doch nun alles Schnee von gestern. Aber Timmie ist ziemlich traurig deswegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680114
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680114,
					"content": "Ich ... Timmies Vater hat mir mal beigebracht, wie man ein bestimmtes Gericht zubereitet. Einen Kartoffelpuffer nach Mondstadt-Art mit Philanemo-Pilzen ist Timmies Lieblingsgericht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680115
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680115,
					"content": "Bitte hilf mir, drei Philanemo-Pilze zu finden. Timmie fühlt sich danach bestimmt viel besser und du kannst dich bei ihm entschuldigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680116,
						200680117
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680116,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680118
					]
				},
				{
					"id": 200680118,
					"content": "Nun gut, fort mit dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680120,
					"content": "Und zu den Philanemo-Pilzen ... Ich erinnere mich, dass du welche unter den Dachrinnen der Häuser im südlichen Teil der Stadt finden kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680121
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680121,
					"content": "Bitte komm bald zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680117,
					"content": "So soll es sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680119
					]
				},
				{
					"id": 200680119,
					"content": "Nur drei sind genug! Was willst du mit so vielen Champignons? Wirst du Timmie jedes Mal, wenn du ihn nervst, mit einem Gericht bestechen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680107,
					"content": "Es war ein Unfall, wirklich!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680111
					]
				},
				{
					"id": 200680111,
					"content": "Du hast diese Enten und Tauben ausversehen getroffen? Hast du deine gefährlichen Feinde, denen du auf deinen Abenteuern begegnet bist, auch ausversehen besiegt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680108,
					"content": "Stärke entsteht durch tägliches Training wie dieses.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680112
					]
				},
				{
					"id": 200680112,
					"content": "Du ... ich ... vergiss es. Sieht so aus, als wäre deine „Stärke“ wirklich nicht einseitig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Grace"
				}
			]
		},
		{
