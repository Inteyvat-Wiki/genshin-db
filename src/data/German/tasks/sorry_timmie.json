			"dialogs": [
				{
					"id": 200680501,
					"content": "Bitte gib Timmie diesen Kartoffelpuffer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680502,
						200680506
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680502,
					"content": "Diese „Mama“, von der Timmie spricht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680503
					]
				},
				{
					"id": 200680503,
					"content": "Das bin ich. Ich kümmere mich um die Kinder, die jetzt für eine Weile jemanden brauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680504
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680504,
					"content": "Auf Timmie habe ich am längsten aufgepasst. Er nennt mich inzwischen sogar „Mama“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680505
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680505,
					"content": "In Wahrheit bin ich aber nicht seine echte Familie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680506,
					"content": "Warum ist Timmie so wütend?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680507
					]
				},
				{
					"id": 200680507,
					"content": "Wie kannst du sowas überhaupt Fragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680508
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680508,
					"content": "Dieses Kind hat nicht viele Freunde oder Leute in der Stadt, denen er nahesteht. Er hat also außer Nora und Glory nur die kleinen Tierchen als Gesellschaft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680509
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680509,
					"content": "Die Tauben sind tatsächlich sogar ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680510
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680510,
					"content": "... Nein, egal. Bitte gib Timmie diesen Kartoffelpuffer so schnell du kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
