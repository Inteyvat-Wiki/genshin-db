				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680301,
					"content": "Iss, iss. Iss und geh, schnell ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680302,
						200680303,
						200680304
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680302,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680305
					]
				},
				{
					"id": 200680305,
					"content": "Du schon wieder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680308,
					"content": "Was hast du vor? Versuchst du, den Enten und Tauben wehzutun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680309,
						200680310
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680309,
					"content": "Dieser Kartoffelpuffer ist für dich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680311,
					"content": "Ein Kartoffelpuffer? Hmm. Woher weißt du, wie man sowas macht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680312
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680312,
					"content": "Ich weiß es, du musst Mama gefragt haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680313
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680313,
					"content": "Hmpf. Willst du mich bestechen, einfach so? Ich weiß, was du mit den Vögeln gemacht hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680314
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680314,
					"content": "...Trotzdem, da Mama dich mit dem Kartoffelpuffer hergeschickt hat, ist es wohl ihre Art zu sagen, mit dem Ärger aufzuhören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680315
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680315,
					"content": "Sie muss sich immer noch um Nora und Glory kümmern. Es wäre unreif von mir, ihr das Leben schwer zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680316
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680316,
					"content": "Aber ich will es deutlich sagen, ich habe dich nicht vergessen! Ich will einfach Mama keinen Ärger machen. Verstehst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680317
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680317,
					"content": "Trotzdem ... hmpf. Ich wette, es liegt daran, dass ich ein Kind bin. Du wirst dein Versprechen einfach vergessen, wenn es dir in den Kram passt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680318
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680318,
					"content": "Sobald Papa zurück ist, erzähle ich ihm alles über dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680310,
					"content": "Bitte nimm diesen Kartoffelpuffer!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680303,
					"content": "He, Timmie ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680306
					]
				},
				{
					"id": 200680306,
					"content": "Du schon wieder? Lass mich in Ruhe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680304,
					"content": "Ist etwas passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680307
					]
				},
				{
					"id": 200680307,
					"content": "Wie kannst du mich das überhaupt fragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "Timmie"
				}
			]
		},
