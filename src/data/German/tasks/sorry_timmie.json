					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680401,
					"content": "Danke, diese sollte genügen. Warte bitte einen Moment ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680402
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680402,
					"content": "Das sollte passen. Bitte gib Timmie diesen Kartoffelpuffer nach Mondstadt-Art.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680403
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680403,
					"content": "Und bitte, mach ... so etwas in Zukunft nicht mehr. Es ist den Ärger nicht wert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680404
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680404,
					"content": "Bitte hör auf meinen Rat. Enttäusche Timmie nicht ... oder mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680405
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680405,
					"content": "Wenn doch nur jeder auf Ratschläge hören würde. Dann wäre Schwester Victoria nicht so beschäftigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
		{
			"id": 2006805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
