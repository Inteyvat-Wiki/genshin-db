			"dialogs": [
				{
					"id": 751770101,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770102
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770102,
					"content": "#He, {REALNAME[ID(2)|SHOWHOST(true)]}, woher hast du diesen Fotoapparat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770103,
					"content": "Hast du dich an jemanden herangeschlichen und ... Das geht nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770104,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770105,
					"content": "*brüll* ... *brüll*! *brüll* ... *brooah*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770106,
						751770108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770106,
					"content": "Das kommt mir ziemlich bekannt vor ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770107
					]
				},
				{
					"id": 751770107,
					"content": "Oh, die „Große Schmorflamme“, oder!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770110,
					"content": "Hehe, gab es damals bei den „Kinder der Echos“ nicht diesen Typen, der Regisseur werden wollte, aber seinen Fotoapparat falsch eingesetzt hat ... Ah! So bist du also zu deinem Fotoapparat gekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770111,
					"content": "*brüll*! *brüll* ... *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770112,
					"content": "Du willst ein Foto mit uns machen. Hehe, das ist es doch, was du meinst, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770113,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770114,
					"content": "Stimmt ... Wir haben schon so viel gemeinsam erlebt, aber wir haben noch kein Foto gemacht! Jetzt ist auch der Fluch von dem kleinen Kerl genommen, er kann nun gesund aufwachsen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770115,
					"content": "#Wer weiß, wie lange es dauert, bis er ein großer Tepetlisaurier wird? Wenn er sich morgen auf einen Schlag verwandelt, dann ist es das letzte Mal, dass wir {REALNAME[ID(2)|SHOWHOST(true)]} als kleinen Saurier sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770116,
						751770118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770116,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770117
					]
				},
				{
					"id": 751770117,
					"content": "Ach, komm schon, nur ein Foto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770119,
					"content": "Meisterfotografin Paimon hat alles vorbereitet, das sollte genau richtig sein! Und der Fotoapparat ist definitiv auf uns gerichtet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770120,
					"content": "Wir rufen zusammen „Große Schmorflamme“! Alle zusammen: Auf drei! Eins, zwei, drei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770121,
					"content": "„Große Schmorflammeee“!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770122
					]
				},
				{
					"id": 751770122,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770123,
					"content": "#Fertig! Schau mal, {REALNAME[ID(2)|SHOWHOST(true)]} sieht voller Elan aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770124,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770125
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770125,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} nimmt sich eines der Fotos, dreht sich um und verstaut es sorgsam unter dem harten Panzer, direkt auf dem weichen Rücken.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770126
					]
				},
				{
					"id": 751770126,
					"content": "#Warum will {REALNAME[ID(2)|SHOWHOST(true)]} auf einmal Fotos machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770127,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770128
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770128,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770129
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770129,
					"content": "*brüll* ... *brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770130
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770130,
					"content": "#He, {REALNAME[ID(2)|SHOWHOST(true)]}, was ist los? Fühlst du dich nicht gut? Du siehst ... irgendwie nicht glücklich aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770131,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770132
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770132,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770133
					]
				},
				{
					"id": 751770133,
					"content": "Du willst bestimmt auf dein eigenes Abenteuer gehen, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770134
					]
				},
				{
					"id": 751770134,
					"content": "Was? Dein eigenes Abenteuer? D... Du willst also nicht mehr mit uns reisen? Hat Paimon dich etwa verärgert ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770135,
					"content": "Paimon wird dich nie wieder verfressen nennen, versprochen! Bleib doch einfach bei uns, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770136,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770137
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770137,
					"content": "Paimon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770138
					]
				},
				{
					"id": 751770138,
					"content": "*seufz* Schon klar ... Irgendwann wird der kleine Kerl erwachsen und muss seinen eigenen Weg gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770139,
					"content": "Aber trotzdem ... es ist schwer, plötzlich einfach so Abschied zu nehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770140,
					"content": "Schon gut ... wir werden uns ja wiedersehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770141
					]
				},
				{
					"id": 751770141,
					"content": "#Wirklich? Also ... wenn wir irgendwann mal Hilfe brauchen, dann musst du sofort hierherkommen, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770142,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770143
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770143,
					"content": "#Solltest du jemals in Schwierigkeiten geraten, musst du uns sofort um Hilfe bitten. Du darfst nicht versuchen, den Helden zu spielen, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770144,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770145
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770145,
					"content": "... Und, iss nicht zu viel, und wenn du auf einen großen Gegner triffst, den du nicht besiegen kannst, dann lauf einfach weg. Aber auch wenn du nicht zu viel essen sollst, den geschmorten Fleischeintopf musst du trotzdem essen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770146,
					"content": "Und das Allerallerallerwichtigste ist, dass ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770147,
					"content": "... Dass du glücklich und kräftig wirst!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770148
					]
				},
				{
					"id": 751770148,
					"content": "Ja, du musst riesig groß werden! Mindestens so groß wie drei Berge!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770149
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770149,
					"content": "*brüll*! *brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770150
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770150,
					"content": "Das ist genau ... *schnief* genau die richtige Einstellung! Du musst dich an uns erinnern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770151,
					"content": "Inmitten des stillen Waldes genießt ihr gemeinsam den geschmorten Fleischeintopf als Abschiedsmahl und bereitet das hin und wieder genutzte Lager vor.\\nFür deinen Sauriergefährten, der künftig allein seine Wege gehen wird, hast du einige Andenken eurer gemeinsamen Reise vorbereitet. Ihr erinnert euch an alles, was ihr auf dieser Reise erlebt habt: den Yumkasaurier, der den Höhleneingang versperrte, die Pummelrobben am Strand und die vielen besonderen Menschen, die ihr in Natlan getroffen habt ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770152
					]
				},
				{
					"id": 751770152,
					"content": "Und dieser Kerl, der mit dieser seltsamen goldenen Schrift kommunizierte ...\\nPaimon meint: „Der hat uns eiskalt ausgenutzt! Von Anfang bis Ende hat er sich nicht mal blicken lassen.“\\nDas lässt dich an jenen Moment in den Tiefen des heiligen Bergs von Tollan zurückdenken, als sich in den Augen des jungen Sauriers eine komplexe Gefühlswelt widerspiegelte.\\n... Noch ist er klein, aber eines Tages wird er bestimmt ein mächtiger Saurier!",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770153
					]
				},
				{
					"id": 751770153,
					"content": "Zuletzt stupst er mit seinen Hörnern sacht Paimons Stirn und schmiegte sich an deine ausgestreckte Hand.\\nDann, als wolle er sich selbst Mut machen ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770154
					]
				},
				{
					"id": 751770154,
					"content": "... dreht sich der junge Saurier entschlossen um und stapft davon.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 751770118,
					"content": "Na gut, dann mach!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770119
					]
				},
				{
					"id": 751770108,
					"content": "Es ist die „Große Schmorflamme“!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770109
					]
				},
				{
					"id": 751770109,
					"content": "Ah, jetzt, da du es sagst, erinnert sich Paimon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770110
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}