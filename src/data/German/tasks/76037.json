			},
			"dialogs": [
				{
					"id": 760370501,
					"content": "(Über den Schmuggler ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370502
					]
				},
				{
					"id": 760370502,
					"content": "„Kopfgeldziel: Neue Eisensalzbande. Grund: Verdacht auf großangelegten Schmuggel mit gefährlichen, kontrollpflichtigen Gütern.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370503
					],
					"speakerTitle": "Kopfgeldziele"
				},
				{
					"id": 760370503,
					"content": "„Untersuchungen zufolge hat die Bande einen vorübergehenden Stützpunkt in einem <color=#00E1FFFF>Lager am nördlichen Stadtrand</color>. Die Spina di Rosula wird diejenigen großzügig belohnen, die dabei helfen, ihre Schmuggelaktivitäten zu unterbinden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kopfgeldziele"
				}
			]
		},
