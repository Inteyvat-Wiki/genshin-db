			"dialogs": [
				{
					"id": 760370201,
					"content": "(An der Anschlagtafel stehen die Details über die Kopfgeldziele ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kopfgeldziele"
