			"dialogs": [
				{
					"id": 760370101,
					"content": "Die Informationen zu allen vier Kopfgeldzielen findest du am Brett. Du kannst mich auch fragen, aber über die Höhe der Belohnung lässt sich nicht verhandeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370107,
						760370102,
						760370108
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370107,
					"content": "Reiche die Beweise ein, dass du Kopfgeldziele erledigt hast.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 760370102,
					"content": "Über die Ziele des Kopfgelds ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370103
					]
				},
				{
					"id": 760370103,
					"content": "Momentan gibt es vier Ziele, aber nur zu drei davon gibt es Hinweise. Die Wahrsagerin Hidimbi aus Sumeru, die wegen Betrugs gesucht wird, hält sich häufig <color=#00E1FFFF>in der Nähe des südlichen Hafens</color> auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370104
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370104,
					"content": "Der wahnsinnige Kairagi aus Inazuma hat bereits mehrere Händler getötet, die den <color=#00E1FFFF>leeren Korridor</color> durchquerten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370105
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370105,
					"content": "Die Bandenmitglieder, die gefährliche Waren schmuggeln, sollen sich in einem <color=#00E1FFFF>Lager am nördlichen Strand des Dorfes</color> verschanzt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370106
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370106,
					"content": "Der grausame Pirat „Kinnbrecher“ Hark ist momentan nicht aufzufinden. Er versteckt sich vermutlich irgendwo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370108,
					"content": "Tschüs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370109
					]
				},
				{
					"id": 760370109,
					"content": "Wiedersehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leszek"
				}
			]
		},
		{
