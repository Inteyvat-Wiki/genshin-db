			"dialogs": [
				{
					"id": 760370401,
					"content": "(Über den Kairagi ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370402
					]
				},
				{
					"id": 760370402,
					"content": "„Kopfgeldziel: Gonpachi, Inazuma-Bewohner in Kairagi-Rüstung. Grund: Wahllose Angriffe auf reisende Händler, mehrere Tote.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370403
					],
					"speakerTitle": "Kopfgeldziele"
				},
				{
					"id": 760370403,
					"content": "„Das Ziel wurde beim <color=#00E1FFFF>Leeren Korridor</color> gesichtet. Wer es erledigt und den Tod beweist, bekommt von der Händlergilde eine fette Belohnung.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kopfgeldziele"
				}
			]
		},
		{
			"id": 7603705,
			"completionStepIds": [],
