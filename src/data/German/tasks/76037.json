					"nextDialogs": [
						760370602
					]
				},
				{
					"id": 760370602,
					"content": "„Kopfgeldziel: Der ehemalige Steuermann der ‚Atlas‘, ‚Kinnbrecher‘ Hark. Grund für das Kopfgeld: Verantwortlich für mehrere Morde, begangen mit äußerster Brutalität, derzeit auf der Flucht.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370603
					],
					"speakerTitle": "Kopfgeldziele"
				},
				{
					"id": 760370603,
					"content": "„Jeder, der einen Hinweis zu seinem Aufenthaltsort liefern kann, wird nach Bestätigung großzügig belohnt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kopfgeldziele"
