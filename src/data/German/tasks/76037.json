			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 760370301,
					"content": "(Über Hidimbi ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370302
					]
				},
				{
					"id": 760370302,
					"content": "„Kopfgeldziel: Hidimbi, Wahrsagerin aus Sumeru, weiblich, Alter unbekannt. Grund: Verdacht auf Verfluchung und schweren Betrug.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370303
					],
					"speakerTitle": "Kopfgeldziele"
				},
				{
					"id": 760370303,
					"content": "„Diese Frau hat mir ganze 18 Millionen Mora abgeknöpft. Sie meinte, die Kette, die sie dem Liebesgott Al-Ahmar angeblich abgerungen hatte, würde alle Mädchen in mich verliebt machen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370304
					],
					"speakerTitle": "Kopfgeldziele"
				},
				{
					"id": 760370304,
					"content": "„Später habe ich rausgefunden, dass Al-Ahmar gar kein Liebesgott war. Seit Tausenden Jahren tot und zu Lebzeiten hat er nie ein Mädchen rumgekriegt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370305
					],
					"speakerTitle": "Kopfgeldziele"
				},
				{
					"id": 760370305,
					"content": "„Das heißt, die Kette war echt, aber mit einem Fluch belegt, der mich vom Verlieben abhält. Wer mir hilft, sie zu finden und den Fluch zu lösen, kriegt eine fette Belohnung.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kopfgeldziele"
				}
			]
		},
		{
			"id": 7603704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
