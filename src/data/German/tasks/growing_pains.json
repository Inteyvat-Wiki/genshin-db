					"Kleine Lulu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000601,
					"content": "Hallo, hast du mein Parfum gekriegt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000602
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 225000602,
					"content": "Ja, hier ist es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000603
					]
				},
				{
					"id": 225000603,
					"content": "Danke dir! Ying’er macht das beste Parfum überhaupt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000604
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 225000604,
					"content": "Ich frag mich, was der kleine Meng und der kleine Fei tun werden, wenn sie es riechen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000605
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 225000605,
					"content": "Ich denke: Egal, wie sie reagieren, es wird sehr lustig sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000606,
						225000608
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 225000606,
					"content": "Sie werden es lieben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000607
					]
				},
				{
					"id": 225000607,
					"content": "Ich hoffe es. Es wäre es das Beste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000610
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 225000610,
					"content": "Danke für deine Hilfe. Ich werde bald nach Hause gehen und mein neues Parfum ausprobieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000611
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 225000611,
					"content": "Falls es gut ist, werde ich es wieder und wieder verwenden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 225000608,
					"content": "Mit wem spielst du am liebsten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000609
					]
				},
				{
					"id": 225000609,
					"content": "Hmm? Ich ... Ich mag sie beide gleich! Der kleine Meng und der kleine Fei sind meine besten Freunde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000610
					],
					"speakerTitle": "Kleine Lulu"
				}
			]
