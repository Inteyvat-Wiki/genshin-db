			"trigger": {
				"objectNames": [
					"Kleine Lulu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000101,
					"content": "Wann wird es fertig sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000102
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 225000102,
					"content": "Spielt ihr heute gar nichts?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000103
					]
				},
				{
					"id": 225000103,
					"content": "Oh, hallo! Ja, momentan passt es nicht so gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000104
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 225000104,
					"content": "Der kleine Meng ist schlecht gelaunt und schmollt lieber alleine und der kleine Fei verschwindet die ganze Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000105
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 225000105,
					"content": "Ich habe den kleinen Meng gefragt, was los sei, aber er hat es mir nicht gesagt. Sie verhalten sich beide so komisch in letzter Zeit. Ich weiß wirklich nicht, was in sie gefahren ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000106,
						225000110
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 225000106,
					"content": "Willkommen in der Welt der Erwachsenen, mein Kind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000107
					]
				},
				{
					"id": 225000107,
					"content": "Warte mal! Also wenn man erwachsen ist, hört man auf, glücklich zu sein? Warum wollen der kleine Meng und der kleine Fei also so dringend erwachsen werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000108
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 225000108,
					"content": "Ich denke, dann werde ich einfach nicht erwachsen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000109
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 225000109,
					"content": "Nun ja, wir kommen vom Thema ab. Ich brauche tatsächlich deine Hilfe bei etwas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 225000112,
					"content": "Kannst du mir etwas von Ying’er bringen? Wir haben bereits darüber gesprochen, sie sollte es mittlerweile fertig haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000113,
						225000115
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 225000113,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000114
					]
				},
				{
					"id": 225000114,
					"content": "Juhu! Danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 225000115,
					"content": "Von Ying’er also, aha ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000116
					]
				},
				{
					"id": 225000116,
					"content": "Es ist schon nichts Schlimmes. Ich habe Ying’er nur gefragt, etwas für mich zu machen. Und sie hat zugesagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000117
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 225000117,
					"content": "Und jetzt möchte ich dich bitten, es für mich zu besorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 225000110,
					"content": "Bist du auch unglücklich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000111
					]
				},
				{
					"id": 225000111,
					"content": "Ich? Nein, mir geht es gut. Aber ... ich brauche deine Hilfe bei etwas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "Kleine Lulu"
				}
			]
		},
		{
			"id": 2250002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
