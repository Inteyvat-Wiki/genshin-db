			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ying’er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000201,
					"content": "Oh, nochmal hallo. Du vermisst mich schon, oder nicht? Warum bist du dieses Mal hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000202
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225000202,
					"content": "Um etwas für die kleine Lulu abzuholen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000203
					]
				},
				{
					"id": 225000203,
					"content": "Die kleine Lulu? ... Oh, richtig. Sie hat mich gefragt, ob ich etwas Parfum für sie herstellen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000204
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225000204,
					"content": "Aber ich befürchte, das ist nicht der beste Zeitpunkt ... Aus irgendeinem Grund haben viele meine Duftessenzen bestellt, nachdem du das letzte Mal hier warst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000205
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225000205,
					"content": "Ich habe enorm viele Bestellungen erhalten. Es sind so viele, dass ich sie nicht alleine bewältigen kann, zumal ich auch noch den Laden betreuen muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000206
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225000206,
					"content": "Außerdem ist Lulu noch ein Kind. Es wäre ein bisschen unangebracht, ihr die gleiche Art von Parfüm zu geben, wie es von erwachsenen Frauen getragen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000207
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225000207,
					"content": "Also habe ich mir den Kopf zermartert und überlegt, wie ich mein Parfüm kinderfreundlicher gestalten könnte. Nun habe ich mich für eine passende Rezeptur entschieden, aber ich bin noch nicht dazu gekommen, sie zuzubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000208
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225000208,
					"content": "Wenn es wirklich nicht warten kann, wäre es nicht unmöglich, es zu beschleunigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000209
					],
					"speakerTitle": "Ying’er"
				}
			]
		},
		{
			"id": 2250003,
			"completionStepIds": [
				2250002
			],
