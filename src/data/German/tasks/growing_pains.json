			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ying’er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000301,
					"content": "Sind dreitausend Mora genug?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000302
					]
				},
				{
					"id": 225000302,
					"content": "Oh, da ist jemand verzweifelt ... Na gut, ich werde Lulus Parfum als Zeichen unserer Freundschaft vorziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000303
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225000303,
					"content": "Ich muss am Tag aber auf den Laden aufpassen. Meine persönlichen Angelegenheiten regle ich am besten in der Nacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000304
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225000304,
					"content": "Komm heute Abend vorbei und ich werde alles für dich bereithalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying’er"
				}
			]
		},
		{
			"id": 2250004,
			"completionStepIds": [
				2250002
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ying’er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000401,
					"content": "Ich helfe dir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000402
					]
				},
				{
					"id": 225000402,
					"content": "Keine schlechte Idee. Du hast in diesen Angelegenheiten schließlich etwas Erfahrung. Also, das letzte Mal, als du hier warst, hast du mich sicherlich beeindruckt. *kicher*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000403
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225000403,
					"content": "Zufällig habe ich die notwendigen Zutaten direkt hier. Ich werde es in Chefkoch Maos Küche vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000404
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225000404,
					"content": "Gehe los und pflücke drei Blätter Minze. Extrahiere dann die ätherischen Öle an einer Werkbank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000405
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225000405,
					"content": "Bring mir das Essentielle Minzöl, ich kümmere mich um den Rest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying’er"
				}
			]
		},
		{
