					"Ying’er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000501,
					"content": "Das Parfum ist bereit. Eine maßgeschneiderte Art mit Essentiellem Minzöl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000502
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225000502,
					"content": "Hier. Es ist jetzt bereit für die kleine Lulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000503,
						225000504
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225000503,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 225000504,
					"content": "Warum Minze?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000505
					]
				},
				{
					"id": 225000505,
					"content": "Es wirkt den etwas ... hmm, stimulierenderen Elementen mit seinem neutralen Duft entgegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000506
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225000506,
					"content": "Um ehrlich zu sein, ich war sehr überrascht, eine Bestellung von Lulu zu erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000507
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225000507,
					"content": "Es lässt mich zurückdenken, als ich so alt war. Man schmeckt zum ersten Mal die Liebe, oh wie das Herz flattert ... Wenn ich damals nur etwas welterfahrener gewesen wäre ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000508
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225000508,
					"content": "Ähm ... Ich sollte dich jedenfalls zurück zu Lulu gehen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying’er"
				}
			]
		},
		{
