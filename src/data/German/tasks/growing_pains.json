					"nextDialogs": []
				},
				{
					"id": 225001203,
					"content": "Für was wollte Lulu es?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225001204
					]
				},
				{
					"id": 225001204,
					"content": "Hat sie mir nicht gesagt. Und ich hab sie nicht gefragt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001205
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225001205,
					"content": "Jedes Mädchen hat seine Geheimnisse. Einiges verborgen zu lassen, die taktvolle Seite zu zeigen, es gehört alles zum Reiz eines Mädchens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001206
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225001206,
					"content": "Na gut, fort mit dir. Bring es zu Lulu.",
