			"dialogs": [
				{
					"id": 225001001,
					"content": "Essentielles Minzöl, hast du verstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001002,
						225001006
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225001002,
					"content": "Wie stelle ich es her?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225001003
					]
				},
				{
					"id": 225001003,
					"content": "Wir haben es vor Kurzem zusammen gemacht, kannst du dich nicht erinnern? Was? Also vergisst du Dinge ebenso schnell, wie du anfängst, dich damit zu befassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001004
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225001004,
					"content": "Dann werde ich dir eine Zusammenfassung geben. Geh los und pflücke drei Blätter Minze, extrahiere dann das essentielle Öl an der Werkbank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001005
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225001005,
					"content": "Bring das ätherische Öl zu mir und ich erledige den Rest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225001006,
					"content": "Für was wird Essentielles Minzöl verwendet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225001007
					]
				},
				{
					"id": 225001007,
					"content": "Wie soll ich es sagen ... es neutralisiert einige der stimulierenderen Elemente in dem Gebräu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001008
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225001008,
					"content": "Aber noch wichtiger: Der Geruch passt gut zu einem Kind wie Lulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001009
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225001009,
					"content": "Beim Geruch eines Mädchens ist viel mehr involviert als nur die Nase ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001010
					],
					"speakerTitle": "Ying’er"
				},
				{
					"id": 225001010,
					"content": "Das Parfum muss Lulus jugendliche Lebenslust, ihre kindliche Unschuld einfangen ... *kicher*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying’er"
				}
			]
