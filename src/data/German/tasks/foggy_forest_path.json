				]
			},
			"dialogs": [
				{
					"id": 740820101,
					"content": "(„... Tau ... singt auf dem Nebelpfad im einsamen Wald ...“ ... Der Großteil der Schrift ist weggekratzt und nur schwer zu entziffern.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820102
					],
					"speakerTitle": "Beschriftete Steinplatte"
				},
				{
					"id": 740820102,
					"content": "Ach Mensch! So viele Wörter sind weggekratzt! Ist das eine Einführung zu einer Sehenswürdigkeit? Pah, manche Touristen sind einfach so ungehobelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820103,
					"content": "Normalerweise schreiben die Touristen etwas, nicht wahr?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820104
					]
				},
				{
					"id": 740820104,
					"content": "#Hm ... Stimmt auch wieder. Schreiben wir etwas wie „{NICKNAME} und Paimon waren hier!“ ... Nein, lieber nicht. Wir sind doch sehr anständig und machen keine Kritzeleien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820105,
					"content": "Aber ist es dann nicht seltsam, dass die Schrift weggekratzt wurde? Es bleibt nur ein Satz übrig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820106,
					"content": "Und selbst dieser Satz hat Kratzer! Glücklicher Nebelpfad im einsamen Wald, du bist wirklich ein Glückspilz, der überlebt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820107,
					"content": "Was ist der Nebelpfad im einsamen Wald denn für einen Ort?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820108
					]
				},
				{
					"id": 740820108,
					"content": "Hm ... Vielleicht ein sehr nebliger Pfad in einem Wald? Das ist wohl damit gemeint ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820109,
					"content": "Paimon will nach diesem Ort suchen! Immer wenn man das Gefühl hat, dass es ein verstecktes Geheimnis gibt, führt es zu einem wertvollen Schatz! Paimon hat es in den Büchern gelesen, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820110,
						740820111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820110,
					"content": "An welchem Straßenstand hast du denn das Buch gelesen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820112
					]
				},
				{
					"id": 740820112,
					"content": "Paimon weiß nicht nur wie man isst! Paimon hat so eine Ahnung, dass auf diesem Nebelpfad im einsamen Wald ein Schatz versteckt sein muss. Deshalb möchte jemand die Worte wegkratzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820113,
					"content": "#{NICKNAME}, es wird Zeit für eine Schatzsuche! Schnapp dir Paimon, deine allerbeste Reisegefährtin, die eine untrügliche Spürnase für Schätze hat, und mach dich auf den Weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820111,
					"content": "In welchem Archiv hast du denn das Buch gelesen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820112
					]
				}
			]
		},
