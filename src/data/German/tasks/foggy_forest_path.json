			"dialogs": [
				{
					"id": 740820401,
					"content": "(„... Tau ... drei ...“ ... Der Großteil der Schrift ist weggekratzt und nur schwer zu entziffern.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820402
					],
					"speakerTitle": "Geheimnisvoller Altar"
				},
				{
					"id": 740820402,
					"content": "Argh! Die Worte darauf wurden auch weggekratzt, da steckt garantiert ein Geheimnis dahinter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820403,
						740820406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820403,
					"content": "Tau?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820404
					]
				},
				{
					"id": 740820404,
					"content": "Was ist damit gemeint? Tautropfen? Aber wir können die auf jedem Gras und jedem Blatt finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820405,
					"content": "Und das Wort „drei“, heißt das etwa drei Tropfen? So verwirrend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820409,
					"content": "Schnell, befrage deine untrügliche Spürnase für Schätze!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820410
					]
				},
				{
					"id": 740820410,
					"content": "Paimon hat sie schon befragt! Also ... Also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820411,
					"content": "Sie sagt, dass es eine Verbindung zwischen „drei“ und „Tau“ gibt. Wir sollten uns in der Umgebung umsehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820406,
					"content": "Drei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820407
					]
				},
				{
					"id": 740820407,
					"content": "Sind mit „drei“ drei Sachen gemeint?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820408,
					"content": "... Und was genau bedeutet der Tau? Tautropfen? Aber wir können die auf jedem Gras und jedem Blatt finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "Paimon"
				}
			]
		},
