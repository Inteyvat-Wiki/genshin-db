			"dialogs": [
				{
					"id": 740820901,
					"content": "Ein kristallklarer Wassertropfen erschien auf dem Altar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820902
					]
				},
				{
					"id": 740820902,
					"content": "Toll, dann haben wir jetzt den dritten Schlüssel, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820903,
					"content": "Schlüssel, Schlüssel, Schlüssel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820904
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820904,
					"content": "Keine Spur, Pahsiv!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820905
					]
				},
				{
					"id": 740820905,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv! Schlüssel, Schlüssel, Schlüssel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820906
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820906,
					"content": "Platz, West!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820907,
					"content": "Hehe. Ist es das, was du sagen willst? Keine Sorge, wir gehen jetzt hin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
