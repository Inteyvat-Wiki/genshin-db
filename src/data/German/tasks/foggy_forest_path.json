			},
			"dialogs": [
				{
					"id": 740821001,
					"content": "Toll, noch ein Schlüssel. Dann brauchen wir nur noch den letzten Schlüssel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821002,
					"content": "Schlüssel, Schlüssel, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821003
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821003,
					"content": "Boah, Pahsiv! Wie tauchst du plötzlich hier auf?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821004,
					"content": "Keine Spur, Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821005
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821005,
					"content": "Nun gut ... Paimon hat wirklich noch nie eine so besondere Melusine wie dich gesehen ... Und Paimon dachte, dass alle Melusinen am Hof von Fontaine oder in Mérusea leben. Wie kommt es, dass du allein hier bist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821006,
					"content": "Hof von Fontaine? Mérusea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821007
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821007,
					"content": "Du scheinst ziemlich verwirrt zu sein. Hast du diese beiden Namen noch nie gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821008,
					"content": "Hof von Fontaine, Melusine ... Mérusea, Melusine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821009
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821009,
					"content": "Äh ... Erinnyes, Pahsiv, Zuhause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821010
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821010,
					"content": "Erinnyes, Pahsiv, schützen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821011
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821011,
					"content": "Warte mal. Hast du gerade gesagt, dass dies dein Zuhause ist und du es beschützt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821012,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821013
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821013,
					"content": "Aber kommen nicht alle Melusinen aus Mérusea?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821014
					]
				},
				{
					"id": 740821014,
					"content": "Genau! Seltsam ... Es gibt noch Melusinen, die an einem anderen Ort geboren wurden? Aber es gibt hier anscheinend keine anderen Melusinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821015,
					"content": "Pahsiv, lebst du hier ganz alleine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821016,
					"content": "Alleine? Melusine. Nur wie nett! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821017
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821017,
					"content": "Nur ... wie nett? Wen meinst du damit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821018,
					"content": "#Nur wie nett! Paimon, Paimon. {NICKNAME}, {NICKNAME}. Nur wie nett, nur wie nett!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821019
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821019,
					"content": "Und wer ist das genau?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821020
					]
				},
				{
					"id": 740821020,
					"content": "Pahsiv, meinst du, dass der Name dieser Person einfach „nur wie nett“ ist, so wie Paimon Paimon heißt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821021,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821022
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821022,
					"content": "Aha! So ist das. Hehe, Paimon hat doch gesagt, dass Paimon auch sehr schlau ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821023,
						740821024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821023,
					"content": "Ein sehr seltsamer Name.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821025
					]
				},
				{
					"id": 740821024,
					"content": "Ein sehr netter Name.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821025
					]
				},
				{
					"id": 740821025,
					"content": "Nur wie nett, Pahsiv, Wissen, hellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821026
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821026,
					"content": "Hmm ... Willst du sagen, dass diese nette Person dir hilft, Dinge zu lernen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821027
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821027,
					"content": "Pahsiv! Sehr viel. Sprache, Wissen ... Sehr, sehr viel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821028
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821028,
					"content": "Ähm ... Irgendwie hat Paimon das Gefühl, dass es doch nicht so viel ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821029,
					"content": "Pahsiv, nur wie nett, schützen, hellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821030
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821030,
					"content": "Diese Person hilft dir auch, diesen Ort zu schützen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821031,
					"content": "Melusine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821032
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821032,
					"content": "Du hilfst ihr, diesen Ort zu beschützen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821033
					]
				},
				{
					"id": 740821033,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821034
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821034,
					"content": "So ist das also ... Wer ist diese Person eigentlich? Weshalb braucht sie deine Hilfe, um diesen Ort zu beschützen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821035
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821035,
					"content": "Zudem haben sich hier wirklich einige üble Dinge ereignet. Die Texte von der Steinplatte, die wir gesehen haben, wurden von jemandem weggekratzt. Und wir haben gerade auch eine Menge Unreinheiten gesehen ... Gibt es hier irgendwelche Feinde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821036
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821036,
					"content": "Paimon neugierig, Pahsiv! Aber Zeit, sehr, sehr wenig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821037
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821037,
					"content": "Schlüssel, Schlüssel, Schlüssel, Platz, West. Hellen, hellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821038
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821038,
					"content": "Wir werden uns beeilen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821039
					]
				},
				{
					"id": 740821039,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821040
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831040,
					"content": "Pahsiv macht zwei Sprünge vor Freude in die Luft und geht etwas in Eile davon.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740831041
					]
				},
				{
					"id": 740821041,
					"content": "Anscheinend drängt wirklich die Zeit. Glücklicherweise haben wir bereits zwei Schlüssel. Lass uns mit Volldampf den dritten Schlüssel besorgen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
