							10671.01
						],
						"pointId": 12598
					}
				]
			},
			"dialogs": [
				{
					"id": 760100601,
					"content": "He, habt ihr das gesehen? Ich weiß nicht, was gerade passiert ist, aber als ich kurz nicht aufgepasst habe, ist dieser große Felsbrocken plötzlich weggeflogen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100602
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100602,
					"content": "Du erzählst von den vorherigen Ereignissen ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760100603
					]
				},
				{
					"id": 760100603,
					"content": "Oha! Auch wenn ich überhaupt nicht verstehe, was hier los ist, steht ihr allem Anschein nach in der Gunst des Mond{RUBY#[D]Kuutar}mädchens, wenn ihr solch ein Wunder vollbringen könnt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100604
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100604,
					"content": "Gelobt sei die Mondgöttin! Jetzt kann ich hier endlich nach Herzenslust angeln! Wenn nur dieser lästige Barde nicht wieder mit seinem Begleiter vorbeikommt und singt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100605
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100605,
					"content": "Hier ist die versprochene Bezahlung! Zwar habe ich in letzter Zeit keine Fische gefangen, aber doch eine Menge anderer Kleinigkeiten ... einige davon sollten ziemlich wertvoll sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100606
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100606,
					"content": "Aber hier auf der Insel Hiisi braucht man sowieso keine Mora, also könnt ihr alles haben. Danke für eure Hilfe, und jetzt lasst mich in Ruhe angeln!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pekkani"
				}
			]
		}
	]
}