			"dialogs": [
				{
					"id": 760100201,
					"content": "Fünfundzwanzig ... sechsundzwanzig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100202
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100202,
					"content": "Hm, was zählst du denn da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100203,
					"content": "Pssst ... ! Sprich leiser ... Ach, egal, diesmal beißt sowieso nichts mehr an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100204
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100204,
					"content": "Hör mal, Kleine, das solltest du doch auf den ersten Blick verstehen, oder? Natürlich warte ich darauf, dass ein Fisch anbeißt. Was denkst du denn, was ich mit der Angelrute mache?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100205,
						760100207
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100205,
					"content": "Als Nachkommen des Frostmonds wäre es ja nicht unmöglich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760100206
					]
				},
				{
					"id": 760100206,
					"content": "#Ach, {M#junger Mann}{F#junge Dame}, du überschätzt mich. Ich bin höchstens ein halber Nachkommen des Frostmonds, nicht einmal ein Priestergehilfe, einfach nur ein normaler Mensch, der kein Kuuvahki beherrscht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100210
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100210,
					"content": "Egal, lassen wir das, aber Paimon sieht zum ersten Mal jemanden, der beim Angeln die Sekunden zählt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100211,
					"content": "Ach, es kommt doch auf die Angeltechnik an und nicht darauf, wie lange man am Ufer steht. Der alte Ilmari versteht genau das nicht, deswegen fängt er auch nie einen Fisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100212
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100212,
					"content": "Hm? Und ihr seid dann wohl Schatzjäger?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100213
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100213,
					"content": "#Nein, wir sind {F#Abenteurerinnen}{M#Abenteurer} ... äh, brauchst du Hilfe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100214,
					"content": "Egal, ob ihr Schatzjäger oder Abenteurer seid – Hauptsache, ihr macht den Job gegen Bezahlung. Wenn ihr Zeit habt, würde ich euch gerne um einen Gefallen bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100215
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100215,
					"content": "Siehst du, meine Angelkunst ist eindeutig die beste auf der Insel Hiisi, selbst unter allen Mondkantorinnen der Geschichte konnte niemand mich beim Angeln übertreffen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100216
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100216,
					"content": "I... Ist das so? Beeindruckend ... Moment mal! Wenn man genauer darüber nachdenkt, ist das gar nicht so beeindruckend, denn Fischen gehört ja nicht zu den Hauptaufgaben einer Mondkantorin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100217,
					"content": "Trotzdem habe ich, so geschickt wie ich bin, in letzter Zeit keinen einzigen Fisch gefangen! Woran liegt das nur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100218
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100218,
					"content": "Es ist doch ganz offensichtlich, dass das Problem nicht bei mir liegt, sondern an der Umgebung. Wie beim verfluchten Auge von Kratti muss es auch hier unter Wasser etwas geben, das die Fischschwärme beeinflusst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100219
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100219,
					"content": "D... Das ist aber eine merkwürdige Schlussfolgerung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100220,
					"content": "Deshalb bitte ich euch beide, das Gewässer in der Umgebung zu untersuchen und herauszufinden, was die Fische vom Anbeißen abhält. Keine Sorge, ihr werdet dafür auch ordentlich entlohnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100221
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100221,
					"content": "Nun, gegen Bezahlung sehen wir uns hier mal um ... aber wir können dir nicht versprechen, dass wir wirklich etwas Seltsames finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100207,
					"content": "Vielleicht suchst du ja nach einer allerbesten Reisegefährtin ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760100208
					]
				},
				{
					"id": 760100208,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100209
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100209,
					"content": "Nicht jeder kann einfach so eine allerbeste Reisegefährtin aus dem Wasser angeln ... Moment mal, darum geht es doch gar nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100210
					],
					"speakerTitle": "Paimon"
				}
			]
		},
