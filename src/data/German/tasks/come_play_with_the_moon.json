				{
					"id": 761220402,
					"content": "Er ist wirklich wunderschön.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220403
					]
				},
				{
					"id": 761220403,
					"content": "Kann Paimon herumfliegen und sich umsehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220404,
					"content": "Natürlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220405
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761220405,
					"content": "Wenn es dir recht ist, könnte ich dich eines Tages wiederherbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220406
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761220406,
					"content": "Also, das ist dann wohl die „angenehme Überraschung“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220407,
					"content": "Ach? Das reicht also schon, um in deinen Augen als „schöne Überraschung“ durchzugehen? Nein, die eigentliche Überraschung kommt erst noch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220408
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761220408,
					"content": "Gibt es noch mehr?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220409
					]
				},
				{
					"id": 761220409,
					"content": "Kommt. Lasst uns malen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220410
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761220410,
					"content": "Warte mal. Hier? Aber Paimon sieht hier nirgendwo eine Leinwand, Pinsel oder Farben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220411,
					"content": "Oh. Das ist ganz einfach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220412
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761220412,
					"content": "Die Wasseroberfläche ist unsere Leinwand, das Mondlicht unsere Pinsel, und die Wege, die wir gehen, werden unsere Pinselstriche sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220413
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761220413,
					"content": "Mit dem Spiegelbild des Mondes als Wegweiser werden reine Gedanken unter unseren Füßen fließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				}
			]
		}
	]
}