			"dialogs": [
				{
					"id": 761220101,
					"content": "Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220102,
					"content": "Hä? Das ist seltsam. Paimon ist sich sicher, Columbinas Stimme gehört zu haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220103,
					"content": "... Hya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220104
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761220104,
					"content": "Aaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220105,
					"content": "Grüße.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220106
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761220106,
					"content": "Noch so ein Schreckmoment? Das ist nicht cool! Wenn du schon hier warst, hättest du das einfach sagen können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220107,
					"content": "Ich dachte, da ihr euch mit diesem Spiel schon so gut auskennt, sollte ich die Schwierigkeit in dieser Runde etwas erhöhen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220108
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761220108,
					"content": "Hmpf! Beim nächsten Mal erwischt dich Paimon, wart’s nur ab!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220109,
					"content": "Toll! Ich freue mich schon darauf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220110
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761220110,
					"content": "Was ist mit deiner Augenmaske passiert, Columbina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220111
					]
				},
				{
					"id": 761220111,
					"content": "Oh. Kuuhenki muss sie mitgehen lassen haben, als wir vorhin gespielt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220112
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761220112,
					"content": "Normalerweise brauche ich meine Augen nicht, deshalb macht die Maske kaum einen Unterschied. Lass sie damit spielen, wenn sie möchten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220113
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761220113,
					"content": "Oh! Wo wir gerade dabei sind, möchtest du nicht öfter rausgehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220114,
					"content": "Du musst dich doch vor niemandem mehr verstecken, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220115
					]
				},
				{
					"id": 761220115,
					"content": "Ja ... Ich habe jetzt viel Zeit. Ich kann gehen, wohin ich will und wann ich will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220116
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761220116,
					"content": "Allerdings hatte ich Bedenken, dass ihr euch Sorgen machen würdet, wenn ihr nach mir sucht und feststellt, dass ich ohne ein Wort des Abschieds gegangen bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220117,
						761220118
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761220117,
					"content": "In so einer Situation ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				},
				{
					"id": 761220119,
					"content": "Genau! Wir müssen ja nur wissen, dass es dir gut geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220120,
					"content": "Verstehe. Ich werde darüber nachdenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220121
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761220121,
					"content": "Du wirst nur darüber „nachdenken“ ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220122,
					"content": "Oder vielleicht ist das hier genau der Ort, an dem sie sein möchte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220123
					]
				},
				{
					"id": 761220123,
					"content": "Alles, was hier passiert ist ... Ich finde, das sind glückliche Erinnerungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220124
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761220124,
					"content": "Allerdings habe ich noch einen anderen Grund, warum ich hier auf euch gewartet habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220125
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761220125,
					"content": "Und der wäre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220126,
					"content": "Um euch eine schöne Überraschung zu bereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761220118,
					"content": "... kannst du einfach eine Nachricht hinterlassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				}
			]
		},
