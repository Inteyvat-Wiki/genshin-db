			},
			"dialogs": [
				{
					"id": 220060101,
					"content": "Wo ist es nur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060102
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220060102,
					"content": "Was hast du denn jetzt schon wieder verloren ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060103
					]
				},
				{
					"id": 220060103,
					"content": "Dieses mal habe ich nichts „verloren“, ich habe gerade mit der Suche begonnen! Aber gefunden habe ich es noch nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060104
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220060104,
					"content": "Wo ist es nur? Die Stelle zu finden ist wirklich nicht einfach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060105
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220060105,
					"content": "Du hilfst mir am besten auch bei der Suche, solch ein wertvolles Relikt, sowas darf man nicht zurücklassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060106,
						220060107
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220060106,
					"content": "Na gut ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060108
					]
				},
				{
					"id": 220060108,
					"content": "Geh du am besten dorthin, ich suche hier weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060109
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220060109,
					"content": "Ich muss es finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220060107,
					"content": "Was ist es denn dieses Mal für ein Relikt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060110
					]
				},
				{
					"id": 220060110,
					"content": "Es ist ... ja es ist ein, ähm ... sehr altes ... tausend Jahre altes, ach was, noch aus der Zeit des Archontenkriegs!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060111
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220060111,
					"content": "Zusammengefasst, es ist ein sehr wertvolles Relikt, das man nicht einfach so zurücklässt! Jetzt hilf mir doch auch mal beim Suchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao’er"
				}
			]
		},
