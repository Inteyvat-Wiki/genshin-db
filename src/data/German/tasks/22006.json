			"dialogs": [
				{
					"id": 220060701,
					"content": "Nur gut, dass die Jadescheibe nicht beschädigt wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060702,
						220060706
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060702,
					"content": "Warum hast du es ihnen nicht gegeben, als du angegriffen wurdest?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060703
					]
				},
				{
					"id": 220060703,
					"content": "Ein kulturelles Relikt, Gelehrte können es studieren, Künstler können es ausstellen und den Leuten zeigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060704
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060704,
					"content": "Diebe jedoch dürfen es nie für schnelles Geld verkaufen. Dies wäre nicht nur eine Beleidigung für das Relikt, sondern für die gesamte Geschichte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060705
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060705,
					"content": "Ich werde mich niemals denen beugen, die keinen Respekt vor kulturellen Relikten zeigen und auf der Geschichte herumtrampeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060706,
					"content": "Diese Jadescheibe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060707
					]
				},
				{
					"id": 220060707,
					"content": "Ach, du interessierst dich für diese Jadescheibe? Ist es ihr Wert oder ihr Preis, der dich interessiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060708
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060708,
					"content": "Ich mache natürlich nur Quatsch, diese Jadescheibe enthält Aufzeichnungen über den Archontenkrieg, anscheinend über zwei verfeindete Stämme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060709
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060709,
					"content": "Wenn man es genau übersetzen könnte, könnten einige Lücken in den Geschichtsbüchern gefüllt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060710
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060710,
					"content": "Obwohl diese „Lücken“ vielleicht ja schon vor langer Zeit gefüllt worden sind und ich sehe es nur nicht ...",
					"roleType": "TALK_ROLE_NPC",
