			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bao’er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060601,
					"content": "Du warst aber lange weg. Hast du irgendwas entdeckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060602,
						220060603
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220060602,
					"content": "Ich habe das hier gefunden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060604
					]
				},
				{
					"id": 220060604,
					"content": "Tja, es sieht gar nicht schlecht aus, aber es ist trotzdem nicht das, was ich gesucht habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060605
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220060605,
					"content": "Nichtsdestotrotz, ein Relikt ist ein Relikt, daher vertrau es mir ruhig an. Ich werde schon einen Nutzen dafür finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060609
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220060609,
					"content": "Danke für deine Mühe, diese Sachen sind für dich, nimm sie bitte an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060610
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220060610,
					"content": "Aber das kulturelle Relikt, das ich suche, ist immer noch da draußen, ich sorge mich wirklich darum ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220060603,
					"content": "Ist das, wonach du gesucht hast?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060606
					]
				},
				{
					"id": 220060606,
					"content": "Es sieht gar nicht schlecht aus, aber es ist trotzdem nicht das, was ich gesucht habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060607
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220060607,
					"content": "Übrigens, du weißt bestimmt nicht, wie man kulturelle Relikte aufbewahrt, du könntest es beschädigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060608
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220060608,
					"content": "Vertrau es mir ruhig an, ich werde schon einen guten Kurs dafür erzielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
