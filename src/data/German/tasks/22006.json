			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060301,
					"content": "#Vielen Dank, Reisende{M#r}! Puh, gerade habe ich mich zu Tode erschreckt, die Schatzräuber hier werden auch immer furchtloser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060302,
					"content": "Wer bist du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060303
					]
				},
				{
					"id": 220060303,
					"content": "Mein Name ist Soraya, ich bin eine reisende Gelehrte, derzeit bin ich hier in Recherchen vertieft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060304,
					"content": "Vor ein paar Tagen folgte ich einer Spur, die mich zu einer Ruine führte, in der ich wiederum eine Jadeplatte aus der Zeit des Archontenkriegs fand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060305,
					"content": "Als ich mit der Jadeplatte die Ruine verlassen wollte, wurde ich von einer Gruppe Schatzräuber angegriffen. Ich rannte eine ganze Weile lang, aber letztendlich holten sie mich dennoch ein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060306
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060306,
					"content": "Ohne eure Hilfe wären ich und die Jadeplatte jetzt noch nicht in Sicherheit. Ich danke euch noch einmal zutiefst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060307
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060307,
					"content": "Du bist auch eine Gelehrte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060308
					]
				},
				{
					"id": 220060308,
					"content": "Auch? Das heißt, es gibt hier noch andere Gelehrte? Wie heißt er oder sie denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060309
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060309,
					"content": "Bao’er ... Wartet mal, während ich gerade von den Schatzräubern überfallen wurde, hörte ich einen von ihnen sagen, „Bao’er darf nicht allein von dem Schatz profitieren“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060310
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060310,
					"content": "Was für ein Zufall ... Entschuldigung, könnt ihr mir mehr über diese Bao’er erzählen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060311
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060311,
					"content": "Also das war so ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060312
					]
				},
				{
					"id": 220060312,
					"content": "Die Position, die diese Bao’er dir gegeben hat, habe ich ausgewählt. Solch ein „Zufall“, wirklich sehr merkwürdig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060313
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060313,
					"content": "Sollte sie wirklich ein Mitglied der Schatzräuber sein, dann ist es wohl so, wie ich vermute. Ich werde von einer Gruppe Schatzräuber verfolgt, die mich ausnutzen, um an einen Schatz zu kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060314
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060314,
					"content": "Diese Bao’er will nur Profit in ihre eigene Tasche wirtschaften, daher hat sie als erstes zugeschlagen. Jedoch ist sie allein, so ein großes Suchgebiet ist zu viel für sie allein, also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060315
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060315,
					"content": "#Es scheint fast so, als hätte euch jemand ausgenutzt, Reisende{M#r}. Ich fürchte, das ist genau die Position, die sie schon länger im Visier hatte. Ihre Kumpanen und ich, wir sind euch nur einen Schritt voraus gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060316
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060316,
					"content": "Sei nicht zu nervös, das sind ja alles nur Vermutungen bis jetzt, aber Bao’er, dieser Name ... hört sich schon sehr dubios an, so wie ein falscher Name, oder ein Code für irgendwas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060317
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060317,
					"content": "#{F#Reisende}{M#Reisender}, kannst du sie für mich ablenken? Was immer auch passiert, diese verdächtige Person darf die Jadescheibe nicht in die Finger bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060318,
						220060319
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060318,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060320
					]
				},
				{
					"id": 220060320,
					"content": "Danke dir, wobei ich dich so mit leeren Händen nicht davonziehen lassen kann. Das wäre verdächtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060321
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060321,
					"content": "Wir machen das so, ich habe hier noch eine nicht so teure Kleinigkeit, die kannst du mitnehmen und ihr geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060322
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060322,
					"content": "Auch wenn es nur eine Kleinigkeit ist, aber es wird sie eine Weile ruhig stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060325,
					"content": "Genug, geh jetzt besser schnell zurück. Du hast ihre Komplizen erfolgreich in die Flucht geschlagen, aber sie war ja auch allein. Warte bis ihre Komplizen davon erfahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060326
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060326,
					"content": "Übrigens, wenn sie dich noch einmal beauftragt, etwas für sie zu suchen, und du es findest, gib es gleich mir. Ich halte mich für gewöhnlich im Gasthaus Wangshu auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060327
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060327,
					"content": "Meine Fähigkeiten mögen Grenzen haben, aber Relikte zu bewachen, das kann ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060319,
					"content": "Mit leeren Händen zurückzukommen würde sie bestimmt misstrauisch werden lassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060323
					]
				},
				{
					"id": 220060323,
					"content": "Ja, das stimmt ... Wir machen das so, ich habe hier noch eine nicht so teure Kleinigkeit, die kannst du mitnehmen und ihr geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060324
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060324,
					"content": "Auch wenn es nur eine Kleinigkeit ist, aber es wird sie eine Weile ruhig stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "Soraya"
				}
			]
		},
