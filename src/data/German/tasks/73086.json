			"dialogs": [
				{
					"id": 730860201,
					"content": "Gut, was spielen wir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730860202
					]
				},
				{
					"id": 730860202,
					"content": "Eine Holztruhe kann vieles verstecken, zum Beispiel ... glänzende Dinge von verschiedenen Elementen! Aragita kann sich natürlich erinnern, <color=#00E1FFFF>wo glänzende Dinge des Dendro-Elements sind</color>. Kann Nara das auch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730860206
					],
					"speakerTitle": "Aragita"
				},
				{
					"id": 730860206,
					"content": "Na klar. Fangen wir an.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
