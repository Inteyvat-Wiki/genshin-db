				{
					"id": 721110301,
					"content": "Das ist ... ähem, woher hast du das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110302,
						721110304
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110302,
					"content": "Flussabwärts des Grabens.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110303
					]
				},
				{
					"id": 721110303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110306
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110306,
					"content": "Wie auch immer, du hast keinen Beweis dafür, dass diese beiden Dinge miteinander verbunden sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110307
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110307,
					"content": "Oh, sie sind schon miteinander verknüpft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110308,
					"content": "Wie sind sie verknüpft?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110309
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110309,
					"content": "Es sei denn ... es gibt eine Art Geheimcode auf der Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110310
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110310,
					"content": "Auf der Mora gibt es nichts, aber wir haben anderswo etwas gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110311,
					"content": "Wir fanden dies in der Nähe der Überreste eines Wagens ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721110304,
					"content": "Wir haben sie auf den Ästen der Bäume am Eingang des Dorfes gefunden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110305
					]
				},
				{
					"id": 721110305,
					"content": "Wie kann das sein ... Mich so zu testen führt zu nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110306
					],
					"speakerTitle": "Konda Densuke"
				}
			]
		},
