					"id": 721110502,
					"content": "Versuch nicht, mich mit irgendwelchen zufälligen Dingen zu täuschen, Kleiner!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110503
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110503,
					"content": "Dies wurde absichtlich in einer regnerischen Nacht zurückgelassen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211106,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211106",
							"3"
						],
						"stepId": 7211106,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"7211103"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Konda Densuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110601,
					"content": "Was ist das? Ich kann es nicht lesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110602
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110602,
					"content": "Versuch nicht, mich mit irgendwelchen zufälligen Dingen zu täuschen, Kleiner!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110603
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110603,
					"content": "Wir fanden dies in der Nähe der Überreste eines Wagens ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211107,
			"completionStepIds": [
				7211107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211101",
							"3"
						],
						"stepId": 7211101,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211102",
							"3"
						],
						"stepId": 7211102,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211103",
							"3"
						],
						"stepId": 7211103,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211107",
							"2"
						],
						"stepId": 7211107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Konda Densuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110701,
					"content": "Das ist ... Das ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110702
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110702,
					"content": "Ich kann nicht glauben, dass ich so unvorsichtig war, als ich den Wagen beschädigt habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110703
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110703,
					"content": "He, jetzt hast du es endlich zugegeben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110704,
					"content": "Da du in deiner Untersuchung schon so weit gekommen bist, gibt es nichts mehr zu verheimlichen. Ich kann es nicht mehr verstecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110705
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110705,
					"content": "In diesem Fall solltest du eine ziemlich gute Vorstellung davon haben, was passiert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110706
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110706,
					"content": "In der Tat eine sehr gute Idee! Großvater Densuke, du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110707,
					"content": "Du hast versucht, einen Bakufu-Karren zu rauben, nicht wahr? Und inmitten des Kampfes hast du den Karren mit einem einzigen Hieb zerstört, wodurch die Waren in den Graben flogen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110708,
					"content": "In der Hoffnung, sich zu retten, warfen die Leute des Bakufu ihre Geldbeutel in den Brunnen, um dich abzulenken! Und dann hast du den Brunnen verschlossen, um andere daran zu hindern, die Mora zu stehlen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110709,
					"content": "Ist das richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110710,
					"content": "Ah? Nein, das ist ganz und gar nicht so passiert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110711
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110711,
					"content": "Wirklich? Paimon wollte nach deinem Schlüssel fragen und diese Mora auf dem Grund des Brunnens haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110712,
					"content": "... um sie dem Bakufu zu übergeben! Das ist richtig! Sie würden definitiv an das Bakufu ausgeliefert werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110713,
					"content": "Die Sache ist so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110714
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110714,
					"content": "Ursprünglich gab es eine Gruppe junger Leute im Dorf, die zu dreist wurden, nachdem sie sich betrunken hatten, und tatsächlich einen der Frachtkarren des Bakufu ausgeraubt haben. Diese Waren und die Tasche gehören beide dem Bakufu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110715
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110715,
					"content": "Ich konnte nicht zulassen, dass andere wissen, dass dieser schändliche Vorfall in unserem Dorf passiert ist. Deshalb habe ich versucht, es zu vertuschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110716
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110716,
					"content": "Was ist mit deinem Geständnis bezüglich des Geldbeutels ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110717,
					"content": "Ich habe das getan, um die Wahrheit zu vertuschen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110718
					]
				},
				{
					"id": 721110718,
					"content": "Das ist richtig. Ich dachte, dass du die Ermittlungen einstellen würdest, sobald ich gestanden habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110719
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110719,
					"content": "Wenn es nur mich beträfe ... Solange niemand anderes betroffen ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110720
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110720,
					"content": "Bitte melde das nicht dem Bakufu. Es geht mir nicht darum, mein Gesicht zu wahren. Ich möchte nur nicht, dass das ganze Dorf mit in den Abgrund gerissen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110721,
						721110724
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110721,
					"content": "Ich bin nicht daran interessiert, dich zu melden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110722
					]
				},
				{
					"id": 721110722,
					"content": "Ja, das ist nicht der Grund, warum wir hierhergekommen sind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110723,
					"content": "Dann ist ja gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110727,
					"content": "Mein Gewissen plagte mich immer wieder wegen dieser Vertuschung, also hielt ich alles in einem Tagebuch fest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110728
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110728,
					"content": "Ich habe das Tagebuch auf das Dach geworfen. Wenn du es wirklich lesen willst, bediene dich, aber ruiniere bitte nicht mein frisch renoviertes Dach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110729
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110729,
					"content": "Über das Schloss am Brunnen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110730
					]
				},
				{
					"id": 721110730,
					"content": "Ja, ich war es, der den Brunnen verschlossen hat. Ich habe auch aufgeschrieben, wo ich den Schlüssel versteckt habe. Geh und schau selbst nach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110731
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110731,
					"content": "Großvater Densuke, weißt du etwas über die Barriere im Dorf Konda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110732,
					"content": "Barriere? Oh, die Leute wissen also immer noch von dieser alten Legende ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110733
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110733,
					"content": "Man sagt, dass in alten Zeiten, unter dem Boden, auf dem wir gerade stehen, die Wurzeln der Donner-Sakura lagen. In der Tat war dies eine der fünf Wurzeln, die den Frieden auf Narukami schützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110734
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110734,
					"content": "Und sie und ihre Barriere zu bewachen, wurde uns, dem Konda-Klan, von der Kitsune Saiguu selbst aufgetragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110735
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110735,
					"content": "Aber das ist schon sehr, sehr lange her. Ich erinnere mich kaum noch an die Details.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110724,
					"content": "Ich will nur die Wahrheit wissen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110725
					]
				},
				{
					"id": 721110725,
					"content": "Ja, das ist nicht der Grund, warum wir hierhergekommen sind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110726,
					"content": "Die Wahrheit? Hehe ... Ihr jungen Leute von heute seid so interessant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "Konda Densuke"
				}
			]
		},
