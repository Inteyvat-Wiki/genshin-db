			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Konda Densuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110201,
					"content": "Eine Tasche für Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110202
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110202,
					"content": "Das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110203
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110203,
					"content": "... Das gehört zu unserer Familie. Es ist nichts Verdächtiges daran. Das ist richtig, es ist ganz normal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110204
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110204,
					"content": "Er ist so verdächtig! Irgendetwas stimmt definitiv nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110205,
						721110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110205,
					"content": "Dann zeichne jetzt bitte die Markierung, die darauf war.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110210
					]
				},
				{
					"id": 721110210,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110211
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110211,
					"content": "Gut. Das ist in der Tat nicht mein Geldbeutel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110212
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110212,
					"content": "So viele Leute sind an meinem Garten vorbeigekommen, da ist es doch ganz normal, dass es jemand fallen gelassen hat, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110213
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110213,
					"content": "Das ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110214
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110214,
					"content": "Wie kann das sein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110215
					]
				},
				{
					"id": 721110215,
					"content": "*seufz* Ja, du hast mich durchschaut, wirklich. Ich war wirklich in Versuchung, den Geldbeutel für mich zu nehmen, weißt du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110216
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110216,
					"content": "Oh Densuke, wie kann ein alter Mann wie du nur solche schelmischen Gedanken haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110217,
						721110218
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110217,
					"content": "Irgendetwas ist hier nicht in Ordnung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110219
					]
				},
				{
					"id": 721110219,
					"content": "Ich habe bereits meinen Wunsch geäußert, das Geld zu stehlen. Was könnte sonst das Problem sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110220
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110220,
					"content": "Komm jetzt, ich werde diesen Geldbeutel an das Bakufu übergeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110221
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110221,
					"content": "Irgendetwas fühlt sich hier nicht richtig an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110222,
						721110223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110222,
					"content": "Jemand hat diesen Geldbeutel absichtlich weggeworfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110227
					]
				},
				{
					"id": 721110227,
					"content": "Welchen Beweis hast du für diese Behauptung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110228
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110228,
					"content": "Der Geldbeutel ist nur ein Teil des Geheimnisses. Wir haben auch das gefunden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110229,
					"content": "#Was gefunden? Hmm, du bist jetzt dran, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110230,
					"content": "#({NICKNAME}, was haben wir vorhin im Graben gefunden?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110231,
					"content": "Dies wurde absichtlich in einer regnerischen Nacht zurückgelassen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721110223,
					"content": "Du machst dir wohl zu viele Gedanken, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110224
					]
				},
				{
					"id": 721110224,
					"content": "#(Das kann nicht stimmen! {NICKNAME}, war Opa Densuke wirklich nur hinter den Mora her?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110225,
					"content": "(Er muss doch etwas anderes verbergen, oder?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110226,
					"content": "Jemand hat diesen Geldbeutel absichtlich weggeworfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110227
					]
				},
				{
					"id": 721110218,
					"content": "Du versteckst etwas anderes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110219
					]
				},
				{
					"id": 721110206,
					"content": "Bitte sag mir, wie viel Mora da drin war.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110207
					]
				},
				{
					"id": 721110207,
					"content": "Hahaha, was ist das denn für eine Frage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110208
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110208,
					"content": "Es gibt auch keine Möglichkeit zu wissen, wie viel Mora da drin war, ohne es zu öffnen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110209
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110209,
					"content": "Dann zeichne jetzt bitte die Markierung, die darauf war.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110210
					]
				}
			]
		},
