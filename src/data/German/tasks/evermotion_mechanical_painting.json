			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue",
					"Swan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140101,
					"content": "Der Enthusiasmus in Mondstadt übertrifft meine kühnsten Träume ... Die Stadt macht ihrem Namen alle Ehre, selbst die Hilichurle waren so energiegeladen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140102
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140102,
					"content": "Auf jeden Fall ... Herr Yogue, bitte gehe nie wieder allein aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140103
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140103,
					"content": "Was? Was ist dann mit meinen Vorrichtungen, da fehlen doch immer noch ... äh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140104
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140104,
					"content": "Eins, zwei, drei ... achtzehn ... neunzehn Komponenten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140105
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140105,
					"content": "Es gibt bereits Abenteurer, die nach ihnen suchen, also kannst du in Ruhe in der Stadt warten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140106
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140106,
					"content": "Aber ohne diese Vorrichtungen, meine ... meine Inspiration, verstehst du? Was tue ich, wenn ich inspiriert werde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140107
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140107,
					"content": "Inspiration ist flüchtig, wie ... wie ein Rülpser nach einem Drink, oh, wie flüchtig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140108
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140108,
					"content": "Aha, das ist eine gute Analogie, die muss ich mir aufschreiben, Xavier wird sie lieben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140109
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140109,
					"content": "Ich ... Du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140110
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140110,
					"content": "Hm? Ehrenritter ... wunderbar! Ehrenritter! Bitte komm schnell!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140111,
						705140112
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140111,
					"content": "Was ist los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				},
				{
					"id": 705140113,
					"content": "Darf ich vorstellen, er ist vom Hof von Fontaine, er ist ein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140114
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140114,
					"content": "Ein Visionär! So nennen wir uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140115
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140115,
					"content": "... Herr Yogue, das ist unser Ehrenritter von Mondstadt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140116
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140116,
					"content": "Aha! Yogue, Félix Yogue! Sei gegrüßt, Ehrenritter! Ich habe schon viel von deinen vielen Heldentaten gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140117
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140117,
					"content": "Kennst du mich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140118
					]
				},
				{
					"id": 705140118,
					"content": "Aber natürlich! Natürlich kenne ich dich, wer kennt dich nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140119
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140119,
					"content": "Dein Kampf mit Dvalin in Mondstadt wurde drei Wochen lang auf der Titelseite des „Dampfvogels“ gezeigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140120
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140120,
					"content": "Hahaha, diese Journalisten wären grün vor Neid, wenn sie wüssten, dass ich mit dir rede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140121,
						705140124
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140121,
					"content": "Was ist der „Dampfvogel“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140122
					]
				},
				{
					"id": 705140122,
					"content": "Wusstest du das nicht? Der „Dampfvogel“ ist eine ... nun ja ... bekannte Zeitung am Hof von Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140123
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140123,
					"content": "Und du hast ihnen geholfen, noch viel mehr Ausgaben zu verkaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140125,
					"content": "Schlag... Schlagzeilen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140126
					]
				},
				{
					"id": 705140126,
					"content": "Natürlich! Du hast ihnen geholfen, die bestverkaufte Zeitung zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140127
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140127,
					"content": "Schlagzeilen auf der ersten Seite, die ganze Ausgabe lang, Interviews mit Experten und die besten handgezeichneten Bilder, ha! Die verdienen sich eine goldene Nase!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140128
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140128,
					"content": "#Also ... {F#Reisende}{M#Reisender}, Herr Félix Yogue, ihr unterhaltet euch, während ich ... äh ... entschuldigt mich, ich muss mich um etwas anderes kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140129
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140129,
					"content": "Und so rannte Swan schnell weg ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705140130
					]
				},
				{
					"id": 705140130,
					"content": "Es scheint, dass die Ritter des Ordo Favonius wirklich so viel zu tun haben, wie ich gehört habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140131
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140131,
					"content": "Warum bist du dann nach Mondstadt gekommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140132
					]
				},
				{
					"id": 705140132,
					"content": "Ich? Ich plane, durch ganz Teyvat zu reisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140133
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140133,
					"content": "Und der Zweck meiner Reise ist es, diesen „kinetischen Kern“ zu verkaufen, den ich hergestellt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140134
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140134,
					"content": "Einfach ausgedrückt handelt es sich um ein Uhrwerk, das in bestimmten Abständen gedreht werden muss, um für eine lange Zeit kinetische Energie zu generieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140135
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140135,
					"content": "Um diese Vorrichtung zu demonstrieren, habe ich auch ein Maschinenspielzeug mit konstanter Bewegung geschaffen, das von einem „kinetischen Kern“ angetrieben wird und das von mir als „mechanisches Perpetuum-Mobile-Puzzle“ bezeichnet wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140136
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140136,
					"content": "Aber so gern ich dir diese Vorrichtung auch zeigen würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140137
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140137,
					"content": "Diese Vorrichtung ist so herausragend, dass selbst Monster ihrem Charme kaum widerstehen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140138
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140138,
					"content": "Im Moment ... wird meine Vorrichtung von den Monstern ganz unschön in tausende Einzelteile zerlegt, wie ein Spielzeug in den Händen von Kindern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140139
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140139,
					"content": "Obwohl ich die Abenteurergilde um Hilfe gebeten habe, können mir auch die Abenteurer nichts Neues mitteilen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140140
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140140,
					"content": "Wenn es dich interessiert, Ehrenritter, kannst du mir diesen Gefallen tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140141
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140141,
					"content": "Glaube mir, weder meine Vorrichtung noch die Entlohnung werden dich enttäuschen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140142
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140142,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140143
					]
				},
				{
					"id": 705140143,
					"content": "#Bravo, du bist wirklich {M#ein so starker und mitfühlender Abenteurer}{F#eine so starke und mitfühlende Abenteurerin}, wie es in der Zeitung steht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140144
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140144,
					"content": "Es ist schade, dass wir jetzt in Mondstadt sind. Wenn wir im Hof von Fontaine wären, hätte ich einen Journalisten vom „Dampfvogel“ für ein Interview zu dir geschickt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140145
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140145,
					"content": "Sie würden wieder einmal so beeindruckt von deinem Charme sein, dass sie dir bereitwillig die Titelseite und Honorare für die nächsten drei Wochen geben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140124,
					"content": "Schlagzeilen auf der ersten Seite, die ganze Ausgabe lang, Interviews mit Experten und die besten handgezeichneten Bilder, ha! Die verdienen sich eine goldene Nase!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140112,
					"content": "Was ist denn passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				}
			]
		},
		{
