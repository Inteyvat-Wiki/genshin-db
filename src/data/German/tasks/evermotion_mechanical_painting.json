				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140401,
					"content": "Genau, das sind sie! Toll, meine Komponenten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140402
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140402,
					"content": "Jetzt, da die Komponenten gefunden sind, müssen sie nur noch zusammengefügt werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140403
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140403,
					"content": "Nun ... wenn du Interesse hast, Ehrenritter, kannst du dich daran versuchen, die Teile des „mechanischen Perpetuum-Mobile-Puzzles“ zusammenzusetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140404
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140404,
					"content": "Vertraue mir, das wird sehr interessant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				}
			]
		},
		{
