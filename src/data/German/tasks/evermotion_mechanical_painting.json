			"dialogs": [
				{
					"id": 705140301,
					"content": "Ehrenritter! Du bist zurück, wie geht es mit den Komponenten voran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140302
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140302,
					"content": "Sind das die richtigen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7051404,
