			"dialogs": [
				{
					"id": 750141320,
					"content": "Paimon war so besorgt, dass sie in Schweiß ausbrach! Zum Glück hatte Paimon sich versteckt, sonst hätte die Frau Paimon noch erwischt, anstatt auf euch zwei Saurier aufzupassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141321,
					"content": "Du bist ohne uns geflohen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141322
					]
				},
				{
					"id": 750141322,
					"content": "*brüll* ... *brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141323
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141323,
					"content": "Wäre es noch langsamer gegangen, wäre dies ein unmögliches Verbrechen geworden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141324
					]
				},
				{
					"id": 750141324,
					"content": "*brüll* ... *brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141325
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141325,
					"content": "Sicher, niemand kann einen Iktomisaurier, ähm ... dich beschuldigen, aber sag nicht so etwas Furchterregendes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141326,
					"content": "W... Wie auch immer, Paimon hat sich einfach spontan angepasst! Ihr hättet nicht entkommen können, wenn Paimon nicht draußen ein paar Geräusche gemacht hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141327,
					"content": "Die Kiste war zufällig mit Saurierkeksen gefüllt. Die Iktomisaurier stürzten sich auf sie, nachdem die Kiste umgekippt war. Das war ein richtiges Chaos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141328,
					"content": "Aber Paimon hat Lamizana draußen auch nicht gesehen. Paimon konnte die zwei Typen, die vorhin über das Geschäft verhandelten, nicht genau sehen, aber Paimon glaubt nicht, dass einer von ihnen Lamizana war, die Stimme klang nicht nach ihm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141329,
					"content": "Hmm ... Wie auch immer, lass uns Taruka erzählen, was wir vorhin gesehen und gehört haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
