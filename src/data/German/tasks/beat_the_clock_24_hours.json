			"dialogs": [
				{
					"id": 750141201,
					"content": "Hm? Hast du dich verlaufen, Kleiner?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141202
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141202,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141203,
					"content": "Du siehst sehr lebendig und gesund aus, und du hast ein besonderes Muster auf deinem Horn ... nicht schlecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141204
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141204,
					"content": "Warum seid ihr alle zusammen hierhergekommen? Stimmt etwas nicht mit meinen Lehrmethoden? Nein, das ist unmöglich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141205
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141205,
					"content": "*brüll*? ... *brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141206,
					"content": "Hm? Was ist denn mit dem los? Hat er dich hierhergebracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141207
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141207,
					"content": "(Ich darf nicht von ihr erwischt werden ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141208,
						750141209
					]
				},
				{
					"id": 750141208,
					"content": "*brüll* ... *brüll* ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141210
					]
				},
				{
					"id": 750141210,
					"content": "Warum machst du so komische Geräusche? Bist du krank? Du scheinst dich auch etwas seltsam zu verhalten. Vielleicht müssen wir dich mal untersuchen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141211
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141211,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141212,
					"content": "Sei geduldig, Kleiner. Bald bist du an der Reihe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141221
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141221,
					"content": "Du bist zuerst dran. Folge mir. Hast du das verstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141213,
						750141215,
						750141217
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141213,
					"content": "(Nicken.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141214
					]
				},
				{
					"id": 750141214,
					"content": "Wo hast du das gelernt? Und verstehst du etwa, was ich sage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141219
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141219,
					"content": "#In diesem Moment beginnt es draußen zu lärmen ...\\n„Wer hat die Kiste geöffnet ... He! Lasst los! Hört auf, euch um die Sachen zu streiten! Quilla wird wütend sein!“\\nEs bleibt keine Zeit, um herauszufinden, was passiert ist. Du nutzt das Chaos, um mit {REALNAME[ID(2)|SHOWHOST(true)]} aus dem Lager zu fliehen ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750141215,
					"content": "(Kopfschütteln.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141216
					]
				},
				{
					"id": 750141216,
					"content": "Wo hast du das gelernt? Und verstehst du etwa, was ich sage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141219
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141217,
					"content": "(Ihr folgen.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141218
					]
				},
				{
					"id": 750141218,
					"content": "Das ist seltsam, ich habe dir noch gar keine Befehle gegeben. Verstehst du vielleicht, was ich sage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141219
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141209,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141210
					]
				}
			]
		},
