			"dialogs": [
				{
					"id": 750141601,
					"content": "Das bedeutet Ärger ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141602,
						750141605
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750141602,
					"content": "Was ist los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141603
					]
				},
				{
					"id": 750141603,
					"content": "Nun, ich habe einen kleinen Bruder, der viel jünger ist als ich. Vielleicht liegt es daran, dass er in seinen rebellischen Jahren ist, aber er versteht sich mit niemandem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141604
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750141604,
					"content": "Ach, ich mache dir nur noch mehr Sorgen, wenn ich dir davon erzähle. Wenn er groß ist, wird es bestimmt besser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750141605,
					"content": "Entschuldige bitte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141606
					]
				},
				{
					"id": 750141606,
					"content": "Alles gut. Auf Wiedersehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lliwa"
				}
			]
		},
