			"dialogs": [
				{
					"id": 750141001,
					"content": "#Gott sei Dank geht es dir gut, {NICKNAME}. Ich war so besorgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141002
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141002,
					"content": "Ja, das war ziemlich spannend! Ähm ... Aber lass uns später darüber reden, denn die Dinge sind kompliziert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141003,
					"content": "Du erzählst Taruka, was du im Lager gesehen und gehört hast ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750141004
					]
				},
				{
					"id": 750141004,
					"content": "Ach, wirklich? Ihr habt Fräulein Quilla gesehen, aber nicht Lamizana ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141005
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141005,
					"content": "Sie haben über das Flugturnier und eine Transaktion gesprochen. Paimon kennt die Details nicht, aber es scheint etwas zu sein, das während des Turniers verwendet wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141006,
					"content": "Fräulein Quilla ist eine fahrende Händlerin, die vor kurzem hier aufgetaucht ist. Laut Paran handelt sie mit vielen verschiedenen Waren. Lamizana könnte von ihr gefährliche Waren erhalten haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141007
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141007,
					"content": "Aha, ich verstehe. Er will also seinen gefährlichen Plan während des Flugturniers ausführen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141008,
						750141009
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141008,
					"content": "Was für ein gefährlicher Plan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141010
					]
				},
				{
					"id": 750141010,
					"content": "Ich weiß es nicht ... Aber ich bin mir sicher, dass er etwas Gefährliches plant!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141011
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141011,
					"content": "#Ah, hier bist du also. Wunderbar! Du musst {NICKNAME} sein, richtig? Lamizana hat mir erzählt, dass du die Trainingsrennstrecke ausprobiert und dich ganz gut geschlagen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141012,
						750141013
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141012,
					"content": "Das war keine große Sache.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141015
					]
				},
				{
					"id": 750141015,
					"content": "Also es sieht so aus, dass das Flugturnier beginnt, aber der Teilnehmer, der gegen Lliwa antreten sollte, in letzter Minute abgesagt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141016
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141016,
					"content": "Tja ... Du kennst sie, Taruka, sie war schon immer sehr kämpferisch, also wird sie sich nicht mit einem einfachen Sieg zufriedengeben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141017
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141017,
					"content": "Dann kann sie sich auch zurückziehen. Das ist auch gut so. Ich werde sie dazu überreden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141018
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141018,
					"content": "Warte, das können wir nicht tun! Sie hat sich auch hart auf dieses Turnier vorbereitet, also ist es doch die beste Lösung, jemanden zu finden, der so gut wie sie ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141019
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141019,
					"content": "#Bist du deshalb zu {NICKNAME} gekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141020,
					"content": "Ja. Wenn du teilnimmst, werden wir dich auf jeden Fall entschädigen, unabhängig davon, ob du es auf die Rangliste schaffst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141021,
						750141023
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141021,
					"content": "Okay, jetzt unterschätzt du mich wirklich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141022
					]
				},
				{
					"id": 750141022,
					"content": "Hm? Oh, du hast recht ... Nun, wenn du am Ende auf der Rangliste stehst, bekommst du gleichzeitig die Ranglistenprämie und eine Bonusprämie obendrauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141025
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141025,
					"content": "Vielen Dank für deine Zusage! Das Einladungsschreiben bekommst du später. Ich muss noch einige Vorbereitungen treffen. Also werden wir uns wahrscheinlich erst am Tag des Flugturniers wiedersehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141026
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141026,
					"content": "Paran geht und nimmt Carrewuff mit ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750141027
					]
				},
				{
					"id": 750141027,
					"content": "#{NICKNAME}, du hast zugestimmt, weil wir so die Möglichkeit haben, das alles aus nächster Nähe zu untersuchen, oder? Sollte während des Flugturniers wirklich etwas passieren, werden die Teilnehmer es zuerst erfahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141028,
						750141029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141028,
					"content": "Ich glaube halt auch, dass es nicht so einfach ist, wie es scheint.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141031
					]
				},
				{
					"id": 750141031,
					"content": "Apropos, die Stimme von Paran kam Paimon irgendwie bekannt vor. Haben wir die vor kurzem irgendwo gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141032
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141032,
					"content": "Er ist für alles Mögliche hier in der Flugschule zuständig. Er und Carrewuff laufen oft hier herum. Es wäre schwieriger, seine Stimme nicht zu hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141033
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141033,
					"content": "Das ergibt Sinn! Wenn Paimon so darüber nachdenkt, scheint Paimon etwas Ähnliches in einer Geschichte gelesen zu haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141034
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141034,
					"content": "Wenn jemand, der mit seiner Umgebung quasi eins geworden ist, ein Verbrechen begeht, verdächtigen ihn die Leute in der Regel nicht, weil sie sich so an seine Anwesenheit gewöhnt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141035
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141035,
					"content": "Hmm ... Es ist wahrscheinlich das Beste, das nicht vor ihm zu sagen. Seine Familie wurde verbannt, weil eines ihrer Mitglieder etwas Schreckliches getan hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141036
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141036,
					"content": "Viele Leute haben das als Ausrede benutzt, um ihm das Leben schwer zu machen ... Vielleicht ist er deshalb so streng zu sich selbst, aber so rücksichtsvoll zu anderen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141037
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141037,
					"content": "Ich muss aber zugeben, dass er ein ganz netter Kerl ist, obwohl er Lamizana ziemlich nahesteht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141038,
						750141040
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141038,
					"content": "Ist Lamizana wie irgendein Ungeziefer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141039
					]
				},
				{
					"id": 750141039,
					"content": "Selbst Ungeziefer ist hundertmal niedlicher als er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141041
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141041,
					"content": "Danke, dass du das Paimon gesagt hast! Es wäre schlimm, wenn wir ihn verletzen würden, auch wenn es nur aus Versehen wäre. Wie dem auch sei, was das Flugturnier betrifft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141042
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141042,
					"content": "#Taruka, du musst dir keine Sorgen um deine Schwester machen. {NICKNAME} wird sich um sie kümmern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141043
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141043,
					"content": "Hmm ... Ich werde in der Nähe der Ziellinie auf euch warten. Lamizana und ich sollten zuerst fertig sein, ich werde also ein Auge auf ihn haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141044
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141044,
					"content": "*brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141045
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141045,
					"content": "#Deine Fähigkeiten sind für diese Situation nicht geeignet, {REALNAME[ID(2)|SHOWHOST(true)]}. Du solltest einfach gemeinsam mit Paimon zusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141046
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141046,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141040,
					"content": "Er scheint es aber auch nicht leicht zu haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141041
					]
				},
				{
					"id": 750141029,
					"content": "Nein, ich will nur den Teilnahmepreis einsacken ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141030
					]
				},
				{
					"id": 750141030,
					"content": "Auch wenn es dich nur etwas schicker aussehen lässt, solltest du schon dem zustimmen, was Paimon gesagt hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141023,
					"content": "Toll, ein garantierter Teilnahmepreis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141024
					]
				},
				{
					"id": 750141024,
					"content": "Du solltest wirklich ein bisschen mehr Ehrgeiz zeigen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141025
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141013,
					"content": "Was? Er hat mich wirklich so unterschätzt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141014
					]
				},
				{
					"id": 750141014,
					"content": "Nein, das ist es nicht! Moment, was würde Temach in dieser Situation sagen ... Ich hab’s! Die Trainingsrennstrecke ist schuld!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141015
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141009,
					"content": "Aber was ist sein Motiv?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141010
					]
				}
			]
