				]
			},
			"dialogs": [
				{
					"id": 751890401,
					"content": "Haha, endlich haben wir die Erlaubnis, um dieses Herz des heiligen Berges zu betreten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890402,
					"content": "„Nein. Wie ich schon sagte, das ist lediglich ein leeres Gehäuse für eine Erlaubnis ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890403
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890403,
					"content": "„Wenn man nur so ein Ding aus einer Schuppe hat, ohne dass darin irgendwelche Informationen über den Besitzer gespeichert sind, kann es keine Erlaubnis werden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890404
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890404,
					"content": "„Sonst würde dieses Ding ja zu einem Universalschlüssel werden, den jeder beliebige Drache benutzen könnte ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890405
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890405,
					"content": "Los, bring mir einen Drachen von Rang und Namen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890406
					]
				},
				{
					"id": 751890406,
					"content": "#Wo sollen wir denn so einen Drachen finden ... Hmm, {REALNAME[ID(2)|SHOWHOST(true)]} ist doch ein Saurier, reicht das nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890407,
					"content": "*brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890408
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890408,
					"content": "„Er ... hat diese Fähigkeit noch nicht.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890409
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890409,
					"content": "Was sollen wir jetzt tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890410,
					"content": "„Vor langer Zeit, nachdem der große Herrscher in das Herz des heiligen Berges eingetreten war, gab es auch andere Mächtige, die diese Erlaubnis zwar hatten, aber nie aktiviert haben.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890411
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890411,
					"content": "„Vielleicht wurde diese auffällig platzierte Erlaubnis genau für diesen Zweck zurückgelassen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				}
			]
		},
