			"dialogs": [
				{
					"id": 751890701,
					"content": "Bedrohung aus den Schatten erkannt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890702
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890702,
					"content": "Interne Sicherung ... Automatischer Reparaturmodus aktiviert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890703
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890703,
					"content": "Ah, Paimon hätte nie erwartet, dass wir in so einem Gebäude diese Art Vorrichtungen finden würden ... Diese Monster hatten nicht den Hauch einer Chance!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890704,
					"content": "„Dieses Gebäude wurde schließlich für die nächsten Millionen Jahre gebaut, um nicht nur Feinde abzuwehren, sondern auch sich selbst zu reparieren ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890705
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890705,
					"content": "Und so golden und glitzernd ... Paimon will es anfassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890706,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890707
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890707,
					"content": "„Haha, denk besser nicht mal dran ... Es wird dich weder als ‚Freund‘ noch als ‚Gegner‘ ansehen ... Es verbrennt einfach alles, was es berührt, ohne Gnade.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890708
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890708,
					"content": "„... Was für eine blöde und brutale Methode. Hmpf, wer kommt nur auf so eine Idee?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890709
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890709,
					"content": "Aber wir könnten damit auch diese Abdeckung über der Erlaubnis öffnen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890710,
						751890712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890710,
					"content": "Es ist einen Versuch wert ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890711
					]
				},
				{
					"id": 751890711,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890716,
					"content": "Dann ... finden wir eben einen Weg, dieses Ding nach oben zu bringen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890712,
					"content": "Ein wirklich ernsthafter Vorschlag ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890713
					]
				},
				{
					"id": 751890713,
					"content": "*brüll* ... *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890714
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890714,
					"content": "„Das stimmt allerdings. Wer hätte gedacht, dass unser weißer Bote so viele verborgene Fähigkeiten besitzt ... Diese Weisheit ist wirklich beeindruckend.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890715
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890715,
					"content": "... Keine Ahnung, warum ihr so überrascht seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "Paimon"
				}
			]
		}
