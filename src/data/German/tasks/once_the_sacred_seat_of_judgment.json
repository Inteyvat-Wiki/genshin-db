						],
						"pointId": 72
					}
				]
			},
			"dialogs": [
				{
					"id": 751890601,
					"content": "„Dort, das Licht, das die Steinschuppe aktiviert, das ist die Erlaubnis ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890602
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890602,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890603
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890603,
					"content": "Von hier aus kann man ... die ganze heilige Stadt sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890604,
					"content": "„Ja, es ist wirklich nur noch ein trauriger Schatten einstiger Pracht ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890605
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890605,
					"content": "*brüll* ... *brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890606
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890606,
					"content": "„Willst du wirklich wissen, wie das Urteil letztlich ausgegangen ist? Hehe ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890607
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890607,
					"content": "„Jene, die nach einem heiligen Urteil verlangten, waren sich sehr wohl bewusst, dass der Herr aller Flammen im Scheintod ruhte. Aber als der König in einem seiner lichten Momente tatsächlich erschien ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890608
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890608,
					"content": "„Die zuvor so geschwätzigen dreizehn Herrscher und drei Prinzen nahmen sofort ihre Worte zurück und die Farce dieser Verhandlung löste sich in Luft auf ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890609
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890609,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890610
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890610,
					"content": "„Später starben die drei Prinzen in Kämpfen gegen die Menschen, zehn Herrscher fanden beim Untergang der heiligen Stadt Tollan ihr Ende und einer blieb in Chichen Uctokah zurück ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890611
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890611,
					"content": "„Nur ein einziger Herrscher hat bis heute überlebt ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890612
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890612,
					"content": "„Doch das ist gewiss nicht die Art, in der er weiterleben wollte ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890613
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890613,
					"content": "„Nun gut. Lasst uns weitergehen in das Herz des heiligen Berges. Dort liegt alles begraben ... auch die Sehnsucht nach dem Ende der Reise.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890614
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890614,
					"content": "#„Meine Mission hier neigt sich dem Ende ... O du Auserwählte{M#r} der Drachen, wie wunderschön dieser Ort einst war ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890615
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890615,
					"content": "„Geh, berühre das flammengravierte Licht ... Gewinne die Erlaubnis, das Herz des heiligen Berges zu betreten ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890616
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890616,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890617
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890617,
					"content": "Awanyu ... Hmm, und schon wieder weg! Paimon hatte kaum Gelegenheit, diesen Namen öfter auszusprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890618,
					"content": "Aber immerhin haben wir jetzt die Erlaubnis, zum „Herzen des heiligen Berges“ zu gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890619,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890620
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890620,
					"content": "Das Licht hier ... ist verschwunden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
