			"dialogs": [
				{
					"id": 751890201,
					"content": "Es hört sich an, als würdest du diesen Ort nicht mögen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890202
					]
				},
				{
					"id": 751890202,
					"content": "„Wenn man dich wie einen Verbrecher behandelt hätte, würdest du diesen Ort sicher auch nicht mögen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Geheimquellen-Drachenknecht"
