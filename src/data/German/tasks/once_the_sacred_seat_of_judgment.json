				]
			},
			"dialogs": [
				{
					"id": 751890501,
					"content": "„Ich wusste doch, dass ihr hierherkommt, also bin ich vorab hergekommen, um euch gebührend zu empfangen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890502
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890502,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890503
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890503,
					"content": "„Auch wenn ich weiß, dass du nur aus Höflichkeit hier bist, freue ich mich wirklich, dich zu sehen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890504
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890504,
					"content": "„Ah, du bist es tatsächlich. Ähm, welchen Namen trägst du diesmal?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890505,
					"content": "„Der Name diesmal gehört einem Archivar der Aufsichtskammer. Seit die Geheimquellen-Drachenknechte erfunden wurden, hat er selbst kaum noch etwas geschrieben.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890506
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890506,
					"content": "„Awanyu ... So könnt ihr mich nennen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890507
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890507,
					"content": "„Na, Awanyu, bist du diesmal hier, um uns die Erlaubnis für den Zugang zum Herzen des heiligen Berges klarzumachen?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890508,
					"content": "„Andernfalls greift die vom Herzen des heiligen Berges eingerichtete Sternhäufung unbefugte Eindringlinge sofort an ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890509
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890509,
					"content": "„... Ich habe die Daten dieses ‚Awanyu‘ abgerufen. Die Erlaubnis für den Zugang zum Herzen des heiligen Berges wurde bei der Aufsichtskammer hinterlegt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890510
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890510,
					"content": "„Deshalb führte mich mein Weg hierher ... an einen Ort, wo Ignorante prahlen und Unfähige sich ihrer Unfähigkeit noch rühmen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890511
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890511,
					"content": "„Es ist auch der Ort, wo diese Leute über ihresgleichen urteilen und sich dabei noch wichtigmachen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				}
			]
		},
		{
			"id": 7518906,
			"completionStepIds": [
				7518905
