						],
						"pointId": 90
					}
				]
			},
			"dialogs": [
				{
					"id": 751890301,
					"content": "„Gehen wir, lasst uns sehen, wo sie die Erlaubnis versteckt haben ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890302
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890302,
					"content": "„Sieht aus, als hätten sie die einfach dort gelassen ... und sich nicht mal die Mühe gemacht, sie zu verstecken ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890303
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890303,
					"content": "„Es scheint aber bloß eine leere Hülle zu sein ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890304
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890304,
					"content": "Waah, woher kommen nur plötzlich all diese Garme ... Mist, und die Erlaubnis ist auch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890305,
					"content": "„Vermutlich konnten sie eindringen, weil der Schutz am Eingang nicht mehr da ist.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890306
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890306,
					"content": "W... Was sollen wir jetzt tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890307,
					"content": "„Kein Problem, wir aktivieren einfach die Reparatur- und Reinigungsgeräte der Aufsichtskammer.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890308
					],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				},
				{
					"id": 751890308,
					"content": "„Da drüben ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Geheimquellen-Drachenknecht"
				}
			]
		},
