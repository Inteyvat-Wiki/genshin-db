			"dialogs": [
				{
					"id": 741090101,
					"content": "Nachdem die Pummelrobbe euch gesehen hat, rennt sie nicht weg, sondern schwimmt fröhlich auf eure Seite. Sie brüllt leise und liebevoll, springt in deine Arme und streichelt deine Wange mit ihrem Kopf ...\\nSie ist ohne Zweifel die „riesige Weinbeere“, die von dir und Paimon sorgfältig großgezogen wurde ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741090102
					]
				},
				{
					"id": 741090102,
					"content": "Wuwu! Wuwu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741090103
					],
					"speakerTitle": "„Riesige Weinbeere“"
				},
				{
					"id": 741090103,
					"content": "Hehe, schon lange nicht mehr gesehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741090104,
					"content": "Paimon war ein bisschen besorgt, ob du im Meer überleben würdest, aber jetzt sieht es so aus, als gäbe es keinen Grund zur Sorge!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741090105,
						741090107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741090105,
					"content": "(Weise die „riesige Weinbeere“ an, einen Salto zu machen.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741090106
					]
				},
				{
