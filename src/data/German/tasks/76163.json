			"dialogs": [
				{
					"id": 761630101,
					"content": "... Sonett. In letzter Zeit drückst du dich immer öfter vor der Arbeit, nur um heimlich Zeit mit den Menschen zu verbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630102
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 761630102,
					"content": "Und was soll damit sein?! Wir können die Arbeit doch einfach den Mondgesandten überlassen, oder?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630103
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630103,
					"content": "Wenn der neue Meister, den ihr, Schwestern, so mögt, sogar Leute schickt, um uns Arbeit abzunehmen, dann bleibt mir wohl nichts anderes übrig, als das zu akzeptieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630104
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630104,
					"content": "Außerdem hattest du doch selbst jede Menge Spaß, Kanon! Du hast sogar an einem Fest der Menschen teilgenommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630105
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630105,
					"content": "... Das gehörte zu meinen Pflichten. Wenn ihr Hohepriester meinen Namen ruft, antworte ich natürlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630106
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 761630106,
					"content": "Hm? Gehört es also auch zu deinen Pflichten, dich als gewöhnliches Menschenmädchen auszugeben und vor deiner eigenen Statue zu tanzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630107
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 761630107,
					"content": "... Arya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630108
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 761630108,
					"content": "Kanon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630109
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 761630109,
					"content": "... Meinen Namen zu rufen bringt nichts ... Egal. Da die neue Mondgesandte auch nichts dagegen hat, Sonett bei der Arbeit zu helfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630110
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 761630110,
					"content": "Zibai. Ihr Name ist Zibai. Du solltest dir die Namen anderer wirklich merken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630111
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 761630111,
					"content": "... Da Zibai nichts dagegen hat, sage ich auch nichts weiter dazu. Aber Sonett, als Wille des Mondes darfst du die grundlegenden Formeln nicht vergessen, die den Lauf dieser Welt aufrechterhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630112
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 761630112,
					"content": "Bereite dich schon mal vor. Ich werde dir ein paar Grundlagenaufgaben zur Isomorphie von Morphismen geben. Und bevor du die nicht fertig gerechnet hast, gehst du nirgendwo mehr hin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630113
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 761630113,
					"content": "Hehe, ganz schön gemein. Fast wie ein Bösewicht aus den Romanen der Menschen unten, der die geflohene Prinzessin zurück auf den Mond holen will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630114
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 761630114,
					"content": "Genau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630115
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630115,
					"content": "... Du bist selbst der Mond, sag so etwas nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kanon"
				}
			]
		}
	]
}