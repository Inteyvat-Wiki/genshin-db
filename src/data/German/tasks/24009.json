			"dialogs": [
				{
					"id": 240090601,
					"content": "Ich schaue mal ... Meine Freunde haben mir einige Ratschläge gegeben, die ich in meinem Notizbuch festgehalten habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090602
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090602,
					"content": "Was habe ich da geschrieben? Ich schaue mal ... Ugh ... Unterwasser ... Raue Felsen ... Pflanzen auf den Felsen ... Die Konturen der Felsen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090603
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090603,
					"content": "Aha. Zu der Zeit habe ich fasziniert Forschung über Felsen betrieben. Ich bin der Meinung, dass Felsen am besten die Schönheit der Natur widerspiegeln können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090604
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090604,
					"content": "Ich bitte dich, ein paar Bilder von Felsen unter Wasser zu machen. Ich frage mich, welche Konturen die Unterwasserfelsen haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
