				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090901,
					"content": "Nun ... Das ist schlimm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090902,
						240090903
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090902,
					"content": "Was soll dieses Mal fotografiert werden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				},
				{
					"id": 240090904,
					"content": "Dieses Mal ... werde ich dir nicht die Schererei machen, Fotos zu schießen. Ich möchte dich um einen anderen Gefallen bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090905
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090905,
					"content": "Ähem, es ist mir peinlich, dies zu sagen. Kannst du für mich ... etwas zum Essen besorgen? Ein Knoblauchbaguette, zum Beispiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090906,
						240090907
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090906,
					"content": "Hast du ... nichts zum Essen dabei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090908,
					"content": "Nein! Ich habe eine Menge Brot, Konfitüre und Trockenfleisch mitgebracht. Es sollte eigentlich heute für mich zum Essen reichen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090909
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090909,
					"content": "Als ich mit dem Malen beschäftigt war, habe ich das Essen an die Seite gelegt ... Und als mir dann bewusst wurde, dass ich Hunger hatte, war das Essen bereits verschwunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090910
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090910,
					"content": "Ich weiß nicht, ob das Essen von einem Tier fortgeschleppt oder von einem Passanten mit knurrendem Magen mitgenommen wurde ... Oh, hoffentlich konnte das Essen ihren Hunger stillen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090911
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090911,
					"content": "Aber ich selbst habe einen Kohldampf. Ich muss einen anderen Weg finden, satt zu werden ... Aber ich kann jetzt nicht in die Stadt zurück. Ich habe noch nicht genug Material gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090912,
						240090913
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090912,
					"content": "Warte mal kurz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090914,
					"content": "Dann zähle ich auf dich. Du kannst das Knoblauchbaguette beim Händler in der Stadt kaufen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090915
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090915,
					"content": "Haha ... Ich fühle mich jetzt etwas kraftlos. Ich weiß nicht, ob es daran liegt, dass mein Magen knurrt, oder daran, dass ich zu viel nachgedacht habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090913,
					"content": "Gern, ich bringe dir etwas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090907,
					"content": "Hast du ... kein Geld, um etwas zum Essen zu kaufen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090903,
					"content": "Wo soll ich dieses Mal Fotos machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				}
			]
		},
		{
			"id": 2400910,
			"completionStepIds": [
				2400914
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
