				"points": []
			},
			"dialogs": [
				{
					"id": 240091001,
					"content": "Vielen Dank. Das sollte reichen, um mich satt zu machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091002
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091002,
					"content": "Das ist deine Bezahlung. Nimm sie. Ich muss schnellstmöglich ein paar Happen essen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091003
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091003,
					"content": "Das nächste Mal ... sollte ich ein paar Kekse mitnehmen, die man in die Tasche stecken kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
