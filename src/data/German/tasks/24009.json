			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240091101,
					"content": "Es fehlt aber trotzdem etwas Spannung ... Warum ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091102,
					"content": "Ich habe ständig das Gefühl, dass etwas Entscheidendes fehlt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091103,
						240091105
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091103,
					"content": "Machst du Fotos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091104
					]
				},
				{
					"id": 240091104,
					"content": "Ja, um ein Bild zu malen, schieße ich gerade mit dem Fotoapparat Fotos, um Material zu bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091107,
					"content": "Ich bin Depierris, ein Maler. Es freut mich dich kennenzulernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091108,
					"content": "Oh ... Oh, hallo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091109
					]
				},
				{
					"id": 240091109,
					"content": "#Normalerweise sollte ich dich als {F#neue Freundin}{M#neuen Freund} auf einen Kaffee einladen. Aber es gibt in der Umgebung kein Café.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091110
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091110,
					"content": "Bitte nimm dieses Glas Fonta und lass uns anstoßen. Nun können wir es als offizielles Kennenlernen betrachten! Apropos, bist du schon einmal in Fontaine gewesen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091111
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091111,
					"content": "Das ist mein erstes Mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091112
					]
				},
				{
					"id": 240091112,
					"content": "Dann wirst du viel Spaß haben. Du kannst zuerst in die Stadt gehen, es gibt viel zu sehen, zum Beispiel die Wasserstraßen, die über deinem Kopf kreuzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091113
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091113,
					"content": "Dann kannst du dir die komplizierten Maschinen auf den Straßen der Stadt ansehen. Doch aus meiner Sicht als Maler ... haben nicht alle Maschinen einen ästhetischen Wert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091114,
					"content": "Am Ende musst du ins Café und eine Tasse Kaffee trinken. Setze dich hin und genieße in aller Ruhe den Geschmack.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091115,
					"content": "Während du Kaffee trinkst, ist es gut möglich, dass jemand raufkommt und mit dir plaudert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091116,
					"content": "Aber wenn die Person, die auf dich zukommt, dir sagt, dass sie von einem „Fotoclub“ ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091117,
					"content": "Dann solltest du vorsichtig sein. Sie werden dir sicher einigen Blödsinn erzählen ... Einige unter ihnen machen gerade ziemlich dumme Sachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091118,
						240091120
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091118,
					"content": "Was machen sie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091119
					]
				},
				{
					"id": 240091119,
					"content": "Was machen sie? Ein Teil von ihnen ist gerade dabei, das zivilisierte Leben in Fontaine zu zerstören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091122,
					"content": "Denk aber nicht, dass ich dir Angst einjagen will. Rate mal, was in diesem Verein gesagt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091123
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091123,
					"content": "„Wenn es nur um die Bildqualität geht, sind die Bilder von Fotoapparaten im Vergleich zu den Bildern eines Malers deutlich besser.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091124
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091124,
					"content": "Na, dieser Satz „Wenn es nur um die Bildqualität geht“, auch wenn er noch so bescheuert ist, wird er von diesen Leuten als die Wahrheit betrachtet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091125
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091125,
					"content": "Wenn ein Maler völlig ohne Unterschiede zum Original ein Bild darstellen will, welche Rolle spielt dann noch der Sinn für Ästhetik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091126
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091126,
					"content": "Nun, ein paar meiner Kollegen machen sich auch gerade Gedanken darüber, wie man die Realität noch genauer darstellen kann ... Aber das basiert auf ihrem Sinn für Ästhetik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091127
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091127,
					"content": "Sinn für Ästhetik! Der wesentliche Punkt liegt auf dem Sinn für Ästhetik. Verstehst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091128,
						240091129
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091128,
					"content": "I... Ich verstehe es nicht so ganz ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091130,
					"content": "Dass der Maler seine Augen nutzt, um die Welt zu erblicken, ist nur der erste Schritt. Wir müssen mit dem Pinsel Spiritualität und Schönheit finden. Erst dann kann aus unserem Herzen ein schönes Bild entstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091131
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091131,
					"content": "Ich möchte nicht alle Liebhaber von Fotoapparaten als Rüpel abstempeln, die keinen Sinn für Ästhetik haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091132
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091132,
					"content": "Ich habe auch einige Hobbyfotografen als Freunde. Wir unterhalten uns oft. Manchmal geben mir ihre Bilder Inspiration und manchmal werden sie von meinen Bildern inspiriert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091133
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091133,
					"content": "Es gibt aber auch einige ignorante Leute, die eine Menge Blödsinn daherreden. Diese Leute sind echt nicht zum Aushalten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091134
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091134,
					"content": "Diese Leute sind eine Beleidigung für die Hobbyfotografen und für die Liebhaber von Malerei! Sie sind wirklich ... *hust* ... *hust* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091135
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091135,
					"content": "Trink etwas Wasser ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091136
					]
				},
				{
					"id": 240091136,
					"content": "Danke ... Jedes Mal, wenn ich diese Sache anspreche, werde ich unfreiwillig wütend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091137
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091137,
					"content": "Daher haben einige Freunde und ich vor, mit diesem Fotoapparat eine Reihe von Fotos zu machen und mit diesen Fotos als Referenzmaterial eine Reihe von Bildern zu malen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091138
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091138,
					"content": "Dann sollen die Bilder und die Fotos, die als Referenzmaterial dienen, in einer Bildausstellung zusammengestellt werden, um den Leuten zu zeigen, wo die Unterschiede zwischen den Gemälden und den Fotos liegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091139
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091139,
					"content": "Aber ... *seufz* ... Die von mir gemachten Fotos sind völlig uninteressant ... Meine Freunde sagen, dass gute Landschaften häufig in gefährlichen Gegenden zu finden sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091140
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091140,
					"content": "Zum Beispiel unter Wasser oder auf Klippen oder vielleicht im tiefen Wald, wo nur wenige Menschen hingehen ... Aber ich traue mich nicht, allein an solche Orte zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091141
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091141,
					"content": "Wenn ich Abenteurer um Hilfe bitten würde, würde das auch zu lange dauern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091142
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091142,
					"content": "#Äh ... {M#Lieber Herr}{F#Liebe Frau}, du hast doch sicher nichts dagegen ... für einen Künstler zu arbeiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091143,
						240091144
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091143,
					"content": "Solange ich nicht malen muss ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091145,
					"content": "Keine Sorge. Jeder von uns muss nur das tun, worin er gut ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091146
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091146,
					"content": "Du musst dir auch keine Sorge um die Bezahlung machen. Ich beauftrage häufig Abenteurer, um mich beim Sammeln von Materialien zu beschützen. Ich verstehe ihre Regeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091147
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091147,
					"content": "Dieses Mal bin ich aber sehr in Eile. Auf die Schnelle finde ich keinen Abenteurer, der mich begleitet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091148
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091148,
					"content": "Dann ist die Sache also abgemacht. Mit deiner Hilfe bin ich sicher, ein gutes Bild malen zu können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091144,
					"content": "Ich verstehe mich nur auf Dinge, die Abenteurer beherrschen müssen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091129,
					"content": "I... Ich verstehe es nur zum Teil ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091120,
					"content": "Was werden sie mir antun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091121
					]
				},
				{
					"id": 240091121,
					"content": "Genau das, was ein Teil von ihnen Fontaine antut. Das zivilisierte Leben, welches du genießen solltest, zu zerstören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091105,
					"content": "Ist Fotografieren dein Hobby?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091106
					]
				},
				{
					"id": 240091106,
					"content": "Hobby? Natürlich nicht. Aus meiner Sicht ist das Fotografieren nur ein Mittel zur Beschaffung von Referenzmaterial. Für mich ist der Pinsel deutlich wichtiger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "Depierris"
				}
			]
		},
