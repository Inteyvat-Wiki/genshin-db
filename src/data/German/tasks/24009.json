			},
			"dialogs": [
				{
					"id": 240090401,
					"content": "Ich schaue mal ... Meine Freunde haben mir einige Ratschläge gegeben, die ich in meinem Notizbuch festgehalten habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090402
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090402,
					"content": "„Gewaltige Unterwasserruinen“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090403
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090403,
					"content": "Warum habe ich mit so viel Kraft geschrieben ... Es wurde sogar das Papier durchstoßen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090404
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090404,
					"content": "Aber gewaltige Unterwasserruinen ... klingen schon nach etwas, was einen speziellen Stil von Ästhetik in sich trägt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090405
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090405,
					"content": "Bitte mache für mich ein Foto von den Unterwasserruinen. Je größer, desto besser, je zerfetzter, desto besser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
