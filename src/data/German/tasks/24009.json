			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090201,
					"content": "Ich schaue mal ... Meine Freunde haben mir einige Ratschläge gegeben, die ich in meinem Notizbuch festgehalten habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090202
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090202,
					"content": "Meeresgrundpflanzen ... Schwanken ... Licht und Schatten ... Änderungen ... Was habe ich damals eigentlich geschrieben. War ich etwa betrunken? *räusper* ... Ah, richtig. Daran liegt es wohl ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090203
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090203,
					"content": "Nun, hilf mir mal, Fotos von den Meerespflanzen auf dem Meeresgrund zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090204
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090204,
					"content": "Es ist wohl so ... dass ich, der diese Notizen geschrieben hat, sehr an den Veränderungen bei Licht und Schatten von Meerespflanzen interessiert bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
			"id": 2400904,
