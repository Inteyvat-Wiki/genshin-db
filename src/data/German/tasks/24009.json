			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090101,
					"content": "#{F#Reisende}{M#Reisender}! Du kommst genau richtig. Ich habe einen idealen Ort zum Schießen von Fotos entdeckt. Ich brauche nur noch deine Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090102,
					"content": "Immer noch auf der Suche nach Material?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090103
					]
				},
				{
					"id": 240090103,
					"content": "Natürlich, das Material hier reicht bei weitem nicht aus. Ein Bild reicht nicht aus für ein ganzes Gemälde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090104
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090104,
					"content": "Wenn ich mich normalerweise entscheide, Bilder als Referenzmaterial zu verwenden, liegt die Menge der benötigten Bilder zwischen ein paar Dutzend und über hundert Stück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090105,
						240090106
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090105,
					"content": "So viel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				},
				{
					"id": 240090107,
					"content": "Wie ich dir schon mal gesagt habe, liegt der Schwerpunkt beim Malen in der „Schöpfung“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090108,
					"content": "Wenn man einfach nur alle Dinge, die man sieht, eins zu eins auf der Leinwand darstellt ... kann man das nicht als „Malen“ bezeichnen, sondern als „Fotografie“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090109
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090109,
					"content": "Was ein Künstler tun muss, ist, alle Objekte mit seiner eigenen Ästhetik und Spiritualität zu erfassen und diese Objekte dann filtern, transformieren und zurechtstutzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090110
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090110,
					"content": "Nur indem man den „schönsten“ Teil einer Sache abstrahiert und auf Leinwand festhält, kann ein Gemälde entstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090111,
						240090112
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090111,
					"content": "Ich verstehe das nicht!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090113,
					"content": "Du ... Nun gut. Um es einfach auszudrücken: Ich verwende von diesen Bildern nur den schönsten Aspekt als Referenz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090114,
					"content": "Beispielsweise ist dieses Bild bezüglich Licht und Schatten sehr gut, aber die Landschaft ist nicht besonders gut. Daher werde ich nur das Licht und den Schatten als Referenz verwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090115,
					"content": "Bei einem anderen Bild sind vielleicht die Bewegungen eines Fußgängers äußerst interessant. Und beim nächsten Bild sind vielleicht die Gebäude beeindruckend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090116,
					"content": "Es ist, als würde man in Gedanken ein Puzzle zusammensetzen. Ob das zusammengesetzte Puzzle schön oder hässlich ist, hängt allein von der eigenen Ästhetik und dem eigenen Wissen ab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090117,
					"content": "Das ist absolut keine präzise Art, es auszudrücken. Da wir an der Landschaft des Materials noch Verformungen, Abstrahierungen und Ähnliches durchführen ... Aber es reicht aus, wenn du es auf diese Weise verstehst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090118,
						240090119
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090118,
					"content": "Deshalb benötigst du immer noch meine Hilfe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090120,
					"content": "Äh ... Genau! Deine Technik beim Machen von Fotos ist wirklich auf einem sehr hohen Niveau. Nachdem meine Freunde die von dir gemachten Fotos gesehen haben, wollen sie dich persönlich kennenlernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090121
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090121,
					"content": "Mit deiner Hilfe werde ich auf jeden Fall ein herausragendes Gemälde hinbekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090122,
					"content": "Also, für die menschliche Ästhetik und die Mora, die ich vorbereitet habe, bitte hilf mir weiter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090119,
					"content": "Deshalb muss ich dir weiter helfen, mehr Material zu finden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090112,
					"content": "Kannst du das einfacher ausdrücken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090106,
					"content": "Haben diese Bilder unterschiedlichen Nutzen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				}
			]
		},
		{
			"id": 2400902,
			"completionStepIds": [
				2400902
			],
