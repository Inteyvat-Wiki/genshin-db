			"dialogs": [
				{
					"id": 710460101,
					"content": "Bitte bleibt stehen! Niemandem ist es erlaubt, die Große Kluft zu betreten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Millelithensoldat"
				}
			]
		},
		{
			"id": 7104602,
			"completionStepIds": [
				7104602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7104602",
							"2"
						],
						"stepId": 7104602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tie Hong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710460201,
					"content": "Bitte bleibt stehen! Niemandem ist es erlaubt, die Große Kluft ... Ah, du bist es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460202
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460202,
					"content": "Oh nein, schnell weg hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460203,
						710460204,
						710460205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460203,
					"content": "Ganz ruhig, Paimon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460206,
					"content": "Hahahahaha ... Tut mir leid, dass ich euch Angst gemacht habe. Wie könnte ich mich nicht an einen Lebensretter erinnern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460207
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460207,
					"content": "Ich wurde erst vor Kurzem hierher versetzt ... Ich hätte nicht erwartet, hier zufällig meinen Retter zu treffen ... Was für ein Glücksfall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460208
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460208,
					"content": "Retter? Haben wir etwas Gutes getan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460209,
					"content": "Was soll denn diese Frage? Ich war auch im Jadegemach, als wir gegen das Ungeheuer aus dem Meer gekämpft haben. Ich war ein bisschen verletzt, aber es geht mir erst seit Kurzem besser ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460210
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460210,
					"content": "Du erinnerst dich vielleicht nicht mehr an mich, aber ich kann dich nicht vergessen. Meine Kameraden, die Seite an Seite gekämpft haben, sind Zeugen deiner Hingabe zu Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460211
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460211,
					"content": "Über die Große Kluft ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460212
					]
				},
				{
					"id": 710460212,
					"content": "Die Mine wurde vor zwei Jahren auf Anordnung der Qixing nach einem ungeklärten Unfall in der Grube stillgelegt. Auch die Bergleute konnten größtenteils unverletzt abgezogen werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460213
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460213,
					"content": "Es ist schade, dass ein so großes Bergwerk seine Produktion einfach eingestellt hat. Die Arbeiter erhielten ihre Subventionen und gingen ihrer Wege ... Leider ist es schwierig, Menschen, die einmal verstreut sind, wieder zusammenzuführen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460214
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460214,
					"content": "Tut mir leid, wenn ich abschweife. Ich bin sicher, dass du wegen einer wichtigen Angelegenheit hier bist, also werde ich dich nicht vorher aufhalten. Bitte wendet euch direkt an Muning, wenn ihr etwas braucht, er befindet sich im Lager am Eingang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460215
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460215,
					"content": "Äh ... Ich bin nicht misstrauisch, aber es ist meine Pflicht. Ich möchte dich einfach warnen: Tu hier nichts Illegales!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460216
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460216,
					"content": "Keine Sorge, kannst du uns trotzdem nicht trauen!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460204,
					"content": "Kennst du mich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460205,
					"content": "Wir sind aufgeflogen! Schnell weg!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				}
			]
		}
	]
}