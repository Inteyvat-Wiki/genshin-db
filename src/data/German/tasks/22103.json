				"points": []
			},
			"dialogs": [
				{
					"id": 221030101,
					"content": "So ein Ärger ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030102
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030103
					]
				},
				{
					"id": 221030103,
					"content": "Oh, ein Gast? Es tut mir leid, in der Nähe des Gasthauses passieren zurzeit seltsame Dinge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030104
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030104,
					"content": "Einige Gäste wurden in der Nähe von Monstern angegriffen. Mittlerweile wollen ein paar von ihnen schon keinen Handel mehr treiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030105
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030105,
					"content": "Wenn das so weitergeht, steht mir noch großer Ärger bevor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030106
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030106,
					"content": "#Hm, du siehst aus wie {F#eine Reisende}{M#ein Reisender}. Hast du Lust, dich mal in der Gegend nach Monstern umzuschauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030107,
						221030108
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030107,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030109
					]
				},
				{
					"id": 221030109,
					"content": "Danke für deine Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030113
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030113,
					"content": "Jedenfalls wäre es schön, wenn du helfen könntest. Ich werde auch eine Belohnung vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030108,
					"content": "Sind die Monster gefährlich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030110
					]
				},
				{
					"id": 221030110,
					"content": "Gefährlich? Ach, die sind recht harmlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030111
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030111,
					"content": "Ich habe nur Angst, dass die Monster Pech haben und auf diesen Typen treffen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030112
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030112,
					"content": "Wenn er sich um die Monster kümmert, achtet er nicht auf Unbeteiligte in der Nähe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030113
					],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
