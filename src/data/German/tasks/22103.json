			"dialogs": [
				{
					"id": 221030201,
					"content": "Bist du schon fertig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030202
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030202,
					"content": "Noch nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030203
					]
				},
				{
					"id": 221030203,
					"content": "Bitte warte nicht zu lange. Dieser Typ könnte jederzeit und an jedem Ort auftauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030204
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030204,
					"content": "Sobald er eingreift, kann das Gasthaus erst einmal dicht machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
