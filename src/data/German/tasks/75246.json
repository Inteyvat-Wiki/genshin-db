			},
			"dialogs": [
				{
					"id": 752460384,
					"content": "#Als Älteste{M#r} hast du den Vortritt, {M#Opa}{F#andere Oma}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460385
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460385,
					"content": "Mit Vergnügen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460301
					]
				},
				{
					"id": 752460301,
					"content": "#Waah, der Wettbewerb wird ja immer hitziger! Hier kommt ein Profi-Move von {NICKNAME} ... und da beißt einer an! {NICKNAME} holt ihn ein, und es ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460302,
					"content": "Warte ... das ist ... ein Asha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460303,
					"content": "Oha ... Nicht ganz die Art von Fang, die ich erwartet hatte! Ich bin mir nicht ganz sicher, wie wir das beurteilen sollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460304
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460304,
					"content": "#Nicht schlecht, {M#Opa}{F#andere Oma}! Wir werden sehen, ob es jemandem gelingt, etwas noch Außergewöhnlicheres zu fangen. Ansonsten könnte das schon für den Sieg reichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460305
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460305,
					"content": "Vielen Dank an euch alle! Ich habe harte Konkurrenz, aber ich denke, ich habe eine Chance. Hoffen wir, dass mein Enkel recht behält!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460306
					]
				},
				{
					"id": 752460306,
					"content": "#Eine echt beeindruckende Leistung von {NICKNAME}! Das wird eine harte Nuss für die verbleibenden zwei Teilnehmer, die noch folgen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460307,
					"content": "Ifa, du bist dran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460308,
					"content": "Du schaffst das, Brudi! Teamarbeit macht den Traum wahr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460309
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460309,
					"content": "Tut mir leid, Cacucu. Hier ist kein Platz für Teamarbeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460310
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460310,
					"content": "Aufgepasst, Brüder ... Ich habe da was!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460311,
						752460313
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460311,
					"content": "Ifa zieht mit aller Kraft die Rute ein. Sieht aus, als hätte er etwas Großes am Haken ...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752460312
					]
				},
				{
					"id": 752460312,
					"content": "Aber ... da ist was anderes Unerwartetes am Haken.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752460313,
					"content": "Hm ... Sieht so aus, als hätte Ifa einen Koholasaurier gefangen ... mit einem Wasserschwein im Schlepptau? Keine Ahnung, was da los ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460314,
					"content": "Beeindruckend! Ifa hatte schon immer ein Händchen für Tiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460315
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460315,
					"content": "Moment, da stimmt was nicht mit dem Schwanz dieses Koholasauriers ... Ich glaube, er hat sich an einem Stein geschnitten, und ich vermute, das Wasserschwein wollte ihm helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460316
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460316,
					"content": "Oder das Wasserschwein hat versucht, seinen Schwanz zu fressen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460317
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460317,
					"content": "Niemals, Bruder! Cacucu, kannst du mal fragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460318
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460318,
					"content": "Na klar ... schon dabei, Brudi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460319
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460319,
					"content": "Siehst du? Ich wusste, dass ich recht hatte ... Nein, warte. Das ist nicht das, was jetzt wichtig ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460320,
						752460322
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460320,
					"content": "Ifa inspiziert schnell den Schwanz des Koholasauriers. Zum Glück ist es nur ein Kratzer.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752460321
					]
				},
				{
					"id": 752460321,
					"content": "Nach einer einfachen Diagnose ziehen der Koholasaurier und sein Wasserschwein-Begleiter ihrer Wege.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752460322,
					"content": "Oh, eine neue Freundschaft. Heute scheint auch ihr Glückstag zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460323
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460323,
					"content": "„Auch“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460324
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460324,
					"content": "Genau. Ich bin an der Reihe, und ich habe das Gefühl, dass ich gewinnen werde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460325
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460325,
					"content": "Teamarbeit macht den Traum wahr, Brudi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460326
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460326,
					"content": "Ich schätze mal, das ist wohl deine Art, uns die Daumen zu drücken, Kleiner? Wo hast du das überhaupt gelernt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460327
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460327,
					"content": "Cacucu, Angel-Cheerleader der Extraklasse!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460328
					]
				},
				{
					"id": 752460328,
					"content": "„Angel-Cheerleader“ klingt doch ziemlich langweilig. Wir kämpfen um was Wichtiges. Es muss ein bisschen mehr Eindruck machen ... Hm!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460329
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460329,
					"content": "Was ist das? Schnell, aus dem Weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460330
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460330,
					"content": "Nun, dies hier sieht ein wenig ungewöhnlich aus ... Aber es ist ein anderes Wasserschwein! Und es hat uns angegriffen! Meintest du nicht, dass sie sanfte Geschöpfe sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460331,
					"content": "Es muss wohl auch für etwas Wichtiges kämpfen. Hm, ich kann es spüren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460332
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460332,
					"content": "... Oder auch nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460333
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460333,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460334
					],
					"speakerTitle": "Wasserschwein"
				},
				{
					"id": 752460334,
					"content": "Ich denke, das sind nur wir. Aber es ist verärgert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460335
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460335,
					"content": "Oh, na du, kleines Kerlchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460336
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460336,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460337
					],
					"speakerTitle": "Wasserschwein"
				},
				{
					"id": 752460337,
					"content": "Haha! Großartig, Brudi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460338
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460338,
					"content": "W... Was? Versucht Cacucu, es zu beruhigen oder so was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460339,
					"content": "Trösten trifft es wohl eher. Er sieht vielleicht nicht danach aus, aber Cacucu kann erstaunlich gut mit Kranken umgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460340
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460340,
					"content": "Hm. Selbst mit seinem, ähm ... begrenzten Wortschatz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460341,
					"content": "Ich schätze mal, dass das menschliche Vokabular keine allzu große Rolle spielt, wenn man mit einem Wasserschwein spricht, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460342
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460342,
					"content": "Oh ... stimmt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460343,
					"content": "Wir müssen dem kleinen Burschen einfach vertrauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460344
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460344,
					"content": "Außerdem denke ich, dass der Tonfall bei einer Kommunikation mehr Gewicht hat als die eigentlichen Worte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460345
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460345,
					"content": "Zum Beispiel: „Hallo“. Das bedeutet „Ich bin glücklich“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460346
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460346,
					"content": "„Hallo“ allerdings ... Das heißt so viel wie „Ich bin frustriert“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460347
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460347,
					"content": "Und „Hallo!“ ... Das bedeutet Wut, ein Zeichen, wegzulaufen und sich zu verstecken, weil Gefahr im Verzug ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460348
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460348,
					"content": "Alles klar, Paimon hat zwar voll den Faden verloren, aber Paimon wird dich beim Wort nehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460349,
					"content": "Man lernt auch jeden Tag etwas dazu, nicht wahr? Danke!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460350
					]
				},
				{
					"id": 752460350,
					"content": "Oh, mit Vergnügen! Das ist die Methode, die ich mir ausgedacht habe, um mit den Läusen zu kommunizieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460351
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460351,
					"content": "„Laus-Mitarbeiter“, erinnerst du dich noch, Bruder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460352
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460352,
					"content": "Nein, nicht nur die Mitarbeiter. Es gibt Läuse, die nicht mitmachen wollten, weißt du. Ich verstehe natürlich ihre Gefühle, und ich respektiere ihre Entscheidung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460353
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460353,
					"content": "... Dann könntest du mir vielleicht etwas von diesem Verständnis entgegenbringen, Bruder. Ich bin hier mit den Nerven am Ende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460354
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460354,
					"content": "Hm, wirklich? Ich dachte, du wärst stolz. Sieh mal da drüben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460355
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460355,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460356
					],
					"speakerTitle": "Wasserschwein"
				},
				{
					"id": 752460356,
					"content": "Haha! Echt jetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460357
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460357,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460358
					],
					"speakerTitle": "Wasserschwein"
				},
				{
					"id": 752460358,
					"content": "Waah! Echt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460359
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460359,
					"content": "Na hallo, sieht so aus, als würden sie sich wirklich gut verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460360
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460360,
					"content": "Tja, nun, ich bin schon ein bisschen stolz, aber ... Hm? Ororon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460361
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460361,
					"content": "Keine Sorgen. Ich habe das im Griff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460362
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460362,
					"content": "Hallo, König Wasserschwein. Möchtest du etwas zu essen? Ich habe hier eine frische Ladung von Ifas Keksen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460363
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460363,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460364
					],
					"speakerTitle": "Wasserschwein"
				},
				{
					"id": 752460364,
					"content": "König Wasserschwein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460365
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460365,
					"content": "Sieht aus, als hätte ihn das ziemlich aufgemuntert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460366
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460366,
					"content": "Oje! Oje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460367
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460367,
					"content": "Moment mal ... Wann ist unser Angelwettbewerb zu einem Streichelzoo geworden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460368,
						752460369
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460368,
					"content": "Was ist so falsch daran?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460370
					]
				},
				{
					"id": 752460370,
					"content": "Hm, stimmt ... Nun, ich schätze, damit wäre Ororon wohl der Gewinner?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460371,
					"content": "Wenn man bedenkt, dass er es geschafft hat, diesen, ähm ... König Wasserschwein oder was auch immer, zu fangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460372
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460372,
					"content": "Ein passender Name, würde ich sagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460373
					]
				},
				{
					"id": 752460373,
					"content": "Klar, Ororon gewinnt. Von uns hat niemand einen richtigen Fisch gefangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460374
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460374,
					"content": "Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460375
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460375,
					"content": "Schön, dann bekomme ich den Aphimead! Obwohl, es war ja schon von Anfang an meiner ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460376
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460376,
					"content": "Nun, du darfst ihn behalten! Das ist doch was, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460377
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460377,
					"content": "Stimmt, und König Wasserschwein hat uns auch noch eine Kleinigkeit dagelassen. Sieh mal, ich glaube, es ist ein Geschenk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460378
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460378,
					"content": "Ein „buntes Geschenk-Ei“ und ein Bild? Hm, der Ort auf diesem Bild kommt mir irgendwie bekannt vor ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460379
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460379,
					"content": "Ob das etwa bedeuten soll, dass König Wasserschwein möchte, dass wir dorthin gehen? Sieht irgendwie danach aus, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460380
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460380,
					"content": "Es kann nicht schaden, mal nachzuschauen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460381
					]
				},
				{
					"id": 752460381,
					"content": "Ja, könnte sicherlich einen Blick wert sein, wenn du etwas Zeit hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460382
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460382,
					"content": "Vielleicht wartet da ja etwas Tolles auf uns.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460383
					]
				},
				{
					"id": 752460383,
					"content": "Ja, wer weiß ... Aber wir sollten uns vorbereiten, nur für den Fall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460369,
					"content": "Macht doch Spaß, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460370
					]
				}
			]
		}
	]
}