			},
			"dialogs": [
				{
					"id": 752460101,
					"content": "#{NICKNAME}, schau mal, dort drüben ist jemand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460102,
					"content": "Hm, die kommen mir irgendwie bekannt vor. Sind das etwa ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460103
					]
				},
				{
					"id": 752460103,
					"content": "Ororon und Ifa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460104,
					"content": "#Ich wusste doch, dass ich diese Stimmen kenne. {M#Opa}{F#Meine andere Oma} und Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460105
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460105,
					"content": "Brudis! Brudis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460106
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460106,
					"content": "Ihr seid auch hier im Resort! Mann, ist schon ’ne ganze Weile her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460107
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460107,
					"content": "Oh ja! Chasca hat uns erzählt, dass du hier arbeitest. War wohl nur eine Frage der Zeit, dass wir uns irgendwann mal über den Weg laufen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460108,
					"content": "Aber hallo. Dieser Ort hat eine so angenehme Atmosphäre, findet ihr nicht auch? Wie ich höre, haben alle hier einen Mordsspaß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460109
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460109,
					"content": "Hehe, auf jeden Fall! Mit ein wenig Glück könnte es noch besser werden und wir könnten noch mehr Besucher anlocken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460110,
					"content": "Und wie steht’s bei euch? Bei der Arbeit alles gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460111,
					"content": "Alles super! Die Saurier-Mitarbeiter und Läuse sind gesund und munter, sodass wir etwas Zeit zur Verfügung hatten. Da haben wir uns gedacht, wir könnten uns ja mal umsehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460112
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460112,
					"content": "... Laus-Mitarbeiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460113
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460113,
					"content": "Was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460114
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460114,
					"content": "Die Läuse sind ebenfalls Teil des Personals. Das hast du vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460115
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460115,
					"content": "Das kannst du laut sagen, Brudi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460116
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460116,
					"content": "*seufz* ... Entschuldigung. Jedenfalls bin ich all unseren Mitarbeitern dankbar und natürlich auch Ororon, der ... so toll auf sie aufpasst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460117
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460117,
					"content": "Früh hier zu sein, um für eine wichtige Sache zu kämpfen. Das ist schon eine Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460118
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460118,
					"content": "Das ist das erste Mal für ihn, dass er so eine formelle Einladung bekommt, und wie du dir wahrscheinlich denken kannst, ist er ziemlich, ähm ... engagiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460119
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460119,
					"content": "Engagement ist doch super.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460120
					]
				},
				{
					"id": 752460120,
					"content": "#Siehst du, {M#Opa}{F#meine andere Oma} weiß genau, wie der Hase läuft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460121
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460121,
					"content": "Wir bekommen jeden Tag eine neue Chance, für das zu kämpfen, was wichtig ist. Cacucu hat mich das gelehrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460122
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460122,
					"content": "Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460123
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460123,
					"content": "Aber ... ihr angelt doch nur? Seit wann zählt das als „für eine wichtige Sache zu kämpfen“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460124,
					"content": "Hörst du dich überhaupt reden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460125
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460125,
					"content": "Da es von einem Freund vorgeschlagen wurde, natürlich zählt es. Er ist ein berühmter Abenteurer aus Mondstadt, mit einem unglaublichen Glück. Wenn er sagt, dass etwas klappt, wer wären wir dann, es nicht zu tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460126
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460126,
					"content": "(Moment mal ... Bennett?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460127
					]
				},
				{
					"id": 752460127,
					"content": "Aber sowas von! Er hat mit einem Stock herumgewirbelt und am Ende hat er auf diesen Teich gezeigt. Oder wie Ororon es ausdrücken würde: Es ist besser, dem Glück zu folgen, wohin es einen führt, als zu versuchen, sein eigenes zu schmieden. Also kamen wir hierher, um zu angeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460128
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460128,
					"content": "Na gut, selbst wenn all das irgendeinen Sinn ergeben würde ... Um diesen Teich tummeln sich doch jede Menge Wasserschweine! Kann man hier überhaupt angeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460129,
					"content": "Ja, natürlich. Wasserschweine sind freundliche Geschöpfe, also ist alles in Ordnung. Außerdem, wenn das Leben dir Wasser gibt, angelst du. So hat es mir Oma beigebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460130
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460130,
					"content": "Ah ja, eine weitere von Omas Perlen der Weisheit. Genauso wie „Wenn das Leben dir Essen gibt, dann iss“ oder „Wenn das Leben dir Zitronen gibt, mach Limonade“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460131
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460131,
					"content": "#Genau. Nur, dass wir es diesmal sind, die euch die Zitronen reichen, {M#Opa}{F#andere Oma} und Paimon. Wo ihr schon mal hier seid, warum fischt ihr nicht mit uns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460132
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460132,
					"content": "Und, um den Einsatz ein wenig zu erhöhen ... Wer den größten Fisch fängt, bekommt ein Glas Aphimead von Ororon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460133
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460133,
					"content": "Das ist ja mal ein Angebot, das Paimon unterstützen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460134,
					"content": "#Hehe, hast du vergessen, mit wem du es hier zu tun hast? Wir schrecken vor keiner Herausforderung zurück, und {NICKNAME} ist ein harter Gegner!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460135,
						752460137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460135,
					"content": "Dann los, Bruder!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460136
					]
				},
				{
					"id": 752460136,
					"content": "Du bist schon sehr begeistert, wie ich sehe! Gut, bin dabei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460137,
					"content": "Dich mach ich fertig, Enkelchen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460138
					]
				},
				{
					"id": 752460138,
					"content": "Na gut, der Gewinner kriegt alles; also nicht nur alle Fische, sondern auch das Produkt der Laus-Mitarbeiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ororon"
				}
			]
		},
