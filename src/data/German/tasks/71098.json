			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710980901,
					"content": "Fangen wir an, Lutong, diesmal mit zehn Prozent weniger von jeder Zutat ... Also gut. Schritt 1: Mit dem Kochen beginnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980902
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980902,
					"content": "Ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980903
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980903,
					"content": "Erstens, das Wasser ... Ah! Achte auf die Geschwindigkeit, mit der das Wasser gegossen wird. Das ist sehr wichtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980904
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980904,
					"content": "Als Nächstes fügen wir die Zutaten hinzu. Zuerst kommt der Rettich hinein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980905
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980905,
					"content": "Das sieht eher nach einem Alchimie-Experiment aus als nach Kochen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980906,
					"content": "Werden Gerichte, die auf diese Weise zubereitet werden, wirklich gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980907,
					"content": "Und schon ist sie fertig: Rettichsuppe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980908
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980908,
					"content": "Unser Prozess verlief ziemlich reibungslos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980909
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980909,
					"content": "#In der Tat, lass sie uns probieren. Komm, {F#Reisende}{M#Reisender}, hier sind auch Suppen für euch beide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980910
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980910,
					"content": "Toll! Paimon kann es schon kaum erwarten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980911,
					"content": "Danke ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980912
					]
				},
				{
					"id": 710980912,
					"content": "Ach ... Es schmeckt wie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980913,
					"content": "Ich vermute, dass der Rettich noch eine Weile gekocht werden muss ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980914
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980914,
					"content": "*hüstel* Herrje ... Wie konnte die Minze so gekocht werden? Ich bin mir sicher, dass ich ihre optimale Kochzeit berechnet hatte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980915,
						710980916
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980915,
					"content": "Sieht so aus, als bräuchte ich es nicht zu trinken ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980917
					]
				},
				{
					"id": 710980917,
					"content": "*hust* Der Geschmack dieser Suppe ist ... tatsächlich schlechter als bei unserem letzten Versuch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980918
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980918,
					"content": "I... *hust* Ich stimme voll und ganz zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980919
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980919,
					"content": "*hust* Also gut ... Schritt 2: Analyse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980920
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980920,
					"content": "Sag ich doch! In der Formel muss der eine oder andere Parameter fehlen oder unsere Berechnungen sind noch ungenau ... Ich muss den Algorithmus der Maschine anpassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980921
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980921,
					"content": "Lutong, hast du alle Daten dieses Kochens aufgezeichnet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980922
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980922,
					"content": "Sie wurden alle aufgezeichnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980923
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980923,
					"content": "Ausgezeichnet! Dann sind wir dem Erfolg einen Schritt näher gekommen. In diesem Fall gehen wir zu Schritt 3 über: Wir bitten einen Koch, das Kochen noch einmal zu demonstrieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980924,
						710980926
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980924,
					"content": "Warum schaut ihr mich alle an?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980925
					]
				},
				{
					"id": 710980925,
					"content": "#Ich fürchte, du bist der Einzige, auf den wir bei der Zubereitung der Rettichsuppe zählen können, {F#Reisende}{M#Reisender}. Herr Yanxiao hat ... Sagen wir einfach, er ignoriert uns schon eine ganze Weile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980926,
					"content": "Du weißt, dass Yanxiao dort drüben ist, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980927
					]
				},
				{
					"id": 710980927,
					"content": "Uns die Küche zu leihen, wäre das größte Zugeständnis gewesen, das er hätte machen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980928
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980928,
					"content": "#Ich fürchte, du bist der Einzige, auf den wir zählen können, wenn es um die Rettichsuppe geht, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980916,
					"content": "Ich glaube, ich warte noch eine Weile ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980917
					]
				}
			]
		},
