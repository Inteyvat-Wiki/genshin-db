			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710981301,
					"content": "Dieser Parameter ... Nein, nein, ich muss zuerst den Algorithmus anpassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981302,
					"content": "Ich glaube, wir sollten sparsam mit unseren Ausgaben sein, damit wir nicht zu wenig Mora für unsere Reise nach Sumeru haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981303
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981303,
					"content": "Sumeru? Ah, ja, du hast recht, Lutong. Wenn wir erst einmal in Sumeru sind, werde ich sicher einen Weg finden, meine „Zahlenmaschine“ zu verbessern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981304
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981304,
					"content": "Dann kann meine Zahlenmaschine immer größere Berechnungen anstellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981305
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981305,
					"content": "... Ich stimme dir voll und ganz zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
		{
			"id": 7109815,
			"completionStepIds": [
				7109808
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109808",
							"2"
						],
						"stepId": 7109808,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710981501,
					"content": "Dieser Geschmack ist wirklich sehr gut, aber ich muss sagen, dass sie ganz anders schmeckt als die Rettichsuppe, die Herr Yanxiao macht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981502
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981502,
					"content": "Verzeih meine Neugierde, aber wie hast du dieses Gericht zubereitet? Wie waren die genauen Mengen der Zutaten? Welche Gewürze hast du verwendet und wie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981503,
						710981504
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981503,
					"content": "He! Abstand, Abstand!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981505
					]
				},
				{
					"id": 710981505,
					"content": "Oh ... Ich bitte um Entschuldigung. Trotzdem würde ich gern wissen, wie du dieses Gericht gemacht hast. Bitte detailliert ... Man weiß ja nie, woher die Inspiration kommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981506
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981506,
					"content": "Du hast ausführlich erklärt, wie man eine Rettichsuppe zubereitet ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710981507
					]
				},
				{
					"id": 710981507,
					"content": "Ah, jetzt verstehe ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981508
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981508,
					"content": "*seufz* Ah, es gibt wirklich zu viele Variablen, die den Geschmack eines einzigen Gerichts bestimmen. Um unsere Berechnungen zu verfeinern, muss viel gerechnet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981509
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981509,
					"content": "Aber ich muss meine „Zahlenmaschine“ verbessern, damit ich mehr Berechnungen durchführen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981510
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981510,
					"content": "Ich kann nur hoffen, dass die Akten in der Bibliothek der Akademie mich inspirieren können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981511
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981511,
					"content": "Warum wolltest du überhaupt eine „Zahlenmaschine“ bauen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981512
					]
				},
				{
					"id": 710981512,
					"content": "Hmm. Gute Frage. Aber bevor ich diese Frage beantworte, erlaube mir, dir zuerst eine zu stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981513
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981513,
					"content": "Glaubst du, dass die „Zahlenmaschine“ über „Gedanken“ verfügt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981514,
						710981515
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981514,
					"content": "Was meinst du damit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981516
					]
				},
				{
					"id": 710981516,
					"content": "Ganz genau. Bitte denke zuerst über diese Frage nach, wenn du möchtest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981517
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981517,
					"content": "Wir können diese Frage bei unserem nächsten Treffen besprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981518
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981518,
					"content": "Jetzt muss ich erst einmal ein paar Daten sortieren ... Komm, Lutong, wir fangen an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981519
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981519,
					"content": "Ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981520
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981520,
					"content": "#Ah ja, bitte nimm diese, {F#liebe Reisende}{M#lieber Reisender}. Bitte sei nicht böse auf Herrn Garcia. So ist er nun mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981521
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981521,
					"content": "Geht ihr beide nach Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981522
					]
				},
				{
					"id": 710981522,
					"content": "In der Tat. Herr Garcia möchte sich in der Akademie nach einigen Akten suchen und ich wurde beauftragt, ihn zu begleiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981523
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981523,
					"content": "#Auf Wiedersehen, {F#Reisende}{M#Reisender}. Es wäre wunderbar, wenn wir das Glück hätten, uns in Sumeru wiederzusehen ... und ich glaube, Herr Garcia würde sich auch sehr freuen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981515,
					"content": "Ob deine „Zahlenmaschine“ über ... „Gedanken“ verfügt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981516
					]
				},
				{
					"id": 710981504,
					"content": "Stehe nicht direkt vor meiner Nase!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981505
					]
				}
			]
		}
	]
}