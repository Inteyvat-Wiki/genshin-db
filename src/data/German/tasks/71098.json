					"content": "Ah, Herr Garcia scheint das Feuer im Herd gelöscht zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710981102,
					"content": "Lass uns zuerst das Feuer wieder anzuzünden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
