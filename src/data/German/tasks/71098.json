	"talks": [
		{
			"id": 7109801,
			"completionStepIds": [
				7109803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109803",
							"2"
						],
						"stepId": 7109803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lutong",
					"Garcia",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710980101,
					"content": "Ich glaube, es ist erwähnenswert, dass wir, wenn wir den heutigen Tag mitzählen, jetzt sechs volle Tage lang Rettichsuppe gegessen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980102,
					"content": "Trotz unserer finanziellen Notlage glaube ich, dass unsere gastrointestinalen Verhältnisse nicht ignoriert werden sollten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980103,
					"content": "Und du hast recht, mein lieber Lutong. Schlau wie immer, wenn ich das sagen darf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980104
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980104,
					"content": "Vielleicht liegt es an diesen gastrointestinalen Problemen, dass wir den Geschmack dieses Gerichts nicht beurteilen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980105
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980105,
					"content": "Wir brauchen einen Zeugen, Lutong! Wir müssen uns eine dritte Partei suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980106,
					"content": "Danke, aber ich glaube, mein Punkt war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980107,
						710980108
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980107,
					"content": "Entschuldigung, aber was macht ihr zwei da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980109
					]
				},
				{
					"id": 710980109,
					"content": "Aha! Und hier kommen nun unsere Zeugen ... natürlich in der Mehrzahl! Wunderbar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980110,
					"content": "Äh? Welche Zeugen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980111,
					"content": "Du meinst uns?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980112
					]
				},
				{
					"id": 710980112,
					"content": "Ja, genau! Sag mal, hast du schon mal Rettichsuppe gegessen? Kennst du ihren Geschmack und ihre Zubereitung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980113,
					"content": "Ich glaube, wir müssen sie zumindest über das Warum und Wieso dieser Situation aufklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980114,
					"content": "#Oh, natürlich! {NICKNAME} weiß, wie man sie zubereitet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980115,
					"content": "Paimon, wir sollten erst einmal hören, worum es hier geht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980116
					]
				},
				{
					"id": 710980116,
					"content": "Richtig, ja, lasst mich euch den Auftrag erklären ... Ich hoffe, ihr könnt ihn annehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980117,
					"content": "Ich bin Lutong und das ist Garcia, mein Chef, der aus Fontaine stammt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980118
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980118,
					"content": "Herr Garcia entwickelt derzeit eine ... Ich glaube, er nennt sie „Zahlenmaschine“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980119
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980119,
					"content": "Genauer gesagt ist es ein Gerät, mit dem man verschiedene Berechnungen durchführen kann. Ist das ungefähr richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980120,
					"content": "So präzise, wie es nur sein kann, mein lieber Lutong. Die Funktionen der Zahlenmaschine sind genau so. Das ist in der Tat eine prägnante Antwort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980121
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980121,
					"content": "Ja, Prägnanz ... Die Funktion muss prägnant sein. Die Funktionsweise des Geräts ist schon viel zu komplex ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980122
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980122,
					"content": "Aber was hat das mit der Rettichsuppe zu tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980123,
					"content": "Ah, ich glaube, diese Frage kannst du am besten beantworten, Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980124
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980124,
					"content": "Aber wie sollen wir es vereinfachen ... Oh! Richtig, ja. Erlaubt mir, das zu erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980125
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980125,
					"content": "Hmm ... Lass uns mit den elementarsten Dingen beginnen. Seid ihr mit „Formeln“ vertraut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980126
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980126,
					"content": "Hmm ... Nicht wirklich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980127,
					"content": "Mir ist auch nicht ganz klar, was du meinst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980128
					]
				},
				{
					"id": 710980128,
					"content": "Schon gut, das ist in Ordnung. Du kannst Formeln als ... ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980129
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980129,
					"content": "Eine Gleichung, die verwendet wird, um die Beziehung zwischen verschiedenen Größen auszudrücken, und die eine gewisse Allgemeingültigkeit besitzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980130
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980130,
					"content": "Äh? Was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980131,
					"content": "Klingt beeindruckend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980132
					]
				},
				{
					"id": 710980132,
					"content": "Einfach gesagt wollen wir mit der „Zahlenmaschine“ versuchen, eine Rezeptformel für Rettichsuppe zu schreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980133
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980133,
					"content": "Herr Garcia glaubt, dass wir die Zubereitung der Rettichsuppe mit der richtigen Formel in eine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980134
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980134,
					"content": "... Art allgemeines Verfahren umwandeln können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980135
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980135,
					"content": "In ein idiotensicheres Verfahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980136
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980136,
					"content": "Solange dieses Verfahren befolgt wird, kann jeder eine leckere Rettichsuppe herstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980137
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980137,
					"content": "Das klingt ziemlich lästig ... Aber hättest du nicht einfach jemanden bitten können, dir direkt zu zeigen, wie man das Gericht zubereitet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980138,
					"content": "Leider ist eine solche Methode zu sehr auf natürliches Talent angewiesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980139
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980139,
					"content": "Für Menschen wie Herrn Garcia und mich, die keinerlei kulinarische Veranlagung haben, ist es unwahrscheinlich, dass wir in der Lage wären, das Wesentliche der Lektionen zu erfassen, die uns ein noch so geduldiger Koch beibringen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980140
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980140,
					"content": "Ich glaube sogar, dass Herr Yanxiao von diesem Gasthaus das am eigenen Leib erfahren hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980141,
						710980143
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980141,
					"content": "Brauchst du also unsere Hilfe, um diese „Formel“ herzuleiten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980142
					]
				},
				{
					"id": 710980142,
					"content": "Nein, sicher nicht. Ich würde euch niemals auf diese Art und Weise übermäßig belästigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980145
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980145,
					"content": "Genau, wir möchten, dass ihr als „neutrale dritte Partei“ fungiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980146
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980146,
					"content": "Ganz einfach: Wir brauchen euch, um die Rettichsuppe zu probieren, die Herr Garcia nach dem Rezept zubereitet, und um Kommentare abzugeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980147
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980147,
					"content": "Kurz gesagt, wir sind also hier, um Geschmackstester für gutes Essen zu sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980148,
					"content": "Du hast es etwas zu sehr vereinfacht, denke ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980149
					]
				},
				{
					"id": 710980149,
					"content": "Oh, das wird gut! Paimon hat jedenfalls noch nie eine Rettichsuppe gegessen, die nach einer „Formel“ zubereitet wurde! Probieren wir es einfach mal aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980150,
					"content": "Das ist schon mal geklärt. In diesem Fall sollten wir uns in die Küche begeben. Herr Yanxiao hat uns freundlicherweise erlaubt, sie zu benutzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980151
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980151,
					"content": "Herr Garcia, sollen wir bei diesem Experiment mit denselben Schritten wie zuvor fortfahren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980152
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980152,
					"content": "Hm? Oh! Richtig, entschuldige. Ich war nur ein bisschen abgelenkt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980153
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980153,
					"content": "Zu viele unkontrollierte Parameter schwirren in meinem Kopf herum, weißt du ... Aber ja, machen wir weiter mit unserem bisherigen dreistufigen Verfahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980143,
					"content": "Sollen wir dir also das Kochen beibringen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980144
					]
				},
				{
					"id": 710980144,
					"content": "Hmm, das würde ich auch nicht sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980145
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980108,
					"content": "Über das „Rezept“ für die Rettichsuppe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980109
					]
				}
			]
		},
		{
			"id": 7109803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109804",
							"3"
						],
						"stepId": 7109804,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lächelnder Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710980301,
					"content": "Ich versteh’s nicht. Gibt es wirklich Leute, die nicht wissen, wie man Rettichsuppe kocht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980302
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 710980302,
					"content": "Sie fragten wieder und wieder, wieder und wieder! Woher soll ich die genaue Menge von ... na ja, von allem, was ich in die Gerichte gebe, wenn ich sie zubereite, kennen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980303
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 710980303,
					"content": "Kann er nicht einfach so viel reintun, wie er will, und seinem Herzen folgen? Ich bin ein Koch, kein Kochbuch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980304
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 710980304,
					"content": "Wären die Mora von ihnen nicht geflossen, hätte ich mich schon vor langer Zeit bei der Inhaberin beschwert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980305
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 710980305,
					"content": "Ich habe einfach Pech, dass ich solche Leute treffe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lächelnder Yanxiao"
				}
			]
		},
