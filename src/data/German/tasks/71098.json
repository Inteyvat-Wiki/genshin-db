			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710980701,
					"content": "... Dieser Parameter und dieser ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980702
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980702,
					"content": "Herr Garcia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980703
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980703,
					"content": "Nein, nein ... Fast ... Warte, nein. Ah, faszinierend. Wie faszinierend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980704
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980704,
					"content": "Herr Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980705
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980705,
					"content": "Ah, Lutong. Mein guter Lutong, hast du mir geholfen, dieses Gericht zu bestellen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980706
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980706,
					"content": "Ja, die Rettichsuppe ist bestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980707
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980707,
					"content": "Wunderbar. Wie rücksichtsvoll von dir, lieber Lutong. Ich bin mir sicher, dass wir dieses Mal unsere Zubereitungsformel haben werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980708
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980708,
					"content": "Ich freue mich darauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980709
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980709,
					"content": "Hm? Wovon reden die denn da ... Und was ist überhaupt eine Zubereitungsformel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980710,
						710980712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980710,
					"content": "Keine Ahnung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980711
					]
				},
				{
					"id": 710980711,
					"content": "Lass uns sie fragen! Vielleicht forschen sie an einem neuen Gericht ... Du weißt schon, eines, das wir probieren können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980712,
					"content": "Wir sollten sie fragen gehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980713
					]
				},
				{
					"id": 710980713,
					"content": "Ja! Vielleicht forschen sie an einem neuen Gericht ... Du weißt schon, eines, das wir probieren können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7109809,
			"completionStepIds": [
				7109809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
