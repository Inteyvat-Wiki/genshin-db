			},
			"dialogs": [
				{
					"id": 710981201,
					"content": "Gut! Also machen wir zunächst einmal eine gute Rettichsuppe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7109813,
