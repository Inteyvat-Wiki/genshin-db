				"points": []
			},
			"dialogs": [
				{
					"id": 10280701,
					"content": "Jetzt sind wir in einer brenzligen Situation. Wir haben bisher keinen Ausgang gefunden. Wir müssen uns mental darauf vorbereiten, für eine längere Zeit hier festzusitzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280702
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280702,
					"content": "Glücklicherweise scheinen die Vorräte noch auszureichen. In dieser bunt zusammengewürfelten Truppe sind auch Leute, die gut mit Krisen umgehen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280703
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280703,
					"content": "Passt gut auf euch auf. Ich kümmere mich um den Rest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				}
			]
		}
