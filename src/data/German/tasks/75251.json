					],
					"speakerTitle": "Papar"
				},
				{
					"id": 752510102,
					"content": "Aaaah! Wer bist du denn?! Wie bist du denn vom Baum gefallen?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752510103,
					"content": "Ich bin Papar! Hayne, hatten wir nicht ausgemacht, noch eine Runde zu trinken? Hätten wir uns heute doch früher getroffen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
