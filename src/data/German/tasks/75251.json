					"nextDialogs": [
						752510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752510108,
					"content": "Äh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510109
					],
					"speakerTitle": "Papar"
				},
				{
					"id": 752510109,
					"content": "Hayne, wo bist du? Lass uns weitertrinken!",
