				},
				{
					"id": 752510105,
					"content": "Hm ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752510106
					]
				},
				{
					"id": 752510106,
					"content": "Hayne, warum gibt es plötzlich zwei von dir? Ein großer ... und ein kleiner ...",
