						"pointId": 350400120
					}
				]
			},
			"dialogs": [
				{
					"id": 250310401,
					"content": "Vielen Dank für deine Hilfe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310402
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310402,
					"content": "Hätte ich diese blöde Tasche früher losgelassen, hätte ich sie allein besiegen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310403
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310403,
					"content": "Dann wäre unser Besuch in Natlan umsonst gewesen! Das will ich erst recht nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310404
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310404,
					"content": "Moment mal, bist du ... Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310405
					]
				},
				{
					"id": 250310405,
					"content": "#Hä? D... Du bist {NICKNAME}! Tatsächlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310406
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310406,
					"content": "Und diese Dame hier, ist das etwa ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310407
					]
				},
				{
					"id": 250310407,
					"content": "Narzam. Schatzräuberin. Wir haben uns schon mal gesehen, erinnerst du dich nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310408
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310408,
					"content": "#Du bist wirklich mein{F#e} Lebensretter{F#in}, wie oft hast du mich schon gerettet? Einmal, zweimal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310409
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310409,
					"content": "Zähl das eine Mal nicht mit. Da wolltest du selbst nicht gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310410
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310410,
					"content": "Das zähle ich nicht mit, und was heißt, ich wollte nicht gehen? Ich hatte dich bereits dafür bezahlt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310411
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310411,
					"content": "Der winzige Betrag war schnell für Essen und Trinken aufgebraucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310412
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310412,
					"content": "Sag bloß, du bist schon wieder wegen eines Aufsatzes hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310413
					]
				},
				{
					"id": 250310413,
					"content": "Hehe ... Ich habe so lange daran gearbeitet, ich kann doch jetzt nicht aufgeben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310414
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310414,
					"content": "Diesmal habe ich spezielle Mittel von der Akademie bekommen, das Thema steht fest, und niemand kommt mir in die Quere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310415
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310415,
					"content": "Außerdem habe ich Narzam als meine Leibwächterin, sie verjagt alle Bösewichte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310416
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310416,
					"content": "Weil es bei uns nichts zu holen gibt und sie keinen Ärger wollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310417,
						250310418
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310417,
					"content": "Aber ihr habt gerade eben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				},
				{
					"id": 250310419,
					"content": "... Auf dem ganzen Weg, den wir von den „Kindern der Echos“ bis hierher gelaufen sind, hat dieses Mädchen ihre Tasche mit den Dokumenten fest umklammert gehalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310420
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310420,
					"content": "Ehrlich gesagt, selbst für mich sah sie bekloppt aus, als würde sie einen Schatz im Arm halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310421
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310421,
					"content": "Jemand, der anscheinend etwas so Wertvolles mit sich herumträgt, allein im Nirgendwo, mit nur einer Leibwache ... Wer würde es nicht riskieren, einen Versuch zu wagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310422
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310422,
					"content": "Ganz recht! In meiner Tasche sind echte Schätze. Das sind meine gesamten Feldforschungsnotizen und Abschriften aller möglichen wichtigen Dokumente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310423
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310423,
					"content": "Solange ich die habe, kann ich problemlos meinen Aufsatz fertig schreiben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310424
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310424,
					"content": "Hmpf, das Thema meines Aufsatzes ist die „Pilgerreise zur Rückkehr des heiligen Feuers“. Das Thema ist alles andere als trivial und wird mich sicher zum Abschluss bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310425
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310425,
					"content": "Ach ja, danke an Tahmures für die Idee. Sie ist wirklich meine beste Freundin, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310426
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310426,
					"content": "#Danke nochmal, {NICKNAME}. Ohne dich hätten diese Bösewichte nicht nur meine Bücher kaputt gemacht, sondern auch meine Mora geklaut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310427
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310427,
					"content": "Vor einiger Zeit habe ich Leuten geholfen, Bücher zu sortieren und Materialien zu ordnen, und dabei mühsam etwas verdient. Wenn das gestohlen worden wäre, könnte ich keine neuen Materialien mehr kaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310428
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310428,
					"content": "Aber letztendlich würdest du doch dein ganzes Vermögen für Bücher ausgeben. Hätte ich dir nicht dein Portemonnaie weggenommen, würden wir jetzt hungern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310429
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310429,
					"content": "I... Ich hab doch nicht so viel gekauft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310430
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310430,
					"content": "Ach, reden wir später weiter. Wir müssen noch zu den Menschen der Quellen, um Material zu sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310431
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310431,
					"content": "Also, bis dann. Beim nächsten Treffen ist mein Aufsatz bestimmt fertig! Dann lade ich dich auf ein feines Essen ein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310418,
					"content": "Und dann seid ihr doch in Schwierigkeiten geraten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				}
			]
		},
