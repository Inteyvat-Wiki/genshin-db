				]
			},
			"dialogs": [
				{
					"id": 250310101,
					"content": "So ein Schlamassel ... Das ist wirklich überhaupt nicht gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310102
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310102,
					"content": "Gibt es ein Problem mit Alems Training?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310103
					]
				},
				{
					"id": 250310103,
					"content": "#{NICKNAME}! Du kommst gerade rechtzeitig, welch ein Glück ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310104
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310104,
					"content": "Nein, es geht nicht um Alem. Aber ich habe keine Zeit für Erklärungen. Bitte hilf mir schnell, sie zu retten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310105,
						250310106
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310105,
					"content": "Ist sie eine Freundin von dir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				},
				{
					"id": 250310107,
					"content": "Na ja ... so ungefähr. Wir sind beide mehrmals an unseren Aufsätzen verzweifelt und haben zusammen in der Bibliothek geweint ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310108
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310108,
					"content": "Aaah! Jetzt ist nicht die Zeit für solche Geschichten! Sie hört überhaupt nicht auf mich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310109
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310109,
					"content": "Na, die redet ständig davon, wie wichtig ihr Aufsatz für sie ist, und zieht dann aber ständig mit ihrem Leibwächter durch die Wildnis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310110
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310110,
					"content": "Und bis jetzt ist sie nicht wieder aufgetaucht! Der Stamm hat auch keine Leute frei, um nach ihr zu suchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310111
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310111,
					"content": "#{NICKNAME}, kannst du sie bitte retten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310112,
						250310113
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310112,
					"content": "Kein Problem, ich kenne mich damit aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310115
					]
				},
				{
					"id": 250310115,
					"content": "#Du bist unsere einzige Hoffnung! Alles hängt von dir ab, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310113,
					"content": "Ihr Leute von eurer Akademie, echt unglaublich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310114
					]
				},
				{
					"id": 250310114,
					"content": "Dieses Mädchen ... *seufz* Ihr Pech ist wirklich unglaublich. Diesmal ist sie nach Natlan gekommen und meinte, sie wolle einen letzten Anlauf für ihren Aufsatz unternehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310115
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310106,
					"content": "Ist sie eine Bekannte von dir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				}
			]
		},
		{
