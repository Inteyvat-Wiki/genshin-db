					}
				]
			},
			"dialogs": [
				{
					"id": 250310501,
					"content": "Wie sieht’s aus? Alles in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310502,
						250310503
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310502,
					"content": "Alrani ist in Sicherheit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310504
					]
				},
				{
					"id": 250310504,
					"content": "Uff ... Ich war echt besorgt. Wäre sie nicht zurückgekommen, wäre ich selbst losgezogen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310505
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310505,
					"content": "Warum kann diese Blitzbirne nicht ein einfacheres Thema wählen? Mit ihren Fähigkeiten könnte sie locker den Abschluss machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310506
