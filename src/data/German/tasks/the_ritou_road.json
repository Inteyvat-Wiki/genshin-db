			"trigger": {
				"objectNames": [
					"Harrison"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728090108,
					"content": "Sie sind endlich angekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090109
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090109,
					"content": "Das hat wirklich lange gedauert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090110
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090110,
					"content": "Warum ist diese Schachtel an der Ecke zerbrochen? Das geht ja gar nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090111
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090111,
					"content": "Wirklich! Ich sagte ihm doch, er solle vorsichtig sein. Hoffen wir nur, dass innen nichts kaputt ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090112
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090112,
					"content": "Zum Glück gingen keine Flaschen kaputt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090113
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090113,
					"content": "Hm? Warum ist der Deckel auf dieser Flasche lose ... Ich muss ihn abschrauben und wieder aufsetzen, damit es funktioniert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090114
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090114,
					"content": "Ähem! Ähem ... Der Geruch dieser Zutaten für das Getränk ist ... so intensiv ... Besser schnell weg damit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090115
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090115,
					"content": "He, was, was soll das mit den ganzen Schleim?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harrison"
				}
			]
		},
		{
			"id": 7280902,
			"completionStepIds": [
				7280907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280907",
							"2"
						],
						"stepId": 7280907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Harrison"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728090204,
					"content": "#Vielen Dank, vielen Dank, vielen Dank, {F#Reisende}{M#Reisender} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090205
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090205,
					"content": "Wenn ich nicht deine Hilfe hätte, wäre ich ich verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090206,
						728090208
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090206,
					"content": "Hast du dieses Lager gebaut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090207
					]
				},
				{
					"id": 728090207,
					"content": "Na ja ... irgendwie schon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090210,
					"content": "Wie du weißt, ist es nicht einfach, außerhalb der Inseln Geschäfte zu machen, und dieses Lager ... ist sozusagen mein kleiner Trick, um Geschäfte zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090211
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090211,
					"content": "Neulich bat ich einen ... Freund, mir eine Charge Getränkezutaten aus Mondstadt zu bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090212
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090212,
					"content": "Er hat vor einiger Zeit einen Freund gebeten, eine Probecharge neuer Ware vom Weingut Morgenröte zu besorgen, und die ist erst in den letzten Tagen eingetroffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090213
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090213,
					"content": "Aber der Kerl hatte kein gutes Händchen dabei, also stieß er gegen die Schachtel und der Deckel löste sich von der darin enthaltenen Flasche mit Getränkezutaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090214
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090214,
					"content": "Ich dachte dann, ich schraube erst die Abdeckung ab und dann wieder auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090215
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090215,
					"content": "Ich hatte nicht erwartet, dass sich ein Haufen Schleim auf mich stürzen würde, sobald ich den Deckel abschraubte. Es war unerklärlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090216
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090216,
					"content": "Getränkezutaten aus dem Weingut Morgenröte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090217
					]
				},
				{
					"id": 728090217,
					"content": "Vergiss es für den Moment, ich werde mit dem Kerl über die Getränkezutaten sprechen, wenn er das nächste Mal vorbeikommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090218
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090218,
					"content": "Ihr habt mich gerettet, ich muss euch etwas geben, um euch dafür zu danken ... Nehmt die hier zuerst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090219
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090219,
					"content": "Abgesehen davon, seht ihr das kleine Boot da drüben? Das ist noch einer meiner ... kleinen Tricks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090220
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090220,
					"content": "Mit diesem Schiff könnt ihr von hier still und heimlich zur Insel Narukami reisen ... Hehehe, ist das nicht praktisch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090221
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090221,
					"content": "Warum denn still und heimlich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090222
					]
				},
				{
					"id": 728090222,
					"content": "Ach, weißt du ... nur für den Fall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090223
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090223,
					"content": "#Nun, ich muss wieder an die Inventur meiner Waren gehen, also werde ich für eine Weile nicht mehr hier sein. Also nochmals vielen Dank, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090224
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090224,
					"content": "Sieht so aus, als müsste ich meinen Aufnahmeort wieder wechseln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090208,
					"content": "Was machst du denn hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090209
					]
				},
				{
					"id": 728090209,
					"content": "Ich ... transportiere Waren ... hahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "Harrison"
				}
			]
		}
	]
}