			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vom Essen besessenes Phantom"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330101,
					"content": "He, Neuling. So kannst du das Essen nicht machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330102
					],
					"speakerTitle": "Vom Essen besessenes Phantom"
				},
				{
					"id": 760330102,
					"content": "Die Rationen, die wir zubereiten, werden an die Ratniki auf der Insel verteilt, also müssen wir ihre Vorlieben beachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330103
					],
					"speakerTitle": "Vom Essen besessenes Phantom"
				},
				{
					"id": 760330103,
					"content": "Diese Gerichte sind absolut unbrauchbar. Erstens stimmt die Garzeit nicht, und zweitens entsprechen sie nicht unseren Ernährungsstandards. Das muss geändert werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330104
					],
					"speakerTitle": "Vom Essen besessenes Phantom"
				},
				{
					"id": 760330104,
					"content": "Du musst noch üben. Fang damit an, ein paar traditionelle Gerichte aus Nod-Krai zuzubereiten, wie etwa das Nod-Krai-Hotdog. Zeig es mir, wenn es fertig ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vom Essen besessenes Phantom"
				}
			]
		},
		{
			"id": 7603302,
			"completionStepIds": [
				7603304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603304",
							"2"
						],
						"stepId": 7603304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vom Essen besessenes Phantom"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330201,
					"content": "Hmm. Das Würstchen ist schön gegrillt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330202
					],
					"speakerTitle": "Vom Essen besessenes Phantom"
				},
				{
					"id": 760330202,
					"content": "Wenn du draußen in einem Restaurant arbeiten würdest, wärst du gut als Küchenhilfe geeignet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330203
					],
					"speakerTitle": "Vom Essen besessenes Phantom"
				},
				{
					"id": 760330203,
					"content": "Aber wir müssen alle Ratniki auf der Insel füttern. Es ist also weniger wichtig, dass das Essen exquisit ist, als dass es genug davon gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330204
					],
					"speakerTitle": "Vom Essen besessenes Phantom"
				},
				{
					"id": 760330204,
					"content": "Mach das Brot etwas dicker. Es gibt momentan nicht besonders viel Gemüse und du könntest auch noch andere Fleischsorten als Würstchen hinzufügen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330205
					],
					"speakerTitle": "Vom Essen besessenes Phantom"
				},
				{
					"id": 760330205,
					"content": "Du musst noch mehr üben! Komm nächstes Mal wieder und mach mal gebratenes Fleisch mit Beeren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vom Essen besessenes Phantom"
				}
			]
		},
		{
			"id": 7603303,
			"completionStepIds": [
				7603306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603306",
							"2"
						],
						"stepId": 7603306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vom Essen besessenes Phantom"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330301,
					"content": "Mhm. Das Fleisch ist dick genug geschnitten und gut durch. Nicht schlecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330302
					],
					"speakerTitle": "Vom Essen besessenes Phantom"
				},
				{
					"id": 760330302,
					"content": "Aber ich muss dich an eine Sache erinnern: Bei gebratenem Fleisch muss man auf die Beilagen achten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330303
					],
					"speakerTitle": "Vom Essen besessenes Phantom"
				},
				{
					"id": 760330303,
					"content": "Wenn man zu viel Fleisch isst, wird man schnell pappsatt. Deshalb sind die Beeren da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330304
					],
					"speakerTitle": "Vom Essen besessenes Phantom"
				},
				{
					"id": 760330304,
					"content": "Auf der Insel sind wir für die Ernährung aller verantwortlich. Daher müssen wir darauf achten, dass die Menge an Gemüse und Fleisch ausgewogen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330305
					],
					"speakerTitle": "Vom Essen besessenes Phantom"
				},
				{
					"id": 760330305,
					"content": "Hier ist zu wenig Gemüse. Das geht einfach nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330306
					],
					"speakerTitle": "Vom Essen besessenes Phantom"
				},
				{
					"id": 760330306,
					"content": "Du musst noch mehr üben! Komm nächstes Mal wieder und mach mal mit Lakkabeeren gefülltes Hühnchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vom Essen besessenes Phantom"
				}
			]
		},
		{
			"id": 7603304,
			"completionStepIds": [
				7603308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603308",
							"2"
						],
						"stepId": 7603308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vom Essen besessenes Phantom"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330401,
					"content": "Das Hähnchen ist schmackhaft, und es gibt genügend Beilagen. Du machst es mir ganz schön schwer, spitzfindig zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330402
					],
					"speakerTitle": "Vom Essen besessenes Phantom"
				},
				{
					"id": 760330402,
					"content": "Ach, lass es gut sein. Ich will mich nicht zu sehr auf euch Neuankömmlinge einschießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330403
					],
					"speakerTitle": "Vom Essen besessenes Phantom"
				},
				{
					"id": 760330403,
					"content": "Ich bin nur ein Koch, der seine Arbeit macht und sie auch gut machen will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330404
					],
					"speakerTitle": "Vom Essen besessenes Phantom"
				},
				{
					"id": 760330404,
					"content": "Und als solcher bin ich auch auf die Wilde Jagd vorbereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330405
					],
					"speakerTitle": "Vom Essen besessenes Phantom"
				},
				{
					"id": 760330405,
					"content": "Es ist nur schade, dass ich die fertigen Gerichte nicht rechtzeitig liefern konnte ... Alles wurde verschüttet ... verschüttet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vom Essen besessenes Phantom"
				}
			]
		}
	]
}