			"dialogs": [
				{
					"id": 752630301,
					"content": "Unfassbar! Jemand hat tatsächlich die stürmische Nanas besiegt!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630302
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630302,
					"content": "#Was für ein Tempo! Wie der Wind gekommen und gleich den Sieg eingesackt! Glückwunsch an {M#diesen Herausforderer}{F#diese Herausfordererin}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630303
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630303,
					"content": "I... Ich habe wirklich verloren? Das kann doch nicht sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630304
					],
					"speakerTitle": "„Stürmische Nanas“"
				},
				{
					"id": 752630304,
					"content": "#Wahnsinn, {M#er}{F#sie} war richtig gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630305
					]
				},
				{
					"id": 752630305,
					"content": "Aber ...! Alle alten Fans wissen es: Stürmische Nanas war nicht die Stärkste, die die Rennbahn je gesehen hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630306
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630306,
					"content": "Vor ihr gab es zwei legendäre Lokalfavoriten, die das Feld einst dominiert haben! Und die sind heute ebenfalls hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630307
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630307,
					"content": "Begrüßen wir „Blitz“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630308
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630308,
					"content": "♪, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630309
					]
				},
				{
					"id": 752630309,
					"content": "Und „Pfeil“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630310
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630310,
					"content": "♫, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630311
					]
				},
				{
					"id": 752630311,
					"content": "#{M#Herausforderer}{F#Herausfordererin}, diese zwei sind echt eine andere Liga. Mit dem, was du gerade gezeigt hast, wird’s richtig schwer, die beiden zu schlagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630312
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630312,
					"content": "Bist du bereit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630313
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630313,
					"content": "Ich bin bereit!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630314
					]
				},
				{
					"id": 752630314,
					"content": "Die Mitarbeiter haben die Rennstrecke vorbereitet, die Zuschauer versammeln sich ... Ihr steht an der Startlinie ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
