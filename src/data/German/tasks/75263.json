					"Kinowa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752630101,
					"content": "Liebe Gäste, das Rennen startet gleich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630102
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630102,
					"content": "Wer es schafft, unsere Titelverteidigerin „Stürmische Nanas“ zu schlagen, die schon drei Tage in Folge gewonnen hat, bekommt heute den großen Überraschungspreis! Wer noch nicht angemeldet ist: Jetzt aber schnell!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630103
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630103,
					"content": "Hmpf! Gibt’s echt niemanden mehr, der sich gegen mich, die „stürmische Nanas“, traut?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630104
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630104,
					"content": "*seufz* ... Die „stürmische Nanas“ ist einfach zu stark. Die hat schon drei Tage in Folge gewonnen, da kann keiner mithalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630105
					]
				},
				{
					"id": 752630105,
					"content": "*brüll*!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630106
					]
				},
				{
					"id": 752630106,
					"content": "Hm? Willst du etwa mitmachen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630107
					]
				},
				{
					"id": 752630107,
					"content": "Pah, seid ihr schon so tief gesunken, dass ihr euch hinter euren Sauriern versteckt? Feiglinge! Dann schickt doch all eure Saurier ins Rennen! Ich, die „stürmische Nanas“, werde euch zeigen, was wahre Geschwindigkeit bedeutet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630108
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630108,
					"content": "Was für ein spannendes Spektakel! Können unsere kräftigen Sauriergefährten es wirklich mit dem dreifachen Champion, der „stürmischen Nanas“ aufnehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinowa"
				}
			]
		},
		{
			"id": 7526302,
			"completionStepIds": [
				7526301
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kinowa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752630201,
					"content": "Ich will auch mitmachen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630202
					]
				},
				{
					"id": 752630202,
					"content": "#Was für eine Wendung! {F#Eine mutige Herausfordererin}{M#Ein mutiger Herausforderer} betritt die Bühne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630203
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630203,
					"content": "Oh? So ein übermütiger kleiner Wicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630204
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630204,
					"content": "Was für ein nervenaufreibender Wettkampf ... Wer wird sich am Ende durchsetzen? Wir dürfen gespannt sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630205
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630205,
					"content": "Die Mitarbeiter haben die Rennstrecke vorbereitet, die Zuschauer versammeln sich ... Ihr steht an der Startlinie ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
