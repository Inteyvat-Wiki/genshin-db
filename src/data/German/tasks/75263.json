			"dialogs": [
				{
					"id": 752630501,
					"content": "Der Wettkampf ist vorbei! Und was für ein unglaubliches Ergebnis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630502
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630502,
					"content": "#Ich verkünde: {F#Die Siegerin}{M#Der Sieger} dieses Wettkampfs ist ... {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630503
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630503,
					"content": "#Boah! {M#Er}{F#Sie} ist ja wirklich stark! Sogar „Blitz“ und „Pfeil“ sind besiegt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630504
					]
				},
				{
					"id": 752630504,
					"content": "Wie ein goldener Blitz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630505
					]
				},
				{
					"id": 752630505,
					"content": "He! Und was ist mit dem silbernen Blitz?! Hat den echt niemand gesehen?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752630506,
					"content": "Ich habe total verloren ... An diese Geschwindigkeit komme ich mein ganzes Leben nicht ran ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630507
					],
					"speakerTitle": "„Stürmische Nanas“"
				},
				{
					"id": 752630507,
					"content": "Gib nicht auf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630508
					]
				},
				{
					"id": 752630508,
					"content": "Ich ... Ich werde dich zu meinem Vorbild machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630509
					],
					"speakerTitle": "„Stürmische Nanas“"
				},
				{
					"id": 752630509,
					"content": "♪, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630510
					]
				},
				{
					"id": 752630510,
					"content": "♫, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630511
					]
				},
				{
					"id": 752630511,
					"content": "Bitte nimm diesen Preis entgegen, er gehört dir, Champion des diesjährigen Turniers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630512
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630512,
					"content": "Dein Name wird für immer in der Geschichte des Rennens stehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinowa"
				}
			]
