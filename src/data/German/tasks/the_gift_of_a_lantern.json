					"content": "Ja, ich habe alles dabei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180603
					]
				},
				{
					"id": 718180603,
					"content": "Danke sehr.",
					"roleType": "TALK_ROLE_NPC",
