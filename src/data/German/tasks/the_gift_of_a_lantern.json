			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangcheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180301,
					"content": "Komm, mein Schatz, und sprich ein bisschen mit Bai ... Ihr Vater ist ein wirklich geschickter Handwerker ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180302
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180302,
					"content": "Sie verkaufen ihren Tofu im Hafen von Liyue, er ist von äußerst hoher Qualität!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180303
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180303,
					"content": "Stimmt! Ich habe ganz vergessen, dich zu fragen, warum du hergekommen bist, Bai ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180304
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180304,
					"content": "Wir haben dir eine Laterne mitgebracht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180305
					]
				},
				{
					"id": 718180305,
					"content": "Eine Laterne ... Ah ... Wie aufmerksam von euch. Jedes Jahr bringst du mir eine, Bai ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180306
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180306,
					"content": "Weißt du noch, mein Schatz? Früher habe ich selber ganz tolle Laternen gemacht. Sie haben unseren Nachbarn immer so gut gefallen, dass sie mich baten, auch ihnen welche zu basteln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180307
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180307,
					"content": "Diese Laternen sind so schön, sie bringen jedes Laternenritual zum Erstrahlen ... Wartet, ich werde sie für euch aufhängen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180308
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180308,
					"content": "Lass das bitte mich tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180309
					]
				},
				{
					"id": 718180309,
					"content": "In Ordnung, aber bitte sei vorsichtig. Tu dir nicht weh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangcheng"
				}
			]
		},
		{
			"id": 7181804,
			"completionStepIds": [
				7181806
			],
