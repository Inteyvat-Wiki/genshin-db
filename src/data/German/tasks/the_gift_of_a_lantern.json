			"dialogs": [
				{
					"id": 718180701,
					"content": "Vielen Dank. Ich werde mir dann später eine Laterne machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180702
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180702,
					"content": "Früher habe ich die Laternen immer gemeinsam mit meinem Vater aufsteigen lassen. Wenn ich mit dieser hier fertig bin, werde ich sie alleine losschicken müssen",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180703
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180703,
					"content": "Aber ich hoffe ... dass er sie wenigstens sehen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180706,
						718180704
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180706,
					"content": "Du wirst es definitiv sehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180705
					]
				},
				{
					"id": 718180705,
					"content": "Vielen Dank. Ich wünsche dir ein Fröhliches Laternenritual.",
