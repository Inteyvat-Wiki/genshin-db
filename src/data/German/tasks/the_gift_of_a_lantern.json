				{
					"id": 718180901,
					"content": "Du bist es, Bai ... Geht es deinem Vater gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180902
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180902,
					"content": "Äh ... Er ... Es geht ihm gut, ja. Die Mühle ist sehr oft im Einsatz. Und die Stadtmenschen aus dem Hafen von Liyue kommen oft extra in das Dorf, um Tofu zu kaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180903
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180903,
					"content": "Haha ... Das klingt doch gut! Der Tofu deines Vaters ist der ganze Stolz des Qingce-Dorfes ...",
