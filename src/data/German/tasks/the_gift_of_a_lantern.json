			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangcheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180401,
					"content": "Hast du die Laterne aufgehängt? Wirklich atemberaubend. Das neue Jahr wird sicher ein weiteres gutes Jahr werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180402,
						718180403
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180402,
					"content": "Ganz sicher.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180404
					]
				},
				{
					"id": 718180404,
					"content": "Es wird Zeit, Großvater Jiangcheng. Wir müssen los, weil wir noch ein paar Dinge erledigen müssen. Ich werde dich aber bald wieder besuchen kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180405
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180405,
					"content": "Ich verstehe ... Junge Menschen haben immer irgendetwas Wichtiges zu tun ... und gönnen sich keine Atempause ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180406
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180406,
					"content": "Tschüs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180407
					]
				},
				{
					"id": 718180407,
					"content": "Ah, natürlich. Schatz ... vergiss nicht, dich um unser Land zu kümmern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180403,
					"content": "Mit Sicherheit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180404
					]
				}
			]
		},
		{
			"id": 7181805,
			"completionStepIds": [
				7181807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
