						],
						"stepId": 7181801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fräulein Bai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180101,
					"content": "#Wie geht’s dir, {F#Reisende}{M#Reisender}? Vielen Dank für deine Hilfe beim letzten Mal. Das Qingce-Dorf hat sich schon lange nicht mehr so lebendig angefühlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180102
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180102,
					"content": "Wirklich gern geschehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180103
					]
				},
				{
					"id": 718180103,
					"content": "In früheren Jahren waren nur Zhi und ich hier, also konnten wir auch nur wenige Laternen für die Kinder machen, mit den älteren Bewohnern übers Geschäft reden und ein paar wenige gute Speisen zubereiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180104
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180104,
					"content": "Mit deiner Hilfe aber konnten wir dieses Mal ein wirklich beschwingtes Laternenritual feiern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180105
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180105,
					"content": "Jetzt aber sollten wir wohl wieder zu normalen Verhältnissen zurückkehren ... Und ich muss mich um die älteren Menschen im Dorf kümmern. Heute ist Jiangcheng dran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180106
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180106,
					"content": "Macht es dir etwas aus, mit mir zu kommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180107
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180107,
					"content": "Dann nichts wie los.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180108
					]
				},
				{
					"id": 718180108,
					"content": "In Ordnung. Dann besuchen wir ihn am besten gleich als erstes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fräulein Bai"
				}
			]
		},
		{
			"id": 7181802,
			"completionStepIds": [
				7181802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181801",
							"3"
						],
						"stepId": 7181801,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181802",
							"2"
						],
						"stepId": 7181802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangcheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180201,
					"content": "Bist du das, mein Schatz? Bist du wieder da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180202
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180202,
					"content": "Tut mir leid, aber ich glaube, du verwechselst mich da mit jemandem ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180203
					]
				},
				{
					"id": 718180203,
					"content": "Blödsinn, ich hab doch noch alle Tassen im Schrank ... Wie sollte ich denn bitte meine eigene Frau nicht kennen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180204
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180204,
					"content": "Ich wollte dir gerade sagen, dass wir vielleicht ein paar neue Klamotten für unsere Tochter besorgen sollten, jetzt, wo ein großes Fest vor der Tür steht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180205
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180205,
					"content": "Du hast ja einen Gast mitgebracht ... Oh, das muss die Schneiderin sein. Du hast ja wirklich meine Gedanken gelesen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180206
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180206,
					"content": "Großvater Jiangcheng, ich bin’s doch, Bai. Ich habe dir gestern Tofu zubereitet. Du hast mich doch nicht schon vergessen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180207
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180207,
					"content": "Ah ... Bai ... Natürlich kenne ich dich, Bai! Dein Vater hat mir erst vor Kurzem gesagt, wie stolz er auf dich ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180208
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180208,
					"content": "Äh ... Wann war denn das? ... Vielleicht kannst du dich erinnern, mein Schatz ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180209,
						718180210
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180209,
					"content": "... ich erinnere mich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				},
				{
					"id": 718180211,
					"content": "Ha! Wie ich schon sagte, mit meinem Gedächtnis ist alles in Ordnung ... Und, und ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180212
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180212,
					"content": "Warum ruhst du dich nicht ein bisschen aus, Großvater Jiangcheng? Streng dich doch nicht unnötig an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180213
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180213,
					"content": "#{F#Reisende}{M#Reisender}, warum hilfst du Großvater Jiangcheng nicht, indem du sein Haus saubermachst? Ich leiste ihm solange Gesellschaft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180214
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180214,
					"content": "Überlass das ruhig mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180215
					]
				},
				{
					"id": 718180215,
					"content": "Danke sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180210,
					"content": "Natürlich tu ich das.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				}
			]
		},
		{
			"id": 7181803,
			"completionStepIds": [
				7181804
