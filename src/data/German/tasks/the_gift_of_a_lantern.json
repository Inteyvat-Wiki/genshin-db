			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fräulein Bai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180501,
					"content": "Ich bin dir für deine Hilfe wirklich dankbar. Wenn ich dort alleine hingegangen wäre, hätte ich sicher viele Stunden gebraucht, um alles zu erledigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180502
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180502,
					"content": "Ich wollte Großvater Jiangcheng so kurz vor dem Fest nicht alleine lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180503
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180503,
					"content": "Was ist mit dir ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180504
					]
				},
				{
					"id": 718180504,
					"content": "Ich ... Ich gehe wieder zur Mühle. Es gibt immer noch viel zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180505
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180505,
					"content": "Ich habe die Mühle von meinem verstorbenen Vater geerbt. Also habe ich meine Arbeit im Hafen von Liyue aufgegeben, um die Familientradition fortzuführen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180506
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180506,
					"content": "Ich weißt ja nicht, ob sich das normal anhört, aber es macht mich echt wehmütig, die gleichen Dinge zu tun wie er es tat und in der gleichen Umgebung zu sein wie er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180507
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180507,
					"content": "Oft fallen mir die vielen Dinge ein, die mein Vater zu mir gesagt hat, ganz besonders in dieser Zeit des Jahres ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180508
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180508,
					"content": "Oh, das hätte ich fast vergessen. Weil ich Großvater Jiangcheng im Kopf hatte, habe ich mir nun keine eigene Laterne gebastelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180509
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180509,
					"content": "Das Problem ist, dass ich nicht einmal mehr genügend Material dafür hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180510
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180510,
					"content": "#Ich habe Angst, dass ich nicht rechtzeitig mit allem fertig werde, wenn ich jetzt noch nach Material suchen gehe ... Würde es dir was ausmachen, mir ein bisschen Material zu besorgen, {F#Reisende}{M#Reisender}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180511
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718180511,
					"content": "Nicht im Geringsten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180512
					]
				},
				{
					"id": 718180512,
					"content": "Das weiß ich wirklich zu schätzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fräulein Bai"
				}
			]
		},
