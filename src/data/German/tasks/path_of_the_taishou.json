			"dialogs": [
				{
					"id": 400230101,
					"content": "#{F#Reisende}{M#Reisender}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230102
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230102,
					"content": "Ich erklärte der Tenryou-Verwaltung die Situation und zeigte ihr die offiziellen Dokumente aus diesem Jahr. Endlich waren sie überzeugt – ich und die „Mystische Onmyou-Kammer“ waren unschuldig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230103
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230103,
					"content": "Wunderbar, so kann sich der „Shiki Taishou“ auf seine Mission konzentrieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400230104,
					"content": "Ja, jetzt ist die „Mystische Onmyou-Kammer“ in ihrer ursprünglichen Form wiederhergestellt, die reine Sphäre des Kampfkunsttrainings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230105
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230105,
					"content": "Diese Sphäre kann, nachdem sie einige Zeit in Betrieb gewesen ist, keine Runenkraft mehr haben. Dann schließe ich sie ab und lasse sie langsam ihre Leistung wiederaufbauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230109
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230109,
					"content": "Eine großartige Gelegenheit! Seid ihr bereit, eine Herausforderung anzunehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230106,
						400230107
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230106,
					"content": "Ich bin bereit!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400230108
					]
				},
				{
					"id": 400230108,
					"content": "Hmmm! Das würde ich auch gerne sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400230107,
					"content": "Hingabe ist angesagt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400230108
					]
				}
			]
		}
	]
