			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752640401,
					"content": "Ihr habt den Falschen erwischt ... Mein Meister heißt Kanei, ich bin Zhaka ... den müsstet ihr holen, nicht mich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640402
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640402,
					"content": "Ich kann doch niemals solche erstklassige Plüschtiere machen wie er ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640403
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640403,
					"content": "Wurdest du etwa entführt?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752640404
					]
				},
				{
					"id": 752640404,
					"content": "Hä? Ihr seid nicht mit denen zusammen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640405
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640405,
					"content": "Natürlich nicht! Hast du nicht gesehen, wie wir die gerade verjagt haben?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752640406,
					"content": "Puh ... Dann bin ich endlich frei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640407
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640407,
					"content": "Klar, du kannst nach Hause gehen. Aber sag mal, was war hier eigentlich los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752640408,
					"content": "Keine Ahnung, wo die herkamen ... Die wollten hier gefälschte Plüschtiere verticken. Aber weil ihre Qualität voll mies war, wollten sie meinen Meister Kanei entführen, damit er für sie als Berater arbeitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640409
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640409,
					"content": "Aber irgendwas ging wohl schief – stattdessen haben sie mich geschnappt. Ich habe erst drei Tage beim Meister gelernt, wie man Farben mischt ... und konnte ihnen gar nicht helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640410
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640410,
					"content": "Wie dem auch sei, danke euch von ganzem Herzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640411
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640411,
					"content": "Azhka, gehen wir nach Hause!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640412
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640412,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azhka"
				}
			]
		}
	]
