			"dialogs": [
				{
					"id": 790590101,
					"content": "Diese verlassene Szene war ursprünglich für das Stück „Die Reise nach Osten – Der Anfang“ geplant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590102
					],
					"speakerTitle": "Notizen zur Szene"
				},
				{
					"id": 790590102,
					"content": "Die ursprüngliche Handlung drehte sich um einen Reisenden und seinen Versuch, von Fontaine nach Sumeru im Osten zu reisen, um im Daena-Palast reine Weisheit zu erlangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590103
					],
					"speakerTitle": "Notizen zur Szene"
				},
				{
					"id": 790590103,
					"content": "In dieser Szene rettet der Reisende den „Verwandlungsmeister“, der unter einem riesigen Felsen gefangen gehalten wird. Dann setzen sie ihre Reise gemeinsam fort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590104
					],
					"speakerTitle": "Notizen zur Szene"
				},
				{
					"id": 790590104,
					"content": "*seufz* Nur leider waren weder der Wassergeist, der den Reisenden spielen sollte, noch der, der die Rolle des „Verwandlungsmeisters“ übernehmen sollte, irgendwo zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590105
					],
					"speakerTitle": "Notizen zur Szene"
				},
				{
					"id": 790590105,
					"content": "Wenn nur jemand <color=#00E1FFFF>die beiden zurückholen</color> könnte, um dann ihre Probe bei dem riesigen Felsen aufzunehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						79059106
					],
					"speakerTitle": "Notizen zur Szene"
				}
			]
		},
