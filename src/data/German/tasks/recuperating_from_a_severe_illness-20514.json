					"nextDialogs": [
						205140602
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140602,
					"content": "Anna befindet sich auf einer Windmühle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140603
					]
				},
				{
					"id": 205140603,
					"content": "Windmühle?! Wie ist sie denn da hinauf geraten! Ich muss sofort zu ihr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140604
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140604,
					"content": "Was? Sie sagt, sie will ausprobieren, wie das Leben als Abenteurer so ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140605
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140605,
					"content": "Sie ist noch nicht wieder ganz gesund und da denkt sie schon an sowas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140606
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140606,
					"content": "Sie soll nur erst wieder ganz gesund werden, dann kann sie von mir aus um die ganze Welt reisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140607
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140607,
					"content": "Danke dir, ich gehe sofort zu ihr. Ihre Krankheit steht vor dem Wendepunkt, ich muss ihr das beibringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
