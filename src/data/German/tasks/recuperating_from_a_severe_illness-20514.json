			"dialogs": [
				{
					"id": 205140501,
					"content": "Ganz schön hoch ... Hier findet mich mein Bruder nie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140502
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140502,
					"content": "Was machst du denn da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140503
					]
				},
				{
					"id": 205140503,
					"content": "Ooh! Wie bist du da hochgekommen. Und auch noch ohne Geräusch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140504
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140504,
					"content": "Und wie hast du mich gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140505
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140505,
					"content": "Ah, ich weiß. Herr Cyrus muss es dir gesagt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140506
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140506,
					"content": "Er hat sich immer um meinen Bruder und mich gekümmert. Ich habe ihn im Vorbeigehen gegrüßt. Er hat auch überrascht ausgesehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140507
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140507,
					"content": "Vielleicht sollte ich mein Glück in der Abenteurergilde versuchen und ein Abenteurer werden. Das könnte gut werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140508
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140508,
					"content": "Was? Mein Bruder sucht mich? Es ist einige Zeit vergangen, nicht wahr? Ich hatte es gar nicht bemerkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140509
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140509,
					"content": "Ich verstehe. Lass mich eine Weile hierbleiben, ich gehe alleine zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
