					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205140401,
					"content": "Oh, du bist hier? Das ist ungewöhnlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140402,
					"content": "Hast du zufällig ein Mädchen gesehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140403
					]
				},
				{
					"id": 205140403,
					"content": "Ein Mädchen? Meinst du etwa Anna? Ich habe sie gesehen, sie ist gerade in Richtung Windmühle gerannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140404,
					"content": "Ich habe mir noch so gedacht, wie kann sie denn auf einmal so rennen, wo es ihr gesundheitlich doch nicht so gut geht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140405,
					"content": "Sie hat mich begrüßt und ist nur vorbeigelaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140406,
					"content": "Dieses Kind ... Hast du eine Ahnung, wann sie sich von ihrer Krankheit erholt hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
		{
