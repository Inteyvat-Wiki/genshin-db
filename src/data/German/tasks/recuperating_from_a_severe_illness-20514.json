					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205140201,
					"content": "Ganz schön hoch ... Hier findet mich mein Bruder nie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140202,
					"content": "Was machst du denn da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140203
					]
				},
				{
					"id": 205140203,
					"content": "Was! Wie bist du da hochgekommen. Und auch noch ohne Geräusch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140204,
					"content": "Nein, warte. Wie hast du mich überhaupt gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140205,
					"content": "Ich? Ich bin gerade hier herauf geklettert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140206
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140206,
					"content": "Mein Bruder sucht mich? Es ist einige Zeit vergangen, nicht wahr? Ich hatte es nicht bemerkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140207
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140207,
					"content": "Ich verstehe. Ich werde bald zurückgehen. Lass mich noch eine Weile hierbleiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2051403,
			"completionStepIds": [
				2051403
