				"points": []
			},
			"dialogs": [
				{
					"id": 205140301,
					"content": "Hast du Anna gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140302,
					"content": "Anna befindet sich auf einer Windmühle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140303
					]
				},
				{
					"id": 205140303,
					"content": "Windmühle?! Wie ist sie denn da hinauf geraten? Ich muss sofort den Ordo Favonius benachrichtigen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140304,
					"content": "Sie sagt, sie kommt gleich zurück ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140305
					]
				},
				{
					"id": 205140305,
					"content": "Ist das wirklich wahr? Wenn ihr nichts fehlt, dann bin ich beruhigt. Ich hatte mich schon zu Tode erschreckt, dass sie auf einer Windmühle sitzt und nicht mehr runterkommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140306,
					"content": "Danke dir, ich gehe sofort zu ihr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140307,
					"content": "Einfach zu wegzulaufen, wenn sie sich gerade erst erholt hat ... Ich muss ihr eine Lehre erteilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
		{
			"id": 2051404,
			"completionStepIds": [
				2051404
