				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205140101,
					"content": "Wie ist dies geschehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140103
					]
				},
				{
					"id": 205140103,
					"content": "Oh, du bist es. Und gerade rechtzeitig. Anna geht es immer besser, seitdem sie die vom Arzt verschriebene Medizin zu sich genommen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140104,
					"content": "Als es ihr nicht gut ging, brauchte sie viel Ruhe. Daher hat sie viel Zeit damit verbracht, sich zu Hause zu erholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140105,
					"content": "Jetzt, da es ihr besser geht, nervt sie mich jeden Tag damit, rauszugehen und zu spielen. Und ich kann es nicht ablehnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140106,
					"content": "Aber jetzt kann ich sie absolut nicht finden. Ich habe keine Ahnung, wo sie hin ist. Bitte hilf mir sie zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140107,
						205140110,
						205140113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140107,
					"content": "Ich ... na gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140108
					]
				},
				{
					"id": 205140108,
					"content": "Ich werde hier warten. Beeil dich bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140109,
					"content": "Ihr ging es gerade besser und jetzt flitzt sie herum. Was machen wir nur, wenn ihr etwas zustößt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140116,
					"content": "Ich habe sie schon eine Weile gesucht. Ich habe noch nicht in der Nähe der Abenteurergilde gesucht, aber ich bin an dieser Stelle mit meinem Latein am Ende ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140117,
					"content": "Du solltest deine Suche dort drüben beginnen. Wer weiß, vielleicht ist Cyrus etwas aufgefallen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140118,
					"content": "Ich hoffe, du findest sie. Sonst muss ich wieder rausgehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140110,
					"content": "Du scheinst recht fröhlich darüber zu sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140111
					]
				},
				{
					"id": 205140111,
					"content": "Fröhlich? Das ist kein Grund zum Lachen. Es geht ihr nur etwas besser und jetzt fliegt sie herum wie ein Vogel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140112
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140112,
					"content": "Wenn sie zurückkommt werd ich ihr den Marsch blasen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140113,
					"content": "Sie wird zurückkommen, sobald sie Hunger kriegt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140114
					]
				},
				{
					"id": 205140114,
					"content": "Ist meine Schwester für dich eine Art Katze? Und sie hat sich gerade erst erholt. Wie können wir sie hungrig gehen lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140115,
					"content": "Also gut. Hilf mir bitte, sie zu finden. Ich werde hier auf dich warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "Anthony"
				}
			]
		},
		{
			"id": 2051402,
			"completionStepIds": [
				2051402
			],
