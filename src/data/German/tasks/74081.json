			"dialogs": [
				{
					"id": 740813101,
					"content": "Hallo! Wegen Frau Sévigne ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740813102,
					"content": "Du erklärst Chisseray die Situation und lieferst die drei Lochstreifen ab ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740813103
					]
				},
				{
					"id": 740813103,
					"content": "Ah, so ist das also. Ich habe mir schon Sorgen um sie gemacht und mir überlegt, nach ihr zu sehen. Danke, dass ihr mir Nachricht von ihr gebracht habt ... und auch für die Lochstreifen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813104
					],
					"speakerTitle": "Chisseray"
				},
				{
					"id": 740813104,
					"content": "Unglaublich, dass die Test-Mecha von Maillardet noch in Betrieb sind und Sévigne weiterhin in einer so gefährlichen Umgebung arbeitet. Ich werde mit dem Sachbearbeiter über die Bergungen sprechen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813105
					],
					"speakerTitle": "Chisseray"
				},
				{
					"id": 740813105,
					"content": "Ich werde mich auch nach der Erstattung erkundigen ... Sévigne ist wirklich klug. Aber ob das regelkonform ist, muss der Sachbearbeiter entscheiden. Daher werde ich vorläufig die Kosten übernehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813106
					],
					"speakerTitle": "Chisseray"
				},
				{
					"id": 740813106,
					"content": "Auf jeden Fall danke ich euch für die Mithilfe. Hier ist euer Lohn für die Erfüllung des Auftrags.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chisseray"
				}
