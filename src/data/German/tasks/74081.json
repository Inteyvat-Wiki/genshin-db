			},
			"dialogs": [
				{
					"id": 740812401,
					"content": "Es sind diese Lochstreifen, die wir zurückholen sollen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812402,
					"content": "Zeige Sévigne die Lochstreifen ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740812403
					]
				},
				{
					"id": 740812403,
					"content": "Genau das sind sie. Ihr seid so effektiv. Überhaupt keine Verzögerungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812404
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812404,
					"content": "Eine so einfache Arbeit. Die ist husch-husch erledigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812405,
					"content": "Ihr seid wirklich fantastisch. Es ist keine Übertreibung zu sagen, dass einige meiner Kollegen einen ganzen Tag damit verbringen müssen, ein Material zu finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812406
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812406,
					"content": "So sei es. Bitte liefert diese Lochstreifen an Chisseray.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812407
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812407,
					"content": "Und sagt ihr, dass ich für eine Weile nicht zurückkehren werde. Oh, und bittet sie, sich mit Maillardet in Verbindung zu setzen, um die Test-Mecha schnellstmöglich zurückzuholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812408
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812408,
					"content": "#Klar. {NICKNAME}, dann gehen wir zurück?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812409,
					"content": "Ah, das ist nicht nötig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812410
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812410,
					"content": "Ihr solltet tauchen können, oder? Eigentlich gibt es einen Wasserweg, um hier rauszukommen, aber er wurde kurzzeitig geschlossen, damit niemand hineinfällt. Ich werde euch helfen, den Zugang zu öffnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812411
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812411,
					"content": "#Toll! {NICKNAME}, lass uns auf dem Wasserweg zurückkehren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812412,
					"content": "Die Station, die den Zugang öffnet, befindet sich im Innenraum. Ich gehe dann mal. Ihr werdet kein Problem haben, alleine zurechtzukommen, oder? Ihr verirrt euch doch nicht, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812413
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740812413,
					"content": "#Unterschätz uns nicht! Paimon ist die beste Reiseführerin von Teyvat, wie könnte {NICKNAME} sich da verlaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812414,
					"content": "So verlässlich. Also bitte, liefert die Nachricht und die Lochstreifen. Dann verabschieden wir uns hier einfach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sévigne"
				}
			]
		},
