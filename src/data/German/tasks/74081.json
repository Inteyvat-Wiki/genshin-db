					},
					{
						"sceneId": 3,
						"position": [
							4411.186,
							372.68,
							3834.401
						],
						"pointId": 6386
					}
				]
			},
			"dialogs": [
				{
					"id": 740811701,
					"content": "Eh ... Haben ... Haben wir etwas Schlimmes getan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811702,
					"content": "Komisch, gerade fühlte ich ein Schütteln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811703,
						740811704
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811703,
					"content": "Ich habe es auch gespürt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				},
				{
					"id": 740811705,
					"content": "Hm ... Wahrscheinlich, weil wir gerade den oberen Apparat berührt haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811706,
					"content": "Die Tür hier war vorher verschlossen, oder? Ich erinnere mich, dass man extra ein paar Uhrwerk-Mecha aufgestellt hat, um sie zu bewachen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811707,
						740811708
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811707,
					"content": "Ich habe sie „sich ausruhen“ lassen und die Tür geöffnet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811709,
					"content": "Wir ... Wir hatten keine andere Wahl! Sie haben uns zuerst angegriffen. Wir haben uns nur selbst geschützt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811710,
					"content": "Maillardets Test-Mecha ... sollten doch gestoppt sein, oder? Schließlich war er kaum noch hierher zurückgekehrt, seit er in Erinnyes einen guten Ort gefunden hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811711
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811711,
					"content": "Aber das ist kein Wunder. Wer möchte zurück in ein feuchtes und schäbiges Labor, wenn man seine Forschung den Menschen an einem schönen Ort wie der Gartenbühne vorführen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811712
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811712,
					"content": "Nach dem Rücktritt von Herrn Bossuet waren alle im Forschungsinstitut Fontaine verstreut wie das Forschungsmaterial hier. Selbst ein Sofa ist nicht mehr übrig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811713
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811713,
					"content": "Nur noch die Test-Mecha blieben hier und warteten auf denjenigen, der nicht zurückkehren würde. Eigentlich hatten sie hier nur gestanden, und das war für sie in Ordnung. Aber jetzt sind sie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811714
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811714,
					"content": "Schau mal, die sind so kaputt, dass sogar die Uhrwerke herausgefallen sind. Wenn Maillardet das wüsste ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811715,
						740811716
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811715,
					"content": "Ich war das. Tut mir leid.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811718
					]
				},
				{
					"id": 740811718,
					"content": "Entschuldigung ... sind ... sind diese Test-Mecha teuer? Wenn man sie bezahlen muss ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811719,
					"content": "Du brauchst nicht nervös zu sein. Ich würde meinen, Maillardet würde sich totlachen, wenn er das wüsste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811720
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811720,
					"content": "Denn schließlich hat er selbst oft die Tänze der Test-Mecha unterbrochen. Nachdem er von ihnen niedergestoßen wurde, saß er auf dem Boden und lachte lauthals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811721
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811721,
					"content": "Ach ja, ich habe mich noch nicht vorgestellt. Ich bin Forscherin am Forschungsinstitut Fontaine. Ihr könnt mich Sévigne nennen, und wer seid ihr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811722
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811722,
					"content": "#Wir sind Paimon und {NICKNAME}. Wir sind ... ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811723,
						740811725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811723,
					"content": "Wir sind nur Passanten, die absolut keine anderen Absichten haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811724
					]
				},
				{
					"id": 740811724,
					"content": "Genau! Wir sind nur Passanten. Wir sind bestimmt nicht wegen des Schatzes hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811726,
					"content": "Ah, ihr wollt also einen Ruinentourismus mit Schatzsuche machen? Dann seid ihr hier am falschen Ort. Dieser Ort sieht zwar aus wie eine Ruine ... Nein, es ist tatsächlich eine Ruine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811727
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811727,
					"content": "Aber es ist noch nicht einer der von Ruinentourismus empfohlenen Orte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811728
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811728,
					"content": "Na, dann gehen wir jetzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811729,
					"content": "... Moment, kennt ihr das Neue Forschungsinstitut Fontaine? Wenn ihr gehen wollt, bitte tut mir einen Gefallen. Könnt ihr zum Neuen Forschungsinstitut Fontaine gehen und Chisseray finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811730,
						740811731
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811730,
					"content": "Aber wir gehen nicht zum Neuen Forschungsinstitut Fontaine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811732,
					"content": "Wie kann man das ändern? Ich muss noch arbeiten, und Maillardets Test-Mecha sind kaputt, also muss jemand kommen und sie bald abholen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811733
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811733,
					"content": "#Hmm ... {NICKNAME}, helfen wir ihr doch einfach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811734,
					"content": "Großartig! Wenn ihr euch bereit erklärt habt, zu helfen, dann könnt ihr auch gern die Lochstreifen zurückholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811735,
						740811736
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811735,
					"content": "Wenn ich das gewusst hätte, hätten wir die Apparate draußen nicht betätigt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811746
					]
				},
				{
					"id": 740811746,
					"content": "Sag das nicht, das wird ein Kinderspiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811737
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811737,
					"content": "Unter dem Deckmantel der Bergung von Forschungsmaterial würden die Kosten für diesen Auftrag erstattet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811738
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811738,
					"content": "Oh? Ist das wirklich kein Problem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811739,
					"content": "Immerhin hat es bei der Forschung geholfen, es macht also Sinn. Natürlich ist das kein Problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811740
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811740,
					"content": "Und wenn es wirklich nicht in Ordnung ist, wird der Sachbearbeiter es ablehnen. Dann muss ich für die Kosten des Auftrags selbst aufkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811741
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811741,
					"content": "Tut ihr das oft?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811742
					]
				},
				{
					"id": 740811742,
					"content": "Ich selbst tue das nicht oft. Ich weiß nicht, wie es anderen geht. Ich habe schon einiges darüber gehört, aber ... na ja, das ist nichts, was ich anderen erzählen muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811743
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811743,
					"content": "Es gibt drei Lochstreifen, die noch zurückgeholt werden müssen. Um genau zu sein, gibt es nur noch drei in den Bücherregalen. Also sind sie bestimmt leicht zu finden. Es wäre toll, wenn ihr das machen könntet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811744
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811744,
					"content": "In der Zwischenzeit muss ich die Test-Mecha noch einmal überprüfen, schließlich sind sie schon lange nicht mehr gewartet worden ... Es wäre schlecht, wenn sie außer Kontrolle geraten würden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811745
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811745,
					"content": "Gut, dann kommen wir wieder, wenn wir die Lochstreifen gefunden haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811736,
					"content": "Kein Problem, ich kümmere mich darum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811737
					]
				},
				{
					"id": 740811731,
					"content": "Wir müssen noch andere Schätze finden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811725,
					"content": "Gibt es hier Schätze?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811726
					]
				},
				{
					"id": 740811716,
					"content": "Wurde eine Verbesserung der Test-Mecha in Betracht gezogen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811717
					]
				},
				{
					"id": 740811717,
					"content": "Maillardet hat es getan. Vielleicht wird das Endprodukt deine Erwartungen an die Stärke erfüllen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811718
					],
					"speakerTitle": "Sévigne"
				},
				{
					"id": 740811708,
					"content": "Ja, seltsam. Wie hat sich die Tür geöffnet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811704,
					"content": "Könnte es sein, dass du dich irrst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				}
			]
		},
