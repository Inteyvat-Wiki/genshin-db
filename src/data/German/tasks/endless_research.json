			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100101,
					"content": "Argh. Wie soll ich so meine Abschlussarbeit schreiben? Was soll ich bloß tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100102
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100102,
					"content": "Alles in Ordnung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100103
					]
				},
				{
					"id": 718100103,
					"content": "Ich ... was? Oh! Du bist es! Erinnerst du dich noch an mich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100104
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100104,
					"content": "Ich bin, äh, die Person, die du aus dem Schatzräuberkäfig im Lingju-Pass befreit hast. Danke nochmal für die Rettung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100105
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100105,
					"content": "Was führt dich her?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100106
					]
				},
				{
					"id": 718100106,
					"content": "Tja, äh, nach deiner Rettung ging ich zu Soraya im Gasthaus Wangshu. Es war reiner Zufall, dass ich sie gefunden habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100107
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100107,
					"content": "Soraya ist wirklich gütig ... Sie gab mir nicht nur eine Mahlzeit, sondern half mir auch, meine Notizen zu sortieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100108
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100108,
					"content": "Aber ... als wir damit fertig waren, meinte sie, dass meine vorigen Arbeiten an der Akademie sich bereits um dasselbe Thema drehten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100109
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100109,
					"content": "Wenn meine Abschlussarbeit nicht absolut überragend wird, falle ich bestimmt durch ... Sie meinte, ich solle es mit einer neuen Perspektive versuchen. Ich könnte zum Beispiel über die Elemente schreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100110
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100110,
					"content": "Aber da ich kein Göttliches Auge besitze und die Elemente nicht nutzen kann, weiß ich nicht, wo ich anfangen soll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100111
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100111,
					"content": "Darum blieb mir nichts anderes übrig, als in die Stadt zu gehen und dort nach Forschungsmaterial zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100112
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100112,
					"content": "Warte ... Als du mich damals gerettet hast, war dein Kampfstil einzigartig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100113
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100113,
					"content": "Verfügst du vielleicht über ein Göttliches Auge?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100114
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100114,
					"content": "Nein, tue ich nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100115
					]
				},
				{
					"id": 718100115,
					"content": "Wie? Du kannst ohne Göttliches Auge so kämpfen? Wie kann das sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100116
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100116,
					"content": "Na ja, spielt keine Rolle. Ist sicher eine lange Geschichte ... So oder so muss ich dich um etwas bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100117
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100117,
					"content": "Würdest du mir deinen Kampfstil demonstrieren? Vielleicht fällt mir dabei etwas auf, das mir für meine Abschlussarbeit helfen könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100118
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100118,
					"content": "Bitte hilf mir! Wenn ich diese Arbeit nicht abschließe, kann ich mich in der Akademie nie wieder blicken lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100119,
						718100122
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100119,
					"content": "Klar, ich helfe dir ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100120
					]
				},
				{
					"id": 718100120,
					"content": "Vielen herzlichen Dank! Dann lass uns nach draußen gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100121
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100121,
					"content": "Hier in der Gegend habe ich eine Gruppe von Hilichurlen gesehen. Kämpf gegen sie, dann sehe ich deinen Kampfstil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100122,
					"content": "Ist es in der Akademie unheimlich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100123
					]
				},
				{
					"id": 718100123,
					"content": "Oh, sie ist wahnsinnig unheimlich. Ich wache jedes Mal schluchzend auf, wenn ich davon träume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100124
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100124,
					"content": "Lieber würde ich zurück in den Schatzräuberkäfig, statt noch einen Entwurf oder eine Abschlussarbeit vorzulegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100125
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100125,
					"content": "Aber genug von der Akademie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100126
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100126,
					"content": "Hier in der Gegend habe ich eine Gruppe von Hilichurlen gesehen. Kämpf gegen sie, dann sehe ich deinen Kampfstil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		},
		{
			"id": 7181002,
			"completionStepIds": [
				7181003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181003",
							"2"
						],
						"stepId": 7181003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100201,
					"content": "Ooh ... dein Kampfstil ist wirklich einzigartig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100202
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100202,
					"content": "Oh, richtig. Ich habe gehört, dass Träger des Göttlichen Auges die Präsenz der Elemente spüren können. Ich glaube, das nennt sich Elementarblick ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100203
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100203,
					"content": "Obwohl du kein Göttliches Auge besitzt, kannst du doch Elementarenergie nutzen – also solltest du eigentlich besitzen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100204
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100204,
					"content": "In der Nähe tummeln sich einige Schleime. Würdest du mir deinen Elementarblick noch mal demonstrieren und sie finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		},
		{
			"id": 7181003,
			"completionStepIds": [
				7181009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181009",
							"2"
						],
						"stepId": 7181009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100301,
					"content": "Haha, als jemand, der kein Göttliches Auge besitzt, ist mir gar nicht aufgefallen, dass du den Elementarblick nutzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100302
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100302,
					"content": "Ich schätze, dass können wohl nur andere Träger des Göttlichen Auges.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100303
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100303,
					"content": "Trotzdem danke für deine Präsentationen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100304
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100304,
					"content": "*seufz* Ich wünschte, ich hätte ein Göttliches Auge ... Mit Elektro-Kraft wäre am besten. Das sähe toll aus und ich könnte mich damit verteidigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100305
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100305,
					"content": "Hmm, nein, ein Göttliches Auge der Elektro-Kraft lässt sich wohl am schwersten erreichen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100306
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100306,
					"content": "Du schaffst das sicher, wenn du dich anstrengst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100307
					]
				},
				{
					"id": 718100307,
					"content": "Nein, ausgeschlossen, wie sehr du dich auch anstrengst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100308
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100308,
					"content": "Warte. Weißt du was? Anscheinend hat seit einem Jahr niemand mehr ein solches Göttliches Auge erlangt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100309
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100309,
					"content": "Es heißt, die Akademie forscht bereits seit einiger Zeit zu diesem Problem. Nun ist sie zu dem Schluss gelangt, dass der Elektro-Archon nicht gewillt ist, den Sterblichen diesese Göttliche Auge zu gewähren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100310
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100310,
					"content": "Es heißt ebenfalls, dass Inazumas Elektro-Archon ein „Augenhatz-Dekret“ erlassen hat, das vorsieht, sämtliche Göttlichen Augen von ihren Trägern in ganz Inazuma zu konfiszieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100311
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100311,
					"content": "Wer sich weigert und sein Göttliches Auge vorenthält, soll hart bestraft werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100312
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100312,
					"content": "Früher wollte ich nach Inazuma reisen, um eine Arbeit über dieses Dekret zu schreiben, doch das war mir zu gefährlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100313
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100313,
					"content": "Dir passiert schon nichts. Du besitzt kein Göttliches Auge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100314
					]
				},
				{
					"id": 718100314,
					"content": "He, sag das nicht! Denk mal nach, wenn die Leute mit einem Göttlichen Auge darunter leiden, sind dann die ohne nicht noch schlechter dran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100315
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100315,
					"content": "Ich sollte einfach hier in Liyue bleiben und in Frieden meine Abschlussarbeit vollenden. Dann werde ich meine Erkenntnisse der Akademie in Sumeru melden. Wenn ich noch länger damit warte, nimmt das kein Ende ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100316
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100316,
					"content": "Ah, ich möchte dir für deine Hilfe noch danken. Nimm dies als Zeichen meiner Wertschätzung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100317
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100317,
					"content": "Diesmal schließe ich meine Abschlussarbeit sicher ab!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		}
	]
}