			"dialogs": [
				{
					"id": 190785201,
					"content": "Eine Untersuchung von den Matra bestätigte, dass Alkami, der Leiter einer Ausbildungsstätte, viele Familien angestiftet hatte, betrügerische Kredite zu exorbitanten Zinsen aufzunehmen, um riesige Gewinne zu erzielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785202
					],
					"speakerTitle": "Anschlagbrett"
				},
				{
					"id": 190785202,
					"content": "Diese Ausbildungsstätte ist ab sofort geschlossen. Das gesamte wiedererlangte Geld wird den Opfern nach Bestätigung durch Matra zurückerstattet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anschlagbrett"
