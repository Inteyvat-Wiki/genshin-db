						],
						"stepId": 1907808,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Adan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780401,
					"content": "Hallo, was gibt’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780402,
						190780403
					],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780402,
					"content": "Kennst du Alkami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				},
				{
					"id": 190780404,
					"content": "Alkami? Der kürzlich sehr berühmte reiche Mann? Vor einiger Zeit bestellte er bei mir ein Möbelset. Dieser Typ ist ziemlich großzügig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780405
					],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780405,
					"content": "Soweit ich weiß, war er früher ein bekannter Architekt und hat ein Vermögen gemacht. Jetzt betreibt er eine Ausbildungsstätte. Und er zögert nicht, seine Erfahrungen beim Geldverdienen mit anderen zu teilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780406
					],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780406,
					"content": "Wären die Studiengebühren nicht so hoch, würde ich mein Kind auch anmelden. Architekt scheint ein profitabler Beruf zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780403,
					"content": "Ich möchte fragen, ob du irgendetwas über Alkami weißt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				}
			]
		},
		{
			"id": 1907808,
			"completionStepIds": [
				1907808
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
