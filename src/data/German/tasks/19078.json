						],
						"stepId": 1907808,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aabid",
					"Adil"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780801,
					"content": "Hast du gehört? Alkami hat Kaveh als Ausbilder rekrutiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780802
					],
					"speakerTitle": "Aabid"
				},
				{
					"id": 190780802,
					"content": "Ich wette, sein Geschäft läuft jetzt sogar noch besser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780803
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780803,
					"content": "Da ist man wirklich etwas neidisch. Ehrlich gesagt war Alkami nie ein guter Architekt. Wenn wir nur über professionelle Fähigkeiten sprechen, würde niemand für einen Unterricht bei ihm bezahlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780804
					],
					"speakerTitle": "Aabid"
				},
				{
					"id": 190780804,
					"content": "Na ja, weil er gut werben kann ... Die Akademie nimmt nur diejenigen auf, die die Aufnahmeprüfung bestehen, daher haben nur wenige die Chance, Architektur an der Akademie zu studieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780805
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780805,
					"content": "Diejenigen, die die Aufnahmeprüfung nicht bestehen können oder einfach nur schnell in die Branche einsteigen möchten, strömen natürlich in seine Ausbildungsstätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780806
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780806,
					"content": "Er ist wirklich gut im Geschäft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aabid"
				}
			]
		},
		{
			"id": 1907850,
