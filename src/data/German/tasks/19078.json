				"objectNames": [
					"Uzayr",
					"Waiz",
					"Tanisha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190785001,
					"content": "Herr Kaveh sah sehr wütend aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785002
					],
					"speakerTitle": "Uzayr"
				},
				{
					"id": 190785002,
					"content": "Na und? Ich wette, er macht sich nur Sorgen, dass wir in Zukunft seine Konkurrenten sein werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785003
					],
					"speakerTitle": "Waiz"
				},
				{
					"id": 190785003,
					"content": "A... Aber das kann es doch nicht sein, oder? Herr Kaveh ist doch sehr berühmt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785004
					],
					"speakerTitle": "Tanisha"
				},
				{
					"id": 190785004,
					"content": "Wer weiß? Mein Vater sagte, je berühmter jemand ist, desto arroganter und sturer wird er. Menschen, die so zugänglich sind wie Herr Alkami, sind selten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Waiz"
				}
			]
		},
		{
