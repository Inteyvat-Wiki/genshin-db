			},
			"dialogs": [
				{
					"id": 722610101,
					"content": "He ... Fürst der fließenden Wasser und aufgetürmten Berge ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610102,
					"content": "He ... Wasserberg ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610103
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610104,
					"content": "Er scheint nicht da zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610105,
					"content": "Haben wir Respekt vor dem Adepten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610106
					]
				},
				{
					"id": 722610106,
					"content": "Paimon, was ist ein Adept?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610107
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610107,
					"content": "Nun ... Paimon denkt, das ist eine ganz besondere Person oder ein Tier, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610108,
					"content": "Wie Kichiboushi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610109
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610109,
					"content": "Nein, nein, nein! Ich sollte sagen, dass er magische Kräfte hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610110,
					"content": "Auch mit Bumm-Bumm? Dann bin ich auch ein Adept ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610111
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610111,
					"content": "Nun ... die Adepten sind viel älter und majestätischer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610112,
					"content": "Na gut, dann ist Kichiboushi kein Adept, aber Ioroi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610113
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610113,
					"content": "Wie soll Paimon das erklären ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610114,
					"content": "Die Adepten haben geschworen, Liyue zu beschützen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610115
					]
				},
				{
					"id": 722610115,
					"content": "Ah. Ioroi bewacht den Chinju-Wald, er ist also kein Adept.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610116
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610116,
					"content": "Es hat zwar keinen Sinn, aber es ist gut, wenn man es so auseinanderhalten kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610117,
					"content": "Aber bei der seltenen Gelegenheit, dass die Behausung eines Adepten vor uns steht, sollten wir ein Foto von Kichiboushi hier machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610118,
					"content": "Kichiboushi, bleib da für ein Foto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610119
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610119,
					"content": "Kichiboushi ist brav!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7226102,
			"completionStepIds": [
				7226104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226104",
							"2"
						],
						"stepId": 7226104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"„Kichiboushi“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722610201,
					"content": "Sehr gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610202,
					"content": "Kichiboushi sieht gut aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610203
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610203,
					"content": "Dieser Junge, ohne jegliche Bescheidenheit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610204,
					"content": "Übrigens, Paimon. Welche Zaubersprüche haben die Adepten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610205
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610205,
					"content": "Adepten sind sehr mächtig! Aber um ein konkretes Beispiel zu nennen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610206,
					"content": "Diese Bernsteine hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610207
					]
				},
				{
					"id": 722610207,
					"content": "Was ist ein Bernstein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610208
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610208,
					"content": "Hmm! Paimon erinnert sich, dass es hieß, dass der Fürst der fließenden Wasser und aufgetürmten Berge Blumen hatte, die Bernstein produzieren und alle eindringenden bösen Dinge darin einschließen konnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610209,
					"content": "Wasserberg ist super. Bewacht Liyue und fängt das Böse ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610210
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610210,
					"content": "Vor langer Zeit kamen die sehr, sehr bösen Vier Oni von Ogata in den Wald und tyrannisierten viele Bakedanuki. Ioroi verwandelte sich in einen Beamten und gab ihnen Bakedanuki-Mähler zu essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610211
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610211,
					"content": "Später wurden sie zusammen mit dem Otogi-König in Bilder geworfen und versiegelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610212
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610212,
					"content": "Es gibt da also so eine Geschichte. Kein Wunder, dass Ioroi, als er vom Bild von Kichiboushi sah, entsetzt war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610213,
					"content": "Ioroi ist kein Adept und beschützt Liyue nicht. Aber Ioroi schützt den Wald und die Tanuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610214
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610214,
					"content": "Verschiedene Wesen beschützen verschiedene Sachen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610215
					]
				},
				{
					"id": 722610215,
					"content": "Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610216
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610216,
					"content": "Kichiboushi wird es verstehen, wenn er erwachsen ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610217
					]
				},
				{
					"id": 722610217,
					"content": "Also muss Kichiboushi hart trainieren, um ein erstaunlicher Bakedanuki zu werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610218,
					"content": "Seht her! Ja, natürlich. Der berühmte Bakedanuki Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610219
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610219,
					"content": "Paimon ist gespannt, wie Ioroi aussah, als er nicht versiegelt wurde! Er sah bestimmt gut aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610220,
					"content": "Ah, da fällt Paimon plötzlich ein, dass einige der Schatzräuber schon einmal in Bernstein versiegelt wurden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610221,
					"content": "Wir wurden auch als „Gesandte der Adepten“ behandelt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610222
					]
				},
				{
					"id": 722610222,
					"content": "Es fühlt sich an, als wäre es schon vor einer Ewigkeit passiert ... aber es scheint nicht so lange her zu sein, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610223,
					"content": "Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610224
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610224,
					"content": "Ähem. Nachdem wir in Liyue angekommen waren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610225,
					"content": "#„Das ist die jährliche Einladung zur Adeptenzeremonie. Ich, {NICKNAME} sollte in der Lage sein, viel und gut zu essen. Auf geht’s, Paimon!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610226,
					"content": "„Und die Tribute! Paimon wird sofort hinfliegen!“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610227
					]
				},
				{
					"id": 722610227,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610228
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610228,
					"content": "Sag nichts Falsches ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610229
					]
				},
				{
					"id": 722610229,
					"content": "Ist ja schon gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610230,
					"content": "Du erzählst einige der Abenteuer in Liyue in relativ einfacher Sprache.\\nDu hörst an dem Punkt auf, an dem du die Adepten in Minlin aufgesucht hast.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722610231
					]
				},
				{
					"id": 722610231,
					"content": "#Als Nächstes geht Paimon mit {NICKNAME} zum Abendessen in den „Liuli-Pavillon“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610232,
					"content": "Wasserberg ist fantastisch und Wolkenwind auch! Sie können sogar ein Haus bauen, das sich bewegt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610233
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610233,
					"content": "Liuliu, ach, die Fürstin der stehenden Wolken und des stillen Windes scheint auch gern zu essen! Damals mussten wir viel kochen, um sie zu treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610234,
					"content": "So gefräßig, wie Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610235,
						722610236
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610235,
					"content": "Das ist in der Tat wie bei Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610237
					]
				},
				{
					"id": 722610237,
					"content": "He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610238,
					"content": "Paimon ist ein Adept? Paimon ist so fantastisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610239
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610239,
					"content": "Oooh, haha, so viele gemischte Gefühle. Es fühlt sich so komisch an, dann wieder von Kichiboushi gelobt zu werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610240,
					"content": "Aber Paimon ist kein Adept!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610241,
					"content": "Ich will mit Adepten spielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610242
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610242,
					"content": "Adepten tauchen normalerweise nicht zufällig auf ... aber es ist schön, sich einfach so umzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610243,
					"content": "Los, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610236,
					"content": "Und fliegen kann sie auch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610237
					]
				}
			]
		},
		{
			"id": 7226104,
			"completionStepIds": [
				7226107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226107",
							"2"
						],
						"stepId": 7226107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"„Kichiboushi“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722610401,
					"content": "Zum Glück haben wir es gefunden ... Kichiboushi, du bist doch nicht verletzt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610402,
					"content": "Uääh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610403
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610403,
					"content": "Es ist gut, dass es dir gut geht. Aber lauf nicht wieder weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610404,
						722610408,
						722610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610404,
					"content": "Paimon sieht aus wie eine große Schwester.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610405
					]
				},
				{
					"id": 722610405,
					"content": "Paimon ist älter als Kichiboushi, also ist Paimon natürlich die ältere Schwester.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610406,
					"content": "Kann man nicht erkennen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610407
					]
				},
				{
					"id": 722610407,
					"content": "He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610412,
					"content": "#Uii, vielen Dank, {NICKNAME}, und vielen Dank an Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610413
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610413,
					"content": "Ich dachte, dass ich wieder versiegelt worden wäre und hatte Angst. Aber ich konnte hören, wie Paimon nach mir rief.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610414
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610414,
					"content": "Ah, Ioroi sagte, dass auch einige kleine Tanuki versiegelt wurden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610415,
					"content": "Es ist so unheimlich im Bernstein. Es war alles schwarz, man konnte nichts sehen, nicht sprechen, sich nicht bewegen und Bumm-Bumm machen. Es war, als würde ich zu Stein werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610416
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610416,
					"content": "Auch wenn sich Ioroi in Stein verwandelt, ist er immer noch sehr mächtig und kann sprechen und sehen. Aber trotzdem kann er sich nicht bewegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610417,
						722610420
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610417,
					"content": "Kichiboushi will Ioroi helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610418
					]
				},
				{
					"id": 722610418,
					"content": "Hmmm. Und dann auch den anderen Bakedanuki helfen, die noch im Felsen sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610419
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610419,
					"content": "Aber jetzt, da wir bei dir sind, werden wir nicht zulassen, dass du versiegelt wirst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610422,
					"content": "Juhu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610423
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610423,
					"content": "Allerdings ist es nur gut, wenn Kichiboushi brav ist und nicht zu viel Unfug treibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610424,
					"content": "Ja, ich verstehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610425
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610425,
					"content": "Guter Junge, guter Junge. Nun, das ist genug für heute, oder? Kichiboushi muss auch müde sein, es ist Zeit, sich auszuruhen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610426,
					"content": "Kichiboushi ist nicht müde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610427
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610427,
					"content": "Ups, das ist heftig. Wenn Kichiboushi nicht hört, wird Paimon nicht wissen, wo er danach üben soll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610428,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610429
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722610429,
					"content": "Wenn auch widerwillig, so scheint es doch, dass Kichiboushi müde ist ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722610430
					]
				},
				{
					"id": 722610430,
					"content": "Leider ist Kichiboushi wirklich wie ein Kind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610431,
					"content": "Aber Paimon wird immer geschickter im Umgang mit kleinen Kindern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610432
					]
				},
				{
					"id": 722610432,
					"content": "Ist das so? Schließlich ist Paimon schon so lange mit dir unterwegs, hehehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610433,
						722610435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610433,
					"content": "Bin ich ein Kind?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610434
					]
				},
				{
					"id": 722610434,
					"content": "Nein! Haben wir nicht mit vielen Kindern zusammen gespielt? Wir haben mit vielen Kindern gespielt, wie Changchang, der kleinen Ming ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610437,
					"content": "Es gibt wirklich viel zu lernen, wenn man mit dir reist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610438
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610438,
					"content": "Nun, was ich dieses Mal gelernt habe ist ... Bakedanuki und Adepten kommen nicht immer miteinander aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610439,
					"content": "Denken wir nun über unser nächstes Ziel nach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610435,
					"content": "Es stimmt, dass wir uns gemeinsam um viele kleine Kinder gekümmert haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610436
					]
				},
				{
					"id": 722610436,
					"content": "Ja. Wir haben mit vielen Kindern gespielt, wie Changchang, der kleinen Ming ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610420,
					"content": "Wir werden Kichiboushi beschützen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610421
					]
				},
				{
					"id": 722610421,
					"content": "Wir werden nicht zulassen, dass Kichiboushi versiegelt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610408,
					"content": "Paimon sieht aus wie eine Mama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610409
					]
				},
				{
					"id": 722610409,
					"content": "He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610410,
					"content": "Paimon sieht aus wie eine Oma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610411
					]
				},
				{
					"id": 722610411,
					"content": "#„{NICKNAME}, iss noch etwas mehr. Du bist noch im Wachstum. Wie kannst du also größer werden, wenn du nicht mehr isst?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610412
					],
					"speakerTitle": "Paimon"
				}
			]
