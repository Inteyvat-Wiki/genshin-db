			},
			"dialogs": [
				{
					"id": 741411101,
					"content": "Oh, du bist zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411102,
					"content": "Wie lange war ich weg?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411103
					]
				},
				{
					"id": 741411103,
					"content": "Hm, nur ein Wimpernschlag ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411104,
					"content": "Wenn es nur ein Wimpernschlag für dich war ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411105
					]
				},
				{
					"id": 741411105,
					"content": "Was denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411106,
					"content": "Nichts. Dort drinnen ist es wirklich gefährlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411107
					]
				},
				{
					"id": 741411107,
					"content": "Ach so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411108,
					"content": "Übrigens, warum ist Canotila noch nicht zurückgekehrt? Sie ist doch nicht zum Hof von Fontaine gegangen, um Gendarmin zu werden, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411109,
					"content": "... Lass uns nächstes Mal wieder kommen. Mir ist ein bisschen schwindelig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411110
					]
				},
				{
					"id": 741411110,
					"content": "Oh, verstanden. Wollen wir dann nicht etwas essen gehen? Du hast Paimon solche Sorgen bereitet, dass Paimon nun am Verhungern ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411111,
					"content": "Meintest du nicht, dass es nur ein Wimpernschlag war?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411112
					]
				},
				{
					"id": 741411112,
					"content": "Paimon hat sich große, große Sorgen gemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
