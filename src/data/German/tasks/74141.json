					"id": 741410803,
					"content": "Wer ist da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410804
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410804,
					"content": "... Ach, du bist es. Ich erinnere mich an dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410805
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410805,
					"content": "Was bringt dich hierher?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410806
					]
				},
				{
					"id": 741410806,
					"content": "Das wollte ich dich gerade auch fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410807
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410807,
					"content": "Nichts, ich dachte nur ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410808
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410808,
					"content": "#Du bist {NICKNAME}, nicht wahr? Das kleine weiße Ding an deiner Seite ... Wie heißt sie nochmal? Wieso ist sie nicht hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410809,
						741410811
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410809,
					"content": "Paimon wartet draußen auf mich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410810
					]
				},
				{
					"id": 741410810,
					"content": "Ist das ihr Name? Egal, das ist unwichtig. Du bist eine gute Person und Paimon ist es auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410812
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410812,
					"content": "Ich bin hier, um nach etwas sehr Wichtigem zu suchen. Weißt du, wonach ich suche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410813
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410813,
					"content": "Vergiss es, tu so, als hätte ich nicht gefragt. Wieso bist du überhaupt hier? Es ist hier sehr gefährlich, du solltest sofort verschwinden. Es gab einst Leute, die wegen der Prüfung hierherkamen, danach waren sie verloren, und ihre Gehirne haben sich zu Brei verwandelt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410814
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410814,
					"content": "Ich erinnere mich, dass wir beide früher wirklich großartige Dinge vollbracht haben. Das ist das einzige, worauf ich in meinem Leben stolz sein kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410815
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410815,
					"content": "Du meinst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410816,
						741410818
					]
				},
				{
					"id": 741410816,
					"content": "Den Sieg über Narzissenkreuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410817
					]
				},
				{
					"id": 741410817,
					"content": "Was ist dem Meister widerfahren? Bist du auch ein Mitglied des Narzissenkreuz-Vereins? Oder ... gehörst du zu Guillotin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410820
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410820,
					"content": "Ach, goldener Schmetterling. Farbe, die wie Sonnenstrahlen glitzert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410821
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410821,
					"content": "Wenn man in solch einem Licht leben darf, wird alles ... alles ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410818,
					"content": "Lanoires Rettung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410819
					]
				},
				{
					"id": 741410819,
					"content": "Ich erinnere mich. Genau, wir sind mit Lanoire aus dem Unterwassergefängnis geflüchtet. Kinder sollten nicht an einem solchen Ort leben. Sie sollte unter der Sonne, inmitten von Blumen leben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410820
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410811,
					"content": "Geht es dir gut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410812
					]
				}
			]
		},
		{
			"id": 7414110,
			"completionStepIds": [
				7414110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7414110",
							"2"
						],
						"stepId": 7414110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Caterpillar"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2383.938,
							-252.923,
							4841.653
						],
						"pointId": 6293
					},
					{
						"sceneId": 3,
						"position": [
							2386.312,
							-252.555,
							4841.593
						],
						"pointId": 6803
					},
					{
						"sceneId": 3,
						"position": [
							2385.29,
							-252.747,
							4843.136
						],
						"pointId": 6835
					}
				]
			},
			"dialogs": [
				{
					"id": 741411001,
					"content": "... Ist das so? Na dann macht es die Sache einfacher. Wie heißt du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411002
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411002,
					"content": "Caterpillar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411003
					]
				},
				{
					"id": 741411003,
					"content": "#{NICKNAME}, ich hätte nicht erwartet, dich hier anzutreffen. Ist Paimon nicht bei dir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411004
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411004,
					"content": "Warte, du bist doch wohl nicht auch so ein Monster, das sich in jemanden verwandelt hat, den ich kenne, um mich an der Nase herumzuführen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411005
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411005,
					"content": "Wir sind uns erst vor Kurzem begegnet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411006
					]
				},
				{
					"id": 741411006,
					"content": "... Ist das so? Mir kommt es wie eine Ewigkeit vor, seit wir uns verabschiedet haben. Egal, möglicherweise werde ich alt und kann mich zunehmend an immer weniger Dinge erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411007
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411007,
					"content": "... Bist du wirklich kein Monster?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411008
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411008,
					"content": "Kannst du dich noch daran erinnern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411009,
						741411010
					]
				},
				{
					"id": 741411009,
					"content": "An den Garten des Riesen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				},
				{
					"id": 741411011,
					"content": "Ich erinnere mich. Ich erinnere mich. Du bist es wirklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411012
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411012,
					"content": "Entschuldige, ich habe hier einfach zu viele unvorstellbare Dinge erlebt und unzählige aussichtslose Kämpfe gekämpft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411013
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411013,
					"content": "Doch schlussendlich hat sich hier einiges verändert. Das goldene Licht ist erstrahlt und hat die Sonnenblumen erblühen lassen. Vielleicht unterliegt sogar das Universum, das sich die Alten vorgestellt haben, Veränderungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411014
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411014,
					"content": "Möglicherweise wird alles besser. Vielleicht werde ich es auch verstehen und loslassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411015
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411015,
					"content": "Caterpillar ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411016
					]
				},
				{
					"id": 741411016,
					"content": "Komm mit mir mit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411017
					]
				},
				{
					"id": 741411017,
					"content": "Haha, du bist es anscheinend wirklich. Du bist noch genauso, wie ich dich in Erinnerung habe. Weil du so aufrichtig und hilfsbereit bist, hast du deine Nase immer in die Angelegenheiten anderer gesteckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411018
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411018,
					"content": "Aber du musst dir um mich keine Sorgen machen. Ich brauche keine Hilfe. Du hast gesehen, wozu ich fähig bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411019
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411019,
					"content": "Außerdem weiß ich wahrscheinlich besser als du, was hier vor sich geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411020
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411020,
					"content": "#Hilichurl, sag bitte dem {F#Mädchen}{M#Jungen}, dass {F#sie}{M#er} gehen soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411021
					]
				},
				{
					"id": 741411021,
					"content": "Hast du mir etwas zu sagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411022
					]
				},
				{
					"id": 741411022,
					"content": "... Du verstehst, was ich sage? Gut, dann lass mich dich etwas fragen. In was für einer Gestalt siehst du mich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411023
					]
				},
				{
					"id": 741411023,
					"content": "Hund.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411024
					]
				},
				{
					"id": 741411024,
					"content": "Verstehe ... Dann ist es noch nicht zu spät.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411025
					]
				},
				{
					"id": 741411025,
					"content": "#Verlasse diesen Ort, {F#Mädchen}{M#Junge}. Das ist zu deinem Besten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411026
					]
				},
				{
					"id": 741411026,
					"content": "#Ich stimme zu. {NICKNAME}, du gehörst in eine hellere Welt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411027
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411027,
					"content": "Ich habe eine Frage ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411028
					]
				},
				{
					"id": 741411028,
					"content": "Das solltest du nicht. Auf Wiedersehen, und komm nicht wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				},
				{
					"id": 741411010,
					"content": "An den Lehrling und den kleinen Fisch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				}
			]
		},
