			"dialogs": [
				{
					"id": 741410101,
					"content": "(Die Inhalte der Seiten setzen sich weiterhin aus unverständlichen Zeichnungen, Buchstaben, alten Sprachen und geometrischen Figuren zusammen. Aber wenn man sich konzentriert, dann scheint man die Inhalte allmählich verstehen zu können.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410102
					],
					"speakerTitle": "Lesen"
				},
				{
					"id": 741410102,
					"content": "Canotila scheint nicht da zu sein, vielleicht ist sie wieder an diesen geheimnisvollen Ort gegangen! Willst du „meditieren“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410103,
					"content": "Nachdem ich gehört habe, was sie das letzte Mal gesagt hatte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410104
					]
				},
				{
					"id": 741410104,
					"content": "Bin ich ein wenig besorgt. Ich möchte nachsehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410105
					]
				},
				{
					"id": 741410105,
					"content": "Hm ... Paimon fühlt sich zwar nicht ganz wohl dabei, aber lass uns zusammen gehen! Canotila kann einem wirklich Sorgen bereiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410106,
					"content": "Paimon, es ist besser, wenn du draußen auf mich wartest.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410107
					]
				},
				{
					"id": 741410107,
					"content": "Was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410108,
					"content": "Die Welt im „Buch der Aufdeckung“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410109,
						741410110
					]
				},
				{
					"id": 741410109,
					"content": "... Könnte gefährlicher sein, als wir glauben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410111
					]
				},
				{
					"id": 741410111,
					"content": "Deshalb möchte ich nicht, dass du dich in Gefahr begibst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410112
					]
				},
				{
					"id": 741410112,
					"content": "Aber ... Aber, haben wir die Abenteuer nicht immer gemeinsam bestritten? Wenn wir zusammen sind, gibt es kein Hindernis, das uns trotzen könnte, und keinen Feind, den wir nicht besiegen könnten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410113,
					"content": "Die Gefahren da drinnen können vielleicht nicht mit Gewalt überwunden werden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410114
					]
				},
				{
					"id": 741410114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410115,
					"content": "Na schön! Hm, du bist viel schlauer als Paimon, also vertraut dir Paimon. Aber vergiss dann Paimon ja hier nicht! Paimon wird hier warten, bis du zurückkommst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410110,
					"content": "... Könnte eine Seite haben, von der wir nichts wissen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410111
					]
				}
			]
		},
