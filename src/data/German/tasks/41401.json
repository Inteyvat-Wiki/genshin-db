				"points": []
			},
			"dialogs": [
				{
					"id": 414010101,
					"content": "Wie merkwürdig ... Was ist mit diesem Fotoapparat los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010102
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010102,
					"content": "Was stimmt nicht mit deinem Fotoapparat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010103
					]
				},
				{
					"id": 414010103,
					"content": "Er ist wohl kaputt ... na ja, vielleicht nicht kaputt, aber er funktioniert nicht wie vorgesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010104
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010104,
					"content": "Vor einer Weile hab ich einige aus Fontaine bestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010105
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010105,
					"content": "Der Verkäufer meinte zu mir, dieser spezielle Fotoapparat enthalte die neuste Technik aus Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010106
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010106,
					"content": "Angeblich druckt er Fotos in einer speziellen Farbtönung und versieht sie mit besonderen Effekten. Also hab ich einen gekauft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010107
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010107,
					"content": "Doch er druckt die Fotos einfach nicht richtig aus. Keine Ahnung, ob ich was falsch mache oder ob er kaputt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010108
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010108,
					"content": "Vielleicht gibt es einen Kniff, den ich nicht kenne ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010109
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010109,
					"content": "Was ist mit dir? Kennst du dich mit solchen Apparaten aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010110,
						414010112
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010110,
					"content": "Ich bin ein Dilettant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010111
					]
				},
				{
					"id": 414010111,
					"content": "Das verstehe ich als ein Ja! Würdest du mir dabei helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010114,
					"content": "#Du bist wohl {F#eine Reisende}{M#ein Reisender}? Dann musst du schon viel gesehen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010115
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010115,
					"content": "Bitte fotografiere mit diesem Fotoapparat ein Motiv mit einer intensiven Farbe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010116
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010116,
					"content": "Sobald du den Schnappschuss gemacht hast, bring mir bitte das Foto. Ich möchte der Quelle dieses Problems auf den Grund gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010117
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010117,
					"content": "Und wenn das nicht klappt, bringe ich die Fotos dem Verkäufer. Mit den Fotos als Beweis kann er das Problem nicht abstreiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010118,
						414010120
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010118,
					"content": "Ich mache das.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010119
					]
				},
				{
					"id": 414010119,
					"content": "Wunderbar. Danke sehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010120,
					"content": "Was meinst du mit einer intensiven Farbe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010121
					]
				},
				{
					"id": 414010121,
					"content": "Oh, ich meine ... extrem helle Farben, wie von einer Jueyun-Peperoni, einer blaue Eisnebelblume ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010122
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010122,
					"content": "Sobald du ein gutes Motiv gefunden hast, bring mir das Foto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010112,
					"content": "Ich habe noch nie von einer gehört.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010113
					]
				},
				{
					"id": 414010113,
					"content": "Oh, verstehe ... Na ja, egal, es ist ganz leicht ... Würdest du mir also trotzdem helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "Ji Tong"
				}
			]
		}
	]
}