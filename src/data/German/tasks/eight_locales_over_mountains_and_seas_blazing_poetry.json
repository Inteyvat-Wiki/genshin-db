			"dialogs": [
				{
					"id": 726770801,
					"content": "Wie warm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770802
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770802,
					"content": "Wenn es doch nur Flammenblumen gäbe, wenn wir in die verschneiten Berge reisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770803
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770803,
					"content": "In diesem Fall wäre es wirklich an der Zeit, etwas zum Warmhalten vorzubereiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770804,
					"content": "Paimon, wenn es sehr große dieser Blumen gäbe, könnte man dann dafür sorgen, das kein Schnee in den Bergen liegt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770805
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770805,
					"content": "Paimon fürchtet, das geht leider nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770806,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770807
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770807,
					"content": "Du kannst die „riesige Flammenblume“ mit Kichiboushi ansehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770808
					]
				},
				{
					"id": 726770808,
					"content": "Könnte es etwa sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770809,
						726770810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770809,
					"content": "In der Nähe gibt es Fluxfeuerbäume.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770811
					]
				},
				{
					"id": 726770811,
					"content": "Ja! Das ist die heutige Übung von Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770810,
					"content": "So ist es. Legen wir los.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770811
					]
				}
			]
		},
