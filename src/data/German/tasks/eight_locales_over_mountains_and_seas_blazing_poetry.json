			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726770701,
					"content": "#{NICKNAME}, wie beeindruckend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770702,
						726770703
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770702,
					"content": "Echt gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770704
					]
				},
				{
					"id": 726770704,
					"content": "#{NICKNAME}, Paimon, kämpft ihr oft?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770705
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770705,
					"content": "#Nun ... wenn Paimon jetzt darüber nachdenkt, ist der Zweck unserer Reise zwar die Suche nach {F#einem}{M#einer} verlorenen Verwandten, aber auf dem Weg müssen wir ständig kämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770706,
						726770708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770706,
					"content": "Schon in Ordnung. Mir gefällt es sehr zu kämpfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770707
					]
				},
				{
					"id": 726770707,
					"content": "Nun ... es ist zwar gut, Kampfgeist zu haben, aber es ist besser, daraus kein Hobby zu machen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770710,
					"content": "#Warte nur, bis ich zu einem großen Bakedanuki geworden bin, dann bin ich auch so toll wie {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770711
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770711,
					"content": "Kichiboushi wird das sicher schaffen! Aber du musst Paimon versprechen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770712,
					"content": "Sag schon, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770713
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770713,
					"content": "Hmmm ... hm! Selbst wenn sich Kichiboushi als Magier entpuppt, der mächtiger ist als Ioroi, sollte er die Schwachen nicht schikanieren. Und dann sollte man auch nicht einfach nach Belieben kämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770714,
					"content": "#Ich kann nicht wie diese große, große, feurige Blume sein, die auftaucht und sich dreht und Feuer spuckt, wenn sie {NICKNAME} sieht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770715,
					"content": "Wann müssen wir also kämpfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770716,
						726770717,
						726770718
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770716,
					"content": "Wenn wir uns verteidigen müssen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770719
					]
				},
				{
					"id": 726770719,
					"content": "Auch wenn ich es nicht richitg verstehe, werde ich es Paimon versprechen und nicht nach Belieben kämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770720
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770720,
					"content": "Ja, Kichiboushi ist sehr brav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770721,
					"content": "Als Nächstes ... sollte es die letzte Station der acht Orte sein, an denen Ioroi ihn üben lassen wollte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770722,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770717,
					"content": "Wenn wir andere verteidigen müssen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770719
					]
				},
				{
					"id": 726770718,
					"content": "Wenn wir Ideale verteidigen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770719
					]
				},
				{
					"id": 726770708,
					"content": "Wenn man beim Kämpfen stirbt, wäre es schon schade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770709
					]
				},
				{
					"id": 726770709,
					"content": "Ja, aber manchmal kann man einfach nicht anders, als zu den Waffen zu greifen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770703,
					"content": "Zum Glück habe ich schon oft mit diesen Dingern gekämpft.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770704
					]
				}
			]
		},
