			"dialogs": [
				{
					"id": 726770101,
					"content": "Die Aussicht von hier ist etwas Besonderes, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770102,
					"content": "Eine Wasserschicht mit einem ganz besonderen Farbklecks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770103,
						726770108,
						726770111
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770103,
					"content": "Das Vokabular von Paimon ist genauso lückenhaft wie das von Kichiboushi ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770104
					]
				},
				{
					"id": 726770104,
					"content": "#Aber es ist wirklich etwas Besonderes! Wie würdest du diese Farbe beschreiben, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770105,
						726770106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770105,
					"content": "Wie Kryo-Kraft ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770107
					]
				},
				{
					"id": 726770107,
					"content": "Was ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770113,
					"content": "#Aber die Aussicht ist hier wirklich besonders. {NICKNAME} erinnerst du dich an den Künstler von früher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770114,
						726770116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770114,
					"content": "Vermeer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770115
					]
				},
				{
					"id": 726770115,
					"content": "Ja, Vermeer! Haben wir ihm damals nicht geholfen, die beiden großen Statuen mit leuchtenden Perlen zu versehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770118,
					"content": "Am Ende haben wir noch ein Bild bekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770119,
					"content": "Ist es dieses?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770120
					]
				},
				{
					"id": 726770120,
					"content": "Ja! Genau! Kichiboushi, schau schnell!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770121,
					"content": "Boah! Wie ähnlich! Ist es ein Foto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770122
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770122,
					"content": "Nein. Oh, es wurde von einem Menschen gemalt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770123,
					"content": "Wie? Aber warum malen die Menschen, wenn sie fotografieren können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770124
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770124,
					"content": "#Ah ... ja, {NICKNAME}, warum ist das so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770125,
						726770127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770125,
					"content": "Weil man etwas schaffen will, das nur einem selber gehört?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770126
					]
				},
				{
					"id": 726770126,
					"content": "Das klingt plausibel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770130,
					"content": "Es steckt auch viel Herzblut darin, etwas selbst zu malen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770131
					]
				},
				{
					"id": 726770131,
					"content": "Nun, es ist harte Arbeit, Strich für Strich das zu zeichnen, was man im Kopf hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770132,
					"content": "Mhmm ... also ist es einfach und unkompliziert, ein Foto zu machen. Steckt deshalb nicht viel Herzblut drin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770133
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770133,
					"content": "Ah! So ist das nicht. Es ist so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770134,
					"content": "Zum Malen braucht man eine lange Zeit. Für Kichiboushi wäre das anstrengend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770135
					]
				},
				{
					"id": 726770135,
					"content": "Ja, genau! Malen dauert sehr lange. Kichiboushi verharrt die ganze Zeit in der gleichen Position und wird sehr müde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770136,
					"content": "Als ich versiegelt und versteinert wurde, stand ich so da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770137
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770137,
					"content": "Nach dem Brechen des Siegels waren meine Füße noch lange Zeit sehr kribbelig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770138
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770138,
					"content": "Ooh, das klingt wirklich sehr schlimm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770139,
					"content": "Aber Paimon kann immerzu fliegen. Deine Füße sollten nicht sehr müde werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770140
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770140,
					"content": "He! Das ist anstrengend, man muss den ganzen Körper bewegen, um schweben zu können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770141,
					"content": "Ooh! Schaut, diese feurige Blume!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770142
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770142,
					"content": "Hör gut zu, was die anderen sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770143,
					"content": "Flammenblume?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770144
					]
				},
				{
					"id": 726770144,
					"content": "Oh ja, ich glaube nicht, dass ich viele Flammenblumen im Chinju-Wald gesehen habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770145,
					"content": "Will Kichiboushi welche haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770146,
					"content": "Ja! Sieht schön warm aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770147
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770147,
					"content": "#Dann bitte {NICKNAME} um eine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770148,
					"content": "#{NICKNAME}, ich hätte gern eine. Danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770149
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770149,
					"content": "Ist das also die Art, wie Bakedanuki sprechen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770127,
					"content": "Weil ein Fotoapparat sehr teuer ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770128
					]
				},
				{
					"id": 726770128,
					"content": "Huch?! Ist ein Fotoapparat teuer? Und geht er kaputt, wenn du kämpfst, schwimmst, kletterst und vom Berg fällst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770129,
					"content": "Oh, Paimon wird von nun an vorsichtig sein müssen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770116,
					"content": "Wer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770117
					]
				},
				{
					"id": 726770117,
					"content": "Vermeer! Hast du ihm damals nicht geholfen, die beiden großen Statuen mit leuchtenden Perlen zu versehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770106,
					"content": "Wie Anemo-Kraft ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770107
					]
				},
				{
					"id": 726770108,
					"content": "Das Vokabular von Kichiboushi ist genauso reich wie das von Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770109
					]
				},
				{
					"id": 726770109,
					"content": "Genauso gut wie Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770110
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770110,
					"content": "#Nun ... {NICKNAME} hat es vielleicht nicht so gemeint, aber egal ... Kichiboushi ist einfach nur schlau! Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770111,
					"content": "Wirklich sehr besonders!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770112
					]
				},
				{
					"id": 726770112,
					"content": "#Huch? Fehlt es dem Wortschatz von {NICKNAME} nicht ein bisschen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "Paimon"
				}
			]
		},
