			"dialogs": [
				{
					"id": 726771001,
					"content": "Die Aussicht von hier ist etwas Besonderes, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771002,
					"content": "Eine Wasserschicht mit einem ganz besonderen Farbklecks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771003,
						726771008,
						726771011
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726771003,
					"content": "Das Vokabular von Paimon ist genauso lückenhaft wie das von Kichiboushi ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771004
					]
				},
				{
					"id": 726771004,
					"content": "#Aber es ist wirklich etwas Besonderes! Wie würdest du diese Farbe beschreiben, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771005,
						726771006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771005,
					"content": "Wie Kryo-Kraft ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771007
					]
				},
				{
					"id": 726771007,
					"content": "Was ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771013,
					"content": "Aber die Aussicht hier ist wirklich besonders. Es ist ein bisschen wie Malen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771014,
					"content": "Kann Paimon malen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771015
					]
				},
				{
					"id": 726771015,
					"content": "Was man nicht kann, kann man lernen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771016,
					"content": "Malen ... Aber es ist schwer zu malen. Früher brauchte Utamarou ewig, Bilder zu malen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771017
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726771017,
					"content": "Warum malt der Mensch noch, wenn der Fotos schießen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771018
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726771018,
					"content": "#Ah ... ja, {NICKNAME}, warum ist das so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771019,
						726771021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771019,
					"content": "Weil man etwas schaffen will, das nur einem selber gehört?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771020
					]
				},
				{
					"id": 726771020,
					"content": "Das klingt plausibel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771024,
					"content": "Es steckt auch viel Herzblut darin, etwas selbst zu malen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771025
					]
				},
				{
					"id": 726771025,
					"content": "Nun, es ist harte Arbeit, Strich für Strich das zu zeichnen, was man im Kopf hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771026
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771026,
					"content": "Mhmm ... also ist es einfach und unkompliziert, ein Foto zu machen. Steckt deshalb nicht viel Herzblut drin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771027
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726771027,
					"content": "Ah! So ist das nicht. Es ist so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771028
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771028,
					"content": "Zum Malen braucht man eine lange Zeit. Für Kichiboushi wäre das anstrengend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771029
					]
				},
				{
					"id": 726771029,
					"content": "Ja, genau! Malen dauert sehr lange. Kichiboushi verharrt die ganze Zeit in der gleichen Position und wird sehr müde.",
