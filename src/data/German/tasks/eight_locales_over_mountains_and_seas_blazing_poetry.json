			"dialogs": [
				{
					"id": 726770301,
					"content": "Wie groß! Wie heiß! Es gibt wirklich so große feurige Blumen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770302
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770302,
					"content": "Richtig! Ah, genau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770303,
					"content": "Kichiboushi, warte mal. Wir machen ein Foto von dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770304,
					"content": "An so einem heißen Ort?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770305
					]
				},
				{
					"id": 726770305,
					"content": "Gerade wenn es so heiß ist, ist es gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770306
					],
