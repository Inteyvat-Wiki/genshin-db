					"nextDialogs": [
						726771031
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726771031,
					"content": "Nach dem Brechen des Siegels waren meine Füße noch lange Zeit sehr kribbelig.",
