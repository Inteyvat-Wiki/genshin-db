			},
			"dialogs": [
				{
					"id": 726770401,
					"content": "... So warm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770402
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770402,
					"content": "Kichiboushi, jetzt weißt du es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770403,
					"content": "Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770404
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770404,
					"content": "Was weiß ich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770405
					]
				},
				{
					"id": 726770405,
					"content": "Wenn man malt, dann muss man mehr Zeit einsetzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770406,
					"content": "Die Entscheidung, zu fotografieren statt zu malen, ist also nicht unüberlegt, sondern wohlüberlegt! Das lässt einen wirklich nachdenken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770407,
						726770408,
						726770409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770407,
					"content": "So ist es!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770410
					]
				},
				{
					"id": 726770410,
					"content": "Ich verstehe. Mach ein Foto ... Es ist so heiß ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770411
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770411,
					"content": "Ich werde die Wärmequelle schnell loswerden. Ich bin gleich fertig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770412
					]
				},
				{
					"id": 726770412,
					"content": "Uuh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726770408,
					"content": "Wirklich komisch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770410
					]
				},
				{
					"id": 726770409,
					"content": "Das stimmt, aber es ist wirklich heiß ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770410
					]
				}
			]
		},
		{
			"id": 7267707,
			"completionStepIds": [
				7267707
