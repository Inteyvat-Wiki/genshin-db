				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721150101,
					"content": "Hallo! Ich habe gute und schlechte Nachrichten bezüglich des Mikage-Hochofens. Welche möchtest du zuerst hören?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150102,
						721150106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150102,
					"content": "Lass uns die guten Nachrichten hören.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150103
					]
				},
				{
					"id": 721150103,
					"content": "Die gute Nachricht ist, dass der Kern nur einen kleinen Schaden erlitten hat. Es liegt noch in meiner Macht, ihn zu reparieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150104,
					"content": "Die schlechte Nachricht ist jedoch, dass die Fatui, die da drin herumalbern, diese gute Nachricht nicht zu schätzen wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150105,
					"content": "Sie scheinen nach einem Weg zu suchen, den Kern der Tatarigami in ihre schmutzigen Hände zu bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150111,
					"content": "Aber wenn wir sie weiter herumalbern lassen, werden die Kräfte der Tatarigami nicht mehr kontrollierbar sein. Die gesamte Insel wird in die Luft gesprengt, während wir noch auf ihr sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150112,
					"content": "Wenn wir uns jedoch nur auf die Fatui konzentrieren, wird die Energie der Tatarigami, die sich im Schild aufgestaut hat, irgendwann trotzdem an ihre Grenzen stoßen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150113,
					"content": "Bedeutet das, dass wir uns mit beiden gleichzeitig beschäftigen müssen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150114
					]
				},
				{
					"id": 721150114,
					"content": "Hmm. Im Grunde genommen, technisch und objektiv ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150115,
					"content": "Ein zweigleisiges Problem liegt in der Tat vor uns: die Fatui und die Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150116,
					"content": "Aber so wie die Situation im Mikage-Hochofen ist, werden wir wahrscheinlich mit dem zweiten Problem konfrontiert werden, während wir uns mit dem ersten beschäftigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150117,
					"content": "Die Wahrheit über unsere Situation ist also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150118,
					"content": "Du willst „ja“ sagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150119
					]
				},
				{
					"id": 721150119,
					"content": "Ähm, ja, das ist richtig. Wir müssen uns mit beiden gleichzeitig beschäftigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150120,
					"content": "Aber lass uns einen Schritt nach dem anderen machen. Wie es in Liyue heißt: „Heißen Tofu isst man nur mit ruhiger Hand“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150121,
					"content": "Du kennst tatsächlich Sprichwörter aus Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150122
					]
				},
				{
					"id": 721150122,
					"content": "Wir waren schon einmal in Liyue. Ich würde dies als ein Andenken von der Reise betrachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150123,
					"content": "Ich habe noch viel mehr von diesen Andenken. Ich muss gestehen, dass ich meine „Andenken“ aus Mondstadt ausgetrunken habe, sie waren sehr lecker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150124,
					"content": "Lass uns wieder auf den richtigen Weg kommen. Ich habe einen klitzekleinen Plan, um diese Mikage-Hochofen-Situation zu lösen, aber ich werde deine Hilfe brauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150125,
						721150127
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150125,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150126
					]
				},
				{
					"id": 721150126,
					"content": "Ha! Unverblümt und bereit für einen Kampf! Das ist es, was ich an dir mag!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150131,
					"content": "*hust* Kommen wir zurück zum Thema. Nimm bitte die Sensor-Baken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150132
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150132,
					"content": "Du musst diese Baken an verschiedenen Orten platzieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150133
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150133,
					"content": "Diese Baken sind in der Lage, Daten über die Ausbreitung und Dichte der Energien im Mikage-Hochofen zu sammeln. Sobald ich diese Daten habe, sollte ich in der Lage sein, einen detaillierteren Plan zu entwerfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150134,
						721150136
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150134,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150135
					]
				},
				{
					"id": 721150135,
					"content": "Danke sehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150141,
					"content": "#Ich werde die Standorte auf deiner Karte markieren. Ich zähle auf dich, Reisende{M#r}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150136,
					"content": "Wie funktionieren diese?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150137
					]
				},
				{
					"id": 721150137,
					"content": "Der einfache Weg es zu erklären ist, dass sie Instrumente sind, die die elementare Kraft nutzen, um alle anderen Arten von Energien zu quantifizieren und zu berechnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150138
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150138,
					"content": "Nun, ich sage „einfach“, aber es ist eigentlich nicht so einfach zu erklären ... Aber ich nehme an, wir könnten von der Theorie der sieben Elemente ausgehen! Nun denn ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150139
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150139,
					"content": "Gut, das reicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150140
					]
				},
				{
					"id": 721150140,
					"content": "Alles klar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150127,
					"content": "Nun, was habe ich davon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150128
					]
				},
				{
					"id": 721150128,
					"content": "Hmm ... wie wäre es mit den unentdeckten Schätzen dieser Insel und einigen „übrig gebliebenen Materialien“ aus dem Inneren des Mikage-Hochofens?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150129
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150129,
					"content": "Ich bin mir sicher, dass es im Inneren des Mikage-Hochofens einige bemerkenswerte Dinge geben muss, schließlich ist es die größte Schmelzanlage in Inazuma und so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150130
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150130,
					"content": "Natürlich kann ich als jemand, der kein Göttliches Auge besitzt, den Mikage-Hochofen derzeit nicht betreten, noch wüsste ich wirklich, was dort vor sich geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150106,
					"content": "*seufz* Lass uns die schlechte Nachricht hören.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150107
					]
				},
				{
					"id": 721150107,
					"content": "Die schlechte Nachricht ist, dass die Fatui im Inneren des Ofens immer noch für Aufruhr sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150108,
					"content": "Sie scheinen nach einem Weg zu suchen, den Kern der Tatarigami in ihre schmutzigen Hände zu bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150109,
					"content": "Die gute Nachricht ist, dass der Kern keinen großen Schaden erlitten hat, so dass ich mich selbst darum kümmern kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150110,
					"content": "Die Fatui werden natürlich nicht erfreut sein, das zu hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "Xavier"
				}
			]
		},
