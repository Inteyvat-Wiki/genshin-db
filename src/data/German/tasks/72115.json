						],
						"stepId": 7211508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721150301,
					"content": "Hast du sie platziert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150302,
					"content": "Jupp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150303
					]
				},
				{
					"id": 721150303,
					"content": "Gut gemacht, jetzt müssen wir sie nur noch die Daten sammeln lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150304,
						721150308
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150304,
					"content": "Woher weißt du von diesen Standorten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150305
					]
				},
				{
					"id": 721150305,
					"content": "Ich war Teil des Entwurfteams für den Mikage-Hochofen. Wenn du an diesen Orten Baken platzierst, erhältst du im Grunde alle Daten im Mikage-Hochofen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150306,
					"content": "Hmm, weißt du, wenn wir an diesen Orten Reinigungsgeräte aufstellen würden, wären unsere Probleme über Nacht vorbei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150307
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150307,
					"content": "Flois würde wahrscheinlich ausrasten und verrückt werden, wenn er von der jetzigen Situation erfährt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150311
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150311,
					"content": "In Ordnung, danke für deine Hilfe. Bitte nimm diese mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150312
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150312,
					"content": "*hust* ... Hm ... Außerdem muss ich dich vielleicht nach einer Weile mit dem Zurückholen der Baken belästigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150313
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150313,
					"content": "Ich habe kein Göttliches Auge, daher kann ich nicht durch Gebiete reisen, die mit solchen Energien gesättigt sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150314
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150314,
					"content": "Außerdem sind die Fatui immer noch da drin. Ich glaube nicht, dass es außer dir noch jemanden auf der Insel gibt, der mit ihnen und dem Ofen gleichzeitig fertig werden könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150308,
					"content": "Stehen diese Baken zum Verkauf?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150309
					]
				},
				{
					"id": 721150309,
					"content": "Du machst Witze! Selbst wenn ich sie an dich verkaufen würde, was würde ich dann benutzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150310
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150310,
					"content": "Wenn du aber mal vorhast, nach Fontaine zu fahren, kann ich dich mit jemandem bekannt machen, der solche Baken verkauft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
