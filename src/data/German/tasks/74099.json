			"dialogs": [
				{
					"id": 740990101,
					"content": "Über die vorherige Erfahrung des Anlockens von Monstern ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740990102
					]
				},
				{
					"id": 740990102,
					"content": "Aha! Wenn ich so darüber nachdenke ... es ist eine ganz besondere Erfahrung, Monster durch den Köder anzulocken, den man selbst ausgeworfen hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990103
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990103,
					"content": "Vor Monstern habe ich selbst keine Angst. Als ich allein zwischen dem Forschungsinstitut und dem Hof von Fontaine unterwegs war, habe ich gegen einige Räuber gekämpft. Ich habe dabei nicht viel Schaden genommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990104
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990104,
					"content": "Aber nun, als Direktorin des Angelvereins kann ich es mir nicht leisten, pflichtvergessen zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990105
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990105,
					"content": "Egal, ob es darum geht, andere Fische unter Wasser zu verscheuchen oder die Angler in der Nähe zu stören, ich werde der Anerkennung, die ich als Direktorin von allen bekommen habe, nicht gerecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990106
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990106,
					"content": "Also möchte ich lieber konservativ und etwas vorsichtig sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Delaroche"
				}
			]
		}
	]
