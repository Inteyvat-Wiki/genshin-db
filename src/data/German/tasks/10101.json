					"speakerTitle": "Lisa"
				},
				{
					"id": 101012002,
					"content": "Mit deinem <color=#00E1FFFF>„Elementarblick“</color> kannst du sogar das Wirken von <color=#00E1FFFF>Magie</color> erkennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
