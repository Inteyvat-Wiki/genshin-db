			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101010701,
					"content": "Er lebt in einer <color=#00E1FFFF>Ruine</color>? Die Leute aus Mondstadt haben manchmal seltsame Angewohnheiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010702,
					"content": "Spar dir deine Mutmaßungen über die Angewohnheiten der Menschen aus Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010703
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010703,
					"content": "Das sieht mir eher nach einem nicht so freundlichen Unruhestifter aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010704,
						101010707,
						101010709
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010704,
					"content": "Hilichurle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010705
					]
				},
				{
					"id": 101010705,
					"content": "Bücher zu stehlen, ist nicht gerade ein Hobby von Hilichurlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010706
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010706,
					"content": "Sie könnten Bücher auch nur für ein warmes Feuerchen gebrauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010712,
					"content": "Das sieht eher nach den Machenschaften des <color=#00E1FFFF>Ordens des Abgrunds</color> aus. Dessen Mitglieder sind bekannt dafür, hier und da für Ärger zu sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010713
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010713,
					"content": "Davon abgesehen ist am Eingang der Ruine ein Elementarsiegel. Das könnte von der Magie des Ordens des Abgrunds stammen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010714
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010714,
					"content": "Ein Siegel? Und wie lösen wir es? ... Oder wird das wieder so eine monstermäßige Aktion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010715,
					"content": "Als würde mich so ein bisschen Elementarmagie abhalten! Nicht mit mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010716
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010716,
					"content": "Hö?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010717,
					"content": "Los, hinein mit euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010718
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010718,
					"content": "Wahnsinn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010719,
					"content": "So ist es also, wenn Lisa mal richtig Hand anlegt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010707,
					"content": "Der Orden des Abgrunds?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010708
					]
				},
				{
					"id": 101010708,
					"content": "Du hast schon wieder meine Gedanken gelesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010709,
					"content": "Die Abenteurergilde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010710
					]
				},
				{
					"id": 101010710,
					"content": "Hmm ... Rein theoretisch wäre es schon möglich, so gern, wie sie sich in Ruinen herumtreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010711
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010711,
					"content": "Aber sie stehlen normalerweise keine Sachen ... zumindest nicht von Lebenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "Lisa"
				}
			]
		},
		{
			"id": 1010108,
			"completionStepIds": [
				1010108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1010108",
							"2"
						],
						"stepId": 1010108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101010801,
					"content": "Hier ist <color=#00E1FFFF>„Schneemädchen und die sechs Winzlinge“</color>! Ich erinnere mich an den Namen. Das muss es doch sein, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010802,
					"content": "Ja! Gut, dass das Buch nicht beschädigt ist. Ansonsten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010803
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010803,
					"content": "Was denn? Könntet Ihr Euch eine noch schlimmere Bestrafung einfallen lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010804,
					"content": "Hehe, in dem Fall hätte ich ihn die Früchte meiner Trankstudien probieren lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010805
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010805,
					"content": "Oh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010806,
					"content": "Aber trotzdem ist dieses Buch nicht aus dem verbotenen Bereich. Deswegen habe ich es auch an normale Bürger verliehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010807
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010807,
					"content": "Außer den von mir hinterlassenen Markierungen gibt es auch keine ungewöhnlichen elementaren Auffälligkeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010808
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010808,
					"content": "Ja, es sieht wie ein stinknormales Kinderbuch aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010809,
						101010810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010809,
					"content": "Aber warum will der Orden des Abgrunds dann ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010810
					]
				},
				{
					"id": 101010810,
					"content": "(Dahinter muss sich ein Geheimnis verbergen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010811
					]
				},
				{
					"id": 101010811,
					"content": "Für mich als Bibliothekarin ist meine Arbeit getan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010812
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010812,
					"content": "Aber wenn du dich für das Buch interessierst, kann ich es dir ausleihen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010813,
						101010814
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010813,
					"content": "Und, ähm, wann läuft die Frist ab?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010814
					]
				},
				{
					"id": 101010814,
					"content": "Ich kann gut und gern auf die Strafe verzichten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010815
					]
				},
				{
					"id": 101010815,
					"content": "Für dich gibt es keine Frist. Ich werde dich als Verwahrer, nicht als Entleiher eintragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010816
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010816,
					"content": "Das mache ich nur für ganz besondere Bürger, denen ich vertraue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010817
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010817,
					"content": "Denen Ihr vertraut, ja? Paimon glaubt, Ihr wollt Eure Arbeit eher auf andere abwälzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010818,
					"content": "Äh, wie bitte? Bist du etwa mit meiner Arbeit unzufrieden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010819,
						101010820
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010819,
					"content": "Auf keinen Fall!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010820
					]
				},
				{
					"id": 101010820,
					"content": "Ich werde ganz besonders behutsam mit dem Buch umgehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010821
					]
				},
				{
					"id": 101010821,
					"content": "#Dann kann ich es dir ja anvertrauen. Am liebsten würde ich dich als Assistent{F#in}{M#en} bei mir behalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010822
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010822,
					"content": "Meine Arbeit hier ist getan. Ich werde mich fürs Erste zurückziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010823
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010823,
					"content": "Vergiss nicht, mal bei der Bibliothek vorbeizukommen, um dich einzutragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
		{
			"id": 1010110,
			"completionStepIds": [
				1010110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
