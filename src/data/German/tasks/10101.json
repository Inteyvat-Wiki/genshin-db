				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101011201,
					"content": "Wie ... habt ihr mich gefunden? Das ist doch das perfekte Versteck!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011202
					],
					"speakerTitle": "Abgrundmagier"
				},
				{
					"id": 101011202,
					"content": "Mir ist es ziemlich egal, wo ihr euch versteckt. Ich will einfach nur das Buch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011203
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011203,
					"content": "Ihr habt euch die Zeit genommen, diesen Stützpunkt zu verstecken und ein Siegel aufzubauen ... Ein Buch ausleihen könnt ihr aber nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011204
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011204,
					"content": "Ihr habt wirklich keinen Respekt vor den Bemühungen anderer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011205
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011205,
					"content": "Wie jetzt ... Du willst <color=#00E1FFFF>das Buch</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011206
					],
					"speakerTitle": "Abgrundmagier"
				},
				{
					"id": 101011206,
					"content": "Mir war nicht bewusst, dass es auch in Mondstadt jemanden geben könnte ... der die Geheimnisse von Büchern aufdecken will ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011207
					],
					"speakerTitle": "Abgrundmagier"
				},
				{
					"id": 101011207,
					"content": "Wer ... Wer bist du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011208
					],
					"speakerTitle": "Abgrundmagier"
				},
				{
					"id": 101011208,
					"content": "Ich bin eine Bibliothekarin, falls du das immer noch nicht kapiert hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011209
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011209,
					"content": "Nun gib das Buch zurück. Das ist meine letzte Warnung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011210
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011210,
					"content": "Hmpf ... Wenn du mir nicht zeigen willst, wer du wirklich bist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011211
					],
					"speakerTitle": "Abgrundmagier"
				},
				{
					"id": 101011211,
					"content": "Dann werde ich dir das Buch erst recht nicht geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011212
					],
					"speakerTitle": "Abgrundmagier"
				},
				{
					"id": 101011212,
					"content": "Schließlich enthält es ... das Geheimnis ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011213
					],
					"speakerTitle": "Abgrundmagier"
				},
				{
					"id": 101011213,
					"content": "Was? Wie ... Was machst du da? Diese elementaren Kräfte ... Wie geht das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011214
					],
					"speakerTitle": "Abgrundmagier"
				},
				{
					"id": 101011214,
					"content": "Aaaaaaaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011215,
						101011216
					],
					"speakerTitle": "Abgrundmagier"
				},
				{
					"id": 101011215,
					"content": "Sie ist so stark!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011217
					]
				},
				{
					"id": 101011217,
					"content": "Tja, wer nicht hört, muss fühlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011218,
						101011219
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011218,
					"content": "Ihr habt ihn auch nicht ausreden lassen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011220
					]
				},
				{
					"id": 101011220,
					"content": "Deswegen sag ich ja immer, die Arbeit ist so anstrengend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011221
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011221,
					"content": "Jetzt müssen wir wenigstens nur noch das Buch finden. Es müsste hier irgendwo sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011219,
					"content": "War das für ein gestohlenes Buch nötig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011220
					]
				},
				{
					"id": 101011216,
					"content": "Sie ist so furchteinflößend!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011217
					]
				}
			]
		},
