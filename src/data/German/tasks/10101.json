			},
			"dialogs": [
				{
					"id": 101011001,
					"content": "Oh, du bist zurück. Die Unterlagen für die Verwahrung sind fertig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011002
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011002,
					"content": "Danke, Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011003,
					"content": "Hmm ... Ich glaube, irgendwas war da noch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011004,
						101011005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011004,
					"content": "Der „Reiseführer Teyvat“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011007
					]
				},
				{
					"id": 101011007,
					"content": "Ah! Seht mal hier im Regal ... Ist das nicht der <color=#00E1FFFF>„Reiseführer Teyvat“</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011008,
					"content": "Davon scheint es richtig viele zu geben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011009,
					"content": "Hehehe ... Der <color=#00E1FFFF>„Reiseführer Teyvat“</color> ist eigentlich eine Serie und nicht wirklich Teil des Bestands der Bibliothek ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011010
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011010,
					"content": "Ach so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011011,
					"content": "Nimm dir eins. Betrachte es als Belohnung für deine heutigen Taten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011012
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011012,
					"content": "Mit dir hat sich die Arbeit heute ein bisschen weniger langweilig angefühlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011013
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011013,
					"content": "Der „Reiseführer Teyvat“ war also nichts weiter als ein Köder, um Euch bei der Arbeit zu helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011014,
					"content": "Konnte ja keiner ahnen, dass wir für ein Buch unterirdische Ruinen durchsuchen mussten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011015
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011015,
					"content": "Um es wiedergutzumachen, gebe ich euch ein paar Andenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011016
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011016,
					"content": "Toll! Habt ihr die extra für uns vorbereitet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011017,
					"content": "Eigentlich wollte ich sie euch beim nächsten Mal geben ... Aber was soll’s? Das hat ja noch Zeit. Ich hoffe, ihr freut euch schon drauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011018
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011018,
					"content": "*gähn*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011005,
					"content": "Die Belohnung!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011006
					]
				},
				{
					"id": 101011006,
					"content": "Hehe, ein unersättliches kleines Monster bist du.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011007
					],
					"speakerTitle": "Lisa"
				}
			]
		},
