			},
			"dialogs": [
				{
					"id": 3790201,
					"content": "He, willkommen zurück, meine lieben Fans!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790202,
					"content": "Ah, die heilige Leier! Ihr habt es also wirklich geschafft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790203
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790203,
					"content": "Das Rosenholz mit dem Muster des wehenden Windes, die kühl wirkenden Saiten ... Das lässt Erinnerungen aufleben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790204,
					"content": "Wie sieht es nun aus, Venti? Kannst du damit Dvalin beschwören?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790205
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790205,
					"content": "Hm ... Es ist zwar der echte Schatz des Anemo-Archons, aber es wird noch nicht klappen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790206,
					"content": "Wie ihr sehen könnt, hat die Leier eintausend Jahre überstanden. Dabei ist ihre Anemo-Kraft aber gewichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790207,
					"content": "In diesem Zustand kann man vielleicht gerade so Lieder in Dilucs Taverne spielen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790208,
					"content": "Sprich nicht so herablassend über meine Taverne! Die Leute würden sich um einen Platz für eine Aufführung bei mir prügeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790209
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3790209,
					"content": "Diluc sollte lieber einen ganz anderen Punkt kritisieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790210,
					"content": "He, du! Hast du die heilige Leier nur haben wollen, um damit vor Betrunkenen aufzutreten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790211,
					"content": "Ehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790212,
					"content": "Was soll das denn heißen?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790213,
					"content": "Jedenfalls reicht das noch lange nicht, um mit Dvalin zu kommunizieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790214
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790214,
					"content": "Die Leier ist übrigens in Ordnung. Es geht eher um die Saiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790215,
					"content": "Das ist deine Chance, Fremder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790216,
						3790217
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790216,
					"content": "Meine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790218
					]
				},
				{
					"id": 3790218,
					"content": "Ach, diese kostbare Leier soll doch auch nicht repariert werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790219
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790219,
					"content": "Es ist nur so, dass durch die Saiten Anemo-Kraft fließen sollte. Diese reicht im Moment überhaupt nicht aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790220
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790220,
					"content": "#{NICKNAME}, du hast doch gut auf den Tränenkristall von Dvalin aufgepasst, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790221
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790221,
					"content": "*nickt*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3790217,
					"content": "Ich weiß nicht, wie man Instrumente repariert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790218
					]
				}
			]
		},
		{
			"id": 37903,
