					"nextDialogs": [
						710800608
					]
				},
				{
					"id": 710800608,
					"content": "Du erzählst Taliesin von deinen bisherigen Erlebnissen ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800609
					]
				},
				{
					"id": 710800609,
					"content": "Oh, oh ... „Und so ... Und so ... der treue Diener ...“ Nein, das geht nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800610
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800610,
					"content": "#„... Unter der Führung eines treuen Gefährten kämpfte sich {NICKNAME} bis zur Mine vor ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800611
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800611,
					"content": "Wah ... Das geht so auch nicht, schließlich haben wir keine Erlaubnis ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710800612,
					"content": "He, keine Sorge! Helden tun nicht, was normale Menschen tun, sie folgen nicht den normalen Wegen! Die Leute wird so ein kleines Problem nicht kümmern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
