					"nextDialogs": [
						710800619
					]
				},
				{
					"id": 710800619,
					"content": "„... Die Farben des Himmels und des Wassers flossen wieder über die Oberfläche des Kristalls und die lila-roten Flecken verblassten ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800620
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800620,
					"content": "#„... die mechanische Bestie in den alten Ruinen, deren Kopf von der eisernen Faust von {NICKNAME} betäubt wurde ... als der Pfeil zur Rettung kam!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800621
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800621,
					"content": "#„... Der geheimnisvolle Besucher, der {F#der}{M#dem} Reisenden geholfen hatte, verschwand spurlos und die mechanische Bestie wurde von den Kristallen in Stücke gerissen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
