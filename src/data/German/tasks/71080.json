						710800616
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800616,
					"content": "„... Der tiefschwarze Nebel kam wie eine Lawine herunter und löste sich auf und die beiden verschwanden aus dem Abgrund, auf dem gleichen Weg wie sie gekommen waren ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
