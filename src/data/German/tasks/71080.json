			"dialogs": [
				{
					"id": 710800634,
					"content": "#Die Geschichte über die Suche nach {F#meinem Bruder}{M#meiner Schwester} ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800635
					]
				},
				{
					"id": 710800635,
					"content": "Du erzählst Taliesin von deinen bisherigen Erlebnissen ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800636
					]
				},
				{
					"id": 710800636,
					"content": "Interessant, interessant ... Das vergessene alte Reich, das nicht anerkannte Opfer ... die ungerechte Strafe für den Sturz in die Unwissenheit ... Ein sehr großes Thema, eine sehr große Geschichte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800637
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800637,
					"content": "Und solche Geschichten sind die Ereignisse, die du auf deinen Abenteuern erlebst und die für deine Ziele relevant sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800638
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800638,
					"content": "Vielen Dank für deine Geschichten, ich werde sie aufschreiben. Aber ich werde sie vorerst nicht zu einem Gedicht zusammenfassen ... Denn es ist nur ein winziges Fragment des Epos, das von dir handelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800639
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800639,
					"content": "Ich werde deine Geschichte nicht mit meinen geringen Talent schmälern ... Aber bitte erzähl mir, wenn du deine eigene Reise abgeschlossen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800640
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800640,
					"content": "Ich habe das Gefühl, dass ich an diesem Tag das Privileg haben werde, das größte aller Heldenepen zu hören ... und das von keinem Geringeren als dir erzählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
