				"points": []
			},
			"dialogs": [
				{
					"id": 710800701,
					"content": "Danke, dass du mir geholfen hast, dieses Epos zu schreiben ... Ah, ja. Bitte nimm diese Kopie meines Manuskripts als Dankeschön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800702
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800702,
					"content": "Puh ... Das ist der erste Entwurf eines epischen Gedichts, das meine Gefühle und Ambitionen enthält. Ich gebe ihn dir heute als kleine Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
		{
			"id": 7108008,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
