				"objectNames": [
					"Taliesin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710800601,
					"content": "#Es könnte ein wenig plötzlich für dich sein, {F#meine Heldin}{M#mein Held}, aber darf ich ein oder zwei Geschichten von dir lernen und sie in Gedichte für die Barden der späteren Generationen schreiben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800602,
						710800603
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800602,
					"content": "Wenn es nur darum geht, eine Geschichte zu erzählen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800604
					]
				},
				{
					"id": 710800604,
					"content": "Es wäre toll, wenn du ja sagen könntest! Ich bin ganz Ohr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800603,
					"content": "Wenn ich etwas habe, dann sind das Geschichten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800604
					]
				}
			]
		},
		{
