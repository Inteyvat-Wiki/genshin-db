				{
					"id": 710800617,
					"content": "Die Geschichte des blauen Kristalls in den Tiefen der Großen Kluft ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800618
					]
				},
				{
					"id": 710800618,
