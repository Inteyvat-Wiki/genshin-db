			"dialogs": [
				{
					"id": 706810301,
					"content": "Puh ... Endlich bin ich gerettet ... Vielen, vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810302
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810302,
					"content": "Ich heiße Gesine, wie ihr seht, bin ich eine Abenteurerin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810303
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810303,
					"content": "#Ihr seid so geschickt, ihr seid bestimmt keine gewöhnlichen Leute! Seid ihr vielleicht edle {F#Ritterinnen}{M#Ritter} oder {M#Helden}{F#Heldinnen} auf den Reisen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810304,
						706810305
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810304,
					"content": "#Ich bin nur {F#eine Reisende}{M#ein Reisender} auf der Durchreise.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810309
					]
				},
				{
					"id": 706810309,
					"content": "#Paimon ist Paimon und {M#er}{F#sie} heißt {NICKNAME} und ist Mitglied der Abenteurergilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810310,
					"content": "Ihr seid also auch Abenteurer! Wie bewundernswert! Ihr müsst sehr erfahren sein, da ihr diese Monster so leicht besiegen könnt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810311
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810311,
					"content": "Anders als ich, im Training kenne ich zwar die Bewegungen, aber im echten Kampf habe ich zwei linke Hände ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810312
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810312,
					"content": "Muss ich denn wirklich noch drei bis fünf Jahre trainieren, wie mein Ausbilder meint? Aber mit leeren Händen zurückkehren ist auch peinlich ... *seufz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810313
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810313,
					"content": "Ach, das ist wahrscheinlich nur eine Frage der Erfahrung. Wir haben auch viele Kämpfe durchgemacht, um so gut zu werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810314,
						706810318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810314,
					"content": "Zuerst musst du immer einen kühlen Kopf bewahren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810315
					]
				},
				{
					"id": 706810315,
					"content": "Ja, Neulinge bekommen im Kampf oft Panik und können ihre eigentliche Stärke nicht nutzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810316,
					"content": "Auch wenn der Gegner stark aussieht, beobachte ihn ruhig und finde seine Schwächen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810317,
					"content": "So kannst du den Kampf ziemlich schnell für dich entscheiden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810320,
					"content": "So ist das also ... Kein Wunder, dass ihr so erfahren seid! Ich sollte wohl auf Reisen weiter an meinen Fähigkeiten feilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810321
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810321,
					"content": "Bist du auch gerade auf einer Reise?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810322
					]
				},
				{
					"id": 706810322,
					"content": "Ja ... Ich möchte <color=#00E1FFFF>Liyue</color> besuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810323
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810323,
					"content": "Habt ihr von den Kampfkünsten in Liyue gehört? Man sagt, sie können über Dächer springen, Wände hochlaufen, sind unverwundbar und schneiden Eisen wie Butter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810324
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810324,
					"content": "Wenn ich ein paar Tricks von einem Meister lernen könnte, wären zukünftige Abenteuer viel einfacher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810325
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810325,
					"content": "Aber um ehrlich zu sein, obwohl ich schon eine Weile in der Abenteurergilde bin, ist das meine erste weite Reise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810326
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810326,
					"content": "*seufz* Kaum war ich aus der Stadt, haben mich Monster angegriffen. Schaffe ich es wirklich bis nach Liyue ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810327,
						706810328
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810327,
					"content": "Wir wollen auch nach Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810329
					]
				},
				{
					"id": 706810329,
					"content": "Wirklich? Sucht ihr etwa auch nach einem großen Meister?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810330
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810330,
					"content": "So ist es auch wieder nicht. Aus bestimmten Gründen reisen wir durch verschiedene Länder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810331,
					"content": "Wir wissen zwar noch nicht viel über Liyue, aber wir wollen es auf jeden Fall besuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810332,
					"content": "Da wir das gleiche Ziel haben, können wir zusammen gehen und uns gegenseitig helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810333,
					"content": "Waah, mit so erfahrenen Leuten losziehen ... Meine Reise sieht auf einmal viel hoffnungsvoller aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810334
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810334,
					"content": "Lasst mich vorangehen. Ich habe die Karte genau studiert, bevor ich losgegangen bin. Wir werden uns nicht verirren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810328,
					"content": "Willst du dich uns anschließen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810329
					]
				},
				{
					"id": 706810318,
					"content": "Außerdem ist es entscheidend, die Situation richtig zu beurteilen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810319
					]
				},
				{
					"id": 706810319,
					"content": "Ja, wenn du merkst, dass der Feind überlegen ist, ist ein Rückzug besser. Weiterkämpfen kann gefährlich sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810305,
					"content": "Ich kann meine Identität nicht preisgeben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810306
					]
				},
				{
					"id": 706810306,
					"content": "Verstanden! Du hast sicher einen geheimen Auftrag und musst diskret handeln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810307
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810307,
					"content": "Jepp, so ungefähr ist es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810308
					]
				},
				{
					"id": 706810308,
					"content": "Ach, hör auf, so geheimnisvoll zu tun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810309
					],
					"speakerTitle": "Paimon"
				}
			]
		},
