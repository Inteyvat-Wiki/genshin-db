				{
					"id": 706811214,
					"content": "Dann bis zum nächsten Mal, wenn das Schicksal es will.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706811216
					]
				},
				{
					"id": 706811215,
					"content": "Mögen deine Wünsche in Erfüllung gehen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706811216
					]
				},
				{
					"id": 706811216,
					"content": "Ja, ebenfalls! Ich wünsche euch auch eine erfolgreiche Reise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811217
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706811217,
					"content": "Gesine winkt euch zum Abschied nach.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706811218
					]
				},
				{
					"id": 706811218,
					"content": "Da wir schon mal hier sind, lass uns die Gegend erkunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706811219,
					"content": "Vielleicht erleben wir etwas Spannendes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7068131,
			"completionStepIds": [
				7068103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
