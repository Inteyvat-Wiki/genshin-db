				]
			},
			"dialogs": [
				{
					"id": 706810401,
					"content": "Entschuldigung, könnt ihr hier einen Moment warten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810402
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810402,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810403
					]
				},
				{
					"id": 706810403,
					"content": "Hast du etwas vergessen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810404,
					"content": "Nein, aber der Karte zufolge verlassen wir gleich Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810405
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810405,
					"content": "Wer weiß, wann ich wieder zurückkomme ... Mein Ausbilder wird wahrscheinlich ausrasten, wenn er den Brief sieht, den ich hinterlassen habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810406,
						706810407
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810406,
					"content": "Du hast deinen Ausbilder schon mal erwähnt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				},
				{
					"id": 706810408,
					"content": "Ja ... Als er gerade ein Abenteurer geworden war, wurde er draußen von einem Mitachurl angegriffen und mit einer Axt bewusstlos geschlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810409
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810409,
					"content": "Zum Glück hat ein vorbeikommender Ritter ihn gerettet und zurückgebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810410
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810410,
					"content": "Er war ziemlich beschämt und beschloss, seine Fähigkeiten in der Stadt bis zur Perfektion zu trainieren, bevor er wieder auf Abenteuer ging. Das dauerte zehn Jahre ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810411
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810411,
					"content": "Er sagt immer, die Grundlagen sind das Wichtigste, aber ich kann es nicht mehr ertragen, jeden Tag auf Holzpfähle einzuschlagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810412
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810412,
					"content": "Also bin ich heimlich allein auf Reisen gegangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810413,
						706810414
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810413,
					"content": "Werde stärker und kehre dann zurück.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810415,
					"content": "Ja, genau das habe ich auch gedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810416
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810416,
					"content": "Oh, mir ist etwas eingefallen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810417
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810417,
					"content": "Gesine holte Löwenzahnsamen aus ihrem Rucksack, legte sie auf ihre Handfläche, murmelte etwas und ließ die Samen im Wind verwehen ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810418
					]
				},
				{
					"id": 706810418,
					"content": "Unseren Bräuchen zufolge können Löwenzahnsamen Wünsche tragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810419
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810419,
					"content": "Ich habe mir gewünscht, dass ich auf dieser Reise meine Ziele erreiche und dass mein Ausbilder mich versteht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810420
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810420,
					"content": "Der Gott des Windes hat deinen Wunsch sicher gehört.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810421
					]
				},
				{
					"id": 706810421,
					"content": "Ja! Dann lasst uns weitergehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810414,
					"content": "Erreiche etwas, das er anerkennt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810407,
					"content": "Ist er auch ein Abenteurer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				}
			]
		},
		{
			"id": 7068105,
			"completionStepIds": [
				7068105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
