							352.074
						],
						"pointId": 9408
					},
					{
						"sceneId": 3,
						"position": [
							924.103,
							258.97,
							353.309
						],
						"pointId": 9409
					}
				]
			},
			"dialogs": [
				{
					"id": 706819905,
					"content": "Gesine fragt den Verwalter, was hier auf der Speisekarte steht und bestellt mehrere Gerichte, die ebenso teuer wie berühmt sind ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 706810801,
					"content": "Ich habe gehört, dass sich die Küche von Liyue auf drei Dinge konzentriert: das Aussehen, das Aroma und den Geschmack! Sie sieht wirklich auch so anders aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810802
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810802,
					"content": "Schon der Anblick bringt Paimon zum Sabbern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810803,
					"content": "Ihr alle genießt ausgiebig die kulinarischen Köstlichkeiten ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810804
					]
				},
				{
					"id": 706810804,
					"content": "Boah, das hier ist lecker, und das da erst ... Paimon platzt gleich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810805,
						706810806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810805,
					"content": "Das war gut!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810806,
					"content": "Die Müdigkeit der Reise ist wie weggeblasen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810807,
					"content": "Danke, dass ihr mich den ganzen Weg begleitet habt. Ohne eure Hilfe hätte ich es niemals so einfach hierhergeschafft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810808
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810808,
					"content": "Die Leute im Gasthaus sagen, dass es von hier aus nicht mehr weit bis nach <color=#00E1FFFF>Liyue</color> ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810809
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810809,
					"content": "Ich werde hier ein paar Tage ausruhen und mich bei anderen Reisenden umhören, wie ich einen legendären Meister finden kann, bevor ich entscheide, wohin ich weiterziehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810810
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810810,
					"content": "Auch wenn ich das Reisen mit euch wirklich genieße, möchte ich eure Zeit nicht weiter beanspruchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810811
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810811,
					"content": "Ich will hart daran arbeiten, meine Kräfte zu stärken, und als Abenteurerin so großartig wie ihr zu werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810812
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810812,
					"content": "Hehe, auch wenn wir nicht lange zusammen unterwegs waren, hat es uns viel Spaß gemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810813,
					"content": "Ich hoffe, wir sehen uns irgendwann irgendwo wieder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810814,
						706810815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810814,
					"content": "Dann bis zum nächsten Mal, wenn das Schicksal es will.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810815,
					"content": "Mögen deine Wünsche in Erfüllung gehen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810816,
					"content": "Ja, ebenfalls! Ich wünsche euch auch eine erfolgreiche Reise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810817
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810817,
					"content": "Gesine winkt euch zum Abschied nach.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810818
					]
				},
				{
					"id": 706810818,
					"content": "Da wir schon mal hier sind, lass uns die Gegend erkunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810819,
					"content": "Vielleicht erleben wir etwas Spannendes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810820,
					"content": "Gesine hat gesagt, dass <color=#00E1FFFF>Liyue</color> gleich da vorn ist. Lass uns dort auch mal vorbeischauen, wenn wir Zeit haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
