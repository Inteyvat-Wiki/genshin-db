						"stepId": 7068105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gesine"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1574.471,
