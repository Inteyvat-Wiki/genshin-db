							207.178
						],
						"pointId": 300201051
					},
					{
						"sceneId": 3,
						"position": [
							1575.554,
							227.66,
							205.588
						],
						"pointId": 9405
					},
					{
						"sceneId": 3,
						"position": [
							1576.451,
							227.659,
							206.559
						],
						"pointId": 9406
					}
				]
			},
			"dialogs": [
				{
					"id": 706810501,
					"content": "Da vorn ist wohl das <color=#00E1FFFF>Dihua-Moor</color>, oder? So schön, so eine Landschaft gibt es in Mondstadt nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810502
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810502,
					"content": "Es war definitiv die richtige Entscheidung, auf Reisen zu gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810503
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810503,
					"content": "Ach, richtig! Machen wir doch bei der Gelegenheit hier ein Foto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				}
			]
		},
		{
			"id": 7068106,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
