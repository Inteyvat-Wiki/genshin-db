				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3840401,
					"content": "Bar... Venti, passt gut auf Euch auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840402
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840402,
					"content": "Haha, du hast sicher nicht erst jetzt herausgefunden, wer ich wirklich bin, Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840403
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840403,
					"content": "Dennoch danke ich dir, dass du weiter diesen Namen verwendest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840404,
					"content": "Wie sieht die heilige Leier aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840405
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840405,
					"content": "Kann man sie noch spielen? Oder muss man sie vielleicht mit Tränen reparieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840406
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840406,
					"content": "Uff ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840407,
					"content": "In diesem Zustand ... bringt eine Reparatur auch nichts mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840408,
						3840410
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840408,
					"content": "Wir können den Abgrundmagier nicht so davonkommen lassen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3840409
					]
				},
				{
					"id": 3840409,
					"content": "Du hast recht. Wenn wir die Ursache des Problems nicht angehen, können wir Dvalin auch nicht von seinem Schmerz befreien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840413
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840413,
					"content": "Dann werde ich unsere Kundschafter ihn aufspüren lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840414
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840414,
					"content": "Nicht nötig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840415
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840415,
					"content": "Wieso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840416
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840416,
					"content": "Vor Kurzem habe ich persönlich einen in den Ruinen eines Tempels der Vier Winde ausradiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840417
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840417,
					"content": "Was? Wann denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840418,
					"content": "Wenn Ihr diese Monster aufspüren wollt, werde ich meine Kontakte nutzen. Ich kenne da Mittel und Wege, um an Informationen zu kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840419
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840419,
					"content": "Diluc ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840420,
					"content": "Zwar verachtet er den Ritterorden. Mondstadt beschützt er aber auf seine eigene Weise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840421,
					"content": "Oho, unsere kleine Paimon klingt plötzlich so anders!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840422
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840422,
					"content": "Hmpf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840423
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840423,
					"content": "Wartet einfach, bis ich mich melde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840424
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840424,
					"content": "Ich werde ihnen verständlich machen, dass selbst der Orden des Abgrunds ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840425
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840425,
					"content": "in Mondstadt nicht tun und lassen kann, was er will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840410,
					"content": "Dvalin ist in großer Gefahr ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3840411
					]
				},
				{
					"id": 3840411,
					"content": "Zuerst sollten wir dem Rädelsführer die Rechnung überreichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840412
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840412,
					"content": "Wenn wir die Ursache des Problems nicht angehen, können wir Dvalin auch nicht von seinem Schmerz befreien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840413
					],
					"speakerTitle": "Diluc"
				}
			]
		}
	]
