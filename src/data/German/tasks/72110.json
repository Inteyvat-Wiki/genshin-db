	"talks": [
		{
			"id": 7211001,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iwakura Kouzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100101,
					"content": "Warum habe ich die Trainings-Schule verlassen, um Kujou anzuleiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100102
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100102,
					"content": "Yanagiha und Okazaki, sowie Mifune ... warum haben sie mich alle verlassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iwakura Kouzou"
				}
			]
		},
		{
			"id": 7211002,
			"completionStepIds": [
				7211015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211007",
							"3"
						],
						"stepId": 7211007,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211015",
							"2"
						],
						"stepId": 7211015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Okazaki Toraemon",
					"Yanagiha Arashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100201,
					"content": "... Jetzt fehlt nur noch die Klinge von Iwakura Kouin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100202
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100202,
					"content": "Der angestammte „Hakuen Michimitsu Amenoma“ des Iwakura-Klans, hm ... Sag mal, erinnerst du dich, als du und Kunihiko adoptiert wurdet, während Meister Eiin nicht hinsah ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100203
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100203,
					"content": "Wir sind bereits vertrieben worden. Es gibt keinen Grund, ihn „Meister“ zu nennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100204
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100204,
					"content": "Aber Okazaki ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100205
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100205,
					"content": "„Wenn du Zuneigung und Rechtschaffenheit auf einer Waage abwägst, muss ein echter Schwertkämpfer den Weg der Rechtschaffenheit gehen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100206
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100206,
					"content": "Da der Meister das gesagt hat, bedeutet das, dass er nicht bereit war, uns zu vertreiben, aber keine andere Wahl hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100207
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100207,
					"content": "Natürlich war er unwillig. Aber da er sich bereits entschieden hat, das Schwert des Shougun zu werden und das Augenhatz-Dekret auszuführen, können wir nur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100208
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100208,
					"content": "Wir können nur unseren eigenen, rechtschaffenen Weg wählen. Schließlich „muss ein echter Schwertkämpfer den Weg der Rechtschaffenheit gehen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100209
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100209,
					"content": "Und doch wurde Meisters eigene Rechtschaffenheit am Ende besiegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100210
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100210,
					"content": "Das ist richtig. Wir müssen sie alle rächen. Kunihiko, die anderen - sogar Iwakura Kouin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100211
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100211,
					"content": "Das ist die Gerechtigkeit von vertriebenen Schülern wie uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100212
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100212,
					"content": "Das muss auch der Segen des Meisters sein. Unser erstes Objekt der Rache kam zu uns, einfach so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100213
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100213,
					"content": "#Du hast recht. Du musst {NICKNAME} sein. Ich habe von deiner Geschichte gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100214
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100214,
					"content": "In der Welt der Schwertkämpfer kann nur Blut das Blut reinigen. Ich nehme an, du bist bereit, dich dem Iwakura-Stil Menkyo Kaiden zu stellen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Okazaki Toraemon"
				}
			]
		},
		{
			"id": 7211003,
			"completionStepIds": [
				7211014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211014",
							"2"
						],
						"stepId": 7211014,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iwakura Kouzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100301,
					"content": "Warum habe ich die Trainings-Schule verlassen, um Kujou anzuleiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100302
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100302,
					"content": "Yanagiha und Okazaki, sowie Mifune ... warum haben sie mich alle verlassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100303
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100303,
					"content": "Ich bin den Schülern des Iwakura-Stils begegnet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100304
					]
				},
				{
					"id": 721100304,
					"content": "Ist das so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100305
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100305,
					"content": "Gibt es immer noch Leute, die behaupten, von Iwakura zu sein? Ihr Meister war doch so eine inkompetente Seele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100306
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100306,
					"content": "Ich bin Iwakura Kouzou. Du könntest mich als Schwertlehrer hier betrachten. Und wer magst du sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100307
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100307,
					"content": "#Ich bin {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100308
					]
				},
				{
					"id": 721100308,
					"content": "Mifune, Tanba ... hast du sie gesehen? Die Okazaki-Brüder auch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100309
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100309,
					"content": "Ah, ja, da ist auch noch Katayama. Er hat es immer geliebt, sich Namen für Duelle auszudenken, bevor sie beginnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100310
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100310,
					"content": "Er würde sagen: „Wenn ich in der Zukunft ein echter Meisterschwertkämpfer werde, dann können all diese Duelle in Geschichten geschrieben werden.“ Hahaha, so ein Blödsinn ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100311
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100311,
					"content": "Richtig, und wir dürfen Shimada nicht vergessen, der die gesamte „Eiin“- und „Kouin“-Ära mit dem Training verbracht hat, aber nie über den Rang eines Shoden hinausgekommen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100312
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100312,
					"content": "Sie flohen und wurden zu Banditen, weil sie das Augenhatz-Dekret des Shougun nicht verstehen konnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100313
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100313,
					"content": "Ich vermisse die gute alte Zeit, in der ich ihnen beigebracht habe, wie man ein Schwert führt. Warum in aller Welt habe ich die Schule geschlossen und bin der Armee beigetreten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100314
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100314,
					"content": "#{NICKNAME}, wie sind ihre Fähigkeiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100315,
						721100316
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100315,
					"content": "Es tut mir leid, das zu sagen, aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100317
					]
				},
				{
					"id": 721100317,
					"content": "Wirklich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100318
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100318,
					"content": "#Also, {NICKNAME}, wer ist dein Meister? Ist es Domon? Oder Shousen? Oder vielleicht Narukami selbst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100319
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100319,
					"content": "Ich denke, ich könnte als „Autodidakt“ betrachtet werden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100320
					]
				},
				{
					"id": 721100320,
					"content": "Oh, ich verstehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100321
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100321,
					"content": "Es scheint, als ob der Iwakura-Stil unter meiner Aufsicht nachgelassen hat. Mein Schüler war in der Lage, einen selbst erlernten Schwertkämpfer zu besiegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100322
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100322,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100323
					]
				},
				{
					"id": 721100323,
					"content": "Ist das so? Ich verstehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100324
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100324,
					"content": "Was auch immer deine Schule des Schwertkampfes ist, es spielt keine Rolle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100325
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100325,
					"content": "Es scheint, als ob der Iwakura-Stil unter meiner Aufsicht nachgelassen hat. Keiner meiner Schüler war in der Lage, jemanden zu besiegen, der nicht bereit ist, den Namen seiner Schule zu verraten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100326
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100326,
					"content": "Ich bin wirklich ein inkompetenter Meister des Iwakura-Stils. Als Schwertkämpfer nennt man mich Iwakura Kouin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100327
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100327,
					"content": "Obwohl ich den Schlüssel zu unserer geheimen Klingentechnik vergessen habe und mein Göttliches Auge dem allmächtigen Shougun übergeben wurde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100328
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100328,
					"content": "... Wenn du mich fragst, ob ich immer noch meine Schüler rächen will, die meine Erniedrigung nicht ertragen konnten und den Weg der bösen Geister einschlugen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100329
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100329,
					"content": "... Doch die inkompetent waren und gegen dich verloren haben, dann habe ich noch etwas von diesem Feuer in mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100330
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100330,
					"content": "Dieser Raum ist zu klein. Es wäre nicht einmal für dich ein Platz da, um deine Schwertkunst zu zeigen. Komm, folge mir nach unten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100316,
					"content": "Ich habe eine ganze Menge gelernt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100317
					]
				}
			]
		}
	]
}