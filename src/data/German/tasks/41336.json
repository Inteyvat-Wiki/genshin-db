					"nextDialogs": [
						413360907
					],
					"speakerTitle": "Bibo"
				},
				{
					"id": 413360907,
					"content": "„Tagsüber versieht er sein Geschäft wie ein ...“ Was?! Was willst du damit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360908
					],
					"speakerTitle": "Bibo"
				},
				{
					"id": 413360908,
					"content": "Was meinst du? Passt wunderbar, oder? Wenn es dir auch gefällt, kann ich dir eine zweite Laterne basteln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360909
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360909,
					"content": "Ähem ... Nicht nötig, danke! Ich habe noch anderes zu erledigen ...",
