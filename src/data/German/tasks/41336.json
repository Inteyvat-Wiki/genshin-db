					"nextDialogs": [
						413360815
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360815,
					"content": "Lass hören, vielleicht kann ich helfen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360816
					]
				},
				{
					"id": 413360816,
					"content": "Also, es geht so: „Mit Waren so frisch, dass es alle macht froh ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360817
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360817,
					"content": "„Verkauft keiner so wie Bibo“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360818
					]
				},
				{
					"id": 413360818,
					"content": "Oh! Das ist gut, aber wie steht es um den Titel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360819
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360819,
					"content": "Wie wäre „Bibos Markt am Meer“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360820
					]
				},
				{
					"id": 413360820,
					"content": "„Mit Waren so frisch, dass es alle macht froh, verkauft keiner so wie Bibo“. Der Titel ist „Bibos Markt am Meer“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360821
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360821,
					"content": "Tagsüber versieht er sein Geschäft wie eine gerissenes Schlitzohr, „doch ist der Tag vorbei, ist das alles einerlei.“ Der Titel ist „Ein famoser Gefährte.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360822
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360822,
					"content": "Hmm, im direkten Vergleich klingt deine Version leicht überlegen. Mein Vers ist etwas zu wild, so einen Text findet man gewöhnlich nicht auf einer Laterne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360823
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360823,
					"content": "Also gut! Ich schreibe unseren Vers auf die Laterne, dann überreichen wir sie.",
