					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360812,
					"content": "Das wird nicht klappen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360813
					]
				},
				{
					"id": 413360809,
					"content": "Nein, du solltest wirklich nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360810
					]
				},
