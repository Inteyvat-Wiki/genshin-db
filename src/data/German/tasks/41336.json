			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Werkmeister Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360501,
					"content": "Ah, hallo Linling. Brauchst du etwas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360502
					],
					"speakerTitle": "Werkmeister Xiao"
				},
				{
					"id": 413360502,
					"content": "#Du hast mich um ein paar Verse für deine Laterne gebeten, nicht wahr? Nun, {F#die Reisende}{M#der Reisende} und ich haben alles vorbereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360503
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360503,
					"content": "Guck, wir haben sie sogar auf der Laterne eingraviert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360504
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360504,
					"content": "Oh, vielen Dank. Lass mich mal sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360505
					],
					"speakerTitle": "Werkmeister Xiao"
				},
				{
					"id": 413360505,
					"content": "„Die Jungen trifft sein bohrend harter Blick“, „Der Wind weht, während er friedlich schlummert wie ein Bär im Gebirge.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360506
					],
					"speakerTitle": "Werkmeister Xiao"
				},
				{
					"id": 413360506,
					"content": "„Friedlich wie ein schlummernder Berg“ ... Hehe, ziemlich gut, Dankeschön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360507
					],
					"speakerTitle": "Werkmeister Xiao"
				},
				{
					"id": 413360507,
					"content": "Gern geschehen, Werkmeister Xiao. Es gibt noch einen weiteren Vers von mir. Hier, ich lese ihn vor ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360508,
						413360509
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360508,
					"content": "Wir sollten besser aufbrechen! Wir haben noch andere Aufträge, weißt du ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360510
					]
				},
				{
					"id": 413360510,
					"content": "Oh, stimmt! Also, unser nächster Gönner ist Degui. Auf geht’s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360511
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360511,
					"content": "Die Verse für Degui werden mein bislang bestes Werk! Sobald wir da sind, erzähle ich dir mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360509,
					"content": "Äh, wir müssen noch weitere Laternen ausliefern!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360510
					]
				}
			]
		},
		{
			"id": 4133606,
			"completionStepIds": [
				4133606
