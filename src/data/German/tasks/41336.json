					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360101,
					"content": "Hmm, ich sollte wohl danach suchen, um inspiriert zu werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360102
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360102,
					"content": "Was machst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360103
					]
				},
				{
					"id": 413360103,
					"content": "Ich helfe jemanden dabei, einen passenden Text für eine Laterne zu verfassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360104
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360104,
					"content": "Während des Laternenrituals lässt jeder Laternen aufsteigen, nicht wahr? Man schreibt ebenfalls darauf. Wünsche, Segen und dergleichen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360105
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360105,
					"content": "Passend zur festlichen Stimmung möchten manche ihren Wünschen und Segen etwas verleihen ... wie soll ich sagen ... du weißt schon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360106
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360106,
					"content": "Etwas literarisches „Flair“, verstehst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360107
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360107,
					"content": "Bibo, Werkmeister Xiao und Degui haben mich alle darum gebeten, ihre Festwünsche für die Laternen mit einer literarischen Note zu versehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360108
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360108,
					"content": "Doch solange ich hier eingesperrt bin, fällt mir bestimmt nichts Anständiges ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360109
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360109,
					"content": "Daher wollte ich zuerst die Laternen vorbereiten, um mir dann die Auftraggeber genauer anzusehen. So kann ich alle Wünsche besser an die Bedürfnisse jeder Person anpassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360110
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360110,
					"content": "Doch wie soll ich diese Laternen bloß flechten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360111,
						413360112
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360111,
					"content": "Ich werde das machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360113
					]
				},
				{
					"id": 413360113,
					"content": "Oh, das würdest du tun? Dann fertige bitte drei Laternen für mich an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360114
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360114,
					"content": "Sobald sie bereit sind, sehen wir uns unsere Auftraggeber an, um uns für die Wünsche inspirieren zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360115
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360115,
					"content": "Hehe, ich habe bereits einige Ideen, sie brauchen bloß ein wenig ... kreative Würze!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360112,
					"content": "Wenn ich eines beherrsche, dann Laternen zu flechten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360113
					]
				}
			]
		},
