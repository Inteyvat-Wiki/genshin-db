			"dialogs": [
				{
					"id": 413360601,
					"content": "Degui ist da drüben. Beobachten wir ihn kurz, in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360602
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360602,
					"content": "Kennst du Degui? Er handelt in seinem Laden mit Getränken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360603
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360603,
					"content": "Ich habe auch schon über den Text für ihn nachgedacht. Hör zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360604
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360604,
					"content": "„Dreibecherrausch, sagen die Leute“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360605,
						413360606
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360605,
					"content": "Na ja ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360607
					]
				},
				{
					"id": 413360607,
					"content": "„Doch nach drei Bechern ist dir übel ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360608
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360608,
					"content": "Oho ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360609
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360609,
					"content": "So weit, so gut ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360610
					]
				},
				{
					"id": 413360610,
					"content": "Der Titel lautet ... „Trotzdem ein guter Mann“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360611,
						413360612
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360611,
					"content": "Warte eine Sekunde!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360613
					]
				},
				{
					"id": 413360613,
					"content": "Nicht? Nun, es gibt noch eine Alternative, aber ich weiß nicht, wie sie weitergehen soll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360614
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360614,
					"content": "Willst du es mal versuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360615
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360615,
					"content": "Der erste Vers lautet so: „Die Schalen sind voll mit Wein ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360616
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360616,
					"content": "Wie wär’s mit: „Und dazu gibt es Suppe mit Klößen, so fein.“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360617
					]
				},
				{
					"id": 413360617,
					"content": "Oh, das passt wunderbar. Und der Titel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360618
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360618,
					"content": "„Alles, was flüssig ist“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360619
					]
				},
				{
					"id": 413360619,
					"content": "„Die Schalen sind voll mit Wein, Und dazu gibt es Suppe mit Klößen, so fein.“ „Alles, was flüssig ist“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360620
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360620,
					"content": "Nicht übel, gar nicht übel. Du besitzt Talent als Versschmied. Ich schreibe es jetzt auf die Laterne ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360621
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360621,
					"content": "So! Jetzt können wir die Laterne Degui überreichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360612,
					"content": "Das ist alles andere als gut!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360613
					]
				},
				{
					"id": 413360606,
					"content": "Klingt so weit gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360607
					]
				}
			]
		},
