					"content": "Oh nein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360810
					]
				},
				{
					"id": 413360810,
					"content": "Oh, und der Titel ist ... „Ein famoser Gefährte“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360811,
						413360812
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360811,
					"content": "Nein, bitte hör auf!",
