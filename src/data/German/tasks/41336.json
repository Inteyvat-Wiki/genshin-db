						413360702
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 413360702,
					"content": "#Du hast mich um ein paar Verse für deine Laterne gebeten, nicht wahr? Nun, {F#die Reisende}{M#der Reisende} und ich haben alles vorbereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360703
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360703,
					"content": "Wir haben es für dich sogar auf die Laterne geschrieben ... Bitte sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360704
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360704,
					"content": "Oh, großartig! Vielen Dank. Lass mich mal sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360705
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 413360705,
					"content": "„Die Schalen sind voll mit Wein, Und dazu gibt es Suppe mit Klößen, so fein.“ „Alles, was flüssig ist“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360706
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 413360706,
					"content": "Liest sich wirklich gut, ja ... wirklich gut. Herzlichen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360707
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 413360707,
					"content": "#Gern geschehen. Bedanken wir uns bei {F#der Reisenden}{M#dem Reisenden} für all die Inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360708
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360708,
					"content": "Übrigens ist mir noch ein weiter Vers dazu eingefallen. Du kannst ihn später lesen, wenn du willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360709
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360709,
					"content": "Sicher! Vielen Dank, ihr beiden. Ich muss zurück, der Laden wartet.",
