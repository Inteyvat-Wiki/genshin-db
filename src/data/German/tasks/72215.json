			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"„Neko“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150101,
					"content": "Miau, miau, wann ist dieser Stein zu einem Ebenbild von mir geworden ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150102
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150102,
					"content": "Wie steht es um die Statue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150103
					]
				},
				{
					"id": 722150103,
					"content": "Der Steinmensch meint, dass er bald genug auf dem Stein herumgeklopft hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150104
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150104,
					"content": "Hibiki wird so glücklich sein, wenn sie wieder da ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150105
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150105,
					"content": "Hmm, ja. Dieser Stein ist gut. Aber wir müssen die Umgebung des Schreins ein wenig schmücken, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150106
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150106,
					"content": "Bitte hilf mir, diese runden klingelnden Metallkugeln rund um den Schrein aufzuhängen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150107
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150107,
					"content": "Diese Kugeln stammen von Hibiki. Wenn die Erinnerung nicht trügt, erhielt sie sie von Domeki, weil sie so gerne mit mir und den anderen Kindern spielte. Es war gar nicht leicht, sie wiederzufinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150108
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150108,
					"content": "Huch. Das sind ... Glöckchen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150109
					]
				},
				{
					"id": 722150109,
					"content": "„Glöckchen“? Ich weiß nicht genau, was das ist, aber Hibiki hat immer mit diesen Metallkugeln mit mir gespielt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150110
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150110,
					"content": "Sie hat die Metallkugeln immer auf den Boden gelegt und sie dann angestupst, sodass sie ganz weit wegrollten. Dabei haben sie immer geklingelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150111
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150111,
					"content": "Ich weiß immer noch nicht, was ihnen für ein Zauber innewohnte, aber das Geräusch hat mich und die anderen Katzen immer angelockt, um ihnen hinterherzujagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150112
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150112,
					"content": "Ich schlussfolgere, dass nur wenige Leute hier ihren Respekt erweisen, weil es dem Schrein derzeit noch an Metallkugeln fehlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150113
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150113,
					"content": "Deshalb bitte ich um deine Hilfe beim Aufhängen dieser Metallkugeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150114
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150114,
					"content": "Dann werden die Menschen das Klingeln der Metallkugeln hören und hierherkommen, um zu beten. Und sie werden nicht vom rechten Weg abkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150115
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150115,
					"content": "Das Spendenkästchen wird voller Mora sein und der Schrein wird blühen und gedeihen ... und Hibiki wird bei ihrer Rückkehr unheimlich glücklich sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150116
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150116,
					"content": "Deshalb hilf mir bitte, diese Metallkugeln rund um den Schrein aufzuhängen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150117
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150117,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150118
					]
				},
				{
					"id": 722150118,
					"content": "Vielen Dank, miau, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				}
			]
		},
		{
			"id": 7221502,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
