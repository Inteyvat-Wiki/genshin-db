			},
			"dialogs": [
				{
					"id": 722150201,
					"content": "Diese Metallkugeln werden mehr Menschen anziehen. Das wird Hibiki bestimmt gefallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				}
			]
		},
		{
			"id": 7221503,
			"completionStepIds": [
				7221503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221503",
							"2"
						],
						"stepId": 7221503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Neko“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150301,
					"content": "Hast du sie alle aufgehängt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150302
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150302,
					"content": "Alles erledigt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150303
					]
				},
				{
					"id": 722150303,
					"content": "Miau, miau, wunderbar! Jetzt wird der Schrein gleich nicht mehr so leer sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150304
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150305
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150305,
					"content": "Hmm. Warum sind die vielen Menschen immer noch nicht eingetroffen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150306,
						722150307
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150306,
					"content": "Ich glaube nicht, dass das so schnell geht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				},
				{
					"id": 722150308,
					"content": "Ah, ihr Menschen seid ein Rätsel. Na ja, du bist eine Ausnahme. Meine Wenigkeit durchschaut vieles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150309
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150309,
					"content": "Es sind zwar im Moment keine Menschen hier ... Aber wenigstens werden sich die kleinen Bengel nicht mehr verirren, miau, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150310
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150310,
					"content": "Der Steinmensch meint, dass der Stein bald fertig ist. Komm und sieh ihn dir an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150311
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150311,
					"content": "... Hmm, ja, da war noch was. Eine merkwürdige Sache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150312
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150312,
					"content": "Ich habe diese beiden grünen Menschen wegen Hibiki und Domeki gefragt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150313
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150313,
					"content": "Beide meinten, dass sie Hibiki nicht kannten oder etwas über sie wussten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150314
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150314,
					"content": "Aber der große grüne Mensch behauptete, dass er etwas über „Ako Domeki“ gelesen hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150315
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150315,
					"content": "Er murmelte etwas von „Banditen“ und „Beute“ ... Es klang fast so, als wäre Domeki ein Gauner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150316
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150316,
					"content": "Das kann aber nicht sein. Hibiki hat immer mit ihm gespielt, Domeki ist bestimmt kein Gauner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150317
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150317,
					"content": "Dieser Mensch hat bestimmt was falsch verstanden. Du bist wohl immer noch der verlässlichste Mensch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150318
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150318,
					"content": "Ah, wann wird Hibiki endlich zurückkommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722150307,
					"content": "So einfach ist das nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				}
			]
		}
	]
}