			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rafiq",
					"Qishan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230200101,
					"content": "... Also glaube ich, dass in diesem Bereich nicht viel Material eingespart werden kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200102
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200102,
					"content": "Sei unbesorgt. Die Stärke dieses Bereichs ist ausreichend. Ich habe es mehrfach durchgerechnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200103
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200103,
					"content": "Ach, ich habe dir doch gesagt, dass man viele Probleme nicht einberechnen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200104
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200104,
					"content": "Worüber streitet ihr euch?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200105
					]
				},
				{
					"id": 230200105,
					"content": "Oh, du bist es. Wir diskutieren gerade die Konstruktionsprobleme des Boots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200106,
					"content": "Ich habe bereits umfassende Berechnungen durchgeführt und ich kann garantieren, dass alle Bereiche stark genug sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200107,
					"content": "Aber Qishan denkt immer noch, dass die Stärke einiger Bereiche nicht ausreichend ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200108,
					"content": "Die „Stärke“, von der du sprichst, existiert nur in der Theorie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200109
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200109,
					"content": "Nachdem das Boot ausläuft, wird es großem Druck standhalten müssen und das wird sicherlich deutlich über diesen Zahlen liegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200110
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200110,
					"content": "Ich verstehe deine Argumente, aber ... aber mein Budget ist begrenzt ... Und ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200111
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200111,
					"content": "Wenn ich teureres Material kaufe, kann ich mir höchstens leisten, den Kiel fertigzustellen ... Ähm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200112,
					"content": "Wie auch immer! Lass uns erstmal meinem Plan für dieses Boot folgen. Ich habe bereits alle Materialien dafür gekauft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200113,
					"content": "#{F#Reisende}{M#Reisender}, würdest du mir helfen, einen Teil der Materialien zurückzubringen? Ich schaffe es einfach nicht allein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200114,
						230200115
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200114,
					"content": "Kein Problem!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200118
					]
				},
				{
					"id": 230200118,
					"content": "Ich bitte dich. Ich muss hier noch einige Berechnungen anstellen und werde die restlichen Materialien später zurückbringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200115,
					"content": "Qishan kennt sich auch mit Bootsbau aus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200116
					]
				},
				{
					"id": 230200116,
					"content": "Jawohl, sie rechnet manche Sachen schneller als ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200117
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200117,
					"content": "Ich habe keine Ahnung, warum sie nur eine Kellnerin sein will, wirklich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200118
					],
					"speakerTitle": "Rafiq"
				}
			]
		},
