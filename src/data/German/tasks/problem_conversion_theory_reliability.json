			"dialogs": [
				{
					"id": 230200201,
					"content": "Theoretisch sind die Zahlen, die Rafiq für die für den Rumpf erforderliche Materialstärke errechnet hat, korrekt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200202
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200202,
					"content": "Aber wenn das Boot wirklich ausläuft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200203
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200203,
					"content": "Vergiss es! Er wird bestimmt nicht auf mich hören ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qishan"
				}
			]
