			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huaqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411131201,
					"content": "Sterblicher! Bist auch du in das Reich der Qualen herabgestiegen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131202
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131202,
					"content": "Dieselbe Situation, die wir schon an den beiden anderen Orten beobachtet haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131203,
					"content": "He! Ist dieser hier zu irgendeinem Zeitpunkt aufgewacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131204,
					"content": "Nein, er hat allerdings einige Dinge im Schlaf gemurmelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131205
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 411131205,
					"content": "Was für Dinge denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131206,
					"content": "„So kalt!“, „Ich kann nicht mehr!“ ... Sowas halt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131207
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 411131207,
					"content": "Auch die Opfer davor haben gesagt, dass ihnen kalt sei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131208
					]
				},
				{
					"id": 411131208,
					"content": "An irgendeinem kalten Ort hoch in den Bergen ... Wo könnte das wohl sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oz"
				}
			]
		},
		{
			"id": 4111313,
			"completionStepIds": [
				4111313
