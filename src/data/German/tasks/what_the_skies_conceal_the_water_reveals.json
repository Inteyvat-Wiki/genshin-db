			},
			"dialogs": [
				{
					"id": 411130901,
					"content": "Das hier ist er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130902
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130902,
					"content": "Ich spüre eine unerwartete Menge an Elementarenergie in ihm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130903
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130903,
					"content": "Das tiefe Herz der Dunkelheit bricht über die Welt herein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130904
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130904,
					"content": "Was haben die Fatui damit vor? Ist dies die Elementarmacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130905,
					"content": "Möglich ... Aber wenn dem so wäre, dann würden sicherlich auch andere Lebensformen von der Energie des Meteoriten angezogen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130906
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130906,
					"content": "Lass uns das näher anschauen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4111310,
			"completionStepIds": [
				4111310
