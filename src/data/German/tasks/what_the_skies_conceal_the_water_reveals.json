					"Yang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411131301,
					"content": "He, ist dieser hier zu irgendeinem Zeitpunkt aufgewacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131302,
					"content": "Bis jetzt noch nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131303
					],
					"speakerTitle": "Yang"
				},
				{
					"id": 411131303,
					"content": "Also, hat er irgendetwas im Schlaf gesagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131304,
					"content": "Nu, da du es sagst ... Gestern hat er plötzlich geschrien; „So hoch!“ Wer weiß, wovon er geträumt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131305
					],
					"speakerTitle": "Yang"
				},
				{
					"id": 411131305,
					"content": "Wie hoch? Hoch wie ein schneebedeckter Berggipfel vielleicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131306,
					"content": "Ein finsterer Berg, dessen eisiger Gipfel hoch über dem Gebiet emporragt und eine böse Macht beherbergt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131307
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131307,
					"content": "Lass uns als Nächstes mit dem dort drüben sprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
