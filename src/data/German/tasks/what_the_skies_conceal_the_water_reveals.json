							"2"
						],
						"stepId": 4111314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kumpel Huang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411131401,
					"content": "Hallo, sind irgendwelche der Opfer erwacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131402,
					"content": "Komisch, dass du fragst! <color=#00E1FFFF>Gao der Sechste</color> ist just in diesem Augenblick erwacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131403
					],
					"speakerTitle": "Kumpel Huang"
				},
				{
					"id": 411131403,
					"content": "In Ordnung! Wir werden mit ihm sprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131404,
					"content": "Kein Problem, aber er ist gerade erst erwacht und noch sehr schwach. Wenn ihr ihn befragen müsst, dann seid bitte behutsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131405
					],
					"speakerTitle": "Kumpel Huang"
				},
				{
					"id": 411131405,
					"content": "Sei gegrüßt! Du hast dein Leiden überwunden und überlebt. Deine Herrscherin wird dich nun befragen-",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131406
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131406,
					"content": "Essen ... Ich brauche Essen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131407
					],
					"speakerTitle": "Gao VI."
				},
				{
					"id": 411131407,
					"content": "Bist du in Ordnung? Es hört sich an, als wärst du am Verhungern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131408,
					"content": "Argh ... Uff ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131409,
						411131410
					],
					"speakerTitle": "Gao VI."
				},
				{
					"id": 411131409,
					"content": "Worauf hast du Appetit? Du bekommst alles, was du dir wünschst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				},
				{
					"id": 411131411,
					"content": "Ich brauche ... etwas Traditionelles ... Hausmannskost ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131412
					],
					"speakerTitle": "Gao VI."
				},
				{
					"id": 411131412,
					"content": "Hausmannskost aus dem Qingce-Dorf? Das kann nur eines bedeuten: <color=#00E1FFFF>Bauernkost</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131410,
					"content": "Ich werde dir ein Gericht zubereiten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				}
			]
		},
		{
			"id": 4111315,
			"completionStepIds": [
				4111315
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111315",
							"2"
						],
						"stepId": 4111315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gao VI."
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411131101,
					"content": "Boah! Das hat mich doch ganz schnell wieder auf den Boden der Tatsachen gebracht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131102
					],
					"speakerTitle": "Gao VI."
				},
				{
					"id": 411131102,
					"content": "Hattest du einen Traum, während du geschlafen hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131103,
					"content": "Nur den anstrengendsten Traum meines gesamten Lebens!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131104
					],
					"speakerTitle": "Gao VI."
				},
				{
					"id": 411131104,
					"content": "Wirklich? Warum, was ist denn passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131105,
						411131107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131105,
					"content": "Warst du auf einem Berg?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131106
					]
				},
				{
					"id": 411131106,
					"content": "Ja ... Woher weißt du das? Ganz weit oben in den Bergen, auf dem höchsten Berg, den ich je gesehen habe ... Da war es eisig kalt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "Gao VI."
				},
				{
					"id": 411131109,
					"content": "Was hast du da getan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131110,
					"content": "Ich bin nicht sicher. Ich schien irgendwie ... besessen zu sein. Ich war von dem Gedanken besessen, den Berg hinaufzusteigen und zu versuchen, den Gipfel zu erreichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131111
					],
					"speakerTitle": "Gao VI."
				},
				{
					"id": 411131111,
					"content": "War da etwas Besonderes auf dem Gipfel oder was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131112,
					"content": "Wer weißt? Ehrlich gesagt fühlte es sich so an, als wäre ich in meinem Traum zu einer völlig anderen Person geworden. Frag mich nicht, warum, ich habe keinen Schimmer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131113
					],
					"speakerTitle": "Gao VI."
				},
				{
					"id": 411131113,
					"content": "Also warst nicht „du“ es, der den Berg hinaufsteigen wollte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131114
					]
				},
				{
					"id": 411131114,
					"content": "Es lässt sich schwer beschreiben ... Es ist, als würde man gesteuert, als würde jemand anderes einen auf den Gedanken bringen, den Berg zu erklimmen. Ich weiß, wie verrückt sich das anhört, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131115
					],
					"speakerTitle": "Gao VI."
				},
				{
					"id": 411131115,
					"content": "Ein Eindringling hat den Weg in die dunklen Tiefen deiner Seele gefunden!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131116
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131116,
					"content": "Ein Gedanke, der nicht autonom von einer Person gebildet wurde, sondern im Unterbewussten entstanden ist ... Ja, es deutet wirklich alles auf Gedankenkontrolle hin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131117,
						411131118
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411131117,
					"content": "Ich sollte inzwischen daran gewöhnt sein, aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131119,
					"content": "All die anderen Opfer, die wir getroffen haben, haben etwas von einem Gefühl der Kälte erzählt und von dem Bedürfnis, sich auszuruhen ... Sind sie auch alle auf den Berg gestiegen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131120,
					"content": "Wie können sie alle denselben Traum haben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131121
					]
				},
				{
					"id": 411131121,
					"content": "Paimon möchte gar nicht daran denken ... Wir müssen <color=#00E1FFFF>Mona</color> davon in Kenntnis setzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131118,
					"content": "Das, was ihr beiden sagt, gleicht sich nicht im Entferntesten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131107,
					"content": "Warst du draußen im Schnee?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131108
					]
				},
				{
					"id": 411131108,
					"content": "Hm, irgendwie schon. Auf einem schneebedeckten Berg, um genau zu sein. Er war riesig, und es war bitterkalt ... Sobald ich eingeschlafen bin, stand ich am Fuß des Berges.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "Gao VI."
				}
			]
		},
