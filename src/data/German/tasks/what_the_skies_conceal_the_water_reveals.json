				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130101,
					"content": "Hi Mona! Danke dir, wir haben es geschafft riesige Mengen an gefallenen Sternen loszuwerden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130102,
					"content": "Aha, guter Zeitpunkt. Es gibt etwas, das ihr für mich tun müsst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130103,
					"content": "Erinnerst du dich, dass ich gesagt habe, die gefallenen Sterne gehören zu jemandes Sternbild?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130104
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130104,
					"content": "Theoretisch ist es nicht möglich, dass Sterne, die wer weiß wie viele Lichtjahre entfernt sind, plötzlich zu Meteoriten werden und vom Himmel fallen. Es mag paradox sein, aber so ist es nun einmal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130105
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130105,
					"content": "Wenn wir dem ganzen auf den Grund gehen wollen, ist es der beste Weg, herauszufinden, wessen Konstellation es war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130106,
					"content": "Basierend auf dem, was du mir gesagt hast, scheint es, als wären alle Opfer der gefallenen Sterne in einen tiefen Schlaf gefallen. Und alle träumten von einem verschneiten Berg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130107,
					"content": "Wir wissen vielleicht nicht, welcher Berg es war, aber wir können sicher annehmen, dass es nicht Drachengrat war. Sonst hätte jemand ihn erkannt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130108,
					"content": "Hatte jeder sicher den gleichen Traum? Und wo genau waren sie in diesem Traum? Dies sind die Fragen, die wir beantworten müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130109,
					"content": "Ich muss Details zu den Träumen dieser Schläfer herausfinden. Je mehr Informationen wir haben, desto näher können wir der Wahrheit kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130110,
					"content": "Es scheint, wir sollten irgendwo hin gehen, wo es viele Menschen gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130111,
					"content": "So sollten wir einige weitere Opfer finden, die wir befragen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130112,
					"content": "Ich muss in einer ungestörten Umgebung bleiben. Ich werde die Nachforschungen dir überlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130113,
					"content": "Gibt es einen Ort, an dem wir noch nicht waren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130114,
					"content": "Es gibt <color=#00E1FFFF>Qingce-Dorf</color>, in Liyue ... Allerdings passt es üblicherweise nicht zu deinem Vorschlag „irgendwo, wo es viele Leute gibt“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130115
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130115,
					"content": "Ich glaube aber trotzdem, dass die Millelithen dieses Gebiet in einen Standort verwandelt haben, an dem Opfer medizinische Versorgung erhalten, so wie sie es beim Gasthaus Wangshu gemacht haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oz"
				}
			]
		},
		{
			"id": 4111302,
			"completionStepIds": [
				4111302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111302",
							"2"
						],
						"stepId": 4111302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130201,
					"content": "Hallo, wir sind aus der Abenteurergilde. Kannst du uns sagen, ob Qingce-Dorf von den gefallen Sternen getroffen wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130202,
					"content": "Abenteurer! Perfekt! Ich bin schon fast verzweifelt auf der Suche nach Helfern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130203
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130203,
					"content": "Diese Sterne fallen nun seit einigen Tagen vom Himmel. Und ich fange erst gar nicht davon an, wie viele Probleme das verursacht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130204
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130204,
					"content": "Wenn man in einem <color=#00E1FFFF>Feld</color> landet, traut sich niemand, etwas zu ernten, und wenn man am <color=#00E1FFFF>Eingang</color> landet, ist es ein Albtraum hinein und hinaus zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130205
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130205,
					"content": "Hast du irgendwelche Ideen, wie wir sie sicher loswerden können? Sie machen nur alles unmöglich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130206
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130206,
					"content": "Ich nehme an, das Qingce-Dorf war auch betroffen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130207
					]
				},
				{
					"id": 411130207,
					"content": "Ich denke, wir sollten ihm helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
