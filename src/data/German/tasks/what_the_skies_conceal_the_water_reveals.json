				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130301,
					"content": "Ich hoffe wirklich, da kannst uns mit den gefallenen Sternen helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		},
		{
			"id": 4111307,
			"completionStepIds": [
				4111307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111307",
							"2"
						],
						"stepId": 4111307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130701,
					"content": "Mona, wir haben etwas herausgefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130702,
					"content": "Ein Berg mit Eisspitze thront von weit über den Wolken drohend über der Welt ... Das ist der Ort, von dem diese aufstrebende Dunkelheit kommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130703
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130703,
					"content": "Berg mit Eisspitze? Ist das alles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130704
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130704,
					"content": "Es ist der gleiche Berg mit Eisspitze im Traum von jedem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130705
					]
				},
				{
					"id": 411130705,
					"content": "Es ist ein wirklich hoher Berg, den niemand zuvor je gesehen hat. Und es ist eisig kalt dort. Die Schläfer sind gezwungen, zu versuchen, den Gipfel zu erklimmen, aber sie wissen nicht warum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130706,
					"content": "Den Berg erklimmen? Bis zum Gipfel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130707
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130707,
					"content": "Welche Art von Mensch will den Gipfel eines solchen Bergs erreichen? Und wie kann dieser Wunsch so stark sein, einen Einfluss auf andere zu haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130708
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130708,
					"content": "Wahrscheinlich liegt eine arme Seele hier, begraben im Schnee, auf dem Berg zu Tode gejagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130709
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130709,
					"content": "Oder ... Ein kühner Forscher war besonders scharf darauf, diesen speziellen Berg zu erobern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130710
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130710,
					"content": "Ich werde noch etwas lesen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130711
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130711,
					"content": "Aha! Ich sehe hier etwas ... Es ist ein bisschen vage, aber ich denke ich kann seinen Namen erkennen ... Ah, ja! <color=#00E1FFFF>„Leonard“</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130712
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130712,
					"content": "Ooh, das ging schnell!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130713,
					"content": "Na ja, falls du es vergessen hast ... Ich bin ein Genie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130714
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130714,
					"content": "„Leonard“ ... Paimon hat den Namen noch nie zuvor gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111308,
			"completionStepIds": [
				4111308
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111308",
							"2"
						],
						"stepId": 4111308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130715,
					"content": "Jeder Anfänger im Wahrsagen hätte dir das sagen können, aber ... Dieser Mann war einer der Elf der Fatui! Das war zu knapp, wie hast du es geschafft, mit so einem Kerl wie ihm zu verkehren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130716
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130716,
					"content": "Einer der Elf der Fatui? Ihre Bösartigkeit kennt keine Grenzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130717
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130717,
					"content": "Einer der Elf? Meine Güte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130718
					]
				},
				{
					"id": 411130718,
					"content": "Was auch immer er geplante hatte ... Er ist direkt auf dich losgegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130719
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130719,
					"content": "Und er ist ein wahnsinnig mächtige Person! Ich konnte es spüren, als ich ihn ansah. Er ist viel mächtiger, als du dir vorstellen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130720
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130720,
					"content": "So sehr es mich schmerzt, es zuzugeben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130721
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130721,
					"content": "Seine Macht kann sich sicher nicht messen mit der des astrologischen Genies des Jahrhunderts?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130722
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130722,
					"content": "Das habe ich nie behauptet ...! Seine Macht mag meine um Haaresbreite übersteigen ... Aber in Astrologie allein kommt er nicht mal in Meine Nähe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130723
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130723,
					"content": "Das erinnert Paimon an etwas ... Wir haben auch einige Fatui im Gasthaus Wangshu gesehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130724,
					"content": "Warum könnten die Fatui Interesse an den gefallenen Sternen haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130725,
					"content": "Sie müssen etwas planen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130726
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130726,
					"content": "Hmm ... Vielleicht, nur vielleicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130727
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130727,
					"content": "Oh! Die Fatui sind diejenigen, die die Sterne vom Himmel haben fallen lassen! War es das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130728,
					"content": "Paimon, das war mein Auftritt! Such dir einen eigenen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130729
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130729,
					"content": "Ehehe, Entschuldigung ... Paimons Mund arbeitet einfach so viel schneller als der von allen anderen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130730,
					"content": "Gibt es wirklich diese Macht, Sterne vom Himmel fallen zu lassen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130731
					]
				},
				{
					"id": 411130731,
					"content": "Ja ... Wo haben sie die Energie herbekommen, um Sterne vom Himmel zu saugen!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130732,
					"content": "Ozvaldo Hrafnavins, was denkst du darüber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130733
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130733,
					"content": "Ich denke, dass alles möglich ist, mein Fräulein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130734
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130734,
					"content": "Solange sie in der Lage sind, den Preis dafür zu zahlen, werden sie nie aufhören, ihre Saat der Zerstörung über das ganze Land zu säen ... Fatui, eure Sünden mögen nie vergessen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130735
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130735,
					"content": "Ich glaube auch, dass es Wunder geben kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130736
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130736,
					"content": "Gesandter der Sterne, du hast dich als Mitglied meiner Gefolgschaft wacker geschlagen. Ich werde meine Truppen zu eurem Schutz entsenden. Sie werden dafür sorgen, dass die herannahende Dunkelheit euch keinen Schaden zufügt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130737
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130737,
					"content": "Sie meint mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130738
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130738,
					"content": "Nicht nötig! Paimon ist der Meinung, dass unser aktuelles Team perfekt funktioniert ... Was nicht kaputt ist, braucht man nicht zu reparieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130739,
					"content": "Du unterschätzt mich, Fischl! Ich bin wesentlich stärker, als du zu glauben scheint.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130740
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130740,
					"content": "Mein Fräulein vertraut niemandem mehr als dir, Herrin, sie ist einfach nur um dein Wohlergehen besorgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130741
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130741,
					"content": "Das ist wirklich nicht nötig. Jedenfalls seid ihr in einer wesentlich gefährlicheren Position als ich. Wenn überhaupt, dann benötigt ihr meinen Schutz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130742,
						411130744
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130742,
					"content": "Mona, du hast einen guten Charakter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130743
					]
				},
				{
					"id": 411130743,
					"content": "Hä? W... Weshalb sagst du das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130746
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130746,
					"content": "Zuerst müssen wir uns um die neue Bedrohung kümmern. Mein Astrolabius zeigt an, dass wieder ein Meteorit eingeschlagen ist, und dieser ist der <color=#00E1FFFF>bisher größte überhaupt</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130744,
					"content": "Fischl, du hast einen guten Charakter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130745
					]
				},
				{
					"id": 411130745,
					"content": "Natürlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130746
					],
					"speakerTitle": "Fischl"
				}
			]
		},
		{
