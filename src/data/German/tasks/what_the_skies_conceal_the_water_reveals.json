			"dialogs": [
				{
					"id": 411131001,
					"content": "Erledigt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131002,
					"content": "Wunderbar! Was für eine große Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131003
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411131003,
					"content": "Sind irgendwelche der Opfer seit Beginn des Vorfalls erwacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131004
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411131004,
					"content": "Oh, ich denke nicht ... Ach, schau lieber einfach selbst nach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		},
		{
