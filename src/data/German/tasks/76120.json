			"dialogs": [
				{
					"id": 761200101,
					"content": "... Hier. Das ist für dich. Damit habe ich meinen Teil erledigt, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200102
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200102,
					"content": "He, eine Zeichenleinwand! Moment mal ... das bedeutet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200103,
					"content": "Ah. Ihr kommt genau richtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200104
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200104,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200105
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200105,
					"content": "Na, wenn das nicht Maalaus ist, unsere großartige Malerin! Das ist ja eine Ewigkeit her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200106,
					"content": "Also, wofür sind wir „genau richtig“ gekommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200107
					]
				},
				{
					"id": 761200107,
					"content": "Ich habe Maalaus gerade kurz zum Mond gebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200108
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200108,
					"content": "Paimon ist sooo neidisch darauf, wie du das einfach so ... so gesagt hast, als würdest du nur kurz in den Garten gehen oder so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200109,
					"content": "Aber warum seid ihr eigentlich dorthin gegangen? Auf der Suche nach Inspiration?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200110,
					"content": "Das stimmt zur Hälfte. Wir haben auch einen Ort für eine „Ausstellung“ ausgewählt. Erinnert ihr euch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200111
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200111,
					"content": "Paimon erinnert sich! Die Mondgöttin-Ausstellung von Maalaus! Vergiss nicht, uns einzuladen, wenn es so weit ist, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200112,
					"content": "Ja, natürlich. Außerdem scheint Maalaus in der Lage zu sein, subtile Veränderungen in ihrer Umgebung wahrzunehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200113
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200113,
					"content": "Sie hat mir gesagt, dass ich mich sehr verändert habe, seit ich vom Mond zurückgekehrt bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200114
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200114,
					"content": "Deshalb wollte sie, dass ich sie dorthin bringe, um zu sehen, ob es dort etwas Besonderes gab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200115
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200115,
					"content": "He! Das ist mal wirklich künstlerisch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200116,
					"content": "Also, diese besondere Sache ist ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200117
					]
				},
				{
					"id": 761200117,
					"content": "Ich bin mir auch nicht sicher. Ich habe Maalaus zu vielen Orten gebracht, aber keiner davon hat ihr gefallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200118
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200118,
					"content": "Bis ich sie in die Nähe deines Schiffes gebracht habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200119,
						761200120
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200119,
					"content": "Das Raumschiff?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				},
				{
					"id": 761200121,
					"content": "Aber nachdem ich sie näher herangeführt hatte, stellte ich fest, dass sie sich gar nicht für das Schiff selbst interessierte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200122
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200122,
					"content": "Eh? Was bedeutet das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200123,
					"content": "~!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200124
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200124,
					"content": "Hm, sie fliegt um dich herum, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200125,
					"content": "Haha. Das hat sie damals auch schon gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200126
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200126,
					"content": "Ich vermute, dass sie sich eigentlich dafür interessiert, wie ich nach dem Anblick des Raumschiffs ausgesehen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200127
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200127,
					"content": "Wie du ... ausgesehen hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200128,
					"content": "#Ja. Es erinnert mich daran, als {NICKNAME} und ich zusammen dort waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200129
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200129,
					"content": "#Wir saßen auf dem Schiff und blickten auf Teyvat. {M#Er}{F#Sie} fand die Wahrheit über die Vergangenheit, und ich fand mein „Zuhause“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200130
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200130,
					"content": "Allein der Gedanke daran gab mir ein Gefühl von Frieden ... oder vielleicht sogar Freude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200131
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200131,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200132
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200132,
					"content": "Ja, du hast recht. Das sind Gefühle, die ich früher nicht gekannt hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200133
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200133,
					"content": "Also habe ich Maalaus unsere Geschichte erzählt, einschließlich dessen, was passierte, nachdem wir den Mond erreicht hatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200134
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200134,
					"content": "Danach schien sie überaus zufrieden zu sein, als hätte sie die Inspiration gefunden, nach der sie so sehr gesucht hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200135
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200135,
					"content": "Ah. Also ist es jetzt Zeit für die große Künstlerin, ihre Magie zu zeigen, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200136,
					"content": "He, du hast Paimon damals nicht mit nach oben genommen, also ist Paimon auch sehr gespannt darauf, was Maalaus malen wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200137,
					"content": "Und was werden wir dieses Mal als Farbe benutzen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200138
					]
				},
				{
					"id": 761200138,
					"content": "Dieses Mal ist es etwas Besonderes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200139
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200139,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200140
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200140,
					"content": "Maalaus sagt, dass sie Farben haben möchte, die nur uns gehören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200141
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200141,
					"content": "Und ... was bedeutet das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200142,
					"content": "Ich glaube, sie meint Dinge, die dich an diese Reise erinnern werden, was du daraus gelernt hast und welche Freude sie dir gebracht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200143
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200143,
					"content": "Keine Sorge. Maalaus möchte diese Gegenstände nur sehen und fühlen. Sie würde nichts so Kostbares als Farbe benutzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200144
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200144,
					"content": "Was hast du ihr gegeben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200145
					]
				},
				{
					"id": 761200145,
					"content": "Monderde und die Karte, die du mir für die Mondgebetsnacht gegeben hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200146
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200146,
					"content": "#Ach, also im Grunde muss es etwas sein, das für dieses Abenteuer steht, richtig? Na gut. {NICKNAME}, du entscheidest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200120,
					"content": "Na ja, das ist wirklich etwas Besonderes ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				}
			]
		},
