			"dialogs": [
				{
					"id": 761200301,
					"content": "Hmm. Eine gute Wahl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200302
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200302,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200303,
					"content": "Sie scheint auch ziemlich zufrieden zu sein – Woah, sie geht direkt zur Leinwand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200304,
					"content": "Weißt du, jetzt wo Paimon darüber nachdenkt: Maalaus’ Gemälde erzählen praktisch deine ganze Geschichte von deiner Geburt bis heute, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200305,
					"content": "Und diese Geschichte ist noch nicht zu Ende.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200306
					]
				},
				{
					"id": 761200306,
					"content": "Jap! Und Paimon möchte sowieso noch mehr von den Werken unserer tollen Malerin sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200307,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200308
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200308,
					"content": "Oh, schon fertig? Schnell wie immer, was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200309,
					"content": "Lass Paimon mal sehen ... Oh! Das ist ja wunderschön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200310,
					"content": "Paimon hätte nie gedacht, dass Teyvat vom Mond aus so wunderschön aussieht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200311,
					"content": "Ha ... Jetzt verstehe ich, warum Maalaus sagt, dass ich mich verändert habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200312
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200312,
					"content": "Hm? Also warum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200313,
					"content": "Wenn ich dieses Gemälde sehe, erinnere ich mich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200314
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200314,
					"content": "Dass ich, als ich auf dem Mond saß und Teyvat beobachtete, darüber nachdachte, wie ich schon immer nach einem eigenen „Zuhause“ gesucht hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200315
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200315,
					"content": "Aber jetzt habe ich plötzlich zwei Heimaten, und beide sind Orte von solcher Schönheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200316
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200316,
					"content": "In diesem Moment wurde mir klar, dass „Zuhause“ vielleicht dort ist, wo die Dinge und Menschen sind, die dir am Herzen liegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200317
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200317,
					"content": "Ein schöner Gedanke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200318
					]
				},
				{
					"id": 761200318,
					"content": "Danke. Ich denke, dass ich in Zukunft öfter mit der Kuuhenki zum Mond fliegen möchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200319
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761200319,
					"content": "Du bist auch herzlich eingeladen, mein „zweites Zuhause“ zu besuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				}
			]
		},
