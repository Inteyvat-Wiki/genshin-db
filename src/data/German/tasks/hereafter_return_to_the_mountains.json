			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang Ping’an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718310301,
					"content": "Der Tempel sieht ziemlich gut aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310302
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718310302,
					"content": "In der Tat sehr gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310303
					]
				},
				{
					"id": 718310303,
					"content": "Was? Du kommst gerade rechtzeitig, der Tempel ist gerade erst repariert worden und ich habe gerade die Handwerker bezahlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310304
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718310304,
					"content": "Ich hatte nicht erwartet, dass ich so viel Geld ausgeben würde, mein ganzes hart verdientes Geld ist bereits dafür ausgegeben worden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310305
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718310305,
					"content": "Aber es ist auf jeden Fall gut, dass dieser Tempel gebaut wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310306
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718310306,
					"content": "Möchtest du in den Tempel gehen und Weihrauch darbieten? Ich habe ein neues Räuchergefäß für dich anfertigen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310307,
						718310308
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718310307,
					"content": "Gern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310310
					]
				},
				{
					"id": 718310310,
					"content": "Nehmt diese Weihrauchstäbchen, das Räuchergefäß steht dort drüben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718310308,
					"content": "Hast du auch Weihrauch angeboten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310309
					]
				},
				{
					"id": 718310309,
					"content": "Natürlich. Nach dem Bau des Tempels opferte ich eine Stange guten Weihrauch. Er brannte gerade noch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310310
					],
					"speakerTitle": "Wang Ping’an"
				}
			]
		},
		{
			"id": 7183105,
			"completionStepIds": [
				7183105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
