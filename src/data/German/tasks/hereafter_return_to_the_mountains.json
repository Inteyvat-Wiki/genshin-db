					"Wang Ping’an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718310501,
					"content": "Hast du Weihrauch dargeboten? Und wie fühlst du dich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310502
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718310502,
					"content": "Ziemlich gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310503
					]
				},
				{
					"id": 718310503,
					"content": "Das ist gut. Ich hoffe, dass dieser Tempel in Zukunft beliebter sein wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310504
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718310504,
					"content": "Ich bleibe noch eine Weile hier. Es ist ruhig und ein guter Ort, um etwas zu schreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310505
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718310505,
					"content": "Ich muss die Informationen, die ich vorhin gesammelt habe, sortieren und die Arbeit an dem Buch über den „Schützenden Yaksha“ so schnell wie möglich fortsetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310506
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718310506,
					"content": "Du kannst diesen Tempel auch in Zukunft öfter besuchen, wenn du Zeit hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310507
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718310507,
					"content": "Wenn du Weihrauch darbringen möchtest, frag mich einfach direkt danach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310508
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718310508,
					"content": "Nun, ich möchte eigentlich auch die Umgebung renovieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310509
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718310509,
					"content": "Die Straße muss neu gepflastert werden, ein Zaun muss auf beiden Seiten hinzugefügt werden und ein Blumengarten muss neben dem Tempel angelegt werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping’an"
				}
			]
		},
