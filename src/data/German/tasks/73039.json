			},
			"dialogs": [
				{
					"id": 730390101,
					"content": "Meine Brüder haben darüber nachgedacht, was sie falsch getan hatten, das Utsava-Fest ist ein fröhlicher Tag, Arapacati sollte nicht mehr wütend sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390102
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390102,
					"content": "Ja, Arapacati braucht nicht wütend zu sein, ein fröhlicher Tag sollte mit dem „Geschmack der Freude“ gefeiert werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390103
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730390103,
					"content": "Zeit, die Früchte der „Kochausbildung“ vorzuführen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390104
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730390104,
					"content": "Schon bereit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390105
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730390105,
					"content": "Ooh! Das Festessen zum Utsava-Fest! Darauf hat Paimon schon lange gewartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390106,
						730390107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730390106,
					"content": "Juhu! Das Utsava-Fest Festessen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				},
				{
					"id": 730390108,
					"content": "Das ist Wasser aus Vanarana, das köstlichste Wasser, um die feinste Suppe zu kochen. Nara werden sicher zufrieden sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390109
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730390109,
					"content": "#Um Nara {NICKNAME} und Paimon den „Geschmack der Freude“ zu servieren, sollte ich {NICKNAME} und Paimon die Brüder „unterweisen“ lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390110
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390110,
					"content": "Nur auf diese Weise können wir das Essen zur Zufriedenheit der Nara zubereiten. Das ist die angemessene „Höflichkeit“, um unsere „Gäste“ zu bedienen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390111
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390111,
					"content": "#Nara {NICKNAME}, würdest du meine Brüder in der Kochkunst „unterweisen“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390107,
					"content": "Wir sollten besser nicht zu viel erwarten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				}
			]
		},
