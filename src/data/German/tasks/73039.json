				{
					"id": 730391002,
					"content": "Hm, was könnten die Aranara denn mögen ... Vielleicht Rettichsuppe! Hehe, dann können sie auch die Kochkünste der Nara kosten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
