			"dialogs": [
				{
					"id": 730391101,
					"content": "Die heiße Rettichsuppe ist fertig! Die Aranara werden sicher auch schon fertig sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7303912,
			"completionStepIds": [
				7303908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303908",
							"2"
						],
						"stepId": 7303908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arapacati",
					"Arachatora",
					"Arasaka",
					"Arapas",
					"Araphala"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730391224,
					"content": "#Ja! {NICKNAME} muss auch helfen, sonst kochen sie dieselben Gerichte wie vorher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391201,
					"content": "Mit der Hilfe von Paimons Verbesserungsmethoden beenden die Aranara die Gerichte unter deiner Aufsicht.\\nDu musst die Gerichte jetzt mit den Aranara genießen ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730391202
					]
				},
				{
					"id": 730391202,
					"content": "Wie ist es? Das ist authentisches Nara-Essen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391203,
					"content": "#Äh, es war zwar der Vorschlag Arapacatis, dass Nara {NICKNAME} die Brüder unterweist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391204
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391204,
					"content": "Das Nara-Essen ... das ist also der „Geschmack der Freude“ der Nara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391205
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730391205,
					"content": "Die Fröhlichkeit verschwindet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391206
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730391206,
					"content": "Das Wasser von Vanarana ist garantiert „das köstlichste Wasser“. Wie kann man damit so etwas kochen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391207
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730391207,
					"content": "Aber die „unvergleichlich frischen Früchte“ sind genauso lecker, hm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391208
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730391208,
					"content": "Hä, wie kann das sein? Sogar Aranara finden es ungenießbar? Aber Paimon findet es ganz lecker ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391209,
					"content": "Ich weiß zwar nicht, was „ungenießbar“ bedeutet, aber das schmeckt wie ein „Aufprall“, als wenn man ganz schnell gegen einen Baumstamm rennt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391210
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391210,
					"content": "Also, das muss wohl der Zusammenprall der Kulturen der Nara und der Aranara sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391211,
					"content": "#Aber Brüder, das ist wirklich gemein. Ihr solltet Nara {NICKNAME} dankbar sein, wie könnt ihr nur so etwas sagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391212
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391212,
					"content": "*Wimmer* ... Tut mir leid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391213
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730391213,
					"content": "Nein, du musst Danke sagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391214
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391214,
					"content": "#Danke, Nara {NICKNAME} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391215
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730391215,
					"content": "#Aber, wenn Nara {NICKNAME} und Paimon sich über das Essen freuen, dann ist ja gut! Vergesst die blöden Brüder. Wenn die Nara Freunde glücklich sind, sind wir es auch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391216
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391216,
					"content": "#Aber es gibt großen Unterschied zwischen Nara {NICKNAME} und Nara Varuna. Nara Varuna hat damals viel über „{M#den Bruder}{F#die Schwester}“ gesprochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391217
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391217,
					"content": "#Aber Nara {NICKNAME} spricht sehr wenig. Fühlst du dich nicht wohl dabei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391218
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391218,
					"content": "#{NICKNAME}, willst du etwas sagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391219,
						730391220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391219,
					"content": "Danke für die Fürsorge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730391222
					]
				},
				{
					"id": 730391222,
					"content": "#Wirklich? Solange es Nara {NICKNAME} gut geht, ist alles in Ordnung. Ich danke euch. Diese Blümchen hier sind ein Geschenk für Nara {NICKNAME} und Paimon von Arapacati und den Brüdern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391223
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391223,
					"content": "#Ich hoffe Nara {NICKNAME} und Paimon finden in Vanarana mehr „Geschmack der Freude“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391220,
					"content": "(Schweigen)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730391221
					]
				},
				{
					"id": 730391221,
					"content": "#... Also, Arapacati braucht sich keine Sorgen zu machen! {NICKNAME} geht es gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391222
					],
					"speakerTitle": "Paimon"
				}
			]
		},
