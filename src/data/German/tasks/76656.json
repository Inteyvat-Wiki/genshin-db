			"dialogs": [
				{
					"id": 766562001,
					"content": "#Hallo, {NICKNAME} und Paimon. Dank eurer Hilfe konnten wir die letztens wiedergefundenen Roboter bereits reparieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562002
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562002,
					"content": "Oh, sie sind alle hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766562003,
					"content": "Im Moment sind keine neuen Störungen aufgetreten, aber ich habe eine Idee ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562004
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562004,
					"content": "#{NICKNAME}, wenn ihr nach den anderen Robotern sucht, könnt ihr für mich auf einige besonderen Verhaltensweisen von ihnen achten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562005
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562005,
					"content": "Um was für Verhaltensweisen geht es denn konkret?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766562006,
					"content": "So ungefähr ... um die Interaktion zwischen den Robotern? Vielleicht wird es deutlicher, wenn genug Roboter zurückgebracht wurden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562007
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562007,
					"content": "Oh ... Überlass das ruhig uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766562008,
					"content": "Vielen Dank! Ich werde den nächsten Bereich auf der Karte markieren.",
					"roleType": "TALK_ROLE_NPC",
