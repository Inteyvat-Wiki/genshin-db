				},
				{
					"id": 240140202,
					"content": "Ich muss die Fischbrut ins tiefere Wasser bringen ... Tss, warum ist mein Taucheranzug gerade jetzt kaputt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140203
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140203,
					"content": "Was machst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140204
					]
				},
				{
					"id": 240140204,
					"content": "Oh, hallo, schön, euch kennenzulernen. Ich heiße Linorea und bin Umweltreporterin. Ich setze hier ... die Fischbrut aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140205
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140205,
					"content": "Oh! Als wir Semaine das letzte Mal gesehen haben, war da Fräulein Linorea auch da, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240140206,
					"content": "Bist du nicht Semaines ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140207
					]
				},
				{
					"id": 240140207,
					"content": "Ihr kennt Semaine? Also habt ihr die Geschenke überbracht? Dafür bin ich euch wirklich dankbar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140208
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140208,
					"content": "Semaine hat mir das erst nach der Oper erzählt, als wir nach Hause kamen. Seitdem wollte ich euch schon die ganze Zeit zum Essen einladen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140209
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140209,
					"content": "Ich hatte nicht erwartet, euch ausgerechnet hier zu treffen. Aber ... jetzt ist es etwas ungünstig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140210
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140210,
					"content": "Weil du die Fischbrut aussetzen musst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240140211,
					"content": "Wieso setzt du die Fischbrut aus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140212
					]
				},
				{
					"id": 240140212,
					"content": "... Weißt du etwas über die „Mecha-Fische“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140213,
						240140214
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140213,
					"content": "Nie davon gehört ...",
