			"dialogs": [
				{
					"id": 240140701,
					"content": "Pah, diese „Mecha-Fische“ sind Vorrichtungen, die das „Forschungsinstitut Fontaine“ hergestellt hat. Und sie sind auch schuld an der Zerstörung der Gewässer des Hofs von Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140702
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140702,
					"content": "Gewässer bestehen in einem ökologischen Gleichgewicht und bieten Lebensraum für die verschiedenen Fischarten und andere Organismen. Dieses Gleichgewicht begünstigt auch die biologische Reproduktion und das Wachstum der Wasserlebewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140703
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140703,
					"content": "In den Gewässern treten zwar auch gelegentlich Störungen auf, etwa durch Fischerei, invasive Fischarten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140704
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140704,
					"content": "Oder durch Wetterumschwünge ... Das hat alles die Abwanderung einiger Fischarten bewirkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140726
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140726,
					"content": "Aber letztendlich wird doch ein subtiles Gleichgewicht in den Gewässern aufrechterhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140705
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140705,
					"content": "Aber dann entwickelten diese Idioten vom „Forschungsinstitut Fontaine“ diese „Mecha-Fische“! Das hat ein großes Chaos angerichtet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140706
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140706,
					"content": "Der Öffentlichkeit erzählten sie, die „Mecha-Fische“ würden die Gewässer von Müll und Schmutz befreien und sie so sauber halten. Darüber hinaus hätten sie keine Auswirkungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140707
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140707,
					"content": "Am Anfang haben die „Mecha-Fische“ die Gewässer tatsächlich sauber gehalten und wir alle haben die Lügen dieser Forscher geglaubt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140708
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140708,
					"content": "Aber nach einer Weile wurde berichtet, dass die Fischbestände in den Gewässern, in denen die Mecha-Fische eingesetzt wurden, zurückgingen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140709
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140709,
					"content": "Da ist uns klar geworden, dass die „Mecha-Fische“ die echten Fische selbst als Abfall behandelten, nachdem sie den eigentlichen Müll entfernt hatten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140710,
						240140711
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140710,
					"content": "„Die Gewässer sauber halten“ bedeutet also eigentlich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140712
					]
				},
				{
					"id": 240140712,
					"content": "Nach unseren heftigen Protesten wollten die Forscher die „Mecha-Fische“ deaktivieren und das Projekt einstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140713
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140713,
					"content": "Aber als sie sich darauf vorbereiteten, sie zurückzuholen, wurde das gesamte „Forschungsinstitut Fontaine“ von einer riesigen Explosion erschüttert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140714
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140714,
					"content": "Dabei wurde ein Teil der deaktivierten „Mecha-Fische“ wieder aktiviert und sie begannen, die Fische in diesen Gewässern noch aggressiver anzugreifen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140715
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140715,
					"content": "Meine Kollegen und ich sind überzeugt davon, dass es so nicht weitergehen darf. Wenn wir dem Wüten der „Mecha-Fische“ nicht Einhalt gebieten, werden die aquatischen Ökosysteme des Hofs von Fontaine in einer Katastrophe enden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140716
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140716,
					"content": "Also habe ich mit einigen Ökosystemexperten begonnen, Fischschulen aufzuziehen und die Bruten in den jeweils geeigneten Gewässern zu entlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140717
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140717,
					"content": "Darüber hinaus haben wir Abenteurer angeheuert, um die „Mecha-Fische“ zu zerstören und zurückzuholen. Mit diesem zweigleisigen Ansatz wollen wir die aquatischen Ökosysteme retten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140718,
						240140719
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140718,
					"content": "Klingt beeindruckend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140720
					]
				},
				{
					"id": 240140720,
					"content": "Vielen Dank für das Kompliment. Ich weiß, das klingt vielleicht nicht unbedingt nach der Aufgabe einer Journalistin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140721
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140721,
					"content": "Aber ich bin der Meinung, dass es wichtiger ist, an die Front und in die Praxis zu gehen, bevor man Essays oder Artikel schreibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140727
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140727,
					"content": "Dieser praktische Ansatz ermöglicht uns erst den Erhalt von authentischen und genauesten Informationen, mit denen wir den besten Bericht verfassen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140722
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140722,
					"content": "Boah, was für eine beeindruckende Reporterin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240140723,
					"content": "Kann ich dir irgendwie helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140724
					]
				},
				{
					"id": 240140724,
					"content": "Oh? Danke für deine Fürsorge. Mein Taucheranzug ist kaputt, deshalb kann ich nicht unter Wasser gehen, um die Fischbrut freizulassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140725
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140725,
					"content": "Wenn du möchtest, kannst du mir helfen, die Fischbrut auszusetzen ... Egal ob im Flach- oder Tiefwasser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140719,
					"content": "Das ist bewundernswert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140720
					]
				},
				{
					"id": 240140711,
					"content": "... Alles außer dem Wasser ist „Müll“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140712
					]
				}
			]
		},
		{
			"id": 2401408,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401401",
							"2"
						],
						"stepId": 2401401,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"2401401",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linorea"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240140801,
					"content": "Diese ... verfluchten Mecha-Fische!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140802,
						240140803
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140802,
					"content": "Was ist passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140804
					]
				},
				{
					"id": 240140804,
					"content": "Ich hatte ihn repariert, aber er ist schon wieder kaputt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140805
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140805,
					"content": "Die Mecha-Fische in diesem Gebiet sind aus irgendeinem Grund völlig verrückt geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140806
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140806,
					"content": "In dem Moment, als ich die Fischbrut entließ, kamen sie auch schon angerauscht und begannen, alles zu verschlingen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140807
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140807,
					"content": "Weil auch Fischbruten an meinem Taucheranzug hingen, sind einige der Mecha-Fische direkt auf mich losgegangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140808
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140808,
					"content": "Ich weiß zwar, dass sie mich eigentlich nicht angreifen, aber ... ich hatte trotzdem Angst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140809
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140809,
					"content": "Dann bin ich hilflos im Wasser getrieben, nur mit Armen und Beinen rudernd ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140810
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140810,
					"content": "Irgendwann bekam mein Taucheranzug dann ein großes Loch ... Glücklicherweise war ich zu diesem Zeitpunkt nicht weit vom Ufer und mit einiger Anstrengung schaffte ich es an Land.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140811
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140811,
					"content": "Aber so wie es jetzt steht, kann ich die Fischbrut nicht mehr ins Wasser bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140812
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140812,
					"content": "#{F#Reisende}{M#Reisender}, kannst du mir helfen, die Fischbrut wieder auszuwildern? Egal ob im Flach- oder Tiefwasser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140803,
					"content": "Hast du deinen Taucheranzug repariert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140804
					]
				}
			]
		}
	]
}