			"dialogs": [
				{
					"id": 240140601,
					"content": "Hast du die Fischbrut ins Wasser gebracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140602
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140602,
					"content": "Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140603
					]
				},
				{
					"id": 240140603,
					"content": "Vielen Dank. Wenn ich meinen Taucheranzug repariert habe, werde ich meine Arbeit fortsetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140604
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140604,
					"content": "Hoffentlich wachsen die Fische heran.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140605
					]
				},
				{
					"id": 240140605,
					"content": "Keine Sorge, ich habe viele Arten von Fischbrut für alle Arten von Gewässern und unterschiedliche Umgebungen vorbereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140606
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140606,
					"content": "Die Fischbrut, die gerade ausgesetzt wurde, ist genau an dieses spezifische Gewässer angepasst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140607
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140607,
					"content": "Ich werde noch einige Fischbruten ins Wasser entlassen und danach die Abenteurer, die wir angeheuert haben, losschicken, um die „Mecha-Fische“ aus dieser Zone zu entfernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140608
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140608,
					"content": "Ich bin zuversichtlich, dass die Fischbrut heranwachsen kann und das ökologische Gleichgewicht dieses Gewässers wiederhergestellt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140609
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140609,
					"content": "Wenn ich genügend Gewässer renaturalisiert habe, werde ich einen langen Bericht veröffentlichen. Die Öffentlichkeit soll erfahren, was das „Forschungsinstitut Fontaine“ mit der Natur anstellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140610
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140610,
					"content": "Warte nur, Damestier. Dieses Mal kannst du dich nicht aus der Affäre ziehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linorea"
				}
			]
		},
