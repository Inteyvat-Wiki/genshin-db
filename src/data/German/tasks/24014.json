			},
			"dialogs": [
				{
					"id": 240140101,
					"content": "... Der Fischbestand ist hier wieder zurückgegangen, sind die Mecha-Fische etwa wieder aktiv?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140102
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140102,
					"content": "Ich muss die Fischbrut ins tiefere Wasser bringen ... Tss, warum ist mein Taucheranzug gerade jetzt kaputt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140103
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140103,
					"content": "Was machst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140104
					]
				},
				{
					"id": 240140104,
					"content": "Oh, hallo, schön, euch kennenzulernen. Ich heiße Linorea und bin Umweltreporterin. Ich setze hier ... die Fischbrut aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140105,
						240140109
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140105,
					"content": "Reporterin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140106
					]
				},
				{
					"id": 240140106,
					"content": "So ist es. Eine gewöhnliche Reporterin. Aber ich unterscheide mich von den Reportern, die nur über Prominente tratschen oder ständig die gleichen langweiligen Nachrichten wiederholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140107
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140107,
					"content": "Ich befasse mich mit einer sehr ernsten Angelegenheit, die am Hof von Fontaine ansteht und die öffentliche Sicherheit gefährdet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140108
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140108,
					"content": "Und das ist auch der Grund, weshalb ich die Fischbrut hier aussetze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140110
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140110,
					"content": "... Weißt du etwas über die „Mecha-Fische“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140111,
						240140112
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140111,
					"content": "Nie davon gehört ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240140112,
					"content": "Ist das eine besondere Fischart von Fontaine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240140109,
					"content": "Wieso setzt du die Fischbrut aus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140110
					]
				}
			]
		},
