			"dialogs": [
				{
					"id": 3532801,
					"content": "Oha! Hast du eben die Elemente dieser Welt gespürt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532802,
					"content": "Sieht aus, als müsstest du nur die Statue berühren, um die elementare Anemo-Kraft zu erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532803,
					"content": "Die Wesen in dieser Welt kommen nicht so einfach wie du an ihre Kräfte, musst du wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532804,
						3532807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532804,
					"content": "Diese Fähigkeit habe ich sicher, weil ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3532805
					]
				},
				{
					"id": 3532805,
					"content": "weil du gar nicht aus dieser Welt stammst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532809,
					"content": "Wenn du von hier aus weiter nach Westen gehst, triffst du auf die Stadt der Freiheit, Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532817,
					"content": "In Mondstadt huldigt man dem Gott des Windes, es ist auch die Stadt des Windes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532810,
					"content": "Vielleicht findest du ja dort Spuren? Schließlich hast du diese Kraft von dieser Statue hier bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532811,
					"content": "#Außerdem soll es in Mondstadt viele Barden geben. Vielleicht hat einer ja von {F#deinem Bruder}{M#deiner Schwester} gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532812,
					"content": "Gehen wir’s an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532813,
					"content": "Die Elemente dieser Welt haben auf deine Gebete reagiert. Ich denke, das ist ein wahrhaft gutes Zeichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532807,
					"content": "Das Ganze ist ziemlich seltsam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3532808
					]
				},
				{
					"id": 3532808,
					"content": "Seltsam? Du hast diese Macht den Göttern zu verdanken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532809
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
