	"talks": [
		{
			"id": 1102303,
			"completionStepIds": [
				1102303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102303",
							"2"
						],
						"stepId": 1102303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230301,
					"content": "Sieh dir das an. Zur Hälfte gefüllt mit Salz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230302
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230302,
					"content": "Sieht wie ein ausgefallener Salzstreuer aus. Die Göttin das Salzes war eine Göttin ohne Schätze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230303
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230303,
					"content": "Meines Wissens ist das kein einfacher Behälter. Er mag nur zur Hälfte gefüllt sein, er ist aber immer zur Hälfte gefüllt - er ist also endlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230304,
					"content": "Was?! Ihr sagt, dass sich die Menge darin nicht ändert, auch wenn ich das Salz herausschütte?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230305
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230305,
					"content": "Exakt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230306
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230306,
					"content": "Endlos Salz produzieren zu können ... Die Göttin des Salzes ist tatsächlich mächtig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230307
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230307,
					"content": "Endlich, nach all den Anstrengungen habe ich einen wertvollen Schatz gefunden. Ich beanspruche ihn als meinen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230308
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230308,
					"content": "Ich muss nur das endlose Salz in tausend oder zehntausend Beutel schütten ... Ich kann es verkaufen und ein Vermögen verdienen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230309
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230309,
					"content": "He! Wie kannst du eine Reliquie der Göttin des Salzes für so ein oberflächliches Unterfangen verwenden!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230310
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230310,
					"content": "Wenn Herr Kliment diesen Salzkelch haben will, dann gehört das nächste Objekt, das wir finden, nach dem vereinbarten Vertrag Frau Wanyan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230311,
					"content": "Natürlich, wie besprochen. Hehe, aber wie kann etwas mehr wert sein als dieser seltene Fund?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230312
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230312,
					"content": "Da wir einen Vertrag haben, besteht keine Notwendigkeit für mich, mit ihm zu kämpfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230313
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230313,
					"content": "Dann weiter, sollen wir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1102305,
			"completionStepIds": [
				1102305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102305",
							"2"
						],
						"stepId": 1102305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230501,
					"content": "Hmpf, nur ein einfaches Messgerät. Sieht nicht wertvoll aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230502
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230502,
					"content": "Das ... Wenn ich mich recht entsinne, ist dies eine Art Werkzeug für Messungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230503
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230503,
					"content": "In der Tat. Aber die Göttin des Salzes hat ihm eine weitere Kraft verliehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230504
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230504,
					"content": "Wenn du dieses Salzmeter in den Boden steckst, wird der umliegende Bereich mit Salz bedeckt. So, wie eine Flut die Erde bedeckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230505
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230505,
					"content": "Je tiefer es im Boden steckt, desto mehr Salz wird auftauchen. Es ist wie eine „Salzernte“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230506
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230506,
					"content": "D... das ist ja noch besser als der Salzkelch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230507
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230507,
					"content": "Na ja, dann geht nach unserem Vertrag das Salzmeter an Frau Wanyan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230508
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230508,
					"content": "Nein! Nicht akzeptabel! Ich habe diese ganze Expedition organisiert und bezahlt. Warum sollte ich den Kürzeren ziehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230509
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230509,
					"content": "Und dieses Mädchen war unnütz. Warum sollte sie auch nur irgendetwas kriegen!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230510
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230510,
					"content": "Oh Junge, es geht wieder los ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230511,
						110230512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230511,
					"content": "*seufz*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				},
				{
					"id": 110230513,
					"content": "Also du sagst, du willst den Vertrag brechen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230514
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230514,
					"content": "Und wenn ich ihn schon breche? Jetzt, da ich gesehen habe, wie die Vorrichtung in der Ruine funktioniert, brauche ich euch nicht mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230515
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230515,
					"content": "Lasst uns nicht vergessen, wer hier wen angeheuert hat. Warum sollte ich Euch die Regeln machen lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230516
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230516,
					"content": "Weil du einem Vertrag zugestimmt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230517
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230517,
					"content": "Rex Lapis sagte mal: „Jemand, der seinen Vertrag bricht, soll den Zorn des Steins spüren.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230518
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230518,
					"content": "Das ist von einem Eurer Götter aus Liyue. Ich bin aus Snezhnaya, ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230519
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230519,
					"content": "Du wirst „den Zorn des Steins spüren“. Das findest du möglicherweise eher unangenehm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230512,
					"content": "Während wir über „unnütze“ Menschen sprechen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				}
			]
		},
		{
			"id": 1102307,
			"completionStepIds": [
				1102307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102307",
							"2"
						],
						"stepId": 1102307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230701,
					"content": "Ich werde auch deinen Schatz konfiszieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230702
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230702,
					"content": "Du bist nicht würdig, weiter in die Ruinen zu gehen. Verlasse diesen Ort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230703
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230703,
					"content": "Verdammt seid Ihr ... Wartet nur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230704
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230704,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230705
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230705,
					"content": "Eine „archäologische Untersuchung“. Er konnte nicht länger nur so tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230706,
						110230708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230706,
					"content": "Wenigstens waren wir auf der Hut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230707
					]
				},
				{
					"id": 110230707,
					"content": "Ja, gut, dass Paimon einen Lügner aus hundert Metern erkennt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230710,
					"content": "Das Fehlverhalten von Kliment kommt von der Gier, ja. Aber neben Gier gibt es andere Dinge, die uns dazu verleiten, Verträge zu brechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230711
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230711,
					"content": "Wenn Leute die Objekte ihrer Träume sehen, wie viele können sich wirklich kontrollieren und dem Vertrag folgen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230712,
					"content": "Ich denke, wir sollten jetzt ehrlich mit uns sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230713
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230713,
					"content": "Hmm? In welcher Hinsicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230714,
					"content": "Na, dass in Wahrheit kein Mitglied dieser „archäologischen Expedition“ wegen der Archäologie hierhergekommen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230715
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230715,
					"content": "W... Warum sagt Ihr das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230716
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230716,
					"content": "Gute Frau, du hast nicht mal ein archäologisches Grundwissen und kannst höchstens ein paar einfache Reliquien erkennen. Jedoch bist du eine Expertin, wenn es um alles zur Göttin des Salzes geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230717
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230717,
					"content": "Du bist nicht interessiert an Archäologie oder Reliquien - was dich wirklich interessiert ist die Göttin des Salzes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230718
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230718,
					"content": "Ich glaube, dass diese Legenden über die Göttin des Salzes, von denen du auf dem Perlenboot sprachst von Generation zu Generation in der Yinyuan-Kammer weitergegeben werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230719
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230719,
					"content": "Gut, das reicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230720
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230720,
					"content": "Mein lieber Herr, Ihr seid tatsächlich ein Mann von großem Wissen und vielen Talenten. Ich hatte wohl recht, Euch aufzusuchen, nachdem ich den Mut dafür aufbringen konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230721
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230721,
					"content": "Ihr habt recht. Ich bin keine Gelehrte der Archäologie. Ich komme von den Acht Handwerken unter der Führung der Qiying, der Yinyuan-Kammer von der Salzindustrie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230722
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230722,
					"content": "Unsere Vorfahren wurden vor all der Zeit von der Göttin des Salzes beschützt, als der Archontenkrieg das Land ins Chaos stürzte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230723,
						110230724
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230723,
					"content": "Wenn ich darüber nachdenke, habe ich dich nie „Rex Lapis“ sagen hören ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230725,
					"content": "Oh, richtig. Jetzt, da du es sagst, die Leute von Liyue verwenden sehr selten den Namen „Morax“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230726,
					"content": "Während des Krieges hat Morax unseren Gott aus Neid auf ihre Macht umgebracht! Er hat uns in dieser Welt alleine und verloren zurückgelassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230727
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230727,
					"content": "Wir ... Wir hassen ihn! Aber Liyue ist nun mal das Liyue von Morax. Und die Geschichte wird so geschrieben, wie er es wünscht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230728
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230728,
					"content": "Also suche ich nach Beweisen für die Schuld von Morax! Er hat Blut an seinen Händen und Grausamkeit in seinem Herzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230729
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230729,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230730
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230730,
					"content": "Wir haben uns auf einen Vertrag geeinigt, wenn wir der Wahrheit ins Auge blicken wollen, oder nicht, Herr Zhongli? Ihr müsst diese Geschichte gerecht bewerten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230731
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230731,
					"content": "Aber klar, natürlich. Ich muss jedoch hinzufügen, dass Liyue nicht länger das Liyue von Morax ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230732,
					"content": "Komm mit mir. Alle Antworten, die du suchst, liegen vor dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230724,
					"content": "Hmm, ich habe dich nie „Herrscher über die Felsen“ sagen hören ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230708,
					"content": "Ich hoffe, du wirst nie so gierig wie er, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230709
					]
				},
				{
					"id": 110230709,
					"content": "Paimon mag Mora, aber Paimon macht nichts Schlechtes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1102309,
			"completionStepIds": [
				1102309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102309",
							"2"
						],
						"stepId": 1102309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230901,
					"content": "Ist das ... ein Schwert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230902
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230902,
					"content": "Aha! Es ist ein zerbrochenes Schwert, das ist ein Beweis! Dies beweist, dass sich die Göttin des Salzes wehren musste, wehren gegen den bösen Morax! Aber leider wurde sie besiegt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230903
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230903,
					"content": "Die Macht dieses Schwertes ist sicher größer als die des Salzkelchs und Salzmeters!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230904
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230904,
					"content": "Wenn wir dieses Schwert reparieren können, dann können wir der Welt die riesige Macht der Göttin des Salzes zeigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230905
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230905,
					"content": "Hmm ... Es sieht so aus, wie etwas, das nach einer Niederlage im Kampf zurückbleibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230906,
					"content": "Zwei Teile eines kaputten Schwerts. Aus archäologischer Perspektive sind das zwei separate Reliquien. Nach dem Vertrag kannst du nur Anspruch auf eines erheben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230907
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230907,
					"content": "W... warum? Wir wechseln uns ab, Anspruch auf Schätze zu erheben, das ist wahr. Aber Kliment ist nicht mehr hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230908
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230908,
					"content": "Ja, aber die „nur ein Objekt pro Anspruch“-Klausel ist noch immer gültig. Du kannst nicht zwei Reliquien zur gleichen Zeit an dich nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230909
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230909,
					"content": "D... Diese Logik ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230910
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230910,
					"content": "Ähm ... Zhongli, sie scheint eine gute Person zu sein und niemand streitet um den Schatz. Wie wäre es, wenn Ihr hier ein Auge zudrücken würdet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230911,
					"content": "Wenn es einen Vertrag gibt, kann man kein Auge zudrücken. Wenn der Vertrag nicht eingehalten wird, wird er gebrochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230912
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230912,
					"content": "Nein! Wenn ich nur eine Hälfte nehme, kann es nicht repariert werden und die Macht der Göttin des Salzes kann nicht wiederhergestellt werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230913
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230913,
					"content": "Egal was kommt. Ich muss ihr treu bleiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230914
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230914,
					"content": "Auch wenn ich einen Vertrag breche, es ist mir egal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230915
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230915,
					"content": "Du hast dich also schon entschieden? Hmm ... Dann musst du einen Preis zahlen, weil du den Vertrag gebrochen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230916
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230916,
					"content": "Zhongli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230917,
					"content": "Das bedeutet, du akzeptierst, den „Zorn der Steine zu spüren“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230918
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230918,
					"content": "Das ... das ist in Ordnung. Die Göttin des Salzes gab ihr Leben, um ihr Volk zu beschützen. Mein Opfer ist nichts im Vergleich dazu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230919
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230919,
					"content": "Bestrafe mich wie immer du willst. Wenn ich nur den Beweis meines Glaubens mitnehmen darf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230920
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230920,
					"content": "Nein, man darf kein Mädchen schlagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230921,
					"content": "Vielleicht wäre diese Strafe einfacher für sie, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230922,
					"content": "Zur Strafe erzähle ich dir die Wahrheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230923
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230923,
					"content": "Was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230924
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230924,
					"content": "Die Wahrheit? Ihr meint, die Wahrheit soll meine Strafe sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230925
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230925,
					"content": "Ja. Die Wahrheit zu erfahren, die ich dir nun erzählen werde, ist der Preis den du für den Vertragsbruch zahlst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230926
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230926,
					"content": "Ich muss dir leider sagen, dass die Göttin des Salzes, Havria, nicht so mächtig war, wie du glaubst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230927
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230927,
					"content": "Sie war ein eher kleiner und schwacher Gott, der sich allen anderen Göttern gebeugt hat. Im Krieg hat sie verloren ... sie konnte nie einen Sitz der Sieben erlangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230928
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230928,
					"content": "W... Was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230929
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230929,
					"content": "Während des Archontenkriegs nutzen die Götter dieser Welt all ihre Stärke und List, um um die Kontrolle über Teyvat zu kämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230930
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230930,
					"content": "Aber Havria hat sich stattdessen dazu entschieden, zu fliehen. Sie dachte, wenn sie schon vor dem Kampf aufgibt, könnte sie sich selbst und ihr Volk vor dem Krieg retten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230931
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230931,
					"content": "Jedoch konnte der Vormarsch der Aggressoren während des langen Krieges nicht aufgehalten werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230932
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230932,
					"content": "Nach endlosen Niederlagen hatte Havria all ihre Länder verloren. Es blieb nur eine kleine Zufluchtsstätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230933,
					"content": "Nein ... nein ... so kann es nicht gewesen sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230934
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230934,
					"content": "In ihren letzten Tagen hatte sie nicht eine einzige Klinge, mit der sie ihr Volk beschützen hätte können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230935
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230935,
					"content": "„Nicht eine einzige Klinge“? Dann ist dieses Schwert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230936
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230936,
					"content": "Ja ... Dieses Schwert ist keine Reliquie, die der Göttin des Salzes gehört ... sondern die Mordwaffe, mit der sie getötet wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230937
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230937,
					"content": "Mordwaffe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230938
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230938,
					"content": "Nein! Das ist nicht wahr, es kann nicht wahr sein! Ihr versucht, meinen Glauben an die Göttin des Salzes zu testen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230939
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230939,
					"content": "Wie ich bereits sagte, ich spreche nur Fakten aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230940
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230940,
					"content": "Absurd! Ihr ... Ihr seid ein Anhänger von Morax, versucht nicht, mir einen Streich zu spielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230941
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230941,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230942
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230942,
					"content": "He! Heee! Komm zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230943,
						110230945
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230943,
					"content": "Das war zu viel für sie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230944
					]
				},
				{
					"id": 110230944,
					"content": "Es war schließlich eine Strafe. Ich wollte ihr nicht so grausame Fakten erzählen, aber der Vertrag wurde gebrochen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230947,
					"content": "Lasst uns ihr tiefer in die Ruine folgen. Dort, fürchte ich, werden wir etwas finden, das ihr keine andere Wahl lässt, als der Wahrheit ins Auge zu blicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230945,
					"content": "Was du sagtest, es war die Wahrheit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230946
					]
				},
				{
					"id": 110230946,
					"content": "In der Tat. Warum sollte ich sonst die Wahrheit als Strafe einsetzen? Es war schließlich eine Strafe. Ich wollte ihr nicht so grausame Fakten erzählen, aber der Vertrag wurde gebrochen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1102310,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102310",
							"2"
						],
						"stepId": 1102310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wanyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110231131,
					"content": "Was ist all das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231132
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231132,
					"content": "Was haben sie gesehen ... Was haben sie getan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231133
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231133,
					"content": "W... Was ist passiert?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231134
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231134,
					"content": "Lass uns weitergehen, du traust mir ja nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231135
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231135,
					"content": "Was hinter dieser Tür liegt, wird dir alles zeigen, was damals geschehen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1102311,
			"completionStepIds": [
				1102311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102311",
							"2"
						],
						"stepId": 1102311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wanyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110231101,
					"content": "Das ist der Schauplatz eines Verbrechens. Der Körper von Harvia hat sich aufgelöst und nichts als diese Salzspuren zurückgelassen. Ihre letzten Momente sind seitdem festgefroren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231103
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231103,
					"content": "Die Geschichte geht so weiter, dass einige aus ihrem Volk endlich feststellten, dass diese gütige, liebe aber schwache Göttin in Kriegszeiten niemanden beschützen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231104
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231104,
					"content": "Der Archontenkrieg war grausam auf extreme Art. Statt sich dem Schmerz der Niederlage auszusetzen, dachten sie, es wäre besser, ihr ein schnelles Ableben zu geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231105,
					"content": "Aber warum diese Statuendinger?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110231106,
					"content": "Egal, wie schwach der Gott, die Macht, die weiterhin fließt, wenn er getötet wurde ist größer als die Kraft, die sterbliche Hüllen aushalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231107
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231107,
					"content": "Daher wurden diejenigen, die nicht fliehen konnten, verwandelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231108
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231108,
					"content": "Diejenigen aus ihrem Volk, die von diesem Desaster unberührt blieben, flohen nach Liyue. Dort fanden sie Zuflucht bei Rex Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231109
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231109,
					"content": "Ihre Nachkommen fürchteten die Überreste von Havria und lebten in der Angst, sie habe ihnen einen ewigen Fluch auferlegt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231110
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231110,
					"content": "Also riskierten sie ihre Leben, um hierherzukommen und das Schwert zu zerbrechen und ihre Ehrerbietung anzubieten, in der Hoffnung, dass sie ihren Ärger beruhigen könnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231111
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231111,
					"content": "Aber das mussten sie gar nicht tun. Wie könnte eine Göttin, die bis zum Ende nicht einmal widerstanden hat, Hass für ihr Volk entwickeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231112
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231112,
					"content": "Ich ... Ich ... Auch wenn das stimmt, kann ich nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231113
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231113,
					"content": "Das muss eine Lüge sein ... Eine erfundene Geschichte ... All das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231114
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231114,
					"content": "Wage es ja nicht, zu versuchen ... meinen Glauben zu erschüttern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231115
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231115,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231116
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231116,
					"content": "Aua, Zhongli hat diesmal auch kein bisschen Gnade walten lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110231117,
					"content": "Das ist der Preis, den sie zahlen muss ... Auch wenn es nicht wirklich so schlimm ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231118
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231118,
					"content": "Ich fürchte, sie wirkt so, als würde sie für einige Zeit Probleme damit haben. Aber auch wenn sie diesen Problemen nicht sofort entkommt, die Wahrheit einfach anzuerkennen reicht für jetzt auch aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231119,
						110231121
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231119,
					"content": "Du scheinst nur allzu vertraut zu sein damit, was mit der Göttin des Salzes geschehen ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231120
					]
				},
				{
					"id": 110231120,
					"content": "In der Tat. In den vergangenen Jahren diente mir die Geschichte von Havria auch als Warnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231123
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231123,
					"content": "An einen Gott zu glauben, der bereits verstorben ist, wird dir nicht helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231124
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231124,
					"content": "Das gilt für Havria sowie für Morax.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231125
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231125,
					"content": "Das Volk von Liyue wird das eines Tages verstehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231126
					]
				},
				{
					"id": 110231126,
					"content": "Na gut. Willst du mich nun begleiten auf eine Reise zu den Guyun-Türmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231127
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231127,
					"content": "Hä? Was wollt Ihr machen, Zhongli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110231128,
					"content": "*seufz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231129
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231129,
					"content": "Auf alten Pfaden wandeln, alte Geschichten erzählen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231130
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231130,
					"content": "Es hilft nichts, man wird immer an alte Bekanntschaften erinnert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231121,
					"content": "Du hast nicht nur einfach Gerüchte darüber gehört, wie das Siegel zu brechen ist, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231122
					]
				},
				{
					"id": 110231122,
					"content": "Nein, in der Tat. Wie schlau von dir, aber das ist keine Frage von Weisheit, sondern Alter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231123
					],
					"speakerTitle": "Zhongli"
				}
			]
		}
	]
}