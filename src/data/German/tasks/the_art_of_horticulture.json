			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madarame Hyakubei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721830101,
					"content": "Sind das ... Samen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830102,
					"content": "Dies sind die Naku-Kraut-Samen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830103
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830103,
					"content": "Kennst du diese Pflanze?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830104
					]
				},
				{
					"id": 721830104,
					"content": "Nun, ein bisschen weiß ich darüber. Ich habe diese Pflanze schon einmal gesehen und gehört, wie die Leute über ihre Eigenheiten gesprochen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830105
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830105,
					"content": "Ich erinnere mich ... selbst wenn kein Wind weht, vibriert diese Pflanze leicht mit dem Klang des Donners ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830106
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830106,
					"content": "Sieht sie gut aus, wenn sie ausgewachsen ist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830107
					]
				},
				{
					"id": 721830107,
					"content": "Wenn es nur um das Aussehen geht ... Ja, es sollte schon ziemlich gut aussehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830108
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830108,
					"content": "Willst du versuchen, „Naku-Kraut“ anzubauen? Aber hier gibt es nicht viel geeignetes Land ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830109
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830109,
					"content": "Ich habe mein eigenes Land.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830110
					]
				},
				{
					"id": 721830110,
					"content": "Ist ... Ist das so? Nicht schlecht ... Dir wurde schon dein eigenes Land verliehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830111
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830111,
					"content": "Dann darf ich dich fragen, ist dein Land in ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830112,
						721830115
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830112,
					"content": "Nicht innerhalb von Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830113
					]
				},
				{
					"id": 721830113,
					"content": "Ach! Ich habe auch von deinen Heldentaten in Mondstadt und Liyue gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830114
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830114,
					"content": "Es ist nur natürlich, dass du für eine solche Leistung dein eigenes Stück Land erhältst. Du bist es wert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830120
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830120,
					"content": "He, das „Land“, von dem du sprichst, ist doch nicht die „Kanne der Vergänglichkeit“, die die Oma uns gegeben hat, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830121,
					"content": "Kannst du darin wirklich Dinge anbauen? Die Oma hat vorher nichts dazu gesagt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830122,
						721830124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830122,
					"content": "Gehen wir zurück und fragen einfach nach.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830123
					]
				},
				{
					"id": 721830123,
					"content": "Nun denn, gehen wir zurück und fragen die Oma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830124,
					"content": "Die Adepten sind wirklich sehr stark.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830125
					]
				},
				{
					"id": 721830125,
					"content": "Ist das so? Aber Oma ist tatsächlich sehr stark ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830126,
					"content": "Nun denn, gehen wir zurück und fragen die Oma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830115,
					"content": "In einer Teekanne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830116
					]
				},
				{
					"id": 721830116,
					"content": "In einer ... Teekanne? Treib keine Scherze mit mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830117
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830117,
					"content": "Ich habe auch von deinen Heldentaten in Mondstadt und Liyue gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830118
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830118,
					"content": "Ich nehme an, dein Land ist entweder in Liyue oder Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830119
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830119,
					"content": "#Oh, du bist {F#die}{M#der} Beste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830120
					],
					"speakerTitle": "Madarame Hyakubei"
				}
			]
		},
		{
			"id": 7218302,
			"completionStepIds": [
				7218302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7218302",
							"2"
						],
						"stepId": 7218302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721830201,
					"content": "Hm? Kinder, seid ihr hier, um mich zu sehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830202
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830202,
					"content": "Über die Naku-Kraut-Samen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830203
					]
				},
				{
					"id": 721830203,
					"content": "Samen ... Ooh, du willst solche Samen in der „Kanne der Vergänglichkeit“ pflanzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830204
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830204,
					"content": "Das ist keine schlechte Idee, schließlich ist genügend Platz verfügbar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830205
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830205,
					"content": "Es ist nur, du hast heute nur dieses eine Päckchen Samen mitgebracht. Wirst du tatsächlich nur dieses eine Päckchen Samen säen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830206
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830206,
					"content": "Stimmt ja! Wir wissen nicht einmal, wie man Samen sammelt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830207,
					"content": "Nachdem dieses Päckchen gepflanzt ist, wo finden wir weitere Samen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830208,
					"content": "Nun gut, immer mit der Ruhe. Ich habe hier zufällig eine kleine Schachtel, die ich vor vielen Jahren benutzt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830209
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830209,
					"content": "Wenn ich früher Blumen gepflanzt habe, habe ich diese Schachtel benutzt, um sie darin aufzubewahren, und sie halten sich sehr lange in der Schachtel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830210
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830210,
					"content": "Außerdem kann diese Schachtel, nachdem du die Blumen in die Schachtel gelegt hast, auch mehrere Blumensamen hervorbringen ... sodass es einfach ist, sie einzupflanzen, wenn du das möchtest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830211
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830211,
					"content": "Auch wenn die Schachtel jetzt etwas weniger nützlich ist ... zumindest hat sie noch etwas ‚Saat‘-Kraft übrig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830212
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830212,
					"content": "Na ja ... Ich benutze die Schachtel sowieso nicht mehr oft ... Also gebe ich sie euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830213
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830213,
					"content": "Egal, ob ihr ein paar Blumen und Pflanzen anbauen wollt oder ein paar Feldfrüchte, diese Schachtel sollte euch recht nützlich sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830214
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830214,
					"content": "Danke, Oma!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830215
					]
				},
				{
					"id": 721830215,
					"content": "Danke, Oma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830216,
					"content": "Ach, ist schon gut, mach weiter und probiere es aus, aber die Blumenpflege ist keine leichte Aufgabe, also sei darauf vorbereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830217
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830217,
					"content": "Oma ist wirklich stark ... Aber bevor wir die Schachtel ausprobieren, lass uns zurück zur Kanne  gehen und versuchen, diese Samen zu säen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830218,
					"content": "Hach, Paimon hofft wirklich, dass diese Samen bald austreiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}