			"dialogs": [
				{
					"id": 705370101,
					"content": "Eine verdächtig aussehende Holzkiste, die du vorher noch nie gesehen hast. Im Deckelspalt klemmt ein Stück Papier. Darauf steht „Diese Ausrüstung ist Eigentum der Ermittlungstruppe, Gefahrgut der höchsten Gefahrenstufe, mit äußerster Vorsicht behandeln.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verdächtige Holzkiste"
				}
			]
		},
		{
			"id": 7053711,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_ACTIVITY_CLIENT_COND",
						"rawParams": [
							"5160",
							"5160001",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7053701",
							"2"
						],
						"stepId": 7053701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verdächtige Holzkiste"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705371101,
					"content": "Werfen wir einen Blick darauf ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371102
					]
				},
				{
					"id": 705371102,
					"content": "Die Nachricht an der Kiste ... Klingt sehr beängstigend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371103,
					"content": "Sie enthält offensichtlich Gefahrgut, und dann wurde sie am Mostsee abgestellt? Gehört sie etwa den beiden Rittern dort drüben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371104,
					"content": "Da ist ein weiter Spalt zwischen den Brettern, man kann sehen, was sich darin befindet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371105,
					"content": "Paimon guckt sich das mal an ... Sie scheint voller ... runder Dinger zu sein ... Rote Bälle, viel größer als Dämmerfrüchte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371106,
					"content": "Warte, sind das etwa Bomben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371107,
					"content": "Warum sollte der Ritterorden eine Kiste mit Bomben am See abstellen? Vielleicht wollen sie ja diese ... invasiven Fische im Mostsee, von denen Lisa gesprochen hat, in die Luft jagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7053712,
			"completionStepIds": [
				7053701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_ACTIVITY_CLIENT_COND",
						"rawParams": [
							"5160",
							"5160001",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7053701",
							"2"
						],
						"stepId": 7053701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verdächtige Holzkiste"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705371201,
					"content": "Haha! Bomben! Ich möchte damit spielen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371202
					]
				},
				{
					"id": 705371202,
					"content": "Warum bist du denn plötzlich so erregt? Wir wissen doch noch gar nicht, wie stark diese Bomben sind. Es wäre doch schlimm, wenn unschuldige Passanten verletzt würden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371203,
						705371204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371203,
					"content": "Sie sind sowieso dafür da, die Fische in die Luft zu jagen, wir können das auch!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371205
					]
				},
				{
					"id": 705371205,
					"content": "Iiih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371206,
					"content": "Hm ... Wenn du das so sagst, juckt es Paimon auch ein bisschen in den Fingern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371207,
					"content": "Wir hören immer, dass Klee Fische in die Luft jagen wollte, und dann hat sie es getan und wurde bestraft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371208,
					"content": "Und jetzt stehen wir selbst neben einer Kiste mit Bomben am See ... Paimon möchte es wirklich einmal probieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371209,
					"content": "Wenn wir nur eine reinschmeißen ... Wird es wohl nicht so schlimm sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371210,
						705371211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371210,
					"content": "Eine für jeden von uns!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371212
					]
				},
				{
					"id": 705371212,
					"content": "Zusammen mit Paimon öffnest du die Holzkiste. Ihr nehmt jeder eine Bombe heraus, studiert den Auslösemechanismus, zählt „drei, zwei, eins“, zieht die Zünder und werft sie gleichzeitig weit in den Mostsee ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705371213
					]
				},
				{
					"id": 705371213,
					"content": "Aus dem Wasser ertönt ein tiefes Donnern, dann schießen zwei Wasserfontänen aus der Oberfläche hervor und einige Hornkugelfische werden in die Luft gewirbelt ...\\nDu und Paimon lacht einander zu, klatscht erfreut in die Hände und sammelt die Beute eures ersten Versuchs, die Fische in die Luft zu jagen. Ihr wollt gerade gehen ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705371214
					]
				},
				{
					"id": 705371214,
					"content": "Aber die improvisierte geheime Aktion „Fische in die Luft zu jagen“ scheint schiefgelaufen zu sein, so wie die Bomben hochgingen, wurdet ihr auch entblößt ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705371215
					]
				},
				{
					"id": 705371215,
					"content": "Aaaah!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371216
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 705371216,
					"content": "Meine Ohren!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371217
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 705371217,
					"content": "Das hat mich fast zu Tode erschreckt! Was ist, Phonia, geht es dir gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371218
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Panischer Schrei"
				},
				{
					"id": 705371218,
					"content": "Es gab auf einmal eine Explosion unter Wasser ... Ich hätte fast mein Gehör verloren! Dem Klangmuster nach, war das eine deiner Bomben, Ematol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371219
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Wütende, aber beherrschte Stimme"
				},
				{
					"id": 705371219,
					"content": "Was? Ich stand die ganze Zeit brav in deiner Nähe, ich hab doch gar nichts gemacht! Schau doch, ich habe überhaupt keine Bombe in meinen Händen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371220
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Panische, aber zweifelnde Stimme"
				},
				{
					"id": 705371220,
					"content": "Du! Du wolltest mich in Panik sehen und hast vorher schon ein paar Bomben mit Zeitzünder im Wasser platziert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371221
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Wütende, aber beherrschte Stimme"
				},
				{
					"id": 705371221,
					"content": "Wenn es so wäre, hätte ich dann nicht einen Fotoapparat bereitgehalten, um diesen Moment einzufangen, wie du jetzt vor mir kniest, deinen Kopf hältst und heulst. Hätte ich mir das entgehen lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371222
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Panische, aber zweifelnde Stimme"
				},
				{
					"id": 705371222,
					"content": "Du! Du brauchst gar nicht zu erwarten, dass ich dir nächsten Monat wieder einen Nachlass auf die Miete gebe! Und was ich dir alles gar nicht berechnet habe, die Wasserrechnung, die Möbelmiete, das Kostgeld ... Das zahlst du mir alles zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371223
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Wütende, aber beherrschte Stimme"
				},
				{
					"id": 705371223,
					"content": "Nein, nein, nein! Moment mal! Phonia, meine liebe Phonia! Auch wenn ich dir früher dutzende Streiche gespielt habe ... Der von gerade eben geht nicht auf meine Kappe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371224
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Panische, aber zweifelnde Stimme"
				},
				{
					"id": 705371224,
					"content": "Wenn ich wirklich Zünder herstellen könnte, die auch nach so langer Zeit im Wasser noch zuverlässig sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371225
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Panische, aber zweifelnde Stimme"
				},
				{
					"id": 705371225,
					"content": "Ich hätte nicht mein Leben riskieren müssen, um die Bomben manuell zu zünden, als wir die Hilichurle das letzte Mal überfallen haben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371226
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Panische, aber zweifelnde Stimme"
				},
				{
					"id": 705371226,
					"content": "... Stimmt auch wieder. Bei deinem schlichten Gemüt, kommst du sicher nicht auf die Idee, mich mit Zeitzündern reinzulegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371227
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Wütende, aber beherrschte Stimme"
				},
				{
					"id": 705371227,
					"content": "Aber du!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371228
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Panische, aber zweifelnde Stimme"
				},
				{
					"id": 705371228,
					"content": "Du hast mich doch auch reingelegt! Hast du nicht gesagt, dass du bei jeder größeren Bewegung dein Gehör verlieren würdest, wenn du diesen Detektor verwendest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371229
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Panische, aber zweifelnde Stimme"
				},
				{
					"id": 705371229,
					"content": "Du scheinst mir nicht gerade taub zu sein, immerhin kannst du immer noch so energisch mit mir streiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371230
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Panische, aber zweifelnde Stimme"
				},
				{
					"id": 705371230,
					"content": "Du hast überhaupt keine Ahnung! Der Gehörverlust staut sich langsam auf, um dann phasenweise hervorzubrechen! Wenn du mich jetzt so laut anschreist, verstärkt das meinen Gehörverlust nur noch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371231
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Wütende, aber beherrschte Stimme"
				},
				{
					"id": 705371231,
					"content": "Es ist gut möglich, dass ich eines Tages die Fähigkeit verliere, die feinen Tonmuster zu unterscheiden, und das wird dann auch der Tag sein, an dem ich meine Arbeit verliere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371232
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Wütende, aber beherrschte Stimme"
				},
				{
					"id": 705371232,
					"content": "Zu diesem Zeitpunkt wirst du auch kein Haus mehr zum Wohnen haben! Weil ich nämlich dann das gesamte Haus an den Höchstbietenden vermieten werde! Und dann werde ... werde ich ... Fischerin! Aber du bist mir sowieso egal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371233
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Wütende, aber beherrschte Stimme"
				},
				{
					"id": 705371233,
					"content": "Na, dann streite ich eben leise mit dir ... Ich spreche ganz leise ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371234
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Panische, aber zweifelnde Stimme"
				},
				{
					"id": 705371234,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371235
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Leise Stimme"
				},
				{
					"id": 705371235,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371236
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Verblassende Stimme"
				},
				{
					"id": 705371236,
					"content": "Paimon kann nicht richtig verstehen, was die dort reden ... Sie scheinen nur mit Streiten beschäftigt zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371237,
						705371238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371237,
					"content": "Juhu! Das macht total viel Spaß!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371239
					]
				},
				{
					"id": 705371239,
					"content": "Ein Riesenspaß! Werfen wir noch eine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371240,
					"content": "Ach nein, ein Mal reicht. Wenn wir weitermachen, kommen die zwei vielleicht her und schauen, was los ist. Wir dürfen uns nicht erwischen lassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371241,
					"content": "Paimon denkt allerdings, dass wir ein ... mittelgroßes Problem geschaffen haben könnten. Aber es hat Paimons ständige Neugier befriedigt, sehr befriedigt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371238,
					"content": "Und es gibt überhaupt keine Probleme!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371239
					]
				},
				{
					"id": 705371211,
					"content": "Wirf sie mit aller Kraft!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371212
					]
				},
				{
					"id": 705371204,
					"content": "Möchtest du nicht wissen, wie es sich anfühlt, Bomben zu schmeißen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371205
					]
				}
			]
		},
		{
			"id": 7053713,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_ACTIVITY_CLIENT_COND",
						"rawParams": [
							"5160",
							"5160001",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7053701",
							"2"
						],
						"stepId": 7053701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verdächtige Holzkiste"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705371301,
					"content": "Ui! Das macht mir Angst! Lass uns schnell abhauen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371302
					]
				},
				{
					"id": 705371302,
					"content": "Ja, genau, eine ganze Kiste voller Bomben. Das schreit geradezu Gefahr, lass uns schnell verschwinden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7053714,
			"completionStepIds": [],
