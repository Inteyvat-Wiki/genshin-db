				]
			},
			"dialogs": [
				{
					"id": 747080101,
					"content": "#{NICKNAME} und Paimon, hallo ihr zwei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080102,
					"content": "Fräulein Guillotin hat erwähnt, dass ihr ein Aquarium betreibt. Natürlich habe ich ihre Einladung angenommen, um als Meeresberater zu helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080103,
						747080104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080103,
					"content": "Schön, dass du dabei bist!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				},
				{
					"id": 747080105,
					"content": "Super! Wenn Oberschwester Sigewinne dabei ist, müssen wir uns keine Sorgen machen, dass die Fischlein krank werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747080106,
					"content": "Hehe, da ihr mich gebeten habt, auf die Tiere in Chevalmarins Filmtasieland aufzupassen, habe ich ein paar Tricks gelernt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080107,
					"content": "Wie sich herausstellt, unterscheidet sich die Pflege von Tieren gar nicht so sehr von der Pflege von Patienten. Nun ja, zumindest bei den braven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080108,
					"content": "#Aber dieses Mal möchte ich nicht nur normale Fische zeigen. Ich habe auch einige Pläne in Sachen „Erholung“, die {NICKNAME} und ich mal besprechen könnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080109,
					"content": "Nur zu. Ich bin ganz Ohr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080110
					]
				},
				{
					"id": 747080110,
					"content": "Frau Ceasth hat berichtet, dass einige wilde Fische in letzter Zeit ungewöhnlich aggressiv geworden sind. Anscheinend greifen sie andere Lebewesen, Taucher und sogar kleine Boote an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080111,
					"content": "Ich habe mich gefragt, ob wir sie ins Aquarium einladen könnten, damit sie sich ausruhen und entspannen können? Zumindest wird sie das davon abhalten, noch mehr Ärger zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080112
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080112,
					"content": "Sobald sie hier sind, kann ich nach einem Weg suchen, ihre plötzliche schlechte Laune zu heilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080113,
					"content": "Auf diese Weise können wir den Fischen und dem Gewässer helfen, wieder in Ruhe zu kommen, und ihr könnt eurem Aquarium ein paar einzigartige Gastkünstler hinzufügen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080114
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080114,
					"content": "Was für eine wunderbare Idee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747080115,
					"content": "Du hast meine volle Unterstützung!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080116
					]
				},
				{
					"id": 747080116,
					"content": "Also gut, ich gebe euch alle Infos, die ich darüber habe, wo ihr diese aggressiven Fische finden könnt. Der Rest liegt in euren Händen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080104,
					"content": "Wir sind so froh über die zusätzliche Hilfe!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				}
			]
		}
	]
}