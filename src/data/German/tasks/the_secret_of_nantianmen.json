						718080502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718080502,
					"content": "Oh? Da drüben ist ein kleines Mädchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718080503,
					"content": "Ein Erdbeben! Was geht hier vor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718080504,
					"content": "Achtung, das sieht nicht gut aus ...",
					"roleType": "TALK_ROLE_NPC",
