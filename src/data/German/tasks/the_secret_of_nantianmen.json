					"Jiayi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718080301,
					"content": "Du bist zurück. Wie ist die Lage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080302
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080302,
					"content": "Also, die Lage in Nantianmen ist so ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080303
					]
				},
				{
					"id": 718080303,
					"content": "Erdbeben, Monster und ein kleines Mädchen ... Wird es vielleicht vermisst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080304
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080304,
					"content": "Was sie sagte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080305
					]
				},
				{
					"id": 718080305,
					"content": "Sie sagte was? „Der Eine“? „Auferstehung“? So ein Gefasel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080306
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080306,
					"content": "Sie halt wohl die falschen Bücher gelesen. Nun gut. Ich werde ein paar Leute nach dem Kind schicken, sie bringen es zurück in die Stadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080307
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080307,
					"content": "Erdbeben und Monster ... Hoffentlich ist das Kind nicht verletzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080308
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080308,
					"content": "Vielen Dank. Bitte nimm dies als Dank für deine Mühe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080309
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080309,
					"content": "Argh, man kommt einfach nie zur Ruhe, was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
