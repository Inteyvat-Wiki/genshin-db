			"dialogs": [
				{
					"id": 718080801,
					"content": "Du bist zurück. Wie ist die Lage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080802
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080802,
					"content": "Also, die Lage in Nantianmen ist so ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080803
					]
				},
				{
					"id": 718080803,
					"content": "Ach, wirklich? Es gab tatsächlich ein Erdbeben? ... Gefolgt von Monstern wie aus dem Nichts?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080804
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080804,
					"content": "Die Monster dort sind nichts Neues, aber diese Erdbeben ... was könnte die Ursache sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080805
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080805,
					"content": "Nun, was auch immer vonstattengeht, Sicherheit hat oberste Priorität.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080806
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080806,
					"content": "Ich werde dem Rat für Allgemeine Angelegenheiten einen detaillierten Bericht über den Sachverhalt erstatten. Vielen Dank für deine Hilfe. Bitte nimm dies als Zeichen meiner Dankbarkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080807
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080807,
					"content": "Uff, die Arbeit häuft sich immer weiter an und ich komme nicht hinterher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
