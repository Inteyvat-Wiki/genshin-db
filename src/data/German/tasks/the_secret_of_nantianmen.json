				{
					"id": 718080901,
					"content": "Du bist wieder da. Wie sieht es aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080902
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080902,
					"content": "Alles scheint normal zu sein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080903
					]
				},
				{
					"id": 718080903,
					"content": "Normal? Also ... keine Erdbeben, keine Monster? Wie seltsam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080904
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080904,
					"content": "Trotzdem, Normalität ist eine gute Nachricht. Vielen Dank für deine Hilfe. Bitte nimm dies als Zeichen meiner Dankbarkeit",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080905
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080905,
					"content": "Gut, auf zur nächsten Aufgabe ... Egal, wie viel ich erledigt habe, es gibt immer mehr zu tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
