			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lächelnder Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030401,
					"content": "Los, geh schon, bevor er so hungrig wird, dass er was anstellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030402
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030402,
					"content": "Warum willst du ihm überhaupt etwas geben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030403
					]
				},
				{
					"id": 220030403,
					"content": "Was glaubst du denn? Er hat sonst keinen. In ganz Liyue kennt er nur mich ganz allein. Er traut sich nur, bei mir um Essen zu bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030404
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030404,
					"content": "Brauchst du noch einen Grund? Mir macht es Spaß. Reicht das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030405
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030405,
					"content": "Und was machen wir, wenn er wieder im Dihua-Moor verrückt spielen würde? Da gebe ich ihm lieber gleich was zu essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030406
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030406,
					"content": "Warum bist du überhaupt noch hier? Jetzt geh schon und vertrödle keine Zeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lächelnder Yanxiao"
				}
			]
		},
		{
			"id": 2200305,
			"completionStepIds": [
				2200304
