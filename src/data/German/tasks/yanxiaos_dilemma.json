			"dialogs": [
				{
					"id": 220030201,
					"content": "Hast du die Zutaten dabei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030202,
						220030203
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030202,
					"content": "Ja, hier sind sie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220030203,
					"content": "Nein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030204
					]
				},
				{
					"id": 220030204,
					"content": "Oh ... Dann mach bitte schnell. Sonst kommt dieser Schnorrer wieder auf dumme Gedanken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lächelnder Yanxiao"
				}
			]
		},
		{
