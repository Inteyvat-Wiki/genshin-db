			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lächelnder Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030601,
					"content": "Hast du ihm das Essen gebracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030602
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030602,
					"content": "Ja, er sagt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030603
					]
				},
				{
					"id": 220030603,
					"content": "Ach, hör mir bloß auf! Er hat sicher auch nur wieder Danke gesagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030604
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030604,
					"content": "Mir tun schon die Ohren weh. Immer das gleiche all die Jahre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030605
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030605,
					"content": "Mal sagt er Danke, mal angelt er. Besser wäre es, wenn er ein bisschen im Gasthaus aushelfen würde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030606
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030606,
					"content": "Hach, was erzähl ich dir das? Hier hast du das. Jetzt kümmer dich wieder um deine eigenen Sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lächelnder Yanxiao"
				}
			]
		},
		{
			"id": 2200307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200305",
							"2"
						],
						"stepId": 2200305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030701,
					"content": "Hm? Worauf wartest du? Geh lieber zurück, bevor der Koch wieder ausflippt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030702
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030702,
					"content": "Warum bringt er dir immer Essen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030703
					]
				},
				{
					"id": 220030703,
					"content": "Wir ... kennen uns schon ziemlich lange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030704
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030704,
					"content": "Nun ja, ich war mal beim Dihua-Moor und habe dort einen Fehler begangen, der nicht zu verhindern war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030705
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030705,
					"content": "In ganz Liyue lässt mich jetzt nur noch dieses Gasthaus bei sich wohnen. Der Koch macht mir Essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030706
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030706,
					"content": "Wenn ich weiter ausholen soll, wird das eine lange Geschichte. Ich befürchte, dass du Wichtigeres zu tun hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030707
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030707,
					"content": "Dann geh lieber. Der Koch ist nicht sehr geduldig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		}
	]
}