			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lächelnder Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030301,
					"content": "Warte kurz. Ich werde das Essen zubereiten und dir geben, damit du es ihm gleich geben kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030302
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030302,
					"content": "Was hast du denn? Du kriegst ja auch was dafür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030303
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030303,
					"content": "Fertig. Gib das bitte dem Schnorrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030304
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030304,
					"content": "Der Kerl heißt <color=#00E1FFFF>Jiangxue</color> und angelt die meiste Zeit. Du kannst ihn nicht verfehlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030305
					],
					"speakerTitle": "Lächelnder Yanxiao"
				}
			]
		},
		{
			"id": 2200304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
