			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lächelnder Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030101,
					"content": "Dieser Kerl frisst mir noch die Haare vom Kopf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030102
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030102,
					"content": "Was machst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030103
					]
				},
				{
					"id": 220030103,
					"content": "Ich? Ich habe gerade für einen gewissen Jemand Essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030104
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030104,
					"content": "Er gammelt den ganzen Tag lang herum und hilft kein bisschen im Gasthaus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030105
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030105,
					"content": "Jeden Tag geht er fischen, angelt aber kaum etwas Anständiges aus dem Wasser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030106
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030106,
					"content": "Wenn ich nicht wäre, würde er neben dem Gasthaus verhungern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030107
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030107,
					"content": "Ach, was soll’s? Er hört sowieso nicht. Und wenn er mich hört, tut er so, als wüsste er von nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030108
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030108,
					"content": "Wenn du zu viel Zeit hast, kannst du gern ein wenig Gemüse besorgen. Ich habe bald nicht mehr genug da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030109
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030109,
					"content": "Muss nicht viel sein, einfach eine <color=#00E1FFFF>Jueyun-Peperoni</color> und eine <color=#00E1FFFF>Lotosfrucht</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030110,
						220030112
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030110,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030111
					]
				},
				{
					"id": 220030111,
					"content": "Dann komm einfach mit den Zutaten wieder, sobald du sie hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030112,
					"content": "Im Gasthaus gibt es doch viel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030113
					]
				},
				{
					"id": 220030113,
					"content": "Dafür hat der Inhaber aber Geld ausgegeben. Wer soll denn den Verlust wieder gutmachen, wenn jemand für lau isst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030114
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030114,
					"content": "Für dieses Gemüse habe ich mein eigenes Geld ausgegeben. Jetzt schulde ich ihm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030115
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 220030115,
					"content": "Also gut, komm bitte schnell wieder zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lächelnder Yanxiao"
				}
			]
		},
