				]
			},
			"dialogs": [
				{
					"id": 741500301,
					"content": "Seid ihr fertig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500302
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500302,
					"content": "Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500303
					]
				},
				{
					"id": 741500303,
					"content": "Ja, die Reinigung ist erledigt und Molli hat auch die Katze gefüttert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500304,
					"content": "Übrigens, Benoit, neben deinem Haus steht ein Haufen sehr schmutziger Kisten. Willst du, dass wir die auch wegräumen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500305,
					"content": "Kisten? Oh, ist schon in Ordnung, ignoriert sie einfach. Ich habe ein paar alte Sachen darin aufbewahrt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500306
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500306,
					"content": "Es sind Möbel und andere Gegenstände aus meiner früheren Wohnung, die ich nicht wegwerfen wollte ... Aber gleichzeitig passen sie nicht in die Einrichtung meines jetzigen Hauses und so sind sie dort gelandet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500307
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500307,
					"content": "Ich kümmere mich kaum noch um sie und alle in der Nachbarschaft sind anständige Menschen, also stiehlt niemand etwas. Lassen wir sie einfach dort stehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500308
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500308,
					"content": "Herr Leroy, Herr Leroy, war ich dir eine Hilfe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500309
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500309,
					"content": "Ja, natürlich! Du warst mir eine große Hilfe. Vergiss nicht, deine Eltern von mir zu grüßen, Molli. Dann würdest du mir noch mehr helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500310
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500310,
					"content": "Und ich habe die Süßigkeiten und das Taschengeld gleich hier, Kinder, also kommt und holt sie euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500311
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500311,
					"content": "Oh nein, nein, ich brauche kein Taschengeld. Ich würde Nana nur gern wieder streicheln. Darf ich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500312
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500312,
					"content": "Natürlich, aber pass auf ihre Krallen auf und denk daran, dir nach dem Spielen deine Süßigkeiten zu holen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500313
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500313,
					"content": "Vater, was machst du draußen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500314
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500314,
					"content": "Nun, der alte Mann fühlte sich einsam, weil seine Kinder nicht mehr da waren, um ihm Gesellschaft zu leisten, und so beschloss er, an die frische Luft zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500315
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500315,
					"content": "Ach, Morticia, schau, wir sind nur ein paar Tage weg und Vater ist schon sauer auf uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500316
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500316,
					"content": "Aber ich bin sicher, er würde uns verzeihen, wenn er wüsste, welches Geschenk wir dieses Mal mitgebracht haben. Meinst du nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500317
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500317,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500318
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500318,
					"content": "Geschenk? Und was hast du mitgebracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500319
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500319,
					"content": "Etwas Wunderbares, Vater. Du wirst es sofort erkennen, wenn du es siehst. Morticia weiß, wie sehr du schöne, teure Dinge magst. Sie hat es selbst für dich ausgesucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500320
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500320,
					"content": "Vielen Dank, meine Tochter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500321
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500321,
					"content": "War mir ein Vergnügen, Vater.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500322
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500322,
					"content": "Ach ja. Diese beiden netten Gäste sind Kinder, die zum Spielen kamen, als ihr unterwegs wart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500323
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500323,
					"content": "Schön, euch beide kennenzulernen. Mein Vater ist ein freundlicher Mann und liebt Kinder, also danke, dass ihr ihm Gesellschaft geleistet habt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500324
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500324,
					"content": "Aber da meine Frau und ich wieder zurück sind, werden wir es von hier an übernehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500325
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500325,
					"content": "Ah, es ist wirklich schön, dass ihr wieder da seid. Nun, lasst mich einen Blick auf das Geschenk werfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500326
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500326,
					"content": "In Ordnung, Vater. Lass uns erst mal reingehen, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500327
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500327,
					"content": "Gut. Athos, vergiss nicht, ihnen ihre Belohnung und ein paar Süßigkeiten zu geben. Sie haben mir beim Aufräumen geholfen und auch Nana gefüttert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500328
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500328,
					"content": "Ach, und gib der jungen Dame auch ein paar von den Süßigkeiten, ja? Ich gehe erst rein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500329
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500329,
					"content": "Herr Leroy, Nana hat mir erlaubt, ihren Bauch zu streicheln! ... Hm? Wo ist er hin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500330
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500330,
					"content": "Suchst du meinen Vater, kleine Dame? Ich bin sein Schwiegersohn ... Nun, versteht es einfach so, dass ich sein Sohn bin. Mein Name ist Athos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500331
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500331,
					"content": "Ich weiß, was ein Schwiegersohn ist. Das heißt, du bist der Ehemann seiner Tochter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500332
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500332,
					"content": "Haha, du weißt wirklich eine Menge. Danke, dass du meinem Vater Gesellschaft geleistet hast, er ist ins Haus gegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500333
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500333,
					"content": "Diese Süßigkeiten sind für dich. Den Rest kannst du meiner Frau und mir überlassen. Es ist auch in Ordnung, wenn du nicht mehr vorbeikommst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500334
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500334,
					"content": "Ich nehme an, du solltest bald nach Hause gehen. Deine Familie wird sich Sorgen um dich machen, wenn du zu lange draußen bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500335
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500335,
					"content": "Oh, keine Sorge, es ist überhaupt kein Problem. Außerdem haben Herr Leroy und ich schon eine Vereinbarung getroffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500336
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500336,
					"content": "Ich glaube, er könnte wieder meine Hilfe brauchen! Du weißt schon, beim Füttern der Katze, beim Gießen der Bäume und so weiter. Menschen zu helfen, macht mich glücklich, also werde ich auf jeden Fall wiederkommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500337
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500337,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500338
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500338,
					"content": "Tss, wie ärgerlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500339
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500339,
					"content": "Hm? Ist etwas nicht in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500340
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500340,
					"content": "Nein, es ist alles in Ordnung, kleine Dame. Ich habe nur etwas Wichtiges mit dir zu besprechen ... Nein, es gibt nichts zu besprechen, aber du musst etwas für mich tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500341
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500341,
					"content": "Natürlich. Was ist es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500342
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500342,
					"content": "Ich gebe dir jetzt die Süßigkeiten und das Taschengeld, also komm nicht wieder, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500343
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500343,
					"content": "Hm? Warum? Habe ich etwas falsch gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500344
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500344,
					"content": "Nein, überhaupt nicht. Es ist nur so, dass es meinem Vater gesundheitlich nicht gut geht und er in letzter Zeit sehr schlecht schläft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500345
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500345,
					"content": "Meine Frau und ich möchten, dass er eine Umgebung hat, in der er sich gut ausruhen kann. Es geht hier nur um seine Gesundheit. Das verstehst du doch, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500346
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500346,
					"content": "Oh, Herr Leroy fühlt sich also unwohl ... Gut, ich verstehe. Nächstes Mal bringe ich ihm ein paar Blasenmandarinen mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500347
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500347,
					"content": "Papa hat mir beigebracht, dass ich, wenn ich zu viel Kuchen esse und Bauchschmerzen bekomme, weniger Süßigkeiten und mehr Obst essen sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500348
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500348,
					"content": "Solange Herr Leroy jeden Tag etwas Obst zu essen bekommt, wird es ihm bald wieder gutgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500349
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500349,
					"content": "*seufz* ... Nun gut. Ich schätze, ich habe keine andere Wahl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500350
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500350,
					"content": "Und hier sind eure Süßigkeiten und eure Belohnung, ihr beiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500351
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500351,
					"content": "Nun möchte ich aber Klartext reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500352
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500352,
					"content": "Ich spreche hier im Namen der gesamten Familie Leroy. Ich hoffe, dass ihr uns in Zukunft nicht mehr stören werdet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500353
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500353,
					"content": "Ich denke, ihr könnt mich trotz eurer Jugend verstehen, also macht euch bitte nicht die Mühe, wiederzukommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500354
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500354,
					"content": "Das ist alles, was ich zu sagen habe. Ich werde mich jetzt verabschieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500355
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500355,
					"content": "Warum können wir nicht mehr kommen? Das ist so seltsam! Herr Leroy war so nett, aber dieser Mann will uns nicht wiederkommen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500356
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500356,
					"content": "Ja, genau! Der Kerl spricht zwar höflich, aber er ist so kalt wie nur möglich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500357,
					"content": "Hmpf, es ist mir egal, was er gesagt hat. Ich werde morgen noch mal zu Herrn Leroy gehen. Was ist mit euch beiden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500358
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500358,
					"content": "Kommt einfach mit! Nana ist so süß, ich will sie noch ein bisschen streicheln ... und ... und Herr Leroy wird uns Süßigkeiten geben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500359,
						741500361
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500359,
					"content": "Wir kommen mit dir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500360
					]
				},
				{
					"id": 741500360,
					"content": "Dann ist es abgemacht! Wir kommen zusammen und spielen mit Nana und Herrn Leroy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500361,
					"content": "Vielleicht, wenn ich Zeit habe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500362
					]
				},
				{
					"id": 741500362,
					"content": "Na gut ... Dann bis zum nächsten Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Molli"
				}
			]
		},
		{
