			},
			"dialogs": [
				{
					"id": 741500101,
					"content": "Ich danke dir, Molli. Deine Nächstenliebe funkelt in deinen schönen lavendelfarbenen Augen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500102
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500102,
					"content": "Hehe, wirklich? Hat dir die Puppe, die ich dir letztes Mal mitgebracht habe, wirklich gefallen, Herr Leroy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500103
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500103,
					"content": "Oh, ja, ich mag sie sehr, sie ist wirklich sehr süß. Ich habe ihr sogar einen Platz am Esstisch eingeräumt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500104
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500104,
					"content": "Dann muss sie sehr glücklich sein! Hehe, und was ist mit heute? Soll ich dich auf einen Spaziergang begleiten? Oder soll ich dir die Zeitung holen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500105
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500105,
					"content": "Und ich kann dir auch die Zeitung vorlesen, wenn deine Augen zu müde sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500106
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500106,
					"content": "Mama hat gesagt, dass ich jeden Tag eine gute Tat vollbringen soll. Und meine Tutorin möchte, dass ich diese Woche einen Aufsatz über gute Leute und gute Taten schreibe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500107
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500107,
					"content": "Ach, ich meine nicht, dass ich das mache, weil ich einen Aufsatz schreiben muss, aber wenn es dir nichts ausmacht, würde ich dir wirklich gern helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500108
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500108,
					"content": "Haha, das ist in Ordnung. Das Beste, was du tun kannst, um mir zu helfen, ist, deinen Eltern zu sagen, dass du oft zu mir zum Spielen kommst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500109
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500109,
					"content": "Ich habe es meinen Eltern schon gesagt, Herr Leroy, aber sie scheinen nicht sehr erfreut darüber zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500110
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500110,
					"content": "Und wirst du mich wieder besuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500111
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500111,
					"content": "Ja, auch wenn meine Eltern es mir nicht erlauben. Denn wir haben bereits eine Vereinbarung getroffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500112
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500112,
					"content": "Haha, du bist wirklich ein Mädchen, das zu seinem Wort steht. Brave Molli, Opa Leroy mag dich sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500113
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500113,
					"content": "Oh, meine hilfsbereiten jungen Freunde, willkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500114
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500114,
					"content": "Ähem, wir wollten euer Gespräch nicht unterbrechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500115,
					"content": "Stören wir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500116
					]
				},
				{
					"id": 741500116,
					"content": "Nein, nein, ihr stört überhaupt nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500117
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500117,
					"content": "Meine junge Freundin Molli hier ist gerade unterwegs und mit ihren Hausaufgaben beschäftigt. Sie ist zufällig vorbeigekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500118
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500118,
					"content": "Sie würde gern etwas Nettes für mich tun, damit sie etwas Material für ihren Aufsatz sammeln kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500119
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500119,
					"content": "He! Ich helfe doch nicht, weil ich meine Hausaufgaben machen will! Na ja, jedenfalls nicht nur deswegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500120
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500120,
					"content": "Na klar. Ich glaube dir, dass du ein gutes Mädchen bist. Deine Hilfsbereitschaft hängt natürlich nicht von deinen Hausaufgaben ab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500121
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500121,
					"content": "Genau wie die beiden Gäste hier. Sie besuchen mich doch nicht, weil sie eine Arbeit brauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500122
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500122,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500123
					]
				},
				{
					"id": 741500123,
					"content": "Ähm ... tja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500124,
					"content": "Hahaha, das war nur ein kleiner Scherz. Ihr werdet doch sicher nicht böse auf einen alten Mann sein, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500125
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500125,
					"content": "Junge Leute haben viel Zeit, die sie verbringen können, wie sie wollen. Da ihr bereit seid, eure Zeit mit mir zu verbringen, und ich die Gesellschaft der jungen Leute genieße ... Wo liegt das Problem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500126
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500126,
					"content": "Lasst mich euch einfach etwas zu tun geben. Jeden Tag kommen viele Leute an meiner Tür vorbei, sodass es hier sehr schnell staubig wird, und ich habe den Bereich hinter meinem Haus schon seit ein paar Tagen nicht mehr saubergemacht. Würdet ihr diese Stellen noch einmal für mich reinigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500127
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500127,
					"content": "Nun ... Na gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500128,
					"content": "Molli, würdest du meiner Katze Gesellschaft leisten? Ah, und gib ihr auch ein Stück Fisch. Sie heißt übrigens Nana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500129
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500129,
					"content": "Sie hat diesen Namen von einem Hund geerbt, den ich hatte ... Leider hat meine Tochter ihn mitgenommen, als sie wegging, um zu heiraten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500130
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500130,
					"content": "Klar, Herr Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500131
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500131,
					"content": "Also dann, Kinder, auf geht’s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				}
			]
		},
