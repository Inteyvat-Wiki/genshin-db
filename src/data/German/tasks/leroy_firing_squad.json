			"dialogs": [
				{
					"id": 741490601,
					"content": "Zeitungszustellung? Leg sie einfach vor die Tür, danke. Ich werde sie später abholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490602
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490602,
					"content": "(Wir haben Benoit heute schon geholfen. Es wäre unhöflich, ihn zu stören. Da wir vereinbart haben, uns morgen wieder zu treffen, sollten wir einfach auf morgen warten ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Einmal klopfen"
				}
			]
		},
		{
