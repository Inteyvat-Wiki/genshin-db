						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415005",
							"2"
						],
						"stepId": 7415005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Benoit Leroy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741500601,
					"content": "Meine Kinder sind nicht zu Hause. Es ist schwer für mich, die Reinigung allein zu machen. Bitte hilf mir also, die Bereiche vor der Tür und hinter dem Haus zu reinigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				}
			]
		},
		{
			"id": 7415007,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415005",
							"2"
						],
						"stepId": 7415005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 741500701,
					"content": "(Diese Kisten sind alt, schwer und mit einer Staubschicht bedeckt. Ihre Anwesenheit hier auf der hellen, sauberen Straße des Hofs von Fontaine ist ziemlich unangenehm.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500702
					],
					"speakerTitle": "Seltsame Kisten"
				},
				{
					"id": 741500702,
					"content": "(Die Böden dieser Kisten haben im Laufe der Jahre deutliche Wasserflecken bekommen. Sie müssen einst an einem äußerst feuchten Ort gestapelt worden sein.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500703
					],
					"speakerTitle": "Seltsame Kisten"
				},
				{
					"id": 741500703,
					"content": "(Verglichen mit dem Staub vor der Tür scheinen diese Kisten viel dringender beseitigt werden zu müssen.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Seltsame Kisten"
				}
			]
		},
		{
			"id": 7415008,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415001",
							"3"
						],
						"stepId": 7415001,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415005",
							"2"
						],
						"stepId": 7415005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 741500801,
					"content": "Oh, du kannst aufhören, an die Tür zu klopfen, es wird niemand aufmachen. Morticia und Athos sind nicht zu Hause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500802
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500802,
					"content": "Sie sagten, sie würden heute zurückkommen, aber es scheint, dass sie sich aus irgendeinem Grund verspätet haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500803
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500803,
					"content": "Das ist das Problem mit großen Kindern. Sie haben immer ihre eigenen Dinge zu tun und sind oft nicht da, wenn man sie braucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				}
			]
		}
	]
}