				{
					"id": 741500401,
					"content": "Nana, Nana, möchtest du etwas Fisch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Molli"
				}
			]
		},
		{
			"id": 7415006,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
