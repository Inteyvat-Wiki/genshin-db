			"trigger": {
				"objectNames": [
					"„Kichiboushi“",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722620101,
					"content": "Oh, das Meer hier, wie schön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620102
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620102,
					"content": "Was? Das Dihua-Moor ist nicht das Meer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620103,
					"content": "Aber die Gewässer vom Dihua-Moor sind mit dem Meer verbunden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620104
					]
				},
				{
					"id": 722620104,
					"content": "Nun, das stimmt ... aber es fühlt sich trotzdem nicht richtig an, zu sagen, dass das Moor das Meer ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620105,
					"content": "Das verstehe ich nicht ganz. Was ist der Unterschied zwischen „dem Meer“ und „nicht dem Meer“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620106,
						722620110,
						722620114
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620106,
					"content": "Das Wasser? Der Geschmack davon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620107
					]
				},
				{
					"id": 722620107,
					"content": "Hm! Die Bäche im Wald sind ein bisschen süß, also ist es nicht das Meer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620108
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620108,
					"content": "Aber als was soll es gezählt werden, wenn der Mostsee voll mit Most wäre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620109,
					"content": "Das würde Venti glücklich machen, nicht wahr?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620120
					]
				},
				{
					"id": 722620120,
					"content": "Aber abgesehen von dieser Frage: Wird Kichiboushi nicht immer besser im Reden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620121,
						722620122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620121,
					"content": "Nach dem, was Ioroi sagte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620123
					]
				},
				{
					"id": 722620123,
					"content": "Was hat Ioroi gesagt? „Ich bin ein berühmter Bakedanuki“ ... Nein, nicht das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620124,
					"content": "„Ich versuche, mich am Bauch zu kratzen, ooohooh.“ ... Auch nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620125,
					"content": "Hahah, Paimon kann das gut nachmachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620126
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620126,
					"content": "„Die Anpassung an Kichiboushis Art und Weise ...“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620127
					]
				},
				{
					"id": 722620127,
					"content": "Ah, ja, oh! Je mehr wir uns an Kichiboushi anpassen, desto besser verstehen wir, was er meint.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620128,
					"content": "#Und Übungen! Zusammen mit {NICKNAME} und Paimon hat Kichiboushi so viele Dinge gelernt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620129,
						722620133
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620129,
					"content": "Paimon ist eine großartige Führerin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620130
					]
				},
				{
					"id": 722620130,
					"content": "Ähm ... Ähmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620131,
					"content": "#Es ist so lange her, aber {NICKNAME} erinnert sich noch daran. So toll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620132,
					"content": "#Ja, {NICKNAME} und Paimon, vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620136
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620136,
					"content": "Das „Ich weiß nicht, ob es das Meer ist“ ist wunderschön hier und es gibt schöne Häuser so hoch oben im Hintergrund. Machst du ein Foto für mich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620137
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620137,
					"content": "Werde ich machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 722620133,
					"content": "Partner für gemeinsame Abenteuer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620134
					]
				},
				{
					"id": 722620134,
					"content": "Ja! Partner!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620135
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620135,
					"content": "Beste Partner!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620122,
					"content": "Vor der Abreise sagte Ioroi ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620123
					]
				},
				{
					"id": 722620110,
					"content": "Die große Wasserfläche außerhalb der Landmasse ist das Meer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620111
					]
				},
				{
					"id": 722620111,
					"content": "Oh, das klingt nach einer strengen Antwort! Aber dann stellt sich wieder die Frage nach der „Abgrenzung“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620112,
					"content": "#{NICKNAME} hat gerade gesagt, dass das Wasser des Dihua-Moors mit dem Meer verbunden ist. Was ist dann die Abgrenzung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620113
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620113,
					"content": "Und obwohl es sich streng anhört, ist es keine Lösung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620114,
					"content": "Diese Konzepte sind von Menschen gemacht. Es gibt keine echte Bedeutung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620115
					]
				},
				{
					"id": 722620115,
					"content": "Wenn das Dihua-Moor sich wie das Meer anfühlt, dann ist es das Meer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620116
					]
				},
				{
					"id": 722620116,
					"content": "Wenn Kichiboushi denkt, er sei ein Adept, ist er es dann auch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620117
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620117,
					"content": "#Nein! Kichiboushi soll nicht auf {NICKNAME} hören ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620118,
					"content": "... Aber auch wenn es zugespitzt ist, ist es nicht völlig unvernünftig. Wenn du ein Bakedanuki sein willst, kannst du einer sein! Vielleicht wirst du sogar ein Adepten-Tanuki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620119,
					"content": "Adepten-Tanuki! Juhu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620120
					],
					"speakerTitle": "„Kichiboushi“"
				}
			]
		},
