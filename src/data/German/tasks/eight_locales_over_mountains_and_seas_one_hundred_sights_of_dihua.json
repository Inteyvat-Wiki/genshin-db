					"nextDialogs": [
						722620402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620402,
					"content": "Ich will mit dem Wasser spielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620403
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620403,
					"content": "He, nicht jetzt! Das wird die Fische verscheuchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620404,
					"content": "Die Grundlagen der Angelausbildung werden kurz und prägnant vermittelt.\\nObwohl der Unterricht so genau wie möglich ist, bleibt die Frage, wie viel davon tatsächlich verstanden wird aber ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722620405
					]
				},
				{
					"id": 722620405,
					"content": "Fisch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620406
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620406,
					"content": "Kapiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620407
					]
				},
				{
					"id": 722620407,
					"content": "Hahaha, Fische sind so dumm. Sie werden mit Essen angelockt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620408,
						722620410,
						722620412
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620408,
					"content": "Paimon auch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620409
					]
				},
				{
					"id": 722620409,
					"content": "He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620413,
					"content": "Schließlich haben wir alle eine Vorliebe für leckeres Essen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620414,
					"content": "#Also, {NICKNAME}, bitte zeig Kichiboushi, wie es geht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620410,
					"content": "Kichiboushi auch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620411
					]
				},
				{
					"id": 722620411,
					"content": "Hä?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620413
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620412,
					"content": "Und ich ebenso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620413
					]
				}
			]
		},
