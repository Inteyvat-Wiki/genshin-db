			"dialogs": [
				{
					"id": 722620201,
					"content": "Fertig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620202,
					"content": "Und jetzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620203,
					"content": "Also, auf geht’s! Hast du schon einmal geangelt, Kichiboushi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620204,
					"content": "Geangelt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620205
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620205,
					"content": "Anscheinend noch nicht! Komm, lass uns zum Wasser gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620206,
					"content": "Gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Kichiboushi“"
				}
			]
		},
		{
			"id": 7226203,
			"completionStepIds": [
				7226207
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226207",
							"2"
						],
						"stepId": 7226207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Kichiboushi“",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722620301,
					"content": "Mhm ... Warum ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620302
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620302,
					"content": "Kichiboushi! Wie sind wir in ein Lager der Hilichurle gekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620303,
					"content": "Ich hatte erwartet, dass ich mit den Hilichurlen spielen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620304
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620304,
					"content": "Was? Warum glaubst du das? Hilichurle sind sehr gefährliche Monster ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620305,
						722620307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620305,
					"content": "Pfft, die sind auch nicht sehr gefährlich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620306
					]
				},
				{
					"id": 722620306,
					"content": "He! Kichiboushi ist kein kampferprobter Reisender wie du!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620309,
					"content": "Als wir uns das erste Mal im Chinju-Wald trafen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620310
					]
				},
				{
					"id": 722620310,
					"content": "Ja, wurde Kichiboushi nicht von Hilichurlen umzingelt und hat sich versteckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620311,
					"content": "Als ich euch vorhin gesehen habe ... mal sehen ... mal sehen ... ah, ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620312
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620312,
					"content": "Zu dieser Zeit spielte ich mit den Hilichurlen Verstecken. Die im Wald greifen die Bakedanuki nicht an. Und sie haben oft mit uns gespielt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620313
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620313,
					"content": "Was? Bildet sich da eine Art harmonische Symbiose ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620314,
					"content": "Ich weiß nicht, warum die Hilichurle hier so sind. Oooh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620315
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620315,
					"content": "Wie auch immer, seid vorsichtig da draußen! Selbst wenn es die Hilichurle sind ... nein, Paimon sollte sagen, weil es sie sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620316,
					"content": "#Uuh, es ist kompliziert ... {NICKNAME}, du bist doch da, um Paimon zu helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620317,
					"content": "Du musst lernen, die guten von den bösen Jungs zu unterscheiden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620318
					]
				},
				{
					"id": 722620318,
					"content": "Hmmm! So kannst du da draußen sein und dich schützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620319,
					"content": "Vergiss aber nicht, auch freundlich und aufgeschlossen zu sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620320
					]
				},
				{
					"id": 722620320,
					"content": "Mhmm, ja! So kann man die guten Dinge behalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620321,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620322
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620322,
					"content": "#{NICKNAME} und Paimon sagen komplizierte Sachen, ich verstehe es nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620323
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620323,
					"content": "Aber ich weiß, dass ihr gute Menschen seid. Deshalb werde ich von euch lernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620324
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620324,
					"content": "#Gut, genug davon. Lass uns zuerst mit {NICKNAME} angeln lernen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620325,
					"content": "Angeln!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620307,
					"content": "O weh! Sehr furchteinflößend!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620308
					]
				},
				{
					"id": 722620308,
					"content": "Kein Grund, ihm so Angst zu machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620309
					],
					"speakerTitle": "Paimon"
				}
			]
		},
