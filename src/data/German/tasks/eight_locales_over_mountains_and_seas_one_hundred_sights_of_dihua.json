			},
			"dialogs": [
				{
					"id": 722620601,
					"content": "Warum kannst du nicht einfach ins Wasser gehen und einen Fisch fangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620602,
						722620603,
						722620604
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620602,
					"content": "Die kannst du so nicht fangen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620605
					]
				},
				{
					"id": 722620605,
					"content": "Nun, Angeln ist auch eine gute Möglichkeit zum Üben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620606,
						722620608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620606,
					"content": "Kichiboushi, probiere es!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620607
					]
				},
				{
					"id": 722620607,
					"content": "Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620610
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620610,
					"content": "Schließlich blieb es Kichiboushi überlassen, sich im Angeln zu versuchen.\\nEs war klar, dass es keine große Beute gab. Am Ende haben die drei es aufgegeben und eine Weile am Wasser gespielt.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722620611
					]
				},
				{
					"id": 722620611,
					"content": "Es war unangenehm, nass zu werden, aber es hat Spaß gemacht, im Wasser zu spielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620612,
					"content": "Ich bin glücklich! Aber Angeln ist so schwierig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620613
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620613,
					"content": "#Aber wenn du Fischen lernst, findest du vielleicht unerwartete Freunde, oder {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620614,
						722620615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620614,
					"content": "Genau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620617
					]
				},
				{
					"id": 722620617,
					"content": "Ich verstehe es nicht wirklich, aber irgendwie doch ein bisschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620618
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620618,
					"content": "#Es hat Spaß gemacht, mit {NICKNAME} und Paimon zu spielen. {NICKNAME} und Paimon sind gute Freunde von Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620619
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620619,
					"content": "Das Üben macht Spaß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620620
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620620,
					"content": "Zu Beginn war es also das Ziel von Ioroi, an acht Orten zu üben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620621,
					"content": "Der Drachengrat, die Guyun-Türme, Mondstadt, Liyue, der Hulao-Berg und heute ... diese Übung ist bereits zu einem großen Teil abgeschlossen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620622,
					"content": "Ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620623
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620623,
					"content": "Hmmm, wo sollen wir als Nächstes hingehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620624,
					"content": "Walte ruhig deines Amtes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620625
					]
				},
				{
					"id": 722620625,
					"content": "#Huu, ein Satz, den {NICKNAME} selten zu sagen bekommt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620626,
					"content": "Ich mach das!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620627,
					"content": "Paimon macht das!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722620615,
					"content": "Ja, aber auch die Kosten für Lebensmittel könnten steigen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620616
					]
				},
				{
					"id": 722620616,
					"content": "He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620608,
					"content": "Paimon, versuch es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620609
					]
				},
				{
					"id": 722620609,
					"content": "Paimon wird ins Meer gezogen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620603,
					"content": "Das ist zwar mühsam, macht aber wahrscheinlich mehr Spaß.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620605
					]
				},
				{
					"id": 722620604,
					"content": "Das ist auch eine Art Übung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620605
					]
				}
			]
