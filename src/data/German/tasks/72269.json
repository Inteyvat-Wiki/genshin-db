			"dialogs": [
				{
					"id": 722690301,
					"content": "Du hast die Prüfung mit Bravour bestanden. Ich, einer der letzten Jibashiri, Eki, erkenne hiermit deine Tapferkeit an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690302
					],
					"speakerTitle": "Eki"
				},
				{
					"id": 722690302,
					"content": "Du bist so scharfsinnig, dass du sogar einen Aal im Winter fangen könntest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690303
					],
					"speakerTitle": "Eki"
				},
				{
					"id": 722690303,
					"content": "Was soll das bedeuten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722690304,
					"content": "Zur Zeit der Aufzucht sind die Jungtiere der Unagi noch sehr, sehr klein. Man muss sich konzentrieren und die Augen zusammenkneifen, um sie zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eki"
				}
			]
		},
