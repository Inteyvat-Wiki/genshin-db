			"dialogs": [
				{
					"id": 722690101,
					"content": "Ich bin einer der letzten Jibashiri, Eki. Recke von Sangonomiya, ich erkenne die Ehre deiner Herausforderung an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690102
					],
					"speakerTitle": "Eki"
				},
				{
					"id": 722690102,
					"content": "Ich werde die Prüfung der Aufmerksamkeit durchführen. Bitte mach dich auf den Weg, um alle Rätsel zu lösen und die „Flammen der hohen Pforte“ wieder an ihren Platz zurückzubringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690103
					],
					"speakerTitle": "Eki"
				},
				{
					"id": 722690103,
					"content": "Das Schlachtfeld ist ständig in Bewegung. Die einzige Möglichkeit, die Situation und alle Variablen zu erfassen, besteht darin, ein Ohr am Boden und ein Auge in alle Himmelsrichtungen zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690103
					],
					"speakerTitle": "Eki"
				}
			]
		},
		{
