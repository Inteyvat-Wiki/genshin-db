				"points": []
			},
			"dialogs": [
				{
					"id": 110120701,
					"content": "Das ... Das ist alles, wovon ich immer geträumt habe! Kloppis Welt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120702,
						110120703
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120702,
					"content": "Das ist die Überraschung, die Bruder für dich vorbereitet hat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120704
					]
				},
				{
					"id": 110120704,
					"content": "Oha ... Er hat es tatsächlich geschafft! Und die Art und Weise, wie er diese Ruinenwächter besiegt hat. Es war, als wären sie wirklich Kinderspielzeug ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120705,
					"content": "Aber Paimon fragt sich, ob es ihm gut gehen wird, nachdem er wieder das Dämonengewand verwendet hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120706,
					"content": "Großartig! He he!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120707
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120707,
					"content": "Junge, wenn diese Kloppis nicht so groß wären, würde ich sicher gerne einen mit nach Hause nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120708
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120708,
					"content": "Warte ... Wo gehst du hin? Wo ist mein Bruder hingegangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120709
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120709,
					"content": "Solltet ihr nicht Verstecken spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120710,
					"content": "Oh, ja richtig! Ich war so aufgeregt, dass ich unser Spiel vergessen habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120711
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120711,
					"content": "#Gut, {NICKNAME}, wir suchen ihn zusammen, in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120703,
					"content": "Kloppi ist der allertollste!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120704
					]
				}
			]
		},
