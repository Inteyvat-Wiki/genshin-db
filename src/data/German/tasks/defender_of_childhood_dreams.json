			"dialogs": [
				{
					"id": 110120601,
					"content": "Teucer, siehst du den großen Steinklotz vor dir? Ich brauche deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120602
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120602,
					"content": "Juhu! Kann ich wirklich meinem großen Bruder helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120603
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120603,
					"content": "Na sicher. Ich zähle jetzt runter von drei. Und dann berühren wir ihn zusammen. Bereit? Drei ... zwei ... eins ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Der Graf“"
				}
			]
		},
		{
			"id": 1101207,
