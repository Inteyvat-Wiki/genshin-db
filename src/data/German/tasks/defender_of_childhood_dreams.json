				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Der Graf“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120101,
					"content": "Da sind wir ... Willkommen in der Spielwaren-Forschungsanstalt von Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120102
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120102,
					"content": "Ja, wir sind hier. Ich kann schon den Klang der Maschinen drinnen hören. Toll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120103
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120103,
					"content": "Was ist das für ein Ort? Und woher weißt du davon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120104,
					"content": "Basierend auf meinem begrenzten Verständnis würde ich sagen, es ist eine der Forschungsanlagen von Il Dottore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120105
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120105,
					"content": "Il Dottore ist ein weiterer der Elf der Fatui. Er hat viel Freude daran, an alten Dingen herumzubasteln. Es ist eine ... persönliche Leidenschaft von ihm. Er hat daher diese Ruinen in ein Forschungslabor für Ruinenwächter umgewandelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120106
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120106,
					"content": "Ääh? Die Ruinenwächter wurden also von den Fatui gebaut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120107,
					"content": "Nein, sie haben eine viel engere Verbindung zum Abgrund. Sie sind genau genommen also unsere Gegner wie die von jemand anderem ... Wir forschen nur, nichts weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120108
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120108,
					"content": "Warum die Ruinenwächter sich seit Kurzem aus dieser Gegend heraus bewegen ... Ich kann mir nur vorstellen, dass es ihm langweilig war, mit ihnen zu spielen und er das Interesse an dem Ort verloren hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120109
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120109,
					"content": "Oh, noch einer von den Elf mit einer schlechten Einstellung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120110,
					"content": "Aber immerhin erklärt das, warum es für dich vollkommen in Ordnung war, Teucer hierher zu bringen. Scheint, als hättest du deine Hausaufgaben im Voraus gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120111,
					"content": "Na ja ... so weit würde ich nicht gehen. Ich habe tatsächlich keine Ahnung, wie der Ort von innen aussieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120112
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120112,
					"content": "W... warte. Du bist also nicht besorgt um die Sicherheit von deinem Bruder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120113,
					"content": "Natürlich bin ich das ... Aber egal, wo die Gefahr liegt, ich werde sie abwehren. Ist es nicht das, was jeder große Bruder tun würde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120114
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120114,
					"content": "Das versteht sogar Teucer. Jetzt weiß er, wofür er kämpft ... Der Grund ist der gleiche, der so viele Jahre in meinem eigenen Herzen geschlummert hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120115
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120115,
					"content": "Über was redet ihr da, Leute? Kommt schon, lasst uns reingehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120116
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120116,
					"content": "Haha, na gut. Folgt mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Der Graf“"
				}
			]
		},
		{
			"id": 1101202,
			"completionStepIds": [
				1101205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101205",
							"2"
						],
						"stepId": 1101205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Der Graf“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120201,
					"content": "Es ist gut, dass ihr beide mich zuerst gefunden habt ... Das Dämonengewand anzulegen, während ich noch verletzt war, hat mich wohl mehr mitgenommen, als ich dachte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120202
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120202,
					"content": "Ich habe keine Ahnung, was ich machen würde, wenn Teucer mich so sehen würde, so anblicken würde, wie einen geplatzten Ballon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120203,
						110120207
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120203,
					"content": "Du hast keine Angst, dass ich dein Leben direkt hier beende?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120204
					]
				},
				{
					"id": 110120204,
					"content": "Haha! Wenn ich mich recht entsinne, hast du auch Geschwister, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120205
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120205,
					"content": "Ich dachte mir, dass du mich wahrscheinlich nicht vor meinem kleinen Bruder ausschaltest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120206
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120206,
					"content": "Aber wir hätten nie gedacht, dass du so weit gehst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120208,
					"content": "Wie gesagt ... Ich kann niemals eine Möglichkeit verpassen, meine Grenzen zu testen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120209
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120209,
					"content": "Und deswegen werde ich, Tartaglia, immer stärker und stärker. *kicher*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120210
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120210,
					"content": "Nun ja, Kinderträume zerplatzen nur allzu schnell. Sogar wenn man sie einfach nur sein lässt, zerfallen sie von sich selbst in Einzelteile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120211
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120211,
					"content": "Also, jemand muss sie beschützen, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120212
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120212,
					"content": "Wer ein Versprechen gibt, der hält es. Wer einen Fehler macht, entschuldigt sich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120213
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120213,
					"content": "Und wenn man jemandem einen Traum gibt, verteidigt man ihn bis zum Schluss ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120214
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120214,
					"content": "Darum geht es bei Familie, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120215
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120215,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120216
					]
				},
				{
					"id": 110120216,
					"content": "Aha. Hat dich das zufällig an etwas erinnert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120217
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120217,
					"content": "*hust* Öhm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120218
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120218,
					"content": "Spiel doch nicht den harten Kerl! Du musst sofort zu einem Arzt, mein Lieber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120219,
					"content": "Ein guter Vorschlag, aber vorher ... Ich habe etwas für Teucer. Bitte gib es ihm an meiner Stelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120220
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120220,
					"content": "Äh, ist das ... eine Puppe von Kloppi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120221,
					"content": "Genau. Ich habe sie vor einiger Zeit von einem Schmied sonderanfertigen lassen. Ich wollte sie ihm bei meiner Rückkehr nach Snezhnaya geben. Aber im Moment scheint es besser als Andenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120222
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120222,
					"content": "Ui ... Jetzt, da Paimon darüber nachdenkt, ist die Familie des Grafen wirklich glücklich, ihn zu haben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120223,
					"content": "Hah. Ich muss dir auch meinen abrupten Aufbruch zu Teucer erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120224
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120224,
					"content": "Du wirst mir helfen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120225,
						110120226
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120225,
					"content": "„Ein Indianerehrenwort hält man sein ganzes Leben ...“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120227
					]
				},
				{
					"id": 110120227,
					"content": "Hahaha ... „damit ihm die Zunge abfriert.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120228
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120228,
					"content": "Ah, dieser Kinderreim bringt so viele schöner Erinnerungen zurück. Teucer hat ihn dir beigebracht, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120229
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120229,
					"content": "Geh in Frieden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120230
					]
				},
				{
					"id": 110120230,
					"content": "... Na gut, danke dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120226,
					"content": "„Wer es bricht, den wirft man in den Gletscher ...“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120227
					]
				},
				{
					"id": 110120207,
					"content": "War es den Aufwand wert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120208
					]
				}
			]
		},
		{
			"id": 1101203,
			"completionStepIds": [
				1101208,
				1101220
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
