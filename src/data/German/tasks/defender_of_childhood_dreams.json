			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teucer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120301,
					"content": "Ich kann ihn nirgends finden ... wo ist er hin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120302,
						110120304
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120302,
					"content": "Ich habe deinen Bruder vor einer Sekunde gefunden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120303
					]
				},
				{
					"id": 110120303,
					"content": "Wirklich? Wo ist er?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120306
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120306,
					"content": "Eine riesige Menge an Leuten wollte Kloppi kaufen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120307
					]
				},
				{
					"id": 110120307,
					"content": "Ja ... also musste er schnell aufbrechen. Er hat dich nicht absichtlich hier verlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120308,
					"content": "Oh ... D... das ist toll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120309
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120309,
					"content": "Aber trotzdem, ich hatte gehofft, wir könnten hier noch ein wenig länger spielen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120310,
						110120311
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120310,
					"content": "Dies ist für dich. Von deinem Bruder.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120312
					]
				},
				{
					"id": 110120312,
					"content": "Oh! Sieh dir das an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120313
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120313,
					"content": "Ich habe gar nicht gewusst, dass sie Kloppi in dieser Größe herstellen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120314
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120314,
					"content": "Schau, er hat sogar meinen Namen darauf! Es ist mein ganz eigener Kloppi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120315
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120315,
					"content": "Du magst es wirklich, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120316,
					"content": "Darauf kannst du wetten! Mein Bruder ist der beste große Bruder auf der Welt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120317
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120317,
					"content": "Du hattest eine Tour durch Liyue, hast deinen Bruder getroffen, die Spielwaren-Forschungsanstalt besucht und ein Andenken gekriegt ... Wir Reiseführer nennen so etwas die perfekte Reise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120318,
					"content": "Denkst du, du bist jetzt bereit zurückzukehren nach Snezhnaya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120319,
					"content": "Hehe ... Mach dir keine Sorgen. Ich weiß, dass nicht immer alles nach meiner Vorstellung geht. Das wäre einfach anstrengend für alle anderen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120320
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120320,
					"content": "Also, lasst uns gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120311,
					"content": "Kloppi wird dir an seiner Stelle Gesellschaft leisten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120312
					]
				},
				{
					"id": 110120304,
					"content": "Er ist schon auf dem Weg zurück.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120305
					]
				},
				{
					"id": 110120305,
					"content": "Was? Warum ... warum würde er ohne mich gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120306
					],
					"speakerTitle": "Teucer"
				}
			]
		},
		{
			"id": 1101204,
			"completionStepIds": [
				1101207
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101207",
							"2"
						],
						"stepId": 1101207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Andrei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120401,
					"content": "#{NICKNAME}, junger Meister Teucer, ich habe auf euch gewartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120402
					],
					"speakerTitle": "Andrei"
				},
				{
					"id": 110120402,
					"content": "Hat der Graf dich geschickt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120403,
					"content": "Das ist korrekt. Der Graf hat mir Anweisungen gegeben, die Rückkehr des jungen Herrn Teucer zu organisieren. Bitte hier entlang ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120404
					],
					"speakerTitle": "Andrei"
				},
				{
					"id": 110120404,
					"content": "Wer bist du? Mein großer Bruder hat mir gesagt, niemals mit Fremden zu gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120405
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120405,
					"content": "Aber du bist uns die ganze Zeit gefolgt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120406,
					"content": "#Ja, weil ich die ganze Zeit wusste, wer du bist, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120407
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120407,
					"content": "Hä?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120408,
					"content": "Mein Bruder hat uns alles über dich in einem Brief erzählt, den er nach Hause geschickt hat. Schwester Tonia hat ihn mir vorgelesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120409
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120409,
					"content": "Ich habe dich tatsächlich in dem Moment erkannt, in dem ich dich gesehen habe. Ich ... konnte mich nur nicht an deinen Namen erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120410
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120410,
					"content": "Was für eine seltsame Laune des Schicksals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120411,
						110120413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120411,
					"content": "Es war mir auch ein Vergnügen, dich zu treffen, Teucer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120412
					]
				},
				{
					"id": 110120412,
					"content": "Hehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120415
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120415,
					"content": "Junger Herr Teucer, das Boot nach Snezhnaya wird bald anlegen. Es wäre das Beste, uns auf unsere Abreise vorzubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120416
					],
					"speakerTitle": "Andrei"
				},
				{
					"id": 110120416,
					"content": "Oho, die Zeit verfliegt wirklich, wenn man Spaß hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120417
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120417,
					"content": "#Na gut, bis dann, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120418
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120418,
					"content": "Ich warte zu Hause auf dich. Du musst unbedingt kommen und Snezhnaya besuchen, unbedingt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120419,
						110120421
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120419,
					"content": "Da sind wir uns einig!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120420
					]
				},
				{
					"id": 110120420,
					"content": "Indianerehrenwort?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120423
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120423,
					"content": "„Ein Indianerehrenwort hält man sein ganzes Leben. Wer es bricht, den wirft Paimon in den Gletscher, damit ihm die Zunge abfriert.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120424,
					"content": "Hehe ... Es ist also ein Versprechen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120425
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120425,
					"content": "Bye bye, Teucer! Gute Reise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120421,
					"content": "Willst du ein Indianerehrenwort geben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120422
					]
				},
				{
					"id": 110120422,
					"content": "Ja, Indianerehrenwort, Indianerehrenwort!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120423
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120413,
					"content": "Dein Bruder hat nichts Schlechtes über mich gesagt, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120414
					]
				},
				{
					"id": 110120414,
					"content": "Überhaupt nicht. Tatsächlich meinte er, wenn er könnte, würde er seinen Beruf aufgeben und dich auf deinen Abenteuern begleiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120415
					],
					"speakerTitle": "Teucer"
				}
			]
		},
