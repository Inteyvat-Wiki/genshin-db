			"dialogs": [
				{
					"id": 110120801,
					"content": "Bruder ... jemand hat gemeint, Kloppi war eine Tötungsmaschine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120802
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120802,
					"content": "War er das? Wie albern, so etwas zu sagen ... Und du solltest es auch nicht wiederholen, Teucer. Du bist viel zu jung, um über solche brutalen Themen zu sprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120803
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120803,
					"content": "Ja, ich weiß sowieso, dass sie gelogen haben. Kloppi ist hier, um die bösen Jungs zu besiegen und die Welt zu beschützen. Er ist mein Lieblingsspielzeug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120804
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120804,
					"content": "Richtig. Mit Kloppi an deiner Seite kriegen dich die bösen Jungs nie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120805
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120805,
					"content": "Hehe, das ist richtig! Na gut, ich werde jetzt mit Kloppi spielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120806
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120806,
					"content": "He, Teucer. Warte mal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120807
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120807,
					"content": "D... die Tür ist zu! Wird es Teucer gut gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120808,
					"content": "Es gibt einen anderen Weg dort drüben - lasst uns gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Der Graf“"
				}
			]
		},
		{
			"id": 1101209,
			"completionStepIds": [
				1101213
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101213",
							"2"
						],
						"stepId": 1101213,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teucer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120901,
					"content": "Oh, die Tür ist aufgegangen! Warst du es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120902
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120902,
					"content": "Das stimmt. Aber lass mir einen Augenblick hier drüben, Teucer. Ich muss mich vergewissern, dass alles sicher ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120903
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110120903,
					"content": "*seufz* Vielleicht hätte ich ihn nicht so verwöhnen sollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Der Graf“"
				}
			]
		},
		{
			"id": 1101210,
			"completionStepIds": [
				1101203,
				1101214
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101214",
							"2"
						],
						"stepId": 1101214,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teucer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110121001,
					"content": "Puh, endlich sind wir wieder zusammen. Teucer, du bist nicht verletzt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121002
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110121002,
					"content": "Verletzt? Auf keinen Fall. Es hat wirklich Spaß gemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121003
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121003,
					"content": "Spaß für dich vielleicht. Uns war Angst und Bange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121004,
					"content": "Was ist da drüben? Oh, dieser Raum ist riesig! Ist das der Ort, wohin Kloppi seine Freunde nimmt, wenn sie zu Besuch kommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121005
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121005,
					"content": "Ja. Beeindruckend, nicht wahr? Wie wäre es jetzt mit einem kleinen Versteckspiel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121006
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110121006,
					"content": "Hmm ... Jetzt? Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121007
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121007,
					"content": "Hehe ... Ich habe eine Überraschung für dich, weißt du.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121008
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110121008,
					"content": "Eine Überraschung! Was für eine Überraschung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121009
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121009,
					"content": "Keine Sorge, du kannst später danach suchen. Aber davor musst du deine Augen schließen, dich umdrehen und von 60 herunterzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121010
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110121010,
					"content": "Na gut ... Aber 60 ist eine richtig lange Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				}
			]
		},
		{
			"id": 1101211,
			"completionStepIds": [
				1101215
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101215",
							"2"
						],
						"stepId": 1101215,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Der Graf“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110121101,
					"content": "He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121102
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110121102,
					"content": "Graf? Du warst also die ganze Zeit hier. Vor was versteckst du dich? Warum bist du nicht gekommen und hast dich verabschiedet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121103,
					"content": "Abschiede sind besondere Momente. Wenn er mich in seinen letzten Augenblicken in Liyue so mitgenommen und schwach gesehen hätte ... Ich will nicht, dass er mit dieser Erinnerung abreist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121104
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110121104,
					"content": "Es ist trotzdem eine Schande, dass ich ihn nicht selbst verabschieden konnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121105
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110121105,
					"content": "*seufz* Es hätte ich sein sollen, der ihn zurückbringt. Ich habe Untergebene, die ihn eskortieren können, aber es macht mich ein wenig nervös.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121106
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110121106,
					"content": "Meine Güte. Glaubst du nicht, du hast ihn genug verhätschelt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121107,
					"content": "Haha. Ich kann es nicht genau erklären, aber irgendwie war es mir viel lieber, als du auf ihn aufgepasst hast. Und wenn ich bedenke, dass wir vor Kurzem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121108
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110121108,
					"content": "Ah, ja. Ich hatte es fast vergessen. Eine Entschädigung für deine Dienste - ohne die ich es dieses Mal wirklich nicht geschafft hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121109
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110121109,
					"content": "Aha, du hast also doch ein Herz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121110,
					"content": "Und noch etwas: Vergiss unser Versprechen nicht. Lass uns nochmal gegeneinander antreten, wenn sich die Chance bietet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121111
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110121111,
					"content": "Dieses Mal steht meine Ehre als einer der Elf auf dem Spiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121112,
						110121113
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110121112,
					"content": "Ich freue mich darauf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110121114
					]
				},
				{
					"id": 110121114,
					"content": "Du solltest dich erst etwas erholen! Aber heul dich nicht bei uns aus, wenn du wieder und wieder verlierst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121115,
					"content": "Hahaha ... Egal, wer unsere nächste Runde gewinnt oder verliert. Ich möchte dich auch zu mir nach Hause einladen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121116
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110121116,
					"content": "Ich werde dich meinen Geschwistern, Tonia und Anton, vorstellen. Sie sind tolle Kinder und ich bin auf beide sehr stolz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121117
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110121117,
					"content": "Das Angebot nehmen wir gerne an! Hauptsächlich weil wir Teucer schon ein Indianerehrenwort gegeben haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121118,
					"content": "Haha, ich bin mir sicher, er wird sich auch sehr darüber freuen, dich zu sehen. Dann ist es ausgemacht. Ich freue mich darauf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121119
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110121119,
					"content": "Macht es gut, meine Freunde, auf Wiedersehen in Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 110121113,
					"content": "Ich werde nicht gegen dich verlieren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110121114
					]
				}
			]
		}
	]
}