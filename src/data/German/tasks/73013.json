	"talks": [
		{
			"id": 7301301,
			"completionStepIds": [
				7301301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301301",
							"2"
						],
						"stepId": 7301301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arapacati",
					"Arama",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130101,
					"content": "Oh! Es ist der goldene Nara! Hä ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130102
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130102,
					"content": "#Arapacati, keine Angst. Nara {NICKNAME} ist ein guter Nara, genauso wie der in den Geschichten beschriebene. Nara {NICKNAME} und Paimon haben uns viel geholfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130103
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130103,
					"content": "#Nun habe ich keine Angst mehr. Arama, Arapacati vertraut dir. Ich glaube, was die Gräser, die Blätter und die Samen sagen, und weiß, dass du ein guter Nara bist. Willkommen, Nara {NICKNAME} und Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130104
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130104,
					"content": "Hallo, Arapacati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130105,
						730130114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130105,
					"content": "Eigentlich bin ich ein böser Mensch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130106
					]
				},
				{
					"id": 730130106,
					"content": "He! Mach nicht solche Witze!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130107,
					"content": "Nein, Arapacati weiß Bescheid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130108
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130108,
					"content": "#An Orten mit viel Wind gibt es kleine Samen. Sie sind mit Nara zusammen nach Vanarana gekommen. Sie sagen, dass Nara {NICKNAME} gut ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130109
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130109,
					"content": "Arama hat auch etwas in dieser Art gesagt! Hmm ... Samen von windigen Orten ... Geht es um Löwenzahn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130110,
						730130111,
						730130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130110,
					"content": "Könnte auch Windmühlenaster sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130115,
					"content": "#Nara {NICKNAME} will Arana helfen, Bija zu bekommen. Daher müssen wir das Utsava-Fest zusammen vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130116
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130116,
					"content": "Oooh ... Das Utsava-Fest ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130117
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130117,
					"content": "Arapacati sieht seltsam aus. Gibt es etwas, das dir Sorgen macht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130118
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130118,
					"content": "Arapacatis „große Brüder“ sind immer noch nicht nach Vanarana zurückgekehrt. Wenn sie nicht bald kommen, dann können wir „Geschwister“ das Utsava-Fest nicht miteinander feiern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130119
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130119,
					"content": "Ich habe Arachatora, Arasaka, Arapas und Araphala auch schon sehr lange nicht mehr in Vanarana gesehen. Seit dem letzten Vorfall sind sie mir nicht mehr untergekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130120
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130120,
					"content": "Wie lange ist ... sehr lange?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130121,
					"content": "Das war vor vielen, vielen Monden. Damals wurden gerade die Setzlinge gekeimt. Jetzt sind sie zu mächtigen Bäumen herangewachsen, die Aranara vor dem Regen schützen können. Siebenmal so groß wie Arapacati sind sie jetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130122
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130122,
					"content": "Seitdem sind die Setzlinge zu mächtigen Bäumen herangewachsen? Oho! Das muss wirklich lange her gewesen sein! Arapacatis Brüder sind verschwunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130123,
					"content": "„Verschwunden“? Ist das eine Art Setzling?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130124
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130124,
					"content": "Oh! Bei den Nara heißen Setzlinge also „Verschwunden“. Großartig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130125
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130125,
					"content": "#Nara sind echt großartig! Nara {NICKNAME} hat sicher ganz viele „Verschwunden“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130126
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130126,
					"content": "Nein, das ist nicht damit gemeint ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130127,
						730130130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130127,
					"content": "Es bedeutet, „wir wissen nicht, wohin sie gegangen sind“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130128
					]
				},
				{
					"id": 730130128,
					"content": "Nein, so ist das nicht. Arapacati weiß, wo Arachatora, Arasaka, Arapas und Araphala sind. Sie sind also nicht verloren gegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130129
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130129,
					"content": "Sie haben Vanarana für lange Zeit für eine Ausbildung verlassen. Eine „Kochausbildung“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130136,
					"content": "So ist das also. Eine „Kochausbildung“ also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130137,
					"content": "Das klingt nach etwas für Paimon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130138
					]
				},
				{
					"id": 730130138,
					"content": "#Hehe! Paimon ist mehr an der „Kochausbildung“ von {NICKNAME} interessiert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130139,
					"content": "Also ... Was ist diese „Kochausbildung“ eigentlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130140,
					"content": "Das ist eine Sache vom letzten Utsava-Fest. Damals bereiteten Nara sehr viele „Gerichte“ zu, um die Aranara davon probieren zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130141
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130141,
					"content": "Also sind Arachatora und die anderen für dieses Utsava-Fest zur „Kochausbildung“ gegangen, um für Nara „Gerichte“ zuzubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130142
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130142,
					"content": "... Jetzt kann Paimon auf einmal das Utsava-Fest kaum erwarten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130143,
						730130145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130143,
					"content": "Aber das ist Essen der Aranara ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130144
					]
				},
				{
					"id": 730130144,
					"content": "Gutes Essen ist die gemeinsame Sprache aller Lebewesen! Kein Problem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130146,
					"content": "Aber wenn Arapacati doch weiß, wo sie sind, warum gehst du sie dann nicht suchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130147,
					"content": "Das herrliche Utsava-Fest wird bald stattfinden. Arapacati hat auch viel zu tun, viel vorzubereiten. Keine Zeit, um sie zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130148
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130148,
					"content": "Für das Utsava-Fest Vanarana verlassen und eine Kochausbildung machen ... Dann aber nicht wissen, dass das Utsava-Fest bald stattfinden wird. Arachatora, Arasaka, Arapas und Araphala sind Idioten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130149
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130149,
					"content": "#Auf jeden Fall müssen wir mit Arama gehen, um die Aranara im Wald zurückzubringen und das Utsava-Fest vorzubereiten. Stimmt’s, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130150,
						730130151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130150,
					"content": "Überlass das uns.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130152,
					"content": "Aber wie können wir Arachatora, Ara... so und so finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130153
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130153,
					"content": "Arachatora, Arasaka, Arapas, und Araphala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130154
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130154,
					"content": "Oh man, Arana, Arama, Araja, Arapacati ... Die Namen der Aranara sind so schwer zu merken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130155,
					"content": "Paimon, sag so etwas nicht über die Namen der Aranara. Du wirst die Aranara traurig machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130156
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130156,
					"content": "Na schön. Aber wie finden wir dann diese verschwundenen Aranara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130157
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130157,
					"content": "Früher haben sie in Vanarana ihre Kochausbildung abgehalten. Doch dabei haben sie richtig viel Rauch produziert, weswegen Arapacati sie dann rausgeworfen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130158
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130158,
					"content": "Das hat damals allen einen gehörigen Schrecken eingejagt. Manche Aranara hatten sogar so viel Angst, dass sie in eine Schlafstarre verfallen sind. Glücklicherweise war Arama tapfer und hat den Rauch bestraft. Arapacati war sehr wütend und hat sie fortgeschickt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130159
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130159,
					"content": "Haltet im Wald eure Augen nach <color=#00E1FFFF>Rauchsäulen</color> offen, dann solltet ihr sie schon finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130160
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130160,
					"content": "Du hast sie also rausgeworfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130161,
					"content": "Ja, war das ein Fehler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130162
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130162,
					"content": "#Nicht wirklich ... Egal, {NICKNAME}, lass uns losgehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130163,
					"content": "Ah, richtig. Da wäre noch etwas. Falls meine Brüder irgendwie seltsam geworden sein sollten, benutzt einfach <color=#00E1FFFF>die Dendro-Kraft</color>, um sie zu „klatschen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130164
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130164,
					"content": "Früher haben sie viel, viel Rauch erzeugt. Ganz Vanarana wurde mit Rauch gefüllt. Sie hatten auch Angst und liefen überall herum. Manchmal wurden sie auch so, wenn sie seltsame Pilze berührten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130165
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130165,
					"content": "Aber Aranara sind Geschöpfe der Wiesen und des Waldes. Deshalb braucht es nur etwas <color=#00E1FFFF>Dendro-Kraft</color> und schon können sie sich erholen und erwachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130166
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130166,
					"content": "#Paimon versteht. {NICKNAME} braucht nur ein süß mariniertes Hühnchen zu essen, um sich zu erholen. {M#Er}{F#Sie} ist also ein Geschöpf des süß marinierten Hühnchens. Das ergibt Sinn, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130167,
						730130171
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130167,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130168
					]
				},
				{
					"id": 730130168,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130169
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130169,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130170
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130170,
					"content": "... Ähem, wir müssen los!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130172
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130172,
					"content": "#Nara {NICKNAME} und Paimon, viel Erfolg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130171,
					"content": "Ähem, los jetzt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130172
					]
				},
				{
					"id": 730130151,
					"content": "Oh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130145,
					"content": "Ja, alles so spannend!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130146
					]
				},
				{
					"id": 730130130,
					"content": "Ich weiß, wie du dich fühlst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130131
					]
				},
				{
					"id": 730130131,
					"content": "#Nara {NICKNAME} versteht auch, wie ich mich fühle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130132
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130132,
					"content": "#Ja, {NICKNAME} hat auch {F#einen Bruder}{M#eine Schwester} verloren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130133,
					"content": "#Oh. Ist {F#der Bruder}{M#die Schwester} von {NICKNAME} auch zur „Kochausbildung“ gegangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130134
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130134,
					"content": "Hä? Das muss ein Missverständnis sein ... Verschwunden bedeutet „niemand weiß, wo sie hingegangen sind“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130135,
					"content": "Ah! Nein, das ist nicht der Fall. Arapacati weiß, dass meine Brüder nicht verschwunden sind. Sie sind außerhalb von Vanarana für ihre „Kochausbildung“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130111,
					"content": "Könnte auch Kiefernzapfen sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130112,
					"content": "Wohl die Samen der Geschichte, vom Wind hergetragen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130113
					]
				},
				{
					"id": 730130113,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130114,
					"content": "Hallo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				}
			]
		},
		{
			"id": 7301302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301302",
							"2"
						],
						"stepId": 7301302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapacati"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130201,
					"content": "... Es ist nicht einfach, sich mit Nara zu unterhalten. Und sie sind so groß ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130202
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130202,
					"content": "Hallo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130203
					]
				},
				{
					"id": 730130203,
					"content": "#Ah! Das ist Nara {NICKNAME} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130204
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130204,
					"content": "Arapacati hat keine Angst. Außerdem sind meine großen Brüder auch mutig und haben sicherlich ebenfalls keine Angst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130205
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130205,
					"content": "Du musst nur den aufsteigenden <color=#00E1FFFF>Rauchsäulen</color> zu folgen, um sie zu finden. Wenn sie sehr seltsam geworden sind, kannst du einfach die <color=#00E1FFFF>Dendro-Kraft</color> benutzen, um sie zu „klatschen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				}
			]
		},
		{
			"id": 7301303,
			"completionStepIds": [
				7301303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301303",
							"2"
						],
						"stepId": 7301303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapacati",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130301,
					"content": "Arapacati ist jetzt aber sehr wütend! Ach! Mehr noch als sehr wütend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130302
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130302,
					"content": "Es ist sehr gefährlich im Wald, „Marana“ treibt dort sein Unwesen. Als ihr loszogt, ermahnte Arapacati euch noch extra, dass ihr ganz mit einem Herz und einer Stimme agieren müsstet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130303
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130303,
					"content": "Und gerade als ihr losgegangen wart, begannt ihr euch heftig zu streiten. Arachatora, du hast sogar etwas Komisches gegessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130304
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130304,
					"content": "*wimmer*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130305
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730130305,
					"content": "Arapacati hat entschieden: für zehn Reifeperioden der Dämmerfrucht darf Arachatora keine Pilze mehr sammeln gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130306
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130306,
					"content": "Wie kann das nur sein ... *schluchz* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130307
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730130307,
					"content": "Genau! Was sollen wir tun, wenn du böse Sporen zurückgebracht hast und hier Pilzmonster wachsen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130308
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730130308,
					"content": "Araphala, du auch! Du hast dich so weit von Vanarana entfernt, um Früchte zu sammeln. Dort gibt es wirklich sehr böse Dinge! Araja hat davon gesprochen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130309
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130309,
					"content": "*wimmer*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130310
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730130310,
					"content": "Genau. Früchte brauchen Wasser, Aranara brauchen auch Wasser. Wasser ist also das Beste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130311
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730130311,
					"content": "Arapas, warum musstest du zur „Varuna-Maschine“ gehen, um dort nach Wasser zu suchen? Weißt du etwa nicht, dass Nara Varuna gesagt hat, dass das Wasser in Vanarana das beste ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130312
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130312,
					"content": "*wimmer*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130313
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730130313,
					"content": "Je... Jetzt seht ihr, dass nur der „Geschmack des Glücks“ kann unserer kleinen Schwester Glück bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130314
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730130314,
					"content": "#Arasaka, ich habe gehört, dass du Nara {NICKNAME}, wegen deines „Geschmacks des Glücks“ einige Kopfschmerzen bereitet hast ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130315
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130315,
					"content": "Da... Das war doch alles für die „größte Delikatesse“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130316
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730130316,
					"content": "Die „größte Delikatesse“ zu erreichen, ist doch das Ziel der „Kochausbildung“. Ah, wo liegt da noch das Vergnügen, wenn man zur Erreichung des Ausbildungsziels die Hilfe anderer benötigt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130317
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130317,
					"content": "Arapacati findet, dass Arasaka einmal gründlich dein Gewissen erörtern sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130318
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130318,
					"content": "*wimmer*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130319
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730130319,
					"content": "Arapacati! Wir sind hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130320,
					"content": "Ah, da seid ihr ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130321
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130321,
					"content": "#Nara {NICKNAME} und Paimon haben sich Arapacatis Ärger angehört und mir dabei geholfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130322
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130322,
					"content": "Arapacati muss sich keine Sorgen mehr machen, dass die Brüder das Utsava-Fest verpassen oder draußen in Gefahr sind. Vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130323
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130323,
					"content": "Arapacati und die Brüder bedanken sich alle herzlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130324
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130324,
					"content": "Das ist toll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130325,
					"content": "Aber es gibt da noch eine Sache, wegen der Paimon immer neugierig ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130326,
					"content": "Wer ist „Nara Varuna“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130327
					]
				},
				{
					"id": 730130327,
					"content": "#{F#Er}{M#Sie} ist {F#unser}{M#unsere} {F#Freund}{M#Freundin} und auch {F#ein}{M#eine} {F#Freund}{M#Freundin} von Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130328
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130328,
					"content": "#Vor langer, langer Zeit hatten die Aranara {F#einen Freund}{M#eine Freundin}, {F#der}{M#die} so wie Nara {NICKNAME} golden glänzte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130329
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130329,
					"content": "So ist das also. Aber Paimon hat noch eine Frage ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130330,
					"content": "Über die „Geschwister“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130331
					]
				},
				{
					"id": 730130331,
					"content": "Ja. Wer ist der größte und wer der kleinste von Arapacatis Brüdern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130332,
					"content": "Was? Groß? Klein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130333,
						730130334
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130333,
					"content": "In Bezug auf ihr Alter ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130336
					]
				},
				{
					"id": 730130336,
					"content": "Das „Alter“ ... Hmm ... Ah, Arapacati weiß doch, dass es sich mit dem Alter wie mit den Jahresringen eines Baumes verhält. Die Kinder des Waldes scheren sich nicht um das „Alter“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130337
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130337,
					"content": "Hä? Warum heißt es dann immer „Großer Bruder“ und „Kleine Schwester“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130338,
					"content": "#Das ... Früher hatten wir {F#einen Freund}{M#eine Freundin} namens Nara Varuna. {F#Er}{M#Sie} hat uns gesagt, dass {F#er}{M#sie} {F#eine Schwester}{M#einen Bruder} hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130339
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130339,
					"content": "#Als Arapacati und die Brüder {F#ihn}{M#sie} so über {M#diesen Bruder}{F#diese Schwester} reden hörten, klang es gleichzeitig sehr glücklich und sehr traurig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130340
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130340,
					"content": "So haben wir es verstanden. Für den „großen Bruder“ ist die „kleine Schwester“ eine sehr wichtige Nara. Für die „kleine Schwester“ ist der „große Bruder“ ein sehr wichtiger Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130341
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130341,
					"content": "Das ist doch sehr gut. Deshalb haben sich Arapacati und ihre Brüder dazu entschieden, jetzt auch „große Brüder“ und „kleine Schwestern“ zu werden. Nara Varuna sagte, das sei sehr gut so. Man muss seine Familie wertschätzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130342
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130342,
					"content": "Richtig. Man muss die Familie wertschätzen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130343
					]
				},
				{
					"id": 730130343,
					"content": "Ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130344
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130344,
					"content": "Da ist noch eine Sache, die sich Paimon gefragt hat ... Muss Aranara etwas essen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130345,
					"content": "Menschen kochen Zutaten zu Essen, und die Kinder des Waldes können auch Zutaten zu Essen machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130346
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130346,
					"content": "Nara Varuna hat uns beigebracht, wie die Nara essen. Deshalb haben Arapacati und Brüder angefangen, eine „Kochausbildung“ zu machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130347
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130347,
					"content": "Oh, wirklich seltsam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130348,
						730130349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130348,
					"content": "Das ist wie ein Spiel ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130350
					]
				},
				{
					"id": 730130350,
					"content": "Arapacati und die Brüder nehmen das sehr ernst. Nara Varuna hat gesagt, dass das Teilen von Essen mit anderen wahres Glück ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130351
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130351,
					"content": "#Übrigens. Arapas sagt, dass Nara {NICKNAME} auch weiß, wie man kocht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130352
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130352,
					"content": "#Ja, {NICKNAME} ist auch sehr erfahren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130353,
					"content": "#So ist das also ... Nara {NICKNAME} sollte auf jeden Fall zum Utsava-Fest kommen und mit Arapacatis dummen Brüdern kochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130354
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130354,
					"content": "Lass sie erkennen, dass nur ein Nara versteht, was die Aranara niemals verstehen können, nämlich wie die wahre Kochkunst und Speisen funktionieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
