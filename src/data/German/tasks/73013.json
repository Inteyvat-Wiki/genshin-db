					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130356,
					"content": "Ich zeige dir, was ich kann!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130357
					]
				},
				{
					"id": 730130349,
					"content": "Das ist wie eine Familie ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130350
					]
				},
				{
					"id": 730130334,
					"content": "In Bezug auf ihre Körpergröße ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130335
					]
				},
				{
					"id": 730130335,
