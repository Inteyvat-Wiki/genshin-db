						730130356
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130355,
					"content": "Sei nicht zu überrascht, wenn du es siehst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130357
					]
				},
				{
					"id": 730130357,
					"content": "Arapacati kann es kaum erwarten. Dieses Utsava-Fest wird sicher sehr gut, sehr aufregend werden.",
