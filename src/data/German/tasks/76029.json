			"dialogs": [
				{
					"id": 760290201,
					"content": "Aino? Bist du zu Hause?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290202,
					"content": "Warte, Paimon? Bist du das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290203
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290203,
					"content": "Was bringt euch denn hierher! Bringt ihr mir etwa Snacks mit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290204
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290204,
					"content": "Paimon wusste, dass du das sagen würdest! Hier, das haben wir auf dem Weg hierher für dich besorgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290205,
					"content": "Hehe, immer her damit! Ineffa wird bald zurück sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290206
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290206,
					"content": "Und, was spielen wir heute?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290207
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290207,
					"content": "Hehe ... Eigentlich möchten wir dich um etwas bitten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290208,
					"content": "Waaah! Nimm ... Nimm dieses komische Ding schnell weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290209
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290209,
					"content": "Komisches Ding? Meinst du diese Leier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290210,
					"content": "Ich hab euch doch gesagt, ich verabscheue Dinge, die mit Wissenschaft und Mechanik nicht zu erklären sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290211
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290211,
					"content": "Wisst ihr? Diese Leier ... taucht manchmal einfach so vor meiner Haustür auf. Und jedes Mal, wenn ich sie repariert habe, ist sie plötzlich wieder verschwunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290212
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290212,
					"content": "A... Aber ich glaube trotzdem nicht an Spukgeschichten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290213
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290213,
					"content": "Ah, so ist das ... Es scheint da ein Missverständnis zu geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290214,
					"content": "Wie meinst du das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290215,
						760290216
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290215,
					"content": "Das ist die Leier einer Freundin ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290217
					]
				},
				{
					"id": 760290217,
					"content": "Ja. Sie hat keine bösen Absichten, und sie hat ihre Gründe dafür, die Leier immer heimlich mitzunehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290218,
					"content": "Wirklich? Und ihr nehmt mich nicht auf den Arm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290219
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290219,
					"content": "Gut, d... dann werde ich euch vertrauen. Ich werde sie noch einmal reparieren ... und diesmal etwas gründlicher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290220
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290220,
					"content": "Wartet bitte einen Moment hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290221
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290221,
					"content": "Aino ist wirklich zuverlässig ... Irgendwie traurig, dass sie durch die ganze Heimlichtuerei so erschreckt wurde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290222,
					"content": "Ja, wir sollten uns bei ihr revanchieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290223
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760290223,
					"content": "Gena... Aaah! Was machst du denn plötzlich hier?! Du hast uns erschreckt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290224,
					"content": "Ich wollte euch nur etwas geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290225
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760290225,
					"content": "Hmm? Was ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290226,
					"content": "Ein paar Schätze, die die Kuuhenki gesammelt hat. Sie wollte der Handwerkerin danken und dachte, dass ihr das gefallen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290227
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760290227,
					"content": "Oh ... So viele merkwürdige Bauteile. Also gut, wir nehmen sie und werden sie nachher Aino geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290228,
					"content": "Sei auf dem Rückweg vorsichtig, dass dich niemand sieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290229,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290230
					]
				},
				{
					"id": 760290230,
					"content": "Paimon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290231
					]
				},
				{
					"id": 760290231,
					"content": "Hm? Was ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290232,
					"content": "Da ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290233
					]
				},
				{
					"id": 760290233,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290234,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290235
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290235,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290236
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760290236,
					"content": "... Ähnlichkeitsabgleichung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290237
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290237,
					"content": "Wieso machst du das denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290238,
					"content": "#Ähnlichkeit mit der Statue der Mondgöttin von Nod-Krai ... 95{NON_BREAK_SPACE}% ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290239,
						760290241
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290239,
					"content": "S... Sie ist eine Schauspielerin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290240
					]
				},
				{
					"id": 760290240,
					"content": "#Erhöhte Herzfrequenz bei {NICKNAME} festgestellt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290243
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290243,
					"content": "Gut! Sie ist repariert! Jetzt sollte sie nie wieder kaputtgehen. Und eure Mitbrings... Ah! I... Ineffa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290244
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290244,
					"content": "Ihre Mitbrings..., Aino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290245
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290245,
					"content": "Äh, eure Mitbringsel haben echt gut gepasst! Tolle Bauteile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290246
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290246,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290247
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290247,
					"content": "Hmm? Und wer ist denn das da hinter euch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290248
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290248,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290249,
						760290250
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760290249,
					"content": "Die Auftraggeberin für die Reparatur!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290251
					]
				},
				{
					"id": 760290251,
					"content": "(Diese Frau kommt mir irgendwie bekannt vor ... Habe ich sie schon mal gesehen? Egal, nicht so wichtig. Hoffentlich hab ich die Snacks, die Paimon mitgebracht hat, gut versteckt ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290252
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290252,
					"content": "Ja ... genau! Sie hat auch diese Bauteile hergebracht, als Dank dafür, dass du ihre Leier repariert hast, Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290253,
					"content": "Hm? Mal sehen ... Oha! Das sind ja alles uralte und seltene Bauteile! Darf ich sie wirklich annehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290254
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290254,
					"content": "... Ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290255
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760290255,
					"content": "Vielen Dank! Wenn du irgendwann noch mal etwas zu reparieren hast, komm einfach zu mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290256
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290256,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290257
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290257,
					"content": "Also ... dann müssen wir jetzt gehen! Wir kommen ein andermal vorbei zum Spielen, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290258
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290258,
					"content": "(Wir müssen „Jungfrau“ schnell hier wegbringen, sonst erkennt Ineffa sie noch!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290259
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290259,
					"content": "A... Alles klar! Wir sehen uns dann ein andermal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290260
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290260,
					"content": "(Ich muss schnell saubermachen, sonst findet Ineffa die Snack-Reste!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290261
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290261,
					"content": "Gut. Auf Wiedersehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290262
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290262,
					"content": "... Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290263
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290263,
					"content": "Hmm... Ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290264
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290264,
					"content": "Möchtest du diese Bauteile im Schrein oder irgendwie aufbewahren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290265
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290265,
					"content": "Was? Wieso möchte ich das denn tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290266
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290266,
					"content": "Offenbar sind sie „Geschenke der Mondgöttin“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290267
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290267,
					"content": "Hmm? Wovon redest du da? Ich sollte mal deine Schaltkreise überprüfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290250,
					"content": "Unsere schüchterne Kundin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290251
					]
				},
				{
					"id": 760290241,
					"content": "E... Es gibt eine Abweichung!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290242
					]
				},
				{
					"id": 760290242,
					"content": "Abweichung minimal. Einschätzung der Schlussfolgerung: zuverlässig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290243
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290216,
					"content": "Und diese Freundin ist etwas schüchtern ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290217
					]
				}
			]
		},
