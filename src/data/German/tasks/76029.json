			},
			"dialogs": [
				{
					"id": 760290101,
					"content": "Hallo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290102
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760290102,
					"content": "Hm? Gehst du aus, Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290103,
					"content": "Ja. Ich möchte eine Leier reparieren lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290104
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760290104,
					"content": "... Wie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290105,
					"content": "Die Leier einer Kuuhenki ist kaputtgegangen. Diese Leier ist ihr sehr wichtig, also möchte ich sie reparieren lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290106
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760290106,
					"content": "Die Kuuhenki sind doch ganz schön talentiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290107,
					"content": "Ja. Sie spielt oft hier, und manchmal singe ich auch dazu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290108
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760290108,
					"content": "Paimon findet schon länger, dass du die Kuuhenki ganz schön verwöhnst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290109,
					"content": "Sie haben mich immer begleitet und mir auch oft interessante Dinge mitgebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290110
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760290110,
					"content": "(Lauma hat gesagt, dass es in der Natur der Kuuhenki liegt, die Mondgöttin glücklich machen zu wollen.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290111
					]
				},
				{
					"id": 760290111,
					"content": "Aber wenn Paimon fragen darf: Wie willst du diese Leier reparieren? Meintest du nicht, dass du nicht von anderen gesehen werden willst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290112,
					"content": "Hmm ... Früher habe ich die kleinen Tiere oder Kuuhenki gebeten, Dinge, die repariert werden müssen, vor die Tür einer Handwerkerin zu legen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290113
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760290113,
					"content": "Und ich muss nur warten, bis die Handwerkerin es findet. Aber manchmal dauert das ein paar Tage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290114
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760290114,
					"content": "Klingt irgendwie kompliziert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290115,
					"content": "Warum überlässt du es nicht uns?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290116
					]
				},
				{
					"id": 760290116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290117
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760290117,
					"content": "Ja, überlass es uns. Wer weiß, vielleicht kriegen wir noch heute das erledigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290118,
					"content": "... In Ordnung. Danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290119
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760290119,
					"content": "Gerne doch. Übrigens, bei welcher Handwerkerin hast du deine Sachen normalerweise abgegeben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290120,
					"content": "Ich kenne ihren Namen nicht. Vor ihrer Haustür befindet sich eine große mechanische Hand und sie lebt in einem runden, muschelartigen Haus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290121
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760290121,
					"content": "(Doch nicht etwa ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290122
					]
				},
				{
					"id": 760290122,
					"content": "Außerdem weht von drinnen oft der Duft von Krumkake heraus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290123
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760290123,
					"content": "Paimon weiß nun, wer das ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
