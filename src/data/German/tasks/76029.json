			},
			"dialogs": [
				{
					"id": 760290401,
					"content": "(Hm? Leiermusik? Anscheinend spielt Columbia den Kuuhenki etwas vor.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290402
					]
				},
				{
					"id": 760290402,
					"content": "(Als wir das letzte Mal hier waren, war die Leier noch nicht repariert. Das war lange bevor Columbina alle kennengelernt hat ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290403
					]
				},
				{
					"id": 760290403,
					"content": "Vor nicht allzu langer Zeit ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
