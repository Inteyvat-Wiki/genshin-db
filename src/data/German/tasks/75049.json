			},
			"dialogs": [
				{
					"id": 750490401,
					"content": "Hmm, hätte nicht gedacht, dass du den Eingang hier finden würdest. Schon lange hat sich niemand mehr hierher verirrt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490402
					],
					"speakerTitle": "Geist der Nachtseele"
				},
				{
					"id": 750490402,
					"content": "Dieser Ort, nun, hier wandern die Nachtseelen umher ... Hehe, aber dort, wo die Sonne auf die Erde scheint, kennt wohl niemand mehr ihre Namen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490403
					],
					"speakerTitle": "Geist der Nachtseele"
				},
				{
					"id": 750490403,
					"content": "Die Nachtseelen ... Wenn unsere Herrin schläft, sind wir ihre Träume. Wenn unsere Göttin gelegentlich erwacht, sind wir ihre flüchtigen Gedanken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490404
					],
					"speakerTitle": "Geist der Nachtseele"
				},
				{
					"id": 750490404,
					"content": "#Dass tatsächlich jemand Lebendiges hier auftaucht ... Hehe, die kampfeslustigen Gefährten sind schon ungeduldig ... {F#Mutige Fremde, die}{M#Mutiger Fremder, der} du von allen geliebt wirst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490405
					],
					"speakerTitle": "Geist der Nachtseele"
				},
				{
					"id": 750490405,
					"content": "Besänftige diese ruhelosen Geister mit einem hitzigen Kampf. Erringe den Sieg und die tief schlummernden Seelen werden dich belohnen ... Was sagst du dazu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Geist der Nachtseele"
				}
			]
		},
