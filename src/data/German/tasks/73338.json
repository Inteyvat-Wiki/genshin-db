			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tanjiyy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733380101,
					"content": "#Grüß dich, {M#Fremder}{F#Fremde}! Bist du {M#ein Reisender}{F#eine Reisende} auf der Durchreise?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380102
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380102,
					"content": "Entschuldige, dass ich dich auf halbem Weg aufhalte, aber ... Könntest du es mir sagen, was hier passiert ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380103
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380103,
					"content": "#Ich bin {NICKNAME}. Sehr erfreut, dich kennenzulernen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380104
					]
				},
				{
					"id": 733380104,
					"content": "Tanjiyy, Dastur der Ursachenlehre. Ich bin hier gekommen, um das Ausbildungsprojekt von ... ähm, ach ja, von Tanit zu unterstützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380105
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380105,
					"content": "Das ist alles sehr seltsam. Es muss hier sein, aber ... was ist hier passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380106,
						733380108
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380106,
					"content": "Das ist ... eine lange Geschichte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380107
					]
				},
				{
					"id": 733380107,
					"content": "Stammeskrieg? Oder interner Konflikt? Sehr interessant. Es ist Jahrhunderte her, dass ein ganzer Stamm in dieser Wüste ausgelöscht wurde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380110
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380110,
					"content": "Außerdem habe ich ein paar ziemlich unheilvolle Zeichen entdeckt. Ich rate dir nicht selbst zu schauen. Es könnte ... zum Erbrechen bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380111
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380111,
					"content": "Vielleicht gab es Überlebende. Sie kamen zurück und stellten die ... restlichen Dinge zusammen. Aber ... es sieht ziemlich furchtbar aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380112
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380112,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380113
					]
				},
				{
					"id": 733380113,
					"content": "*seufz* Wie konnte ich nur auf so etwas stoßen? Ich habe das Gefühl, dass ich Zeuge eines historischen Ereignisses bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380114
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380114,
					"content": "Ah, übrigens, willst du Karten spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380115
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380115,
					"content": "Ich habe ein paar Decks in den Zelten gefunden, sie ein wenig gewischt und sind jetzt schon sauber. Wenn du willst, können wir vielleicht ein paar Runden spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380108,
					"content": "Vielleicht sind sie ... abgewandert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380109
					]
				},
				{
					"id": 733380109,
					"content": "Abgewandert? Nein, schau mal, die Vorräte und Zelte sind noch da. Überall sind Asche und Anzeichen dafür, dass sie hier gelebt haben ... Es ist eher so, als ob ihr Leben wohl durch eine plötzliche Katastrophe unterbrochen wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380110
					],
					"speakerTitle": "Tanjiyy"
				}
			]
		},
