			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400320101,
					"content": "Oh, ihr seid hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320102,
					"content": "Irgendwelche Spuren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320103
					]
				},
				{
					"id": 400320103,
					"content": "Ja, dank Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320104,
					"content": "Mithilfe ihrer Analyse haben wir einige Orte bestätigen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320105
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320105,
					"content": "So wie es aussieht, gibt es ein Lager, das von dem „Huthund“ von gestern bewacht wird und das mit besonderer Sorgfalt behandelt werden muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320106
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320106,
					"content": "Diesen Spitznamen hätte sich auch Paimon ausdenken können.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320107
					]
				},
				{
					"id": 400320107,
					"content": "He! Paimon hätte sich so einen Spitznamen nicht ausgedacht. Wenn Paimon das gewesen wäre, würde es heißen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320108,
					"content": "Nun, nennen wir ihn „Klingenwelpe“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320109,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320110,
					"content": "Wie auch immer, ich habe dort einige der gleichen Vorrichtungen eingerichtet. Hoffen wir, dass es auch dieses Mal klappt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320111,
					"content": "Wah, Paimon wurde ignoriert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320112,
					"content": "Ich zähle auf euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320113,
					"content": "Gibt es noch weitere Fragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320114,
					"content": "Ist diese Auskunft zuverlässig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320115
					]
				},
				{
					"id": 400320115,
					"content": "Absolut zuverlässig. Schließlich habe ich selbst die Orte ausgekundschaftet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320116
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320116,
					"content": "Hm? Ryuuji kommt nicht mit uns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320117,
					"content": "So gerne ich mich euch angeschlossen hätte, habe ich heute leider noch andere Aufgaben für Sango zu erledigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320118,
					"content": "Im Großen und Ganzen hatte sie einige Vorstellungen davon, woher der „Huthund“ kam. Deshalb wurde ich beauftragt, mir das Ganze einmal anzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320119
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320119,
					"content": "„Klingenwelpe“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320120,
					"content": "„Huthund“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320121,
						400320124
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320121,
					"content": "„Hutklingenwelpe“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320122
					]
				},
				{
					"id": 400320122,
					"content": "Wie merkwürdig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320123
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320123,
					"content": "Was ist das für ein Spitzname? So merkwürdig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320125,
					"content": "Nennen wir ihn weiterhin „schwarzer Schatten“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320126
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320126,
					"content": "Wie auch immer, ich zähl auf dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320124,
					"content": "Hört auf ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320125
					]
				}
			]
		},
		{
			"id": 4003203,
			"completionStepIds": [
				4003203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003203",
							"2"
						],
						"stepId": 4003203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400320301,
					"content": "Vielen Dank für deine harte Arbeit. Mal sehen ... die Zahlen stimmen immer noch nicht überein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320302
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320302,
					"content": "Sind also so viele Tiere verschwunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320303,
					"content": "Ja. Anhand der eingegangenen Aufträge haben wir etwa die Hälfte der vermissten Tiere gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320304
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320304,
					"content": "Leider haben wir keine Hinweise mehr. Aber zum Glück sind lebende Tiere viel einfacher zu untersuchen als leblose Gegenstände.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320305
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320305,
					"content": "In der Vergangenheit haben wir Großfamilien geholfen, gestohlene Gegenstände zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320306
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320306,
					"content": "Die Spur ist mehrmals erloschen, aber dank der Bemühungen von Sango wurde sie schließlich gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320307,
						400320325
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320307,
					"content": "Kannst du das genauer erläutern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320308
					]
				},
				{
					"id": 400320308,
					"content": "Das hört sich interessant an, erzähle uns mehr darüber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320309,
					"content": "Ich kann nicht glauben, dass ihr euch für Detektivarbeit interessiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320310
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320310,
					"content": "Zu diesem Zeitpunkt hatten wir den Verdächtigen tatsächlich im Visier. Es wurde nur weder Diebesgut noch andere Anhaltspunkte in seinem Haus gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320311
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320311,
					"content": "Später, als ich mich umhörte, erfuhr ich, dass der Verdächtige einen Tag zuvor Naku-Kraut verkauft hat. Ich ging zum Käufer, um die Kräuter zu prüfen, und stellte fest, dass sie tatsächlich noch frisch waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320312
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320312,
					"content": "Als Sango davon erfuhr, schickte sie mich sofort los, um die Gegend am Fuße des Yougou-Berges zu untersuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320313
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320313,
					"content": "Huh? Warum des Yougou-Berges?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320314,
					"content": "„Zunächst einmal lebt der Verdächtige auf Narukami. Es gibt zwar viele Orte in Inazuma, an denen Naku-Kraut zu finden ist, aber um zu einer anderen Insel zu gelangen, bräuchten normale Menschen unbedingt ein Boot, aber wir haben keins gefunden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320315
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320315,
					"content": "„In Verbindung mit der Tatsache, dass die Tenryou-Verwaltung aufgrund des Sakoku-Dekrets sehr empfindlich gegenüber Schiffen ist, würde der Täter das Verbrechen begehen, müsste er sicherstellen, dass er die Aufmerksamkeit der Tenryou-Verwaltung nicht auf sich zieht.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320316
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320316,
					"content": "„Man kann also die anderen Inseln im Grunde ausschließen.“ Das hat Sango gesagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320317
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320317,
					"content": "Aber es gibt doch auch in der Nähe des großen Narukami-Schreins Naku-Kraut, oder? Warum hast du dann nur am Fuße des Yougou-Berges gesucht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320318,
					"content": "Daran hat auch Sango gedacht. „Obwohl in der Nähe des Großen Narkuami-Schreins auch Naku-Kraut wächst, gibt es beim Großen Narukami-Schrein Schreinjungfern und auch Gläubige, die ihren religiösen Ritualien nachgehen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320319
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320319,
					"content": "„Sollte dort irgendetwas Ungewöhnliches passieren, ist es leicht zu erkennen, weil es dort viele Leute gibt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320320
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320320,
					"content": "So ist das also! Jetzt bin ich überzeugt, dass sie eine Intelligenzbestie ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320321,
					"content": "Dann wurde am Fuße des Yougou-Berges tatsächlich ein Erdhügel gefunden, der Anzeichen dafür aufwies, dass er vor Kurzem gelockert worden war. Die Verdächtigen vergruben das Diebesgut zunächst, um zu warten, bis der Wind sich gelegt hatte, und dann zurückzukommen, um das Diebesgut zum Verkauf zu holen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320322
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320322,
					"content": "Aber er dachte, er würde sich verdächtig machen, wenn er mit einem Rucksack losziehen und mit leeren Händen zurückkommen würde, also pflückte er Naku-Kraut am Straßenrand und ging zurück, um sie zu verkaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320323
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320323,
					"content": "Aber andererseits war es gerade Naku-Kraut, das ihn entlarvte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320324,
					"content": "Ganz genau. Es muss also noch andere Hinweise geben, die wir noch nicht gefunden haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320327
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320327,
					"content": "Ich dachte, es wäre gut für uns, auf diese Weise zusammenzuarbeiten. Schließlich bin ich auf Botengänge spezialisiert und nicht auf Infiltration und Kämpfe. Diesen Teil dir zu überlassen, ist mir mehr als recht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320328
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320328,
					"content": "Wie sieht es aus? Bist du an einer Stelle bei Sango interessiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320329
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320329,
					"content": "Sango ... Mag zwar etwas schwer zu verstehen sein, wenn sie Dinge sagt wie „Gewissen ist eine Last für die Weisheit“, aber im Grunde ist sie ein sehr sanfter Mensch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320330,
						400320331
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320330,
					"content": "Nein, danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320332
					]
				},
				{
					"id": 400320332,
					"content": "Wirklich schade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320333
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320333,
					"content": "Aber es stimmt schon, wenn Sango jemanden hätte, der so fähig ist wie du, wäre ich meine Arbeit los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320334
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320334,
					"content": "Ich werde meine Untersuchung als Nächstes fortsetzen. Wenn du noch andere Dinge zu erledigen hast, lass dich dann bitte nicht aufhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320335
					],
