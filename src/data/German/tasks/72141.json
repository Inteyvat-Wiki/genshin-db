			"dialogs": [
				{
					"id": 721410301,
					"content": "(Gewöhnlich aussehender Schrein, ohne besondere elementare Spuren.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410302
					],
					"speakerTitle": "Außenseiter-Schrein"
				},
				{
					"id": 721410302,
					"content": "Vor dem Schrein beten",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410304
					]
				},
				{
					"id": 721410304,
					"content": "(Die feuchte Meeresbrise streift deine Wange. In der Ferne zwitschert ein Seevogel. Inzwischen fliegt er in den einsamen Wolken. Du versuchst zuzuhören, aber nichts passiert.)",
					"roleType": "TALK_ROLE_NPC",
