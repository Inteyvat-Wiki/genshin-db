			"dialogs": [
				{
					"id": 721410701,
					"content": "In Vergleich zu „seinen“ großen Segnungen ist das nur eine kleine Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410702
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410702,
					"content": "Bete. Hör auf „ihn“ und lass „ihn“ dich hören!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410703
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410703,
					"content": "Dann wirst du, wie ich, „seine“ Worte hören, die aus deinem Herzen kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410704
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410704,
					"content": "Dann wird „er“ dich aus dem Leid herausführen und dir einen großen Segen gewähren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410705,
						721410706
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410705,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410707
					]
				},
				{
					"id": 721410707,
					"content": "Behalte es im Sinn. Bete jeden Tag dreimal an. Du wirst belohnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410708
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410708,
					"content": "Behalte es im Sinn, vergiss es nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410706,
					"content": "Von mir aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410707
					]
				}
			]
