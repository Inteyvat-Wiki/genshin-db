			"dialogs": [
				{
					"id": 721410101,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410102,
						721410103
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410102,
					"content": "Hallo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410105
					]
				},
				{
					"id": 721410105,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410106
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410106,
					"content": "Hörst du mir zu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410107
					]
				},
				{
					"id": 721410107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410108,
						721410109
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410108,
					"content": "Hallo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410110
					]
				},
				{
					"id": 721410110,
					"content": "... Bitte störe mich nicht mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410111
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410111,
					"content": "„Er“ ist unzufrieden. „Er“ ist unzufrieden mit der Störung von Worten auf der Zunge, die die Weisheit der „Worte des Herzens“ überdeckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410112
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410112,
					"content": "Worte der Zunge?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410113
					]
				},
				{
					"id": 721410113,
					"content": "Die Worte der Zunge sind wie strömender Regen. Sie einem das Trommelfell platzen und stören den Geist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410114
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410114,
					"content": "Die „Worte des Herzens“ sind wie Nebel. Sie sickern ganz natürlich und allmählich ein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410116
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410116,
					"content": "Pst! „Er“ hört zu. „Er“ spricht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410117
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410117,
					"content": "Benutze weder deine Zunge noch deine Ohren. Hör mit deinem Herzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410118
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410118,
					"content": "Komm her. Bete. Und dann hör zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410119
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410119,
					"content": "Bete dreimal. Dreimal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410120,
						721410121
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410120,
					"content": "(Versuche es mal.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721410121,
					"content": "Nein, danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721410109,
					"content": "Nicke, wenn du sprechen kannst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410110
					]
				},
				{
					"id": 721410103,
					"content": "Was machst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410105
					]
				}
			]
		},
