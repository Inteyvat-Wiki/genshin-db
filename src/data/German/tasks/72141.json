			"dialogs": [
				{
					"id": 721411901,
					"content": "(Gewöhnlich aussehender Schrein, ohne besondere elementare Spur. Du hast Washizus Wahnsinn gesehen, willst du anbeten?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411902
					],
					"speakerTitle": "Außenseiter-Schrein"
				},
				{
					"id": 721411902,
					"content": "Vor dem Schrein beten",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411904
					]
				},
				{
					"id": 721411904,
					"content": "(Washizu murmelt immer noch neben dir und er sieht gar nicht gut aus. Der Schrein ist still. Vielleicht ist das alles ein Schwindel? Du versuchst zuzuhören, aber nichts passiert.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Außenseiter-Schrein"
				}
