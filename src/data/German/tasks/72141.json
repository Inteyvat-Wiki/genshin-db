			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Washizu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721410601,
					"content": "Wie ist es? Hast du das Glück, „seine“ Lehren zu hören?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410602,
						721410603
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410602,
					"content": "Ich habe nichts gehört.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410604
					]
				},
				{
					"id": 721410604,
					"content": "Es ist in Ordnung. Es ist in Ordnung. „Er“ sieht. „Er“ hört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410605
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410605,
					"content": "„Er“ freut sich. Und diejenigen, die sich an ihm erfreuen, werden belohnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410606
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410606,
					"content": "„Seine“ Belohnung ist nicht an jenem Ufer. Sie kommt morgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410607,
						721410608
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410607,
					"content": "Weißt du, wovon du redest?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410609
					]
				},
				{
					"id": 721410609,
					"content": "Komme morgen wieder her. Du wirst verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410608,
					"content": "Entschuldigung, aber ich verstehe dich nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410609
					]
				},
				{
					"id": 721410603,
					"content": "Ich habe kein Glück, etwas zu hören.",
					"roleType": "TALK_ROLE_PLAYER",
