					"content": "Weiterbeten",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411603
					]
				},
				{
					"id": 721411603,
					"content": "(Du hörst das Geräusch der Wellen, die gegen die Felsen schlagen. Und dieses andauernde Geräusch verleitet einen dazu, auf den Ort hinauszublicken, wo sich Meer und Himmel treffen. Du versuchst zuzuhören, aber nichts passiert.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Außenseiter-Schrein"
				}
			]
		},
		{
			"id": 7214117,
			"completionStepIds": [
				7214108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
