			},
			"dialogs": [
				{
					"id": 721411101,
					"content": "Bete, hör zu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411102
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411102,
					"content": "„Er“ ist stark, weil „er“ zuhört. „Er“ ist so stark, dass er alles sieht und hört. So sieht und hört „er“ alles, was es gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411103
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411103,
					"content": "Weder die Narren in Sangonomiya noch die Verrückten in Narukami verstehen es, fühlen es. Also wissen sie nur, sich gegenseitig zu bekämpfen und das Blut ihre Augen blenden zu lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411104
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411104,
					"content": "Aber du musst das verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411105,
						721411106
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411105,
					"content": "Klingt nach ungeheuer viel Geschwafel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411107
					]
				},
				{
					"id": 721411107,
					"content": "Die Antwort liegt in der Anbetung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411108
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411108,
					"content": "Behalte es im Sinn. Bete jeden Tag dreimal. Du wirst belohnt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411106,
					"content": "Ich verstehe es, mehr oder weniger.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411107
					]
				}
			]
		},
