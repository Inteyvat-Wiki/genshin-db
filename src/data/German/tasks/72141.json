			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Washizu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721411701,
					"content": "„Er“ muss beruhigt werden. „Sein“ Zorn muss besänftigt werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411702
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411702,
					"content": "Du hast es gut gemacht! Du hast es gut gemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411703
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411703,
					"content": "Vergiss nicht, dass manche Leute dich betrügen werden. Aber „er“ wird dir helfen. „Er“ wird dir immer helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411704,
						721411705
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411704,
					"content": "Hmm ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411706
					]
				},
				{
					"id": 721411706,
					"content": "Diese Frau ist wie die Bakedanuki der Legende. Ich lasse sie gehen. „Er“ ist sehr wütend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411707
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411707,
					"content": "„Er“ ist wieder wütend ... Das ist meine Schuld.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411708
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411708,
					"content": "Verzeihung ... Ich werde wieder ein Opfer darbringen. Ich werde ein Opfer der „Rückkehr“ für dich finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411709
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411709,
					"content": "Verzeih mir! Verzeih mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411710
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411710,
					"content": "Verzeih mir! Verzeih mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411705,
					"content": "Ja, klar ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411706
					]
				}
			]
		},
