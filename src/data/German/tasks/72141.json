			"dialogs": [
				{
					"id": 721411801,
					"content": "Du bist hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411802
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411802,
					"content": "Wie geht es dir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411803
					]
				},
				{
					"id": 721411803,
					"content": "Danke, dass du mir meine Sünden vergibst. Bitte lass mich zu dir zurückkehren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411804
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411804,
					"content": "Sprichst du mit mir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411805
					]
				},
				{
					"id": 721411805,
					"content": "Was ... Aber warum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411806
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411806,
					"content": "Ich war bei jeder Opfergabe. Und ich habe jede deiner Segnungen angenommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411807
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411807,
					"content": "Aber sie wurde von dir gebrandmarkt und hat dir gedient. Nun ist sie vor deinen Segnungen geflohen. Sie hat uns verraten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411808
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411808,
					"content": "Wovon redest du ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411809
					]
				},
				{
					"id": 721411809,
					"content": "Ah! Ah ... Tut mir leid ... Tut mir leid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411810
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411810,
					"content": "Ich sollte nicht an „seiner“ Entscheidung zweifeln. Weiter aushalten, weiter anbeten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411811
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411811,
					"content": "Kannst du mich hören?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411812
					]
				},
				{
					"id": 721411812,
					"content": "Weiter aushalten ... Weiter anbeten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411813
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411813,
					"content": "Weiter aushalten ... Weiter anbeten ...",
					"roleType": "TALK_ROLE_NPC",
