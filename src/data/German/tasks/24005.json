			},
			"dialogs": [
				{
					"id": 240051101,
					"content": "Ist dein Bruder immer so ernst? Ich habe ihn noch nicht ein einziges Mal lächeln sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051102
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240051102,
					"content": "Vorher nicht, aber seit er mit deinem Vater in den Büchern liest, ist er so, ständig am Grübeln. Keine Ahnung, was in ihm vorgeht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051103
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240051103,
					"content": "Boah ... Genau wie Papa. Mama sagt, er würde sich mit etwas herumschlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051104
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240051104,
					"content": "Mit was schlägt er sich denn herum? Hatte er etwa ... einen Streit mit deiner Mama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240051105,
					"content": "Auf keinen Fall! Papa und Mama haben sich noch nie gestritten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051106
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240051106,
					"content": "Erwachsene sind echt komisch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
		{
			"id": 2400512,
