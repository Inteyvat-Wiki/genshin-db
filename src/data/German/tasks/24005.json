			"dialogs": [
				{
					"id": 240050601,
					"content": "Die sollten reichen, nur einen Moment ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050602
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050602,
					"content": "Louis fängt an, die Blasenmandarinensoße zuzubereiten ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240050603
					]
				},
				{
					"id": 240050603,
					"content": "Das wär’s! Pommes mit Blasenmandarinensoße, frisch aus dem Ofen. Gleich rein damit, aber passt auf, sie sind heiß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050604
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050604,
					"content": "Super! Haut rein, ihr alle! Die müsst ihr probieren, wirklich lecker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050605
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050605,
					"content": "Ach ja, Aurèle, das darfst du aber nicht meinem Papa erzählen, sonst schimpft er wieder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050606
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050606,
					"content": "Pff ... Keine Sorge, ich glaube nicht, dass sich Herr Delerue für Pommes interessiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050607
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050607,
					"content": "Ähm, und ... was ist mit mir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050608
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050608,
					"content": "Hau rein. Ihr könnt euch meine Portion teilen, ich mag sowieso keine Pommes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050609
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050609,
					"content": "#Hehe, wenn das so ist, bediene ich mich! Greif zu, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050610
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050610,
					"content": "Ach ja, ich werde noch Kaffee für Herrn Delerue kaufen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050611
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050611,
					"content": "Warte, das geht nicht! Mama hat Papa schon vor einer ganzen Weile verboten, Kaffee zu trinken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050612
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050612,
					"content": "Immer wenn er Kaffee getrunken hat, muss er danach die ganze Nacht husten und seine Stimme wird ganz heiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050613
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050613,
					"content": "Papa sagt, dass das alles wegen der Arbeit ist, aber was für eine Arbeit bereitet denn solchen Kummer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050614
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050614,
					"content": "... Hat das Herr Delerue damit gemeint, der Preis dafür, herausragende „Kommentare“ zu schreiben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050615
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050615,
					"content": "Der Beruf des Kritikers ist wirklich nicht einfach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				}
			]
		},
