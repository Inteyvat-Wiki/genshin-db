				]
			},
			"dialogs": [
				{
					"id": 240050301,
					"content": "Das ist also der Hauptsitz des Dampfvogels? Sieht aber nicht gerade ... besonders aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050302,
						240050303
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050302,
					"content": "Ein ganz normales Gebäude.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				},
				{
					"id": 240050304,
					"content": "He! Es gibt hier wirklich mechanische Vögel! Absolut abgefahren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050305
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050305,
					"content": "Abgefahren, oder? Ich komme mit meinem Papa oft her, um eine Zeitung zu kaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050306
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050306,
					"content": "Er liebt den Dampfvogel, jeden Morgen ist er in die Zeitung vertieft. Manchmal schneidet er sogar etwas aus der Zeitung aus und klebt es zum Archivieren in ein Buch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050307
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050307,
					"content": "Papa sagt, das sind die „Kommentare“, die er eingesandt hat. Und manchmal liest er sie Mama und mir vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050308
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050308,
					"content": "Wir hören dabei nicht gern zu und antworten immer nur mit „Ja.“, „Wirklich?“ oder „Ach so ist das.“ Aber Papa merkt das überhaupt nicht und liest einfach fröhlich weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050309
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050309,
					"content": "Was sind denn „Kommentare“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050310
					]
				},
				{
					"id": 240050310,
					"content": "Kurz gesagt, ein „Kommentar“ ist die persönliche Meinung eines Kritikers zu einem bestimmten Thema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050311
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050311,
					"content": "Lovis Vater, Herr Delerue, ist ein Wissenschaftler am Forschungsinstitut Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050320
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050320,
					"content": "Es ist ein „Kritiker“, der im Dampfvogel häufig „Kommentare“ veröffentlicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050312
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050312,
					"content": "Genau, Papa „kommentiert“ wirklich jede Sache groß und breit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050313
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050313,
					"content": "Manchmal hastet er, als wäre ihm gerade etwas Wichtiges eingefallen, während er noch spricht in sein Zimmer, um sich Notizen zu machen. Dann isst er nicht einmal etwas, sondern trinkt nur pausenlos Tee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050314
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050314,
					"content": "Oha ... Gibt es denn solche Berufe, in denen man Geld verdienen kann, wenn man einfach nur seine Meinung sagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050315
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050315,
					"content": "Wenn man einfach nur seine Meinung sagt, ist man noch kein „Kritiker“. Wenn ein Kommentar öffentlich wahrgenommen werden soll, muss man einige Punkte beachten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050316
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050316,
					"content": "Ach ... He, Verut! Und du auch, habt ihr Hunger?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050317
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050317,
					"content": "Herr Louis hat mir kürzlich erzählt, das er jetzt Pommes mit Blasenmandarinen-Geschmack verkauft. Lasst uns das gleich mal ausprobieren, wir laden euch ein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050318
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050318,
					"content": "Ooh ... Ja! Super! Bruder, hör auf zu nörgeln, auf geht’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050319
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050319,
					"content": "*seufz* Ihr beide ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050303,
					"content": "Es gibt wirklich nichts Besonderes ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				}
			]
		},
