				]
			},
			"dialogs": [
				{
					"id": 240050201,
					"content": "Ooh ... Ich möchte wirklich gern in dem Becken planschen ... oder ein Bad nehmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050202
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050202,
					"content": "Dann bekommst du garantiert Ärger, schau ihn dir lieber einfach nur von außen an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050203
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050203,
					"content": "Aber wenn niemand in den Springbrunnen darf, wieso hat man ihn dann so groß gebaut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050204
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050204,
					"content": "Der sieht zwar schön aus, aber wenn man ihn sich nur anschauen darf, ist es ja doch bloß ein langweiliges Wasserbecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050205
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050205,
					"content": "Das hier ist ganz gewiss kein gewöhnlicher Brunnen. Aber ... mein Papa hat doch über andere gewöhnliche Brunnen gesprochen. Was hat er noch gleich gesagt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050206
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050206,
					"content": "„Der Hauptzweck von kommunalen Verschönerungsprojekten am Hof von Fontaine besteht darin, Probleme bei der Steuererklärung auf flexible Weise zu lösen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050207
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050207,
					"content": "Herr Delerue hat mir das heute zufällig erklärt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050208
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050208,
					"content": "Selbst deine Stimme klingt wie die von meinem Papa ... Kein Wunder, dass mein Papa dich so gern hat, Aurèle. Er bringt jedes Mal einen Stapel Bücher mit, um mit dir darüber zu reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050209
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050209,
					"content": "Ich habe zwar nichts verstanden, aber mein Bruder hat sicher wieder etwas Einschläferndes gesagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050210
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050210,
					"content": "Lovi, lass uns gleich zum nächsten Punkt gehen, wo du doch heute nicht lernen musst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050211
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050211,
					"content": "Hm, wo gehen wir als Nächstes hin, lass mich überlegen ... Der Dampfvogel müsste noch auf sein, gehen wir dort hin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
