			"dialogs": [
				{
					"id": 240050401,
					"content": "Herr Louis! Ich möchte Pommes mit Blasenmandarinen-Geschmack kaufen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050402,
					"content": "Lovi, du bist’s. Tut mir leid, heute war am Hafen besonders viel los, da habe ich all meine Blasenmandarinen aufgebraucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050403
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050403,
					"content": "Ich ... Ich habe es dir doch schon so lange angekündigt! Und meine Freunde habe ich auch extra mitgebracht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050404
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050404,
					"content": "*seufz* Ach, da waren so viele Gäste, dass ich das ganz vergessen hatte ... Ich habe noch ein paar einfache Pommes übrig, die schenke ich euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050405
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050405,
					"content": "Na gut, danke, Herr Louis ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050406,
						240050407
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050406,
					"content": "Fehlen dir nur die Blasenmandarinen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050408
					]
				},
				{
					"id": 240050408,
					"content": "Also, wenn ich Blasenmandarinen hätte, könnte ich sofort eine Soße machen, von den anderen Gewürzen habe ich noch etwas übrig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050409
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050409,
					"content": "Super! Du bist klasse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050410
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050410,
					"content": "Danke sehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050411
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050411,
					"content": "Es tut mir so leid. Wann immer wir uns treffen, müssen wir dich um einen Gefallen bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050412,
						240050413
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050412,
					"content": "Ach, das ist doch kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050414,
					"content": "Stimmt ... Das muss ich noch von dir lernen. Herr Delerue sagt auch immer, dass ich zu pedantisch wäre, das würde meiner Karriere nicht förderlich sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050415
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050415,
					"content": "*räusper*! Reden wir nicht weiter davon. Ich werde auf sie aufpassen, und was die Blasenmandarinen angeht, zählen wir auf dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050413,
					"content": "Ich will doch die gute Laune nicht verderben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050407,
					"content": "Ich könnte dir ein paar Blasenmandarinen besorgen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050408
					]
				}
			]
		},
