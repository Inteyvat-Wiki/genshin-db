			},
			"dialogs": [
				{
					"id": 240051201,
					"content": "Vielen Dank. Ich werde hier sein und dafür sorgen, dass die beiden nicht weglaufen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051202
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240051202,
					"content": "Wenn ich als Kritiker für den Dampfvogel arbeiten könnte, würde ich etwas Geld verdienen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051203
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240051203,
					"content": "Aber Herr Delerue sagt auch, dass man sich als Kritiker nicht nur auf das Geld fokussieren darf. Sonst kommt man vom Weg ab, so wie es anderen passiert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051204
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240051204,
					"content": "Aber ich brauche Geld wirklich. *seufz* Was soll ich nur tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				}
			]
		}
	]
