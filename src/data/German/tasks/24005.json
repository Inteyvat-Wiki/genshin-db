			"trigger": {
				"objectNames": [
					"Verut",
					"Aurèle",
					"Lovi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240050101,
					"content": "Bruder, schnell, komm hierher. Dieses große Haus haben wir uns noch nicht angeschaut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050102,
					"content": "Mach langsam, fall nicht wieder hin. Und du auch, Lovi. Dein Papa hat gesagt, dass du etwas schwach bist, du sollst dich nicht erkälten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050103
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050103,
					"content": "Herrje, dein Bruder ist wirklich ein Nörgler, genau wie meine Mama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050104
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050104,
					"content": "Das finde ich auch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050105,
					"content": "Ihr zwei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050106,
						240050107
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050106,
					"content": "So sieht man sich wieder.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				},
				{
					"id": 240050108,
					"content": "Hallo! Wir treffen uns wieder! Heute spielen wir nicht Verstecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050109
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050109,
					"content": "Um genau zu sein, haben wir gerade gespielt ... Aber Fräulein Nour hat mit uns geschimpft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050110
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050110,
					"content": "Wenn Fräulein Nour arbeitet, ist sie immer so streng und schimpft mit den Leuten. Hmpf, ich habe ihr früher sogar Kekse gegeben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050111
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050111,
					"content": "Aber wir haben sowieso genug gespielt. Ich wollte Aurèle und Verut gerade herumführen und was Leckeres zu essen suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050112
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050112,
					"content": "Ähm, möchtest du mit uns zusammen ... Hmm ... wie heißt das noch gleich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050113
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050113,
					"content": "Spazieren gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050114
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050114,
					"content": "Genau, mit uns spazieren gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050115
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050115,
					"content": "Lasst uns den Platz dort anschauen. Ich möchte noch den Springbrunnen sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050116,
						240050117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050116,
					"content": "Dann zeig uns bitte den Weg, Fräulein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050118,
					"content": "Na gut. Dann gehen wir ... zuerst zum Platz, dort gibt es einen sehr schönen Springbrunnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050117,
					"content": "Dann bitte ich euch, mir den Weg zu zeigen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050107,
					"content": "Was macht ihr da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				}
			]
		},
		{
