			},
			"dialogs": [
				{
					"id": 718230701,
					"content": "Warte mal eine Sekunde ... gerade scheint nicht die richtige Zeit zu sein, Lotosfrüchte zu sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718230702,
					"content": "Mal nachdenken ... Zhi wollte, dass wir die Lotosfrüchte zwischen Mitternacht und 6 Uhr morgens pflücken, richtig? Wir müssen auf den richtigen Zeitpunkt warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7182308,
			"completionStepIds": [
				7182306,
				7182308
