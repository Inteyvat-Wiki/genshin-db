			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718230901,
					"content": "Du bist zurück! Konntest du die Kräuter finden, um die ich dich gebeten habe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230902
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230902,
					"content": "Ich habe sie gleich hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230903
					]
				},
				{
					"id": 718230903,
					"content": "Danke für deine Hilfe. Ich habe auch Fräulein Bai gebeten, mir bei der Verarbeitung der Kräuter zu helfen. Bringen wir diese Kräuter zur Mühle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhi"
				}
			]
		},
		{
			"id": 7182310,
			"completionStepIds": [
				7182310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182310",
							"2"
						],
						"stepId": 7182310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fräulein Bai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718231001,
					"content": "Oh, erlaube mir, mich um diese Kräuter zu kümmern. Sobald ich fertig bin kannst du sie mit zurücknehmen und damit beginnen, sie zu Medizin weiterzuverarbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231002
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718231002,
					"content": "Vielen Dank. Wenn ich die Medizin jetzt doch nur noch etwas süßer machen könnte ... Sonst werden die Kinder sie auf keinen Fall einnehmen wollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231003
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231003,
					"content": "Bist du zu dieser Zeit des Jahres immer so beschäftigt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231004
					]
				},
				{
					"id": 718231004,
					"content": "Ja, ziemlich. Bedenke, dass es heutzutage im Qingce-Dorf nicht viele junge Leute gibt. Deshalb helfen wir, wo wir können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231005
					],
					"speakerTitle": "Fräulein Bai"
				},
				{
					"id": 718231005,
					"content": "Für diese paar Tage im Jahr etwas im Stress zu sein ist kein Problem. Abgesehen davon war dieses Jahr dank deiner Hilfe schon alles viel einfacher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231006
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231006,
					"content": "In den vergangenen Jahren musste ich viele Tage mit Kräutersammeln verbringen, ganz zu schweigen von der Zeit, die es dauerte, sie dann zu Medizin zu verarbeiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231007
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231007,
					"content": "Also, vielen Dank für deine Hilfe. Ich werde diese Kräuter jetzt weiterverarbeiten und dann werde ich meine Laterne vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231008
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231008,
					"content": "Ich habe letztes Jahr fast vergessen eine loszuschicken. Das darf mir dieses Mal nicht passieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231009
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231009,
					"content": "Was würdest du dir gerne wünschen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231010
					]
				},
				{
					"id": 718231010,
					"content": "Hmm ... Dass alle im Qingce-Dorf gesund bleiben? Ja, sowas würde ich mir wohl wünschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231011
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231011,
					"content": "Aber Wünsche gehen nicht in Erfüllung, wenn man sie laut aussprichst, deshalb bekommst du nicht mehr aus mir heraus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231012
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231012,
					"content": "Die sind für dich. Danke für deine Hilfe heute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhi"
				}
			]
		},
