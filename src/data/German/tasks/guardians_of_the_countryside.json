			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718230201,
					"content": "Hmm, unser Kräutervorrat ist immer noch ziemlich knapp ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230202
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230202,
					"content": "Hast du vor mehr Kräuter zu sammeln?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230203
					]
				},
				{
					"id": 718230203,
					"content": "Ja, ich wollte mich gerade auf den Weg machen. Zu dieser Zeit des Jahres bereite ich immer ein bisschen mehr Medizin vor, als sonst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230204
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230204,
					"content": "Ich spreche nicht von irgendeiner besonders mächtigen Medizin, einfach das ganz normale Zeug zur Behandlung von Fieber oder Verdauungsproblemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230205
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230205,
					"content": "Warum holst du dir nicht einfach ein Rezept von der Bubu-Hütte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230206
					]
				},
				{
					"id": 718230206,
					"content": "Die Bubu-Hütte ist einfach zu weit weg. Von hier aus zum Hafen von Liyue zu gehen, dauert eine ganze Weile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230207
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230207,
					"content": "Außerdem leben im Qingce-Dorf hauptsächlich Kinder und alte Leute. Sie sind keine Abenteurer wie du und könnten eine solch lange Reise nicht schaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230208
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230208,
					"content": "Aus diesem Grund habe ich vorsichtshalber ein paar Kräuter als Mittel gegen solch kleine Wehwehchen vorbereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230209
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230209,
					"content": "Wenn jedoch jemand ernsthaft erkrankt, dann benötigen wir ordentliche Medikation, die wir nur von der Bubu-Hütte bekommen können. *seufz* Aber ich hoffe, dass das nicht nötig sein wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230210
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230210,
					"content": "Wir reden später. Ich muss noch mehr Kräuter sammeln, die ich dann zurückbringe, um sie weiterverarbeiten zu lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230211
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230211,
					"content": "Wir können helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230212
					]
				},
				{
					"id": 718230212,
					"content": "Hä? Das würdet ihr wirklich tun? Das wäre toll! Ich hatte mir schon Sorgen darüber gemacht, wie lange ich wohl unterwegs sein würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230213
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230213,
					"content": "Lass mich mal sehen ... Ich denke, ich brauche drei verschiedene Arten von Kräutern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230214
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230214,
					"content": "Eines davon ist Qingxin, welche auf Berggipfeln wächst und sowohl nahrhaft als auch gut für die Verdauung ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230215
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230215,
					"content": "Das andere sind Wasserlilien, die an Flussufern gefunden werden können. Sie können zur Regulierung des Wasserhaushalts verwendet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230216
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230216,
					"content": "Die Qualität der Wasserlilien, die an diesen Flussufern wachsen, ist am besten, und dort pflücke ich meine auch für gewöhnlich. Die medizinischen Eigenschaften von Wasserlilien, die an anderen Orten wachsen, sind verglichen mit diesen blass ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230217
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230217,
					"content": "Und schließlich brauche ich Lotosfrüchte vom nahegelegenen Tümpel. Wenn sie zu Medizin verarbeitet werden, können sie dafür verwendet werden, die Nerven zu beruhigen und das Herz zu stärken. Das Ernten jedoch erfordert ein gewisses Maß an Timing: für die größte Wirksamkeit musst du sie zwischen Mitternacht und sechs Uhr morgens sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhi"
				}
			]
		},
		{
			"id": 7182307,
