			"dialogs": [
				{
					"id": 223040301,
					"content": "Ja, bitte markiere den Standort.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040302
					]
				},
				{
					"id": 223040302,
					"content": "Gut, ich werde ihn sofort markieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040303
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040303,
					"content": "Viel Erfolg! Komm wieder, wenn du den Schatz gefunden hast, damit wir ihn teilen können!",
					"roleType": "TALK_ROLE_NPC",
