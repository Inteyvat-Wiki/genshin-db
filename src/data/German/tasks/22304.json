			"dialogs": [
				{
					"id": 223040801,
					"content": "Aber kannst du die Schatzkarten überhaupt lesen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040802
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040802,
					"content": "Ich werde dir nicht verschweigen, dass ich ganz am Anfang einige Leute gebeten habe, mal ein Auge darauf zu werfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040803
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040803,
					"content": "Wo die Schätze liegen müssen, konnten sie dabei schon grob eingrenzen. Wenn ich eine Suchaktion gestartet hätte, hätte mich das zusätzlich gekostet. Deswegen habe ich es sein lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040804
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040804,
					"content": "Wenn du nicht selbst suchen willst, sag einfach Bescheid. Ich markiere den Standort auf deiner Karte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040805
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040805,
					"content": "Natürlich wird dich das etwas kosten. Sagen wir <color=#00E1FFFF>100 Mora</color>. Was hältst du davon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040806
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040806,
					"content": "Möchtest du, dass ich dir eine <color=#00E1FFFF>Markierung</color> auf deine Karte setze?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
