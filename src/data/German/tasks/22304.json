			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bolai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223040201,
					"content": "#Hallo, {F#meine Freundin}{M#mein Freund}, was hättest du denn gern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040202
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040202,
					"content": "Ich hätte gern die Schatzkarten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040203
					]
				},
				{
					"id": 223040203,
					"content": "Schatzkarten? Oh, du meinst die, die Zhangshun verpfändet hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040204
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040204,
					"content": "Aha, du willst also nachsehen, welche Dinge sich da verstecken? Ich sehe sie eher als Spielzeug an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040205
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040205,
					"content": "#Du siehst aber wie {F#eine echte Abenteurerin}{M#ein echter Abenteurer} aus. Sobald du das Wort Schatz hörst, leuchten deine Augen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040206
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040206,
					"content": "Mit den Schatzkarten kann ich selbst sowieso nichts weiter anfangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040207
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040207,
					"content": "Wenn du wirklich etwas finden solltest, wäre es angebracht, die Beute gerecht zu teilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040208
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040208,
					"content": "Schließlich habe ich die Schatzkarten lange verwahrt. Allein für die Lagerkosten müsste mal jemand aufkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
		{
			"id": 2230403,
