			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhangshun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223040101,
					"content": "Was jetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040102
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040103
					]
				},
				{
					"id": 223040103,
					"content": "Ich war früher ein Matrose der Crux. Dummerweise habe ich mich einmal verletzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040104
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040104,
					"content": "Um meinen Lebensunterhalt zu bestreiten, habe ich nach meinem Austritt aus der Flotte ein paar Schatzkarten an Bolai verpfändet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040105
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040105,
					"content": "Wenn es wirklich einen Schatz geben sollte, wird er mir einen Teil davon abgeben. Zumindest sollte er das. In der letzten Zeit habe ich nichts mehr von ihm gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040106
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040106,
					"content": "Das scheint einfach nicht voranzugehen. Würdest du die Schätze vielleicht für mich suchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040107,
						223040109,
						223040116
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040107,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040108
					]
				},
				{
					"id": 223040108,
					"content": "Danke sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040120
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040120,
					"content": "Geh zu <color=#00E1FFFF>Bolai</color> und nimm dir die <color=#00E1FFFF>Schatzkarten</color>. Sobald du einen <color=#00E1FFFF>Schatz</color> gefunden hast, kannst du ihn direkt zu <color=#00E1FFFF>ihm</color> bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040121
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040121,
					"content": "Ich habe schon mit ihm abgemacht, dass er mir meinen Anteil später geben wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040109,
					"content": "Warum bist du ausgetreten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040110
					]
				},
				{
					"id": 223040110,
					"content": "Ich war mir im Klaren, dass meine alte Verletzung jederzeit Probleme bereiten könnte. Am Ende bin ich ausgetreten, weil ich meine Kameraden nicht gefährden wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040111
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040111,
					"content": "Danach fing ich an, mit ein paar Dingen die ich vorher selbst gesammelt habe, zu handeln. So einfach ist das aber nicht. Bald werde ich all mein Hab und Gut verkauft haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040112
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040112,
					"content": "Ich hatte vorher mehrere Schatzkarten, die ich als Beute heimgebracht hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040113
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040113,
					"content": "Aber wie soll ich in meiner Verfassung auf Schatzsuche gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040114
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040114,
					"content": "Da habe ich sie an Bolai verpfändet, damit sie wenigstens ein bisschen von Nutzen sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040115
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040115,
					"content": "Er wird aber auch kaum die Muße haben, selbst auf die Suche zu gehen. Er ist auch nur ein einfacher Händler. Deswegen wäre es großartig, wenn du nach den Schätzen suchen könntest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040107,
						223040116
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040116,
					"content": "Sprechen wir hier von richtig großen Schätzen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040117
					]
				},
				{
					"id": 223040117,
					"content": "Hahaha! Das wäre echt ein Wunder! Diese Karten sind auch nur ein Teil der Beute für die Besatzung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040118
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040118,
					"content": "Wenn es wirklich einen Schatz geben würde, wären die anderen schon längst den Hinweisen gefolgt und hätten ihn auf die Schiffe gebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040119
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040119,
					"content": "Ich denke nicht, dass die Schätze allzu groß ausfallen werden. Sie werden aber genug wert sein, um sie durch drei zu teilen. Es sollte sich demnach trotzdem lohnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040120
					],
					"speakerTitle": "Zhangshun"
				}
			]
		},
