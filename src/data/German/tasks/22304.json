			"dialogs": [
				{
					"id": 223040601,
					"content": "Du bist zurück! Hast du den Schatz gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040602
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040602,
					"content": "Ja, habe ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040603
					]
				},
				{
					"id": 223040603,
					"content": "#{F#Eine waschechte Abenteurerin}{M#Ein waschechter Abenteurer}! Und schnell bist du auch noch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040604
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040604,
					"content": "Dann sehen wir mal, was wir hier finden. Oh, eine Schachtel ... Hmm, nichts von Wert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040605
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040605,
					"content": "Trotzdem danke. Hier hast du deinen Anteil. Zhangshuns Anteil bewahre ich auf, bis er ihn abholen kommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040606
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040606,
					"content": "Hach, immer noch nichts. Man wird mir doch keinen Bären aufgebunden haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
