				{
					"id": 223040901,
					"content": "Du bist zurück! Hast du den Schatz gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040902
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040902,
					"content": "Ja, habe ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040903
					]
				},
				{
					"id": 223040903,
					"content": "#{F#Eine waschechte Abenteurerin}{M#Ein waschechter Abenteurer}! Und schnell bist du auch noch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040904
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040904,
					"content": "Dann sehen wir mal, was wir hier finden. Oh, eine Schachtel ... Was ist das denn? Eine zerrissene Karte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040905
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040905,
					"content": "Diese Kerle hatten also recht. In diesen alten Schatzkarten liegen tatsächlich Hinweise zum Verbleib des echten Schatzes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040906
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040906,
					"content": "Ach so, du bist ja immer noch hier. Das ist dein Anteil. Du hast sicher noch zu tun ... Zhangshuns Anteil behalte ich, solange er nicht hier ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
