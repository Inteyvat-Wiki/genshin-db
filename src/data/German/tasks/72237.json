			"trigger": {
				"objectNames": [
					"Antei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370301,
					"content": "Wer seid ihr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370302
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370302,
					"content": "Antei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370303,
					"content": "Ja, ich bin es. Ich fühle mich ... ein bisschen seltsam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370304
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370304,
					"content": "Ich erinnere mich, dass ich den Haufen weiter verfolgte und dann einen Kern herunterzog und ihn in das Lager warf. Danach war ich ein bisschen müde, weil ich selbst ziemlich schwer verletzt war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370305
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370305,
					"content": "Jetzt, da ich aufgewacht bin und euch gesehen habe, fühle ich mich ziemlich erfrischt. Ist das die letzte Kraft vor dem Tod?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370306
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370306,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370307
					]
				},
				{
					"id": 722370307,
					"content": "Lasst uns einen Moment lang nicht darüber reden. Bist du gekommen, um mich zu verhaften und zurückzubringen? Ich habe meine Unschuld bewiesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370308
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370308,
					"content": "Es waren die Jungs aus Khaenri’ah, die die Bücher aus der Bibliothek gestohlen haben. Obwohl ich der Wachmann war, der sie empfing, steckte ich in keiner Weise mit ihnen unter einer Decke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370309
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370309,
					"content": "Ich habe sie aufgespürt und sie alle besiegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370310
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370310,
					"content": "Aber ich habe schließlich den Kern der Art von Maschinen herausgeholt, die sie mitgebracht hatten, aber ich wurde dabei schwer verletzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370311
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370311,
					"content": "Die Maschine, die ihre Kraft verloren hatte, fiel auf die Bücher. Es gab nichts mehr, was ich tun konnte, um sie herauszuholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370312
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370312,
					"content": "Die Jibashiri von Byakuyakoku sind echt krass ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370313,
					"content": "Seid ihr keine Jibashiri? Nun, das ist nicht wichtig. In der Anfangszeit waren sie alle Krieger gegen die Drachenechsen der Tiefe und erst später wurden sie zu Strafverfolgungsbehörden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370314
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370314,
					"content": "Die Kerne befinden sich im Lager. Wenn ihr mir nicht glaubt, könnt ihr den Kern nehmen und euch selbst davon überzeugen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				}
			]
		},
		{
			"id": 7223704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
