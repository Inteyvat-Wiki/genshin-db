			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Antei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370401,
					"content": "Ich habe gehört, wie die Botschafter von Narukami vom Vogel sprachen. Er hat Flügel und kann in den Himmel fliegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370402
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370402,
					"content": "Es ist fantastisch. Könnt ihr euch das vorstellen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370403
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370403,
					"content": "Andere glauben, dass sie Boten der Götter sind, die extra kommen, um das Schicksal der Menschen zu überbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370404
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370404,
					"content": "Wenn ein Mensch als Folge der Strafe des Exils in der Wüste landet, wird derselbe Vogel kommen und an seinem sterblichen Körper picken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370405
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370405,
					"content": "Ich bin von dieser Kreatur fasziniert. Wenn ich nach dem heutigen Tag noch lange Zeit an Land leben könnte, würde ich auf jeden Fall einen Vogel haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				}
			]
		},
		{
			"id": 7223705,
			"completionStepIds": [
				7223708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223708",
							"2"
						],
						"stepId": 7223708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Antei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370501,
					"content": "Habt ihr die Bücher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370502
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370502,
					"content": "Ja, Antei, du bist unschuldig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370503,
					"content": "Hm, ich habe es dir gesagt. Nach dem, was ich gerade gesehen habe, ist es ein bisschen schade, dass ihr keine Jibashiri seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370504
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370504,
					"content": "Sonst wäre meine Unschuld sofort bewiesen worden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370505
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370505,
					"content": "Ich fühle mich jetzt sehr erfrischt, aber die Müdigkeit, die ich vorher wegen der vielen Blutungen verspürte, ist auch sehr real. Sterbe ich wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370506
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370506,
					"content": "Ufff ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370507,
					"content": "Ach, ich frage dich, o Fremder. Ist es eine Sünde, von Byakuyakoku zu Unrecht verurteilt zu werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370508
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370508,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370509
					]
				},
				{
					"id": 722370509,
					"content": "Wenn ich in diesem Moment von Tokoyo Ookami wegen dieses beunruhigenden Geisteszustandes als Sündenschatten zurückgelassen werde, ist das eine Sünde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370510
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370510,
					"content": "Bin ich ein Sünder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370511
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370511,
					"content": "Nein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370512
					]
				},
				{
					"id": 722370512,
					"content": "#He, {NICKNAME}, du musst vorsichtig sein, was du sagst. Wenn er es merkt, wird er verschwinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370513,
					"content": "Du bist nur ein hinterbliebener Schatten von dem, was Antei hinterlassen hat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370514
					]
				},
				{
					"id": 722370514,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370515
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370515,
					"content": "Du bist unschuldig und ich werde es jeden wissen lassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370516
					]
				},
				{
					"id": 722370516,
					"content": "Hmpf, das ist es. Ich bin nur noch ein Schatten von mir selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370517
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370517,
					"content": "Ich bin also unschuldig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370518,
					"content": "Der hinterbliebene Schatten von Antei begann, Teile von Kapiteln zu rezitieren ...\\n„Welches der göttlichen Gesetze habe ich gebrochen ... Warum sollten die Unglücklichen zu den Göttern schauen?\\nHaben meine Taten einen Sinn, da meine frommen Taten gegen den Namen der Schuld ausgetauscht wurden?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				}
			]
		}
	]
}