					"content": "Ja, was gibt es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030702
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030702,
					"content": "Wegen Barbaras Reiseplan ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030703
					]
				},
				{
					"id": 190030703,
					"content": "Oh, Barbara will in den Flüsterwald gehen, um Kräuter zu sammeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030704
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030704,
					"content": "Ich verstehe ... Barbara hat sich gerade einen halben Tag freigenommen, um einen Freund zu treffen. Und jetzt will sie plötzlich Kräuter sammeln gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030705
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030705,
					"content": "Ich bin sicher, dass Barbara ihre Gründe hat ... Wirst du sie begleiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030706
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030706,
					"content": "Ja, werde ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030707
					]
				},
				{
					"id": 190030707,
					"content": "Ah, dann ist sie ja in guten Händen. Bitte pass gut auf Barbara auf, Ehrenritter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030708
					],
					"speakerTitle": "Victoria"
				},
