					"Victoria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190030601,
					"content": "Ja, was gibt es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030602
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030602,
					"content": "Wegen Barbaras Pause ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030603
					]
				},
				{
					"id": 190030603,
					"content": "Oh ja, Schwester Barbara hat soeben ihren Antrag auf einen halben Tag Urlaub eingereicht. Sie hat gesagt, dass sie mit einem Freund verabredet ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030604
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030604,
					"content": "Ich muss jedoch sagen, dass es recht selten ist, dass Barbara eine Pause beantragt, nur um einen Freund zu sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030605
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030605,
					"content": "Aber das ist unwichtig. Was genau möchtest du mich fragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030606
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030606,
					"content": "Nach dem „Überwältigenden Sprudeltee trauriger Korallen in einem sommerlichen Traum“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030607
					]
				},
				{
					"id": 190030607,
					"content": "Oh? Du willst mir also erzählen, dass Barbara mit dir dieses ... spezielle Getränk kaufen will?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030608
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030608,
					"content": "Dann musst du der Freund sein, von dem sie sprach, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030609
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030609,
					"content": "Hmm, da du der Ehrenritter bist, denke ich, dass das schon in Ordnung ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030610
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030610,
					"content": "Gut, dann pass bitte gut auf Barbara auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030611
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030611,
					"content": "Warum muss Barbara dauernd von ihren Plänen erzählen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030612
					]
				},
				{
					"id": 190030612,
					"content": "Nun, wie du sicher schon weißt, ist Barbara in Mondstadt aus vielen Gründen sehr beliebt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030613
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030613,
					"content": "Auch wenn die Bürger hier nur aus guter Absicht handeln, gibt es zu viele von ihnen und Barbara kann sich nicht um alles kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030614
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030614,
					"content": "Wenn sie auftauchen, während sie hier in der Kathedrale beschäftigt ist, können wir kommen und eingreifen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030615
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030615,
					"content": "Aber falls sie während ihrer Pause von Fans angequatscht wird, dann ist sie auf sich allein gestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030616
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030616,
					"content": "Und ganz zu schweigen davon, dass sie zu ... nett ist. Sie versucht stets, die Wünsche der Bürger von Mondstadt zu erfüllen, auch wenn es schwerfällt und sie noch viel erschöpfter ist als während ihrer eigentlichen Arbeitszeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030617
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030617,
					"content": "Also haben wir gedacht, dass Barbara uns immer sagt, wo sie ist, für den Fall, dass wir sie aus der Menge retten müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030618
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030618,
					"content": "Ich hoffe, dass Barbara sich nicht mehr so sehr anstrengt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Victoria"
				}
			]
		},
