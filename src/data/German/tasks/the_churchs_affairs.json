		},
		{
			"id": 1900303,
			"completionStepIds": [
				1900303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1900303",
							"2"
						],
						"stepId": 1900303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Victoria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190030301,
					"content": "Oh, du bist wieder da. Falls du nach Barbara suchst ... sie ist noch nicht zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030302,
						190030303
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030302,
					"content": "Wir haben Barbara in Wolfenlauf gefunden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				},
				{
					"id": 190030304,
					"content": "Oh, ich verstehe ... Barbatos sei Dank, dass es ihr gut geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030305
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030305,
					"content": "Aber sie kommt wohl nicht so bald zurück ... Möglicherweise muss ich ihre Aufgaben in der Kathedrale an jemand anderen übergeben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030306
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030306,
					"content": "Wir können helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030307
					]
				},
				{
					"id": 190030307,
					"content": "Oh, das ist sehr nett von euch. Ich wollte euch damit nicht behelligen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030308
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030308,
					"content": "Hmm ... Lass mich kurz nachdenken ... Ah ja, du könntest ein wenig helfen, in der Kathedrale aufzuräumen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030309
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030309,
					"content": "Die Leute schleppen häufig Schmutz mit ein, wenn sie die Kathedrale betreten, daher ist der Boden oft ziemlich schmutzig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030310
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030310,
					"content": "Putzen und dergleichen war schon immer Barbaras Aufgabe ... und sobald sie weg war, wurde alles dreckig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030311
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030311,
					"content": "Barbara ist ganz allein für die Sauberkeit eines so großen Gebäudes verantwortlich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030312
					]
				},
				{
					"id": 190030312,
					"content": "Ja, das stimmt. Sie meinte stets, dass sie selbst damit zurechtkommt und niemand sonst ihr helfen muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030313
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030313,
					"content": "Aber sie sieht oft recht erschöpft aus, wenn sie mit dem Putzen fertig ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030314
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030314,
					"content": "Um ehrlich zu sein, ich bin sehr überrascht, dass du helfen willst ... Viel mehr wundert mich, dass Barbara bereit ist, sich von dir helfen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030315
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030315,
					"content": "Dadurch würde sie jedoch entlastet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030316
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030316,
					"content": "Ich überlasse dir jetzt das Putzen, Ehrenritter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030303,
					"content": "Barbara ist auf dem Weingut Morgenröte und sieht nach Tunner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				}
			]
		},
