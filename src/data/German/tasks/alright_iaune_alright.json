			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130401,
					"content": "#{F#Reisende}{M#Reisender}, du ... du hast mir wirklich eine Tasse Kaffee gekocht? Vielen Dank ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130402,
						240130403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130402,
					"content": "Nichts zu danken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				},
				{
					"id": 240130404,
					"content": "... Oh, schmeckt der gut! Viel besser als der Kaffee in der Maison Gestion! Nein ... genauer gesagt kann man ihn einfach nicht mit diesem hier vergleichen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130405,
					"content": "Wenn ich doch nur jeden Tag solchen Kaffee trinken könnte! Dann würde ich nicht jeden Nachmittag so todesmüde sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130406
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130406,
					"content": "Ich danke dir für den Kaffee. Nach dieser Tasse muss ich aber wieder zur Arbeit gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130407,
						240130408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130407,
					"content": "Viel Erfolg bei der Arbeit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130409,
					"content": "Aber natürlich. Ich muss hart arbeiten und so schnell wie möglich ein erfahrener und kompetenter Mitarbeiter wie Herr Roialte werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130410
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130410,
					"content": "*seufz* Aber wie viele Albträume muss ich bis dahin noch durchmachen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130408,
					"content": "Kopf hoch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130403,
					"content": "Lass ihn dir schmecken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				}
			]
		},
		{
			"id": 2401331,
			"completionStepIds": [
				2401306
			],
