			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130101,
					"content": "*seufz* Ich verstehe wirklich nicht, warum das nur passiert ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130102,
						240130103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130102,
					"content": "Iaune?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130104
					]
				},
				{
					"id": 240130104,
					"content": "#Oh, {F#Reisende}{M#Reisender}! Es ist mir eine große Freude, dich zu sehen. Bist du hier, um einen Kaffee zu trinken? Lass mich dich auf eine Tasse einladen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130105
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130105,
					"content": "Was ist los? Du siehst schrecklich aus. Hat dich wieder jemand gezwungen, die ganze Nacht aufzubleiben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130106,
					"content": "Danke für deine Fürsorge. Dieses Mal geht es um mein eigenes Problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130107,
					"content": "In letzter Zeit habe ich mich gefragt ... was der Sinn meiner Arbeit ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130108,
					"content": "Ich habe immer geglaubt, dass die Maison Gestion eine faire und effiziente Behörde ist, in der jeder bereit ist, einander zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130109,
					"content": "Mit der Leitung der Maison Gestion wird sich der gesamte Hof von Fontaine zweifellos in die richtige Richtung bewegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130110,
					"content": "Aber so wie es jetzt aussieht, ist sie nichts Weiteres als ein kaputtes Maschinenhaus. Im Inneren herrscht ein Wirrwarr aus Zahnrädern, Hebeln, Schwenkarmen ... Nur die äußere Hülle bleibt schön intakt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130111,
					"content": "Dank einer Reihe von Zufällen und gewonnenen Erkenntnissen funktioniert dieses Maschinenhaus immer noch. Aber es mangelt an sorgfältiger Überlegung und Gestaltung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130112,
					"content": "Ich ... Ich möchte etwas tun, aber ich weiß nur nicht, wo ich anfangen soll. Ich habe Angst, dass das gesamte Maschinenhaus zusammenbricht, wenn ich etwas falsch mache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130113
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130113,
					"content": "Obwohl Herr Roialte stets betont, ich müsse mir keine Sorgen machen, denn die Dinge können nicht noch schlimmer werden, egal wie viele Fehler ich mache ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130114
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130114,
					"content": "Mal im Ernst ... War das wirklich ein Trost?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130115,
					"content": "*seufz* Tut mir leid, ich hätte mich nicht bei euch beschweren sollen. Um ehrlich zu sein, bin ich heute rausgegangen, um mich zu entspannen und meine Sorgen für eine Weile zu vergessen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130116,
					"content": "Lass mich dir einen Kaffee brühen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130117
					]
				},
				{
					"id": 240130117,
					"content": "Wirklich? Du kannst Kaffee aufbrühen? Erstaunlich! Ich wollte es schon früher lernen, hatte aber nie die Zeit dafür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130118
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130118,
					"content": "Dann danke ich dir. Ich warte hier. Hoffentlich stolpere ich im Café nicht über neue arbeitsbezogene Angelegenheiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130103,
					"content": "Hast du heute frei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130104
					]
				}
			]
		},
		{
			"id": 2401302,
			"completionStepIds": [
				2401302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401302",
							"2"
						],
						"stepId": 2401302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arouet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130201,
					"content": "#{F#Reisende}{M#Reisender}, bist du hier, um im Café zu helfen? Herzlich willkommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130202
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130202,
					"content": "Nein, wir wollten nur eine Tasse Kaffee für einen Freund kochen. Er scheint jetzt ... hm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130203,
						240130204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130203,
					"content": "Er ist jetzt ein bisschen traurig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130205
					]
				},
				{
					"id": 240130205,
					"content": "Der Freund, von dem ihr redet, ist das Iaune, der da drüben sitzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130206
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130206,
					"content": "Kennst du ihn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130207
					]
				},
				{
					"id": 240130207,
					"content": "Ich bin seit langer Zeit mit Roialte befreundet. Er erzählte mir, dass sie einen neuen klugen und fleißigen jungen Mann im Büro haben, namens Iaune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130208
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130208,
					"content": "Mach dir keine Sorgen um ihn. Junge Leute, die gerade erst mit der Arbeit in der Maison Gestion angefangen haben, sind immer eine Zeit lang frustriert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130209
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130209,
					"content": "Wenn sie einen eigenen Platz gefunden haben, wird sich die Stimmung entspannen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130210
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130210,
					"content": "Warum bist du darin so erfahren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130211,
					"content": "Ich habe auch mal in der Maison Gestion gearbeitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130212
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130212,
					"content": "Eines Tages war ich mit meinem Job nicht mehr zufrieden und kündigte. Dann ... habe ich dieses Café eröffnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130213,
						240130214
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130213,
					"content": "Klingt so, dass viel passiert ist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130215
					]
				},
				{
					"id": 240130215,
					"content": "Hahaha, vielleicht. Aber jetzt bin ich nur der Inhaber eines Cafés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130216
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130216,
					"content": "Gut, müsst ihr für Iaune nicht noch eine Tasse Kaffee kochen? Ich gehe den Kaffeeapparat einstellen. Kommt zu mir, wenn ihr fertig seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130214,
					"content": "Es scheint so, dass es da viel zu erzählen gibt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130215
					]
				},
				{
					"id": 240130204,
					"content": "Er steht im Moment unter großem Druck.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130205
					]
				}
			]
		},
