			},
			"dialogs": [
				{
					"id": 240133101,
					"content": "Das hört sich gut an! Dann können wir mit dem Aufbrühen beginnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240133102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240133102,
					"content": "Du beginnst, den Kaffee zu mischen ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240133103
					]
				},
				{
					"id": 240133103,
					"content": "Ooh, das riecht aber gut! Geben wir ihn Iaune. Paimon hofft, dass er ihn aufmuntert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
