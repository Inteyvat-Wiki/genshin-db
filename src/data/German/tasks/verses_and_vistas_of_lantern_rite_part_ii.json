	"talks": [
		{
			"id": 7103301,
			"completionStepIds": [
				7103301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103301",
							"2"
						],
						"stepId": 7103301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330101,
					"content": "#Hier, {F#Reisende}{M#Reisender}, hier drüben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330102,
					"content": "Du bist der Künstler, der vor gewisser Zeit eine Abmachung mit Qingzhou getroffen hat ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330103
					]
				},
				{
					"id": 710330103,
					"content": "Ja, der bin ich. Dieser Dichter und ich haben vereinbart, dass jeder von uns ein Kunstwerk erstellen würde, welches das Laternenritual behandelt und genau auf den Punkt bringt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330104,
					"content": "Damals hast du mir sogar dabei geholfen, meine Farben und Pinsel zu suchen, weißt du noch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330105,
						710330106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330105,
					"content": "Ja, ich erinnere mich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				},
				{
					"id": 710330107,
					"content": "Mein Bild ... äh, nun ... eigentlich habe ich schon ziemlich viel gemalt – Szenen, Menschen, sogar Tiere ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330108,
					"content": "Ich bin zuversichtlich, dass alle diese Arbeiten ihre Objekte sehr präzise abbilden, aber ... ich kann nicht sagen, ob irgendeines davon auch wirklich das Laternenritual auf den Punkt bringt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330109,
					"content": "*seufz* Ich kann schon seit Tagen nicht mehr richtig essen oder schlafen, weil mir diese Sache über dem Haupte schwebt. Ich habe schon fast alles gemalt, aber keines meiner Bilder kann den Geist des Fests wirklich einfangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330110,
					"content": "Also möchte ich diesen Dichter finden und erfahren, wie er mit seinem Gedicht vorankommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330111,
					"content": "#Weißt du, wo er hingegangen ist, {F#Reisende}{M#Reisender}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330112,
					"content": "Er ist in das Qingce-Dorf gegangen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330113
					]
				},
				{
					"id": 710330113,
					"content": "Das Qingce-Dorf? Was hat er denn dort zu suchen? ... Dichterische Anregungen vielleicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330114
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330114,
					"content": "#Schnell, {F#Reisende}{M#Reisender}, wir müssen in dieses Qingce-Dorf und ihn suchen! Vielleicht kann ich dort ja ebenfalls ein paar Anregungen finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330115
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330115,
					"content": "Ähm! Egal, brechen wir sofort auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330106,
					"content": "Also, was dein Bild angeht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				}
			]
		},
		{
			"id": 7103303,
			"completionStepIds": [
				7103303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103303",
							"2"
						],
						"stepId": 7103303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330301,
					"content": "Hier ist das Qingce-Dorf, also ... Wo ist dann jetzt dieser Dichter? Ist er woanders hingegangen, um Inspirationen zu finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330302
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330302,
					"content": "Als ich ihn das letzte Mal gesehen habe, hat er mit den Kindern gespielt und ihnen Laternen-Rätsel aufgegeben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330303
					]
				},
				{
					"id": 710330303,
					"content": "Laternen-Rätsel? Was soll denn das bedeuten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330304
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330304,
					"content": "Hat er etwa keine Inspirationen für sein Gedicht gefunden und einfach aufgegeben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330305
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330305,
					"content": "Wie dem auch sei, das Laternenritual ist schon beinahe wieder vorbei, ganz egal, was er nun im Schilde führt – ich darf keine Zeit mehr verlieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330306
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330306,
					"content": "Fragen wir jemanden, der hier das Sagen hat. Ich muss heute unbedingt erfahren, wie es um unseren Wettstreit steht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 7103304,
			"completionStepIds": [
				7103304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103304",
							"2"
						],
						"stepId": 7103304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Oma Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330401,
					"content": "#Na, wenn das nicht {F#die Reisende}{M#der Reisende} ist. Dank dir kann sich unser Dorf endlich einer festlichen Stimmung erfreuen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330402
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 710330402,
					"content": "Oh, und ich sehe, dass du jemanden Neues mitgebracht hast? Wenn es mir gestattet ist, das zu fragen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330403
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 710330403,
					"content": "Das ist ein Künstler, der hierhergekommen ist, um nach Qingzhou zu suchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330404
					]
				},
				{
					"id": 710330404,
					"content": "Er sucht also nach Qingzhou, ja? Hmm, das ist ebenso gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330405
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 710330405,
					"content": "Als Fräulein Wangya vor einigen Tagen fortgegangen ist, sagte Herr Qingzhou, er würde gern noch eine Weile länger bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330406
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 710330406,
					"content": "Wahrscheinlich denkt er sich immer noch Laternen-Rätsel für die Kinder aus. Wenn ich mich richtig erinnere, hat er sie mit nach draußen genommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330407
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 710330407,
					"content": "Ihr werdet ihn wahrscheinlich draußen suchen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330408
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 710330408,
					"content": "#Also erfindet er wirklich Spiele mit Laternen-Rätseln ... Würdest du mir bitte einen Gefallen tun, {F#Reisende}{M#Reisender}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330409
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330409,
					"content": "Sag dem Dichter, dass ich eingetroffen bin. Ich bleibe hier und bereite mich vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330410
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330410,
					"content": "Was auch passieren mag, ich muss heute einfach erfahren, wie es um unseren Wettstreit steht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 7103305,
			"completionStepIds": [
				7103305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103305",
							"2"
						],
						"stepId": 7103305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330501,
					"content": "Hahaha, so langsam habt ihr den Bogen alle raus, glaube ich. Ihr schafft es immer schneller, die richtigen Antworten zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330502,
						710330503
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330502,
					"content": "Vermeer ist eingetroffen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330504
					]
				},
				{
					"id": 710330504,
					"content": "Vermeer ... Ah, richtig, das ist doch dieser Künstler. Mal sehen ... nach meiner Zählung haben wir heute wirklich das Datum, das wir vereinbart hatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330505
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330505,
					"content": "Dann ist es schade, dass mein Gedicht immer noch nicht vollendet ist. Und auch diesen Kinder habe ich immer noch nicht genügend Laternen-Rätsel aufgegeben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330506
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330506,
					"content": "Nun, dann ist dies vielleicht einfach die äußerste Grenze meiner dichterischen Fähigkeiten ... Würdest du mich eventuell begleiten, während ich mir ein paar neue Inspirationen sammeln gehe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330507
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330507,
					"content": "Hmm, vielleicht sollte ich es lieber nicht „Inspirationen sammeln“ nennen, gehen wir einfach zusammen spazieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330508
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330508,
					"content": "Onkel Qingzhou! Heißt das etwa, dass wir keine Laternen-Rätsel mehr bekommen? Ich will weiterspielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330509
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710330509,
					"content": "Ich will auch noch ein paar Laternen-Rätsel lösen, Onkel Qingzhou ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330510
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 710330510,
					"content": "Hmpf, ich will auch noch ein paar Rätsel lösen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330511
					],
					"speakerTitle": "You"
				},
				{
					"id": 710330511,
					"content": "Hahaha, beruhigt euch, Kinder. Ich mache nur einen kurzen Spaziergang mit dieser reizenden, reisenden Person hier. Bald bin ich wieder zurück und gebe euch allen ein neues Laternen-Rätsel auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330512
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330512,
					"content": "Geht wieder zurück ins Qingce-Dorf, und ich werde euch dort aufsuchen, wenn ich zurück bin. Was sagt ihr dazu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330513
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330513,
					"content": "Klasse! Du bist einfach super, Onkel Qingzhou, du kannst dir echt viele Rätsel ausdenken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330514
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710330514,
					"content": "Du liest ganz, ganz viele Bücher, nicht wahr, Onkel Qingzhou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330515
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 710330515,
					"content": "Wenn ich groß bin, will ich genauso sein wie du, Onkel Qingzhou ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330516
					],
					"speakerTitle": "You"
				},
				{
					"id": 710330516,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330517
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330517,
					"content": "#Nun, dann lass uns aufbrechen, {F#Reisende}{M#Reisender}. Ich kann die Kinder nicht ewig warten lassen, also bringen wir diese belanglose Angelegenheit schnell zu Ende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330503,
					"content": "Kannst du dich noch an deine Vereinbarung mit Vermeer erinnern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330504
					]
				}
			]
		},
		{
			"id": 7103309,
