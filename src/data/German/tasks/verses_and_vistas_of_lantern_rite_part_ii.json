						],
						"stepId": 7103312,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Oma Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331201,
					"content": "Oh, brauchst du irgendwas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331202
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 710331202,
					"content": "Was Qingzhou und Vermeer angeht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331203
					]
				},
				{
					"id": 710331203,
					"content": "Ach, die beiden? Mach dir deretwegen mal keine Sorgen. Solange sie freiwillig mit den Kindern spielen, bin ich mit ihnen zufrieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331204
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 710331204,
					"content": "Immerhin haben wir gerade eine festliche Saison. Da ist es gut, wenn die Dinge ein bisschen in Schwung kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331205
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 710331205,
					"content": "Ständig läufst du herum, um dem Qingce-Dorf zu helfen. Vielen Dank, liebes Kind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331206,
						710331207
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 710331206,
					"content": "Keine Ursache.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				},
				{
					"id": 710331208,
					"content": "Du bist wirklich ein gutherziges Kind ... Nimm dies hier zum Dank an. Auch du sollst jetzt ein fröhliches Fest feiern können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331209
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 710331209,
					"content": "Ich hoffe, dass die Laternenrituale auch in Zukunft so spannend sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 710331207,
					"content": "Gern geschehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				}
			]
		},
		{
			"id": 7103314,
			"completionStepIds": [
				7103314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
