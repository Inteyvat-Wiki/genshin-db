			},
			"dialogs": [
				{
					"id": 710330801,
					"content": "Hmm ... In Ordnung, ich hab’s, ein Satz für das Laternen-Rätsel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330901,
					"content": "In Ordnung, das Laternen-Rätsel ist vollendet. Gehen wir nun ins Qingce-Dorf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330902
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330902,
					"content": "Ich werde dir das Rätsel sagen, sobald wir angekommen sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 7103310,
			"completionStepIds": [
				7103310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103310",
							"2"
						],
						"stepId": 7103310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kleine Liu",
					"You",
					"Zuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331001,
					"content": "Onkel Qingzhou ist wieder da! Hast du wieder ein neues Laternen-Rätsel für uns, Onkel Qingzhou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331002
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 710331002,
					"content": "Dieses Mal werde ich es als Erster lösen ... glaube ich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331003
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331003,
					"content": "Ich werde dieses Mal richtig gut nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331004
					],
					"speakerTitle": "You"
				},
				{
					"id": 710331004,
					"content": "Hahaha, jawohl. Ich habe das Laternen-Rätsel bereits aufgeschrieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331005
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331005,
					"content": "Hilfst du mir bitte dabei, diese Laterne aufzuhängen? Ein bisschen höher bitte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 7103311,
			"completionStepIds": [
				7103311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103311",
							"2"
						],
						"stepId": 7103311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331101,
					"content": "Endlich bist du hier. Hast du dein Gedicht geschrieben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331102,
					"content": "Nein, ich habe nichts Brauchbares zu Papier gebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331103
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331103,
					"content": "Also hast auch du ... Ähm ... hast du nichts zustande gebracht, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331104,
					"content": "Liyue ist groß und hat viele Haushalte. Ich habe lange über diese Angelegenheit nachgedacht, letztendlich aber keine geeignete Zusammenfassung für das Laternenritual gefunden. Hast du dein Bild denn vollenden können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331105
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331105,
					"content": "I... Ich habe ebenfalls nichts zustande gebracht. Liyue ist einfach zu groß! Wie könnte ich denn das alles malen, ohne gleich den ganzen Himmel als Leinwand zu nutzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331106,
					"content": "Also ist es letztendlich keinem von uns gelungen, ein Gedicht oder ein Kunstwerk zu schaffen, das den Hafen von Liyue und das Laternenritual wirklich erfassen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331107
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331107,
					"content": "Dann haben wir hier wohl ein Unentschieden, würde ich sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331108
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331108,
					"content": "Äh ... gut, in Ordnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331109,
					"content": "Onkel Qingzhou, Onkel Qingzhou! Wir haben das Laternen-Rätsel gelöst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331110
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331110,
					"content": "Laternen-Rätsel? Was denn für ein Laternen-Rätsel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331111,
					"content": "Ach, das ist wirklich nichts Besonderes. Ich habe mir ein paar Laternen-Rätsel ausgedacht, um diesen Kindern hier eine Freude zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331112
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331112,
					"content": "Oh? Was für Rätsel denn? Kannst du mir eines aufgeben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331113
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331113,
					"content": "„Zahllose Schiffe gleiten über die Wellen, deren Lichter die Steine Guyuns erleuchten. Sie treiben entlang der Meeresgezeiten, bis ihre Gebeine am Ende mit den Fischen und Drachen ruhen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331114
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331114,
					"content": "Und dieses Rätsel hast du für Kinder geschrieben? Es ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331115
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331115,
					"content": "Onkel Qingzhou, wer ist denn dieser andere Onkel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331116,
						710331117
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331116,
					"content": "Das ist ein Maler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331118
					]
				},
				{
					"id": 710331118,
					"content": "Wenn dieser Dichter keinen Wettstreit mit mir gewünscht hat, warum hätte er dann diese Vereinbarung mit mir treffen sollen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331119
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331119,
					"content": "Da liegst du falsch. Anfangs habe ich es wirklich als einen Wettstreit betrachtet ... Ich habe viel Energie aufgewandt, überall hinzugehen, um nach Inspirationen zu suchen ... und am Ende das perfekte Gedicht zu verfassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331120
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331120,
					"content": "Allerdings, wie du auch selbst gemerkt haben magst, ist es schier unmöglich, den Hafen von Liyue und das Laternenritual in ein paar wenigen Zeilen von Worten zu erfassen. Also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331121
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331121,
					"content": "Also bist du hierhergekommen, um mit Kindern zu spielen und ihnen Laternen-Rätsel aufzugeben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331122
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331122,
					"content": "So ist es. Ich bin gekommen, um mit Kindern zu spielen, in der Hoffnung, dass ich bei diesen wunderbaren Laternen-Rätsel-Spielen ein wenig dichterische Anregung finden würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331123
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331123,
					"content": "Hehe, wenn ich auch nie eine Inspiration für mein Gedicht gefunden habe, so sind mir doch wenigstens ein paar Laternen-Rätsel eingefallen. Und die Kinder haben das sehr genossen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331124
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331124,
					"content": "Vielleicht ... ist diese Erfahrung ja genau das Gedicht, nach dem ich die ganze Zeit gesucht habe. Aber ach, wo würde ich nur beginnen, um es aufzuschreiben? Weil ich also kein Gedicht habe, kann ich mir auch keinen Wettstreit mir dir liefern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331125
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331125,
					"content": "Ihr Menschen aus Liyue ... seid wirklich seltsam! Was wird dann aus unserem Wettstreit? Wer hat gewonnen, wer hat verloren? Ein Unentschieden kann ich einfach nicht akzeptieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331126
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331126,
					"content": "Dieser andere Onkel da scheint wirklich gern zu quatschen ... der Gewinner ist natürlich Onkel Qingzhou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331127
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331127,
					"content": "Er ist einfach super. Er hat sich richtig viele Laternen-Rätsel für uns ausgedacht, und ich wette, du kannst kein einziges davon lösen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331128
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331128,
					"content": "Dieser Dichter ... Hmm? Moment mal, da kommt mir eine Idee ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331129
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331129,
					"content": "Wie wäre es damit – lass uns einen neuen Wettstreit beginnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331130
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331130,
					"content": "Oh? Und wie sollte dieser neue Wettstreit deiner Meinung nach aussehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331131
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331131,
					"content": "Du hast dir für diese Kinder viele Laternen-Rätsel ausgedacht, nicht wahr? Nun, und habe viele Laternen wie auch deren dekorativen Muster gesehen, als ich nach Anregungen für mein Bild suchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331132
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331132,
					"content": "Du schreibst das Rätsel und ich male die Laterne dazu. Die Kinder sollen dann entscheiden, wessen Arbeit ihnen besser gefällt, und bestimmen so den Sieger. Wie findest du das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331133
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331133,
					"content": "In Ordnung! Diese Bedingungen passen mir sehr gut und entsprechen auch gleichzeitig dem Geist des Laternenrituals. Ein wirklich angemessener Wettstreit also.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331134
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331134,
					"content": "Dann sind wir uns ja einig. Lass mich zuerst noch meine Maler-Utensilien vorbereiten, und dann können wir unseren Wettstreit beginnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331135,
						710331136
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331135,
					"content": "Ihr habt wirklich viel Energie ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331137
					]
				},
				{
					"id": 710331137,
					"content": "Kommt alle her, Kinder. Zeigt mir das Rätsel, das dieser Dichter schreibt, und ich werde eine wunderschöne Laterne für euch malen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331138
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331138,
					"content": "Hehe, du wirst allerdings nicht mit mir Schritt halten können, fürchte ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331136,
					"content": "Gebt alles, Leute ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331137
					]
				},
				{
					"id": 710331117,
					"content": "Das ist dieser Typ, der sich mit Qingzhou einen Wettstreit liefert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331118
					]
				}
			]
		},
		{
			"id": 7103312,
			"completionStepIds": [
				7103312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103312",
