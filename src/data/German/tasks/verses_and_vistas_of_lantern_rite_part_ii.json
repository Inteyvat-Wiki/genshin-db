			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331401,
					"content": "Seht euch diese Laterne an, Kinder. Die Antwort auf das Rätsel ist ein „Ding“ im Laternenritual. Na kommt, ihr könnt jetzt raten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331402
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331402,
					"content": "#Ich muss mich mit {F#der Reisenden}{M#dem Reisenden} nun um eine gewisse Angelegenheit kümmern. Wenn ich fertig bin, komme ich wieder zurück und wir spielen weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331403
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331403,
					"content": "Ooh! Was denn für eine Angelegenheit, Onkel Qingzhou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331404
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 710331404,
					"content": "Ich muss einen gewissen Maler finden, um einen gewissen ... Wettstreit zu entscheiden. Ich schreibe mein bestes Gedicht, er malt sein bestes Bild, und dann sehen wir, wer die bessere Leistung erbracht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331405
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331405,
					"content": "Ach, da wirst du ganz sicher gewinnen, Onkel Qingzhou. Deine Laternen-Rätsel waren alle richtig toll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331406
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331406,
					"content": "Wirklich? Dann vielen Dank für euer Lob. Bringt als erstes diese Laterne ins Qingce-Dorf und versucht, die Lösung zu erraten. Hier in der Wildnis ist es zu gefährlich für euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331407
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331407,
					"content": "Keine Bange, Onkel Qingzhou! Wir kennen uns hier gut aus und finden auch leicht alleine zurück. Geh los und zeig diesem Maler, was du drauf hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331408
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331408,
					"content": "Also ... dann beeil dich und komm wieder zurück, wenn dein Wettstreit mit diesem Maler fertig ist, Onkel Qingzhou, damit wir weiterspielen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331409
					],
					"speakerTitle": "You"
				},
				{
					"id": 710331409,
					"content": "Natürlich. Ich komme gleich zu euch, wenn ich diese Angelegenheit erledigt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331410,
						710331411
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331410,
					"content": "Wirklich ein tolles Gedicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331411
					]
				},
				{
					"id": 710331411,
					"content": "Wir haben einen Gewinner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331412
					]
				},
				{
					"id": 710331412,
					"content": "Hehe, dass ist kein echtes Gedicht. Nichts weiter als ein Laternen-Rätsel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331413
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331413,
					"content": "In Ordnung, dann wollen wir diesen Maler suchen. Er wartet schon lange genug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
