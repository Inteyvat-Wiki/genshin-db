			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221080101,
					"content": "Immer noch nicht gefunden ... Dabei haben wir bald keine Spuren mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080103
					]
				},
				{
					"id": 221080103,
					"content": "Wer bist du? Wenn du etwas über die Gilde erfahren willst, solltest du lieber Katheryne fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080104,
					"content": "Ach, du bist schon ein Abenteurer? Entschuldige bitte, ich mag zwar der Leiter der Niederlassung hier sein, aber ich kümmere mich nicht allzu viel um die Angelegenheiten der Gilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080105,
					"content": "Deswegen kenne ich nicht alle Neuen hier. Wenn ich mir dich genauer ansehe, glaube ich, dass du schon einiges von Abenteuern verstehst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080106,
					"content": "Vielleicht könntest du mir ja einen Gefallen tun. Ich muss aber dazusagen, dass das kein Auftrag der Gilde ist, sondern eine Privatmission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080107,
						221080108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080107,
					"content": "In Ordnung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080109
					]
				},
				{
					"id": 221080109,
					"content": "Du bist ja gut drauf. Es ist aber nicht wirklich klug, Aufträge anzunehmen ohne zu wissen, worum es sich genau handelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080111,
					"content": "Was die Mission angeht, so möchte ich dich bitten, zwei starke Hilichurle mit Großschilden zu vernichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080112,
					"content": "Ihre Schilde sind mit der Geo-Kraft versehen. Sie sollten nicht allzu gefährlich sein, aber Vorsicht ist trotzdem angebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080113
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080113,
					"content": "Du musst sie einfach vernichten und mir danach Bericht erstatten. Dann bekommst du auch eine Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080114,
					"content": "Und wenn du etwas findest, das mit Säbeln zu tun hat, kannst du es zu mir bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080115,
					"content": "Wenn nicht, ist das auch nicht so schlimm. Solange du die Hilichurl vernichtest, bekommst du deine Belohnung von mir. Du kannst also beruhigt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080108,
					"content": "Um was für eine Mission handelt es sich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080110
					]
				},
				{
					"id": 221080110,
					"content": "Du gehst sehr vorsichtig vor. Du hast sicher schon erfahren, wie es ist, einen Fehler zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
