			"dialogs": [
				{
					"id": 221080301,
					"content": "Hast du sie vernichtet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080302
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080302,
					"content": "Ja, ich habe sie besiegt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080303
					]
				},
				{
					"id": 221080303,
					"content": "Nicht übel, du bist richtig flink. Sieht ganz nach einem ordentlichen Abenteurer aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080304
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080304,
					"content": "Hier ist deine Belohnung. Jetzt sollte es in der Umgebung auch viel friedlicher sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080305
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080305,
					"content": "Hast du nichts gefunden, dass mit Säbeln zu tun hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080306
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080306,
					"content": "Hmm, na gut. Das habe ich mir schon gedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080307
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080307,
					"content": "Danke, hier ist deine Belohnung. Jetzt kannst du dich wieder um deine eigenen Sachen kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		}
	]
