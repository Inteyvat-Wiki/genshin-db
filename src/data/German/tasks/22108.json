			},
			"dialogs": [
				{
					"id": 221080201,
					"content": "Hast du sie vernichtet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080202,
					"content": "Noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080203
					]
				},
				{
					"id": 221080203,
					"content": "Bloß keine Eile. Abenteurer, die überstürzt handeln, machen nur Fehler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080204
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080204,
					"content": "Zu lange trödeln solltest du aber auch nicht. Deine Belohnung hängt nämlich auch davon ab, wie lange du brauchst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
