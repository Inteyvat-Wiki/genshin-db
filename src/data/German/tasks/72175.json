			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roald",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721751801,
					"content": "#So sieht man sich wieder, {NICKNAME}! Und diese ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751802
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751802,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751803,
					"content": "Ich frag einfach gerade heraus: Wie viel kostet dieses süße hin- und herfliegende Ding? Wirklich interessant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751804
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751804,
					"content": "Ah?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751805,
						721751807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751805,
					"content": "Geht es dir gut ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751806
					]
				},
				{
					"id": 721751806,
					"content": "Offensichtlich nicht so gut! Warum hat er plötzlich sein Gedächtnis verloren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751809,
					"content": "Wovon redet ihr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751810
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751810,
					"content": "Uff ... Hahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751811
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751811,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751812,
					"content": "???",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751813
					]
				},
				{
					"id": 721751813,
					"content": "Hahah ... ah ... hahhaha! Schaut nur wie ihr guckt! Hahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751814
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751814,
					"content": "Oh nein ... ich kann nicht mehr ... tut mir leid ... das ist ... hahaha ... mein Lieblingswitz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751815
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751815,
					"content": "Das ist kein bisschen lustig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751816,
						721751817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751816,
					"content": "Ich verstehe deinen Sinn für Humor nicht wirklich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751818,
					"content": "Gut, gut. Ich mache keinen Witz mehr. Tut mir leid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751819
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751819,
					"content": "Also wirklich. Ich dachte du, als großer Abenteurer, bist ein sehr ernsthafter Mensch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751820,
					"content": "Haha, die Abenteurergilde ist als ein Kreis von Spinnern bekannt. Verglichen dazu bin ich ein relativ normaler Mensch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751821
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751821,
					"content": "... auch nicht soo normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751822,
					"content": "Vielen Dank für eure Pilze. Bisher ist es nicht sehr wirksam ... vielleicht muss man es über einen längeren Zeitraum einnehmen, vielleicht ist es aber auch kein Medikament an sich ... es schmeckt jedenfalls nicht schlecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751823
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751823,
					"content": "Ich kann nicht alle essen, ich muss einige für meine Freunde in Sumeru aufbewahren, um ihren medizinischen Wert zu erforschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751824
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751824,
					"content": "Ich schätze, du wirst es vergessen, sobald du dich umdrehst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751825,
					"content": "Ähm, Geschäft ist Geschäft. Habt ihr euch bitte auf die Suche nach dem Wandgemälde gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751826
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751826,
					"content": "Hier ist das Foto, das du wolltest.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751827
					]
				},
				{
					"id": 721751827,
					"content": "Oh, vielen lieben Dank! Das ist doch die Art und Weise, wie man in diesem Land Dankbarkeit ausdrückt oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751828
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751828,
					"content": "Oh, wirklich interessant. Es ist nur ... habt ihr nicht noch mehr Wandgemälde entdeckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751829,
						721751830
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751829,
					"content": "Das ist alles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751831,
					"content": "Na dann ist es sogar noch interessanter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751832
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751832,
					"content": "Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751833,
					"content": "Die Ureinwohner von Tsurumi haben ihre eigene Zivilisation gebildet, die auf dem Glauben an den magischen Elektro-Vogel beruhte und deren Kernelement Opferrituale waren. Jeder, der ein wenig Ahnung von Geschichte hat, sollte keine Einwände haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751834
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751834,
					"content": "Aber auf den Wandgemälden, die ihr mir zur Verfügung gestellt habt, gibt es keine Spur des Donnervogels. Was die Menschen anbeten, ist etwas anderes –",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751835
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751835,
					"content": "Die Sonne, der Mond und die Sterne ... und ... seltsame Symbole. Vielleicht ... besaßen die Vorfahren der Ureinwohner Tsurumis eine hohe Zivilisationsstufe, bevor der Donnervögel herabstieg ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751836
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751836,
					"content": "Darüber hinaus ... Nebel und Mond, Sterne und Dunkelheit ... nun, das ergibt keinen Sinn ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751837
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751837,
					"content": "Es ist besser, wenn du deinen Kopf nicht überstrapazierst. Deine Erinnerung lässt dich bereits im Stich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751838,
					"content": "Ah, tut mir leid. Ich war so tief in Gedanken versunken, dass ich vergaß, dass ihr hier seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751839
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751839,
					"content": "Nochmals vielen Dank für all eure harte Arbeit, ich habe genug Material für den Rest meines Tagebuchs ... und ich werde nicht vergessen, mit eurem Namen zu unterschreiben, wenn ich das Glück habe, von einem Historiker ernst genommen zu werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751840
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751840,
					"content": "Gut, nun ist es an der Zeit, dass ich mich bei der Abenteurergilde melde. Tut mir nochmal sehr leid, so viel eurer Zeit in Anspruch genommen zu haben. Ich hoffe wir sehen uns wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751841
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751841,
					"content": "Was für ein beschäftigter Mensch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751842
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751842,
					"content": "Ah, ich hätte noch eine Sache auf dem Weg. Auch wenn es nichts Großes ist, hoffe ich, dass du mir folgst. Der kleine Junge, der erwähnt wurde ... wie hieß er doch gleich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751843
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751843,
					"content": "„Ruu“ ... genau, das ist der Name. Ich habe etwas Essen, was ich ihm mitbringen möchte. Ich hoffe es ist noch frisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751844
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751844,
					"content": "Seit dem letzten Mal habe ich über das Kind auf dieser Insel nachgedacht ... Es muss schwer sein, auf einer so tückischen Insel zu leben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751845
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751845,
					"content": "#Also gut, ich will nicht noch mehr deiner Zeit stehlen, {NICKNAME}. Wir sehen uns auf dem nächsten Stopp unserer Reise. Ad astra abyssosque! Zu den Sternen und Abgründen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751830,
					"content": "Wir haben nur diese gefunden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751817,
					"content": "Das ist die Art wie „Vergessliche“ sich an diese Welt anpassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751807,
					"content": "Haben diese „Leuchtpilze“ gewirkt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751808
					]
				},
				{
					"id": 721751808,
					"content": "Ja genau, genau! Warum hat es sich verschlechtert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751809
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}