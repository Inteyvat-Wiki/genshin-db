			},
			"dialogs": [
				{
					"id": 721750601,
					"content": "#Hallo {NICKNAME} und die gesprächige Fee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750602
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750602,
					"content": "Hallo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750603,
					"content": "Ich bin Paimon! Nächstes Mal hoffe ich erinnerst du dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750604,
					"content": "Ich weiß, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750605
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750605,
					"content": "Wah! Du machst dich also lustig! Wo sind nur deine Manieren?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750606,
					"content": "#Hm {NICKNAME}, gib ihm schnell diese gespenstischen Pilze. Ich will nicht mit ihm reden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750607,
					"content": "Ist das genug?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7217518,
			"completionStepIds": [
				7217509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217502",
							"3"
						],
						"stepId": 7217502,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217509",
