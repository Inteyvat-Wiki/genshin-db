			"dialogs": [
				{
					"id": 721750401,
					"content": "Ihr zwei! Hattet ihr in letzter irgendetwas gesammelt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750402,
						721750405
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750402,
					"content": "Wir haben nichts Interessantes gefunden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750403
					]
				},
				{
					"id": 721750403,
					"content": "Du musst nicht so aufgeregt umherkaufen. Ich werde immer hier sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750404
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750404,
					"content": "Übrigens vielen Dank für die „Leuchtpilze“. Sie sind sehr frisch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750407
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750407,
					"content": "Du hast leicht reden. Du isst ja gerade die Pilze, die wir gepflückt haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750408,
					"content": "Haha, mach dir nichts daraus. Ich esse immer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750409
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750409,
					"content": "Was für eine Person!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750405,
					"content": "Es läuft immer noch gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750406
					]
				},
				{
					"id": 721750406,
					"content": "Ruh dich aus, wenn du müde bist. Hier ein paar „Leuchtpilze“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750407
					],
					"speakerTitle": "Roald"
				}
			]
		},
		{
