			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Roald"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750101,
					"content": "Ich wusste gar nicht, dass ihr auch noch auf der Insel seid, das ist ja toll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750102
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750102,
					"content": "Wie ist es euch ergangen? Habt ihr irgendwelche erstaunlichen Entdeckungen gemacht? Lasst mich alles wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750103,
						721750105
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750103,
					"content": "Es ist nichts passiert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750104
					]
				},
				{
					"id": 721750104,
					"content": "Es ist unvermeidlich! An Geheimnissen mangelt es auf einer Insel wie dieser nie, und ich bin sicher, ihr werdet etwas finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750107,
					"content": "Was macht Herr Roald eigentlich hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750108,
					"content": "Huch? Ich habe gerade die Lagersachen zusammen gepackt und wollte mich gerade auf den Weg machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750109
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750109,
					"content": "Der Nebel auf dieser Insel ist so bizarr ... Jedes Mal, wenn man kaum ein bisschen hineingeht, verirrt man sich. Und ehe man sich versieht, ist man wieder da, wo man angefangen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750110
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750110,
					"content": "Ich habe den Weg, den Kama mir gezeigt hat, ganz vergessen ... und als ich zurückgehen wollte, um die Eingeborenen dort zu besuchen, fand ich den Weg nicht mehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750111
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750111,
					"content": "Mein Kompass und die Schatten auf dem Boden konnten mir den Weg nicht weisen ... Ich versuchte es sogar mit meinen Schuhen, aber am Ende habe ich nicht mal einen halben Schritt im Nebel geschafft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750112
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750112,
					"content": "Schuhe ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750113,
					"content": "Er meint, er habe seine Schuhe benutzt, um nach dem Weg zu suchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750114
					]
				},
				{
					"id": 721750114,
					"content": "Ääähm ... !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750115,
					"content": "#Haha! Solche Tipps von einem erfahrenen Abenteurer sind wirklich schwer zu verstehen, {NICKNAME}! Die kleine Paimon muss mehr lernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750116
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750116,
					"content": "Paimon muss noch mehr lernen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750117
					]
				},
				{
					"id": 721750117,
					"content": "Das ist doch nur vom Glück abhängig. Was soll man da denn lernen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750118,
					"content": "Wie auch immer. Meine Erkundung ist beendet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750119
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750119,
					"content": "Hätte ich das Seil an einen Baum in der Nähe gebunden und mich am anderen Ende festgehalten, um den Weg zu ertasten, hätte ich es noch ein paar Mal versuchen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750120
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750120,
					"content": "Na warum dann nicht noch einmal versuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750121,
					"content": "Ich habe den Ersatzschuh verloren, der mir sagte, in welche Richtung ich gehen muss ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750122,
						721750124
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750122,
					"content": "Die Ersatzschuhe sind also alle Wegwerfartikel ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750123
					]
				},
				{
					"id": 721750123,
					"content": "He, so war das ursprünglich nicht. Es ist nur so, dass man, wenn man zu viel verliert, immer wieder vergisst, zurückzugehen und es aufzuheben, und das Ergebnis ist, dass alles langsam ... verzehrt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750126,
					"content": "Ah! Oh ja, endlich fällt mir ein, dass ich dich um etwas bitten möchte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750127
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750127,
					"content": "Wah, hast du mich erschreckt. Ich dachte schon, du beißt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750128,
					"content": "Tut mir leid, tut mir leid!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750129
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750129,
					"content": "Wie du weißt, habe ich ein peinliches Problem, und zwar, dass ich immer alles verliere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750130
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750130,
					"content": "Dass ich mit einem schlechten Gedächtnis geboren wurde, hat mir viele Unannehmlichkeiten bereitet, vor allem als Abenteurer, und es ist leicht, deswegen in Gefahr zu geraten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750131
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750131,
					"content": "Eines der Ziele meines Besuchs in Tsurumi war es, „Leuchtpilze“ zu sammeln. Ich habe von Frau Sango gehört, dass dieser Pilz das Gedächtnis verbessern, das Gehirn entlasten und auch die Sehkraft fördern kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750132
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750132,
					"content": "Als ich das letzte Mal mit Kama hier war, war ich so sehr darauf konzentriert, die Eingeborenen zu treffen, dass ich vergessen habe, Pilze zu sammeln ... seufz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750133
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750133,
					"content": "Ich hatte nicht erwartet, dass ich nach meiner Landung auf der Insel auf solche Schwierigkeiten stoßen würde ... schade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750134
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750134,
					"content": "Wenn ihr noch weitere Abenteuer für hier geplant habt, wie wäre es, wenn ihr mir dabei helft die „Leuchtpilze“ zu sammeln bevor ihr zurückkehrt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750135,
						721750137
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750135,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750136
					]
				},
				{
					"id": 721750136,
					"content": "Vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750137,
					"content": "Vergiss nur nicht mich daran zu erinnern, wenn es so weit ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750138
					]
				},
				{
					"id": 721750138,
					"content": "Haha, wird nicht vergessen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750124,
					"content": "Sehr bedauerlich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750125
					]
				},
				{
					"id": 721750125,
					"content": "Das ist richtig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750105,
					"content": "Wir sind noch auf der Erkundung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750106
					]
				},
				{
					"id": 721750106,
					"content": "Ah, haha so ist das also. Dann lasst euch von mir nicht auf eurer Reise aufhalten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "Roald"
				}
			]
		},
		{
			"id": 7217503,
			"completionStepIds": [
				7217510
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217517",
							"3"
						],
						"stepId": 7217517,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217510",
							"2"
						],
						"stepId": 7217510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roald"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750301,
					"content": "Ja ... ich denke, diese sind genug. Danke euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750302
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750302,
					"content": "Übrigens, wenn ihr auf der Insel etwas in der Nähe der „Feststätte“ findet, lasst es mich bitte wissen",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750303
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750303,
					"content": "Ach ja, ihr habt einen „Fotoapparat“ bei euch, das Fontaine-Zeug, oder? Ich werde mir einen kaufen, wenn ich das Geld dafür übrig habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750304
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750304,
					"content": "Lokalen Geschichtsschreibern zufolge sollen die alten Bewohner von Tsurumi die Wände der Höhlen mit unwiederbringlichen Geschichten bemalt haben, die oft mehr als tausend Jahre alt sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750305
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750305,
					"content": "Bei meiner vorherigen Suche schien ich auch einige Schatten im Licht des Festfeuers gesehen zu haben ... Seitdem kann ich es nicht mehr vergessen und ich habe tagelang nicht gut geschlafen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750306
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750306,
					"content": "Diese Wandgemälde hat meines Wissens noch nie jemand gesehen ... Wenn sie bestätigt werden könnten, wäre das ein großer Durchbruch für die Abenteurergilde auf dem Gebiet der Geschichtswissenschaft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750307
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750307,
					"content": "Ich hoffe also, dass ihr das legendäre Wandgemälde finden und möglichst klar und deutlich fotografieren könnt. Ich kaufe eure Fotos für die Zeitschrift und zahle euch ein angemessenes Honorar für eure Bemühungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750308
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750308,
					"content": "Ich frage mich, was ihr beide machen wollt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750309,
						721750311
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750309,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750310
					]
				},
				{
					"id": 721750310,
					"content": "Vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750311,
					"content": "Solange du nicht wieder deine Zeitschrift verlierst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750312
					]
				},
				{
					"id": 721750312,
					"content": "Ich werde mir alle Mühe geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				}
			]
		},
