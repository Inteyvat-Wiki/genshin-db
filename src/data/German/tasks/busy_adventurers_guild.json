			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050101,
					"content": "Entschuldige bitte, dass ich dich wieder habe kommen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050102,
						205050104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050102,
					"content": "Macht doch nichts. Bisher gab es ja immer was Tolles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050103
					]
				},
				{
					"id": 205050103,
					"content": "Das beruhigt mich aber. Ich werde mich kurz halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050106,
					"content": "Wir möchten dir dafür danken, dass du die Missionen der Abenteurergilde ausgeführt und somit ihren Ruf stetig verbessert hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050107,
					"content": "Das hatte aber auch zur Folge, dass immer mehr Leute Missionen in Auftrag geben. Die Abenteurer kommen kaum mehr hinterher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050108,
					"content": "Sollen wir Werbung für die Gilde machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050109,
					"content": "Äh, nein, das nicht, aber trotzdem danke! Natürlich hoffe ich, dass noch andere der Gilde beitreten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050110,
					"content": "Damit lassen sich aber nicht unsere unmittelbaren Probleme lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050111,
					"content": "Ich möchte dich fragen, ob deine Freunde uns vielleicht aushelfen könnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050112,
						205050114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050112,
					"content": "Da muss ich mal mit ihnen reden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050113
					]
				},
				{
					"id": 205050113,
					"content": "Prima, danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050117,
					"content": "Im Klartext heißt das, wir brauchen dringend Leute für unsere <color=#00E1FFFF>„Erkundungen“</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050118,
					"content": "Erkundungen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050119
					]
				},
				{
					"id": 205050119,
					"content": "Wir achten immer darauf, was um die Stadt herum so vor sich geht. Falls wir erfahren, dass irgendwo eine Gefahr lauert oder es an einer Ruine Tumult gibt, geben wir Alarm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050120
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050120,
					"content": "Da es aber keinen wirklichen Auftraggeber gibt, sind diese Missionen nicht zeitlich begrenzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050121
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050121,
					"content": "Warten wir aber zu lange, ohne etwas dagegen zu tun, könnte sich aus einem kleinen Vorfall eine schlimme Katastrophe entwickeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050122,
					"content": "Dann ist das ja echt wichtig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050123,
						205050125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050123,
					"content": "Meine Freunde werden das sicher verstehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050124
					]
				},
				{
					"id": 205050124,
					"content": "Sie müssen nur zustimmen zu helfen. Die Einzelheiten übernehme ich dann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050127,
					"content": "Um dich nicht lange aufzuhalten, werde ich dir zeigen, welche Erkundungsmissionen es im Moment gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050128
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050128,
					"content": "Erkundung bestätigen und entsenden",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205050125,
					"content": "Gibt es dafür auch Belohnungen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050126
					]
				},
				{
					"id": 205050126,
					"content": "Da musst du dir keine Sorgen machen. Alles, was deine Freunde auf diesen Erkundungen finden, gehört euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050114,
					"content": "Ich soll also meine Freunde überreden, der Gilde beizutreten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050115
					]
				},
				{
					"id": 205050115,
					"content": "Nein, nein, nein, so mein ich das nicht! Deine Freunde haben vollkommen verschiedene Hintergründe. Sie beitreten lassen zu wollen, wäre vollkommen absurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050116,
					"content": "Es geht um einen Gefallen für die Gilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050104,
					"content": "Gibt es wieder eine Belohnung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050105
					]
				},
				{
					"id": 205050105,
					"content": "Haha! Du hast es erraten. Ich gehe davon aus, dass du sie haben willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 2050502,
			"completionStepIds": [
				2050502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050502",
							"2"
						],
						"stepId": 2050502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050201,
					"content": "Du kannst deine Gefährten jederzeit zur Erkundung entsenden. Während sie unterwegs sind, können sie weiterhin mit dir auf Abenteuer gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050202,
					"content": "Je nachdem, wie schwierig eine Erkundung ist, dauert die Entsendung unterschiedlich lange. Sobald sie abgeschlossen ist, musst du nur noch einmal kurz hier vorbeischauen und die Ergebnisse bestätigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050203
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050203,
					"content": "Mit höherer Abenteuerstufe kannst du deine Freunde zu noch mehr und gefährlicheren Erkundungen entsenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050204
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050204,
					"content": "Mit mehr Macht hast du auch mehr Verantwortung, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050205,
					"content": "Aber es geht natürlich auch darum, die deine Sicherheit und die deiner Freunde zu gewährleisten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050206
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050206,
					"content": "Noch einmal vielen Dank! Ich hoffe, dass du und deine Freunde möglichst viele Erkundungen machen werdet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		}
	]
}