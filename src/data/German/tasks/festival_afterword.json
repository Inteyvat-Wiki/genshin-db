				"points": []
			},
			"dialogs": [
				{
					"id": 725000101,
					"content": "Schlechte Nachrichten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000102
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000102,
					"content": "Was ist passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000103
					]
				},
				{
					"id": 725000103,
					"content": "Der Boss wurde wieder verhaftet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000104
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000104,
					"content": "Gerade kam jemand von der Tenryou-Verwaltung und heftete an der Pinnwand eine Bekanntmachung an, die besagt, dass unser Fest ausgesetzt werden muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000105
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000105,
					"content": "Ich weiß nicht, was passiert ist. Ich denke, der Boss hat vielleicht einige Flugblätter am Tenshukaku verteilt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000106
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000106,
					"content": "Er sagte, dass der Shougun auf keinen Fall das große und spektakuläre Trommelfest des allmächtigen Arataki verpassen wolle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000107
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000107,
					"content": "Hm? Nun, ich denke, der Boss hat recht. Der Shougun würde sicherlich zu dem Fest kommen wollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000108
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 725000108,
					"content": "Ja, findest du nicht auch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000109
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 725000109,
					"content": "Komm schon, wen interessiert, was wir denken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000110
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000110,
					"content": "Alles in allem, der Boss wurde auf der Stelle von den Okuzumeshuu verhaftet. Sie brachten ihn zu der Tenryou-Verwaltung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000111
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000111,
					"content": "Was werdet ihr tun dann?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000112
					]
				},
				{
					"id": 725000112,
					"content": "Shinobu ist wahrscheinlich schon an dem Fall dran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000113
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000113,
					"content": "Ich habe gehört, dass die Okuzumeshuu den Boss beschuldigt haben, in einem militärischen Sperrgebiet Unruhe gestiftet zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000114
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000114,
					"content": "Dann änderte Frau Kujou Sara den Vorwurf in Störung der öffentlichen Ordnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000115
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000115,
					"content": "Hijaaaa, dieser verdammte Kujou-Tengu! Wie kann sie damit durchkommen, dass sie den Boss wegen so etwas eine Straftat vorwirft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000116
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 725000116,
					"content": "Ah, du Spatzenhirn! Das ist nur eine Ordnungswidrigkeit, sie hat das Vergehen heruntergestuft. Normalerweise bekommt man dafür nur eine Verwarnung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000117
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000117,
					"content": "Wie auch immer, ich denke, was das Fest angeht, müssen wir warten, bis der Boss herauskommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000118
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000118,
					"content": "#Mach dir keine Sorgen, {F#Reisende}{M#Reisender}. Mit Shinobu an der Seite wird sich alles zum Guten wenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000119
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000119,
					"content": "Du hast unser Fest so sehr unterstützt. Wenn der Boss rauskommt, wird er sich sicher persönlich bei dir bedanken wollen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000120
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000120,
					"content": "Ich hoffe, dass deine Reise, genauso wie unser Fest, immer besser und besser wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000121
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000121,
					"content": "Immer besser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mamoru"
				}
			]
		}
	]
}