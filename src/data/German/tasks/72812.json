			"dialogs": [
				{
					"id": 728120201,
					"content": "Die Geschichte ist zu Ende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120202
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120202,
					"content": "Ich war noch nie so müde, ist diese Geschichte wirklich so kompliziert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120203
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120203,
					"content": "Das passiert, wenn man die Szenerie nicht vorher plant. Ohne einen festen Erzählrahmen stürzen alle Elemente der Geschichte einfach durcheinander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120204
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 728120204,
					"content": "In diesem Fall hast du überhaupt keine Kontrolle über die Geschichte und du wirst vom Schreiben erschöpft sein, egal wie die Handlung aussieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120205
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 728120205,
					"content": "#Leider habe ich nicht die Kraft, dir zu widersprechen ... {F#Reisende}{M#Reisender}, danke, dass du dieses ... Urteile gefällt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120206
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120206,
					"content": "Diese Urteile haben mir sehr geholfen ... sehr geholfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120207
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120207,
					"content": "Bitte nimm diese Geschenke an und ich werde mich später wieder an meinen Roman machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120208
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120208,
					"content": "Die Szenerie oder die Handlung, nun ... was ist wichtiger ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		}
