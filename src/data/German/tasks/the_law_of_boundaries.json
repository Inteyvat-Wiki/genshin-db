			"dialogs": [
				{
					"id": 100090101,
					"content": "Hmm ... Nach den bisherigen Ergebnissen sollte ich ein paar Anpassungen am Experiment vornehmen und sicherstellen, dass die Materialien und die Ausrüstung alle in Ordnung sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090102
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090102,
					"content": "#Was den Trank angeht, den ich herstellen muss ... Oh, {NICKNAME}, Paimon! Was führt euch her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090103
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090103,
					"content": "Hehe, wir sind hier, um dir bei deiner „Aufgabe“ zu helfen. Wir wollten sehen, ob du ein paar zusätzliche Hände gebrauchen könntest ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090104,
					"content": "Meine „Aufgabe“ ... Oh, du meinst die von Herrn Albedo? Die vom Hexenzirkel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090105
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090105,
					"content": "Also, du kommst genau richtig. Das Experiment läuft gerade, und ich wollte mich auch gleich damit beschäftigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090106
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090106,
					"content": "Läuft gerade? Also hast du die ganze Zeit daran gearbeitet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090107,
					"content": "Ja. Es passt zu anderen Forschungsthemen, an denen ich arbeite, deshalb war es nicht zu viel zusätzliche Arbeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090108
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090108,
					"content": "Trotzdem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090109
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090109,
					"content": "Was? Gibt es ein Problem mit dem Experiment?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090110,
					"content": "Ich war bisher „erfolglos“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090111
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090111,
					"content": "Ach, es klappt also immer noch nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090112,
					"content": "Es geht hier nicht nur darum, dass es „nicht klappt“. Der theoretische Rahmen hinter dieser Aufgabe ist etwas komplizierter, als ich mir vorgestellt habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090113
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090113,
					"content": "Also, was ist das genau für eine Aufgabe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090114
					]
				},
				{
					"id": 100090114,
					"content": "Ach richtig! Du hast uns noch gar nicht erzählt, was für ein Experiment das ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090115,
					"content": "Ein Experiment, bei dem ein Trank entwickelt werden soll, der Zuckerblumen in eine Variante verwandelt, die das 16-fache ihrer normalen Größe erreicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090116
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090116,
					"content": "Das heißt, die Formel des „Botanischen Verstärkungsreagenz Typ IV, Version VII“ – wie du dir sicher schon denken kannst, ist dies mein siebter Versuch des Experiments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090117
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090117,
					"content": "Wah! Also müssen wir ein Wachstumsserum herstellen! Oder besser gesagt, die siebte Version von einem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090118,
					"content": "J... Ja, so ungefähr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090119
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090119,
					"content": "Das ist mein siebter Versuch, aber ich habe die Formel diesmal kaum verändert, denn sowohl die theoretischen Grundlagen dieses Experiments als auch die Prozessergebnisse beweisen, dass damit alles stimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090120
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090120,
					"content": "Aber das Ganze war noch nicht von „Erfolg“ gekrönt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090121,
					"content": "Ja. Ich denke, dass nicht unbedingt meine aktuelle Formel falsch ist, sondern ... dass ein anderes wichtiges Element fehlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090122
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090122,
					"content": "Oooh ... Hehe, dann weiß Paimon genau, was zu tun ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090123,
						100090125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090123,
					"content": "Lass uns helfen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090124
					]
				},
				{
					"id": 100090124,
					"content": "Genau! Dafür sind wir doch hergekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090127,
					"content": "Ähm, wir könnten es versuchen, es ist nur ... ich müsste die Mengenverhältnisse in der ursprünglichen Formel anpassen, und das könnte den Trank noch instabiler machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090128
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090128,
					"content": "Nein, das werden wir NICHT ausprobieren! Zeig uns einfach das Original!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090129,
					"content": "Hier ist es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090130
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090130,
					"content": "Allerdings fehlen mir noch zwei Zutaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090131
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090131,
					"content": "Hehe, da können wir helfen. Was müssen wir besorgen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090132,
					"content": "Ich brauche Quellwasser aus Quellingen als Grundlage und auch Fragmente vom Auge des Sturms ... Aber Letzteres könnte schwierig werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090133
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090133,
					"content": "Wir schaffen das! Auf geht’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090125,
					"content": "Vielleicht könnten wir ein bisschen Paimon-Essenz hinzufügen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090126
					]
				},
				{
					"id": 100090126,
					"content": "Hehe, deshalb helfen wir ja au... Moment mal, Paimon ist KEINE Zutat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090127
					],
					"speakerTitle": "Paimon"
				}
			]
		},
