			},
			"dialogs": [
				{
					"id": 100091101,
					"content": "Puh, geschafft. Auch wenn sie so groß ist, eine Vaniloqua bleibt eine Vaniloqua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091102,
					"content": "... Ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091103
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100091103,
					"content": "Aber, äh ... sollte sie denn so groß werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091104,
					"content": "Ich konnte während des Kampfes nur eine grobe Schätzung anstellen, aber sie schien mindestens ... 16-mal so groß wie ursprünglich zu sein, vielleicht sogar noch größer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091105
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100091105,
					"content": "Das heißt, dass das Experiment ... funktioniert hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091106
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100091106,
					"content": "Moment mal, ist das denn nicht etwas Gutes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091107,
					"content": "Ich bin mir noch nicht sicher, was das bedeutet ... Aber wenn weitere Versuche das gleiche Ergebnis zeigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091108
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100091108,
					"content": "Das bedeutet, dass etwas anders ist ... Vielleicht verändern sich die Grenzen und Gesetze dieser Welt aufgrund eines unbekannten Faktors ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091109
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100091109,
					"content": "Ich kann nicht sagen, ob das gut oder schlecht ist, aber zumindest aus alchemistischer Sicht bedeuten erweiterte Grenzen, dass uns nun mehr Möglichkeiten offenstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091110
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100091110,
					"content": "Wie dem auch sei, meine Aufgabe ist damit beendet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091111
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100091111,
					"content": "Sieht wohl so aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091112,
					"content": "Hmm. Allerdings könnte es auch an der Person liegen, die den Trank hergestellt hat. Vielleicht war auch etwas Besonderes an dieser speziellen Vaniloqua ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091113
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100091113,
					"content": "Es gibt noch viel zu bestätigen. Ich schätze, diese Aufgabe wirft nur weitere Fragen auf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091114
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100091114,
					"content": "Also, wir sind da, falls du mal Hilfe brauchst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091115,
					"content": "Könnten wir dieses Wachstumsserum mal an Paimon ausprobieren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100091116
					]
				},
				{
					"id": 100091116,
					"content": "Hehe, stell dir das mal vor ... Paimon könnte bestimmt eine ganze Bande von Schatzräubern zu Brei schlagen, wenn Paimon 16-mal größer wäre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091117,
					"content": "Da bin ich mir nicht sicher. Das Serum hat nur bei der Vaniloqua funktioniert, weil ihre innere Struktur der einer Zuckerblume ähnlich genug war ... Wenn du davon trinkst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091118
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100091118,
					"content": "... Wirst du zwar möglicherweise 16-mal größer, aber du könntest dich auch in ein Gemüse verwandeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091119
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100091119,
					"content": "Ah, auf keinen Fall. Das darf nicht passieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091120,
					"content": "Ach übrigens, Paimon wollte fragen ... Warum konzentriert sich deine ganze Forschung auf Sachen wie Zuckerblumen und Dämmerfrüchte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091121,
					"content": "Oh, das ist ganz einfach. Sowohl Dämmerfrüchte als auch Zuckerblumen schmecken süß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091122
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100091122,
					"content": "Also in diesem Sinne hat es auch einen versteckten Vorteil, wenn man aus Versehen eine Vaniloqua 16-mal größer macht, denn der Nektar der Vaniloqua ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091123
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100091123,
					"content": "... schmeckt genau wie Zuckerblumen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091124,
					"content": "Genau! Sobald ich den Zucker aus dem Nektar extrahiert habe, gebe ich dir etwas davon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091125
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100091125,
					"content": "Hehe, abgemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}