					}
				]
			},
			"dialogs": [
				{
					"id": 100090801,
					"content": "Das war’s ... Deine Ausführung war perfekt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090802
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090802,
					"content": "Wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090803,
					"content": "Ja, ich sehe überhaupt keine Fehler beim Brauen ... Lass mich etwas entnehmen und die Zusammensetzung des Produkts testen. Einen Moment ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090804
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090804,
					"content": "Saccharose entnimmt etwas von dem Trank und untersucht dessen Zusammensetzung mit einem Gerät ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						100090805
					]
				},
				{
					"id": 100090805,
					"content": "Ja, die Ausführung war perfekt, und der fertige Trank ist es auch. Es ist genau das, was ich erwartet habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090806
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090806,
					"content": "Also, hat es beim siebten Mal endlich geklappt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090807,
					"content": "Nach der Untersuchung scheint es identisch mit den vorherigen sechs Versionen zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090808
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090808,
					"content": "Oh ... Würde das nicht bedeuten, dass die Ergebnisse identisch sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090809,
					"content": "Nicht unbedingt. Experimentelle Ergebnisse können sich unterscheiden, auch wenn die Variablen ähnlich sind. Man weiß nie, was dabei herauskommt — genau das macht Experimente ja erst wertvoll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090810
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090810,
					"content": "Komm, lass uns das Ding testen. Ich habe vorher ein paar Zuckerblumen gepflanzt, die wir benutzen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090811
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090811,
					"content": "Wir müssen sie nur mit dem Trank übergießen und sehen, was passiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Saccharose"
				}
			]
		},
		{
			"id": 1000909,
			"completionStepIds": [
				1000909
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1000909",
							"2"
						],
						"stepId": 1000909,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Saccharose"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1087.496,
