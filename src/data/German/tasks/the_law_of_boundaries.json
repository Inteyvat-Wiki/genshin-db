					},
					{
						"sceneId": 3,
						"position": [
							1087.191,
							285.861,
							-441.896
						],
						"pointId": 14228
					},
					{
						"sceneId": 3,
						"position": [
							1087.249,
							285.861,
							-440.176
						],
						"pointId": 14229
					}
				]
			},
			"dialogs": [
				{
					"id": 100090901,
					"content": "Also gut, wir haben das Wachstumsserum auf die Blumen gegossen ... War das schon alles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090902,
					"content": "Ja. Die Blumen müssen den Trank erst vollständig aufnehmen. Deshalb könnte es etwas dauern, bis wir eine Reaktion sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090903
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090903,
					"content": "Und dann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090904,
					"content": "Die Blumen werden in ihrer Größe wachsen und dabei ihr ursprüngliches Aussehen behalten. Aber wenn sie dann das 12- bis 14-fache ihrer normalen Größe erreichen, wird es mehr sein, als sie ertragen können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090905
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090905,
					"content": "Als ob eine Obergrenze erreicht wäre, verwelken und verfaulen sie, nehmen unnatürliche Formen an, bis von ihnen nur noch Flüssigkeit übrig bleibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090906
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090906,
					"content": "Moment mal, was? Also stimmt etwas nicht mit dem Wachstumsserum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090907,
					"content": "Nein. Ich habe die Formel immer wieder angepasst und dabei alle möglichen Probleme gelöst, die beim Wachstum kleiner Pflanzen auftreten können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090908
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090908,
					"content": "Probleme wie ... dass die Blätter nicht zu groß werden, die Verstärkung des Wurzeldurchmessers und der Tragfähigkeit, die Berechnung, wie sich die Zunahme der Oberfläche auf die Sonneneinstrahlung und Ernährung auswirken könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090909
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090909,
					"content": "Warum funktioniert es dann also nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090910,
					"content": "Weil die Blumen sich nicht übertreffen können ... „Wie oben, so auch unten“ ist eines der wichtigsten Prinzipien der Alchemie. Die Alchemie strebt nach der Beherrschung der Materie, aber diese Welt hat ihre Grenzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090911
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090911,
					"content": "Es ist wie ... eine „Spezifikation“, die in das Gesetz eingraviert ist, das alles regiert. Ein Teil des Zwecks der vielen Experimente ist es, herauszufinden, ob diese „Spezifikation“ stabil ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090912
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090912,
					"content": "Also ist „Scheitern“ auch ein mögliches Ergebnis ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090913
					]
				},
				{
					"id": 100090913,
					"content": "Genau. Das beweist, dass die Grenze „weiterhin existiert“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090914
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090914,
					"content": "Okay, das ist alles ein bisschen zu hoch für Paimon, aber ... Du brauchtest also ein gescheitertes Experiment, um zu beweisen, dass die Grenzen in dieser Welt stabil sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090915,
					"content": "Was für ein seltsames Experiment ... Hm? Eine der Blumen scheint zu reagieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090916,
					"content": "Warte mal ... Das ist ja gar keine Zuckerblume!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090917,
					"content": "Vorsicht! D... Das ist eine Vaniloqua! Sie muss etwas von dem Trank aufgesogen haben. Moment mal. Aber das ist schon mal passiert und sie ist noch nie so groß geworden. Könnte das bedeuten ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090918
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090918,
					"content": "Darüber können wir später reden. Erledigen wir sie zuerst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
