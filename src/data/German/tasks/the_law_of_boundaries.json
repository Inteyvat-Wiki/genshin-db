			},
			"dialogs": [
				{
					"id": 100090601,
					"content": "Also gut, die Materialien sind bereit und der Alchimiekessel ist gleich da drüben, also können wir loslegen. Aber, ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090602
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090602,
					"content": "Stimmt etwas nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090603,
					"content": "Nein, nein. Es ist nur ... Stört es dich, wenn ich von der Seite aus zuschaue? Ich meine nur, um alles genau aufzeichnen zu können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090604
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090604,
					"content": "Ich weiß, dass viele Leute es nicht mögen, wenn man ihnen bei Experimenten über die Schulter schaut, also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090605
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090605,
					"content": "Absolut kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090606
					]
				},
				{
					"id": 100090606,
					"content": "Danke. Ich bin bereit, wenn du es bist. Ich werde mir auch genaue Notizen machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090607
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 100090607,
					"content": "Also, bist du bereit, mit dem Experiment zu beginnen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Saccharose"
				}
			]
		},
		{
			"id": 1000907,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
