			"dialogs": [
				{
					"id": 756710101,
					"content": "Zwitschi, gurr gurr, zwitschi-zwitschi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710102
					],
					"speakerTitle": "Basima die Fünfte"
				},
				{
					"id": 756710102,
					"content": "Was ... soll das denn sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710103,
						756710104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710103,
					"content": "Eine ... Geheimsprache?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				},
				{
					"id": 756710105,
					"content": "Ja! Das ist ein Trick, um mit niedlichen Finken zu kommunizieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710106
					],
					"speakerTitle": "Basima die Fünfte"
				},
				{
					"id": 756710106,
					"content": "Oh, da habe ich wohl ganz vergessen, euch zu begrüßen und diesen einen unverzichtbaren Satz loszuwerden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710107
					],
					"speakerTitle": "Basima die Fünfte"
				},
				{
					"id": 756710107,
					"content": "Ihr beiden freundlichen Passanten: die Gelehrte der Lebenskunde, aufgehender Stern unter den Händlern und Expertin für niedliche Tiere, Basima die Fünfte grüßt euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710108
					],
					"speakerTitle": "Basima die Fünfte"
				},
				{
					"id": 756710108,
					"content": "Bitte entspannt euren Körper, leert euren Geist und hört mir zu, während ich euch eine wichtige Sache sage ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710109
					],
					"speakerTitle": "Basima die Fünfte"
				},
				{
					"id": 756710109,
					"content": "Der Fink ist der niedlichste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710110,
					"content": "Völlig richtig! Herzlichen Glückwunsch, du wurdest von der Niedlichkeit des Finken angesteckt und hast die Antwort blitzschnell als Erste genannt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710111
					],
					"speakerTitle": "Basima die Fünfte"
				},
				{
					"id": 756710111,
					"content": "Seltsam, Paimon weiß nicht warum, aber als Paimon das Spiel auf dem Tisch gesehen hat, ist Paimon dieser Satz einfach so eingefallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710112,
					"content": "#Kannst du dich daran erinnern, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710113,
						756710115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710113,
					"content": "Wir haben diese Dame schon mal getroffen, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710114
					]
				},
				{
					"id": 756710114,
					"content": "Genau! Und es war nicht nur eine flüchtige Begegnung. Es wärmt mein Herz zu sehen, dass ihr immer noch so voller Energie seid!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "Basima die Fünfte"
				},
				{
					"id": 756710117,
					"content": "Wie auch immer, wollt ihr das Spiel hier bei mir ausprobieren? Die siebzehnte Version, also die dritte Generation von „Bing-Bang-Zwitscherball“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710118
					],
					"speakerTitle": "Basima die Fünfte"
				},
				{
					"id": 756710118,
					"content": "Beim entspannten und gemütlichen Spielen könnt ihr auch die Geschichte des großen uralten Rotfeder-Finken und seinen triumphalen Sieg über die Raubmöwen kennenlernen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710119
					],
					"speakerTitle": "Basima die Fünfte"
				},
				{
					"id": 756710119,
					"content": "Ja, gut, entspannte und lockere Spiele haben wir schon immer gemocht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710120,
						756710121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710120,
					"content": "Spielen wir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710122,
					"content": "Toll! Ich hoffe, ihr könnt die Art zu spielen finden, die am besten zu euch passt, und habt ein unvergessliches Erlebnis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Basima die Fünfte"
				},
				{
					"id": 756710121,
					"content": "Los geht’s!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710115,
					"content": "Es ist nie zu spät, zu erkennen, dass der Fink der niedlichste ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710116
					]
				},
				{
					"id": 756710116,
					"content": "Genau! Auch wenn du dich vorläufig nicht an frühere Dinge erinnerst, ist das nicht schlimm. Wichtig ist, die Gegenwart zu genießen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "Basima die Fünfte"
				},
				{
					"id": 756710104,
					"content": "Ein ... Ein Geheimsignal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				}
			]
		}
	]
}