			"dialogs": [
				{
					"id": 750100201,
					"content": "Oh, da ist etwas Flauschiges. Irgendetwas Flauschiges blockiert deinen Weg ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750100202
					]
				},
				{
					"id": 750100202,
					"content": "Hm ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100203
					],
					"speakerTitle": "Lebhaftes Alpacktier"
				},
				{
					"id": 750100203,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100204
					],
					"speakerTitle": "„Halbgares Ei“"
				},
				{
					"id": 750100204,
					"content": "Mhm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100205
					],
					"speakerTitle": "Lebhaftes Alpacktier"
				},
				{
					"id": 750100205,
					"content": "Ah? Ihr seid also Freunde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100206,
					"content": "*brüll*! *brüll* *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100207
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100207,
					"content": "Sieht so aus, als käme jemand, die die Alpacktiere hütet, um den Yumkasaurier zu beruhigen ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750100208
					]
				},
				{
					"id": 750100208,
					"content": "Halbgares Ei, jetzt beruhige dich mal. Genau weil du immer so vorschnell urteilst, bist du ein halbgares Ei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100209
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100209,
					"content": "*brüll*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100210
					],
					"speakerTitle": "„Halbgares Ei“"
				},
				{
					"id": 750100210,
					"content": "Sorry, er ist eben sehr pflichtbewusst und wird nervös, wenn Fremde sich nähern. Aber weil er sich so ausdauernd um die Alpacktiere kümmert, kann ich ein entspanntes Leben führen, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100211
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100211,
					"content": "Also, welche Angelegenheit führt euch hierher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100212,
						750100214
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100212,
					"content": "Wir halten bloß nach Abenteuern Ausschau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100213,
					"content": "Ach, ihr seid also Abenteurer. Vielleicht hält Halbgares Ei euch für gefährliche Gegner, von denen eine Aura der Bedrohung ausgeht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100216
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100216,
					"content": "Wer hätte gedacht, dass Yumkasaurier Alpacktiere hüten können. Als ich sie von Weitem sah, dachte ich, sie würden die Alpacktiere angreifen, aber das war ein Missverständnis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100217,
					"content": "Haha, das passiert öfter. Er sieht vielleicht grimmig aus, aber er versteht sich prima mit den Alpacktieren, man könnte sogar sagen, sie sind Freunde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100218
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100218,
					"content": "*brüll* ... *brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100219
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100219,
					"content": "Na, kleines Kerlchen, willst du auch mit ihnen Freundschaft schließen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100220
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100220,
					"content": "*brüll*! *brüüüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100221
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100221,
					"content": "#Waah, du bist ja ganz aufgeregt. Du willst wohl wirklich Freundschaft schließen. Na ja, du bist sonst nur mit {NICKNAME} und Paimon zusammen, da wäre ein tierischer Freund bestimmt schön ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100222,
					"content": "Das wäre bestimmt ein niedlicher Anblick, ein kleiner, frecher Tepetlisaurier, umringt von Alpacktieren. Allein der Gedanke macht mich hungrig auf drei Schüsseln geschmorten Fleischeintopf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100223
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100223,
					"content": "Ah, aber das hängt natürlich davon ab, ob die Alpacktiere das auch wollen. Freundschaft kann man nicht erzwingen, stimmt’s, Halbgares Ei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100224
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100224,
					"content": "Hmpf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100225,
						750100228
					],
					"speakerTitle": "„Halbgares Ei“"
				},
				{
					"id": 750100225,
					"content": "#Wer könnte denn meinen {REALNAME[ID(2)|SHOWHOST(true)]} nicht mögen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750100226
					]
				},
				{
					"id": 750100226,
					"content": "#Hör auf, dich wie ein Vormund für Monster zu benehmen! Gib {REALNAME[ID(2)|SHOWHOST(true)]} eine Chance, es selbst zu versuchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100227,
					"content": "Kinder müssen schließlich ihre eigenen Erfahrungen machen, um zu wachsen, stimmt’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100231,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100232
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100232,
					"content": "Er wirkt ganz zuversichtlich, da muss ich mir wohl keine Sorgen machen. Ich gehe jetzt zurück und ruhe mich aus. Falls es Probleme gibt, kommt einfach zu mir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100233
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100233,
					"content": "Aber anstatt mich zu fragen, wendet euch lieber an Halbgares Ei. Er kennt die Alpacktiere am besten. War nur ein Witz. Viel Erfolg beim Freunde finden, kleines Kerlchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100228,
					"content": "Keine Sorge, wenn es nicht klappt, sind wir ja immer noch da.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750100229
					]
				},
				{
					"id": 750100229,
					"content": "#Natürlich, du willst, dass {REALNAME[ID(2)|SHOWHOST(true)]} sich nicht schlecht fühlt, falls es nicht klappt ... Aber sei doch nicht von Anfang an so pessimistisch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100230,
					"content": "#Kinder brauchen Ermutigung, um gesund aufzuwachsen. Also lobe es viel! {REALNAME[ID(2)|SHOWHOST(true)]} schafft das bestimmt! Los, gib dein Bestes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100214,
					"content": "Wir möchten das idyllische Landleben genießen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750100215
					]
				},
				{
					"id": 750100215,
					"content": "Dann bist du hier genau richtig. Lass die Saurier die Arbeit machen, so wie ich, und genieße dein Leben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100216
					],
					"speakerTitle": "Wactana"
				}
			]
		},
		{
			"id": 7501003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
