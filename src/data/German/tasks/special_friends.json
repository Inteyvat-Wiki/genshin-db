			"dialogs": [
				{
					"id": 750100101,
					"content": "Ich habe weder große Ambitionen noch dringliche Wünsche, ich bin eine zufriedene Hirtin, die sich nur um ihre Alpacktiere, die schöne Natur und die einfachen Dinge des Lebens kümmert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100102
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100102,
					"content": "Das ist mein Lieblingslied, wie gefällt es dir? Gar nicht übel, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wactana"
				}
			]
		},
