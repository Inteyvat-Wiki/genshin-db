						750101610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101608,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}’s Freunde sind auch meine Freunde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750101609
					]
				},
				{
					"id": 750101609,
					"content": "Und auch Paimons Freunde! Nein, warte. Mit wem konkurrierst du da eigentlich!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101612,
					"content": "Allein ist es hier schon ziemlich gefährlich, oder? Lass uns lieber Wactana Bescheid sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101613,
					"content": "#Wenn sie hört, dass {REALNAME[ID(2)|SHOWHOST(true)]} Freundschaft mit einem Alpacktier geschlossen hat, freut sie sich bestimmt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101610,
					"content": "Irgendwie beneidenswert ...",
