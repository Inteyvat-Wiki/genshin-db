					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750101605,
					"content": "#Beim Anblick des begeisterten {REALNAME[ID(2)|SHOWHOST(true)]} zeigt das scheue Alpacktier gar keine Angst, sondern stupst ihn sogar sanft mit der Nase an ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
