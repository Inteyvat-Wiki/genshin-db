			"dialogs": [
				{
					"id": 750101201,
					"content": "Da bist du ja wieder, kleines Kerlchen. Na, hast du Freunde unter den Alpacktieren gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101202
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101202,
					"content": "*brüll*! *brüll* *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750101203,
					"content": "Mhm, wenn du so fröhlich bist, freue ich mich gleich mit. Sehr schön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101204
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101204,
					"content": "#Wactana sollte sich mehr um die Alpacktiere kümmern. Das Alpacktier, das mit {REALNAME[ID(2)|SHOWHOST(true)]} befreundet ist, war vorhin an einem gefährlichen Ort!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101205,
					"content": "Oje, wirklich? Ich muss Halbgarem Ei sagen, dass er künftig besser aufpassen soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101206,
						750101208
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101206,
					"content": "Du siehst das echt etwas zu entspannt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750101207
					]
				},
				{
					"id": 750101207,
					"content": "So ist es! Ich lebe bereits meinen Traum, also gratulier mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101211
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101211,
					"content": "#Übrigens, das Alpacktier-Spielzeug da drüben könnt ihr mitnehmen, wenn {REALNAME[ID(2)|SHOWHOST(true)]} es mag.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101212
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101212,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750101213,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} ist wohl echt nicht schüchtern, was? Danke, Wactana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101214,
					"content": "Kein Problem, ihr seid jederzeit willkommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101208,
					"content": "Halbgares Ei hat es echt nicht leicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750101209
					]
				},
				{
					"id": 750101209,
					"content": "Ja, es ist zwar hart... Aber er kümmert sich von Natur aus gern. Wenn du ihm die Alpacktiere wegnimmst, wird er nur nervös und verliert sein Fell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101210
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101210,
					"content": "Also ist es so am besten. Er ist glücklich, wenn er seine Arbeit macht, und ich genieße das Leben. Schon ziemlich gut, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101211
					],
					"speakerTitle": "Wactana"
				}
			]
