			"dialogs": [
				{
					"id": 210340401,
					"content": "Wie geht’s? Hast du schon alle Monster beseitigt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340402
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340402,
					"content": "Hast du die Monster hier ... schon alle besiegt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340403
					]
				},
				{
					"id": 210340403,
					"content": "Ja, natürlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340404
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340404,
					"content": "Ich bin immerhin die Leiterin der Abenteurergilde von Liyue. So eine kleine Gruppe Monster macht mir keine Mühe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 2103405,
