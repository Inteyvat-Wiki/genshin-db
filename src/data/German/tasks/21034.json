					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210340501,
					"content": "#{F#Reisende}{M#Reisender}, hast du die Monster in dem Lager bereits beseitigt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340502,
						210340503
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340502,
					"content": "Alles erledigt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340504
					]
				},
				{
					"id": 210340504,
					"content": "Das sind nur ein paar ganz normale Monster, da braucht es nicht viel Kraft. Und ich hatte auch sehr viel Glück und konnte ein sehr wertvolles Schwertbruchstück finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340505
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340505,
					"content": "Ich habe nichts gefunden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340506
					]
				},
				{
					"id": 210340506,
					"content": "Mach dir nichts draus. Du hast mir geholfen, einen falschen Ort auszuschließen, also vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340507
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340507,
					"content": "Diese Belohnung ist für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340508,
						210340509
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340508,
					"content": "Wenn du alle Bruchstücke finden würdest ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340510
					]
				},
				{
					"id": 210340510,
					"content": "Was ich möchte, ist sehr einfach ... Die „Versteckte Klinge“ neu zu schmieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340511
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340511,
					"content": "Auch wenn die ursprünglichen Pläne für die Anfertigung der „Versteckten Klinge“ verloren gegangen sind und ich nicht weiß, welches Material verwendet wurde ... will ich doch einen Weg finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340512
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340512,
					"content": "Wenn ich die „Versteckte Klinge“ wirklich neu schmieden könnte, dann würde mein Bruder auch ... *seufz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340509,
					"content": "Was würdest du mit ihnen machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340510
					]
				},
				{
					"id": 210340503,
					"content": "Wie sieht es bei dir aus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340504
					]
				}
			]
		},
