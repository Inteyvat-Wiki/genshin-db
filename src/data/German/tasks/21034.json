			"dialogs": [
				{
					"id": 210340101,
					"content": "Hmpf, hier sollte er sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340102,
						210340103
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340102,
					"content": "Lan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340104
					]
				},
				{
					"id": 210340104,
					"content": "#{F#Reisende}{M#Reisender}? Ich hätte nicht erwartet, dich hier zu sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340105,
					"content": "Erinnerst du dich noch, wie ihr mir beim letzten Mal geholfen habt, den Schwertgriff zu finden? Tatsächlich war das ein Teil der „Versteckten Klinge“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340106,
					"content": "Das interessante dabei ist, dass ich sie nur identifizieren konnte, weil ich in meiner Kindheit heimlich eine Markierung darauf hinterlassen habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340107
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340107,
					"content": "Damals habe ich meinem Bruder gesagt, dass er, falls er später zu einem anderen Schwert wechseln sollte, mir die „Versteckte Klinge“ geben sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340108,
					"content": "Ha, damals hätten wir uns das nicht ausmalen können ... Auf diese Weise bin ich tatsächlich in Besitz der „Versteckten Klinge“ gekommen. Sieht aus, als sei dieses Schwert ... Tatsächlich zerbrochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340109
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340109,
					"content": "Na gut, genug damit. Da ich dich hier treffe, möchte ich dich noch einmal um einen Gefallen bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340110
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340110,
					"content": "Da vorn befinden sich zwei Orte, an denen sich Monster versammeln. Aus einem unbekannten Grund scheinen sie in ihren Lagern einen großen Vorrat an beschädigten Waffen anzuhäufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340111
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340111,
					"content": "Die Gilde ist besorgt, dass sie hier Unordnung stiften könnten und wollte deshalb eigentlich eine Mission beauftragen, aber als ich es mir angesehen habe, habe ich entschlossen, mich selbst darum zu kümmern ... Vielleicht finde ich dabei auch die Bruchstücke der „Versteckten Klinge“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340112,
					"content": "#{F#Reisende}{M#Reisender}, lass uns beide je ein Lager aufräumen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340113
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340113,
					"content": "Im linken Lager ist eine Gruppe von Hilichurlen, auch wenn einzelne Hilichurle für dich kein Problem darstellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340114,
					"content": "Aber da sind sehr viele, wenn sie dich einkreisen, wird es bestimmt auch für dich schwer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340115,
					"content": "Auf der rechten Seite gibt es einen „Steinhaut-Lawachurl“, wie gefährlich er ist ... Nun, dir muss ich das nicht erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340116
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340116,
					"content": "Da es meine Bitte ist, lasse ich dir die Wahl des Lagers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340103,
					"content": "Was machst du denn hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340104
					]
				}
			]
		},
