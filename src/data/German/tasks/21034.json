					"nextDialogs": [
						210340604
					]
				},
				{
					"id": 210340604,
					"content": "Das sind nur ein paar ganz normale Monster, da braucht es nicht viel Kraft. Aber leider habe ich nichts außer ein paar verrosten Schwertern gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340605
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340605,
					"content": "Und bei dir? Hast du etwas entdeckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340606
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340606,
					"content": "Ich habe das hier gefunden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340607
					]
				},
				{
					"id": 210340607,
					"content": "Hm ... Das ist tatsächlich ein Bruchstück des Schwertes ... Vielen Dank, ich werde es mir genau anschauen, wenn ich zurück bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340608
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340608,
					"content": "Also, danke schön. Das ist deine Belohnung. Bitte nimm sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340609,
						210340610
					],
					"speakerTitle": "Lan"
				},
