					"nextDialogs": [
						210340804
					]
				},
				{
					"id": 210340804,
					"content": "Oh? Was für ein Zufall, wir sehen uns schon wieder hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340805
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340805,
					"content": "Ganz recht, ich habe von der Gilde ein paar ... hehe ... „passende“ Aufträge bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340806
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340806,
					"content": "Die Situation ist noch genauso wie beim letzten Mal und ich möchte dich bitten, die Monster dieses Mal mit mir gemeinsam zu beseitigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340807
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340807,
					"content": "Im linken Lager ist eine Gruppe von Hilichurlen, auch wenn einzelne Hilichurle für dich kein Problem darstellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340808
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340808,
					"content": "Aber da sind sehr viele, wenn sie dich einkreisen, wird es bestimmt auch für dich schwer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340809
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340809,
					"content": "Auf der rechten Seite gibt es einen „Steinhaut-Lawachurl“, wie gefährlich er ist ... Nun, dir muss ich das nicht erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340810
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340810,
					"content": "Da es meine Bitte ist, lasse ich dir die Wahl des Lagers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
