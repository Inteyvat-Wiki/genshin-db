			},
			"dialogs": [
				{
					"id": 710190301,
					"content": "(Ein Becken, das wie ein Steingarten aussieht und als Dekoration dient. Eine eigentümliche Markierung schmückt seine Spitze.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190302
					],
					"speakerTitle": "Beobachten"
				},
				{
					"id": 710190302,
					"content": "(Halte bei deinen Reisen in Liyue Ausschau nach einem ähnlich aussehenden Berg, und schau dir die Spitze eines solchen Berges genau an. Und vielleicht findest du etwas Unerwartetes ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beobachten"
				}
			]
