			},
			"dialogs": [
				{
					"id": 710190201,
					"content": "In diesem Becken liegt ein großer Stein. Paimon meint, dies sei ein „Steingarten“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190202,
					"content": "Aber werden sie nicht gewöhnlich in Gärten oder Innenhöfen aufgestellt? Welchen Sinn hat es, einen hier draußen zu platzieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190203,
					"content": "Hm. Oben auf diesem Steingarten befindet sich etwas Seltsames. Es sieht aus wie eine Art Zeichen ... Paimon scheint sehr besorgt zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190204,
					"content": "Na ja, da wir auf einer Reise sind ... halten wir einfach Ausschau nach Bergen, die wie dieser Steingarten aussehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190205,
					"content": "Es wäre gut, wenn wir etwas finden würden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
