			"dialogs": [
				{
					"id": 200210101,
					"content": "Warum braucht man einen Flugschein, um den Windgleiter zu benutzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210102,
					"content": "Hast du einen Flugschein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210103
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210103,
					"content": "Ich benutze keine Windgleiter, ich habe die Prüfung nie gemacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200210104,
					"content": "Willst du die Prüfung ablegen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210105
					]
				},
				{
					"id": 200210105,
					"content": "Da Windgleiter für das Abenteuer unentbehrlich sind, dachte ich mir, dass ich ihren Einsatz üben sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210106,
					"content": "Aber ich dachte nicht, dass es so etwas wie einen Flugschein gibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210107,
					"content": "Obwohl ich mich für die Prüfung angemeldet habe, weiß ich einige Punkte noch nicht auswendig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210108
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210108,
					"content": "#{F#Reisende}{M#Reisender}, ich habe von Amber gehört, dass du bereits einen Flugschein hast. Könntest du mir bitte Nachhilfe geben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210109,
						200210113
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210109,
					"content": "Wird Amber deine Prüfung beaufsichtigen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210110
					]
				},
				{
					"id": 200210110,
					"content": "Nein, ich habe Amber nur getroffen, als ich mich angemeldet habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210111
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210111,
					"content": "Sie erwähnte dich, als sie mich über meinen Flugschein informierte, und sagte, du hättest wirklich gut abgeschnitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210112
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210112,
					"content": "Ich dachte, ich stelle dir mal eine Frage zum Flugschein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210115
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210115,
					"content": "Ich habe drei Fragen, die ich dir stellen möchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210116,
					"content": "Nun ... die erste Frage ist, wie viele Personen können sich beim Fliegen einen Windgleiter gleichzeitig teilen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210113,
					"content": "Klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210114
					]
				},
				{
					"id": 200210114,
					"content": "Toll, ich zähle auf dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210115
					],
					"speakerTitle": "Anna"
				}
			]
		},
