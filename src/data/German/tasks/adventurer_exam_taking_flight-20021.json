					"content": "Dann lass uns bitte loslegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200211304,
					"content": "Sieh gut zu.",
