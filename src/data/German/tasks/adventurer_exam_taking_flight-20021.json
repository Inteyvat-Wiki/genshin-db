				{
					"id": 200211401,
					"content": "Dein Umgang mit dem Windgleiter ist ziemlich beeindruckend. Kein Wunder, dass Amber mir geraten hat, dich um Rat zu fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200211402
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200211402,
					"content": "He, wenn du mir Nachhilfe gibst, bestehe ich bestimmt meine Flugscheinprüfung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200211403
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200211403,
					"content": "Danke, bitte nimm das an. Ich gehe zurück und übe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200211404
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200211404,
					"content": "Welche Farbe sollte mein Windgleiter haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200211405
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200211405,
					"content": "Blau? Grün? Ansonsten wäre ein bisschen von beidem schön ...",
