			"dialogs": [
				{
					"id": 200211301,
					"content": "Oh ... ich habe es verstanden! Aber es reicht nicht aus, nur Theorien zu hören ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200211302
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200211302,
					"content": "#{F#Reisende}{M#Reisender}, kannst du mir die Benutzung des Windgleiters zeigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200211303,
