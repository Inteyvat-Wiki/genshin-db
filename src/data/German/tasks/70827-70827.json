					"nextDialogs": [
						708270104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708270104,
					"content": "*wimmer*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708270105
					],
					"speakerTitle": "Fischi"
				},
				{
					"id": 708270105,
					"content": "#Paimon würde sich richtig schlecht fühlen, wenn wir es einfach so zurücklassen würden. Hunger zu haben ist schrecklich ... {NICKNAME}, wenn wir etwas Fleisch übrig haben, könnten wir ihm vielleicht ein bisschen davon geben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
