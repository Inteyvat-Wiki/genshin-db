			},
			"dialogs": [
				{
					"id": 50220401,
					"content": "(Wo bin ich? Ist das etwa ... das Königreich der Nacht?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220402
					]
				},
				{
					"id": 50220402,
					"content": "(Wie bin ich hierhergelangt? Eben gerade war ich doch noch ... Argh ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220403
					]
				},
				{
					"id": 50220403,
					"content": "(Mir dreht sich alles, ich kann keinen klaren Gedanken fassen. Ich sollte mich wohl zuallererst einmal umsehen.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
