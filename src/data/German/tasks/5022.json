			"dialogs": [
				{
					"id": 50220801,
					"content": "Guten Morgen! Hattest du gestern Nacht einen Albtraum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50220802,
					"content": "Paimon hat gehört, wie du dich im Schlaf hin- und hergewälzt hast. Vielleicht bist du einfach nervös wegen der letzten Schlacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50220803,
					"content": "(Also war das ein Traum? Ich kann mich kaum noch dran erinnern.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220804
					]
				},
				{
					"id": 50220804,
					"content": "(Alles, was passiert ist, scheint so undeutlich. Wenn ich versuche, mich daran zu erinnern, bekomme ich Kopfschmerzen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220805
					]
				},
				{
					"id": 50220805,
					"content": "Schüttel es einfach ab! Heute ist unser Treffen mit Mavuika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
