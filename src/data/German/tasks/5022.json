							10565.12
						],
						"pointId": 350200497
					}
				]
			},
			"dialogs": [
				{
					"id": 50220701,
					"content": "(Als ich die Lichtwand durchquert habe, hat es sich so angefühlt, als wäre mein gesamter Körper zu Eis erstarrt.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220702
					]
				},
				{
					"id": 50220702,
					"content": "(Sieht so aus, als reiche der Schutz des Herrschers der Nacht nicht bis hier. Kälte und Dunkelheit rauben einem den Atem und man hört nur das Klagen von Erschöpfung und Schmerz.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220703
					]
				},
				{
					"id": 50220703,
					"content": "(Wie lang mussten diese Seelen schon Qualen ertragen? Und wann wird es enden ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220704
					]
				},
				{
					"id": 50220704,
					"content": "(Hmm? Da ist jemand ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220705
					]
				},
				{
					"id": 50220705,
					"content": "Unsere Heimat liegt fern im Nebel der Erinnerung, aber die Flammen des Krieges toben weiter. Wir haben längst unser letztes Blut vergossen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220706
					],
					"speakerTitle": "„Capitano“"
				},
				{
					"id": 50220706,
					"content": "Haltet durch, meine tapferen Krieger ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220707
					],
					"speakerTitle": "„Capitano“"
				},
				{
					"id": 50220707,
					"content": "(Was macht Capitano hier? Und wovon redet er da ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220708
					]
				},
				{
					"id": 50220708,
					"content": "Eines Tages werde ich euch an den Ort führen, den ich euch versprochen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Capitano“"
				}
			]
		},
