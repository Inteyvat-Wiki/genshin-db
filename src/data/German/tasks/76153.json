			"dialogs": [
				{
					"id": 761530101,
					"content": "Im Verlagswesen verdient man kaum Geld, vielleicht sollte ich mich nach neuen Investitionsmöglichkeiten umsehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530102
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530102,
					"content": "Ich würde gern die Investitionspapiere sehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530103
					]
				},
				{
					"id": 761530103,
					"content": "Also gut, zweitausend Mora für ein Investitionspapier. Und du kannst einmal wöchentlich die Investitionserträge einsammeln. Hehe, in diesem kleinen Beutel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530104
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530104,
					"content": "... Ach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530105
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530105,
					"content": "Was ist los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530106
					]
				},
				{
					"id": 761530106,
					"content": "Oh, Jahoda, was führt dich her? Hat Frau Nefer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530107
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530107,
					"content": "Oh, nein. Ich bin nur mit meinem Freund hier, um ein wenig herumzuschauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530108
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530108,
					"content": "Hehe, sieht so aus, als ob dein Investitionsgeschäft wirklich gut läuft, Herr Dhabit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530109
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530109,
					"content": "Geht so, geht so, hahaha ... Es ist nur ein kleines Geschäft, reicht gerade zum Leben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530110
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530110,
					"content": "(Dieses listige Mädchen ... Ihre Worte haben eine andere Bedeutung! Bestimmt hat Nefer sie hierher geschickt ... Tss.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530111
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530111,
					"content": "Kann man damit echt Geld verdienen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530112
					]
				},
				{
					"id": 761530112,
					"content": "Na klar! Chefin Nef hat gesagt, dass Herr Dhabit der angesehenste und fähigste Geschäftsmann ist. Wer mit ihm zusammen investiert, macht bestimmt nichts falsch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530113
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530113,
					"content": "J... Ja ... Ja ... hahaha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530114
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530114,
					"content": "(Es ist also wirklich Nefer!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530115
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530115,
					"content": "Wann kann ich die Auszahlung meiner Investition erhalten ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530116
					]
				},
				{
					"id": 761530116,
					"content": "Heute! Genau heute! Du hast unser brandneues kurzfristiges Investitionspapier gekauft! Gewinn oder Verlust wird sofort abgerechnet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530117
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530117,
					"content": "Warum hat Paimon das Gefühl, dass du dir das gerade ausgedacht hast ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761530118,
					"content": "Hm ... W... Wie auch immer, danke dir für den Kauf des kurzfristigen Investitionspapiers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530119
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530119,
					"content": "Hier, nimm deinen Investitionsertrag entgegen und pass gut drauf auf. Und einen wunderschönen Tag noch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530120,
						761530121
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530120,
					"content": "Na ja ... Wie auch immer, Geld verdienen ist doch was Gutes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530122
					]
				},
				{
					"id": 761530122,
					"content": "Wirklich? Hehehe ... dann kauf Paimon eine in Vogelform, die mag Paimon nämlich am liebsten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761530123,
					"content": "Eh, ich komme mit euch und bringe der Chefin auch eine mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530124
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530124,
					"content": "Fräu... Fräulein Jahoda, warte bitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530125
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530125,
					"content": "Ähm ... Hast du vielleicht eine Nachricht von Frau Nefer für mich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530126
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530126,
					"content": "Ah. Die Chefin hat gesagt: „Wir haben gefunden, wonach du suchst.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530127
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530127,
					"content": "„Nur Geduld, Herr Dhabit. Man muss die Dinge eins nach dem anderen angehen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530128
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530128,
					"content": "J... Ja, Frau Nefer hat recht ... Danke, also dann, ich zähl auf euch beide ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530121,
					"content": "Los, Paimon, wir holen uns ein paar Zuckerfiguren.",
