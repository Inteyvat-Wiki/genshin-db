				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3560101,
					"content": "Darf ich euch vorstellen? Die Stadt des Windes und des Löwenzahns, die Stadt des Hirtengesangs und der Freiheit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560102,
					"content": "Reisende, die ihr unter dem Schutz des Ordo Favonius steht, ich heiße euch herzlich willkommen in Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560103,
					"content": "Endlich müssen wir nicht mehr draußen übernachten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560104,
					"content": "Die Leute hier scheinen aber nicht gerade in bester Laune zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560105,
					"content": "Das wird an Sturmschrecken liegen. In letzter Zeit dreht sich alles nur um ihn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560106,
					"content": "Aber solange Jean da ist, wird alles gut ausgehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560107,
					"content": "Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560108,
					"content": "Stellvertretender Großmeister des Ordo Favonius. Jean ist die Beschützerin von Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560109,
					"content": "Mit Jean an unserer Seite können wir selbst ein Ungeheuer wie Sturmschrecken besiegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560110,
						3560111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560110,
					"content": "(Die Dame scheint ja echt beeindruckend zu sein.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3560112
					]
				},
				{
					"id": 3560112,
					"content": "#Ach ja, bevor wir zusammen zum Hauptquartier des Ritterordens gehen, möchte ich dir ein Geschenk überreichen, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560113,
					"content": "Sieh es als Dankeschön für deine Hilfe beim Hilichurl-Lager!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560114,
					"content": "Wie bitte? Wo bleibt Paimons Geschenk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560115,
					"content": "Du ... wirst kaum etwas damit anfangen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560116,
					"content": "Dafür lade ich dich auf eine Portion Honigmöhren-Fleischpfanne heute Abend ein, eine Delikatesse aus Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560117
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560117,
					"content": "Honigmöhren-Fleischpfanne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560118,
					"content": "Aber jetzt kommt mal mit mir. Wir gehen zum <color=#00E1FFFF>höchsten Punkt</color> der Stadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560111,
					"content": "(Hoffentlich weiß sie etwas über den Gott des Windes.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3560112
					]
				}
			]
		},
		{
			"id": 35604,
			"completionStepIds": [
				35604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"35604",
							"2"
						],
						"stepId": 35604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3560401,
					"content": "Und nun, mein Geschenk an dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560402
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560402,
					"content": "Ein <color=#00E1FFFF>Windgleiter</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560403
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560403,
					"content": "Als Kundschafter von Mondstadt fliegt man damit durch die Lüfte. Auch die Bewohner der Stadt benutzen sie gern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560404,
					"content": "Ich wollte, dass du gleich zu Anfang siehst, wie toll so ein Gleiter ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560405
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560405,
					"content": "Du musst diese Gleiter ja echt lieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560406,
					"content": "Der Wind ist nun einmal die Seele Mondstadts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560407
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560407,
					"content": "Probier den Gleiter doch gleich mal aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560408
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560408,
					"content": "Es mag auf den ersten Blick sehr einfach erscheinen. Du solltest aber trotzdem auf meine Hinweise achten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		}
	]
}