			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mengmeng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410101,
					"content": "Die Laternen sind so schwer zu flechten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410102
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410102,
					"content": "Was ist los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410103
					]
				},
				{
					"id": 413410103,
					"content": "Weißt du, wie man Laternen anfertigt? Alle meine Versuche scheitern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410104
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410104,
					"content": "Durch das Loch, dann wieder zurück, und dann ... bring ich es durcheinander. Oder mach es kaputt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410105
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410105,
					"content": "Ich wollte so gerne eine Laterne für Yu basteln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410106
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410106,
					"content": "Yu kümmert sich immer um den Teeladen, darum hat er nie Zeit zum Spielen oder eine Laterne zu basteln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410107
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410107,
					"content": "Doch bestimmt wünscht er sich etwas. Darum will ich eine Laterne für ihn basteln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410108,
						413410109
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410108,
					"content": "Ich kann das für dich übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				},
				{
					"id": 413410110,
					"content": "Aber, aber ... das wollte ich doch für ihn machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410111
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410111,
					"content": "Und, und ... Ich möchte wissen, wie man sie anfertigt, damit ich Yu davon erzählen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410112
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410112,
					"content": "Würdest du mir ... beibringen, wie man sie anfertigt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410113
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410113,
					"content": "Werde ich machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410114
					]
				},
				{
					"id": 413410114,
					"content": "Hurraaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410115
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410115,
					"content": "Also ... dann ist die Laterne fertig, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410116
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410116,
					"content": "Danke! Jetzt werde ich eine für Yu basteln!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410109,
					"content": "Ich fertige eine für ihn an.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				}
			]
		},
		{
			"id": 4134102,
			"completionStepIds": [
				4134102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134102",
							"2"
						],
						"stepId": 4134102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410201,
					"content": "Hallo ... werter Kunde ... Bitte lege die Füße hoch und genieße eine Tasse Tee ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410203
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410203,
					"content": "Wir wollen dir eine Laterne überreichen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410204
					]
				},
				{
					"id": 413410204,
					"content": "Eine Laterne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410205
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410205,
					"content": "Yu, diese Laterne ist für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410206
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410206,
					"content": "Mengmeng? Oh, die ist von dir? Oh ... vielen Dank ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410207
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410207,
					"content": "#{M#Dieser nette Mann}{F#Diese nette Frau} hat es mir beigebracht. Es ist eine meiner ersten Laternen, darum ist es kein Meisterwerk ... Gefällt sie dir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410208
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410208,
					"content": "Soll das ein Witz sein? Sie ist super, einfach fantastisch! Ich dachte schon, ich schaffe es nicht, selbst eine zu basteln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410209
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410209,
					"content": "Danke, Mengmeng. Ich werde jemanden darum bitten, sie an meiner Tür aufzuhängen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410210,
						413410211
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410210,
					"content": "Aufhängen? Wozu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				},
				{
					"id": 413410212,
					"content": "Die Sache ist die ... Meinem Vater geht es nicht gut, darum kann er sie nicht für mich aufhängen. Und ich komm nicht ran, weil ich zu klein bin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410213
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410213,
					"content": "Wenn ich die Laterne aufhängen will, muss ich also jemanden darum bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410214,
						413410215
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410214,
					"content": "Wir können helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410216,
					"content": "Wirklich? Bereitet das auch keine Umstände? Wunderbar, vielen Dank! Jetzt kann ich den Laden verlassen, um nach Hilfe zu suchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410215,
					"content": "Wir übernehmen das.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410211,
					"content": "Kann dir deine Familie nicht helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				}
			]
		},
		{
			"id": 4134104,
			"completionStepIds": [
				4134104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134104",
							"2"
						],
						"stepId": 4134104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410401,
					"content": "#Diese Laterne ist so hübsch! Vielen herzlichen Dank, {M#Onkel}{F#Tante}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410402
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410402,
					"content": "Komm, Yu ... Lass uns spielen. Ich kenne ein Plätzchen, an dem es die schönsten Blumen gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410403
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410403,
					"content": "#{M#Dieser nette Mann}{F#Diese nette Frau} hat mir beigebracht, Laternen anzufertigen. Wenn du mitkommst, kann ich es dir beibringen. Wäre das nicht großartig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410404
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410404,
					"content": "Ich, äh ... Ich kann nicht. Ich muss auf den Laden aufpassen. Auch wenn keine Kunden da sind, muss der Laden blitzblank sein, wie mein Vater immer sagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410405
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410405,
					"content": "Oh, na ja ... Dann vergiss die Laterne, lass uns einfach schnell hingehen und einen kurzen Plausch halten. Dann gehen wir wieder zurück. So verlierst du kaum Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410406
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410406,
					"content": "Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410407,
						413410408
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410407,
					"content": "Ich kann den Laden für dich in Schuss halten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				},
				{
					"id": 413410409,
					"content": "Bist du sicher? Das, äh ... das wäre viel verlangt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410410
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410410,
					"content": "Wir sputen uns auch. Wir gehen direkt hin und kommen gleich wieder zurück. Es dauert nicht lang, versprochen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410411
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410411,
					"content": "Vieeelen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410408,
					"content": "Überlass das Putzen mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				}
			]
		},
		{
			"id": 4134107,
			"completionStepIds": [
				4134107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134107",
							"2"
						],
						"stepId": 4134107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410701,
					"content": "Die beiden spielen immer noch. Es ist also alles in Ordnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413410702,
					"content": "Vielleicht sollten wir sie lieber nicht stören ... das würde die Stimmung verderben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410703,
						413410704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413410703,
					"content": "Ich würde sie gern belauschen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410705
					]
				},
				{
					"id": 413410705,
					"content": "Ich habe einen Kranz für deinen Vater geflochten. Glaubst du, ihm geht es bald besser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410706
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410706,
					"content": "Ich ... Ich weiß es nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410707
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410707,
					"content": "Ich hab gelesen, wer glücklich ist, wird schneller gesund, wenn er krank ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410708
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410708,
					"content": "Du bist so erwachsen, du hilfst deinem Vater täglich im Laden ... Das macht ihn bestimmt sehr glücklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410709
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410709,
					"content": "Doch manchmal schimpft er mit mir ... „Faulenze nicht im Laden, geh spielen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410710
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410710,
					"content": "„Wenn du nicht mit Mengmeng spielst, gibt es in der gesamten Nachbarschaft bald keine Blumen mehr.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410711
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410711,
					"content": "Das wird nie passieren, dafür gibt es hier vieeel zu viele Blumen ... Warte kurz, ich flechte dir einen Kranz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410712
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410712,
					"content": "Danke, Mengmeng. Ich sollte wieder zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410713
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410713,
					"content": "Oh, na gut ... Aber sobald dein Vater wieder gesund ist, hast du mehr Zeit, oder? Dann können wir wieder zusammen spielen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410714
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410714,
					"content": "Jupp, bestimmt geht es Papa bald besser ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410715
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410715,
					"content": "Was zum ...?! Seit wann bist du hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410716,
						413410717
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410716,
