					"nextDialogs": [
						4860706
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 4860706,
					"content": "Großmeister? Alles jut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860707
					]
				},
				{
					"id": 4860707,
					"content": "Jeeaan? Was geht ab?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860708
					]
				},
				{
					"id": 4860708,
					"content": "O großer Löwenzahnritter ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860709
					]
				},
				{
					"id": 4860709,
					"content": "Aaah! ... Oh, ähm, mein Ehrenritter ... Ich bitte um Verzeihung, ich war wohl in Gedanken woanders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860710
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 4860710,
					"content": "Seid ihr auf ein Problem gestoßen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860711
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 4860711,
					"content": "Tatsächlich gibt es da ein paar Dinge, die aufgeklärt werden müssen. Wir sind aber nur im Auftrag von anderen hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860712,
					"content": "Ach, so ist das. Vielen Dank, dass ihr den Bürgern von Mondstadt so zur Seite steht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860713
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 4860713,
					"content": "Ich habe die Fälle in die Akten aufgenommen ... und werde mich sofort ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860714
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 4860714,
					"content": "darum kümmern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860715
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 4860715,
					"content": "Sehr schön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860716,
					"content": "Wir sollten niemanden vergessen haben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860717,
					"content": "Sara, Charles, Margaret ... Ja, das sollten alle sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860718,
					"content": "Dann vielen Dank und bis ... Jean ... Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860719,
					"content": "Noch da, Jean? Alles in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
