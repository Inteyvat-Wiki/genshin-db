						4860704
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 4860704,
					"content": "Ähm, hallo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860705,
					"content": "...",
