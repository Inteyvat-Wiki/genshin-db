			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4860203,
					"content": "Können wir dir helfen, Sara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860204
					]
				},
				{
					"id": 4860204,
					"content": "Aber ich habe doch eben schon gegessen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860205
					]
				},
				{
					"id": 4860202,
					"content": "Endlich seid ihr hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860205,
					"content": "Ich will doch keine Kunden anwerben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860206
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860206,
					"content": "Ich will den Ritterorden bitten, einen Auftrag zu übernehmen. Könnt ihr bitte dem stellvertretenden Großmeister Bescheid geben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860207
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860207,
					"content": "Ah, du willst also eigentlich mit Jean sprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860209,
					"content": "Wir sind dicke Freunde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860210
					]
				},
				{
					"id": 4860211,
					"content": "Wir sind uns einmal begegnet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860212
					]
				},
				{
					"id": 4860213,
					"content": "#Ich bin {F#ihre treue Dienerin}{M#ihr treuer Diener}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860214
					]
				},
				{
					"id": 4860208,
					"content": "Ach, kennt ihr Jean persönlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860209
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860210,
					"content": "Ach so? Mit Jean als Freundin fühlt ihr euch bestimmt gut beschützt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860211
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860212,
					"content": "Ich habe gehört, dass Jean euch sehr achtet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860213
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860214,
					"content": "Diener? Ähm ... Entwickelt sich der Ordo Favonius zu dem Adel des alten Mondstadts?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860215
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860215,
					"content": "#Entschuldige bitte. {NICKNAME} hat einen schrägen Humor ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860216,
					"content": "Was sollen wir denn für dich ausrichten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860217,
					"content": "Ach ja ... Also, es tut mir leid, dass ich nicht persönlich erscheinen kann. Es gibt einfach so viel hier im Restaurant zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860218
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860218,
					"content": "Aber genau jetzt scheint es Probleme auf der Versorgungsstrecke zwischen Quellingen und uns gekommen zu sein. Wahrscheinlich treiben Hilichurle dort ihr Unwesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860219
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860220,
					"content": "Ich würde den Ritterorden darum bitten, die Strecke zu säubern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860221
					]
				},
				{
					"id": 4860222,
					"content": "Ich verstehe schon. Du willst den Jägern eine Lektion erteilen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860223
					]
				},
				{
					"id": 4860219,
					"content": "Doch die Jäger aus Quellingen sind der Meinung, dass sie nur für die Jagd zuständig seien, nicht für das, was danach mit dem Wild geschieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860220
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860221,
					"content": "Jawohl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860222
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860223,
					"content": "Nein! Damit kann das Problem doch nicht gelöst werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860225,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860226
					]
				},
				{
					"id": 4860224,
					"content": "Bitte <color=#00E1FFFF>Jean</color> darum, einige Leute auszusenden, die Versorgungsstrecke von Hilichurlen zu befreien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860225
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860226,
					"content": "Endlich Hilfe ... Wenn sich Jean darum kümmert, werden wir bestimmt bald keine Engpässe mehr haben. Danke euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860227
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860227,
					"content": "Ich habe das Gefühl, dass wirklich ausnahmslos jeder Jean vertraut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860228,
					"content": "Ach, eins noch. Der <color=#00E1FFFF>Wirt Charles</color> meinte, dass er auch ein Problem hätte, bei dem er eure Hilfe bräuchte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860229
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860229,
					"content": "Vielleicht könntet ihr auf dem Weg bei ihm vorbeischauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860230
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860230,
					"content": "Aber sicher doch! Paimon ist immer zur Stelle! ... Paimon hat nur das Gefühl, dass das nicht wirklich auf dem Weg liegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 48603,
			"completionStepIds": [
				48603
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48603",
							"2"
						],
						"stepId": 48603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charles"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4860301,
					"content": "Ihr glaubt wohl, hier gäbe es Obstsaft, Kinder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860302
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860302,
					"content": "Hach, was für ein Benehmen! Wir sind hier um zu helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860303,
					"content": "#Helfen? Ach, dann musst du {F#die}{M#der} Neue unter den Helfern des stellvertretenden Großmeisters sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860304
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860304,
					"content": "Ja ... Also falsch ist das ja nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860305,
					"content": "Dann sag Jean bitte, dass ich die Steuerunterlagen für dieses Quartal noch brauche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860306
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860306,
					"content": "Elzer muss schließlich wieder die Rechnungen prüfen ... Die Steuern auf Alkohol sind in Mondstadt wirklich hoch, muss ich sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860307
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860307,
					"content": "Und dafür brauchst du wirklich Jean?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860308
					]
				},
				{
					"id": 4860308,
					"content": "Das Weingut Morgenröte hat doch so viel Geld.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860309
					]
				},
				{
					"id": 4860309,
					"content": "Das liegt vorwiegend an dem hervorragenden Betrieb durch Diluc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860310
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860310,
					"content": "Warum sind die Unterlagen denn bei Jean? Macht sie die Rechnungen jetzt etwa auch noch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860311,
					"content": "Ja, der stellvertretende Großmeister muss die Konten alle persönlich durchgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860312
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860312,
					"content": "Die Getränkewirtschaft ist nun einmal die Haupteinnahmequelle von Mondstadt. Jean würde da keinerlei Unklarheiten zulassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860313
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860313,
					"content": "Wirklich ... Jean hat noch mehr zu tun, als ich mir vorgestellt hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860314,
					"content": "Dank der Anstrengungen des stellvertretenden Großmeisters haben wir nicht so viel um die Ohren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860315
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860315,
					"content": "Aber – wie soll ich sagen – mittlerweile scheint sich jeder an dieses Glück gewöhnt zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860316
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860316,
					"content": "Ihr wisst also ganz genau, dass Jean so viel zu tun hat, und euch macht das gar nichts aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860317,
					"content": "Du hast schon recht, ja ... Der Nächste geht wohl aufs Haus, sobald sie mal wieder hier ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860318
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860318,
					"content": "Wobei Jean kaum Zeit für sowas hat, befürchte ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860319
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860319,
					"content": "Ich habe das Gefühl, du suchst nur nach Ausreden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860320,
					"content": "#{NICKNAME}, ich schlage vor, wir gehen gleich zu <color=#00E1FFFF>Jean</color> und sprechen mit ihr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 48605,
			"completionStepIds": [
				48605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
