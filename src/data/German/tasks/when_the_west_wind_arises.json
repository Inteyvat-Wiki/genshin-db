				"points": []
			},
			"dialogs": [
				{
					"id": 4860501,
					"content": "Wartet kurz, ihr beiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860502
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860502,
					"content": "Margaret, was machst du denn hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860503,
					"content": "Meine Katze ist wieder verschwunden. Habt ihr sie gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860504
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860504,
					"content": "Nein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860505
					]
				},
				{
					"id": 4860505,
					"content": "Meinst du Diona?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860506
					]
				},
				{
					"id": 4860506,
					"content": "Nein, nicht die. Diona ist noch in der Taverne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860507
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860507,
					"content": "Ich spreche von Prinz. Er war gerade noch zu Hause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860508
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860508,
					"content": "Du glaubst doch wohl nicht, dass Diona ein braves Hauskätzchen ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860509,
					"content": "Ich habe Angst, dass er nicht mehr nach Hause findet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860510
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860510,
					"content": "Wir würden zwar gern helfen, aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860511
					]
				},
				{
					"id": 4860511,
					"content": "Aber wir haben eine dringende Angelegenheit, über die wir Jean informieren müssen. Ich hoffe, du verstehst das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860512,
					"content": "Wir könnten doch nebenbei suchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860513
					]
				},
				{
					"id": 4860513,
					"content": "#Also, {NICKNAME}, du bist wie immer sehr hilfsbereit. Aber du solltest nicht vergessen, dass wir noch etwas zu tun haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860514,
					"content": "Sara und Charles brauchen dringend unsere Hilfe. Ich denke, wir sollten erst zu Jean gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860515,
					"content": "Ach, ihr wollt auch zu Jean? Das trifft sich ja gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860516
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860516,
					"content": "Bist du nicht auf der Suche nach deiner Katze?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860517,
					"content": "Ja, eben. Ich möchte Jean darum bitten, nach meiner Katze zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860518
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860518,
					"content": "Wie bitte?! Jean wird Wichtigeres zu tun haben, als nach einer Katze zu suchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860519,
					"content": "Ach, sollte ich sie lieber nicht darum bitten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860520
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860520,
					"content": "Aber Jean ist doch so nett.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860521
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860521,
					"content": "Was ist das denn für ein Grund?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860522
					]
				},
				{
					"id": 4860522,
					"content": "Man hat es wirklich nicht leicht im Leben, wenn man nett ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860523
					]
				},
				{
					"id": 4860523,
					"content": "Dann sagt doch Jean wenigstens bitte, was los ist. Dann lade ich euch auch beim nächsten Mal bei Zum Katzenschwanz ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860524
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860524,
					"content": "Aber, d...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860525,
					"content": "Na gut, was sollen wir machen? Dann erzählen wir Jean eben vom Kater Prinz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
