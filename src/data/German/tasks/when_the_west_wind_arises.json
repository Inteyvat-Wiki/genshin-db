				},
				{
					"id": 4861003,
					"content": "Ich weiß schon, dass es Jean nicht gut geht. Ich möchte im Namen des Ritterordens unseren Dank aussprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861004
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861004,
					"content": "So viele Worte des Danks bin ich bei Kaeya gar nicht gewohnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861005,
					"content": "Haha! Es geht hier schließlich um unseren hoch geschätzten hochstellvertretenden Großmeister.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861006
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861006,
					"content": "Dennoch möchte ich noch etwas anderes loswerden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861007
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861007,
					"content": "Ihr habt Arbeit für uns?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861008
					]
				},
				{
					"id": 4861008,
					"content": "Ganz genau! Zwischen uns gibt es eine spürbare Verbindung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861009
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861009,
					"content": "Ihr habt wieder eine Belohnung für uns?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861010
					]
				},
				{
					"id": 4861010,
					"content": "Hahaha! Ich mag, wie direkt du sein kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861011
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861011,
					"content": "Doch bevor wir zu einer Belohnung kommen, muss ich dich um einen Gefallen für den Ritterorden bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861012
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861012,
					"content": "Wir sollen Jeans Arbeit übernehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861013,
					"content": "Ja, Jean hat zwar schon Pläne für die Missionen gemacht, die ihr ihr übermittelt habt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861014
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861014,
					"content": "Aber ich habe so meine Bedenken, dass nicht alles so reibungslos abläuft, wenn sich Jean nicht persönlich darum kümmert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861015
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861015,
					"content": "Es wäre schön, wenn du nachsehen könntest, ob deine Unterstützung benötigt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861016
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861016,
					"content": "Ich wäre sehr beruhigt, wenn der Ehrenritter von Mondstadt mit Hand anlegen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861017
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861017,
					"content": "#Wie sehr Ihr {NICKNAME} auch schmeichelt, muss Paimon doch die eine Frage stellen: Warum geht Ihr nicht selbst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861018,
					"content": "Hahaha! Ich habe noch so viele Aufträge zu erledigen, das würdet ihr mir gar nicht glauben ... so viel zu tun ... ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861019
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861019,
					"content": "Hmm, na gut. Also dann, wir haben hier <color=#00E1FFFF>Sara, Charles und Margaret</color>. Sonst noch jemand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861020,
					"content": "Nein, das sollten alle Aufträge sein. Viel Erfolg euch beiden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		},
