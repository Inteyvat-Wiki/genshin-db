					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4860801,
					"content": "Wie geht es Jean? Ich hoffe, es ist nichts Schlimmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860802,
					"content": "Tja, das wird wohl der Stress von der vielen Arbeit sein. Sie muss sich unbedingt genügend ausruhen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860803
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860803,
					"content": "Danke, dass ihr sie hergebracht habt! Sonst würde sie sicher weiter versuchen weiterzuarbeiten, als wäre nichts geschehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860804
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860804,
					"content": "Es ist ja auch kein Wunder bei all der Arbeit, die Jean zu erledigen hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860805,
					"content": "Das stimmt. Jean schultert schon immer gern die Sorgen anderer und vergisst dabei, auf sich selbst acht zu geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860806
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860806,
					"content": "Das ist nämlich nicht das erste Mal, dass so etwas passiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860807
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860807,
					"content": "Die arme Jean ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860808
					]
				},
				{
					"id": 4860808,
					"content": "Barbara, Ihr macht Euch wirklich große Sorgen um Jean.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860809
					]
				},
				{
					"id": 4860809,
					"content": "A... Ach ja? Ich ... Ich meine, sie ist eben der stellvertretende Großmeister. Wenn sie ausfällt, ist das für alle ein großer Verlust!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860810
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860810,
					"content": "Deswegen ... Also das hat nichts mit meinen persönlichen Gefühlen für sie zu tun! Es geht hier um ... um das Allgemeinwohl! Ihr hört richtig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860811
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860811,
					"content": "Das kam wohl falscher an, als es sollte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860812,
					"content": "#Ach ja, {NICKNAME}, du bist doch der Ehrenritter, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860813
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860813,
					"content": "Solange der stellvertretende Großmeister seine Pflichten nicht erfüllen kann, müssen andere ihr doch dabei helfen, ist es nicht so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860814
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860814,
					"content": "Da habt Ihr natürlich recht. Aber sollte das nicht ein vollwertiger Ritter des Ordo Favonius übernehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860815,
					"content": "Jean hat so viel Arbeit, dass einer mehr auf jeden Fall eine große Hilfe sein wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860816
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860816,
					"content": "Wärt ihr also so freundlich, <color=#00E1FFFF>zurück zum Orden zu gehen</color>? Ich passe solange auf Jean auf. Ich werde mich gut um sie kümmern, versprochen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860817
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860817,
					"content": "Es kommt mir vor, als wollte man uns loswerden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860818,
					"content": "Bitte was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860819
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860819,
					"content": "#Schon gut, gehen wir jetzt besser, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
