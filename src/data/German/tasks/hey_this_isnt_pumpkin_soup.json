			"dialogs": [
				{
					"id": 740390801,
					"content": "Hier, das ist die Werkstatt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390802
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390802,
					"content": "Also, der nächste Test ist der „Trank des wahren Sehens“, bist du bereit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390803
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390803,
					"content": "Ich bin bereit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390804
					]
				},
				{
					"id": 740390804,
					"content": "Ähm ... sei vorsichtig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390805,
					"content": "Du nimmst den Trank aus Vérénatas Hand. Er riecht wie längst abgestorbenes Seegras, das in der Sonne verrottet, und er verursacht einen üblen Brechreiz in deiner Kehle ...\\nDu zögerst einen Moment und trinkst ihn dann ganz aus. Die Flüssigkeit ist nicht unangenehm, um genau zu sein, hat sie keinen erkennbaren Geschmack ...\\nAnsonsten zeigt dein Körper keine Reaktion.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390806
					]
				},
				{
					"id": 740390806,
					"content": "Dann hast du dich auf Anweisung von Vérénata eine Weile ausgeruht und nichts hat sich geändert.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390807
					]
				},
				{
					"id": 740390807,
					"content": "Aber, kurz darauf ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390808
					]
				},
				{
					"id": 740390808,
					"content": "Es scheint sich nichts verändert zu haben ... Puh, Paimon ist froh, sich keine Sorgen machen zu müssen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390809,
					"content": "#Ja, aber ... {NICKNAME}, du bist gerade für einen Moment erstarrt. Was ist passiert? Hast du etwas gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390810
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390810,
					"content": "Ich habe ... ein halbes durchsichtiges Schiff gesehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390811
					]
				},
				{
					"id": 740390811,
					"content": "Hm? Interessant! Aber ... ähm ... kannst du es genauer beschreiben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390812,
						740390815
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390812,
					"content": "Es war so weit weg, dass ich es nicht genau sehen konnte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390813
					]
				},
				{
					"id": 740390813,
					"content": "#Sehr interessant! ... Aber das ist kein konkreter Beweis für die Wirksamkeit des Tranks ... denn {NICKNAME} kann nicht beweisen, ob das „Geisterschiff“, das {F#sie}{M#er} gesehen hat, ein entferntes Riff oder das Schiffswrack war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390814
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390814,
					"content": "Na ja ... leider ist auch dieses Experiment immer noch erfolglos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390818,
					"content": "Vielen Dank, ich habe dieses Mal viele Notizen gesammelt! Sie werden in der nächsten Trankmischung bestimmt einen Nutzen finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390819
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390819,
					"content": "Hmm ... „obwohl ich eine bekannte Beschreibung gehört habe ...“ Hm ... „aber ich muss noch genauer untersuchen, ob jemand anderes diese Art von Zeichen gesehen hat“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390820
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390820,
					"content": "Hä ... das bedeutet, dass du jemand anderen bitten musst, den Trank zu testen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390821,
					"content": "Ja, richtig! Weil ... nur wenn wir mehr als zwei verlässliche Zeugen finden, können wir bestätigen, dass der Trank die Menschen wirklich die „wahren Dinge“ sehen lässt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390822
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390822,
					"content": "Denn die „wahren Dinge“ sind nicht durch Blicke und Gedanken getrübt, sie werden nicht durch das Herz und den Geist der Menschen verzerrt ... Sie sind immer da, einfach so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390823
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390823,
					"content": "Ähm ... wie ... eine Gottheit, die Tausende von Jahren leben kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390824
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390824,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390825
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390825,
					"content": "Nein, wie der feine weiße Sand, der Leichnam eines Seesterns, die sich wiegenden Wellen ... das sind die „wahren Dinge“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390826
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390826,
					"content": "Aber Frau Tränkemischerin hat auch gesagt ... dass durch Träume und Erinnerungen auch neue „Wahrheiten“ geschaffen werden können. Diese widersprüchliche Aussage verstehe ich nicht ... aber ich versuche, es zu ergründen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390827
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390827,
					"content": "Waah ... das Thema ist plötzlich so esoterisch geworden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390828
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390828,
					"content": "Haha, dann reden wir nicht über esoterische Themen! Jedenfalls danke ich euch für eure Hilfe! Bitte nehmt die hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390829
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390829,
					"content": "Und ... bitte seid unbedingt wieder dabei, wenn ich das nächste Mal einen neuen Trank herstelle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390815,
					"content": "Es sah so aus, als wäre es von etwas Großem abgeschnitten worden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390816
					]
				},
				{
					"id": 740390816,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390817
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390817,
					"content": "Ah, Entschuldigung! Ich ... war etwas abgelenkt ... Aber ... Aber ich habe die Informationen soeben notiert, danke dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "Vérénata"
				}
			]
		},
