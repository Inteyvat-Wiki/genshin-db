			"dialogs": [
				{
					"id": 740390101,
					"content": "Also ... Windgetrocknete Gezeitenalgenpaste, eingelegte Innereien von Lumitoiles, und dazu noch ... Hmm, eine „Prise“ ... Ach, wie viel ist eine „Prise“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390102
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390102,
					"content": "Oh? Was kochst du denn da für eine Suppe ... Waah! Die riecht echt seltsam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390103,
					"content": "Wie? Seltsam? Das sollte doch nicht sein ... Ich habe mich doch genau an Frau Carabosses Rezept gehalten. Der Geruch sollte ganz normal sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390104,
						740390106
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390104,
					"content": "Es riecht wie ein Barsch, der drei Jahre in toten Fröschen eingelegt war ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390105
					]
				},
				{
					"id": 740390105,
					"content": "Igitt, da hat Paimon gleich ein Bild vor den Augen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390108,
					"content": "Wie auch immer ... Was kochst du da nun eigentlich? Äh ... Benötigst du unsere Hilfe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390109,
					"content": "Einen Trank! Ich braue einen Trank ... der vielen Leuten helfen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390110
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390110,
					"content": "Äh ... Also ... Also bist du eine Tränkemischerin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390111,
					"content": "Ich bin noch keine Tränkemischerin. Ich bin Vérénata, eine Assistentin. Frau Tränkemischerin ist die großartige Carabosse und ich habe noch viel von ihr zu lernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390112
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390112,
					"content": "Hehe, die Assistentin einer großen Ärztin zu sein, bedeutet, eine großartige Assistentin zu sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390113,
					"content": "Hehe ... Äh, aber nein, aber nein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390114
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390114,
					"content": "Es ... Es gibt noch so viel, das ich lernen muss. Ich tue einfach nur mein Bestes, um für Frau Tränkemischerin Tränke zuzubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390115
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390115,
					"content": "Ah, also ... Ich habe euch meinen Namen verraten, aber wie heißt ihr beide eigentlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390116
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390116,
					"content": "#Wir sind Paimon und {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390117,
					"content": "„Paimon“, was für ein schöner Name. Er klingt wie eine kleine weiße Qualle, sehr geräuschvoll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390118
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390118,
					"content": "#{NICKNAME} ... ein etwas sonderbarer Name. Golden schillernd aber auch sehr freundlich. Ich freue mich sehr, euch beide kennenzulernen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390119
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390119,
					"content": "Ah ... Ihr wolltet wissen, ob ich Hilfe benötige. In der Tat, ich könnte etwas Hilfe gebrauchen, aber ich bin mir nicht sicher, ob ihr dazu bereit seid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390120
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390120,
					"content": "Sag einfach, worum es geht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390121
					]
				},
				{
					"id": 740390121,
					"content": "Ja, wenn du unsere Hilfe benötigst, dann sag einfach, was du brauchst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390122,
					"content": "Ich möchte, dass ihr ... den neu zubereiteten Trank ausprobiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390123
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390123,
					"content": "Äh ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390124,
					"content": "Ich weiß, dass er nicht gut riecht und auch nicht gut schmeckt ... aber er kann sehr vielen Leuten helfen und viele Krankheiten heilen. Er ist also sehr nützlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390125
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390125,
					"content": "Aber wir können keine Krankheiten bekommen und mögen es auch nicht, seltsame Dinge zu trinken ... Mittlerweile gibt es niemandem mehr, der mir beim Testen von Tränken helfen will und das ist wirklich ein Problem für mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390126
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390126,
					"content": "A... Aber ... du hast selbst gesagt, dass es ein seltsames Ding ist! Ist es nicht etwas Gefährliches?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390127,
					"content": "Keine Sorge, wir können nicht vergiftet werden. Äh ... und daher, also in der Theorie, solltet ihr auch nicht vergiftet werden können ... Rein theoretisch gesehen, versteht sich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390128
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390128,
					"content": "Also es gibt insgesamt drei Arten an Tränken, die ausprobiert werden müssen. Eine Art macht Menschen mächtiger, sodass sie besser kämpfen können! Eine andere Art kann Menschen aufwärmen, und dann ist da noch die letzte Art ... Äh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390129
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390129,
					"content": "Ich weiß auch nicht genau ... Frau Carabosse hat gesagt, dass diese Art von Trank Menschen die „Wahrheit“ sehen lassen kann. Genau das waren ihre Worte, doch ich verstehe nicht, was damit gemeint ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390130
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390130,
					"content": "Das klingt ziemlich gefährlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390131,
					"content": "Nein, nein, überhaupt nicht ... Also, seid ihr bereit, mir zu helfen? Falls ja, dann werde ich euch gleich dorthin bringen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390106,
					"content": "Wenn man den ersten Schock überwunden hat, kann man einen ganz kleinen Hauch von Zuckerblume riechen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390107
					]
				},
				{
					"id": 740390107,
					"content": "Hui! Aber das macht die Sache nicht wirklich besser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
