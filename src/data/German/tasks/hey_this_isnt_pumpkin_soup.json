					}
				]
			},
			"dialogs": [
				{
					"id": 740390701,
					"content": "#{NICKNAME}! Wie geht es dir? Alles in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390702
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390702,
					"content": "*schluchz* ... Tut mir leid, tut mir leid ... Ich wusste nicht, dass der Trank sonderbare Dinge anziehen würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390703,
						740390710
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390703,
					"content": "Es lag daran, dass der Trank mir ein wonniges Gefühl der Wärme gegeben hat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390704
					]
				},
				{
					"id": 740390704,
					"content": "Ah ... Das ist also der Grund!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390705,
					"content": "Ah ... Richtig! Weil Wasserlebewesen warme Dinge fälschlicherweise für Sonnenlicht halten, wurden sie davon angezogen. Und das heißt ... dass der Trank funktioniert! Ich danke dir! Ich danke euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390706
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390706,
					"content": "Hä? ... Obwohl Paimon glaubt, dass das nicht so funktioniert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390707,
					"content": "Wasserlebewesen ...? Waren das nicht Pyro-Schleime?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390708
					]
				},
				{
					"id": 740390708,
					"content": "So ist das also ... Hmm, der Trank induziert also Halluzinationen ... Gut, ich werde das vermerken! Immerhin heißt das ja, dass er nicht ganz ohne Wirkung ist ... Allerdings ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390709
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390709,
					"content": "Allerdings ist die Wirkung ziemlich bedenklich! Dieses Mal sahen große Krebse wie Pyro-Schleime aus. Was, wenn es beim nächsten Mal noch gefährlichere Monster sein werden?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390720,
					"content": "Stimmt ... Ihr habt mir schon sehr viel geholfen, aber es gibt da immer noch eine Art von Trank, die getestet werden muss ... Also, wollt ihr noch weitermachen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390721,
						740390723
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390721,
					"content": "Solange er nicht giftig ist, geht das schon in Ordnung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390722
					]
				},
				{
					"id": 740390722,
					"content": "Ob er giftig ist oder nicht, lässt sich wohl auch nur durch Testen herausfinden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390725,
					"content": "Danke! Ich danke euch beiden! Also, als Nächstes ... kommt der Trank des wahren Sehens dran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390726
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390726,
					"content": "Äh? M... Moment!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390727,
					"content": "Der erste Trank heißt Trank der Superstärke, der zweite Trank der wonnigen Wärme und dieser hier heißt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390728,
					"content": "Trank des wahren Sehens, genau. Der Name soll darauf hindeuten, dass „er Menschen die Wahrheit sehen lassen kann“ ... Wo liegt das Problem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390729
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390729,
					"content": "Äh ... Es ist nichts ... Paimon hat nur das Gefühl, dass der Name dieses Tranks im Vergleich zu den anderen eine Dreihundertsechzig-Grad-Wendung darstellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390730,
						740390731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390730,
					"content": "Würde das nicht bedeuten, dass er gleich ist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390732
					]
				},
				{
					"id": 740390732,
					"content": "Äh? ... Oh, da hat Paimon sich wohl verzählt! Na ja, du weißt ja, was Paimon meint!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390733,
					"content": "Hehe, das liegt daran, dass mir Frau Tränkemischerin bei den ersten beiden mit den Namen geholfen hat, während ich mir den Namen für den „Trank des wahren Sehens“ selbst ausgedacht habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390734
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390734,
					"content": "Der Name, den ich mir ausgedacht habe, ist dumm und kann sich gewiss nicht mit den Namen messen, die sich Frau Tränkemischerin ausgedacht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390735
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390735,
					"content": "So ... So ist also ... Und Paimon hat noch gedacht, dass es andersherum wäre ... Jedenfalls solltest du ein bisschen mehr Selbstvertrauen haben! Dein Name klingt viel eher, wie ein richtiger Name für einen Trank ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390736,
					"content": "Ah, danke. Also ... anders als die letzten beiden könnte dieser Trank sehr gefährlich sein ... Daher sollten wir zu meiner Werkstatt gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390737
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390737,
					"content": "Genau ... Wenn wir im Meer wären, könnte die Umgebung den Effekt des Tranks neutralisieren. Außerdem habe ich in der Werkstatt die Mittel, um Gefahren zu bewältigen, also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390738
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390738,
					"content": "Ooh ... Dieses Mal ist der Trank wohl wirklich sehr riskant ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390739,
					"content": "Dann fangen wir an.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390740
					]
				},
				{
					"id": 740390740,
					"content": "Ja, folgt mir bitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390731,
					"content": "Du meinst wohl einhundertachtzig Grad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390732
					]
				},
				{
					"id": 740390723,
					"content": "Da wir schon so weit sind ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390724
					]
				},
				{
					"id": 740390724,
					"content": "Stimmt! Mittendrin aufzuhören, wäre zu schade! Auch wenn Paimon immer noch ein wenig besorgt ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390710,
					"content": "Kein Problem, Pyro-Schleime sind sehr schwach.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390711
					]
				},
				{
					"id": 740390711,
					"content": "#Nein, vielmehr liegt es daran, dass du sehr stark bist, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390712,
					"content": "Hm, einen Moment ... Hast du gerade „Pyro-Schleime“ gesagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390713
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390713,
					"content": "Oh, ja ... Wir haben ganz klar nur ein paar große Krebse gesehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390714,
						740390716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390714,
					"content": "Krebse? Hm ... Krebse an der Küste sind tatsächlich ziemlich normal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390715
					]
				},
				{
					"id": 740390715,
					"content": "Du warst hingegen gerade alles andere als normal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390716,
					"content": "Aber das Gefühl der Wärme war sehr real, ich hatte sogar Hitzewallungen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390717
					]
				},
				{
					"id": 740390717,
					"content": "Oh, so ist das also? ... Hmm, der Trank induziert also Halluzinationen ... Gut, ich werde das vermerken! Er ist also nicht ganz ohne Wirkung ... Jedoch ... *seufz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390718
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390718,
					"content": "Die Hauptsache ist, dass dir nichts passiert ist! Es tut mir halt nur leid, dass der Trank wieder ein Fehlschlag war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390719
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390719,
					"content": "#Ach kein Problem ... Also, er riecht zwar in der Tat sehr übel, doch eigentlich war er ja zur Hälfte erfolgreich! Schau mal, {NICKNAME} ist nach dem Trinken immer noch lebendig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				}
			]
		},
