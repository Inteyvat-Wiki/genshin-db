						],
						"pointId": 5959
					}
				]
			},
			"dialogs": [
				{
					"id": 740390501,
					"content": "Danke, dass ihr mir dabei helfen wollt! Lasst uns nun gleich den ersten Trank ausprobieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390502
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390502,
					"content": "#{NICKNAME}, trink besser nicht zu viel davon! Und wenn es sich komisch anfühlt, dann spuck das Zeug sofort aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390503,
					"content": "Schon gut. Mir wird schon nichts passieren, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390504
					]
				},
				{
					"id": 740390504,
					"content": "Hmpf ... Paimon macht sich halt Sorgen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390505,
					"content": "Ich bin bereit. Gib mir den Trank.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390506
					]
				},
				{
					"id": 740390506,
					"content": "Dieser Trank nennt sich „Trank der Superstärke“ und theoretisch kann er dich superstark machen! Hehe ... theoretisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390507
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390507,
					"content": "Du nimmst dir den Trank, den Vérénata dir anreicht, und trinkst die ganze Flasche aus.\\nDer Geruch ist unerträglich. Überraschenderweise hat der Trank einen angenehm süßen Geschmack mit einer klebrigen Konsistenz.\\nAbgesehen davon hast du keinerlei andere körperliche Reaktion.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390508
					]
				},
				{
					"id": 740390508,
					"content": "Dann wartet ihr auf Anweisung von Vérénata hin, bis zu dem Zeitpunkt, an dem die Rissprimusse aktiv werden.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
