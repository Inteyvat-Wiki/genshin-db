						"position": [
							2501.063,
							445.119,
							4637.081
						],
						"pointId": 5959
					}
				]
			},
			"dialogs": [
				{
					"id": 740390601,
					"content": "Dass ... Dass du gerade die Monster so spielend besiegen konntest, war das der Effekt des „Tranks der Superstärke“, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390602,
						740390605
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390602,
					"content": "Ja, der „Trank der Superstärke“ hat mich superstark gemacht!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390603
					]
				},
				{
					"id": 740390603,
					"content": "Was für ein zweitklassiger Werbeslogan ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390604,
					"content": "Ooh! Danke! Ich danke euch! Es war also tatsächlich der Effekt des Tranks. Kein Wunder, immerhin ist es ja auch die Rezeptur von Frau Tränkemischerin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390609,
					"content": "Also gut, damit wäre das Testen des „Tranks der Superstärke“ beendet. Als Nächstes beginnen wir mit dem Testen des ... „Tranks der wonnigen Wärme“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390610
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390610,
					"content": "Äh, denkst du dir diese Namen alle selbst aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390611,
					"content": "Nein, ich kann mir keine Namen ausdenken, also muss ich andere bitten, mir beim Erfinden dieser etwas hölzernen Namen zu helfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390612
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390612,
					"content": "Oh, sag das nicht ... Namen, die ihre Wirkung direkt ausdrücken, sind gute Namen für Tränke! Meinst du nicht auch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390613,
					"content": "Das ist das erste Mal, dass ich jemanden so etwas sagen höre ... Aber es stimmt. Das ist genau das, was Frau Tränkemischerin sagen würde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390614
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390614,
					"content": "#Ähem, aber genug davon! {NICKNAME}, bist du bereit, den Trank auszuprobieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390615
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390615,
					"content": "Ja, lass uns beginnen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390616
					]
				},
				{
					"id": 740390616,
					"content": "Boah, der riecht ja auch nicht besonders toll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390617,
					"content": "Der „Trank der wonnigen Wärme“ sollte dich in der Theorie immun gegen Kälte machen und dich aufwärmen! Ähm ... theoretisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390618
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390618,
					"content": "Du nimmst den Trank von Vérénata entgegen. Er riecht wie staubiges, verschimmeltes altes Leder ...\\nDu zögerst einen Moment und trinkst dann schließlich alles aus. Die Flüssigkeit ist ganz passabel, schmeckt nach Zimt und hat einen Hauch der Schärfe vom Ingwer ... Sie erinnert dich an einen prasselnden Kamin in einem Bücherzimmer an einem regnerischen Tag.\\nAbgesehen davon hast du keinerlei andere körperliche Reaktion.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390619
					]
				},
				{
					"id": 740390619,
					"content": "Dann ruhst du dich auf Anweisung von Vérénata hin eine Weile lang aus.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 740390605,
					"content": "Ich kann keinen Unterschied spüren ... Er ist ziemlich süß.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390606
					]
				},
				{
					"id": 740390606,
					"content": "Äh?! Aber ... er hat doch so übel gerochen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390607,
					"content": "Oh? ... So ist das also? Wo liegt nur der Fehler ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390608
					],
					"speakerTitle": "Vérénata"
				},
				{
					"id": 740390608,
					"content": "Sei nicht niedergeschlagen ... Äh ... immerhin schmeckt er ja ganz gut und ist auch nicht giftig. Das ist doch schon mal was!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7403907,
