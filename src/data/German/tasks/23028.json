			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Awan",
					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280401,
					"content": "Yasmin? Was machst du denn hier? Ähm ... Bist du wieder gekommen, um deinen Trank zu sprühen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280402
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280402,
					"content": "Die Wurzeln sind hier völlig in Ordnung und haben keine Medizin nötig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280403
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280403,
					"content": "Auch wenn sie in Ordnung sind, sollten wir uns trotzdem weiter um sie kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280404
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280404,
					"content": "Wenn man erst anfängt, nach einer Lösung zu suchen, nachdem ein Problem aufgetreten ist, wäre es so, als würde man herausfinden, dass der Fisch selbst dann noch roh ist, wenn aber die Fischröllchen schon fertig sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280405
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280405,
					"content": "Egal, ob du die gerollten Fladen neu machst oder sie wieder aufmachst, ist es nervig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280406
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280406,
					"content": "Ich kann es dir wirklich nicht ausreden ... aber was ist mit dem Geruch des Trankes, den ich letztes Mal erwähnt habe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280407
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280407,
					"content": "Ich wohne direkt nebenan. Ich möchte nicht mit diesem komischen Geruch einschlafen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280408
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280408,
					"content": "Keine Sorge, ich habe Ladep das Rezept für den Trank ändern lassen. Der Gestank wird nicht zu heftig sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280409
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280409,
					"content": "Ach, na gut. Ich gehe. Sprühe deinen Trank nicht in meinem Hof. Ich kann ihn nicht ertragen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280410
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280410,
					"content": "#In Ordnung, ich hab’s. {F#Reisende}{M#Reisender}, gib mir den Trank aus der Kiste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280411
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280411,
					"content": "Den Trank zusammen mit Yasmin schütten ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230280412
					]
				},
				{
					"id": 230280412,
					"content": "Dieser Trank riecht wirklich übel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230280413,
					"content": "Du scheinst nichts zu spüren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280414
					]
				},
				{
					"id": 230280414,
					"content": "Wenn du über den Geruch sprichst ... Ich habe schon viele Dinge erlebt, die schlimmer riechen als dieser Trank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280415
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280415,
					"content": "Das wird reichen, ich habe auch viele Daten aufgezeichnet, Pharez wird sich freuen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280416
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280416,
					"content": "#Das ist deine Belohnung, {F#Reisende}{M#Reisender}. Vielen Dank für deine Hilfe auf dem Weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280417
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280417,
					"content": "Ich weiß auch nicht, wie gut Ladep und Pharez vorangekommen sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		},
