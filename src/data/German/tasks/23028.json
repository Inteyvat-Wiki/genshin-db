				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280101,
					"content": "#{F#Reisende}{M#Reisender}, ihr kommt gerade rechtzeitig, ich suche Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280102,
					"content": "Gibt es ein Problem mit dem Wurzelsystem des Heiligen Baumes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280103
					]
				},
				{
					"id": 230280103,
					"content": "Jetzt ist alles gut mit dem Heiligen Baum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280104,
					"content": "Und es ist meine Aufgabe, dafür zu sorgen, dass es so bleibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280105,
					"content": "Alles, was ich tun muss, ist, diese Tränke um die Wurzeln des Heiligen Baumes zu gießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280106,
					"content": "Aber es sind so viele Tränke, dass ich sie nicht allein tragen kann. Ladep und Pharez sind zu sehr in ihre Arbeit vertieft, um mir zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280107
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280107,
					"content": "Deshalb möchte ich dich bitten, mir beim Tragen dieser Tränke zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280108,
						230280112
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280108,
					"content": "Ladep und Pharez sind ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280109
					]
				},
				{
					"id": 230280109,
					"content": "Sie sind Studenten wie ich, obwohl Ladep zu Spantamad und Pharez zu Kshahrewar gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280110
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280110,
					"content": "Wir haben ein gemeinsames Thema und arbeiten derzeit zusammen, obwohl wir unterschiedliche Philosophien haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280111
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280111,
					"content": "Diese Tränke sind das Ergebnis unserer Zusammenarbeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280113
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280113,
					"content": "So, ich trage diesen hier. Ich verlasse mich darauf, dass du die anderen Tränke mitnimmst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280114
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280114,
					"content": "Geh vorsichtig damit um. Ladep sagt, er hat den Trank absichtlich unangenehm riechen lassen, um zu verhindern, dass Menschen ihn versehentlich einnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280115
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280115,
					"content": "Wenn du den Trank auf deine Kleidung bekommst, geht der unangenehme Geruch lange Zeit nicht weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280112,
					"content": "Gut, dann lass uns losgehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280113
					]
				}
			]
		},
		{
			"id": 2302804,
			"completionStepIds": [
				2302804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2302804",
							"2"
						],
						"stepId": 2302804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
