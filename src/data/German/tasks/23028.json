			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280501,
					"content": "Yasmin! *schluchz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280502
					]
				},
				{
					"id": 230280502,
					"content": "Ich ... Ich bekomme bald keine Luft mehr. Lasst uns diesen Ort verlassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280503
					]
				},
				{
					"id": 230280503,
					"content": "Was ist das ... *hust* *hust* Das riecht ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230280504,
					"content": "Sieht aus, als hätte Ladep gute Arbeit geleistet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280505
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280505,
					"content": "Wir sind hier fertig mit dem Verschütten. Lasst uns zum nächsten Ort gehen. Er ist nur ein Katzensprung entfernt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		}
	]
}