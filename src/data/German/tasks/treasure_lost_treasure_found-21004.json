			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210045001,
					"content": "Und? Habt ihr den Schatz gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045003
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045003,
					"content": "Gefunden, der Ort, wo alles zusammenfließt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045004
					]
				},
				{
					"id": 210045004,
					"content": "So ist das also ... Dann ist es wirklich wie in den „Guizhong-Mahnungen“ beschrieben, der Schatz ist an dem Ort, wo alles „zusammenfließt“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045005
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045005,
					"content": "Derjenige, der sich das Rätsel ausgedacht hat, muss Guizhong bis zum Schluss treu gewesen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045006
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045006,
					"content": "Auch wenn meine Heimat zerstört wurde, so werde ich die Guizhong-Mahnungen weitergeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045007
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045007,
					"content": "Derjenige, der die vier Mahnungen von „Guizhong“ niederschrieb, muss sein Volk zutiefst geliebt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045008
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045008,
					"content": "Sie hoffte, dass ihr eigenes Volk gesegnet sei mit Weisheit, dass sie einem strengen inneren moralischen Kompass folgten und vereint gemeinsam ihre Heimat, die Guili-Stätte, verteidigten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045009,
						210045016,
						210045021
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045009,
					"content": "Sie scheiterte dennoch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045010
					]
				},
				{
					"id": 210045010,
					"content": "Scheiterte? So kann man das auch nennen, sie ist gestorben ... Die Guili-Stätte wurde zerstört und ihr Volk wurde obdachlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045011
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045011,
					"content": "Aber wir haben doch heute ihre „Guizhong-Mahnungen“ ans Tageslicht gebracht, oder nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045012
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045012,
					"content": "Diese „Guizhong“ hat die Mahnungen und Wünsche sorgfältig von Hand für ihr Volk niedergeschrieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045013
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045013,
					"content": "Die vier „Guizhong-Mahnungen“ ausführend marschierte sie einst Hand in Hand mit ihrem Volk durch dieses Land.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045014
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045014,
					"content": "Auch wenn sie bereits nicht mehr unter den Lebenden weilte, ihr Glaube und ihre Ideale lebten weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045015
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045015,
					"content": "Einer ihrer Verehrer war sehr schlau, indem er sich eines Schatzes bediente um die „Guizhong-Mahnungen“ darin weiterzugeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045028
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045028,
					"content": "Jedoch weiß man nie, in wessen Herzen ein Schatz Gold und Silber oder die „Guizhong-Mahnungen“ bedeutet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045029,
					"content": "Haha, wenn man mich fragt, verglichen mit diesen Gold- und Silberschätzen, so sind diese „Mahnungen“ der eigentliche Schatz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045030
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045030,
					"content": "Wenn man aber die Leute wirklich wählen lassen würde, wie viele würden den greifbaren Schatz aufgeben und die „Mahnungen“ wählen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045016,
					"content": "Eine wahrlich gütige Göttin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045017
					]
				},
				{
					"id": 210045017,
					"content": "Eine Göttin als gütig zu beschreiben, geht eigentlich schon ein bisschen zu weit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045018
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045018,
					"content": "Vor langer, langer Zeit lebte unter den Menschen womöglich doch so eine Göttin, die man als gütig bezeichnen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045019
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045019,
					"content": "Sie beschützte ihr Volk und wandelte gemeinsam mit ihnen Hand in Hand durch diese Lande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045020
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045020,
					"content": "Ein so sanfter Archon und am Ende war nichts mehr übrig, das es zu beschützen gab. Selbst die Befehle, die sie ihrem Volk gab, mussten mit einem „Schatz“ erkauft werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045021,
					"content": "Ich würde sie wirklich gern einmal sehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045022
					]
				},
				{
					"id": 210045022,
					"content": "Du willst einen Gott zu Gesicht bekommen? Deine Fantasie geht wohl wirklich mit dir durch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045023
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045023,
					"content": "Wobei ... Wenn du wirklich Guizhong zu Gesicht bekommen würdest, was würdest du tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045024
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045024,
					"content": "Wahrscheinlich so etwas wie „Du hast Großes geleistet“ oder „Danke für alles“, um sie aufzubauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045025
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045025,
					"content": "Wenn ich etwas sagen müsste, würde ich etwas von den „Guizhong-Mahnungen“ zitieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045026
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045026,
					"content": "Und dann würde ich ihr sagen, dass ihr Glauben und ihre Ideale nicht verschwunden sind, dass es noch Leute in diesem Land gibt, die sich an ihre Lehren erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045027
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045027,
					"content": "Eine Guizhong, die bereits alles verloren hat, baut man so doch am besten auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
