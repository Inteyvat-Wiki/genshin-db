					"content": "Vielleicht hat es ja was mit diesem anderen Gott zu tun ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210049502
					]
				},
				{
					"id": 210049502,
					"content": "Du ... wie geht denn das ... was denkst du dir, lass die Mythen von Liyue doch nicht zur Realität werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049503
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049503,
					"content": "Guizhong war ein Archon, kein gewöhnlicher Sterblicher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049504
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049504,
					"content": "Ein ... ein Archon ... würde doch nicht etwa ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
