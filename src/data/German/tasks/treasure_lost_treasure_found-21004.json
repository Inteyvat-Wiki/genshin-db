				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210049001,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049002
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049002,
					"content": "Kannst du mir mehr über die Legende erzählen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210049003
					]
				},
				{
					"id": 210049003,
					"content": "Nun ja, es ist eher ein Rätsel als eine Legende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049004
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049004,
					"content": "Dieses Rätsel erzählt man sich hier auf der Guili-Ebene ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049005
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049005,
					"content": "„Wo Weisheit und Ehrgeiz, Zusammenhalt und Entschlossenheit wie Wasser ineinanderfließen, dort werde ich den großzügigen Schatz der Erde preisgeben.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049006
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049006,
					"content": "Was meinst du? Dieses Rätsel klingt doch ganz so, als wäre hier auf der Guili-Ebene ein Schatz vergraben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049007
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049007,
					"content": "Wenn ich das richtig verstehe, deuten diese vier Wörter auf vier bestimmte Ruinen hin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049008
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049008,
					"content": "Ich erhoffe mir, dass ich das Rätsel dieser Legende vollständig lösen kann, wenn ich alle vier Ruinen gefunden habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049009
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049009,
					"content": "Ich bin aber nicht gut hin Form. Allein für diese erste Ruine habe ich Tage gebraucht, bis ich wieder zurück war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049010
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049010,
					"content": "Falls du Lust hast, kannst du ja selbst auf die Suche gehen. Vielleicht findest du ja etwas Aufschlussreiches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
