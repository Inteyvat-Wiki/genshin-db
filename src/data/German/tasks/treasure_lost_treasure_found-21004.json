				{
					"id": 210040201,
					"content": "Klingt nach Spaß.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040202
					]
				},
				{
					"id": 210040202,
					"content": "Ich habe die Ruine, die ich schon entdeckt habe, auf der Karte markiert. Sieh dich dort einfach schon einmal um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040203
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040203,
					"content": "Und handle nicht zu voreilig, sobald du einen Hinweis gefunden hast. <color=#00E1FFFF>Schreib dir erst alles auf</color>, damit du in aller Ruhe darüber nachdenken kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
