				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210049301,
					"content": "Vielleicht war es ja ein Territoriumskampf unter den Göttern ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210049302
					]
				},
				{
					"id": 210049302,
					"content": "Territoriumskampf? Aber den Erzählungen nach war die Guili-Stätte unter der Führung von Guizhong immer stabil und friedlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049303
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049303,
					"content": "Ich habe plötzlich das Gefühl, „Guizhong“ war gar kein so mächtiger Gott ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049304,
					"content": "Es muss noch einen weiteren Gott außer Guizhong gegeben haben. Niemand wäre so töricht, es mit zwei Göttern gleichzeitig aufzunehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
