			"dialogs": [
				{
					"id": 210049401,
					"content": "Wegen ... eines Schatzes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210049402
					]
				},
				{
					"id": 210049402,
					"content": "Ein mächtiger Gott jedoch würde doch nicht wegen eines gewöhnlichen Schatzes einen Krieg riskieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049403
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049403,
					"content": "Außerdem, selbst wenn dem so wäre, überleg mal, ein Schatz, für den sogar Götter in den Krieg ziehen würden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049404
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049404,
					"content": "Haha, ich kann mir einfach nicht vorstellen, was es sein könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
