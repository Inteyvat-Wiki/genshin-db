			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210040101,
					"content": "Die Guizhong-Mahnungen ... Was für ein Hinweis verbirgt sich hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040102,
						210040104
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040102,
					"content": "Ich bin bereit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040103
					]
				},
				{
					"id": 210040103,
					"content": "Haha, du hast aber Ausdauer! Na gut, dann entziffern wir eben die Guizhong-Mahnungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040106,
					"content": "„Lehre Weisheit, gebunden an Moral, mit starken Muskeln und vereint im Herzen. All dies fließt in der Guili-Stätte zusammen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040107
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040107,
					"content": "Vom Text allein liest es sich wie eine „Ermahnung“ für das tägliche Leben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040108
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040108,
					"content": "Aber, wo ist in diesem Satz nur der Hinweis auf den Schatz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040109
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040109,
					"content": "Es hilft alles nichts, wir müssen den unbequemsten Weg gehen. Wir haben es ja so gewollt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040110
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040110,
					"content": "Diese sieben Passagen, die wir zuvor gefunden hatten, befanden sich alle irgendwie in Ruinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040111
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040111,
					"content": "Wir wissen nicht so genau, wo wir anfangen sollen, daher wäre es wohl besser, wenn wir weiter in den Ruinen suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040112,
						210040116,
						210040122
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040112,
					"content": "Wo sollen wir nur suchen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040113
					]
				},
				{
					"id": 210040113,
					"content": "Gut, was das Suchgebiet angeht, lass uns erstmal in der „Guili-Ebene“ verweilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040114
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040114,
					"content": "Du musst verstehen, ein Gelehrter wie ich kann mit deinem Schritttempo doch gar nicht mithalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040115
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040115,
					"content": "Daher überlasse ich dir das Durchsuchen der Ruinen. Solltest du etwas finden, komm zurück zu mir und erzähl davon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040129,
					"content": "Da wir gerade davon sprechen, ich habe in der Nähe eine Ruine entdeckt, darin fand ich eine seltsame Scheibe mit Schriftzeichen darauf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040130
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040130,
					"content": "Zur jener Zeit jedoch war ich noch mit anderen Studien beschäftigt und habe mich nicht intensiv damit befasst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040131
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040131,
					"content": "Rückwirkend betrachtet, hatte die Scheibe aus dieser Ruine vielleicht etwas mit den „Guizhong-Mahnungen“ zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040132
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040132,
					"content": "Wenn das so ist, mache ich eine Markierung für dich auf der Karte und du kannst dich dort einmal umsehen, ob du etwas findest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040116,
					"content": "Das alles soll ich einmal komplett durchsuchen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040117
					]
				},
				{
					"id": 210040117,
					"content": "Natürlich nicht, wenn wir das Suchgebiet auf ganz Liyue ausbreiten würden, wären wir beide niemals in der Lage alles zu durchforsten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040118
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040118,
					"content": "Da der Schatz mit der „Guili-Ebene“ zu tun hat, sollten wir das Suchgebiet auch erstmal auf diese Gegend beschränken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040119
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040119,
					"content": "Dann legen wir das Suchgebiet erstmal innerhalb der Guili-Ebene fest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040120
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040120,
					"content": "Übrigens, ein Gelehrter wie ich kann mit deinem Schritttempo doch gar nicht mithalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040121
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040121,
					"content": "Daher überlasse ich dir das Durchsuchen der Ruinen. Solltest du etwas finden, komm zurück zu mir und erzähl davon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040122,
					"content": "Ich werde mich nach Liyue begeben und alle dortigen Ruinen durchsuchen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040123
					]
				},
				{
					"id": 210040123,
					"content": "Warte! Sei nicht so aufgeregt, Liyue ist so groß, wann willst du das denn alles absuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040124
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040124,
					"content": "Du warst so aufgeregt, von dem Schatz zu hören ... Was kann ich da noch groß sagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040125
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040125,
					"content": "Da der Schatz wohl aus der Guili-Stätte der Guili-Ebene stammt, lass uns das Suchgebiet auch auf dieses Gebiet beschränken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040126
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040126,
					"content": "Lass mich mal überlegen ... Das Suchgebiet sollte genau in der Guili-Ebene liegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040127
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040127,
					"content": "He! Hör mich erst an, bevor du gehst! Denke immer daran, sei bei der Erforschung der Ruinen sehr vorsichtig und solltest du etwas finden, bring es zurück zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040128
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040128,
					"content": "Denk dran, such nur auf der Guili-Ebene, verlasse dieses Gebiet nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040104,
					"content": "Gehen wir und finden den Schatz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040105
					]
				},
				{
					"id": 210040105,
					"content": "Man muss nur einen Schatz erwähnen, dann bist du wieder völlig munter. Gut, dann fangen wir mal mit dem Entziffern der Guizhong-Mahnungen an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "Soraya"
				}
			]
		},
