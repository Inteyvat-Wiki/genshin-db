					"id": 210040901,
					"content": "Tschüs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040902
					]
				},
				{
					"id": 210040902,
					"content": "Willst du dich schon auf den Weg machen? Erzähl mir bitte, wenn du auf etwas Interessantes stößt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 2100420,
			"completionStepIds": [
				2100420
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100420",
							"2"
						],
						"stepId": 2100420,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210042001,
					"content": "Selbst ein Archon kann seinem Schicksal nicht entkommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042002
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042002,
					"content": "Vier Hinweise aus vier Ruinen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042003
					]
				},
				{
					"id": 210042003,
					"content": "Vier Ruinen, vier Hinweise ... Genau wie die Guizhong-Mahnungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042004
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042004,
					"content": "Allerdings sind diese vier Sätze nur ein Auszug aus den Guizhong-Mahnungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042005
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042005,
					"content": "Der Schlüssel zu einer korrekten Interpretation ist der Originaltext der Guizhong-Mahnungen, diese vier Sätze dienen nur unterstützend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042006
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042006,
					"content": "Man kann versuchen, diese fünf Absätze zu verbinden. Aber was bedeuten sie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042007
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042007,
					"content": "„fließt zusammen“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042008
					]
				},
				{
					"id": 210042008,
					"content": "Zusammenfließen ... das klingt so, als ob diese vier Absätze zusammen etwas anderes bedeuten könnten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042009
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042009,
					"content": "Warte, jetzt erinnere ich mich. Jede einzelne dieser Mahnungen ist jeweils in einer bestimmten Ruine zu finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042010
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042010,
					"content": "Ich habe eine halbgare Theorie. Wenn man diese vier Mahnungen interpretieren will, so muss man in jede der jeweiligen <color=#00E1FFFF>„Ruine“</color> ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042011
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042011,
					"content": "Über die genaue Interpretation muss ich allerdings noch einmal nachdenken ... Du kannst dir ja auch Gedanken machen und wenn dir etwas Gutes einfällt, setz es direkt in die Tat um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042012
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042012,
					"content": "Du bist nicht wie ich, eine schwächliche Gelehrte, die keiner Brise standhalten kann ... Ich beneide dich wirklich, so viel Ausdauer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042013
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042013,
					"content": "Nun gut, ich werde darüber noch einmal nachdenken. Solltest du irgendwelche Entdeckungen machen, lass es mich wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 2100422,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
