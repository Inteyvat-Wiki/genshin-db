				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210042201,
					"content": "Bisher ist dies nur meine Theorie, aber die wahre Entschlüsselung dieser vier Mahnungen hängt bestimmt mit der jeweiligen Ruine zusammen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042202
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042202,
					"content": "Wie uns das helfen soll, darüber habe ich noch nicht nachgedacht. Außerdem ... habe ich einfach nicht mehr die Kraft, jede einzelne Theorie auszutesten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042203
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042203,
					"content": "Wenn ich aber nur darüber nachdenke und nichts wirklich in Angriff nehme, wird mein Durchbruch niemals kommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
