					"content": "Ich weiß auch nicht wieso ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210049602
					]
				},
				{
					"id": 210049602,
					"content": "Heißt das, es ist wegen dieses „Archontenkriegs“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049603
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049603,
					"content": "Um einen der begehrten sieben Sitze auf Celestia zu bekommen, bekriegten sich die Götter in einem nicht enden wollenden Kampf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049604
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049604,
					"content": "Es sah fast so aus, als ob keiner auf dieser Welt sich dem Krieg entziehen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
