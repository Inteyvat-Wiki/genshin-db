			"dialogs": [
				{
					"id": 210049201,
					"content": "Was kannst du mir über die Guizhong-Mahnungen erzählen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210049202
					]
				},
				{
					"id": 210049202,
					"content": "Erinnerst du dich nicht mehr an „Guizhong-Mahnungen“? Macht nichts, solche Dinge bleiben schlecht im Gedächtnis, obwohl mein Erinnerungsvermögen nicht ohne ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049203
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049203,
					"content": "Der Inhalt der Guizhong-Mahnungen lautet: „Lehre Weisheit, gebunden an Moral, mit starken Muskeln und vereint im Herzen. All dies fließt in der Guili-Stätte zusammen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 2100493,
