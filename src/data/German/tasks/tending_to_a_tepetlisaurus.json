							7728.138
						],
						"pointId": 350400157
					}
				]
			},
			"dialogs": [
				{
					"id": 250200101,
					"content": "Hora! Sei ein braver Junge und zappel nicht so viel! Ich will dich nur ein bisschen abschrubben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200102,
					"content": "*wimmer* ... *brüll*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200103
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200103,
					"content": "Jetzt komm schon, mein Kleiner. Wie wär’s, nehmen wir doch erstmal ein Bad, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200104
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200104,
					"content": "Sieh mal, der Teich dort vorne. Wenn wir mit dem Waschen fertig sind, können wir gleich zurückkommen und weiterspielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200105
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200105,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200106
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200106,
					"content": "He! Warte! Nicht wegrennen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200107,
						250200108
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200107,
					"content": "W... Was ist denn da gerade vorbeigesaust?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				},
				{
					"id": 250200109,
					"content": "Bist du hier, um den Stamm zu besuchen? Es tut mir so leid. Hora ist in letzter Zeit etwas überdreht und tobt ständig herum. Ich hoffe, er hat dich nicht erschreckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200110
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200110,
					"content": "Wolltest du ihn gerade zu einem Bad überreden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200111
					]
				},
				{
					"id": 250200111,
					"content": "Überreden? *seufz* Betteln trifft es wohl eher. Es hat in den letzten Tagen immer wieder geregnet und jedes Mal, wenn er zum Spielen rausgeht, ist er danach voller Schlamm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200112
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200112,
					"content": "Ich habe versucht, ihn ein wenig sauberzubekommen. Aber er ist so versessen aufs Spielen, dass er jede wache Minute des Tages nur herumtollt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200113
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200113,
					"content": "Und ich ... bin halt auch nur ein Mensch. Da kann ich nicht mithalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200114
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200114,
					"content": "Hast du mal versucht, ihn mit einem Leckerli anzulocken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200115
					]
				},
				{
					"id": 250200115,
					"content": "Ja, hab ich schon versucht. Aber es ist, als wüsste er, was ich vorhabe, und wenn er mich sieht, macht er sich nicht einmal die Mühe, ihn zu fressen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200116
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200116,
					"content": "Wenn ich dann einmal wegschaue, gräbt er sich seinen Weg nach drüben, futtert alles weg und taucht dann wieder ab ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200117
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200117,
					"content": "Ein Tepetlisaurier, wie er im Buche steht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200118
					]
				},
				{
					"id": 250200118,
					"content": "Ganz genau! Mir graut schon davor, was er alles anstellen wird, wenn er erstmal groß ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200119
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200119,
					"content": "Ich hoffe nur, dass er sich nicht über Chevens Laden hermacht ... Ich könnte es mir nie leisten, die ganzen Edelsteine zu ersetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200120
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200120,
					"content": "*seufz* Mir bleibt wohl nichts anderes übrig, als die Idee von Batz auszuprobieren. Aber dieser Ball ... ob ein Tepetlisaurier überhaupt Interesse an so was hat ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200121
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200121,
					"content": "Wer ist denn Batz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200122
					]
				},
				{
					"id": 250200122,
					"content": "Ach ja, er ist derjenige, der sich um die Tepetlisaurier im Stamm kümmert. Der Kerl hat echt Köpfchen und Musik im Blut. Egal ob Saurier oder Mensch, alle lieben ihn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200123
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200123,
					"content": "Als ich das letzte Mal mit ihm darüber sprach, gab er mir den Bauplan zur Herstellung eines „Schwimmballs“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200124
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200124,
					"content": "Er hat ihn von Mataoho bekommen, und die kleinen Saurier lieben ihn. Ich werde also versuchen, auch einen für Hora zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200125
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200125,
					"content": "Ich hatte gerade die Materialien zusammengesucht und wollte mit der Arbeit beginnen, als Hora wieder anfing, na ja, Hora zu sein ... Er kann einfach nicht stillsitzen, nicht einmal für eine Minute!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200126
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200126,
					"content": "Mir bleibt wohl nichts anderes übrig, die „Schwimmball“-Idee ist alles, was ich hab ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200127,
						250200128
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200127,
					"content": "Kann ich dir irgendwie helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200129,
					"content": "Du würdest mir echt helfen? Das ist ja großartig. Was für ein Glück, dass ich jemanden so Nettes treffe wie dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200130
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200130,
					"content": "Würdest du mir aus der Kiste dort bitte ein paar Glutkernblumen-Stiele bringen? Ich werde hier erstmal den „Schwimmball“-Rahmen herstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200128,
					"content": "Wenn du Hilfe brauchst, sag es einfach.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200108,
					"content": "Waah! Das war knapp! Er hat fast mein Knie getroffen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				}
			]
		},
