				"points": []
			},
			"dialogs": [
				{
					"id": 250201001,
					"content": "Genau richtig, danke dir! Ich muss nur ... Aua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201002
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201002,
					"content": "Entschuldigung. Ich ... Ich hab mir nur den Finger aufgekratzt, als ich den Rahmen zusammengebunden habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201003
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201003,
					"content": "Diese Art von Fummelarbeit ist wirklich nichts für mich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201004
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201004,
					"content": "Moment, ich binde nur die Stiele an den Rahmen und dann kommt der Stoff drum ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201005
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201005,
					"content": "Cazcal ringt weiter mit dem „Schwimmball“ ... und nach drei weiteren Blessuren an seiner Hand ist der Ball endlich fertig ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250201006
					]
				},
				{
					"id": 250201006,
					"content": "Und fertig! Gehen wir los und suchen Hora. Er hat sich sicher wieder unter irgendeinen Baum gebuddelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201007
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201007,
					"content": "Willst du nicht lieber erstmal deine Hand verbinden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250201008
					]
				},
				{
					"id": 250201008,
					"content": "Ach, keine Sorge deswegen, das sind nur Kratzer. Ich bandagiere das später.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201009
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201009,
					"content": "Finden wir erstmal Hora. Nicht, dass er uns wieder völlig durchdreht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
