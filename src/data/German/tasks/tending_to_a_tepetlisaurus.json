			"dialogs": [
				{
					"id": 250200501,
					"content": "*brüll*? *brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200502
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200502,
					"content": "*brüll* ... *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200503
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200503,
					"content": "Hora schnappt sich fröhlich den „Schwimmball“ und tollt mit ihm im Teich herum. In den Wellen des Wassers wird nach und nach der ganze Schlamm von seinem Körper gespült ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250200504
					]
				},
				{
					"id": 250200504,
					"content": "Hahaha, der kleine Tunichtgut scheint den Ball ja zu lieben. Er spielt sogar direkt im Teich damit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200505
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200505,
					"content": "Lass uns rübergehen. Das zählt wohl auch als Bad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200506
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200506,
					"content": "*brüll*? *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200507
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200507,
					"content": "Na, gefällt dir das Geschenk, mein Junge? Es ist nur für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200508
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200508,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200509
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200509,
					"content": "Dich zu baden, ist echt kein Pappenstiel ... aber gut, hahaha, ich weiß jetzt, wie wir das hinkriegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200510
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200510,
					"content": "*brüll* ... *brüll*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200511
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200511,
					"content": "Ist etwas mit meiner Hand? Ach das ... nur ein paar Kratzer, nicht schlimm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200512
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200512,
					"content": "*wimmer*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200513
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200513,
					"content": "Warum plötzlich so niedergeschlagen, mein Kleiner? Hattest du nicht gerade eben noch so viel Spaß? Bist du müde vom Spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200514
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200514,
					"content": "Vielen Dank auch an dich. Hier, das ist für dich, deine Bezahlung. Es ist nichts Wertvolles drin, also keine Sorge, du kannst es beruhigt annehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200515
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200515,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200516
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200516,
					"content": "Halt, nein, nicht zurück ins Wasser! Hora! Du bist doch gerade erst trocken geworden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
