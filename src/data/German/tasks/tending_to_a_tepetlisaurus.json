			"dialogs": [
				{
					"id": 250201101,
					"content": "Dort drüben ist er. Und auch direkt neben dem Teich. Wenn wir ihn dorthin locken könnten, wäre das die Gelegenheit für sein Bad ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201102,
					"content": "Wenn ich rübergehe, wird er mich sicher bemerken. Würdest du das für mich übernehmen und den „Schwimmball“ in der Mitte des Teiches platzieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201103
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201103,
					"content": "Bring den „Schwimmball“ in die Mitte des Teiches ... Ich hoffe, Hora gefällt er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
