			"dialogs": [
				{
					"id": 710501401,
					"content": "Dann kommen wir gleich zum Punkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501402
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501402,
					"content": "Du hast in den letzten Tagen so viel für mich in der Große Kluft getan, ich weiß gar nicht, wie ich dir danken soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501403
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501403,
					"content": "Es wäre auch unangebracht, dir nur weiter Geld zu geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501404
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501404,
					"content": "Wenn du es wirklich geben willst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710501405
					]
				},
				{
					"id": 710501405,
					"content": "Seid nicht lächerlich, wie könnte ich eine so unangenehme Tat begehen, indem ich euch eine Geldsumme gebe und dann Feierabend mache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501406
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501406,
					"content": "Das ist eine Beleidigung für dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501407,
					"content": "Hier, nimm diesen Brief, und wenn du jemals die Gelegenheit hast, nach Sumeru zu gehen und in Schwierigkeiten gerätst oder Hilfe brauchst, dann bring diesen Brief zur Purbiruni-Schule!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501408,
					"content": "Wir werden sicherlich alles tun, um dir zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501409
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501409,
					"content": "„Ein Gefallen ist wertvoller als Gold.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501410
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501410,
					"content": "Dieses sumerische Sprichwort spricht, glaube ich, von einer solchen Situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				}
			]
		}
	]
