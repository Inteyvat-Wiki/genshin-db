			"dialogs": [
				{
					"id": 761290101,
					"content": "Nochmals vielen Dank für eure Hilfe für die Gilde, Chefin Nefer, Fräulein Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761290102,
					"content": "Du brauchst nicht so formell zu sein. Wir arbeiten nur zusammen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290103,
					"content": "Das stimmt schon, aber ich muss mich trotzdem bei dir bedanken, Chefin Nefer, dass du bereit warst, der Gilde bei einigen ... komplizierten Ermittlungsarbeiten zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290104
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290104,
					"content": "Die Abenteurergilde hat auch viele Mitglieder abgestellt, um uns bei der Arbeit zu helfen. Das ist eine für beide Seiten vorteilhafte Partnerschaft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290105,
					"content": "Ich hoffe, dass unsere Zusammenarbeit auch in Zukunft so angenehm sein wird, Herr Sarin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290106,
					"content": "Du kannst dir sicher sein, Chefin Nefer, dass die Abenteurergilde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290107
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290107,
					"content": "Oh, ich sollte etwas präziser sein. Die Niederlassung der Abenteurergilde in Nod-Krai ist definitiv ein vertrauenswürdiger Partner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290108
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290108,
					"content": "Hehe, das sieht man.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290109,
					"content": "(Gut, gut, redet einfach weiter. Chefin Nef, meine liebe Chefin Nef, schau mich nicht an, schau mich nicht an, schau mich nicht an ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290110,
					"content": "Jahoda, warum sagst du nichts?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290111
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290111,
					"content": "(Sie hat mich doch angeschaut! Dann schau nicht auf die Missionstafel, schau nicht auf die Missionstafel, schau nicht auf die Missionstafel ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290112
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290112,
					"content": "Hä? Ich ... Ich habe nichts, was ich sagen will! Hmm ... Danke ... für die Mission ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290113
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290113,
					"content": "Oh, wir sollten auch Fräulein Jahoda für ihre Hilfe danken. Ohne dich würden sich die Angelegenheiten der Gilde wahrscheinlich wie ein Berg anhäufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290114
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290114,
					"content": "Gern geschehen, gern geschehen ... Ich werde schließlich dafür bezahlt, da muss ich die Arbeit auch gut erledigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290115
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290115,
					"content": "(*seufz* Sie hat wohl schon wieder alles vergessen, was ich ihr beigebracht habe zu sagen ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290116,
					"content": "Übrigens, da wir schon mal hier sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290117
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290117,
					"content": "(Bitte nicht! Die Stimmung ist so gut, Chefin, lass mich aus der Sache raus!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290118
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290118,
					"content": "Herr Sarin, bring bitte die neueste Reihe von Aufträgen her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290119,
					"content": "Jahoda, such dir einen Auftrag aus, der deiner Meinung nach am ehesten bearbeitet werden muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290120
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290120,
					"content": "Denk gut darüber nach und nimm dir Zeit für die Entscheidung, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290121
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290121,
					"content": "J... Ja, Chefin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290122
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290122,
					"content": "(Urgh ... Ich bin erledigt!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		}
	]
}