			"dialogs": [
				{
					"id": 760680101,
					"content": "Arya. Wie ich sehe, hast du dir bereits eine Gestalt als „Mensch“ ausgesucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680102
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 760680102,
					"content": "Hehe, du siehst genauso aus, wie ich es mir vorgestellt habe, Kanon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680103
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 760680103,
					"content": "Allerdings hätte ich nicht gedacht, dass du für diese süßen kleinen Wesen sogar eine solche Gestalt annehmen würdest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680104
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 760680104,
					"content": "Das ist doch selbstverständlich, Arya. Diese zerbrechlichen Leben vertrauen mir, rufen mich – und ich antworte auf ihre Stimmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680105
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 760680105,
					"content": "Wir wurden geboren, um die Welt zu erhalten. Wenn Lebewesen, die sich „Menschen“ nennen, bereit sind, in unserer Welt zu leben, dann ist es auch unsere vom König auferlegte Mission, ihre Rufe zu erhören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680106
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 760680106,
					"content": "Nun, schließlich hat der König gesagt, dass jedes Lebewesen im Sternenmeer, das mit uns gegen die Dunkelheit kämpft, ein Verbündeter ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680107
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 760680107,
					"content": "Aber darum geht es mir eigentlich gar nicht. Ich hätte nicht gedacht, dass der „Frostmond“ auch so eine emotionale Seite zeigen kann – wirklich süß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680108
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 760680108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680109
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 760680109,
					"content": "... Ich kann sehen, dass deine Sprache bereits von diesen kleinen Menschen beeinflusst wurde, Arya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680110
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 760680110,
					"content": "Ihre Worte sind immer so zweideutig. Verwende sie nicht. Ich kann absolut nicht verstehen, was du mit „süß“ ausdrücken willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680111
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 760680111,
					"content": "Ach, komm schon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680112
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680112,
					"content": "Arya, Kanon, sollte mit diesen Körpern nicht das Erste sein, sich heimlich rauszuschleichen und mit den Leuten dort unten etwas zu unternehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680113
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680113,
					"content": "Sonst war doch die ganze Mühe umsonst! Schnell, bevor uns jemand entdeckt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680114
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680114,
					"content": "Hehe, scheint so, als könnte unsere Liebe hier es kaum erwarten, Kanon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680115
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 760680115,
					"content": "Als sie gerade damit begannen, auf der Erde eine Zivilisation aufzubauen, sagtest du noch: „Dieser Fremde ist nichts Gutes, und seine Schöpfungen sind natürlich genauso.“ Du wolltest nicht einmal einen Blick darauf werfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680116
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 760680116,
					"content": "D... Das war etwas völlig anderes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680117
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680117,
					"content": "Ich finde immer noch, ihr hättet diesen Fremden nicht hereinlassen sollen, aber die Leute an der Oberfläche ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680118
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680118,
					"content": "*seufz* ... Viel Spaß euch. Geht schon, aber bleibt bitte in Aryas Nähe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680119
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 760680119,
					"content": "Hm? Kommst du nicht mit uns, Kanon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680120
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680120,
					"content": "Die Begleiterin des Ankömmlings sagte, sie wolle mit mir über etwas sprechen ... über das Gravitationspotenzial und den Metrik-{RUBY#[D]Regeln der Zeit}Tensor dieser Welt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680121
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 760680121,
					"content": "Istaroth?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680122
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 760680122,
					"content": "Ich glaube, das ist ihr Name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680123
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 760680123,
					"content": "Du solltest dir die Namen anderer wirklich merken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680124
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 760680124,
					"content": "Aber ... vielleicht bilde ich mir das ein, aber ich habe das Gefühl, dass sie diesem Ankömmling gegenüber irgendwie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680125
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 760680125,
					"content": "Ich treffe keine voreiligen Verurteilungen, Arya. Aber ich werde darauf achten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680126
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 760680126,
					"content": "Dann ist ja gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680127
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 760680127,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680128
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680128,
					"content": "Hehe, ach nichts. Dann gehen wir jetzt, Kanon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680129
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 760680129,
					"content": "Keine Sorge, Sonett und ich bringen dir ein Geschenk mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680130
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 760680130,
					"content": "... Ich brauche keine Geschenke. Passt nur auf, dass ihr nicht erkannt werdet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kanon"
				}
			]
		}
	]
}