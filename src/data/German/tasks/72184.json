				"objectNames": [
					"Rie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721840201,
					"content": "Hallo. Was kann ich für dich tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840202
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840202,
					"content": "Über die Pizza im „Restaurant Kiminami“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840203
					]
				},
				{
					"id": 721840203,
					"content": "Oh, die Pizza, von der du geredet hast, schmeckt wirklich gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840204
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840204,
					"content": "Aber ... wie soll ich das sagen, ich bin nicht daran gewöhnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840205
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840205,
					"content": "Ich persönlich habe mir gedacht, wenn man ein paar lokale Inazuma-Zutaten in diese Art von Pizza einbauen könnte, wie z. B. Lavendelmelone oder so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840206
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840206,
					"content": "Vielleicht wird diese Pizza bei allen beliebter sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rie"
				}
			]
		},
		{
			"id": 7218403,
			"completionStepIds": [
				7218403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7218403",
							"2"
						],
						"stepId": 7218403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kiminami Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721840301,
					"content": "#{F#Reisende}{M#Reisender}, du bist ja wieder da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840302
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840302,
					"content": "Wie sieht es aus? Hast du eine Antwort bekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840303
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840303,
					"content": "Über die Rückmeldungen unserer Gäste ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840304
					]
				},
				{
					"id": 721840304,
					"content": "Eine Pizza, die mit Lavendelmelone zubereitet wird ... Das ist nicht allzu kompliziert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840305
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840305,
					"content": "Der Rest der Zutaten wird wie üblich zubereitet ... Nun, da es heißt „einige lokale Zutaten aus Inazuma einarbeiten“, füge ich einfach ein wenig andere Zutaten hinzu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840306
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840306,
					"content": "Nun, Meereslackporling? Naku-Kraut? Hmm ... Wie wäre es mit dem Leuchtpilz ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840307
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840307,
					"content": "Also, kann ich helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840308
					]
				},
				{
					"id": 721840308,
					"content": "Oooh! Es tut mir leid, ich habe nur überlegt, welche Zutaten ich da reinpacken soll! Mal sehen, ich glaube, es ist nicht mehr viel Lavendelmelone im Laden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840309
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840309,
					"content": "#{F#Reisende}{M#Reisender}, hol mir bitte eine Lavendelmelone für die Zutaten ... Das sollte alles sein, was noch fehlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840310,
						721840312
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840310,
					"content": "Das mach ich gern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840311
					]
				},
				{
					"id": 721840311,
					"content": "Also dann, bitte, nur eine Lavendelmelone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840312,
					"content": "Suchst du noch weitere Zutaten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840313
					]
				},
				{
					"id": 721840313,
					"content": "Im Laden sind noch ein paar andere Zutaten vorrätig. Bring mir bitte eine Lavendelmelone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				}
			]
		},
