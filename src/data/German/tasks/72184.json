			},
			"dialogs": [
				{
					"id": 721840501,
					"content": "Danke. Diese Zutaten sind genug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840502
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840502,
					"content": "Ich frage mich, wie eine Pizza mit lokalen Zutaten aus Inazuma wohl schmecken würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840503
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840503,
					"content": "Erledigt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840504
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840504,
					"content": "Diese Pizza sieht ... ziemlich gut aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840505
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840505,
					"content": "#Danke für deine Hilfe, {F#Reisende}{M#Reisender}. Bitte nimm dies hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840506
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840506,
					"content": "Ich werde den Geschmack dieser Pizza auf jeden Fall auskosten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840507
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840507,
					"content": "Sobald sie gut genug ist ... sollte sie bald offiziell als neues Produkt eingeführt werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				}
			]
		},
