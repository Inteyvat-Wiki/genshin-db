			"dialogs": [
				{
					"id": 732580201,
					"content": "(Weiterlesen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732580202
					]
				},
				{
					"id": 732580202,
					"content": "#„... Paimon hat mir etwas Neues beigebracht, ich bin sehr froh. Jetzt weiß ich, dass der Zauberspruch nicht ‚Schat‘, sondern ‚Schatz‘ heißt. Nara {NICKNAME} ist sehr stark, {F#sie}{M#er} hat Vanagni ganz leicht besiegt ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580203
					],
					"speakerTitle": "Kritzelig geschriebene Notizen"
				},
				{
					"id": 732580203,
					"content": "#„... Alle lieben sie. {F#Eine goldene}{M#Ein goldener} und eine silberne. Ähnlich wie die große Sonne und der kleine Mond, hell und sanft ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kritzelig geschriebene Notizen"
				}
			]
		},
