			"dialogs": [
				{
					"id": 732580301,
					"content": "(Weiterlesen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732580302
					]
				},
				{
					"id": 732580302,
					"content": "#„... Blumen vorbereitet. Ich habe aber Angst, dass ich sie {M#ihm}{F#ihr} nicht geben kann. Aber Angst ist kein gutes Ding. Wie Arana sagt, wenn man Angst hat, glaubt man an die Kraft der Angst ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580303
					],
					"speakerTitle": "Kritzelig geschriebene Notizen"
				},
				{
					"id": 732580303,
					"content": "„... Utsava-Fest steht vor der Tür. Freunde, die ich lange nicht gesehen habe, sind nach Vanarana zurückgekehrt. Auch Araja ist sehr glücklich. Ich freue mich auch, seine Lücke füllen zu können ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kritzelig geschriebene Notizen"
				}
			]
		},
		{
			"id": 7325804,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303208",
