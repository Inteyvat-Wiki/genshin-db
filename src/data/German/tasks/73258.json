			},
			"dialogs": [
				{
					"id": 732580401,
					"content": "(Weiterlesen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732580402
					]
				},
				{
					"id": 732580402,
					"content": "#„... Sieht gut aus mit der Blütenkrone. {NICKNAME} versteht sich mit allen gut, als wäre {M#er}{F#sie} auch {M#ein}{F#eine} Aranara.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580403
					],
					"speakerTitle": "Kritzelig geschriebene Notizen"
				},
				{
					"id": 732580403,
					"content": "#„Jetzt ruhen sich Nara {NICKNAME} und Paimon aus. Ich verstehe aber immer noch nicht, warum Nara sich ausruhen müssen? Wenn man sich ausruht, kann man keine Erinnerungen mit Freunden schaffen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580404
					],
					"speakerTitle": "Kritzelig geschriebene Notizen"
				},
				{
					"id": 732580404,
					"content": "#„... Bald werden wir den Ashvattha-Baum treffen. Der Ashvattha-Baum wird sicherlich Nara {NICKNAME} und Paimon willkommen heißen. Wir sind alle Kinder des Waldes.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580405
					],
					"speakerTitle": "Kritzelig geschriebene Notizen"
				},
				{
					"id": 732580405,
					"content": "#„Oh ja, im ‚Aranyaka‘ muss es viele Abenteuer von Nara {NICKNAME}, Paimon und uns allen geben.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580406
					],
					"speakerTitle": "Kritzelig geschriebene Notizen"
				},
				{
					"id": 732580406,
					"content": "#„Nachdem Nara {NICKNAME} und Paimon die Bija bekommen und Nara Rana geholfen haben, lesen wir die Geschichten im ‚Aranyaka‘ gemeinsam mit Arana!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kritzelig geschriebene Notizen"
				}
			]
		}
