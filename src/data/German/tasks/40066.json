				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400661701,
					"content": "Tatsächlich wurde er hier wieder eingesperrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400661702,
					"content": "Haha, das ist wie eine Faustregel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661703
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661703,
					"content": "Wir sind wieder in das Labyrinth der Illusion eingetreten. Aber dieses Mal scheint es anders zu sein als beim letzten Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400661704,
					"content": "Die Geschichte von diesem Mal wird erzählt ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400661705
					]
				},
				{
					"id": 400661705,
					"content": "Die Leute sind weniger und die Dekorationen sind nicht so prächtig ... Ja, das sollte es sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661706
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661706,
					"content": "Was ihr saht, sollte der Kaedehara-Klan sein, der im Niedergang begriffen war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661707
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661707,
					"content": "Allerdings warst du in der Illusion wie ein Schatten und anders dazu, wie du jetzt bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400661708,
					"content": "Richtig, ich stimme auch zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661709
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400661709,
					"content": "Verglichen mit dem jetzigen Kazuha war dieses Phantom verwirrter und mit einem schweren Schicksal belastet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661710
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400661710,
					"content": "Es kann in der Tat davon ausgegangen werden, dass es ein schweres Schicksal trägt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661711
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400661711,
					"content": "Das bedeutet, dass ich jetzt erwachsen geworden bin. Es tut mir wirklich leid, dass ihr mein alte Ich gesehen habt, das so unreif ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661712
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661712,
					"content": "Nachdem ich Inazuma verlassen hatte, war mein Leben lange Zeit ein Auf und Ab. Aber es ist keine schlechte Sache, ich habe dabei viel Erfahrungen gesammelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661713
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661713,
					"content": "Es wäre toll, wenn ich auch mein altes Ich sehen könnte. Er wird es verstehen, wenn er mich sieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661714
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661714,
					"content": "Das Leben ist ein langer Weg. Ich muss noch weit herumkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
