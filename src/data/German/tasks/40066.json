						"rawParams": [
							"4006614",
							"2"
						],
						"stepId": 4006614,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 400661401,
					"content": "Das ist sicher Kazuha ... aber er kann uns nicht einmal hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400661402,
					"content": "Es sieht so aus, als wäre es nur ein Phantom. Das war nicht der Kazuha, der mit uns gekommen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
