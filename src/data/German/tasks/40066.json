			]
		},
		{
			"id": 4006606,
			"completionStepIds": [
				4006606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006606",
							"2"
						],
						"stepId": 4006606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kageharu",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400660601,
					"content": "... Schon gut. Du kommst ja gerade rechtzeitig, Kazuha. Was hältst du von meiner Steinschnitzerei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660602
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660602,
					"content": "Raffiniert und lustig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660603
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400660603,
					"content": "Hehe, das ist eine Berglandschaft, die ich aus dem Buch gelernt habe. Es gibt viele hoch aufragende und berühmte Berge in anderen Ländern. Wenn es die Möglichkeit gibt, möchte ich unbedingt auf die Reise gehen und sie besichtigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660604
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660604,
					"content": "Du kannst ja jederzeit loslegen, wenn du willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660605
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400660605,
					"content": "Das kann man nicht sagen. Ich bin heute das Oberhaupt des Klans. Obwohl der Kaedehara-Klan weit von dem Ruhm entfernt ist, den er einst besaß, haben wir heute jedoch nicht weniger zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660606
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660606,
					"content": "Aber ... lohnt es sich wirklich, auf dem Weg der Vätergeneration zu bleiben und alles für das einst gescheiterte Geschäft des Klans zu tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660607
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660607,
					"content": "Ich ... habe es nicht verstanden, Vater.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660608
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400660608,
					"content": "... Ich möchte, dass du dich an eine Sache erinnern sollst, Kazuha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660609
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660609,
					"content": "Der Klan ist zwar wichtig, man sollte aber nicht durch ihn eingeschränkt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660610
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660610,
					"content": "Familien existieren wegen Menschen. Wenn wir selbst unglücklich leben, wie können wir unsere Familie glücklich machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660611
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660611,
					"content": "Die Vergangenheit hat die Familie sehr belastet. Aber es sollte keine Last für zukünftige Generationen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660612
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660612,
					"content": "... Wenn du eines Tages das langweilige Leben satthaben solltest, lass einfach alles stehen und geh auf eine Reise. Denk daran, lass dich nicht vom Leben zurückhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660613
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660613,
					"content": "Alles klar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006611,
			"completionStepIds": [
				4006611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006611",
							"2"
						],
						"stepId": 4006611,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Kaedehara Kageharu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400661101,
					"content": "Entschuldigung, aber ich kann das nicht verstehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661102
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661102,
					"content": "Hast du unsere Vereinbarung vergessen, Kazuha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661103
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661103,
					"content": "Wirst du das alles wirklich aufgeben? Auch wenn ... auch wenn wir es schwer haben, hast du mich noch an deiner Seite. Kann ich dir nicht helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661104
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661104,
					"content": "Als du in meinem Alter warst, hast du schon mit dem Opa Sorgen und Nöte geteilt. Bin ich zu inkompetent und bist du deswegen von mir enttäuscht, oder ist es ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661105
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661105,
					"content": "Kazuha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661106
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661106,
					"content": "... Ach, du hast Gewissensbisse für diese Dinge. Das ist genau der Beweis für mein Versagen als Vater.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661107
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661107,
					"content": "Der Kaedehara-Klan hat zu viel für die Fehler der Vergangenheit bezahlt. Von der Generation deines Urgroßvaters bis jetzt sind wir nicht wirklich aus dem Schatten herausgekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661108
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661108,
					"content": "Das Schmieden von Schwertern ist das Geschäft unserer Familie. Aber denk daran, dass das Geschäft der Familie nicht unbedingt dein Ganzes sein muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661109
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661109,
					"content": "Will das verletzte Tier aus der Falle entkommen, muss es widerwillig die gefesselten Hinterbeine aufgeben. Du denkst, das ist ein Verlust. Aber wenn du die Falle nicht verlässt, sind die Folgen noch tödlicher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661110
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661110,
					"content": "Genug ist genug, Kazuha. Als Familienoberhaupt ist es mir nicht gelungen, die Familie wiederzubeleben und dich zu einem edlen jungen Aristokrat zu machen. Ich bin schon ziemlich glücklich, wenn du mir dafür keine Vorwürfe machst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661111
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661111,
					"content": "Die Schmerzen von Generationen ... sollen heute ein Ende finden. Entlade von jetzt an die Last und hab dein eigenes Leben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661112
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661112,
					"content": "Die Schuld für die Aufgabe des Familiengeschäftes werde ich übernehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661113
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661113,
					"content": "... Vater ... bitte tu das nicht. Diese Schuld darfst du nicht tragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661114,
					"content": "Wenn es so einen Tag gibt, werde ich diese Last auch mit dir teilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661115
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661115,
					"content": "Warte einfach. Früher oder später werde ich die Führungsrolle im Kaedehara-Klan übernehmen. Ich werde mich dann darum kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006614,
			"completionStepIds": [
				4006614
			],
			"beginWay": "TALK_BEGIN_MANUAL",
