			"dialogs": [
				{
					"id": 400660301,
					"content": "Oh, eine neue Sphäre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400660302,
					"content": "Wie beim letzten Mal ist nur Kazuha nicht dabei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660303
					],
					"speakerTitle": "Oz"
				},
				{
