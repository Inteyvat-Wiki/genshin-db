						760830606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830606,
					"content": "Die Fatui haben in Nod-Krai eine Anlage gebaut, die viel zu auffällig war. Sogar die Kuuhenki haben sich gemerkt, wie sie aussieht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760830607,
					"content": "Eine schwebende Anemo-Pilzbestie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830608
					]
				},
				{
					"id": 760830608,
					"content": "Zwar kann ich mir die Körperteile schon vorstellen, aber ist die Pilzkappe der Anemo-Pilzbestie wirklich so rund?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830609,
					"content": "An der Eigenschaft „schwebend“ ist aber nichts verkehrt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830610
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760830610,
					"content": "Die richtige Antwort lautet: das Versuchs- und Konstruktionsbüro zu Kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830611
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760830611,
					"content": "Die Fatui haben in Nod-Krai eine Anlage gebaut, die viel zu auffällig war. Sogar die Kuuhenki haben sich gemerkt, wie sie aussieht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830612
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760830612,
					"content": "Kommt zurück, ihr habt euch wirklich Mühe gegeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760830613,
					"content": "Ein Schirm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830614
					]
				},
				{
					"id": 760830614,
					"content": "Der Griff von diesem Schirm scheint etwas zu kurz zu sein. Bei Regen kann man ihn nicht wirklich gut halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830615,
					"content": "Ein Regenschirm ... sowas benutze ich normalerweise nicht. Wenn es regnet, kann ich doch einfach mit Kuuvahki einen Schild erzeugen, oder nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830616
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760830616,
					"content": "Also kann man den Trick, den du uns beigebracht hast, auch bei Regen verwenden!",
