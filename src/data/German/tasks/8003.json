				"points": []
			},
			"dialogs": [
				{
					"id": 80030401,
					"content": "So, nach all dem Herumrennen landen wir wieder hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030402,
					"content": "Schau dir uns an ... Das letzte Mal sind wir diesem Ort nur mit Mühe entkommen, und jetzt spazieren wir gleich wieder rein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030403,
					"content": "Mann, wir sind sicher die mutigsten Abenteurer in ganz Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 800305,
			"completionStepIds": [
				800310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800310",
							"2"
						],
						"stepId": 800310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030501,
					"content": "Sieht aus, als ob wir hier sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030502
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030502,
					"content": "Eine schaurige, leblose, dunkle Kammer ... Ich verstehe die bösartige Aura, die du zuvor beschrieben hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030503
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030503,
					"content": "Oooh ... So ein schauriger Ort ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030504,
					"content": "Pass gut auf, dass du nicht von der Macht der Entweihten Statue übermannt wirst! Es ist der Abgrundbote, er ist hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030505
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030505,
					"content": "Bruhaha ... Du fühlst richtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030506
					],
					"speakerTitle": "Abgrundbote"
				},
				{
					"id": 80030506,
					"content": "Du bist so nervtötend wie immer, Dainsleif, Feind des Abgrunds!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030507
					],
					"speakerTitle": "Abgrundbote"
				},
				{
					"id": 80030507,
					"content": "Ich spüre, dass deine Seele von furchtbarem Blutvergießen besudelt ist, vielleicht durch deine dunkelsten Albträume. Außer natürlich ... Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030508
					],
					"speakerTitle": "Abgrundbote"
				},
				{
					"id": 80030508,
					"content": "Oh, und noch etwas weitaus Gefährlicheres! Du verströmst den Geruch einer mir bekannten Verderbnis ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030509
					],
					"speakerTitle": "Abgrundbote"
				},
				{
					"id": 80030509,
					"content": "Dann sind wir gleich. Wir beide verheißen Gefahr. Aber die Gefahren von außerhalb des Ordens des Abgrunds müssen eingefangen und eingesperrt werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030510
					],
					"speakerTitle": "Abgrundbote"
				},
				{
					"id": 80030510,
					"content": "Tss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030511
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030511,
					"content": "Es sind deine Worte, die ewig nach Verderbnis stinken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030512
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030512,
					"content": "Zeit, dich zum Schweigen zu bringen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800306,
			"completionStepIds": [
				800311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800311",
							"2"
						],
						"stepId": 800311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030601,
					"content": "Sie sind weg ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030602,
					"content": "Oh, sei nicht allzu betrübt ... Wir werden sie wiederfinden! Sieh es mal positiv, wenigstens haben wir ein paar nützliche Hinweise bekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030603,
						80030605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030603,
					"content": "Ich bin ... nicht betrübt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030604
					]
				},
				{
					"id": 80030604,
					"content": "Echt? Bist du sicher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030607,
					"content": "#Zumindest ist neben den Sieben nun auch Dain ein wichtiger Teil bei der Suche nach {F#deinem Bruder}{M#deiner Schwester}, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030608,
						80030609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030608,
					"content": "Sobald wir in Inazuma sind, dürfen wir nicht vergessen, nach weiteren Hinweisen zu suchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030610
					]
				},
				{
					"id": 80030610,
					"content": "Das stimmt schon. Übrigens, was sie eben gesagt haben, war ziemlich verwirrend ... Hast du das alles verstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030611,
						80030612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030611,
					"content": "Einigermaßen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030613
					]
				},
				{
					"id": 80030613,
					"content": "Oh ... Na ja, dann gehen wir wieder rüber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030614,
					"content": "#Zunächst einmal, der Abgrundbote nannte {F#deinen Bruder}{M#deine Schwester} „Hoheit“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030615,
					"content": "#Es scheint, dass {F#dein Bruder}{M#deine Schwester} den Orden des Abgrunds anführt, selbst der Abgrundbote ist {F#ihm}{M#ihr} zu Diensten. Trotzdem wissen wir nicht sicher, wer der ranghöchste Anführer in der Organisation ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030616,
					"content": "#{F#Dein Bruder}{M#Deine Schwester} sagte auch, dass {F#er}{M#sie} „den Thron verschlingen“ wolle und „gegen das Schicksal in den Krieg ziehen“ würde. Was soll das bedeuten? Könnte es sein, dass {F#er}{M#sie} die Sieben und die sieben Städte vernichten will?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030617,
					"content": "Und weiter ... Es hat sich gezeigt, dass die Monster des Ordens des Abgrunds in Wirklichkeit die ehemaligen Menschen von Khaenri’ah sind, die nach der Zerstörung ihrer Heimat verwandelt wurden. Diese Geschichte ist einfach nur schrecklich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030618,
					"content": "Und Dain ist auch aus Khaenri’ah! Er hat die Zerstörung vor fünfhundert Jahren miterlebt. Aber ... er ist nicht zu einem Monster geworden, und nun bekämpft er den Orden des Abgrunds ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030619,
					"content": "#Also deshalb hat {F#dein Bruder}{M#deine Schwester} gesagt, dass Dain {F#sein}{M#ihr} Feind ist, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030620,
					"content": "Aber ... wenn die Monster des Abgrunds dieselben Menschen sind, die Dain all die Jahre lang beschützte, warum ist der Orden des Abgrunds dann nun sein Feind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030621,
					"content": "#Und wie kann es sein, dass es sich nach all der Zeit, die wir mit der Suche nach {F#deinem Bruder}{M#deiner Schwester} verbracht haben, herausstellt, dass {F#er}{M#sie} auf der Seite des Abgrunds steht? Wie konnte es dazu kommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030622,
						80030623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030622,
					"content": "Wir haben viele neue Fragen, aber wenige Antworten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030624,
					"content": "Stimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030625,
					"content": "#Dann ... dürfen wir uns jetzt nicht verrückt machen lassen, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030626,
					"content": "Unsere Reise ist noch nicht zu Ende, lass uns weitergehen! Zeit, diesen furchtbaren, dunklen Ort zu verlassen und zurück an die Oberfläche zu gehen, wo die Sonne scheint.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030627,
					"content": "#Wenn {F#dein Bruder}{M#deine Schwester} will, dass du „das Ende deiner Reise“ erreichst ... Nun dann, zeige {F#ihm}{M#ihr}, aus welchem Holz du geschnitzt bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030628,
					"content": "#Komm schon, {F#Reisende}{M#Reisender}, gehen wir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030623,
					"content": "Sich darüber den Kopf zu zerbrechen wird nichts lösen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030612,
					"content": "#Ich war zu sehr auf {F#meinen Bruder}{M#meine Schwester} konzentriert, um genau zuzuhören.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030613
					]
				},
				{
					"id": 80030609,
					"content": "Ein weiteres Ziel für unsere Reise.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030610
					]
				},
				{
					"id": 80030605,
					"content": "Du hast recht, Paimon. Es gibt Hoffnung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030606
					]
				},
				{
					"id": 80030606,
					"content": "Ahaa, das ist richtig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030607
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}