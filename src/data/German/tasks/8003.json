			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030101,
					"content": "Dain, du bist da. Hast du Jean getroffen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030102,
					"content": "Ich habe sie zwar gesehen, bin ihr aber absichtlich aus dem Weg gegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030103
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030103,
					"content": "Als Löwenzahnritter und stellvertretender Großmeister hätte sie selbstverständlich einige Bedenken mir gegenüber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030104
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030104,
					"content": "Und wenn ich nicht vorsichtig bin, werde ich vielleicht eines Tages selbst zum Ziel einer ihrer Ermittlungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030105
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030105,
					"content": "Aber nun zurück zum aktuellen Problem ... Ich habe einige der Abgrundtruppen besiegt, aber ich habe keine weiteren Erkenntnisse gewinnen können. Hattest du mehr Erfolg?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030106
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030106,
					"content": "Ich verstehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030107
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030107,
					"content": "Nun denn. Wir können uns mehr oder weniger denken, wo der weltweit erste Pflug gelandet ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030108
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030108,
					"content": "Was? Echt jetzt? Nur aus der Geschichte von Boreas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030109,
					"content": "Diese Angaben in Verbindung mit einer ausführlicheren Auswertung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030110
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030110,
					"content": "Zum Beispiel die „alte Geschichte“, von der du mir erzählt hast, dass du sie in der Kathedrale gehört hast ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030111
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030111,
					"content": "„Der letzte Zorn des Tyrannen“!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030112
					]
				},
				{
					"id": 80030112,
					"content": "Genau, die merkwürdige Geschichte, die dir die junge Schwester erzählt hat, die man lange für einen Fluch gehalten hatte, der von einem verblichenen Tyrannen ausgegangen war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030113,
						80030114,
						80030126
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030113,
					"content": "Die Feuerbälle, die vom Himmel prasselten, waren vermutlich Raketen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030115,
					"content": "Ah, Paimon kapiert es! Also war „Der letzte Zorn des Tyrannen“ in Wirklichkeit nur Raketen, die von dem Pflug abgeschossen wurden, als er aus Wolfenlauf floh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030116,
					"content": "Nachdem er im Kampf mit dem Wolf des Nordens schwer beschädigt wurde, ist er wohl in die Ruinen des alten Mondstadt gelangt und dort geblieben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030117,
					"content": "Und immer, wenn sich jemand näherte ... PENG, PENG, BUMM! feuerte er Unmengen von Raketen ab ... Bis er eines Tages endgültig den Geist aufgab und die Feuerbälle aufhörten, vom Himmel zu regnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030118,
					"content": "Damals haben die Bürger von Mondstadt noch nicht viele Ruinenwächter gesehen, also deuteten sie ihn als den „letzten Zorn des Tyrannen“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030119,
					"content": "So wie es aussieht, müssen wir einen Abstecher zu <color=#00E1FFFF>Dvalins Ruinen</color> machen und das gesamte Gebiet durchkämmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030120,
						80030121
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030120,
					"content": "Nein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030122,
					"content": "Hm? Was meinst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030123
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030123,
					"content": "Ich ... erinnere mich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030124
					]
				},
				{
					"id": 80030124,
					"content": "Äh? Du meinst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030125,
					"content": "Ooh, Paimon erinnert sich auch! Wir sahen diesen verlassenen <color=#00E1FFFF>Ruinenwächter da oben auf dem Turm sitzen</color>, als wir vorher dort waren! Sowas kann man doch nicht vergessen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030121,
					"content": "Brauchst du nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030114,
					"content": "Die damaligen Bewohner von Mondstadt haben die Feuerbälle nicht als das gesehen, was sie waren ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030126,
					"content": "Ehrlich gesagt ist Barbara die Bischöfin ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				}
			]
		},
		{
			"id": 800302,
