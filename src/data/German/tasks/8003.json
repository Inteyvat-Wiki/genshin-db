			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030201,
					"content": "He, kann das sein ...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030202,
					"content": "#{F#Aether}{M#Lumine}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030203
					]
				},
				{
					"id": 80030203,
					"content": "#{NICKNAME} ...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030204,
						80030205
					]
				},
				{
					"id": 80030204,
					"content": "Endlich habe ich dich gefunden!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030206
					]
				},
				{
					"id": 80030206,
					"content": "#Wa... Warte, {NICKNAME} ... {F#Er}{M#Sie} hat gerade einen Angriff gegen den Abgrundboten pariert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030207,
					"content": "#{F#Dein Bruder}{M#Deine Schwester} und der Abgrund ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030208,
					"content": "#{NICKNAME}, warum bist du bei Dain?",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030209,
						80030210
					]
				},
				{
					"id": 80030209,
					"content": "Was?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030211,
						80030212
					]
				},
				{
					"id": 80030211,
					"content": "(Wir waren so lange getrennt ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030213
					]
				},
				{
					"id": 80030213,
					"content": "Ach so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030214,
					"content": "#{NICKNAME}, {F#dein Bruder}{M#deine Schwester} kennt Dain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030216,
					"content": "#{F#Aether}{M#Lumine}, so sehen wir uns wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030217
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030217,
					"content": "#Wa... Was ... passiert denn hier? Dain kennt {F#ihn}{M#sie} auch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030218,
					"content": "#{NICKNAME}, du solltest dich nicht mit diesem Mann zusammentun.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030219
					]
				},
				{
					"id": 80030219,
					"content": "Er ist ... mein Feind.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030220
					]
				},
				{
					"id": 80030220,
					"content": "#Aber {F#Aether}{M#Lumine} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030221,
						80030222
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030221,
					"content": "Warte einen Moment!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030223
					]
				},
				{
					"id": 80030223,
					"content": "...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030224
					]
				},
				{
					"id": 80030224,
					"content": "Aber das muss gesagt werden. Versuche nicht, mich aufzuhalten. Versuche nicht, den Abgrund aufzuhalten.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030225
					]
				},
				{
					"id": 80030225,
					"content": "Dainsleif war das „Schwert des Zwielichts“, einer der königlichen Wachen der letzten Dynastie von Khaenri’ah. Vor fünfhundert Jahren gelang es ihm nicht, die Zerstörung von Khaenri’ah zu verhindern.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030226
					]
				},
				{
					"id": 80030226,
					"content": "Auf ihn wurde der Fluch der Unsterblichkeit gelegt, damit er für immer durch die Wildnis wandert ... und zusieht, wie die Menschen, zu deren Schutz er bestimmt war, zu Monstern des Abgrunds werden.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030227
					]
				},
				{
					"id": 80030227,
					"content": "Du willst damit sagen ... dass Dain von den Khaenri’ah stammt?! Dasselbe Khaenri’ah, welches vor fünfhundert Jahren zerstört wurde?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030228,
					"content": "Und du hast gesagt, dass sich die Menschen in Monster verwandelt haben ... Willst du Paimon etwa erzählen, dass der Orden des Abgrunds nicht nur mit den Khaenri’ah verwandt ist, sondern in Wirklichkeit das Volk der Khaenri’ah selbst ist?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030229,
					"content": "Äh ... und was soll das heißen, dass Dain dein Feind ist? Paimon ist so verwirrt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030230,
						80030231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030230,
					"content": "#Komm doch, {F#Aether}{M#Lumine}, gehen wir nach Hause!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030232
					]
				},
				{
					"id": 80030232,
					"content": "Nach Hause ...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030233
					]
				},
				{
					"id": 80030233,
					"content": "Ja, Zuhause ist da, wo du bist.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030234
					]
				},
				{
					"id": 80030234,
					"content": "Aber ich kann nicht mit dir in die nächste Welt reisen, um ein neues Zuhause zu finden ... jedenfalls noch nicht.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030235
					]
				},
				{
					"id": 80030235,
					"content": "Bis der Abgrund die Throne verwüstet hat, wird mein Kampf mit der himmlischen Ordnung nicht enden ...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030236
					]
				},
				{
					"id": 80030236,
					"content": "Mit der himmlischen Ordnung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030237
					]
				},
				{
					"id": 80030237,
					"content": "#Hör mir zu, {NICKNAME}.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030238
					]
				},
				{
					"id": 80030238,
					"content": "Auch ich bin einmal durch diese Welt gereist. Wenn du wie ich das Ende deiner Reise erreicht hast, dann wirst du die wahrhaftige Natur dieser Welt mit eigenen Augen erkennen.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": []
				},
				{
					"id": 80030231,
					"content": "Du kannst mir das alles später berichten. Lass uns nach Hause gehen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030232
					]
				},
				{
					"id": 80030222,
					"content": "#Hör auf, so komische Sachen zu erzählen, {F#Aether}{M#Lumine}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030223
					]
				},
				{
					"id": 80030212,
					"content": "(Warum fragst du nach etwas, was keine Rolle spielt?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030213
					]
				},
				{
					"id": 80030210,
					"content": "Du meinst ... Dain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030211,
						80030212
					]
				},
				{
					"id": 80030205,
					"content": "Lass uns hier abhauen, es ist zu gefährlich!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030206
					]
				}
			]
		},
		{
			"id": 800303,
			"completionStepIds": [
				800307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800307",
							"2"
						],
						"stepId": 800307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030301,
					"content": "Das ist es, stimmt’s? Gut, dann nutze deinen Elementarblick, um nach dem Auge zu suchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030302,
					"content": "Ooooh ... Also, was hast du gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030303,
					"content": "Hm? ... Nichts? Aber Paimon war so aufgeregt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030304,
					"content": "Was passiert da ... Bist du sicher, dass du es richtig gemacht hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030305,
					"content": "Dies erfordert eine andere Methode.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030306,
					"content": "Die Verwendung des Elementarblicks bei einem Pflug ist sinnlos, da er nicht von den Elementen angetrieben wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030307
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030307,
					"content": "Lasst es mich mal versuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030308
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030308,
					"content": "Erledigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030309
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030309,
					"content": "Ooh! Das ist, das ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030310,
					"content": "Genau das hat der Abgrundbote die ganze Zeit über gesucht – das Auge des weltweit ersten Pflugs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030311
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030311,
					"content": "Alle heutigen Ruinenwächter sind nur noch Nachbildungen dieser Maschine. Als Prototyp war seine Kampffähigkeit nicht begrenzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030312
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030312,
					"content": "„Prototyp“? ...Paimon kennt dieses Wort nicht, ist das noch ein uralter Begriff von den Khaenri’ah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030313,
					"content": "Wie der Orden des Abgrunds schon vermutet hat, wenn dieses Auge in die Hände der Entweihten Statue gelegt wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030314
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030314,
					"content": "Und wenn die Glieder von Osial, dem Herrscher des Wirbels, an der Statue angebracht sind ... dann hat man einen mechanischen Gott.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030315
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030315,
					"content": "Ein neu erschaffener Gott mit der Macht, „die göttlichen Throne von Celestia zu stürzen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030316,
						80030317
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030316,
					"content": "Was für eine außergewöhnliche und gefährliche Operation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030318
					]
				},
				{
					"id": 80030318,
					"content": "Ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030319
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030319,
					"content": "Also ... Was sollen wir mit diesem Auge anfangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030320,
						80030321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030320,
					"content": "Es irgendwo verstecken, wo es niemand findet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030322
					]
				},
				{
					"id": 80030322,
					"content": "Nein. Ich werde es selbst bewachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030323
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030323,
					"content": "Was?! Du?! Dain ... Du tust doch nichts Verrücktes damit, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030324,
					"content": "Du magst an mir zweifeln, aber ich muss dafür sorgen, dass es nicht in die falschen Hände fällt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030325
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030325,
					"content": "Ganz gleich, wo wir es verstecken, sie werden es finden. Und was die Kathedrale des Ordo Favonius angeht, nun, du weißt, ich traue ihnen nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030326
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030326,
					"content": "Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030327,
					"content": "Doch unsere Arbeit ist noch nicht erledigt. Um weiteren Ärger zu ersparen, müssen wir uns auch um die Entweihte Statue kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030328,
						80030329
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030328,
					"content": "Und wie das?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030330
					]
				},
				{
					"id": 80030330,
					"content": "Wir dürfen nicht zulassen, dass die Kathedrale sich da einmischt. Wir sollten es selbst in die Hand nehmen. Und was ich mit „sich darum kümmern“ meine ... ist, sie komplett zu zerstören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030331
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030331,
					"content": "Sie zerstören?! Das ist eine Statue der Sieben! Abgesehen davon, dass sie ein bedeutendes Kulturgut sind, sind sie auch noch göttlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030332,
					"content": "Uff, gut, dass wir Barbara vorher nichts davon gesagt haben. Sonst würde sie jetzt völlig ausrasten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030333,
					"content": "Hmpf ... Verlangen die Sieben denn wirklich, dass ich auf etwas aufpasse, das ihnen gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030334
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030334,
					"content": "Gehen wir zurück zu <color=#00E1FFFF>diesen Ruinen</color> und zerschlagen die umgedrehte Statue. Mit etwas Glück stoßen wir auch auf den Abgrundboten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030335
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030335,
					"content": "Ich werde dafür sorgen, dass er diesmal nicht verschwindet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030329,
					"content": "Kann die Kathedrale sich nicht darum kümmern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030330
					]
				},
				{
					"id": 80030321,
					"content": "Es muss in die Obhut der Kathedrale des Ordo Favonius übergehen werden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030322
					]
				},
				{
					"id": 80030317,
					"content": "Der Orden des Abgrunds muss aufgehalten werden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030318
					]
				}
			]
		},
		{
			"id": 800304,
			"completionStepIds": [
				800308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
