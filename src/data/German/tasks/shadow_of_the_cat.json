				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220450101,
					"content": "Irgendetwas fühlt sich hier nicht richtig an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450102
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450103
					]
				},
				{
					"id": 220450103,
					"content": "#{F#Reisende}{M#Reisender}! Du kommst gerade recht. Ich suche dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450104
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450104,
					"content": "In letzter Zeit habe ich Holzschnitzereien gemacht und ich habe immer das Gefühl, dass ... die resultierenden Holzschnitzereien keine Seele haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450105,
						220450107
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450105,
					"content": "Es sind auch nur Holzschnitzereien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450106
					]
				},
				{
					"id": 220450106,
					"content": "Das kannst du so nicht sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450108
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450108,
					"content": "Hmmm ... Wie soll ich es beschreiben? Einfach ausgedrückt: Die „Seele“, die ich mir wünsche, ist eine Art ... Vitalität.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450109
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450109,
					"content": "Schau her, obwohl die vorläufige Oberpriesterin normalerweise schläft, steht sie gelegentlich auf und wandert umher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450110
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450110,
					"content": "Während sie umherwandert, springt sie gelegentlich herum, stürzt sich auf heruntergefallene Blätter oder streckt ihre Beine aus oder so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450111
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450111,
					"content": "Diese Bewegungen sind die Art von Energie, die ich mir wünsche. Ich denke ... eine Holzschnitzerei, die auf solchen Bewegungen basiert, sollte auch die Art von „Seele“ haben, die ich mir wünsche ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450112,
						220450113
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450112,
					"content": "Dann beobachte sowas doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450114
					]
				},
				{
					"id": 220450114,
					"content": "Oh, ich ... Es ist mir unangenehm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450115
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450115,
					"content": "Ich habe immer das Gefühl, sie zu verärgern, wenn ich neben ihr hocke und sie beobachte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450116
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450116,
					"content": "Du musst ihr sehr nahe stehen, also gehe bitte und mach ein paar Bilder für mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450117,
						220450118
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450117,
					"content": "Alles klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450121
					]
				},
				{
					"id": 220450121,
					"content": "Na gut, bitte bring sie zu mir, sobald du sie hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450118,
					"content": "Wenn ich diese Bewegungen nicht aufnehmen kann ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450119
					]
				},
				{
					"id": 220450119,
					"content": "Schon gut, ich kann diese Art von Bewegungen sowieso zurzeit noch nicht nachstellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450120
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450120,
					"content": "Das Aufzeichnen einiger kleiner Gesten von ihr reicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450121
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450113,
					"content": "Neko ist doch dort drüben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450114
					]
				},
				{
					"id": 220450107,
					"content": "Wonach strebst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450108
					]
				}
			]
		},
