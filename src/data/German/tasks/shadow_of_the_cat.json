			"dialogs": [
				{
					"id": 220450401,
					"content": "Also, hast du die Bilder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450402
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450402,
					"content": "Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450403
					]
				},
				{
					"id": 220450403,
					"content": "Lass mich sehen ... Sie sind super!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450404,
						220450405
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450404,
					"content": "Diese Ausstrahlung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450406
					]
				},
				{
					"id": 220450406,
					"content": "Absolut kein Problem, diese Bilder könnten nicht besser als Referenz verwendet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450407
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450407,
					"content": "Vielen Dank die Hilfe, bitte nimm dies. Ich werde später weiter an meiner Holzschnitzerei üben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450408
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450408,
					"content": "Nicht schlecht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450405,
					"content": "Können diese als Referenz verwendet werden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450406
					]
				}
			]
		},
