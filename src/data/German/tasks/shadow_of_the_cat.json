			"dialogs": [
				{
					"id": 220450301,
					"content": "Was tust du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450302
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220450302,
					"content": "Bilder machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450303
					]
				},
				{
					"id": 220450303,
					"content": "Hmm, wirklich seltsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450304
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220450304,
					"content": "Egal, mach weiter, solange du den Schrein nicht störst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				}
			]
		},
