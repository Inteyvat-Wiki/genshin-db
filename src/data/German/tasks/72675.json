					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750302,
					"content": "Nicht Gold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750303
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750303,
					"content": "Was! Nicht Gold?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750304,
						726750305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750304,
					"content": "Wenn ihr das sagt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750306
					]
				},
				{
					"id": 726750306,
					"content": "Wenn Paimon so darüber nachdenkt, hat Paimon auf den Reisen mit dir zwar viele Kristallschmetterlinge gefangen, aber nie bemerkt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750307,
					"content": "Da ist etwas ... Paimon hat das Gefühl, dass Paimon plötzlich erwachsen geworden ist und einige der Illusionen zerschlagen wurden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750308,
					"content": "Paimon muss auch noch mehr üben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750309
					]
				},
				{
					"id": 726750309,
					"content": "Viel Glück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750310
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750310,
					"content": "He! Du bist der, der üben muss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750311,
					"content": "Trotzdem ist es ein bisschen enttäuschend ... Warum ist der Kristallkern des Geo-Kristallschmetterling nicht golden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750312,
					"content": "Richtig. Der Kristallschmetterling ist golden, warum ist der Kern nicht golden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750313,
						726750314
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750313,
					"content": "Vielleicht sind Kristallschmetterlinge einfach so.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750315
					]
				},
				{
					"id": 726750315,
					"content": "Nun ... es führt kein Weg daran vorbei. Wie auch immer, lass uns wie geplant weitermachen. Zeigen wir Kichiboushi die Alcor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750314,
					"content": "Öh, woher sollte ich denn wissen, dass ihr das nicht wisst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750315
					]
				},
				{
					"id": 726750305,
					"content": "Da kann ich auch nicht viel machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750306
					]
				}
			]
		},
