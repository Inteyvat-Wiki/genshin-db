			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Kichiboushi“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726750601,
					"content": "Nehmen wir Kichiboushi mit auf die Alcor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750602,
					"content": "Wenn das Schiff sinkt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750603
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750603,
					"content": "Wird es nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750604
					]
				},
				{
					"id": 726750604,
					"content": "Wir sind mit dem Schiff nach Inazuma gefahren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750605
					]
				},
				{
					"id": 726750605,
					"content": "Und dann haben wir Ioroi und Kichiboushi kennengelernt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750606,
					"content": "Ah, ich verstehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750607
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750607,
					"content": "Und Kapitän Beidou ist sehr zuverlässig, ebenso wie die Menschen in der Crux. Also ja, dieses Schiff ist der sicherste Ort auf dem Meer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750608,
					"content": "Gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Kichiboushi“"
				}
			]
		},
		{
			"id": 7267508,
			"completionStepIds": [
				7267508
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267508",
							"2"
						],
						"stepId": 7267508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726750801,
					"content": "Seht her! Tolle Aussichten, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750802,
					"content": "Absolut abgefahren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750803
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750803,
					"content": "Es gibt dort so viele Hügel. Was ist das für ein Ort?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750804
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750804,
					"content": "Dort ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750805,
						726750806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750805,
					"content": "Das ist Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750807
					]
				},
				{
					"id": 726750807,
					"content": "Das ist richtig! Das sollte der Yougou-Berg sein. Unterhalb befindet sich der Chinju-Wald.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750808,
					"content": "So weit, Ioroi ist auf der anderen Seite des Meeres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750809
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750809,
					"content": "Hm. Aber wir werden dich in deiner Übung begleiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750810,
					"content": "Ja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750811
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750811,
					"content": "Wohin also als Nächstes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750812,
					"content": "Gibt es Orte, die uns vertraut sind und an denen man gut essen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750813,
						726750817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750813,
					"content": "Paimon denkt nur an das Essen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750814
					]
				},
				{
					"id": 726750814,
					"content": "Gutes Essen, gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750815
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750815,
					"content": "#Siehst du, {NICKNAME}, Kichiboushi weiß es besser. Das Essen aller guten Lebensmittel der Welt ist ebenfalls eine sehr wichtige Übung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750816,
					"content": "Wenn du das nicht verstehst, wird Kichiboushi dich bald einholen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750818,
					"content": "Hach, außerdem ist es anstrengend, auf den Mast zu klettern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750819,
					"content": "Klettern? Du kannst doch fliegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750820
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750820,
					"content": "Lass uns nicht über die Details streiten, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750821,
					"content": "Wie auch immer, das war’s für heute. Lasst mich darüber nachdenken, wohin wir als Nächstes gehen sollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750822,
					"content": "Ja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750817,
					"content": "Ich selbst bekomme nämlich langsam auch etwas Hunger.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750818
					]
				},
				{
					"id": 726750806,
					"content": "Da wohnst du.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750807
					]
				}
			]
		}
	]
}