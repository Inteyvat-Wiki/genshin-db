			"dialogs": [
				{
					"id": 722641401,
					"content": "Viel Spaß beim Üben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641402,
						722641412
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722641402,
					"content": "Gut, solange du glücklich bist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641403
					]
				},
				{
					"id": 722641403,
					"content": "Gelbfell stark. Bumm-Bumm und dickes Rundes weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641404
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722641404,
					"content": "Denn normalerweise wird trainiert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641405
					]
				},
				{
					"id": 722641405,
					"content": "Ich will wie Gelbfell sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641406
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722641406,
					"content": "Also üben und stark werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641407
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722641407,
					"content": "Was macht Kichiboushi, wenn er stark wird?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641408
					]
				},
				{
					"id": 722641408,
					"content": "Sich an Gyoubu Koban rächen, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641409
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722641409,
					"content": "Ioroi wieder ent-steinern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641410
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722641410,
					"content": "Überlass das uns.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641411
					]
				},
				{
					"id": 722641411,
					"content": "Ja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 722641412,
					"content": "Gut, solange du glücklich bist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641413
					]
				},
				{
					"id": 722641413,
					"content": "Juhu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Kichiboushi“"
				}
			]
		},
		{
