			},
			"dialogs": [
				{
					"id": 726750101,
					"content": "Im Gegensatz zu den schneebedeckten Bergen ist es hier nicht kalt. Auch gibt es kein Schnee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750102
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750102,
					"content": "Dies sind die Guyun-Türme! Der Legende nach besiegte Rex Lapis einst diese ... diese ... vielköpfige große Wasserschlange. Wie hieß sie doch gleich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750103,
						726750104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750103,
					"content": "Herrscher des Wirbels?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750105
					]
				},
				{
					"id": 726750105,
					"content": "Ah, ja! Osial, Herrscher des Wirbels! Hier wurde er seinerzeit von der Steinernen Lanze besiegt und unterworfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750106,
					"content": "Wah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750107
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750107,
					"content": "Hehe, klasse, oder? Aber wir haben ihn auch bekämpft! Wir waren im Jadegemach von Ningguang ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750108,
					"content": "Ein goldener Kristallschmetterling!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750109
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750109,
					"content": "Wirklich, hör den Leuten richtig zu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750110,
					"content": "Sieht anders aus als die von Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750111
					]
				},
				{
					"id": 726750111,
					"content": "Er hat vielleicht noch nie welche gesehen, die nicht lila sind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750112
					]
				},
				{
					"id": 726750112,
					"content": "#Nun ... das ist wahr. Dagegen kann Paimon nichts tun. {NICKNAME}, fange einen Kristallschmetterling und zeige ihn ihm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750113,
						726750115,
						726750117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750113,
					"content": "Warum machst du das nicht selbst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750114
					]
				},
				{
					"id": 726750114,
					"content": "Du kannst es besser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750118,
					"content": "Es geht schon, aber ich bekomme nur den Kristallkern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750119
					]
				},
				{
					"id": 726750119,
					"content": "Klasse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750115,
					"content": "Du kannst fliegen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750116
					]
				},
				{
					"id": 726750116,
					"content": "Du kannst aber dennoch besser Schmetterlinge fangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750117,
					"content": "Na gut, na gut ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750118
					]
				},
				{
					"id": 726750104,
					"content": "Osial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750105
					]
				}
			]
		},
