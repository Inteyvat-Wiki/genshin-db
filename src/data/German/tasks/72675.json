					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750403,
					"content": "Und sie ist groß! So groß und auf dem Wasser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750404
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750404,
					"content": "Sie ist so groß, dass sie echt schwer sein muss. Warum geht sie nicht unter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750405
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750405,
					"content": "Weil die Alcor ein Schiff ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750406,
					"content": "Aber ein Schlammschiff sinkt. Ioroi hat davon erzählt. Die Geschichte vom Kaninchen, dem Bakedanuki und dem Schlammschiff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750407
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750407,
					"content": "Ja, aber der Alcor ist nicht aus Schlamm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750408,
					"content": "Warum sinkt sie nicht, nur weil sie nicht aus Schlamm ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750409
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750409,
					"content": "Kichiboushi redet immer flüssiger ... Aber wie soll Paimon das sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750410,
					"content": "#{NICKNAME}, warum treiben Schiffe auf dem Wasser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750411,
						726750414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750411,
					"content": "Schiffe sind aus Holz, Dendro-Kraft ist stark.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750412
					]
				},
				{
					"id": 726750412,
					"content": "Kann Dendro-Kraft sowas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750413,
					"content": "Hmmm ... Aber warum kann ein Hilichurl mit einem Schild nicht auf dem Wasser schwimmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750416,
					"content": "Ich verstehe es nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750417
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750417,
					"content": "Das macht nichts, wenn Kichiboushi aufwächst und so klug wird wie Paimon, wird er es verstehen können. Warum das Boot schwimmt und warum die verschneiten Berge Schnee haben, das wird alles einen Sinn ergeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750418,
						726750420,
						726750421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750418,
					"content": "Du weißt es doch auch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750419
					]
				},
				{
					"id": 726750419,
					"content": "He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750422,
					"content": "Wie auch immer, hier ist ein perfekter Blick auf die Alcor ... Machen wir ein Foto für Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750423,
					"content": "Foto! Bild!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750424
					],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 726750424,
					"content": "Ja, das ist richtig! Kichiboushi muss still stehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750420,
					"content": "Es ist in Ordnung, wenn man etwas nicht sofort weiß.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750422
					]
				},
				{
					"id": 726750421,
					"content": "Es ist in Ordnung, wenn man manches nicht weiß.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750422
					]
				},
				{
					"id": 726750414,
					"content": "Der Auftrieb ist größer als die Schwerkraft und so schwimmt das Boot.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750415
					]
				},
				{
					"id": 726750415,
					"content": "So ist es also! Hmm, Paimon versteht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
