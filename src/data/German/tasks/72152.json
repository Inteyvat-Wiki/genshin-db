			},
			"dialogs": [
				{
					"id": 721520101,
					"content": "„... Vor langer Zeit lagerte der große Pirat Rinzou hier stets seine Schätze ab. Die Männer brachten die letzten paar Truhen fort ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520102
					],
					"speakerTitle": "Notiz der Schatzräuber"
				},
				{
					"id": 721520102,
					"content": "„...Rinzou aber war sein Leben lang ein gerissener Bursche und er hat viele Arten von besonderen Symbolen auf der Insel hinterlassen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520103
					],
					"speakerTitle": "Notiz der Schatzräuber"
				},
				{
					"id": 721520103,
					"content": "„... Vielleicht ist das ganze ja nur ein Deckmantel oder es gibt hier wirklich einen Schatz. Wir aber werden es nur herausfinden, wenn wir hingehen und selbst nachsehen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520104
					],
					"speakerTitle": "Notiz der Schatzräuber"
				},
				{
					"id": 721520104,
					"content": "„Wir haben ein paar dieser Symbole entdeckt. Nun, was du heute kannst besorgen ... Wir machen uns besser auf den Weg und graben Rinzous gesamten Schatz aus!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520105
					],
					"speakerTitle": "Notiz der Schatzräuber"
				},
				{
					"id": 721520105,
					"content": "Oh, das ist ... echt lang ... Paimon wird keine Lust haben, irgendetwas davon zu lesen, das nichts mit Schätzen zu tun hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721520106,
					"content": "Warte mal ... Schätze?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721520107,
					"content": "#Na komm, {F#Reisende}{M#Reisender}, ein Schatz erwartet uns! Wir können nicht zulassen, dass uns die Schatzräuber zuvorkommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}