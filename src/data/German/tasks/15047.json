				]
			},
			"dialogs": [
				{
					"id": 150470101,
					"content": "Ihr seid es! Es sieht so aus, als ob das Personal für eine Weile ausfällt, aber ich habe herausgefunden, wie man es benutzt ... Ich meine, wie man den Test abschließt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470102,
					"content": "Gut, dann zeig uns, wie es geht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470103,
					"content": "Im Grunde fährt eine Person das Tourboot, während die andere dem Saurier-Mitarbeiter Signale gibt. Ziel ist es, das Boot sicher an sein Ziel zu bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470104
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470104,
					"content": "#Ich bin also ziemlich zuversichtlich – denn wenn es um Zusammenarbeit geht, sind {NICKNAME} und ich unschlagbar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470105
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470105,
					"content": "Ach wirklich? Denn wenn es ums Segeln geht, sind es meistens die, die große Töne spucken, die kentern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470106,
					"content": "Ooh, Paimon, sag so was nicht! Das bringt Unglück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470107,
					"content": "Na gut, na gut ... Dann wünscht Paimon euch ... gute Fahrt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470108,
					"content": "Hehe, das versteht sich von selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470109,
					"content": "Ich habe eigentlich wirklich Lust, mit dem Boot zu fahren. Ich bin harte Surf-Herausforderungen gewöhnt, also wird etwas anderes sicher auch Spaß machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470110,
						150470111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470110,
					"content": "Ich habe den Wellenreiter auch irgendwie satt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				},
				{
					"id": 150470112,
					"content": "Siehst du, wir sind bereits perfekt aufeinander abgestimmt! Das ist doch der Beweis für unsere Verbundenheit, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470113,
					"content": "Ich kann es kaum erwarten, meinen Kugelfisch-Badeanzug aufzupumpen und direkt auf das Tourboot zu hüpfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470111,
					"content": "Ich kümmere mich um die Signale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				}
			]
		},
		{
