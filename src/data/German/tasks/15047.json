					}
				]
			},
			"dialogs": [
				{
					"id": 150470401,
					"content": "... Oh, die Anlagen hier sind also noch im Bau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470402
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470402,
					"content": "Seht mal, da ist ein Iktomisaurier-Mitarbeiter! Sollen wir ihn um Hilfe bitten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470403,
					"content": "Hallo! Kannst du uns helfen, das hier zu bauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470404
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470405
					],
					"speakerTitle": "Junger Iktomisaurier"
				},
				{
					"id": 150470405,
					"content": "Platzieren ... hier ... und ... bauen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470406
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470406,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470407
					],
					"speakerTitle": "Junger Iktomisaurier"
				},
				{
					"id": 150470407,
					"content": "Sieht nicht so aus, als ob er es versteht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470408,
					"content": "Ja ... Hm, was sollen wir jetzt tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470409
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470409,
					"content": "... Moment, mir ist gerade etwas eingefallen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470410
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470410,
					"content": "*quietsch*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470411
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470411,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470412
					],
					"speakerTitle": "Junger Iktomisaurier"
				},
				{
					"id": 150470412,
					"content": "*quietsch*! *quietsch*! *quietsch*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470413
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470413,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470414
					],
					"speakerTitle": "Junger Iktomisaurier"
				},
				{
					"id": 150470414,
					"content": "Ha, gar nicht ... Wenigstens wissen wir jetzt, dass er nicht Koholasaurier-Sprache sprechen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470415
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470415,
					"content": "Warum können wir nicht einfach ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470416
					]
				},
				{
					"id": 150470416,
					"content": "He, ich habe eine andere Idee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470417
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470417,
					"content": "Was ist denn jetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470418,
					"content": "Ich habe einmal gehört, wie Ifa erwähnte, dass Iktomisaurier auf Leuchthornpilze abfahren. Und ratet mal, was ich zufällig bei mir habe ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470419
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470419,
					"content": "Das wird absolut funktionieren! Wenn er das erst einmal gegessen hat, werden wir uns total verstehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470420
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470420,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470421
					],
					"speakerTitle": "Junger Iktomisaurier"
				},
				{
					"id": 150470421,
					"content": "Man kann wirklich nicht zu viel einpacken, wenn man auf eine lange Reise geht ... Kachina hat genau richtig gehandelt. Danke, Kachina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470422
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470422,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470423
					],
					"speakerTitle": "Junger Iktomisaurier"
				},
				{
					"id": 150470423,
					"content": "Äh, aber es gibt keine Anzeichen dafür, dass er anfängt zu verstehen, was wir sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470424,
					"content": "Was für ein Desaster ... Tag eins, und das war’s mit meinem Traum, alle Herausforderungen in der Wellen-Bucht zu meistern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470425
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470425,
					"content": "#{NICKNAME}, {F#große Heldin}{M#großer Held}, hast du eine Idee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470426,
						150470427
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470426,
					"content": "Nun, es gibt immer eine Möglichkeit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470428
					]
				},
				{
					"id": 150470428,
					"content": "Sehr gut, versuchen wir das! Danke, und entschuldigt den Ärger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470427,
					"content": "Ich werde einen anderen Iktomisaurier holen, um zu helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470428
					]
				}
			]
		},
