			"dialogs": [
				{
					"id": 150470801,
					"content": "Uff, sieht aus, als wären wir alle fertig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470802
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470802,
					"content": "Ich danke dir! Ohne deine Hilfe hätte ich es nicht geschafft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470803
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470803,
					"content": "Darf ich dich noch mal streicheln? Oh, du bist so süß ... Du bist der Beste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470804
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470804,
					"content": "!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470805
					]
				},
				{
					"id": 150470805,
					"content": "Ähm ... Mualani, es ist wohl an der Zeit, dass Paimon ihn zurückbringt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470806,
					"content": "#Oh, sicher. Ich werde hier warten, falls {NICKNAME} in der Zwischenzeit zurückkommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470807
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470807,
					"content": "So bezaubernd! Vielleicht sollte ich Oma dazu bringen, mir etwas Iktomisaurier-Sprache beizubringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470808
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470808,
					"content": "#He, {NICKNAME}. Wie geht es deinem Magen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470809
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470809,
					"content": "Alles in Ordnung, danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470810
					]
				},
				{
					"id": 150470810,
					"content": "Gut, das zu hören. Oh, du wirst es nicht glauben – du hast gerade den süßesten Iktomisaurier aller Zeiten verpasst! Im Ernst, er war so niedlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470811
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470811,
					"content": "Da bekomme ich fast Lust, eine Weile bei den Meistern des Nachtwinds zu bleiben, nur damit ich noch mehr Leuchthornpilze pflücken und mich mit ihnen anfreunden kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
