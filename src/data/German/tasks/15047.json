			"dialogs": [
				{
					"id": 150470501,
					"content": "Du kehrst zurück, nachdem du einen Iktomisaurier übernommen hast ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150470502
					]
				},
				{
					"id": 150470502,
					"content": "Mualani, wir sind zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470503,
					"content": "!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470504
					]
				},
				{
					"id": 150470504,
					"content": "#Oh, hallo! Ah, bist du ja süß! Warte, wo ist {NICKNAME} hin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470505
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470505,
					"content": "#Äh, {M#er}{F#sie} ... {M#Sein}{F#Ihr} Magen fing plötzlich an verrücktzuspielen und dann ist {M#er}{F#sie} zur Toilette gerannt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470506,
					"content": "(Im Ernst, Paimon, das ist so eine lahme Tarngeschichte. Egal, Hauptsache Mualani kauft sie uns ab ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470507
					]
				},
				{
					"id": 150470507,
					"content": "!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470508
					]
				},
				{
					"id": 150470508,
					"content": "Meine Güte, bist du freundlich! Willst du einen Leuchthornpilz probieren? Hier, nimm etwas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470509
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470509,
					"content": "(In der Tat ein seltsamer Geschmack. Dick, saftig und erstaunlich lecker für einen Pilz ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470510
					]
				},
				{
					"id": 150470510,
					"content": "!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470511
					]
				},
				{
					"id": 150470511,
					"content": "Haha, schön, dass es dir gefallen hat! Hier, sie gehören alle dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470512
					],
