			},
			"dialogs": [
				{
					"id": 130320901,
					"content": "Oh ... Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320902,
					"content": "Wachen wir schon auf? Aber Paimon will noch mehr sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320903,
					"content": "Die von uns herbeigerufenen Sternschnuppen flogen vom Boden empor ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320904
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320904,
					"content": "Sie waren genau wie ein Feuerwerk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320905
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320905,
					"content": "Ah! Ich hätte mir das für immer anschauen können. Das war der echteste, größte und magischste Traum, den ich jemals hatte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320906
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320906,
					"content": "Paimon sieht das auch so! Paimon hätte aber nicht gedacht, dass du uns direkt in den Sternregen führst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320907,
					"content": "Hehe. Ehrlich gesagt, habe ich darüber gar nicht nachgedacht. Ich dachte nur daran, dass es eine Schande wäre, wenn wir es unversucht ließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320908,
						130320909
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320908,
					"content": "Yoimiya, du ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320910
					]
				},
				{
					"id": 130320909,
					"content": "Du wusstest bereits, dass es ein Traum war.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320910
					]
				},
				{
					"id": 130320910,
					"content": "Ihr kennt mich doch. Mir ist es egal, ob unsere Erlebnisse real oder ein Traum waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320911
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320911,
					"content": "Dennoch sollte ich euch beiden wirklich danken. Ihr habt einen Notfallplan entwickelt, weil ihr wusstet, dass der Sternregen kaum zu sehen ist, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320912
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320912,
					"content": "Macht euch keine Sorgen, ich habe es so, so sehr genossen. Ich glaube, das ist das beste Geschenk, was ich jemals bekommen habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320913
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320913,
					"content": "Na toll, das ist gut. Paimon hatte die Befürchtung, dass du wütend wärst, wenn du die Wahrheit erfahren würdest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320914,
					"content": "Warum sollte ich das? Ich habe von den so hilfsbereiten, süßen Aranara geträumt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320915
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320915,
					"content": "Ich habe davon geträumt, dass wir auf großen Pilzen herumgerannt und gesprungen sind, und dass wir den Urstein auf eine unerwartete Art und Weise fanden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320916
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320916,
					"content": "Und als ich dachte, dass ich aus dem Traum erwacht bin, war der nächste Teil sogar noch besser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320917
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320917,
					"content": "Aus ihrem Herzen holte Avin eine Urstein-Brille hervor! Wir haben Sternschnuppen gesehen, die vom Boden aus gen Himmel emporstiegen, und wir sind sogar eins mit den Sternschnuppen geworden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320918,
						130320919
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320918,
					"content": "Wir waren in einem Traum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320920
					]
				},
				{
					"id": 130320919,
					"content": "Wer sagt denn, dass wir aufgewacht sind?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320920
					]
				},
				{
					"id": 130320920,
					"content": "Das stimmt. Träume selbst können imaginär sein, doch ihre einzigartigen Erfahrungen sind real.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320921
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320921,
					"content": "Wenn wir uns nur darauf konzentriert hätten, was Wahrheit und Fiktion ist, dann hätten wir all die Schönheit und Emotionen verpasst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320922
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320922,
					"content": "Hehe, du kannst wirklich gut mit Worten umgehen. Paimon wird dich in „Paimons Liste der besten Freunde“ ein paar Plätze weiter nach oben befördern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320923,
					"content": "Es gibt also eine Bestenliste ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320924
					]
				},
				{
					"id": 130320924,
					"content": "Ach übrigens ... Die Aranara mögen es ni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320925,
					"content": "Stimmt ja, sie waren so niedlich! Wir müssen uns unbedingt bei den wundervollen Holzfiguren bedanken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320926
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320926,
					"content": "Bei den Holzfiguren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320927,
					"content": "Ja, wenn wir nicht diese Holzfiguren gesehen hätten, dann hätten wir auch nicht von diesen unfassbar niedlichen Aranara geträumt, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320928
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320928,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320929,
						130320930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320929,
					"content": "Yoimiya versteht es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320931
					]
				},
				{
					"id": 130320930,
					"content": "Ich finde sie sogar süßer als die Holzfiguren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320931
					]
				},
				{
					"id": 130320931,
					"content": "Hehe, keine Sorge, ich verstehe. Ich finde sie auch sehr süß, und bin gerne bereit, sie zu beschützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320932
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320932,
					"content": "Es ist so weit. Lasst uns sie nach Hause bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321101,
					"content": "Nachdem ihr Avin nach Hause gebracht habt, verbringt ihr noch ein paar Tage mit Yoimiya in Sumeru.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130321102
					]
				}
			]
		},
		{
			"id": 1303211,
			"completionStepIds": [
				1303211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1303211",
							"2"
						],
						"stepId": 1303211,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yoimiya",
					"Niousha",
					"Avin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130321105,
					"content": "Sumeru ist ein wunderschöner Ort. Ich werde bestimmt wiederkommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321106,
					"content": "Du bist hier stets willkommen. Avin würde sich sehr freuen, dich wiederzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321107
					],
					"speakerTitle": "Niousha"
				},
				{
					"id": 130321107,
					"content": "Ja, ich werde auf dich warten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321108
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130321108,
					"content": "Hahaha, so machen wir das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321109,
					"content": "Yoimiya, bevor du nach Hause gehst, möchte ich dir von meinem neuen Traum erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321110
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130321110,
					"content": "Ich möchte alleine nach Inazuma reisen und dort die Feuerwerksschau sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321111
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130321111,
					"content": "Oh, das klingt ja großartig! Hehe, ich hätte nicht gedacht, dass ich im Urlaub auf neue Kunden stoßen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321112
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321112,
					"content": "Keine Sorge, ich werde für dich die unvergesslichsten Feuerwerksartikel herstellen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321113
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321113,
					"content": "Das gilt auch für euch. Egal wie beschäftigt ihr auf euren Abenteuern auch sein mögt, vergesst nicht in Inazuma einen Halt einzulegen. Ihr seid jederzeit willkommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321114
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321114,
					"content": "Ihr müsst euch unbedingt das vom Sternregen inspirierte Feuerwerk ansehen, wenn es hoch in den Himmel steigt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321115
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321115,
					"content": "Abgemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321116,
						130321118,
						130321120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130321116,
					"content": "Pass auf dich auf, Yoimiya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321117
					]
				},
				{
					"id": 130321117,
					"content": "Werde ich, werde ich! Hehe, du bist so ernsthaft wie eh und je.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321122,
					"content": "Ach ja, übrigens, schau dir das mal an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321123
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321123,
					"content": "Eine Aranara-Holzfigur ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321124
					]
				},
				{
					"id": 130321124,
					"content": "Genau! Ihr habt mir geholfen, diese auszusuchen, und ihr meintet, dass diese mir ähnelt. Ich habe noch eine gekauft – diese hier ist für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321125
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321125,
					"content": "Wann immer du dich niedergeschlagen fühlst, schau sie dir an. Vielleicht muntert sie dich auf. Zumindest wirst du wissen, dass ich dich vollends unterstütze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321126
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321126,
					"content": "Natürlich ist ein persönliches Treffen viel schöner, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321127,
						130321128
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321127,
					"content": "Danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321129
					]
				},
				{
					"id": 130321129,
					"content": "Na dann, ich werde mich auf den Rückweg machen. Ich bin mir sicher, dass wir uns bald wiedersehen werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321130
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321130,
					"content": "Mir hat die Reise, die ihr für mich vorbereitet habt, sehr viel Spaß gemacht. Besser gesagt, bin ich vollkommen beeindruckt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321131
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321131,
					"content": "Egal wohin euch euer Weg führen mag, unsere Freundschaft und ihre Wärme werden euch unterstützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321132
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321132,
					"content": "Also schreitet weiter voran, bis an das Ende eurer Reise, bis an das Ende der Welt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321133
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321133,
					"content": "Tschüs!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321128,
					"content": "Ich werde gut darauf Acht geben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321129
					]
				},
				{
					"id": 130321118,
					"content": "Mögen all deine Tage mit Glück erfüllt sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321119
					]
				},
				{
					"id": 130321119,
					"content": "Jeder Tag, und für immer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321120,
					"content": "Feuerwerke sind vergänglich, doch Freunde bleiben ewig!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321121
					]
				},
				{
					"id": 130321121,
					"content": "W... Warum hast du das gerade herausgeschrien? Das war peinlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "Yoimiya"
				}
			]
		}
	]
}