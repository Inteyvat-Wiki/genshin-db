						],
						"stepId": 1303201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapurva",
					"Avin",
					"Yoimiya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320101,
					"content": "Ähm, Paimon hat eine Frage ... Du hast gesagt, dass sie „unvorbereitet“ ist, was meinst du damit genau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320102,
					"content": "Nara Avin kann sich noch nicht vollständig erinnern. Erinnerungen und Träume sind beide erforderlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320103
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320103,
					"content": "Träume ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320104
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320104,
					"content": "Aber ich werde niemals wieder in der Lage sein, stehen zu können. Selbst wenn ich genesen sollte, könnte es lange dauern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320105
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320105,
					"content": "Solche Bedenken finden hier keinen Platz. Nara Avin, du musst dich erinnern. Deine Träume sind mit deinem Herzen verbunden, nicht mit deinem Körper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320106
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320106,
					"content": "Meinem Herzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320107
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320107,
					"content": "Ich habe dich an die Hand genommen, doch nun muss Nara Avin ihre wertvollen Dinge selbst wiederfinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320108
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320108,
					"content": "Wie? Er ist einfach so verschwunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320109,
					"content": "Anscheinend hat sich der Himmel ein wenig verändert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320110
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320110,
					"content": "Meinem Herzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320111
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320111,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320112
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320112,
					"content": "Hä?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320113,
					"content": "Ich ... kann stehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320114
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320114,
					"content": "Es war überhaupt nicht schwer und es hat sich nicht seltsam angefühlt. Es war wie ... bevor ich erkrankt war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320115
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320115,
					"content": "Warte, das bedeutet also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320116,
					"content": "Dass wir in einem Traum sind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320117
					]
				},
				{
					"id": 130320117,
					"content": "Nicht unser erstes Mal. Ah, kein Wunder, dass Arapurva sagte, dass wir uns keine Sorgen machen sollten ... In diesem Traum kann sich Avin frei bewegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320118,
					"content": "Schaut nur, ich kann stehen! Haha, ich kann stehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320119
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320119,
					"content": "Das ist großartig! Dann können wir uns gemeinsam auf die Suche nach Arashani machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320120
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320120,
					"content": "Na komm schon, wer schneller ist! Mal sehen, wie gut du bist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320121
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320121,
					"content": "Möglicherweise bin ich noch nicht vollständig geheilt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320122
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320122,
					"content": "Was soll’s, los geht’s! Auch gegen eine Erwachsene werde ich verlieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320123
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320123,
					"content": "Ah, und weg sind sie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320124,
					"content": "Hm, alles lief ziemlich glatt. Paimon dachte, sie würde mehr Zeit brauchen, um sich an ihre Beine zu gewöhnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320125,
						130320126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320125,
					"content": "Deshalb wird es auch Talent genannt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				},
				{
					"id": 130320127,
					"content": "Hehe, genau. Lass uns sie einholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320126,
					"content": "Das ist die Kraft eines Wunsches.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				}
			]
		},
		{
			"id": 1303202,
