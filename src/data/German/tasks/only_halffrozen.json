			"dialogs": [
				{
					"id": 205200501,
					"content": "Hast du etwas „Kaltes Gourmetfleisch“ gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200502
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200502,
					"content": "Ja, das hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200503
					]
				},
				{
					"id": 205200503,
					"content": "Großartig! Das ist also „Kaltes Gourmetfleisch“? Ehrlich gesagt sehe ich keinen Unterschied außer der Tatsache, dass es sich kalt anfühlt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200504
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200504,
					"content": "Na ja, solange der Auftrag erfüllt ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200505
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200505,
					"content": "#Danke, {F#Reisende}{M#Reisender}. Ohne dich hätte ich ziemliche Probleme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200506
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200506,
					"content": "Hier, das musst du als Entschädigung nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tommy"
				}
			]
		},
