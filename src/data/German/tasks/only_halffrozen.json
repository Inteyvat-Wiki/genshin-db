			"dialogs": [
				{
					"id": 205200101,
					"content": "#{F#Reisende}{M#Reisender} ... Kannst ... du mir helfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200102
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200102,
					"content": "Was ist los mit dir ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200103
					]
				},
				{
					"id": 205200103,
					"content": "Bitte ... Ich brauche etwas Wärme ... Es ist ... zu kalt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200104
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200104,
					"content": "Oder vielleicht ... einige warme Speisen ... das wäre auch gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200105
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200105,
					"content": "Bitte ... mir ist einfach ... zu kalt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tommy"
				}
			]
		},
