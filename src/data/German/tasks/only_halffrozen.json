			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tommy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205200401,
					"content": "#Puh ... Viel besser. Danke, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200402
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200402,
					"content": "Was bringt dich hierher?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200403
					]
				},
				{
					"id": 205200403,
					"content": "*seufz* Ein Auftrag, was sonst? Ich war die ganze Zeit im Lager wegen eines ziemlich ... kniffligen Auftrags.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200404
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200404,
					"content": "Aber ich wollte nicht ewig dort bleiben, also suchte ich nach einer anderen Beschäftigung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200405
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200405,
					"content": "Der Koch Harris suchte jemanden, der auf dem Berg nach „Kaltem Gourmetfleisch“ sucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200406
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200406,
					"content": "Er meinte, dass ich nur ein kleines gefrorenes Wildschwein suchen müsse und es nicht nötig sei, zu weit den Berg hinauf zu gehen, sodass es überhaupt keine Gefahr gäbe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200407
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200407,
					"content": "Ich dachte, es wäre ganz einfach, also nahm ich den Auftrag an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200408
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200408,
					"content": "Ich habe mich auch vorbereitet. Ich habe meinen Körper ganz allmählich trainiert, mich an die Umgebung des Drachengrats gewöhnt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200409
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200409,
					"content": "Alles, um den Auftrag zu erfüllen, den mir diese Alchimistenfrau gegeben hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200410
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200410,
					"content": "Aber ich habe nicht damit gerechnet, dass ich mich kurz nach Beginn meines Aufstiegs verirren und dabei fast erfrieren würde. Ich hatte Glück, dich getroffen zu haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200411
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200411,
					"content": "Ich bereue nur, dass ... ich meinen Auftrag nicht erfüllen konnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200412
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200412,
					"content": "#{F#Reisende}{M#Reisender}, du scheinst diesen Berg sehr gut zu kennen. Dürfte ich dich bitten, mir einen Gefallen zu tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200413
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200413,
					"content": "Du musst nur eine Portion „Kaltes Gourmetfleisch“ für mich finden. Das ist alles, was ich brauche, um meinen Auftrag zu erfüllen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200414
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200414,
					"content": "Ich helfe dir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200415
					]
				},
				{
					"id": 205200415,
					"content": "Danke. In diesem Fall werde ich die Orte markieren, an denen laut Harris kleine gefrorene Wildschweine auf deiner Karte zu finden sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200416
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200416,
					"content": "Ich werde zum Lager am Bergfuß absteigen und dort auf deine guten Neuigkeiten warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tommy"
				}
			]
		},
