				"points": []
			},
			"dialogs": [
				{
					"id": 701280101,
					"content": "Hmm, diese Flasche ist schwer. Scheint so, als wäre da etwas drin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280102
					],
					"speakerTitle": "Flaschenpost"
				},
				{
					"id": 701280102,
					"content": "„Ein alter Freund von uns kam gestern mit einer schlechten Kunde vorbei ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280103
					],
					"speakerTitle": "Flaschenpost"
				},
				{
					"id": 701280103,
					"content": "„Ich habe schon lange nichts mehr von dir gehört. Vielleicht hat er recht und ich sollte die Tatsachen akzeptieren.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280104
					],
					"speakerTitle": "Flaschenpost"
				},
				{
					"id": 701280104,
					"content": "„Aber dennoch, solltest du immer noch durch das Land wandern, so hoffe ich, dass du, wenn du das Schreiben erhältst, mir eine Nachricht schicken könntest.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280105
					],
					"speakerTitle": "Flaschenpost"
				},
				{
					"id": 701280105,
					"content": "„Binde deine Insignien an deinen Brief, sodass ich dich daran erkennen kann, wenn die Zeit gekommen ist.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280106
					],
					"speakerTitle": "Flaschenpost"
				},
				{
					"id": 701280106,
					"content": "„Weißt du noch die Uyuu-Pagode? Wir werden uns dort treffen. Du wirst dort Geld für Wein finden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280107
					],
					"speakerTitle": "Flaschenpost"
				},
				{
					"id": 701280107,
					"content": "„Aber wenn du nicht derjenige bist, den ich mit diesem Brief erreichen wollte ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280108
					],
					"speakerTitle": "Flaschenpost"
				},
				{
					"id": 701280108,
					"content": "„Dann bitte, nimm dieses Andenken trotzdem. Vielleicht findest du ja seinen Erstbesitzer für mich. Bitte nimm die Mora als Dank.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flaschenpost"
				}
			]
		}
	]
}