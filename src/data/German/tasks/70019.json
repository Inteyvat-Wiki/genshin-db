			"dialogs": [
				{
					"id": 700190101,
					"content": "Yoyo dala si?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190102
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700190102,
					"content": "Mimi tomo. Mimi mani ye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700190103,
					"content": "Yoyo mani mi? Mi muhe Upa Celi nini. Mi muhe mi nunu si, mi muhe mi nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190104
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700190104,
					"content": "Er sagt, er will die Sonne nicht sehen. Er will einschlafen und für den Rest seines Lebens nie wieder aufwachen. Weiß der Himmel, was ihm so viel Kummer bereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700190105,
					"content": "Biat. Mi muhe <color=#00E1FFFF>celi lata</color>. Mi nunu nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190106
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700190106,
					"content": "Hmm, warum versuchen wir nicht, ihm etwas zu geben, was er will, damit es sich besser fühlt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
