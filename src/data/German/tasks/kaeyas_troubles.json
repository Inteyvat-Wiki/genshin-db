			},
			"dialogs": [
				{
					"id": 4610612,
					"content": "Ich würde gern wissen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610602
					]
				},
				{
					"id": 4610602,
					"content": "Hallo! Weißt du etwas über die Ruinen von Arcadia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610603,
					"content": "Arcadia ... Ich glaube nicht. Entschuldigung, ich bin noch neu in der Gilde und weiß nicht so viel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610604
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 4610604,
					"content": "Ach so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610605,
					"content": "Ihr könnt auch einen Auftrag in der Gilde vergeben. Dann melden sich bestimmt einige Veteranen, die helfen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610606
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 4610606,
					"content": "Nein, nein, nein, nein, nein, das geht nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610607,
					"content": "Sie können nicht riskieren, dass diese Abenteurer von dem Schatz erfahren und ihn uns vor der Nase wegschnappen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610608,
					"content": "Sie hat’s gesagt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610609
					]
				},
				{
					"id": 4610609,
					"content": "Wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610610
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 4610610,
					"content": "Na dann eben nicht. Ich werde die Ohren spitzen und aufpassen, ob ich etwas über euren Schatz, äh, die Ruinen erfahre ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610611
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 4610611,
					"content": "Wunderbar, vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
