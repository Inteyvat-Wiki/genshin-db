			},
			"dialogs": [
				{
					"id": 4610513,
					"content": "Nein, wir wollen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610502
					]
				},
				{
					"id": 4610502,
					"content": "Verzeihung, wir wollen nur wissen, ob du weißt, wo die Ruinen von Arcadia sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610503,
					"content": "Die Ruinen von Arcadia? Es gibt tatsächlich einen Ort, an dem ich noch nicht gewesen bin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610504
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 4610504,
					"content": "Auch der große Stanley weiß es nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610505,
					"content": "Ach, wer braucht schon Arcadia? Ich sollte euch lieber von meinen Abenteuern im Mare Jivari und im Siedequellgefilde erzählen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610506
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 4610506,
					"content": "Wir haben keine Zeit für Geschichten. Falls du wirklich etwas darüber weißt, wäre es eine große Hilfe, wenn du es uns sagen würdest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610507,
					"content": "Als ich damals im Mare Jivari war, gab es nichts als den Tod dort ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610508
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 4610508,
					"content": "Herrje ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610509,
					"content": "Sobald wir den <color=#00E1FFFF>Schatz</color> gefunden haben, wird die Geschichte von der „Schatzsuche in Arcadia“ viel spannender sein als deine ollen Kamellen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610510,
					"content": "Sie hat’s gesagt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610511
					]
				},
				{
					"id": 4610511,
					"content": "Den Schatz? Es gibt eine Schatzsuche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610512
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 4610512,
					"content": "Ach, das bringt nichts. Alles nur Zeitverschwendung. Wir sollten wieder gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
