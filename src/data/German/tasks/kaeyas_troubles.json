			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610404,
					"content": "Püh, so was Langweiliges! Dafür sind wir natürlich nicht hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610405,
					"content": "Wir sind auf der Suche nach einem Schwert, das von Celestia gefallen ist und mit dem schon eine achtköpfige Hexe und eine silberhaarige Seeschlange umgebracht worden sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610407,
					"content": "Das waren eine achtköpfige Seeschlange und eine silberhaarige Hexe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610408
					]
				},
				{
					"id": 4610410,
					"content": "Du hast schon zu viel verraten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610411
					]
				},
				{
					"id": 4610406,
					"content": "Das ist das supertollste Schwert aller Zeiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610407,
						4610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610408,
					"content": "Ja, sag ich doch! Das Ding ist voll der Wahnsinn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610409,
					"content": "Jedenfalls ist alles in Ordnung, solange ich nicht sage, wo der Schatz ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610411,
					"content": "Ach, das macht doch nichts, solange ich nicht verrate, wo der Schatz ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610413,
					"content": "Sie hat’s gesagt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610414
					]
				},
				{
					"id": 4610412,
					"content": "Also gut, Cyrus, weißt du, wo die sogenannten „Ruinen des Verlorenen Arcadia“ sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610414,
					"content": "Ruinen von Arcadia ... Davon habe ich noch nie gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610415
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 4610415,
					"content": "Trotzdem danke für die Informationen! Falls ihr das Schwert doch findet, könnt ihr es mir gern zeigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610416
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 4610416,
					"content": "Hm? Was für Informationen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610429,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
