			"dialogs": [
				{
					"id": 4610801,
					"content": "Oh, ihr seid zurück. Habt ihr Neuigkeiten für mich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610802
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610802,
					"content": "Wir haben überall in der Abenteurergilde herumgefragt, konnten aber keinerlei Anhaltspunkte sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610803,
					"content": "Tja, davon bin ich ausgegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610804
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610804,
					"content": "Was meint Ihr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610805,
					"content": "Ach, ich finde nur, dass es langweilig wird, wenn man einen Schatz ganz ohne Anstrengung findet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610806
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610806,
					"content": "Trotzdem habe ich einige Informationen, die ich euch zukommen lassen möchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610807
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610807,
					"content": "Ich habe jemanden beauftragt, Informationen zu sammeln ... Anscheinend gibt es jemanden, der mehr über die Ruinen von Arcadia weiß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610808
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610808,
					"content": "Wirklich? Wo ist dieser Jemand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610809,
					"content": "Immer mit der Ruhe. Laut der Vereinbarung werden sie einen Informanten kommen lassen, um sicherzustellen, dass niemand zu viel ausplaudert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610810
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610810,
					"content": "Wir werden diese Informantin im Flüsterwald treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610811
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610811,
					"content": "Worauf warten wir dann noch? Wann gehen wir los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610812,
						4610815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610812,
					"content": "Kaeya sollte lieber nicht persönlich hingehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610813
					]
				},
				{
					"id": 4610813,
					"content": "Klug von dir! Du hast es erfasst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610814
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610814,
					"content": "Ich bin eben ein Ritter und dürfte eigentlich nichts mit solchen Dingen am Hut haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610816
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610816,
					"content": "Vielen Dank! Dann kommen wir auch so an die Informationen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610817
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610817,
					"content": "Wenn dabei Kosten entstehen, werde ich sie natürlich nachher für euch übernehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610818
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610818,
					"content": "Hehe, wir sind schon auf dem Weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610815,
					"content": "Paimon und ich, wir werden uns darum kümmern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610816
					]
				}
			]
		},
