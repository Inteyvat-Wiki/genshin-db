						111010503
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111010503,
					"content": "W... Warum fliehst du nicht?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010504
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111010504,
					"content": "Beru nye! Beru nya! Beru nyaaaa!!!",
					"roleType": "TALK_ROLE_NPC",
