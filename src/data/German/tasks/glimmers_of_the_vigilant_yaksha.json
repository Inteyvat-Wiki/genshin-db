			"dialogs": [
				{
					"id": 111010701,
					"content": "Wie ... Warum hat der Passierschein nicht funktioniert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010702
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111010702,
					"content": "Ist die böse Aura dieser Hilichurle etwa stärker geworden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010703
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111010703,
					"content": "Passierschein, was ... Klingt vertraut, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010704,
						111010705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010704,
					"content": "Damit hat man nach Belieben Zutritt zum Jueyun-Karst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				},
				{
					"id": 111010706,
					"content": "Oh, richtig! Das ist ein Erinnerungsstück der Adepten, es muss also noch Spuren ihrer Macht enthalten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010707,
					"content": "Kein Wunder, dass er zuvor diese Monster verscheuchen konnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010708,
					"content": "Wa... Was faselt ihr beiden da? Einer war bloß nicht ausgeruht genug ... die Adeptenkraft muss einen ganz und gar erfüllen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010709
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111010709,
					"content": "Einer hat noch eine weitere Chance ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010710
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111010710,
					"content": "Tja, da kommt noch ein Haufen fieser Hilichurle. Kümmerst du dich dann um die?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010711,
					"content": "Ich ... E... Einer fühlt sich plötzlich nicht so gut. Sicher hat einer die Adeptenkräfte übermäßig strapaziert. Ansonsten hätten diese Schurken keine Chance ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010712
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111010712,
					"content": "*seufz* Also hat er tatsächlich bloß geprahlt, wie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010713,
					"content": "Komm, wir sind dran. Denk dran, die Monster mit deinem Elementarblick aufzuspüren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010705,
					"content": "Er hat den Passierschein also für den Exorzismus genutzt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				}
			]
		},
