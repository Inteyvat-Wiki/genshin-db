					"nextDialogs": [
						111011407
					]
				},
				{
					"id": 111011407,
					"content": "Hehehe! Paimon hofft, dass in Wirklichkeit er selbst ein Adept ist. Seine Exorzismus-Techniken scheinen ja schon echt zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011408,
					"content": "Doch wer viel hofft, kann auch stark enttäuscht werden. Gehen wir also lieber gründlich vor, nur um sicherzugehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011409,
					"content": "Gehen wir zurück zum Gasthaus Wangshu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
