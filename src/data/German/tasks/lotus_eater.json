				"points": []
			},
			"dialogs": [
				{
					"id": 722391301,
					"content": "Nun ... es werden hier einige Namen genannt ... Bandit, Supada no Hiko?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391302,
					"content": "Oh, das sollte ... Supada no Hiko! Könnte das der Name von ihm sein? Lass uns zurückgehen und ihn fragen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7223918,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
