			},
			"dialogs": [
				{
					"id": 722391801,
					"content": "Das Licht kommt aus der Sonne ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391802
					]
				},
				{
					"id": 722391802,
					"content": "Was ist das? Geh weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adonis"
				}
			]
		},
		{
			"id": 7223919,
			"completionStepIds": [
				7223906
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Adonis",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722391901,
					"content": "Hinter der Sonne beginnt die Dunkelheit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391902
					]
				},
				{
					"id": 722391902,
					"content": "Aber das wahre Licht verbirgt sich in unseren Herzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391903
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391903,
					"content": "Puh, ich hatte fast vergessen, wie lange ich das schon nicht mehr gehört habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391904
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391904,
					"content": "Sag mir, guter Genosse, wer hat dich geschickt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391905
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391905,
					"content": "Supada no Hiko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391906
					]
				},
				{
					"id": 722391906,
					"content": "Spartacus? Bist du es?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391907
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391907,
					"content": "Wo ist er? Ich weiß nur, dass er während des Aufruhrs von der Partei der Sonnenkinder gefangen genommen wurde. Seitdem hat man nichts mehr von ihm gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391908
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391908,
					"content": "Er ist am Altar beim Schlangenherzen gefangen ... und in seinem Zustand hat er Angst, dass er nicht mehr herauskommt, deshalb hat er uns gebeten, euch zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391909,
					"content": "Verdammte Sonnenkinder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391910
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391910,
					"content": "Weshalb seid ihr gekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391911
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391911,
					"content": "Er hat uns nur gebeten, eine Nachricht zu übermitteln, er sagt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391912,
					"content": "Kinder, gebt niemals auf, die Hoffnung von Byakuyakoku tragt ihr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391913,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391914
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391914,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391915
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391915,
					"content": "Es tut mir leid ... Es tut mir leid! Lehrer, wir haben dich im Stich gelassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391916
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391916,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391917
					]
				},
				{
					"id": 722391917,
					"content": "Die Widerstandstruppe existiert nicht mehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391918
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391918,
					"content": "Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391919,
					"content": "Nach der Entführung des Lehrers wurde die Führung des Widerstands im Wesentlichen ausgelöscht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391920
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391920,
					"content": "Nur wir, die Schüler, die normalerweise den Lehrern folgen, konnten entkommen, weil wir weit vom Zentrum entfernt waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391921
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391921,
					"content": "Danach flüchteten wir Überlebenden in das Versteck, das wir zuvor vorbereitet hatten, in der Hoffnung, unsere Kräfte neu zu sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391922
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391922,
					"content": "Wir haben brillante Strategen, erfahrene Gelehrte, hervorragende Hexenmeister und zuverlässige Ärzte unter uns gehabt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391923
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391923,
					"content": "Klingt sehr vielversprechend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391924,
					"content": "Wir dachten auch, dass wir uns mit der Zeit zu einer lebensfähigen Kraft reorganisieren könnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391925
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391925,
					"content": "Aber diese brauchen eine Finanzierung ... für jede Aktivität braucht man eine Finanzierung, wir haben alles, nur kein Geld ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391926
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391926,
					"content": "Schließlich wurde ein Vorschlag gemacht: der Verkauf von Perlen der Drachenknochenblume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391927
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391927,
					"content": "Was sind Perlen der Drachenknochenblume?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391928
					]
				},
				{
					"id": 722391928,
					"content": "Es ist eine Frucht, die von der Drachenknochenblume unter besonderen Umständen produziert wird und sehr selten ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391929
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391929,
					"content": "Sie erzeugt ein erfrischendes Aroma, das Ängste lindert und Sorgen vertreibt. Aus diesem Grund wird sie auf dem Markt sehr geschätzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391930
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391930,
					"content": "Ist es wirklich so erstaunlich? Das kann doch Betrug sein, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391931
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391931,
					"content": "Wenn sie einfach nur interessant wäre ... Dummerweise habe ich die Gefahr zuerst nicht erkannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391932
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391932,
					"content": "Ich weiß nicht mehr, woher ich das Rezept hatte, nur dass es uns viel Geld eingebracht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391933
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391933,
					"content": "Alles lief gut ... aber langsam bemerkte ich, dass einige meiner Kameraden anfingen, den Konflikt zu vermeiden und sich weigerten zu kämpfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391934
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391934,
					"content": "Diese Leute wurden mehr und mehr und am Ende des Tages baten sie mich sogar darum, unsere Gruppe zu verlassen, was ich einfach nicht zulassen konnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391935
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391935,
					"content": "Wie konnte das passieren? Ist es, weil sie zu viel Geld mit dem Verkauf von geronnenen Perlen verdient haben, dass sie nicht kämpfen wollen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391948
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391948,
					"content": "Würdest du sagen, es ist die Korruption des Geldes? Nein ... Ich ... Ich weiß es nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391949
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391949,
					"content": "Ich weiß nur, dass der Widerstand nicht weitergehen kann, wenn Menschen, die sich mit der Unterdrückung abgefunden haben, zufrieden sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391936
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391936,
					"content": "Der Zusammenbruch begann auf der Stelle und war unwiderruflich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391947
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391947,
					"content": "Manchmal frage ich mich sogar, ob das Rezept für dieses Zeug von diesen gemeinen Erwachsenen absichtlich an uns weitergegeben worden sein könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391950
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391950,
					"content": "Könnte es sein, dass der Verkauf dieser Dinge auch eine Illusion ist, die von diesen verachtenswerten Menschen geschaffen wurde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391937
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391937,
					"content": "Leider, wenn es der Lehrer gewesen wäre, wie wäre er mit der Situation umgegangen, hätte er alles gleich zu Beginn ausgelöscht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391938
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391938,
					"content": "Tut mir leid, wir konnten nicht die Bürde tragen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391939,
						722391940
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391939,
					"content": "Es tut mir leid, das zu hören ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391941
					]
				},
				{
					"id": 722391941,
					"content": "Ich schäme mich, meinem Lehrer gegenüberzutreten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391942
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391942,
					"content": "Aber wie auch immer, ich danke euch für die Nachricht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391943
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391943,
					"content": "Es gibt nichts, womit ich euch danken könnte, also lasst mich euch das Geheimnis der Perle der Drachenknochenblume verraten, wenn es euch nichts ausmacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391944
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391944,
					"content": "Die besondere Bedingung für ihre Herstellung ist, dass die Drachenknochenblume mit Wasser aus dem Tokoyo Reisen, auch bekannt als Wasser von Lethe, bewässert werden muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391945
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391945,
					"content": "Vielleicht könnt ihr es gegen etwas Geld eintauschen oder natürlich auch für euch behalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391946
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391946,
					"content": "Sei dennoch vorsichtig. Halte den Wunsch in dir wach, weiterzugehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391940,
					"content": "Würdest du deinen Lehrer gern wiedersehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391950
					]
				}
			]
		},
		{
			"id": 7223924,
			"completionStepIds": [
				7223903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 722392401,
					"content": "(Die Schrift auf dem Grabstein ist in zwei Zeilen unterteilt, von denen die erste, die in der Sprache von Byakuyakoku geschrieben ist, unleserlich ist.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392402
					],
					"speakerTitle": "Eine alte Steintafel"
				},
				{
					"id": 722392402,
					"content": "(Die zweite Zeile ist in der üblichen Sprache geschrieben und lautet wie folgt:)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392403
					],
					"speakerTitle": "Eine alte Steintafel"
				},
				{
					"id": 722392403,
					"content": "„Der Ort der Verehrung des gerechten Spartacus, jetzt bekannt als Supada no Hiko. Im Folgenden findest du eine Übersetzung seines sündigen Erlasses. Mögest du der Geschichte gedenken.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392404
					],
					"speakerTitle": "Eine alte Steintafel"
				},
				{
					"id": 722392404,
					"content": "„Der Sohn eines Verräters, Supada no Hiko, hat eine große Armee von Sündern aufgestellt und das Fundament der Nation erschüttert. Jetzt, beim großen Tokoyo Ookami, werde ich ihm die Augen ausstechen und seine Seele zerhacken und ihn für alle Ewigkeit in ein sicheres Gefängnis sperren.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eine alte Steintafel"
				}
			]
		}
	]
}