			"trigger": {
				"objectNames": [
					"Supada no Hiko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722390101,
					"content": "Kinder, gebt niemals auf, in euch steckt noch Hoffnung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390102
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390102,
					"content": "Seid ihr das? Habt ihr es geschafft, Kinder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390103
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390103,
					"content": "Nein, es ist nicht ... Ich fühle es, du bist nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390104
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390104,
					"content": "#{NICKNAME}, er scheint ein Mann zu sein, der nach seiner Erblindung im Schatten zurückgeblieben ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390105,
					"content": "Was auch immer du bist, bitte hilf mir! Hilf mir, die Kinder zu finden, ich habe ihnen etwas zu sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390106
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390106,
					"content": "Wer bist du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390107
					]
				},
				{
					"id": 722390107,
					"content": "Mein Name ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390108
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390108,
					"content": "Ich ... habe meinen Namen vergessen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390109
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390109,
					"content": "Ich erinnere mich nur daran, dass ich mich für Byakuyakoku eingesetzt und für die Hoffnung gekämpft habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390110
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390110,
					"content": "Ich bin auch heute noch im Widerstand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390111
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390111,
					"content": "Aber wogegen rebelliert man in einem unterirdischen Land wie Byakuyakoku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390112,
					"content": "Gegen die schmutzigen Adligen des Tempels natürlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390113
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390113,
					"content": "Sie behaupten, den Willen der Götter zu empfangen und in ihrem Namen zu sprechen, tun dies aber nur, um ihre niederen Wünsche zu befriedigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390114
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390114,
					"content": "Angeblich der Hüter der Sonnenkinder, aber in Wirklichkeit der Herrscher des Landes, im Grunde ein Wurm, der sich auf die Menschen legt und ihr Fleisch und Blut aussaugt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390115
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390115,
					"content": "Sie müssen vernichtet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390116
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390116,
					"content": "Du erinnerst dich so gut an all das, doch selbst deinen eigenen Namen hast du vergessen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390117,
					"content": "Denn so grausam sind sie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390118
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390118,
					"content": "Wegen meines letzten Versagens nahmen sie mich gefangen und sperrten mich in diesem Altar ein, um mich zu foltern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390119
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390119,
					"content": "Es ist ein bösartiges Gefängnis, ich konnte es spüren, meine Seele wurde zerquetscht, etwas Wertvolles ging verloren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390120
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390120,
					"content": "Ich bitte dich, geh und hilf mir, die Kinder zu finden, solange ich mich noch daran erinnere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390121
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390121,
					"content": "Sagt ihnen, gebt niemals auf, in euch steckt noch Hoffnung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390122
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390122,
					"content": "Kinder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390123
					]
				},
				{
					"id": 722390123,
					"content": "Es gibt eine Gruppe junger Menschen, die mir folgen wollen und die sehr intelligent sind. Sie sind meine Schüler und unsere Reservearmee. Ich sehe sie als meine Kinder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390124
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390124,
					"content": "Es war mir unmöglich zu reden, als die bösen Erwachsenen auf jede erdenkliche Weise versuchten, mich zum Reden zu bringen und mich dazu zu bringen, Informationen über meine Kinder preiszugeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390125
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390125,
					"content": "Denn ich weiß, dass die Hoffnung in ihnen liegt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390126
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390126,
					"content": "Paimon geht davon aus, dass sie zu diesem Zeitpunkt alle weg sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390127,
					"content": "Nein, das wird nicht sein! Es sind gute Kinder, auch mit Ambitionen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390128
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390128,
					"content": "Noch nicht einmal ich habe aufgegeben ... Sie müssen noch immer durchhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390129
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390129,
					"content": "Wie soll ich sie finden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390130
					]
				},
				{
					"id": 722390130,
					"content": "Ich erinnere mich definitiv an diese Art von Dingen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390131
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390131,
					"content": "Ich werde dir sagen, wo sie sich verstecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390132
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390132,
					"content": "Aber wenn man sie findet, wie können wir dann erklären, weswegen wir kommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390133,
					"content": "„Wir wurden von einem Onkel aus dem Widerstand geschickt, dessen Namen er vergessen hat“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390134,
					"content": "Nein, das ist nicht genug, ich habe sie gut unterrichtet. Solange ihr euch nicht beweisen könnt, wird man euch nicht vertrauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390135
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390135,
					"content": "Aber jetzt kann ich mich nicht einmal mehr an meinen Namen erinnern, verdammt noch mal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390136
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390136,
					"content": "#{NICKNAME}, dieser ältere Mann scheint ein großer Verbrecher in Byakuyakoku gewesen zu sein. Er sollte in der Geschichte stehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390137,
					"content": "Seine Spur dürfte nicht allzu schwer zu finden sein. Vielleicht gibt es ja eine in der Nähe. Wir können zuerst nach ihr suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390138,
					"content": "Wenn es meinen Namen in der Geschichte gibt, dann hoffe ich, dass er von den Nachfolgern unserer Sache geschrieben wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Supada no Hiko"
				}
			]
		},
