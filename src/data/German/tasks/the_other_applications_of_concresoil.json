			},
			"dialogs": [
				{
					"id": 230091401,
					"content": "Oje schrecklich, was habe ich nur falsch gemacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091402
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091402,
					"content": "Stimmt etwas nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091403
					]
				},
				{
					"id": 230091403,
					"content": "#Ah! Du bist es, {M#Reisender}{F#Reisende} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091404
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091404,
					"content": "Ach, ich will kein Wort mehr darüber verlieren, aber es gibt Probleme mit meinem „verdichteten Lehm“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091405
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091405,
					"content": "Ich weiß nicht, ob es an meinem Rezept liegt oder ob ich die tatsächlichen Gegebenheiten nicht berücksichtigt habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091406
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091406,
					"content": "Viele Kunden, die ihre Küchen mit dem „verdichteten Lehm“ gebaut haben, haben uns von Rissen nach wenigen Tagen berichtet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091407
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091407,
					"content": "Vielleicht ist die Temperatur so hoch, dass einige Substanzen im Lehm einfach nicht mehr funktionieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091408
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091408,
					"content": "Wie auch immer, ich muss diese Risse für sie reparieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091409
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091409,
					"content": "Weil so viele Leute um Reparaturen gebeten haben, hatte ich keine Zeit, den abgekratzten „verdichteten Lehm“ mitzunehmen, also habe ich sie einfach gebeten, ihn in Töpfen aufzubewahren. Hmm, das sind ganz schön viele Töpfe geworden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091410
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091410,
					"content": "#{M#Reisender}{F#Reisende}, bitte hilf mir, den verworfenen „verdichteten Lehm“ in diesem Haus zurückzuholen, während ich zu den anderen gehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091411
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091411,
					"content": "Oje, was um alles in der Welt ist da nur schiefgelaufen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				}
			]
		},
