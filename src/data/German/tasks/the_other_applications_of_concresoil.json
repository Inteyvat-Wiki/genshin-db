						230091802
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091802,
					"content": "#Juhu! Danke sehr, {M#junger Mann}{F#junge Frau}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091803
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091803,
					"content": "Jetzt kann ich „Adri“ machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091804
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091804,
					"content": "„Adri“ bedeutet ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091805
					]
				},
				{
					"id": 230091805,
					"content": "#{M#Junger Mann}{F#Junge Frau}, hat Akim dir nicht davon erzählt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091806
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091806,
					"content": "Ich stelle „Tontopfkrieger“ her. „Adri“ ist der erste und der beste von ihnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091807
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091807,
					"content": "Er ist ein wohlwollender Krieger mit guter Laune. Wenn er als „Tontopfkrieger“ aufwacht, ist das erste, was er tut, sich bei dem Gras unter ihm zu entschuldigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091808
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091808,
					"content": "Seine Fertigkeit ist ... ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091809
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091809,
					"content": "Ich ... Ich habe mich noch nicht entschieden ... aber du erfährst es als Erster, wenn ich es getan habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091810
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091810,
					"content": "Wenn „Adri“ fertig ist, werde ich „Ivar“ zu seinem Gehilfen und „Lasson“ zu seinem Schüler machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091811
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091811,
					"content": "Die drei Jungs ... nein, die drei „Tontopfkrieger“ werden sich auf eine lange, lange Reise begeben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nima"
				}
			]
		},
