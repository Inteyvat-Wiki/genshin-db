				"objectNames": [
					"Akim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230091101,
					"content": "#{M#Reisender}{F#Reisende}! Ein Glück, dass du hier bist. Ich brauchte gerade deine Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091102
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091102,
					"content": "Hast du Fortschritte bei deiner Forschung gemacht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091103
					]
				},
				{
					"id": 230091103,
					"content": "Na ja ... kein großer Fortschritt, aber ein Kunde von mir hat mir ein paar nützliche Tipps gegeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091104
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091104,
					"content": "Er sagt, dass er gerne Blumen züchtet und dass das, was ihm am meisten Sorgen macht, die richtige Blumenerde ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091114
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091114,
					"content": "Sie sollte gut durchlässig sein und über ausreichend Nährstoffe verfügen. Und sie sollte Wasser speichern, aber nicht zu nass sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091105
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091105,
					"content": "Da er wusste, dass ich mit dem „verdichteten Lehm“ solche Fortschritte erzielt hatte, bat er mich, einen „verdichteten Lehm“ für Blumen zu entwickeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091106,
					"content": "Ich fand es eine Recherche wert, also suche ich nach zusätzlichen Materialien, um meinen „verdichteten Lehm“ weiter zu verbessern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091107,
					"content": "Könntest du mir dieses Mal bitte helfen, fruchtbaren Lehm zu finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091108,
					"content": "Ich werde die Stelle mit dem Lehm für dich auf der Karte markieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091109,
						230091110
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091109,
					"content": "Wieso muss das so weit entfernt sein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091111
					]
				},
				{
					"id": 230091111,
					"content": "Ich habe mich umgehört und jemand hat mir davon berichtet. Der Ort ist zwar recht weit entfernt, doch der Lehm dort soll überaus fruchtbar sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091112
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091112,
					"content": "Allerdings ... äh ... sollen sich dort Monster herumtreiben. Daher wage ich nicht, selbst dorthin zu gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091113
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091113,
					"content": "#Und deswegen will ich dich darum bitten, {M#Reisender}{F#Reisende}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091110,
					"content": "Wie hast du diesen Ort gefunden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091111
					]
				}
			]
		},
