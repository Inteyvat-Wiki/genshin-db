					"Akim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230091701,
					"content": "Danke dir. Dann habe ich erst einmal alle Materialien, die ich brauche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091702
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091702,
					"content": "Gib mir einen Moment, während ich den „verdichteten Lehm“ mische ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091703
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091703,
					"content": "Akim beginnt den Lehm zu mischen ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230091704
					]
				},
				{
					"id": 230091704,
					"content": "#So, es ist geschafft, {M#Reisender}{F#Reisende}. Bitte bring den Lehm zu Nima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091705
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091705,
					"content": "Er hat schon lange auf den Lehm gewartet. Er kann es bestimmt kaum noch erwarten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091706
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091706,
					"content": "Dieses Kind ist ... ja ... ungewöhnlich fantasievoll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091707
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091707,
					"content": "Nima hat mir erzählt, dass er eine Truppe von sprechenden „Tontopfkriegern“ machen wollte. Sie sollen alle sprechende Tontöpfe sein, die herumrollen und damit Gegner ausschalten können und alle möglichen magischen Fertigkeiten haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091708
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091708,
					"content": "Die Kraft dieser „Tontopfkrieger“ ändert sich mit den Materialien, die in ihren „Topfkörpern“ stecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091709
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091709,
					"content": "Er hat diesen Tontopfkriegern sogar einen Namen gegeben, die A... Nun, vergiss es, ich weiß es nicht mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091710
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091710,
					"content": "Haha, ich kann zwar nicht wirklich Topfkrieger mit magischen Kräften machen. Aber es ist trotzdem eine interessante Idee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091711
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091711,
					"content": "Also dachte ich, da er so eine neuartige Idee hatte, warum ihm nicht den Lehm als Spielzeug schenken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091712
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091712,
					"content": "Auf diese Weise kann er seine eigenen „Tontopfkrieger“ machen und sie wie ein „Tontopfgeneral“ kommandieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091713
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091713,
					"content": "Wie auch immer, hilf mir bitte, diesen Topf mit Lehm zu Nima zu schicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091714
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091714,
					"content": "Wenn seine „Tontopfkrieger“ fertig sind, wird er auch uns vielleicht den Titel eines „Tontopfgenerals“ verleihen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				}
			]
		},
