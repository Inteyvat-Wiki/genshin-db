			"dialogs": [
				{
					"id": 230090201,
					"content": "Ich muss noch mehr Materialien besorgen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090202
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090202,
					"content": "Wie geht es mit deinem „verdichteten Lehm“ voran?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090203
					]
				},
				{
					"id": 230090203,
					"content": "Ausgezeichnet! Es stellt sich heraus, dass dieser Lehm für eine unerwartete Vielzahl von Zwecken verwendet werden kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090204
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090204,
					"content": "Er kann auch zum Töpfern und beim Ausbessern von Rissen in Häusern verwendet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090205
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090205,
					"content": "Mit einer kleinen Anpassung des Mischungsverhältnisses könnte ich mit diesem Lehm sogar Häuser bauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090206
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090206,
					"content": "Aber ... die Materialien sind knapp geworden, weil die Bestellungen für den Lehm in die Höhe geschnellt sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090207
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090207,
					"content": "#Und mir ist die Schleimabsonderung ausgegangen, das wichtigste Material. {M#Reisender}{F#Reisende}, könntest du mir bitte noch drei Portionen Schleimabsonderung bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090208,
						230090209
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090208,
					"content": "Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090212
					]
				},
				{
					"id": 230090212,
					"content": "#Ich bitte dich, {M#Reisender}{F#Reisende}, könntest du bitte noch drei Portionen Schleimabsonderung für mich holen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090209,
					"content": "Und was ist mit anderen Materialien?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090210
					]
				},
				{
					"id": 230090210,
					"content": "Weitere Materialien habe ich über verschiedene Kanäle eingekauft oder andere um Hilfe gebeten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090211
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090211,
					"content": "Aber ich hatte nicht erwartet, dass die Schleimabsonderung so schnell ausgehen würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090212
					],
					"speakerTitle": "Akim"
				}
			]
		},
