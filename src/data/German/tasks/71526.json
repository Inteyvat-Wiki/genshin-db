					}
				]
			},
			"dialogs": [
				{
					"id": 716663001,
					"content": "Onikabuto sind unsere Freunde! So wie Katzen und Hunde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663002
					],
					"speakerTitle": "„Pfötchen des Schreckens“"
				},
				{
					"id": 716663002,
					"content": "Schon wieder ein Kind? Puh, hatten wir das nicht beim letzten Mal schon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663003
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663003,
					"content": "Ja schon, aber Marschall Hanakado ist auch ein Kind und eines der Kinder beim letzten Mal war sogar ziemlich gut. Also ist das Alter nicht maßgeblich für die Fähigkeiten der Käferkämpfer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663004,
					"content": "„Pfötchen des Schreckens“ hat zwar keinerlei Erfahrung im Käferkampf, aber der von ihr gewählte Onikabuto hat die Anmut eines formidablen Kriegers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663005
					],
					"speakerTitle": "„Marschall Hanakado“"
				},
				{
					"id": 716663005,
					"content": "Ich weiß nicht, wovon ihr redet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663006
					],
					"speakerTitle": "„Pfötchen des Schreckens“"
				},
				{
					"id": 716663006,
					"content": "Mein Onikabuto ist ein Geschenk meines Vaters. Er hatte ihn von einem neuen Bekannten, den er zuletzt auswärts kennengelernt hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663007
					],
					"speakerTitle": "„Pfötchen des Schreckens“"
				},
				{
					"id": 716663007,
					"content": "Oho ... Dein Vater ist wohl mit allen Wassern gewaschen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663008,
					"content": "Gut, dann senden wir diesmal Silbermelone die Himmelsbrecherin aus. Wir wollen keine Anschuldigungen wegen Mobbing hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663009
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663009,
					"content": "Hmpf, du sagst es so, als wäre Paimon das schwächste Mitglied in unserem Team ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663010,
					"content": "Trotzdem ist Paimon wahrscheinlich die beste Wahl ... Besonders, weil ihr beiden eine Gefahr für euch selbst und andere darstellt, wenn ihr in Wettkampflaune seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663011,
					"content": "Immer mit der Ruhe, junge Dame! Es ist nur ein Spiel. Es geht ums Vergnügen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7166631,
			"completionStepIds": [
				7152603
			],
