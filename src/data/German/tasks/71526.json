					}
				]
			},
			"dialogs": [
				{
					"id": 716663101,
					"content": "Uii ... Das hätte Paimon beinahe versemmelt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663102,
					"content": "Ich hätte fast einen Herzanfall bekommen! Der kleine Fiesling ist heftig! Sogar ich hätte es schwer gehabt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663103,
					"content": "Wie bist du so verdammt gut darin geworden, ohne einen Lehrer? Sind alle, die aus Liyue stammen, geborene Krieger, oder was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663104,
					"content": "So spielen also die Onikabuto miteinander? Jetzt verstehe ich es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663105
					],
					"speakerTitle": "„Pfötchen des Schreckens“"
				},
				{
					"id": 716663105,
					"content": "Habt ihr Zeit für eine weitere Runde? Ich würde euch auch gern beim Spielen zusehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663106
					],
					"speakerTitle": "„Pfötchen des Schreckens“"
				},
				{
					"id": 716663106,
					"content": "Es sieht so aus, also hätte „Pfötchen des Schreckens“ den Dreh raus ... Beängstigend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663107,
					"content": "He, Kuhhirte! Wenn du über dieses Talent verfügen würdest, hättest du vermutlich schon lernen können, wie man mit Krustentieren kommuniziert, indem du einfach zuhörst, wie Guoba mit Kristall-Luftwirbel spricht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663108,
					"content": "Hahaha ... Ja, schön wär’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
