					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290101,
					"content": "Puh ... endlich kann ich zurück ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290102
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290102,
					"content": "Gehst du bald?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290103
					]
				},
				{
					"id": 200290103,
					"content": "Oh, du bist es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290104
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290104,
					"content": "Ja, ich habe erst kürzlich von meinen Vorgesetzten den Befehl erhalten, nach Snezhnaya zurückzukehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290105,
					"content": "Die sagten so etwas wie ... Ich bin zu einem anderen Exekutivbeamten unter den Elf versetzt worden und muss eine Zeit lang nicht mehr in Mondstadt bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290106,
					"content": "Ich weiß nicht, zu wem ich versetzt wurde, aber lass es bitte nicht „Scaramouche“ sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290107
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290107,
					"content": "Wann gehst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290108
					]
				},
				{
					"id": 200290108,
					"content": "Haben sie nicht gesagt. Wenn ich fertig gepackt habe, soll ich los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290109,
					"content": "Ach, endlich kann ich dieses Drecksloch verlassen und muss nicht jeden Tag die leeren Blicke der Ordensschwestern ertragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290110
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290110,
					"content": "#Oh ja, {F#Reisende}{M#Reisender}, wir arbeiten schon so lange zusammen, tu mir einen letzten Gefallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290111,
					"content": "Wie wäre es, wenn du mir einen Gefallen tust und ich dich dafür bezahle? Wie immer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290112,
						200290113
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290112,
					"content": "Welche Art von Geschichte willst du jetzt erzählen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				},
				{
					"id": 200290114,
					"content": "Hahahaha, ich habe dir alle „Fatuigeschichten“ erzählt, die ich dir hier erzählen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290115
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290115,
					"content": "Wenn du mir diesmal einen Gefallen tust, werde ich dich auf jeden Fall mit echtem Geld bezahlen. Wie wäre das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290116
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290116,
					"content": "Es sei denn, du willst die Märchen hören, die ich Lily erzählt habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290117,
						200290118
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290117,
					"content": "Wie soll ich helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290120
					]
				},
				{
					"id": 200290120,
					"content": "Nun ... der Gefallen, um den ich dich dieses Mal bitten möchte, hat auch mit Lily zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290121
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290121,
					"content": "Abgesehen von dir ist Lily wohl das einzige Kind in ganz Mondstadt, das bereit ist, mir, dem „bösen Fatuus“, zuzuhören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290122
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290122,
					"content": "Wenn ich gehe, werde ich wohl keine Gelegenheit mehr haben, nach Mondstadt zurückzukehren ... Ich wollte Lily nur ein letztes Geschenk zur Erinnerung machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290123
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290123,
					"content": "Aber du weißt, wie viele leere Blicke ich ernten würde, wenn ich allein einkaufen ginge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290124,
					"content": "#Deshalb hilf mir bitte, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290125
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290125,
					"content": "Geh einfach rüber zu Marjorie und hilf mir, zu sehen, was für ein Geschenk für ein kleines Kind passt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290118,
					"content": "Du spielst noch mit Lily?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290119
					]
				},
				{
					"id": 200290119,
					"content": "Ab und zu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290120
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290113,
					"content": "Von Geschichten der Fatui hast du einige ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				}
			]
		},
		{
			"id": 2002902,
			"completionStepIds": [
				2002902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
