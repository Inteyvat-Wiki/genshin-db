						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ängstlicher Schuster"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290501,
					"content": "#Danke, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290502
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 200290502,
					"content": "Warum sind diese Monster so hinter mir her? Sie lassen nicht von mir ab, obwohl ich hierher gelaufen bin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290503
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 200290503,
					"content": "Bist du hier, um Wolfshaken zu pflücken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290504
					]
				},
				{
					"id": 200290504,
					"content": "Was? Ja, das ist ein Auftrag von Marjorie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290505,
						200290507
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 200290505,
					"content": "Könnte dich denn nicht jemand begleiten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290506
					]
				},
				{
					"id": 200290506,
					"content": "Wie könnte jemand mit mir an einem Auftrag vom Kaliber des „Pflanzensammelns“ arbeiten wollen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290508
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 200290508,
					"content": "Ich verstehe zwar die Argumentation, aber Wolfshaken ist nur in Wolfenlauf zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290509
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 200290509,
					"content": "Und die Wolfshaken, die in sicheren Gegenden wachsen, sind längst eingesammelt worden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290510
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 200290510,
					"content": "Wenn ich noch Wolfshaken pflücken will, muss ich tiefer gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290511
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 200290511,
					"content": "Nun, kannst du diese Wolfshaken für mich zu Marjorie bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290512
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 200290512,
					"content": "Ich muss eine Pause machen, ich bin erschöpft von der ganzen Lauferei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 200290507,
					"content": "Alleine sollte man nicht so weit weg laufen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290508
					]
				}
			]
		},
		{
			"id": 2002906,
			"completionStepIds": [
				2002906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2002906",
							"2"
						],
						"stepId": 2002906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Marjorie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290601,
					"content": "#{F#Reisende}{M#Reisender}, hast du Schuster gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290602
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290602,
					"content": "Er hat mich gebeten, dir die Wolfshaken zu bringen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290603
					]
				},
				{
					"id": 200290603,
					"content": "Danke, ich nehme diese Wolfshaken an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290604
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290604,
					"content": "Ich werde Schuster bezahlen, wenn er zurückkommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290605
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290605,
					"content": "Übrigens, du willst ein Geschenk, das für ein Kind geeignet ist, richtig? Einen Moment, bitte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290606
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290606,
					"content": "Marjorie macht das Geschenk ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						200290607
					]
				},
				{
					"id": 200290607,
					"content": "So! Bitte nimm dieses Geschenk an. Danke, dass du mir die Wolfshaken gebracht hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290608
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290608,
					"content": "Kinder werden diese Puppen mit ihrem Duft lieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				}
			]
		},
		{
			"id": 2002907,
			"completionStepIds": [
				2002907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2002907",
							"2"
						],
						"stepId": 2002907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290701,
					"content": "Hast du das Geschenk gekriegt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290702
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290702,
					"content": "Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290703
					]
				},
				{
					"id": 200290703,
					"content": "Oh, du bist sehr fähig. Schauen wir mal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290704
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290704,
					"content": "Huch, was ist das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290705
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290705,
					"content": "Eine schiefe Puppe mit einer so unerklärlichen Färbung ... aber der Geruch ist schön.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290706
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290706,
					"content": "Kann man das wirklich einem Kind geben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290707,
						200290708
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290707,
					"content": "Das hat Marjorie empfolen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290710
					]
				},
				{
					"id": 200290710,
					"content": "In Ordnung, es ist ein gutes Geschenk. Aber wo soll ich diesen Brief hinlegen ... Oh, ich lege ihn einfach unten hin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290711,
						200290712
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290711,
					"content": "Hast du Lily geschrieben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290713
					]
				},
				{
					"id": 200290713,
					"content": "Das ist nichts, das ist alles ein bisschen Unsinn, also lass es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290714
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290714,
					"content": "Gut, hier ist das Geschenk, gib es Lily von mir. Sie sollte <color=#00E1FFFF>in der Nähe des Platzes</color> sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290715
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290715,
					"content": "Verdammt, wenn ich Lily direkt ihr Geschenk gegeben hätte, hätte mich Rudolf wahrscheinlich wieder komisch angeguckt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290712,
					"content": "Was steht drin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290713
					]
				},
				{
					"id": 200290708,
					"content": "Dann kauf ein Geschenk in Snezhnaya und schick es her.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290709
					]
				},
				{
					"id": 200290709,
					"content": "Das würde ich gern. Aber wenn ein Fatuus wie ich etwas nach Mondstadt schicken würde, würde der Ritterorden das Paket wahrscheinlich einfach aufhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290710
					],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 2002908,
			"completionStepIds": [
				2002908
			],
