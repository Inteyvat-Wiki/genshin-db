				"objectNames": [
					"Rudolf",
					"Lily"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290801,
					"content": "Lily, sprich nicht mit diesem Fatui-Onkel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290802
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290802,
					"content": "Warum? Er hat mir viele Geschichten erzählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290803
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290803,
					"content": "Lily, dies ist ein Geschenk von Viktor an dich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290804
					]
				},
				{
					"id": 200290804,
					"content": "Oh! Dieser Fatui-Onkel hat ein Geschenk für mich? Ich danke dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290805
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290805,
					"content": "Moment mal, warum sollten die Fatui Lily ein Geschenk geben wollen? Will er vielleicht etwas versuchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290806
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290806,
					"content": "Es ist meinetwegen, ich habe den Onkel mit einer guten Mahlzeit verwöhnt! Und dann hat er mir ein Geschenk gemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290807
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290807,
					"content": "Lily, diese Fatui sind keine netten Leute ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290808
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290808,
					"content": "Aber dieser Onkel kann mir gute Geschichten erzählen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290809,
						200290810
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290809,
					"content": "Das ist das Abschiedsgeschenk von Viktor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290811
					]
				},
				{
					"id": 200290811,
					"content": "Warum will er gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290812
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290812,
					"content": "Es ist gut, wenn er geht. Er spricht jeden Tag mit Lily, das macht mich nervös.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290813
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290813,
					"content": "Ich will mich verabschieden, Papa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290814
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290814,
					"content": "Lily, sprich nicht mit diesem Fatui-Onkel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290815
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290815,
					"content": "Warum? Dieser Onkel ... Dieser Onkel ist sehr nett zu mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290816
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290816,
					"content": "Er liest mir Geschichten vor und macht mir eine schöne Zeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290817
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290817,
					"content": "Lily, hör auf Papa ... Es ist nicht so einfach ... Leider wird Papa erst später mit dir darüber sprechen können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290810,
					"content": "Viktor wird Mondstadt bald verlassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290811
					]
				}
			]
		},
