			"dialogs": [
				{
					"id": 200291701,
					"content": "Warum gibst du dieses Geschenk nicht für mich an Lily weiter? Sie sollte <color=#00E1FFFF>in der Nähe des Platzes</color> sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200291702
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200291702,
					"content": "Rudolf würde mich wahrscheinlich wieder anstarren, wenn ich das Geschenk direkt an Lily weitergeben würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
