			"dialogs": [
				{
					"id": 200290901,
					"content": "Hast du das Geschenk an Lily weitergegeben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290902
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290902,
					"content": "Lily ist froh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290903
					]
				},
				{
					"id": 200290903,
					"content": "Gut. Redet Rudolf wieder über mich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290904
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290904,
					"content": "Das weiß ich auch, wenn du es mir nicht sagst. Wer in Mondstadt kann einem Fatuus vertrauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290905
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290905,
					"content": "Wann gehst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290906
					]
				},
				{
					"id": 200290906,
					"content": "Die offiziellen Bescheide sind noch nicht da, ich habe nur meine Sachen vorab gepackt und werde nach einer Weile im Grand Hotel Goth übernachten, ich bin jederzeit bereit zur Abreise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290907
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290907,
					"content": "Möchtest du dich von mir offiziel verabschieden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290908
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290908,
					"content": "Das nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290909
					]
				},
				{
					"id": 200290909,
					"content": "Hm, das stimmt, wir beide sind keine Freunde, sondern nur Partner auf Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290910
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290910,
					"content": "Wenn du nach Snezhnaya gehst, kannst du zu mir kommen, und wir können beide weiter zusammenarbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290911
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290911,
					"content": "Nun, ohne weitere Umstände, hier ist deine Bezahlung, nimm sie. Dies ist unser letzter „Austausch“ in Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290912
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290912,
					"content": "Ich hoffe, dass ich nach meiner Rückkehr nicht noch mehr ärgerliche Aufgaben bekomme ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
