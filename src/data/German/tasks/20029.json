			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290401,
					"content": "Hast du das Geschenk gekriegt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290402,
						200290406,
						200290409,
						200290412
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290402,
					"content": "Was wirst du tun, wenn du zurückkommst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290403
					]
				},
				{
					"id": 200290403,
					"content": "Um was zu tun? Nun ... ich bin sicher, dass die da oben es mir sagen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290404
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290404,
					"content": "Wenn ich Pech habe, werde ich wieder irgendwo in ein Drecksloch geschickt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290405
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290405,
					"content": "Solange es nicht Inazuma ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290406,
					"content": "Warum musst du weg?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290407
					]
				},
				{
					"id": 200290407,
					"content": "Na ja, weil La Signora tot ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290408
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290408,
					"content": "Ich weiß nicht, warum Leute auf meiner Ebene so viel darüber nachdenken sollten, wenn sie einfach Befehle von oben befolgen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290409,
					"content": "Wo ist Lily?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290410
					]
				},
				{
					"id": 200290410,
					"content": "Ich hörte, wie Rudolf mit ihr darüber sprach, sie zum Platz zu bringen oder so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290411
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290411,
					"content": "Hm, ich glaube, die wollen nicht, dass Lily mit mir, dem „bösen Onkel der Fatui“, spricht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290412,
					"content": "Tschüs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290413
					]
				},
				{
					"id": 200290413,
					"content": "Nun, ich verlasse mich auf dich, was das Geschenk angeht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 2002905,
