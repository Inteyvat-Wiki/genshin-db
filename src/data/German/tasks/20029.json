				"points": []
			},
			"dialogs": [
				{
					"id": 200291901,
					"content": "Aber dieser Onkel kann mir gute Geschichten erzählen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200291902
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200291902,
					"content": "Lily, so einfach ist das nicht ... leider. Ich werde dir später mehr darüber erzählen ...",
					"roleType": "TALK_ROLE_NPC",
