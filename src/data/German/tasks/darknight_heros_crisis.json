			},
			"dialogs": [
				{
					"id": 4650301,
					"content": "Hier sind wir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650302
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650302,
					"content": "Solche alten Ruinen passen zum Stil des Ordens des Abgrunds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650303
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650303,
					"content": "Gehen wir schnell hinein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				}
			]
		},
		{
			"id": 46504,
			"completionStepIds": [
				46510
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46510",
							"2"
						],
						"stepId": 46510,
						"stateName": "QUEST_STATE_UNFINISHED"
