				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Befrager"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650401,
					"content": "Ihr habt uns tatsächlich hier gefunden! Ihr miesen Ritter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650402
					],
					"speakerTitle": "Befrager"
				},
				{
					"id": 4650402,
					"content": "Ich bin keiner dieser Ritter. Und jetzt erzähl uns von euren Plänen. Lass keine Details aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650403
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650403,
					"content": "Du hast unseren Brief also erhalten ... Wenn ihr glaubt, ich würde euch etwas über unsere Pläne erzählen, habt ihr euch geschnitten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650404
					],
					"speakerTitle": "Befrager"
				},
				{
					"id": 4650404,
					"content": "Du hast wohl vergessen, in welcher Lage du dich befindest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651001
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651001,
					"content": "Nimm die <color=#00E1FFFF>„brennende Hand“</color>!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651501
					]
				},
				{
					"id": 4651501,
					"content": "Hast du eben mithilfe des Göttlichen Auges Feuer aus deiner Hand auf mich geschossen? Das brennt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650601
					],
					"speakerTitle": "Befrager"
				},
				{
					"id": 4650601,
					"content": "Werden wir mal sehen, wie lange du durchhältst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650405
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650405,
					"content": "Nimm die <color=#00E1FFFF>„brennende Hand“</color> noch einmal!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651502
					]
				},
				{
					"id": 4651502,
					"content": "Hör auf! Diese Schmerzen! Ich halte es nicht aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650406,
						4651201
					],
					"speakerTitle": "Befrager"
				},
				{
					"id": 4650406,
					"content": "Nimm die <color=#00E1FFFF>„brennende Hand“</color> noch einmal!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651402
					]
				},
				{
					"id": 4651402,
					"content": "Argh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651403
					],
					"speakerTitle": "Befrager"
				},
				{
					"id": 4651403,
					"content": "Tu nicht so! Diese Flammen sind längst nicht ... Oh, ich glaube, er ist <color=#00E1FFFF>ohnmächtig</color> ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651404
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651404,
					"content": "He, es ist noch nicht Schlafenszeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651405
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651405,
					"content": "Aah! Das brennt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650901
					],
					"speakerTitle": "Befrager"
				},
				{
					"id": 4650901,
					"content": "Ist gut, ist gut! Ich rede ja schon. Ich werde euch <color=#00E1FFFF>alles sagen</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650902
					],
					"speakerTitle": "Befrager"
				},
				{
					"id": 4650902,
					"content": "Der Orden ... Er hat verschiedene Kräfte mobilisiert, die alle den Helden der Nacht hassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650903
					],
					"speakerTitle": "Befrager"
				},
				{
					"id": 4650903,
					"content": "Sie werden morgen 10 Uhr Abends vom <color=#00E1FFFF>Haupttor</color> aus Mondstadt angreifen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650904
					],
					"speakerTitle": "Befrager"
				},
				{
					"id": 4650904,
					"content": "Das ist alles, was ich weiß ... Wirklich! Diese Flammen sind schrecklich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650905
					],
					"speakerTitle": "Befrager"
				},
				{
					"id": 4650905,
					"content": "War das alles? Na gut, du wirst sicher nichts weiter verbergen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651201,
					"content": "Jetzt <color=#00E1FFFF>frage ihn</color> nach seinen Plänen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650901
					]
				}
			]
		},
		{
			"id": 46505,
			"completionStepIds": [
				46513
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
