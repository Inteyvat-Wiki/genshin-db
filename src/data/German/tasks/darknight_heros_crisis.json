			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650501,
					"content": "Wenn wir den Helden der Nacht nicht bald finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650502
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650502,
					"content": "Wie wird der Ritterorden auf die Herausforderung reagieren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650503
					]
				},
				{
					"id": 4650503,
					"content": "Ah ... Ihr seid es. Ich werde euch nicht verheimlichen, dass uns diese Angelegenheit Kopfzerbrechen bereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650504
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650504,
					"content": "Soeben haben wir darüber diskutiert, wie wir mit der Sache umgehen sollten. Was glaubt ihr, wozu wir uns entschieden haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650505,
						4650508
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650505,
					"content": "Ihr wollt so tun, als wäre nie etwas geschehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650506
					]
				},
				{
					"id": 4650506,
					"content": "Du machst wohl Späße! Der Ritterorden kann es sich nicht leisten, Mondstadt im Angesicht der Gefahr im Stich zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650507
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650507,
					"content": "Ansonsten würden immer mehr Leute dem Helden der Nacht vertrauen statt dem Ritterorden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650511
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650511,
					"content": "Aber was plant ihr dann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650512,
					"content": "Wir müssen herausfinden, wer der Held der Nacht in Wahrheit ist, und werden ihm dann unseren Schutz anbieten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650513
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650513,
					"content": "Schutz? Wieso braucht er mit seinen Fähigkeiten noch den Schutz des Ritterordens?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650514,
					"content": "Puh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650515
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650515,
					"content": "Nun gut. Ihr habt dem Ritterorden schon viel geholfen. Deswegen werde ich offen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650516
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650516,
					"content": "Dieser Schutz dient eigentlich dazu, den Rittern zu ermöglichen, diesen Fall uneingeschränkt zu übernehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650517
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650517,
					"content": "Wollt ihr den Helden der Nacht nicht helfen lassen? Was bringt das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650518,
					"content": "Erstens müssen wir die Macht des Ritterordens demonstrieren und den Bürgern zeigen, dass die Ritter auch ohne den Helden der Nacht alles unter Kontrolle haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650519
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650519,
					"content": "Zweitens wird der Orden des Abgrunds keine Gnade walten lassen. Was ist, wenn dem Helden der Nacht etwas zustößt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650520
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650520,
					"content": "Das würde unserem Feind genau in die Hände spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650521
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650521,
					"content": "Uff ... Der Ritterorden muss echt vieles bedenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650522,
					"content": "Das sagt sich alles so leicht. Aber solange wir nicht wissen, wer der Held der Nacht ist, bringt uns das gar nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650523
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650523,
					"content": "Zerbrich dir nicht den Kopf, Huffman. Tu einfach, was ich sage, und alles wird gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650524
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650524,
					"content": "Rittmeister Kaeya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650525
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650525,
					"content": "Diluc hat die ganzen letzten Nächte selbst in der Engelsgabe mit Hand angelegt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650526
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650526,
					"content": "Du musst nichts weiter tun, als ihn zu beobachten. Das ist doch nicht zu anstrengend, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650527
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650527,
					"content": "Kein Problem. Aber heißt das nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650528
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650528,
					"content": "dass Diluc der Held der Nacht ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650529
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650529,
					"content": "Hm, wer weiß? Das ist nur so ein Gefühl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650508,
					"content": "Ihr wollt euch mit dem Helden der Nacht zusammentun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650509
					]
				},
				{
					"id": 4650509,
					"content": "Nein, das hieße, dass wir die Existenz des Helden der Nacht guthießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650510
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650510,
					"content": "Einen derartigen Helden zu fördern, würde bedeuten, die Autorität der Ritter zu untergraben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650511
					],
					"speakerTitle": "Huffman"
				}
			]
		},
