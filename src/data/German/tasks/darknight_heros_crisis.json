			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650101,
					"content": "Huffman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650102,
					"content": "Oh, ihr seid es. Danke, dass ihr gekommen seid!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650103
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650103,
					"content": "Wir haben das letzte Mal über den Helden der Nacht geredet. Wisst ihr vielleicht noch etwas über ihn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650104,
						4650106
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650104,
					"content": "Dürfte ich erst fragen, ob es einen besonderen Grund gibt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650105
					]
				},
				{
					"id": 4650105,
					"content": "Ach so, ich hätte euch natürlich gleich alles erzählen können. Entschuldigt bitte meine Manieren als Ritter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650108,
					"content": "Es ist nämlich folgendermaßen ... Seht euch das hier an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650109
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650109,
					"content": "Meine Güte, ist das schlecht geschrieben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650110,
					"content": "Hmm, ich kann das bei genauerem Hinsehen immer noch nicht ganz entziffern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650111,
					"content": "Ja, der Text ist im Großen und Ganzen normal geschrieben. Für einige Stellen wurde aber eine Geheimschrift verwendet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650112
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650112,
					"content": "Man kann den Inhalt aber vom Kontext her erschließen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650119
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650119,
					"content": "Dies ist eine Herausforderung des Ordens des Abgrunds an den Helden der Nacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650113
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650113,
					"content": "Jetzt haben es die Bösen richtig auf den Helden der Nacht abgesehen, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650114,
					"content": "Ja, das hast du richtig erkannt. Ich hoffe, dass wir möglichst bald mit ihm Kontakt aufnehmen können, um ihm zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650115
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650115,
					"content": "Es geht hier schließlich nicht allein um den Helden der Nacht, sondern um ganz Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650116,
						4650117
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650116,
					"content": "Danke für die Informationen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650118,
					"content": "Gut. Wenn ihr etwas erfahrt, kommt jederzeit zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650117,
					"content": "Ich werde die Augen offenhalten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650106,
					"content": "Kein Problem, aber wir wissen wirklich nichts weiter über ihn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650107
					]
				},
				{
					"id": 4650107,
					"content": "Oh, wie schade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
