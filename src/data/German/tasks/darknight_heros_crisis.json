			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650201,
					"content": "Diluc, wir haben schlechte Neuigkeiten für Euch! Eben waren wir beim Ritterorden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650202,
					"content": "Geht es um die Herausforderung des Ordens des Abgrunds?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650203
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650203,
					"content": "Davon weiß ich bereits. Dennoch danke ich euch, dass ihr den Weg auf euch genommen habt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650204
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650204,
					"content": "Wie bitte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650205,
					"content": "Meine Kontakte erstrecken sich weiter über das Weingut Morgenröte hinaus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650206
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650206,
					"content": "Was habt Ihr jetzt vor, Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650207,
					"content": "Was denkt ihr denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650208,
						4650213
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650208,
					"content": "Ihr solltet doch mit den Rittern zusammenarbeiten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650209
					]
				},
				{
					"id": 4650209,
					"content": "Das würde dem Orden des Abgrunds gerade recht kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650210
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650210,
					"content": "Sie wissen ganz genau, dass ich mit dem Ritterorden nicht zurechtkomme, und warten auf die richtige Gelegenheit zuzuschlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650211
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650211,
					"content": "Sobald ich aufgeflogen bin, wird der Ritterorden sicherlich bei meinen Aktivitäten dazwischenfunken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650212
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650212,
					"content": "Schließlich will keine so mächtige Organisation, dass jemand, der nicht dazugehört, ihre Pflichten erfüllt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650217
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650217,
					"content": "Hmm ... Der Orden des Abgrunds hat Euch diesmal vor eine schwierige Aufgabe gestellt, wirklich hinterlistig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650218,
					"content": "Es gibt einen Weg. Doch dafür brauchen wir mehr Informationen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650219
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650219,
					"content": "Wir sollten erfahren, was die unlesbaren Teile in der Herausforderung bedeuten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650220
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650220,
					"content": "Unlesbar? Meint Ihr die Teile im Text, die Paimon nicht lesen konnte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650221,
					"content": "Diese Teile kann man sicher nur als Mitglied der Organisation lesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650222,
						4650223
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650222,
					"content": "War die Herausforderung etwa an einen der ihren gerichtet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650224
					]
				},
				{
					"id": 4650224,
					"content": "Das heißt, dass diese Herausforderung nicht direkt an mich gerichtet ist, sondern an ihre Leute hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650225
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650225,
					"content": "Wenn man in den Augen einiger zu einem Helden wird, ist man automatisch ein Feind in den Augen anderer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650226
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650226,
					"content": "Mittlerweile bin ich nun schon ziemlich lange ein Feind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650227
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650227,
					"content": "Der Orden des Abgrunds hat mich zu seinem Ziel erklärt. Mit einem gemeinsamen Ziel werden sie noch stärker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650228
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650228,
					"content": "Oho ... Sieht aus, als müsste man als Held auch noch Köpfchen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650229,
					"content": "Ich verstehe sie einfach ziemlich gut. Wie ich eben gesagt habe, für die einen sind sie Feinde, für die anderen Helden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650230
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650230,
					"content": "Und was machen wir jetzt mit den Stellen, die wir nicht lesen können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650231,
					"content": "Wenn man etwas nicht versteht, fragt man einfach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650232
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650232,
					"content": "Ich habe bereits herausgefunden, wo einer ihrer <color=#00E1FFFF>Stützpunkte</color> ist. Wenn ihr Lust habt, könnt ihr gern mit mir kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650223,
					"content": "Warum sollten sie die Herausforderung schreiben, wenn wir sie sowieso nicht lesen können?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650224
					]
				},
				{
					"id": 4650213,
					"content": "Dann solltet Ihr lieber solange auf dem Weingut bleiben, bis die Wogen geglättet sind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650214
					]
				},
				{
					"id": 4650214,
					"content": "Das würde bedeuten, dass ich dem Ritterorden alles überließe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650215
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650215,
					"content": "Wenn die Ritter dem gewachsen wären, wäre es gar nicht erst so weit gekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650216
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650216,
					"content": "Ich werde mich nicht einfach verstecken und zusehen, wie der Ritterorden die Verantwortung dafür übernehmen muss und womöglich scheitert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650217
					],
					"speakerTitle": "Diluc"
				}
			]
		},
		{
