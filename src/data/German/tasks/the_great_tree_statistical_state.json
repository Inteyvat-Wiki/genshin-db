			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladep",
					"Pharez"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300101,
					"content": "Wir brauchen mehr Daten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300102
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300102,
					"content": "Wie können deine Geräte ohne Daten richtig funktionieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300103
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300103,
					"content": "Du willst alle Daten so gut wie möglich sammeln, bevor du es tust?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300104
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300104,
					"content": "Musst du dir jede Welle ansehen, wenn du einen Fisch fängst? Nein! Du musst nur auf die einzige abzielen, wo ein Fisch drin schwimmt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300105
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300105,
					"content": "Deshalb kannst du auch nie einen Fisch fangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300106
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300106,
					"content": "Du hast nicht bei Haravatat studiert! Also hör auf mit den Wortspielen. Wir müssen jetzt an die Arbeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300107
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300107,
					"content": "Wenn wir noch länger zögern, könnte Yasmins Abhandlung ihre Aktualität verlieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300108
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300108,
					"content": "Worüber streitet ihr euch denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300109
					]
				},
				{
					"id": 230300109,
					"content": "Wer bist du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300110
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300110,
					"content": "Das muss der Reisende sein, den Yasmin erwähnt hat. Du hast uns viel geholfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300111
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300111,
					"content": "#Es ist mir eine Freude, dich kennenzulernen! {F#Reisende}{M#Reisender}, wie schön, dich kennenzulernen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300112
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300112,
					"content": "Ich heiße Pharez und ich studiere am Kshahrewar-Institut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300113
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300113,
					"content": "Ich bin Ladep und ein Student des Spantamad-Instituts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300114
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300114,
					"content": "#{F#Reisende}{M#Reisender}, wir würden dich auch gerne um einen Gefallen bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300115
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300115,
					"content": "Du weißt, dass Yasmin in letzter Zeit Tränke um die Wurzeln dieses „Heiligen Baumes“ geschüttet hat, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300116
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300116,
					"content": "Aber ... Ähm ... Es scheint ein Problem mit den Tränken zu geben, die Yasmin in letzter Zeit geschüttet hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300117
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300117,
					"content": "Alle möglichen Monster tauchen in Gebieten auf, in dem sie Tränke geschüttet hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300118
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300118,
					"content": "Ich schwöre, ich habe definitiv kein Rezept oder Gießverhältnis verändert. Es muss etwas ... nun ja, Unerwartetes sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300119
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300119,
					"content": "#Wie auch immer, {F#Reisende}{M#Reisender}, komm bitte mit uns, um nach den Orten zu sehen, wo Yasmin ihre Tränke geschüttet hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300120
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300120,
					"content": "Es kann sein, dass es dort wieder viele Monster gibt. Wir würden es nicht wagen, alleine dorthin zu gehen. Wir benötigen jemanden mit einer hervorragenden Kampffertigkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300121
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300121,
					"content": "Und selbst wenn die Pilzbestien nicht allzu gefährlich sind, wenn der Mentor davon Wind bekommt, dass unsere Tränke so große Probleme hervorgebracht haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300122
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300122,
					"content": "Unsere Abhandlungen würden aufs Schärfste verurteilt werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300123
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300123,
					"content": "Vor allem würden wir bei Spantamad von unseren Mentoren gescholten werden, wenn wir falsche Daten angeben würden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300124,
						230300125
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300124,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230300125,
					"content": "Wie hast du dieses Problem bisher gelöst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300126
					]
				},
				{
					"id": 230300126,
					"content": "Normalerweise heuern wir Abenteurer an oder gehen zu unserem Mentor und bitten ihn, ein paar vertrauenswürdige Mitglieder der Goldbrigaden um Hilfe zu bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300127
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300127,
					"content": "Aber auch die Geduld unseres Mentors ist begrenzt. In dieser Situation trauen wir uns nicht, uns an ihn zu wenden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300128
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300128,
					"content": "#Wir können also nur dich darum bitten, {F#Reisende}{M#Reisender}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ladep"
				}
			]
		},
		{
			"id": 2303002,
			"completionStepIds": [
				2303002
