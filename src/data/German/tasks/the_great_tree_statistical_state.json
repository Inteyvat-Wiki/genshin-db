			"trigger": {
				"objectNames": [
					"Ladep",
					"Pharez"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300201,
					"content": "Sieh dir diese Kiste an, darin müssten die Tränke sein. Sieht aus, als wäre Yasmin schon hier gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300202
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300202,
					"content": "Hä? Die Deckel der Tränke dieser Kiste wurden noch nicht geöffnet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300203
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300203,
					"content": "Öffne sie nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300204
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300204,
					"content": "Oooh! Da hinten kommen Pilzbestien heraus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230300205,
					"content": "Was? Sie war vorher noch nicht da! Was ist hier nur los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300206
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300206,
					"content": "#Hör nicht auf ihr Geschwätz, {NICKNAME}, lass uns sie besiegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2303004,
			"completionStepIds": [
				2303004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303004",
							"2"
						],
						"stepId": 2303004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladep",
					"Pharez"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300401,
					"content": "Zum Glück waren die Trankkrüge in der Kiste nicht kaputt, sonst hätten wir uns übergeben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300402
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300402,
					"content": "Du bist nicht an den Geruch gewöhnt? Das hast du aber doch alles selbstgemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300403
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300403,
					"content": "Wie oft habe ich dir schon erklärt, dass das, was ich hinzugefügt habe, ein Brechmittel ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300404
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300404,
					"content": "Das hat nichts damit zu tun, ob man sich daran gewöhnt hat. Der Geruch löst einfach bei jedem automatisch Erbrechen aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300405
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300405,
					"content": "Warum muss ich mich wiederholen, du verstehst es bestimmt nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300406
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300406,
					"content": "Aber wo ist denn jetzt Yasmin hin? Der Trank war noch nicht einmal verchüttet worden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300407
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300407,
					"content": "Sie hat wohl wieder eine seltene Pflanze gefunden und sammelt fleißig Exemplare. Kennst du die Vorzüge ihrer Amurtas noch nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300408
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300408,
					"content": "#Nun, der Krug mit der Medizin wird vorerst von uns bewacht. Danke für deine Hilfe, {F#Reisende}{M#Reisender}, und bitte nimm das hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300409
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300409,
					"content": "Diese Amurta ... Sie sind wirklich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pharez"
				}
			]
		},
		{
			"id": 2303005,
			"completionStepIds": [
				2303005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303005",
							"2"
						],
						"stepId": 2303005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladep",
					"Pharez",
					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300501,
					"content": "*hust*, *hust*, *hust* ... Hier sollte es wieder in Ordnung sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300502
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300502,
					"content": "Oooh ... *würg* ... Ach, du ... Das ist alles dein Werk! Warum übergibst du dich auch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300503
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300503,
					"content": "Äh ... *hust* ... *hust* ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300504
					]
				},
				{
					"id": 230300504,
					"content": "Wie oft habe ich dir schon erklärt: Das, was ich hinzugefügt habe, ist ein Brechmittel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300505
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300505,
					"content": "Das hat nichts damit zu tun, ob man sich daran gewöhnt hat. Der Geruch löst einfach bei jedem automatisch Erbrechen aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300506
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300506,
					"content": "Warum muss ich mich noch einmal wiederholen, du verstehst doch nie ... Ähem ... Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300507
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300507,
					"content": "#Hm? Ladep, Pharez und {F#Reisende}{M#Reisender}? Was führt euch hierher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300508
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300508,
					"content": "Die Trankkrüge sind auch kaputt ... Wurdet ihr von Monstern angegriffen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300509
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300509,
					"content": "So wie es aussieht ... Ja. Hast du keine Monster gesehen, als du hier warst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300510
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300510,
					"content": "Nein, ich habe mir sogar die Zeit genommen, in der Nähe einige Pflanzen für Exemplare zu pflücken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300511
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300511,
					"content": "Das ist seltsam ... Sehr seltsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300512
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300512,
					"content": "Was ist daran so seltsam! Diese Monster wurden von den Tränken angezogen, die du hergestellt hast!",
