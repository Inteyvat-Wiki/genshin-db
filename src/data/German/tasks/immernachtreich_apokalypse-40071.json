			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Kaedehara Kazuha",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400710201,
					"content": "Bist du wach?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710202,
					"content": "Ah ... Es ist wieder Morgen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710203
					]
				},
				{
					"id": 400710203,
					"content": "Wie läuft’s denn so? Hat sich etwas ergeben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710204
					]
				},
				{
					"id": 400710204,
					"content": "Du wirst es vielleicht nicht glauben, aber es ist nichts passiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710205,
					"content": "Du bist wach? Dann lass uns direkt zum Thema kommen. Wir haben uns umgeschaut und es gibt nichts Verdächtiges.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710206
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710206,
					"content": "Nach dem Muster der beiden vorherigen Illusionen hätte es einen Gegenstand als „Eingang“ geben müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710207
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400710207,
					"content": "Das ist seltsam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710208
					]
				},
				{
					"id": 400710208,
					"content": "Könnte es sein, dass die Zeit noch nicht reif ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710209,
					"content": "Du meinst, wir sollen noch ein bisschen warten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710210
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710210,
					"content": "Ja. Außerdem ist Fischl nicht hier. Ich glaube, sie ist wahrscheinlich noch gespannter darauf, den Eingang zu finden, als wir es sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710211,
					"content": "Lasst uns warten. Gib der Illusion ... Nein, gib Fischl etwas Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710212
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710212,
					"content": "Die Leute stimmte Mona zu und versammelte sich für eine Teepause. Dann teilten sich alle in zwei Gruppen auf und suchten herum.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400710213
					]
				},
				{
					"id": 400710213,
					"content": "Schließlich, nach mehreren vergeblichen Rundgängen, tauchte plötzlich etwas am Strand auf.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400710214
					]
				},
				{
					"id": 400710214,
					"content": "Etwas ist auf den Strand herabgefallen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710215,
					"content": "Ist es ein Buch? Und daneben die Statue einer ... ähm ... Krähe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710216
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400710216,
					"content": "Diese Statue sieht aus wie Oz ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710217,
					"content": "Was bedeutet es, dass sie zusammen aufgetreten sind. Wurde das Buch von der Krähe geliefert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710218
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710218,
					"content": "Was ist das? Ein Tagebuch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710219
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710219,
					"content": "Mal sehen ... „Hymne des Heiligen Reichs“? So ein Buch habe ich noch nie gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710220,
					"content": "Auf dem Buchdeckel sieht es so aus, als ob es ... von Fischl selbst geschrieben wurde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710221,
					"content": "Das sieht nach ihrem Stil aus, wenn du es so formulierst. „Hymne des Heiligen Reichs“, ein schöner Titel, er gefällt mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710222
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710222,
					"content": "Der Titel dieses Buches hat etwas Spirituelles an sich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710223
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400710223,
					"content": "Also ... Willst du es mal berühren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710224,
					"content": "... Fischl ist noch immer nicht zurückgekehrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710225
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710225,
					"content": "Macht nichts, lasst uns weitermachen. Wenn Fischl das Buch sieht, sollte sie zu uns kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710226
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710226,
					"content": "Da stimmt Paimon zu! Es ist, als würde man in ein Tagebuch gucken. Sie wird definitiv auftauchen und uns aufhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4007103,
			"completionStepIds": [
				4007103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007103",
							"2"
						],
						"stepId": 4007103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Erzähler",
					"Mona",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400710301,
					"content": "„Die Menschen von heute haben keine Erinnerung daran, aber die Gelehrten wissen, dass Ihre Hoheit während das Chaos auf die Welt kam, etwa sechshundert Jahre vor der Zeit der Heiligen, regierte.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710302
					],
					"speakerTitle": "Erzähler"
				},
				{
					"id": 400710302,
					"content": "Echt? Ein Erzähler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710303,
					"content": "Wie in der Welt der Bücher gab es einen Erzähler, der uns die Geschichte erzählte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710304
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710304,
					"content": "Der Weg ist zerstört und es ist unmöglich, ihn zu nutzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710305,
					"content": "Dort drüben stand ein Apparat, als ob er darauf wartete, dass wir ihn ansteuern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710306
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710306,
					"content": "Paimon hat immer das Gefühl ... dass hier alles zu durchdacht ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710307,
					"content": "Es ist ein heiliges Land. Sei rücksichtsvoll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710308,
					"content": "Ja, es ist so offensichtlich, dass man erwartet, dass es bemerkt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710309,
					"content": "Fischls Gedanken sind immer so leicht zu verstehen, wenn es um solche Dinge geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4007110,
			"completionStepIds": [
				4007110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007110",
							"2"
						],
						"stepId": 4007110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Leon",
					"Mona",
					"Xinyan",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711001,
					"content": "Oh, bitte helft mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711002
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711002,
					"content": "He, ist das nicht eine Statue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711003,
					"content": "Bitte sag so etwas nicht! Ich heiße Leon und bin Ritter aus dem Immernachtreich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711004
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711004,
					"content": "Ein Ritter? Sieht überhaupt nicht danach aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711005,
					"content": "Kannst du es nicht sehen? Nun. Trotzdem solltest du Herr Ozvaldo, der die Rüstungen für die Nachtrabenritter entworfen und ausgegeben hat, nicht die Schuld geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711006
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711006,
					"content": "Herr Ozvaldo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711007
					]
				},
				{
					"id": 400711007,
					"content": "#{NICKNAME} sollte davon gehört haben, oder? Oz’ voller Name ist Ozvaldo Hrafnavins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711008,
						400711009
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711008,
					"content": "Ich weiß.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711010
					]
				},
				{
					"id": 400711010,
					"content": "Megistus lässt sich etwas leichter aussprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711011
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711011,
					"content": "Das finde ich auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711012
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711012,
					"content": "Haha, das sagen alle ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711013
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711013,
					"content": "Freunde, es ist wirklich nicht meine Absicht, euer angenehmes Gespräch zu unterbrechen, nur, ich glaube, ihr seid euch nicht bewusst, dass das Tor vor euch eingesperrt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711014
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711014,
					"content": "In der Tat, wir wussten es nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711015,
					"content": "Ich hoffe, dass ihr so freundlich seid, mich hochzuheben und im Gegenzug zeige ich dir gerne, wie man das Tor öffnen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711016
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711016,
					"content": "Also ... Nun gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711009,
					"content": "Das weiß ich jetzt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711010
					]
				}
			]
		},
		{
			"id": 4007112,
			"completionStepIds": [
				4007112
