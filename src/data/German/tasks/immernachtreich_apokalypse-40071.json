				"points": []
			},
			"dialogs": [
				{
					"id": 400711201,
					"content": "Ihr Helden, keine Worte können euch sagen, wie aufgeregt ich in diesem Moment bin. Ich danke euch allen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711202
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711202,
					"content": "Bitte erinnert euch an das Mantra, um das Tor zu öffnen: „Möge mein Volk von den Fesseln der alten Dekrete befreit werden“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leon"
				}
			]
		},
		{
			"id": 4007113,
			"completionStepIds": [
				4007113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007113",
							"2"
						],
						"stepId": 4007113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Mona",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711301,
					"content": "Es scheint keinen anderen Weg zu geben, nur dieses Buch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711302,
					"content": "Was wir gerade gehört haben, ist die Geschichte aus dem Buch, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711303
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711303,
					"content": "Das heilige Land im Titel des Buches bezieht sich also auf das Immernachtreich. Das Buch singt ein Loblied für Ihre Hoheit im Ton des Reiches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711304,
					"content": "Es ist eine Art Autobiografie ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711305
					]
				},
				{
					"id": 400711305,
					"content": "Das Buch ist auf der letzten Seite angelangt, aber ihre Geschichte scheint noch nicht zu Ende zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711306
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711306,
					"content": "Wo ist die Fortsetzung? Paimon will wissen, wie es weitergeht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711307,
					"content": "Nun, es ist wohl an der Zeit, weiter zu erkunden, denke ich. Es ist besser, das fertige Buch zu schließen ... als dieses hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4007114,
			"completionStepIds": [
				4007114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007114",
							"2"
						],
						"stepId": 4007114,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Fischl",
					"Fischls Mutter",
					"Fischls Vater",
					"Kaedehara Kazuha",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711401,
					"content": "Äh! Wie kommt es, dass der Ort gewechselt wird, aber wir nicht wieder am Strand sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711402
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711402,
					"content": "Das hier scheint ein Haus in Mondstadt zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711403,
					"content": "Guten Tag, die ehrwürdige „Kaiserin der Verurteilung“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711404
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400711404,
					"content": "Kleine Amy, Liebes, Mama hat Schnitzel und Fischerschnitte gemacht, komm und iss, solange sie heiß sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711405
					],
					"speakerTitle": "Fischls Mutter"
				},
				{
					"id": 400711405,
					"content": "Ähem! Mutter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711406
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400711406,
					"content": "Oh, schau mich an, ich habe es vergessen. Prinzessin der Verurteilung, weißt du, dass es Mittagszeit ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711407
					],
					"speakerTitle": "Fischls Mutter"
				},
				{
					"id": 400711407,
					"content": "Natürlich, Mutter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711408
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400711408,
					"content": "Oh! Der Blick aus dem Fenster ist so atemberaubend, liebe Prinzessin und Eure Majestät, würdet Ihr bitte mit mir, dem Kaiser der Verurteilung, die Ehre erweisen, ein Picknick zu machen? Schaut Euch die Aussicht an und genießt die Wonnen des Himmels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711409
					],
					"speakerTitle": "Fischls Vater"
				},
				{
					"id": 400711409,
					"content": "Ja, sehr sogar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711410
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400711410,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711411
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711411,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711412
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711412,
					"content": "Äh ... nun, hat jemand was zu sagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711413
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711413,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711414
					]
				},
				{
					"id": 400711414,
					"content": "Ich fragte direkt: „Kleine Amy ... ist das Fischls echter Name?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711415
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711415,
					"content": "Paimon glaubt schon. Die beiden Stimmen von gerade eben schienen ihre Mutter und ihr Vater zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711416,
					"content": "... Warum schaut ihr mich so an?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711417
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711417,
					"content": "Es mag vielleicht etwas anmaßend sein, aber ... ist dein Nachname wirklich Megistus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711418
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711418,
					"content": "Hm, du unterschätzt mich? Der vollständige Name dieser Astrologin lautet: Astrologin Mona Megistus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711419
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711419,
					"content": "... Entschuldige bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711420
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711420,
					"content": "Wer soll sich das denn merken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711421
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711421,
					"content": "Dieser Name kann nur dem wahren Genie gehören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711422
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711422,
					"content": "Das ergibt nie einen Sinn ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711423,
					"content": "Was denkt ihr über das, was gerade passiert ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711424
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711424,
					"content": "Ich war mir einer Sache sicher: Das „Schließen des Buches“ war auch ein Mittel, um eine Veränderung in der Illusion zu bewirken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711425
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711425,
					"content": "Es ist großartig, dass Fischls Familie bereit ist, sie zu unterstützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711426
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711426,
					"content": "Aber das wird nicht immer so sein. Laut der Stimme scheint es eine Erinnerung an ihre Kindheit zu sein, richtig? Die Dinge werden sich ändern, nachdem sie aufgewachsen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711427
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711427,
					"content": "Mona weiß ’ne Menge!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711428,
					"content": "Als Freundin ist es wohl normal, das zu wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711429
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711429,
					"content": "... Fischl, wo könnte sie jetzt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711430
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711430,
					"content": "Die Stimme hat gerade gesagt, dass sie rausgeht, also warum gehen wir nicht auch raus und sehen uns das an, wir sollten einen Hinweis darauf erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4007115,
			"completionStepIds": [
				4007115
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007115",
							"2"
						],
						"stepId": 4007115,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Xinyan",
					"Kaedehara Kazuha",
					"Arnold"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711501,
					"content": "Ach, wir sind zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711502,
					"content": "Nein, nein, nein, warum sind wir zurück? Wir haben die Geschichte noch nicht zu Ende gehört!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711503,
					"content": "Es ist ein schreckliches Gefühl, so wie der Kauf eines gefälschten Astrologiekurses oder wenn du mitten beim Essen feststellst, dass du dein Portemonnaie vergessen hast ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711504,
					"content": "Aah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711505,
					"content": "Nein! Das ist so unangenehm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711506,
					"content": "Diese beiden sehen ziemlich erschüttert aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711507
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711507,
					"content": "Um ehrlich zu sein, lese ich auch nicht gern Bücher, die halbiert worden sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711508
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711508,
					"content": "Haha, wem würde das gefallen? Leute, lasst uns noch einmal in die Illusion eingehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711509
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711509,
					"content": "Gute Idee! Dann los geht’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711510,
					"content": "... Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711511
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711511,
					"content": "Keine Reaktion, keine Änderung der Position.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711512
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711512,
					"content": "Seltsam, eben konnten wir noch eintreten und jetzt werden wir zurückgewiesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711513
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711513,
					"content": "Warum? Warum wird uns die Möglichkeit verweigert, das Buch zu Ende zu lesen? Das ist Quälerei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711514,
					"content": "Nun ... Das liegt wohl daran, dass das Buch schon „zu Ende gelesen“ wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711515
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711515,
					"content": "In dem Buch, das wir sahen, bevor wir die Illusion verließen, war die letzte Seite umgeblättert. Ich glaube, dass es mehr als ein Exemplar von der „Hymne des Heiligen Reichs“ geben könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711516
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711516,
					"content": "Es ist wie eine Art kitschige kurze Erzählung ... Um zu erfahren, was danach passiert, kaufe bitte den nächsten Band oder so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711517,
					"content": "Verdammt, ich muss erfahren wie es zu Ende geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711518
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711518,
					"content": "Oh, oh ja, das Ende, jeder liebt das Ende eines Buches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711519
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711519,
					"content": "Hm? Wer ist dort drüben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711520
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711520,
					"content": "Oh, meine Güte, sie hat mich gesehen. Achtung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711521
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711521,
					"content": "Bist du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711522
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711522,
					"content": "Ich bin „Frag-mich-nach-der-Richtung Arnold“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711523
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711523,
					"content": "Der Name ist zu eindeutig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711524,
					"content": "Arnold, ich frage dich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711525
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711525,
					"content": "Es heißt „Frag-mich-nach-der-Richtung Arnold“, nicht Arnold!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711526
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711526,
					"content": "Frag-mich-nach-der-Richtung Arnold, ich frage dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711527
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711527,
					"content": "Ja, meine Dame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711528
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711528,
					"content": "Gibt es eine Fortsetzung zu „Hymne des Heiligen Reichs“? Wo ist es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711529
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711529,
					"content": "Oh, oh, da fragst du die richtige Person. Die „Hymne des Heiligen Reichs“ ist der heilige Text des Immernachtreichs und besteht aus drei Bänden, von denen die beiden anderen an zwei besonders hohen Orten in der Kaiserstadt versteckt sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711530
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711530,
					"content": "Wenn du den zweiten Band finden willst, musst du dich auf die Spitze des hohen Turms begeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711531
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711531,
					"content": "Der hohe Turm, ist das der da drüben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711532
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711532,
					"content": "Ja, das ist der Turm, in dem die heiligen Texte aufbewahrt werden. Es gibt einen Geheimgang, der dich schnell dorthin bringt, wenn du dich in der Höhle dort drüben genau umschaust.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711533
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711533,
					"content": "Oh, vielen Dank, Arnold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711534
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711534,
					"content": "Es heißt „Frag-mich-nach-der-Richtung Arnold“, nicht Arnold!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711535
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711535,
					"content": "Wunderschöne Madame, hast du mich sonst nichts zu fragen? Zum Beispiel, ob ich eine Freundin habe, wie hoch mein monatliches Einkommen ist oder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711536
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711536,
					"content": "Nein, tschüs!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711537
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711537,
					"content": "Kümmert euch nicht um die Nachtkrähe. In der Höhle vor uns gibt es einen Geheimgang, der direkt zur Spitze des Turms führt, also lasst uns loslegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711538
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711538,
					"content": "Oh, meine Dame! Hast du wirklich kein Interesse an mir? Nur weil du so schön bist, bin ich bereit, dir das Geheimnis vom Immernachtreich zu verraten! Meine Dame! ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arnold"
				}
			]
		}
	]
}