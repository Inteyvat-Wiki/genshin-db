				},
				{
					"id": 207010202,
					"content": "Prima! Vielen Dank dafür. Ich werde hier drüben warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010203
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010203,
					"content": "Hehe ... endlich werde ich wieder gefüllte Jadetaschen essen können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Siegfria"
