					"Siegfria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207010101,
					"content": "Wie kann ich schon wieder Hunger haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010102
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010102,
					"content": "Oh, du bist es! Wundervoll. Erinnerst du dich an mich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010103
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010103,
					"content": "Vom Kochwettbewerb mit Xiangling? Das war ich, Siegfria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010104
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010104,
					"content": "Hehe, kannst du dich jetzt erinnern? Du bist jedenfalls zur besten Zeit gekommen. Könnte ich ... dich bitten, mir mit etwas zu helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010105
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010105,
					"content": "Was gibt’s?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207010106
					]
				},
				{
					"id": 207010106,
					"content": "Kannst du dich noch an die gefüllten Jadetaschen erinnern, die du das letzte Mal gemacht hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010107
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010107,
					"content": "Es war so köstlich, ich kann es sogar jetzt noch schmecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010108
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010108,
					"content": "Ich wollte es also ausprobieren und selbst etwas davon machen, aber ... ich habe immer das Gefühl, dass etwas fehlt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010109
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010109,
					"content": "Ich denke, wenn ich es noch ein paar Mal öfters probieren kann, kann ich den Geschmack auch nachmachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010110
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010110,
					"content": "Also, darf ich dich bitten, mir ein paar gefüllte Jadetaschen zum Probieren zu machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Siegfria"
				}
			]
		},
