			"dialogs": [
				{
					"id": 207010502,
					"content": "... Ah, sie sind alle weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010503
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010503,
					"content": "Das Mundgefühl von diesem Gemüse ... der perfekt gepaarte Geschmack von Schinken und Lotossamen ... und diese Suppe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010504
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010504,
					"content": "Das ist er - das ist der Geschmack, den ich das letzte Mal schmeckte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010531
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010531,
					"content": "Danke dafür, dass du gekommen bist, nur um mir dieses Essen zu kochen. Ich muss zurückgehen und einige Notizen machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010532
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010532,
					"content": "Das nächste Mal, wenn wir uns treffen, werde ich sicherlich eine Ladung perfekte gefüllte Jadetaschen zubereiten können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010533
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010533,
					"content": "Wenn das passiert, komm doch vorbei und probiere.",
					"roleType": "TALK_ROLE_NPC",
