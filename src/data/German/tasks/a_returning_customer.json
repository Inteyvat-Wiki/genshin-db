					"nextDialogs": [
						207010402
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010402,
					"content": "I kenne das Rezept und ich konnte herausfinden, wie man sie macht. Aber es kommt nicht ganz an den Geschmack der von dir gemachten heran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010403
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010403,
					"content": "*seufz* Wenn du diese gefüllten Jadetaschen doch nur noch ein paar Mal für mich machen könntest. Es gibt noch viele Feinheiten an ihnen, die ich noch ausarbeiten muss.",
					"roleType": "TALK_ROLE_NPC",
