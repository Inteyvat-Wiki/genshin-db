					"nextDialogs": [
						207010302
					]
				},
				{
					"id": 207010302,
					"content": "Ähm, na ja ... Ich würde auch gerne andere Sachen essen. Wenn ich aber versuchen würde alles zu essen, könnte ich am Ende gar nichts essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010303
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010303,
					"content": "Ich hätte also gern ein gutes Verständnis dafür, wie gefüllte Jadetaschen schmecken.",
