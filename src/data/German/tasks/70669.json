			"dialogs": [
				{
					"id": 706690201,
					"content": "#Miau! „Du bist wirklich {F#eine tolle Kartenbeschwörerin}{M#ein toller Kartenbeschwörer}! Herzlichen Glückwunsch zum Bestehen der Aufstiegsprüfung, jetzt bist du eine Legende!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706690202
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706690202,
					"content": "Miau ... „Den Titel Legende zu tragen ... Wirklich unglaublich ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706690203
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706690203,
					"content": "#„{NICKNAME}, ich hoffe, dass du auch in Zukunft weiter an deinen Kartenkünsten feilen wirst, damit du {F#eine unglaubliche Kartenbeschwörerin}{M#ein unglaublicher Kartenbeschwörer} wirst, {F#die}{M#der} dem Titel einer Legende wirklich gerecht wird!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706690204
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706690204,
					"content": "„Ich meine, das jetzt noch zu sagen, ist vielleicht ein bisschen überflüssig, aber dennoch ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706690205
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706690205,
					"content": "#„{NICKNAME}, ich hoffe, dass du die Freude, ‚Geniale Beschwörung‘ zu spielen, spüren kannst!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Prinz“"
				}
			]
