				},
				{
					"id": 741930206,
					"content": "#Danke, Paimon! Danke, {NICKNAME}! Danke, Gezeitenalge!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930207
					],
					"speakerTitle": "Pahsiv"
