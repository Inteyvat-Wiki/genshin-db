				{
					"id": 741930503,
					"content": "Pahsiv ... rausgehen! Pahsiv ... suchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930504
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930504,
					"content": "Ist schon in Ordnung, wenn du nichts hast.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930505
					]
				},
				{
					"id": 741930505,
					"content": "Genau. Wir können dir auch einfach so die Gezeitenalgen geben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930506,
					"content": "Melusine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930507
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930507,
					"content": "#Paimon, Freund ... aufrichtig! {NICKNAME}, Freund ... aufrichtig! Also ... Tausch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930508
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930508,
					"content": "N... Na gut. Pahsiv, wie lange wirst du weg sein? Werden wir uns wiedersehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930509,
					"content": "... Wiedersehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930510
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930510,
					"content": "Ja, wiedersehen! Das heißt, wir treffen uns wieder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930511,
					"content": "Und mit „Auf Wiedersehen“ verabschiedet man sich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930512
					]
				},
				{
					"id": 741930512,
					"content": "Genau! Wie Paimon schon sagte, werden wir dir beibringen, wie man sich verabschiedet. Also Pahsiv, versuch du es auch mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930513,
					"content": "Ver...abschieden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930514
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930514,
					"content": "Oh ... Du verstehst nicht, was verabschieden heißt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930515,
					"content": "Lass Paimon mal überlegen ... Das ist quasi ein Tausch, bei dem du ein morgen gegen ein anderes morgen tauschst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930516,
					"content": "Du nimmst ein wenig von deinem morgen und gibst es uns, und wir nehmen ein wenig von unserem morgen und geben es dir, und so können wir uns dann wiedersehen! Wie war das? Hast du das verstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930517,
					"content": "Tausch ... morgen ... gegen ... morgen! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930518
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930518,
					"content": "Waah! Sieht so aus, als hättest du’s verstanden! Dann können wir uns ja verabschieden. Wenn man sich richtig auf Wiedersehen sagt, wird man sich auf jeden Fall wiedersehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930519,
					"content": "Auf Wiedersehen, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930520,
					"content": "Auf Wiedersehen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930521
					]
				},
				{
					"id": 741930521,
					"content": "#Auf Wiedersehen, {NICKNAME}! Auf Wiedersehen, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pahsiv"
				}
			]
		}
	]
}