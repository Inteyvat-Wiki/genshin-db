			},
			"dialogs": [
				{
					"id": 741930101,
					"content": "#Paimon! {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930102
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930102,
					"content": "Waah! Pahsiv, du bist es! Paimon flippt aus vor Freude! Was machst du hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930103,
					"content": "Pahsiv ... arbeiten! Pahsiv ... müde! Pahsiv ... hinlegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930104
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930104,
					"content": "Hä ...? Du arbeitest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930105,
					"content": "Zweig des einsamen Waldes ... Zweig des einsamen Waldes ... sehr verloren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930106
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930106,
					"content": "Zweig des einsamen Waldes? Was ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930107,
					"content": "Zweig des einsamen Waldes ... Information!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930108
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930108,
					"content": "Trauerweide, sammeln. Nebelpfad, erledigen. Quelle, senden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930109
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930109,
					"content": "Zweig des einsamen Waldes ... Nebelpfad-Information!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930110
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930110,
					"content": "Meinst du, das sind Informationen des Nebelpfads im einsamen Wald?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930111
					]
				},
				{
					"id": 741930111,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930112
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930112,
					"content": "Zweig des einsamen Waldes ... sehr verloren! Sehr viel Ort!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930113
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930113,
					"content": "Pahsiv ... suchen! Pahsiv ... müde! Pahsiv ... essen! Pahsiv ... hinlegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930114
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930114,
					"content": "Zweig des einsamen Waldes ... sehr nicht viel! Aber Kiste, sehr viel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930115
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930115,
					"content": "#Ah ... Danke, Paimon, danke, {NICKNAME}, nehmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930116
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930116,
					"content": "Du hast schon wieder eine Truhe gefunden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930117
					]
				},
				{
					"id": 741930117,
					"content": "Pahsiv! Kiste, Schatz, Blume, Glanz, süß, sehr viel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930118
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930118,
					"content": "Waah, es gibt also noch mehr? Pahsiv, du bist so lieb! Aber wir können doch nicht einfach so deine Sachen nehmen. Du solltest im Gegenzug dafür etwas kriegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930119,
					"content": "Ge... Gegenzug?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930120
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930120,
					"content": "Ja, weil wir Freunde sind. Ein Freund ist jemand, der aufrichtigen Herzens etwas gegen etwas anderes eintauscht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930121,
					"content": "Wir werden dir also dabei helfen, die Zweige des einsamen Waldes zu finden und tauschen ihn dann gegen deine Sachen ein. Was hältst du davon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930122,
					"content": "Und wir können dir auch gleich was zu Essen suchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930123
					]
				},
				{
					"id": 741930123,
					"content": "Genau! Für jemanden wie Pahsiv dürfte es schwer sein, so ganz allein hier draußen. Wir können ihr helfen, was zu Essen zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930124,
					"content": "Essen! Gezeitenalge! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930125
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930125,
					"content": "Magst du Gezeitenalgen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930126
					]
				},
				{
					"id": 741930126,
					"content": "Gezeitenalge! Gezeitenalge! Gezeitenalge, Gezeitenalge, Gezeitenalge!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930127
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930127,
					"content": "Heißt das, du isst fünf an einem Tag, oder dass du fünf Gezeitenalgen zu einer Mahlzeit verspeist? Waah ... Du kannst ja noch mehr wegfuttern als Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930128,
					"content": "Und was ist mit den Zweigen des einsamen Waldes? Finden wir sie, wenn wir dem Nebelpfad im einsamen Wald folgen, Pahsiv?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930129,
					"content": "Melusine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930130
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930130,
					"content": "Zweig des einsamen Waldes ... sehr verloren! Sehr viel Ort! Sehr Erinnyes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930131
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930131,
					"content": "Die Zweige sind überall in Erinnyes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930132
					]
				},
				{
					"id": 741930132,
					"content": "#{NICKNAME} schlau! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930133
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930133,
					"content": "Nebelpfad, Blume, Zweig des einsamen Waldes, auch Blume!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930134
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930134,
					"content": "Zweig des einsamen Waldes ... Zweig des einsamen Waldes ... Zweig des einsamen Waldes ... Zweig des einsamen Waldes ... Zweig des einsamen Waldes ... Zweig des einsamen Waldes ... Zahl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930135
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930135,
					"content": "Ah ... Paimon hat’s! Die Zweige des einsamen Waldes sind an insgesamt sechs Orten, an denen dieselben Blumen wie auf dem Nebelpfad im einsamen Wald wachsen. Hat Paimon recht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930136,
					"content": "Paimon schlau! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930137
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930137,
					"content": "Hehe, jetzt ist alles klar. Pahsiv, dann ruh du dich mal schön aus, wir machen das schon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930138,
					"content": "#Paimon, {NICKNAME}, gut Ding! Also, langsam ... langsam! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pahsiv"
				}
			]
		},
