			"dialogs": [
				{
					"id": 741930301,
					"content": "Pahsiv sieht so glücklich aus. Aber Paimon fragt sich, wofür die hier sein sollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930302,
