				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191010101,
					"content": "Mmm ... Umtrunk bei Zum Katzenschwanz. Nicht schlecht ... gar nicht schlecht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010102
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010102,
					"content": "Zum Katzenschwanz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010103
					]
				},
				{
					"id": 191010103,
					"content": "#Oh he, du bist es, {F#Reisende}{M#Reisender}. Was? Du hast noch nie von „Zum Katzenschwanz“ gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010104
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010104,
					"content": "Deinem Gesichtsausdruck nach zu urteilen, scheinst du den Ort wirklich nicht zu kennen. Mannomann, hast du was verpasst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010105
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010105,
					"content": "Zum Katzenschwanz ist für seine unglaublichen Spezialgetränke bekannt ... Ich spreche von Getränken, die du definitiv noch nie probiert hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010106
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010106,
					"content": "Und wie der Name schon sagt, gibt es im Zum Katzenschwanz jede Menge niedliche Kätzchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010107
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010107,
					"content": "Die Zeit vergeht wie im Flug, wenn man ein leckeres Spezialgetränk genießt und von einer Horde süßer Kätzchen umgeben ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010108,
						191010109
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010108,
					"content": "Ist Zum Katzenschwanz jetzt noch geöffnet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				},
				{
					"id": 191010110,
					"content": "Äh, aber du scheinst noch nicht volljährig zu sein, um zu trinken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010111
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010111,
					"content": "Nun, das sollte kein Problem sein, Diona wird da sein. Sie ist die beste Wirtin in ganz Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010112
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010112,
					"content": "Es sollte ein Kinderspiel für sie sein, dir ein Getränk ohne Alkohol zu mixen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010113
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010113,
					"content": "Und nicht zu vergessen, Diona ist auch ziemlich süß ... wie ein kleines Kätzchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010114
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010114,
					"content": "*Hick* Oh nein ... habe ich das laut gesagt? Äh, bitte sag ihr nicht, dass ich das gesagt habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010115
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010115,
					"content": "Wie auch immer, wenn du dir Zum Katzenschwanz selbst ansehen möchtest, der Eingang ist gleich auf der Rückseite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010116
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010116,
					"content": "Ich werde ... *hick* rübergehen und ein bisschen nüchtern werden, ich glaube, eine fünfte Runde schaffe ich noch nicht ... Ich habe schon viel zu viel getrunken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010109,
					"content": "Ich würde da gerne mal vorbeischauen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				}
			]
		}
	]
}