				"points": []
			},
			"dialogs": [
				{
					"id": 752540409,
					"content": "Tschüss.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540410
					]
				},
				{
					"id": 752540410,
					"content": "Hast du überhaupt schon gefragt, was mit meinem Auge passiert ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525405,
			"completionStepIds": [],
