					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540509,
					"content": "Haben wir das nicht schon mal irgendwo gesehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540501
					]
				},
				{
					"id": 752540501,
					"content": "Mein Freund, das ist ein Wink des Schicksals für eine außergewöhnliche Person. Unsere erste Begegnung ist wie ein Wiedersehen nach langer Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540502
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540502,
					"content": "Durch meine bösartige Augenklappe hast du sicher bemerkt, wie außergewöhnlich ich bin, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
