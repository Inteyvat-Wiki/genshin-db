			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540603,
					"content": "Ach? Du willst wissen, was es mit meinem Auge auf sich hat? Haha! Das gehört zu den drei wichtigsten Lektionen eines echten Mannes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540604
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540604,
					"content": "Erstens: Ein von der Welt gegerbter Körper braucht mindestens eine Narbe. Sonst kann niemand sehen, dass dieser Mann schon einiges durchgemacht hat. Das verleiht ihm nämlich Charakter und Tiefe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540605
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540605,
					"content": "Zweitens: Verdecke diese Narbe teilweise durch ein Kleidungsstück oder ein Accessoire. Sie darf niemals ganz verdeckt sein, sonst merkt niemand, wie besonders dieser Mann ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540606
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540606,
					"content": "Drittens ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540607
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540607,
					"content": "Einen Moment, das habe ich doch gar nicht gefragt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540608
					]
				},
				{
					"id": 752540608,
					"content": "Genau! Das ist der dritte Punkt: Wenn niemand darauf achtet, musst du eben selbst darauf aufmerksam machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
