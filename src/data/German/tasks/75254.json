			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540101,
					"content": "Liebe Freunde! Willkommen in Paititi im Traum – auf der Tete-Insel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540102
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540102,
					"content": "Geradeaus sind die zwei Tavernen das „Honigbrau“ und „Zum Tautropfen“. Ich bin Tecuhtli, der Empfangsmitarbeiter hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525402,
			"completionStepIds": [
				7525403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525403",
							"2"
						],
						"stepId": 7525403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540201,
					"content": "Also, mein Freund, da du jetzt schon von meinem Willkommensdrink gekostet hast, lass dir einen Rat von mir geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540202
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540202,
					"content": "Wenn du hier nur für den Urlaub bist, dann halt dich vom äußersten Norden der Insel fern. Da findest du nichts, was dir guttun würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525403,
			"completionStepIds": [
				7525401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525401",
							"2"
						],
						"stepId": 7525401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540309,
					"content": "In Ordnung, und was ist jetzt mit deinem Auge?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540310
					]
				},
				{
					"id": 752540310,
					"content": "Hmpf! Das war so ein Glatzkopf, der mir diese Narbe verpasst hat ... Der Typ ist ebenfalls hier auf der Insel, und glaubt mir, ich werde ihm dafür schon noch „herzlich danken“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540311
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540311,
					"content": "Ich kann mir vorstellen, dass du jetzt Lust hast, mir bei der Rache zu helfen, was? Ist aber gar nicht nötig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540312
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540312,
					"content": "#{F#Meine Liebe}{M#Mein Freund}, an so einem wunderschönen Sommertag sollte niemand traurig sein müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540313
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540313,
					"content": "Bedien dich ruhig am Willkommenssaft, den ich für unsere Gäste bereithalte, und genieß einfach deinen Urlaub hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540314
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540314,
					"content": "Der Saft steht gleich drüben auf dem Regal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525404,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
