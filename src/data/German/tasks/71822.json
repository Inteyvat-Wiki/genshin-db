			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220101,
					"content": "Tianheng-Berg ... Fürst des ziehenden Himmels ... Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220102
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220102,
					"content": "Worüber denkst du nach?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220103
					]
				},
				{
					"id": 718220103,
					"content": "Ah, ich erforsche gerade die Geschichte und Legenden des Laternenrituals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220104
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220104,
					"content": "Ich habe gehört, dass die diesjährige Mingxiao-Laterne nach einem Adepten namens Fürst des ziehenden Himmels benannt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220105
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220105,
					"content": "Den Legenden, die ich zusammentragen konnte, zufolge, hat dieser Adept für eine Weile auch an der Seite von Rex Lapis gekämpft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220106
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220106,
					"content": "Die genaue Zeit und die Feinde, denen sie sich gestellt haben, variierten jedoch von uraltem Schriftstück zu Schriftstück ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220107
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220107,
					"content": "Alle Texte sind sich jedoch einig, dass der Fürst des ziehenden Himmels weitergezogen ist, und es wird gesagt, dass dieser Adept einst den Tianheng-Berg mit seinem eigenen Geweih aufrecht gehalten hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220108
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220108,
					"content": "Aus diesem Grund bin ich persönlich zum Tianheng-Berg gekommen, um selbst zu sehen, ob ich nicht Glück habe und vielleicht etwas finde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220109
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220109,
					"content": "Aber wie es scheint, wimmelt es auf dem Tianheng-Berg von Monstern. Nachdem ich einen Ort für meine Untersuchungen bestimmt hatte, musste ich feststellen, dass es hier so viele Monster gibt, dass ich nicht passieren kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220110
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220110,
					"content": "#{F#Reisende}{M#Reisender}, kannst du mir dabei helfen diesen Ort zu untersuchen und einige Bodenproben zu nehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220111
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220111,
					"content": "Boden... -proben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220112
					]
				},
				{
					"id": 718220112,
					"content": "Na ja, so nennen wir das an der Akademie. Was wir damit meinen ist etwas Erde aus dem zu untersuchenden Gebiet zu entnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220113
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220113,
					"content": "Lokale Legenden sagen, dass der Fürst des ziehenden Himmels den Tianheng-Berg mit seinem eigenen Geweih aufrecht hielt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220114
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220114,
					"content": "Aus akademischer Sicht kann man davon ausgehen, dass der Boden hier eine ungewöhnliche Zusammensetzung haben könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220115
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220115,
					"content": "Also hilf mir bitte dorthin zu gehen und eine Bodenprobe zu nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 7182202,
