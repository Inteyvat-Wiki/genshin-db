		},
		{
			"id": 7182203,
			"completionStepIds": [
				7182203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182203",
							"2"
						],
						"stepId": 7182203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220301,
					"content": "Hast du die Probe bei dir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220302,
					"content": "Rate mal, wer zurück ist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220303
					]
				},
				{
					"id": 718220303,
					"content": "Vielen Dank. Lass mich mal sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220304,
					"content": "Hmm, an dem Boden hier scheint nichts Besonders zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220305,
					"content": "Was hast du denn erwartet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220306
					]
				},
				{
					"id": 718220306,
					"content": "Die Legenden besagen, dass der Fürst des ziehenden Himmels den Hafen von Liyue mit seinem starken Geweih beschützte, indem er ein Einstürzen vom Tianheng-Berg verhindert hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220307
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220307,
					"content": "Ich dachte, dass ich wenigstens ein paar Fragmente dieses Geweihs finden könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220308
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220308,
					"content": "Wie ich mir schon gedacht habe, Legenden sind eben doch nur Legenden ... Oder ist so viel Zeit seit der Schlacht vergangen, dass alle Spuren davon schon längst verschwunden sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220309
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220309,
					"content": "Dennoch, eine Bodenprobe ist an sich doch kein schlechtes Ergebnis ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220310
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220310,
					"content": "#{F#Reisende}{M#Reisender}, würdest du mir noch etwas länger Gesellschaft leisten? Ich würde gern noch etwas weiter hinaufgehen, es sollte nicht zu weit sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220311,
						718220312
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220311,
					"content": "Überlass das ruhig mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220313
					]
				},
				{
					"id": 718220313,
					"content": "Dieses Mal ... Ich möchte zu einem Aussichtspunkt gelangen, von dem aus ich den Tianheng-Berg überblicken und sein Terrain studieren kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220314
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220314,
					"content": "Die Geschichten besagen, dass Rex Lapis und viele Adepten an der Schlacht teilgenommen haben, und den Tianheng-Berg fast zum Zusammensturz brachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220315
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220315,
					"content": "Wenn die Schlacht wirklich so heftig war, dann können wir vielleicht etwas aus dem Terrain schließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220312,
					"content": "Wonach suchst du dieses Mal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220313
					]
				}
			]
		},
		{
			"id": 7182206,
			"completionStepIds": [
				7182206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182206",
							"2"
						],
						"stepId": 7182206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220601,
					"content": "Endlich sind wir hier ... Der Weg war steinig und gesäumt von Monstern, die wir beseitigen mussten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220602
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220602,
					"content": "An dem Terrain scheint auch nichts besonders zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220603
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220603,
					"content": "Hm? Was ist in diesem Baum hier ... Es ist eine Laterne ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220604
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220604,
					"content": "Warum sollte gerade hier eine Laterne sein? Ist hier etwa jemand hergekommen, um dem verstorbenen Adepten Respekt zu zollen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220605
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220605,
					"content": "Hier steht etwas geschrieben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220606
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220606,
					"content": "„Möge die ganze Welt in Frieden sein.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220607,
						718220608
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220607,
					"content": "Ein edler Wunsch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220609
					]
				},
				{
					"id": 718220609,
					"content": "Das ist wahr. Aber dieser Wunsch ... Wie soll ich es sagen ... Er scheint mir ein bisschen zu edel. Dies scheint weder ein Wunsch zu sein, noch dazu da zu sein, Respekt zu zeigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220610
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220610,
					"content": "Es scheint mehr wie ein Wunsch, den einer dieser Adepten der Legenden aussprechen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220611
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220611,
					"content": "Ich frage mich, wer einen solchen Wunsch auf eine Laterne schreiben sollte. Seltsam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220612
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220612,
					"content": "Wie dem auch sei, scheinbar hat wenigstens eine Person daran gedacht eine Laterne hier hinauf zu bringen. Der Adept sollte recht erfreut sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220613
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220613,
					"content": "Vielen Dank, dass du mich auf diesem weiten Weg begleitet hast. Ich möchte ein wenig hier verweilen und einige weitere Nachforschungen anstellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220614
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220614,
					"content": "Ach ja, das hier ist für dich. Betrachte es als Dankeschön für deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220615
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220615,
					"content": "*seufz* Liyue hat so viele Legenden und doch hat meine Forschung bis jetzt absolut keinen Fortschritt gemacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220608,
					"content": "Es klingt, als wäre die Person hier gewesen, um Respekt zu zollen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220609
					]
				}
			]
		}
	]
}