					"Nasejuna",
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732562401,
					"content": "Wie zu erwarten von der verehrten Gesandten und ihrem Yasnapati. Nichts kann euch im Weg stehen, weder Vorrichtungen der Dahri noch Monster von Dev.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562402
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562402,
					"content": "Hä? Nasejuna, wann bist du reingekommen!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562403,
					"content": "Ich habe euren Heldenmut schon eine Weile draußen bewundert! Aber da ihr die Hymne des Khvarena erhalten habt, muss ich natürlich zu euch eilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562404
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562404,
					"content": "Danke für eure Bemühungen. Jetzt, da ich dabei bin, könnt ihr mir die Aufbewahrung der Hymne des Khvarena anvertrauen. Hmm ... wie soll ich es ausdrücken ... Also, damit könnt ihr mir das Gefühl geben, Teil unseres großen Unterfangens zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562405
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562405,
					"content": "Was? Aber du hast doch nicht allzu viel getan, Nasejuna. Zurvan hat auch gesagt, dass wir die Hymne des Khvarena niemandem leichtfertig anvertrauen sollten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562406,
					"content": "Na ja, das stimmt so nicht. Über die Hymnen des Khvarena habe ich viel recherchiert. Gebt sie mir, damit ich zuerst etwas recherchieren kann, was die Dinge später einfacher macht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562407
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562407,
					"content": "Zum Beispiel kann ich untersuchen, warum diese Hymnen des Khvarena unter der Ruine versteckt sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562408
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562408,
					"content": "Jetzt ist nicht die Zeit zum Geschichtenerzählen, Nasuraia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562409
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562409,
					"content": "Ganz genau! Wir müssen zuerst zum nächsten Ort gehen, an dem ein großes Khvarena versteckt ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562410,
					"content": "Du kannst deine Geschichten fortsetzen, nachdem wir alle großen Khvarena gesammelt haben, Nasejuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562411,
					"content": "Hmm ... na gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
