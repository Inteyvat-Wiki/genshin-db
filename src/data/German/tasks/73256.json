			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nasejuna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732561001,
					"content": "Die Energiekerne sind gefüllt. Jetzt sollten wir in der Lage sein, das gesamte Kontrollsystem zu aktivieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561002
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561002,
					"content": "Hä? Das war aber anders als erwartet. Stimmt irgendwas nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561003
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561003,
					"content": "Sieht so aus, als müssten wir uns zum Kontrollzentrum gehen, wo die Energierelais sind. Es liegt gerade auf dem Weg zum Testgelände.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561004
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561004,
					"content": "Ah, das Kontrollzentrum ist in der Richtung, aus der ihr zuvor gekommen seid. Lasst uns aufbrechen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
		{
			"id": 7325612,
			"completionStepIds": [
				7325612
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325612",
							"2"
						],
						"stepId": 7325612,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
