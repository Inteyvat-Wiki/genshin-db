				{
					"id": 732562801,
					"content": "Wenn ich mit euch gehen würde, würde ich nur eure Last sein. Besser, dass ich hier ruhig auf euch warte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562802
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562802,
					"content": "Sei es Vorrichtungen der Dahri oder Monster von Dev, für die verehrte Gesandte und euch ist alles nur ein Klacks, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
