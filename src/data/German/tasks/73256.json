					"Nasejuna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732562701,
					"content": "Wie es in den Notizen steht ... Hmm? Ihr seid so schnell zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562702
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562702,
					"content": "Aber eurem Gesicht nach zu urteilen, scheint ihr den nötigen Energieblock gefunden zu haben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562703
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562703,
					"content": "Diese Energiekerne habe ich bereits überprüft. Sie sind sehr gut erhalten. Jetzt muss nur noch der Energieblock hineingeladen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562704
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562704,
					"content": "Dann zähle ich auf euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
