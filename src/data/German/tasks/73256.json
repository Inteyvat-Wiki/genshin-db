			"dialogs": [
				{
					"id": 732560301,
					"content": "<color=#00E1FFFF>„Dreht die Zahnräder, bis drei Arten von Runen angezeigt werden. Verbindet das Rechteck mit dem Dreieck unten, ohne dabei das Dreieck unten zu verändern.“</color> Versucht es mal gemäß meinen Anweisungen und es sollte funktionieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
		{
			"id": 7325604,
			"completionStepIds": [
				7325604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325604",
							"2"
						],
						"stepId": 7325604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nasejuna",
					"Sorush",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732560401,
					"content": "Seht, der Moment des Schicksals ist gekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560402
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560402,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560403
					]
				},
				{
					"id": 732560403,
					"content": "Hmm ... Dies ist nur eine gewöhnliche Vorrichtungstür!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560404,
					"content": "*hust* Ich meine, wir können Zugang zu der Ruine erhalten, solange wir diese Tür öffnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560405
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560405,
					"content": "Mein Herz rast bei dem Gedanken, zum ersten Mal einen Fuß auf eine Ruine der Dahri setzen zu können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560406
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560406,
					"content": "Hä? Du klangst gerade so zuversichtlich, dass Paimon dachte, du hättest bereits viele dieser Ruinen erkundet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560407,
					"content": "Ha! Ich habe zwar keine ihrer Ruinen persönlich erkundet, mit dem Buch „Renés Untersuchungsnotizen“, das von einem großen antiken Gelehrten geschrieben wurde, fühlt es sich an, als wäre ich dort gewesen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560408
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560408,
					"content": "„Renés Untersuchungsnotizen“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560409
					]
				},
				{
					"id": 732560409,
					"content": "Habt ihr noch nie davon gehört? Ich dachte, nur Leute wie ich, die in der fernen Wüste abgesondert sind, haben noch nie von einem so brillanten Gelehrten gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560410
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560410,
					"content": "Dieses Buch enthält viele von den Dahri hinterlassenen Aufzeichnungen. In diesen Ruinen, so der Autor, entdeckte er einst ein Wissen „jenseits des Verständnisses der Sterblichen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560411
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560411,
					"content": "Klingt jetzt noch unzuverlässiger ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560412,
					"content": "Dies legen wir erstmal beiseite. Mit diesen Notizen sollten wir also in der Lage sein, zu diesen Dahri-Ruinen zu gelangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560413
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560413,
					"content": "Wenn ihr mir nicht glaubt, lasst uns es mal versuchen! Wenn wir zum Beispiel diese Vorrichtung aktivieren möchten ... Oh, ich habe es gefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560414
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560414,
					"content": "<color=#00E1FFFF>„Dreht die Zahnräder, bis drei Arten von Runen angezeigt werden. Verbindet das Rechteck mit dem Dreieck unten, ohne dabei das Dreieck unten zu verändern.“</color> Versucht es mal gemäß meinen Anweisungen und es sollte funktionieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
