			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nasejuna",
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732561201,
					"content": "Das Problem liegt also tatsächlich bei diesen Relais. Von den Kernen übertragende Energie erreicht sie nicht. Es ist notwendig, einen Weg zu finden, sie anzuschließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561202
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561202,
					"content": "Und diese Relais sind alle in Kristallen versiegelt. Sie sind nicht von der Energie der Unreinheit angetrieben, also hätten sie die Aufmerksamkeit der Khvarena überhaupt nicht erregen sollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561203
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561203,
					"content": "Die einzige Erklärung dafür muss sein, dass dies absichtlich von jemandem versiegelt wurde, der Khvarena kontrollieren kann. Aber warum denn? Was versucht er zu verbergen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561204
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561204,
					"content": "Nun, darüber können wir später diskutieren. Schließlich geht es jetzt vorrangig darum, die Kraft der Khvarena zu nutzen, um die Graukristalle zu entfernen, die diese Vorrichtungen versiegeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561205
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561205,
					"content": "Hmm ... in der Nähe sollte es Farrwick geben, die die Kraft der Khvarena enthalten. Verehrte Gesandte der Khvarena, du solltest sie gespürt haben, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561206
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561206,
					"content": "Hmpf, natürlich. Zweifelst du an meiner Kraft als eine Tapfere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561207
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732561207,
					"content": "Oh nein, das würde ich nie wagen. Meine verehrte Gesandte, ich bitte dich aufrichtig, uns den Weg zu zeigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561208
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561208,
					"content": "Wir müssen nur die Farrwick finden, die Graukristalle entfernen und dann den Mixer erneut laufen lassen, um diese Relais zu verbinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
