			"dialogs": [
				{
					"id": 732562001,
					"content": "Oh, aus dem Boden tauchte eine seltsame Kanone auf! Heißt das, dass wir damit auf die Riesenmaschine da drüben schießen sollten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562002,
					"content": "Ähm ... Wirklich ein durchdachtes Design.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562003,
					"content": "Ha, du hast wirklich eine wilde Fantasie, weißes Schweberchen. Hat der Nasuraia nicht gerade gesagt, dass dieser Ort umgebaut wurde und zuvor ein Leistungstestgelände für die Vorrichtungen war?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562004
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562004,
					"content": "Offensichtlich war der Apparat, den wir gerade freigeschaltet haben, dazu gedacht, dieses Testgelände zu aktivieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562005
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562005,
					"content": "Obwohl ein Umbau durchgeführt wurde, scheint die ursprüngliche Vorrichtung nicht entfernt worden zu sein, was die Sache für uns ein wenig einfacher machen sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562006
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562006,
					"content": "Nun, mein Yasnapati, ich vertraue dir den Betrieb dieser Kanone an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				}
			]
		},
		{
			"id": 7325623,
			"completionStepIds": [
				7325623
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325623",
							"2"
						],
						"stepId": 7325623,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nasejuna",
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732562301,
					"content": "Verehrte Gesandte, verehrter Yasnapati, ich fürchte, ich kann euch nur bis hierher begleiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562302
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562302,
					"content": "... Was ist es denn diesmal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732562303
					]
				},
				{
					"id": 732562303,
					"content": "Laut Aufzeichnungen ist der folgende Weg voller Gefahren, die gewöhnliche Sterbliche nicht ertragen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562304
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562304,
					"content": "Hier geht es direkt zum Testgelände, das die Dahri einst benutzten, um die Leistung ihrer Vorrichtungen zu testen. Im Inneren sollte es sogar einen unvollständigen Prototyp einer Riesenvorrichtung geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562305
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562305,
					"content": "Meine Notizen weisen darauf hin, dass dieser Ort einst zu einer Befestigung gegen Monsterangriffe umgebaut wurde, obwohl er in dieser Hinsicht keine allzu große Funktion erfüllte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562306
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562306,
					"content": "Seltsam, nicht wahr? Es waren die Dahri, die die große Katastrophe der Unreinheit verursachten, aber sie bauten auch diese Vorrichtungen, um Monster abzuwehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562307
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562307,
					"content": "Aber jetzt, da wir das gesamte Kontrollsystem der Ruine aktiviert haben, müssen die Abwehrvorrichtungen innerhalb des Testgeländes aktiviert worden sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562308
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562308,
					"content": "Und die Hymne des Khvarena, nach der wir suchen, sollte in dieser Riesenmaschine versteckt sein. Obwohl die lauernden Gefahren Sterbliche wie mich zurückschrecken, bin ich sicher, dass diese Aufgabe für euch nur ein Klacks ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562309
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562309,
					"content": "Bitte gestattet mir, hier zu bleiben und auf eure Rückkehr zu warten. Ich vertraue darauf, dass ihr alle Hymnen des Khvarena sammeln könnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562310
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562310,
					"content": "Na schön, du bist schließlich nur ein gewöhnlicher Mensch. Einen solchen Antrag halte ich für vernünftig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562311
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562311,
					"content": "Danke für deine gnädige Erlaubnis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562312
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562312,
					"content": "Ach, dieser feige Nasejuna, im letzten Moment hat er sich wieder davongeschlichen. Trotzdem ist Paimon jetzt viel erleichterter, da ihr beide eine Weile nicht zusammen sein werdet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7325624,
			"completionStepIds": [
				7325624
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
