			"dialogs": [
				{
					"id": 732560901,
					"content": "Was ist, seid ihr auf irgendwelche Probleme gestoßen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560902
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560902,
					"content": "Folgt einfach den Anweisungen dieses Schemas und ihr solltet den Energieblock finden können. Dann könnt ihr zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
		{
			"id": 7325610,
			"completionStepIds": [
				7325610
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
