			"dialogs": [
				{
					"id": 722460401,
					"content": "„Die Welt ist so weit ... “",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460402
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460402,
					"content": "Ist das ein Zitat von „Joururi Kidoutai“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460403
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460403,
					"content": "Ja, dein Gedächtnis ist echt nicht schlecht Kama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460404
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460404,
					"content": "Du hast mir diese Geschichte erzählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kama"
				}
			]
		}
