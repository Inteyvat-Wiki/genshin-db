					"content": "Hat Sumida einen Plan, wohin er danach gehen wird?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460302
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460302,
					"content": "Hmmm ... Ich habe gehört, dass es eine große Bibliothek in Mondstadt gibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sumida"
				}
			]
