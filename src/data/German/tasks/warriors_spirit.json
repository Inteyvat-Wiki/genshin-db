			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880101,
					"content": "Deine Kampfkunst ist großartig. Du hast dir den Sieg mehr als verdient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880102
					],
					"speakerTitle": "Akatsuki Saemon Juuzou"
				},
				{
					"id": 736880102,
					"content": "Du hast sehr gut gekämpft.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880103
					]
				},
				{
					"id": 736880103,
					"content": "#Meine Damen und Herren, nach einem atemberaubenden Kampf steht {F#die Gewinnerin}{M#der Gewinner} des Turniers „Kämpferherz“ fest! Eine Runde Applaus für ... {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880104
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880104,
					"content": "#Morgen wird der längst ersehnte Schaukampf stattfinden ... {F#Die}{M#Der} Reisende und Fräulein Kamisato gegen den auserwählten Gesandten des allmächtigen Shougun, einen autonomen Humanoiden namens „Maguu Kengou“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880105
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880105,
					"content": "Den solltet ihr nicht verpassen! Wir sehen uns dann! Tschüs!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880106
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880106,
					"content": "#{F#Reisende}{M#Reisender}, das war ein toller Wettkampf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880107
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880107,
					"content": "#Herzlichen Glückwunsch, {F#Reisende}{M#Reisender}! Dein Siegertitel ist wohlverdient!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880108
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880108,
					"content": "Aber euer Gegner morgen ist Maguu Kengou, das hätte Paimon nicht erwartet. Der Name hört sich ähnlich an wie der des Unruhestifters, den wir auf Yashiori getroffen haben. Es wird kein leichter Kampf sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880109,
					"content": "Mach dir keine Sorgen, Paimon. Der von Shougun gewählte Gesandte mag zwar stark sein, aber der morgige Kampf verbietet nicht den Einsatz des Göttlichen Auges. Wir sind also nicht zu sehr benachteiligt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880110
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880110,
					"content": "Solange wir uns gut wehren können, lässt sich die Gelegenheit zum Gegenangriff auch nicht zu lange warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880111
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880111,
					"content": "Da ist Paimon ja beruhigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880112,
					"content": "Ich kann nicht garantieren, dass wir gewinnen, aber wir müssen unser Bestes geben, um den Zuschauern zumindest einen unvergesslichen Schaukampf zu bieten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880113,
						736880114
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880113,
					"content": "Wir werden schon gewinnen, Ayaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				},
				{
					"id": 736880115,
					"content": "Ich sehe, dass ihr beide schon in den Startlöchern steht, aber das Beste wäre, dass ihr euch heute Abend erstmal gut ausruht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880116
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880116,
					"content": "Wenn wir morgen aufwachen, werden wir auch Ayakas neues Kleid sehen können. Ayaka in einem Fontaine-Kleid ... Oh, Paimon kann es kaum erwarten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880117,
					"content": "Hmm, na ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880118,
						736880120
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880118,
					"content": "Ich bin auch gespannt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880119
					]
				},
				{
					"id": 736880119,
					"content": "#{F#Reisende}{M#Reisender}, du auch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880121
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880121,
					"content": "Hehehe, Ayaka, erfülle doch ihren Wunsch. Ich würde auch gerne kommen, aber leider muss ich morgen noch was erledigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880122
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880122,
					"content": "Gut, ich warte morgen früh im Kamisato-Anwesen auf euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880120,
					"content": "Soll ich dich morgen abholen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880121
					]
				},
				{
					"id": 736880114,
					"content": "Das kriegen wir gemeinsam hin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				}
			]
		},
		{
			"id": 7368802,
			"completionStepIds": [
				7368803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368803",
							"2"
						],
						"stepId": 7368803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hirotatsu",
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880201,
					"content": "Morgen, seid gegrüßt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880202
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880202,
					"content": "Oh, es ist Hirotatsu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880203,
					"content": "#{NICKNAME} hat dich besiegt und zudem auch das Turnier gewonnen, was hast du nun noch zu sagen, hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880204,
					"content": "#Keine Sorge, ich bin nicht hier, um Ärger zu machen. Ich wollte mich nur entschuldigen. {F#Reisende}{M#Reisender}, ich habe vor ein paar Tagen in unserem Duell klar und deutlich verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880205
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880205,
					"content": "Deine Schwertkunst ist hervorragend. Jeder Schlag war sehr präzise, aber nicht aggressiv, was eine Menge über deine Persönlichkeit aussagt. Ich bitte dich um Vergebung für die Vorurteile und dafür, dass ich dich vorhin geärgert habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880206,
						736880207
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880206,
					"content": "Schon gut, ich habe es nicht persönlich genommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				},
				{
					"id": 736880208,
					"content": "Ihr müsst hier sein, um Fräulein Kamisato abzuholen. Sie ist gerade in der Umkleide, aber sie sollte gleich kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880209
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880209,
					"content": "#{F#Reisende}{M#Reisender}, bevor mein Fräulein kommt, habe ich eine ziemlich anmaßende Bitte, die du hoffentlich berücksichtigen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880210
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880210,
					"content": "Gut. Wie kann ich helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880211
					]
				},
				{
					"id": 736880211,
					"content": "Auch wenn das junge Fräulein uns Gefolgsleuten nie den heutigen Schaukampf erwähnt hat, sehen wir jeden Abend, wie sie stundenlang die Schwertkunst übt, obwohl sie tagsüber schon sehr beschäftigt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880212
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880212,
					"content": "Sie war schon immer fleißig und pflichtbewusst. Obwohl es nur ein Schaukampf ist und es nicht schlimm ist, wenn ihr verlieren würdet, glaube ich, dass sie alles geben wird, um zu gewinnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880213
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880213,
					"content": "Als ihr Gefolgsmann zweifle ich nie an ihrer Stärke, aber ... ich hoffe trotzdem, dass du mein Fräulein in der Arena unterstützen und beschützen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880214
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880214,
					"content": "Keine Sorge, ich kümmere mich darum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880215
					]
				},
				{
					"id": 736880215,
					"content": "#Dann zähle ich auf dich, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880217
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880217,
					"content": "Ah! Das muss Ayaka sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880218,
					"content": "Oha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880219,
					"content": "Hm? Warum seid ihr beide plötzlich so schweigsam ...? Stimmt etwas mit dem Kostüm nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880220
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880220,
					"content": "Nein, nein! Ayaka, du siehst darin fantastisch aus ... Du strahlst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880221,
						736880225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880221,
					"content": "Dieses Kostüm steht dir sehr gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880222
					]
				},
				{
					"id": 736880222,
					"content": "Ja, ja! Du siehst wie ein temperamentvolles Fräulein aus Fontaine aus, sehr reizend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880223,
					"content": "Ja? Ich war besorgt, dass es ein bisschen zu viel sein könnte ... war mir nicht sicher, ob dieser Stil zu mir passen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880224
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880224,
					"content": "Aber wenn ihr das sagt, dann bin ich beruhigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880229,
					"content": "Hehe, das Publikum wird bestimmt auch begeistert sein, wenn Ayaka auftritt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880230,
					"content": "#Danke für dein Kompliment, Paimon. {F#Reisende}{M#Reisender}, da wir nun bereit sind, begeben wir uns in die Arena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880231
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880231,
					"content": "#Mein Fräulein, {F#Reisende}{M#Reisender}, ich wünsche euch viel Erfolg für den Schaukampf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880225,
					"content": "Das ist eine wunderschöne Bekleidung und sie steht dir perfekt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880226
					]
				},
				{
					"id": 736880226,
					"content": "Genau! Da ist sogar das Hauswappen des Kamisato-Klans aufgestickt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880227,
					"content": "Ja, Herr Onodera und seine Leute haben sich sehr viel Mühe gegeben. Das mit dem Wappen soll auf den Vorschlägen beruhen, die das Publikum auf die Stimmzettel geschrieben hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880228
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880228,
					"content": "Und die Bekleidung ist sehr gut auf meine Figur zugeschnitten. Sie bietet mehr Bewegungsfreiheit, als ich erwartet habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880207,
					"content": "Ich habe unser Duell genossen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				}
			]
		},
		{
			"id": 7368803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
