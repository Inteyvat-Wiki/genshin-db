			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880301,
					"content": "#Schaut! Fräulein Kamisato und {F#die Reisende}{M#der Reisende} sind da!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880302
					],
					"speakerTitle": "Yuu"
				},
				{
					"id": 736880302,
					"content": "Ich habe zwar schon Abbildungen dieser Bekleidung gesehen, aber dass Fräulein Kamisato sie trägt, macht es wirklich einzigartig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880303
					],
					"speakerTitle": "Sae"
				},
				{
					"id": 736880303,
					"content": "Es hat sich gelohnt, sehr früh anzustehen, um Plätze in der ersten Reihe zu ergattern. Der Schaukampf wird bestimmt brillant sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880304
					],
					"speakerTitle": "Matsumae"
				},
				{
					"id": 736880304,
					"content": "Oha, Ayaka steht sofort im Fokus des Interesses, sobald sie auftaucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880305,
					"content": "Meine Damen und Herren, ich bitte um eure Aufmerksamkeit. Der Schaukampf des Turniers „Kämpferherz“ beginnt gleich. Bitte betretet die Arena in geordneter Weise und nehmt eure Plätze ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880306
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880306,
					"content": "#Fräulein Kamisato, {F#Reisende}{M#Reisender}, bitte kommt mit mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880307
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880307,
					"content": "#{F#Reisende}{M#Reisender}, bist du bereit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880308,
						736880310
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880308,
					"content": "Ja, lass uns loslegen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880309
					]
				},
				{
					"id": 736880309,
					"content": "Gut, lass uns unser Bestes geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880310,
					"content": "Ich muss mich noch vorbereiten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880311
					]
				},
				{
					"id": 736880311,
					"content": "Lass dir Zeit. Wir werden die Arena gemeinsam betreten, wenn du bereit bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				}
			]
		},
		{
			"id": 7368804,
			"completionStepIds": [
				7368806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368806",
							"2"
						],
						"stepId": 7368806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880401,
					"content": "#{NICKNAME}, Ayaka, wir sind hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880402,
					"content": "Das war außergewöhnlich. Ich weiß nicht viel über die Schwertkunst, aber selbst ich wurde von der Spannung in der Arena gefangen genommen. Mein Herz klopft auch jetzt noch schnell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880403
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880403,
					"content": "Die Angriffe eures Gegners haben Paimon immer wieder schockiert, aber es scheint, als wärt ihr beide darauf gut vorbereitet gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880404,
					"content": "#{F#Reisende}{M#Reisender}, Fräulein Kamisato, herzlichen Glückwunsch zum Sieg im Schaukampf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880405
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880405,
					"content": "He, Sara! Du hast dir den Schaukampf auch angeschaut?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880406,
					"content": "Ich habe vom Shougun den Auftrag erhalten, diesen Schaukampf zu beobachten. Eure Schwertkunst ist bemerkenswert. Eure Zusammenarbeit hat den Zuschauern die Schönheit der Schwertkunst näher gebracht. Da konnte ich auch sehr viel mitnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880407
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880407,
					"content": "Ich fühle mich geschmeichelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880408
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880408,
					"content": "Ihr habt euch bei der Vorbereitung des Turniers „Kämpferherz“ sehr engagiert. Heute habt ihr es auch gemeinsam zu einem guten Ende gebracht. Der Shougun hat eure Bemühungen hochgeschätzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880409
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880409,
					"content": "Ich muss jetzt zum Tenshukaku zurückkehren und dem Shougun über diesen Schaukampf berichten. Entschuldigt mich bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880411
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880411,
					"content": "Und was habt ihr noch vor? Wie wäre es, dass wir gemeinsam zur Uyuu-Pagode gehen, um den Sieg zu feiern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880412
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880412,
					"content": "Super! Wir waren so sehr mit dem Turnier beschäftigt, dass wir schon lange kein gutes Essen mehr hatten. Los geht’s, schnell!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880413,
					"content": "Ah ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880414
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880414,
					"content": "Was ist, Ayaka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880415
					]
				},
				{
					"id": 736880415,
					"content": "Nichts Besonderes. Die Auswirkungen des Sieges beginnen sich zu zeigen. Fräulein Kujou Sara hat gesagt, dass sie viel aus dem Schaukampf gelernt hat, und das habe ich auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880416,
					"content": "Auch wenn die Zuschauer es vielleicht nicht bemerkt haben, gab es viele Momente, in denen ich in Gefahr gewesen wäre, wenn du nicht an meiner Seite gewesen wärst und die Angriffe des Gegners auf dich gezogen hättest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880417
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880417,
					"content": "Ohne dich wäre es unmöglich gewesen, allein mit meinen Fähigkeiten zu gewinnen. Wie ich erwartet habe, ist meine Schwertkunst noch weit von deinem Niveau entfernt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880418,
						736880419
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880418,
					"content": "Du hast mich auch mehrmals gerettet, Ayaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				},
				{
					"id": 736880420,
					"content": "Wirklich? Ich habe auf einmal Lust, mal gegen dich zu kämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880421
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880421,
					"content": "Um ehrlich zu sein, träume ich seit unserem ersten Treffen immer davon, mich mal mit dir im Kampf zu messen. Dieser Wunsch wurde heute im Schaukampf zum Teil erfüllt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880422
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880422,
					"content": "Wir werden eine Gelegenheit für ein Kräftemessen finden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880423
					]
				},
				{
					"id": 736880423,
					"content": "Gut. Aber ... bis dahin solltest du dein Schwert gut aufbewahren. Wenn es mir eines Tages gelingt, es zu stehlen, wird dann ... auch dein Leben in meinen Händen liegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880424
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880424,
					"content": "Hehe ... so etwas wollte ich schon immer mal sagen. Hat es sich komisch angehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880425,
						736880426
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880425,
					"content": "Klingt sehr nach Fräulein Orith.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880427,
					"content": "He, wieso lauft ihr so langsam? Wovon redet ihr da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880428,
					"content": "Wir haben gerade über einen Kampf zwischen uns gesprochen. Wir wollen wissen, wer von uns der bessere Schwertkämpfer ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880429
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880429,
					"content": "Hoho, Ayaka ist regelrecht besessen von der Schwertkunst. Seid ihr zwei nicht befreundet? Trotzdem braucht ihr ein Duell?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880430,
					"content": "Gerade weil wir Freunde sind, sollten wir uns häufig im Kampf messen und voneinander lernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880431
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880431,
					"content": "Hmm, das macht irgendwie Sinn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880432,
					"content": "#{F#Reisende}{M#Reisender}, das war ein Geheimnis zwischen uns, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880433
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880433,
					"content": "Hm? Ayaka, was hast du gerade gesagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880434,
					"content": "Nichts, wir sollten uns beeilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880426,
					"content": "Überhaupt nicht, klingt süß.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880419,
					"content": "Ayaka, du bist zu bescheiden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				}
			]
		},
