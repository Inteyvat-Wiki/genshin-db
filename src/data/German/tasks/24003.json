				]
			},
			"dialogs": [
				{
					"id": 240030901,
					"content": "#Bruder! Bruder, hast du {M#ihm}{F#ihr} etwa mein Versteck verraten? Warum konnte {M#er}{F#sie} mich sonst so schnell finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030902
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030902,
					"content": "Ich habe dir doch gesagt, dass deine Verstecke zu offensichtlich sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030903,
						240030904
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030903,
					"content": "Ich habe viel Erfahrung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030905
					]
				},
				{
					"id": 240030905,
					"content": "Ach so? Na dann kannst du doch öfters vorbeikommen? Wir spielen zusammen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030906
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030906,
					"content": "Mama und Papa sind tagsüber nie zu Hause und mein Bruder liest immer nur Bücher ... Niemand hat Zeit, um mit mir zu spielen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030907
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030907,
					"content": "Du könntest auch ein paar Bücher aus dem Regal lesen, so wie ich. Das wäre besser und sinnvoller, als Verstecken zu spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030908
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030908,
					"content": "Da ... Da gehe ich lieber zu Mama und lerne, wie man Kleider flickt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030904,
					"content": "Ich bin wirklich gut im Versteckspielen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030905
					]
				}
			]
		}
	]
}