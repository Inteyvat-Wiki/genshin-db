			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verut",
					"Aurèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030101,
					"content": "Diesmal wirst du mich nicht finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030102,
					"content": "Wenn du dich an solchen Orten versteckst, werden nicht ich, sondern deine Eltern nach dir suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030103
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030103,
					"content": "Was macht ihr da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030104
					]
				},
				{
					"id": 240030104,
					"content": "Ich spiele mit meinem Bruder Verstecken! Aber ... er weiß immer, wo ich mich verstecke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030105,
					"content": "Verut ... wir haben schon sehr oft hier gespielt. Du hast schon alle möglichen Verstecke durchprobiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030106
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030106,
					"content": "Und die Plätze, an denen du dich nicht verstecken kannst ... Ich habe dir doch schon tausendmal erklärt, warum das nicht geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030107
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030107,
					"content": "Die sind doch gar nicht gefährlich, Mama und Papa übertreiben immer nur ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030108,
					"content": "Aber dort machst du dir deine Kleider dreckig oder zerreißt dir die Hosen. Mama und Papa arbeiten schon hart genug, also bereite ihnen nicht noch mehr Kummer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030109
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030109,
					"content": "Na ... Na gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030110,
						240030111
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030110,
					"content": "Wollt ihr vielleicht ... dass ich mitspiele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				},
				{
					"id": 240030112,
					"content": "Wirklich?! Willst du wirklich mit mir spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030113
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030113,
					"content": "Verut, nerv doch die anderen nicht so! Entschuldige, mein Bruder denkt immer nur ans Spielen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030114,
						240030115
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030114,
					"content": "Es ist in Ordnung, ich habe gerade Zeit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030116,
					"content": "#Super! Hörst du das, Bruder? {M#Er}{F#Sie} sagt, es ist in Ordnung! Ich kann mich bestimmt besser verstecken als du!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030117,
					"content": "Also gut ... Vielen Dank, dass du mit uns spielst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030118
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030118,
					"content": "Verut, verstecke dich aber nicht an den Plätzen, die ich dir verboten habe. Mama und Papa kommen heute spät nach Hause, wenn du dir deine Kleidung kaputt machst, wird sie dir niemand flicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030119
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030119,
					"content": "Ich weiß doch! Hör auf, das zu wiederholen, es ist so nervig ... Ich verstecke mich zuerst. Los Bruder, spiel auch mit, schnell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030120
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030120,
					"content": "Flitz los, ich habe mir schon ein Versteck ausgedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030121
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030121,
					"content": "#Wirklich? Du gibst wohl schon wieder an. {M#Er}{F#Sie} findet dich garantiert zuerst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030122
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030122,
					"content": "Aurèle und Verut verstecken sich an verschiedenen Orten ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240030115,
					"content": "Es ist in Ordnung, das stört mich nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030111,
					"content": "Ich finde dich bestimmt nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				}
			]
		},
		{
			"id": 2400302,
			"completionStepIds": [
				2400302
			],
