			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aurèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030701,
					"content": "Wann wird Verut endlich erwachsen ... *seufz* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030702
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030702,
					"content": "Versteckst du dich nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030703
					]
				},
				{
					"id": 240030703,
					"content": "Ich will eigentlich gar nicht spielen. Wenn Verut nicht so gebettelt hätte, hätte ich ein Buch gelesen, anstatt Verstecken zu spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030704
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030704,
					"content": "Mama und Papa arbeiten wirklich hart und ich muss schnell erwachsen werden ... damit ich ihnen etwas von der Last abnehmen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030705
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030705,
					"content": "Aber Verut vermisst Mama immer so sehr ... Nur wenn ich mit ihm spiele, hört er auf zu weinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030706
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030706,
					"content": "Entschuldige, ich habe wohl zu viel gesagt. Ich gehe jetzt zum Treffpunkt und warte dort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030707
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240030707,
					"content": "Ich hoffe, Verut macht seine Kleidung nicht schmutzig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				}
			]
		},
