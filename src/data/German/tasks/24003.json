				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030201,
					"content": "Boah! Du hast mich gefunden! Hat dir etwa mein Bruder dieses Versteck verraten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030202
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030202,
					"content": "Na schön ... Du bist gut! Ich gehe zum Treffpunkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
