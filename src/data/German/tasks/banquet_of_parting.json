			"dialogs": [
				{
					"id": 120290812,
					"content": "Während die Nacht hereinbricht, versammeln sich die Monster langsam in diesem Gebiet ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 120310801,
					"content": "Diese Monster sehen wirklich verunsichert aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310802,
						120310803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310802,
					"content": "Wir können sie nicht auf den Berg lassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310804
					]
				},
				{
					"id": 120310803,
					"content": "Lass sie uns loswerden, für Miko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310804
					]
				},
				{
					"id": 120310804,
					"content": "Jawohl! Lass sie uns so schnell wie möglich loswerden! Dann sind wir rechtzeitig zurück, um die Youkai zu sehen, hehehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310805,
					"content": "#Sie kommen, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
