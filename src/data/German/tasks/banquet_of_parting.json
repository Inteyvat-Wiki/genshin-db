			},
			"dialogs": [
				{
					"id": 120310901,
					"content": "Hm, genau wie ich dachte, verlief das Ritual sehr reibungslos. Ich danke euch beiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310902
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310902,
					"content": "Miko, geht es dir gut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310903
					]
				},
				{
					"id": 120310903,
					"content": "Hm? Mir geht’s gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310904
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310904,
					"content": "Aber der Ausdruck in deinem Gesicht gerade ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310905,
					"content": "Mir geht es gut, wirklich. Wirklich! I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310906
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310906,
					"content": "Hm ... Also ehrlich, ihr zwei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310907
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310907,
					"content": "Miko ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310908,
					"content": "Na gut, wenn du unbedingt etwas für mich tun willst, kannst du mich zum Essen einladen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310909
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310909,
					"content": "Klar, kein Problem! Eine gute Mahlzeit soll es sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310910,
					"content": "Eine gute Mahlzeit? Abgemacht!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310911
					]
				},
				{
					"id": 120310911,
					"content": "Gut. Also dann, bis bald.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				}
			]
		},
