							"1203102",
							"2"
						],
						"stepId": 1203102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maki",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310201,
					"content": "... Den Berg hinabsteigen? Ist das der Befehl von Frau Guuji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310202
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310202,
					"content": "Ja, Miko hat gesagt, dass das Ritual, das sie bald durchführen wird, eine physische Gefahr für euch alle darstellen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310203,
					"content": "Ich verstehe ... Ich werde alle sofort evakuieren. Was ist mit dir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310204
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310204,
					"content": "Wir werden uns um ein paar andere Dinge für sie kümmern und wenn wir damit fertig sind, kommen wir zurück und machen das Ritual gemeinsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310205,
						120310206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310205,
					"content": "Weil wir sichergehen wollen, dass sie auch in Sicherheit ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				},
				{
					"id": 120310207,
					"content": "Es scheint, dass Frau Guuji großes Vertrauen in dich setzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310208
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310208,
					"content": "Frau Guuji hat in der Vergangenheit bei solchen Ritualen nie jemand anderen an ihre Seite gelassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310209
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310209,
					"content": "Danke für deine Hilfe bei dem Ritual und ... viel Glück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310210
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310210,
					"content": "Keine Sorge, wir sind viel stärker, als wir aussehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310206,
					"content": "Weil wir die Youkai sehen wollen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				}
			]
		},
		{
			"id": 1203104,
			"completionStepIds": [
				1203106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203106",
							"2"
						],
						"stepId": 1203106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Paimon",
					"Okazaki Rikuto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310401,
					"content": "Ah, meine kleinen Freunde, da seid ihr ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310402
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310402,
					"content": "Miko ... Was ist das? Du hast ohne uns angefangen zu essen!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310403,
					"content": "Das habe ich, ja. Du bezahlst ja schließlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310404
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310404,
					"content": "Der Gedanke, die teuersten Gerichte zu essen und die besten Weine zu trinken, und das alles völlig kostenlos ... Oh, ich konnte es einfach nicht mehr erwarten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310405
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310405,
					"content": "Ah, Chef, siehst du diese beiden Gesichter hier? Merk sie dir. Sie sind diejenigen, die später die Rechnung begleichen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310406
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310406,
					"content": "In Ordnung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310407
					],
					"speakerTitle": "Okazaki Rikuto"
				},
				{
					"id": 120310407,
					"content": "Ähmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310408,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310409
					]
				},
				{
					"id": 120310409,
					"content": "Was ist denn in euch gefahren? Kommt schon, setzt euch hin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310410
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310410,
					"content": "Du musst diesen Fisch unbedingt probieren. Er kommt ausschließlich in den Gewässern um die Insel Seirai vor. Er wurde über Nacht nach Inazuma geliefert und war noch lebendig, bis ich ihn bestellt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310411,
					"content": "Oder möchtest du vielleicht lieber das hier probieren? Ich weiß, ich weiß, ich kann mich normalerweise auch nicht dazu durchringen, so teuren Sake zu trinken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310412
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310412,
					"content": "Wenn du keinen Alkohol trinkst, ist das auch in Ordnung. Es gibt alle Arten von Fruchtsäften, die das ganze Preisspektrum abdecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310413
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310413,
					"content": "Grrr ... Miko! Du bist unverschämt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310414,
					"content": "Als wir das letzte Mal hier waren und an dem Roman gearbeitet haben, hast du uns nur das einfachste Kushikatsu bestellt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310415,
					"content": "Hm? Seltsam, ich kann mich an nichts dergleichen erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310416,
						120310417
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310416,
					"content": "So war es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310418
					]
				},
				{
					"id": 120310418,
					"content": "Oh. Was soll’s? Du hast mir doch angeboten, mich zum Essen einzuladen, oder nicht? Außerdem bin ich so etwas wie ein Ehrengast, weißt du. Wäre es dir nicht peinlich, mich nicht großzügig zu behandeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310419
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310419,
					"content": "Miko, dieses Essen wird superteuer werden. Hast du keine Angst, dass wir es uns nicht leisten können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310420,
					"content": "Hehe, mach dir da mal keine Sorgen. Ihr könnt es euch auf jeden Fall leisten ... Euer Roman wird immer noch stapelweise gedruckt, weißt du. Ihr habt eine ziemlich großzügige Zahlung zu erwarten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310421
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310421,
					"content": "Was!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310422,
					"content": "#Aaaah, so ein Mist!!! Sie hat uns reingelegt, {NICKNAME}! Miko war von Anfang an hinter unseren Mora her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310423,
						120310424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310423,
					"content": "Wir hätten nicht so leichtsinnig sein sollen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310425
					]
				},
				{
					"id": 120310425,
					"content": "Hahaha, oh, die Blicke auf euren Gesichtern in diesem Moment. Echt perfekt, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310426
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310426,
					"content": "Übrigens, seit in der mondlosen Nacht keine Wünsche mehr in Erfüllung gingen, sind Romane mit Zaubersprüchen nicht mehr so beliebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310427
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310427,
					"content": "#Also müsst ihr euch für das nächste Kapitel von „Die wundersamen Abenteuer {F#der}{M#des} Reisenden“ etwas Neues einfallen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310428
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310428,
					"content": "Das Fälligkeitsdatum rückt näher ... Ich zähle auf euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310424,
					"content": "Wir wurden auf die Schippe genommen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310425
					]
				},
				{
					"id": 120310417,
					"content": "Kushikatsu und frittierter Tofu. Das war’s.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310418
					]
				}
			]
		},
