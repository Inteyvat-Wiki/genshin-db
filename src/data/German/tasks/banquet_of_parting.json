				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310101,
					"content": "Hallo, meine kleinen Helfer, wie schön, dass ihr dabei seid. Ihr seid auch genau pünktlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310102,
					"content": "Hmpf, als ob wir eine Wahl hätten. Wir wollen nur unsere Gehaltsschecks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310103,
					"content": "Also, Miko, was genau müssen wir tun, damit dieses Hyakkiyakou stattfindet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310104,
					"content": "Um das klarzustellen: Wir haben keine Ahnung, was das überhaupt bedeutet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310105,
					"content": "Es mag ominös klingen, aber um es einfach auszudrücken, ist das Hyakkiyakou nur eine Versammlung der Youkai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310106,
					"content": "Früher, bei den Youkai-Versammlungen, wenn alle genug getrunken hatten, begann einer nach dem anderen mit seinen Youkai-Kräften in den Himmel zu steigen. Es waren so viele von ihnen, dass ihre Silhouetten den Mond verdeckten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310107,
					"content": "Aber jetzt sind die Erinnerungen der Youkai, die aus dem Fluss der Elemente austreten, schwach. Sie sind nicht mehr in der Lage zu fliegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310108
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310108,
					"content": "Deshalb werde ich ein Einberufungsritual für sie durchführen, bei dem alle wandernden Erinnerungen an einem Ort versammelt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310109,
					"content": "Wenn die Zeit gekommen ist, versammeln sie sich am Himmel über dem Großen Narukami-Schrein. Wenn ihre Energie verbraucht ist, sind sie zufrieden und kehren dorthin zurück, wo sie hingehören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310110
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310110,
					"content": "Oh, ich verstehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310111
					]
				},
				{
					"id": 120310111,
					"content": "Alle Vorbereitungen für das Ritual wurden eigentlich schon lange im Voraus getroffen. Erinnerst du dich an den Zauberspruch und die Erwähnung der „mondlosen Nacht“, die ich in unserem Roman hinzugefügt habe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310112,
					"content": "Ach ja, etwas über das Rezitieren von „Die geheimen Zauber der Kitsune“ in einer mondlosen Nacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310113,
					"content": "Das ist es. Eigentlich ist es gar kein Zauberspruch zur Wunscherfüllung. Es ist ein Zauber, der hilft, die Erinnerungen im Fluss der Elemente zu beruhigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310114
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310114,
					"content": "Wenn es so weit ist, lasst uns alle mit anpacken und sie auf den Weg schicken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310115
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310115,
					"content": "Was brauchst du von mir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310116
					]
				},
				{
					"id": 120310116,
					"content": "Ich werde in Kürze mit den rituellen Vorbereitungen beginnen und zu diesem Zeitpunkt musst du zwei Dinge tun:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310117
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310117,
					"content": "Sag den Schreinjungfern zuerst, dass sie den Berg verlassen sollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310118
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310118,
					"content": "Während des Hyakkiyakou wird ein ganzer Schwarm von Youkai-Erinnerungen in der Luft über dem Großen Narukami-Schrein herumschweben. Wenn die Schreinjungfern gehen, wird das lästige Problem vermieden, dass jemand besessen werden könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310119
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310119,
					"content": "Danach beginne ich mit dem Ritual und die Erinnerungen beginnen sich zu sammeln. Das wird einige Zeit dauern. Während dieser Zeit brauche ich dich am Fuße des Yougou-Berges, um die Aktivitäten der Monster in der Nähe im Auge zu behalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310120
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310120,
					"content": "Die Erinnerungen sind normalerweise verstreut und stellen keine Bedrohung dar. Aber wenn ihre Energie konzentriert ist, kann sie die Monster stören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310121
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310121,
					"content": "Sie könnten dies als Gelegenheit sehen, den Berg zu erklimmen. Du musst sie abwehren, damit das nicht passiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310122
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310122,
					"content": "Alles klar, Paimon kapiert es. Was dann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310123,
					"content": "Hmm ... Wenn du jetzt Lust hast, zum Schrein zu kommen und die Youkai aus der Nähe zu sehen, würde ich nicht nein sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310124,
					"content": "#Also gut, {NICKNAME}, lass uns loslegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1203102,
			"completionStepIds": [
				1203102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
