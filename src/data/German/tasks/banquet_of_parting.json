					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120311001,
					"content": "Vielen Dank für das Essen. Ich habe mich heute sehr gut amüsiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311002
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120311002,
					"content": "Oh, habe ich das schon erwähnt? Ei hat das Beschwörungsritual gesehen, das wir über dem Großen Narukami-Schrein durchgeführt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311003
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120311003,
					"content": "Ich weiß, dass sie stur sein kann, aber es hat mich trotzdem überrascht, als sie mir einen langen und strengen Brief geschrieben hat, in dem sie mich dafür tadelte, dass ich „diese ganze Sache viel zu weit getrieben habe“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311004
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120311004,
					"content": "Ich verstehe nicht, was die ganze Aufregung soll. Alle schienen sehr glücklich zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				}
			]
		},
