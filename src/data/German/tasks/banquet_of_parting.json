				"points": []
			},
			"dialogs": [
				{
					"id": 120311901,
					"content": "#Ach, die Wartezeit ist unerträglich! Wie kann es sein, dass das nächste Kapitel von „Die wundersamen Abenteuer {F#der}{M#des} Reisenden“ noch nicht erschienen ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311902
					],
					"speakerTitle": "Kyouta"
				},
				{
					"id": 120311902,
					"content": "Es war eine ziemliche Überraschung, als die „mondlose Nacht“ endlich kam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311903
					],
					"speakerTitle": "Oosuke"
				},
				{
					"id": 120311903,
					"content": "Ja, diese riesige schwarze Wolke über dem Yougou-Berg in der Nacht. Sie schien sich einfach aus dem Nichts zu bilden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311904
					],
					"speakerTitle": "Tetsuo"
				},
				{
					"id": 120311904,
					"content": "Aber dann passierte nichts mehr, nachdem ich mit der Methode aus dem Buch einen Wunsch geäußert hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311905
					],
					"speakerTitle": "Oosuke"
				},
				{
					"id": 120311905,
					"content": "*seufz* Ich schätze, kurze Erzählungen sind doch nur Fiktion, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311906
					],
					"speakerTitle": "Tetsuo"
				},
				{
					"id": 120311906,
					"content": "#Diese Nacht war definitiv der Sargnagel für die „Zaubersprüche aus Romanen“-Mode. Dennoch sagt mir etwas, dass „Die wundersamen Abenteuer {F#der}{M#des} Reisenden“ noch lange ein interessanter Serienroman bleiben wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311907
					],
					"speakerTitle": "Oosuke"
				},
				{
					"id": 120311907,
					"content": "Hm? Paimon kann Miko nirgends sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120311908,
					"content": "Ich schätze, sie ist nicht hier draußen. Vielleicht ist sie schon reingegangen? Lass uns reingehen und nach ihr suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
