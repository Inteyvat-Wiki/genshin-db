			"dialogs": [
				{
					"id": 741570201,
					"content": "Dieses Haus ist zu einem sehr günstigen Preis zu verkaufen, bitte kontaktiere uns, bevor es zu spät ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570202
					],
					"speakerTitle": "Information zum Hausverkauf"
				},
				{
					"id": 741570202,
					"content": "#{NICKNAME}, Paimon, Herr Leroy scheint nicht mehr hier zu wohnen. Habt ihr ihn seit dem letzten Mal gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570203
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570203,
					"content": "(He, wollen wir ihr die Wahrheit sagen?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570204,
						741570210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570204,
					"content": "Ja, haben wir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570205
					]
				},
				{
					"id": 741570205,
					"content": "Ihr habt ihn also wirklich gesehen! Habt ihr ihm gesagt, dass die Süßigkeiten super lecker waren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570206,
						741570208
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570206,
					"content": "Ja, haben wir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570207
					]
				},
				{
					"id": 741570207,
					"content": "Ich wusste, dass ich auf euch zählen kann! Vielen Dank! Ich habe ein paar Blasenmandarinen mitgebracht, die ich mit euch teilen möchte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570214,
					"content": "Molli seufzt und winkt zum Abschied, und als sie gerade gehen will ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741570215
					]
				},
				{
					"id": 741570215,
					"content": "Öffnet sich die Tür und Athos kommt mit Autumn heraus.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741570216
					]
				},
				{
					"id": 741570216,
					"content": "Es waren also wirklich eure Stimmen. Warum seid ihr wieder hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570217,
						741570219,
						741570222
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570217,
					"content": "Wir waren einfach in der Nähe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570218
					]
				},
				{
					"id": 741570218,
					"content": "Ach so? Die Welt ist ein kleiner Ort, nicht wahr? Autumn und ich wollten auch gerade gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570219
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570219,
					"content": "Wo ist Benoit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570220
					]
				},
				{
					"id": 741570220,
					"content": "Oh, er ist bereits an einem anderen Ort ... einem Ort, an den wir erst in ein paar Jahrzehnten gehen werden. Ich glaube nicht, dass ihr ihn in nächster Zeit wiedersehen werdet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570221
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570221,
					"content": "Aber das ist auch schwer zu sagen. Wer weiß schon, was zuerst kommt, der nächste Morgen oder eine unerwartete Überraschung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570225
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570225,
					"content": "Hm, ist das nicht das Mädchen, das immer nach ihm sucht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570226
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570226,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570227
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570227,
					"content": "Guten Tag.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570228
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570228,
					"content": "... Zu ähnlich ... Und die lila Augen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570229
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570229,
					"content": "H... Hallo, kann ich dir helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570230
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570230,
					"content": "Wie alt bist du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570231
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570231,
					"content": "Ich bin neun Jahre alt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570232
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570232,
					"content": "Wie lauten die Namen deiner Eltern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570233
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570233,
					"content": "Ähm ... Warum fragst du das, ist alles in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570234
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570234,
					"content": "He, Autumn, was ist los? ... Ist das Mädchen ... Aber kann es wirklich einen solchen Zufall geben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570235
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570235,
					"content": "Sag mir, bist du adoptiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570236
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570236,
					"content": "#... {NICKNAME}, kennst du diese Frau? Was will sie tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570237
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570237,
					"content": "So stellt man keine Fragen. Ich mache das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570238
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570238,
					"content": "Mädchen, ich erinnere mich, dass du unserem Vater sehr nahestehst, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570239
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570239,
					"content": "Ja, genau! Herr Leroy war sehr nett zu mir. Herr Schwiegersohn, wohnt er nicht mehr hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570240
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570240,
					"content": "Ja, er ist an einen sehr weit entfernten Ort gegangen und wird nicht mehr zurückkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570241
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570241,
					"content": "Worüber spricht unser Vater normalerweise mit dir? Kannst du mir das sagen? Ich werde ihm sagen, dass du ihn sehr vermisst, wenn ich ihn sehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570242
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570242,
					"content": "Herr Leroy gibt mir immer etwas zu essen, lässt mich Nana streicheln und sagt mir, dass ich schöne Augen habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570243
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570243,
					"content": "Gibt es sonst noch etwas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570244
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570244,
					"content": "Er sagt mir oft, ich solle meine Mama und meinen Papa von ihm grüßen, aber das mögen sie gar nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570245
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570245,
					"content": "Papa wird immer sehr wütend und sagt, dass Herr Leroy ein schlechter Mensch ist und dass er sie „erpressen“ will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570246
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570246,
					"content": "Obwohl sie mir verboten haben, hierherzukommen, habe ich eine Abmachung mit Herrn Leroy getroffen, also schleiche ich rüber. Bitte sag Papa nichts davon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570247
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570247,
					"content": "Das ist typisch für ihn. Er wird nicht aufhören zu quetschen, bis er den letzten Tropfen Wert aus der Sache herausgepresst hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570248
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570248,
					"content": "Dieser Schw... Verzeihung, wir haben gerade über etwas anderes geredet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570249
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570249,
					"content": "G... Gibt es noch etwas, das ihr wissen wollt? Wenn nicht, werde ich jetzt nach Hause gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570250
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570250,
					"content": "... Haben dich deine Mutter und dein Vater lieb?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570251
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570251,
					"content": "Ja, sie sind die beste Mama und der beste Papa auf der ganzen Welt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570252
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570252,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570253
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570253,
					"content": "Das ist gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570254
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570254,
					"content": "Ich gehe jetzt nach Hause! Auf Wiedersehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570255
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570255,
					"content": "Auf Wiedersehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570256,
						741570257
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570256,
					"content": "Ist das wirklich in Ordnung so?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570258
					]
				},
				{
					"id": 741570258,
					"content": "Ich habe mir diese Szene viele, viele Male vorgestellt ... Aber nichts ist besser, als zu wissen, dass sie glücklich ist. Das reicht mir schon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570259
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570259,
					"content": "Ich bin nicht mein Vater. Ich will ihrer jetzigen Familie keinen Ärger machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570260
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570260,
					"content": "Ich möchte nicht unterbrechen, aber hast du nicht eine Spieldose für sie gekauft? Willst du sie ihr auch nicht mehr schenken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570261
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570261,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570262
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570262,
					"content": "Nein, das ist nicht nötig. Sie ... Sie sieht nicht so aus, als ob es ihr an solchen Dingen mangeln würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570263
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570263,
					"content": "Ich werde einen Weg finden, sie auch in Zukunft zu besuchen. Ich werde ihr besorgen, was sie braucht, sobald ich davon erfahre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570264
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570264,
					"content": "... Und ich werde die Spieldose jemand anderem schenken. Schließlich habe ich viel Zeit und Mühe darauf verwendet, sie auszusuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570265
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570265,
					"content": "Weißhaariges Mädchen, magst du Geschenke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570266
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570266,
					"content": "Wer? Paimon? Willst du sie Paimon schenken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570267
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570267,
					"content": "Ja, ich schenke sie dir. Ich hoffe, dass sie dir noch ein bisschen nützen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570268
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570268,
					"content": "Entschuldige, Athos, aber ich glaube, wir müssen noch ein bisschen länger am Hof von Fontaine bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570269
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570269,
					"content": "Keine Sorge, für mich ist das alles gleich. Lass uns gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570270
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570270,
					"content": "Ihr seht, wie die beiden die Straße verlassen ... Und so endet die Geschichte der Familie Leroy.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741570257,
					"content": "Du willst es ihr nicht sagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570258
					]
				},
				{
					"id": 741570222,
					"content": "Was ist mit Benoit passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570223
					]
				},
				{
					"id": 741570223,
					"content": "Diese Welt ist voll von Ungerechtigkeit, extremer Armut und übermäßiger Gier. Die Strafe, die die Gesetze von Fontaine nicht verhängen können, werden wir an ihrer Stelle vollstrecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570224
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570224,
					"content": "Mit anderen Worten: Er ist dorthin gegangen, wo er sein sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570225
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570208,
					"content": "Nein, das haben wir vergessen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570209
					]
				},
				{
					"id": 741570209,
					"content": "Oh, das ist aber schade. *seufz* Dann gibt es vielleicht schon keine Chance mehr, es ihm mitzuteilen ... Und was diese Blasenmandarinen angeht, die ich mitgebracht habe ... Bitte nehmt sie trotzdem mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570210,
					"content": "Nein, haben wir nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570211
					]
				},
				{
					"id": 741570211,
					"content": "Oh, das ist aber schade. Ich nehme an, ich werde Herrn Leroy nie wiedersehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570212
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570212,
					"content": "Ich dachte, ich könnte Herrn Leroy heute sehen, also habe ich ihm ein paar Blasenmandarinen mitgebracht, aber da er nicht mehr hier wohnt ... Hier, ich schenke sie euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570213
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570213,
					"content": "Wie auch immer, ich denke, ich werde mich immer an Herrn Leroy erinnern! Auf Wiedersehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "Molli"
				}
			]
		},
		{
