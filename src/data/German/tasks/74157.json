			"dialogs": [
				{
					"id": 741570301,
					"content": "Dieses Haus ist zu einem sehr günstigen Preis zu verkaufen, bitte kontaktiere uns, bevor es zu spät ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570302
					],
					"speakerTitle": "Information zum Hausverkauf"
				},
				{
					"id": 741570302,
					"content": "#{NICKNAME}, Paimon, seid ihr hier, um Herrn Leroy zu besuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570303,
						741570305
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570303,
					"content": "Ist Benoit zu Hause?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570304
					]
				},
				{
					"id": 741570304,
					"content": "Nein, er ist nicht hier. Papa hat gesagt, dass Herr Leroy nicht mehr hier wohnt, er ist in den Untergrund gezogen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570308,
					"content": "Zum Fleuve Cendré?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570309
					]
				},
				{
					"id": 741570309,
					"content": "Oh, zum Fleuve Cendré, an dem wir schon waren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570310,
					"content": "Nein, nicht dorthin. Papa hat gesagt, an einen noch tieferen Ort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570311
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570311,
					"content": "Im Dampfvogel wird berichtet, dass Herr Leroy bei einem Spaziergang auf einem Berg aus großer Höhe gestürzt ist und einen schweren Sturz erlitten hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570312
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570312,
					"content": "Aber um ehrlich zu sein, weiß ich nicht, warum er deswegen wegziehen musste ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570313
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570313,
					"content": "Ach, übrigens, ich habe den Schwiegersohn von Herrn Leroy gesehen! Und da war auch eine sehr nette Frau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570314
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570314,
					"content": "Sie mag mich wirklich sehr und sie hat auch lila Augen, genau wie ich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570315
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570315,
					"content": "Sie fragte mich sogar, wo ich wohne, und sagte, sie würde mich besuchen kommen, wenn sie Zeit hätte, und meine gute Freundin werden! Genau wie ich dachte, ist jeder in der Familie Leroy nett und freundlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570316
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570316,
					"content": "Aber ... was soll ich jetzt mit den Blasenmandarinen machen, die ich für Herrn Leroy mitgebracht habe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570317
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570317,
					"content": "#Ähm, {NICKNAME}, Paimon, macht es euch etwas aus, sie zu nehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570318
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570318,
					"content": "Natürlich nicht, danke, Molli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570319,
					"content": "Nicht der Rede wert! Mama und Papa sagen immer, man soll großzügig zu seinen Freunden sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570320
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570320,
					"content": "Und so habe ich heute wieder etwas Gutes getan! Ich werde zurückgehen und es in mein Tagebuch schreiben, juhu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570321
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570321,
					"content": "Ihr seht, wie Molli glücklich die Straße verlässt ... Und so endet die Geschichte der Familie Leroy.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741570305,
					"content": "Wir waren einfach in der Nähe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570306
					]
				},
				{
					"id": 741570306,
					"content": "Ich habe gerade überlegt, ob ich euch sagen soll, dass Herr Leroy umgezogen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570307
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570307,
					"content": "Papa hat gesagt, dass Herr Leroy nicht mehr hier wohnt, er ist in den Untergrund gezogen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "Molli"
				}
			]
		},
