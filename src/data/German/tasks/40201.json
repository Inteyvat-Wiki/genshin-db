							3190.269,
							441.276,
							2891.58
						],
						"pointId": 341200016
					}
				]
			},
			"dialogs": [
				{
					"id": 402010301,
					"content": "Du hast Paimon zu Tode erschreckt, Yelan! So direkt auf sie zuzugehen ... Was wäre, wenn sie es mitbekommen und in ihrer Verzweiflung etwas Schlimmes versucht hätten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010302,
					"content": "Es ist keine Frage des „Was wäre, wenn“, Paimon. Ich bin sicher, dass sie es mitbekommen haben, aber im Interesse ihres eigenen Überlebens hatten sie keine andere Wahl, als mitzuspielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010303
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010303,
					"content": "Jetzt können wir sicher sein, dass der Dunkle Finanzier verzweifelt ist. Das Ziel seines Plans mit dem Schiff war es, sich selbst um jeden Preis zu retten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010304
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010304,
					"content": "Er muss alles loswerden, was zu ihm zurückverfolgt werden kann. Deswegen wird das Schiff in die Luft gesprengt. Die Waren, die für die Auktion bestimmt sind, werden direkt auf den Meeresgrund geschickt und der Psychobetrüger wird alle Blicke auf sich ziehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010305
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010305,
					"content": "Das Letzte, was er wollte, war, dass die Waren in die Auktion gelangen. Aber jetzt haben wir dafür gesorgt, dass sie es schaffen. Er hat also keine andere Wahl, als die Sache durchzuziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010306
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010306,
					"content": "Er könnte sich dafür entscheiden, keinen seiner Agenten zur Auktion zu schicken und seine Waren stattdessen an einen ahnungslosen Käufer gehen zu lassen. Aber denk daran, ihr Wert ist überhöht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010307
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010307,
					"content": "Es wäre nur eine Frage der Zeit, bis der Käufer merkt, dass die Bewertung falsch ist, und dies den Behörden meldet. Als Verkäufer würde Corder mit einer möglichen Verurteilung rechnen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010308
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010308,
					"content": "Im besten Fall muss der Dunkle Finanzier eine neue Art von Mora-Wäsche finden. Im schlimmsten Fall verliert er einen seiner letzten zuverlässigen Agenten in Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010309,
						402010310
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010309,
					"content": "Und wenn er sich entscheidet, die Auktion fortzusetzen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010311
					]
				},
				{
					"id": 402010311,
					"content": "Ganz genau. Unsere Hinweise bleiben intakt und wir lassen uns von dem Käufer auf der Auktion näher an den Dunklen Finanzier heranführen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010312
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010312,
					"content": "Gut, äh ... Also, äh ... Das heißt, äh ... Können wir das noch mal durchgehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010313,
					"content": "#Keine Sorge. Ich bin sicher, dass {NICKNAME} es noch einmal in paimon-freundlicher Sprache erklären wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010314
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010314,
					"content": "Wir befinden uns auf der Zielgeraden und es ist wichtig, diese Auktion zu nutzen ... Seid also bereit, die Sache durchzuziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010315
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010315,
					"content": "Frau Edler hat bereits einen Informanten am Tatort postiert. Mit diesem Einladungsschreiben kannst du an der Auktion teilnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010316
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010316,
					"content": "Wir treffen uns in zwei Tagen im Hotel Debord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010310,
					"content": "Das arbeitet auch zu unseren Gunsten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010311
					]
				}
			]
		},
