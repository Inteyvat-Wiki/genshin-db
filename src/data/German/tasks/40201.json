			"dialogs": [
				{
					"id": 402010501,
					"content": "Nun gut, also keine Fälschungen. Diese Leute sind definitiv bestrebt, ihre Waren in einem Rutsch nach Fontaine zu bringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010502,
					"content": "Aber hast du die seltsamen Markierungen auf einigen von ihnen gesehen? Paimon fragt sich, was sie bedeuten ... Lass uns Yelan fragen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010503,
					"content": "Du findest Yelan und teilst ihr die Ergebnisse der Untersuchung mit ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402010504
					]
				},
				{
					"id": 402010504,
					"content": "Gute Arbeit. Was die Auktion angeht, konnte Frau Edler einige nützliche Informationen sammeln. Wir sind fast sicher, dass ihr Ziel die Auktion ist, die in zwei Tagen im Hotel Debord stattfindet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010505
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010505,
					"content": "Die Markierungen, die du aufnehmen konntest, wurden mit einer besonderen Art von Farbe aufgetragen. Es ist fast unmöglich, sie ohne eine spezielle Technik wie das „forensische Aufzeichnungsgerät“ zu erkennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010506
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010506,
					"content": "Ich glaube, wir haben es hier mit einer Insigne der Schatzräuber zu tun. Jedes hohe Tier in der Organisation hat eine eigene – fast wie eine persönliche Unterschrift. Und in Anbetracht dessen, was wir über den Fall wissen, würde ich wetten, dass dies die Handarbeit des Psychobetrügers ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010507,
						402010508
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010507,
					"content": "Also ... Er markiert die Ware. Aber warum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010509
					]
				},
				{
					"id": 402010509,
					"content": "Aus dem Warenverzeichnis des Hafens geht hervor, dass zu den markierten Waren Düngemittel aus Sumeru, lokale Feuerwerkskörper, Seife und Duftessenz gehören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010510
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010510,
					"content": "Also nichts Besonderes ... Nur ein paar landwirtschaftliche Produkte und Dinge des täglichen Bedarfs?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010511,
					"content": "Düngemittel, Seife und Duftessenz ... Das ist merkwürdig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010512
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010512,
					"content": "Es mag riskant sein, aber ich werde an Bord nachforschen und mich gleich nach Fontaine durchschlagen, wenn ich schon dabei bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010513,
						402010514
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010513,
					"content": "Wir haben es bis hierher geschafft ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010515
					]
				},
				{
					"id": 402010515,
					"content": "Ja, lasst uns die Sache zu Ende bringen! Paimon muss doch wissen, was hier los ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010516,
					"content": "Nun, ihr habt euch bisher bewährt, also sehe ich kein Problem. Ihr solltet nur wissen, dass wir, sobald wir an Bord des Schiffes sind, Corder und Doddamani gegenüberstehen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010517
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010517,
					"content": "Seid also vorbereitet. Die Untersuchung könnte dieses Mal ein wenig anders aussehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010514,
					"content": "Wir kommen mit dir ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010515
					]
				},
				{
					"id": 402010508,
					"content": "Welche Botschaft will er damit vermitteln?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010509
					]
				}
			]
		},
