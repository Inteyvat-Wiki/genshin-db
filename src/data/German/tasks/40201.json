			"dialogs": [
				{
					"id": 402010201,
					"content": "Entschuldigt, Passagiere. Aufgrund des begrenzten Platzes im Frachtraum sind wir gezwungen, einen Teil der Waren auf dem Deck zu lagern. Wir bitten aufgrund der Unannehmlichkeiten um Entschuldigung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010202
					],
					"speakerTitle": "Matrose"
				},
				{
					"id": 402010202,
					"content": "Bitte, du musst dich nicht für deinen geschäftlichen Erfolg entschuldigen! Ich hoffe nur, er färbt auf den Rest von uns ab, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010203
					],
					"speakerTitle": "Leidenschaftlicher Passagier"
				},
				{
					"id": 402010203,
					"content": "Es sieht so aus, als ob bei allen Waren, die mit der Insigne des Psychobetrügers gekennzeichnet sind, Corder als Lieferant aufgeführt ist. Doddamani ist im Frachtraum und stellt wahrscheinlich sicher, dass alle Waren für die Auslieferung bereit sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010204
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010204,
					"content": "Untersuchen sie ... etwas? Warum durchstöbern sie die Kisten? Paimon kann sich keinen Reim darauf machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010205,
					"content": "Hier, nimm diese Chiffre. Sie sollte dir helfen, ihre verschlüsselten Nachrichten zu entziffern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010206
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010206,
					"content": "Das ist der Plan: Während ich Corder und Doddamani ablenke, untersucht ihr zwei die Waren, die mit der Insigne des Psychobetrügers markiert sind. Vielleicht erfahren wir etwas Nützliches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010207,
						402010208
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010207,
					"content": "Wenn ich etwas Interessantes finde ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010209
					]
				},
				{
					"id": 402010209,
					"content": "Auf jeden Fall. Ich vertraue auf dein Urteilsvermögen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010210
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010210,
					"content": "Hm? W... W... Warte! Du gehst einfach hin und redest mit diesen Typen!? Yelan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010211,
					"content": "Hm? Oh, entschuldigt, meine Herren ... Aber, kennen wir uns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010212
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010212,
					"content": "Du bist Herr Corder, ein berühmter Antiquitätensammler aus dem Bezirk Lyonnais, richtig? Ich glaube, wir drei hatten schon einmal das Vergnügen, uns zu treffen. In der Teestube Jiulüe beim Yilong-Pier, wenn ich mich nicht irre ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010213
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010213,
					"content": "Was? Du ... Du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010214
					],
					"speakerTitle": "Doddamani"
				},
				{
					"id": 402010214,
					"content": "Ah, der Würfelmeister der Teestube Yanshang ... Es ist mir ein Vergnügen, Fräulein Yelan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010215
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010215,
					"content": "Du hast also von mir gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010216
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010216,
					"content": "Ja, ich habe dort einmal eine exquisite Tasse Tee getrunken. Man kann die Teestube Yanshang kaum verlassen, ohne von deinen legendären Würfelkünsten zu hören. Ich nehme an, irgendetwas bringt uns immer wieder zusammen. Eine gemeinsame Liebe zum Tee vielleicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010217
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010217,
					"content": "Ja, das muss es sein ... Nun, wir sind uns genau zum richtigen Zeitpunkt über den Weg gelaufen. Ich bin auf dem Weg nach Fontaine, um Urlaub zu machen. Irgendwelche Empfehlungen, wo ich hingehen sollte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010218
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010218,
					"content": "Irgendwo, wo ich vielleicht ein passendes Teeservice finden könnte ... Wie eine Kunstausstellung. Oder eine Auktion? Ich habe gehört, dass schwarzer Tee aus Fontaine einen einzigartigen Geschmack haben soll. Ich kann mir vorstellen, dass die Teeservice auch eine Augenweide sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010219
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010219,
					"content": "Du!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010220
					],
					"speakerTitle": "Doddamani"
				},
				{
					"id": 402010220,
					"content": "Ah, hat dieser Herr auch Interesse an Teeservicen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010221
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010221,
					"content": "Ich ... *hust* Natürlich. Es ist mir ein Vergnügen, dich kennenzulernen, Fräulein Yelan. Ich reise auch nach Fontaine. Auf Einladung von Corder, du verstehst. Obwohl ich derjenige bin, dem das Schiff gehört ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010222
					],
					"speakerTitle": "Doddamani"
				},
				{
					"id": 402010222,
					"content": "Ja, Yelan spricht tatsächlich mit ihnen! Ob das wirklich eine gute Idee ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010223,
						402010224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010223,
					"content": "Wir haben nicht viel Zeit!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010225
					]
				},
				{
					"id": 402010225,
					"content": "Also gut! Dann lass uns irgendwohin gehen, wo sie uns nicht sehen können, damit wir die Kisten untersuchen können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010226,
					"content": "*hust* Was ist das für ein starker Geruch, der aus diesen Kisten kommt? Muss ein Haufen Zeug sein, das zusammengemischt wurde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010227,
					"content": "Und da ist ein seltsamer Zettel. Aber Paimon kann nicht lesen, was darauf steht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010228,
						402010229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010228,
					"content": "Es ist als Code geschrieben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010230
					]
				},
				{
					"id": 402010230,
					"content": "Yelan denkt wirklich an alles, hm! Aber, äh ... Du weißt doch, wie man das Ding benutzt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010231,
					"content": "Und? Und? Was steht denn da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010232,
						402010233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010232,
					"content": "Wenn ich richtig liege, planen sie, die Waren zu entsorgen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010234
					]
				},
				{
					"id": 402010234,
					"content": "Das Schiff in die L... L... Luft jagen!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010235,
					"content": "Sind die verrückt? Paimon dachte, es ginge darum, sich die Behörden vom Hals zu schaffen! Nicht darum, noch mehr Aufmerksamkeit auf sich zu lenken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010236,
						402010237,
						402010238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010236,
					"content": "Der Psychobetrüger muss die Person an der Spitze schützen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010239,
					"content": "Yelan hatte also recht! Dieser Typ ist komplett verrückt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010240,
					"content": "Es sind unschuldige Menschen auf diesem Schiff! Wir müssen diese Bomben so schnell wie möglich finden und entschärfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010237,
					"content": "Also lenkt er die Aufmerksamkeit auf ein noch größeres Problem ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010238,
					"content": "Und trennt uns damit von all unseren Hinweisen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010233,
					"content": "... indem sie das Schiff in die Luft jagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010234
					]
				},
				{
					"id": 402010229,
					"content": "Zum Glück haben wir die Chiffre ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010230
					]
				},
				{
					"id": 402010224,
					"content": "Sie gibt uns eine Chance! Nutzen wir sie!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010225
					]
				},
				{
					"id": 402010208,
					"content": "Ist es in Ordnung, wenn ich mich sofort darum kümmere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010209
					]
				}
			]
		},
		{
