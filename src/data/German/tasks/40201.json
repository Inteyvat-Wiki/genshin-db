				]
			},
			"dialogs": [
				{
					"id": 402010101,
					"content": "Sehr gut, ihr beiden. Absolut pünktlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010102,
						402010103
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010102,
					"content": "Wie läuft es mit dem Fall?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				},
				{
					"id": 402010104,
					"content": "Am Tag, nachdem wir in das Lager eingedrungen waren, begannen die beiden Lakaien des Dunklen Finanziers, Corder und Doddamani, mit dem Transport der Waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010105
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010105,
					"content": "Siehst du das Schiff? Das ist das Schiff, das Doddamani für den Transport der Waren geschickt hat. Es fährt unter dem Deckmantel eines gemeinsamen Passagier- und Frachtschiffes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010106
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010106,
					"content": "Boah, das ist ja ein riesiges Schiff! Paimon kann all die Waren sehen, die sich auf dem Pier stapeln! Sieht aus, als würde es auch eine Menge Passagiere zum Lumidouce-Hafen transportieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010107,
						402010108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010107,
					"content": "Was, wenn das nicht die echten Waren sind?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010109,
					"content": "Du denkst zwei Schritte voraus? Das gefällt mir. Du lernst schnell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010110
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010110,
					"content": "Wenn Corder und Doddamani glauben, dass die Behörden ihnen auf der Spur sind, ist es möglich, dass die Waren hier ein Haufen Nichts sind. Nur ein Köder, um die Strafverfolgungsbehörden aufzuscheuchen, die ihnen auf den Fersen sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010111
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010111,
					"content": "Aber wir müssen vorsichtig sein. Mehrere Mitglieder ihrer Mannschaft haben gestanden, dass ein altgedienter Schatzräuber, bekannt als der „Psychobetrüger“, mit dem Dunklen Finanzier zu tun hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010112
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010112,
					"content": "Der Psychobetrüger ist ein entflohener Sträfling und ein Meister darin, sich zu verstecken. Aufgrund unserer früheren Ermittlungen ist klar, dass er derjenige ist, der den Leuchtturm der Millelithen ausspioniert hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010113
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010113,
					"content": "Ich werde die Gegend durchstreifen, um den Psychobetrüger von der Szenerie abzulenken, während ihr beiden die Waren untersucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010114
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010114,
					"content": "Denkt daran, euch unauffällig zu verhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010115,
						402010116
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010115,
					"content": "Verstanden, ich werde mich diskret verhalten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010117,
					"content": "#Ja! Und Paimon wird ihr Bestes tun, um ... näher am Boden zu schweben! Nicht höher als die Schulter von {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010116,
					"content": "Mach dir keine Sorgen. Ich habe das im Griff.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010108,
					"content": "Sollten wir sie vorsichtshalber untersuchen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010103,
					"content": "Irgendwelche Entwicklungen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				}
			]
		},
