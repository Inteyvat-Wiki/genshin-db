			"dialogs": [
				{
					"id": 402010401,
					"content": "Also gut, das sind alle Bomben an Deck. Was ist mit dem Frachtraum? Haben wir noch genug Zeit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010402,
					"content": "Bereits erledigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010403
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010403,
					"content": "Gute Arbeit, ihr beiden. Ihr seid ruhig geblieben und habt schnell gehandelt. Das war die perfekte Reaktion auf eine Situation wie diese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010404
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010404,
					"content": "Yelan! Ehrlich gesagt ist das alles dein Verdienst. Es war deine Idee, das Schiff zu untersuchen. Und ohne deine Chiffre hätten wir die Nachricht nie entschlüsseln können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010405,
					"content": "Warte eine Sekunde ... Wo sind Corder und Doddamani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010406,
					"content": "Heh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010407
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010407,
					"content": "Dabei, sich von einem Schock zu erholen, könnte ich mir vorstellen. Plötzlich herauszufinden, dass man von einer gefährlichen Person verfolgt wird ... Das muss eine ziemliche Tortur für euch gewesen sein, meine Herren? Fast hättet ihr eure Fracht und euer Leben auf einen Schlag verloren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010408
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010409
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010409,
					"content": "In der Tat. Wenn man bedenkt, dass so etwas Böses in dieser Welt existiert ... Ich kann mir kaum vorstellen, was ich getan habe, um diesen Kerl zu verärgern. Dann gleich zu Mord überzugehen ... Das ist mir unbegreiflich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010410
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010410,
					"content": "Nun, kein Grund zur Sorge. Ich werde sofort die Maison Gardiennage alarmieren und sie bitten, Agenten zum Lumidouce-Hafen zu schicken. Ihr beide braucht eindeutig Schutz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010411
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010411,
					"content": "Deine Fracht muss auch den Behörden zur Inspektion übergeben werden, Herr Corder – nur um alle verbleibenden Gefahren zu beseitigen. Danach wird die Maison Gardiennage natürlich alles an seinen Bestimmungsort eskortieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010412
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010412,
					"content": "Wenn ich also dürfte ... Wohin gehen deine Waren, Herr Corder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010413
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010413,
					"content": "... Zum Hotel Debord. Für eine Auktion in zwei Tagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010414
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010414,
					"content": "Ah, dann sei beruhigt. Die Maison Gardiennage verfügt über sorgfältiges und verantwortungsbewusstes Personal. Du kannst darauf vertrauen, dass deine Waren ohne einen Kratzer bei der Auktion ankommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010415
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010415,
					"content": "Ich danke euch vielmals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010416
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010416,
					"content": "Nach einiger Zeit legt das Schiff sicher im Lumidouce-Hafen an. Die Maison Gardiennage führt eine kurze Sicherheitsinspektion durch und entlädt die gesamte Ladung des Schiffes.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402010417
					]
				},
				{
					"id": 402010417,
					"content": "In der Zwischenzeit erzählst du Yelan von der Nachricht, die der Psychobetrüger für Corder und Doddamani hinterlassen hat.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
