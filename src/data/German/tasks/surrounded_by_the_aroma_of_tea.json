			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705070101,
					"content": "Zhongli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070102,
					"content": "Lange nicht gesehen. Wie geht es euch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070103
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070103,
					"content": "Was bringt Euch hierher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070104,
					"content": "Wenn man in der Freizeit unterwegs ist, sollte man sich nicht auf das Unmittelbare beschränken. Das Reich des Windes ist frei und reich und ein großartiger Ort für einen Besuch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070105,
					"content": "Es war eine angenehme Überraschung, euch hier zu treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070106,
						705070107
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070106,
					"content": "Was hättet Ihr denn gern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070108
					]
				},
				{
					"id": 705070108,
					"content": "Einen Becher Nebliger Garten, bitte. Stärkerer Tee am besten, danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070107,
					"content": "Wir können uns bei einer Tasse Tee unterhalten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070108
					]
				}
			]
		},
		{
			"id": 7050702,
			"completionStepIds": [
				7050703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050703",
							"2"
						],
						"stepId": 7050703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705070201,
					"content": "Das Warten hat ein Ende!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070202,
					"content": "Na dann, viel Spaß ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070203
					]
				},
				{
					"id": 705070203,
					"content": "Der Teesud ist hell und angenehm gefärbt, der Geschmack ist süß und weich, mit blumigen und fruchtigen Noten. Nun, ziemlich selten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070204
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070204,
					"content": "Ooh, Zhongli ist auch ein Profi im Teetrinken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070205,
					"content": "Paimon „gluckert“ es in einem Zug hinunter und kann nur das Wort „gut“ sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070206,
					"content": "Die sorgfältige Verkostung ist eine Hommage an die Person, die den Tee zubereitet hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070207
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070207,
					"content": "Guter Tee ist selten und noch seltener sind diejenigen, die guten Tee auf eine Weise zubereiten können, die dem Auge schmeichelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070208,
						705070209
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070208,
					"content": "Das war viel zu nett.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070210
					]
				},
				{
					"id": 705070210,
					"content": "Verstanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070211,
					"content": "Also ... Zeigt Paimon, wie Ihr Tee verkostet. Paimon sieht, dass man riechen muss, bevor man trinkt, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070212,
					"content": "Genau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070213
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070213,
					"content": "Teeblätter haben ihre eigenen Eigenschaften, und wenn du mehr davon trinkst, wirst du natürlich einige Erkenntnisse gewinnen. Ob der Tee gut oder schlecht ist, kann man ein wenig am Aroma riechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070214
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070214,
					"content": "Einige Tees riechen feucht und fettig, mit einem übermäßig verbrannten Aroma, und sollten daher von minderer Qualität sein. Einige andere Teesorten duften süß, weich und elegant, mit einem angenehmen Aroma, diese sind meist von höchster Qualität.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070215
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070215,
					"content": "Wenn du etwas anspruchsvoller sein willst, solltest du auch einen „Verkostungsbecher“ haben, wie es in den alten Tagen von Liyue Tradition war. Dies ist ein Gefäß, das den Teesud aufnimmt und ausschließlich für die Verkostung des Aromas verwendet wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070216
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070216,
					"content": "Was soll Paimon tun, Paimon hat das Gefühl, schon verloren zu haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070217,
					"content": "Das spielt keine Rolle. Es gibt so viel zu lernen, dass es nie zu spät ist, damit anzufangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070218
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070218,
					"content": "Anfänger können diese Verkostung ausprobieren: zuerst die Farbe des Wassers beobachten, dann das Aroma des Tees riechen und schließlich den Tee kosten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070219
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070219,
					"content": "Das gilt für alles: „vom Seichten zum Tiefen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070220,
						705070221
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070220,
					"content": "Viel gelernt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070222
					]
				},
				{
					"id": 705070222,
					"content": "Qiaoying im Nordwesten von Liyue ist berühmt für seine Teeindustrie. Wenn du die Gelegenheit hast, das Dorf in Zukunft zu besuchen, solltest du das tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070223
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070223,
					"content": "Das meiste, was heute gesagt wurde, ist für mich, einen aus der alten Schule von Liyue, ganz normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070224
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070224,
					"content": "Die Gewohnheiten des Teetrinkens und die Teekultur unterscheiden sich von Ort zu Ort. Wenn du dich in einem anderen Land aufhältst, ist es wichtig, dass du die örtlichen Gepflogenheiten respektierst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070225
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070225,
					"content": "Paimon versteht das vollkommen! Aber ob Paimon sich daran erinnern kann oder nicht, ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070226,
					"content": "Wie zu erwarten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070227
					]
				},
				{
					"id": 705070227,
					"content": "#{NICKNAME}, vielen Dank für den heutigen Tag. Ich hatte das Glück, diesen tollen Tee zu trinken, und es war eine lohnende Reise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070228
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070228,
					"content": "Wenn du eines Tages im Teehaus sitzt, werde ich auf jeden Fall kommen und dich unterstützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070229
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070229,
					"content": "Aber wir sind so beschäftigt, dass wir wahrscheinlich keine Zeit für Gelegenheitsaufträge in Teehäusern haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070230,
					"content": "Wer weiß?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070231
					]
				},
				{
					"id": 705070231,
					"content": "Ich werde es auf jeden Fall unterstützen, wenn sich die Gelegenheit ergibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070232
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070232,
					"content": "Das war’s für heute. In diesem Sinne wünsche ich dir viel Erfolg bei deiner Arbeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070233,
						705070234
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070233,
					"content": "Bis bald.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070235
					]
				},
				{
					"id": 705070235,
					"content": "Nun, die Kosten werden, wie üblich, dem Bestattungsunternehmen Wangsheng in Rechnung gestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070236
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070236,
					"content": "Passt gut auf Euch auf und grüßt die Direktorin von uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070234,
					"content": "Wegen der Zahlung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070235
					]
				},
				{
					"id": 705070221,
					"content": "Ich will mehr lernen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070222
					]
				},
				{
					"id": 705070209,
					"content": "Das bringt mich in Verlegenheit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070210
					]
				}
			]
		}
	]
}