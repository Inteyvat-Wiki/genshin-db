			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10160101,
					"content": "Ah, da seid ihr ja. Ihr müsst nichts bestellen, ich habe bereits alles organisiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160102,
					"content": "Diese Gaststätte „Dreibecherrausch“ ist nicht wie die üblichen Tavernen in Mondstadt. Bestellungen für Memmengetränke wie Fruchtsaft werden hier vom Besitzer erst gar nicht angenommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160103
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160103,
					"content": "Also können wir endlich was Alkoholisches trinken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160104
					]
				},
				{
					"id": 10160104,
					"content": "Daher habe ich euch dieses Mal eine Schüssel süße Reisbällchen bestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160105,
					"content": "Als hätte ich es mir nicht denken können ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160106
					]
				},
				{
					"id": 10160106,
					"content": "Meine Herrschaften, wenn ihr nur gewillt seid zuzuhören, so werde ich euch mehr über Ningguangs „Jadegemach“ erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160107
					],
					"speakerTitle": "Tian mit der eisernen Zunge"
				},
				{
					"id": 10160107,
					"content": "Ja heu! Hier gibt es sogar Geschichtenerzähler! Welch eine tolle Atmosphäre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160108,
					"content": "Außer dem guten Wein hier macht die Atmosphäre diesen Ort sehr beliebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160109
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160109,
					"content": "Diese Atmosphäre jedoch hat nichts mit jener Atmosphäre zu tun, die im Reiseführer Teyvat erwähnt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160110
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160110,
					"content": "Jeder hier weiß, über unserem Hafen schwebt ein Pavillon in den Wolken, ein Palast im Nebel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160111
					],
					"speakerTitle": "Tian mit der eisernen Zunge"
				},
				{
					"id": 10160111,
					"content": "Was bedeutet es, außergewöhnlich versiert in der Kunst der Täuschung zu sein? Seht her, es bedeutet dies, Ningguangs käuflicher Direktzugang zu den höheren Behörden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160112
					],
					"speakerTitle": "Tian mit der eisernen Zunge"
				},
				{
					"id": 10160112,
					"content": "Stell dir vor, bei schönstem Wetter vom Deck außerhalb der Palastmauern die Welt darunter zu bewundern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160113
					],
					"speakerTitle": "Tian mit der eisernen Zunge"
				},
				{
					"id": 10160113,
					"content": "Das ist einfach toll! Von dort aus siehst du mehr als die Hälfte von ganz Liyue, so weit das Auge reicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160201
					],
					"speakerTitle": "Tian mit der eisernen Zunge"
				},
				{
					"id": 10160201,
					"content": "Denk doch mal nach, das sind nur Überlegungen auf Papier. Aber was könnte wertvoller sein, als die Überlegungen und Entscheidungen beeinflussenden Ideen von Ningguang persönlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160202
					],
					"speakerTitle": "Tian mit der eisernen Zunge"
				},
				{
					"id": 10160202,
					"content": "Ihr werdet noch ein paar Schnipsel mehr wollen, damit ihr noch mehr von Ningguangs Weisheit aufnehmen könnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160203
					],
					"speakerTitle": "Tian mit der eisernen Zunge"
				},
				{
					"id": 10160203,
					"content": "Der „Tianquan“ Ningguang ... in der letzten Zeit haben wir diesen Namen ganz schön oft gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160204,
					"content": "Das Volk von Liyue redet über sie, die Fatui hassen sie, sie war es anscheinend, die den Leichnam des Stammvaters der Adepten versteckt hat, und bei der Adeptenzeremonie haben wir sie auch gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160205,
					"content": "Was für eine Person sie wohl wirklich ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160207,
					"content": "Endlich habe ich euch gefunden, ihr, die ihr vom Jueyun-Karst zurückgekehrt seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160208
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160208,
					"content": "Wer da?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160209,
					"content": "Paimon, lass uns gehen ...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160210
					]
				},
				{
					"id": 10160210,
					"content": "Wartet, ich bin kein Millelith oder sonst wer, der versucht euch festzunehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160211
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160211,
					"content": "Ich bin nur ein Bote der Qixing von Liyue, mein Name ist Ganyu, ich bin außerdem die Sekretärin des Yuehai-Pavillons und bin gekommen, um euch zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160212,
						10160213
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160212,
					"content": "Bote?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				},
				{
					"id": 10160214,
					"content": "Um genau zu sein, in meiner Position bin ich die Sekretärin der gesamten Qixing. Mein heutiger Auftrag kommt von Ningguang persönlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160215
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160215,
					"content": "Ah ja, wieder Ningguang ... ein Auftrag von Ningguang persönlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160216,
					"content": "Vom Jueyun-Karst Zurückgekehrte ... vergebt mir mein spontanes Auftauchen, das war nicht sehr höflich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160217
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160217,
					"content": "Der Brief, den ich bei mir trage, ist eine Einladung von Fräulein Ningguang, eine persönliche Einladung aus ihrer Position als Tianquan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160218
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160218,
					"content": "Eine Einladung zum Palast in den Wolken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160219
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160219,
					"content": "Eine ... formale Einladung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160220,
					"content": "Korrekt. Fräulein Ningguang hat es so formuliert:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160221
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160221,
					"content": "#„Lade {F#sie}{M#ihn} ein zu kommen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160222
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160222,
					"content": "#„Ich möchte {F#sie}{M#ihn} sehen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160223
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160223,
					"content": "#„Im Jadegemach möchte ich gemeinsam mit {F#ihr}{M#ihm} alle Fäden der düsteren Machenschaften durchtrennen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160213,
					"content": "Sekretärin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				}
			]
		},
		{
			"id": 101603,
