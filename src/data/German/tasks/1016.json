			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10160301,
					"content": "Ningguang ... Ganyu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160302
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160302,
					"content": "Die düsteren Machenschaften sind in den letzten Tagen stark angestiegen. Wo kommen sie her und wie weit reichen sie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 101610,
			"completionStepIds": [
				101610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101610",
							"2"
						],
						"stepId": 101610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10161001,
					"content": "Und damit verschwand die Abgesandte, die sich Ganyu nannte, einfach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161002,
					"content": "Doch wir haben eine Einladung von der Liyue Qixing bekommen. Paimon kann das immer noch nicht glauben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161003,
					"content": "#{NICKNAME}! Wir werden Menschen treffen, die weit mehr Geld haben, als Paimon je zählen könnte ... Wir sollten unsere besten Manieren zeigen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161004,
						10161005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161004,
					"content": "Ich beachte immer meine Manieren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10161006
					]
				},
				{
					"id": 10161006,
					"content": "Hah ... Eine Einladung in das Jadegemach ist wirklich eine seltene Ehre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161007
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10161007,
					"content": "Am besten machst du dich jetzt auf den Weg. Aber vergiss den Adeptenabschied nicht. Wenn du im Jadegemach alles erledigt hast, triff mich im Dihua-Moor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161008
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10161008,
					"content": "Keine Sorge, wir vergessen es nicht! Dihua-Moor. Wir treffen dich dort!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161005,
					"content": "Paimon hat mal wieder was vor ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10161006
					]
				}
			]
		}
	]
}