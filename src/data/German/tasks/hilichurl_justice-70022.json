						700220107,
						700220108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700220107,
					"content": "Sieh dir diesen Hilichurl in Aktion an!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700220109
					]
				},
				{
					"id": 700220109,
					"content": "Haha, er sagte, dass er sehr glücklich ist, sich mit uns anzufreunden. Aber wir müssen erst einen kleinen Gefallen für ihn tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700220110
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700220110,
