				"objectNames": [
					"Bricole"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741700401,
					"content": "Du warst erfolgreich! Sieht so aus, als könnte die Herausforderung funktionieren. Ich kann das Projekt beruhigt an das Forschungsinstitut übergeben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700402
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700402,
					"content": "Leider sind die Vermögenswerte hier noch nicht vollständig überprüft worden, sodass ich später wahrscheinlich zurückkehren muss ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700403
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700403,
					"content": "Trotzdem vielen Dank für deine Hilfe. Ach ja! Hier ist die Belohnung. Ich wünsche dir eine gute Reise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
