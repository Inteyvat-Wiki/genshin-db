			"dialogs": [
				{
					"id": 741700213,
					"content": "Übrigens, wer ist eigentlich Kuisel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700214
					]
				},
				{
					"id": 741700214,
					"content": "Ich weiß es auch nicht. Meiner Erinnerung nach gibt es am Forschungsinstitut Fontaine niemanden, der so heißt ... Vielleicht ist es für ihn auch besser, wenn es niemanden mit diesem Namen gibt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700215
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700215,
					"content": "Wie er selbst gesagt hat, ist Kuisel nur eine bequeme Rolle. Je größer der Unterschied zwischen dieser Rolle und ihm selbst, desto besser. Auf diese Weise wird die Wahrscheinlichkeit reduziert, erkannt zu werden ... Nun, das ist nur eine wilde Spekulation von mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700216
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700216,
					"content": "Ähm, aber wenn du mich fragst, ist der Unterschied von ihm selbst im Vergleich zu früher schon sehr groß. Zu Beginn habe ich ihn nicht wiedererkannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
