			"dialogs": [
				{
					"id": 741700217,
					"content": "Vergiss für einen Moment die Herausforderungen. Was den Apparat hier angeht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700218
					]
				},
				{
					"id": 741700218,
					"content": "Sehr verwirrend, oder? Es ist erkennbar, dass er hier ... ähm, verschiedene Änderungen vorgenommen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700219
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700219,
					"content": "Ich habe das Gefühl, dass so eher den Anforderungen an die Standortwahl des Ruinentourismus entsprochen wird ... Oh, so etwas zu sagen, ist wohl etwas unvorsichtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700220
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700220,
					"content": "*hust* Nun, meine Aussage gerade eben ist nur meine persönliche Meinung und stellt nicht den Standpunkt des Forschungsinstituts Fontaine dar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
