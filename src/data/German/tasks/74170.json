			"dialogs": [
				{
					"id": 741700210,
					"content": "Vergiss für einen Moment die Herausforderungen. Was Coutrot angeht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700211
					]
				},
				{
					"id": 741700211,
					"content": "Dass er bloß von der Personalliste des Forschungsinstituts Fontaine gestrichen wurde, schien bei ihm nicht die Alarmglocken schrillen zu lassen. Er ist wirklich unbelehrbar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700212
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700212,
					"content": "Aber dieses Mal wird niemand für ihn bürgen. Daher kannst du beruhigt sein. Er wird keinen Ärger mehr bereiten können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
