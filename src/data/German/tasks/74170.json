				"objectNames": [
					"Bricole"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741701701,
					"content": "Ah! Du bist wieder da. Ich bin auch zurück ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701702
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701702,
					"content": "Nachdem die Mitarbeiter des Forschungsinstituts meinen Bericht gehört haben, ersuchten sie mich, auch die Möglichkeit zu prüfen, ob dieser Ort zu einem Entwicklung-Ausbildungsspielfeld umgebaut werden kann, während ich den Besitz des Instituts zurückhole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701703
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701703,
					"content": "*seufz* Ich fühle mich bei dieser Arbeit immer wie in einem Déjà-vu. Es gab eine Zeit, in der der Verwaltungsbeauftragte daran arbeitete, Menschen zum Tauchtraining zu motivieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701704
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701704,
					"content": "Ich finde das nicht sehr sinnvoll, aber Arbeit ist Arbeit und Auftrag ist Auftrag ... Außerdem ist die Struktur hier wirklich seltsam ... ich meine sonderbar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701705
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701705,
					"content": "Also habe ich einige Repliken von Ankern an verschiedenen Stellen platziert. Einfach gesagt, sie sind Modelle von Anker und sie sind komplett ohne Risiko und sicher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701706
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701706,
					"content": "Im Moment habe ich die Trainingsinhalte im Kopf, die darin besteht, <color=#00E1FFFF>alle Repliken des Ankers im Gebäude innerhalb der vorgegebenen Zeit zu sammeln.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701707
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701707,
					"content": "Willst du es versuchen? Ich biete dir auch eine Bezahlung an, wenn die Herausforderung erfolgreich abgeschlossen wird. Schließlich hilft es auch bei der Forschung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
		{
			"id": 7417004,
			"completionStepIds": [
				7417004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
