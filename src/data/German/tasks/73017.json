			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arakunti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730171001,
					"content": "Ein nasser Traum, ein trockener Traum ... Ding dong, tick tick, das Lied von Vana ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171002
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171002,
					"content": "#Nara {NICKNAME}? Die „Blätter“ sind im Traum, die „Äste“ sind hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakunti"
				}
			]
		},
		{
			"id": 7301712,
			"completionStepIds": [
				7301712
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301712",
							"2"
						],
						"stepId": 7301712,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arakunti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730171201,
					"content": "Wir sind zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171202,
					"content": "Ich höre es! Das Wimmern hat sich in eine wohlklingende Melodie verwandelt, aber es bedarf noch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171203
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171203,
					"content": "Es bedarf noch Arakuntis Hilfe! Hehe, als nächstes kommt es auf dich an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171204,
					"content": "Arakunti weiß Bescheid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171205
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171205,
					"content": "Oh! Jetzt sollte es keine Probleme geben! Wir müssen die Varuna-Maschine sobald wie möglich heilen, sonst quillt der Apam-Wald vor Sporen über ... Allein beim Gedanken ... wird Paimon ... Hatschi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171206,
					"content": "Paimon fasst kaum, dass Aranara keinerlei Reaktion auf die Sporen zeigen ... Heißt das etwa, dass sie nicht von ihnen beeinflusst werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171207,
					"content": "Aranara kochen Pilze, also sind wir nicht unbeeinflusst. Die „Sporen“ sind jedoch zu klein und zu weit verbreitet, wir können sie nicht fangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171208
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171208,
					"content": "Als die Varuna-Maschine noch ganz war, gab es nicht so viele Pilze in Vana. Deshalb wird alles wieder gut, wenn es der Varuna-Maschine wieder gut geht. Außer Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171209
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171209,
					"content": "Alles wird wieder gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171210
					]
				},
				{
					"id": 730171210,
					"content": "#Genau! {NICKNAME} und Paimon helfen mit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171211,
					"content": "Es wird auch einen Weg geben, Marana zu eliminieren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171212
					]
				},
				{
					"id": 730171212,
					"content": "#Ist Nara {NICKNAME} Nara Varuna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171213
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171213,
					"content": "Hm? Warum fragst du das plötzlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171214,
					"content": "#Arapandu sagte, Nara Varuna sei der goldene, tapfere Nara. Zusammen mit Aranara heilte {M#sie}{F#er} die Varuna-Maschine, vertrieb den schwarzen Regen und den schwarzen Schlamm und brachte den Sonnen- und Mondschein zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171215
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171215,
					"content": "#Nara {NICKNAME} hilft uns auch bei der Heilung der Varuna-Maschine. Nara {NICKNAME} ist ebenso golden und tapfer, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171216
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171216,
					"content": "Aber ist Nara Varuna nicht eine Person aus der Geschichte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171217,
					"content": "#Ist Nara Varuna also nicht nach Vana zurückgekommen? Ist Nara {NICKNAME} ein völlig anderer Nara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171218
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171218,
					"content": "Haben unterschiedliche Nara dieselbe Melodie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171219,
						730171220
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171219,
					"content": "Vielleicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171221
					]
				},
				{
					"id": 730171221,
					"content": "#Arakunti kennt Nara Varuna nicht, aber Arapandu spricht viel von {M#ihr}{F#ihm}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171222
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171222,
					"content": "#{F#Seine}{M#Ihre} Melodie muss dieselbe sein wie die von Nara {NICKNAME}, und sie zu hören, macht glücklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171223
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171223,
					"content": "#Stimmt! Jedes Mal, wenn Paimon mit {NICKNAME} zusammen ist, ist Paimon gut gelaunt! Wenn {NICKNAME} eines Tages von Paimon geht, so wie Nara Varuna vom Wald gegangen ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171224,
					"content": "*wimmer* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171225,
					"content": "#Arapandu wartet bestimmt im „Ruheort“ auf uns. Nara {NICKNAME}, komm mit mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171226,
						730171228
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171226,
					"content": "Lass uns gehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171227
					]
				},
				{
					"id": 730171227,
					"content": "Gut, dann kehren wir zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171228,
					"content": "Es gibt da noch eine Sache.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171229
					]
				},
				{
					"id": 730171229,
					"content": "Keine Sorge, Arakunti geht alleine zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171220,
					"content": "Ich weiß es nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171221
					]
				}
			]
		}
	]
}