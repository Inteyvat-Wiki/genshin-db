						],
						"stepId": 7301704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arakunti",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730170401,
					"content": "Die Baumwurzeln sind gut, ein nasser Atem ist zu hören. Ein kleines Wiegelied.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170402
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170402,
					"content": "Oh ... Paimon weiß immer noch nicht, was Arakunti uns sagen möchte. Aber egal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170403,
					"content": "Hier drinnen gibt es einen so großen Raum! Soll das eine „knorrige Wurzel“ sein? Außerdem unterscheidet sich die Atmosphäre von anderen Orten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170404,
					"content": "Sollen wir hier nach den „Blättern“ suchen, die die Varuna-Maschine mit Energie versorgen sollen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170405,
					"content": "Hier und nicht hier. Man kann seine Stimme hören, seinen Atem riechen, seine Adern sehen ... Aber Paimon kann es nicht finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170406
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170406,
					"content": "Hm? Wieso das denn ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170407,
					"content": "Paimon kann ihn nicht finden, was ist mit mir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170408
					]
				},
				{
					"id": 730170408,
					"content": "Der goldene Nara kann Melodien sehen ... wie eine kühle Brise in der Nacht und ein plötzlicher Regen, der den Traum auf der Seeoberfläche in tausend Stücke zerbricht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170409
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170409,
					"content": "Hört sich stark an.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170410
					]
				},
				{
					"id": 730170410,
					"content": "#Nicht schlecht, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170411,
					"content": "Hehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170412
					]
				},
				{
					"id": 730170412,
					"content": "#Hehe ... Nein! {NICKNAME}, du hast Paimons Zeilen gestohlen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170413,
					"content": "#Nara {NICKNAME} hat sich in Paimon verwandelt ... Das ist sogar noch beängstigender als mit den Pilzen in Marana zu tanzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170414
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170414,
					"content": "Unvorstellbar ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170415
					]
				},
				{
					"id": 730170415,
					"content": "Deshalb passiert das nicht! Besser so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170416,
					"content": "Arakunti, kannst du dich nicht klarer ausdrücken? Wo sollen wir die „Blätter“ der Varuna-Maschine finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170417,
					"content": "Im Traum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170418
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170418,
					"content": "Oh ... Warte, warum hast du das nicht von Anfang an gesagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170419,
					"content": "Weil Paimon nicht nach dem Ort gefragt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170420
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170420,
					"content": "Äh ... Paimon hat plötzlich die Kommunikationsweise der Aranara begriffen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170421,
					"content": "Arakunti, kannst du uns sagen, wo die drei „Blätter“ genau sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170422,
					"content": "Natürlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170423
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170423,
					"content": "Oh, Arakunti beantwortet nur Fragen, die wir direkt stellen ... Na gut, wo sind die drei Orte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170424,
					"content": "Hier, dort und da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170425
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170425,
					"content": "Ja, gut ... Damit sagst du uns aber gar nichts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170426,
					"content": "Paimon ist am Boden zerstört.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170427
					]
				},
				{
					"id": 730170427,
					"content": "#Ob Paimon oder {NICKNAME} am Boden zerstört ist, das ist dieselbe Sache! Arakunti kann uns nicht weiterhelfen ... Wie sollen wir die drei Orte finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170428,
					"content": "Die Varuna-Maschine wurde vom herausragendsten Aranara entwickelt. Die Beziehung zwischen „Ästen“ und „Blättern“ ist ersichtlich und wiederum nicht ersichtlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170429
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170429,
					"content": "#Nara {NICKNAME} kann Aranara und ihre hinterlassenen Spuren sehen, also kann er auch die Richtung finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170430
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170430,
					"content": "Paimon hat ... Paimon hat es verstanden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170431,
					"content": "Wir müssen einfach nur den Spuren der Aranara folgen, um sie zu finden, richtig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170432
					]
				},
				{
					"id": 730170432,
					"content": "Ooh ... Gib Paimon wenigstens diesmal die Chance zu antworten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
