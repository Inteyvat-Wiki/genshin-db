			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nach den Sternen greifender Himmelsfürst"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111001001,
					"content": "Hallo! Dürfen wir uns vorstellen? Dies ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001002,
					"content": "Bitte, ihr braucht mir nicht zu danken. Die Welt vom Bösen zu säubern ist die Pflicht der Adepten. Denkt euch nichts dabei ... so wie ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001003
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111001003,
					"content": "Moment, wer seid ihr? Ich dachte, ihr seid Anhänger, aber genauer betrachtet kennen wir uns noch nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001004,
						111001007
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111001004,
					"content": "Wir sind bloß auf der Durchreise.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001005
					]
				},
				{
					"id": 111001005,
					"content": "#Paimon mein Name! Und Paimon reist mit {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001006,
					"content": "Verstehe. Da ihr so höflich seid, sollte ich mich wohl ebenfalls vorstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001010
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111001010,
					"content": "Ähem ... Vor euch steht der Adept „Nach den Sternen greifender Himmelsfürst“, unter diesem Namen kennen mich auch meine Anhänger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001011
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111001011,
					"content": "Ich stieg von meiner Bleibe in den Bergen herab, um die Welt vom Bösen zu säubern, woraufhin unsere Wege sich kreuzten. Nun ... sagt mir, was ihr euch wünscht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001012
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111001012,
					"content": "Unsere Wünsche? Paimon dachte bloß, dass die Adepten in Liyue ausgezeichnete Kämpfer sind ... Meinst du etwa, du kannst auch Wünsche erfüllen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001013,
					"content": "Ha ... Es gibt unterschiedliche Stufen des Adeptendasein ... Sind die Sterne nicht höher als die Berge, die Wolken und der Mond?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001014
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111001014,
					"content": "Doch für einen Adepten ziemt es sich nicht, mit seinen Kräften zu prahlen. Ihr solltet zuerst mit seinen Anhängern sprechen, dann solltet ihr euer Urteil fällen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111001007,
					"content": "Wir folgen dem Pfad der Adepten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001008
					]
				},
				{
					"id": 111001008,
					"content": "#Paimon mein Name! Und Paimon reist mit {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001009,
					"content": "Dann ist es gut, dass unsere Wege sich kreuzen. Ich sollte mich wohl ebenfalls vorstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001010
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				}
			]
		},
		{
