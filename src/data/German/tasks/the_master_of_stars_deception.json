			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000101,
					"content": "#He, {NICKNAME} ... liegt es an Paimon oder sind diese Hilichurle da drüben irgendwie merkwürdig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000102,
						111000104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000102,
					"content": "Sie verstrahlen eine bösartige Energie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000103
					]
				},
				{
					"id": 111000103,
					"content": "Das denkt Paimon auch. Fiese Hilichurle sind kein ungewohnter Anblick, aber ... die hier sind anders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000106,
					"content": "Oh, oh, das Gasthaus Wangshu ist ganz in der Nähe. Die Gäste sind in großer Gefahr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000107,
					"content": "#Jetzt, da wir es gesehen haben, wird Paimon ein sehr schlechtes Gewissen haben, wenn wir nichts unternehmen ... Komm schon, kümmern wir uns um sie, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000104,
					"content": "Sie wirken ungewohnt aggressiv.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000105
					]
				},
				{
					"id": 111000105,
					"content": "Stimmt! Vielleicht liegt es an der ... dunklen Energie, die sie verstrahlen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1110003,
			"completionStepIds": [
				1110003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110003",
							"2"
						],
						"stepId": 1110003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000301,
					"content": "Diese ungewohnt fieseren Hilichurle sind wohl auch ungewohnt schwer zu besiegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000302,
					"content": "He, da drüben versammeln sich Leute ... Was da wohl los ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000303,
					"content": "Ooh, siehst du den Typen in der Maske? Er hat alle Hilichurle verscheucht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000304,
						111000305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000304,
					"content": "Ist er etwa ein Adept?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				},
				{
					"id": 111000306,
					"content": "Oh, meinst du wie Xiao? Jetzt, da du es sagst, ihre Masken ähneln sich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000307,
					"content": "Doch seine Magie wirkte eher wie die eines Adepten als die von Xiao. Sollen wir uns vorstellen? Diesmal auf die normale Weise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000305,
					"content": "Er scheint eine Art Adeptenkunst genutzt zu haben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				}
			]
		},
		{
			"id": 1110004,
			"completionStepIds": [
				1110004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110004",
							"2"
						],
						"stepId": 1110004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anbeter"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000401,
					"content": "Habt ihr den nach den Sternen greifenden Himmelsfürst in Aktion gesehen? Seine Kräfte sind wirklich göttlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000402
					],
					"speakerTitle": "Anbeter"
				},
				{
					"id": 111000402,
					"content": "Ich glaube, jetzt gibt es endlich Hoffnung für meinen leidenden Vater ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000403
					],
					"speakerTitle": "Anbeter"
				},
				{
					"id": 111000403,
					"content": "Erzähl mir vom nach den Sternen greifenden Himmelsfürst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000404
					]
				},
				{
					"id": 111000404,
					"content": "Du musst bloß Zeuge seiner Magie sein, das ist Beweis genug. Ein wahrer Adept, kein Zweifel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000405
					],
					"speakerTitle": "Anbeter"
				},
				{
					"id": 111000405,
					"content": "Vor kurzer Zeit bat ich ihn um Medizin für meinen kranken Vater. Der Unterschied zwischen den Rezepten der Bubu-Hütte und ihm war wie Nacht und Tag.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000406
					],
					"speakerTitle": "Anbeter"
				},
				{
					"id": 111000406,
					"content": "Sobald sie fertig gebraut war, gab sie diesen ätherischen Nebel von sich – das kann nur ein Adept! Vielleicht lag es aber auch an der Eisnebelblume ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000407
					],
					"speakerTitle": "Anbeter"
				},
				{
					"id": 111000407,
					"content": "Die Medizin der Adepten ist am stärksten. Mein Vater ist bald wieder auf dem Damm, ich weiß es ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000408
					],
					"speakerTitle": "Anbeter"
				},
				{
					"id": 111000408,
					"content": "Klar muss man auch Opfer bringen, wenn man die Hilfe von einem Adepten wie der nach den Sternen greifende Himmelsfürst sucht ... Ich musste ein paar Antiquitäten als Opfergabe bringen. Doch das Leben meines Vaters ist mehr wert als ein paar Relikte, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anbeter"
				}
			]
		},
		{
			"id": 1110005,
			"completionStepIds": [
				1110005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110005",
							"2"
						],
						"stepId": 1110005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anbeterin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000501,
					"content": "Endlich, ein Leben voller Hoffnung und Sinn ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000502
					],
					"speakerTitle": "Anbeterin"
				},
				{
					"id": 111000502,
					"content": "Was hältst du vom nach den Sternen greifenden Himmelsfürst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000503
					]
				},
				{
					"id": 111000503,
					"content": "Oh! Seid ihr auch Anhänger?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000504
					],
					"speakerTitle": "Anbeterin"
				},
				{
					"id": 111000504,
					"content": "Nachdem mein Verlobter mich verließ, weinte ich jeden Tag ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000505
					],
					"speakerTitle": "Anbeterin"
				},
				{
					"id": 111000505,
					"content": "Doch dann wandte ich mich an den nach den Sternen greifenden Himmelsfürst. Auf seinen Rat hin verbrannte ich die Bilder meines Verlobten und streute die Asche bei Sonnenaufgang in den Ozean ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000506
					],
					"speakerTitle": "Anbeterin"
				},
				{
					"id": 111000506,
					"content": "Ich kann es nicht erklären ... aber es hat funktioniert! In meinem Herzen weiß ich, dass er zurückkehren wird. Das ist nicht nur Wunschdenken ... Ich bin mir sicher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000507
					],
					"speakerTitle": "Anbeterin"
				},
				{
					"id": 111000507,
					"content": "Ich war so überglücklich, dass ich dem nach den Sternen greifenden Himmelsfürst meine Mitgift als Opfergabe brachte. Ohne ihn würde ich schließlich meine Verlobten nicht zurückbekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anbeterin"
				}
			]
		},
		{
			"id": 1110006,
			"completionStepIds": [
				1110006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
