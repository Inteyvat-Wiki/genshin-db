							"1110006",
							"2"
						],
						"stepId": 1110006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anbetender Händler"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000601,
					"content": "Die Millelithen müssen nicht wirklich Wache schieben, wenn der nach den Sternen greifende Himmelsfürst da ist, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000602
					],
					"speakerTitle": "Anbetender Händler"
				},
				{
					"id": 111000602,
					"content": "Was weißt du über den nach den Sternen greifenden Himmelsfürst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000603
					]
				},
				{
					"id": 111000603,
					"content": "Ich bin ein Händler und musste jüngst eine Ladung wertvoller Güter transportieren. Darum bat ich, auch wenn es vermessen war, den nach den Sternen greifenden Himmelsfürst, diese Reise mit mir anzutreten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000604
					],
					"speakerTitle": "Anbetender Händler"
				},
				{
					"id": 111000604,
					"content": "Sobald er seinen Talisman empor hielt, ergriffen die Monster weit und breit die Flucht. Auf der gesamten Reise gab es nicht den geringsten Ärger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000605
					],
					"speakerTitle": "Anbetender Händler"
				},
				{
					"id": 111000605,
					"content": "Es war natürlich nicht billig ... doch die Dienste eines Gottes in Anspruch zu nehmen, ist natürlich eine monumentale Angelegenheit. Denkt nur an die Adeptenzeremonie! Ich habe also kein Problem damit, auch wenn man außerhalb von Liyue wohl anderer Meinung ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anbetender Händler"
				}
			]
		},
		{
			"id": 1110008,
			"completionStepIds": [
				1110008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110008",
							"2"
						],
						"stepId": 1110008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nach den Sternen greifender Himmelsfürst"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000801,
					"content": "Was denkst du? Die eigenen Anhänger übertrieben vielleicht ein wenig, aber sie sprechen aus dem Herzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000802
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111000802,
					"content": "Wohl eher aus ihrer Fantasie ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000803
					]
				},
				{
					"id": 111000803,
					"content": "Haha, sicher scherzt du. Einst gab es einen ehrenwerten Adepten namens Xue Wuliang, der „Liangzi“ genannt wurde. Er sagte einst:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000804
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111000804,
					"content": "„Alles ist verbunden. Was die Sterblichen Fantasie nennen, ist nur die Verbindung zwischen Geist und Materie.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000805
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111000805,
					"content": "Anders gesagt, ihre Wünsche sind bereits dabei, Wirklichkeit zu werden. Verstehst du es jetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000806
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111000806,
					"content": "Nicht alles ... Aber du meinst, ihre Wünsche können sich erfüllen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000807,
					"content": "So ist es. Sehr scharfsinnig, mein kleiner Freund.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000808
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111000808,
					"content": "Nun ... Es gibt da ein Problem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000809,
					"content": "Oh? Was ist denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000810,
						111000811
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111000810,
					"content": "Warum trägst du eine Maske?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000814
					]
				},
				{
					"id": 111000814,
					"content": "Einer ... wandert unter Sterblichen, um Gutes zu tun und Böses zu vertrieben. Einer enthüllt nicht sein Gesicht, um unnötigen Aufruhr zu vermeiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000815
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111000815,
					"content": "Ooh, jetzt versteht Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000816,
					"content": "Also – wie lauten eure Wünsche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000817,
						111000819,
						111000821
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111000817,
					"content": "Ich bin auf der Suche nach einem nahen Verwandten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000818
					]
				},
				{
					"id": 111000818,
					"content": "Ah ... Da steckt sicher eine Tragödie dahinter, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111000824,
					"content": "So sei es. Diese Wünsche können erfüllt werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000825
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111000825,
					"content": "Doch es mangelt ... an einem Beweis deiner Ernsthaftigkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000826
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111000826,
					"content": "Beweis wovon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000827,
					"content": "Der Weg des Adepten gründet im „Verstehen“. Verstehst du nicht die verborgene Bedeutung, kann dir leider keine Hilfe gewährt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000828
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111000828,
					"content": "Was sollen wir tun? Paimon hat keine Ahnung, wovon er redet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000829,
						111000830
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000829,
					"content": "Er möchte wohl einen Anreiz von uns ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000831,
					"content": "Ooh, richtig! Einige dieser Anhänger erwähnten, dass sie ein hübsches Sümmchen für die Hilfe des Adepten hinlegen mussten, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000832
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000832,
					"content": "Aber wir haben nicht viel von Wert bei uns ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000833,
					"content": "Und du besitzt kein Göttliches Auge ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000834,
						111000835
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000834,
					"content": "Ich glaube nicht, dass ein Göttliches Auge verkäuflich ist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000836,
					"content": "He! Warum kochen wir nicht etwas Köstliches für ihn? Einer guten Mahlzeit kann keiner widerstehen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000837,
						111000838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000837,
					"content": "Deine Reichtümer sind nun mal, was sie sind ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000839,
					"content": "Jawohl, eine köstliche Mahlzeit. Das funktioniert bestimmt, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000840
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000840,
					"content": "Warum gehst du nicht zur Buchhandlung Wanwen und hältst nach neuen Rezepten Ausschau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000838,
					"content": "Etwas Köstliches!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000835,
					"content": "Stimmt, wie schade ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000830,
					"content": "Er möchte wohl Mora von uns ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000819,
					"content": "Ich wünsche mir die Stärke der Götter.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						111000820
					]
				},
				{
					"id": 111000820,
					"content": "In der Tat können viele Hindernisse mit entsprechender Kraft überwunden werden. Doch es bleibt die Frage – was für einen Groll hast du gegen die Götter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111000821,
					"content": "Ich möchte schnell reich werden!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000822
					]
				},
				{
					"id": 111000822,
					"content": "#He! Hast du {M#deine Schwester}{F#deinen Bruder} schon vergessen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000823,
					"content": "Mmh, ein unter Sterblichen verbreiteter Wunsch. Du kommst zwar nicht aus Liyue, aber unterliegst dem dort herrschenden materialistischen Einfluss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				},
				{
					"id": 111000811,
					"content": "Würdest du deine Maske abnehmen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000812
					]
				},
				{
					"id": 111000812,
					"content": "He! Ist das nicht etwas unhöflich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000813,
					"content": "Das würde mich in der Tat in Verlegenheit bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000814
					],
					"speakerTitle": "Nach den Sternen greifender Himmelsfürst"
				}
			]
		},
		{
			"id": 1110010,
			"completionStepIds": [
				1110010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
