					"nextDialogs": [
						411310705
					]
				},
				{
					"id": 411310705,
					"content": "Hmm ... ja, da hast du wohl recht. Aber sooo gefährlich können sie auch nicht sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
