				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310201,
					"content": "Da wimmelt es vor Monstern, weißt du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310202
					]
				},
				{
					"id": 411310202,
					"content": "#Weiß ich, und darum bin ich auf dich angewiesen, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
		{
			"id": 4113103,
			"completionStepIds": [
				4113103
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310301,
					"content": "Andere hatten sicher die gleiche Idee ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310302
					]
				},
				{
					"id": 411310302,
					"content": "Da bin ich sicher – und genau darum sollten wir uns beeilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310303
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310303,
					"content": "Wenn du mir helfen willst, sollten wir sofort ausbrechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310304
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310304,
					"content": "Jede Sekunde, die untätig verstreicht, verlieren wir kostbare Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310305
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310305,
					"content": "Ah, er will einfach nicht hören, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411310306,
					"content": "Vielleicht können wir ihn davon überzeugen, dass dieser Plan nichts einbringt, oder dass die gefallenen Sterne extrem gefährlich sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4113104,
			"completionStepIds": [
				4113104
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310401,
					"content": "Wenn du die gefallenen Sterne berührst, verlierst du das Bewusstsein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310402
					]
				},
				{
					"id": 411310402,
					"content": "Hmm? Ah, richtig. Von diesem Gerücht habe ich gehört. Das könnte ein Problem darstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310403
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310403,
					"content": "Doch ich glaube, diese Maschinen können es lösen ... meinst du nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310404
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310404,
					"content": "Ooh, langsam sieht er es ein. Wiegt ... er Gewinn und Verlust auf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411310405,
					"content": "Weiter so. Überzeugen wir ihn, dass seine Unternehmung nichts einbringt und die gefallenen Sterne extrem gefährlich sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4113105,
			"completionStepIds": [
				4113105
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310501,
					"content": "Findest du auch den passenden Schmuck dafür?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310502
					]
				},
				{
					"id": 411310502,
					"content": "Oh, mach dir darum keine Sorgen. Ich finde sie so oder so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310503
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310503,
					"content": "Silber, Gold, kostbares Gestein ... Da komme ich leicht dran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
