			},
			"dialogs": [
				{
					"id": 411311001,
					"content": "Doch die Käufer dieser Schmuckstücke werden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311002
					]
				},
				{
					"id": 411311002,
					"content": "Argh, du hast recht ... Selbst wenn ich das Problem mit den Maschinen löse, muss den Schmuck jemand tragen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311003
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311003,
					"content": "Wenn meine Kunden in Tiefschlaf fallen, ist das ... schlecht für mein Geschäft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311004
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311004,
					"content": "Nun, wir könnten den Schmuck zur Schau stellen, ohne dass ihn jemand berührt. Aber das würde den Preis beträchtlich senken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311005
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311005,
					"content": "Hmm, verzwickte Sache ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
