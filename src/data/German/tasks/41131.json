					"nextDialogs": [
						411310902
					]
				},
				{
					"id": 411310902,
					"content": "Ach, komm schon. Wir tun hier nichts Illegales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310903
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310903,
					"content": "Versteh doch: Dieser Hagel gefallener Sterne ist wahrlich eine Katastrophe, doch er stellt auch eine Gelegenheit dar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
		{
