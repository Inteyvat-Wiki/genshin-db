				{
					"id": 411310702,
					"content": "Ha! Die haben meine Anfrage abgelehnt, sie meinten, ich soll diese gefallenen Sterne nicht anrühren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310703
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310703,
					"content": "Abenteurergilde, von wegen! Wo bleibt da bitte der Abenteuergeist?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310704
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310704,
					"content": "Aber sind diese gefallenen Sterne nicht wirklich gefährlich?",
