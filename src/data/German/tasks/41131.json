				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310101,
					"content": "Hmm ... nicht übel. Daraus könnte ich einen ganzen Haufen machen. Es gibt nur ein Problem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310102
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310102,
					"content": "Was für ein Problem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310103
					]
				},
				{
					"id": 411310103,
					"content": "#Wie? Oh, {F#Reisende}{M#Reisender}, du bist es. Du kommst gerade recht! Könnte ich dich für etwas interessieren? Es ist ... nun ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310107
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310107,
					"content": "Ein wunderbar mysteriöses, einmaliges, todsicheres Geschäftsangebot?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310108
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310108,
					"content": "Mit ein wenig Hilfe von dir wird sich die Sache für uns beide großzügig lohnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310104,
						411310109
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310104,
					"content": "Wie du weißt, ist die Bank des Nordens eine Hochsicherheitseinrichtung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310105
					]
				},
				{
					"id": 411310105,
					"content": "Das weiß doch jeder. Die Wachen kommen sogar aus Snezhnaya. Also ... Moment mal? Was willst du damit sagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310106,
					"content": "Deine Reisen haben jedoch deinen Horizont erweitert und deine Fantasie angeregt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310112
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310112,
					"content": "Er ist realistisch und absolut auf dem Boden der Tatsachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310113
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310113,
					"content": "Sicher hast du von den gefallenen Sternen gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310114
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310114,
					"content": "Ich möchte von einem dieser Objekte ein paar Teile abschlagen und sie zurückbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310115
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310115,
					"content": "Anschließend heuern wir einen Kunsthandwerker an, der daraus Schmuck anfertigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310116
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310116,
					"content": "Denk drüber nach. Objekte aus gefallenen Sternen. Ringe, Halsbänder, Armbänder und Ohrringe ... Dafür werden die Wohlhabenden einen schönen Preis zahlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310117
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310117,
					"content": "#Deine Aufgabe ist simpel, {F#Reisende}{M#Reisender}. Du musst nur dafür sorgen, dass mich die Monster nicht stören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310118
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310118,
					"content": "Wie sieht’s aus? Haben wir eine Abmachung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310119
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310119,
					"content": "Halte dich von diesen gefallenen Sternen lieber fern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310120
					]
				},
				{
					"id": 411310120,
					"content": "Was? Warum? Dieses Geschäft lasse ich mir nicht entgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310109,
					"content": "Konntest du etwas in Liyues Kodizes finden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310110
					]
				},
				{
					"id": 411310110,
					"content": "Ähm, ehrlich gesagt sind Liyues Gesetze trefflich verfasst. Es findet sich im Grunde keine Lücke darin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310111
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310111,
					"content": "*hust* A... Aber darum geht es nicht! Mein Plan ist auf jeden Fall legal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "Ivanovich"
				}
			]
		},
		{
			"id": 4113102,
			"completionStepIds": [
				4113102
			],
