					"nextDialogs": [
						411311102
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311102,
					"content": "Du wirst diese Mission auch nicht annehmen, oder? Na ja, wenn du nicht willst, ist das in Ordnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311103
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311103,
					"content": "Es wird schwer werden, so kurzfristig neue Wachen anzuheuern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311104
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311104,
					"content": "Doch ich gebe nicht auf! Auch wenn ich die gefallenen Sterne nicht berühren kann, lasse ich diese Gelegenheit nicht so leicht verstreichen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311105
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311105,
					"content": "#{F#Reisende}{M#Reisender}, auch wenn ich keinen gefallenen Stern bekomme, brauche ich deine Hilfe bei einer anderen Sache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311106
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311106,
					"content": "Wenn diese gefallenen Sterne wirklich so faszi– ich meine, gefährlich sind, dass sie jeden, der sie berührt, in Tiefschlaf versetzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311107
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311107,
					"content": "... dann muss die Umgebung ebenfalls von ihnen beeinflusst sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311108
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311108,
					"content": "#{F#Reisende}{M#Reisender}, könntest du mir einen Gegenstand aus dem Einschlagsgebiet bringen? Pflanzen, Blumen ... egal was.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311109,
						411311111
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311109,
					"content": "Alles klar ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311110
					]
				},
				{
					"id": 411311110,
					"content": "Danke. Ich kann diese Gelegenheit nicht einfach verstreichen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311111,
					"content": "Sind alle Händler so?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311112
					]
				},
				{
					"id": 411311112,
					"content": "Haha. Das verstehe ich als Kompliment. Ich zähle also auf dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
