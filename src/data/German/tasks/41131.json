				{
					"id": 411311301,
					"content": "Hast du etwas gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311302,
						411311305
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311302,
					"content": "Ja, hier ist es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311303
					]
				},
				{
					"id": 411311303,
					"content": "Wunderbar! Zeig her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311304
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311304,
					"content": "Ah, eine frische Zuckerblume. Nicht übel. Sie ist in der Tat ungewöhnlich. Das muss am Einfluss der gefallenen Sterne liegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311305,
					"content": "Das könnte ein Problem sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311306
					]
				},
				{
					"id": 411311306,
					"content": "Hmm? Was meinst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311307
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311307,
					"content": "Du wurdest von Blumen angegriffen, als du Blumen ... pflücktest? Blumen greifen Leute an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311308
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311308,
					"content": "Aha, das muss der Einfluss der gefallenen Sterne sein! Das erklärt, warum diese Blumen so besonders sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311309
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311309,
					"content": "Über den Zusammenhang wäre ich nicht so sicher ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311310
					]
				},
				{
					"id": 411311310,
					"content": "Stimmt! Zwischen gefallenen Sternen und Blumen besteht ja keine Verbindung, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411311311,
					"content": "Nein, nein, nein, vertrau mir. Diese Blume ist irgendwie außergewöhnlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311312
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311312,
					"content": "Ich kann nichts Besonderes daran erkennen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311313
					]
				},
				{
					"id": 411311313,
					"content": "Nein, nein. Sie wuchs neben einem dieser gefallenen Sterne, also muss sie irgendwie besonders sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311314
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311314,
					"content": "Doch diese Zuckerblume sieht so aus wie jede andere aus. Sie duftet auch normal und fühlt sich so an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411311315,
					"content": "Nun, was das betrifft ... musst du dir keine Gedanken machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311316
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311316,
					"content": "Hier ist wie vereinbart deine Entschädigung. Es war ein Vergnügen, mit dir Geschäfte zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311317
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311317,
					"content": "Also, was stelle ich mit dieser Zuckerblume an ... Gewinne ich ein Parfüm daraus, oder verwende ich sie als Lesezeichen? Vielleicht sollte ich sie trocknen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
