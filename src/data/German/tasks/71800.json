						],
						"stepId": 7180006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718000301,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000302,
						718000305
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 718000302,
					"content": "Ich bin von Kopf bis Fuß durchnässt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718000303
					]
				},
				{
					"id": 718000303,
					"content": "Tut mir leid, Kinder, das war fürchterlich unaufmerksam von mir. Ich dachte, es sei nur ein klein wenig Wasser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000304
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 718000304,
					"content": "Zumindest ist dieser Teekessel nun sauber. Um ein paar Kleinigkeiten muss ich mich kümmern, doch alles zu seiner Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000307
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 718000307,
					"content": "Oma, hast du den gesamten Bishui-Fluss genommen, oder so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718000308,
					"content": "Törichtes Kind, das würde mir nicht im Traum einfallen. Wo sollen die armen Stadtbewohner dann ihr Wasser herholen? Nein, ich habe nur die Hälfte des Flusswassers genommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000309
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 718000309,
					"content": "Verzeihung für das kleine Ärgernis von meiner Seite. Bitte nimm dies als Dank für deine Hilfe an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000310
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 718000310,
					"content": "Oh, und ich muss das Wasser aus dem Teekessel noch zurück zum Fluss bringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 718000305,
					"content": "Jetzt sollte es blitzsauber sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718000306
					]
				},
				{
					"id": 718000306,
					"content": "Nun, fast. Ein paar Ecken und Enden gibt es noch, die ordentlich gereinigt werden müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000307
					],
					"speakerTitle": "Madame Ping"
				}
			]
		},
