			"dialogs": [
				{
					"id": 790480101,
					"content": "Hier scheinen einige Papierstücke zu sein. Sind das jemandes Aufzeichnungen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790480102
					],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790480102,
					"content": "Wenn Paimon sich die Wortwahl in dem Text so ansieht, dann scheint es ... sich um das Tagebuch eines Malers zu handeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790480103,
						790480104
					],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790480103,
					"content": "Was für ein Selbstvertrauen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790480105
					]
				},
				{
					"id": 790480105,
					"content": "Doch es ist schon irgendwie verständlich. Egal, worum es geht, ohne ein gewisses Maß an Eifer wird man bei keiner Sache schnelle Fortschritte machen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790480106
					],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790480106,
					"content": "Allerdings hat dieser Teil des Tagebuchs nur wenig Inhalt. Paimon fragt sich, was danach mit ihm geschah ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790480107
					],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790480107,
					"content": "#Vielleicht finden wir ja an anderen Orten noch andere Teile seines Tagebuchs. Wir sollten die Augen danach offenhalten, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790480104,
					"content": "Ein wenig hochmütig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790480105
					]
				}
			]
