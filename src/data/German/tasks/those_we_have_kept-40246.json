					}
				]
			},
			"dialogs": [
				{
					"id": 402460501,
					"content": "Hm, bisher keine Spur davon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460502
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460502,
					"content": "Soll ich das Beschwörungsritual starten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460503
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460503,
					"content": "Lass uns zuerst das Wasser aus dieser Etage des Turms ablassen. Dann können wir uns hier leichter bewegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460504
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460504,
					"content": "Warte, das können wir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460505,
					"content": "Natürlich. Alain und René haben beide die Zukunft gesehen, die auf Fontaine zukam, und haben sogar ein paar Methoden geteilt, um Gebäude wasserdicht zu machen. Das Prinzip dahinter ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460506
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460506,
					"content": "... Ähem, unwichtig. Entriegelt einfach die Mechanismen in der Reihenfolge, die ich sage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
		{
			"id": 4024607,
			"completionStepIds": [
				4024607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
