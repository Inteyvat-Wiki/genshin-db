						"stepId": 4024607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 20359,
						"position": [
							2652.556,
							253.937,
							3640.104
						],
						"pointId": 7
					}
				]
			},
			"dialogs": [
				{
					"id": 402460701,
					"content": "Seid ihr bereit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460702
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460702,
					"content": "Ja. Wenn dieses Ding auftaucht, werde ich versuchen, mit den Seelen darin zu reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460703
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460703,
					"content": "Aber höchstwahrscheinlich haben sie bereits den Verstand verloren. Wenn die Kommunikation scheitert, steht uns ein Kampf bevor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460704
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460704,
					"content": "In diesem Fall sollte sich Paimon besser ein Versteck suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460705,
					"content": "Falls es wirklich zu einem Kampf kommt, sollte ich den letzten Schlag austeilen. In der Sache könnt ihr mir vertrauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460706
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460706,
					"content": "Verstanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460707
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460707,
					"content": "Also gut, ich brauche Ruhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460708
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460708,
					"content": "... Umherirrende Geister, die mit den Gezeiten treiben, hört mich nun an. Zerbrochene Seelen, stumm, zerrissen und verlassen, folgt den Spuren der Vergangenheit und kehrt zu uns zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460709
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460709,
					"content": "... Möge Groll den Groll erkennen. Mögen finstere Wesen sich vereinen und an diesem Ort erneut Gestalt annehmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460710
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460710,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460711
					]
				},
				{
					"id": 402460711,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460712,
					"content": "(... Was nun? War das alles?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460713
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460713,
					"content": "(Ugh ... Genau deshalb beschäftige ich mich mit Mathe und nicht mit Magie. Wie sollen wir wissen, in welcher Phase der Zauber gerade ist? Es ist, als gäbe es hier überhaupt keine Logik.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460714
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460714,
					"content": "(Mechanik ist so viel einfacher zu ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460715
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460715,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460716
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460716,
					"content": "Pass auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460717
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460717,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460718
					],
					"speakerTitle": "„Groll der wandernden Seelen“"
				},
				{
					"id": 402460718,
					"content": "He, du! Oder wer auch immer in dir steckt ... Du musst mir zuhören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460719
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460719,
					"content": "Ich bin ein Nachkomme von Fontaines „Herrn der wunderlichen Maschinen“, Alain Guillotin. Ich kann dich wieder ganz machen und zum Fluss der Elemente zurückbringen. Du musst nur mit mir zusammenarbeiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460720
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460720,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460721
					],
					"speakerTitle": "„Groll der wandernden Seelen“"
				},
				{
					"id": 402460721,
					"content": "Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460722,
					"content": "Ts ... Sieht so aus, als wäre Reden keine Option mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460723
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460723,
					"content": "Also gut, Plan B ... Zeit, etwas Dampf abzulassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
		{
			"id": 4024609,
			"completionStepIds": [
				4024609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4024609",
							"2"
						],
						"stepId": 4024609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 20359,
						"position": [
							2644.99,
							253.937,
							3639.558
						],
						"pointId": 8
					}
				]
			},
			"dialogs": [
				{
					"id": 402460901,
					"content": "I... Ist es vorbei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460902,
					"content": "Ja. Hab dir doch gesagt, dass es ein Kinderspiel wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460903
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460903,
					"content": "Wie hast du das gerade gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460904
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460904,
					"content": "Diese Kreatur war nichts Besonderes. Man nehme einen Haufen Seelen, die nirgendwohin können, einen Hauch böser Energie, ein paar Verunreinigungen und jede Menge Groll, und dann kommt genau das dabei heraus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460905
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460905,
					"content": "Ich habe nur die ursprünglichen Seelen vom restlichen Schmutz getrennt, damit sie von den aktuellen Regeln der Welt akzeptiert werden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460906
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460906,
					"content": "Das Prinzip hinter der Weltformel ist die „Divergenz“. Ausgehend von einem Ursprungspunkt zerlegt und rekonstruiert sie die Möglichkeiten der Welt, um bestimmte Antworten zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460907
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460907,
					"content": "Daraus folgt also, dass wir durch das Rückwärtsberechnen der Weltformel stattdessen Konvergenz und Wiederherstellung erreichen können. Mit dem arithmetischen Feld ist mir genau das gelungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460908
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460908,
					"content": "Es ähnelt dem Konzept der homologischen Reduktion in der Mathematik. Ich habe sie auf die fundamentale Essenz ihres Seins reduziert, ohne ihre eigentliche Natur zu verändern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460909
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460909,
					"content": "Das bedeutete ... Ach, egal. Wenn ich mir eure leeren Blicke so ansehe, schätze ich mal, dass es euch eigentlich gar nicht interessiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460910
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460910,
					"content": "Ich glaube, ich verstehe endlich, wie sich Fremde fühlen, wenn ich über Schamanen-Themen rede ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460911
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460911,
					"content": "J... Jedenfalls war es super beeindruckend! Du bist wirklich unglaublich, Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460912,
					"content": "Heh, merkst du das erst jetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460913
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460913,
					"content": "Nichts Geringeres hätte ich von der Entwirrerin jeglicher Vernun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460914
					]
				},
				{
					"id": 402460914,
					"content": "Ähem! Genug davon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460915
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460915,
					"content": "W... Wir sollten aufbrechen! Ich setze die Mechanismen im Turm zurück. Wir sehen uns an Land!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
		{
			"id": 4024610,
			"completionStepIds": [
				4024610
