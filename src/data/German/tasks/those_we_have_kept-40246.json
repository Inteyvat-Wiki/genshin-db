						],
						"pointId": 9
					}
				]
			},
			"dialogs": [
				{
					"id": 402461001,
					"content": "Tja, das war mal ein richtiges Durcheinander. Ich bin froh, dass wir das endlich hinter uns haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461002
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461002,
					"content": "Es fühlt sich gut an, ab und zu mal etwas Gutes zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461003
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461003,
					"content": "Du hast in Nod-Krai auch allen total viel geholfen! Irgendwie scheinst du im Herzen einfach ein guter Mensch zu sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461004,
					"content": "Heh, da wäre ich mir nicht so sicher. Ich werde schon bald zu den Fatui zurückkehren. Ihr beide seid manchmal echt zu gutgläubig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461005
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461005,
					"content": "Nun, zumindest wissen wir, dass wir dir vertrauen können.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402461006
					]
				},
				{
					"id": 402461006,
					"content": "Hmpf, na gut. Sagt aber bloß nicht, ich hätte euch nicht gewarnt, wenn es nach hinten losgeht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461007
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461007,
					"content": "Also, wohin als Nächstes? Zurück zum Schiff?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461008
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461008,
					"content": "Ja! Deine persönlichen Angelegenheiten, die Sache mit dem Narzissenkreuz, sind jetzt alle geklärt. Das bedeutet, du kannst jetzt „die Leute sehen, die gesehen werden müssen“, stimmt’s, Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461009,
					"content": "Alle werden sich so freuen, dass du wieder da bist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461010,
					"content": "Heh ... Früher wäre ich lieber gestorben, als das zuzugeben, aber ... Ja. Ich habe wirklich alle vermisst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461011
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461011,
					"content": "Columbina ist allerdings ein Sonderfall! Dieses Mal zahle ich ihr all ihre nervigen Mätzchen der letzten Jahre definitiv heim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
		{
			"id": 4024611,
			"completionStepIds": [
				4024611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
