						],
						"pointId": 16576
					}
				]
			},
			"dialogs": [
				{
					"id": 402461101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461102
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 402461102,
					"content": "Ähm, Sandrone ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461103
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 402461103,
					"content": "Mach den Moment doch nicht kaputt. Sonst fange ich an, mich darüber zu ärgern, wie du mich an einen zufälligen Ort teleportiert hast, nachdem ich dir ausdrücklich gesagt habe, dass du damit aufhören sollst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461104,
					"content": "Ä... Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461105
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 402461105,
					"content": "Uuund ... Schnitt! Bravo! Bravo! Wir haben’s! Das ist genau das Ende, das ich mir erhofft habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461106
					],
					"speakerTitle": "Xavier",
					"speakerSubtitle": "Filmproduzent"
				},
				{
					"id": 402461106,
					"content": "... Hä?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461107,
					"content": "Wo bist du gerade hin, Fräulein Columbina? Du bist einfach verschwunden, und in der nächsten Sekunde warst du dann wieder da und hast diese, ähm ... diese neue Freundin hier umarmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402461108,
					"content": "D... Das ... war alles ... auf ... Kamera ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461109,
					"content": "Nun, die Kamera lief bereits und es ging alles so schnell, also ... Ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461110
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402461110,
					"content": "Moment mal, sie muss ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402461111,
					"content": "Ja, meine beste Freundin. Die, die ich gesucht habe. Ich hätte nie gedacht, dass ich sie wirklich wiedersehe. Ich bin einfach ... so glücklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461112
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 402461112,
					"content": "Außerdem hat der Film auch ein gutes Ende bekommen. Das haben wir alles dir zu verdanken, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461113
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 402461113,
					"content": "... Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461114
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 402461114,
					"content": "Konntest du nicht mal für eine Sekunde aufhören so nervig zu sein?! Columbinaaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
		{
			"id": 4024612,
			"completionStepIds": [
				4024612
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4024612",
							"2"
						],
						"stepId": 4024612,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Citlali"
				],
				"points": [
					{
						"sceneId": 1161,
						"position": [
							120.083,
							16.223,
							67.002
						],
						"pointId": 23
					},
					{
						"sceneId": 1161,
						"position": [
							117.987,
							16.223,
							73.794
						],
						"pointId": 24
					}
				]
			},
			"dialogs": [
				{
					"id": 402461201,
					"content": "Citlali, wir sind da!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461202,
					"content": "Oh, ziemlich pünktlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461203,
					"content": "Na ja ... Wir waren ja auch nicht diejenigen, die gestern Unmengen an Alkohol getrunken haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461204,
					"content": "Hm, was? Glaubst du etwa, ich vertrage keinen Alkohol? Es braucht schon einiges mehr, um mich betrunken zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461205
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461205,
					"content": "Wirklich? Denn, äh, was du gesagt hast, ergab nach einer Weile gar keinen Sinn mehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461206,
					"content": "W... War das so? Davon weiß ich ja gar nichts. Ich habe hoffentlich nichts ... allzu Verrücktes gesagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461207
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461207,
					"content": "Mal sehen ... Du hast eine halbe Stunde lang über Ororon gelästert, dich eine halbe Stunde über die Arbeit beschwert, dann noch eine Stunde über Kurzerzählungen geredet ... Und, ähm, Paimon ist danach dann irgendwie eingeschlafen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461208,
					"content": "... Sind sie weg?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461209
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461209,
					"content": "Hm? Oh, das Team? Ja, wir haben sie an Deck getroffen, aber sie sind gerade gegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461210,
					"content": "Warte mal, aber jetzt, wo alles mit deinem Kern geklärt ist, was hält dich davon ab, Columbina zu sehen? Sie vermisst dich sehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461211,
					"content": "Ich ... Ich will einfach zuerst dieses Chaos beseitigen. Außerdem ist das die perfekte Gelegenheit, sie zur Abwechslung mal zu erschrecken. Das muss ich gut planen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461212
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461212,
					"content": "Aber genug davon. Konntest du den Standort unseres Ziels ausfindig machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461213
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461213,
					"content": "Natürlich. Wenn ich, Oma Itztli, etwas verspreche, dann halte ich auch mein Wort!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461214
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461214,
					"content": "Sehr gut, mal sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461215
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461215,
					"content": "Der Bezirk Morte ... Moment, das ist der Turm der Gestalt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461216
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461216,
					"content": "Der Ort, an dem ihre Seelen abgetrennt wurden ... Ist es das, was sie am meisten hassen? Oder ist es eher der Narzissenkreuz-Verein selbst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461217
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461217,
					"content": "Lasst mich mitkommen. Dieses Ding bewegt sich nicht nach einem festen Muster. Wenn es nicht an diesem Ort ist, wenn wir dort ankommen, kann ich ein Ritual nutzen, um es zu beschwören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461218
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461218,
					"content": "Du hast dir schon mehr als genug Mühe gemacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461219
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461219,
					"content": "Das macht mir nichts aus. Diese alten Knochen haben sowieso nichts Besseres zu tun. Einen Geist zu beschwören, wird mich schon nicht umbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461220
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461220,
					"content": "(Außerdem haben sie, wenn ich nicht hingehe, nur noch mehr Insiderwitze, bei denen ich nicht mitreden kann!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461221
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461221,
					"content": "Also gut. Ich danke dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461222
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461222,
					"content": "Hehe, wir haben keine Zeit zu verlieren. Lasst uns aufbrechen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
