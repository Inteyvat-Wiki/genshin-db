			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Columbina“"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3537.532,
							452.648,
							4178.716
						],
						"pointId": 16568
					},
					{
						"sceneId": 3,
