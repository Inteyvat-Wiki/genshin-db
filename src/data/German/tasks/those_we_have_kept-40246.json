							3538.825,
							452.648,
							4179.689
						],
						"pointId": 16573
					}
				]
			},
			"dialogs": [
				{
					"id": 402460201,
					"content": "Citlali hat gestern Abend echt viel getrunken ... Ob sie überhaupt schon wach ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460202,
					"content": "Guten Morgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460203
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 402460203,
					"content": "Waah! C... Columbina! Du, äh, weißt wirklich, wie man einen Auftritt hinlegt ... Was machst du hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460204,
					"content": "Wir haben gerade in letzter Minute noch eine Szene abgedreht, also bin ich hochgekommen, um etwas frische Luft zu schnappen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460205
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 402460205,
					"content": "Die anderen sind noch unten und diskutieren, was genau die letzte Szene sein soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460206
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 402460206,
					"content": "Du meinst, wie es enden soll?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460207,
					"content": "Ja. Sie sind hin- und hergerissen, ob die Heldin und ihre alte Freundin wieder zueinander finden sollen oder nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460208
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 402460208,
					"content": "Ah ... Weil es ja darum geht, dass sie in die Heimat ihrer Freundin gekommen ist, um nach ihr zu suchen, oder? Paimon hätte fast die Handlung vergessen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460209,
					"content": "Ja. Regisseurin Furina und Fräulein Chiori finden, dass ein tragisches Ende, bei dem die beiden sich nie begegnen, bewegender wäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460210
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 402460210,
					"content": "Aber Regisseur Xavier findet, dass es ein berührenderes und herzerwärmenderes Ende wäre, wenn die beiden wieder zueinanderfinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460211
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 402460211,
					"content": "Was denkst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460212
					]
				},
				{
					"id": 402460212,
					"content": "Ich? Ich ... Ich bin mir nicht sicher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460213
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 402460213,
					"content": "Persönlich möchte ich sie natürlich wiedersehen ... Natürlich möchte ich diesen Moment erleben, in dem wir wieder vereint sind ... Auch wenn es nur für die Kameras ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460214
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 402460214,
					"content": "Aber das bedeutet ... Ein Schauspieler müsste ihren Platz einnehmen, und dabei fühle ich mich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460215
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 402460215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460216,
					"content": "Mach dir darüber erst mal keine Sorgen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460217
					]
				},
				{
					"id": 402460217,
					"content": "Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460218
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 402460218,
					"content": "Ja! Schau nicht so besorgt! Einen Film zu drehen, soll doch Spaß machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460219,
					"content": "A... Außerdem wird schon alles glattlaufen! Da kannst du Paimon vertrauen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460220,
					"content": "Glattlaufen ... Wie denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460221
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 402460221,
					"content": "Ähm, na ja ... Weißt du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460222,
					"content": "Am Ende fügt sich alles perfekt zusammen. Du wirst schon sehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460223
					]
				},
				{
					"id": 402460223,
					"content": "Jap! Genau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460224,
					"content": "Hehe ... Na gut. Ich vertraue euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460225
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 402460225,
					"content": "Ich werde mich fürs Erste einfach darauf konzentrieren, Spaß zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460226
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 402460226,
					"content": "#Na, wen haben wir denn da! {NICKNAME} und Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460227
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460227,
					"content": "#Oh, {F#die Beleuchtungsspezialistin}{M#der Beleuchtungsspezialist} und die Klappenschlägerin, die es nie gab ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460228
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402460228,
					"content": "Äh, ja ... Wir sind wohl einfach abgehauen ... Tut uns leid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460229,
					"content": "Hehe, im Ernst, macht euch keinen Kopf deswegen. Bei uns läuft alles glatt, also tut einfach, was ihr tun müsst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460230,
						402460231
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402460230,
					"content": "Danke für dein Verständnis ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				},
				{
					"id": 402460232,
					"content": "Du scheinst jetzt wieder besser gelaunt zu sein, Fräulein Columbina. Es tut mir leid, falls dich unser Gespräch vorhin in Verlegenheit gebracht hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460233
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460233,
					"content": "#Schon gut, mir geht es jetzt wieder gut. {NICKNAME} und Paimon haben mit mir darüber geredet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460234
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 402460234,
					"content": "Also, was denkst du über das Ende? Sollen wir sie wieder zusammenbringen oder nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460235
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460235,
					"content": "Wir sollten ... um alles eine hübsche Schleife binden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460236
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 402460236,
					"content": "... Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460231,
					"content": "Wir werden es auf jeden Fall wiedergutmachen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				}
			]
		},
