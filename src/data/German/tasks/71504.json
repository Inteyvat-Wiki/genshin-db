				"points": []
			},
			"dialogs": [
				{
					"id": 715040101,
					"content": "*hust* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040102,
					"content": "Hosseini, was ist los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715040103,
					"content": "Der vorherige Versuch, einen Weg zu finden, den „Pursina-Lichtnagel“ zum Fluss der Elemente zu transportieren, hat zu lange gedauert und ich bin ein wenig von der Umwelt beeinflusst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040104,
					"content": "Aber das ist keine große Sache, nach einer kurzen Pause hatte ich mich wieder erholt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040105,
					"content": "Und währenddessen hatte ich eine Lösung gefunden. Es würde doch wohl einfacher sein, einen Weg zu finden, den „Pursina-Lichtnagel“ zu transportieren, als eine Ausrede zu erfinden, um die Abgabe der Forschungsarbeit zu verzögern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040106,
					"content": "Wenn der Boden mit schwarzem Schlamm bedeckt ist, muss man einfach ein wenig schweben. Man kann einen Heißluftballon benutzen, um sie im Minenstollen zu transportieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040107,
					"content": "Der Heißluftballon ist in der Tat eine gute Lösung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715040108,
					"content": "Obwohl man so das Problem mit dem schwarzen Schlamm bis zu einem gewissen Grad umgehen kann, wird es den Heißluftballon natürlich am Fortkommen hindern, wenn viel schwarzer Schlamm den Weg blockiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040109,
					"content": "Und der schwarze Schlamm lockt immer noch Monster an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040110,
					"content": "Ich fürchte, diese Aufgabe muss ich euch überlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040111,
					"content": "#Keine Sorge, {NICKNAME} und Paimon können alle Monster vertreiben, die sich dem Heißluftballon nähern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040112,
						715040113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715040112,
					"content": "Gut, das liegt dann größtenteils an dir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715040114
					]
				},
				{
					"id": 715040114,
					"content": "Pai... Paimon ist vor allem hier, um dich anzufeuern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715040115,
					"content": "Haha äh *hust*, *hust* ... *hust* *hust* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040116
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040116,
					"content": "Das ist eine ganze Menge Husten für einen kleinen Lacher ... Kumpel Tu und Hao helfen beim Verpacken des „Pursina-Lichtnagels“ und bereiten den Heißluftballon vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040117
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040117,
					"content": "Ich hätte den „Pursina-Lichtnagel“ selbst verpackt, aber allein die Anstrengung, eine Weile aufzustehen, reichte aus, um mir Hustenanfälle zu bereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040118
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040118,
					"content": "Es scheint, dass ich in Zukunft nicht nur akademische Forschung betreiben, sondern auch mehr auf meine körperliche Gesundheit achten sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040119
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040119,
					"content": "Gehe schnell zu ihnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040113,
					"content": "Ich werde dir mein Schwert für eine Weile leihen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715040114
					]
				}
			]
		},
		{
			"id": 7150402,
			"completionStepIds": [
				7150402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
