			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kumpel Tu",
					"Hao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715040201,
					"content": "#He, {NICKNAME}, du kommst zur richtigen Zeit. Wir haben das Ding gerade eingepackt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040202
					],
					"speakerTitle": "Kumpel Tu"
				},
				{
					"id": 715040202,
					"content": "Dieser Kerl aus Sumeru hat dir bereits gesagt, dass du diesen Heißluftballon benutzen sollst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040203
					],
					"speakerTitle": "Kumpel Tu"
				},
				{
					"id": 715040203,
					"content": "Was heißt hier „Kerl aus Sumeru“? Hosseini ist hier, um uns mit diesem schwarzen Schlamm zu helfen, er ist ein großer Gelehrter aus Sumeru. Du respektierst andere einfach nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040204
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 715040204,
					"content": "Was ... Was weißt du schon, diese Art von Anrede ist auch eine Art zu zeigen, dass man jemandem nahesteht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040205
					],
					"speakerTitle": "Kumpel Tu"
				},
				{
					"id": 715040205,
					"content": "Genug, der Heißluftballon ist jetzt einsatzbereit, und die Ausrüstung zur Beseitigung des schwarzen Schlamms steht auch bereit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040206
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 715040206,
					"content": "#{NICKNAME}, wenn du Hilfe vom Minenmeister brauchst ... *hust* *hust* ... Vergiss es, ich glaube, *hust* ich kann auch nicht viel helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040207
					],
					"speakerTitle": "Kumpel Tu"
				},
				{
					"id": 715040207,
					"content": "Gut, dass du das weißt. Und du solltest dich etwas ausruhen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040208
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 715040208,
					"content": "Nun ja, wenn du dich bewegen willst, dann starte einfach den Heißluftballon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kumpel Tu"
				}
			]
		},
