						"position": [
							5045.966,
							521.689,
							4014.979
						],
						"pointId": 6369
					}
				]
			},
			"dialogs": [
				{
					"id": 740410601,
					"content": "Hmm, mal sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410602
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410602,
					"content": "Wenn ich die Daten, die wir gesammelt haben, zusammenführe, sollten wir solide Ergebnisse erhalten ... Und die Wiederaufnahme der hydrologischen Messungen ist nur noch einen Steinwurf entfernt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410603
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410603,
					"content": "Oh, das ist ja fabelhaft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410604,
					"content": "Hä? Ich habe das Gefühl, als würde ein Teil der Daten fehlen ... Bilde ich mir das nur ein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410605
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410605,
					"content": "Warum bist du dir so unsicher! Das sind doch die Daten, aus deinem Zuständigkeitsbereich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410606,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410607
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740410607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410608,
					"content": "...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410609
					]
				},
				{
					"id": 740410609,
					"content": "... Oh, Entschuldigung, falsches Zimmer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410610
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740410610,
					"content": "Der Fatuikommandant ergreift mit einer Behändigkeit, die überhaupt nicht zu seinen körperlichen Proportionen passt, die Flucht ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410611
					]
				},
				{
					"id": 740410611,
					"content": "W... Warte, was war denn das gerade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410612,
						740410613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410612,
					"content": "Echt flink, noch schneller als eine Drachenechse ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				},
				{
					"id": 740410614,
					"content": "Nein, darüber sollten wir uns jetzt nicht den Kopf zerbrechen! Der Kerl ist ein Fatuus! Was hat der hier zu suchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410615,
					"content": "#{NICKNAME}, lass uns schnell aufholen und dann genau nachfragen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410613,
					"content": "Wirklich ein wendiges Bürschchen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				}
			]
		},
		{
			"id": 7404113,
			"completionStepIds": [
				7404113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
