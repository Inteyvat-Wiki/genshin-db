						740411404
					]
				},
				{
					"id": 740411404,
					"content": "Ja, hier sind keine Fatui, also werden wir doch hier auch nicht mehr gebraucht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
