				]
			},
			"dialogs": [
				{
					"id": 740410101,
					"content": "Broglie, wir haben die Daten von den beiden Messstationen, von denen du gesprochen hast, bereits!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410102,
					"content": "Wirklich?! Das ist ja großartig! Dann bitte, zeigt sie mir schnell ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410103,
						740410104
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410103,
					"content": "Hier, bitte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410107
					]
				},
				{
					"id": 740410107,
					"content": "Du übergibst die Papierstreifen, die ihr gesammelt habt, an Broglie ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410108
					]
				},
				{
					"id": 740410108,
					"content": "#Oh ja, richtig, das ist es, das ist es! Der Himmel muss euch zwei {F#Engelinnen}{M#Engel} geradewegs zu mir gesandt haben, damit ihr meinem Elend ein Ende bereitet und ich wieder ein wundervolles und friedlich entspanntes Leben führen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410109
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410109,
					"content": "Mach doch nicht so eine große Sache daraus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410110,
					"content": "Jedenfalls sollte ich keine Zeit verlieren. Ich werde jetzt zum Leiter gehen und den Schlüssel zur Verarbeitungszentrale beantragen. Bitte wartet einen Augenblick auf mich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410111
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410111,
					"content": "Ach, das ist wirklich ... Vergiss nicht, dich zu beeilen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410112,
					"content": "Kurz darauf kommt Broglie aufgeregt zurück ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410113
					]
				},
				{
					"id": 740410113,
					"content": "#{M#Mein Herr}{F#Mein Fräulein}, ich habe den Schlüssel bekommen! Jetzt müssen wir die Daten nur noch in der Verarbeitungszentrale aufbereiten und das hydrologische Messwesen kann wieder seinen regulären Betrieb aufnehmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410114,
						740410115
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410114,
					"content": "Äh ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410116,
					"content": "Angesichts der Situation in der „Fruchtgummi-Station“ und der „Crêpes-Suzette-Station“, könnten diese Herren aus Snezhnaya auch in der Verarbeitungszentrale sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410117
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410117,
					"content": "Deswegen ... bitte ich euch beide, mich zu begleiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410118
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410118,
					"content": "Hm, aber vergiss nicht, uns zu bezahlen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410115,
					"content": "Sollen wir dich dabei auch begleiten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410104,
					"content": "Und unsere Belohnung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410105
					]
				},
				{
					"id": 740410105,
					"content": "Ach das ... Macht euch darüber keine Sorgen, wenn der Abteilungsleiter die Wiederherstellung der Daten bestätigen kann, sollt ihr ausreichend belohnt werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410106
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410106,
					"content": "Hehe, dann ist ja gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
