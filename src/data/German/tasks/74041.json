					},
					{
						"sceneId": 3,
						"position": [
							4930.665,
							495.328,
							3967.136
						],
						"pointId": 4700
					},
					{
						"sceneId": 3,
						"position": [
							4931.681,
							495.167,
							3966.649
						],
						"pointId": 4845
					},
					{
						"sceneId": 3,
						"position": [
							4932.99,
							495.314,
							3968.181
						],
						"pointId": 6370
					}
				]
			},
			"dialogs": [
				{
					"id": 740411301,
					"content": "Haut mich nicht wieder! Ich gebe auf! Ich ergebe mich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411302
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411302,
					"content": "Ihr ... Ihr seid wegen dieser Streifen hier? Die könnt ihr alle haben! Haut mich nur nicht wieder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411303
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411303,
					"content": "Der Fatuikommandant übergibt dir brav sämtliche Forschungsdaten ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740411304
					]
				},
				{
					"id": 740411304,
					"content": "Wie sieht’s aus, Broglie, sind sie vollständig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411305,
					"content": "Äh, das ... Vielleicht? Hm, richtig, das sollte alles sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411306
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411306,
					"content": "Vergiss es, tu einfach so, als hätte Paimon gar nicht gefragt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411307,
					"content": "Was hattet ihr hier vor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411308
					]
				},
				{
					"id": 740411308,
					"content": "Genau, sag die Wahrheit! Wieso habt ihr diese Messstationen besetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411309,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411310
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411310,
					"content": "Um zu ... faulenzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411311
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411311,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411312,
					"content": "Ich bin Malinovskyi, Anführer des 34. Autonomen Spähtrupps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411313
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411313,
					"content": "Als wir zu Beginn nach Fontaine abkommandiert wurden, hatten alle eine tolle Zeit ohne irgendwelche kniffligen Aufträge ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411315
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411315,
					"content": "Äh ... Und was hat das damit zu tun, dass ihr die Messstationen besetzt habt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411316,
					"content": "Vor ein paar Monaten wurde mir aus heiterem Himmel, wegen eines Personalwechsels, aus Snezhnaya ein Kerl namens Shumilov als neuer Adjutant zugeteilt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411317
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411317,
					"content": "Shumilov? Ah, das ist doch dieser Truppführer, den wir an der Crêpes-Suzette-Station gesehen haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411318,
					"content": "Ganz genau! Ich kann den Kerl nicht mehr ausstehen! Aber ich habe auch keine Möglichkeit, ihn loszuwerden. Also musste ich einen Vorwand suchen, um selbst loszuziehen und Aufträge zu erledigen, um von ihm wegzukommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411319
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411319,
					"content": "Warte mal, du bringst Paimon ganz durcheinander ... Dieser Kerl namens Shumilov ist dein Adjutant?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411320,
					"content": "Richtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411321
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411321,
					"content": "Dann ist er doch dein Untergebener, seit wann muss denn ein Vorgesetzter einem Untergebenen gehorchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411322,
					"content": "Dieser widerliche Kerl ist ohne Zweifel mein Untergebener, aber er lässt immer den Diensteifrigen raushängen und lässt alle schuften!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411323
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411323,
					"content": "Und er hat ja auch unbestreitbar recht ... Wie sollte ich ihm denn vor aller Augen eingestehen, dass von uns eigentlich niemand arbeiten will?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411324
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411324,
					"content": "Da entdeckte ich zufällig diese seltsamen Türme in der Nähe und behauptete, dass wir hier seien, um sie zu untersuchen. Und dann habe ich das Schreiben von der Maison Gestion gefälscht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411325
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411325,
					"content": "Pah, also habt ihr es gefälscht! Warum sollte euch, bei Lichte betrachtet, die Maison Gestion auch die Leitung der Messstationen übertragen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411326,
					"content": "Broglie, möchtest du ihn noch etwas fragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411327,
					"content": "Hm ... So ist das, ihr habt unsere Messstationen also besetzt, um faulenzen zu können ... Nein, nur um einen Moment der Ruhe in dieser lärmenden Welt zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411328
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411328,
					"content": "Also? Wie fühlt es sich an, sich hier auszuruhen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411329
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411329,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411330,
					"content": "Äh ... sehr gemütlich? Und der Ausblick in der Nähe ist auch sehr schön. Nach einem Mittagsschläfchen fühlst du dich gleich ganz befreit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411331
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411331,
					"content": "Nicht wahr? Besonders wenn dir nach dem Aufwachen bewusst wird, dass keine dringende Aufgabe auf dich wartet und du nicht von Störenfrieden beobachtet wirst. Du genießt einfach friedlich die Nachmittagssonne und die leichte Brise ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411332
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411332,
					"content": "Es ist, als würde man aus einem Traum aufwachen, nur um in den nächsten einzutauchen, einem Traum, in dem man sich um nichts sorgen muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411333
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411333,
					"content": "Ah, das ist das wahre Leben, mein Herr! Du hast wohl leider noch nicht die limitierte Schwarztee-Edition aus der Vasari-Passage probiert? Solltest du einmal die Möglichkeit bekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411334
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411334,
					"content": "Was soll das, wie könnt ihr plötzlich über solche Belanglosigkeiten plaudern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411335,
					"content": "Also gut, du Tunichtgut kommst jetzt schön mit uns mit! Es ist Zeit, dem Forschungsinstitut Fontaine mitzuteilen, was du getan hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411336,
					"content": "*winsel* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411337
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411337,
					"content": "Bitte wartet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411338
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411338,
					"content": "#Ihr beiden {F#Wohltäterinnen}{M#Wohltäter}! Dieser Herr hat unserer hydrologischen Forschung doch überhaupt nicht geschadet, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411339
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411339,
					"content": "Genaugenommen hat der Herr sogar geholfen, einen Teil der Daten zu sammeln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411340
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411340,
					"content": "Mehr noch ... Er will anstatt zu arbeiten einfach nur ein wundervolles und friedlich entspanntes Leben führen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411341
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411341,
					"content": "J... Ja, genau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411342
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411342,
					"content": "Nein, auch wenn ihr zwei noch so überzeugend redet, das ist überhaupt nichts, worauf man stolz sein kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411343,
					"content": "#Bitte, {M#gutherziger Herr}{F#gutherziges Fräulein}! Ich bitte dich im Namen der Wissenschaft, zeig dich großherzig und lass ihn dieses Mal ziehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411344,
						740411345
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411344,
					"content": "Das hat zwar eher nichts mit Wissenschaft zu tun ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411346
					]
				},
				{
					"id": 740411346,
					"content": "Danke ... Danke euch! Ich schwöre, dass ich so etwas niemals wieder tun werde! Von jetzt an werde ich mein Bestes geben und nur noch aus eigener Kraft faulenzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411347
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411347,
					"content": "So ist es richtig! Diese Entschlossenheit ist das Wichtigste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411348
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411348,
					"content": "He, bei so etwas darf man keinen komischen Kampfgeist entfachen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411349,
					"content": "Der Fatuikommandant verlässt diesen Ort in größter Dankbarkeit ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740411350
					]
				},
				{
					"id": 740411350,
					"content": "Also gut! Jetzt, wo das Problem zu aller Zufriedenheit gelöst ist, sollte ich auch zurückgehen und die Daten aufbereiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411351
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411351,
					"content": "Ich danke euch beiden vielmals! Bitte nehmt dies!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411352
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411352,
					"content": "Ist es wirklich ... zu aller Zufriedenheit gelöst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411353,
					"content": "Ach, vergiss es ... Die Messstation ist wieder in Betrieb, die Fatui sind vertrieben, dann gilt diese Sache wohl als abgeschlossen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411345,
					"content": "Aber wenn der Auftraggeber es so will ...",
					"roleType": "TALK_ROLE_PLAYER",
