			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kobayashi",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130101,
					"content": "Stehen bleiben! Reiseberechtigungen, bitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130102
					],
					"speakerTitle": "Kobayashi"
				},
				{
					"id": 20130102,
					"content": "Entschuldigung, aber wir müssen wirklich zur Insel Narukami, das ist ziemlich dringend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130103,
					"content": "Ohne Reiseberechtigung ist hier für euch Endstation. So sind die Regeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130104
					],
					"speakerTitle": "Kobayashi"
				},
				{
					"id": 20130104,
					"content": "Hm ... wie erwartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130105,
					"content": "#{F#Reisende}{M#Reisender}, du musst dir etwas einfallen lassen. Wie kommen wir aus Ritou raus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130106,
						20130107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130106,
					"content": "Wenn die Yashiro-Verwaltung von uns gehört hat ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130108
					]
				},
				{
					"id": 20130108,
					"content": "Willst du damit sagen ... wir sollten uns mit einem Mitglied der Kanjou-Verwaltung treffen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130109,
					"content": "Schadet doch nichts, es zu versuchen. Auch wenn Paimon einige Dinge über seine Untergebenen zu loszuwerden hätte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130110,
					"content": "Wer weiß? Vielleicht ist er ja unser größter Fan! Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130107,
					"content": "Ich frage mich, ob die Kanjou-Verwaltung von uns gehört hat ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130108
					]
				}
			]
		},
		{
			"id": 201302,
			"completionStepIds": [
				201302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201302",
							"2"
						],
						"stepId": 201302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hiiragi Shinsuke",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130201,
					"content": "Ich bin Hiiragi Shinsuke, Mitglied der Kanjou-Verwaltung und Anführer des Hiiragi-Klans. Es ist mir eine Ehre euch beide kennenzulernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130202,
						20130203
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130202,
					"content": "Auch mir ist es eine Ehre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130204
					]
				},
				{
					"id": 20130204,
					"content": "Freut mich sehr, dich kennenzulernen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130205,
					"content": "Also, der Grund warum wir hier sind, ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130206,
					"content": "Immer mit der Ruhe, alles zu seiner Zeit. Zwei Reisende, die in allen Himmelsrichtungen einen hohen Bekanntheitsgrad haben, sind hier aufgetaucht, um mich zu sehen, und ich würde sie wirklich gerne etwas näher kennenlernen! Beschränken wir das hier doch nicht nur auf geschäftliche Angelegenheiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130207
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130207,
					"content": "Hehe, höre ich da etwa raus, dass wir schon ziemlich sehr berühmt sind, hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130208,
					"content": "Absolut. Wie viele andere Menschen auf der Welt haben das Zeug, Sturmschrecken den Wind aus den Segeln zu nehmen und den Herrscher des Wirbels wieder in die Tiefen des Meeres zurückzuschicken, hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130209
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130209,
					"content": "Genau! Paimon findet, dass du das sehr gut auf den Punkt gebracht hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130210,
					"content": "Und ... Ich hörte, dass du außerdem Machenschaften der Fatui im Hafen von Liyue vereitelt und sogar einen der Elf in einem Duell besiegt hast. Ist das wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130211
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130211,
					"content": "Ooh! Davon hast du auch gehört? Ja, das stimmt alles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130212,
					"content": "Hm ... wie ich dachte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130213
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130213,
					"content": "Stimmt etwas nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130214,
					"content": "Hehe, nein, nein. Ich bin von euch beiden einfach nur schwer beeindruckt, das ist alles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130215,
						20130216
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130215,
					"content": "Das ist zu freundlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130217
					]
				},
				{
					"id": 20130217,
					"content": "Ganz Ritou fühlt sich von eurem Besuch sehr geehrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130218
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130218,
					"content": "Eine andere Sache, die ich über euch gehört habe, ist euer Eifer den Menschen zu helfen. Da frage ich mich ... ob ihr eure Unterstützung vielleicht auch der Kanjou-Verwaltung zukommen lassen würdet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130219
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130219,
					"content": "#Klar, kein Problem! Was immer du brauchst, richtig, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130220,
						20130221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130220,
					"content": "Ist es wieder Zeit für ein paar Erledigungen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130222
					]
				},
				{
					"id": 20130222,
					"content": "Hehehe, hervorragend. Also dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130223
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130223,
					"content": "Du kennst sicher Qingxin? Eine Blume, die auf den Gipfeln der Berge in Liyue wächst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130224
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130224,
					"content": "Japp, wir haben davon schon einmal welche gepflückt. Also, äh ... möchtest du, dass wir nach Liyue zurückkehren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130225,
					"content": "Ja. Pflückt mir 300 frische Qingxin, ja? Ich meine ganz frisch gepflückt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130226
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130226,
					"content": "Äh, hat sich Paimon da verhört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130227,
						20130228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130227,
					"content": "Ich glaube, die Größenordnung hier ist etwas aus den Fugen geraten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130229
					]
				},
				{
					"id": 20130229,
					"content": "Hm? Zu viel Aufwand, oder? Mhm, ich verstehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130230
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130230,
					"content": "Wie wäre es dann damit: Wir haben ein paar Versandartikel, die ausgeliefert werden müssten, vielleicht könnt ihr mir ja damit helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130231
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130231,
					"content": "Das klingt schon besser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130232,
					"content": "709 Briefe, um genau zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130233
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130233,
					"content": "He! Was zum ... Warum hast du nicht schon jemanden, der dafür zuständig ist?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130234,
					"content": "Hehe, es tut mir schrecklich leid, wir leiden momentan etwas unter Personalmangel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130235
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130235,
					"content": "Was ist das denn für eine Erklärung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130236,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130237
					]
				},
				{
					"id": 20130237,
					"content": "#{F#Reisende}{M#Reisender}, was sollen wir tun? Helfen wir diesem Typen wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130238,
						20130239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130238,
					"content": "Ich ziehe es in Erwägung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130240
					]
				},
				{
					"id": 20130240,
					"content": "Das ist die richtige Einstellung! Lasst mich jetzt nicht zu lange warten, hehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130239,
					"content": "Ich muss erst mehr darüber in Erfahrung bringen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130240
					]
				},
				{
					"id": 20130228,
					"content": "Sie bleiben nicht frisch, nachdem man sie abgepflückt hat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130229
					]
				},
				{
					"id": 20130221,
					"content": "Das ist meine Stärke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130222
					]
				},
				{
					"id": 20130216,
					"content": "Am Ende haben sie aber doch ihren Willen bekommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130217
					]
				},
				{
					"id": 20130203,
					"content": "Hallöchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130204
					]
				}
			]
		},
		{
			"id": 201304,
