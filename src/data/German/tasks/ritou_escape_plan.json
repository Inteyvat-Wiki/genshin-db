			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shinnojou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130401,
					"content": "Anhalten, ihr beiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130402,
						20130403
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130402,
					"content": "Genau wie ich erwartet habe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130404
					]
				},
				{
					"id": 20130404,
					"content": "Hm? Was haben wir gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130405,
					"content": "Ein Brief von Fräulein Hiiragi für euch. Sie besteht darauf, dass ihr ihn sofort lest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130406
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130406,
					"content": "Ein Brief? Schnell, lass Paimon mal sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130407,
					"content": "Lieber Reisender, ich wünschte, ich könnte dir diese Nachricht persönlich überbringen. Ich entschuldige mich für die Eile, mit der dieser Brief zu dir gekommen ist, und hoffe, dass er dich nicht in irgendeiner Weise verwirrt oder beunruhigt hat. Es ist schließlich das erste Mal, dass ich einem unbekannten Fremden eine Einladung ausspreche. Es ist kein reiner Zufall, dass sich unsere Wege gekreuzt haben. Daher hoffe ich, dass du so höflich bist, mich heute Abend unter dem Schleier des strahlenden Mondlichts zu treffen. Bitte sorge dich nicht um Gefolgsleute und Leibwächter, ich sorge dafür, dass deren Aufmerksamkeit woanders sein wird. Ich freue mich auf deine Gesellschaft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130408,
					"content": "Also, das bedeutet ... sie möchte dich bei Nacht im Geheimen treffen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130409,
					"content": "Du scheinst von all dem überhaupt nicht überrascht ... Was geht hier vor sich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130410,
						20130412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130410,
					"content": "Wir haben Blicke ausgetauscht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130411
					]
				},
				{
					"id": 20130411,
					"content": "Hm? Hast du hinter Paimons Rücken etwa etwas ausgeheckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130414,
					"content": "Hm ... befragen wir sie heute Nacht und sehen, was sie zu sagen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130412,
					"content": "Shinsuke hat nicht die Absicht uns gehen zu lassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130413
					]
				},
				{
					"id": 20130413,
					"content": "Paimon wusste, dass mit ihm etwas nicht stimmt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130403,
					"content": "Das habe ich kommen sehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130404
					]
				}
			]
		},
		{
			"id": 201307,
			"completionStepIds": [
				201307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201307",
							"2"
						],
						"stepId": 201307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hiiragi Chisato",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130701,
					"content": "Ah, ihr seid endlich hier ... Erlaubt mir, mich vorzustellen, ich bin Hiiragi Chisato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130702
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130702,
					"content": "Dies ist ... im Prinzip unser zweites Treffen. Es freut mich sehr euch wiederzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130703
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130703,
					"content": "Ooh, sie ist echt die Tochter des Hiiragi-Klans ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130704,
						20130705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130704,
					"content": "Die Freude ist ganz meinerseits.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130706
					]
				},
				{
					"id": 20130706,
					"content": "Kein Grund so formell zu sein. Ich habe eure Heldentaten schon lange bewundert ... und endlich haben wir nun die Gelegenheit uns zu treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130707
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130707,
					"content": "Liegt es nur an Paimon oder stimmt hier irgendetwas nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130708,
					"content": "Der Grund, warum ich dich hier insgeheim treffen wollte ist ... Na ja, ich hatte Angst, dass ich niemals eine andere Gelegenheit haben würde, dies mit dir zu diskutieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130709
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130709,
					"content": "Was genau diskutieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130710,
					"content": "Ähem ... Ich würde gerne um eure Hilfe bitten ... bei der Auslieferung eines Briefes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130711,
						20130712
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130711,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130713
					]
				},
				{
					"id": 20130713,
					"content": "Urgh, wie der Vater so die Tochter! Ist Euch nichts Originelleres eingefallen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130714,
					"content": "Nein! Du missverstehst mich! Bitte ... erlaube mir, mich zu erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130715
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130715,
					"content": "Ich hoffte, du könntest an meiner statt einen Brief zur Insel Narukami liefern. Er muss an Kujou Kamaji von der Tenryou-Verwaltung übergeben werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130716
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130716,
					"content": "Mein Vater hatte mir immer verboten mit Kujou Kamaji zu kommunizieren. Es gibt aus politischer Sicht nützlichere Hochzeitskandidaten für mich, das weiß er. Aber ich habe mein Herz an Kamaji verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130717
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130717,
					"content": "In Ritou gibt es niemanden, der es wagen würde sich dem Willen meines Vaters zu widersetzen, doch ihr seid Fremde ... Fremde, die zur Insel Narukami gelangen möchten. Es wäre doch schade, sich eine solche Gelegenheit entgehen zu lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130718
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130718,
					"content": "Ah, jetzt ergibt das ganze einen Sinn für Paimon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130719,
					"content": "Selbstverständlich werde ich so alles in meiner Macht stehende tun, um euch dabei zu helfen, Ritou zu verlassen. Das verspreche ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130720,
						20130721
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130720,
					"content": "Hm, klingt nach einem vernünftigen Handel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130722
					]
				},
				{
					"id": 20130722,
					"content": "Um ganz ehrlich zu sein ... solange ihr in Inazuma verbleibt, wird mein Vater keinen Anlass sehen, euch die Möglichkeit zu geben, Ritou zu verlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130723
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130723,
					"content": "Ja, das haben wir uns schon gedacht. Es war ziemlich offensichtlich, dass er versucht hat uns hier zu behalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130724,
					"content": "Ich habe vor nur ein paar Tagen heimlich ein Gespräch zwischen meinem Vater und einer sehr arrogant klingenden Frau mitangehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130725
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130725,
					"content": "Sie schienen zu diskutieren, wie sie dich hier auf Ritou halten könnten. Tatsächlich habe ich meinen Vater zum ersten Mal in einem so respektvollen Ton mit jemandem sprechen hören, der nicht Shougun war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130726,
						20130727
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130726,
					"content": "Eine arrogant klingende Frau ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130728
					]
				},
				{
					"id": 20130728,
					"content": "Wir haben nicht viel Zeit. Ich offenbare euch meine Pläne, um euch von der Insel zu helfen. Praktischerweise ist eine Warenlieferung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130729
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130729,
					"content": "#(Hiiragi Chisato erzählt {F#der Reisenden}{M#dem Reisenden} von ihren Plänen.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130730
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130730,
					"content": "Sehr gut, ich erwarte euch an der Grenze. Ich zähle auf euch bei der Auslieferung meines Briefes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130727,
					"content": "Sieht so aus, als müssten wir so schnell wie möglich von Ritou weg.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130728
					]
				},
				{
					"id": 20130721,
					"content": "Sieht so aus als hätten wir keine andere Möglichkeit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130722
					]
				},
				{
					"id": 20130712,
					"content": "Ich gehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130713
					]
				},
				{
					"id": 20130705,
					"content": "Es freut mich sehr, Euch wiederzusehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130706
					]
				}
			]
		},
		{
			"id": 201308,
			"completionStepIds": [
				201308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201308",
							"2"
						],
						"stepId": 201308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hiiragi Chisato",
					"Shinnojou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130801,
					"content": "Einen Moment ... Diese Waren werden geliefert zur ... Insel Watatsumi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130802
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130802,
					"content": "Meine Dame! Dies ist eine unerwartete Ehre. Das stimmt, diese Waren wurden von dem Mitglied der Kanjou-Verwaltung wiederholt angefragt. Wir müssen sicherstellen, dass sie die Insel Watatsumi unbeschadet erreichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130803
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130803,
					"content": "Stimmt etwas nicht, Fräulein Hiiragi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130804
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130804,
					"content": "Nein. Mein Vater hatte lediglich einige Bedenken bezüglich der Sicherheit der Ladung und hat angeordnet, dass ich und eine zusätzliche qualifizierte Eskorte entsandt werden, um den sicheren Transport der Waren zu gewährleisten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130805
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130805,
					"content": "Meine Dame, du sagst doch nicht etwa, dass du gedenkst, die Warenlieferung persönlich zu eskortieren, oder? Es besteht sicherlich kein Anlass für dich, sich mit so etwas zu belasten. Und was diese „qualifizierte Eskorte“ angeht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130806,
						20130807
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130806,
					"content": "Ich freue mich auf eine gute Zusammenarbeit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130808
					]
				},
				{
					"id": 20130808,
					"content": "Bitte, bereite uns keine weiteren Verzögerungen. Wenn ich mich recht erinnere, hat mein Vater bereits deutlich gemacht, dass diese Lieferung pünktlich ankommen muss. Ich bin mir sicher, dass die Strafe für ein Versagen in dieser Sache sehr unangenehm ausfallen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130809
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130809,
					"content": "Ja, natürlich, meine Dame. Es ist nur ... Na ja, wir wissen nicht einmal, wer diese Person ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130810
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130810,
					"content": "Darf ich dich an die Strafe erinnern, die auf dich zukommt, wenn mir unterwegs irgendetwas zustoßen würde? Ich denke ihr kennt das Temperament meines Vaters alle nur zu gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130811
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130811,
					"content": "Meinst du wirklich, dass du ganz alleine meine Sicherheit garantieren könntest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130812
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130812,
					"content": "Junge, Chisato weiß wirklich mit Worten umzugehen, sie haben keine Chance ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130813,
					"content": "Ah, ja, meine Dame. In Ordnung ... Es ist mir eine Ehre, dich als unsere Begleitung an Bord begrüßen zu dürfen. Deine Sicherheit ist unsere oberste Priorität.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130814
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130814,
					"content": "Shinnojou! Dem kannst du doch nicht wirklich zustimmen?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130815
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130815,
					"content": "Nun ja, die Forderung kommt von Fräulein Hiiragi höchstpersönlich. Es ist unsere Pflicht, ihren Wünschen nach allem, was uns möglich ist, zu entsprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130816
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130816,
					"content": "Ja, aber ... das ist hier nicht das Problem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130817
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130817,
					"content": "Nun denn, wenn wir hier fertig sind, würde ich vorschlagen, dass wir sogleich ablegen. Herumbummeln gibt potenziellen Dieben nur mehr Zeit sich vorzubereiten, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130818
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130818,
					"content": "Ja, meine Dame. Ihr habt sie gehört, wir haben keine Zeit zu verlieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130807,
					"content": "Du wagst es, meine Fähigkeiten anzuzweifeln?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130808
					]
				}
			]
		},
		{
			"id": 201310,
			"completionStepIds": [
				201310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201310",
							"2"
						],
						"stepId": 201310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hiiragi Chisato"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20131001,
					"content": "Puh, wir können in dem vorausliegenden Dorf Zuflucht finden. Wie geht es dir, mein Fräulein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131002
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131002,
					"content": "Mir geht es bestens. Du kannst hier anhalten. Der Weg zur Insel Narukami ist direkt dort drüben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131003
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131003,
					"content": "In meinem Brief habe ich Kamaji darum gebeten, dir eine besondere Reiseerlaubnis der Tenryou-Verwaltung auszustellen. Betrachte das als Zeichen meiner Wertschätzung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131004,
						20131005
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131004,
					"content": "Vielen Dank, Chisato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20131006
					]
				},
				{
					"id": 20131006,
					"content": "Fräulein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131007
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131007,
					"content": "Hm? So ist das also. Ich wusste, dass etwas nicht stimmt, aber Shinnojou, du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131008
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131008,
					"content": "Nein, Fräulein Hiiragi würde niemals schlechte Absichten haben, da bin ich sicher. Aber wer ist dieser „Kamaji“ von dem du gesprochen hast, mein Fräulein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131009
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131009,
					"content": "Ich scheue mich nicht es auszusprechen ... er ist derjenige, den ich liebe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131010
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131010,
					"content": "Den du ... liebst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131011
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131011,
					"content": "Shinnojou, hast du ernsthaft gedacht, dass ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131012
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131012,
					"content": "Was?! Nein, ich, äh ... ähem! Ich wollte das nur klarstellen, das ist alles. Ich würde mir in meinen wildesten Träumen niemals, äh ... ähem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131013
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131013,
					"content": "Ihr beide braucht euch keine Sorgen zu machen. Bitte vergesst, dass dies hier überhaupt geschehen ist. Wenn mein Vater davon auch nur ein Wort zu Ohren kommt, werde alleine ich dafür die Verantwortung übernehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131014
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131014,
					"content": "Ja, natürlich. Wie du wünschst, mein Fräulein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131015
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131015,
					"content": "Doch was wird geschehen, wenn deine Taten hier aufgedeckt würden, Chisato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131016,
					"content": "Keine Sorge, mein Vater hat mich schon immer verhätschelt. Das Schlimmste, was passieren könnte ist, dass er mich zu einem halben Tag ohne Essen verdonnert, oder irgendetwas anderes in der Größenordnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131017
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131017,
					"content": "Hm, Paimon hätte nie gedacht, dass ein Typ wie er so eine weiche Seite haben könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131018,
					"content": "Ich wünsche dir eine sichere Reise. Ich bin mir sicher, dass wir uns wieder treffen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131019
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131019,
					"content": "Auf Wiedersehen, Chisato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131020,
					"content": "He, komm schon! Hör auf da so hinzustarren und beweg dich. Hier müssen Waren verladen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131021
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131021,
					"content": "*wimmer* Na gut ... *seufz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131005,
					"content": "Sei bitte vorsichtig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20131006
					]
				}
			]
		},
