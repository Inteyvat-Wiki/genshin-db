			},
			"dialogs": [
				{
					"id": 20131101,
					"content": "Stopp! Dies ist das Büro des Kanjou-Verwalters. Durchgang verboten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131102
					],
					"speakerTitle": "Yokoyama"
				},
				{
					"id": 20131102,
					"content": "Wir sind hier, um ... äh ... den Kanjou-Verwalter zu sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131103,
					"content": "Der Kanjou-Verwalter empfängt selten Fremde. Geht jetzt oder wir sehen uns gezwungen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131104
					],
					"speakerTitle": "Yokoyama"
				},
				{
					"id": 20131104,
					"content": "Ah ... Wartet, wartet, wartet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131105
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20131105,
					"content": "Oh! Verwalter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131106
					],
					"speakerTitle": "Yokoyama"
				},
				{
					"id": 20131106,
					"content": "Diese beiden sind geehrte Gäste von weit her, kein Grund sie mit dem üblichen Ablauf zu belästigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131107
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20131107,
					"content": "Kommt herein, schauen wir, was ich für euch tun kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131108
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20131108,
					"content": "Hmpf! Hast du das alles verstanden?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131109,
					"content": "Es tut mir wirklich sehr leid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yokoyama"
				}
			]
		},
