			"dialogs": [
				{
					"id": 752470101,
					"content": "Das dürfte der Ort vom Bild sein. Schau, Ororon und Ifa sind da!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470102,
					"content": "Hallo zusammen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470103,
					"content": "Paimon klingt jedenfalls glücklich. Gut! Dann brauchen wir nicht so sehr auf der Hut zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470104
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470104,
					"content": "Komm schon, selbst wütend ist Paimon vollkommen harmlos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470105
					]
				},
				{
					"id": 752470105,
					"content": "#*schnauf*! Schön vorsichtig, {M#Freundchen}{F#Fräulein}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470106,
					"content": "Alles, was es braucht, ist, ihr einfach nur etwas Leckeres zu kaufen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470107
					]
				},
				{
					"id": 752470107,
					"content": "He! Paimon ist doch nicht Cacucu! Du kannst ihr nicht einfach ’nen Keks geben und gut ist’s ... Na gut, vielleicht ja doch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470108,
					"content": "Aber weißt du was? Ach, egal! Paimon hat heute gute Laune, und die wirst du ihr nicht verderben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470109,
					"content": "Aber wo wir gerade davon sprechen, Cacucu ... Wo ist er denn? Sag Paimon nicht, dass der König Wasserschwein ihn verspeist hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470110,
					"content": "Was? Hörst du dich eigentlich selbst reden, Bruder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470111
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470111,
					"content": "Cacucu hat sich mit dem Feind zusammengetan, um uns das Leben schwer zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470112
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470112,
					"content": "Das Leben schwer machen? Cacucu? Hahaha, der war gut, Ororon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470113,
					"content": "Das war kein Witz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470114
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470114,
					"content": "Hmm ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470115,
					"content": "Und wer ist dieser sogenannte Feind ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470116
					]
				},
				{
					"id": 752470116,
					"content": "Er meinte, sein Name sei „Cacasha“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470117
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470117,
					"content": "Warte, heißt das, er ist ein Asha? Ein Asha, der sprechen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470118,
					"content": "Woah, Moment mal. Ororon ... du übertreibst. Lasst es mich erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470119
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470119,
					"content": "Cacucu ... also, er spielt hier mit einem Asha Verstecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470120
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470120,
					"content": "Und das heißt, dass sie sich gegen uns zusammengetan haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470121
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470121,
					"content": "Cacucu ist schnell, und Cacasha kann sich tarnen ... Wir haben es also in der Tat mit einem gewieften Feind zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470122
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470122,
					"content": "Wir haben Runde um Runde mit den kleinen Taugenichtsen gespielt, bevor ihr aufgetaucht seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470123
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470123,
					"content": "Und hört mal, Cacucu ist in diesem Spiel eine Bestie. Ob ich stolz auf ihn bin? Ja, schon. Aber Mann, ich bin ganz schön erschöpft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470124
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470124,
					"content": "Deine eigene Schuld, wenn du nicht zum Fitnesskurs von Iansan gehst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470125
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470125,
					"content": "*seufz* Ehrlich, ich hab rund um die Uhr nach diesen kleinen Kerlchen gesucht, Runde um Runde ... Mein Rücken bringt mich um!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470126
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470126,
					"content": "Kein Wunder. Du warst ja auch nicht im Fitnesskurs von Trainerin Iansan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470127
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470127,
					"content": "... Schon gut, schon gut. Ich hab’s ja verstanden! Ich werde gehen, wenn wir zurück sind. Zufrieden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470128
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470128,
					"content": "He, solltest du jetzt nicht ein bisschen mehr suchen? Wer soll denn Cacucu und Cacasha aufspüren, wenn ihr euch weiter so in den Haaren habt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470129,
					"content": "Nun, das bringt uns zu der perfekten Zitrone, die uns gerade in den Schoß gefallen ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470130
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470130,
					"content": "Ich ... schon wieder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470131
					]
				},
				{
					"id": 752470131,
					"content": "Mhm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470132
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470132,
					"content": "In Ordnung, ich gehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470133
					]
				},
				{
					"id": 752470133,
					"content": "#Du machst das schon, {M#Opa}{F#andere Oma}! Und Oma Paimon natürlich auch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470134
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470134,
					"content": "Habt einfach Spaß und ruft uns, wenn ihr Hilfe braucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470135
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470135,
					"content": "Moment, ich dachte, wir würden auch Asha sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470136
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470136,
					"content": "Oh nein ... Sag Paimon bitte nicht, dass ihr euch auch verstecken werdet wie sie und wir euch auch finden müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470137,
					"content": "Ja, das stimmt! Von nun an bin ich „Orasha“, und er ist „Ifasha“. Ich muss mich verstecken. Viel Glück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470138
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470138,
					"content": "Bruder! Was zum ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470139
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470139,
					"content": "Tut mir leid. Was dagegen, ihn ein wenig bei Laune zu halten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470140,
						752470141
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470140,
					"content": "Kein bisschen. Das wird lustig!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470142
					]
				},
				{
					"id": 752470142,
					"content": "Danke, ihr beiden! Das bedeutet dann wohl, dass ich mich auch verstecken muss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470141,
					"content": "Keine Sorge! Ich habe genug Energie, das wird für alle reichen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470142
					]
				}
			]
		},
