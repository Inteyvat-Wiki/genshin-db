						],
						"stepId": 7524704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ifa",
					"Challwa"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							412.321,
