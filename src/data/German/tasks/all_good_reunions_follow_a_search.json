						],
						"pointId": 11895
					}
				]
			},
			"dialogs": [
				{
					"id": 752470401,
					"content": "Gefunden! Wir hatten recht mit dem Leichtbrise-Markt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470402
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470402,
					"content": "Leichtbrise-Markt!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470403
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470403,
					"content": "Immer mit der Ruhe, Bruder. Ich weiß, das ist aufregend, aber wir müssen uns erst einen Überblick verschaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470404
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470404,
					"content": "*räusper* ... Tretet näher, liebe Gäste! Wählt ein Ei, irgendein Ei! Lasst dies euer Glückstag sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470405
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470405,
					"content": "Der erste Versuch ist kostenlos! Also, was sagt ihr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470406
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470406,
					"content": "Oh, das ist also die Stelle, zu der uns das Bild geführt hat. Hier müssen die bunten Geschenk-Eier herkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470407,
					"content": "Na ja, hehe ... Mal schauen, wie weit uns diese Glückssträhne bringen wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470408,
					"content": "Hereinspaziert! Die Geschenk-Eier sind bereit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470409
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470409,
					"content": "Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470410
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470410,
					"content": "Du zuerst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470411
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470411,
					"content": "Echt jetzt, Bruder? Sag mir nicht, du glaubst wirklich an die ganze „Pech hat, wer als Erster geht“-Sache? ... Gut, gut. Wir machen es, wie du willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470412
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470412,
					"content": "Bei dem Glück der Asha, lass es etwas Gutes sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470413
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470413,
					"content": "Woah, Saurierkekse! Treffer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470414,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470415
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470415,
					"content": "Pff ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470416
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470416,
					"content": "Magst du keine Saurierkekse, Ifa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470417,
					"content": "Oh, versteh mich nicht falsch, wir beide lieben sie. Aber wenn es um bunte Geschenk-Eier geht, sind sie nicht gerade einer der besseren Preise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470418
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470418,
					"content": "Egal, alles, was gut schmeckt, ist für mich in Ordnung. Hier geht keiner leer aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470419
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470419,
					"content": "Mach dich nur lustig über mich, Bruder. Warte nur, bis du eines dieser seltsamen Magma-Eier kriegst. Mal sehen, ob ich dir dann helfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470420
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470420,
					"content": "Unmöglich. Niemals würdest du jemandem deine Hilfe ausschlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470421
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470421,
					"content": "Also ... Gibt es ein irgendein spezielles Ritual, das ich durchführen sollte, bevor ich das Ei öffne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470422
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470422,
					"content": "Wovon auch immer du glaubst, dass es dir Glück bringt, denke ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470423
					]
				},
				{
					"id": 752470423,
					"content": "Verstanden. „Patrouille des Blumenfeder-Klans! Aufmachen!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470424
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470424,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470425
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470425,
					"content": "Waah, das ist die Spezialität des Blumenfeder-Klans: „Die Bude bebt“ ... Sieht so aus, als hätte dieses Ritual tatsächlich funktioniert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470426,
					"content": "Toll! Ich nehme alles außer der „Faszinierenden Suppe“. Ganz ehrlich, Ich kann dieses Zeug nicht mehr sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470427
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470427,
					"content": "Ich schätze, ich habe Glück gehabt mit diesem riesigen Eimer voller Süßigkeiten! Haut rein, Leute!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470428
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470428,
					"content": "Du bist der Beste, Brudi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470429,
						752470431
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470429,
					"content": "Nachdem er sich über die Saurierkekse hergemacht hat, knabbert Cacucu die Süßigkeiten weg.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752470430
					]
				},
				{
					"id": 752470430,
					"content": "Durch den ganzen Zucker verfallen alle in eine Art kleinen Rausch ...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752470431,
					"content": "Paimon ist dran, Paimon ist dran! Hmm, was soll Paimon als Glücksbringer sagen ... Ah, genau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470432,
					"content": "Ähem ... „Lass es den großen sein! Komm schon, großer, großer Leckerbissen!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470433,
					"content": "Hehe ... Oh! Es ist die Suppe, die Ororon nicht wollte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470434,
					"content": "Super, Paimon! Dann ist das alles für dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470435
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470435,
					"content": "Hm, stimmt. Umso mehr für Paimon! Hehe, Zeit, reinzuhauen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470436,
					"content": "Ah, so süß und erfrischend! Perfekt für diese Jahreszeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470437,
					"content": "Na gut, dann bleibt nur noch ihr zwei ... Wer will als Nächstes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470438
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470438,
					"content": "Immer mit der Ruhe, Brudi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470439,
						752470440
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470439,
					"content": "Dann mach ich mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470441
					]
				},
				{
					"id": 752470441,
					"content": "#Dann los, {NICKNAME}! Oh, und vergiss nicht, dir irgendetwas Glückbringendes einfallen zu lassen, was du sagen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470442,
					"content": "(Etwas Glückbringendes, hm ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470443
					]
				},
				{
					"id": 752470443,
					"content": "(Tief einatmen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470444
					]
				},
				{
					"id": 752470444,
					"content": "„Auf geht’s, Bennys Abenteurertruppe!“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470445
					]
				},
				{
					"id": 752470445,
					"content": "„Funkelnde Edelsteine“ ... Juhu! Wieder was Süßes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470446,
					"content": "Hehe, das erinnert mich an die Zeit, als ich meinen Schützling aufgenommen habe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470447
					]
				},
				{
					"id": 752470447,
					"content": "#Sieht so aus, als würde {M#Opa}{F#die andere Oma} in schönen Erinnerungen schwelgen. Das Glück war {M#ihm}{F#ihr} wohl hold ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470448
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470448,
					"content": "Also gut, Cacucu, jetzt bist du dran. Dann zeig mal, was du drauf hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470449
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470449,
					"content": "Hol dir den Sieg, Bruder! Oder ... mach es wenigstens besser als Ifa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470450
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470450,
					"content": "Ja, ja, was auch immer du sagst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470451
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470451,
					"content": "Los geht’s, Brudi! „Freut mich, Brudi!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470452
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470452,
					"content": "Woah ... Was ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470453
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470453,
					"content": "Treffer! Treffer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470454
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470454,
					"content": "Na, sieh sich das einer an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470455
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470455,
					"content": "*räusper* Uuuuund wir haben einen Gewinner! Herzlichen Glückwunsch an Herrn Cacucu, der als dritter Gast des Tages unseren Hauptpreis gewonnen hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470456
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470456,
					"content": "Zusätzlich zu diesen „Mini-Asha-Brötchen“, unserem exklusivsten Preis, freuen wir uns, Herrn Cacucu auch noch mit einer Portion jedes Gerichtes aus unseren Eiern zu beschenken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470457
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470457,
					"content": "Nicht dein Ernst, Brudi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470458
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470458,
					"content": "Ja, im Ernst, Bruder!? Wer hätte gedacht, dass Cacucu der Glückliche sein würde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470459
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470459,
					"content": "Haha. Glückwunsch, Bruder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470460
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470460,
					"content": "Cacucu, mein guter Bruder ... Ah, nein, werter Herr, ich hätte da eine bescheidene Bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470461
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470461,
					"content": "Es heißt doch, dass man das Glück durch Händeschütteln weitergeben kann. Würde es dir etwas ausmachen, wenn ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470462
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470462,
					"content": "Haha! Na klar, Brudi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470463,
						752470466
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470463,
					"content": "Ororons Beispiel folgend, schütteln alle Cacucu die Flügel.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752470464
					]
				},
				{
					"id": 752470464,
					"content": "Es ist regelrecht ansteckend und bald schon streicheln alle auch seinen Kopf.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752470465
					]
				},
				{
					"id": 752470465,
					"content": "So absolut kugelrund und weich. Du wünschst dir fast, dass der Moment niemals endet.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752470466,
					"content": "Hehe, das sollte reichen, damit Paimon Glück für den Rest des Jahres hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470467
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470467,
					"content": "#Na, aber hallo, Paimon. Denn du hast ja auch eine{M#n} ganz besondere{M#n} Begleiter{F#in} in deinem Leben. Genau wie Cacucu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470468
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470468,
					"content": "W... Warum guckst du mich so an ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470469
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470469,
					"content": "Das war doch die ganze Zeit dein Plan, oder nicht? Zeit, reinen Tisch zu machen, meinst du nicht auch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470470
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470470,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470471
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470471,
					"content": "Hä? Was meinst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470472,
						752470473
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470472,
					"content": "Warte, heißt das, dass Cacucus Glück ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470474
					]
				},
				{
					"id": 752470474,
					"content": "Schon gut, schon gut. Es ist keine große Sache, oder? Natürlich hat der kleine Kerl Glück, einen Bruder wie mich zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470475
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470475,
					"content": "Red nicht um den heißen Brei, komm schon, raus damit. Du hast das doch alles eingefädelt, nicht wahr? Das Angeln, das Versteckspiel, alles ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470476
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470476,
					"content": "Nun, also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470477
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470477,
					"content": "Du kanntest diesen Abenteurer aus Mondstadt also bereits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470478
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470478,
					"content": "Nein, nicht wirklich. Ich habe ihn nur einen Tag vor euch getroffen und ihn gebeten, mir die richtige Richtung zu zeigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470479
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470479,
					"content": "Und ja, ich habe alles mit den Bildern organisiert, sodass Cacucu mit dem Asha und dem Wasserschwein spielen konnte. Und ich war es auch, der die Eier vorbereitet hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470480
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470480,
					"content": "Oh woah, Brudi ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470481
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470481,
					"content": "Haha ... Aber König Wasserschwein hat das irgendwie falsch verstanden. Schließlich versteht ein wildes Tier nicht alles, was man ihm sagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470482
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470482,
					"content": "Ich vermute, er dachte, wir würden versuchen, die Dinge zu stehlen, die ich für Cacucu vorbereitet hatte. Deshalb war er wohl so wütend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470483
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470483,
					"content": "Oh, er heißt also tatsächlich „König Wasserschwein“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470484
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470484,
					"content": "Nein, natürlich nicht. Ich dachte mir einfach nur, ich benutze den Namen, den du ihm gegeben hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470485
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470485,
					"content": "Oh woah, Bruder, das rührt mich aber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470486
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470486,
					"content": "... Jetzt wisst ihr es also! Es war zufällig um den Jahrestag herum, an dem ich Cacucu kennenlernte, und ich wollte ihm etwas Besonderes bieten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470487
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470487,
					"content": "Wir haben keinen Schimmer, wann Cacucu eigentlich Geburtstag hat, also haben wir den Jahrestag immer nur als Vorwand genommen, um ihn zu feiern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470488
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470488,
					"content": "Cacucu verhält sich vielleicht wie ein reifer, großer Bruder unter den Sauriern. Aber tief in seinem Inneren ist er nur ein kleines Kerlchen, das für sein Leben gerne spielt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470489
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470489,
					"content": "Ich weiß doch, dass du innen und außen noch ein kleiner Kerl bist, Bruder. Also, hab so viel Spaß, wie du willst, in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470490
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470490,
					"content": "Brudi, Brudi ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470491
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470491,
					"content": "Oh, hast du noch etwas hinzuzufügen, Cacucu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470492
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470492,
					"content": "Brudi, es ist nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470493
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470493,
					"content": "Du brauchst nichts zu sagen. Ich hab schon verstanden. Wir lieben dich auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470494
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470494,
					"content": "Ganz genau, es muss dir nicht peinlich sein, Bruder. Während wir hier in der Urlaubsanlage sind, bist du so frei wie ein wilder Qucusaurier. Alles, was du tun musst, ist Spaß zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470495
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470495,
					"content": "Alles Gute zum Jahrestag, Cacucu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470496
					]
				},
				{
					"id": 752470496,
					"content": "Brudi! Brudi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470473,
					"content": "Alles nur wegen dir ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470474
					]
				},
				{
					"id": 752470440,
					"content": "Das Beste kommt zum Schluss.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470441
					]
				}
			]
		},
		{
			"id": 7524750,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7524704",
							"3"
						],
						"stepId": 7524704,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ifa",
					"Ororon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752475001,
					"content": "Und, gefällt es dir, Bruder? Hattest du Spaß?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475002
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752475002,
					"content": "Oh woah, Brudi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475003
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475003,
					"content": "Das heißt dann wohl ja. Alles Gute zum Geburtstag, Bruder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475004
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475004,
					"content": "Oh, das erinnert mich an etwas. Warum hast du mir nichts von deinem Plan erzählt, Bruder? Ernsthaft, Bruder, Brüder haben keine Geheimnisse voreinander, Bruder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475005
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475005,
					"content": "Haha ... Um ehrlich zu sein, ich wollte sehen, ob du dich an den Jahrestag erinnerst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475006
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752475006,
					"content": "... Du hast dich verändert, Ifa. Wie soll ich dir vertrauen, wenn du einen Bruder so hintergehst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475007
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475007,
					"content": "Nun, der Spaß ging auf deine Kosten, denn ich habe mich erinnert und etwas frischen Honig für Cacucu aufgehoben. Ich kenne den Preis, den man zahlt, wenn man einen Jahrestag vergisst, und ich wollte nicht ein ganzes Jahr lang auf den Kopf gepickt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475008
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475008,
					"content": "Niemals, Brudi! Du bist der Beste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				}
			]
		},
		{
			"id": 7524751,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7524704",
							"3"
						],
						"stepId": 7524704,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cacucu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752475101,
					"content": "So sehen wir uns wieder, Brudi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475102
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475102,
					"content": "Was ich vorhin versucht hatte, Ifa zu sagen, ist, dass er sich im Datum vertan hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475103
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475103,
					"content": "Aber ich habe mich zurückgehalten. Ich schätze, es gehört zum Erwachsensein dazu, zu wissen, wann es besser ist, etwas einfach sein zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				}
			]
		}
	]
}