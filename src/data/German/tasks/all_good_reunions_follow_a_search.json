			"dialogs": [
				{
					"id": 752470301,
					"content": "*seufz* ... Wir haben es geschafft, endlich! Das war echt anstrengend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470302,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470303
					],
					"speakerTitle": "„Cacasha“"
				},
				{
					"id": 752470303,
					"content": "Oh, du musst Cacasha sein! Du und Cacucu seid ein echt beeindruckendes Duo! Und da Paimon selbst Teil eines beeindruckenden Duos ist, wird Paimon es wohl wissen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470304,
					"content": "Beeindruckend, Brudi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470305
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470305,
					"content": "Siehst du, was ich meine? Wenn sich diese beiden zusammentun, ist es fast unmöglich, sie zu schlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470306
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470306,
					"content": "Cacucu, ich kann offiziell sagen, dass du dir dein Zertifikat in der „Kunst des Versteckens“ verdient hast. Von nun an kannst du dich einen Meister der Täuschung nennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470307
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470307,
					"content": "Oh, woah! Du bist der Beste, Brudi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470308
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470308,
					"content": "He, was ist mit mir? Ich war derjenige, der am meisten mit dir gespielt hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470309
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470309,
					"content": "Du bist auch der Beste, Brudi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470310
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470310,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470311
					],
					"speakerTitle": "„Cacasha“"
				},
				{
					"id": 752470311,
					"content": "Ich glaube, er will uns etwas geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470312
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470312,
					"content": "Cacasha überreicht der Gruppe ein buntes Geschenk-Ei ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						752470313
					]
				},
				{
					"id": 752470313,
					"content": "Oh! Noch ein buntes Geschenk-Ei, und noch ein Bild. Ich glaube, ich habe dieses Symbol schon mal auf dem Leichtbrise-Markt gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470314
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470314,
					"content": "Bruder ... Warum habe ich das Gefühl, dass eine weitere Herausforderung auf uns zukommt ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470315
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470315,
					"content": "Ist das also eine Art geheimes Schatzsuche-Spiel der Urlaubsanlage? Ich muss da mitmachen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470316
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470316,
					"content": "Mach mit, Brudi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470317
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470317,
					"content": "Cacucu scheint sich zu amüsieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470318,
					"content": "#Nun, ein Abenteuer ohne {NICKNAME} und Paimon ist kein Abenteuer! Also, was sagst du, wollen wir es uns ansehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470319,
					"content": "Auf jeden Fall! Wir machen mit!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470320
					]
				},
				{
					"id": 752470320,
					"content": "Na gut, dann mach ich auch mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifa"
				}
			]
		},
		{
			"id": 7524704,
			"completionStepIds": [
				7524704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7524704",
