				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160501,
					"content": "Ich habe alle drei gefunden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160502
					]
				},
				{
					"id": 710160502,
					"content": "Du ... hast es wirklich geschafft, sie alle zusammenzusetzen? Bitte, lass mich sehen ... Tatsächlich! Diese drei Muster erzählen, wenn sie zusammengesetzt werden, die Geschichte von Azhdaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160503
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160503,
					"content": "Dieser Kranich muss der Adept Fürst der fließenden Wasser und aufgetürmten Berge sein, und dieser Hirsch könnte der Fürst des untergehenden Mondes und der aufgehenden Sonne sein. Aber der letzte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160504
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160504,
					"content": "Was? Es sieht so aus, als wäre dieses Muster ... absichtlich von jemandem ausradiert worden. Man erkennt es nicht mehr. Wer war dieser dritte Adept?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160505
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160505,
					"content": "Vergiss es. Diese Dinge übersteigen mein Wissen. Wie dem auch sei, dieser Schatz ist vollständig und wird sich bestimmt gut verkaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160506
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160506,
					"content": "Also, willst du es als Erinnerungsstück behalten, oder möchtest du es lieber mir verkaufen? Ich werde dir eine hübsche Summe zahlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160507
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160507,
					"content": "Es gehört dir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160508
					]
				},
				{
					"id": 710160508,
					"content": "Gut. Bitte nimm dies!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160509
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160509,
					"content": "Aber wieso war das Bild von einem der drei Adepten beschädigt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160510
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160510,
					"content": "Wer hat dieses Ding geschaffen, und wer hat es zerstört und das Bild des Adept ausradiert?",
					"roleType": "TALK_ROLE_NPC",
