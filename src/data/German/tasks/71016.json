				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160301,
					"content": "Was den Namenlosen Schatz angeht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160302
					]
				},
				{
					"id": 710160302,
					"content": "Wenn ich mich nicht irre, ist der Gegenstand, den du vorher mitgebracht hast, einer von dreien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160303
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160303,
					"content": "Erst wenn alle drei Gegenstände zusammengeführt sind, ist es vollständig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160304
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160304,
					"content": "Wenn du sie alle findest, wäre ich mehr als bereit, dir ein generöses Angebot zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160305
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160305,
					"content": "Ich befürchte allerdings, dass sie aus allzu alter Zeit stammen und dass es schwierig ist, sie zusammenzutragen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
		{
			"id": 7101604,
