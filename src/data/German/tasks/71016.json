						],
						"stepId": 7101602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160201,
					"content": "Was den Namenlosen Schatz angeht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160202
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160202,
					"content": "Dieses Ding, welches du angeschleppt hast ... Es sieht ziemlich gut aus. Das Muster scheint auch ziemlich alt zu sein. Warte, solange ich es öffne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160203
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160203,
					"content": "Es hat hier und da ein paar Schönheitsfehler, aber wenn du es loswerden möchtest, kann ich dir einen Preis anbieten. Er wird fair, aber nicht hoch sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160204
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160204,
					"content": "Ich habe mir gerade das hier angesehen. Diese Markierungen stammen definitiv aus Liyue, und hier ist eine kleine Geschichte über Azhdaha eingraviert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160205
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160205,
					"content": "Sie erzählt, dass Azhdaha ein Drache war, der durch eine Vereinigung von Geo-Gottheiten in Liyue gezeugt wurde, und dass selbst Rex Lapis ihn nicht so leicht bezwingen konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160206
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160206,
					"content": "So beschwor Rex Lapis drei Adepten zu seiner Hilfe, und gemeinsam erschufen sie ein höhlenähnliches Reich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160207
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160207,
					"content": "Rex Lapis trat dann gegen die Kreatur an und lockte sie in die Höhle. Dann befahl er den Adepten, den Eingang zu versiegeln und Azhdaha darin einzusperren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160208
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160208,
					"content": "Die Muster auf dem Ding, das du angeschleppt hast, beschreiben anscheinend die drei Adepten, die sich die Hände reichen, um die Höhle zu erschaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160209
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160209,
					"content": "Ich vermute, dass es mindestens drei Reliquien dieser Art gibt. Wenn wir alle drei miteinander verbinden, dann sollten wir den kompletten Gegenstand erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160210,
						710160212
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160210,
					"content": "Du weißt all dies ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160211
					]
				},
				{
					"id": 710160211,
					"content": "Na ja, ich handle mit Gegenständen jeglicher Art. Ein wenig Allgemeinwissen hier und da schadet nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160215,
					"content": "Ah, ich schweife ab. Wie ich vorhin schon sagte, sollte es drei davon geben. Eine davon allein wird wahrscheinlich keinen hohen Preis erzielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160216
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160216,
					"content": "Aber wenn du alle drei zusammenführen kannst, wäre das etwas anderes. Aber das scheint ziemlich alt zu sein. Alle drei zusammenzuführen, wäre vielleicht eine zu große Aufgabe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160212,
					"content": "Liyue ist wahrlich ein magischer Ort ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160213
					]
				},
				{
					"id": 710160213,
					"content": "Ich bin mir zwar nicht sicher, aber einer meiner Vorgänger hat mir einmal gesagt, dass Liyue zu groß ist, und seine Geschichte ebenso viel zu lang ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160214
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160214,
					"content": "Sei nicht überrascht, wenn du seltsame Reliquien in Liyue findest. Das Wissen, das wir haben, mit der langen Geschichte von Liyue zu vergleichen, ist wie der Vergleich eines einzelnen Tropfens mit einem riesigen Ozean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "Linlang"
				}
			]
		},
		{
			"id": 7101603,
