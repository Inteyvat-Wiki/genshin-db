			"dialogs": [
				{
					"id": 710701901,
					"content": "Tut mir leid ... Mir ist ein bisschen schwindelig, aber ich reiße mich zusammen! Hach, hei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701902,
						710701907
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710701902,
					"content": "Was genau tust du hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701903
					]
				},
				{
					"id": 710701903,
					"content": "Ich bin ein Barde der alten Schule, also bin ich natürlich hier, um mich inspirieren zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701904
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710701904,
					"content": "Ooh ... Gerade noch so energiegeladen und jetzt so traurig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710701905,
					"content": "Es ist ja nicht so, als ob ich jemals in einer Mine gewesen wäre ... Außerdem ... war ich in Eile, als ich vorhin ankam, und habe meine Muskeln irgendwie ... überdehnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701906
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710701906,
					"content": "Eieiei, das tat weh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710701907,
					"content": "Ich werde dich dann nicht stören.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701908
					]
				},
				{
					"id": 710701908,
					"content": "Puh ... Warum funktioniert diese Salbe nicht ... Ah, pass auf dich auf und lass mich wissen, wenn du neue Geschichten hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
