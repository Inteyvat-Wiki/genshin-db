			"dialogs": [
				{
					"id": 710702101,
					"content": "Zhiqiong ging einfach wütend davon, als ob sie einen Wutanfall hätte. Weißt du, was hier los ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702102
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702102,
					"content": "Sie sagtes, dass sie nicht mehr sauer auf mich sein würde ... Aber sie ist total mürrisch, seit sie in dieses Lager gekommen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702103
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702103,
					"content": "Khedive sagt allen, dass Zhiqiong den Verstand verloren hat und die Große Kluft verlassen muss ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702104
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702104,
					"content": "Ich glaube, er ist derjenige, der zu viel studiert hat, sodass er seinen Verstand verloren hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				}
			]
