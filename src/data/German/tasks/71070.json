			"dialogs": [
				{
					"id": 710702001,
					"content": "Ah, du bist hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702002
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702002,
					"content": "Zhiqiong ist in letzter Zeit sehr abwesend und ich vermute, dass es das ... verdorbene schwarze Ding ist, das ihren Geist und Körper beeinträchtigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702003
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702003,
					"content": "Diese ... Dinge ähneln sehr den legendären Beschreibungen der pechschwarzen Katastrophe durch die Eingeborenen vor fünfhundert Jahren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702004
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702004,
					"content": "Aber jetzt, seit die Yahska größtenteils verschwunden und der Herrscher über die Felsen gegangen ist, bin ich zum ersten Mal so besorgt um die Sicherheit von uns Sterblichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702005
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702005,
					"content": "Tut mir leid, dass ich euch zurückgehalten habe, um so viel Unwichtiges zu erzählen. Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702006
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702006,
					"content": "Aber egal ... Pass auf dich auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
