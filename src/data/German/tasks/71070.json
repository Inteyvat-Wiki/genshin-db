				"points": []
			},
			"dialogs": [
				{
					"id": 710702801,
					"content": "Haha, du bist wieder da. Mach es dir gemütlich und fühl dich wie zu Hause!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702802,
						710702803
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702802,
					"content": "Es sieht nicht so aus, als ob es zu Hause wäre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702804
					]
				},
				{
					"id": 710702804,
					"content": "#Hahaha! Du bist mir ja eine{M#r}! Was erzählst du nur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702805
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702805,
					"content": "Dank deiner Hilfe ist die Atmosphäre im Lager viel entspannter geworden. Es tut mir wirklich leid, wenn ich dich vorhin nervös gemacht habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702806
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702806,
					"content": "Die wichtigen Aufgaben sind erledigt, und was uns jetzt noch bleibt, ist die langfristige Arbeit. Das heißt ... im Untergrund zu sein und die ungewöhnlichen Veränderungen zu überwachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702807
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702807,
					"content": "Irgendwann wird die Grube vielleicht teilweise offen sein, aber noch nicht so tief unter der Erde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702808
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702808,
					"content": "Wir sind dafür verantwortlich, diesen Bereich abzusperren und die Bergleute nicht ... nein, niemanden hierherkommen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702803,
					"content": "Sollte ich mich als Höhlenmensch sehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702804
					]
				}
			]
		},
