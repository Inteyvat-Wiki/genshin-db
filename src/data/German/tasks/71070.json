					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710703004,
					"content": "Ich muss gehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710703005
					]
				},
				{
					"id": 710703005,
					"content": "Ich werde dich nicht länger aufhalten, aber der Erkundungstrupp wird deine Ankunft immer begrüßen.",
