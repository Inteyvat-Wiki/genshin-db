	"talks": [
		{
			"id": 7107001,
			"completionStepIds": [
				7107001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107001",
							"2"
						],
						"stepId": 7107001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710700101,
					"content": "Ah, da bist du ja. Danke, dass du uns geholfen hast, den Weg freizumachen. Zhiqiong hat viel dazu beigetragen, den Weg für uns freizumachen. Wir sind euch allen sehr dankbar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700102,
						710700113,
						710700122
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700102,
					"content": "In Bezug auf das Lager ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700103
					]
				},
				{
					"id": 710700103,
					"content": "Wie ist das? Nicht schlecht, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700104
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700104,
					"content": "Ich habe all das von meinem Vater gelernt ... wie man ein Lager baut, wie man Kristalllampen herstellt, wie man Bergbauausrüstung wartet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700105
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700105,
					"content": "Während ich lernte, wurde er alt. Als seine Augen versagten, musste ich die gesamte Sicherheitsausrüstung der Mine warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700106
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700106,
					"content": "Und nun ... bin ich nicht mehr so jung. Über den Rest meines Lebens gibt es nicht viel zu erzählen ... Ich hatte einen Mann verlor ihn dann, ich hatte eine Tochter, sie ging nach Sumeru zum Studium ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700107
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700107,
					"content": "Manchmal gingen die Männer aus dem Bergwerk früher und ich kümmerte mich um die zurückgebliebenen Kinder ... und ich hatte immer ein paar kleine süße Leckereien dabei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700108
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700108,
					"content": "Ja, soweit ich mich erinnern kann, warteten die kleinen süßen Kinder immer auf unsere Süßigkeiten oder hübschen Steine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700109
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700109,
					"content": "Wah ... Hat Jinwu jetzt also auch Süßigkeiten mit dabei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710700110,
					"content": "Süßigkeiten? Hm ... So ausgefallene Süßigkeiten aus der Stadt gibt es nicht mehr. Aber Zuckerwürfel würdest du auch nehmen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700111
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700111,
					"content": "Also ist es diese Art von Süßigkeiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710700112,
					"content": "Menschen um mich herum kommen und gehen und hinterlassen nichts als Erinnerungen, um mir hier Gesellschaft zu leisten. Haha, und all ihr Abenteurer unten in den Minen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700113,
					"content": "Über Zhiqiong ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700114
					]
				},
				{
					"id": 710700114,
					"content": "Zhiqiong gehörte zur neuen Generation in den Minen, geboren im Mingyun-Dorf. Tatsächlich waren alle erfahrenen Bergleute im der Großen Kluft auch ... Zhiyiong hat es wohl nicht mehr rechtzeitig geschafft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700115
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700115,
					"content": "Versteh mich nicht falsch, ich meine nicht, dass die Zeiten jetzt schlecht sind. Ich meine damit, dass das Mingyun-Dorf vor einigen Jahren die Produktion eingestellt hat, weil ihre Mineralien erschöpft sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700116
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700116,
					"content": "Zhiqiong kam später zur Großen Kluft und irgendetwas geschah mit der Großen Kluft, sodass die Produktion gestoppt wurde ... Das Mädchen war wahrscheinlich nicht zum Bergmann geboren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700117
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700117,
					"content": "Uuh ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700118
					]
				},
				{
					"id": 710700118,
					"content": "Alle anderen haben noch ihr Leben zu leben. Ich blieb aber in der Grube. Die nach der Evakuierung zurückgelassenen Geräte müssen ja gewartet werden. Danach wurde sie zur Abenteurerin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700119
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700119,
					"content": "Dieses Kind wird immer größer und kümmert sich überhaupt nicht um sich selbst. Sie hatte zu wenige Arbeitstage in den Minen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700120
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700120,
					"content": "Wenn sie an das Leben eines Bergarbeiters gewöhnt gewesen wäre, wenn sie mit ihren eigenen Händen die Gefährdeten gerettet hätte ... Ich denke, sie hätte dann ein tieferes Verständnis für dieses Leben gehabt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700121
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700121,
					"content": "Das ist aber keine anständige Bitte ... Ich wünschte, du würdest sie besonders im Auge behalten, lass bloß nicht zu, dass sie sich etwas antut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700122,
					"content": "Tschüs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700123
					]
				},
				{
					"id": 710700123,
					"content": "Ja, pass auf dich auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
			"id": 7107017,
			"completionStepIds": [
				7107002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107002",
							"2"
						],
						"stepId": 7107002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitopho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701701,
					"content": "Hallo! Wie war die Reise?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701702
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701702,
					"content": "Schon gut. Wie geht es dir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701703
					]
				},
				{
					"id": 710701703,
					"content": "Ich danke dir für diese Gelegenheit, seit der erfolgreichen Herstellung der Zünder sind alle bereit, mich hier zu akzeptieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701704
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701704,
					"content": "Und was ich tun werde, wenn ich an der Oberfläche angekommen bin ... Haha, ich habe mich noch nicht entschieden! Wahrscheinlich kein Schatzräuber sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701705,
						710701706
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701705,
					"content": "Wahrscheinlich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				},
				{
					"id": 710701707,
					"content": "Ganz bestimmt nicht, bestimmt nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701708
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701708,
					"content": "Tschüs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701709
					]
				},
				{
					"id": 710701709,
					"content": "Auf bald!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701706,
					"content": "Wirklich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				}
			]
		},
		{
			"id": 7107018,
			"completionStepIds": [
				7107003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107003",
							"2"
						],
						"stepId": 7107003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701801,
					"content": "Dieser Kerl ... äh ... hm? Ah, hallo. Es tut mir leid, aber störst du mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701802
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701802,
					"content": "Sind wir also quitt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701804
					]
				},
				{
					"id": 710701804,
					"content": "Mach dich nicht lustig über mich. Wir sind jetzt in einer schlechten Lage, weißt du? Sehr schlecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701805
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701805,
					"content": "Du hast den leuchtenden Kristallsplitter auch gesehen, oder? Soweit ich das beurteilen kann, sollte tiefer unten ein größerer sein ... und ich nehme an, dass du das erwartet hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701806
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701806,
					"content": "Theoretisch hätten sich die Energiewerte stabilisieren müssen, als der obere Brocken „zurückkehrte“ ... Nun, genau das ist passiert. Aber ... die Wellenform war völlig falsch ... völlig falsch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701807,
						710701808
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701807,
					"content": "Was sagst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				},
				{
					"id": 710701809,
					"content": "Du warst nicht in der Schule, oder? Nun ... einfach ausgedrückt: Wir haben es mit einem Kampf zwischen zwei mächtigen Kräften zu tun, wie Bohnen, die zwischen Steinen gemahlen werden, verstehst du das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701810
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701810,
					"content": "Auf lange Sicht werden wir von zwei Kräften von oben und von unten zu Sojamilch zermahlen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701811
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701811,
					"content": "Warte nur ab, wenn du mir nicht glaubst, diese Abenteurerin namens Zhiqiong ... Ich habe gesehen, wie die Leute aussehen, wenn sie mit dem Zeug in Berührung gekommen sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701812
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701812,
					"content": "Heute hustet sie Blut, und morgen riskiert sie, ihr eigenes Lungengewebe mit auszuhusten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701813
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701813,
					"content": "Kann ich irgendetwas tun, um zu helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701814
					]
				},
				{
					"id": 710701814,
					"content": "Du? Hmmm ... Lass mich nachdenken, lass mich nachdenken ... Gib mir Zeit, es muss doch etwas geben, was ich tun kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701815
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701815,
					"content": "Aber im Moment ist es das Wichtigste, dass du weiterforscht und herausfindest, was da unten wirklich vor sich geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701816
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701816,
					"content": "Keine Sorge, ich werde so etwas Wichtiges nicht schleifen lassen ... Ich muss mich um die Sicherheit des Erkundungstrupps kümmern, und kann mein Geld nicht zum Fenster hinausschmeißen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701817
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701817,
					"content": "Wirst du dich auch um meine Sicherheit kümmern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701818
					]
				},
				{
					"id": 710701818,
					"content": "Nun ... Ich muss zugeben, dass deine Fertigkeiten meine Erwartungen übertroffen haben, also ... da du durchaus in der Lage bist, für dich selbst Verantwortung zu übernehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701819
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701819,
					"content": "Ach, schon gut. Red nur nicht von solchen Sachen ... Ich zahle dir eine Entschädigung, wenn dir etwas zustößt, in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701808,
					"content": "Bitte verwende eine menschliche Sprache.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				}
			]
		},
