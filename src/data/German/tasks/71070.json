						710703002
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710703002,
					"content": "Die Energiewerte sind viel stabiler ... Vielen Dank für deine Bemühungen und ich werde dich in meiner Arbeit erwähnen, wenn ich zurückkomme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710703003
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710703003,
					"content": "Als nomineller Arbeitgeber des Erkundungstrupps muss ich aber auch lange bleiben, um die Auswirkungen zu beobachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
