			"dialogs": [
				{
					"id": 710702901,
					"content": "Ah, da bist du ja! Willkommen bei dem Sprengtrupp und der Getränkeversorgung des Erkundungstrupps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702902
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702902,
					"content": "Alle Mitglieder! Das heißt, ich, Clitopho, grüße euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702903
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702903,
					"content": "Haha, der Drink geht auf mich! Danke für alles, was du für uns getan hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702904,
						710702905
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702904,
					"content": "Was ist dein nächster Plan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702906
					]
				},
				{
					"id": 710702906,
					"content": "Jetzt, da ich offiziell zum Erkundungstrupp gehöre, muss ich natürlich hier im Trupp bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702907
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702907,
					"content": "Hm ... Aber es wäre schön, wenn Khedive und Jinwu sich um weitere Helfer für mich kümmern könnten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702908
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702908,
					"content": "Trotzdem würde ich mich zu diesem Zeitpunkt nicht mehr als das einzige Mitglied und den Leiter des Sprengtrupps bezeichnen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702905,
					"content": "Willst du hierbleiben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702906
					]
				}
			]
