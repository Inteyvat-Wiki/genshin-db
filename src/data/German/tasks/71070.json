					"id": 710702502,
					"content": "Hallo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702503
					]
				},
				{
					"id": 710702503,
					"content": "He, behandle mich nicht wie einen Faulpelz. Wartet nur, wenn ihr mich braucht, werde ich sehr beschäftigt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702504,
					"content": "Über Zhiqiong ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702505
					]
				},
				{
					"id": 710702505,
					"content": "Sie ... Sie hat sich sehr beruhigt, seit sie zurück ist. Hm ... Ich weiß nicht, ob es an der bösen Umgebung hier liegt, aber alle sind ein bisschen launisch und reizbar und zunehmend ungeduldig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702506
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702506,
					"content": "Ich wurde gerade von Jinwu gescholten ... Ich habe sie noch nie so gemein gesehen ... Ich habe immer noch Herzklopfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				},
