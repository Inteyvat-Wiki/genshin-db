	"talks": [
		{
			"id": 7320401,
			"completionStepIds": [
				7320401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320401",
							"2"
						],
						"stepId": 7320401,
						"stateName": "QUEST_STATE_UNFINISHED"
