				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040101,
					"content": "Was macht ihr zwei denn hier? Seid ihr auch gekommen, um euch über mich, den „Steine anpflanzenden“ Alten, lustig zu machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040102,
					"content": "Mir geht es gut, ich brauche die Hilfe von euch Leuten aus dem Dorf nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040103
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040103,
					"content": "Boah, warum gleich so feindselig?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040104,
					"content": "Du irrst dich. Wir sind nicht aus dem Aaru-Dorf. Und wir wollen uns auch nicht über dich lustig machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040105,
						732040107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040105,
					"content": "Wir sind einfach nur auf der Durchreise.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040106
					]
				},
				{
					"id": 732040106,
					"content": "Auf der Durchreise ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040110
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040110,
					"content": "Üblicherweise lassen sich hier nur einige meiner alten Bekannten blicken, die mich immerzu dazu auffordern, die Baumschule aufzugeben und wieder ins Dorf zurückzuziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040111
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040111,
					"content": "Und dann sind da noch einige ungezogene kleine Gören, die ständig hierherkommen, um mich aufzuziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040112
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040112,
					"content": "Jemanden in eurer Aufmachung sehe ich tatsächlich zum ersten Mal. Was habt ihr zwei denn hier verloren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040113,
						732040116
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040113,
					"content": "Wir sind Reisende, die nach einem Verwandten suchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040114
					]
				},
				{
					"id": 732040114,
					"content": "Genau. Und dazu haben wir einen weiten Weg zurückgelegt und auf unserer Suche viele Abenteuer erlebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040115,
					"content": "#{NICKNAME} ist jemand mit einem großen Gerechtigkeitsgefühl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040119,
					"content": "In Abgeschiedenheit lebende alte Leute zu piesacken, würde uns sogar im Traum nicht einfallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040120,
					"content": "Du brauchst dir also keine Sorgen zu machen, wir sind keine Schufte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040121,
					"content": "*hust* Es ist ein bisschen peinlich, sich bei zwei jungen Leuten wie euch zu entschuldigen. Aber ich hätte genauer hinschauen sollen, bevor ich den Mund aufgemacht habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040122
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040122,
					"content": "Entschuldigung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040123
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040123,
					"content": "Ihr seid noch so jung, könnt aber schon für euch selbst sorgen, das ist ziemlich beeindruckend. Ihr habt mehr drauf als ich in eurem Alter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040124
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040124,
					"content": "Wenn ich euch gerade richtig verstanden habe, dann kann ich euch um Hilfe bitten, wenn ich ein Problem habe, mit dem ich selbst nicht fertig werde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040125
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040125,
					"content": "Hä? Heißt das, dass du Arbeit für uns hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040126,
					"content": "Um was für ein Problem geht es?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040127
					]
				},
				{
					"id": 732040127,
					"content": "Ich habe ursprünglich zwei Baumschulen angelegt. Dies ist eine davon. Die andere liegt im Westen des Dorfes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040128
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040128,
					"content": "Aufgrund meines Alters ist es für mich schwierig, mich allein um zwei Baumschulen zu kümmern, und als ich dann mehrere Tage nicht mehr dort war, wurde die andere Baumschule von seltsamen schwarzen Dingen verwüstet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040129
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040129,
					"content": "Viel zu gefährlich! Ich bin fast nicht herausgekommen. Ich traue mich gar nicht mehr in die Nähe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040130
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040130,
					"content": "Jetzt ist es mein größter Wunsch, die Baumschule zu reinigen, sodass ich dort später wieder Blumen anpflanzen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040131
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040131,
					"content": "#Klingt nicht besonders kompliziert. Was meinst du, {NICKNAME}? Sollen wir diese Mission annehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040132,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040133
					]
				},
				{
					"id": 732040133,
					"content": "Diese Baumschule befindet sich im Westen des Dorfes. Verlauft euch nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040134
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040134,
					"content": "Kein Problem, mach dir keine Sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040116,
					"content": "Wir sind Abenteurer, die die Welt erkunden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040117
					]
				},
				{
					"id": 732040117,
					"content": "Richtig. Wir haben viele hohe Berge und große Seen überquert, um nach Sumeru zu kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040118,
					"content": "Wie soll Paimon es am besten sagen, wir sind ... äh ... weitherzige Abenteurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040107,
					"content": "Wir haben gehört, dass es hier jemanden gibt, der Blumen anpflanzt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040108
					]
				},
				{
					"id": 732040108,
					"content": "Stimmt. Was ich anpflanze, sind Blumen und nicht irgendwelche mistigen Steine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040109
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040109,
					"content": "Ich habe eben gedacht ... Ach, vergiss es, was soll ich jetzt überhaupt sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040110
					],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320404,
			"completionStepIds": [
				7320404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320404",
							"2"
						],
						"stepId": 7320404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040401,
					"content": "Ihr seid wieder zurück? Wie steht es um die Baumschule? Kann es noch gerettet werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040402
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040402,
					"content": "Das Problem ist bereits gelöst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040403
					]
				},
				{
					"id": 732040403,
					"content": "Du erklärst Affan die Sache mit der Verwelkung.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732040404
					]
				},
				{
					"id": 732040404,
					"content": "So ist das also. Ich habe mich noch gefragt, wie ein kerngesunder Boden urplötzlich so viele seltsame schwarze Dinge hervorbringen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040405
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040405,
					"content": "Sehr gut, nun kann ich die Samen unbesorgt einpflanzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040406
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040406,
					"content": "Wenn diese drei Samen sprießen, erblühen und neue Samen bilden, werde ich diese wieder in das andere Blumenfeld einpflanzen. Schon bald wird hier alles voll von diesen Blumen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040407
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040407,
					"content": "Ähm, diese ... seltsam geformten Steine? Aus ihnen können Blumen wachsen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040408,
					"content": "Opa Affan, wo hast du sie gekauft? Nicht, dass du noch von jemanden übers Ohr gehauen wurdest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040409,
					"content": "Du hast dein Herz am rechten Fleck. Keine Sorge, diese Blumensamen kann man nicht mit Mora kaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040410
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040410,
					"content": "Diese drei Samen sind wertvolle Samen, die mir Sch... *hust* ... ein alter Freund hinterlassen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040411
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040411,
					"content": "Das hört sich ja immer sonderbarer an. Opa Affan, was pflanzt du da nun eigentlich an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040412,
					"content": "Hehe, was ich anpflanze, ist die Bitte eines Freundes, sein Wunsch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040413
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040413,
					"content": "Das klingt sehr seltsam. So etwas kann man anpflanzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040414,
					"content": "Selbst wenn ich es dir erkläre, würdest du das nicht verstehen. Solltest du später die Gelegenheit dazu haben, dann komm wieder vorbei und schau dir das Ergebnis an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040415
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040415,
					"content": "Es mag jetzt leer sein, aber diese drei Samen werden eines Tages in dieser Baumschule sprießen und blühen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040416
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040416,
					"content": "Es wird immer mehr von ihnen geben. Haha. Dann wird es hier bestimmt sehr schön sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040417
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040417,
					"content": "Also gut, ihr habt die Mission erfüllt und ich will euch eure Belohnung nicht vorenthalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040418
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040418,
					"content": "Bitte nehmt dies an, ich besitze zwar nicht viel, doch alles, was ich euch geben kann, ist hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040419
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040419,
					"content": "Puh, die Mission ist abgeschlossen. Dieses ganze Rumgelaufe hat Paimon etwas hungrig gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040420,
					"content": "#Von uns zweien ist nur {F#eine}{M#einer} gelaufen, und zwar ich!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040421
					]
				},
				{
					"id": 732040421,
					"content": "Aber Paimon hat dich die ganze Zeit begleitet und mit dir geplaudert. Plaudern kann auch ganz schön Kraft kosten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040422,
					"content": "#Sei nicht so geizig, {NICKNAME}. Wie wäre es, wenn wir uns das Geld nehmen und uns damit eine wohlverdiente leckere Mahlzeit kaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040423,
					"content": "Schau gleich mal nach, wie viel es ist, dann sehen wir ja, wie viel wir damit essen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040424,
					"content": "Schauen wir mal ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040425
					]
				},
				{
					"id": 732040425,
					"content": "Oh! Hier ist mehr Essen als Mora ... Da sind Schawarma-Rollen, Tahchin und ganz viel Gemüse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040426,
					"content": "Das ist etwas zu viel. Haben wir uns da etwa ... Opa Affans Essen für den ganzen Tag genommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040427,
					"content": "Opa Affan hat es sicher nicht leicht, immerhin wohnt er ja ganz alleine außerhalb des Dorfs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040428,
					"content": "Die Mora gehen in Ordnung, doch dass er uns auch sein ganzes Essen gegeben hat ... Paimon fühlt sich nicht gut dabei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040429,
					"content": "Außerdem pflanzt er eindeutig Samen an, die wie Steine aussehen, aber gleichzeitig sagt er, dass er einen ... Wunsch anpflanze?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040430,
					"content": "Sag mal, könnte er Illusionen entwickelt haben, weil er so lange schon alleine lebt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040431,
					"content": "Paimon macht sich immer mehr Sorgen um ihn. Wir sollten nach ihm sehen, wenn wir Zeit haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
