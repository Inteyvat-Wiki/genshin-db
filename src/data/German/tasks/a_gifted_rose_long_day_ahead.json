						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320502",
							"2"
						],
						"stepId": 7320502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050401,
					"content": "Gießt zuerst diese drei Samen, und ich überlege mir, was ich mit dem Dünger machen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050402
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050402,
					"content": "Nach all den Jahren weiß ich dennoch, wie man einen einfachen Dünger herstellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		}
	]
}