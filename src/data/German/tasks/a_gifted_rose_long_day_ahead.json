			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040701,
					"content": "Ah, ich hatte noch keine Zeit, Essen zu machen, und kann euch nichts anbieten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040702,
						732040703
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040702,
					"content": "Nicht nötig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				},
				{
					"id": 732040704,
					"content": "Du bist mit dem anderen Kind befreundet, nicht wahr? Es ist sehr süß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040705
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040705,
					"content": "Wollt ihr zwei vorbeikommen, wenn die von mir angepflanzten Blumen Blüten treiben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040706
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040706,
					"content": "Gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040707
					]
				},
				{
					"id": 732040707,
					"content": "Sie sollten in kurzer Zeit blühen. Kommt in Zukunft vorbei und bewundert die Blumen, die wir gemeinsam gepflanzt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040708
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040708,
					"content": "Sicher.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040709
					]
				},
				{
					"id": 732040709,
					"content": "Gut, ich verstehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040710
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040710,
					"content": "♪♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040703,
					"content": "Ich bin nicht hungrig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				}
			]
		},
		{
			"id": 7320501,
			"completionStepIds": [
				7320501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320501",
							"2"
						],
						"stepId": 7320501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050101,
					"content": "Kommt und schaut euch diese Samen an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050102,
					"content": "Es scheint sich nichts verändert zu haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050103
					]
				},
				{
					"id": 732050103,
					"content": "Ja, ich habe zwar viele Jahre lang Felder bestellt, aber zwischen dem Ackerbau und dem Anpflanzen von Blumen bestehen Unterschiede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050104,
					"content": "Wie könnte es andernfalls zu erklären sein, dass sie nach so langer Zeit immer noch nicht gewachsen sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050105
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050105,
					"content": "Lass Paimon mal sehen, hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050106,
					"content": "Opa Affan, Paimon glaubt, deine Baumschule ist zu trocken. Außerdem hat der Boden um das Aaru-Dorf vielleicht nicht genug Nährstoffe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050107,
					"content": "Wir haben erst letztens jemandem im Dorf geholfen, Blumen anzupflanzen, und haben Erfahrung mit derlei Dingen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050108,
					"content": "Oh, ist das so ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050109
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050109,
					"content": "Das ergibt Sinn. Eine so seltene Blumensorte ist bestimmt etwas anspruchsvoller als gewöhnliche Pflanzen. Ich habe da wohl tatsächlich nicht ausreichend gegossen und gedüngt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050110
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050110,
					"content": "Doch diese Baumschule ist etwas weit von der nächsten Wasserquelle entfernt. Es ist nicht einfach, Wasser hierher zu bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050111
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050111,
					"content": "Und ich habe auch nicht gerade viel Wasser für meinen täglichen Gebrauch gespeichert. Wenn ich die Samen in der Baumschule nun auch noch regelmäßig gießen müsste, wäre das sehr umständlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050112
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050112,
					"content": "Ich werde dir helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050113
					]
				},
				{
					"id": 732050113,
					"content": "Na gut, dann will ich euch darum bitten, meine drei Samen zu gießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320503,
			"completionStepIds": [
				7320503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320503",
							"2"
						],
						"stepId": 7320503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050301,
					"content": "Sehr gut! Ihr zwei habt es wirklich drauf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050302
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050302,
					"content": "Da mir jetzt ja Experten mit eurem Rat zur Seite stehen, habe ich das Gefühl, dass sie dieses Mal wachsen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050303
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050303,
					"content": "Haben euch die Schawarma-Rollen und das Tahchin von eben geschmeckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050304,
						732050306
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050304,
					"content": "Sie waren sehr lecker.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050305
					]
				},
				{
					"id": 732050305,
					"content": "Wenn sie euch geschmeckt haben, bereite ich noch ein paar mehr für euch zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050307
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050307,
					"content": "Ich kann nicht so gut kochen wie meine verstorbene Frau, bitte seht mir das nach. Greift zu, dieses Mal sind es etwas weniger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050308
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050308,
					"content": "Leckeres Essen! Opa Affan, du bist echt nett, wir werden öfters bei dir vorbeischauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050309,
					"content": "Haha, wolltet ihr mich vorher nicht fragen, um was für eine Blume es sich handelt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050310
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050310,
					"content": "Es spricht nichts dagegen, es euch zu sagen. Was ich hier anpflanze, sind Rosen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050311
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050311,
					"content": "Die gleiche Art von Blumen wie Sumeru-Rosen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050312
					]
				},
				{
					"id": 732050312,
					"content": "Diese Blumen heißen „Goldrosen“ und sie sind weitaus kostbarer als Sumeru-Rosen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050313
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050313,
					"content": "Ich habe euch vorher erzählt, dass ein Freund mir diese Blumensamen gegeben hat. Erinnert ihr euch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050314
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050314,
					"content": "Na ja, diese Samen und dieses alte Haus, in dem ich jetzt wohne, wurden mir alle von dem verstorbenen Scheusalsgreis hinterlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050315
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050315,
					"content": "Ah, ich habe ganz vergessen, dass ihr nicht aus dem Dorf seid. Dann ist euch dieser Name wohl nicht bekannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050316
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050316,
					"content": "Und es ist auch gut, dass euch dieser Name nicht bekannt ist. Denkt einfach an ihn als einen alten Mann, der wusste, wie man Blumen pflanzt ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050317
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050317,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050318
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050318,
					"content": "Opa Affan, warum stehst du wie versteinert da? Opa Affan? Opa Affan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050319,
					"content": "Ah, war ich gerade geistesabwesend? In meinem Alter lässt die Konzentration schnell nach, tut mir leid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050320
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050320,
					"content": "Ich muss euch zwei wieder einmal danken. Wenn ihr hier noch etwas anderes sehen wollt, dann schaut euch ruhig um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050321
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050321,
					"content": "Ich werde nicht noch einmal Leute von hier wegjagen. Aber seid vorsichtig und tretet nicht auf die Baumschule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050306,
					"content": "Ich habe sie noch nicht probiert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050307
					]
				}
			]
		},
		{
			"id": 7320504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
