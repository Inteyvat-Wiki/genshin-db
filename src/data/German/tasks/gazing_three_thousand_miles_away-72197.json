			"dialogs": [
				{
					"id": 721402301,
					"content": "#{NICKNAME}, ich habe nie gedacht, dass ich dich hier noch einmal sehen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402302
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402302,
					"content": "Es ist eine lange Zeit her! Wie sieht die Welt außerhalb von Yashiori aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402303,
					"content": "Sie ist viel reicher als meine Heimat und es gibt viel mehr leckere Küche und lustige Dinge. Aber ... ich mag es nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402304
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402304,
					"content": "Warum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402305,
					"content": "Den Menschen hier fehlt etwas ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402306
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402306,
					"content": "Als ich früher auf Yashiori lebte, war die Ogosho für mich fern und friedlich ... Wir kümmerten uns nicht darum, wo sie war. Aber wir glaubten, dass sie hier war, über uns wachte und uns beschützte. Es wurde angeordnet, wie wir unser Leben lebten und was für Menschen wir wurden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402307
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402307,
					"content": "Aber hier kontrolliert die Ogosho alles und unterdrückt alle ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402308
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402308,
					"content": "Ah, ich bin mir nicht sicher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402309
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402310,
					"content": "Wir arbeiten noch daran.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402311
					]
				},
				{
					"id": 721402309,
					"content": "Übrigens, über meine Mutti ... hast du etwas herausgefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402310
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402311,
					"content": "Das macht nichts. Sag mir einfach Bescheid, wenn du Neuigkeiten hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chouji"
				}
			]
		},
