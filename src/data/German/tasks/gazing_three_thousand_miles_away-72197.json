			"dialogs": [
				{
					"id": 721402001,
					"content": "Hallo, so sehen wir uns wieder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402002
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402003,
					"content": "„Bitte hol mir mehr Kristallmark ...“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402004
					]
				},
				{
					"id": 721402002,
					"content": "Lass mich mal raten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402005,
					"content": "Das ist es, was du sagen willst!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402006
					]
				},
				{
					"id": 721402004,
					"content": "„Ich brauch sie ganz dringend, oooh ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402007,
					"content": "Wie war deine Reise?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402008
					]
				},
				{
					"id": 721402006,
					"content": "Hahahahahahaha, natürlich nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402007
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402008,
					"content": "Ganz gut. Aber es gibt noch kein Spuren von Mutti ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402009
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402010,
					"content": "Wir geben uns alle Mühe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402011
					]
				},
				{
					"id": 721402009,
					"content": "#Ist schon gut. Wir werden dir helfen, ja? {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402011,
					"content": "#Nun, ich weiß, dass man {NICKNAME} vertrauen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chouji"
				}
			]
		},
		{
			"id": 7219721,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
