			"dialogs": [
				{
					"id": 721402102,
					"content": "Bitte lies selbst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402103,
					"content": "Nun ... na gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402104
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402105,
					"content": "Ihre Wahl mag ein bisschen egoistisch gewesen sein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402106
					]
				},
				{
					"id": 721402104,
					"content": "Ich werde ihn lesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402105
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402106,
					"content": "Aber sei nicht böse auf sie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402107
					]
				},
				{
					"id": 721402107,
					"content": "... Ich verstehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402108
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402108,
					"content": "Aber ich werde weiter nach ihr suchen. Erst wenn ich sie finde, wird alles einen Sinn haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402109
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402109,
					"content": "Dieses Kind ... Warum ist es so stur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
