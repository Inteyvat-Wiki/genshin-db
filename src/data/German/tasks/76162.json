			"dialogs": [
				{
					"id": 761000701,
					"content": "Geh mir aus dem Weg, hau ab!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000702
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000702,
					"content": "Hehe ... warum so eilig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000703
					],
					"speakerTitle": "Stimme des Monsters"
				},
				{
					"id": 761000703,
					"content": "Ihr werdet sowieso ... früher oder später sterben ... es ist nur so, dass ... manche früher gehen müssen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000704
					],
					"speakerTitle": "Stimme des Monsters"
				},
				{
					"id": 761000704,
					"content": "Hat er sich nicht ... vor drei Jahren beklagt, dass er nicht sterben konnte ... Jetzt ... werde ich ihm diesen Wunsch erfüllen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000705
					],
					"speakerTitle": "Stimme des Monsters"
				},
				{
					"id": 761000705,
					"content": "... Bjorn? Was hast du ihm angetan?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000706
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000706,
					"content": "Er war zu schwach ... Schwächlinge ... Nutzlose Kreaturen ... Ungeziefer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000707
					],
					"speakerTitle": "Stimme des Monsters"
				},
				{
					"id": 761000707,
					"content": "... Ist es nicht selbstverständlich, dass solche Schwächlinge sterben müssen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000708
					],
					"speakerTitle": "Stimme des Monsters"
				},
				{
					"id": 761000708,
					"content": "Wage es nicht, ihn zu beleidigen! Er ist überhaupt nicht schwach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000709
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000709,
					"content": "Oh ... in deinen Augen ... ist er ein von den Starken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000710
					],
					"speakerTitle": "Stimme des Monsters"
				},
				{
					"id": 761000710,
					"content": "Aber ... Aber heißt das denn, dass Starke nicht sterben können ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000711
					],
					"speakerTitle": "Stimme des Monsters"
				},
				{
					"id": 761000711,
					"content": "Ich dachte ... du wüsstest es besser ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000712
					],
					"speakerTitle": "Stimme des Monsters"
				},
				{
					"id": 761000712,
					"content": "Die, die stärker waren als du ... Sie sind doch alle tot ... Egal ob vor drei Jahren ... oder vor zehn Jahren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000713
					],
					"speakerTitle": "Stimme des Monsters"
				},
				{
					"id": 761000713,
					"content": "... Halt deine verdammte Klappe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000714
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000714,
					"content": "Ja ... am Ende bist du ... der einzige Schwächling hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000715
					],
					"speakerTitle": "Stimme des Monsters"
				},
				{
					"id": 761000715,
					"content": "Warum sonst ... überlebst du jedes Mal ... jedes Mal als Einziger?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000716
					],
					"speakerTitle": "Stimme des Monsters"
				},
				{
					"id": 761000716,
					"content": "... Du bist vom Schlachtfeld geflohen, nicht wahr? Ein feiger Feigling, der nur ans Überleben denkt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000717
					],
					"speakerTitle": "Stimme des Monsters"
				},
				{
					"id": 761000717,
					"content": "Illuga! Hör nicht auf dieses dumme Geschwätz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761000718,
					"content": "Genug geredet! Mach dich bereit zu sterben!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761000719
					]
				},
				{
					"id": 761000719,
					"content": "#... {NICKNAME}! Machen wir’s kurz und bündig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
