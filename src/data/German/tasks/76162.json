						],
						"pointId": 14831
					}
				]
			},
			"dialogs": [
				{
					"id": 761001601,
					"content": "... Ist Bjorn in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001602
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001602,
					"content": "... Er ist schwer verletzt. Der Angriff kam so plötzlich, er wollte uns beschützen ... *schluchz* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001603
					],
					"speakerTitle": "Egle"
				},
				{
					"id": 761001603,
					"content": "... Hier auf dem Schlachtfeld ist zu gefährlich, und er würde den Transport nicht überleben. Wir hatten keine andere Wahl, als ihn hier vor Ort zu behandeln, aber mit den uns zur Verfügung stehenden Mitteln ist es einfach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001604
					],
					"speakerTitle": "Egle"
				},
				{
					"id": 761001604,
					"content": "... Truppenführer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001605
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001605,
					"content": "Bjorn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001606
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001606,
					"content": "... Es tut mir leid ... Ich habe den Auftrag nicht erfüllt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001607
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001607,
					"content": "Du hast ihn sehr gut erfüllt! Die Stellung wurde gehalten und alle sind wohlauf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001608
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001608,
					"content": "Wirklich ... Also habe ich es doch geschafft ... wie schön ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001609
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001609,
					"content": "Sag jetzt nichts und konzentriere dich erst mal auf deine Genesung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001610
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001610,
					"content": "Wenn ich jetzt nicht spreche ... dann werde ich später keine Gelegenheit mehr dazu haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001611
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001611,
					"content": "... Das ist ein Befehl von deinem Truppenführer! Ich verbiete dir, so etwas zu sagen! Dir wird nichts passieren ... Das wird schon alles gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001612
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001612,
					"content": "Hah ... gut ... zu Befehl ... ich werde nichts mehr sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001613
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001613,
					"content": "Aber ... wenn ich Veyde sehe ... kann ich ihm wenigstens ohne Reue gegenübertreten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001614
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001614,
					"content": "Er sagte früher oft ... wir Lichthüter sind wie das Winterweidenkraut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001615
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001615,
					"content": "Angesichts der Wilden Jagd ... sind wir alle so zerbrechlich ... wie die Blüten des Winterweidenkrauts ... fallen so leicht ab ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001616
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001616,
					"content": "Aber ... solange die Blätter noch da sind ... solange die Wurzeln noch fest in der Erde stecken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001617
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001617,
					"content": "Dann werden im nächsten Jahr ... und im übernächsten ... neue Blüten sprießen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001618
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001618,
					"content": "Wir werden nicht scheitern ... oder, Truppenführer ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001619
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001619,
					"content": "... Ja! Wir werden niemals scheitern! Ich werde dieses Monster mit meinen eigenen Händen endgültig vernichten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001620
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001620,
					"content": "... Du bist der Stärkste von uns ... ich glaube an dich ... Truppenführer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001621
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001621,
					"content": "... Mach dir keine Sorgen, Bjorn, ich werde unser Versprechen ganz sicher halten. Ruh dich erst einmal aus ... Wenn deine Wunden verheilt sind, wird alles wieder gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001622
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001622,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001623
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001623,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001624
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001624,
					"content": "#{NICKNAME}, Paimon, wir müssen gehen. Der Auftrag ist noch nicht zu Ende, wir können hier nicht länger bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001625
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001625,
					"content": "Illuga ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001626,
						761001627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761001626,
					"content": "Schon allein für Bjorn müssen wir weitermachen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761001628
					]
				},
				{
					"id": 761001627,
					"content": "Wir werden die Gegner besiegen und den Sieg erringen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761001628
					]
				},
				{
					"id": 761001628,
					"content": "... Hm, lasst uns weitergehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		}
	]
}