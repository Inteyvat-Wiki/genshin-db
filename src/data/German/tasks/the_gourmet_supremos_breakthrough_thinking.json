					"content": "Dieses Gericht ... lass es mich mal versuchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140802
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140802,
					"content": "Der Geschmack ist großartig und die Kombination der Zutaten ist auch wirklich gut. Wie man es von Koch Mao erwartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140803
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140803,
					"content": "Allerdings habe ich immer noch das Gefühl, dass ein bisschen was fehlt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140804
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140804,
					"content": "Allerdings habe ich immer noch das Gefühl, dass es ein bisschen was fehlt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140805
					]
				},
				{
					"id": 220140805,
					"content": "Ich weiß es nicht ... *seufz* Ich werde darüber nachdenken. Zumindest hat Koch Mao mich auf eine Idee gebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140806
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140806,
					"content": "Vielen Dank für deine Hilfe. Bitte nimm dies hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140807
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140807,
					"content": "Wie um alles in der Welt soll ich ein wirklich einzigartiges Gericht zubereiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
