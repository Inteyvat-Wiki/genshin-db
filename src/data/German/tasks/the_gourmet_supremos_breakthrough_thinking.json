					"Xiangling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140601,
					"content": "Diese Bambussprossen sehen ziemlich gut aus. Ich werde ein paar ausgraben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140602
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140602,
					"content": "Hm? Du bist es. Was führt dich hierher? Soll ich dir wieder etwas Leckeres zaubern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140603,
						220140604
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140603,
					"content": "Nun, ich habe etwas, bei dem ich deine Hilfe brauche.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140607
					]
				},
				{
					"id": 220140607,
					"content": "Oh. Der Umgang mit Zutaten aus Inazuma mit Techniken von Liyue ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140608
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140608,
					"content": "Hehe. Da bist du bei dem richtigen Koch gelandet! Ich habe von einer Technik aus Inazuma gehört, bei der man Zutaten in Mehl wickelt und sie dann brät.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140609
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140609,
					"content": "Es nennt sich Tempura und wird mit einer speziellen Soße zum Dippen serviert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140610
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140610,
					"content": "Besonders interessant fand ich die Soße, als ich versucht habe, Tempura zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140615
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140615,
					"content": "Ich habe so viele Zutaten ausprobiert: Vaniloqua-Nektar, Flammenblume ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140611
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140611,
					"content": "Wird es zufällig mit Schleimabsonderung hergestellt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140612
					]
				},
				{
					"id": 220140612,
					"content": "Nein, nein. Schleimabsonderung ist für dieses Gericht nicht geeignet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140616
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140616,
					"content": "Dennoch bevorzuge ich die Zugabe des Pulvers der Flügel von Elektro-Cicinen, um eine mehrschichtige Textur zu erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140613
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140613,
					"content": "Nur für den Fall, dass du es vergisst, werde ich es aufschreiben. Dann kannst du es Xudong zeigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140614
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140614,
					"content": "*seufz* Ich wünschte, ich könnte nach Inazuma gehen. Es muss so viele Zutaten geben, die ich noch nicht verwendet habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140604,
					"content": "Du hast genau wie Koch Mao reagiert ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140605
					]
				},
				{
					"id": 220140605,
					"content": "Oh, du warst im Laden? Hmm. Aber jetzt, wo ich einen weiteren Blick darauf geworfen habe, siehst du nicht so aus, als wärst du zum Essen hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140606
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140606,
					"content": "Hast du also kulinarische Probleme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140607
					],
					"speakerTitle": "Xiangling"
				}
			]
		},
