				{
					"id": 220140901,
					"content": "Xiangling ... hat das geschrieben? Es muss schwer gewesen sein, sie zu finden. Danke für deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140903
