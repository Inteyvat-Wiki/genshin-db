				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140101,
					"content": "#He, {F#Reisende}{M#Reisender}. Schön, dich wiederzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140102,
						220140104
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140102,
					"content": "Kann ich bei irgendetwas helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140103
					]
				},
				{
					"id": 220140103,
					"content": "Weißt du noch, wie ich dir ein Essen versprochen habe? Ich treffe gerade die Vorbereitungen dafür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140106,
					"content": "Wir haben von überall her frische Zutaten gesammelt, um ein tolles Essen zu kochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140107,
					"content": "Ich habe fast genug Zutaten, also versuche ich herauszufinden, wie ich sie zubereiten kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140108
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140108,
					"content": "Wo sind Julie und Parvaneh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140109
					]
				},
				{
					"id": 220140109,
					"content": "Nun, Parvaneh ist auf der Suche nach weiteren Zutaten für das „ultimative Gewürz“, das sie machen wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140110
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140110,
					"content": "Sie nahm Julie auf dieser Suche mit nach draußen ... Sie sagten aber, dass sie nicht zu weit aus der Stadt gehen würden, also mach dir keine Sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140111
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140111,
					"content": "Allerdings brauche ich deine Hilfe bei etwas. Obwohl ich eine Menge frischer Zutaten habe, fehlt mir ... die Inspiration, die ich brauche, um einen Durchbruch zu schaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140112
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140112,
					"content": "Schau dir das an. Seegras ... Meereslackporling und ... äh, Sakura-Blüten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140113
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140113,
					"content": "Sie sind ziemlich frisch, aber ich habe keine Ahnung, was ich mit ihnen anfangen soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140114,
					"content": "Ich wollte einen lokalen Koch in Inazuma um Rat fragen. Aber wenn ich das tun würde, würde ich mit der üblichen Inazuma-Küche enden. Das ist nichts Neues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140115,
					"content": "Also dachte ich daran, Zutaten aus Inazuma zu verwenden, wie die Köche von Liyue es tun. Auf diese Weise kann ich vielleicht etwas Neues und Aufregendes machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140116
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140116,
					"content": "#{F#Reisende}{M#Reisender}, könntest du bitte nach Liyue gehen und Koch Mao vom Wanmin Restaurant für mich konsultieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140117,
						220140119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140117,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140118
					]
				},
				{
					"id": 220140118,
					"content": "Danke vielmals. Ich werde hier auf dich warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140124,
					"content": "Ich hoffe, Koch Mao hat ein paar gute Ideen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140119,
					"content": "Du willst ein bisschen Pfiff, nicht wahr?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140120
					]
				},
				{
					"id": 220140120,
					"content": "Boom shaka-laka? Was ist das? Meinst du ... eine Art Gefühl der Ehrfurcht vor dem Essen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140121
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140121,
					"content": "Wenn du ein Rezept mit diesem Gefühl finden kannst, wäre das fantastisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140122
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140122,
					"content": "Aber ich kenne niemanden, der ein solches Rezept hätte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140123
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140123,
					"content": "Wie auch immer, bitte geh und konsultiere zuerst Koch Mao für mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140104,
					"content": "Wirst du mich zu diesem Essen einladen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140105
					]
				},
				{
					"id": 220140105,
					"content": "Hahaha, das ist genau das, worauf ich mich vorbereite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2201402,
			"completionStepIds": [
				2201402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201402",
							"2"
						],
						"stepId": 2201402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Koch Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140201,
					"content": "#Hm? {F#Reisende}{M#Reisender}, was machst du denn hier? Soll ich dir wieder etwas Leckeres zaubern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140202
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 220140202,
					"content": "Ich bin eigentlich für deinen Ratschlag hier ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140203
					]
				},
				{
					"id": 220140203,
					"content": "Xudong ist nach Inazuma gegangen, um zu kochen? ... Er hat wirklich eine ganz schöne Portion Entschlossenheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140204
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 220140204,
					"content": "Kennst du ihn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140205
					]
				},
				{
					"id": 220140205,
					"content": "Irgendwie schon. Wir hatten mal eine Kochrivalität und es war ... eine Pattsituation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140206
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 220140206,
					"content": "Er sagte, er wolle die Welt bereisen und nach einem Durchbruch suchen ... Ich hätte nie gedacht, dass er es tatsächlich tun würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140207
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 220140207,
					"content": "Trotzdem sieht es so aus, als ob er gegen eine Wand gefahren ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140208,
						220140210
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 220140208,
					"content": "Weißt du, was ihm helfen könnte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140209
					]
				},
				{
					"id": 220140209,
					"content": "Ich kann nicht garantieren, dass es funktioniert, aber ich werde mein Bestes versuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 220140214,
					"content": "Seegras ... Meereslackporling ... und ... Sakura-Blüte? Das sind seltsame Zutaten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140215
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 220140215,
					"content": "Wenn ich das Seegras und den Meereslackporling alleine nehmen würde, könnte ich wohl ein Gericht machen ... aber wir brauchen noch ein paar zusätzliche Dinge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140216
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 220140216,
					"content": "#{F#Reisende}{M#Reisender}, könntest du bitte ein paar Jueyun-Peperoni und rohes Geflügel für mich auftreiben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140217,
						220140219
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 220140217,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140218
					]
				},
				{
					"id": 220140218,
					"content": "Danke! Bring sie zu mir, sobald du sie hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 220140219,
					"content": "Ah, klassische Zutaten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140220
					]
				},
				{
					"id": 220140220,
					"content": "Hahaha, das ist sicher. Sie sind auch am schwersten zu vermasseln. Bring sie zu mir, sobald du welche hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140221
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 220140221,
					"content": "Abgesehen davon weiß ich wirklich nicht, wie man Sakura-Blüten kocht ... Ich bin mir nicht sicher, wie die Köche in Inazuma mit ihnen umgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 220140210,
					"content": "Vielleicht weiß Xiangling, wie man sein Problem lösen kann ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140211
					]
				},
				{
					"id": 220140211,
					"content": "Xiangling ... Stimmt, sie ist schon immer eine sehr kreative Köchin gewesen. Vielleicht kann sie eine Lösung finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140212
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 220140212,
					"content": "Aber sie ist im Moment ins Qingce-Dorf gegangen, um Bambussprossen zu pflücken, also ist sie nicht hier. Es wird eine Weile dauern, sie zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140213
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 220140213,
					"content": "Xudong wartet bestimmt schon sehnsüchtig. Mal sehen, ob ich sein Problem lösen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "Koch Mao"
				}
			]
		},
		{
			"id": 2201403,
