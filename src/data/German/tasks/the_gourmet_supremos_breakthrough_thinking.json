				}
			]
		},
		{
			"id": 2201404,
			"completionStepIds": [
				2201404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201404",
							"2"
						],
						"stepId": 2201404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Koch Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140401,
					"content": "Das sollte genug sein. Warte einen Moment. Ich werde sehen, was ich mit diesen Zutaten machen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140402
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 220140402,
					"content": "Erledigt. Trotzdem habe ich das Gefühl, dass es sich nicht allzu sehr von den Gerichten unterscheidet, die ich normalerweise mache ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140403
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 220140403,
					"content": "Bringe dieses Gericht zurück zu Xudong. Hoffentlich wird es sein Problem lösen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Koch Mao"
				}
			]
		},
		{
			"id": 2201405,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
