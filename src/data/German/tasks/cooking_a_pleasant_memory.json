				"points": []
			},
			"dialogs": [
				{
					"id": 730190101,
					"content": "Ihr müsst viel Tau aufsaugen und schnell aufwachsen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190102
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190102,
					"content": "Hallo! Du bist Ara... Ara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190103,
						730190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190103,
					"content": "Bist du Arapacatis Bruder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190104
					]
				},
				{
					"id": 730190104,
					"content": "Oh, kein schlechter Trick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190107,
					"content": "... Wachsen, gedeihen, zu einem köstlichen Gericht werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190108
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190108,
					"content": "Er scheint uns nicht zu bemerken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190105,
					"content": "Arasaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190106
					]
				},
				{
					"id": 730190106,
					"content": "Arasaka! Du bist Arasaka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301902,
			"completionStepIds": [
				7301902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301902",
							"2"
						],
						"stepId": 7301902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190201,
					"content": "Ah! Ein Nara ... So groß, so furchteinflößend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190202
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190202,
					"content": "Ich bitte dich ... Pflücke sie nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190203
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190203,
					"content": "Schon gut, wir pflücken sie nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190204,
					"content": "Dann ist gut. Ach ... diese Zaytun-Pfirsiche habe ich selbst eingepflanzt, als sie noch Samen waren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190205
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190205,
					"content": "Ne... nein! Böse Nara! Wie könnt ihr euch nur an den Zaytun-Pfirsichen anderer Leute vergreifen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190206
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190206,
					"content": "Nara, warum, warum habt ihr eine so furchterregende Angewohnheit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190207
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190207,
					"content": "Wir haben nichts getan und haben sie auch nicht gepflückt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190208,
					"content": "Rein gar nichts getan und schon so furchterregend? Was passiert, wenn ihr wirklich etwas anstellt? Ihr jagt mir einen gehörigen Schrecken ein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190209
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190209,
					"content": "Ach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190210,
					"content": "Nein, Arasaka ... denk doch mal nach. Für die Zaytun-Pfirsiche, die dich so viel Mühe gekostet haben, für die „Kochausbildung“ ... du darfst hier nicht klein beigeben, du darfst keine Angst haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190211
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190211,
					"content": "Du bist also wirklich Arasaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190212,
					"content": "Ah! Woher, woher kennt ihr meinen Namen ... Wer seid ihr ... Woher kennt ihr meinen Namen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190213,
						730190216
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190213,
					"content": "Du hast ihn selbst genannt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190214
					]
				},
				{
					"id": 730190214,
					"content": "Schweigen ist Gold! Oh nein, mein Name wird für einen gefährlichen Fluch benutzt ... Bitte, bitte, verschont mich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190215
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190215,
					"content": "Ich bin zu allem bereit, außer euch meine Zaytun-Pfirsiche zu geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190219,
					"content": "Reg dich etwas ab. Wir wurden von Arapacati beauftragt, zu dir zu kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190220,
					"content": "Arapacati? Ah, meine geliebte „Schwester“! Die Sonne des Walds ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190221
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190221,
					"content": "Du hast Arasaka erzählt, was passiert ist.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730190222
					]
				},
				{
					"id": 730190222,
					"content": "Oh! Das Utsava-Fest, wie kann das Utsava-Fest so schnell ... Ach, ihr nehmt diesmal am Fest teil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190223
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190223,
					"content": "Tut mir leid, dass ich euch böse Nara genannt habe. Ihr seid gute Nara, denn nur gute Nara können Vanarana betreten und am Utsava-Fest teilnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190224
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190224,
					"content": "Das Utsava-Fest ist bald da! Wenn ich meine „Kochausbildung“ nicht vollende und einfach nach Vanarana zurückkehre ... Nein ... Aber ich kann das Utsava-Fest auch nicht ausfallen lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190225
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190225,
					"content": "Wieso bist du denn nun sogar noch angespannter geworden ... Hast du denn nicht immer noch die Zaytun-Pfirsiche, die du angepflanzt hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190226,
					"content": "... Es ist nur, dass die von mir angepflanzten Zaytun-Pfirsiche nicht ausreichen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190227
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190227,
					"content": "Sie brauchen den „Geschmack des Glücks“, denn andernfalls wären die Zaytun-Pfirsiche einfach nur Zaytun-Pfirsiche ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190228
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190228,
					"content": "Arachatora, Arapas und Araphala glauben nicht an den „Geschmack des Glücks“. Ich werde es ihnen zeigen. Du sollst auch probieren, Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190229,
						730190230
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190229,
					"content": "„Geschmack des Glücks“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190231,
					"content": "Hehe, ich habe den „Geschmack des Glücks“ einmal probiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190232
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190232,
					"content": "Der „Geschmack des Glücks“. Er ist weiß, zerbröselt, wenn man ihn reibt ... Verwandelt sich in weißes Valuka, ist aber nicht hart und schmerzhaft wie Valuka. Wird in einer harten Luftblase aufbewahrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190233,
						730190234
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190233,
					"content": "... Weißes Valuka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190235,
					"content": "Weißes Valuka ist also weißer Sand ... oder? Aber was soll eine harte Luftblase sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190236,
					"content": "Hmm, keine Ahnung. Wo soll dieser „Geschmack des Glücks“ sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190237,
					"content": "Warum, warum fragst du? Willst du etwa den „Geschmack des Glücks“ von mir wegschnappen? Wie fürchterlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190238,
						730190239
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190238,
					"content": "Wir möchten dir helfen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190241
					]
				},
				{
					"id": 730190241,
					"content": "Mir helfen? Wobei helfen? Ich, ich schaffe es selbst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190242
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190242,
					"content": "Nur laufen dort viele Nara herum und einer von ihnen hat den Geschmack von Nara Valuka. Hmm ... Ich habe Angst ... Ich könnte es selbst tun, wenn weniger Nara da wären ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190243
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190243,
					"content": "... Ah. Na gut, ich schaffe es selbst nicht. Ich ... traue mich nicht nach Gandharva, dort sind zu viele Nara. Außerdem gibt es überall tote Bäume. Wie erschreckend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190244
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190244,
					"content": "Ich habe einen Nara Freund dort. Aber es ist lange, lange Zeit her. Jetzt hat er sich verändert und kann meine Stimme nicht mehr hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190245
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190245,
					"content": "Verstehe. Deshalb ist der „Geschmack des Glücks“, von dem du sprichst, in Gandharva zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190246,
					"content": "Der „Geschmack des Glücks“ wächst nicht aus dem Boden, sondern wird von Nara gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190247
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190247,
					"content": "Ich würde ihn so gerne wieder probieren! Ich erinnere mich an das erste Mal ... wie glücklich ich war! Ein zutiefst beeindruckender Geschmack.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190248
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190248,
					"content": "Ich war mit ihm im Wald und wir haben gezählt, wie viele Sonnenstrahlen wie Blattgold von den Blättern fielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190249
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190249,
					"content": "Wir haben zusammen gesungen und den „Geschmack des Glücks“ probiert. Jedes Mal, wenn ich die Sonnenstrahlen zwischen den Blättern sehe, muss ich an ihn denken. Jedes Mal, wenn ich an ihn denke, denke ich an den „Geschmack des Glücks“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190250
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190250,
					"content": "Ich möchte also, dass Arapacati einen solchen Geschmack probiert. Und wenn das Utsava-Fest beginnt, möchte ich, dass auch Nara diesen Geschmack genießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190251
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190251,
					"content": "#Verstanden! Überlasse es ruhig {NICKNAME} und Paimon! Was sagst du dazu, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190252,
						730190253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190252,
					"content": "Ich möchte auch glücklich sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190254,
					"content": "Wirklich? Ihr legt mich nicht herein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190255
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190255,
					"content": "Auf keinen Fall!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190256
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190256,
					"content": "Aber in Gandharva sind so viele Menschen, wie sollen wir ihn finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190257,
					"content": "Ich weiß. Vor Kurzem habe ich einen Nara gesehen, der auf dem <color=#00E1FFFF>Weg nach Gandharva</color> war. Er hatte den „Geschmack des Glücks“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190258
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190258,
					"content": "Er hatte einen großen Packen auf dem Rücken. Die Nara benutzen sie, um Dinge zu tragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190259
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190259,
					"content": "Ein großer Packen auf dem Rücken ... Hmm, <color=#00E1FFFF>sollte ein Gepäck oder ein Korb sein</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190260
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190260,
					"content": "Alles klar! Wir suchen den „Geschmack des Glücks“ für dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190253,
					"content": "Da ich Arapacati versprochen habe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190239,
					"content": "Oh! Paimon, wie fürchterlich!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190240
					]
				},
				{
					"id": 730190240,
					"content": "He! Paimon möchte dir nur helfen, Arasaka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190234,
					"content": "... Eine harte Luftblase?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190230,
					"content": "Was meinst du mit „Geschmack des Glücks“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190216,
					"content": "Das wissen wir längst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190217
					]
				},
				{
					"id": 730190217,
					"content": "Was! Das wisst ihr längst? Ihr habt es also die ganze Zeit schon auf mich abgesehen ... Was, was wollt ihr von mir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190218
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190218,
					"content": "Doch nicht etwa Zaytun-Pfirsiche? Nein, auf keinen Fall. Ich gebe euch alles, was ihr wollt, aber keine Zaytun-Pfirsiche, unter gar keinen Umständen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "Arasaka"
				}
			]
		},
