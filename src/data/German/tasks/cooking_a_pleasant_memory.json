				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Iaanesh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190401,
					"content": "Hallo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190402,
					"content": "Oh, hallo ... Was denn, wie kann ich euch helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190403
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190403,
					"content": "Gerne. Du hast etwas, was wir möchten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190404,
					"content": "Hehe, selbstverständlich! Alle möchten „etwas“ von mir. Aber ich weiß nicht, was „etwas“ heißen soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190405
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190405,
					"content": "Ah ... Paimon versteht. Wie soll ich sagen ... Wir möchten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190406,
					"content": "Etwas Weißes und Würfeliges ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190407
					]
				},
				{
					"id": 730190407,
					"content": "Etwas Weißes und Würfeliges?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190408
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190408,
					"content": "Genau! Richtig, und es zerbröselt wie Sand, wenn man es reibt, und es muss in einer harten Luftblase verpackt werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190409,
					"content": "Eine merkwürdige Beschreibung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190410
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190410,
					"content": "Bei eurer Beschreibung kann ich nur die Stirn runzeln. Aber dieses weiße, quadratische Ding ... wofür ist das gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190411
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190411,
					"content": "Der Nutzen. Den Nutzen kennt ihr, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190412,
						730190414
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190412,
					"content": "Zum Essen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190413
					]
				},
				{
					"id": 730190413,
					"content": "Ein essbares, weißes, würfeliges Ding ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190416,
					"content": "Ah! Ich weiß Bescheid! Ich weiß, was ihr möchtet ... Hahaha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190417
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190417,
					"content": "Was ist so lustig daran?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190418,
					"content": "Ach ja, hahaha, ich sage nur, etwas Weißes, Würfeliges, das beim Reiben zu Sand zerfällt ... und zum Essen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190419
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190419,
					"content": "Meint ihr etwa nicht „Zucker“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190420
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190420,
					"content": "Mit einer harten Luftblase ist doch ein Zuckerglastopf gemeint? Oh mein, eine harte Luftblase! Hahaha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190421
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190421,
					"content": "Was? Also Zucker ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190422,
						730190423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190422,
					"content": "Wie peinlich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190424,
					"content": "Ahahaha, mir kommen die Tränen. All die Jahre bin ich kopflos von Geschäft zu Geschäft gerannt, aber wann ich das letzte Mal so herzhaft gelacht habe, daran kann ich mich schon nicht erinnern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190425
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190425,
					"content": "Da fällt mir eine Sache ein! Vor langer, langer Zeit ... Als ich noch ein Kind war, aß ein Freund von mir zum ersten Mal Zucker und benutzte ähnliche Worte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190426
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190426,
					"content": "„Das weiße, würfelige Dinge schmeckt so gut! Unfassbar! Der Geschmack des Glücks.“ Er war so überrascht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190427
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190427,
					"content": "Haha ... Das ist schon so lange her. Wenn ich jetzt darüber nachdenke, kann ich mich nicht einmal mehr an sein Gesicht erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190428
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190428,
					"content": "Ach Gott! Als Dankeschön, dass ich so herzhaft lachen durfte, schenke ich euch den Topf Zucker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190429
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190429,
					"content": "Vielen Dank.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190430
					]
				},
				{
					"id": 730190430,
					"content": "Passt gut auf! Die harte Luftblase ist zwar hart, aber wenn sie auf den Boden fällt, dann zerplatzt sie trotzdem. „Harte Luftblase“! Hahahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190423,
					"content": "Wie unbehaglich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190414,
					"content": "Zum Kochen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190415
					]
				},
				{
					"id": 730190415,
					"content": "Ein weißes, würfeliges Ding zum Kochen? Etwa ein Gewürz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "Iaanesh"
				}
			]
		},
		{
			"id": 7301905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
