				"objectNames": [
					"Iaanesh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190501,
					"content": "Meine Familie treibt seit langem Geschäfte auf dieser Route, von der Großen Kluft nach Sumeru. Ich importiere Edelsteine aus Liyue und bringe Gewürze zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190502
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190502,
					"content": "Einmal war etwas passiert ... Ich erinnere mich nicht mehr, was es war. Jedenfalls hat mich mein Vater eine Weile in Gandharva behalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190503
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190503,
					"content": "Ich habe einen Freund im Wald kennengelernt. Wir waren überall, und dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190504
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190504,
					"content": "Ich erinnere mich nicht mehr, was danach passiert ist. Auch nicht, wie er hieß und wie er aussah ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190505
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190505,
					"content": "Ich erinnere mich nur, wie glücklich ich damals war. Dann hat mich mein Vater abgeholt. Ich habe darüber nachgedacht, ihn wieder aufzusuchen, aber ich hatte keine Gelegenheit dazu und habe es schließlich vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190506
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190506,
					"content": "Wenn du nicht Zucker von mir verlangt hättest, hätte ich die Sache schon längst vergessen. Wie kann das sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaanesh"
				}
			]
		},
		{
			"id": 7301906,
			"completionStepIds": [
				7301906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301906",
							"2"
						],
						"stepId": 7301906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arasaka",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190601,
					"content": "Das ist es! Wie habt ihr ihn so schnell gefunden ... Ist das wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190602
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190602,
					"content": "Ihr wollt mich doch nicht mit einem falschen Produkt hereinlegen, oder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190603
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190603,
					"content": "Etwas mit deiner Beschreibung zu fälschen, ist schier unmöglich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190604,
					"content": "Wenn du uns nicht glaubst, kannst du selbst probieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190605,
					"content": "... Ihr habt doch nicht etwas Seltsames hineingetan, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190606
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190606,
					"content": "Nein, natürlich nicht! Hmpf! Wenn du es nicht probierst, nehmen wir es dir weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190607,
					"content": "Nein, nein ... Ihr dürft ihn nicht wegnehmen! Ich, ich möchte probieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190608
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190608,
					"content": "Nicht wegnehmen! Ich probiere ja schon ... Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190609
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190609,
					"content": "Ah, es ist tatsächlich ... der „Geschmack des Glücks“! Das ist es ... Hehe, das ist nicht das erste Mal, dass ich es probiert habe, trotzdem bin ich glücklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190610
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190610,
					"content": "Oh, wer hätte gedacht, dass ich den Geschmack jemals wieder probieren dürfte ... Ah, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190611,
						730190612
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190611,
					"content": "Stimmt etwas nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190613
					]
				},
				{
					"id": 730190613,
					"content": "Hmm ... Wie soll ich sagen ... Der „Geschmack des Glücks“ schmeckt immer noch so wie früher, aber warum bin ich nicht so glücklich wie beim ersten Mal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190614
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190614,
					"content": "Ist der Zucker etwa nicht süß genug?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190615,
					"content": "Nein, der Geschmack ist gleich ... Aber als ich ihn damals mit meinem Freund gegessen habe ... Habe ich zum ersten Mal den „Geschmack des Glücks“ probiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190616
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190616,
					"content": "Ich war damals so viel glücklicher als jetzt. Was ist es nur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190617
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190617,
					"content": "#Das ist doch selbstverständlich! Ein Gericht schmeckt jedes Mal unterschiedlich, wenn {NICKNAME} kocht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190618,
					"content": "Auch Paimons Laune ist jedes Mal anders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190619,
						730190620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190619,
					"content": "Stimmt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190621
					]
				},
				{
					"id": 730190621,
					"content": "... Nein, nein. Bestimmt gibt es eine Methode, dass ich so glücklich bin wie damals, als ich den „Geschmack des Glücks“ zum ersten Mal probiert habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190622
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190622,
					"content": "Ich weiß! Damals habe ich ihn mit einem Freund gegessen. Das heißt, der „Geschmack des Glücks“ schmeckt nur mit Freunden gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190623
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190623,
					"content": "Bestimmt ist das der Fall. Ihr seid gute Nara, ihr habt den „Geschmack des Glücks“ gefunden. Ihr seid meine Freunde. Ich werde für euch kochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190624
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190624,
					"content": "Genau, wir sind Freunde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190625,
					"content": "Arasaka beginnt sogleich zu kochen und gibt die Zaytun-Pfirsiche und den Zucker in den Topf ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730190626
					]
				},
				{
					"id": 730190626,
					"content": "Danach übergibt Arasaka dir und Paimon das fertige Gericht.\\nUnd tatsächlich: Außer einer überwältigen „Süße“ schmeckt das Gericht nach nichts anderem.\\nVielleicht ist das der „Geschmack des Glücks“.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730190627
					]
				},
				{
					"id": 730190627,
					"content": "Ah, das ist der Geschmack des Glücks! So lecker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190628
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190628,
					"content": "Hmm, das Gericht ist wirklich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190629,
					"content": "Sehr „glücklich“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190630,
						730190631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190630,
					"content": "Zu süß ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190632
					]
				},
				{
					"id": 730190632,
					"content": "Paimon findet das Gericht auch etwas zu süß ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190633,
					"content": "Wirklich? Oh nein, ich habe zu viel hinzugegeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190634
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190634,
					"content": "Aber ... Hehe, es stimmt! Der „Geschmack des Glücks“ macht nur glücklich, wenn man ihn mit Freunden teilt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190635
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190635,
					"content": "Auch wenn das Glück des „Geschmacks des Glücks“ anders schmeckt als beim ersten Mal, aber eure Gesellschaft ... verleiht mir eine andere Art von Glück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190636,
						730190637
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190636,
					"content": "Solange du nur glücklich bist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190638
					]
				},
				{
					"id": 730190638,
					"content": "Am Anfang habe ich euch verdächtig, aber trotzdem habt ihr den „Geschmack des Glücks“ für mich gefunden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190639
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190639,
					"content": "Dank eurer Hilfe kann ich die „größte Delikatesse“ erreichen und die „Kochausbildung“ abschließen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190640
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190640,
					"content": "Nicht der Rede wert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190641,
					"content": "Auf, auf keinen Fall! Ihr habt mir einen großen Dienst erwiesen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190642
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190642,
					"content": "Übrigens, ich zeige euch, wie das Gericht geht. Dann könnt ihr den „Geschmack des Glücks“ später mit euren Freunden teilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190643
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190643,
					"content": "(Hmm ... Wenn wir die Mengen der Zutaten etwas verändern und noch etwas anderes hinzufügen würden, dann könnte das eine gute Süßigkeit abgeben ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190637,
					"content": "Ich hätte gern etwas Wasser ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190638
					]
				},
				{
					"id": 730190631,
					"content": "Ich brauche Wasser.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190632
					]
				},
				{
					"id": 730190620,
					"content": "Ist das so?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190621
					]
				},
				{
					"id": 730190612,
					"content": "Wo liegt das Problem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190613
					]
				}
			]
		},
