			},
			"dialogs": [
				{
					"id": 730190301,
					"content": "Wie, wie? Habt ihr den „Geschmack des Glücks“ gefunden? Er ist in Gandharva ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190302
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190302,
					"content": "Ein Nara mit einem großen Packen auf dem Rücken. Der „Geschmack des Glücks“ ist bestimmt in ihm verpackt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arasaka"
				}
			]
		},
		{
			"id": 7301904,
			"completionStepIds": [
				7301904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301904",
							"2"
						],
						"stepId": 7301904,
						"stateName": "QUEST_STATE_UNFINISHED"
