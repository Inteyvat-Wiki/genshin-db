			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190101,
					"content": "So sieht man sich wieder. Und, wie ist es euch so ergangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190102
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190102,
					"content": "Jilliana geht es übrigens im Augenblick nicht wirklich gut, aber auch nicht sonderlich schlecht. Das Gute ist, dass sie Mondstadt noch nicht verlassen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190103
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190103,
					"content": "Das nicht so Gute ist, dass sie ihre Situation bereits Ordensschwester Victoria gebeichtet hat und diese noch nichts dazu getan hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190104
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190104,
					"content": "Es bleibt abzuwarten, wie sich die Situation noch weiter entwickeln wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190105
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190105,
					"content": "Hast du etwa wieder einen Plan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190106
					]
				},
				{
					"id": 205190106,
					"content": "Guck mich nicht so fürchterlich an, ich bin schließlich kein schlechter Mensch und ich habe bereits viele Hinweise gegeben, wie man Jilliana retten kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190107
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190107,
					"content": "Dann lasst uns mal mit dem geschäftlichen Teil beginnen. Der Grund für unser heutiges Treffen ist das bisher ungelöste „kleine Problem“ von letztens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190108
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190108,
					"content": "Einfach gesagt, ihr habt zwar die Schatzräuber zurückgestoßen, aber zur gleichen Zeit auch Jillianas Tarnung aufgedeckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190109
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190109,
					"content": "Diese Schatzräuber sind noch nie zimperlich mit Verrätern umgegangen und allein um Mondstadt herum gibt es unzählige Banden, die meisten sogar unerkannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190110
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190110,
					"content": "Ich fürchte, sie wollten Jilliana Schwierigkeiten bereiten und ihre Verluste rächen. Jetzt liegt es an euch sie zu bekämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190111,
						205190113,
						205190115
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190111,
					"content": "Sieh nur, was du angerichtet hast.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190112
					]
				},
				{
					"id": 205190112,
					"content": "Ich habe auch nur meine Anweisungen und wäre der Herr nicht so beharrlich gewesen, euch diese Sache machen zu lassen, würde ich euch gar nicht weiter belästigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190113,
					"content": "Also soll ich es selbst lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190114
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190114,
					"content": "Sag doch so etwas Unfreundliches nicht! Ich besitze doch gar nicht deine Stärke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190115,
					"content": "Das ist eine Angelegenheit für den Ordo Favonius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190116
					]
				},
				{
					"id": 205190116,
					"content": "So gesehen ist das schon richtig. Aber dieser Herr hat angeordnet, dass möglichst wenige Leute von der jetzigen Situation, in der sich Jilliana befindet, erfahren sollten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190117
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190117,
					"content": "Außerdem möchte der Herr nicht, dass der Ordo Favonius in diese Angelegenheit involviert wird. Der Ritterorden hat nämlich den Ruf, etwas ungestüm zu sein und die Sache möglicherweise über Bord gehen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190118
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190118,
					"content": "Nehmen wir den verlässlichen Huffman: Wenn er erfahren würde, dass sich Schatzräuber in der Nähe von Mondstadt aufhalten, hätte er umgehend den Ritterorden verständigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190119
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190119,
					"content": "Sollte der Ritterorden wirklich mit geballter Kraft auftreten, so würden die Schatzräuber bestimmt das Weite suchen und unser Plan, sie ein für alle Mal zu zerschlagen, würde erneut scheitern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190120
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190120,
					"content": "Daher muss ich euch bitten, dieses Mal allein in den Kampf zu ziehen und sie vollständig zu beseitigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190121
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190121,
					"content": "Obwohl ... Diese Gruppe von Schatzräubern befindet sich schon so dicht an Mondstadt. Vielleicht hat der Ordo Favonius bereits Wind davon bekommen und ist bereit anzugreifen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190122
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190122,
					"content": "Aber das sollte uns jetzt kein Kopfzerbrechen bereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190123
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190123,
					"content": "Und keine Sorge, ich habe dieses Mal bereits eine hohe Belohnung für euch vorbereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190124
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190124,
					"content": "Wenigstens hat uns der Herr dieses Mal mit genügend Mora ausgestattet, nicht wie beim letzten Mal, als wir alles aus eigener Tasche zahlen mussten ... Ach übrigens, ich werde dir noch die Koordinaten der Schatzräuber einzeichnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190125
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190125,
					"content": "Egal wie es aussieht und wenn nur für die Mora, beschütze bitte Jilliana, Rudolf, Lily und Mondstadt. Alles liegt in deiner Hand, halte durch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051902,
