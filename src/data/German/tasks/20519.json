	"talks": [
		{
			"id": 2051901,
			"completionStepIds": [
				2051901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
