				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190301,
					"content": "Diese Schatzräuber ... ! Oh, Entschuldigung! Gibt es etwas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190302
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190302,
					"content": "Um Mondstadt herum halten sich Schatzräuber auf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190303
					]
				},
				{
					"id": 205190303,
					"content": "Schatzräuber? Wir sind mitten in den Vorbereitungen, diese Schatzräuber zu verfolgen. Wie kann dieser Abschaum es wagen, sich Mondstadt zu nähern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190304
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190304,
					"content": "Aber egal aus welchem Grunde, sie sind bestimmt nicht gut vorbereitet. Wir werden sie mit Streitkräften überrollen. Ich fürchte, zum jetzigen zeitpunkt kann ich deinen Bericht leider nicht mehr berücksichtigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190305
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190305,
					"content": "Erhalten habe ich ihn trotzdem und ich werde mich darum kümmern, sobald wir mit den Schatzräubern fertig geworden sind. Vielen Dank für deine Unterstützung und den Bericht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 2051904,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
