					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080402
					]
				},
				{
					"id": 210080402,
					"content": "Die Guili-Ebene besteht aus felsigem Grund. Deswegen sind einige Stellen sehr holprig, wie die Aussichtsplattform im Westen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080403
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080403,
					"content": "Im Osten Richtung Meer wird es aber flacher. Dort geht es zur Yaoguang-Untiefe, kann ich nur empfehlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
			"id": 2100805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080501,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080502
					]
				},
				{
					"id": 210080502,
					"content": "Also, die anderen füllen das Brennmaterial auf und ich bin dafür verantwortlich, es anzuzünden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080503
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080503,
					"content": "Das klingt zwar nicht nach viel Arbeit, aber jeder hat seinen Teil zu erfüllen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
