				"points": []
			},
			"dialogs": [
				{
					"id": 110000401,
					"content": "Die Wildschweine hier sind richtig schön dick und haben viel Bewegung. Das Fleisch wird zartschmelzend sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000402
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000402,
					"content": "Ah, davon bekomme ich Hunger ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				}
			]
		},
		{
			"id": 1100005,
			"completionStepIds": [
				1100005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100005",
							"2"
						],
						"stepId": 1100005,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"100061",
							"3"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiangling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110000501,
					"content": "Oho, so viel! Einen Teil davon werde ich einzeln anbraten, den anderen mit Champignons zusammen. Ein bisschen was werde ich noch mit Schleimabsonderung zubereiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000502,
						110000504
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000502,
					"content": "Und schon ist sie in ihrer eigenen Welt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000503
					]
				},
				{
					"id": 110000503,
					"content": "Sie scheint uns schon vergessen zu haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000506,
					"content": "Aaah, tut mir leid. Ich war abgelenkt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000507
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000507,
					"content": "Ich habe euch doch etwas Leckeres versprochen. Hier, probiert das mal! Und sagt mir, was ihr davon haltet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000508
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000508,
					"content": "Sind wir jetzt Essenstester geworden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000509,
					"content": "Oooh! Das ... Das ist ja superlecker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000510,
					"content": "Kannst du uns sagen, wie du das zubereitet hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000511,
					"content": "Hehe, sicher doch! Ich habe nur noch kein Rezept dazu geschrieben. Mal sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000512
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000512,
					"content": "Wie wäre es, wenn wir das Gericht einfach noch einmal zusammen zubereiten würden, damit du weißt, wie es geht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000513
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000513,
					"content": "Es ist bestimmt zu kompliziert, um es sich bei einer Zubereitung schon merken zu können ... Außerdem haben wir hier keinen Topf und auch nicht alle Zutaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000514,
					"content": "Ach, das sollte doch kein Problem sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000515
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000515,
					"content": "Wir können auf einem Stein braten. Dazu nehmen wir das Fett von den Wildschweinen. Wenn wir einen kleinen Ofen aus ein paar Steinen bauen, brauchen wir nur noch Holz und Stroh für das Feuer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000516
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000516,
					"content": "Für den Zucker nehmen wir Zuckerblumen. Salz finden wir sicher in der Gegend. Ich weiß noch, dass ich letzten in einer Höhle war, wo es viel davon gab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000517,
						110000518
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000517,
					"content": "Du scheinst das schon öfter gemacht zu haben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000519
					]
				},
				{
					"id": 110000519,
					"content": "Hehe, ich bin einfach aufgeregt, wenn ich ein neues Gericht zubereiten kann. Außerdem kann ich nicht jedes Mal meine ganze Küche mitnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000520
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000520,
					"content": "Wartet einen Augenblick! Ich werde alles vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000521
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000521,
					"content": "He, was macht ihr da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000601
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000601,
					"content": "Hier ist der Rückzugsort der Wildschweine. Ihr könnt hier nicht jagen! Sonst laufen sie noch alle weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000602
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000602,
					"content": "Wir müssen mit System jagen und können nicht einfach alle Wildschweine ausrotten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000603
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000603,
					"content": "Ah, ich verstehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000604
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000604,
					"content": "Nur in dieser für die Wildschweine so passenden Umgebung können sie so exzellentes Fleisch entwickeln! Aber wenn man sie verjagen würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000605
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000605,
					"content": "Nein, das wäre schrecklich für die Welt der Feinschmecker! Das wäre ein Verlust für die gesamte Menschheit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000606,
						110000607
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000606,
					"content": "So kann man es auch sehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000608
					]
				},
				{
					"id": 110000608,
					"content": "Entschuldige bitte! Ich habe nicht gedacht, dass das ein so großes Problem werden würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000609
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000609,
					"content": "Tja, ihr solltet bei Draff um Entschuldigung bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000610
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000610,
					"content": "Er ist der Anführer der Jäger hier. Ihm sind die Regeln besonders wichtig. Deswegen wird er mit Sicherheit sehr wütend sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000611,
						110000612
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000611,
					"content": "Was sollen wir denn jetzt tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000613
					]
				},
				{
					"id": 110000613,
					"content": "Wir sollten uns bei ihm entschuldigen. Schließlich war es unsere Schuld.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000614
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000614,
					"content": "Wir werden mitkommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000615
					]
				},
				{
					"id": 110000615,
					"content": "Hehe, danke euch. Sobald alles wieder in Ordnung ist, werde ich euch wieder etwas zu essen machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000616
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000616,
					"content": "Gut, mach dir keine Sorgen. Wir werden dich beim Wort nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000617,
					"content": "Dann mal los! Draff müsste in Quellingen sein.",
