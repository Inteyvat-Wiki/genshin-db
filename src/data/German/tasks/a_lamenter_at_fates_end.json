			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110501,
					"content": "Ist das hier ... das Ende?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110502
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110502,
					"content": "Was ist das?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110503
					]
				},
				{
					"id": 80110503,
					"content": "(In mehrere Ketten geschlagen, in der Luft hängend und von einer unheilvollen Aura umgeben ... Ganz richtig, es sieht einer „Entweihten Statue“ sehr ähnlich!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110504
					]
				},
				{
					"id": 80110504,
					"content": "(Steht das tatsächlich mit dem Orden des Abgrunds in Verbindung? Diese betenden Hilichurle erinnern ebenfalls sehr an „dieses Wesen“ von damals ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110505
					]
				},
				{
					"id": 80110505,
					"content": "Eide, das hier ist sehr bedrohlich, wir sollten schnell verschwinden!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110506
					]
				},
				{
					"id": 80110506,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110507
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110507,
					"content": "Eide?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110508
					]
				},
				{
					"id": 80110508,
					"content": "... Lebende ... Warum verbeugt ihr euch? Weil ihr das Unbekannte fürchtet? Weil ihr nach Macht giert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110509
					],
					"speakerTitle": "Herstellen"
				},
				{
					"id": 80110509,
					"content": "(Was ist das für eine Stimme, sie scheint in meinem Kopf zu ertönen ... Eide scheint sie nicht hören zu können?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110510
					]
				},
				{
					"id": 80110510,
					"content": "... Lebende ... Warum verbeugt ihr euch? Ich bin doch kein Gott, ich bin nur ein „Sünder“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110511
					],
					"speakerTitle": "Herstellen"
				},
				{
					"id": 80110511,
					"content": "(Ein „Sünder“ ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110512
					]
				},
				{
					"id": 80110512,
					"content": "Du unschuldige Blüte, geboren in Sünden, ich kenne dein Schicksal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110513
					],
					"speakerTitle": "Herstellen"
				},
				{
					"id": 80110513,
					"content": "Unterdrücke nicht deine Unzufriedenheit, toleriere diese ganzen Lügen nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110514
					],
					"speakerTitle": "Herstellen"
				},
				{
					"id": 80110514,
					"content": "Werde zu einer transzendenten Existenz, übertreffe das dir „zugewiesene Schicksal“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110515
					],
					"speakerTitle": "Herstellen"
				},
				{
					"id": 80110515,
					"content": "Ich werde am Ende der Zeit weinen ... wenn ich auf deine Geschichte zurückblicke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110516
					],
					"speakerTitle": "Herstellen"
				},
				{
					"id": 80110516,
					"content": "(... Wer bist du? Was haben diese Worte zu bedeuten?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110517
					]
				},
				{
					"id": 80110517,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110518
					],
					"speakerTitle": "Herstellen"
				},
				{
					"id": 80110518,
					"content": "(Die Stimme ... Sie ist fort ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110519
					]
				},
				{
					"id": 80110519,
					"content": "!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110520
					]
				},
				{
					"id": 80110520,
					"content": "... Eide?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110521
					]
				},
				{
					"id": 80110521,
					"content": "*keuch* ... Was ist gerade passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110522
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110522,
					"content": "In dem Augenblick, als ich dieses Ding gesehen habe, war mir, als ob meine sämtlichen Gefühle abgeebbt wären und dass nur eine unbeschreibliche Ehrfurcht ... und ein Gefühl des Glücks geblieben wären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110523
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110523,
					"content": "Geht es dir jetzt wieder besser?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110524
					]
				},
				{
					"id": 80110524,
					"content": "Ja, keine Sorge, ich fühle mich sehr gut ... Sogar viel besser, als zu dem Zeitpunkt, an dem wir in diese Höhle gekommen sind. Wie sonderbar ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110525
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110525,
					"content": "Hier stimmt irgendetwas nicht, wir sollten hier so schnell wie möglich weg.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110526
					]
				},
				{
					"id": 80110526,
					"content": "Mei... Meinst du? ... Also gut, wir machen es so, wie du sagst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110527,
					"content": "Nachdem ihr die sonderbare Höhle verlassen habt, kehrt ihr direkt zu Eides Haus zurück ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 801106,
			"completionStepIds": [
				801111,
				801112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"801111",
							"2"
						],
						"stepId": 801111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110601,
					"content": "Caribert, dem Himmel sei Dank, hier ist alles in Ordnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110602,
						80110603
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110602,
					"content": "Willst du nicht zur Statue der Sieben gehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110604
					]
				},
				{
					"id": 80110604,
					"content": "Ich ... Ich hatte nur ein vages Gefühl, dass diese Sache eben irgendeine Vorbestimmung des Schicksals war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110605
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110605,
					"content": "Dass gerade an dem Zeitpunkt, an dem ich die Götter am allerwenigsten anbeten wollte, diese Sache geschehen ist, scheint eine Art von Fingerzeig für mich gewesen zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110606
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110606,
					"content": "Dir zufolge habe ich mich anscheinend vor „jenem Ding“ auf die Knie geworfen. Vielleicht ... hatte das die erhoffte Wirkung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110607,
						80110608
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110607,
					"content": "Einfach unbegreiflich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110609
					]
				},
				{
					"id": 80110609,
					"content": "Egal, was du davon hältst, ich will es zunächst einmal versuchen ... Du hast es ja selbst gesagt, es „darf keine Möglichkeit ausgeschlossen werden“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110610
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110610,
					"content": "Er verabreicht dem Hilichurl ein weiteres Mal das Heilmittel ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80110611
					]
				},
				{
					"id": 80110611,
					"content": "Caribert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110612
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110612,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110613
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110613,
					"content": "Pa... Papa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110614
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110614,
					"content": "Ah ... Ah! Caribert! Himmel! Es ist wirklich wahr, das ist ein Wunder! Mein Caribert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110615,
						80110616
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110615,
					"content": "Wie kann es sein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110617
					]
				},
				{
					"id": 80110617,
					"content": "Siehst du, es hat gewirkt, Caribert kann wieder sprechen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110618
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110618,
					"content": "... Wo ... ist Mama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110619
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110619,
					"content": "Mama, sie ist ... Caribert, schau erst einmal mich an, kannst du mich erkennen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110620
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110620,
					"content": "Ja, du bist Papa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110621
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110621,
					"content": "Ha ... Hahaha ... Erlösung, ist das ... das Gefühl der Erlösung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110622
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110622,
					"content": "Wie fühlst du dich, Caribert, kannst du klar denken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110623
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110623,
					"content": "Ja ... Es kommt mir vor, als hätte ich lange geschlafen. In meinen Träumen habe ich mich in einem kleinen Haus versteckt und mich nie hinausgetraut und gleichzeitig wollte ich auch nicht hinausgehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110624
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110624,
					"content": "Ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110625
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110625,
					"content": "Mein Körper! Was ist mit meinem Körper! Bin, bin ich das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110626
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110626,
					"content": "Papa, was ... was ist passiert?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110627
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110627,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110628
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110628,
					"content": "... Beruhige dich, mein Sohn, es ist nur ... es ist nur, dass wir, während du geschlafen hast, in eine Märchenwelt gekommen sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110629
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110629,
					"content": "In dieser Welt existiert Khaenri’ah nicht länger. Unsere Heimat gibt es nicht mehr. Aber gleichzeitig gibt es auch keinen roten Himmel mehr und auch keine Katastrophen, die dem Weltuntergang gleichkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110630
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110630,
					"content": "Du wirst so, in der Form eines kleinen Fabeltiers, für immer mit Papa zusammen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110631
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110631,
					"content": "Bin ich ... Bin ich gestorben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110632
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110632,
					"content": "Nein, was redest du da? Caribert ... Schau mal, du hast an deinem Arm immer noch Mamas Seidentuch. Sie segnet und behütet dich, wie kannst du da gestorben sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110633
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110633,
					"content": "Wirklich ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110634
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110634,
					"content": "Ja. Du bist gerade erst aufgewacht und daher wohl noch ein wenig verwirrt. Ruhe dich erst einmal hier aus ... Alles wird gut werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110635
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110635,
					"content": "Ah, richtig ... Eines darfst du nicht vergessen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110636
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110636,
					"content": "Nimm die Maske nicht ab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110637
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110637,
					"content": "Hast du dir das gemerkt? Du darfst die Maske nicht abnehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110638
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110638,
					"content": "Ja ... Ja, Papa, ich habe es mir gemerkt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110639
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110639,
					"content": "Vater und Sohn reden noch eine ganze Weile miteinander und Eide macht den Eindruck, als ob ihm Erlösung zuteilgeworden wäre ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80110640
					]
				},
				{
					"id": 80110640,
					"content": "Seit jenem Tag war ich nicht mehr so glücklich wie heute ... Es ist tatsächlich wahr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110641,
						80110642
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110641,
					"content": "Ja ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110643
					]
				},
				{
					"id": 80110643,
					"content": "Hmpf, ich wusste, dass ich meine Hoffnungen nicht auf die Sieben setzen sollte. Pfui ... Ich war doch tatsächlich zur Statue der Sieben gegangen, um zu beten. Das ist wirklich die größte Schmach meines Lebens ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110644
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110644,
					"content": "Übeltäter, sie waren und werden niemals etwas anderes sein als Übeltäter. Sie um Rettung zu bitten, war wirklich allzu naiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110645
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110645,
					"content": "Stattdessen sind wir in der Höhle auf diesen unbekannten Gott getroffen, ein wahrhaft großer Gott, ganz anders als die Sieben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110646
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110646,
					"content": "Jene geheimnisvolle Kraft, die einen in ihren Bann schlägt ... Das war bestimmt, weil ich vorher fromm gebetet habe, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110647
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110647,
					"content": "Hmm, wenn man einen Gott um die Erfüllung eines Wunsches bittet und seine Hoffnungen dann tatsächlich Wirklichkeit werden, sollte man dann ... sollte man dann sein „Gelübde erfüllen“ oder wie nennt man das noch gleich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110648
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110648,
					"content": "Ich weiß nicht allzu viel über die Anbetung von Göttern, aber hierfür muss ich bestimmt mein „Gelübde erfüllen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110649,
						80110650
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110649,
					"content": "Aber ... das war gar kein Gott, Eide.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110651
					]
				},
				{
					"id": 80110651,
					"content": "Ein „Sünder“? Was redest du da? Was weißt du schon von jenem Gott. Wie kannst du es wagen, solch frevelhafte Dinge zu sagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110652
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110652,
					"content": "Du hast seine göttliche Macht doch mit eigenen Augen gesehen. Können die Sieben ein solches Wunder vollbringen? Er muss ein Gott sein, der über den Sieben steht. Ihn „Sünder“ zu nennen, ergibt doch einfach keinen Sinn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110653
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110653,
					"content": "Vergiss es ... Egal, was du auch davon hältst, es wird nichts an meinen Glauben an ihn ändern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110654
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110654,
					"content": "Ich werde jetzt gleich losgehen, um mein Gelöbnis zu erfüllen. Wenn du nicht mitkommst, ist mir das auch egal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110655,
						80110656
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110655,
					"content": "Ach, du ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110657
					]
				},
				{
					"id": 80110657,
					"content": "(Eides Verstand scheint beeinträchtigt worden zu sein ... Auch wenn er von vornherein nicht ganz normal war, ist sein Fanatismus jetzt doch etwas ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110658
					]
				},
				{
					"id": 80110658,
					"content": "(*seufz* Ich sollte ihm besser folgen. Immerhin waren dort ja auch viele Monster und ich will nicht tatenlos dabei zusehen, wie er ihnen in die Hände fällt ...)",
					"roleType": "TALK_ROLE_PLAYER",
