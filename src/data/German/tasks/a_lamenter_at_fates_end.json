				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110301,
					"content": "Halt, Menschen. Ihr habt nicht die Erlaubnis, an diesem Ort das „Schicksal“ zu erkunden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110302
					],
					"speakerTitle": "Schicksalsbote"
				},
				{
					"id": 80110302,
					"content": "(Ein Abgrundbote? Nein, ich habe im Orden des Abgrunds nie zuvor eine solche Gestalt gesehen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110303
					]
				},
				{
					"id": 80110303,
					"content": "Wie? Ihr besteht auf eine „Audienz“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110304
					],
					"speakerTitle": "Schicksalsbote"
				},
				{
					"id": 80110304,
					"content": "... Wie ihr wünscht, dann werde ich euch der „Prüfung des Schicksals“ unterziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Schicksalsbote"
				}
			]
		},
		{
			"id": 801104,
			"completionStepIds": [
				801108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"801108",
							"2"
						],
						"stepId": 801108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110401,
					"content": "Wer war das gerade? Das war einfach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110402,
						80110403
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110402,
					"content": "Hast du dich erschreckt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				},
				{
					"id": 80110404,
					"content": "... Einfach ein perfektes Geschöpf, wirklich atemberaubend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110405
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110405,
					"content": "... Hä?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110406
					]
				},
				{
					"id": 80110406,
					"content": "Er war von einer mysteriösen Aura umgeben und ihm war eine bedrohliche, aber gleichzeitig auch elegante Stärke zu eigen. Eine überaus anziehende Kombination.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110407
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110407,
					"content": "Nur gut, dass du mit einem solchen Wesen fertig geworden bist. Deine Kraft übersteigt meine Vorstellungskraft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110408,
						80110409
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110408,
					"content": "Du hast wirklich einen sonderbaren Geschmack.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110410,
					"content": "Lass uns weiter gehen. Meine Neugier und Aufregung nehmen immer weiter zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110409,
					"content": "Ich habe einfach nur reiche Erfahrung in solchen Dingen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110403,
					"content": "Ich bin schon einmal auf eine ähnliche Gestalt getroffen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				}
			]
		},
		{
			"id": 801105,
			"completionStepIds": [
				801110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
