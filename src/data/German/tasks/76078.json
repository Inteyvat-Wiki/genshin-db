						],
						"pointId": 13639
					}
				]
			},
			"dialogs": [
				{
					"id": 760780501,
					"content": "Hier steht auch eine Laterne des Eids ... Sie muss jemandem gehört haben, der vor uns da war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780502
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780502,
					"content": "Die Laterne ist noch von der Unreinheit der Wilden Jagd befleckt. Man kann sich schon denken, was hier geschehen ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780503
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780503,
					"content": "Seit dem Tag, an dem wir die Laterne des Eids erhoben haben, ist unser Leben mit der Flamme in der Laterne verbunden, bis ... der Moment kommt, in dem unsere Bestimmung erfüllt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780504
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780504,
					"content": "Ich verneige mich vor dir, tapferer Recke, der bis zum letzten Augenblick für den Frieden und die Sicherheit von Nod-Krai gestritten hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780505
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780505,
					"content": "Ich werde deine Laterne an mich nehmen und in Ehren verwahren. Sei versichert, dass eine Krone für die geehrte Seele für dich aufbewahrt wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780506
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780506,
					"content": "Ich werde sie zum Hauptquartier bringen, sie neu entflammen und dann jemandem übergeben, der diesen Willen weiterführen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780507
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780507,
					"content": "Illuga reinigt die Laterne und legt sie achtsam beiseite.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780508
					]
				},
				{
					"id": 760780508,
					"content": "Damit ist die Wilde Jagd hier endgültig gebannt, und die Seele des Helden hat ihre Ruhe gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		}
	]
}