					}
				]
			},
			"dialogs": [
				{
					"id": 760780401,
					"content": "Nach meiner Erfahrung hätte sich dieser Riss von selbst schließen sollen, nachdem wir die Monster in der Nähe vernichtet haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780402
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780402,
					"content": "Aber warum liegt die Aura der Wilden Jagd immer noch in der Luft ... Das ist wirklich merkwürdig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780403
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780403,
					"content": "Könnte es sein, dass ich etwas übersehen habe — etwas, das ebenfalls von der Unreinheit der Wilden Jagd durchdrungen wurde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
		{
			"id": 7607805,
			"completionStepIds": [
				7607804
