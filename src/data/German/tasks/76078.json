			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 760780301,
					"content": "(Auch wenn die Monster verschwunden sind, bleibt die Dunkelheit bestehen. Um das Problem hier zu lösen, ist möglicherweise die Hilfe von jemandem erforderlich, der sich mit der Wilden Jagd auskennt.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Betrachten"
				}
			]
		},
		{
			"id": 7607804,
