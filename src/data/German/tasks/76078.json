				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2423.771,
							211.958,
							9661.866
						],
						"pointId": 13639
					}
				]
			},
			"dialogs": [
				{
					"id": 760780201,
					"content": "Oh, eine Laterne. Als Lichthüter muss man sie bei sich tragen. Sie ist der Schlüssel, um die Wilde Jagd zu vertreiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780202,
					"content": "Die Lampe ist noch da, und es ist sogar noch der Geruch der Wilden Jagd auf der Laterne, aber die Person, zu der sie gehört, ist nirgends zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780203,
					"content": "So traurig es auch ist, das, was hier geschehen ist, liegt auf der Hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780204,
					"content": "Die Opfer der Lichthüter bleiben oft unbemerkt, wie ein Flüstern. Jedes Mal, wenn man auf solch unerwartete Weise vom Tod eines Kameraden erfährt, ist es ein schmerzlicher Moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780205,
					"content": "... Unbekannter Freund, ich werde mich um die Laterne kümmern, die du zurückgelassen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780206
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780206,
					"content": "Ihr Körper wird gereinigt und ihr Licht wird neu entzündet. Sie wird dem nächsten Lichthüter übergeben, der geschworen hat, Nod-Krai zu beschützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780207
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780207,
					"content": "Flins putzt die Laterne und verstaut sie mit großer Vorsicht.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780208
					]
				},
				{
					"id": 760780208,
					"content": "Das sollte der Grund sein, warum die Wilde Jagd nicht vollständig verschwinden kann. Ich werde diese Laterne vorerst behalten, bis jemand vom Hauptquartier kommt und sie abholt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780209
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780209,
					"content": "Etwas liegt unter der Lampe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780210
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780210,
					"content": "Das dürfte auch zu diesem Lichthüter gehören. Vielleicht sollte ich es zusammen mit der Laterne aufbewahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
		{
			"id": 7607803,
