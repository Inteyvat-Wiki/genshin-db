			"dialogs": [
				{
					"id": 760780101,
					"content": "Normalerweise sollte die unreine Energie verschwinden, wenn alle Monster, die mit der Wilden Jagd zusammenhängen, vernichtet sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780102,
					"content": "Aber diese Spalte ist noch immer da. Es ist ungewöhnlich, aber nicht außergewöhnlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780103,
					"content": "Schauen wir uns in der Nähe um. Hier sollte es noch etwas anderes geben, das von der Unreinheit kontaminiert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
		{
			"id": 7607802,
			"completionStepIds": [
				7607804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7607804",
