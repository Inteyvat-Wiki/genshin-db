			},
			"dialogs": [
				{
					"id": 750330401,
					"content": "Du bist gut geflogen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330402
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330402,
					"content": "#{NICKNAME}, was hältst du von meinem Flug?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330403,
						750330404
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330403,
					"content": "Sehr Gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330405
					]
				},
				{
					"id": 750330405,
					"content": "Ich danke dir für deine Ermutigung. Aber ich weiß, dass ich im Vergleich zu dir nicht so gut fliegen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330406
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330406,
					"content": "Acomitl ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330407
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330407,
					"content": "Es ist nicht so, wie ihr denkt. Ich bin nicht entmutigt, weil ich die anderen nicht übertreffen kann. Ich kann fliegen, ich weiß es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330408
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330408,
					"content": "Aber ich habe schon so lange eine schlechte Kondition, dass ich kein Selbstvertrauen mehr habe. Ich bin einfach nicht in der Lage, einen Flug mit Gelassenheit anzugehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330409
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330409,
					"content": "#{NICKNAME} ist da anders. {M#Seine}{F#Ihre} Haltung ist viel entspannter. Jeder, der Augen hat, kann das sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330410
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330410,
					"content": "Papa, ich weiß, dass du und meine Schwester wollen, dass ich meine eigene Entscheidung treffe und dem Problem nicht ausweiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330411
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330411,
					"content": "Aber wenn ich euch jetzt sagen würde, dass mein Körper, mein Gehirn oder mein Herz ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330412
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330412,
					"content": "... dass sie sich alle weigern, einen Weg zu gehen, der nicht für mich bestimmt ist, was würdet ihr dann denken? Würdet ihr mich dann immer noch so unterstützen, wie ihr es bisher getan habt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330413
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330413,
					"content": "Natürlich, solange es das ist, was du willst. Und solange du die Verantwortung für die Konsequenzen trägst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330414
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330414,
					"content": "Matahga, du wirst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330415
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330415,
					"content": "He! Ich werde dich in so einem Moment nicht kritisieren. Ich weiß genau, was für ein Mensch du bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330416
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330416,
					"content": "Wenn du nicht mehr kannst, gib auf. Solange du fair zu dir selbst bleibst, bist du immer noch ein Recke. Niemand hat das Recht, dich zu kritisieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330417
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330417,
					"content": "Manchmal ist die Aufgabe eines Trainingsexperten recht einfach. Ich mache Trainingspläne für unsere Recken, aber ich muss nicht persönlich trainieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330418
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330418,
					"content": "Aber auch ich hatte meine arbeitsreichen Tage, in denen ich ständig mit Sauriern herumflog, und ich weiß nur zu gut, wie dieses Leben aussieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330419
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330419,
					"content": "Es ist sehr leicht, andere zu kritisieren, denn es ist immer einfacher, zu reden als zu handeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330420
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330420,
					"content": "Als Trainer empfehle ich dir, einen Urlaub zu nehmen, um sich körperlich und geistig zu erholen, auch wenn dies zu Unzufriedenheit im Team führt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330421
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330421,
					"content": "Als Vater weiß ich, dass du nicht weitermachen willst, und ich respektiere diese Entscheidung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330422
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330422,
					"content": "Es ist kein großes Problem, die Flugstaffel zu verlassen. Fliegen ist nicht die einzige Möglichkeit für die Recken des Blumenfeder-Klans, ihren Wert unter Beweis zu stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330423
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330423,
					"content": "Danke ... Ich habe mir echt Sorgen gemacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330424
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330424,
					"content": "Mach dir keine Sorgen. Wir sind deine Familie und helfen dir bei jedem Problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330425
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330425,
					"content": "Paimon wusste nicht, dass es so schwer ist, ein Recke zu werden, und noch weniger, dass es so schwer ist, sich der Flugstaffel des Blumenfeder-Klans anzuschließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330426,
						750330428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330426,
					"content": "Wir haben unsere eigenen Schwierigkeiten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330427
					]
				},
				{
					"id": 750330427,
					"content": "Oh ja, du hast recht. Paimon ist richtig stolz auf uns. Schließlich haben wir auf unserer Reise eine Menge Hindernisse überwunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330430,
					"content": "Und wenn es schon nicht einfach ist, ein Recke zu werden, so ist es noch schwieriger, vom Recken zum Helden zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330431
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330431,
					"content": "Ich habe so viele Recken gesehen, dass ich weiß, wann jemand die Qualitäten hat, ein Held zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330432
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330432,
					"content": "Du hast viel durchgemacht, nicht wahr? Ich sehe es in deinen Augen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330433,
						750330434
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330433,
					"content": "Das kannst du dir gar nicht vorstellen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330435
					]
				},
				{
					"id": 750330435,
					"content": "Es scheint, dass ich mich nicht geirrt habe. Dein Weg ist anders als unserer, und vielleicht hast du noch einen langen Weg vor dir. Ich würde mich freuen, einem zukünftigen Helden zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330436
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330436,
					"content": "Außerdem kennst du meine Familie bereits. Eigentlich kann ich nicht viel mehr für dich tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330437
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330437,
					"content": "Aber ich kann dir die Trainingsrennstrecke anbieten, die wir hier haben. Sag mir einfach Bescheid und du kannst sie benutzen, wann immer du willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330438
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330438,
					"content": "Danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330439
					]
				},
				{
					"id": 750330439,
					"content": "Nichts zu danken. Wenn überhaupt, dann freue ich mich auf den Moment, wenn du als Held am Himmel strahlst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330434,
					"content": "(Schweigen)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330435
					]
				},
				{
					"id": 750330428,
					"content": "Nicht jeder kann ein Recke werden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330429
					]
				},
				{
					"id": 750330429,
					"content": "Ja, die Anforderungen sind sehr hoch. Jedenfalls will Paimon kein Recke sein. Keine Chance, den ganzen Tag zu trainieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330404,
					"content": "Nicht schlecht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330405
					]
				}
			]
		},
