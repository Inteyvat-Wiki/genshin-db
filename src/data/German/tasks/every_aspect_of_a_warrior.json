					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330502,
					"content": "Pff, Matahga! Du warst schon immer so! Du gehst immer aufs Ganze, schon mitten im Rennen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330503
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330503,
					"content": "Wenn du denkst, dass ich so nervig bin, dann versuch doch mal, mich einzuholen! Haha!",
