			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xueyoni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750330201,
					"content": "Flieg doch einfach mal mit. Es kommt nicht jeden Tag vor, dass du dich mit den besten Flugexperten vom Blumenfeder-Klan messen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330202
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330202,
					"content": "Jage die <color=#00E1FFFF>fliegende Fackel</color> auf der Rennstrecke. Wer sie zuerst fängt, gewinnt. So habe ich sie trainiert, als sie noch klein waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330203
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330203,
					"content": "<color=#00E1FFFF>Die Fackel ist an einem mit roten Federn geschmückten Ballon befestigt</color>, der die Verantwortung und Ehre symbolisiert, die ein Recke tragen muss. Ich habe sie für sie angefertigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330204
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330204,
					"content": "Du wirst es erkennen, wenn du es siehst. Was denkst du? Willst du es ausprobieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330205,
						750330207
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330205,
					"content": "Ich bin bereit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330206
					]
				},
				{
					"id": 750330206,
					"content": "Haha, super! Dann lasst uns zum Startpunkt gehen und uns bereit machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330207,
					"content": "Ich brauche noch Zeit für die Vorbereitung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330208
					]
				},
				{
					"id": 750330208,
					"content": "Sag uns Bescheid, wenn du so weit bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				}
			]
		},
		{
			"id": 7503304,
