			"dialogs": [
				{
					"id": 750330801,
					"content": "Schon wieder ein Rennen? Haha, du wirst schon sehen, wozu ich fähig bin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330802
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330802,
					"content": "Du bist ziemlich selbstbewusst. Komm schon, Acomitl, wir können hier nur gewinnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330803
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330803,
					"content": "Eine Niederlage gegen Manyoya kann ich akzeptieren, aber gegen Matahga muss ich auf jeden Fall gewinnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330804
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330804,
					"content": "#{NICKNAME}, du solltest auch dein Bestes geben. Lass dich von Matahgas Tricks nicht täuschen, das ist eine typische Strategie von ihm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330805
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330805,
					"content": "Wenn du bereit bist, sag meinem Vater Bescheid, und wir fliegen zusammen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Acomitl"
				}
			]
