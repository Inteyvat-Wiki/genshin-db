			"dialogs": [
				{
					"id": 750330101,
					"content": "Warum muss ich weitermachen? Warum kann ich nicht einfach aufgeben? Ich gebe auf! Hilf mir, Manyoya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330102
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330102,
					"content": "Das ist peinlich! Sei kein Kind, das aufgibt, wenn es nicht gut läuft. Wie kannst du dich Recke nennen? Ich schäme mich, dich Bruder zu nennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330103
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330103,
					"content": "Hast du auch denn manchmal nicht auch keine Ahnung, was du tun sollst, und brauchst Hilfe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330104
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330104,
					"content": "Das habe ich, und deshalb bin ich hier, um Papas und Manyoyas Meinung über die Früchte meines Spezialtrainings einzuholen. Ich bin kein Feigling wie du!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330105
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330105,
					"content": "Acomitl, ich nehme an, der Kapitän hat deinen Rücktritt abgelehnt, damit du es dir noch einmal überlegen kannst. Triff keine wichtigen Entscheidungen in der Hitze des Gefechts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330106
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330106,
					"content": "Beruhige dich und entscheide für dich selbst. Ich will nicht, dass du es später bereust.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330107
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330107,
					"content": "Ich bin im Ruhestand und selbst ich weiß nicht, was die Zukunft für mich bereithält. Deshalb glaube ich nicht, dass ich die beste Person bin, um dir Ratschläge zu geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330108
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330108,
					"content": "Waah! Ihr seid also alle drei Geschwister!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330109,
						750330110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330109,
					"content": "Das hätte ich nicht erwartet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330111
					]
				},
				{
					"id": 750330111,
					"content": "He, ihr beide seid gekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330112
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330112,
					"content": "#Schlechte Nachrichten, {F#meine Retterin}{M#mein Retter}. Mein Fluchtplan ist gescheitert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330113,
						750330114
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330113,
					"content": "Wie erwartet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330115
					]
				},
				{
					"id": 750330115,
					"content": "Kann ich diesem Schmerz nicht entkommen? Es ist so anstrengend, ein Recke zu sein. Warum kann es nicht einfacher sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330116
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330116,
					"content": "Du denkst immer noch an die Flugstaffel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330117
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330117,
					"content": "Es tut mir leid, Acomitl. Meiner Erfahrung nach wird es so nicht einfacher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330118
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330118,
					"content": "Aber ich habe gerade Matahgas Handschutz repariert. Manyoya, müssen deine auch repariert werden? Hm? Wir haben Gäste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330119
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330119,
					"content": "Papa, das sind Abenteurer, die wir während unserer Trainings kennengelernt haben. Sie haben sogar Acomitl geholfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330120
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330120,
					"content": "Dann seid gegrüßt, liebe Freunde. Ich bin Xueyoni, Trainer und ihr Vater.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330121
					],
					"speakerTitle": "Xueyoni",
					"speakerSubtitle": "Trainer des Blumenfeder-Klans"
				},
				{
					"id": 750330121,
					"content": "Paimon glaubt, dass es Acomitl nicht gut geht. Wenn du Hilfe brauchst, kannst du auf uns zählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330122,
					"content": "Danke für das Angebot, aber ich denke, Acomitl ist völlig in Ordnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330123
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330123,
					"content": "Hm? Du willst es also einfach ignorieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330124,
					"content": "Haha! Was ich damit sagen will, ist ... Also, ich erkläre es mal so. Ihr seid Abenteurer, also müsst ihr in der Gilde der Abenteurer sein, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330125
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330125,
					"content": "Das ist eine tolle Organisation. Ihr Abenteurer wollt doch die Welt erkunden, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330126
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330126,
					"content": "Ich kann mir aber vorstellen, dass jeder Abenteurer seine eigenen Motive hat. Einige tun es für Geld, andere für Wissen, und es gibt sogar solche, die es tun, um die Zeit totzuschlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330127
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330127,
					"content": "Es ist erstaunlich, all diese Menschen unter einem gemeinsamen Motto zu versammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330128
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330128,
					"content": "Nimm mich zum Beispiel. Ich bin ein alter Mann, der nach seinem Dienst als Reitmeister in der Flugstaffel in den Ruhestand getreten ist und nun Trainer in unserem Stamm ist. Dennoch kann ich mir nicht vorstellen, wie eine Gilde aussehen würde, die aus den Reitmeistern der Flugstaffeln aller sechs Stämme besteht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330129
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330129,
					"content": "Humm... Paimon ist verwirrt, was hat das alles mit Acomitl zu tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330130,
					"content": "So redet Papa. Als er noch bei der Flugstaffel war, hörten ihm alle gern zu, auch die Qucusaurier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330131
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330131,
					"content": "Jetzt ist er Trainer des Stammes, und alle, die Recken werden wollen, kommen, um seine Meinung zu hören. Habt etwas Geduld, hört euch an, was er zu sagen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330132
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330132,
					"content": "Hehe, das gehört alles der Vergangenheit an, Manyoya. Aber ich erzähle trotzdem weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330133
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330133,
					"content": "Wir Trainer streben nach dem Ideal des „Reckens“. Das ist es, was uns dazu inspiriert, uns die Zeit und Mühe zu nehmen, unsere Trainingsprogramme zu entwerfen und einzurichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330134
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330134,
					"content": "Jeder möchte den Recken, von dem er träumt, im echten Leben sehen, aber niemand kann entscheiden, wie er oder sie aussehen soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330135
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330135,
					"content": "Deshalb können wir Trainer keine Gilde mit bestimmten Grundsätzen und Zielen gründen. Wir wüssten nicht, welche wir festlegen sollten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330136
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330136,
					"content": "Dieser „größte Recke“ hat unzählige Gesichter und Persönlichkeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330137
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330137,
					"content": "Sie sind manchmal sehr willensstark, haben aber auch mit Selbstzweifeln zu kämpfen. Und sie werden auch altern und sterben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330138
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330138,
					"content": "Werden die Recken niemals müde werden? Ich kann viele Beispiele von Schriftrollen zitieren, die zeigen, dass Zweifel und Erschöpfung jeden gleichermaßen quälen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330139
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330139,
					"content": "Müssen Recken unbedingt groß sein? Ich kenne viele, die wie Riesen aussahen, aber dennoch über alle Maßen verachtenswert waren. Und solche sind auch in den Geweberollen festgehalten worden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330140
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330140,
					"content": "Und natürlich werden auch Recken schwach werden. Das ist das Gesetz der Natur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330141
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330141,
					"content": "Meine Kinder nennen mich einen Recken, aber sieh mich an, ich kann nicht mehr fliegen. Ich bin ein alter Vogel, der keine Kraft mehr zum Fliegen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330142
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330142,
					"content": "Ein Recke mit einem perfekten Gesicht, ein Mensch, der auch nur dem geringsten langweiligen Standard entspricht, wird hier in Natlan nicht als Recken anerkannt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330143
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330143,
					"content": "Manyoya, Acomitl, Matahga, ich habe euch hierhergebracht, weil ihr die Recken des Blumenfeder-Klans sein sollt, die aus großer Höhe herabschauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330144
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330144,
					"content": "Eure Sorgen und Wünsche sind vorübergehende Zustände auf der langen Reise des Recken, ihr müsst nichts dagegen tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330145
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330145,
					"content": "Wer sagt, dass du kein Recke bist, wenn du die Flugstaffel verlässt? Und wer sagt, dass du ein Recke bist, nur weil du der Flugstaffel beigetreten bist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330146
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330146,
					"content": "Es ist in Ordnung, Träume und Ambitionen zu haben, aber es ist auch in Ordnung, zu zweifeln oder sich niedergeschlagen zu fühlen. Du bist ein Recke, und ein Recke muss viel durchmachen, um zum Helden zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330147
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330147,
					"content": "Akzeptiere, wer du bist, lerne, mit diesem Zustand zu leben, und finde einen Weg, ihn zu überwinden und lass dich nie von ihm kontrollieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330148
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330148,
					"content": "Das ist es, was wir in Natlan machen, das ist es, was die Helden machen. Versteht ihr, was ich meine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330149
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330149,
					"content": "Ich verstehe, Vater.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330150
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330150,
					"content": "Acomitl, zögerst du noch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330151
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330151,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330152
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330152,
					"content": "Belehrungen sind nicht der Stil unserer Familie. Fliege noch einmal mit deinem Bruder und deiner Schwester, wie du es als Kind getan hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330153
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330153,
					"content": "Lass deinen Körper und deinen Geist gemeinsame die Entscheidung treffen. Du wirst nichts davon haben, wenn du zu Hause bleibst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330154
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330154,
					"content": "Alles klar, Papa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330155
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330155,
					"content": "#Was der Trainingsexperte sagte, war so abstrakt, dass Paimon nichts verstand. {NICKNAME}, hast du das verstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330156,
						750330157
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330156,
					"content": "Ja. Im Grunde handelt es sich um eine Flugherausforderung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330158
					]
				},
				{
					"id": 750330158,
					"content": "#Meine Kinder haben mir von dir erzählt. Du bist ein {F#faszinierendes Mädchen}{M#faszinierender junger Mann}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330159
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330159,
					"content": "Du hattest den Mut, gegen Manyoya zu kämpfen, dem kleinen Acomitl zu helfen ... Und du hast sogar die Anerkennung von Matahga gewonnen, du bist ein wahrer Recke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330160
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330160,
					"content": "Ich möchte dich einladen, mit diesen Kindern zu fliegen. Wie wäre es damit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330161,
						750330162
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330161,
					"content": "Super.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330163
					]
				},
				{
					"id": 750330163,
					"content": "Haha, gut. Komm zu uns, wenn du deine Entscheidung getroffen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330164
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330164,
					"content": "Meine drei Kinder sind die besten Flieger im Blumenfeder-Klan. Ich bin sicher, dass sie viel Spaß beim gemeinsamen Fliegen haben werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330162,
					"content": "Lass mich darüber nachdenken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330163
					]
				},
				{
					"id": 750330157,
					"content": "Nein. Familienerziehung ist zu tiefgreifend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330158
					]
				},
				{
					"id": 750330114,
					"content": "(Mit den Schultern zucken)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330115
					]
				},
				{
					"id": 750330110,
					"content": "Es war ziemlich offensichtlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330111
					]
				}
			]
		},
		{
			"id": 7503302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
