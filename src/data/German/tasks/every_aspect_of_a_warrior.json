					"Xueyoni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750330601,
					"content": "#Oh, ich habe wieder verloren. Sogar nach all dem Training habe ich gegen {M#ihn}{F#sie} verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330602
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330602,
					"content": "Das habe ich dir doch gesagt. Wenn man nur ans Gewinnen denkt, gibt es kein Ende. Ich ziehe meinen Hut vor deinem Mut, dich ohne Angst voranzukämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330603
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330603,
					"content": "Acomitl war als Kind auch so. Damals stand er immer hinter mir und sagte mir, dass es sein Traum sei, Saurierexperte zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330604
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330604,
					"content": "Hör auf, Manyoya ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330605
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330605,
					"content": "Ihr seid alle meine guten Kinder und auch gute Recken. Wie alle Recken müsst ihr euch zu verschiedenen Zeiten verschiedenen Herausforderungen stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330606
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330606,
					"content": "Es ist alles in Ordnung. Ich werde stolz auf euch sein, solange ihr eurem Herzen treu bleibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				}
			]
		},
