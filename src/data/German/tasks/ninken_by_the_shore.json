			"dialogs": [
				{
					"id": 191170106,
					"content": "Wuff, wuff! *knurr*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170107
					],
					"speakerTitle": "Ninken"
				},
				{
					"id": 191170107,
					"content": "Du bist ein bösartiges kleines Ding, nicht wahr? Du hättest mich fast wieder gebissen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170108
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170108,
					"content": "Ich meine, du bist am Verhungern, es wird Zeit, dass du etwas isst, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170109
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170109,
					"content": "Auch wenn du nicht denkst, mit mir zurückzugehen, ist es doch nicht nötig, überhaupt nichts zu essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170110
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170110,
					"content": "Machst du dir Sorgen über Gift im Essen? Ich werde das Essen selbst probieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170121
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170121,
					"content": "Jetzt gibt es keine Probleme mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170111,
						191170112
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170111,
					"content": "Thoma ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				},
				{
					"id": 191170113,
					"content": "Hier, iss ein bisschen. Wie wär’s mit ein paar Bissen und ich störe dich heute nicht mehr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170114
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170114,
					"content": "Wuff! Wuff, Wuff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170115
					],
					"speakerTitle": "Ninken"
				},
				{
					"id": 191170115,
					"content": "Er isst unser Essen gar nicht ... Er sieht immer aufgeregt und unruhig aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170116
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170116,
					"content": "Ist da etwas im Meer? Oder gibt es etwas in der Nähe, das ihn misstrauisch macht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170117
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170117,
					"content": "Sind es die Monster?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170118
					]
				},
				{
					"id": 191170118,
					"content": "Willst du damit sagen, dass er von den Monstern um ihn herum angegriffen wurde? Das ist möglich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170119
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170119,
					"content": "Man kann doch nicht unter gefährlichen Bedingungen essen, oder? Helfen wir ihm, die Umgebung zu säubern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170120
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170120,
					"content": "#Danke, dass du mitgeholfen hast. Lass uns die Monster besiegen, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170112,
					"content": "Du gibst dir wirklich Mühe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				}
			]
		}
	]
