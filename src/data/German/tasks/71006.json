			"dialogs": [
				{
					"id": 710060801,
					"content": "Das geht doch nicht ... Das kann nicht stimmen. Die Augen dieser Statuen leuchten nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060802
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060802,
					"content": "Ist meine Perspektivtechnik irgendwie falsch? Nein, das ist unmöglich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060803
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060803,
					"content": "Augen ... Welche Augen? Diese Statue hat überhaupt keine Augen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
