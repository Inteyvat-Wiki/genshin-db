						710060702
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060702,
					"content": "Was diesen Stein angeht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060703
					]
				},
				{
					"id": 710060703,
					"content": "Dieser Stein? Warum interessierst du dich plötzlich dafür?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060704
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060704,
					"content": "Ich hob ihn auf, als ich nach einer guten Perspektive am <color=#00E1FFFF>Luhua-See</color> suchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060705
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060705,
					"content": "Willst du zum <color=#00E1FFFF>Luhua-See</color> gehen und dich umschauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060706
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060706,
					"content": "Du musst genau hinsehen. In diesem See sind alle möglichen Dinge, und ich habe keine Ahnung, wer sie da hineingeworfen hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
