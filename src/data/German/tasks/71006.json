			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060601,
					"content": "Hast du meine Malutensilien gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060602
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060602,
					"content": "Ja, habe ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060603
					]
				},
				{
					"id": 710060603,
					"content": "Genau wie ich dachte! Ich habe sie an der Stelle zurückgelassen, von der aus ich meine Inspiration zog. Ich lege für gewöhnlich die Dinge, die ich benutzt habe, auf den Boden, während ich male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060604
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060604,
					"content": "Wenn ich in zu großer Eile bin, lasse ich oft viele Dinge zurück. Ich danke dir vielmals. Wenn du nicht gewesen wärst, müsste ich zurück in die Stadt gehen, um mich neu einzudecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060605
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060605,
					"content": "Willst du hier weiter malen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060606
					]
				},
				{
					"id": 710060606,
					"content": "Kein Wort davon. Ich habe Leute sagen hören, dass diese beiden Statuen Augen haben, die leuchten können, und dass man das schon von weitem sehen könne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060607
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060607,
					"content": "Gigantische Statuen mit leuchtenden Augen, die neben einem Berg Wache stehen ... Das wäre sicher ein großartiges Gemälde geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060608
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060608,
					"content": "Aber als ich hier ankam, waren zwar die Statuen da, aber keine leuchtenden Augen waren zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060609
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060609,
					"content": "Ich glaubte, dass ich vielleicht den richtigen Zeitpunkt verpasst habe oder dass meine Perspektive falsch war, deshalb bin ich etwas herumgelaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060610
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060610,
					"content": "Aber egal wo ich stehe, die Landschaft scheint sich nicht zu verändern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060611
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060611,
					"content": "Das ist alles, was ich aus der ganzen Sache rausbekommen habe. Ich habe das in dem Teich da unten gefunden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060612
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060612,
					"content": "Hmm, ich habe auch eines gefunden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060613
					]
				},
				{
					"id": 710060613,
					"content": "Wirklich? Lass mich mal sehen. Nein, ich habe nie – sie sind identisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060614
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060614,
					"content": "Seltsam. Da sind sogar Worte auf der Rückseite eingeritzt. Und was sagen sie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060615
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060615,
					"content": "„Die steinernen Wächter hüten das Tor, gegen alle, die ihm nicht den letzten Schliff geben ...“ Was soll das bedeuten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060616
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060616,
					"content": "Dieser Stein nützt mir ohnehin wenig, warum nimmst du ihn nicht? Sieh ihn als Dank dafür an, dass du mir geholfen hast, meine Werkzeuge zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060617
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060617,
					"content": "Ich habe da eine Idee. Es ist nur eine wilde Spekulation, aber meinst du nicht, dass diese beiden Steine ein bisschen wie Augen aussehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060618
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060618,
					"content": "Wenn das wirklich Augen sind, könnte es sein, dass der „letzte Schliff“ etwas mit diesen beiden Steinen zu tun hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060619
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060619,
					"content": "Es ist nur eine Vermutung, also denk nicht zu viel darüber nach. Ich suche jetzt nach neuen Perspektiven. Danke, dass du meine Werkzeuge gefunden hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
