			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060101,
					"content": "Oh, das ist furchtbar. Wie soll ich so malen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060103
					]
				},
				{
					"id": 710060103,
					"content": "Du ... Oh, du bist es, Reisender. Also, hier ist das Problem: Ich habe rund um den Luhua-See nach Inspiration gesucht, und ich wollte ein paar Bilder malen, die ich mit zurückbringen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060104,
					"content": "Aber ich habe keine gute Perspektive finden können, und deshalb war keines meiner Bilder bisher befriedigend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060105,
					"content": "Ich war so sehr damit beschäftigt, die Landschaft zu erfassen, dass ich erst bei meiner Ankunft hier merkte, dass die meisten meiner Pinsel und Farben verschwunden waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060106,
					"content": "Ich muss sie wohl in den letzten Stellen vergessen haben, an denen ich Bilder gemalt hatte. Könntest du mir helfen, sie zu suchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060107,
						710060110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060107,
					"content": "Wo hast du diese Bilder gemalt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060108
					]
				},
				{
					"id": 710060108,
					"content": "Äh, ehrlich gesagt ... Ich erinnere mich selbst nicht mehr so genau. Ich war jedes Mal zu sehr in meine Malerei vertieft, um mir viel Gedanken um meine Umgebung zu machen, deshalb kann ich dir keine sehr spezifischen Stellen nennen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060109,
					"content": "Aber ich habe nur zwei Bilder in dieser Gegend gezeichnet, also kommen nur diese beiden Stellen in Betracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060113,
					"content": "Ich gebe dir diese beiden Bilder. Ich bin mir sicher, dass ich meine Malutensilien an den Stellen, die ich als <color=#00E1FFFF>Inspiration für diese Gemälde</color> verwendet habe, vergessen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060114
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060114,
					"content": "Wenn du sie gefunden hast, bring sie mir bitte zurück. Ich suche hier weiter ... Ich denke, dass es hier eine bessere Perspektive gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060110,
					"content": "Aber wo soll ich anfangen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060111
					]
				},
				{
					"id": 710060111,
					"content": "Ich war jedes Mal zu sehr in Gedanken vertieft, um auf meine Umgebung zu achten, deshalb kann ich mich nicht an Einzelheiten erinnern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060112,
					"content": "Aber ich habe nur zwei Bilder in dieser Gegend gemalt, also kommen nur diese beiden Stellen in Betracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 7100602,
