			"dialogs": [
				{
					"id": 710061001,
					"content": "Oh ... So ist das also! Diese beiden Steine sind wirklich die Augen der zwei Statuen. Ihre Augen werden erst leuchten, wenn du diese Steine eingesetzt hast ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710061002
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710061002,
					"content": "Anscheinend werde ich doch noch etwas Großartiges malen können! Ich mache mich auf und suche nach einer guten Perspektive! Ich danke dir vielmals!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710061003
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710061003,
					"content": "Wundervoll, absolut wundervoll ...",
