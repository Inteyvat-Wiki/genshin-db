			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060201,
					"content": "Wow! Hast du den Kerl da eben gesehen?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060202,
						722060203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722060202,
					"content": "Nein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060204
					]
				},
				{
					"id": 722060204,
					"content": "Nun ... das war komisch. Lass uns noch ein paar Pilze sammeln und dann abhauen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722060203,
					"content": "Das ist eine Illusion, denke ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060204
					]
				}
			]
		},
		{
			"id": 7220603,
			"completionStepIds": [
				7220605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220604",
							"3"
						],
						"stepId": 7220604,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220605",
							"2"
						],
						"stepId": 7220605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Abe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060301,
					"content": "He! Habe ich euch nicht gewarnt? Habt ihr schlechte Ohren oder keine Augen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060302
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060302,
					"content": "Oh, ein Geist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060303
					]
				},
				{
					"id": 722060303,
					"content": "Wo? Wo ist ein Geist?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060304,
						722060305
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060304,
					"content": "Hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				},
				{
					"id": 722060306,
					"content": "Ah, geh weg! Mein Name ist Abe, bitte geh weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060307
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060307,
					"content": "Oje! In all meinen Lebensjahren habe ich noch nie einen so bösartigen Geist gesehen! Warum gehst du nicht jetzt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060308
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060308,
					"content": "Ich komme von außerhalb der Insel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060309
					]
				},
				{
					"id": 722060309,
					"content": "Ein böser Geist von jenseits des Nebels ... hmpf, ich habe keine Angst vor dir! Bleib hier und warte, bis dich der Donnervogel vertreibt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060310,
						722060311
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060310,
					"content": "Der Donnervogel wird nicht mehr kommen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060312,
					"content": "Was meinst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060313,
						722060314
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060313,
					"content": "Alle sind fort.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060315,
					"content": "Was ... Wovon redest du? Sag nichts, was mir Angst macht ... meine Gänsehaut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060316
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060316,
					"content": "Aber ... die Insel wird immer weniger bevölkert ... Kina sagte vorhin, dass alle eine Bootsfahrt gemacht haben ... Nun, ich frage mich, wo das Kind zum Spielen hingegangen ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060317
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060317,
					"content": "Übrigens, böser Geist von außerhalb der Insel, willst du nicht gehen ...? Zum silbernen Boot?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060318,
						722060319
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060318,
					"content": "Ich sehe kein Boot.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060320,
					"content": "Ich wusste es ... ich wusste, dass das Boot für Wesen außerhalb der Insel unsichtbar ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060321
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060321,
					"content": "Danke, dass du mich zum Boot schicken willst, böser Geist von außerhalb der Insel. Aber ... ich habe so viele Jahre gelebt und so viele Dinge gesehen, dass ich es nicht ertragen kann, wegzugehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060322
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060322,
					"content": "Was brauchst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060323
					]
				},
				{
					"id": 722060323,
					"content": "Brauchen? Ich brauche nicht wirklich was ... ich bin nur noch neugierig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060324
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060324,
					"content": "Als ich sehr, sehr jung war, habe ich einmal mit Una gewettet ... Ich sagte, dass es außerhalb der Insel verschiedene Pilze geben muss, aber sie glaubte mir einfach nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060325
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060325,
					"content": "Dann ... fuhr ihr Mann zur See in das Land der Außenstehenden und kehrte nicht mehr zurück ... und sein Geist wurde zurückgelassen, um im Land der Außenstehenden umherzuwandern ... armer Mann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060326
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060326,
					"content": "Una hat also bis jetzt ihr Leben alleine gelebt ... allein der Gedanke daran macht mich ... hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060327,
						722060328
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060327,
					"content": "Bitte denke nicht an jemand anderen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060329,
					"content": "Ich habe sogar den Priester angefleht ... gebt den Leuten wenigstens ein Zuhause ... hä? Oh, ja, ja, Pilze!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060330
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060330,
					"content": "Ich bin dabei, das Boot zu besteigen, und ich habe nichts zu bedauern ... außer, dass ich nichts von der Insel gesehen habe. Aber was mich am meisten beunruhigt sind die Pilze, um die ich mich jeden Tag gekümmert habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060331
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060331,
					"content": "Bringe mir bitte einfach ein paar Pilze von außerhalb des Nebelmeeres ... und zeig mir etwas Neues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060332
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060332,
					"content": "Bitte, böser Geist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060328,
					"content": "In Sachen Pilze ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060319,
					"content": "Das Boot ist nicht für mich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060314,
					"content": "Es ist Zeit für den Abschied.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060311,
					"content": "Das Nebelmeer ist die Vergangenheit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060305,
					"content": "Hier bin ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				}
			]
		},
		{
