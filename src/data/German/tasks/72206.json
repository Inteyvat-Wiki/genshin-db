				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Abe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060501,
					"content": "Oooooh! Haha ... was für eine seltsame Form! Haben sie einen eigenen „Geist“? Enthalten sie auch die Erinnerungen von Menschen ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060502
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060502,
					"content": "Und das hier ... weich und flauschig, ein wenig flügelartig ... fliegt er ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060503
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060503,
					"content": "Es tut mir leid, aber es ist endlich an der Zeit an Bord zu gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				}
			]
		}
	]
