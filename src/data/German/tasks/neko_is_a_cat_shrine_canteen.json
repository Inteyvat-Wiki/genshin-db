			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"„Neko“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140101,
					"content": "Das ist ... wirklich großartig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140102
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722140102,
					"content": "Ist die Steinskulptur fertig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140103
					]
				},
				{
					"id": 722140103,
					"content": "Anfangs sah mir dieser Stein überhaupt nicht ähnlich. Aber je genauer man hinsieht, desto mehr Ähnlichkeiten entdeckt man.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140104
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722140104,
					"content": "Ihr Menschen seid wirklich unglaublich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140105
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722140105,
					"content": "Es ist sehr laut, ja. Aber meine Wenigkeit ist die vorläufige Oberpriesterin. Solche trivialen Angelegenheiten sind es nicht wert, dass man sich darüber beschwert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140106
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722140106,
					"content": "Bring dem großen Menschen diese Fische.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140107
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722140107,
					"content": "Die sind was Gutes, im Prinzip wie eine ... „Vergnügung“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140108,
						722140111
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722140108,
					"content": "Nur Fisch?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140109
					]
				},
				{
					"id": 722140109,
					"content": "Miau, ich habe Konbumaru dazu gebracht, diesen Kindern beibringen zu wollen, wie man Finken fängt. Aber das klappte nicht so recht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140110
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722140110,
					"content": "Fischen fällt den Kleinen immer noch am leichtesten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722140111,
					"content": "Eine „VerGÜTung“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140112
					]
				},
				{
					"id": 722140112,
					"content": "Miau, miau, miau, du nervst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140113
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722140113,
					"content": "Bring sie ihm einfach. Schließlich sind sie ja was Gutes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				}
			]
		},
		{
			"id": 7221402,
			"completionStepIds": [
				7221402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221402",
							"2"
						],
						"stepId": 7221402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140201,
					"content": "Nun, sie sieht jetzt wirklich so aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140202
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140202,
					"content": "Haha, du bist es. Findest du, dass sie der Frau Priesterin jetzt ein wenig ähnlicher sieht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140203,
						722140205
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140203,
					"content": "Auf jeden Fall.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140204
					]
				},
				{
					"id": 722140204,
					"content": "Nicht wahr? Ah, ich habe ja schließlich einige Nächte durchgearbeitet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140207
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140207,
					"content": "Ah, ich bin ziemlich hungrig ... Wird Zeit, nach etwas Essbarem zu suchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140208
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140208,
					"content": "Neko schickt dir Fische.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140209
					]
				},
				{
					"id": 722140209,
					"content": "Hmm, nun, ich danke der Frau Priesterin, aber ... ähm ... Ich glaube, ich besorge mir selbst was zu essen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140210
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140210,
					"content": "Ich esse jetzt schon seit einigen Tagen nur Fisch. Ich glaube nicht, dass ich noch einen davon runterkriege ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140211
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140211,
					"content": "Ich wollte gerade aufbrechen, um was zu jagen oder zu sammeln. Wenn ich Glück habe, erwische ich einen Finken oder eine Taube ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140212
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140212,
					"content": "*seufz* Aber weißt du, ich hätte gern etwas richtiges Fleisch. Festes, saftiges Fleisch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140213
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140213,
					"content": "#Also, ähm, {F#Reisende}{M#Reisender} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140214
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140214,
					"content": "Wärst du so lieb und besorgst mir drei Portionen rohes Fleisch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140215
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140215,
					"content": "Ich bin kein guter Jäger, deshalb habe ich in den letzten Tagen kein Fleisch gekriegt ... Bitte hilf mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140216,
						722140217
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140216,
					"content": "Na gut ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140220
					]
				},
				{
					"id": 722140220,
					"content": "Bitte hilf mir. Drei Portionen reichen bestimmt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140217,
					"content": "Wolltest du nach Narukami zurück, um zu essen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140218
					]
				},
				{
					"id": 722140218,
					"content": "Na ja, erstens ist die Insel ziemlich weit weg. Und zweitens ... hat mich bei meiner Skulptur gerade die Muse geküsst. Würde ich an diesem Punkt aufhören, ginge das auf Kosten meiner Inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140219
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140219,
					"content": "Ich will lieber hier schnell was essen und gleich wieder weiterarbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140220
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140205,
					"content": "Sie ist viel größer, keine Frage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140206
					]
				},
				{
					"id": 722140206,
					"content": "Na ja, natürlich. Die Frau Priesterin ist um einiges größer als eine gewöhnliche Katze. Aber wenn man eine erhabenere Statue haben will, muss die noch größer sein. Immerhin ziert sie einen Schrein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140207
					],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
		{
