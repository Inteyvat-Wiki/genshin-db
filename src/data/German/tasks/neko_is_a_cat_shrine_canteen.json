			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221403",
							"2"
						],
						"stepId": 7221403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140401,
					"content": "Oooh ... die Marmorierung ... Vielen Dank, ihr zwei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140402
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140402,
					"content": "Ich werde gleich ein paar köstliche Gerichte zaubern. Mit etwas Glück werde ich nach dem Essen sogar schneller fertig, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140403
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140403,
					"content": "Und wieso das nochmal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140404
					]
				},
				{
					"id": 722140404,
					"content": "Ordentlich Fleisch im Magen gibt einem die Kraft, um weiterzumachen! Bei Fisch ist das etwas anderes. Ich hatte immer das Gefühl, dass meine Hände zu schwach für die Arbeit wären ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140405
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140405,
					"content": "Ehrlich! Langsam habe ich mir Sorgen gemacht, dass ich für die ganze Statue länger brauchen würde als geplant. Nun, dank dir ist das jetzt kein Problem mehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140406
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140406,
					"content": "Ich meine, mein Auftraggeber ist ... eine Katze, das stimmt schon. Aber es ist nie gut, um eine Fristverlängerung bitten zu müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140407
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140407,
					"content": "Wie dem auch sei, ich werde sie so schnell wie möglich fertigstellen ... Da fällt mir ein, die Frau Priesterin meint, dass etwa Gutes geschehen wird, wenn die Statue fertig ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140408
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140408,
					"content": "Ich weiß nicht, was sie damit genau meint, aber na ja ... Ich freue mich schon darauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140409
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140409,
					"content": "Komm später wieder zurück und sieh dir das fertige Werk an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		}
	]
}