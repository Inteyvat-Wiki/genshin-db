			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verut"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060201,
					"content": "Ah, du hast mich doch gefunden. Du bist einfach besser als ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060202
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060202,
					"content": "Dann gehe ich mal zurück zum Treffpunkt. Hoffentlich findest du meinen Bruder nicht zu früh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060203
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060203,
					"content": "Wieso hoffst du das?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060204
					]
				},
				{
					"id": 240060204,
					"content": "Mein Bruder hat gesagt, dass er nach dem Versteckspielen immer viele neue Ideen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060205
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060205,
					"content": "So viele Ideen, dass er sich hinhocken muss, um sie sich alle zu merken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060206
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060206,
					"content": "Lovi hat mir gesagt, dass die Ideen ganz wichtig sind und wir ihn nicht stören dürfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060207
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060207,
					"content": "Wenn wir mit meinem Bruder Verstecken spielen und er gefangen werden muss, nehmen Lovi und ich uns deswegen extra viel Zeit, ihn zu fangen, bis er sich alles gemerkt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060208
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060208,
					"content": "Nur ... wenn mein Bruder an der Reihe ist, werden wir lange auf ihn warten müssen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
		{
			"id": 2400603,
			"completionStepIds": [
				2400603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
