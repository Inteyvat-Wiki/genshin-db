			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aurèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060301,
					"content": "So nicht ... Dieser Absatz ist nicht stringent, das verlangt eine andere Perspektive ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060302
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060302,
					"content": "Das ist ... nicht richtig, gar nicht richtig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060303
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060303,
					"content": "Oh? Ich wurde gefunden. Dann gehe ich zurück zum Treffpunkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060304
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060304,
					"content": "Hm ... Ist das der korrekte Ansatz? Nein, hmm ... Richtig ... oder falsch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				}
			]
		},
		{
			"id": 2400604,
			"completionStepIds": [
				2400604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400604",
