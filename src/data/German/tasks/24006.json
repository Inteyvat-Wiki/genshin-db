					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lovi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060401,
					"content": "Ob Aurèle wohl schon eine Idee hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060402,
					"content": "Was?! Du kannst diesen Ort sogar finden! Oha, wie oft hast du eigentlich schon Verstecken gespielt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060403
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060403,
					"content": "Dann gehe ich mal zurück zum Treffpunkt. Das nächste Mal suche ich mir bestimmt ein besseres Versteck.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
		{
			"id": 2400606,
			"completionStepIds": [
				2400606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400606",
							"2"
						],
						"stepId": 2400606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aurèle",
					"Lovi",
					"Verut"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3498.448,
							281.167,
							4542.663
						],
						"pointId": 340100170
					}
				]
			},
			"dialogs": [
				{
					"id": 240060601,
					"content": "Nein, falsch ... Dieses Argument ist nicht schlüssig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060602
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060602,
					"content": "Aurèle bemerkt uns schon wieder nicht mehr ... Danke, dass du mit uns spielst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060603,
						240060604
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060603,
					"content": "Ist ... mit ihm alles in Ordnung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060605
					]
				},
				{
					"id": 240060605,
					"content": "Solange er den Kaffee nicht wie Wasser in sich hineinstürzt wie mein Papa, sollte es ihm gut gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060606
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060606,
					"content": "Dafür sorge ich schon. Nein, ich lasse meinen Bruder nicht zu viel Kaffee trinken ... Ich verstecke seinen ganzen Kaffee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060607
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060607,
					"content": "Ach, ich hatte auch vor, Papas Kaffee hier zu verstecken. Das ist wohl keine gute Option.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060608
					],
					"speakerTitle": "Lovi"
				},
				{
