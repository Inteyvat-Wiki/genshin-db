			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verut",
					"Lovi",
					"Aurèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060101,
					"content": "Jetzt bin ich an der Reihe. Ich werde dich ganz sicher finden, Lovi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060102,
					"content": "Sei dir mal nicht so sicher. Es gibt auch Orte, auf die du nicht klettern kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060103
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060103,
					"content": "Aber nur ... nur weil meine Schuhe nicht zum Klettern taugen! Wenn ich sie wechsle, erwische ich dich garantiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060104
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060104,
					"content": "Na dann ziehen wir doch alle unsere Schuhe aus, dann ist es fair!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060105
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060105,
					"content": "Moment! Ihr dürft nicht barfuß umherlaufen, hier liegen überall Bauteile herum, was, wenn ihr euch verletzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060106
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060106,
					"content": "Ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060107
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060107,
					"content": "Na gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060108,
					"content": "Aber ... Bruder, wieso warst du denn gerade so abgelenkt, als du mich fangen wolltest? Du hast nicht einmal reagiert, als ich direkt an dir vorbeigelaufen bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060109
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060109,
					"content": "Hä? Ist das so? Ich habe gerade überhaupt nicht aufgepasst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060110
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060110,
					"content": "Ja doch, ich bin gerade die ganze Zeit um dich herumgelaufen, aber du hast mich anscheinend gar nicht bemerkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060111
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060111,
					"content": "#Aber ... Hä? {NICKNAME}, warum bist du gekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060112,
						240060115
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060112,
					"content": "Warum ist Lovi hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060113
					]
				},
				{
					"id": 240060113,
					"content": "Mein Papa sagte, er müsse auf Geschäftsreise. Und meine Mama arbeitet auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060114
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060114,
					"content": "Da kam Aurèle vorbei, um Bücher zurückzubringen. Also hat Papa ihn gebeten, auf mich aufzupassen, deshalb spiele ich hier mit den beiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060118,
					"content": "Genug geredet, spielen wir weiter. Wer ist jetzt der Fänger?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060119,
						240060120
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060119,
					"content": "Ich dachte, du spielst nicht gern Verstecken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060121,
					"content": "Das ... *ähem* ... Ich arbeite gerade an meinem ersten Kommentar und muss über einige Fragen nachdenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060122
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060122,
					"content": "Ich habe festgestellt ... Also, wenn ich laufe, kann ich besser denken, deshalb ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060123
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060123,
					"content": "Aber er ist schnell abgelenkt. Manchmal steht er plötzlich nur da und spricht mit sich selbst, dann reagiert er nicht einmal auf Rufe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060124
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060124,
					"content": "#{NICKNAME}, spiel doch mit uns. Du bist beim Versteckspiel auf jeden Fall besser als mein Bruder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060125,
						240060126
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060125,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060127,
					"content": "Hehe, du auch! Lovi und ich sind Experten im Versteckspiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060128
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060128,
					"content": "Also los. Lovi, schnell, wir verstecken uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060129
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060129,
					"content": "Lovi und Verut rennen schnell weg, während Aurèle langsam und nachdenklich davongeht ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240060126,
					"content": "Ihr solltet euch gut vorbereiten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060120,
					"content": "Wieso willst du jetzt plötzlich Verstecken spielen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060115,
					"content": "Spielt ihr immer noch Verstecken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060116
					]
				},
				{
					"id": 240060116,
					"content": "Ja. Herr Delerue wollte gerade zu einer Geschäftsreise aufbrechen und seine Frau Dumay musste auch zur Arbeit gehen, also baten sie mich, auf Lovi aufzupassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060117
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240060117,
					"content": "Deshalb habe ich Lovi zum Spielen mitgenommen. Hoffentlich wird ihr Kleid nicht zu dreckig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "Aurèle"
				}
			]
		},
		{
			"id": 2400602,
			"completionStepIds": [
				2400602
			],
