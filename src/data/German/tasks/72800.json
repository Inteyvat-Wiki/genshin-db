			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???",
					"Julie",
					"Parvaneh",
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728000201,
					"content": "... Was ist mit euch los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000202
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000202,
					"content": "Darf ich nach ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000203
					]
				},
				{
					"id": 728000203,
					"content": "Ich bin Kamei Munehisa. Ich bin einfach nur unterwegs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000204
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000204,
					"content": "Oooh ... Dieser Onkel ist angezogen wie ein „Samurai“...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000205
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000205,
					"content": "Samurai? Samurai? Ist das ein Samurai des Bakufu ... Ich habe gehört, dass die Einstellung des Bakufu gegenüber Fremden sehr ... besonders ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000206
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000206,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000207
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000207,
					"content": "Mach dir keine Sorgen. Ich habe das Bakufu verlassen. Ich bin nicht länger ein Samurai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000208
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000208,
					"content": "Ich komme oft hierher, um Dinge zu finden, die ich essen kann, aber als ich heute vorbeikam, fand ich Monster, die in der Gegend herumstreiften.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000209
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000209,
					"content": "Sie haben die ganze Nahrung in der Gegend geplündert, da musste ich sie einfach alle umhauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000210,
						728000212,
						728000214
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000210,
					"content": "Kommst du oft hierher?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000211
					]
				},
				{
					"id": 728000211,
					"content": "Normalerweise gibt es hier keine Monster und ich komme oft hierher, um ein paar Früchte zu holen oder ein paar Tiere zu jagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000217,
					"content": "Das ist alles, was ich sagen werde. Nachdem ich diese Monster besiegt habe, sollten die anderen Monster in der Umgebung es erst einmal nicht wagen herüberzukommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000218
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000218,
					"content": "Wenn du auch wegen des Essens hier bist, schau dich um, ich habe nur meinen Anteil genommen und es sollten noch einige Zutaten übrig sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000219
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000219,
					"content": "Nun, dann werde ich mich verabschieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000220
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000220,
					"content": "Er ist einfach so gegangen. Es fühlt sich an, als ob der Stil dieses Onkels genau der gleiche ist wie der Samurai-Stil, von dem ich auch schon gehört habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000221
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000221,
					"content": "Aber was meinte er, als er sagte, er habe das Bakufu verlassen? Und ist ein Samurai, der das Bakufu verlässt, nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000222,
						728000223
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000222,
					"content": "Er ist wie ein Gegner, dem wir schon einmal begegnet sind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000224,
					"content": "Ja, ich habe schon mal gehört, dass es einige Samurai gibt, die das Bakufu verlassen haben und umherwandern, um Passanten zu berauben und so weiter, um ihren Lebensunterhalt zu verdienen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000225
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000225,
					"content": "Obwohl dieser Onkel nicht wie einer dieser Schurken aussieht, ist es besser für uns, wachsam zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000226
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000226,
					"content": "Na gut, na gut. Sind wir nicht hierhergekommen, um nach Zutaten zu suchen? Aber wenn wir uns hier umsehen, sollten wir nicht noch weiter gehen, damit wir nicht noch mehr Gefahren begegnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000227
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000227,
					"content": "#{F#Diese Reisende}{M#Dieser Reisende} sollte müde sein, nachdem {F#sie}{M#er} uns so lange eskortiert hat, also lass uns hier etwas zu essen machen, eine kurze Pause einlegen und zurück in die Stadt gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000228
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000228,
					"content": "Der Onkel hat gesagt, dass hier noch Zutaten übrig sind, oder? Schauen wir uns um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000223,
					"content": "Es ist wie ein „Kairagi“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000212,
					"content": "Du hast all diese Monster besiegt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000213
					]
				},
				{
					"id": 728000213,
					"content": "Ja, es sind alles ganz normale Monster, mit denen man leicht umgehen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000214,
					"content": "Warum suchst du in der Wildnis nach Nahrung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000215
					]
				},
				{
					"id": 728000215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000216
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000216,
					"content": "Ich habe meine Gründe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				}
			]
		},
		{
