			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong",
					"Julie",
					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728000301,
					"content": "Ich hatte versucht, ein paar frische Zutaten zu bekommen ... Egal, diese sollten auch funktionieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000302,
					"content": "Es tut mir leid, ich wollte dir eigentlich etwas Leckeres kochen, aber jetzt muss ich mich wohl damit begnügen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000303,
						728000306
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000303,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000304
					]
				},
				{
					"id": 728000304,
					"content": "Du kannst es nicht einfach mit einem „Kein Problem“ übergehen, wenn du so hart daran gearbeitet hast, uns zu begleiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000305,
					"content": "Ich werde mir dieses Essen vormerken und dich beim nächsten Mal zu einem schönen Essen einladen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000308,
					"content": "Julie, der Eintopf sollte doch fertig sein, oder? Denke daran, dass du Parvaneh nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000309,
					"content": "Nein, nein, nein, lass die Suppe einfach in Ruhe köcheln!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000310
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000310,
					"content": "Es ist schon gut. Ich würze diese Suppe nach meinem abgewandelten Rezept. Es ist nur ein wenig Würze ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000311
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000311,
					"content": "Ich kann das Rezept, das du verbessert hast, gar nicht verstehen. Hör auf! Xudong! Xudong, komm schon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000312
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000312,
					"content": "Parvaneh! He! Was für eine komische Würzung tust du da wieder rein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000313,
					"content": "Komische Würzung? Das ist eine spezielle Würzung, die ich entwickelt habe! Es ist das Ergebnis einer Forschungsschrift, die ich geschrieben habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000314
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000314,
					"content": "Nicht nötig! Wir werden heute einfach etwas Gewöhnliches essen! Julie, halte sie auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000315
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000315,
					"content": "Hmpf, was für ein Mangel an Wissen ... Egal, warten wir darauf, dass ich es wieder perfektioniere, dann kann ich dieses Universalgewürz machen, das jedes Gericht in ein köstliches verwandeln kann, indem ich es einfach dazugebe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000316
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000316,
					"content": "Das Universalgewürz ... Kann man sowas wirklich herstellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000317
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000317,
					"content": "Es hat einfach noch niemand geschafft, aber ich werde es schaffen. Dann kann ich diesen Idioten in der Akademie einen guten Denkzettel verpassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000318
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000318,
					"content": "Haha ... Na ja, ich freu mich schon drauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000319
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000319,
					"content": "#Übrigens, {F#Reisende}{M#Reisender}, danke, dass du so lange mit uns da draußen warst, es war schwer für dich dieses Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000320
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000320,
					"content": "Ich packe noch eine Portion für dich zum Mitnehmen ein. Du musst gut essen und trinken, wenn du dich auf den Weg machst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000321
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000321,
					"content": "Wenn wir uns das nächste Mal treffen, werde ich dich auf jeden Fall zu einem schönen Essen einladen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000306,
					"content": "Ich werde dich das nächste Mal bitten, mir ein tolles Mahl zuzubereiten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000307
					]
				},
				{
					"id": 728000307,
					"content": "Haha, gut. Ich werde mir dieses Essen vormerken und dich beim nächsten Mal zu einem schönen Essen einladen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "Xudong"
				}
			]
		}
	]
}