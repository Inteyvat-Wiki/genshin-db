				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jeht",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552601,
					"content": "Entschuldigung ... Ich habe meine Emotionen noch nicht gut im Griff ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552602
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 730552602,
					"content": "Entschuldige dich nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552603
					]
				},
				{
					"id": 730552603,
					"content": "Stimmt ... Jeht ist sehr traurig, das wissen wir alle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730552604,
					"content": "Vielen Dank an euch allen ... Wünsche euch eine gute Reise auf dem weiteren Weg ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552605
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 730552605,
					"content": "Ooh ... Und hoffentlich geht es auch bei Jeht alles gut auf dem weiteren Weg ... Da ist sich Paimon ganz sicher!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7305527,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
