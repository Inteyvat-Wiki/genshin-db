			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bonifaz",
					"Nachtigal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552701,
					"content": "Wo sind Omid und Mirsad? Sind sie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552702
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552702,
					"content": "Keine Sorgen, sie sind alle sicher. Nur ... sie haben andere Pläne und werden nicht weiter mit uns zusammenarbeiten, Geschäfte zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552703
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552703,
					"content": "Hä? Was sollen wir dann tun? Wir beide können uns bestimmt nicht um alles kümmern, da müssen wir neue Arbeitskräfte suchen ... Aber wer will schon nach Aaru-Dorf kommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552704
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552704,
					"content": "Also gut, darum kümmern wir uns später. Glücklicherweise ist Cyrus sicher und wohlauf zurückgekehrt. Nächstes Mal lassen wir ihn nicht mehr an so einen gefährlichen Ort gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552705
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552705,
					"content": "Worüber redest du? Wir sind Packtier Händler. Was essen wir, wenn wir unser Packtier nicht zur Arbeit schicken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552706
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552706,
					"content": "Wir können uns nicht vom Wind ernähren. Oh, warum machst du nicht einfach deinen Mund auf und schaust, was deinen Magen füllt? Ich wette, es wäre ein Pfund Sand ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552707
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552707,
					"content": "Trotzdem können wir Cyrus das Risiko nicht eingehen lassen. Aha, du bist auch ziemlich stark und gesund, warum machst du dich nicht für den Transport der Waren verantwortlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552708
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552708,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nachtigal"
				}
			]
		}
	]
