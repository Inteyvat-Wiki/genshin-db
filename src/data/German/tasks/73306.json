			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tirzad"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552501,
					"content": "... Ihr seid es, habt ihr noch etwas zu sagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552502,
						730552507,
						730552511
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552502,
					"content": "Über Jebrael.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552503
					]
				},
				{
					"id": 730552503,
					"content": "Ich habe bis zum Ende an ihm gezweifelt. Ich bin ein so mieser Mensch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552504
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552504,
					"content": "Jetzt bin ich ihm nur dankbar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552505
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552505,
					"content": "Ich war zuvor ständig unentschlossen, egal ob es um akademische Forschung geht oder ums Leben ... Aber von jetzt an ist Schluss damit. Ich werde den Weg verfolgen, den ich gewählt habe, egal wie schwierig er auch sein mag ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552506
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552506,
					"content": "Damit werde ich Jebrael meinen Respekt zollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552507,
					"content": "Über König Deshret ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552508
					]
				},
				{
					"id": 730552508,
					"content": "Ich zweifle langsam an der Glaubwürdigkeit der Artikel, die ich gelesen habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552509
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552509,
					"content": "Das „Gebet“ hat mir ein unbeschreiblich seltsames Gefühl gegeben. Außerdem muss das, was Samail gesagt hat, nach dem Zurückkehren gründlich erforscht werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552510
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552510,
					"content": "Natürlich, meine erste Priorität ist jedoch, meine Abhandlung plangemäß fertig zu stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552511,
					"content": "Über Jeht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552512
					]
				},
				{
					"id": 730552512,
					"content": "*seufz* ... Ich wünschte auch etwas für sie tun zu können, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552513
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552513,
					"content": "Ich kann nichts tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552514
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552514,
					"content": "Und sie weigert sich, etwas zu sagen. Wenn sie nur einen einzigen Wunsch äußern würde, wäre ich bereit, es ihr zu ermöglichen, soweit es in meiner Macht steht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				}
			]
		},
		{
			"id": 7305526,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
