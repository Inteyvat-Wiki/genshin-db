			},
			"dialogs": [
				{
					"id": 762100617,
					"content": "Die Person aus dem Gemälde springt mit einem Satz heraus und landet direkt vor euch ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762100601
					]
				},
				{
					"id": 762100601,
					"content": "#Mein Name ist Zhangsun Jijing, ich grüße dich, {M#edler Held}{F#edle Heldin}. Darf ich fragen, welche Angelegenheit dich veranlasst hat, mich zu rufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100602
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100602,
					"content": "Äh, es ist eigentlich nichts Wichtiges. Paimon hat nur gesehen, wie du in dem Bild herumgesprungen bist, und war ein bisschen neugierig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100603,
					"content": "Ach so ist das. Ich habe gerade hart an meiner Technik der Leichtigkeit trainiert. Aber ich stelle mich noch ungeschickt an, also bitte lacht mich nicht aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100604
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100604,
					"content": "Technik der Leichtigkeit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100605,
					"content": "Das stimmt. Da der Regen sich nie hierher verirrt, kann ich die Technik „Regenschnitt“ meines Meisters kaum üben. Doch ich darf das Training nicht vernachlässigen. Deshalb bleibt mir nichts anderes übrig, als mein Training auf diese Weise fortzusetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100606
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100606,
					"content": "Damals übte mein Meister Guhua genau auf diesen Holzpfählen seine Techniken und erreichte Perfektion. Wir – seine Schüler – sind zwar mit weniger Talent gesegnet, versuchen aber, ihm nachzueifern, und hoffen auf kleine Fortschritte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100607
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100607,
					"content": "#Da uns das Glück heute zusammengeführt hat, und da {M#der edle Held}{F#die edle Heldin} ebenfalls der Kampfkunst mächtig ist, dürfte ich {M#den edlen Helden}{F#die edle Heldin} vielleicht um eine kleine Unterweisung bitten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100609,
						762100611
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100609,
					"content": "Hmpf, ganz wie du wünschst. Sei er nun Zeuge meiner Fähigkeiten!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100610
					]
				},
				{
					"id": 762100610,
					"content": "Uah, warum klingst du plötzlich so komisch? Äh, was sollen wir denn jetzt machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100614,
					"content": "Vielen Dank. Wenn du mir nun bitte deine Aufmerksamkeit schenken würdest ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100611,
					"content": "Paimon ist das Oberhaupt der Paimon-Schule. Zeit für die Meisterin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100612
					]
				},
				{
					"id": 762100612,
					"content": "Ach so, du bist also Paimon, das Oberhaupt der Paimon-Schule? Verzeih mir meine Respektlosigkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100613
					],
