				"points": []
			},
			"dialogs": [
				{
					"id": 762100501,
					"content": "Ach so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100502
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100502,
					"content": "#Man kann es zwar nicht gerade als „auf Wolken schweben“ bezeichnen, aber du hast mich trotzdem inspiriert. Vielen Dank für deine Unterstützung, {M#edler Held}{F#edle Heldin}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangsun Jijing"
				}
			]
		},
		{
