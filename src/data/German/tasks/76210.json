			"dialogs": [
				{
					"id": 762100301,
					"content": "Seht her, ihr zwei. Das ist die „Formation der Pflaumenblütenpfähle“ der Guhua-Stätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100302
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100302,
					"content": "#Könntest du bitte in der vorgegebenen Zeit nacheinander auf die von mir angezeigten Pflöcke treten und mir deine Techniken zeigen, {M#edler Held}{F#edle Heldin}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100303,
						762100305
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100303,
					"content": "Nur eine Kleinigkeit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100304
					]
				},
				{
					"id": 762100304,
					"content": "Auch wenn es eigentlich sehr, sehr viele Kleinigkeiten sind ... Äh, vergiss es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100307,
					"content": "#Dann zeig uns bitte, was du drauf hast, {M#edler Held}{F#edle Heldin}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100305,
					"content": "Das Oberhaupt der Paimon-Schule, Paimon, sollte das eigentlich auch schaffen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100306
					]
				},
				{
					"id": 762100306,
					"content": "Das geht nicht! Auf keinen Fall ... Hmm? Wo Paimon so darüber nachdenkt, könnte Paimon das tatsächlich hinkriegen ... Aber Fliegen gilt bestimmt als Regelverstoß, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "Paimon"
				}
			]
		},
