						],
						"pointId": 910303079
					}
				]
			},
			"dialogs": [
				{
					"id": 762100201,
					"content": "Höchst beeindruckend. Ich bin voller Bewunderung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100202
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100202,
					"content": "Jedenfalls ... hätte ich da noch eine unverschämte Bitte. Hast du schon einmal von der <color=#00E1FFFF>Technik des Wolkenwandelns</color> gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100203
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100203,
					"content": "Es heißt, unser Vorfahre Meister Guhua sei einst inmitten von strahlendem Licht und violettem Nebel in den hohen Himmel aufgestiegen. Er wandelte durch die Luft, als wäre es fester Boden, und das alles nur dank dieser legendären Geheimkunst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100204,
						762100206
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100204,
					"content": "Klingt ein bisschen verrückt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100205
					]
				},
				{
					"id": 762100205,
					"content": "Ja, das klingt echt wie eine Erfindung ... Aber wenn man so darüber nachdenkt: Wenn man einen Windgleiter benutzen könnte, würde es doch vielleicht funktionieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100207,
					"content": "#Oh? Dann bitte ich {M#den edlen Helden}{F#die edle Heldin}, mir das einmal vorzuführen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100206,
					"content": "Wenn man den Windgleiter benutzen könnte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100207
					]
				}
			]
		},
