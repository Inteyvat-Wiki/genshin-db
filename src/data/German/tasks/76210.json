				]
			},
			"dialogs": [
				{
					"id": 762100101,
					"content": "#{M#Edler Held}{F#Edle Heldin}, deine Techniken sind wirklich beeindruckend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100102
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100102,
					"content": "#Hehe, na klar! {NICKNAME} ist echt stark!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100103,
					"content": "#Könntest du mir als Nächstes die Essenz der <color=#00E1FFFF>Sprungtechnik</color> zeigen, {M#edler Held}{F#edle Heldin}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100104
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100104,
					"content": "In den Büchern steht, dass meine Vorfahren der Guhua-Schule über Mauern sprangen und Städte durchquerten, als würden sie auf flachem Boden laufen. Sie besaßen wirklich die Fähigkeit, über Dächer zu springen und Wände hinaufzuklettern, was die Technik des Sprungs genannt wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100105,
						762100106
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100105,
					"content": "Ziemlich beeindruckend!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100108
					]
				},
				{
					"id": 762100108,
					"content": "#Hmm ... Versuchen wir es doch mal? Schließlich sucht {NICKNAME} überall nach Truhen und ist schon an vielen Orten geklettert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100106,
					"content": "Klingt wie ein Einbrecher ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100107
					]
				},
				{
					"id": 762100107,
					"content": "#Hehe, {M#edler Held}{F#edle Heldin}, überleg einmal: Wenn Diebe einfach über Mauern steigen und verschwinden können, wir, die das Böse bekämpfen, aber nicht ... würden uns die Schurken dann nicht viel zu leicht entwischen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100108
					],
					"speakerTitle": "Zhangsun Jijing"
				}
			]
		},
		{
			"id": 7621002,
			"completionStepIds": [
				7621005
			],
