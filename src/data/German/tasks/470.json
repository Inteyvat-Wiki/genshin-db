					"content": "Hier riecht es nach <color=#00E1FFFF>Fischerschnitten</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4700103,
					"content": "Mmh ... Der Duft kommt vom „Hirschjäger“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4700104,
					"content": "Eine dicke Scheibe herzhaftes Brot ...",
