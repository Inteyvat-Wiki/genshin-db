					"nextDialogs": [
						4700107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4700107,
					"content": "Wir müssen auf der Stelle zum <color=#00E1FFFF>Hirschjäger</color> und eine <color=#00E1FFFF>Fischerschnitte</color> kaufen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4700108,
					"content": "Natürlich darfst du Paimon einladen.",
