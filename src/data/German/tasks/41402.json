			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Ji Tong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020101,
					"content": "Ah, hallo. Genau mit dir wollte ich reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020102,
						414020103
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020102,
					"content": "Worüber?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				},
				{
					"id": 414020104,
					"content": "Nein, nicht nötig. Ich weiß jetzt, woran es lag.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020105
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020105,
					"content": "Neulich hab ich den Händler endlich erwischt. Den, der mir den Fotoapparat verkaufte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020106
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020106,
					"content": "Ich sagte ihm, es gebe ein Problem damit, doch er konnte keines entdecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020107
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020107,
					"content": "Zum Glück hatte ich all deine Fotos dabei, ohne die hätte ich ihn nicht überzeugen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020108
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020108,
					"content": "Als er sich die Fotos angesehen hatte, willigte er endlich ein, sich den Fotoapparat genauer anzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020109
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020109,
					"content": "Gestern kam er zu mir, er hatte ein Fläschchen mit einer Flüssigkeit dabei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020110
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020110,
					"content": "Er meinte, der Fotoapparat funktioniere anders als reguläre Modelle. Damit die Fotos normal aussehen, muss man etwas von dieser Flüssigkeit hinzufügen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020111
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020111,
					"content": "Wenn das nicht geschieht, werden die Fotos so wie deine. Reine Farben statt klarer Bilder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020112,
						414020113
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020112,
					"content": "Zum Glück ist der Fotoapparat also nicht kaputt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020114,
					"content": "Um ehrlich zu sein, interessiert mich jetzt weniger der Fotoapparat, sondern eher die Flüssigkeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020115
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020115,
					"content": "Denk mal drüber nach. Die meisten Leute würden nur den Fotoapparat kaufen, oder? Einmal kaufen, ewig behalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020116
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020116,
					"content": "Doch die Flüssigkeit hält nicht ewig. Will man sie weiter nutzen, muss man mehr davon kaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020117
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020117,
					"content": "Der Typ meinte auch, verschiedene Flüssigkeiten sorgen für verschiedene Effekte. Derzeit arbeitet er an weiteren Varianten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020118
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020118,
					"content": "Vielleicht ... nur vielleicht bieten diese Fläschchen mit der Flüssigkeit die Möglichkeit auf ein gutes Geschäft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020119
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020119,
					"content": "Oh, Pardon. Ich schweife ab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020120
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020120,
					"content": "Danke für all deine Hilfe. Gib mir diesen Fotoapparat, dann versorge ich ihn mit ein wenig Flüssigkeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020113,
					"content": "Also ... Problem gelöst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020103,
					"content": "Über Intensivfarben-Fotografie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				}
			]
		},
		{
			"id": 4140202,
			"completionStepIds": [
				4140202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
