			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Ji Tong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020201,
					"content": "#{F#Reisende}{M#Reisender}, warte einen Moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020202
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020202,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020203
					]
				},
				{
					"id": 414020203,
					"content": "Es kommt ein bisschen plötzlich, aber ... Interessierst du dich für Fotoapparate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020204,
						414020205
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020204,
					"content": "Klar, ein wenig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				},
				{
					"id": 414020206,
					"content": "Nun, dies ist kein gewöhnlicher Fotoapparat. Er nutzt die neueste Technik aus Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020207
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020207,
					"content": "Die mit diesem Modell geknipsten Fotos weisen alle einen besonderen Effekt auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020208,
						414020209
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020208,
					"content": "Wie funktioniert das?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020210,
					"content": "He! Ich sage nur die Wahrheit. Frag die Abenteurergilde, wenn du mir nicht glaubst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020211
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020211,
					"content": "Ich war zuerst auch skeptisch. Ich spielte ewig damit herum, aber es klappte nicht. Schließlich half mir einer der Abenteurer aus der Gilde damit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020212
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020212,
					"content": "Sicher fragst du dich, was diesen Fotoapparat so besonders macht. Nun, es ist sein Innenleben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020213
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020213,
					"content": "Er braucht eine bestimmte Flüssigkeit, die im Druck für den speziellen Effekt sorgt. Damit sehen die Fotos viel besser aus als mit einem gewöhnlichen Fotoapparat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020214
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020214,
					"content": "Was meinst du? Wenn es dich interessiert, kann ich ihn dir eine Weile überlassen. Es gibt zwar nicht so viele verschiedene Flüssigkeiten, doch für den Anfang reicht es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020215
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020215,
					"content": "Irgendwann gehe ich wieder nach Fontaine, um ein paar neue Tränke zu erwerben. Bitte komm dann wieder, wenn du interessiert bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020216,
						414020217
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020216,
					"content": "Also gut ... Danke ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020219
					]
				},
				{
					"id": 414020219,
					"content": "Bitte behalte diesen Fotoapparat als Zeichen meiner Wertschätzung. Wenn er dir gefällt, können wir zukünftig gerne Geschäfte machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020217,
					"content": "Wie viel kostet das?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020218
					]
				},
				{
					"id": 414020218,
					"content": "Oh, also, mach dir darüber keine Gedanken. Die sind bereits billig, wenn man sie einzeln kauft, und wenn du mehrere willst, können wir uns über Rabatt unterhalten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020219
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020209,
					"content": "Echt jetzt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020205,
					"content": "Nicht interessiert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				}
			]
		},
		{
			"id": 4140203,
			"completionStepIds": [
				4140203
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4140203",
							"2"
						],
						"stepId": 4140203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ji Tong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020301,
					"content": "Dann kannst du diesen Fotoapparat behalten. Pass gut darauf auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020302,
						414020303
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020302,
					"content": "Du gibst mir nur den Fotoapparat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				},
				{
					"id": 414020304,
					"content": "Fürs Erste befindet sich mehr als genug Flüssigkeit darin. Wenn sie alle ist ... nun, du weißt, wo du mich findest, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020305
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020305,
					"content": "Apropos, ich plane mit meinem Kontakt, ein paar neue Flüssigkeiten für den Fotoapparat zu importieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020306
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020306,
					"content": "Ich hoffe, dich hier in Zukunft wiederzusehen, wenn du etwas findest, das dich interessiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020307
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020307,
					"content": "Eigentlich wollte ich ja nur einen Fotoapparat kaufen, jetzt aber stellt sich heraus, dass es sich dabei um ein ganzes Geschäftsprojekt handelt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020303,
					"content": "Und wenn die Flüssigkeit zur Neige geht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				}
			]
		}
	]
}