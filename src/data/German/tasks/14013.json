				{
					"id": 140130401,
					"content": "Es ist schon ironisch, wenn ich daran denke, dass ich in meiner ganzen Zeit als „Göttin“ nur davon träumen konnte, diese Art von Macht zu erhalten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140130402
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140130402,
					"content": "Und obwohl die Macht, die ich jetzt habe, nicht mehr ist als der Segen einer Gottheit ... Es fühlt sich aber eher so an, als ob ich mein Schicksal endlich selbst in die Hand nehmen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140130403
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140130403,
					"content": "Geht es den Menschen genauso?",
