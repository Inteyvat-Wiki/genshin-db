				{
					"id": 210100001,
					"content": "Hm, darüber muss ich nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210100002
					],
					"speakerTitle": "Dandy"
				},
				{
					"id": 210100002,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210100003
					]
				},
				{
					"id": 210100003,
					"content": "Ach, nichts weiter. Ich überlege nur, wie lange es wohl dauert, all die Stufen vom Gasthaus Wangshu zu gehen. Es ist so hoch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210100004
					],
					"speakerTitle": "Dandy"
				},
				{
					"id": 210100004,
					"content": "Ich wollte es eigentlich ausprobieren. Aber all die Laubhaufen sind echt hinderlich. Ich will sie erstmal beseitigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210100005
					],
					"speakerTitle": "Dandy"
				},
				{
					"id": 210100005,
					"content": "Aber allein bei dem Gedanken, all die Stufen zu steigen und dann auch noch das Laub zu entfernen, bekomme ich Atemnot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210100006
					],
					"speakerTitle": "Dandy"
				},
				{
					"id": 210100006,
					"content": "Ich werde es versuchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210100007
					]
				},
				{
					"id": 210100007,
					"content": "Haha, klar, gern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dandy"
				}
			]
		},
