			},
			"dialogs": [
				{
					"id": 751450101,
					"content": "#Auserwählte{M#r} der Drachen ... Ah, Auserwählte{M#r} der Drachen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450102,
					"content": "Der heilige Berg liegt direkt vor dir ... Du ... müsstest den Feind im Schatten ... aber erst ausrotten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450103,
					"content": "#Auserwählte{M#r} der Drachen ... betritt ... den heiligen Berg ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450104,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450105,
					"content": "Ist da ... etwa gerade der Vulkan ausgebrochen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450106
					]
				},
				{
					"id": 751450106,
					"content": "Nein, der Vulkan war gerade richtig leise ... Habt ihr ihn etwa ausbrechen sehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450107,
					"content": "#Was ist los, {NICKNAME} und {REALNAME[ID(2)|SHOWHOST(true)]}? Warum schaut ihr so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450108,
					"content": "Ihr seht wie zwei Detektive aus einem Kriminalroman aus, denen plötzlich die ganze Wahrheit hinter einem Fall klar geworden ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450109,
						751450112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450109,
					"content": "Wir haben eine andere Art der „Wahrheit“ gesehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450110
					]
				},
				{
					"id": 751450110,
					"content": "(Du erklärst Paimon, was du gesehen hast ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450111
					]
				},
				{
					"id": 751450111,
					"content": "#Oh, du meinst also, dass das, was du gesehen hast, genau dasselbe war, was du gesehen hast, als wir zum ersten Mal in Natlan angekommen und auf {REALNAME[ID(2)|SHOWHOST(true)]} getroffen sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450118,
					"content": "Und dann noch irgendwelche seltsamen Bilder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450119,
					"content": "*brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450120
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450120,
					"content": "Damals hast du komische Wörter gesehen, hast du gemeint ... Hm, Paimon hat sie nicht gesehen, weiß also nichts darüber, aber sah das nach derselben Person aus, die die Wörter geschrieben haben könnte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450121,
					"content": "Es muss dieselbe Person gewesen sein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450122
					]
				},
				{
					"id": 751450122,
					"content": "Aber diesmal habt ihr auch ... riesige Ruinen und den Abgrund gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450123,
					"content": "Und einen „heiligen Berg“ ... Nennen die Leute in Natlan diesen Vulkan nicht auch „heiligen Berg“? Könnte es denn nicht sein, dass das, was du gesehen hast, mit diesem Vulkan zu tun hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450124,
					"content": "#Paimon wird einfach nicht das Gefühl los, dass die Person, die uns mit {REALNAME[ID(2)|SHOWHOST(true)]} zusammengebracht hat, uns in Wirklichkeit dazu bewegen möchte, den „heiligen Berg“ zu betreten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450125,
					"content": "#Vielleicht finden wir dort ja mehr über die Geschichte von {REALNAME[ID(2)|SHOWHOST(true)]} heraus ... Und vielleicht treffen wir ja sogar seine Familie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450126,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450127,
					"content": "Wie auch immer ... Wir sollten auf weitere Informationen über den Vulkan achten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450128,
					"content": "Ach ja, einer der sechs Stämme Natlans, das Kollektiv der Fülle, lebt wohl neben dem Vulkan. Vielleicht können sie uns ja weiterhelfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450112,
					"content": "Der Kuchenmörder ist ... Paimon! Du bist es!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450113
					]
				},
				{
					"id": 751450113,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450114,
					"content": "So ein Mist! Wie kannst du das denn wissen? Paimon war sich sicher, dass niemand Paimon gesehen hat, als Paimon den kleinen Kuchen gegessen hat ... Spaß, Paimon hat eigentlich den geschmorten Fleischeintopf heimlich aufgegessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450115,
					"content": "Also ... Moment, was habt ihr denn gerade gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450116,
					"content": "(Du erklärst Paimon, was du gesehen hast ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450117
					]
				},
				{
					"id": 751450117,
					"content": "Du hast wieder komische Wörter gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450118
					],
					"speakerTitle": "Paimon"
				}
			]
		},
