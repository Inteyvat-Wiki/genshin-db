			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbeloth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746930101,
					"content": "Bist du sicher, dass du mir keine Kopie der Rückseite dieser Karte machen kannst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930102
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930102,
					"content": "Ganz sicher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930103
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930103,
					"content": "Das ist sehr beeindruckend. Vielleicht können wir uns irgendwie einigen ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930104
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930104,
					"content": "Auf keinen Fall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930105
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930105,
					"content": "Na gut. Schöne Kartenrücken bekommen und mächtige Karten ausspielen – beides hat seinen Preis. Ich glaube, ich verstehe das jetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930106,
						746930107,
						746930108
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930106,
					"content": "Ich glaube nicht, dass du das verstehst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				},
				{
					"id": 746930109,
					"content": "He! Du weißt doch gar nicht, warum Cyno hier ist! Vielleicht ist er hier, um ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930110,
					"content": "Natürlich! Genau das erwarte ich von einem so guten Freund – wir sind auf derselben Wellenlänge!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930111
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930111,
					"content": "Im Ernst!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930112,
					"content": "Hier in Fontaine findet ein kleines Treffen von Sammelkartenspielern statt. Ich habe gehört, dass die Teilnehmer kostenlose, exklusive Kartenhalter für die Veranstaltung bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930113
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930113,
					"content": "An der Akademie gab es nichts Dringendes, also bin ich hergekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930114
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930114,
					"content": "Selbst wenn es wichtige Angelegenheiten gäbe, hat Paimon so eine Ahnung, dass du einen Weg gefunden hättest, sie unwichtig zu machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930115,
					"content": "Du hast recht! Ich habe es geschafft, fast meine ganze Arbeit nach nur zwei Wochen Überstunden zu erledigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930116
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930116,
					"content": "Sethos hat mir auch geholfen, also habe ich versprochen, ihm als Dank eine Kartenhülle mitzubringen. Er kommt wirklich gut mit Papierkram zurecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930117
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930117,
					"content": "Nun denn, Mahamatra, wirst du eine Karte ziehen oder nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930118
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930118,
					"content": "Natürlich. Du sagst, diese Karte wird meine Zukunft vorhersagen, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930119
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930119,
					"content": "Streng genommen ist das nicht ganz richtig. Aber es so zu verstehen dürfte keine großen Probleme geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930120
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930120,
					"content": "Verstehe ... Ist das wie diese Zeile aus „Duell-Meister“ – „Setze dein Schicksal auf die nächste Karte im Zug“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930121
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930121,
					"content": "Und jetzt bin ich an der Reihe zu ziehen ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930122
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930122,
					"content": "Cyno atmet tief durch, nimmt eine stylische Pose ein und zieht eine Karte ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746930123
					]
				},
				{
					"id": 746930123,
					"content": "Ah, die umgekehrte Mäßigkeit. Eine passende Karte für Mahamatra von der Sumeru-Akademie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930124
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930124,
					"content": "Du kennst Cyno bereits?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930125
					]
				},
				{
					"id": 746930125,
					"content": "Alice hat ihn ein paar Mal erwähnt. Sie findet es lustig, dass die verstaubte, alte Akademie einen Mahamatra mit so ausgeprägtem Sinn für Humor hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930126
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930126,
					"content": "Bitte richte ihr meinen Dank für das Kompliment aus. Nun, da ich eine Karte gezogen habe, was soll ich als Nächstes tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930127
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930127,
					"content": "Da es sich um die umgekehrte „Mäßigkeit“ handelt – oder besser gesagt, um die umgekehrte „Künstlerische Begabung“ –, schlage ich vor, dass du vorerst in einem Zustand des Nichtstuns verbleibst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930128
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930128,
					"content": "Du warst unüberlegt und hast beinahe den Halt auf der schmalen Brücke des Schicksals verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930129
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930129,
					"content": "Das kommt davon, dass ich zu viel Karten gespielt habe, stimmt’s? Sethos und Tighnari haben mir das Gleiche gesagt – ich habe meinen Zeitplan bereits angepasst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930130
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930130,
					"content": "... Ich spreche nicht vom Kartenspielen. Ich meine deine Arbeitszeiten. Sicherlich ist Geniale Beschwörung nicht das Einzige, das Mahamatras volle Aufmerksamkeit erfordert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930131
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930131,
					"content": "Meine Pflichten lassen mir nicht viel Spielraum, sie anzupassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930132
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930132,
					"content": "Bist du es gewohnt, den Druck eines so strengen Zeitplans allein zu tragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930133
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930133,
					"content": "Es gibt auch andere Matras. Wir teilen uns die Last.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930134
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930134,
					"content": "Aber sie alle verlassen sich auf dich? Nicht nur die Matras, sondern auch die Forscher und die Leute von Sumeru ... So viele Menschen setzen ihr Vertrauen in dich, Mahamatra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930135
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930135,
					"content": "Sie sagen es dir nie, vielleicht merken sie es selbst nicht einmal ... Warum sollten sie auch, wenn sie alle so von deinem Witz gefesselt sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930136
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930136,
					"content": "Aber du spürst ihre Blicke, die Tag und Nacht auf dir ruhen ... Oh, und der Schatten, der neben dir geht. Auch er ist eine deiner Lasten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930137
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930137,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930138
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930138,
					"content": "Du bist es gewohnt, voranzugehen und die Lasten anderer zu tragen ... Ich denke, dass das vielleicht der Grund für dein Ungleichgewicht ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930139
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930139,
					"content": "Ich habe viele Freunde und Geniale Beschwörung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930140
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930140,
					"content": "Es sieht also so aus, als hättest du nicht vor, dich auszuruhen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930141
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930141,
					"content": "Zum Ausruhen ist keine Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930142
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930142,
					"content": "In der Tat. Für jemanden wie dich gilt: Wenn der innere Kampf endlos ist, markiert nicht einmal der Tod das Ende der Pflicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930143
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930143,
					"content": "Nimm diese Mondorakelkarte. Vielleicht wird sie dich zu dem Grund führen, der dein Gleichgewicht wiederherstellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930144
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930144,
					"content": "Wenn das passiert, sollte auch der Kampf in dir ein entscheidendes Ende erreichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930145,
						746930146
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930145,
					"content": "Cyno wird nicht verlieren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930147
					]
				},
				{
					"id": 746930147,
					"content": "#Danke, {NICKNAME} und Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930148
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930148,
					"content": "Und auch dir meinen Dank. Und keine Sorge, ich verspreche, dass ich nicht völlig durchdrehen werde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930149
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930149,
					"content": "... Hä? Warum würdest du es dorthin bringen ... Warte, ist das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930150,
						746930151,
						746930152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930150,
					"content": "Oh nein, nicht schon wieder!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930153,
					"content": "... Was hat das mit Fort Méropide zu tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930154
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930154,
					"content": "Weil ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930155
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930155,
					"content": "... Die Leute könnten mich ja für jemanden halten, der „hinter dem Mond lebt“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930151,
					"content": "Er hat sich schon wieder was ausgedacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930152,
					"content": "Barbeloth, frag nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930146,
					"content": "Cyno ist der Stärkste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930147
					]
				},
				{
					"id": 746930107,
					"content": "Ich glaube nicht, dass ich das verstehe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				},
				{
					"id": 746930108,
					"content": "Du bist den ganzen Weg hergekommen, um Karten zu spielen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				}
			]
		},
