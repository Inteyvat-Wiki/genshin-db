			"dialogs": [
				{
					"id": 700110201,
					"content": "Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110202
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700110202,
					"content": "Mimi muhe du, du ya Wei zido dala si.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110203
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700110203,
					"content": "Mi mito nye. Mi mito ya zido mito, beru ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110204
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700110204,
					"content": "Es weiß es auch nicht. Aber wir können versuchen, einen seiner Freunde zu fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110205
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700110205,
					"content": "Valo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700110206
					]
				},
				{
					"id": 700110206,
					"content": "Valo, mimi tomo!",
