					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412120301,
					"content": "Hmm? Wie leergefegt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120302
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120302,
					"content": "Müssen Monster auch einkaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120303,
					"content": "Hm. Möchtet ihr euch ein wenig die Beine vertreten, bevor sie zurückkehren, oder sollen wir hier ein wenig verschnaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120304,
						412120306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120304,
					"content": "Was hältst du von einer Pause und einem netten Gespräch?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120305
					]
				},
				{
					"id": 412120305,
					"content": "Da hätte ich überhaupt nichts dagegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120309,
					"content": "Oh, wir reden? Paimon will auch mitreden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120310,
					"content": "Ich weiß, dass du Fragen hast ... über mich, über das Ganze hier. Und ich habe schon gesagt, dass ich sie beantworten werde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120311
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120311,
					"content": "Aber ich werde dich nicht anlügen. Es gibt einige Dinge, die ich für mich behalten muss. Bei diesen Angelegenheiten musst du es mir erlauben, vorerst noch Stillschweigen zu bewahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120312
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120312,
					"content": "Huch. Albedo kann wohl ziemlich direkt sein, wenn er es wirklich will ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120313,
						412120314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120313,
					"content": "Auf jeden Fall ist er aufrichtiger als ich erwartet habe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120315
					]
				},
				{
					"id": 412120315,
					"content": "Tiga plata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120316
					],
					"speakerTitle": "???"
				},
				{
					"id": 412120316,
					"content": "Äh ... häh! Was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120317,
					"content": "Odomu Movo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120318,
						412120320
					],
					"speakerTitle": "???"
				},
				{
					"id": 412120318,
					"content": "Machst du diese seltsamen Geräusche, Albedo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120319
					]
				},
				{
					"id": 412120319,
					"content": "Hältst du das für möglich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120322
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120322,
					"content": "Ah, ein Hilichurl!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120320,
					"content": "Machst du diese seltsamen Geräusche, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120321
					]
				},
				{
					"id": 412120321,
					"content": "Was glaubst du? Und warum fragst du nicht Albedo, häh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120314,
					"content": "Auf jeden Fall ist er offener als ich erwartet habe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120315
					]
				},
				{
					"id": 412120306,
					"content": "Das ist gut ... Ich habe nämlich ein paar Fragen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120307
					]
				},
				{
					"id": 412120307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120308
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120308,
					"content": "Na gut. Was möchtest du gerne wissen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120309
					],
					"speakerTitle": "Albedo"
				}
			]
		},
