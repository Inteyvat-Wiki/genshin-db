						"stepId": 4121210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412120601,
					"content": "Anscheinend geht es hier nicht mehr weiter rauf. Na ja, außer durch die riesige Höhle hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120602,
					"content": "Ist er da hineingelaufen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120603
					]
				},
				{
					"id": 412120603,
					"content": "Die Spuren deuten darauf hin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120604
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120604,
					"content": "Worauf warten wir dann noch?!? Wir dürfen ihn nicht entkommen lassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120605,
					"content": "Wartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120606
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120606,
					"content": "Dieser Berg ist riesig. Selbst wenn es in seinem Inneren einen Pfad gibt, wäre der mit Vorsicht zu genießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120607
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120608
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120608,
					"content": "Spürt ihr das auch? Der Wind trägt den Geruch von Eis und Fels mit sich ... und den Klang des Echos. Die Höhle ist bestimmt riesig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120609
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120609,
					"content": "Wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120610,
					"content": "Ah, solche unbesonnenen Entscheidungen helfen uns nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120611
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120611,
					"content": "Aber ... Aber wir sind den ganzen Weg hierhergelaufen ... Wir können ihn nicht einfach davonkommen lassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120612,
					"content": "Ist dir das Skizzenbuch nicht unheimlich wichtig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120613
					]
				},
				{
					"id": 412120613,
					"content": "Schon. Aber das heißt noch lange nicht, dass wir leichtsinnig sein sollten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120614
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120614,
					"content": "Es gibt noch einen anderen Weg. Wir müssen nur ein wenig mehr Arbeit investieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120615
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120615,
					"content": "Wenn ich mich nicht irre, befindet sich der Ausgang dieser Höhle auf der anderen Seite des Bergs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120616
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120616,
					"content": "Du bist doch richtig gut im Gleiten und ich selbst bin auch nicht schlecht. Mach dich fertig und wir gleiten in einem durch hinüber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 4121207,
			"completionStepIds": [
				4121215
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
