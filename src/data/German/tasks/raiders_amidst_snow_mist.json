			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412120101,
					"content": "Albedo! Wir sind zurück ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120102,
					"content": "Oh, he, hat er Besuch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120103,
						412120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120103,
					"content": "Ja, und sogar ein bekanntes Gesicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120105
					]
				},
				{
					"id": 412120105,
					"content": "Ja, vielleicht ist es zu früh, unsere Anfänger hier zum Abenteuern einzuladen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120106
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120106,
					"content": "Aber geht es bei Abenteuern nicht ausgerechnet darum, unsere Grenzen auszutesten? Was wäre eine Reise ohne Mühen, ohne die Aufregung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120107
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120107,
					"content": "Hier wimmelt es von garstigen Hilichurl-Banditen und der Schnee geht bis über die Knie, aber ein Abenteurer darf nicht aufgeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120108
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120108,
					"content": "Cyrus, komm zum Punkt, bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120109,
					"content": "Hahaha! Geduld, Geduld! Das Schöne an einem Gespräch ist die Reise und nicht das Ziel ... wie bei einem Abenteuer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120110
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120110,
					"content": "Selbst wenn man völlig ausgeraubt wurde und sogar das Lager weg ist, kann man im eisigen Schnee immer noch ein Feuer anzünden und eine Mahlzeit kochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120111
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120111,
					"content": "Den Besuch auf dem Berg werden unsere Anfänger niemals vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120112
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120112,
					"content": "Mm, ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120113
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120113,
					"content": "Sie werden mich vielleicht verachten oder sogar hassen. Aber später werden sie mit dankbarem Herzen auf diesen Augenblick zurückblicken ... Denn das war der Tag, an dem der Geist des Abenteuers in ihnen erwachte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120114
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120114,
					"content": "Oh, ja. Erzähl weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120115
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120115,
					"content": "Oje ... Typisch Albedo. Er ist immer so abweisend, wenn ihn ein Thema nicht fesselt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120116,
					"content": "Abenteuer interessieren ihn nicht die Bohne, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120117
					]
				},
				{
					"id": 412120117,
					"content": "Meinst du? Du interessierst ihn aber schon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120118,
					"content": "Dennoch ... sollten wir sagen, dass unsere Neulinge zu unerfahren sind oder der Berg zu gefährlich? Wir mussten dieses Mal ziemliche Verluste beklagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120119
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120119,
					"content": "Was? Was meinst du mit „ziemliche Verluste“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120120,
					"content": "Oh, du bist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120121
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120121,
					"content": "Wie geht’s, Cyrus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120122
					]
				},
				{
					"id": 412120122,
					"content": "Lange schon nicht mehr gesehen ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120123,
					"content": "#Ah, ja! {F#Die junge Abenteurerin und ihre}{M#Der junge Abenteurer und seine} Begleiterin! Freut mich, euch hier zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120124
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120124,
					"content": "Der Aufstieg in dieser Kälte hat euch doch nicht zu sehr zugesetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120125
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120125,
					"content": "Ha, der Berg kann uns gar nichts anhaben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120126,
					"content": "Hahaha! Gut, gut! Ich mag euer Selbstvertrauen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120127
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120127,
					"content": "Aber ihr seid bestimmt in einer wichtigen Angelegenheit unterwegs. Für einen Spaziergang gibt es etwas Angenehmeres als diesen Wind und den Schnee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120128
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120128,
					"content": "#Ich wollte hier die neuesten Daten bezüglich der Hilichurle sammeln und habe {F#sie}{M#ihn} gebeten, mir zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120129,
						412120130
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120129,
					"content": "(Oh. So war das also?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120131
					]
				},
				{
					"id": 412120131,
					"content": "Ah, verstehe. Menschen, die sich treffen, um ihren Träumen und Idealen nachzujagen, stimmt’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120132
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120132,
					"content": "Dann wünsche ich euch allen alles Gute. Auf Wiedersehen ... Ich muss mich wieder um unsere neuen Rekruten kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120201
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120201,
					"content": "Oho! Sieht aus, als hätten wir eine Entdeckung gemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120202,
					"content": "Albedo lässt Cyrus im Dunkeln tappen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120203
					]
				},
				{
					"id": 412120203,
					"content": "Na ja, im Endeffekt ist es auch wirklich ein magisches Schwert. Ich verstehe, dass er das anderen nicht unbedingt auf die Nase binden will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120204,
					"content": "Ich höre euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120205
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120205,
					"content": "Sollte ich nicht fragen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120206
					]
				},
				{
					"id": 412120206,
					"content": "Es gibt hier kein „sollte“ oder „sollte nicht“. Ich kann deine Fragen beantworten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120207
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120207,
					"content": "Aber nicht jetzt. Jetzt gibt es Wichtigeres zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120208
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120208,
					"content": "Wichtigeres? Lass Paimon raten, wir sind mal wieder ein Teil davon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120209,
					"content": "Du wirst immer schlauer, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120210
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120210,
					"content": "He! Paimon will, dass du weißt, dass Paimon immer schon schlau war!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120211,
					"content": "Ich habe in der Nähe ein paar neue Gebiete entdeckt, wo sich andere Monster herumtreiben. Ich glaube, sie könnten uns mit ähnlich vielfältigen Daten versorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120212
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120212,
					"content": "Du liebst deine Forschung einfach, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120213
					]
				},
				{
					"id": 412120213,
					"content": "Beharrlichkeit ist der Schlüssel zur Forschung und Ausdauer der Grundstein der Alchimie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120214
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120214,
					"content": "Seid ihr bereit? Legen wir los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120130,
					"content": "(Die Sache mit dem Schwert erwähnt er wohl eher ungern anderen gegenüber, hm?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120131
					]
				},
				{
					"id": 412120104,
					"content": "Hmm ... woher kennen wir diesen Mann?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120105
					]
				}
			]
		},
