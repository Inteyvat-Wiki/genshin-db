			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412120501,
					"content": "Habt ihr das gesehen? Dieser Hilichurl ist davongerannt. Hatte der so etwas wie ein ... Buch in der Hand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120502,
					"content": "Das ist ... nicht gut. Das war mein Skizzenbuch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120503,
						412120504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120503,
					"content": "Vielleicht träumt er davon, einst ein großer Künstler zu werden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120505
					]
				},
				{
					"id": 412120505,
					"content": "Paimon glaubt, dass er in Wahrheit einfach nur irgendwas klauen wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120506,
					"content": "Dass er es gewagt hat, mein Skizzenbuch zu stehlen. Eigentlich fast frech.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120507
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120507,
					"content": "Eieiei, Albedos Laune ist im Keller ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120508,
					"content": "Ich helfe dir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120504,
					"content": "Will er auch ein Alchimist werden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120505
					]
				}
			]
		},
		{
			"id": 4121206,
			"completionStepIds": [
				4121210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121210",
							"2"
