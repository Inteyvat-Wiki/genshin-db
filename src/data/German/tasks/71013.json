				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710131501,
					"content": "<color=#00E1FFFF>Göttliche Augen</color> ... Sie entstammen wahrlich aus einem anderen Reich. Die Menschen sagen, dass sie ein Gottesgeschenk sind, aber niemand kann sagen, wer eine erhalten wird und warum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131502
					],
					"speakerTitle": "Ruinenschatz"
				},
				{
					"id": 710131502,
					"content": "In alten Texten wird erzählt, dass die Göttlichen mit Mitgefühl auf die Welt der Sterblichen herabblicken und den Würdigen <color=#00E1FFFF>Göttliche Augen</color> verleihen, um ihnen im Kampf gegen das Böse und beim Schutz der Welt zu helfen. Aber ich ... Ich verzehre mich nicht länger mit dem Wunsch, Monster zu vertreiben. Ich will nur noch mit ihnen sprechen. Sie verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131503
					],
					"speakerTitle": "Ruinenschatz"
				},
				{
					"id": 710131503,
					"content": "Dieses <color=#00E1FFFF>Göttliche Auge</color> ... Es hilft mir nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruinenschatz"
				}
			]
		},
