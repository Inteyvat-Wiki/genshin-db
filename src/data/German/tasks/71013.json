						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101301",
							"2"
						],
						"stepId": 7101301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710130101,
					"content": "Mein Schulkamerad und ich haben von Kindheit an die Kampfkünste geübt. Wir wollten die Mächte des Bösen bekämpfen und alles schützen, was in dieser Welt heilig ist. Aber dies war keine leichte Aufgabe ohne ein <color=#00E1FFFF>Göttliches Auge</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130102
					],
					"speakerTitle": "Ruinenschatz"
				},
				{
					"id": 710130102,
					"content": "Wir zwei haben hier Unterschlupf gesucht, um uns weiterzubilden und das <color=#00E1FFFF>Göttlichen Auge</color> zu suchen, das wir begehrten. Wir errichteten diese Stele als Zeichen unserer Bemühungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130103
					],
					"speakerTitle": "Ruinenschatz"
				}
			]
		},
		{
			"id": 7101302,
			"completionStepIds": [
				7101302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101302",
							"2"
						],
						"stepId": 7101302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710130201,
					"content": "Ich hatte Glück, mein <color=#00E1FFFF>Göttliches Auge</color> zu empfangen. Aber dennoch hatte ich Zweifel: Steht es wirklich in der Macht bloßer Sterblicher, eines Tages die Welt von den Monstern zu befreien, die sie so lange geplagt haben? Und wie verschieden sind diese Monster von den Menschen, abgesehen von ihrer äußeren Erscheinung? Stimmt es nicht, dass auch sie, genau wie wir, sprechen? Wie wir bauen sie, wie wir fühlen sie Liebe und Hass, Freude und Trauer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130202
					],
					"speakerTitle": "Ruinenschatz"
				},
				{
					"id": 710130202,
					"content": "Hiermit graviere ich dieser Stele das schwierigste Rätsel meines Geistes ein. Oh, Leser in ferner Zukunft, wirst du derjenige sein, der es löst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruinenschatz"
				}
			]
		},
		{
			"id": 7101303,
