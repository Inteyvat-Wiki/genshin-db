			},
			"dialogs": [
				{
					"id": 710131401,
					"content": "Künftiger Leser, ich weiß nicht, ob du die Antworten auf meine Fragen weißt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131402
					],
					"speakerTitle": "Ruinenschatz"
				},
				{
					"id": 710131402,
					"content": "Jeder, der diese Worte liest, muss sicher der gleichen Natur sein wie ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131403
					],
					"speakerTitle": "Ruinenschatz"
				},
				{
					"id": 710131403,
					"content": "<color=#00E1FFFF>Falls es dich interessiert, habe ich die wenigen Schätze, die ich besitze, am See vergraben. Hol sie mit meinem Segen zurück.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131404
					],
					"speakerTitle": "Ruinenschatz"
				},
				{
					"id": 710131404,
					"content": "Aber bitte vergiss niemals diese drei Fragen. Ich hoffe, dass der Tag kommen wird, an dem du bereit bist, sie zu beantworten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruinenschatz"
				}
			]
		},
		{
			"id": 7101315,
