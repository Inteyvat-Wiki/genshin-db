				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710130901,
					"content": "Monster verwüsten die ganze Welt, und wir, die wir die Welt schützen wollen, müssen immer daran denken, dass die Monster nichts anderes verdienen als das gnadenlose Abschlachten. Und das werden sie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130902
					],
					"speakerTitle": "Ruinenschatz"
				},
				{
					"id": 710130902,
					"content": "Berühre die Stele",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7101310,
			"completionStepIds": [
				7101311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101309",
							"3"
						],
						"stepId": 7101309,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710131001,
					"content": "Mit diesen drei Fragen wandte ich mich an meinen Schulkameraden und fragte ihn danach. Aber er wurde zornig, beschuldigte mich, meine Pflicht zu vernachlässigen und ist wütend weggegangen. Mögen die wahren Antworten auf diese drei Fragen der Welt Frieden bringen. In meiner Zeit habe ich die Weisheiten der uralten Texte aus allen Winkeln der Welt gesammelt, habe mich hier in stiller Meditation verborgen und die Sprache der Monster studiert. All dies tat ich in der Hoffnung, deren wahre Natur zu verstehen. Ich errichte diese Stele, um mein Zeuge zu sein, falls derjenige kommt, der diese Fragen für immer lösen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131002
					],
					"speakerTitle": "Ruinenschatz"
				},
				{
					"id": 710131002,
					"content": "Berühre die Stele",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
