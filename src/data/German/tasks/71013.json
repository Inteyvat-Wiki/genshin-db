			"dialogs": [
				{
					"id": 710131601,
					"content": "An alle, die diese Stele betrachten: Sucht zuerst die Stelen im Berg, und kehrt erst dann zu der hier errichteten zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131602
					],
					"speakerTitle": "Ruinenschatz"
				},
				{
					"id": 710131602,
					"content": "Jeder, der sich ernstlich bemüht, mein Rätsel aufzulösen, sollte zuerst die Stelen im Berg suchen und sie der Reihe nach anschauen.",
					"roleType": "TALK_ROLE_NPC",
