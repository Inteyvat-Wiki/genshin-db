						220230202
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230202,
					"content": "Hmmm ... Ich kann es nicht abwarten, bitte lass es mich ausprobieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230203,
						220230204
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230203,
					"content": "Bitte genieße es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220230204,
					"content": "Schauen wir mal ... Über welche Gerichte haben wir gerade gesprochen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230205
					]
				},
				{
					"id": 220230205,
					"content": "Ach ja ... Mora-Medaillon, Pökeltopf, und Gulaschsuppe mit Gemüse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220230206,
					"content": "Entscheide dich und gib es Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
