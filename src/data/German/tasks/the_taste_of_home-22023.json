					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220230101,
					"content": "Aah, es wäre schön, Gerichte aus Liyue zu haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230102
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230102,
					"content": "Was ist mit dir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230103
					]
				},
				{
					"id": 220230103,
					"content": "#Wer bist du? Mit dieser Aufmachung ... Du bist {F#die}{M#der} Reisende, richtig? Tut mir leid, ich habe nur ein bisschen Heimweh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230104,
						220230105
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230104,
					"content": "Hast du gerade gesagt, dass du Gerichte aus Liyue haben willst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230118
					]
				},
				{
					"id": 220230118,
					"content": "Hm? Du weißt, wie man die Gerichte aus Liyue macht? Das ist großartig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230119
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230119,
					"content": "Dann hilf mir bitte! Bitte mach mir ein paar authentische Liyue-Gerichte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230120
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230120,
					"content": "Lass mich nachdenken ... Was ich jetzt wirklich essen möchte, ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230121
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230121,
					"content": "Hmmm! Ich will Fleisch essen! Viel, sehr viel Fleisch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230122
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230122,
					"content": "Die zarte Textur und das duftende Aroma des Fleisches gemischt mit Liyues speziellen Gewürzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230123
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230123,
					"content": "Allein der Gedanke daran lässt mich vor Hunger zittern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230124
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230124,
					"content": "Also, ich möchte Fleisch essen! Bitte hilf mir ein Liyue Gericht aus Fleisch zuzubereiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230105,
					"content": "Brauchst du Hilfe bei irgendetwas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230106
					]
				},
				{
					"id": 220230106,
					"content": "Ich möchte mich vorstellen. Ich bin Tang Wen, eine Historikerin aus Liyue. Ich habe zuvor eine Feldforschung über die einzigartigen Bräuche und die Folklore von Inazuma gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230107
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230107,
					"content": "Ich war dabei, nach Liyue zurückzukehren, da ich mit dem Sammeln von Informationen fast fertig war. Aber wegen Inazumas Sakoku-Dekret bin ich hier für eine lange Zeit gestrandet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230108
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230108,
					"content": "Eigentlich denke ich, dass das eine gute Sache für mich ist. Denn ich habe das Gefühl, dass dies ein historischer Moment für Inazuma ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230109
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230109,
					"content": "Ich bin mir ziemlich sicher, dass diese besondere Periode sicherlich einen starken Eindruck in der Geschichte von Teyvat hinterlassen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230110
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230110,
					"content": "Eine solche Geschichte mit eigenen Augen mitzuerleben und dann alles wahrheitsgetreu, vollständig und klar für die Nachwelt festzuhalten, ist das, was ein Historiker tun sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230111
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230111,
					"content": "Aber ... so aufregend diese Sache für mich auch ist, meinen Magen wird es nicht zufriedenstellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230112
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230112,
					"content": "Bekommst du Hunger?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230113
					]
				},
				{
					"id": 220230113,
					"content": "Ich kann es nicht sagen ... Ja, es liegt daran, dass ich hungrig bin ... Hahaha, Inazumas Essen ist auch ziemlich lecker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230114
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230114,
					"content": "Ich mag das Tempura hier wirklich, obwohl es sich anfühlt, als ob alles mit Teig überzogen und dann frittiert wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230115
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230115,
					"content": "Aber nachdem ich lange Zeit die Inazuma-Gerichte gegessen hatte, begann ich, die Liyue-Gerichte zu vermissen. Leider konnte ich kein Restaurant finden, das authentische Liyue-Küche zubereiten konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230116
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230116,
					"content": "Ich habe mich vor ein paar Tagen dazu entschlossen, eine Mission für Gerichte bei der Abenteurergilde auszuhängen, aber es gab noch keine Reaktion ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230117
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230117,
					"content": "Kann ich es versuchen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230118
					]
				}
			]
		},
