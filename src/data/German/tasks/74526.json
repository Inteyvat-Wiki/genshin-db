				"points": []
			},
			"dialogs": [
				{
					"id": 745260401,
					"content": "#Ah, {NICKNAME}, da bist du ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260402,
						745260403
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260402,
					"content": "Nilou, übst du etwa gerade?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				},
				{
					"id": 745260404,
					"content": "Nein, nein. Ich arbeite gerade an einem neuen Tanz, inspiriert von Padisarah nach dem Regen, wenn die Blütenblätter noch mit Tautropfen bedeckt sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260405
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260405,
					"content": "Aber bisher ist es nur die erste Version. Viele Bewegungen wirken noch nicht elegant genug, und irgendwie fehlt noch das gewisse Etwas ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260406,
						745260407
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260406,
					"content": "Wie du das so beschreibst, klingt es schon wunderschön ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260408,
					"content": "Du möchtest ein Foto von mir machen? Aber wie ich gerade gesagt habe, bin ich mit diesen Tanzschritten noch nicht so vertraut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260409,
						745260410
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260409,
					"content": "Das Üben, bevor man den Tanz vollständig beherrscht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260411,
					"content": "Ah, ich verstehe! Dann werde ich meine Gefühle in meine Tanzschritte einfließen lassen ... Fange mit deiner Kamera den Moment ein, in dem die Blume erblüht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260410,
					"content": "... ist auch ein Teil der Kunst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260407,
					"content": "Darf ich ein Foto von dir machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260403,
					"content": "Ich hoffe, ich störe dich nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				}
			]
		}
	]
