			"dialogs": [
				{
					"id": 721130501,
					"content": "Her mit dem Bambusstäbchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130502
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130502,
					"content": "Gut, hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130503
					]
				},
				{
					"id": 721130503,
					"content": "Diesem Schrein scheint wirklich die ganze göttliche Zuneigung zu fehlen, hm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130504,
					"content": "Hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130505
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130505,
					"content": "Sehen wir uns mal dein Horoskop an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130506,
					"content": "Ah ja. Du kannst am Tag nur einen Zettel ziehen. Bitte vergiss das nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130507
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130507,
					"content": "Es ist sonst zu anstrengend ... Warte, nein. Wenn nicht, kannst du den Orakelzettelanhänger nicht verwenden, um ... Nein, das ist auch nicht richtig. Was sollte ich sagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130508
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130508,
					"content": "„Orakelzettel sind die Manifestation des Willens unseres Archons. Es ist unsere Aufgabe als Sterbliche, ihn zu respektieren und alles zu tun, was wir können.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130509
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130509,
					"content": "Siehst du? Elegant geschrieben. Denke also daran, dass du jeden Tag nur einen ziehen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gendou Ringo"
				}
			]
		},
		{
			"id": 7211306,
			"completionStepIds": [
