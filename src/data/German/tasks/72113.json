			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gendou Ringo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721131001,
					"content": "W... Wer seid ihr? Was wollt ihr hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131002
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131002,
					"content": "Wir sind diejenigen, die die Fragen stellen! Was willst du, Gendou, und warum hast du uns plötzlich angegriffen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131003,
					"content": "Wie unhöflich. Beantworte meine Frage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131004
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131004,
					"content": "#Ich bin {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131005
					]
				},
				{
					"id": 721131005,
					"content": "Sag mir die Wahrheit. Woher hast du den Geheimcode gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131006,
						721131008
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131006,
					"content": "P... Paimon sagte ihn mir ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131007
					]
				},
				{
					"id": 721131007,
					"content": "Warte, was sagst du da!? Sag Fräulein Gendou einfach, was passiert ist! Siehst du denn nicht den furchterregenden Blick in ihren Augen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131010,
					"content": "Aha, ich verstehe. Du bist also zufällig auf diese Notizen gestoßen. Wenn das so ist, muss Momoka ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131011
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131011,
					"content": "„Momoka“ ... Wer soll das sein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131012
					]
				},
				{
					"id": 721131012,
					"content": "Sie war diejenige, die diese Notizen verfasst hat, und sie war eine Kollegin von mir. Leider wird sie nicht mehr in der Lage sein, Inazuma weiter zu dienen. Eine wahre Schande ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131013
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131013,
					"content": "Sicherlich hast du viele Fragen. Ich denke, es kann nicht schaden, sie zu beantworten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131014
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131014,
					"content": "Momoka und ich sind beide Ninja im Shuumatsuban. Unsere Aufgabe ist es, Inazuma von äußeren Bedrohungen zu befreien, und diese „Papierstreifen“ sind eines der Mittel, mit denen wir unsere Missionen vermitteln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131015
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131015,
					"content": "Infolgedessen haben wir auch eine Menge Groll und Gefahren ertragen müssen. Zum Beispiel von diesen seltsamen und gefährlichen Fremden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131016,
						721131018
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131016,
					"content": "Für mich klang er wie ein Mondstädter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131017
					]
				},
				{
					"id": 721131017,
					"content": "Was meinst mit Mondstädter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131020,
					"content": "Wenn sie den Geheimcode kennen, wissen wir, dass sie einer von uns sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131021
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131021,
					"content": "Allerdings ist der Geheimcode jeder Person einzigartig. Es scheint, dass Momoka absichtlich seinen Geheimcode hinterlassen hat, um den Shuumatsuban über die Situation zu informieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131022
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131022,
					"content": "... um den Feind, der diesen Code benutzt, herauszulocken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131023
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131023,
					"content": "Also ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131024
					]
				},
				{
					"id": 721131024,
					"content": "Du hast es also sofort herausgefunden, nicht wahr, Fräulein Gendou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131025
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131025,
					"content": "Ja, natürlich. Deshalb bin ich dir gefolgt ... um die Situation zu erkunden. Aber es war wirklich seltsam. Ich konnte es nicht herausfinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131026
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131026,
					"content": "Wenn ihr wirklich Snezhnaya-Spione wärt, warum würdet ihr dann gehen und die Mission beenden, ohne einen weiteren Bericht zu machen oder weitere Aktionen durchzuführen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131027
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131027,
					"content": "Als solches glaube ich deine Geschichte über das verlassene Lager.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131028
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131028,
					"content": "Denn praktisch gesehen seid ihr Freunde und keine Feinde von Inazuma, obwohl ihr anfangs aus Neugierde den Code ausgesprochen habt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131029
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131029,
					"content": "Obwohl wir entlastet wurden, ist es immer noch ein bisschen ärgerlich, dass Gendou uns so lange als kostenlose Arbeitskräfte benutzt hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131030
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131030,
					"content": "Warst du diese Person wirklich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131031
					]
				},
				{
					"id": 721131031,
					"content": "Hm, war euch wirklich klar, dass die Gendou, die euch später den Auftrag gab, nicht die echte war?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131032
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131032,
					"content": "Was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131033
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131033,
					"content": "Als ich dich verfolgte, wurde ich von einigen Fatui-Spionen angegriffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131034
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131034,
					"content": "Ich weiß selbst ein oder zwei Dinge über Ninja-Künste, also habe ich meinen Tod vorgetäuscht, um sie zu täuschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131035
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131035,
					"content": "Es scheint, dass sie einfach einen ihrer eigenen Leute mich ersetzen ließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131036,
						721131037
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131036,
					"content": "Kein Wunder, dass sie sich so daneben fühlte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131038
					]
				},
				{
					"id": 721131038,
					"content": "Hm? Heißt das, dass das gutherzige Fräulein Gendou eine Fälschung war?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131039
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131039,
					"content": "„Freundlich“? Hm, die klingt ziemlich beliebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131040
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131040,
					"content": "Wie auch immer, sie müssen davon ausgegangen sein, dass du ein offizielles Mitglied des Shuumatsuban bist, und haben versucht, dich zu benutzen, um unsere Organisation zu infiltrieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131041
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131041,
					"content": "Dies erwies sich als eine gute Gelegenheit für mich. Während der Hochstapler unterwegs war, habe ich meine eigenen Methoden angewandt, um dich hierherzubringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131042
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131042,
					"content": "Hör gut zu. Ich werde dich jetzt vor die Wahl stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131043
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131043,
					"content": "Arbeite für uns als externes Mitglied. Sie wissen noch nicht, dass ich lebe, also ist der Vorteil derzeit bei uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131044,
						721131047,
						721131048
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131044,
					"content": "Was ist, wenn ich mich weigere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131045
					]
				},
				{
					"id": 721131045,
					"content": "Du könntest es sicherlich versuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131046
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131046,
					"content": "#Wie auch immer, {NICKNAME}, die Fatui sind auch unsere Feinde! Warum arbeiten wir nicht zusammen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131049
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131049,
					"content": "Eine weise Entscheidung. Die Vorräte in diesem Unterschlupf gehören dir und du kannst sie nach Belieben verwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131050
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131050,
					"content": "Na dann. Ich melde mich, wenn sich etwas Neues ergibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131051
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131051,
					"content": "Möge unsere Zusammenarbeit von Erfolg gekrönt sein. Auf Wiedersehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131052
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131047,
					"content": "Ein sinnvoller Vorschlag.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131049
					]
				},
				{
					"id": 721131048,
					"content": "Na gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131049
					]
				},
				{
					"id": 721131037,
					"content": "Kein Wunder, dass sie wusste, was ein Orakelzettel ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131038
					]
				},
				{
					"id": 721131018,
					"content": "Die Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131019
					]
				},
				{
					"id": 721131019,
					"content": "Das ist richtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131020
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131008,
					"content": "Hör mich einfach zu. Folgendes ist passiert ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131009
					]
				},
				{
					"id": 721131009,
					"content": "Wir fanden ein verlassenes Lager auf einem Hügel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131052
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}