			},
			"dialogs": [
				{
					"id": 721130601,
					"content": "Hä? Was ist das? Notizen von jemandem? Lass Paimon sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130602,
					"content": "„... Shiyuu ... Fatui ... Verschwörung gegen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130603,
					"content": "Was ist das? Es ist ein Durcheinander und alles ist mit Flecken übersät. Paimon kann es nicht wirklich lesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130604,
					"content": "Könnte ein Hinweis auf einen Schatz sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130605
					]
				},
				{
					"id": 721130605,
					"content": "Das hat Sinn! Lass Paimon noch einen Blick drauf werfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130606,
					"content": "„ ... beim Entschlüsseln des Stäbchens, des Geheimcodes ... “",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130607,
						721130608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130607,
					"content": "Das Stäbchen entschlüsseln?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130609
					]
				},
				{
					"id": 721130609,
					"content": "Lass Paimon sehen! „ ... Die erste Hälfte ist ... Inmitten der trüben Nacht ... “",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130610,
					"content": "Hier bricht es ab. Paimon kann nicht erkennen, was die zweite Hälfte ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130611,
					"content": "Aber wenn eine geheime Schrift verwendet wurde, verbirgt sich dahinter bestimmt etwas, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130612,
					"content": "Diese Geheimschrift scheint ziemlich wichtig zu sein. Wenn wir das nächste Mal einen Zettel entziffern, lass uns versuchen, den Code zu finden, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130608,
					"content": "Geheimcode?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130609
					]
				}
			]
		},
		{
