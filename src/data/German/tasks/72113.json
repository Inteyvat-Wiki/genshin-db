				{
					"id": 721130401,
					"content": "Lass Paimon sehen, lass Paimon sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130402,
					"content": "Oh, das ist Pech!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130403,
					"content": "Paimon erinnert sich an dieses Szenario! Man sollte ... „einen schlechten Zettel an den Orakelzettelanhänger binden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130404,
					"content": "„Und dann verwöhne Paimon mit einem guten Essen. Das wird helfen, das Unglück in Glück zu verwandeln!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130405,
					"content": "Ist das so?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130406
					]
				},
				{
					"id": 721130406,
					"content": "Aber natürlich! Stellst du die Weisheit der Ältesten in Frage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130407,
					"content": "Die Weisheit der Ältesten ist unglaublich! Wie auch immer, lass uns zuerst den Orakelzettelanhänger finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
