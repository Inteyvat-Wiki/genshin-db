			"dialogs": [
				{
					"id": 721130801,
					"content": "Hm? Wo ist Frau Gendou hin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130802,
					"content": "Das ist beunruhigend ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130803
					]
				},
				{
					"id": 721130803,
					"content": "Oder? Was ist, wenn sie nicht zurückkommt? Wie wird Paimon das heutige Schicksal erfahren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130804,
					"content": "Hm? Hier gibt es ein Stäbchen. Lass Paimon einen Blick darauf werfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130805,
					"content": "Wir sollten nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130806
					]
				},
				{
					"id": 721130806,
					"content": "Es spielt keine Rolle! Es könnte ein Hinweis sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130807,
					"content": "Hm? Das ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130808,
					"content": "Scheint uns zu sagen, dass wir diesen Ort besuchen sollen, um die nächste Anweisung zu erhalten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130809,
					"content": "Lass es uns herausfinden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7211309,
