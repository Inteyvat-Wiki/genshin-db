			"dialogs": [
				{
					"id": 721130901,
					"content": "Das ist der Ort?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130902,
					"content": "Was ist da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130903,
					"content": "Du bist tatsächlich aufgetaucht, genau wie ich es erwartet habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gendou Ringo"
				}
			]
		},
		{
