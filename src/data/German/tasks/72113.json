				"points": []
			},
			"dialogs": [
				{
					"id": 721130701,
					"content": "Fräulein Gendous Einstellung ist immer noch ... Wie auch immer, lass uns den Inhalt des Zettels überprüfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130702,
					"content": "Hm? Das ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130703,
					"content": "Paimon hat es verstanden. Das muss sich auf einen Bösewicht beziehen, der besiegt werden muss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130704,
					"content": "Ja, das war’s. Es stellt sich heraus, dass Fräulein Gendou eine Geheimagentin ist, die diese Methode benutzt, um zu kommunizieren und diejenigen auszulöschen, die versuchen, Inazuma zu schaden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130705,
					"content": "Wie laut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130706
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130706,
					"content": "Puh! T... Tut uns leid! Bitte lass uns nicht verschwinden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130707,
					"content": "Geh jetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130708
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130708,
					"content": "Wir brechen jetzt sofort auf! Lass uns zu dem Ort gehen, der auf dem Gemälde abgebildet ist und schauen, ob wir das Ziel finden können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
