					"content": "Lass Paimon sehen, lass Paimon sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130302,
					"content": "Ja, nicht schlecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130303,
					"content": "Mit Paimon zusammen zu sein, wird dir sicherlich Glück bringen!",
					"roleType": "TALK_ROLE_NPC",
