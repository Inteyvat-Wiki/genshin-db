			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Degui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223030101,
					"content": "Es wird immer schwieriger, hier Geschäfte zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030102
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030103
					]
				},
				{
					"id": 223030103,
					"content": "Hm? Oh, ich meine die Taverne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030104
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030104,
					"content": "Wenn so ein Laden erst einmal steht, gibt es Vor- und Nachteile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030105
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030105,
					"content": "Das Gute ist, dass man mit der Zeit einen gewissen Ruf bekommt und damit ein stetiges Einkommen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030106
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030106,
					"content": "Das Schlechte ist, dass die Leute auch irgendwann einmal genug haben. Solange man aber genügend im Angebot hat, dass keinem langweilig wird, ist das kein Problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030107
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030107,
					"content": "Bei dieser kleinen Taverne ist das aber schwierig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030108
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030108,
					"content": "Unsere Stammkunden kennen alles in- und auswendig und kommen mittlerweile immer seltener.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030109
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030109,
					"content": "In Mondstadt soll die Getränkewirtschaft richtig gut laufen. Der „Löwenzahnschnaps“ soll sich verkaufen wie warme Semmeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030110
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030110,
					"content": "Ich kann mir zwar nur schwer vorstellen, dass man Löwenzahn für ein Getränk verwenden kann. Es lohnt sich aber immer, etwas Neues zu probieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030111
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030111,
					"content": "Könntest du nach Mondstadt gehen und etwas Löwenzahn mitbringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030112,
						223030114
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030112,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030113
					]
				},
				{
					"id": 223030113,
					"content": "Ich danke dir. Eine Belohnung wirst du auch kriegen. Hier in Liyue hält man sich an seine Versprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030114,
					"content": "Löwenzahnschnaps?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030115
					]
				},
				{
					"id": 223030115,
					"content": "Ja, wieso? Ist das keine gute Idee? Er soll sehr beliebt in Mondstadt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030116
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030116,
					"content": "An das Rezept von Löwenzahnschnaps würde ich sowieso nicht kommen. Das brauche ich also gar nicht erst zu versuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030117
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030117,
					"content": "Bring mir einfach etwas <color=#00E1FFFF>Löwenzahn</color>. Ich werde dann etwas nach Liyue-Art daraus zubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Degui"
				}
			]
		},
