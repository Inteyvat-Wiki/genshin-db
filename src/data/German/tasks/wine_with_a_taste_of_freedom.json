			"dialogs": [
				{
					"id": 223030301,
					"content": "Ich werde es einfach probieren. Mal sehen, ob es mit den Methoden aus Liyue funktioniert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030302
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030302,
					"content": "Aber hier kriegst du erstmal das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030303
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030303,
					"content": "Wenn ich versuche, Alkohol aus Löwenzahn herzustellen, werde ich sicher einige Male scheitern. Wenn ich keinen mehr habe, brauche ich vielleicht wieder deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Degui"
				}
			]
		}
	]
