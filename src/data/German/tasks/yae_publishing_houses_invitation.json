				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060401,
					"content": "Nun ... Die Inhalte sind nicht übel, recht originell ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060402
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060402,
					"content": "Xingqiu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060403
					]
				},
				{
					"id": 728060403,
					"content": "Ah, so ist das also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060404
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060404,
					"content": "Xingqiu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060405
					]
				},
				{
					"id": 728060405,
					"content": "#He! Du bist es, {NICKNAME}, lange nicht mehr gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060406
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060406,
					"content": "Du klangst, als wärst du gut gelaunt, nicht schlecht, nicht schlecht ... Was kann ich für dich tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060407
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060407,
					"content": "Eigentlich wollten wir dich nach jemandem fragen, du hast viel gelesen, du kennst ihn vielleicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060408,
					"content": "Eine Person? Suchst du nach irgendwelchen Autoren? Nun ... es tut nicht weh, mal zu fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060409
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060409,
					"content": "Über „Zhenyu“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060410
					]
				},
				{
					"id": 728060410,
					"content": "„Zhenyu“? Wo ... hast du diesen Namen gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060411
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060411,
					"content": "Er steht in diesem Buch geschrieben, „Vom Schwert gefunden im Herbst“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060412
					]
				},
				{
					"id": 728060412,
					"content": "Wir sind auf der Suche nach diesem „Zhenyu“ und „Verlagshaus Yae“ auf Inazuma hat uns gebeten, einen Brief an den Autor zu liefern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060413,
					"content": "Weißt du, wer dieser „Zhenyu“ wirklich ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060414,
					"content": "Nun ... dieser „Zhenyu“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060415
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060415,
					"content": "Ich schäme mich zu sagen, dass es eigentlich genau ... mein Pseudonym ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060416
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060416,
					"content": "He?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060417,
					"content": "Davon höre ich das erste Mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060418
					]
				},
				{
					"id": 728060418,
					"content": "Diese Sache ... ist nichts, was ich an die große Glocke hängen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060419
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060419,
					"content": "Als ich in Liyue war, sagte der verantwortliche Redakteur, dass das Buch, das ich schrieb, „so unverschämt in der Einstellung und so unerwartet kitschig in der Handlung ist, dass es niemandem gefallen wird“, und lehnte dann mein Manuskript ab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060420
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060420,
					"content": "Als ich davon hörte ... Ähem, war ich nicht allzu überzeugt, also habe ich selbst ein paar Exemplare ausgedruckt und sie heimlich in die „Buchhandlung Wanwen“ gelegt, um zu sehen, ob sie jemandem gefallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060421
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060421,
					"content": "Wie sich herausstellte, gab es immer nur sehr wenige Leser, also habe ich nicht weiter darüber nachgedacht. Ich hatte keine Ahnung, dass das Buch in Inazuma so gut ankommen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060422
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060422,
					"content": "Aber auf jeden Fall ist es natürlich gut, dass jemand dieses Buch, das ich geschrieben habe, lesen will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060423
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060423,
					"content": "#Ich werde mir den Brief genau ansehen, danke dir, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingqiu"
				}
			]
		},
		{
