			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang IX."
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060201,
					"content": "#Hm? {F#Reisende}{M#Reisender}, weswegen bist du heute vorbeigekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060202
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 728060202,
					"content": "Hier sind ein Brief und Geschenke vom „Verlagshaus Yae“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060203
					]
				},
				{
					"id": 728060203,
					"content": "Ein Brief vom Verlagshaus Yae? Sie bitten mich doch nicht schon wieder, mein Pseudonym zu ändern, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060204
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 728060204,
					"content": "Ich habe ihnen schon tausendmal gesagt, dass ich unter meinem richtigen Namen schreiben werde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060205
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 728060205,
					"content": "*seufz* Ach, vergiss es. Lass mich mal gucken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060206
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 728060206,
					"content": "Sie wollen, dass ich bei einem Roman-Schreibwettbewerb die Ergebnisse beurteile ... Hmm. Ich glaube nicht, dass ich die Zeit dazu habe, aber ich sollte ihnen trotzdem danken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060207
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 728060207,
					"content": "Hm? Warum steht danach noch so viel mehr? Das sind ... kreative Ideen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060208
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 728060208,
					"content": "#Äh, ich ... ich werde es mir genau ansehen. Danke, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang IX."
				}
			]
		},
		{
			"id": 7280604,
			"completionStepIds": [
				7280604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
