			},
			"dialogs": [
				{
					"id": 728060501,
					"content": "He, du bist endlich wieder da! Wie war es? Hast du die beiden Autoren gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060502
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060502,
					"content": "Ich habe die Briefe zugestellt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060503
					]
				},
				{
					"id": 728060503,
					"content": "#Großartig! Danke, {F#Reisende}{M#Reisender}, was ist mit den beiden Autoren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060504
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060504,
					"content": "Sie sagten, sie hätten die Briefe aufmerksam gelesen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060505
					]
				},
				{
					"id": 728060505,
					"content": "Dann ist gut. Hach ... es ist schade, dass diese beiden Autoren so weit weg in Liyue sind ... und es keine Möglichkeit gibt, sie einfach so zu besuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060506
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060506,
					"content": "Insbesondere das Buch „Vom Schwert gefunden im Herbst“ von Zhenyu war noch kein Manuskript, das er selbst eingereicht hatte, sondern wurde von einem Gasthändler nach Inazuma gebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060507
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060507,
					"content": "Dann las einer unserer Redakteure im „Verlagshaus Yae“ das Buch, spürte den Wert des Buches und bereitete sich darauf vor, persönlich nach Liyue zu reisen, um „Zhenyu“ ein formelles Angebot zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060508
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060508,
					"content": "Aber die Situation in Inazuma hat sich so sehr verändert, dass wir niemanden nach Liyue schicken können, und wir haben von den Briefen, die wir geschickt haben, nichts zurückbekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060509
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060509,
					"content": "Wir müssen das Buch selbst ausstellen und die Zahlung an Zhenyu weitergeben und ihn gemeinsam bezahlen, nachdem wir uns gemeldet haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060510
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060510,
					"content": "Allerdings ist es schon so lange her, dass die Verkäufe von „Vom Schwert gefunden im Herbst“ angestiegen sind und sich der Manuskriptlohn angehäuft hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060511
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060511,
					"content": "Oh, „Zhenyu“ muss an diesem Wettbewerb teilnehmen, die Bezahlung ... die Bezahlung kann sich nicht weiter auftürmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aratani"
				}
			]
		},
