	"talks": [
		{
			"id": 1300301,
			"completionStepIds": [
				1300301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300301",
							"2"
						],
						"stepId": 1300301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030101,
					"content": "... Letzten Endes war der Austritt des Flusses der Elemente tief im Wald die Ursache von dem verunreinigten Gebiet. Jetzt ist alles wieder normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030102,
					"content": "So ist es also, vielen Dank für eure Mühen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 130030103,
					"content": "Sobald sich die Überreste vom Fluss der Elemente in der Luft aufgelöst haben, können wir eine Ankündigung platzieren. So können die Bewohner ihre normalen Aktivitäten wieder aufnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 130030104,
					"content": "Hier, das ist eure versprochene Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 130030105,
					"content": "Nachdem du die Abenteurergilde verlässt, wirst du von Paimon an einen ruhigen Ort gebracht ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130030106
					]
				},
				{
					"id": 130030106,
					"content": "Wird Karkata ... zur Akademie gebracht werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030107,
					"content": "Auch wenn er bereits schwer beschädigt ist, ist Paimon traurig, dass er demontiert werden wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030108,
					"content": "Mir geht es genauso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030109
					]
				},
				{
					"id": 130030109,
					"content": "Wollen wir Tighnari dann morgen bitten, es nicht zu tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030110,
					"content": "Auch wenn Paimon jetzt gern gehen würde, würde Tighnari dann nicht wütend werden? Immerhin hat er gesagt: „Falls es irgendetwas gibt, können wir morgen darüber sprechen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030111,
					"content": "Ja ... das stimmt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030112
					]
				},
				{
					"id": 130030112,
					"content": "Dann ist das abgemacht! Morgen gehen wir zu Tighnari und sagen ihm, dass er Karkata nicht demontieren soll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1300303,
			"completionStepIds": [
				1300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300303",
							"2"
						],
						"stepId": 1300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tighnari",
					"Karkata"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030301,
					"content": "Tighnari ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030302,
					"content": "Psst ... ein wenig leiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030303
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030303,
					"content": "Lila Seidelbast, ein duftender Seidelbast aus der Familie Seidelbastgewächse. Er hat eine gute anti-konvulsive Wirkung und kann so als Anästhetikum verwendet werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030304
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030304,
					"content": "Den Daten zweier Gruppen von Experimenten ist zu entnehmen, dass seine Toxizität für Fische außergewöhnlich hoch ist ... schreib das auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030305
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030305,
					"content": "*grummel*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030306
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030306,
					"content": "Karkata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030307,
					"content": "*grummel*!*grummel*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030308
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030308,
					"content": "Habe ich nicht gesagt, ihr sollt leise sein? Selbst wenn Pflanzen sich nicht an Geräuschen stören, meine Ohren erschüttern sie sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030309
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030309,
					"content": "Du ... Du hast Karkata nicht demontiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030310,
					"content": "Warum sollte ich das tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030311
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030311,
					"content": "Aber du hast doch gesagt „nach den Regeln der Akademie“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030312,
					"content": "Deshalb stört ihr so früh am Morgen meine Ruhe. Nun gut, ich habe mich gestern wohl nicht klar ausgedrückt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030313
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030313,
					"content": "Was ich meinte ist, da die Regeln der Akademie die Zerstörung aller Forschungsergebnisse vorsehen, darf die Akademie nichts erfahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030314
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030314,
					"content": "Du bist dort geblieben, um ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030315
					]
				},
				{
					"id": 130030315,
					"content": "Da habe ich Karkata repariert. Kaum zu glauben, dass ich eines Tages meine Stoffkunde-Kurse aus der Akademie zum Einsatz bringen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030316
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030316,
					"content": "Danach habe ich Abattouy zusammen mit ihm zur letzten Ruhe gebettet. Das experimentelle Material habe ich kurz geordnet, einen Teil davon zur Erinnerung mitgenommen, den Großteil verbrannt und vergraben, um alle Beweise zu beseitigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030317
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030317,
					"content": "Ich bin nicht an der Akademie, warum sollte ich mich an ihre Regeln halten? Ganz im Gegenteil. Ich bin jetzt der Waldhütermeister des Avidya-Waldes. Es ist meine Aufgabe, das Leben im Wald zu bewahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030318
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030318,
					"content": "Alles Leben dieser Erde hat seine Bedeutung. Bei ihm ist es nicht anders. Er lebt, also sollte er nicht einfach aufgegeben oder zerstört werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030319
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030319,
					"content": "Hehe! Wunderbar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030320,
					"content": "*grummel grummel*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030321
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030321,
					"content": "Tighnari, du sagtest gerade „alles Leben“. Heißt das, du siehst Karkata als „echtes Leben“ an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030322,
					"content": "Vielleicht. Immerhin hat er versucht, Abattouy zu reparieren. Dafür kann es keine andere Erklärung geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030323
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030323,
					"content": "Tatsächlich hat Abattouy nur einen kleinen Teil seiner Experimente notiert. Es ist unmöglich zu sagen, welche Befehle er noch gegeben hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030324
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030324,
					"content": "Vielleicht war es nur ein Konflikt zwischen den Befehlen, der zu Karkatas Verhalten geführt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030325
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030325,
					"content": "Wenn man es genau nimmt, ist es unmöglich, zu dem Schluss zu kommen, dass „Karkata wirklich lebt“. Aber da es möglich ist, bin ich auch bereit, es zu glauben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030326
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030326,
					"content": "*grummel*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030327
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030327,
					"content": "Nebenbei gesagt, ich bin in keiner Weise interessiert, diese Experimente fortzuführen. Ich lasse ihn hier bleiben, nur weil er hier einigermaßen versteckt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030328
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030328,
					"content": "Aber wie es jetzt aussieht, wäre es auch nicht schlecht, ihn als Forschungsassistent an meiner Seite zu haben. Er könnte zumindest das Forschungsjournal führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030329
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030329,
					"content": "Was hältst du davon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030330
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030330,
					"content": "*grummel*!*grummel*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Karkata"
				}
			]
		},
