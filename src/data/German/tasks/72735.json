			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Großer Panzer Sennichi“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727350101,
					"content": "He, ihr drei! Wer ist der Boss? Komm heraus und stell dich mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350102
					],
					"speakerTitle": "„Großer Panzer Sennichi“"
				},
				{
					"id": 727350102,
					"content": "Ich, der „Große Panzer Sennichi“, bin der Stärkste unter den Eliten. Um „Marschall Hanakados“ Willen bin ich hier und werde dem Boss der Arataki-Bande sein Haupt abschlagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350103
					],
					"speakerTitle": "„Großer Panzer Sennichi“"
				},
				{
					"id": 727350103,
					"content": "Waah! Er sieht wild aus und klingt auch so! Scheint, dass wir diesmal einen wirklich sehr mächtigen Gegner getroffen haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727350104,
					"content": "Halt einfach die Klappe, deine Worte sind so bedeutungslos wie dein Titel! Versuchst du, mir mein Rampenlicht zu stehlen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350105,
					"content": "Heute bin ich gerade in der Stimmung, den Stärksten unter den Eliten zu verprügeln!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350106,
					"content": "So ... So groß! Und du bist ... Du bist ein Oni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350107
					],
					"speakerTitle": "„Großer Panzer Sennichi“"
				},
				{
					"id": 727350107,
					"content": "Du siehst doch so majestätisch und heldenhaft aus, warum magst du Käferkämpfe? Das ist doch ein Spiel für Kinder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350108
					],
					"speakerTitle": "„Großer Panzer Sennichi“"
				},
				{
					"id": 727350108,
					"content": "Was? Kinderspiel? Verachtest du den Käferkampf? Wie kannst du es wagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350109,
					"content": "Scheint mir, als wüsstest du nicht das Geringste über Käferkämpfe. Lass mich dir eine Lektion erteilen und dein Missverständnis korrigieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350110,
						727350111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350110,
					"content": "Erteile ihm eine Lektion!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				},
				{
					"id": 727350112,
					"content": "Ja, ja, du kannst diesen Kerl nicht weiter stolzieren lassen! Los, Kuhhirte, stampf ihn nieder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727350113,
					"content": "Also gut ... Komm, her damit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Großer Panzer Sennichi“"
				},
				{
					"id": 727350111,
					"content": "Korrigiere sein Missverständnis!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				}
			]
		}
	]
}