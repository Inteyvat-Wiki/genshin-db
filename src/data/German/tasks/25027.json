			},
			"dialogs": [
				{
					"id": 250270201,
					"content": "Herr Milu hat eine neue Platte rausgebracht. Soll ich mir die kaufen oder nicht ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270202
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270202,
					"content": "Über die früheren Schallplatten von Milu Nui ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270203
					]
				},
				{
					"id": 250270203,
					"content": "Hm? Seine Schallplatten sind klasse! Haloa und die Saurierbabys hören die total gern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270204
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270204,
					"content": "Immer wenn sie nicht schlafen wollen, spiele ich ihnen Milus Frühlingshymne vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270205
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270205,
					"content": "Dann schlafen sie immer ganz brav ein, und zwar tief und fest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270206
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270206,
					"content": "Hach ... Aber Haloa sagt immer, sie steht mehr auf fetzigere Lieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270207
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270207,
					"content": "Wenn Herr Milu doch nur ein paar peppigere Lieder schreiben würde ... Dann hätte sie noch mehr Spaß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahina Nui"
				}
			]
		},
		{
			"id": 2502703,
			"completionStepIds": [
				2502703
