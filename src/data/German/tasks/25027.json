			"dialogs": [
				{
					"id": 250271301,
					"content": "#Puh ... {NICKNAME}, du bist echt geschickt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271302
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271302,
					"content": "Sieht so aus, als könntest du ziemlich gut mit solchen Hitzköpfen umgehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271303,
						250271305
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271303,
					"content": "Das war noch nicht mal die Hälfte von dem, was ich kann.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250271304
					]
				},
				{
					"id": 250271304,
					"content": "Das sehe ich. In jeder Hinsicht ... kann man dir das ansehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271307
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271307,
					"content": "Auch wenn der Weg ein wenig holprig war ... Am Ende habe ich doch eine ganze Menge brauchbarer Klangmaterialien gesammelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271308
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271308,
					"content": "Noch ein paar Vorbereitungen, dann kann ich bald mit den richtigen Aufnahmen anfangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271309
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271309,
					"content": "Hm, ich glaube, ich fange mal mit dem „Klang echter Kämpfe“ an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271310
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271310,
					"content": "... Nein, Moment mal, besser doch mit etwas anderem starten, das weniger ausgefallen ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271305,
					"content": "War in Ordnung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250271306
					]
				},
				{
					"id": 250271306,
					"content": "Du bist wirklich bescheiden. Ich danke dir nochmals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271307
