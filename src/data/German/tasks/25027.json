			"dialogs": [
				{
					"id": 250270401,
					"content": "Sieh dir die Vogelschar da vorn an, toll! Ihr Gesang ... könnte gut als Material herhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270402
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270402,
					"content": "Aber wenn es nur so wenige sind, ist ihr Gesang etwas dürftig. Wenn ich eine ganze Schar finde, könnte ich ihren Chor aufnehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270403
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270403,
					"content": "Moment mal, da vorn ist eine Koholasaurierherde. Hörst du, wie sie mit den Krallen über den Stein kratzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270404
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270404,
					"content": "Koholasaurier sind sehr empfindlich, also sollten wir ihnen nicht zu nahe kommen. Ich werde später Experten aus dem Stamm bitten, das Material zu besorgen. Wenn jemand das wuppen kann, dann sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270405
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270405,
					"content": "Das da sind ... Stammeskrieger, die sich gerade messen. Nicht schlecht, das Geräusch echter Kämpfe klingt richtig gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270406
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270406,
					"content": "He! Wer ist denn das daneben? Was machst du da? Willst du Ärger!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270407
					],
					"speakerTitle": "Wütender Stammeskrieger"
				},
				{
					"id": 250270407,
					"content": "Wir sind hier um ... Material zu sammeln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270408
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270408,
