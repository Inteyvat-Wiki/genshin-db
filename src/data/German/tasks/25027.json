			"dialogs": [
				{
					"id": 250270701,
					"content": "Erstmal musst du die Meinung der Kunden einholen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270702
					]
				},
				{
					"id": 250270702,
					"content": "Ähm ... Ich habe nichts gegen deine Meinung. Ich habe schließlich schon viele Leute gefragt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270703
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270703,
					"content": "Aber ich glaube, sie haben nur die netten Dinge gesagt, weil ich sie persönlich gefragt habe ... Ich glaube, dass sie mir nicht sagen werden, was sie wirklich denken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270704
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270704,
					"content": "#{NICKNAME}, könntest du bitte mal die Meinung der Kunden einholen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270705
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270705,
					"content": "Dir gegenüber ... sagen sie bestimmt eher, was sie wirklich denken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				}
			]
		},
