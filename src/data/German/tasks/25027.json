			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Milu Nui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270101,
					"content": "Man kann mit Pakaa einfach nicht reden! Er hat gar keinen Plan von meinen musikalischen Ambitionen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270102,
						250270103
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270102,
					"content": "Was ist passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270104
					]
				},
				{
					"id": 250270104,
					"content": "#Ah, du bist also ein{F#e} ... Reisende{M#r}? Sei mir gegrüßt, ich bin Milu Nui, ein Musiker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270105
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270105,
					"content": "Falls du schon mal im Musikladen Xochicuicatl warst, hast du da bestimmt meine Schallplatten in der Abteilung für Popmusik gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270106
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270106,
					"content": "Auf diesen Schallplatten ist meine Interpretation von „Popmusik“ verewigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270107
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270107,
					"content": "Aber Pakaa versteht mich überhaupt nicht und meint, meine Musik klinge mehr nach „Kinderliedern“ als nach „Pop“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270108
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270108,
					"content": "Und wie sehr ich auch darauf beharre, er räumt meine Schallplatten immer in die Kinderlieder-Abteilung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270109
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270109,
					"content": "Gut, die Kinder mögen sie tatsächlich auch, und manche Eltern kaufen sie ihnen als Geschenk ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270110
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270110,
					"content": "A... Aber, Kinder sind die aufmerksamsten Zuhörer! Und es gibt eine Menge Kinder im ganzen Stamm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270111
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270111,
					"content": "Also, wenn meine Schallplatten bei den Kindern so durch die Decke gehen, dann gehören sie unbedingt in die Popmusik-Abteilung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270112,
						250270113
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270112,
					"content": "Das ergibt ... schon irgendwie Sinn ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270114
					]
				},
				{
					"id": 250270114,
					"content": "Oder? Hmpf, ich wusste es, Pakaa hat einfach keinen Geschmack. Warte nur, bis ich dieses neue Lied fertig geschrieben habe, dann wird er mich feiern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270115
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270115,
					"content": "#Ich vertraue seinem musikalischen Urteil nicht mehr ... Sag mal, Reisende{M#r}, wie gut kennst du dich mit Musik aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270116
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270116,
					"content": "Öhm ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270117
					]
				},
				{
					"id": 250270117,
					"content": "Spielst du ein Instrument? Es ist auch in Ordnung, wenn du nur singst oder summst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270118,
						250270120
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270118,
					"content": "Ja klar, ich kann das alles ziemlich gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270119
					]
				},
				{
					"id": 250270119,
					"content": "Das ist fantastisch! Dann verstehst du bestimmt meine musikalische Vision!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270122
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270122,
					"content": "Ich brauche gerade jemanden wie dich, um mir objektiv und professionell dabei zu helfen, ein neues Lied zu schreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270123
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270123,
					"content": "Mach dir keine Sorgen, ich werde dich ordentlich belohnen. Deine Mühe wird nicht umsonst sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270124
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270124,
					"content": "Also los, sei spontan und sag mir, was du denkst. Was sollte ich zuerst tun, um ein großartiges Musikstück zu produzieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270120,
					"content": "Ehrlich gesagt, nicht wirklich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270121
					]
				},
				{
					"id": 250270121,
					"content": "Das macht nichts! Gerade Leute wie du genießen Musik mit dem Herzen und können sie umso objektiver beurteilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270122
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270113,
					"content": "Du könntest es doch als „Kinder-Popmusik“ bezeichnen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270114
					]
				},
				{
					"id": 250270103,
					"content": "Was sind denn deine musikalischen Ambitionen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270104
					]
				}
			]
		},
