			"dialogs": [
				{
					"id": 250270901,
					"content": "Vielleicht sollten wir Geräusche als Material sammeln ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270902
					]
				},
				{
					"id": 250270902,
					"content": "Geräusche? Hm ... Du meinst, man könnte Naturklänge direkt in die Lieder einbauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270903
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270903,
					"content": "Oh ... das ist eine großartige Idee. Toll! Ich wusste, dass du scharfsinnig bist. Lass uns gleich loslegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270904
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270904,
					"content": "Moment mal, du gehst einfach ohne Ausrüstung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270905
					]
				},
				{
					"id": 250270905,
					"content": "Natürlich. Oder glaubst du, ich werde mit einem riesigen Grammofon durch die Gegend laufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270906
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270906,
					"content": "Keine Sorge, diesmal wollen wir nur herausfinden, welche Geräusche brauchbar sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270907
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270907,
					"content": "Zum Beispiel das Flattern von Entenflügeln, das Platschen eines Koholasauriers, wenn er ins Wasser taucht, oder das dumpfe Stampfen des Tepetlisauriers ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270908
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270908,
					"content": "Sobald wir wissen, was wir brauchen, bereite ich alles vor und mache die eigentlichen Aufnahmen. Aber das ist dann ein späterer Schritt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270909
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270909,
					"content": "Also, gehen wir am besten gleich los. Verlieren wir keine Zeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				}
			]
		},
