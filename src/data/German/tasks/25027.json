				"points": []
			},
			"dialogs": [
				{
					"id": 250270301,
					"content": "Waah! Schon wieder eine neue Platte. Die Saurierbabys werden sich freuen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270302
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270302,
					"content": "Über die früheren Schallplatten von Milu Nui ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270303
					]
				},
				{
					"id": 250270303,
					"content": "Ich mag Onkel Milus Lieder sehr und mein kleiner Saurier liebt sie noch mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270304
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270304,
					"content": "Immer wenn sie unruhig sind, spielt Mama Onkel Milus Lieder und sofort beruhigen sie sich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270305
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270305,
					"content": "Hmm, aber diese Lieder sind einfach zu lang, ich kann mir die Texte nie merken und so kann ich meinem Drachenbaby kein Liedchen singen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270306
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270306,
					"content": "Haha, wenn Onkel Milu die Texte kürzer machen könnte, würde ich meinem Kleinen jeden Tag ein Liedchen trällern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Haloa Nui"
				}
			]
		},
