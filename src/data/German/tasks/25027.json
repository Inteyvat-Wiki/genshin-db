			"dialogs": [
				{
					"id": 250270501,
					"content": "Wie sieht es aus, hast du Meinungen für mich eingeholt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270502
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270502,
					"content": "Ich habe die folgenden Meinungen gehört ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270503
					]
				},
				{
					"id": 250270503,
					"content": "Du teilst Milu Nui die Rückmeldungen der Leute mit ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250270504
					]
				},
				{
					"id": 250270504,
					"content": "Oh, so ist das? Danke, diese Rückmeldungen sind wirklich hilfreich. Ich werde versuchen, das zu adaptieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270505
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270505,
					"content": "Aber so wie die reden ... haben sie meine Schallplatten ja tatsächlich als „Kinderlieder“ einsortiert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270506
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270506,
					"content": "Nein, das geht so nicht, ich muss etwas ändern ... Aber wo soll ich bloß anfangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				}
			]
		},
