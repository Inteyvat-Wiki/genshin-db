			},
			"dialogs": [
				{
					"id": 732571401,
					"content": "Endlich wurde es ruhig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732571402,
					"content": "Nutzt die Gelegenheit und führt jetzt das Chinvat-Ritual durch, bevor die Unreinheit wieder herausfließt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571403
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571403,
					"content": "Dann ist unsere Arbeit erledigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571404
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571404,
					"content": "Dann kann ich ... ohne Unterbrechung ... ruhig schlafen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571405
					],
					"speakerTitle": "Rashnu"
				},
				{
					"id": 732571405,
					"content": "Komm, Sorush.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571406
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571406,
					"content": "Beeil dich ... Sorush.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571407
					],
					"speakerTitle": "Rashnu"
				},
				{
					"id": 732571407,
					"content": "Das müssen wir drei gemeinsam tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mihir"
				}
			]
		},
