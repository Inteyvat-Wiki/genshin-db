			},
			"dialogs": [
				{
					"id": 732571701,
					"content": "Mhm, damit ist unsere Arbeit erledigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732571702,
					"content": "An dem Baum scheinen Blumen gewachsen zu sein. Was sollen wir als nächstes tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732571703,
					"content": "Schaut mich nicht an, ich habe auch keine Ahnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571704
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571704,
					"content": "Apropos, jetzt, da Sorush bereits die Zwillingshorn-Blütenkrone getragen hat, kann sie sich durch die Blütenkrone mit den Erinnerungen und der Weisheit des Harvisptokhm verbinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571705
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571705,
					"content": "Versuch es mal damit, Sorush.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571706
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571706,
					"content": "Aber ich bin es noch nicht gewohnt, die Blütenkrone zu tragen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571707
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732571707,
					"content": "Hmm ... Ich sehe neue Knospen, aber die Unreinheit ist noch nicht ganz verschwunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571708
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732571708,
					"content": "Wir müssen noch diese Blumen reinigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571709
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732571709,
					"content": "Dadurch kann die reine Kraft der Khvarena wieder gedeihen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				}
			]
		},
