			"dialogs": [
				{
					"id": 732572901,
					"content": "Gut. Der Weg in die Tiefen der dunklen Mulde ist nun geöffnet, somit ist unsere Mission auch erfüllt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572902
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572902,
					"content": "Hä? So einfach? Ihr habt die ganze Zeit vom „Ritual“ gesprochen, also dachte Paimon, dass es eine Art Zauberspruch brauchen würde, um es zu vollziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732572903,
					"content": "Hmpf, sowas brauchen doch nur Menschen. Schließlich können sie die Kräfte der Elemente nicht einmal selbst beherrschen und nutzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572904
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572904,
					"content": "Bei uns Pari ist das anders, denn unsere Kraft und die der Khvarena stammen aus derselben Quelle. Ihr Menschen braucht beispielsweise beim Gehen auch keine Zaubersprüche sagen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572905
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572905,
					"content": "Ah ... das trifft auf dich nicht zu, denn statt zu gehen schwebst du.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572906
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572906,
					"content": "Deine Logik ist wirklich seltsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732572907,
					"content": "Nun, das war’s mit dem Geplauder. Die nächste Aufgabe überlasse ich euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572908
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572908,
					"content": "„O die ewigen Khvarena, sie werden uns den Weg nach oben weisen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mihir"
				}
			]
		},
