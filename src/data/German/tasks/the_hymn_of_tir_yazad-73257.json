			"dialogs": [
				{
					"id": 732573001,
					"content": "Jetzt, da wir das große Khvarena richtig platziert haben, scheint sich hier alles erholt zu haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732573002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732573002,
					"content": "Diese Bäume wurden ursprünglich von Kraft der Khvarena genährt, um der Korrosion der Katastrophe zu widerstehen. Es ist nur so, dass ihre Kraft im Laufe der Zeit erschöpft war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732573003
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732573003,
					"content": "Jetzt, da sie wieder von den Hymnen des Khvarena genährt sind, werden sie ihren früheren Glanz wiedererlangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732573004
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732573004,
					"content": "Aber da das Siegel entfernt ist, sollte auch die vergangene Unreinheit freigesetzt worden sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732573005
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732573005,
					"content": "Wenn Rashnu und ich all unsere Energie darauf verwenden würden, könnte das Ritual nicht vollzogen werden. Den Rest überlasse ich also euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732573006
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732573006,
					"content": "Hehe, auf mich kannst du dich verlassen! Das ist meine Aufgabe als eine Tapfere, gegen die Unreinheit zu kämpfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				}
