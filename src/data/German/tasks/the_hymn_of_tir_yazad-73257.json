			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732570101,
					"content": "Apropos, Sorush ist so schweigend, nachdem wir die Werkstatt verlassen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570102,
					"content": "Zuvor hat sie die ganze Zeit geredet. Paimon ist es wirklich nicht gewohnt, dass sie plötzlich so still geworden ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570103,
						732570104,
						732570105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570103,
					"content": "Sie muss entsetzt gewesen sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570106,
					"content": "Kopf hoch, Sorush! Wir haben noch so viel zu tun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570107,
					"content": "Zum Beispiel dieses ... ähm, dieses Ritual mit einem richtig komischen Namen. Dann müssen wir uns noch um das riesige Loch kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570108,
					"content": "Wenn alles erledigt ist, gönnen wir uns für all die harte Arbeit etwas Leckeres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570109,
					"content": "Zum Beispiel können wir ... Na ja, Paimon weiß nicht, was Pari gerne essen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570111
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570111,
					"content": "... Wir Pari müssen nichts essen, dummes Schweberchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570112
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570112,
					"content": "*seufz* Hätte nicht erwartet, dass mich eines Tages selbst das weiße Schweberchen trösten könnte. Was für eine Schande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570113
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570113,
					"content": "Wäre es möglich, würde ich lieber in einem Graukristall eingesperrt sein oder mir eine Höhle suchen, in der ich mich für die Ewigkeit verstecken kann, bis jeder, der mich kennt, aufhört zu existieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570114
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570114,
					"content": "Nenn Paimon nicht weißes Schweberchen, das hat Paimon doch mehrmals gesagt! Aber gibt es wirklich so eine Höhle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570115,
						732570117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570115,
					"content": "Vermeidung löst kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570116
					]
				},
				{
					"id": 732570116,
					"content": "Jetzt will ich mich um nichts mehr kümmern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570119,
					"content": "Ah, was für eine Schande, dass ich von Nasejuna wie ein Narr getäuscht worden bin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570120
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570120,
					"content": "Wie auch immer, jetzt, da ihr die Hymnen des Khvarena beschafft habt, könnt ihr selbst zu Mihir oder Rashnu gehen, um jenes Himmelszeichen zu lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570121
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570121,
					"content": "Lasst mich also in Ruhe. Tut einfach so, als hättet ihr nie gehört, was ich zuvor gesagt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570122
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570122,
					"content": "Hmm, da hast du tatsächlich eine Menge seltsamer Dinge gesagt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570123,
						732570124,
						732570125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570123,
					"content": "„Mein Yasnapati“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570126,
					"content": "Boah! Bitte, sag nichts weiter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570127
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570127,
					"content": "#{NICKNAME}, hör jetzt auf, dich über Sorush lustig zu machen! Schließlich sind wir schon so lange zusammen unterwegs, niemand von uns sollte auf halbem Weg aufgeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570128,
					"content": "Außerdem hat Sorush viele Stärken ... zum Beispiel ... ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570129,
					"content": "Du hast gerade gezögert! *schluchz* Hör auf, mich zu ärgern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570130,
						732570131
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570130,
					"content": "Zum Beispiel ist Sorush sehr motiviert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570132,
					"content": "Ja, ja. Und wir haben zusammen so viel getan, um das Himmelszeichen auszulöschen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570133,
					"content": "Dass wir es so weit geschafft haben, ist auch Sorush zu verdanken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570134,
					"content": "Wie heißt das noch gleich? Ah, ja, „solange man niemals aufhört, vorwärtszugehen, ist es nur eine Frage der Zeit, bis man ein wirklich großer Abenteurer wird.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570135,
					"content": "Wirklich? War euer Kompliment aufrichtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570136
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570136,
					"content": "#Ja, ein aufrichtiges Kompliment von {F#deiner Freundin}{M#deinem Freund}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570137
					]
				},
				{
					"id": 732570137,
					"content": "Hehe, ich wusste, dass ich großartig bin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570138
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570138,
					"content": "Auf einmal bin ich wieder voller Tatkraft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570139
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570139,
					"content": "Jetzt, da Sorush wieder motiviert ist, lasst uns zu Zurvan eilen, um das riesige Loch zu lösen und unsere Belohnung dafür zu erhalten. Paimon kann es kaum erwarten, ein tolles Essen zu haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570131,
					"content": "Zum Beispiel ist Sorush sehr verantwortungsbewusst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570124,
					"content": "„Heldentaten“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570125,
					"content": "„Schicksalhaftes Opfer“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570117,
					"content": "Es gibt noch Dinge, die du tun musst, nicht wahr?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570118
					]
				},
				{
					"id": 732570118,
					"content": "Stimmt schon, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570104,
					"content": "Schließlich hat sie so etwas durchgemacht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570105,
					"content": "Vielleicht ist sie einfach etwas müde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				}
			]
		},
		{
			"id": 7325702,
			"completionStepIds": [
				7325702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325702",
							"2"
						],
						"stepId": 7325702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zurvan"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							390.447,
							312.914,
							5703.516
						],
						"pointId": 4535
					}
				]
			},
			"dialogs": [
				{
					"id": 732570201,
					"content": "Zurvan, wir sind zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570202,
					"content": "#Oh, ihr seid es, {NICKNAME}, Sorush und Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570203
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570203,
					"content": "Nun, lasst mich mal raten. Ihr habt alle Hymnen des Khvarena erhalten, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570204,
						732570205
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570204,
					"content": "Ja, obwohl es etwas Mühe gekostet hat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570206
					]
				},
				{
					"id": 732570206,
					"content": "Wie auch immer, das Ergebnis stimmt. Es war ja eine richtige Entscheidung, euch diese Mission anzuvertrauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570207
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570207,
					"content": "Ohne euch wären die Hymnen des Khvarena vielleicht längst in die falschen Hände geraten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570208
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570208,
					"content": "Äh? Zurvans Worte klangen, als wüsste sie etwas bereits im Voraus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570209,
					"content": "Aha, anscheinend habe ich richtig geraten. Ihr seid tatsächlich auf die Diener der dunklen Mulde gestoßen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570210,
						732570212
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570210,
					"content": "Woher wusstest du das?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570211
					]
				},
				{
					"id": 732570211,
					"content": "Nun ... wie ich das wusste, spielt eigentlich keine Rolle. Erzählt mir zunächst, was genau passiert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570214,
					"content": "Du erzählst Zurvan von eurem Abenteuer in den unterirdischen Ruinen und dem Verrat von Nasejuna.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732570215
					]
				},
				{
					"id": 732570215,
					"content": "Hehe, sogar der Vijnanapati des Skeptikerordens hatte sich auf die Seite der dunklen Mulde gestellt. Obwohl ich nicht viel von ihnen erwartet habe, habe ich mit sowas wirklich nicht gerechnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570216
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570216,
					"content": "Wenn ich mich nicht irre, wurde er von einer Person aus der dunklen Mulde verleitet, gegen die ihr gekämpft habt, weshalb er die Hymnen des Khvarena ins Visier genommen hat. Diese Person ist auch eine alte Bekannte von mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570217
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570217,
					"content": "Hä? Du kennst jemanden vom Orden des Abgrunds?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570218,
					"content": "Hmpf, er war mal auch Mitglied des Skeptikerordens. Vor Jahrhunderten kam eine Untersuchungstruppe aus dem Regenwald hierher, um die Geheimnisse der Dahri zu erforschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570219
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570219,
					"content": "Trotz Warnungen des Skeptikerordens bestanden sie darauf, eine Ruine von Dahri zu betreten. Um Unfälle zu vermeiden, wurde er vom damaligen Vijnanapati dorthin geschickt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570220
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570220,
					"content": "Niemand wusste, was in der Ruine passiert war, aber als wir ihn wieder trafen, hatte er bereits den „Segen“ der Unreinheit angenommen. Die Untersuchungstruppe ging auch verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570221
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570221,
					"content": "Die Diener der dunklen Mulde folgten hierher. Sie begehrten die Hymnen des Khvarena und riefen zahllose Monster von Dev herbei, um die Oase anzugreifen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570222
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570222,
					"content": "Mit der Hilfe vieler Pari und menschlicher Recken gelang es uns, die Oase zu sichern, aber nicht alle Diener der dunklen Mulde wurden eliminiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570223
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570223,
					"content": "Um zu verhindern, dass sie diese Gelegenheit nutzten und sich einschlichen, versiegelte ich mit der Kraft der Hymnen des Khvarena die Oase und die vielen Ruinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570224
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570224,
					"content": "Als Folge dieses Verrats wurde der Skeptikerorden auch stark geschwächt. Alle Dokumente gingen bei einem Brand verloren. Und nach und nach wurde der Orden zu dem, was er heute ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570225
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570225,
					"content": "Nachdem ihr den Skeptikerorden zuvor erwähnt hattet, hatte ich das Gefühl, dass jemand des Ordens dahinter steckte. Unerwarteterweise war sogar ihr Anführer in diese Pläne verwickelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570226
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570226,
					"content": "Aber irgendwie ist Paimon besorgt über das, was Nasejuna gesagt hat. Zurvan, kannst du uns mehr über die Vorfahren des Skeptikerordens erzählen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570227,
					"content": "Schließlich hat Zurvan einst an ihrer Seite gekämpft.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570228
					]
				},
				{
					"id": 732570228,
					"content": "Hehe, aus Geschichte wird Legende, aus Legende wird Erzählung. Dies gilt grundsätzlich auch für die Weitergabe von Traditionen. Auch das Vergessen ist Teil der Erzählung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570229
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570229,
					"content": "Je mehr man sich an der Weitergabe der Traditionen klammert, desto mehr erinnert man sich nur noch an die gewünschte Erzählung und verliert sich schließlich im Labyrinth dieser Erzählung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570230
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570230,
					"content": "In einer Welt, in der alles jede Sekunde vergessen werden könnte, ist das, was wir in den Boden schnitzen, viel zuverlässiger als die Hymne, die schließlich vom Wind verweht wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570231
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570231,
					"content": "Deshalb vertraue ich euch. Denn ihr seid ehrliche Menschen und kümmert euch nicht darum, was andere über euch denken oder sagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570232
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570232,
					"content": "Hmm ... Ist das ein Kompliment? Klingt etwas seltsam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570233,
					"content": "Klingt ein wenig ironisch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570234
					]
				},
				{
					"id": 732570234,
					"content": "Ich glaube, was sie gesagt hat, war an mich gerichtet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570235
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570235,
					"content": "Was die Dinge vor fünfhundert Jahren betrifft, schlage ich vor, dass ihr es selbst herausfindet, was passiert ist, anstatt nach meiner Version zu fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570236
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570236,
					"content": "Und jetzt habt ihr genau so eine Gelegenheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570237
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570237,
					"content": "Übrigens, Sorush, du scheinst viel zuverlässiger geworden zu sein. Nach all dem, was du bisher durchgemacht hast, solltest du nun von diesem trügerischen Flüstern der Menschen erwacht haben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570238
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570238,
					"content": "Älteste! Bitte rede nicht mehr über die Vergangenheit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570239
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570239,
					"content": "#Offensichtlich war es richtig, diese Aufgabe {NICKNAME} und Paimon anvertraut zu haben. In Anbetracht dessen denke ich, dass ich das Ab-Zohr-Ritual ohne Vorbehalte auch in eure fähigen Hände geben kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570240
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570240,
					"content": "Das Ab-Zohr-Ritual ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570241
					]
				},
				{
					"id": 732570241,
					"content": "Paimon erinnert sich, dass Zurvan es vorhin erwähnt hat! Dabei geht es um die Reinigung von ... ähm ... einer Art Schmutz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570242,
					"content": "Das ist ein Ritual zur Reinigung des „Harvisptokhm“ von der Unreinheit. Normalerweise wird es unter Riesenbäumen durchgeführt, die die dunkle Mulde unterdrücken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570243
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570243,
					"content": "Doch jetzt, da das Siegel der dunklen Mulde schwächer wird und das Himmelszeichen wieder auftaucht, reicht ein normales Ab-Zohr-Ritual nicht mehr aus, um dieses Problem zu lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570244
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570244,
					"content": "Dieses Himmelszeichen erschien über Harvisptokhm, weil er eine große Menge an Unreinheit absorbierte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570245
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570245,
					"content": "Im Harvisptokhm hat sich zu viel Unreinheit angesammelt. Außerdem wurde er durch die Erosion des seltsamen Zeichens stark geschwächt und kann daher die Kraft der Khvarena nicht länger aufrechterhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570246
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570246,
					"content": "Was uns jetzt zu tun bleibt, ist, Harvisptokhm zu betreten, um ihn zu reinigen und das Bewusstsein unserer Gottheit zu erwecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570247
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570247,
					"content": "Man kann also tatsächlich Harvisptokhm betreten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570248,
					"content": "Natürlich. Dachtet ihr etwa, dass das Chinvat-Ritual in der dunklen Mulde vollzogen werden sollte? Selbst wir Pari könnten solche Unreinheit nicht aushalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570249
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570249,
					"content": "Der Riesenlotos „Gaokerena“, der das göttliche Bewusstsein beherbergt, befindet sich im Harvisptokhm. Solange die Unreinheit gereinigt wird, wird die Blume der Heiligkeit erneut blühen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570250
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570250,
					"content": "Und dann wird das Amrita die ganze Erde von all ihrer Unreinheit befreien. Auch wenn euch dieser Vorgang etwas kompliziert erscheinen mag, sollte das für euch kein Problem darstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570251
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570251,
					"content": "Nun, ich habe Rashnu und Mihir bereits zur Tunigi-Mulde geschickt. Ihr müsst nur die Hymnen mitbringen, um die Kraft der Khvarena zu sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570252
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570252,
					"content": "Die Khvarena werden die Riesenbäume erwecken, die die dunkle Mulde unterdrücken und den Schmutz am Boden der Tiefen reinigen. Danach könnt ihr dann das Chinvat-Ritual durchführen und somit den Weg in den Harvisptokhm öffnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570253
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570253,
					"content": "Sobald ihr den Harvisptokhm betretet, wird die Blütenkrone Sorush die großen Taten alter Recken offenbaren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570254
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570254,
					"content": "Da alle Erinnerungen im Zusammenhang mit Khvarena schließlich zum Harvisptokhm zurückkehren werden, werden diese Erinnerungen niemals verblassen, egal wie Legenden nacherzählt und verändert werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570255
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570255,
					"content": "Davon höre ich zum ersten Mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570256
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570256,
					"content": "Hehe, die Blütenkrone ist eigentlich ein Teil des Harvisptokhm. Du wirst es verstehen, wenn du dort ankommst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570257
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570257,
					"content": "Jetzt geht bitte und entfernt das Zeichen von Apaosha. Wir werden uns wiedersehen, wenn das Amrita wieder vom Himmel fällt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570212,
					"content": "Ja ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570213
					]
				},
				{
					"id": 732570213,
					"content": "Dann erzählt mir mal, was passiert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570205,
					"content": "Ich bin völlig erschöpft ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570206
					]
				}
			]
		},
		{
			"id": 7325704,
			"completionStepIds": [
				7325704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325704",
							"2"
						],
						"stepId": 7325704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rashnu",
					"Mihir",
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732570401,
					"content": "So langsam ... Sorush.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570402
					],
					"speakerTitle": "Rashnu"
				},
				{
					"id": 732570402,
					"content": "Wir haben schon eine ganze Weile hier gewartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570403
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570403,
					"content": "So müde ... Ich will ... zurück nach Hause gehen ... schlafen ... *schnarch*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570404
					],
					"speakerTitle": "Rashnu"
				},
				{
					"id": 732570404,
					"content": "Pah! Ich bin doch diejenige, die die ganze Zeit hart gearbeitet hat und ihr habt nichts getan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570405
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570405,
					"content": "Das stimmt nicht. Auch das Warten ist eine wichtige Arbeit. Tatsächlich ist das Handeln nur vorübergehend, während das Warten ewig ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570406
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570406,
					"content": "Was ist das für eine seltsame Logik ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570407,
					"content": "Nun, so ist die Philosophie von uns Pari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570408
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570408,
					"content": "Wie auch immer, jetzt ist nicht die Zeit, über unsere Philosophie zu reden ... Wichtiger sind die Hymnen des Khvarena. Habt ihr schon alle gesammelt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570409
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570409,
					"content": "Natürlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570410,
					"content": "Gut. In diesem Fall werden wir gleich das Siegel entfernen. Dann kann man mit den Hymnen die Kraft von Khvarena sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570411
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570411,
					"content": "Passt auf euch auf. Da sich die Unreinheit über Hunderte von Jahren angesammelt hat, weiß niemand, was beim Entfernen des Siegels entfesselt werden könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mihir"
				}
			]
		},
