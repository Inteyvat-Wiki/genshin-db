					"Zhaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752640401,
					"content": "Escutem, vocês pegaram o cara errado... Viu, o nome do meu mestre é Kanei, e eu sou Zhaka... Você deveria estar indo atrás dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640402
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640402,
					"content": "De jeito nenhum consigo fazer bonecos como meu mestre faz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640403
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640403,
					"content": "Então, você foi sequestrado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752640404
					]
				},
				{
					"id": 752640404,
					"content": "Hã? Espera, então vocês não estão com eles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640405
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640405,
					"content": "Claro que não! Você não viu? Nós derrotamos todos eles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752640406,
					"content": "Sério? Isso é ótimo! Estou finalmente livre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640407
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640407,
					"content": "Claro! Você pode ir para casa agora. Mas... o que foi tudo isso mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752640408,
					"content": "Esses caras apareceram do nada, tentando fazer bonecos falsificados serem vendidos no resort. Mas são péssimos nisso, então tentaram sequestrar meu mestre, Kanei, para fazê-lo ajudá-los...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640409
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640409,
					"content": "Mas algo deu errado e eles acabaram me pegando no lugar... Caramba, só estive aprendendo a pintar com meu mestre há três dias... De jeito nenhum sou qualificado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640410
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640410,
					"content": "Enfim, obrigado por me salvar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640411
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640411,
					"content": "Azhka, vamos para casa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640412
					],
					"speakerTitle": "Zhaka"
				},
				{
