						3790402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790402,
					"content": "Este brilho juvenil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790403
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790403,
					"content": "Você está elogiando a si mesma, Mestre Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790404,
					"content": "...Eu estava falando da Lira Sagrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790405
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790405,
					"content": "#Graças {F#a}{M#ao} {NICKNAME} que purificou o cristal, a Lira Sagrada não perderá mais poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790406
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790406,
					"content": "Mas seu poder está longe de se regenerar completamente. Seria ótimo se conseguíssemos mais Lágrimas de Dvalin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790407,
						3790409,
						3790410
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790407,
					"content": "Nós iremos ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790408
					]
				},
				{
					"id": 3790408,
					"content": "Como que nós podemos conseguir mais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790411,
					"content": "O Dvalin deve estar chorando neste momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790412
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790412,
					"content": "Sofrendo sozinho em um local deserto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790413
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790413,
					"content": "Dvalin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790414
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790414,
					"content": "Pobre neném...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790415,
					"content": "#Isso não é algo que {M#um Cavaleiro}{F#uma Cavaleira} Honorável possa fazer sozinh{F#a}{M#o}. Eu irei chamar pelos outros cavaleiros para ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790416
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790416,
					"content": "#Quando você obtiver o Cristal da Lágrima, deixe o processo de purificação com {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790417
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790417,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790418
					]
				},
				{
					"id": 3790418,
					"content": "Heróis ajudando uns aos outros e seguindo a jornada juntos... Incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790419
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790419,
					"content": "Deixe-me tocar uma música para você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790420,
					"content": "Ei, isso é tudo o que você vai fazer? Apenas cantar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790421,
					"content": "Eu não seria um bardo se não soubesse, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790422
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790422,
					"content": "Hunf! Você é tão descarado... Você merece um apelido ruim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790423,
					"content": "Ah, Paimon já sabe! Vou chamar você de <color=#00E1FFFF>O Bardo surdo</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790409,
					"content": "Certo, como que nós fazemos isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790411
					]
				},
				{
					"id": 3790410,
					"content": "Como podemos fazer Dvalin chorar? Batendo nele?",
