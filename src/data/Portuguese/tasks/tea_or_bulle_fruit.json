			"dialogs": [
				{
					"id": 761870301,
					"content": "Por favor, aceite minha gratidão, Srta. Sandrone, em nome da Srta. Maime, pelo seu convite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870302
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870302,
					"content": "Mmhmm, esta comida está deliciosa. Obrigada, Sandrone. Suas habilidades culinárias são incríveis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870303
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 761870303,
					"content": "Estou feliz por você ter gostado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870304
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761870304,
					"content": "Mas Protótipo 4ACV07, acredito que esta é a primeira vez que nos encontramos? Como você me reconheceu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870305
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761870305,
					"content": "Uau, essa é a primeira vez que ouço alguém chamá-lo assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870306
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 761870306,
					"content": "Afirmativo. Embora eu esteja familiarizado com sua gentileza e resplendor, nunca a vi pessoalmente antes, Srta. Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870307
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870307,
					"content": "Consigo reconhecê-la porque sua aparência é semelhante à da minha mestra, a Srta. Mary-Ann Guillotin. Ela está permanentemente registrada na minha unidade de memória.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870308
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870308,
					"content": "A senhorita Mary-Ann me falou sobre você. Como sua aparência corresponde à da minha mestra, o raciocínio lógico necessário para reconhecê-la é bastante simples, Srta. Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870309
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870309,
					"content": "Hah, até o trabalho mais antigo de Alain é tão impressionante. Embora pareça que você tenha recebido algumas melhorias... Suponho que deva tratá-lo como Seymour agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870310
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761870310,
					"content": "Você ficou confuso quando me viu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870311
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761870311,
					"content": "Negativo. Minha diretriz primária é acompanhar e proteger a Srta. Mary-Ann em nome de Alain Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870312
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870312,
					"content": "Sendo assim, meu conhecimento sobre a Srta. Mary-Ann é completo. Com base em uma análise lógica de espaços vetoriais de dimensão finita, você e a Srta. Mary-Ann são totalmente diferentes, Srta. Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870313
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870313,
					"content": "Como a diferença entre as folhas de chá do Vale Chenyu e a Fruta Bulle do Distrito Beryl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870314
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870314,
					"content": "Sandrone é o chá ou a Fruta Bulle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870315
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 761870315,
					"content": "Procurando... Dados insuficientes. Impossível responder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870316
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870316,
					"content": "(*Suspiro*... Ainda bem que o Alain melhorou o design do módulo de linguagem quando me criou.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
