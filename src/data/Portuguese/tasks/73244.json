					"id": 732441901,
					"content": "Espero poder recuperar Benben depois que pegar os Capacitores de Conversão Energia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441902
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441902,
					"content": "#Se vocês não estiverem se sentindo segur{F#as}{M#os}, eu também irei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441903,
						732441904
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441903,
					"content": "Fique aqui cuidado de Benben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				},
				{
					"id": 732441905,
					"content": "Certo. Ficarei por aqui esperando vocês, vão e voltem com segurança!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441904,
					"content": "Vamos voltar logo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				}
			]
		},
