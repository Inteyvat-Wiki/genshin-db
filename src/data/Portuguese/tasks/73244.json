			},
			"dialogs": [
				{
					"id": 732441001,
					"content": "Ah, é Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441002,
					"content": "Ainda bem que Aderfi não chegou a tempo de levar ele embora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441003
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441003,
					"content": "Mas as coisas daqui estão totalmente iguais as de antes, nada mudou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441004
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441004,
					"content": "É sério que esse cara achou que conseguiria derrubar a Matriarca e depois voltar para a sua tenda sem problema nenhum? Que imbecil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441005
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441005,
					"content": "Mas é graças a esse imbecil que Benben está bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441006
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441006,
					"content": "Você chama isso de bem? Pobre Benben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441007,
						732441008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441007,
					"content": "Por que ele está assim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441009
					]
				},
				{
					"id": 732441009,
					"content": "Sim, por que ele está deitado no chão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441010,
					"content": "O que aconteceu com ele? Ele estava bem na última vez que o vimos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441011,
					"content": "... Depois que Benben saiu do Salão da Hierofania, ele ficou cada vez mais fraco... Era como se algo tivesse quebrado, e o som que ele emitia estava cada vez mais baixo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441012
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441012,
					"content": "Até que um dia ele não emitiu mais som nenhum, nem se moveu mais, era como se a vida que tivesse fosse pouco a pouco desaparecendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441013
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441013,
					"content": "Ninguém na tribo tinha ideia do que estava acontecendo com Benben, menos Aderfi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441014
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441014,
					"content": "Foi por isso que eu entreguei Benben para ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441015
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441015,
					"content": "Como isso é possível? Benben não vai ficar assim, sem despertar mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441016,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441017
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441017,
					"content": "Enfim, Benben ainda está comigo. Eu um dia encontrarei uma maneira de fazer ele se recuperar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441018
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441018,
					"content": "Mas assim nós não temos nenhuma pista sobre o que fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441019,
					"content": "Deixem eu pensar... Eu me lembro que na última vez que falei com Aderfi, ele disse que não era nada grave e que em dois dias já teria algum resultado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441020
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441020,
					"content": "Conhecendo ele, se ele fez algum tipo de investigação, com certeza deixou alguns registros para trás. Vamos procurar por aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441021
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441021,
					"content": "Se não for nenhum problema grave, talvez possamos resolver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441008,
					"content": "Benben... O que tem de errado com ele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441009
					]
				}
			]
		},
