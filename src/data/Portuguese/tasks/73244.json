						732441509
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441509,
					"content": "Uau! Benben está vivo de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441510,
					"content": "Que idiotice é essa que você está falando? Benben só estava dormindo, ele agora apenas despertou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441511
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441511,
					"content": "Bip bip... Bip bip...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441512
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441512,
					"content": "Não, eu não estava preocupada. Eu sabia que um dia você iria se recuperar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441513
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441513,
					"content": "Hmph! \"Eu não quero deixar ele em risco nunca mais...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441514,
					"content": "Paimon, não me imite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441515
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441515,
					"content": "Bip bip...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441516
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441516,
					"content": "#Ah, sim. {NICKNAME}, Benben quer te agradecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441517
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441517,
					"content": "Parece que mesmo tendo ficado sem se mover, Benben sabe o que vocês fizeram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441518
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441518,
					"content": "Não foi nada, Benben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441519
					]
				},
				{
					"id": 732441519,
					"content": "Bip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441520
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441520,
					"content": "Hã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441521
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441521,
					"content": "O que foi, Jeht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441522,
					"content": "Apesar de já ter acordado, Benben ainda precisa se recuperar um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441523
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441523,
					"content": "Sim, descanse bastante, Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441524,
					"content": "Bip bip...",
					"roleType": "TALK_ROLE_NPC",
