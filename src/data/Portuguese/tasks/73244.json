			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Jeht"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440101,
					"content": "Como... Como posso ter esquecido disso...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440102
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440102,
					"content": "Espero que consigamos chegar a tempo... Vamos pelo menos procurar na tenda dele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440103
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440103,
					"content": "Jeht! Hã? O que foi? Para onde você está indo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440104,
					"content": "#Paimon, {NICKNAME}! Vocês chegaram na hora certa, tem algo que preciso resolver... Estou indo aonde Aderfi costuma ficar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440105
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440105,
					"content": "Aderfi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440106,
					"content": "Aquele vira-casaca que estava andando junto com os Fatui?! Ah, Paimon já sabe! Você quer ir na tenda dele pegar tudo que puder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440107,
					"content": "Não, eu não tenho interesse no que aquele cara deixou para trás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440108
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440108,
					"content": "Nós das tribos temos regras sobre como devemos lidar com as coisas deixadas por esses traidores... Urgh, se não fosse por isso, eu não me conteria em tocar fogo em todas as coisas daquele cara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440109
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440109,
					"content": "Eu quero ir na tenda dele porque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440110
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440110,
					"content": "Por causa de Benben...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440111
					]
				},
				{
					"id": 732440111,
					"content": "Ah, verdade! Poxa, Benben ainda está lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440112,
					"content": "Jeht, por que você deixou Benben com um cara como aquele?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440113,
					"content": "*Suspiro* Porque eu não sabia que ele era um traidor antes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440114
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440114,
					"content": "Enfim, eu tenho que ir logo para dar uma olhada nas coisas de Aderfi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440115
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440115,
					"content": "#{NICKNAME}, também temos que ir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440116,
						732440117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440116,
					"content": "Não há tempo a perder.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440118
					]
				},
				{
					"id": 732440118,
					"content": "É... Paimon espera que Benben esteja bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440117,
					"content": "Vamos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440118
					]
				}
			]
		},
		{
			"id": 7324403,
			"completionStepIds": [
				7324403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324403",
							"2"
						],
						"stepId": 7324403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jeht"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440301,
					"content": "Veja, tem algo aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440302,
					"content": "Paimon não acha que é um diário de investigação. Parece ser... uma carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440303,
					"content": "Uma carta? Rápido, abra ela logo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440304
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440304,
					"content": "Pelo que está escrito nela, parece que Benben ficou sem energia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440305,
					"content": "Pensando bem, Benben nos ajudou muito em nossa jornada, desde abrir o portão do Mausoléu do Rei Deshret até ativar nossa permissão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440306,
					"content": "Mesmo se tratando de Benben, ele deve se sentir cansado... ele fez muito por nós, por isso perdeu sua energia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440307
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440307,
					"content": "Mas não tem nada na tenda que se pareça com os Capacitores de Conversão Energética especial que ele mencionou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440308
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440308,
					"content": "Será que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440309,
						732440312
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440309,
					"content": "Estão escondidos em algum lugar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440310
					]
				},
				{
					"id": 732440310,
					"content": "Acho isso improvável. Se eles só podem ser usados para reparar Benben, não há razão para escondê-los, seria melhor usar logo sempre que possível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440311
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440311,
					"content": "Ah, já sei! Deve ser porque essa transação ainda não aconteceu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440314
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440314,
					"content": "Aderfi não levou Benben para o local dela, então é claro que não há nenhum Capacitor de Conversão Energética aqui... Mas ainda fica a pergunta: com quem Aderfi ia fazer essa transação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440315
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440315,
					"content": "Haha, que pergunta idiota... Só existe um tipo de pessoa de fora da tribo que faria esse tipo de negociação com ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440316,
						732440318
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440316,
					"content": "Um acadêmico de Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440317
					]
				},
				{
					"id": 732440317,
					"content": "Os Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440320
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440320,
					"content": "O que a gente faz agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440321,
					"content": "O que mais poderíamos fazer? Não há nada para se discutir com os Fatui. Deveríamos ir para o local onde a negociação vai ocorrer e roubarmos os Capacitores de Conversão Energética!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440322
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440322,
					"content": "Uau! Você quer roubar eles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440323,
					"content": "Mas Benben... não temos como carregá-lo no seu estado atual, então é óbvio que não temos como levá-lo para o local da transação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440324
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440324,
					"content": "Também não é seguro deixar ele sozinho. Eu não quero deixar ele em risco nunca mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440325
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440325,
					"content": "#Então vamos fazer assim. Paimon e {NICKNAME} vão roubar os Fatui, você e Benben ficam esperando aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440326,
						732440328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440326,
					"content": "Isso mesmo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440327
					]
				},
				{
					"id": 732440327,
					"content": "Uhul! Vamos lá roubar os Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440330,
					"content": "#Eu queria muito ir, mas... {NICKNAME}, Paimon, estou contando com vocês para ajudarem Benben a se recuperar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440331
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440331,
					"content": "Eu sei que os seus oponentes vão ser só alguns Fatui, mas tenham muito cuidado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440332
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440332,
					"content": "Não se preocupe! Pode deixar com a gente! Mamão com açúcar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440333,
					"content": "Sim... E eu não quero ficar na tenda daquele traidor com Benben. Eu vou levar ele para minha tenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440334
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440334,
					"content": "Peguem os Capacitores de Conversão Energética, esperarei por vocês na minha tenda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440328,
					"content": "Roubar os Fatui!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440329
					]
				},
				{
					"id": 732440329,
					"content": "Hehe, não vai ser a primeira vez que fazemos isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440318,
					"content": "Os Fatui!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440319
					]
				},
				{
					"id": 732440319,
					"content": "Exatamente. Quem mais faria isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440320
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440312,
					"content": "Então ele nunca recebeu os Capacitores?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440313
					]
				},
				{
					"id": 732440313,
					"content": "Sim, entendi o que você quis dizer! Essa transação ainda nem aconteceu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440314
					],
					"speakerTitle": "Jeht"
				}
			]
		},
