			},
			"dialogs": [
				{
					"id": 732441701,
					"content": "Por favor, pare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441702
					],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441702,
					"content": "Por favor, pare! Se você continuar, alguém vai acabar morrendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441703
					],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441703,
					"content": "Parece que fomos bem convincentes para ele estar falando isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441704,
					"content": "Abra o bico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441705,
					"content": "Vamos, fale!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441706
					]
				},
				{
					"id": 732441706,
					"content": "Está bem, eu falo, eu falo! Eu digo tudo que vocês quiserem saber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441707
					],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441707,
					"content": "Diga o que você sabe primeiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441708,
					"content": "Nós só fazíamos alguns negócios com Aderfi, nada de mais... Ouvi dizer que a Matriarca dos Tanit tinha uma preferência por um tal de Azariq, e também tem uma mulher recém-chegada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441709
					],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441709,
					"content": "Apesar de eu não saber como, Azariq também desapareceu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441710
					],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441710,
					"content": "Essa mulher é cruel. Ela não tolerava pessoas que perderam o valor para a tribo... Foi por isso que Aderfi, para garantir sua posição, entrou em contato conosco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441711
					],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441711,
					"content": "Nossos negócios no deserto nunca saíram como planejado, até que fizemos aquele acordo com Aderfi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441712,
						732441716
					],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441712,
					"content": "Perder o valor? O que você quer dizer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441713
					]
				},
				{
					"id": 732441713,
					"content": "Eu não sei, realmente não sei! Essas pessoas do deserto têm uma lógica própria... mas se eu tivesse que adivinhar, deve ser porque aquela garota acreditava que nós não eramos confiáveis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441714
					],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441714,
					"content": "... Foi por isso que ela se distanciou de nós, e também era a razão para Aderfi ficar preocupado em se encontrar conosco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441715
					],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441715,
					"content": "Afinal, nós tínhamos como sair desse lugar amaldiçoado, enquanto ele só podia ser extorquido e no final ainda teria que lidar com a tribo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441724
					],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441724,
					"content": "Mas, Aderfi é um cara muito astuto. Nós demos muito das coisas que ele queria, mas ficamos de mãos vazias para o que queríamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441725
					],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441725,
					"content": "Mas depois que ouvimos que ele sofreu um acidente... Apesar de não sabermos o que aconteceu, pensamos que essa era uma boa chance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441726
					],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441726,
					"content": "Boa chance? Para o quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441727,
					"content": "Nós supomos que não teríamos como fazer nenhuma negociação com Aderfi no futuro, por isso pedimos que ele trouxesse a Estrutura Primordial especial que ele havia mencionado nas suas cartas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441728
					],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441728,
					"content": "Se pudéssemos roubar ela e esperar alguns dias depois de termos partido, não seria como se estivéssemos saindo de mãos vazias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441729
					],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441729,
					"content": "O quê?! Então vocês também pensaram em roubar essa transação?! Não é à toa que não conseguimos encontrar nenhum produto OU os Capacitores de Conversão Energética!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441730,
					"content": "Hã? \"Também pensaram em roubar?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441731,
						732441732
					],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441731,
					"content": "Sim, pode ir passando os Capacitores de Conversão Energética.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441733,
					"content": "Ei, não me digam que vocês também estão nos enrolando com esses Capacitores de Conversão Energética!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441734,
					"content": "Não. Os Capacitores de Conversão Energética são reais. Há muitos deles, mas como são artefatos antigos, não sei se ainda funcionam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441735
					],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441735,
					"content": "Então onde esses Capacitores de Conversão Energética estão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441736,
					"content": "Paimon, você está falando num tom imponente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441737
					]
				},
				{
					"id": 732441737,
					"content": "#Hehe, você acha? Ei, {NICKNAME}, não mude de assunto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441738
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441738,
					"content": "Vamos, desembuchem onde vocês colocaram os Capacitores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441739,
					"content": "... Está perto de uma de nossas bases. Aqui está a chave dela. Eu contei tudo que sabia para vocês...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441740,
						732441741
					],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441740,
					"content": "Vamos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441742,
					"content": "Certo, certo. Eu vou dar o fora daqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441741,
					"content": "Nós não queremos ver você de novo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441732,
					"content": "Parece que estamos com sorte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441716,
					"content": "Qual o trabalho que vocês estavam fazendo no deserto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441717
					]
				},
				{
					"id": 732441717,
					"content": "... É secreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441718
					],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441718,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441719
					]
				},
				{
					"id": 732441719,
					"content": "#Veja bem, se você deixar {NICKNAME} irritad{F#a}{M#o}, será pior para você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441720,
					"content": "#Aah! Está bem, está bem! Por favor, não fique irritad{F#a}{M#o}, eu falo! Mas... Eu não sei muita coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441721
					],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441721,
					"content": "Nossa missão era investigar o povo das tribos do deserto. Deveríamos usar a transação para atraí-los e conseguirmos nos infiltrar, atraindo a atenção dos sábios... Assim poderíamos ajudar nosso Mensageiro na Cidade de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441722
					],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441722,
					"content": "Além disso... o Professor Froderock também estava procurando por espécimes vivos no deserto. Ele nunca obedeceu as ordens do Mestre Dottore... Na minha opinião, ele só estava com inveja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441723
					],
					"speakerTitle": "Fatui Negociante"
				},
				{
					"id": 732441723,
					"content": "Ahem! Eu já falei demais, já falei demais... Enfim, Aderfi é o nosso contato. Ele sempre foi o responsável pela transação de suprimentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441724
					],
					"speakerTitle": "Fatui Negociante"
				}
			]
		},
