			"dialogs": [
				{
					"id": 230360101,
					"content": "Sr. Kayvan, tente com o novo modelo de isca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360102
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360102,
					"content": "Já tentei várias vezes, o resultado é sempre o mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360103,
					"content": "Oh, por que vocês dois estão pescando juntos novamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230360104,
					"content": "Viajante, nos encontramos de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360105
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360105,
					"content": "Olá, pessoal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360106,
						230360107
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360106,
					"content": "Você já descobriu o motivo de não fisgar nenhum peixe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				},
				{
					"id": 230360108,
					"content": "Haha! Nada. Eu e aquele pesquisador tentamos melhorar a vara de pesca, a isca e a técnica de diversas maneiras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360109
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360109,
					"content": "Tentamos em várias águas, diferentes ângulos... Até me deixaram tentar em um viveiro cheio de peixes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360110
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360110,
					"content": "Mesmo assim, eu só conseguia pescar coisas que não eram peixes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360111
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360111,
					"content": "Não se preocupe, Sr. Kayvan! Aquele pesquisador não lhe prometeu continuar pesquisando? Ele com certeza determinará a razão por trás disso tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360112
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360112,
					"content": "Veja bem, ele projetou novos tipos de iscas para você, e também me pediu para o acompanhar, irei registrar todos os detalhes enquanto você pesca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360113
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360113,
					"content": "Espero que ele tenha sucesso... Mas antes disso, eu continuarei pescando como sempre fiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360114
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360114,
					"content": "Viajante, se você estiver livre, me ajude a encontrar mais alguns materiais para iscas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360107,
					"content": "Aprendeu algo com os pesquisadores?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				}
			]
		},
