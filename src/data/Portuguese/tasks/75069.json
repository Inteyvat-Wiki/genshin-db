			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quenin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690201,
					"content": "Ah, esse lugar... Poucos o visitam... Afinal de contas, aqui é perigoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690202
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690202,
					"content": "Você também está com a equipe de aventura...? Hnf, eles dizem que a sombra de uma serpente negra desceu do Tonatiuh... Você deveria ter cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690203
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690203,
					"content": "Ou melhor, saia enquanto pode. Existem coisas não humanas, ha, escondidas dentro da equipe... Aquelas vozes, os xingamentos... tão barulhento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690204
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690204,
					"content": "É bem silencioso por aqui, graças a cachoeira. Haha... O rugido da cachoeira abafa todo o resto, então você não consegue ouvir nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
		{
			"id": 7506905,
			"completionStepIds": [
				7506903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7506903",
