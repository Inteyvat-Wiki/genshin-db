				},
				{
					"id": 750691203,
					"content": "O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691204
					]
				},
				{
					"id": 750691204,
					"content": "Eu sou... um guerreiro da equipe de aventura. Não tão poderoso quanto o nosso líder, Lorde Taika, mas eu tenho meus pontos fortes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691205
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691205,
					"content": "Eu guardo nosso acampamento... Às vezes, quando não consigo dormir à noite, patrulho para manter o acampamento seguro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691206
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691206,
					"content": "Agora, não sei quando começou, mas tem havido cada vez menos pessoas no acampamento a cada dia... Hã, espera. Estranho... Por que estou aqui agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691207,
					"content": "Não, não preciso de nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691208
					]
				},
				{
					"id": 750691208,
					"content": "#É mesmo... Ah, então siga meu conselho, {M#bravo guerreiro}{F#brava guerreira}. Saia daqui rapidamente.",
