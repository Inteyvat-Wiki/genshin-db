					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690802
					],
					"speakerTitle": "Corpo Frio"
				},
				{
					"id": 750690802,
					"content": "(E julgando pelos seus arredores, esteve nesse estado por um bom tempo...)",
