				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690501,
					"content": "(Uma página rasgada, com palavras escritas de forma bem organizada logo no início...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690502
					],
					"speakerTitle": "Diário de Quenin"
				},
				{
					"id": 750690502,
					"content": "\"...Os monstros do Abismo estão aumentando em número, como esperado... A equipe de aventura falhou, e uma retirada planejada está em progresso.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690503
					],
					"speakerTitle": "Diário de Quenin"
				},
				{
					"id": 750690503,
					"content": "\"Temos que garantir que os membros restantes evacuem em segurança. Tenha cuidado com aqueles que desaparecem à noite, ou retornam de lugares sem luz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690504
					],
					"speakerTitle": "Diário de Quenin"
				},
				{
					"id": 750690504,
					"content": "\"...Os monstros do Abismo estão aparecendo mais frequentemente. A fortaleza pode acabar sendo descoberta em breve, mas antes disso...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690505
					],
					"speakerTitle": "Diário de Quenin"
				},
				{
					"id": 750690505,
					"content": "(A caligrafia se torna rabiscada e distorcida...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690506
					],
					"speakerTitle": "Diário de Quenin"
				},
				{
					"id": 750690506,
					"content": "\"Ah, está frio... Tão frio... Ali, bem ali, o sangue está vazando...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690507
					],
					"speakerTitle": "Diário de Quenin"
				},
				{
					"id": 750690507,
					"content": "\"O som da cachoeira, tão alto... sim, isso é bom. Desde que... debaixo da cachoeira, ficará silencioso lá... rostos pálidos, bocas abertas, sangue drenado...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690508
					],
					"speakerTitle": "Diário de Quenin"
				},
				{
					"id": 750690508,
					"content": "\"Bem ali... bem... ali... algo... está ali...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690509
					],
					"speakerTitle": "Diário de Quenin"
				},
				{
					"id": 750690509,
					"content": "\"Debaixo da cachoeira debaixo da cachoeira debaixo da cachoeira debaixo da cachoeira debaixo da cachoeira debaixo da cachoeira...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diário de Quenin"
				}
			]
		},
