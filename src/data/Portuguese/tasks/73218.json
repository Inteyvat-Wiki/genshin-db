			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181101,
					"content": "\"Ouvi dizer que tem um hospital que trata Eleazar lá no deserto. Foi especialmente estabelecido pela Academia, mas foi abandonado por razões desconhecidas...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181102
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732181102,
					"content": "\"De acordo com o que o pessoal da Vila Aaru diz, houve pacientes diagnosticados com Eleazar que foram curados e escaparam de lá.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181103
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732181103,
					"content": "\"Se sobrou algum material, talvez possamos encontrar uma cura para esta doença...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321812,
			"completionStepIds": [
				7321812
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321812",
							"2"
						],
						"stepId": 7321812,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181201,
					"content": "\"Ouvi dizer que algumas pessoas de nossa Vila Aaru se tornaram oficiais de alto escalão na Academia, isso pode ser uma virada de página para o nosso povo do deserto.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181202
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732181202,
					"content": "\"Só ficar empurrando essas pedras não irá me gerar nenhum dinheiro. Mas com um único pedido para transporte de conhecimento enlatado, poderia voltar para casa para me casar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181203
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732181203,
					"content": "\"Contudo, ouvi que o oficial é quem está à frente do combate ao contrabando. Eu não acho que essa pessoa se aliará a nós.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181204
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732181204,
					"content": "\"Pss! Nós do deserto não somos unidos o suficiente, por isso a situação chegou a esse ponto.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321813,
			"completionStepIds": [
				7321813
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321813",
							"2"
						],
						"stepId": 7321813,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181301,
					"content": "Aos aventureiros que estão indo para o deserto, por favor percebam que de acordo com determinações da Academia, todas as aventuras no Grande Mar de Areias Vermelhas devem ser registradas junto a Academia antes de serem realizadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181302
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732181302,
					"content": "Todos os artefatos encontrados nas ruínas do deserto pertencem, em princípio, a Academia e não podem ser apropriados por ninguém.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181303
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732181303,
					"content": "Por razões de segurança, a Academia decretou a proibição de acesso para outras áreas desérticas além do Grande Mar de Areias Vermelhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181304
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732181304,
					"content": "A Academia não será responsabilizada por quaisquer acidentes que ocorram nestas áreas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321814,
			"completionStepIds": [
				7321814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
