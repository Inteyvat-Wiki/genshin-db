			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180901,
					"content": "Os viajantes devem ser registrados no escritório Mahamata e somente após a aprovação, podem atravessar a fronteira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180902
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732180902,
					"content": "É proibido o transporte de mercadorias não registradas e itens proibidos de importação ou exportação. Uma vez descobertos, todos serão confiscados e os acompanhantes também serão conduzidos ao deserto de acordo com os regulamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180903
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732180903,
					"content": "Além disso, os residentes da Vila Aaru podem passar diretamente pela fronteira com o documento de liberação emitido pela Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
