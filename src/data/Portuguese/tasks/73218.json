			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180101,
					"content": "Este quadro de avisos é dedicado ao Ribat de Caravanas, que é uma importante porta de entrada e saída de Sumeru. Este quadro de avisos é usado para informar comerciantes e turistas sobre assuntos importantes. Por favor mantenha-se informado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321802,
			"completionStepIds": [
				7321802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321802",
							"2"
						],
						"stepId": 7321802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180201,
					"content": "\"Meu amor, embora você esteja tão longe de mim, meu coração sempre foi seu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180202
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732180202,
					"content": "\"Sei que você tem coisas mais importantes a fazer, e quanto maior sua autoridade, maiores suas obrigações.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180203
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732180203,
					"content": "\"No entanto, não posso falar dos meus problemas aos outros. Também não posso divulgar seu nome para ninguém.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180204
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732180204,
					"content": "\"Espero que algum dia eu possa contar a todos sem hesitar, o quão inteligente que você é.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321803,
			"completionStepIds": [
				7321803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
