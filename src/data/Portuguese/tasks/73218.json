			"dialogs": [
				{
					"id": 732181601,
					"content": "Recrutamento permanente de trabalhadores para a manutenção da Muralha de Samiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181602
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732181602,
					"content": "A acomodação e a alimentação são gratuitas e o salário é justo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181603
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732181603,
					"content": "Aqueles que fizeram um trabalho excelente também serão recomendados pelo oficial para admissão na Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
