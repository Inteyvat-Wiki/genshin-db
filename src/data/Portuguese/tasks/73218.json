			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181001,
					"content": "\"Venda de pacote de produtos de aventura no deserto, fornecendo as melhores soluções em aventuras para os comerciantes e viajantes.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181002
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732181002,
					"content": "\"Se você comprar um pacote de produtos, garantimos o sucesso de sua aventura. Nós somos passíveis a uma multa de dez vezes o valor por qualquer imitação vendida. Reserve já e ganhe um bom desconto!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321811,
			"completionStepIds": [
				7321811
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
