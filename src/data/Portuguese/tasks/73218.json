			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180801,
					"content": "Para evitar acidentes, como vazamento de conhecimento, os pesquisadores que ficarem por muito tempo no Ribat de Caravanas precisam se registrar com o Mahamata antes de poderem se hospedar no hotel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321809,
			"completionStepIds": [
				7321809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321809",
