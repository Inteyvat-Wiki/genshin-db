			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180301,
					"content": "Siga para o Grande Mar de Areias Vermelhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180302
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732180302,
					"content": "Aqueles que não respeitam a morte, fiquem aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321804,
			"completionStepIds": [
				7321804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321804",
							"2"
						],
						"stepId": 7321804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180401,
					"content": "É estritamente proibido destruir a Muralha de Samiel de qualquer forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180402
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732180402,
					"content": "Qualquer violação será severamente punida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321805,
			"completionStepIds": [
				7321805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321805",
							"2"
						],
						"stepId": 7321805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180501,
					"content": "\"Trabalhamos com especialidades do deserto, frutas secas de todos os tipos e ingredientes para sobremesa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180502
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732180502,
					"content": "\"O serviço de entrega está disponível para pedidos em grandes volumes.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180503
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732180503,
					"content": "\"Isto parece muito bom, eu posso fazer Dango com isso. Você poderia entregar até Inazuma para mim?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180504
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732180504,
					"content": "\"Desculpe. Entregas para o estrangeiro somente para Liyue no momento.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321806,
			"completionStepIds": [
				7321806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321806",
							"2"
						],
						"stepId": 7321806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180601,
					"content": "Parece não haver necessidade de fazer publicidade para o Jornada Dourada, já que é o único hotel do Ribat de Caravanas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180602
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732180602,
					"content": "Contudo, o nosso churrasco é muito gostoso e genuíno, pois, é feito por hábeis mãos do deserto. Bem mais autêntico do que o que você come lá na cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180603
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732180603,
					"content": "Mesmo que esteja cansado da viagem, venha experimentar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321807,
			"completionStepIds": [
				7321807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321807",
							"2"
						],
						"stepId": 7321807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180701,
					"content": "\"Espero que os Mahamata considerem apertar as restrições de alfândega no Ribat de Caravanas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180702
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732180702,
					"content": "\"Agora, desde que você seja um cidadão do deserto, você pode passar pela alfândega à vontade, o que não apenas fez com que muitos bandidos aproveitassem a oportunidade para fugir para a selva, onde se esconderam, mas também aproveitaram as oportunidades de trabalho do povo de Sumeru.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180703
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732180703,
					"content": "\"As pessoas do deserto ainda não tiveram livre acesso ao Akasha, mas as comissões dadas pela Cidadela de Regzar, não estão mais limitadas ao trabalho mercenário. Neste ritmo, mesmo que todos eles entrem para a Academia, alguém terá que se tornar um sem-teto.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180704
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732180704,
					"content": "\"O que você está falando? As pessoas do deserto também pertencem a Lorde Maior Rukkhadevata e são cidadãos de Sumeru também. Deixá-las entrar na cidade é algo natural.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180705
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732180705,
					"content": "\"Cuidado para não apanhar ao falar estas coisas por aqui.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321808,
			"completionStepIds": [
				7321808
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
