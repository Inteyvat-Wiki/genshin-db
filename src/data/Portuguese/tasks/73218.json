			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181501,
					"content": "\"Os jovens de hoje gostam de pensar demais. Se não fosse pela proteção da Lorde Maior Rukkhadevata, as pessoas da Vila Aaru teriam se tornado esqueleto sob as ruínas daqueles templos.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181502
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732181502,
					"content": "\"Ouvi dizer que ainda há rumores de que o Rei Deshret está voltando à vida. Procuro pensar que se nem mesmo a Lorde Maior Rukkhadevata deu sinais de voltar a vida, o que dizer daquele tal Rei Deshret?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181503
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732181503,
					"content": "\"Penso que é mais importante trabalhar honestamente. Apenas confiar nos suprimentos enviados para a Vila Aaru todos os meses, não é suficiente para vivermos.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
