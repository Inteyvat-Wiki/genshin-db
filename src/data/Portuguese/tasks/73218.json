			},
			"dialogs": [
				{
					"id": 732181701,
					"content": "\"Em nome do Rei da Garrafa Mágica, perdoei seus pecados, mas quem assim o fara com os nossos?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
