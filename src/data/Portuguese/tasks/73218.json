			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181401,
					"content": "\"Ouvi dizer que teve gente que enriqueceu depois de contrabandear gordura de crisálida do deserto para a cidade. Eles não só compraram mansões na cidade, como também se autoproclamaram ser de um certo clã, e próximos do pessoal da Academia.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181402
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732181402,
					"content": "\"Como que passei metade da vida movendo pedras por aqui e ainda sou um indigente?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181403
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732181403,
					"content": "\"Você não sabe de nada. Esse negócio de gordura de crisálida do deserto é um negócio licenciado pela Academia. Nem tente se meter com isso.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181404
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732181404,
					"content": "\"Se você quiser enriquecer, venha contrabandear alguns livros comigo. Se der certo, pelo menos não teremos mais que carregar pedras por aqui.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321815,
			"completionStepIds": [
				7321815
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
