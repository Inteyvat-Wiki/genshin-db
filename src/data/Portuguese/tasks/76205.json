					}
				]
			},
			"dialogs": [
				{
					"id": 762050101,
					"content": "#O que fazer... O que fazer agora... Pelas minhas contas, {M#eles}{F#elas} estão quase chegando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050102,
					"content": "Oi, Nicole, estamos aqui! Ei, por que você tá empurrando a gente pra fora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050103,
					"content": "Ó, céus, céus... Sinto muito por isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050104,
					"content": "Você já tá pronta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050105
					]
				},
				{
					"id": 762050105,
					"content": "Como devo dizer... Ah, droga, acho que não consigo explicar com clareza. Vou ter que contar a história toda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050106,
					"content": "Tudo começou na primeira vez que as bruxas desafiaram o Arconte Anemo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050107
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050107,
					"content": "Nicole, isso já faz... tempo demais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050108,
					"content": "Ugh, isso não é justo! Que vergonha vocês terem que ouvir isso da minha boca... Não! Não há o que fazer, os fatos são fatos... Contanto que Alice não saiba disso, não tem motivo para darem risada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050109
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050109,
					"content": "Eita, o monólogo interno dela tá vazando de novo... Além disso, não tá saindo da boca dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050110,
					"content": "Shh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050111
					]
				},
				{
					"id": 762050111,
					"content": "Decidi esconder as penas no topo do escritório. Achei que, se eu dificultasse as coisas, haveria um senso maior de conquista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050112
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050112,
					"content": "Mas não sou muito boa em controlar esses ventos despreocupados. Só consigo voar tão alto antes de ser atingida por um teto invisível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050113
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050113,
					"content": "Você não consegue usar magia pra trazer as penas de volta para baixo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050114,
					"content": "Mas e cadê a diversão nisso?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050115
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050115,
					"content": "Ah, Paimon entende... Hmm, essa é difícil mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050116,
					"content": "Nicole, pode tentar dizer alguma coisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050117
					]
				},
				{
					"id": 762050117,
					"content": "O que você quer que eu diga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050118,
						762050119
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050118,
					"content": "Em Simulanka, palavras são mágicas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				},
				{
					"id": 762050120,
					"content": "Ah! Entendi o que você tá falando! Tudo bem, vou tentar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050121
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050121,
					"content": "Ugh, isso não é justo! Que vergonha vocês terem que ouvir isso da minha boca...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050122
					]
				},
				{
					"id": 762050122,
					"content": "Não! Não há o que fazer, os fatos são fatos...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050123
					]
				},
				{
					"id": 762050123,
					"content": "Contanto que Alice não saiba disso, não tem motivo para darem risada...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				},
				{
					"id": 762050119,
					"content": "Talvez você pudesse tentar dizer que alguma coisa vai virar uma escada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				}
			]
		},
