			"dialogs": [
				{
					"id": 762050201,
					"content": "Opa, esse espaço é grandão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050202,
					"content": "Todas as coisas podem servir como guia... As escrituras preenchidas... com palavras divinas! As frases e capítulos... se envolvem... e anjos agem em similar ordem! Neste local sagrado, que palavras forjem o caminho destinado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050203,
					"content": "*Ding*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050204
					],
					"speakerTitle": "Examinar a porta"
				},
				{
					"id": 762050204,
					"content": "Viu? Tudo resolvido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050205
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050205,
					"content": "Todas as coisas servem de guia, e o santo nome é inscrito nas escrituras.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050206
					]
				},
				{
					"id": 762050206,
					"content": "As palavras se entrelaçam, e todos os emissários avançam juntos.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050207
					]
				},
				{
					"id": 762050207,
					"content": "Neste templo sagrado, que as palavras forjem os degraus do caminho à tua frente",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
