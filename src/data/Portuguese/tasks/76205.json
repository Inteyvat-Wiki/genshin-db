			},
			"dialogs": [
				{
					"id": 762050301,
					"content": "Tesouro! Uhuul, isso é tão divertido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050302,
					"content": "Mas... A cabeça de Paimon tá latejando. Sério, Nicole precisava mesmo gritar alto assim só pra aquelas escadas aparecerem...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050303,
					"content": "O que é isso? Reclamando, não é? Você não se preocupa que uma poderosa maga como eu pode estalar os dedos e transformar todo esse tesouro em rabanetes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050304,
						762050305
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050304,
					"content": "P-Paimon não quis dizer nada com aquilo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050306
					]
				},
				{
					"id": 762050306,
					"content": "Hehe, tô brincando com vocês. Saibam que eu não sou do tipo de anjo silencioso que lembra de cada deslize.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050307,
					"content": "#— E assim, naquele dia, {NICKNAME} e Paimon subiram as sete escadarias, mas o que {M#os}{F#as} esperava diante {M#deles}{F#delas} era uma silhueta familiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050308,
					"content": "Chamas radiantes convergem para formar asas nas costas dela. A silhueta dela permanecia nobre e bela como no dia em que se conheceram, mas os olhos dela agora brilhavam com uma luz cruel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050309,
					"content": "#\"Por quê?\" {NICKNAME} e Paimon perguntam ao mesmo tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050310,
					"content": "\"Tudo começou no dia em que Paimon reclamou que eu gritei alto demais!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050311,
					"content": "Ei! As palavras aqui são mágicas, não sabe? Não diga essas coisas assustadoras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050305,
					"content": "Qual é, não leve tão a sério...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050306
					]
				}
			]
		},
		{
			"id": 7620505,
