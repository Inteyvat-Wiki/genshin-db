			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102010401,
					"content": "Hmph. Você me seguiu. Devo dizer que estou impressionado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010402
					],
					"speakerTitle": "Feiticeiro do Abismo"
				},
				{
					"id": 102010402,
					"content": "Mas aqui é o mais longe que você chegará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010403
					],
					"speakerTitle": "Feiticeiro do Abismo"
				},
				{
					"id": 102010403,
					"content": "Ah é? E o que você vai fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010404,
					"content": "Mwuhahaha! Ahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010405
					],
					"speakerTitle": "Feiticeiro do Abismo"
				},
				{
					"id": 102010405,
					"content": "Oh, a propensão humana de fofocar nos proporcionou tudo o que precisamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010406
					],
					"speakerTitle": "Feiticeiro do Abismo"
				},
				{
					"id": 102010406,
					"content": "Soubemos que sua amiguinha vermelha possuía o tesouro mais poderoso de toda cidade de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010407
					],
					"speakerTitle": "Feiticeiro do Abismo"
				},
				{
					"id": 102010407,
					"content": "Esse tesouro está agora nas minhas mãos. Não há nada que você possa fazer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010408
					],
					"speakerTitle": "Feiticeiro do Abismo"
				},
				{
					"id": 102010408,
					"content": "Agora seu precioso tesouro será sua ruína!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010409
					],
					"speakerTitle": "Feiticeiro do Abismo"
				},
				{
					"id": 102010409,
					"content": "Não, não, espere! N-Não toque nisso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010410
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010410,
					"content": "Hah! Oh, como você se preocupa agora que sua situação está finalmente clara para você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010411
					],
					"speakerTitle": "Feiticeiro do Abismo"
				},
				{
					"id": 102010411,
					"content": "Agora, o que temos aqui - um símbolo de fogo? Mwuhahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010412
					],
					"speakerTitle": "Feiticeiro do Abismo"
				},
				{
					"id": 102010412,
					"content": "Bumm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010501
					],
					"speakerTitle": "Feiticeiro do Abismo"
				},
				{
					"id": 102010501,
					"content": "Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010502
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010502,
					"content": "Quebrei as regras de sobrevivência... \"Explosões podem machucar pessoas... Jean pode ser horrível...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010503
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010503,
					"content": "É isso aí... Desta vez estou acabada... *Chora*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010504
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010504,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010505,
					"content": "Espera, então o Tesouro de Klee era uma bomba!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010506,
						102010507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010506,
					"content": "Isso foi épico...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010508
					]
				},
				{
					"id": 102010508,
					"content": "Não é de se admirar que a Klee tenha sido considerada a lutadora mais forte de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010509,
					"content": "Paimon mesmo, jamais vai arrumar uma briga com ela. Nunca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010510,
					"content": "Espera um pouco... Por que ela correu e fugiu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010511,
						102010512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010511,
					"content": "Algo a ver com as regras de sobrevivência...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010513
					]
				},
				{
					"id": 102010513,
					"content": "Parece que sim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010514,
					"content": "Bem, então vamos voltar aos <color=#00E1FFFF>Cavaleiros de Favonius</color> e falar com a Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010512,
					"content": "Algo a ver com a Jean...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010513
					]
				},
				{
					"id": 102010507,
					"content": "Lidou bem rápido com o Feiticeiro do Abismo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010508
					]
				}
			]
		},
		{
