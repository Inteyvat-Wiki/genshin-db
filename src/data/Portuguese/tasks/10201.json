			"dialogs": [
				{
					"id": 102010101,
					"content": "Estamos aqui! Este é o local!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010102,
					"content": "Veja, é aqui onde o meu graaande tesouro estava enterrado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010103,
					"content": "E onde agora existe apenas um enooorme buraco vazio no chão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010104,
					"content": "Espera - Quem é aquela pessoa ali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010105
					]
				},
				{
					"id": 102010105,
					"content": "É um... Feiticeiro do Abismo? Ei, talvez ele seja aquele que a Jean estava nos alertando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010106,
					"content": "O que é isso nas suas mãos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010107,
					"content": "Meu tesouro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010108
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010108,
					"content": "Ei?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010109,
					"content": "Hunf! Estou vendo que a garotinha trouxe seus amigos consigo! É hora de mudar de planos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010110
					],
					"speakerTitle": "Feiticeiro do Abismo"
				},
				{
					"id": 102010110,
					"content": "Ei, você! Se você acha que você é tão durão, volte aqui e lute!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010111,
					"content": "Atrás dele!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 1020103,
			"completionStepIds": [
				1020113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
