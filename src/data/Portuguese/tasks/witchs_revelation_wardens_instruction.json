						],
						"pointId": 340100825
					}
				]
			},
			"dialogs": [
				{
					"id": 746950101,
					"content": "Olá, Srta. Trismegistus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950102
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950102,
					"content": "Ah? Uma pronúncia tão perfeita... Só posso presumir que temos uma amiga em comum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950103
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950103,
					"content": "Uma certa Srta. Columbina recomendou seus serviços.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950104
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950104,
					"content": "Uma moça muito imprevisível, essa Srta. Columbina. Tenho certeza de que seu encontro deve ter sido cheio de surpresas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950105
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950105,
					"content": "Com certeza. \"Imprevisível\" é a palavra perfeita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950106
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950106,
					"content": "Prazer em conhecê-la. Meu nome é Wriothesley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950107
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950107,
					"content": "O Duque Submerso em carne e osso. É um prazer conhecê-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950108
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950108,
					"content": "Não imaginei que uma Bruxa tão grandiosa quanto você teria ouvido falar de mim. Estou honrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950109
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950109,
					"content": "Ou talvez tenha visto minha chegada nas estrelas, Srta. Trismegistus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950110
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950110,
					"content": "Hehe... Como já nos conhecemos, vamos deixar as formalidades de lado. Pode me chamar de Barbeloth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950111
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950111,
					"content": "Então, por favor, me chame de Wriothesley. Isto não é trabalho oficial, então não há necessidade de títulos. Sou só um cidadão comum de Fontaine aproveitando um tempo fora do expediente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950112
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950112,
					"content": "Encontrei um Bolo de Concha de cristal recém-saído do forno no caminho para cá. Ouvi dizer que as bruxas gostam de uma boa festa de chá. Por favor, pegue uma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950113
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950113,
					"content": "Ora, esse é um doce muito popular nas nossas festas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950114
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950114,
					"content": "Já estou aqui há um bom tempo e li a sorte de bastante gente, mas é a primeira vez que alguém vem trazendo presentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950115
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950115,
					"content": "Obrigada, Sr. Wriothesley. Vou compartilhá-las com Alice e as outras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950116
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950116,
					"content": "...Eu ouvi, Barbie! Deixe para mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950117
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950117,
					"content": "Não posso deixar Nicole levar tudo sem dizer uma palavra só porque estou atrasada, como antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950118
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950118,
					"content": "Hum-hum! Sim, sim, vou garantir que ela deixe um pouco para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950119
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950119,
					"content": "Sinceramente, você poderia ter escolhido um momento melhor. Logo agora que eu esperava preservar a dignidade da Sociedade das Feiticeiras diante da nossa nova amiga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950120
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950120,
					"content": "Não tem problema. Que mal há nisso? Pessoas poderosas não precisam ser sérias o tempo todo. Todo mundo tem direito a um pouco de personalidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950121
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950121,
					"content": "Exatamente! Aliás, otimismo e alegria são requisitos fundamentais para entrar na Sociedade das Feiticeiras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950122
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950122,
					"content": "É a primeira vez que ouço falar disso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950123
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950123,
					"content": "É uma nova regra que acabei de inventar! A Sociedade das Feiticeiras deve trazer alegria ao mundo. É natural que sejamos alegres e otimistas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950124
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950124,
					"content": "Falando apenas por mim, eu apoio que todos aproveitem a vida como quiserem, desde que nenhuma lei seja violada, é claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950125
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950125,
					"content": "Essa é uma condição que você talvez tenha dificuldade em fazer Alice cumprir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950126
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950126,
					"content": "Minha nossa, isso é preocupante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950127
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950127,
					"content": "Ei, vocês sabem que eu ainda estou aqui, né!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950128
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950128,
					"content": "Além disso, eu não faria nada criminoso na frente do Administrador da Fortaleza Meropide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950129
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950129,
					"content": "...E mesmo que eu fosse, imagino que suas salas sejam mais espaçosas do que a sala de confinamento solitário dos Cavaleiros de Favonius. Não é mesmo, Sr. Wriothesley?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950130
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950130,
					"content": "Haha! Como se uma simples sala de confinamento solitário pudesse conter uma bruxa lendária como você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950131
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950131,
					"content": "Tenho certeza de que a Srta. Alice aceitou sua punição de bom grado, sem dúvida por sua humildade e confiabilidade irrepreensível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950132
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950132,
					"content": "Exatamente, você não poderia estar mais certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950133
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950133,
					"content": "Por favor, pare, Sr. Wriothesley. Você realmente não devia encorajá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950134
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950134,
					"content": "Quando ela fica de bom humor, não dá para saber o que Alice pode acabar fazendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950135,
						746950136
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950135,
					"content": "Sei exatamente o que você quer dizer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950137
					]
				},
				{
					"id": 746950137,
					"content": "#Oh, sim! Falando nisso, {NICKNAME} é {F#a}{M#o} Cavaleir{F#a}{M#o} Honorável! Então {F#ela}{M#ele} certamente deve defender a dignidade do confinamento solitário!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950138,
					"content": "#{F#A}{M#O} Cavaleir{F#a}{M#o} Honorável impedindo a fuga de uma bruxa? Isso parece uma peça de teatro bem boa. Por favor, me chame para assistir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950139
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950139,
					"content": "Você adora ver o drama acontecer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950140,
					"content": "Mesmo assim, Paimon não esperava que você viesse aqui sozinho, Wriothesley. Assim a gente não precisa ir debaixo d'água buscar você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950141,
					"content": "Deve ser o poder da adivinhação.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950142
					]
				},
				{
					"id": 746950142,
					"content": "Ah, falando nisso, já está na hora de irmos ao que interessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950143
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950143,
					"content": "Sr. Wriothesley, seja por respeito à Srta. Columbina ou em agradecimento pelos seus doces, por favor, tire um Arcano Lunar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950144
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950144,
					"content": "Talvez haja um presente do destino escondido nele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950145
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950145,
					"content": "Isso conta como uma profecia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950146
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950146,
					"content": "Pode-se dizer que sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950147
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950147,
					"content": "Então nenhum cidadão de Fontaine deixaria de levá-lo a sério.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950148
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950148,
					"content": "Tendo dito o quanto levaria isso a sério, Wriothesley pega diretamente a carta do topo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746950149
					]
				},
				{
					"id": 746950149,
					"content": "Não conheço muito bem essas cartas. Esta parece ser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950150
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950150,
					"content": "O Imperador na posição normal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950151
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950151,
					"content": "Você parece sem palavras... Esta carta é ruim? Não precisa se preocupar, eu consigo lidar com qualquer coisa que me disser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950152
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950152,
					"content": "...Muito pelo contrário. Esta carta simboliza domínio eterno e autoridade inabalável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950153
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950153,
					"content": "Se isso representa o seu futuro, então você já chegou ao seu destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950154
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950154,
					"content": "Mas... Hehehe, seu destino continua avançando, sempre mudando, o que só pode significar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950155
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950155,
					"content": "Talvez não seja a pessoa que muda, mas sim o ambiente ao redor dela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950156
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950156,
					"content": "Mmhmm... Pelo menos por enquanto, essa tendência parece mesmo existir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950157
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950157,
					"content": "Então acho que posso confiar um pouco mais na minha intuição daqui em diante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950158
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950158,
					"content": "Já visitei Nod-Krai a negócios oficiais e aprendi bastante coisa por lá. Desde então, não consigo deixar de acompanhar as notícias locais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950159
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950159,
					"content": "E numa certa noite, ao olhar para a lua especialmente brilhante, não pude deixar de pensar: este mundo está passando por transformações, não está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950160
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950160,
					"content": "A resposta correta é: todas as coisas no mundo estão mudando a cada instante. E, após a intervenção de grandes variáveis, todos nós devemos nos preparar para receber o desconhecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950161
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950161,
					"content": "Porém, pelo resultado desta carta, parece que você não precisa se preocupar muito. Não importa como o ambiente mude, você sempre terá a capacidade de se adaptar a ele ou de lutar contra ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950162
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950162,
					"content": "Que notícia maravilhosa! Parece que não apanhei à toa, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950163,
						746950164
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950163,
					"content": "Foi um golpe cheio de belos desejos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950165
					]
				},
				{
					"id": 746950165,
					"content": "Por mera curiosidade, tenho uma pergunta um tanto presunçosa a fazer... Espero que não se incomode...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950166
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950166,
					"content": "Que astuto! Você está tentando atiçar nossa curiosidade de propósito, Sr. Wriothesley! Agora não temos escolha senão insistir que você pergunte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950167
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950167,
					"content": "Então permita-me ser franco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950168
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950168,
					"content": "Eu sempre me perguntei... Como exatamente uma profecia garante seu próprio cumprimento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950169
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950169,
					"content": "Por exemplo, minha leitura diz que permanecerei estável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950170
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950170,
					"content": "Mas e se, depois de ouvir essa profecia, eu for tomado por um repentino impulso rebelde e fizer imediatamente algo impulsivo? O que aconteceria então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950171
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950171,
					"content": "Por exemplo, e se...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950172
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950172,
					"content": "E se você explodir a Fortaleza Meropide?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950173
					]
				},
				{
					"id": 746950173,
					"content": "Claro, vamos supor isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950174
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950174,
					"content": "Você vai mesmo trazer esse assunto à tona de novo!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950175
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950175,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950176
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950176,
					"content": "Não, espere um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950177
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950177,
					"content": "Haha! Que coincidência feliz! Por acaso, eu conheço uma especialista em explosivos muito habilidosa. Recomendo-a sem reservas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950178
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950178,
					"content": "#Mas aí {F#a}{M#o} Cavaleir{F#a}{M#o} Honorável certamente agirá como {F#guardiã}{M#guardião}, intervindo no momento crítico para impedir que algo ruim aconteça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950179
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950179,
					"content": "...E assim a profecia se cumpre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950180
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950180,
					"content": "Ela parece ser uma verdadeira força destrutiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950181
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950181,
					"content": "E fofinha. Muito fofinha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950182
					]
				},
				{
					"id": 746950182,
					"content": "Hã, estamos falando da Klee!? O Wriothesley provavelmente não sabe que a Klee é filha da Alice, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950183
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950183,
					"content": "Bem, na verdade, acredito que o título completo dela seja Filha da Aventureira que viu o mundo inteiro, Rei Dodo, Defensora da Antiga Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950184
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950184,
					"content": "Não temos tempo para tudo isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950185
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950185,
					"content": "Muito bem... Ela é a Criança Mais Adorável de Alice, o Rei Dodo, a Verdadeira Cavaleira das Faíscas, Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950186
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950186,
					"content": "Sinceramente, acho que deveríamos mesmo voltar ao meu plano original e dar uma festa fabulosa para todos, onde eu possa apresentá-los devidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950187
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950187,
					"content": "Assim, quando Klee for para Fontaine, ela terá vários novos amigos com quem tomar chá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950188
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950188,
					"content": "Parece um plano maravilhoso. Já estou ansioso por isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950189
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950189,
					"content": "Afinal de contas, eu nunca desistirei de um bom bule de chá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950164,
					"content": "A boa sorte vem àqueles que sobrevivem a grandes desastres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950165
					]
				},
				{
					"id": 746950136,
					"content": "Por favor, mantenha o respeito pelo confinamento solitário.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950137
					]
				}
			]
		},
