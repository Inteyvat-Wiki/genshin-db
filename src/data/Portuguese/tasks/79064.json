					"nextDialogs": [
						790640302
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Supervisor Azul"
				},
				{
					"id": 790640302,
					"content": "Bem, não nos contaram nada sobre isso essa manhã. Saia daqui. Nos deixe em paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640303
					],
					"speakerTitle": "Guarda Gigante"
				},
				{
					"id": 790640303,
					"content": "O guarda gigante pega todos vocês e te jogam para fora.\\nNinguém consegue lutar contra isso.",
