			"dialogs": [
				{
					"id": 790640601,
					"content": "Indivíduos suspeitos detectados! Eu não sei qual lei você quebrou, mas atualmente estamos no maior nível de alerta. Venha conosco, se entreguem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640602
					],
					"speakerTitle": "Guarda Gigante"
				},
				{
					"id": 790640602,
					"content": "Todos dispersam. Você ouve a voz de Cappet gritando, \"Cada um por si!\"\\nApós os guardas terem ido embora, vocês se juntam de volta no mesmo lugar. Parece que ninguém foi pego...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						790640603
					]
				},
				{
					"id": 790640603,
					"content": "Vamos tentar de novo, tudo bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Detetive"
				}
			]
		},
