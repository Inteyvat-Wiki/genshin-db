			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230170101,
					"content": "Vi-Viajante! Você chegou bem na hora! Eu estava terminando de tomar um café com Kaia e voltando ao trabalho. Permita-me apresentá-lo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170102,
					"content": "#Ah! Então você deve ser o Viajante que Garcia tem me falado. É um prazer conhecê-l{M#o}{F#a}, eu sou Kaia, sou uma... Hum... Bem, eu danço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170104
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170104,
					"content": "Olá, Garcia falou de você antes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230170105
					]
				},
				{
					"id": 230170105,
					"content": "Hehe, é mesmo? Bom saber. Achei que ele não conseguia pensar em mais nada além da sua máquina e em Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170106
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170106,
					"content": "Você pode me deixar fora disso, senhorita. Tenho certeza que seria de agrado do Sr. Garcia também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170107,
					"content": "De jeito nenhum, se não fosse por você, Garcia já estaria falido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170108
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170108,
					"content": "Não concordo totalmente com isso, senhorita. O Sr. Garcia certamente economizaria dinheiro suficiente para duas xícaras de café.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170109
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170109,
					"content": "Para três xícaras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170110,
					"content": "Você demonstra uma empatia surpreendente, Sr. Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170111,
					"content": "Bem, d—de volta aos negócios! Viajante, ainda estou comprando insignias, se você encontrar algumas, pode vendê-las para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170112
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170112,
					"content": "Eu... Ganhei um pouco de Mora recentemente. Então você não precisa se preocupar com o seu pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
