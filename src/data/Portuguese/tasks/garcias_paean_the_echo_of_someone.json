			"dialogs": [
				{
					"id": 230175001,
					"content": "Oi? Hmm... Você tem alguma pergunta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175002
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175002,
					"content": "Como você conheceu o Sr. Garcia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230175003
					]
				},
				{
					"id": 230175003,
					"content": "#Que pergunta direta! Típico de {F#uma}{M#um} aventureir{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175004
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175004,
					"content": "Conheci o Sr. Garcia pois... Ele foi contratado pelo chefe da minha trupe como contador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175005
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175005,
					"content": "Hahaha, para ser sincera, nunca conheci alguém tão diferente da nossa trupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175006
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175006,
					"content": "Enquanto estávamos brincando, dançando, bebendo e cantando, ele estava apenas fazendo cálculos silenciosamente com Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175007
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175007,
					"content": "Em uma ocasião, vi que ele estava vestindo roupas muito estranhas, com algo desenhado nelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175008
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175008,
					"content": "Ele me deixou muito curiosa, então perguntei a ele o que eram aqueles desenhos. Ele me disse que eram projetos para uma máquina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175009
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175009,
					"content": "Ele disse que desenhou nas suas próprias roupas uma vez quando estava falando para alguém sobre sua máquina, e não encontrava papel e nem lápis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175010
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175010,
					"content": "Ele usou um pedaço de carvão para desenhar os esboços para que pudesse explicar melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175011
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175011,
					"content": "Depois passamos muito tempo conversando sobre aquela roupa e sua máquina... E, claro, ele foi quem mais falou, enquanto eu era a ouvinte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175012
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175012,
					"content": "He he, ele é uma pessoa muito estranha. Mas, também... Ele também é uma pessoa carismática.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaia"
				}
			]
		},
