			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hilichurl"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2695.591,
							282.595,
							9928.808
						],
						"pointId": 351500004
					}
				]
			},
			"dialogs": [
				{
					"id": 80160201,
					"content": "Ei, tem um Hilichurl aqui! Ele tá... dormindo? Não parece agressivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160202,
					"content": "Por que ele está... escondido aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160203,
					"content": "Ah! Você acordou ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160204,
					"content": "Hã? Ele fugiu... Nossa reputação em Natlan é tão intimidadora para os Hilichurls?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160205,
					"content": "Parece que tem alguma coisa aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160206
					]
				},
				{
					"id": 80160206,
					"content": "Você quer dizer aquela coisa brilhante? Deve ter caído das roupas dele enquanto corria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160207,
					"content": "Hmm... Talvez ele achasse que tinha encontrado algum tesouro e estava planejando escondê-lo aqui. Mas não esperava que fôssemos descobrir tão rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160208,
					"content": "Deixe a Paimon ver! Hilichurls nem sempre são os mais espertos, então pode não valer muito, mas ainda assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160209,
					"content": "...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160210
					]
				},
				{
					"id": 80160210,
					"content": "#O que houve, {NICKNAME}? Você parece preocupad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160211,
					"content": "Isso não é só uma chave qualquer? Mas seu formato é realmente único, não parece ser do estilo de Natlan... Hmm... De qual nação será?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160212,
						80160213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160212,
					"content": "Isso é...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				},
				{
					"id": 80160214,
					"content": "Câmara de Hibernação da nave espacial? Que câmara? Que nave espacial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160215,
					"content": "Pera aí! Câmara de Hibernação da nave espacial! Tipo, a que trouxe você para Teyvat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160216,
					"content": "Isso mesmo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160217
					]
				},
				{
					"id": 80160217,
					"content": "Como isso pode ter chegado aqui? Você tem certeza que não foi você que deixou cair?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160218,
						80160219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160218,
					"content": "A minha está aqui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160220,
					"content": "Ué, são idênticas! Mas se essa não é sua, então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160221,
						80160222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160221,
					"content": "Só tem duas, na verdade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160223,
					"content": "#Paimon sabia... Uau, as chaves de uma nave espacial. Hmm, isso só confirma que você é mesmo {M#um}{F#uma} alienígena... Espera, não, {M#um Descido}{F#uma Descida}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160224,
					"content": "Mas enfim, agora que a gente sabe de onde veio, a pergunta é — como chegou aqui? Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160225,
					"content": "#{M#Sua irmã}{F#Seu irmão} deixou essa chave cair por perto, o que permitiu que aquele Hilichurl a pegasse e tentasse escondê-la em algum lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160226,
					"content": "#Significa que {M#sua irmã}{F#seu irmão} esteve aqui recentemente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160227,
						80160228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160227,
					"content": "Isso quer dizer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160229,
					"content": "#Quem diria que ajudar a Iansan a patrulhar por acaso nos levaria a uma descoberta tão importante, e até uma pista sobre {M#sua irmã}{F#seu irmão}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160230,
					"content": "Deveríamos continuar procurando por informações aqui perto, ou contar isso para Iansan imediatamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160231,
					"content": "Ah, aí estão vocês. Vocês devem ter se esforçado bastante na patrulha — obrigada pelo trabalho duro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160232
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160232,
					"content": "Iansan? Não deveríamos nos encontrar no Coletivo da Fartura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160233,
					"content": "Estávamos pensando em procurar você. Acabamos de descobrir algo importante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160234,
					"content": "Eu vim avisar que vocês não precisam continuar patrulhando. O concurso de fisiculturismo foi cancelado. Uma patrulha vai assumir nosso lugar em breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160235
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160235,
					"content": "O que aconteceu? O que houve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160236,
					"content": "A Ordem do Abismo lançou um ataque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160237
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160237,
					"content": "Como é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160238,
					"content": "Nossa hipótese foi confirmada tão rapidamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160239
					]
				},
				{
					"id": 80160239,
					"content": "#(Parece que {M#Lumine}{F#Aether} está agindo de novo.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160240
					]
				},
				{
					"id": 80160240,
					"content": "#(Tenho que aproveitar essa oportunidade para falar com {M#ela}{F#ele}.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160241
					]
				},
				{
					"id": 80160241,
					"content": "Eu já tinha ouvido sobre a Ordem do Abismo antes, mas nunca vi eles realizarem uma operação em uma escala tão grande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160242
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160242,
					"content": "É como se eles estivessem se preparando para uma guerra com toda a nossa nação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160243
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160243,
					"content": "Uma ordenzinha secreta contra a nação da guerra inteira? Como eles esperam conseguir isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160244,
					"content": "Preferem agir nas sombras, pelo que sabemos. Essa é a primeira vez que vemos algo assim... O que eles estão tentando fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160245,
					"content": "Não faço ideia. Não dá para saber só com base nos ataques deles à nossa tribo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160246
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160246,
					"content": "A defesa do Coletivo da Fartura não deve ser um problema. Decidi ir para o Estádio da Chama Sagrada para falar com Mavuika. Afinal, ela tem acesso a todas as notícias de cada canto da nossa nação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160247
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160247,
					"content": "#Você quer me acompanhar, {NICKNAME}? Tenho certeza que todos vão se sentir melhor sabendo que {F#a heroína}{M#o herói} de Natlan tá no caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160248,
						80160249
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160248,
					"content": "Eu também preciso entender a situação.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160250,
					"content": "#Ótimo, vamos lá junt{M#os}{F#as}, então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160249,
					"content": "Eu sei algumas coisas sobre a Ordem do Abismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160228,
					"content": "A Ordem do Abismo também deve ter vindo aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160222,
					"content": "#Uma é minha e a outra é {M#da minha irmã}{F#do meu irmão}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160219,
					"content": "Eu sempre mantive ela comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160213,
					"content": "A chave da Câmara de Hibernação da nave espacial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				}
			]
		},
		{
			"id": 801603,
