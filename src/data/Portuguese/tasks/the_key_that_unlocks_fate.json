			"dialogs": [
				{
					"id": 80160401,
					"content": "Ufa... Bem melhor. Isso aí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160402
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160402,
					"content": "Como era de se esperar da Vovó Itztli... Se eu soubesse que você estava no comando, teria reconsiderado a necessidade de apoiar sua tribo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160403
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160403,
					"content": "A Ordem do Abismo deveria reconsiderar seus objetivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160404
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160404,
					"content": "Pela direção que eles foram, minha experiência de combate me diz que eles devem estar indo para uma fortaleza da Ordem do Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160405
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160405,
					"content": "Vamos aproveitar a vantagem e tomar a fortaleza de onde eles estão atacando. Isso deve prejudicar mais operações ofensivas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160406
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160406,
					"content": "Houve uma batalha aqui? Precisa de ajuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160407
					],
					"speakerTitle": "Sutura"
				},
				{
					"id": 80160407,
					"content": "Os guerreiros dos Mestres do Vento Noturno também vieram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160408,
					"content": "A batalha contra o Abismo continua fresca em nossas mentes, então todos estão acostumados a trabalhar juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160409
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160409,
					"content": "Estamos com a moral alta. Vamos em frente derrubar aquela fortaleza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansan"
				}
			]
		},
		{
			"id": 801605,
			"completionStepIds": [
