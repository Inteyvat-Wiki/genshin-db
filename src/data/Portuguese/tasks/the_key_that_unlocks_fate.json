			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iansan"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2649.083,
							279.082,
							10084.27
						],
						"pointId": 351500003
					}
				]
			},
			"dialogs": [
				{
					"id": 80160101,
					"content": "Olha só, que coincidência! Tum{RUBY#[S]Esperança}aini e Paimon, não esperávamos ver vocês aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160102
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160102,
					"content": "Treinadora Iansan! O que você tá fazendo aqui sozinha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160103,
					"content": "S-Só pra você saber, Paimon não veio pra treinar! Paimon tá de boa sem essas aulas de dieta e musculação por ora, valeu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160104,
					"content": "Hahaha... Sei, sei, eu também não sou nenhuma treinadora durona, sempre respeito a vontade dos alunos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160105
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160105,
					"content": "Mas... um pouco de exercício aeróbico provavelmente te faria bem. Que tal assumir minha patrulha por um tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160106,
						80160107
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160106,
					"content": "Ao invés de exercício...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160108
					]
				},
				{
					"id": 80160108,
					"content": "Tô só brincando. Você tem razão, eu realmente tô procurando ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160109
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160109,
					"content": "Então, o Coletivo da Fartura tá organizando um concurso de fisiculturismo. Como muita gente começou a se exercitar de última hora, estamos sem pessoal pra patrulhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160110
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160110,
					"content": "Então você tá patrulhando por eles? Você não precisa se preparar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160111,
					"content": "Tô de boa. Primeiro porque eu sempre acreditei que só com disciplina ao longo do tempo você consegue ter a melhor forma física. Treino de última hora não faz sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160112
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160112,
					"content": "E como vocês podem ver, eu não posso competir nas categorias de peso regulares e, na minha categoria, eu não tenho adversários.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160113
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160113,
					"content": "Paimon acha que faz sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160114,
					"content": "Hã? Por que você tá encarando Paimon? Paimon não tá nem perto da sua categoria de peso! Paimon também não vai participar de nenhuma competição de fisiculturismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160115,
					"content": "#{NICKNAME}, vamos ajudar na patrulha, certo? Caso contrário, ela pode forçar Paimon a subir no palco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160116,
					"content": "Hahaha, que bom! Resolvi a comissão só com um olhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160117,
						80160118
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160117,
					"content": "Certo, vou fazer isso por você, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160119
					]
				},
				{
					"id": 80160119,
					"content": "Obrigada, só garantam que tá tudo normal por aqui. É uma patrulha básica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160120
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160120,
					"content": "Vou dar uma olhada na outra área, e nos encontraremos de volta no Coletivo da Fartura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160121
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160121,
					"content": "Pode deixar, Treinadora Iansan. Somos especialistas em passeios e patrulhas, não se preocupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160118,
					"content": "Certo, Treinadora, vamos te ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160119
					]
				},
				{
					"id": 80160107,
					"content": "Isso aí parece mais é que eu estaria te ajudando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160108
					]
				}
			]
		},
		{
			"id": 801602,
			"completionStepIds": [
				801602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
