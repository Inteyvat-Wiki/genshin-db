			"dialogs": [
				{
					"id": 80160701,
					"content": "Essa fortaleza foi neutralizada. Bom trabalho, pessoal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160702
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160702,
					"content": "Hehe. Então eles não são bons pra muita coisa, afinal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160703,
					"content": "Não foi um resultado satisfatório. Eu queria que eles se desculpassem pessoalmente e admitissem que os Mestres do Vento Noturno são fortes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160704
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160704,
					"content": "Esqueça, vou ter que voltar e usar um vinho do bom para compensar essa sensação de perda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160705
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160705,
					"content": "Apesar de termos eliminado os monstros da Ordem do Abismo dessa fortaleza, eles não devem representar uma grande ameaça por um tempo, mas... Não devemos baixar a guarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160706
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160706,
					"content": "Talvez seja só eu, mas um inimigo sob certo normalmente defende a base a todo custo. A luta vai ficando mais intensa até o final de tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160707
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160707,
					"content": "Mas, além dos poucos que lutaram até o fim, a maioria dos inimigos simplesmente... desistiu e recuou, como se tivessem sentido algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160708
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160708,
					"content": "E então? Isso não é estratégia de abandono de fortaleza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160709
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160709,
					"content": "Não, eles são a Ordem do Abismo, que se atreveram a desafiar uma nação inteira. Eles são extremamente agressivos, e não parece que essa seria a estratégia deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160710
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160710,
					"content": "Então você acha que eles estão tramando algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160711
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160711,
					"content": "De qualquer forma, não temos nenhuma informação, portanto, devemos manter o ceticismo e estar atentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160712
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160712,
					"content": "(No final, não sabemos nada sobre os objetivos da Ordem do Abismo, e não temos nenhuma fonte de informações...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160713
					]
				},
				{
					"id": 80160713,
					"content": "#(Mas se eu puder encontrar {M#Lumine}{F#Aether}, minhas perguntas, e as de Natlan, poderão ser respondidas.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160714,
						80160715
					]
				},
				{
					"id": 80160714,
					"content": "Irei para o Coletivo da Fartura mais uma vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160716
					]
				},
				{
					"id": 80160716,
					"content": "Ah, então aquela chave continua te incomodando, né...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160717,
					"content": "#Você tem razão. Se pudéssemos usar a chave para encontrar {M#sua}{F#seu} {M#irmã}{F#irmão}, você poderia falar com {M#ela}{F#ele} de novo, e talvez até conseguíssemos acabar com essa guerra imediatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160718,
					"content": "Espera, você já vai embora? Bem na hora em que eu estava pensando em te convidar para o primeiro banquete da vitória?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160719
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160719,
					"content": "Podem ir, gente. Citlali e eu vamos cuidar das coisas aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160715,
					"content": "A única pista que temos é a chave.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160716
					]
				}
			]
		},
