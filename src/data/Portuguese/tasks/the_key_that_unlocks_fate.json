						],
						"pointId": 1
					}
				]
			},
			"dialogs": [
				{
					"id": 80160501,
					"content": "Veja, é a Citlali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160502,
					"content": "O que vocês estão fazendo aqui? Vocês vieram para ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160503
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160503,
					"content": "Qual é a situação? Mavuika mandou a gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160504
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160504,
					"content": "Julgando pelo fato de que você tá aqui em vez de estar trancada em casa, as coisas não estão tão bem assim, estão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160505,
					"content": "Não, não é nada disso... Só é irritante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160506
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160506,
					"content": "Ouvi dizer que nossa tribo é o alvo principal dos ataques. Sério... Por que eles nos tratam como se fôssemos alvos fáceis? Urg...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160507
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160507,
					"content": "...Quanto mais eu penso, mais irritada fico. Não consigo nem ler um livro em casa, então... Hunf, aqui estou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160508
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160508,
					"content": "Então esse é o motivo da Vovó Itztli ficar irritada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160509,
					"content": "A \"Ordem do Abismo\", né? Até mesmo o nome deles reflete seu péssimo gosto. Parece exatamente o tipo de truque barato que um escritor de terceira categoria faria para marcar uma facção como vilã imediatamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160510
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160510,
					"content": "#Ela tá dizendo que a organização d{F#o seu irmão}{M#a sua irmã} tem um péssimo gosto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160511,
						80160512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160511,
					"content": "Me sinto da mesma maneira.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160513
					]
				},
				{
					"id": 80160513,
					"content": "#Calma lá, como é? Você tá dizendo que {M#a irmã}{F#o irmão} de {NICKNAME}... é da Ordem do Abismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160514
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160514,
					"content": "(Bem, eu realmente só disse aquilo, pois estava irritada, mas mesmo assim, acho que fui longe demais...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160515
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160515,
					"content": "Ei, pessoal, vamos falar sobre isso mais tarde. Temos inimigos se aproximando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160516
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160516,
					"content": "Ótimo! Agora é a nossa chance de descontar nossa raiva e quebrar a atmosfera constrangedora de antes. Ainda bem que não preciso me preocupar em como reverter a situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160517
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160517,
					"content": "Você não precisava dizer essa última parte em voz alta, Citlali... De qualquer forma, vamos dar uma boa surra neles, pessoal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160512,
					"content": "#Se eu fosse {M#ela}{F#ele}, teria mudado de nome há muito tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160513
					]
				}
			]
		},
