				},
				{
					"id": 741210303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210304
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 741210304,
					"content": "Ei! Não deixe Paimon nesse silêncio constrangedor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210305,
					"content": "...Olá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210306
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210306,
					"content": "Que dia bonito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210307
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 741210307,
					"content": "Sobre a pessoa ali...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210308
					]
				},
				{
					"id": 741210308,
					"content": "Que pessoa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210309
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210309,
					"content": "Não sei de que pessoa você está falando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210310
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 741210310,
					"content": "Estávamos apenas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210311
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210311,
					"content": "Fazendo uma caminhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210312
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 741210312,
					"content": "Sim, isso mesmo. Estamos apenas fazendo uma caminhada. Uma caminhada, feita por nós, duas pessoas totalmente normais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210313
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210313,
					"content": "Que dia lindo e que maravilhoso é caminhar! Você não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210314
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 741210314,
					"content": "Fazer uma caminhada é algo completamente normal. Tenho certeza de que você entende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210315
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210315,
					"content": "Uh... do que vocês estão falando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210316,
					"content": "Vocês ouviram alguém pedindo socorro? Um homem está enterrado no chão ali e quase foi comido por caranguejos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210317,
					"content": "Como é? Aconteceu uma coisa assim onde caminhamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210318
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210318,
					"content": "Em um dia tão bonito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210319
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 741210319,
					"content": "Se ele for comido por caranguejos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210320
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210320,
					"content": "Ia ser muito engraçado. Uh, digo, uma pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210321
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 741210321,
					"content": "Infelizmente, não vamos deixar isso acontecer. Quero dizer, não podemos deixar isso acontecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210322
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210322,
					"content": "Se a gente encontrar alguma coisa assim durante nossa caminhada, não ficaremos só assistindo. Digo, se.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210323
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 741210323,
					"content": "O que vocês estão fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210324
					]
				},
				{
					"id": 741210324,
					"content": "Caminhando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210325
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210325,
					"content": "Como dissemos, caminhando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210326
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 741210326,
					"content": "Vocês não notaram nada estranho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210327,
					"content": "Não, nadinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210328
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210328,
					"content": "#Isso, nadinha. Exceto que vocês {M#dois}{F#duas} estão interrompendo nossa caminhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210329
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 741210329,
					"content": "Caminhar é... muito pessoal. Não gostamos de ser interrompidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210330
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210330,
					"content": "Sugerimos que vocês encontrem um bom lugar para caminhadas. A Fonte de Lucine, por exemplo, é um ótimo lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210331
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 741210331,
					"content": "Aqui é onde a gente caminha. Digo, onde sentimos a natureza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210332
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210332,
					"content": "É por isso que não queremos ser interrompidos. Adeus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		},
