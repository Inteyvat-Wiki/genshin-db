						"sceneId": 3,
						"position": [
							2904.566,
							441.616,
							4182.956
						],
						"pointId": 5746
					}
				]
			},
			"dialogs": [
				{
					"id": 741210701,
					"content": "...O quê? Então eles não pretendiam me matar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210702
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210702,
					"content": "#*Suspiro* Vocês são muito observador{M#es}{F#as}. Isso mesmo. Fui eu quem quebrei a máquina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210703
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210703,
					"content": "Mas por que você quebrou a máquina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210704,
					"content": "Hunf, por que mesmo! Porque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210705
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210705,
					"content": "Há muito tempo, eu vivia uma vida miserável. Eu estava muito deprimido. Então, conheci um cara que me deu uma bebida saudável que levantou meu ânimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210706
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210706,
					"content": "Ele foi muito gentil comigo. Então eu queria retribuir a bondade dele. Um dia, eu tive minha chance. Ele me apresentou a pessoas muito ricas e me pediu para ajudá-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210707
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210707,
					"content": "Tudo que eu fiz foi trabalho braçal, como coletar peças mecânicas que pertenciam ao Instituto de Pesquisas de Fontaine. Os ricos me pagavam um bom dinheiro por esses serviços.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210708
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210708,
					"content": "Opa, parece uma maravilha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210709,
					"content": "Não é? Dessa vez, eles me pediram para achar essa máquina estranha, remover o núcleo e entregar para eles. Eu posso devolver o dinheiro ao meu mano e ganhar um dinheiro. Tenho que dar tudo de mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210710
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210710,
					"content": "Mas, aquela gente terrível... talvez eles tenham odiado me ver trabalhando duro para mudar minha vida para melhor. Eles interferiram com meu trabalho e me alertaram contra entregar os—hmm, componentes de precisão aos meus empregadores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210711
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210711,
					"content": "Mas eu não deixei eles vencerem! Eu aceitei o serviço e protestei contra o comportamento deles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210712
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210712,
					"content": "E como resultado, como você disse, eu recebi uma lição...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210713
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210713,
					"content": "Oh... Pobrezinho... Mas esse seu trabalho paga tanto assim mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210714,
					"content": "Claro. Essa é uma das razões de eu não querer contar porque eu protestei. Contudo, já que salvaram minha vida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210715
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210715,
					"content": "Não tanto quanto salvar sua vida, quero dizer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210716
					]
				},
				{
					"id": 741210716,
					"content": "#...Eu também pensei que já que vocês são bem observador{M#es}{F#as}, eu deveria logo contar a verdade. Podem ver isso como uma colaboração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210717
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210717,
					"content": "Máquinas tão esquisitas foram colocadas acima e debaixo d'água. É fácil avistar essas máquinas — todas elas produzem uma luz peculiar ao redor delas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210718
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210718,
					"content": "Lide com isso para mim e me traga o núcleo específico de dentro. Deve ter <color=#00E1FFFF>sete</color> ao todo. Depois que tudo terminar, vamos dividir os ganhos na metade. Fechado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210719,
						741210721,
						741210722
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210719,
					"content": "Parece bom.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210720
					]
				},
				{
					"id": 741210720,
					"content": "Hmm, mas o que essas máquinas fazem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210725,
					"content": "Elas destroem o ambiente. Essas máquinas são malignas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210726
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210726,
					"content": "Destroem como?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210727,
					"content": "Como eu vou saber? Eu não faço parte do Instituto de Pesquisas de Fontaine. Anomalias já ocorreram, então deve fazer mal ao ambiente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210728
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210728,
					"content": "Bem... Isso parece sensato. Cada vez que vemos um ambiente sobrenatural durante nossa aventura, vai ter algum problema que temos que resolver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210729,
					"content": "#{NICKNAME}, por que a gente não ajuda Henri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210730,
					"content": "Haha, ótimo! Então está decidido! <color=#00E1FFFF>Me tragam sete núcleos</color>, vamos ficar ricos juntos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210721,
					"content": "O que essas máquinas fazem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210725
					]
				},
				{
					"id": 741210722,
					"content": "Eu recebo 70% dos ganhos e 20% devem ser pagos adiantados.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210723
					]
				},
				{
					"id": 741210723,
					"content": "Urgh, está bem. Mas não posso te dar tudo. Ainda estou esperando para terminar tudo para eu ser pago!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210724
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210724,
					"content": "Hmm, mas o que essas máquinas fazem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210725
					],
					"speakerTitle": "Paimon"
				}
			]
