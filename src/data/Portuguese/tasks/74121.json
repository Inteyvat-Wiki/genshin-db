			"dialogs": [
				{
					"id": 741210301,
					"content": "Olá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210303
