			"dialogs": [
				{
					"id": 741210601,
					"content": "Hunf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210602
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 741210602,
					"content": "*Suspiro* Eu não fiz na— Eu... essa é a nova tendência de beleza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210603
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210603,
					"content": "Waah! Quando vocês...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210604,
					"content": "Estamos caminhando. Caminhar... é uma forma de exercício.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210605
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210605,
					"content": "Exercício envolve movimento. Movimento é o que nos trouxe aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210606
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 741210606,
					"content": "Vocês fizeram isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210607
					]
				},
				{
					"id": 741210607,
					"content": "Então, e se...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210608
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210608,
					"content": "#Oh, Hunter, me lembro agora. Dê uma boa olhada nel{M#e}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210609
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 741210609,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210610
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210610,
					"content": "#El{M#e}{F#a} é a pessoa que ele nos disse para não mexer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210611
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210611,
					"content": "Certo, certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210612
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 741210612,
					"content": "Sobre o que estão cochichando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210613,
					"content": "Nada. Só estamos caminhando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210614
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210614,
					"content": "Isso mesmo. Só estamos caminhando. Se não houver nada mais, vamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210615
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 741210615,
					"content": "Continuar caminhando para outros lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210616
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210616,
					"content": "Espera, vocês não têm mais que fazer alguma coisa assustadora comigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210617
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210617,
					"content": "A lição foi aprendida, se entende o que quero dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210618
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 741210618,
					"content": "Que lição?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210619
					]
				},
				{
					"id": 741210619,
					"content": "Nada. Digo, frango assado é perigoso. Atrai problemas. Veja como uma lição valiosa. Vamos lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210620
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 741210620,
					"content": "Mas, frango assado é... Debord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210621
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210621,
					"content": "Esqueça o frango assado! Devemos continuar nossa caminhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210622
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 741210622,
					"content": "\"Vamos pedir para Sonny nos pagar um frango assado da próxima vez.\"\\nAssim diz Tunner enquanto ele sai andando com Hunter.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741210623
					]
				},
				{
					"id": 741210623,
					"content": "Obrigado! Muito obrigado! Eu sabia que entenderiam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210624
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210624,
					"content": "#Parece que é exatamente como {NICKNAME} disse... Vamos ajudar Henri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210625,
					"content": "Mas cavar você é muito cansativo! Então Paimon vai aceitar frango assado como pagamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210626,
					"content": "Hã? Ugh... Tudo bem, certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210627
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210627,
					"content": "Demora um tempo para ajudar Henri a sair das areias e tirar o barril dele.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741210628
					]
				},
				{
					"id": 741210628,
					"content": "Você começa a desfrutar do delicioso frango assado com Paimon.\\nHenri parece estar prestes a babar, mas segura o desejo de comer um pedaço e mantém a promessa para continuar com sua dignidade.\\nEntretanto, ver Henri tentar realmente parecer não afetado, Paimon oferece compartilhar o frango assado com Henri.\\nO frango está crocante por fora e exala um aroma oleoso irresistível. Delícia!",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
