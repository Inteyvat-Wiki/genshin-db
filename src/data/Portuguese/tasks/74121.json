			"dialogs": [
				{
					"id": 741210801,
					"content": "Liberdade! Aah, como é bom o gosto da liberdade! Bem, não é tão gostoso como frango assado, mas liberdade é incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210802
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210802,
					"content": "... Então, o que a placa que você está segurando quer dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210803,
					"content": "Hmm? Oh, isso aqui é para representar um protesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210804
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210804,
					"content": "Protesto contra o quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210805
					]
				},
				{
					"id": 741210805,
					"content": "Hmm, como posso explicar. São as pessoas que me enterraram. Fizeram isso para me impedir de trabalhar duro, por isso estou protestando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210806
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210806,
					"content": "Espera, por que eles queriam que você parasse de trabalhar duro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210807,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210808
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210808,
					"content": "Você pode guardar um segredo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210809
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210809,
					"content": "Claro! A boca de Paimon está fechada! Nem um pio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210810,
					"content": "Então seus segredos estão seguros comigo também. Mas não posso falar eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210811
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210811,
					"content": "Ei! Você tá tirando onda de Paimon?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210812,
					"content": "Vamos falar sobre alguma outra coisa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210813
					]
				},
				{
					"id": 741210813,
					"content": "Ok... qual era a do barril que você estava usando? Era um jeito de protestar também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210814,
					"content": "Hã? Bem, não sei... mas antes deles me enterrarem, colocaram esse barril em mim. Que coisa de mau gosto, tenho que dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210815
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210815,
					"content": "Então por que você acabou enterrado por eles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210816,
					"content": "Porque eles são pessoas terríveis! Eles me pegaram sem razão nenhuma e me enterraram na areia! Eles me queriam morto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210817
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210817,
					"content": "Sem razão nenhuma? Mesmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210818
					]
				},
				{
					"id": 741210818,
					"content": "Cla—claro! Você não viu?! Eles me enterraram na areia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210819
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210819,
					"content": "Se eles não me queriam morto, por que fariam isso?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210820
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210820,
					"content": "#Hmm, isso soa razoável... {NICKNAME}, o que você acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
