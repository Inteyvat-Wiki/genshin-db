			"dialogs": [
				{
					"id": 742490201,
					"content": "Ahhh! Nunca me canso de um chá da tarde tranquilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490202,
						742490203
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490202,
					"content": "#(Vamos ficar sentad{M#o}{F#a}s assim por mais um pouco.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490204,
					"content": "Ora, ora... Os momentos alegres realmente passam num piscar de olhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490203,
					"content": "Acho que está na hora de eu começar a arrumar as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
