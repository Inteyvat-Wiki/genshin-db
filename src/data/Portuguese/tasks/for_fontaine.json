			},
			"dialogs": [
				{
					"id": 742490101,
					"content": "Me sinto péssima por deixar todo o trabalho para você de novo, Srta. Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490102,
					"content": "Não é incômodo nenhum. É o mínimo que posso fazer depois do apoio que você nos deu durante o Festival de Cinema de Fontinalia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490103,
					"content": "Ah, imagina! Os atores é que foram as verdadeiras estrelas do espetáculo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490104,
					"content": "A senhorita não planeja voltar a atuar, Srta. Furina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490105
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490105,
					"content": "Bem... Nunca diga nunca... Mas agora, eu prefiro trabalhar nos bastidores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490106
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490106,
					"content": "Para falar a verdade, quando eu ainda vivia em Fontaine, até eu sabia quem você era, Furina, a superestrela adorada por todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490107,
					"content": "Argh, por favor, não! Faça o que for, mas não diga que \"cresceu assistindo às minhas apresentações\"... Isso me deixa tão sem graça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490108,
					"content": "Ah, não precisa se preocupar com isso. Eu só queria dizer que, quando deixei Fontaine, tive a honra de vê-la como era naquela época.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490109,
					"content": "Mas vendo você de novo depois de todo esse tempo, acho que prefiro o jeito que você se porta agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490110,
					"content": "Hã...? Como eu me comporto agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490111,
					"content": "Sim, você sempre parecia tão tensa no palco. Agora você parece mais confortável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490112,
					"content": "Haha... Obrigada por dizer isso. Na verdade, estou aproveitando muito mais a vida ultimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490113,
					"content": "E você, Srta. Guillotin? Está satisfeita com seu estilo de vida atual? Em comparação a quando deixou Fontaine, quero dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490114,
					"content": "Tudo está indo bem, embora eu suponha que isso se deva principalmente a uma mudança na minha forma de pensar. Para falar a verdade, sempre gostei de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490115
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490115,
					"content": "Não estou dizendo que é melhor do que as outras nações, mas este lugar guarda muitas memórias. A vida aqui pode ser tão calma quanto águas paradas, mas também pode ser repleta de mudanças inesperadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490116,
					"content": "Recentemente, aprendi a enxergar o lado mais positivo da vida. Suponho que as pessoas de outros lugares vejam suas terras natais de uma forma parecida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490117
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490117,
					"content": "Nossa, que palavras lindas, Srta. Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490118
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490118,
					"content": "Talvez isso seja uma pequena quebra da etiqueta de uma festa do chá, mas... Por Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490119
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490119,
					"content": "Haha... À nossa terra natal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
