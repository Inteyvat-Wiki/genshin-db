			"dialogs": [
				{
					"id": 715330101,
					"content": "Hmm, isso não parece certo também... Esses envelopes de presente são bem difíceis de fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330102
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330102,
					"content": "Mika, você tá fazendo envelopes de presente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330103
					]
				},
				{
					"id": 715330103,
					"content": "#{NICKNAME}! Que coincidência! Eu não esperava te ver aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330104
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330104,
					"content": "Você tá aqui para comemorar o Ritual de Lanternas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330105
					]
				},
				{
					"id": 715330105,
					"content": "Ah, não, não. Eu vim entregar uma carta e, por acaso, o Ritual de Lanternas está acontecendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330106
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330106,
					"content": "Klee disse que ela queria muito um envelope de presente do Ritual de Lanternas, então pensei em comprar um e levar de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330107
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330107,
					"content": "Imagine minha surpresa quando descobri que você mesmo tem que fazer o envelope...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330108
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330108,
					"content": "Eu passei muito tempo tentando fazer um, mas ainda parece \"errado\" por algum motivo. Não sei dizer onde errei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330109
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330109,
					"content": "#{NICKNAME}, você sabe mais sobre os costumes de Liyue do que eu... Será que poderia me ajudar em como melhorar o envelope?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330110
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330110,
					"content": "Hmm, me deixa pensar um instante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
