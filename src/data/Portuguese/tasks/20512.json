				"points": []
			},
			"dialogs": [
				{
					"id": 205120101,
					"content": "Essa receita só continua ficando mais estranha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120102,
					"content": "Como a Anna está?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120103
					]
				},
				{
					"id": 205120103,
					"content": "Oh, é você, Bem, pode parecer difícil de acreditar, mas a Anna diz que ela está se sentindo muito melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120104,
					"content": "Talvez a receita do médico realmente funcionou? Eu mal consigo acreditar nisto eu mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120105,
					"content": "Bem, independentemente de ser verdade ou não, é melhor continuarmos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120106,
					"content": "A receita dessa vez é... Hm. Você poderia me ajudar a achar a \"condensação espessa de um Slime Hydro\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120107,
						205120112,
						205120117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120107,
					"content": "Bem, essa parece normal o suficiente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120108
					]
				},
				{
					"id": 205120108,
					"content": "Hm, sério? Eu, na verdade acredito que o oposto seja verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120109,
					"content": "Mas pelo menos é fácil de achar. Perguntei por aí, e dizem que você pode conseguir a Condensação Espessa de um Slime Hydro apenas derrotando Slimes Gigantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120110,
					"content": "Ouvi o Jack falar que você pode chamar a atenção de Slimes Gigantes apenas derrotando várias vezes os slimes pequenos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120111,
					"content": "Eu não tenho este tipo de habilidade em combate, então estou contando com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120112,
					"content": "Não se preocupe, este parece ser comestível.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120113
					]
				},
				{
					"id": 205120113,
					"content": "E como você pode saber disso? Você já provou antes? ... Hm, por que você não está dizendo nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120114,
					"content": "Tanto faz. Slimes Hydro devem ser bem fáceis de achar. Perguntei por aí e os outros dizem que você pode conseguir a Condensação Espessa derrotando Slimes Gigantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120115,
					"content": "Ouvi o Jack falar que você pode chamar a atenção de Slimes Gigantes apenas derrotando várias vezes os slimes pequenos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120116,
					"content": "Eu não tenho este tipo de habilidade em combate, então estou contando com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120117,
					"content": "Eu sei onde encontrar alguns!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120118
					]
				},
				{
					"id": 205120118,
					"content": "Bem, isso é bom. Parece que você sabe muito bem como lidar com Slimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120119,
					"content": "Obrigado por aceitar ajudar. Você deve conseguir achar Condensação Espessa só derrotando Slimes Gigantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120120,
					"content": "Ouvi o Jack falar que você pode chamar a atenção de Slimes Gigantes apenas derrotando várias vezes os slimes pequenos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120121
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120121,
					"content": "Então, boa sorte para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
