			"dialogs": [
				{
					"id": 721310101,
					"content": "A lanterna de pedra estranha parece estar emitindo uma energia perturbadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310102
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721310102,
					"content": "Isso aqui é uma... Lanterna de pedra? Por que ela está aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721310103,
					"content": "Ei, alguém escreveu alguma coisa nesta lanterna, vamos dar uma olhada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721310104,
					"content": "\"Colegas trabalhadores, se vocês tem perguntas sobre esse amuleto, vão até a Garganta Musoujin e falem com o Sr. Kaji\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310105
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721310105,
					"content": "A escrita parece recente. Há algumas linhas ásperas embaixo:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310106
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721310106,
					"content": "\"Me desculpe, mas não podemos lhe ajudar. Acabar de receber a ordem evacuar do Comissário de Tenryou ontem\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310107
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721310107,
					"content": "\"Espero poder ver você de novo algum dia e discutir como resolver o problema do Tatarigami\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310108
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721310108,
					"content": "O Sr. Kaji parece se importar com esta lanterna de pedra. Por que não vamos até a Garganta Musoujin e perguntamos a ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
