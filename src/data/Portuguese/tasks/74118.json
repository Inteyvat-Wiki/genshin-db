						"sceneId": 3,
						"position": [
							3517.158,
							421.427,
							4611.459
						],
						"pointId": 5739
					}
				]
			},
			"dialogs": [
				{
					"id": 741180601,
					"content": "...Obrigado, Garde Menthe. Assim que você veio, aquele canalha se virou imediatamente e saiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180602
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180602,
					"content": "Eu estava só fazendo meu trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180603
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180603,
					"content": "Senhor, parece que devemos deixar esta cidade rapidamente e retornar a Petrichor com agilidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180604
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180604,
					"content": "Acredito que eles estão gradualmente perdendo paciência e eles podem... recorrer a medidas drásticas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180605
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180605,
					"content": "Eu levarei essa questão aos meus superiores. Vocês devem ter uma resposta dentro de alguns dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180606
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180606,
					"content": "Idealmente, poderemos atribuir alguns oficiais para escoltá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180607
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180607,
					"content": "Embora tenhamos recursos limitados, e temos o dever de cuidar de assuntos dentro da cidade, então, no máximo, poderemos escoltar vocês parcialmente, e não todo o caminho até Petrichor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180608
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180608,
					"content": "Além disso, antes que saiam, vocês devem ir para algum lugar seguro. Discutir essa questão... pode levar um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180609,
						741180610
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180609,
					"content": "Deixa a escolta comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180611
					]
				},
				{
					"id": 741180611,
					"content": "Muito obrigado. Com você ao nosso lado, eles não ousarão agir tão precipitadamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180612
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180612,
					"content": "Mas Kaia não trabalha com a trupe? Se vocês forem a Petrichor, então ela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180613,
					"content": "Então eu irei com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180614
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180614,
					"content": "O quê?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180615
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180615,
					"content": "Senhorita, estou pedindo com sinceridade, do fundo do meu coração. Por favor, não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180616
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180616,
					"content": "Meu caro Lutong, nem tente me convencer. Eu sou exatamente como seu chefe, sabe. Eu simplesmente não posso ser persuadida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180617
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180617,
					"content": "M-Mas não temos ideia do tipo de perigo que podemos encontrar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180618
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180618,
					"content": "Mais um motivo para eu viajar com vocês! Vocês querem me abandonar como da última vez, deixando nada além de uma composição sem início ou fim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180619
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180619,
					"content": "E também, o mestre de nossa trupe está bastante interessado na música gerada por seus números.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180620
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180620,
					"content": "Acredito que ele certamente apoiaria que eu fosse com vocês. Muito bem, falei o que queria. Para onde vamos agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180621
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180621,
					"content": "E-Exatamente como em Sumeru, Kaia completamente obliterou Garcia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180622,
					"content": "Garcia não tem a menor chance contra ela...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180623
					]
				},
				{
					"id": 741180623,
					"content": "Talvez seja porque o Sr. Garcia nem quer ganhar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180624
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180624,
					"content": "*Cof cof* Lutong! Vamos nos apressar, precisamos encontrar um lugar adequado para ficar! De preferência, algum lugar com muitas pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180625
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180625,
					"content": "Algum lugar com muitas pessoas... Talvez possamos ir para...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180626
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180626,
					"content": "Por que não o hotel onde nossa trupe está hospedada? É bastante cheio e todos nós nos conhecemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180627
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180627,
					"content": "Se qualquer estranho tentar se infiltrar entre nós, será imediatamente descoberto. Também, o mestre de nossa trupe certamente irá querer aprender mais sobre sua Aritmeticadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180628
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180628,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180629
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180629,
					"content": "Então está definido! Excelente, todos os nossos problemas foram solucionados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180630
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180630,
					"content": "Todos os nossos problemas?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180631
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180631,
					"content": "#Então está decidido. {NICKNAME}, por favor, aceite isso. Considere como depósito para sues serviços em nos escoltar até nosso destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180632
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180632,
					"content": "Embora não saibamos quando poderemos partir, quando chegar a hora, confiaremos em você para cuidar de tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180633
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180633,
					"content": "Mas por que sinto que temos ainda mais problemas do que antes?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180610,
					"content": "Eu posso proteger eles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180611
					]
				}
			]
		},
