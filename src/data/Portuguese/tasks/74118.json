					}
				]
			},
			"dialogs": [
				{
					"id": 741180201,
					"content": "Embora deva ser dito, esta casa de ópera é magnífica. Deve ganhar bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180202
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180202,
					"content": "A casa de ópera... *Suspiro* Vamos entrar e começar o trabalho. Quando a gente terminar, vamos voltar à Vila Petrichor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180203
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180203,
					"content": "E então eu vou abrir uma padaria lá e nunca mais tocarei em uma Aritmeticadora de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180204
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180204,
					"content": "Uh... Senhor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180205
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180205,
					"content": "O que há, Lutong? Sua expressão... você parece ter visto um fantasma ou uma criatura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180206
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180206,
					"content": "É realmente tão... assustadora quanto um fantasma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180207
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180207,
					"content": "Garcia...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180208
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180208,
					"content": "Srta. Kaia?! O que ela está fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180209,
					"content": "Oh, nossa, mas que coincidência...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180210
					]
				},
				{
					"id": 741180210,
					"content": "Senhor, o que você disse agora não foi muito educado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180211
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180211,
					"content": "Oh, cale-se, Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180212
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180212,
					"content": "#Garcia. Que prazer ver você aqui, e você também, {NICKNAME}. Deixe-me adivinhar, vocês estão aqui para ajudar a casa de ópera a liquidar as contas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180213
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180213,
					"content": "Será que a conta que ele vai liquidar vai ser...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180214
					]
				},
				{
					"id": 741180214,
					"content": "Claro que não! Nossa trupe não teve uma apresentação aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180215
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180215,
					"content": "Mas do que eu conheço de Garcia, ele não é do tipo de pessoa que frequenta a ópera durante seu tempo livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180216
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180216,
					"content": "Então, a única razão que ele viria à casa de ópera seria... por que ele foi contratado para trabalhar aqui, não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180217
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180217,
					"content": "Do fundo do meu coração, sinto que você é mais adequada para acompanhar este cavalheiro do que eu, Srta. Kaia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180218
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180218,
					"content": "Cada um de nós é insubstituível, meu caro Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180219
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180219,
					"content": "Eu... uh... Kaia, estou feliz em te ver, eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180220
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180220,
					"content": "...Mas você certamente não parece tão feliz, parece? Sua pesquisa não aconteceu tranquilamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180221
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180221,
					"content": "Uau, como você conseguiu adivinhar isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180222
					]
				},
				{
					"id": 741180222,
					"content": "Bem, ele certamente não estaria infeliz de me ver, ou por causa de você ou Lutong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180223
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180223,
					"content": "Na vida dele, a única coisa que pode o fazer infeliz é aquela Aritmeticadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180224
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180224,
					"content": "Uau, como você conhece Garcia tão bem? Vocês ficaram separados por tanto tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180225,
						741180226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180225,
					"content": "Talvez seja a intuição dela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				},
				{
					"id": 741180227,
					"content": "Talvez vocês devessem ir a um café. Podemos sentar e ter uma boa conversa. Isso não é algo que possa ser explicado apenas em algumas palavras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180228
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180228,
					"content": "Eu ainda tenho que... Hm, não, estou muito contente, mas nós...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180229
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180229,
					"content": "Relaxe, senhor. Aqueles cálculos são bem simples. Eu posso lidar com tudo sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180230
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180230,
					"content": "...Afinal, você não pode deixar a Srta. Kaia de lado e fazê-la esperar até nosso trabalho terminar, pode?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180231
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180231,
					"content": "Você é mesmo muito gentil, Lutong. Obrigada. Eu trarei uma xícara de café para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180232
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180232,
					"content": "Obrigado, senhorita. Aproveite sua bebida com o Sr. Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180233
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180233,
					"content": "Kaia e Garcia saem juntos...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741180234
					]
				},
				{
					"id": 741180234,
					"content": "Então eles foram tomar um café, desse jeito...? Tudo isso não tinha nada a ver com a gente desde o início!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180235,
						741180236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180235,
					"content": "Nada a ver com a gente mesmo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180237,
					"content": "#Não, {NICKNAME}. O que vem a seguir a comissão de verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180238,
						741180239,
						741180240
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180238,
					"content": "Eu tenho que pegar ingredientes para cozinhar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180241,
					"content": "Muito divertido. Mas não pretendo desperdiçar o seu tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180242
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180242,
					"content": "Sr. Garcia e eu... Nós estamos em perigo no momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180243
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180243,
					"content": "Hã... Hã?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180244,
					"content": "Vamos conversar ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180239,
					"content": "Eu tenho que pegar componentes extras?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180240,
					"content": "Por que não só tiramos uma foto juntos no lugar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180236,
					"content": "Então o que estamos fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180226,
					"content": "Talvez Garcia seja fácil demais de entender.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				}
			]
		},
