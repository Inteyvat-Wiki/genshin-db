				]
			},
			"dialogs": [
				{
					"id": 741180101,
					"content": "...Senhor, talvez devemos ir à Vila Petrichor primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180102,
					"content": "Embora os senhores Xavier e Félix não estejam lá, os senhores Mécantre e Babisse ainda devem estar na vila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180103,
					"content": "Talvez eles possam dar a vocês algumas sugestões ou inspiração. Mesmo no pior dos casos, vocês terão dois receptáculos aos quais podem depositar seus problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180104,
					"content": "Não, meu caro Lutong, não... a pesquisa de Mécantre e Babisse estão queimando brilhantemente, prosseguindo como um incêndio por uma mata seca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180105
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180105,
					"content": "Na última carta deles, e indicaram um figurão esperto do Instituto de Pesquisas de Fontaine chegou em Petrichor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180106,
					"content": "Este Sr. Bossuet é muito inteligente e perceptível, e os ajudou a resolver diversos problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180107,
					"content": "E eu... *suspiro*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180108,
						741180109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180108,
					"content": "Garcia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				},
				{
					"id": 741180110,
					"content": "#Realmente um encontro inesperado, {NICKNAME}. Nós nunca imaginamos que veríamos você em Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180111,
					"content": "Embora... o momento seja... uma grande coincidência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180112,
					"content": "#De fato, uma coincidência... Mas ainda estamos felizes de te ver aqui, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180113,
					"content": "Opa, eles parecem exaustos! Esses círculos pretos ao redor dos olhos... É como se eles não têm nenhuma energia sobrando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180114,
					"content": "O que houve, Garcia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180115
					]
				},
				{
					"id": 741180115,
					"content": "Nós... ugh... a pesquisa dele encontrou alguns... problemas sem precedentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180116
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180116,
					"content": "Mas é uma história muito longa... Agora, estamos planejando ir à Ópera Epiclese para liquidar as contas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180117,
					"content": "Após nosso trabalho estar concluído, nós podemos encontrar um lugar quieto para sentar e ter uma conversa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180118
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180118,
					"content": "Você ainda tem outro trabalho para fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180119
					]
				},
				{
					"id": 741180119,
					"content": "Não pode mesmo ser chamado de trabalho. Só sendo contratado aqui e ali para auxiliar com vários cálculos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180120,
					"content": "A Ópera Epiclese recentemente recebeu várias trupes e precisa conduzir uma contabilização geral urgentemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180121
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180121,
					"content": "Então, para ganhar bastante para voltar a Petrichor, nós... Eu, no lugar do Sr. Garcia, aceitará a comissão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180122
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180122,
					"content": "Ah! É como usar um canhão para explodir um formigueiro! Esses cálculos são tão simples que até uma criança poderia fazê-los. Até sem usar uma Aritmeticadora, eu poderia fazer em uma tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180123
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180123,
					"content": "Então este é um excelente jeito de reunir fundos. Vamos nos apressar e sair, senhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180124
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180124,
					"content": "#Por sinal, {NICKNAME}, poderia te convidar para nos acompanhar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180125
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180125,
					"content": "#Com um{F#a} amig{M#o}{F#a} tão renomada nos acompanhando, talvez não encontraremos nenhum problema desnecessário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180126
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180126,
					"content": "Claro, teremos que fornecer remuneração apropriada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180127,
						741180128
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180127,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180129,
					"content": "Eu não seria tão apressado se fosse você... Hehe. De qualquer forma, devemos seguir nosso caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180128,
					"content": "Nada acontecerá a você na cidade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180109,
					"content": "Você voltou para Fontaine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				}
			]
		},
		{
			"id": 7411802,
