			},
			"dialogs": [
				{
					"id": 760520401,
					"content": "Hm, já senti um cheiro parecido com esse antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520402
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520402,
					"content": "Sério? Onde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520403,
					"content": "No quarto da Sandrone. Ela tinha uma bebida que cheirava assim. O aroma chamou minha atenção e, quando ela percebeu... ela ficou segurando a bebida por um tempão sem terminar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520404
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520404,
					"content": "Era como se... ela estivesse esperando que eu perguntasse sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520405
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520405,
					"content": "E aí... você perguntou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520406
					]
				},
				{
					"id": 760520406,
					"content": "Sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520407
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520407,
					"content": "O que você perguntou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520408,
					"content": "\"Você não deveria estar bebendo óleo de motor em vez disso?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520409
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520409,
					"content": "E... como ela respondeu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520410
					]
				},
				{
					"id": 760520410,
					"content": "Bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520411
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520411,
					"content": "Ela disse algo bem desagradável. Não vale a pena repetir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520412
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520412,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520413
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520413,
					"content": "Você perdeu o interesse depois de um único gole!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520414,
					"content": "Desculpe, estava meio amargo... no geral, não muito bom. Não é de se admirar que a Sandrone tenha feito aquela cara azeda quando bebeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520415
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520415,
					"content": "A Paimon acha que talvez tenham outros motivos pra isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
