			},
			"dialogs": [
				{
					"id": 760520201,
					"content": "Bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520202
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520202,
					"content": "Então, o que você acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520203,
					"content": "Isso me faz lembrar de um tempo muito, muito distante, quando eu vivia com os Filhos da Lua Gelada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520204
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520204,
					"content": "As pessoas costumavam preparar um tipo de chá feito com folhas frescas de menta, especiarias e frutas vermelhas secas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520205
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520205,
					"content": "Sempre que eu passava diante de suas casas, havia um leve aroma herbal escapando pelas janelas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520206
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520206,
					"content": "Você chegou a provar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520207,
					"content": "Eu queria, mas nunca tive a chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520208
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520208,
					"content": "Ah, por que não...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520209,
					"content": "Quando uma \"Deusa\" bate à sua porta e pergunta: \"Posso experimentar o seu chá?\"... Ninguém ousa oferecer o \"chá rústico\" preparado apenas para o próprio consumo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520210
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520210,
					"content": "Ah... É.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520211,
					"content": "O que eu recebi, no fim das contas, foi mais como uma \"oferta\" para o divino, com direito a embalagem ornamentada e tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520212
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520212,
					"content": "Não que tivesse um gosto ruim, por assim dizer... Mas faltava aquele sentimento de... \"lar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520213
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520213,
					"content": "Bem, agora podemos resolver isso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520214
					]
				},
				{
					"id": 760520214,
					"content": "Bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520215
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520215,
					"content": "O sabor é delicioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520216
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520216,
					"content": "...Embora eu deva dizer que a ideia de adicionar leite me pareça nada ortodoxa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520217
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520217,
					"content": "Ah, bem, esta é uma receita de Mondstadt. As pessoas adoram adicionar leite, creme e açúcar ao chá por lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520218,
					"content": "É algo novo... mas de uma forma boa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520219
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520219,
					"content": "Ufa, ainda bem que você gostou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520220,
					"content": "Mm... Obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520221
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520221,
					"content": "Parece que a luz da lua não é o único meio através do qual se pode vislumbrar o passado. Até mesmo algo tão simples quanto o aroma de uma bebida pode trazer de volta memórias há muito esquecidas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				}
			]
		},
		{
			"id": 7608504,
