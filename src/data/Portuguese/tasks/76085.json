			"dialogs": [
				{
					"id": 760520501,
					"content": "Glup... Glup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520502
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520502,
					"content": "Uau, tomou tudo de uma vez! Parece que ela adorou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520503,
					"content": "Hm... completamente sem gosto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520504
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520504,
					"content": "S-s-sem sabor!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520505,
					"content": "Sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520506,
						760520507
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520506,
					"content": "Talvez você tenha bebido rápido demais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				},
				{
					"id": 760520508,
					"content": "Ah... Obrigada, mas não precisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520509
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520509,
					"content": "Houve um tempo em que eu não conseguia entender por que as pessoas sentiam tanta alegria na época da colheita. Então, um dia, estendi a mão para tocar uma fruta madura pendurada em um galho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520510
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520510,
					"content": "Percebi vitalidade na própria textura de sua casca — a encarnação orgânica da luz do sol, da água, da terra e do ar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520511
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520511,
					"content": "A cada mordida, senti uma doçura revigorante me envolver como ondas de espuma branca e fresca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520512
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520512,
					"content": "E foi assim que passei a compreender o poder irresistível do aroma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520513
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520513,
					"content": "Ah, que interessante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520514,
					"content": "Então, completamos o ciclo da natureza ao tomar para nós essa força vital.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520515
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520515,
					"content": "Uh, isso de repente ficou meio sombrio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520516,
					"content": "É por isso que prefiro frutas frescas. Elas me permitem ver o que tirei deste mundo, exatamente como era antes de eu tomar para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520517
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520517,
					"content": "E me lembram do que devo a este mundo em retribuição...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520507,
					"content": "Que tal eu preparar outra pra você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				}
			]
		},
