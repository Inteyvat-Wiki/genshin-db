					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760850602,
					"content": "Essa bebida está deliciosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850603
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760850603,
					"content": "É a minha favorita até agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850604
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760850604,
					"content": "Uau! Finalmente, uma bebida que Columbina gosta! Paimon tá comovida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850605,
					"content": "Hã, desculpe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850606
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760850606,
					"content": "Vamos resumir: nenhum gosto amargo, nunca adicionar suco diretamente, e pode ter leite, mas é melhor sem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850608
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760850608,
					"content": "Então essa é uma bebida leve...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850609
					]
				},
				{
					"id": 760850609,
					"content": "Descobrir o padrão de algo é bom! No futuro, vamos saber como preparar bebidas do jeito que você gosta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850610,
					"content": "...No futuro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850611
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760850611,
					"content": "#Claro, somos {F#suas amigas}{M#seus amigos}! Quando você tiver sede, é só dizer pra gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850612,
					"content": "Espera, é por causa disso que você não terminou sua bebida? Você tá guardando isso por que acha que é a última coisa que vai provar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850613,
					"content": "...Hmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850614
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760850614,
					"content": "Tudo bem, não tem problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850615
					]
				},
				{
					"id": 760850615,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850616
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760850616,
					"content": "Obrigada pela bebida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				}
			]
