			},
			"dialogs": [
				{
					"id": 766530401,
					"content": "Você finalmente chegou. Você não esqueceu dessa oportunidade única de terceirização, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530402
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530402,
					"content": "Espera, qual é o seu pedido mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530403
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530403,
					"content": "Eu sou Gaudenty, um representante externo do Escritório de Design de Experimentos de Kuuvahki. Isso deve bastar para você se lembrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530404
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530404,
					"content": "Falou demais, não ouvi. Me fale qual é o seu pedido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530405
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530405,
					"content": "Você! Tsc, eu vou dizer só mais uma vez. Recentemente, um lote de robôs de reconhecimento descontrolados saiu do Escritório, e é meu trabalho recuperá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530406
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530406,
					"content": "Mas os robôs tendem a voar numa altitude alta, e não posso cuidar deles sozinho. É por isso que ofereci essa oportunidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530407
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530407,
					"content": "Pra falar a verdade, eles podem ser recuperados ou destruídos. Nosso objetivo é só impedir que eles caíam nas mãos de forasteiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530408
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530408,
					"content": "Ah! Esse pedido! Sim, esses robôs de reconhecimento podem voar muito alto, e a maioria das pessoas nem consegue pegar neles. Foi por isso que eu dominei um jeito simples de fazer os Caminhos Lunares chegarem lá em cima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530409
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530409,
					"content": "#{NICKNAME}, você pode fazer os Kuuhenki nos ajudar, né? Vamos testar e ver se eles podem usar os Caminhos Lunares para nos ajudarem a trazer esses robôs pra baixo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530410
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530410,
					"content": "#Sem problema! Deixa com {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530411,
						766530412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530411,
					"content": "Mamão com açúcar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530413
					]
				},
				{
					"id": 766530413,
					"content": "Oh, sim. Não vou pagar com Mora. Você pode ficar com os componentes dos robôs de reconhecimento como pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530414
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530414,
					"content": "Isso foi definido quando eu fiz o pedido. Não quebre sua palavra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530415
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530415,
					"content": "... Você vai dar peças sobressalentes pra gente como pagamento? Você mesmo não acabou de dizer que os robôs não deviam cair nas mãos de forasteiros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530416,
					"content": "É por isso que essa é uma chance rara e valiosa para vocês! Se tudo correr bem, não me importo em fazer vista grossa ao seu trabalho duro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530417
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530417,
					"content": "Que estranho. Parece como se ele só não quisesse pagar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530418,
					"content": "Bem, com ou sem Mora, não importa pra mim. Eu quero essas peças. E estou pensando em usar elas para meus projetos futuros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530419
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530419,
					"content": "Bem, já que você não se importa, Aino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530412,
					"content": "Parece meio complicado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530413
					]
				}
			]
		}
	]
