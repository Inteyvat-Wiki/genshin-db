			"dialogs": [
				{
					"id": 6050201,
					"content": "Trabalho fantástico na defesa, pessoal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050202
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 6050202,
					"content": "Pode deixar o resto conosco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050203
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 6050203,
					"content": "Capitão Kaeya, Swan está—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050204
					],
					"speakerTitle": "Lawrence"
				},
				{
					"id": 6050204,
					"content": "Ei! Eu estou bem. É com sua perna que devíamos estar nos preocupando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050205
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 6050205,
					"content": "Swan, Lawrence, vocês têm que ir receber tratamento na Igreja. Não se forcem. Vamos cuidar das coisas aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050206
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 6050206,
					"content": "Mas, Mestre Diluc... Você não deixou os Cavaleiros de Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050207
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 6050207,
					"content": "O que foi, só Cavaleiros conseguem proteger esse portão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 6050208,
					"content": "Está tudo bem. O Mestre Diluc só está... altruísta como sempre. Se um civil está disposto a ajudar, quem somos nós para recusar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050209
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 6050209,
					"content": "...Entendido. Somos gratos pelo apoio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050210
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 6050210,
					"content": "É, obrigado mesmo! Voltaremos logo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050211
					],
					"speakerTitle": "Lawrence"
				},
				{
					"id": 6051104,
					"content": "Tenho algum tempo sobrando agora, então estava planejando fazer algumas poções para ajudar as pessoas lutando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051105
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 6051105,
					"content": "Um bom plano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6051106,
					"content": "Lembre-se de ter cuidado. Eu sei que é improvável, mas se você encontrar uma situação que não conseguir lidar, retire-se imediatamente para um lugar seguro. Não se preocupe com a linha de frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6051107,
					"content": "Entendido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sucrose"
				}
			]
		},
