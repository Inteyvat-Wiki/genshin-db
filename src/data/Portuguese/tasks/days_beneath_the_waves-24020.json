	"talks": [
		{
			"id": 2402001,
			"completionStepIds": [
				2402001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402001",
							"2"
						],
						"stepId": 2402001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200101,
					"content": "Que azar! Nunca mais vou para debaixo d'água!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200102,
						240200103
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				},
				{
					"id": 240200104,
					"content": "Ah, é você. Realmente é muito bom te ver! Eu... eu quase perdi a vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200105
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200105,
					"content": "Eu estava trabalhando debaixo d'água, como normalmente faço. Mergulhei, esquivei das algas, do lixo e não levei nenhum arranhão nem me furei com nenhum objeto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200106
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200106,
					"content": "Mas assim que eu estava levando as coisas, um grupo de monstros do nada emergiu da lama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200107
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200107,
					"content": "Não consigo me lembrar que criaturas eles eram, só que vieram partindo pro ataque na minha direção. Eu tive que sair correndo e nadando contra a corrente com toda a minha força.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200108
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200108,
					"content": "Mas não muito depois, acabei me deparando com um cardume de peixes mecânicos estranhos, e eles também me atacaram assim que me viram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200109
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200109,
					"content": "Eu não sei como cheguei numa margem, e sem me ferir também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200110,
						240200111
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200110,
					"content": "É muito perigoso, você não deveria mergulhar aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200112,
					"content": "Mas eu não posso! Goldman designou esse lugar... muitas pessoas foram feridas aqui, e outras até mesmo morreram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200113
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200113,
					"content": "Com o tempo, até mesmo as ameaças e pagamentos dele não conseguiam convencer mais ninguém a fazerem o resgate aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200114
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200114,
					"content": "Por isso ele mudou de estratégia por um tempo, alegando que estaria disposto a pagar três vezes a quantidade de Mora para qualquer um vir aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200115
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200115,
					"content": "Por isso... eu e alguns amigos que precisavam de dinheiro aceitamos a oferta, a gente até comprou algumas lanças de pesca para nos defendermos debaixo d'água.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200116
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200116,
					"content": "Mas elas quebraram ou se perderam só com alguns dias... os outros voltaram para a cidade para comprarem outro lote, enquanto eu fiquei aqui protegendo o lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200117,
						240200118
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200117,
					"content": "Então por que você acabou de mergulhar na água?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200119,
					"content": "Eles foram embora há muito tempo! Se não começarmos agora, eu não faço ideia até que horas vou ter que trabalhar hoje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200120
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200120,
					"content": "Deixe eu te ajudar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200121
					]
				},
				{
					"id": 240200121,
					"content": "Não, isso não vai bastar! São monstros de verdade, eles vão ser um desafio! Aventureiros normais não conseguem lidar com eles, não posso deixar você fazer isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200122,
						240200123
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200122,
					"content": "#Eu não sou um{F#a} aventureir{M#o}{F#a} qualquer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200124,
					"content": "Bem, não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200125
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200125,
					"content": "Certo, já que você está insistindo, vou marcar os locais para você, mas lembre-se de ter cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200123,
					"content": "#Eu por acaso tenho cara de um{F#a} aventureir{M#o}{F#a} fracote?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200118,
					"content": "Você entrou na água sem nada para se defender?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200111,
					"content": "É muito perigoso. Talvez devêssemos ir para outro lugar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200103,
					"content": "O que você viu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				}
			]
		},
		{
			"id": 2402002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
