					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200201,
					"content": "Você me ajudou a recuperar essas coisas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				}
			]
		},
		{
			"id": 2402003,
			"completionStepIds": [
				2402005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402005",
							"2"
						],
						"stepId": 2402005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200301,
					"content": "Isso mesmo, isso é o que pegamos todos os dias. É apenas lixo, lixo e mais lixo — talvez aquele patife mesquinho do Goldman coma essas coisas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200302
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200302,
					"content": "Obrigado pela sua ajuda. Esse é o pagamento que recebi adiantado do Goldman — por favor, aceite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200303
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200303,
					"content": "Eu não posso aceitar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200304
					]
				},
				{
					"id": 240200304,
					"content": "Mas você precisa — é o seu pagamento pelo *seu* trabalho. Não pertence mais a mim... e se você não pegar, eu vou apenas jogar a bolsa de moedas na água.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200305
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200305,
					"content": "Tá bom, tá bom...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200306
					]
				},
				{
					"id": 240200306,
					"content": "Isso mesmo! Se você precisar que algo seja recuperado no futuro, venha me procurar — eu vou pegar tudo para você, não importa o que seja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200307
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200307,
					"content": "Preciso descansar mais um pouco... *Suspiro*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				}
			]
		},
		{
			"id": 2402004,
			"completionStepIds": [
				2402006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402006",
							"2"
						],
						"stepId": 2402006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200401,
					"content": "Isso são... o que são todas essas bugingangas? Isso são realmente as coisas que o Goldman quer que recuperemos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200402
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200402,
					"content": "Muito obrigado pela sua ajuda! Aqui... fique com essa Mora, e não conte a ninguém sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200403
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200403,
					"content": "Se eu puder vender isso, eu poderei comprar uma roupa de mergulho para mim. Assim não precisaria mais alugar uma do Goldman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200404,
						240200405
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200404,
					"content": "Eu não posso aceitar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200406
					]
				},
				{
					"id": 240200406,
					"content": "Não, não! Esse é o pagamento que você merece — essa Mora certamente não cobre todo o esforço que você fez! Porém, isso é tudo que eu tenho. Eu estava planejando comprar um pouquinho de bebida com ela hoje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200407
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200407,
					"content": "Então, por favor, pegue. Irei cuidar de algumas coisas, então vou pensar em como... você sabe, vender isso às escondidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200405,
					"content": "Minha boca é um túmulo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200406
					]
				}
			]
		},
		{
			"id": 2402005,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402002",
							"2"
						],
						"stepId": 2402002,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402003",
							"2"
						],
						"stepId": 2402003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200501,
					"content": "Pah, aquele malandro mesquinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200502,
						240200508,
						240200512
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200502,
					"content": "Você poderia me falar sobre Goldman novamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200503
					]
				},
				{
					"id": 240200503,
					"content": "Ele é meu chefe — um verdadeiro especialista em contratar pessoas como eu, sem habilidades, mas com força de sobra para fazer o que for preciso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200504
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200504,
					"content": "Um verdadeiro desmiolado, e também é bem severo e mesquinho! Ele insiste que sigamos aquele enorme e grosso manual durante o trabalho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200514
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200514,
					"content": "Além disso, até mesmo as roupas de mergulho que usamos no trabalho, ele \"aluga\" para nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200505
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200505,
					"content": "Se violarmos essas estipulações ou nossas roupas de mergulho ficarem danificadas, temos que pagar a ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200515
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200515,
					"content": "Em outras palavras, se eu for descuidado no trabalho, nem que seja uma vez, eu não apenas terei que pagar uma taxa a ele, mas terei que me ajoelhar e implorar que ele me mantenha na equipe! Pah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200506
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200506,
					"content": "Mas para que você quer saber mais sobre ele? Estou te implorando, fique longe dele — mesmo que seja pelo bem da sua própria reputação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200516
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200516,
					"content": "Sem vergonha, é o que ele é, e ele se envolve com outros iguais a ele. Tudo gente ruim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200507
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200507,
					"content": "Não se relacione com esse sujeito — você não conseguiria limpar aquela lama impura de suas mãos, nem mesmo com uma torre inteira de água pura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200517
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200517,
					"content": "Mas veja, não precisa de muito esforço para sujar um lago limpo usando lama suja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200508,
					"content": "Você faz uns trabalhos bem pesados...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200509
					]
				},
				{
					"id": 240200509,
					"content": "Hah, você tem toda razão. Mas essa é a única forma que eu consigo ganhar a vida. Não sou esperto e não tenho nenhuma outra habilidade, mas também não vou me tornar um criminoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200518
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200518,
					"content": "Se eu preciso ser ruim para conseguir o que comer, eu prefiro passar fome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200510
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200510,
					"content": "Meu trabalho é difícil, sim, mas consigo fechar meus olhos em paz à noite. Não preciso ter medo de que alguém me odeia ou vá me apunhalar enquanto durmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200511
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200511,
					"content": "Nesse sentido, vivo minha vida bem melhor do que o Goldman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200512,
					"content": "Até mais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200513
					]
				},
				{
					"id": 240200513,
					"content": "#Bem, conto com você, amig{M#o}{F#a}. Eu preciso recuperar o fôlego...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				}
			]
		},
		{
			"id": 2402006,
			"completionStepIds": [
				2402001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402001",
							"2"
						],
						"stepId": 2402001,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"2401701",
							"2"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200601,
					"content": "Arg, que azar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200602
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200602,
					"content": "Você conseguiu vender as coisas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200603
					]
				},
				{
					"id": 240200603,
					"content": "Ah, é você. Urg, esqueça. E eu acabei de encontrar um comprador, e foi bem quando Goldman entrou na minha casa e levou a caixa de bugigangas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200604
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200604,
					"content": "Se ele ainda não precisasse de mim para trabalhar para ele, eu teria levado uma bela surra... mas ele deduziu dois meses do meu salário...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200616
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200616,
					"content": "Ele quer me pagar apenas depois que eu tiver terminado um ano inteiro de trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200605
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200605,
					"content": "*Suspira* Esqueça. A sorte não sorri para idiotas como eu... espera. Goldman não bateu na sua porta, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200606,
						240200609
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200606,
					"content": "Não.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200607
					]
				},
				{
					"id": 240200607,
					"content": "Então, ótimo. Eu levar uma surra? Tudo ótimo. Mas eu jamais iria querer problema com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200608
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200608,
					"content": "Eu não contei a ele sobre seu trabalho de recuperar as coisas, mas eu suspeito que outra pessoa tenha descoberto e dito a ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200611
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200611,
					"content": "Mesmo assim, precisarei da sua ajuda hoje de novo. Minha roupa de mergulho ainda não foi arrumada, mas Goldman tem me forçado a compensar os dias que não consegui terminar o trabalho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200612
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200612,
					"content": "Não tive escolha se não pegar a roupa de mergulho de alguém emprestado, mas mesmo assim, não consegui terminar meu trabalho rápido o suficiente... infelizmente vou depender da sua bondade novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200613,
						240200614
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200613,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200615
					]
				},
				{
					"id": 240200615,
					"content": "Obrigado. Marcarei a localização dos objetos para você — vamos nos dividir e procurar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200614,
					"content": "Permita-me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200615
					]
				},
				{
					"id": 240200609,
					"content": "Se ele tivesse vindo até mim, eu teria uma lição a dar a ele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200610
					]
				},
				{
					"id": 240200610,
					"content": "#Por favor, não se envolva com aquele nojento sem vergonha! Alguém tão honros{M#o}{F#a} quanto você não deveria nem se envolver com alguém como ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200611
					],
					"speakerTitle": "Yves"
				}
			]
		}
	]
}