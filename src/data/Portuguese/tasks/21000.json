			},
			"dialogs": [
				{
					"id": 210000301,
					"content": "Mas que... E imaginar que essas coisas existem... Isso foi assustador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000302
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000302,
					"content": "Muito obrigado! Vamos lá, vamos continuar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000303
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000303,
					"content": "...Espere. Onde foi parar minha garrafa? Eu estava segurando ela agora pouco, mas agora sumiu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000304
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000304,
					"content": "Será que eu derrubei enquanto a gente lutava com aquela... aquela Flor Gigante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000305
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000305,
					"content": "Por favor, me ajude a encontrá-la!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeno Meng"
				}
			]
		},
