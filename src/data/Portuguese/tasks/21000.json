				{
					"id": 210000201,
					"content": "Já estamos chegando no Rio Bishui? Hã~ Vamos escolher um bom lugar para colocar a garrafa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000202
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000202,
					"content": "Precisamos encontrar uma posição a favor da corrente se quisermos que ela vá longe...",
