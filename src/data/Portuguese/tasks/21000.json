				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210000501,
					"content": "Ufa... Fiquei a noite toda acordado escrevendo essa mensagem. Se eu tivesse perdido a garrafa, teria que escrever tudo de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000502
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000502,
					"content": "Uau, a noite toda? Você realmente tem várias preocupações, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000503
					],
					"speakerTitle": "Paimon"
				},
