			},
			"dialogs": [
				{
					"id": 210000101,
					"content": "*Suspiro* Será que eu realmente posso fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000102
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000102,
					"content": "Pequeno Meng, o que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000103
					]
				},
				{
					"id": 210000103,
					"content": "#{F#Irmãzona}{M#Irmãozão}, {NICKNAME}, olá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000104
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000104,
					"content": "Pequeno Meng, por que você não está feliz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000105,
					"content": "O que houve? Eles não queriam brincar aquele jogo de piratas com você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000106,
					"content": "Não é isso. Lulu e Fei voltaram para casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000107
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000107,
					"content": "Eu... eu gostaria de dar mais uma volta, então ainda não voltei para casa por enquanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000108
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000108,
					"content": "Os seus pais não ficam preocupados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000109,
					"content": "Os meus pais ainda devem estar trabalhando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000110
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000110,
					"content": "#Esquece, {NICKNAME}, posso te fazer uma pergunta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000111,
						210000112
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000111,
					"content": "Que pergunta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000114
					]
				},
				{
					"id": 210000114,
					"content": "#{NICKNAME}, ouvi muitas pessoas falarem de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000115
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000115,
					"content": "Você já foi a muitos lugares e passou por muitas coisas... Talvez você possa me dizer a resposta a esta pergunta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000116
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000116,
					"content": "Uau... por que o Pequeno Meng ficou tão sério de repente? O que houve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000117,
					"content": "#{F#Irmãzona}{M#Irmãozão}, {NICKNAME}, eu gostaria de te perguntar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000118
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000118,
					"content": "Como que uma pessoa pode amadurecer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000119,
						210000122
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000119,
					"content": "Isso leva tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000120
					]
				},
				{
					"id": 210000120,
					"content": "Então você está dizendo que as pessoas amadurecem naturalmente conforme elas crescem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000121
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000121,
					"content": "Mas não seria tarde demais se a gente só amadurecesse quando crescesse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000124,
					"content": "Se você quiser dar uma olhada fora da cidade, a Paimon pode fazer companhia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000125,
					"content": "Isso é... eu não quero incomodá-la. E duvido que algo especial cairia no meu colo só porque saí da cidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000126
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000126,
					"content": "Ao invés disso, eu gostaria da sua ajuda com outra coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000127
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000127,
					"content": "Ouvi dizer que se você tiver algumas preocupações das quais você não tem como se livrar, pode escrever suas preocupações em um papel e colocá-lo em uma garrafa e elas vão longe junto com a corrente de água do rio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000128
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000128,
					"content": "Dessa forma, talvez consiga me livrar das minhas preocupações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000129
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000129,
					"content": "Mas eu também ouvi dizer que lá fora há muitos monstros, não é muito seguro ir lá sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000130
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000130,
					"content": "Por isso, gostaria que você me protegesse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000131,
						210000132
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000131,
					"content": "Não tem problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000133,
					"content": "#Obrigado, {NICKNAME}, lhe pagarei com o dinheiro que ganhei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000134
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000134,
					"content": "Então vamos lá! Vamos dar uma olhada no Rio Bishui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000132,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000122,
					"content": "É preciso passar por algo especial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000123
					]
				},
				{
					"id": 210000123,
					"content": "Passar por algo especial? Mas por enquanto eu nem saí do Porto de Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210000112,
					"content": "Eu não tenho tempo para brincar com você agora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000113
					]
				},
				{
					"id": 210000113,
					"content": "Haha... Eu fui jogar aquele jogo por causa de Lulu e Fei. Quando eles não estão, não tenho como brincar dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000114
					],
					"speakerTitle": "Pequeno Meng"
				}
			]
		},
