			"dialogs": [
				{
					"id": 200050101,
					"content": "Viajante! Você chegou na hora certa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200050102
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200050102,
					"content": "Na última noite, eu estava no caminho à cidade para levar estas mercadorias quando alguns orbes brilhantes chamaram minha atenção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200050103
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200050103,
					"content": "Eu tinha bebido um pouco demais... Fiquei com vontade de ver o que era e descobri que era um grupo de slimes e acabei sendo atacado por eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200050104
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200050104,
					"content": "Eu entrei em pânico e fugi, mas me perdi no caminho. Demorei muito tempo para achar o carrinho de novo. Então, nesta manhã, eu percebi que minha <color=#00E1FFFF>chave</color> tinha desparecido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200050105
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200050105,
					"content": "Você poderia me ajudar a procurar? Deve estar em algum lugar... Sinto que está por perto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200050106,
						200050108
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200050106,
					"content": "Tudo bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200050107
					]
				},
				{
					"id": 200050107,
					"content": "Ótimo! É uma área enorme, não sei nem por onde começar a procurar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200050108,
					"content": "Eu tenho algumas outras coisas mais importantes para fazer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200050109
					]
				},
				{
					"id": 200050109,
					"content": "É uma área enorme, não sei nem por onde começara a procurar. Por favor, você é o único que pode me ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wyatt"
				}
			]
