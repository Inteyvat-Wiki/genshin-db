			"dialogs": [
				{
					"id": 730240101,
					"content": "Oh, você ajudou bastante! Obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240102
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240102,
					"content": "Como você pode ver, eu sou a Patrulheira Florestal daqui. E quanto ao meu nome, é Rana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240103,
						730240105
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240103,
					"content": "#Eu sou {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240104
					]
				},
				{
					"id": 730240104,
					"content": "E o nome da Paimon é Paimon! Somos de outra nação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240107,
					"content": "Oh, entendo. Hmm... Vocês não se vestem como o povo da floresta, e nem parecem que são do deserto, mas suas roupas permitem transpiração, e são boas para viajar em Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240108
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240108,
					"content": "Hã? Falando nisso, já que Rana é uma Patrulheira Florestal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240109,
						730240123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240109,
					"content": "Você deve conhecer Tighnari, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240110
					]
				},
				{
					"id": 730240110,
					"content": "#Oooh! {NICKNAME}, você também conhece Tighnari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240111
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240111,
					"content": "Tighnari pode parecer inacessível, mas, na verdade ele é uma pessoa muito legal. Ele cuidou muito bem de mim quando eu estava treinando, e suas orelhas são lindas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240112
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240112,
					"content": "Sim! Paimon realmente queria tocá-las...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240113,
						730240116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240113,
					"content": "Na verdade, eu também...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240114
					]
				},
				{
					"id": 730240114,
					"content": "Hmm... Paimon se pergunta se voar sorrateiramente ao lado dele funcionará...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240115,
					"content": "Hahaha! Tighnari ficará com raiva se você fizer isso sem perguntar antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240118
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240118,
					"content": "Não é? Elas parecem tão brilhantes. Me pergunto qual é a sensação de tocá-las. A criança que está com ele provavelmente está bem interessada também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240119
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240119,
					"content": "Hã? Rana, você está falando de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240120,
					"content": "De Collei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240121
					]
				},
				{
					"id": 730240121,
					"content": "#Hã? {NICKNAME}, você também conhece Collei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240122
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240122,
					"content": "Collei não tem estado muito bem. Mesmo assim, ela trabalha duro para proteger a floresta e eliminar o Definhamento. Todos estão preocupados com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240141
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240141,
					"content": "Ahem! Enfim, o dever de uma Patrulheira Florestal é proteger a floresta, ajudar viajantes, e ser um guia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240142
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240142,
					"content": "#Como {NICKNAME} e Paimon viram, ultimamente a floresta tem estado... Menos que o ideal? Os cogumelos e bestas estão mais agressivos, e há o Definhamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240143
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240143,
					"content": "#Que tal eu escoltar vocês {F#duas}{M#dois}? A próxima parada da minha rota de patrulha é a Vila Vimara. De lá, ir até o Porto Ormos ou Cidade de Sumeru é muito fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240144,
						730240146
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240144,
					"content": "Claro, vamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240145
					]
				},
				{
					"id": 730240145,
					"content": "Certo, manterei vocês em segurança!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240146,
					"content": "Certo, mas eu tenho algumas coisas para fazer antes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240147
					]
				},
				{
					"id": 730240147,
					"content": "Oh, entendo. Esperarei aqui por vocês. Tenham cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240116,
					"content": "Paimon pode fazer super furtivamente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240117
					]
				},
				{
					"id": 730240117,
					"content": "Ei! Isso não irritará Tighnari, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240123,
					"content": "Talvez conheça a Collei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240124
					]
				},
				{
					"id": 730240124,
					"content": "#Hã? {NICKNAME}, você conhece essa garota?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240125
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240125,
					"content": "Collei não tem estado muito bem. Mesmo assim, ela trabalha duro para proteger a floresta e eliminar o Definhamento. Todos estão preocupados com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240126
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240126,
					"content": "Mas ela está com aquele cara com orelhas bonitas, então ela deve estar bem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240127
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240127,
					"content": "Hã? Orelhas... Você está falando sobre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240128,
						730240138
					],
					"speakerTitle": "Paimon"
				},
