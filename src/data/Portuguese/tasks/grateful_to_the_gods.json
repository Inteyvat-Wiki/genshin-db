					"content": "Você terminou de limpar as Estátuas dos Sete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380302
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380302,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380303
					]
				},
				{
					"id": 200380303,
					"content": "Só tenho a agradecer você! Que Barbatos proteja você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380304
					],
					"speakerTitle": "Jilliana"
				},
				{
