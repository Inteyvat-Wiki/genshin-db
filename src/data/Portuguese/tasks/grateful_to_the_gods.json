				"objectNames": [
					"Jilliana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200380101,
					"content": "*Suspiro* Fico me perguntando como devem estar as Estátuas dos Sete neste momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380102
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380102,
					"content": "As Estátuas dos Sete? O que aconteceu com elas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380103
					]
				},
				{
					"id": 200380103,
					"content": "Deixe-me explicar... No passado, eu ia para lá e rezava para a Estátua dos Sete toda semana e aproveitava também para limpar a poeira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380104
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380104,
					"content": "Tenho que agradecer os Arcontes por todas as bênçãos em minha vida, limpar suas estátuas era a minha forma de retribuição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380105
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380105,
					"content": "Mas, desde que eu tive a Lily, eu não tive mais oportunidades de sair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380106
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380106,
					"content": "As estátuas devem estar muito sujas, já que ninguém as limpa faz muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380107
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380107,
					"content": "Eu sei que isso deve parecer que estou tentando evitar assumir a responsabilidade, mas... Será que você acha que poderia tirar a poeira das Estátuas dos Sete para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380109,
						200380110
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380109,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380111
					]
				},
				{
					"id": 200380111,
					"content": "Muito obrigada! Que o Arconte Anemo o proteja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380115,
					"content": "Mais uma coisa. As Estátuas dos Sete estão imbuídas com o poder dos Arcontes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380116
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380116,
					"content": "O pó que eles acumulam não pode ser simplesmente removido da maneira usual...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380117
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380117,
					"content": "Mas você tem habilidades elementais, deve ser fácil para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380118
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380118,
					"content": "Diferente de mim, é um trabalho e tanto limpar uma única estátua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380110,
					"content": "Deixe que o próprio vento limpe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380112
					]
				},
				{
					"id": 200380112,
					"content": "Barbatos e os ventos que governam possuem muitas outras coisas mais importantes para lidar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380113
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380113,
					"content": "De qualquer forma, não podemos depender dos Arcontes para tudo quando temos preguiça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380114
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380114,
					"content": "Por favor, trabalhe comigo para aliviar um pouco a carga de Barbatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "Jilliana"
				}
			]
		},
