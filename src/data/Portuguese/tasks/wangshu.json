						10039303
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039303,
					"content": "Não se deixe desviar pelo sorriso atrevido em seu rosto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
