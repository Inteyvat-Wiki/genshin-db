					"nextDialogs": [
						10039402
					]
				},
				{
					"id": 10039402,
					"content": "O meu nome é Goldet, sou de Mondstadt. Eu sou a dona do Albergue Wangshu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039403
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039403,
					"content": "Não pense que sou a esposa do chefe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039404
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039404,
					"content": "Eu sou a CHEFE, em maiúsculo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039405,
						10039410
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039405,
					"content": "Eu ouvi alguns rumores...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039406
					]
				},
				{
					"id": 10039406,
					"content": "Hahaha, bem, eu dificilmente seria capaz de operar um Albergue neste local sem conexões com os Qixing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039407
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039407,
					"content": "Me refiro que obviamente preciso de aprovação deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039408
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039408,
					"content": "Todos esses outros absurdos são apenas rumores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039409
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039409,
					"content": "Falando nisso, você conseguiu alguma informação interessante para compartilhar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039410,
					"content": "De quem é esse gatinho?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039411
					]
				},
				{
					"id": 10039411,
					"content": "*Suspiro*... Este gato se convidou aqui... Mas é fofo, então eu o deixei ficar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039412
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039412,
					"content": "Se chama Wei. Esse foi o primeiro nome que nos veio em mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039413
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039413,
					"content": "O meu gatinho talvez seja um pouco irritante - você sabe como são os gatos, não leve a sério por favor.",
