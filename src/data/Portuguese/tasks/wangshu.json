			},
			"dialogs": [
				{
					"id": 10030601,
					"content": "Você não vê que estou descansando? Não me incomode.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030602
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 10030602,
					"content": "Com licença, também gostaríamos de uma amêndoa para...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030603
					]
				},
				{
					"id": 10030603,
					"content": "Por favor, não incomode.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030604
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 10030604,
					"content": "O serviço deste cozinheiro é mesmo que o ferreiro Wagner de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030605,
					"content": "Foi a chefe Goldet que pediu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030606
					]
				},
				{
					"id": 10030606,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030607
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 10030607,
					"content": "Certo, entendi. Se for para a chefe, então acho que não tenho escolha agora, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030608
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 10030608,
					"content": "Mas agora não tenho forças para fazer um prato tão elaborado quanto o Tofu de Amêndoas. É uma pena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030609
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 10030609,
					"content": "E por que isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030610,
					"content": "A mão de esgrimista tem que ser estável, para a mão de um cozinheiro, é mesma coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030611
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 10030611,
					"content": "Mas minhas mãos, estou um pouco indisposto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030612
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 10030612,
					"content": "Porque... Tem rumor que um fantasma está assombrando o albergue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030613
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 10030613,
					"content": "E então, agora há pouco - agora há pouco! Na cozinha... Eu vi algo... Algo que não estava certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030614
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 10030614,
					"content": "(Este cozinheiro parecia grosseiro, mas quando falando do fantasma, se mostra fraco)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030615,
					"content": "Eu fico pensando... Até mesmo o Albergue Wangshu está correndo riscos. Assim não consigo preparar o Tofu de Amêndoas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030616
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 10030616,
					"content": "#Ok, {NICKNAME}. em nome do melhor tofu de amêndoas, temos que conferir esta cozinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
