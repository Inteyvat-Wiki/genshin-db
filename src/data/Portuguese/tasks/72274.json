			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soldado Fatui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722740201,
					"content": "Argh, nunca imaginei que nossos planos seriam vazados. Que azar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740202
					],
					"speakerTitle": "Soldado Fatui"
				},
				{
					"id": 722740202,
					"content": "Exatamente! Também ouvi dizer que o Professor foi chamado de volta à Snezhnaya, mas a operação na Ilha Watatsumi ainda está em andamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740203
					],
					"speakerTitle": "Soldado Fatui"
				},
				{
					"id": 722740203,
					"content": "Você não acha que o Professor está agindo de uma forma muito independente? Ele não reportou essa operação para a Srta. Arlecchino, não foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740204
					],
					"speakerTitle": "Soldado Fatui"
				},
				{
					"id": 722740204,
					"content": "É verdade. Isso é uma ideia dele. Eu não tenho uma boa sensação sobre isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740205
					],
					"speakerTitle": "Soldado Fatui"
				},
				{
					"id": 722740205,
					"content": "Você quer dizer que se fracassarmos, o Professor vai colocar toda a culpa em nós?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soldado Fatui"
				}
			]
		}
	]
