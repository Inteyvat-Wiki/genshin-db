			"dialogs": [
				{
					"id": 760280301,
					"content": "#Uwaaah, aí está você, {NICKNAME}! Quando aquelas duas coisas brilhantes colidiram, a explosão fez a Paimon voar pelos ares! Ainda bem que ela não se machucou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280302,
					"content": "Paimon levou uma eternidade pra voltar voando até aqui... Mas tá feliz que você também esteja bem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280303,
						760280308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280303,
					"content": "Na verdade, eu também saí voando por um bom tempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760280304
					]
				},
				{
					"id": 760280304,
					"content": "Paimon entendeu... Êh? Espera aí, como assim \"voando\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280305,
					"content": "Você conta à Paimon o que acabou de ver...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760280306
					]
				},
				{
					"id": 760280306,
					"content": "#Hmm, a Paimon nunca ouviu falar de um lugar assim em Teyvat... Tem certeza de que não estava só imaginando coisas, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280307,
					"content": "De qualquer forma, o que importa é que você está bem! Tem coisa estranha demais acontecendo por aqui. Vamos sair daqui enquanto ainda dá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280312,
					"content": "Ugh, Paimon não achava que fosse tão perigoso, e a gente nem acabou encontrando tesouro nenhum no fim... Por que uma coisa dessas ia aparecer aqui, mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280313,
					"content": "E se aquelas coisas brilhantes não eram Seelies... o que eram então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280308,
					"content": "#Acho que fui arremessad{M#o}{F#a} pra um lugar bem esquisito...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760280309
					]
