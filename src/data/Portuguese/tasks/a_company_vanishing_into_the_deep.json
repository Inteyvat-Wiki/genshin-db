	"talks": [
		{
			"id": 7106201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106201",
							"2"
						],
						"stepId": 7106201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Anthon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620101,
					"content": "Ei... Desculpe interromper se você está com pressa. Sou Anthon Melnikov, o... Comandante Interino da Nona Companhia. Apenas me chame de Anthon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620102
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620102,
					"content": "Esses são Danila, Temur, Radomir e... hã, Romanski. Ele não está aqui. Ele está no... acampamento médico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620103
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620103,
					"content": "Romanski se foi, assim como o acampamento médico. E o Anthon não passou desta manhã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620104
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620104,
					"content": "Danila, eu já lhe disse. Eu estou no comando da companhia agora. Me chame de Sargento-mor Anthon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620105
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620105,
					"content": "Haha! No comando da companhia? Sargento-mor? Quem você acha que é? Desde que o capitão sumiu, você está agindo como se fosse alguém importante. Não me faça rir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620106
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620106,
					"content": "Temur, já chega... Seu estômago faminto deve ter prejudicado sua cabeça. Se acalme e conserve sua energia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620107
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620107,
					"content": "Sim, \"Comandante Interino\" Anthon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620149
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620149,
					"content": "Comandante interino, que engraçado! Por quanto tempo mais teremos que acatar ordens deste comandante interino falso que não liga para o que está fazendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620150
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620150,
					"content": "Ei, Temur, seu cérebro deve estar totalmente tomado pela fome. Talvez eu devesse te dar uma surra para ficar lúcido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620151
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620151,
					"content": "Pois bem, venha! Venha se você acha que é capaz e eu te deixarei lúcido também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620152
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620152,
					"content": "Ótimo! Agora além de ter acabado com nossa comida, estamos dando adeus a nossa sanidade e paciência. Maravilha! Estamos gastando o resto de energia que temos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620108
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620108,
					"content": "*Cof* *Cof* Silêncio! Vocês querem brigar? Então desçam e lutem com os monstros que estão saindo da lama preta! Lutem contra eles com seus estômagos roncando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620109
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620109,
					"content": "Se quisermos viver e sair daqui, temos que trabalhar juntos! Não quero me repetir, entenderam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620110
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620110,
					"content": "É agora ou nunca! Se não for eu, quem?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620111
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620111,
					"content": "Se não for eu, quem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620112
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620112,
					"content": "Se não for eu, quem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620113
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620153
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620153,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620114
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620114,
					"content": "#Haha, {F#minha amiga}{M#meu amigo}, você deve ter reparado que não estamos em condições de combater agora... Afinal, tivemos um certo probleminha recentemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620115
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620115,
					"content": "Hmph... \"Pequeno problema\"! Você fala como se fosse um Capitão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620116
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620116,
					"content": "Como ele não está aqui, eu sou o Comandante da Companhia! Conserve sua energia e feche a matraca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620117
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620117,
					"content": "#Desculpe-me, amig{M#o}{F#a}. Estamos precisando muito de sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthon"
				}
			]
		},
		{
			"id": 7106202,
			"completionStepIds": [],
