				"points": []
			},
			"dialogs": [
				{
					"id": 710621001,
					"content": "Seja qual for o caso, obrigado por nos dar comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621002
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710621002,
					"content": "Daremos um jeito de encontrar uma forma de sair daqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthon"
				}
			]
		},
		{
			"id": 7106211,
			"completionStepIds": [
				7106207
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106207",
							"2"
						],
						"stepId": 7106207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthon",
					"Radomir",
					"Danila",
					"Temur"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710621101,
					"content": "Você voltou. Como foi? Alguma novidade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621102
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710621102,
					"content": "Está abandonado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621103
					]
				},
				{
					"id": 710621103,
					"content": "Sério? Então, você encontrou algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621104
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710621104,
					"content": "Você não é mais bem-vindo ao Porto de Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621105
					]
				},
				{
					"id": 710621105,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621106
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710621106,
					"content": "Além disso, você tem mais alguma notícia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621107
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710621107,
					"content": "Uh... tem uma carta que encontramos. Parece que é para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710621108,
					"content": "Está aqui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621109
					]
				},
				{
					"id": 710621109,
					"content": "Os soldados dos Fatui leem a carta...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710621110
					]
				},
				{
					"id": 710621110,
					"content": "Ah, é do Yanbo. Entendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621111
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710621111,
					"content": "O que houve? Os Millelith também se foram? Deixe-me ler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621112
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621112,
					"content": "*Suspira* Qual é a deles!? Estamos lutando por eles! Não somos aliados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621113
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710621113,
					"content": "Não são mais nossos aliados. Sem mais colaborações... Na verdade, como membros dos Fatui, nós não estamos mais em colaboração com Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621131
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621131,
					"content": "Isso é traição! As pessoas de Liyue nos traíram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621132
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710621132,
					"content": "Talvez eles estejam pensando o mesmo de nós? Eles acham que nós, dos Fatui, que traímos eles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621114
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621114,
					"content": "Não pode ser! Viemos aqui para proteger as pessoas de Liyue! Você lembra o que o Capitão disse antes de partirmos? \"Esta expedição não tem nada a ver com conspirações ou esquemas!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621115
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710621115,
					"content": "Mas isso não previne de conspirações e esquemas chegarem até nós, não é? Isso não é algo que podemos controlar, Danila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621116
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710621116,
					"content": "Certo, entendo. *Suspira* ...Estou decidido. Precisamos recuar quanto antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621117
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710621117,
					"content": "Está tudo bem, assumirei total responsabilidade. Se houver algum desertor entre nós... se algum desertor trouxer desonra a nossa Nona Companhia, é comigo e apenas comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621118
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710621118,
					"content": "Danila tem razão. Estamos aqui para proteger as pessoas de Liyue contra a Calamidade Tenebrosa. Não podemos simplesmente sair assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621119
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621119,
					"content": "Você realmente acha que é hora de se preocupar com sua honra, Mirka? Você está perdido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621120
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710621120,
					"content": "Você não consegue entender que as pessoas de Liyue não precisam da nossa proteção e nem querem que estejamos aqui!? Eles até derrotaram os nossos camaradas que acreditavam que eram invencíveis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621121,
						710621122
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710621121,
					"content": "Sim, você traiu a confiança das pessoas de Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				},
				{
					"id": 710621123,
					"content": "Deveríamos recuar e, de preferência, em silêncio. Não alertem os Millelith locais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621124
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710621124,
					"content": "O Capitão disse que deveríamos estar preparados para dar nossas vidas aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621125
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621125,
					"content": "Ele também disse que não deixaria ninguém morrer em vão! Que ele não gostaria que toda companhia fosse enterrada aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621126
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710621126,
					"content": "Pelo menos ainda estamos vivos. Pelo menos nem todos da Nona Companhia se foram. Você entende?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621127
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710621127,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621128
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621128,
					"content": "Sim, senhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621129
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621129,
					"content": "Ok, mais alguma pergunta? Não quero ouvir mais nenhuma objeção. Isso é tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621130
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710621130,
					"content": "#Seja qual for o caso, {NICKNAME}, muito obrigado por ajudar. Pegue esta Mora e estes suprimentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710621122,
					"content": "É melhor você considerar com cuidado o que fará em seguida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				}
			]
		},
