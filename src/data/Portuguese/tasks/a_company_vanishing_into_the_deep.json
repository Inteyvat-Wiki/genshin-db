							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620128,
					"content": "O que aconteceu depois disso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620131
					]
				},
				{
					"id": 710620131,
					"content": "Sairemos para nunca mais retornar. Te prometo... pela honra da Nona Companhia, e pelos nossos ancestrais que defenderam Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620132
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620132,
					"content": "*Suspira* Pobrezinho, tão faminto, patético!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620133
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620133,
					"content": "Chega disso! Você não está tão melhor também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620134
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620134,
					"content": "Existiam 64 de nós quando chegamos, 64 ao todo! Agora sobraram apenas 4 almas famintas. Que outro propósito poderíamos ter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620135
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620135,
					"content": "Eita! Como vocês acabaram assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620136,
					"content": "Isso não é assunto para agora... Sem comida, os últimos quatro que restaram da Nona Companhia poderá sumir em um instante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthon"
				}
			]
		},
