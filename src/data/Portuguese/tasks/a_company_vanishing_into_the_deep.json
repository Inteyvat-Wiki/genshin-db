			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620118,
					"content": "Desde quando nos tornamos \"amigos\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620121
					]
				},
				{
					"id": 710620121,
					"content": "O que você quer? — suprimentos, armas, informação ou Mora? Temos bastante de tudo isso. Pegue tudo que precisar, desde que você nos ajude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620122
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620122,
					"content": "Veja só, nosso novo mestre suplicando feito um mendigo no trabalho mais humilhante de todos... Que maravilhoso que é perder nossa última fração de dignidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620123
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620123,
					"content": "Pare já com isso! Você está esperando encher sua barriga com sarcasmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620124
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620124,
					"content": "\"Junte-se a nós! Deixe que nossas botas sacudam à terra como o trovão! Você que marchará conosco em direção a estrela polar da noite branca, venha! Jamais abandonaremos você...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620125
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620125,
					"content": "Alguém cale a boca dele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620126
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620126,
					"content": "Urg... Embora todos sejam malvados, ver eles passando fome realmente deixa a Paimon triste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620127,
					"content": "É difícil de admitir... mas como pode ver, não estamos mais em condição de combate. Tudo que queremos é um pouco de comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthon"
				}
			]
		},
