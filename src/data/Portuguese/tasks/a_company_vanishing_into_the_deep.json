					"Anthon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620137,
					"content": "Conte-me seu propósito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620140
					]
				},
				{
					"id": 710620140,
					"content": "Deixe-me explicar desta forma. Sejam quais forem as dúvidas que você tiver, o único propósito que temos aqui é de investigar a fonte da calamidade no Despenhadeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620141
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620141,
					"content": "Que calamidade? Paimon não viu nem sinal disso no Despenhadeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620142,
					"content": "A calamidade que ocorreu há 500 anos é apenas o começo. A luta contra a escuridão nunca parou e estamos em cima de um de seus campos de batalha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620143
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620143,
					"content": "*Suspira* Nosso comandante interino está tão faminto que começou a falar um monte de bobagens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620144
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620144,
					"content": "Ele sempre gostou de exagerar as coisas, mas esta é a primeira vez que ele fala um monte de bobagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620145
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620145,
					"content": "Esqueça. O que o Anthon quis dizer é que, bem, as pessoas de Liyue não são nossas inimigas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620146
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620146,
					"content": "Pelo menos não nesta operação, nem mesmo para nós da Nona Companhia... mas eu não tenho certeza sobre o que pensam os nossos camaradas que sumiram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620147
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620147,
					"content": "Te ajudarei como um gesto de bondade, mas apenas desta vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620148
					]
				},
				{
					"id": 710620148,
					"content": "O-obrigado! Seremos eternamente gratos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthon"
				}
			]
		},
