			},
			"dialogs": [
				{
					"id": 710620202,
					"content": "Por favor, considere o nosso pedido",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620201
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620201,
					"content": "Aqui está a comida que você queria.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7106207,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106203",
							"2"
						],
						"stepId": 7106203,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"7106202"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Anthon",
					"Danila",
					"Temur",
					"Radomir"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620701,
					"content": "Eles são tão fracos. Só uns soquinhos e eles já caíram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620702,
					"content": "Pare, por favor, pare! Apenas nos dê alguma comida e faremos o que quiser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620703
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620703,
					"content": "Hunf... Eles realmente estão bem desesperados por comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620704,
						710620705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620704,
					"content": "Conte-me seu propósito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				},
				{
					"id": 710620706,
					"content": "Como posso dizer... Sejam quais forem as dúvidas que você tiver, o único propósito que temos aqui é de investigar a fonte da calamidade no Despenhadeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620707
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620707,
					"content": "Que calamidade? Paimon não viu nem sinal disso no Despenhadeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620708,
					"content": "A calamidade que ocorreu há 500 anos é apenas o começo. A luta contra a escuridão nunca parou e estamos em cima de um de seus campos de batalha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620709
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620709,
					"content": "*Suspira* Nosso comandante interino está tão faminto que começou a falar um monte de bobagens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620710
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620710,
					"content": "Ele sempre gostou de exagerar as coisas, mas esta é a primeira vez que ele fala um monte de bobagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620711
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620711,
					"content": "Esqueça... Se tem uma coisa que Anthon tem razão é que as pessoas de Liyue não são nossas inimigas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620712
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620712,
					"content": "Pelo menos não para nós... mas eu não tenho certeza sobre o que pensam os nossos camaradas que sumiram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620713
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620713,
					"content": "Ok... Eu vou te ajudar, mas só desta vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710620705,
					"content": "Como posso confiar em você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				}
			]
		},
		{
			"id": 7106209,
			"completionStepIds": [
				7106205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106205",
							"2"
						],
						"stepId": 7106205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthon",
					"Danila",
					"Temur",
					"Radomir",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620901,
					"content": "*Suspira* Desculpa, mas tem um... pequeno problema... com nossa cadeia de comando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620902
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620902,
					"content": "\"Pequeno problema\"!? Acabamos de trair nossos homens, assistindo de braços cruzados enquanto alguém estava correndo atrás deles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620903
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620903,
					"content": "Então o que você sugere que eu faça? Quer que eu chame a pessoa até aqui para bater na gente e levar a nossa comida? Eu sugiro que você cale a boca e se concentre em comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620904
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620904,
					"content": "Anthon, pare de minimizar a situação. Nossa cadeia de comando foi dizimada. Acabou! Todos os nossos capitães e superiores desapareceram ou foram mortos... Isso não nos dá outra opção a não ser recuar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620905
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620905,
					"content": "Mas muitos de nossos homens se recusam a fazer isso... eles preferem se agarrar ao que restou e continuarem lutando até o fim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620906
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620906,
					"content": "Eu diria que é \"morrer de fome\" até o fim... Segundo o contrato, as pessoas lá em cima deveriam dar ordens e nos prover com comida, mas não ouvimos falar deles há muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620907
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620907,
					"content": "Somos leais aos Fatui e aos Mestres Mensageiros — mas não somos idiotas. Qualquer um em sã consciência saberia que deveríamos recuar diante de tal circunstância.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620908
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620908,
					"content": "Então, qual o seu plano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620909
					]
				},
				{
					"id": 710620909,
					"content": "Hã, sei que não é da sua conta. Não irei te impedir se você quiser sair, mas estamos realmente desesperados e gostaríamos da sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620910,
						710620912
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620910,
					"content": "Preciso pensar nisso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620911
					]
				},
				{
					"id": 710620911,
					"content": "Ok, tenha cuidado. Meus outros camaradas por aí podem não ser tão amigáveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620913
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620913,
					"content": "Eu não deveria te dizer isso, mas... tem uma base de suprimento perto da superfície. Todos os nossos suprimentos passam por lá, e às vezes também recebemos as ordens de lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620914
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620914,
					"content": "Enviamos alguns homens para pegar comida, mas eles não retornaram... não posso me arriscar em tentar mais uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620915
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620915,
					"content": "Além disso, ninguém mais veio da base de suprimentos já faz um bom tempo. Espero que você possa checar a situação para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620916,
						710620917
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620916,
					"content": "Deixe-me pensar nisso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620918,
					"content": "Me desculpe te incomodar com isso, mas preciso saber o que está acontecendo na superfície... caso contrário, eu não poderei tomar nenhuma decisão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620919
					],
					"speakerTitle": "Anthon"
				},
				{
					"id": 710620919,
					"content": "Tá bom, já chega! Você está começando a confundir a Paimon com todo esse falatório! Daremos uma olhada nisso quando der.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620917,
					"content": "Eu irei ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620912,
					"content": "O que você precisa que eu faça?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620913
					]
				}
			]
		},
		{
			"id": 7106210,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
