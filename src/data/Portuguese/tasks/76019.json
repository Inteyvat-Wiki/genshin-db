					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190228
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190228,
					"content": "#O Vieri também, se é um assunto secreto, claro que você deveria se aproximar e falar baixinho. Mas você, não, falou alto e atraiu {M#esses dois intrusos}{F#essas duas intrusas}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190229
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190229,
					"content": "Estou muito irritada agora. Se eu não der uma lição em vocês, realmente não vou conseguir me acalmar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190230
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190230,
					"content": "Tome isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190219,
					"content": "500.000 Mora. Ou então eu vou embora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190220
					]
				},
				{
					"id": 760190220,
					"content": "Por que você está tentando barganhar? Nós nem precisamos disso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190204,
					"content": "Se já foi ouvido por alguém, já não é mais um segredo mesmo.",
					"roleType": "TALK_ROLE_PLAYER",
