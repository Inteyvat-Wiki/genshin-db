			"dialogs": [
				{
					"id": 760190301,
					"content": "...Faça o que quiser, estou à sua mercê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190302
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190302,
					"content": "#Ahh, Paimon e {NICKNAME} nunca fariam algo tão horrível! Só precisamos que você pare de enganar os outros daqui pra frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190303,
					"content": "Mesmo alguém tão bobão quanto o Vieri... Hã? Quando foi que aquele cara escapou? De qualquer forma, mesmo alguém como ele não deve ser enganado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190304,
					"content": "Vocês são realmente gentis. Ah, se eu tivesse encontrado pessoas tão boas como vocês quando estava em Sumeru, talvez não teria acabado assim hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190305
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190306
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190306,
					"content": "Vocês não vão me perguntar o que aconteceu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190307,
						760190308
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190307,
					"content": "Minha intuição me diz para parar de perguntar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190309
					]
				},
				{
					"id": 760190309,
					"content": "#Vocês são realmente espertinh{M#os}{F#as}... Ah, faz tempo que não faço um bom negócio. Talvez esteja na hora de mudar de profissão. Também não quero chamar a atenção da Guilda Voynich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190310
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190310,
					"content": "Se você tivesse pensado assim mais cedo, não teria apanhado à toa agora há pouco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190311,
					"content": "Tomar decisões na vida sempre precisa de um momento decisivo, seja ele bom ou ruim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190312
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190312,
					"content": "#{M#Garoto}{F#Garota}, e você, coisinha voadora, se vocês precisarem desse momento decisivo, podem me procurar a qualquer hora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190313
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190313,
					"content": "Acho que não é necessário!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190314,
					"content": "Hidimbi deixa a seda vermelha para trás e dá adeus enquanto vai embora...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
