				]
			},
			"dialogs": [
				{
					"id": 150170401,
					"content": "Hã, tem um Tepetlissauro lá em cima. Mas não tenho certeza se é o de Tlazolli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170402,
						150170403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170402,
					"content": "Pelo menos ele não parece estar em perigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170404
					]
				},
				{
					"id": 150170404,
					"content": "Hmm... Não, não, espere, estamos aqui para procurar por Tlazolli, mas ela não está em lugar nenhum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170405,
					"content": "#Ei, {NICKNAME}! Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170406
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170406,
					"content": "É Cheven, o que ela está gritando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170407,
					"content": "Tem alguém do lado dela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170408
					]
				},
				{
					"id": 150170408,
					"content": "Desça, rápido! Tlazolli está aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170409
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170409,
					"content": "Hã? Acabamos de subir e Tlazolli já voltou? Que coincidência...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170410,
						150170411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170410,
					"content": "De qualquer forma, vamos descer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170413
					]
				},
				{
					"id": 150170413,
					"content": "Hmm? Por que o Tepetlissauro está vindo junto— Ow, ei, ei, não corra, você vai nos acertar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170414,
					"content": "Você desce a montanha com o Tepetlissauro...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150170415
					]
				},
				{
					"id": 150170415,
					"content": "Iengu, venha aqui... Você anda sendo travesso de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170416
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170416,
					"content": "*Choraminga*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170417
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170417,
					"content": "Bom Sauriano. Você está com fome? Desculpe... Vou fazer algo gostoso para você mais tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170418
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170418,
					"content": "Certo, agora vá brincar. Te procurarei logo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170419
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170419,
					"content": "*Choraminga*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170420
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170420,
					"content": "Desculpe. Eu estava esperando por vocês em casa quando Nechca... Bem, ela fugiu e saiu correndo por conta própria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170421
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170421,
					"content": "#Quando eu a encontrei, ela disse que apenas queria fazer um presente para {M#nossos convidados}{F#nossas convidadas}, então foi pegar algumas flores bonitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170422
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170422,
					"content": "Ela estava colhendo flores conforme andava, mas acabou se perdendo... Ainda bem que consegui encontrar ela a tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170423
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170423,
					"content": "Ela está bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170424
					]
				},
				{
					"id": 150170424,
					"content": "É, Cheven nos disse que apenas recentemente ela ficou melhor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170425,
					"content": "Seu corpo ainda está bem fraco. Ela ficou assustada e ficou exposta a ventos frios, então ela tem uma febre leve no momento. Ela tomou remédio e foi pra cama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170426
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170426,
					"content": "Não é nada sério. Uma boa noite de sono deve ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170427
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170427,
					"content": "Dito isso, temo que ela não poderá te encontrar hoje. Desculpe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170428
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170428,
					"content": "Oh, sem problemas! Ouvimos Cheven mencionar que a doença de Nechca era super séria e como ela ainda tá em recuperação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170429,
					"content": "Então queríamos passar e ver como ela estava. Independentemente, ela tem que tentar e cuidar de sua saúde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170430,
						150170433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170430,
					"content": "Então, ela foi curada de sua condição anterior?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170431
					]
				},
				{
					"id": 150170431,
					"content": "...Bem, pelo menos agora ela pode conversar normalmente comigo sobre seu dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170432
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170432,
					"content": "Isso já é um grande progresso, eu não poderia pedir por mais nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170437
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170437,
					"content": "Ei, qual é, por que tão pra baixo? Se anime!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170438
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170438,
					"content": "Apreciamos que ela tentou nos receber com flores. Enfim, Tlazolli, sobre aquilo que eu estava te contando antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170439,
						150170440
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170439,
					"content": "Oh, o presente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170441
					]
				},
				{
					"id": 150170441,
					"content": "É! Que tipo de presente é? Você poderia nos dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170442,
					"content": "Bem, é uma Inscrição de Cristal Flamejante. Fiz com o minério mais puro e é praticamente totalmente resistente a erosão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170443
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170443,
					"content": "As técnicas que usei para fazê-lo vieram da criação de Nomes Antigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170444
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170444,
					"content": "Então, é basicamente uma versão simplificada de um Nome Antigo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170445
					]
				},
				{
					"id": 150170445,
					"content": "Heh, não diga isso, ou você pode acabar trazendo a fúria de Wayob pra cima de mim. Apenas usei as técnicas relevantes em alguns minérios para criar esse cristal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170446
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170446,
					"content": "Quando fiz um pela primeira vez, eu não achava que poderia servir nenhum propósito prático, além de ser bonito e ser resistente a erosão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170447
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170447,
					"content": "Mas então Cheven sugeriu usar esses cristais para fazer \"ornamentos\" únicos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170448
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170448,
					"content": "\"Inscrições de Cristal Flamejante feitas por uma artesã de Nomes Antigos, com palavras registradas que nunca desaparecem.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170449
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170449,
					"content": "Uma bela de uma propaganda, não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170450
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170450,
					"content": "Uh, a descrição ajuda realmente a fazer esse item parecer especial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170451,
						150170452
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170451,
					"content": "Você tem uma boa cabeça para negócios...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170453
					]
				},
				{
					"id": 150170453,
					"content": "Haha, as Inscrições de Cristal Flamejante de Tlazolli realmente são especiais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170454
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170454,
					"content": "Boca a boca não é sempre tão confiável. Conforme a informação é passada, se torna incompleta ou é esquecida. Talvez mentiras até comecem a ser espalhadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170455
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170455,
					"content": "Mas as palavras registradas nesses cristais resistirão ao teste do tempo. A inscrição jamais se deteriorará e o significado nunca será distorcido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170456
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170456,
					"content": "É um ótimo presente, independente se você quiser dar a um querido amigo ou amado, ou passar para algum parente mais novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170457,
						150170460
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170457,
					"content": "Tentando me fazer comprar um é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170458
					]
				},
				{
					"id": 150170458,
					"content": "#É, Paimon já está indo pegar a Mora! Ei, {NICKNAME}, por que não compramos um e gravamos nosso nome nele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170459
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170459,
					"content": "#E então quando encontrarmos {M#a sua irmã}{F#o seu irmão}, podemos fazer com que {M#ela}{F#ele} grave seu nome também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170462
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170462,
					"content": "Dessa forma, nossos nomes podem ficar juntos para sempre. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170463,
						150170495
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170463,
					"content": "Parece que Paimon já está convencida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170464
					]
				},
				{
					"id": 150170464,
					"content": "Vocês merecem! Vocês me salvaram, além do presente de aniversário de Nechca. É o mínimo que posso fazer para retribuir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170465
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170465,
					"content": "Cheven, eu não tinha dito que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170466
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170466,
					"content": "E não comece a agir envergonhada também, é um ótimo presente, Tlazolli! Sei quanto esforço precisa para fazer um desses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170467
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170467,
					"content": "#Obrigada, Cheven — e você também, {NICKNAME}. Vou preparar o mais rápido possível. Quando o momento chegar, você poderá inscrever os seus nomes pessoalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170468
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170468,
					"content": "Imagino que até lá Nechca deva estar melhor — tenho certeza que ela ficará feliz com sua visita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170469,
						150170496
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170469,
					"content": "Boas coisas são melhores com companhia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170470
					]
				},
				{
					"id": 150170470,
					"content": "Você não está meio que se apressando? Essas coisas podem ser bem caras... tem certeza que tem fundos de viagem suficientes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170471
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170471,
					"content": "Espera um segundo... isso não é parte de um esquema que você montou para nos fazer gastar toda nossa Mora, é, Cheven?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170472
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170472,
					"content": "Talvez, talvez. Nunca se sabe... Você realmente parece que tem algum dinheiro sobrando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170473
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170473,
					"content": "#Ah, oh não! Precisamos ter cuidado com ela, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170474
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170474,
					"content": "Haha! Deixarei vocês discutirem sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170475
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170475,
					"content": "*Choraminga*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170476
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170476,
					"content": "Hã!? Lá vem de novo! Rápido, alguém fique na frente! Paimon não quer ser atropelada de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170477
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170477,
					"content": "Eita! Pronto, pronto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170478
					]
				},
				{
					"id": 150170478,
					"content": "*Choraminga*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170479
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170479,
					"content": "Além disso, se você não se importar, Tlazolli, eu gostaria que você me ajudasse a reparar minha Inscrição de Cristal Flamejante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170480
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170480,
					"content": "Eu derrubei quando fui atacada mais cedo e tanto a corda quanto o fecho quebraram, e é por isso que não estou usando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170481
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170481,
					"content": "Tentei consertar por conta própria, mas eu simplesmente não consegui. Você poderia ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170482
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170482,
					"content": "Sem problemas, apenas deixa comigo. Vou deixar novinho em folha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170483
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170483,
					"content": "...E obrigada, Cheven, por ir tão longe e—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170484
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170484,
					"content": "Está tudo bem, Tlazolli. Ficarei feliz desde que Nechca melhore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170485
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170485,
					"content": "...Certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170486
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170486,
					"content": "Venha, Iengu, se comporte! Te alimentarei mais tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170487
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170487,
					"content": "Uma vez que a inscrição estiver completa, pedirei que Cheven entre em contato com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170488
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170488,
					"content": "Talvez até conseguiremos alinhar com o aniversário de Nechca. Aí, sim, teremos uma festa de verdade, tudo bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170489
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170489,
					"content": "#Maravilha! Hehe, talvez terá várias comidas deliciosas! Vamos aparecer e estar pront{M#o}{F#a}s para comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170490
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170490,
					"content": "Enfim, te vemos por aí, Tlazolli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170491,
						150170492
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170491,
					"content": "Até mais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170493
					]
				},
				{
					"id": 150170493,
					"content": "Cuidem-se!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170494
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170494,
					"content": "Tenho certeza que Nechca vai adorar conhecer vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170492,
					"content": "Espero que sua filha se recupere logo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170493
					]
				},
				{
					"id": 150170496,
					"content": "Deveríamos comprar mais alguns como presente logo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170470
					]
				},
				{
					"id": 150170495,
					"content": "Isso parece um pouco precioso demais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170464
					]
				},
				{
					"id": 150170460,
					"content": "Você sabe mesmo como persuadir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170461
					]
				},
				{
					"id": 150170461,
					"content": "#É, parece um ótimo produto! Vamos comprar um e gravar nossos nomes nele. E então quando encontrarmos {M#a sua irmã}{F#o seu irmão}, podemos fazer com que {M#ela}{F#ele} grave seu nome também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170462
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170452,
					"content": "Não é à toa que você tem sua própria loja...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170453
					]
				},
				{
					"id": 150170440,
					"content": "Nada melhor do que a hora dos presentes!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170441
					]
				},
				{
					"id": 150170433,
					"content": "Considerando que ela foi capaz de fugir, ela parece estar bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170434
					]
				},
				{
					"id": 150170434,
					"content": "Sim, e ela corre bem rápido quando tento fazer ela comer vegetais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170435
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170435,
					"content": "Por cima de cadeiras e debaixo de mesas... Por toda casa, também. Mal consigo pegá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170436
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170436,
					"content": "Então, considerando como ela está agora... Isso já é bom o suficiente, eu não poderia pedir por mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170437
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170411,
					"content": "É, uma verdadeira coincidência...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170412
					]
				},
				{
					"id": 150170412,
					"content": "Seja qual for o caso, vamos descer primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170403,
					"content": "Parece que subiu lá por conta própria...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170404
					]
				}
			]
		},
		{
			"id": 1501706,
