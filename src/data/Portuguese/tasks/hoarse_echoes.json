			"dialogs": [
				{
					"id": 150170101,
					"content": "#Oh, vocês chegaram cedo! Ansios{M#o}{F#a}s pelos seus presentes, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170102,
						150170105
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170102,
					"content": "Só estamos felizes de visitar Tlazolli e Nechca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170103
					]
				},
				{
					"id": 150170103,
					"content": "Isso mesmo! Nechca anda tão doentinha, e Tlazolli teve que desistir de um trabalho tão importante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170104,
					"content": "As coisas podem estar melhorando, mas quem sabe se serão capazes de voltar a ativa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170109,
					"content": "Haha, eu já pedi para alguém dar uma passada e avisar a Tlazolli que estamos chegando. Ela provavelmente já fez todos os preparativos necessários.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170110
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170110,
					"content": "Então, vamos. Você se importa de cuidar da loja, Imix? Voltarei logo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170105,
					"content": "É, me pergunto o que os presentes poderiam ser...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170106
					]
				},
				{
					"id": 150170106,
					"content": "Paimon também... Mas também estamos aqui para ver como Nechca está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170107,
					"content": "Após ficar tão doente, quem sabe como ela está agora. E tem Tlazolli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170108,
					"content": "É difícil dizer como ela se sente depois de desistir de um trabalho tão importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "Paimon"
				}
			]
		},
