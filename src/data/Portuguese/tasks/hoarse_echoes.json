			"dialogs": [
				{
					"id": 150170201,
					"content": "Aqui estamos. Casa bem incrível, se quer saber. Um momento, irei bater.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170202
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170202,
					"content": "Ei, Tlazolli! Chegaram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170203
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170203,
					"content": "...Tlazolli? Você está em casa? Abra logo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170204
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170204,
					"content": "Estranho... Hã. A porta está bloqueada e trancada, mas ela não deveria sair a essa hora do dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170205
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170205,
					"content": "Ei, Nechca? Nechca? Sou eu, Cheven. Abra, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170206,
						150170207
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170206,
					"content": "(Sem resposta...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170210
					]
				},
				{
					"id": 150170210,
					"content": "Mas é estranho, eu já falei com Tlazolli sobre isso... Será que ela teve que levar Nechca urgentemente para buscar remédios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170211
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170211,
					"content": "Hã? O que é aquilo ali? Parece ser um pequeno ninho de Tepetlissauro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170212,
					"content": "Isso mesmo. Tlazolli tem um companheiro Tepetlissauro. Se me lembro bem, seu nome é... Iengu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170213
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170213,
					"content": "Quando ela ainda estava no ramo de forja, ela costumava levar Iengu para ajudá-la com algumas escavações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170214
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170214,
					"content": "Mas desde que Nechca adoeceu, Tlazolli não deixou ele cavar muito recentemente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170215
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170215,
					"content": "Espera um minuto aí. Mas o quê...? Esse lugar está uma bagunça! E Iengu não está em lugar nenhum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170216
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170216,
					"content": "Eita, olha só todas essas caixas quebradas! Algo terrível deve ter acontecido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170217,
						150170218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170217,
					"content": "Vamos olhar mais de perto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150170218,
					"content": "Você fica aqui, Cheven.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170219
					]
				},
				{
					"id": 150170219,
					"content": "Oh... Certo! Vou apenas... encontrar um lugar para me esconder por ora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170220
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170220,
					"content": "Sinceramente, os lábios de Imix foram abençoados pelo Wayob? Toda vez que ela me diz para não ir em algum lugar perigoso, acabo me deparando com perigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170207,
					"content": "Precisa que eu derrube a porta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170208
					]
				},
				{
					"id": 150170208,
					"content": "Algo aconteceu com elas? Ou talvez seja a condição de Nechca... Ohh, isso pode ser bem ruim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170209,
					"content": "Não vamos pensar demais nas coisas. Elas estavam bem da última vez que estive aqui. Nechca até estava dormindo em seu próprio quarto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170210
					],
					"speakerTitle": "Cheven"
				}
			]
		},
