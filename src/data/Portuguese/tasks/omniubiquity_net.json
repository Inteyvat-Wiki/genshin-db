			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720501,
					"content": "Você encontrou a Wakamurasaki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720502
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720502,
					"content": "Então, esse é o problema da Rede Oniubíqua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720503
					]
				},
				{
					"id": 726720503,
					"content": "\"Rede Oniubíqua\"... Sabe de uma coisa? Não é um nome ruim. Ainda assim, essa técnica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720504
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720504,
					"content": "Será que essa técnica conseguiria reter a essência humana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720505
					]
				},
				{
					"id": 726720505,
					"content": "Uhh, oh. Isso não é possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720506
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720506,
					"content": "Existem apenas registros de uma técnica onmyoudou deste tipo existente. Qualquer prática já desapareceu há muito tempo na neblina do tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720507
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720507,
					"content": "A técnica que ensinei à Wakamurasaki só pode ser usada em pequenos animais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720508
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720508,
					"content": "Espera, o quê? Então por que você não disse a ela?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720509
					]
				},
				{
					"id": 726720509,
					"content": "Oh, isso? Apenas quis que a Wakamurasaki ajudasse a espalhar uma certa coisa por aí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720510
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720510,
					"content": "\"A presidente da Agência de Detetive de Bantan Sango está pedindo a alguém para criar uma rede usando Kamuna Onmyoudou que pode fazer as pessoas falarem a verdade.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720511
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720511,
					"content": "Os Onmyoudou de Kamuna que desapareceram, a presidente da Agência de Detetive de Bantan Sango e uma rede que pode reter a essência de pequenas criaturas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720512
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720512,
					"content": "Coloque tudo isso junto, e você terá uma lenda urbana que soa tanto incrível, quanto de certa forma com um pouco de verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720513
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720513,
					"content": "Para a maioria das pessoas, essas lendas urbanas são apenas historinhas... Mas para criminosos que já têm a semente do medo dentro de si, esses contos não são tão simples.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720514
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720514,
					"content": "Ah, então foi isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720515
					]
				},
				{
					"id": 726720515,
					"content": "O outro lado da questão é que.. Bem, Wakamurasaki estava começando a me irritar com todo aquele papo idiota de \"me ache a técnica onmyoudou mais forte de todos os tempos!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720516
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720516,
					"content": "Eu lhe disse muitas, muitas vezes que tais coisas não existem, mas ela não quis ouvir! Portanto, não tive outra escolha senão dar-lhe \"alguma coisa\" com que trabalhar para que ela me deixasse em paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720517
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720517,
					"content": "E se a Wakamurasaki não falar com ninguém sobre isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720518
					]
				},
				{
					"id": 726720518,
					"content": "Im-pos-sí-vel. Ela não consegue manter segredo nem que custe sua vida. Confie em mim, conheço ela beeemmm demais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720519
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720519,
					"content": "De qualquer forma, obrigada por ter feito esta viagem por mim. Pegue isto, considere como um pagamento pelo seu esforço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720520
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720520,
					"content": "Arcontes, por favor, eu imploro que ela não venha me incomodar de novo. Eu sou uma detetive, sabe? Não alguma onmyouji...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
