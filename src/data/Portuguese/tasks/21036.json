			"dialogs": [
				{
					"id": 210360101,
					"content": "Viajante, nos encontramos de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360102,
						210360104
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360102,
					"content": "Você ainda está treinando aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360103
					]
				},
				{
					"id": 210360103,
					"content": "De fato estou. É só que... é muito mais difícil do que eu esperava. Eu não sei se sou mesmo tão fraco, ou se eu adotei o método errado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360108,
					"content": "Enfim, já falamos demais sobre ela. Da última vez que lutamos juntos, seus movimentos foram muito inspiradores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360109,
					"content": "Viajante, me faça um favor e me acompanhe em outra rodada de treinamento, pode ser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360110,
					"content": "E assim como da última vez, luta contra monstros ou treinamento pela natureza? Você decide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360104,
					"content": "Que'er ainda está te ignorando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360105
					]
				},
				{
					"id": 210360105,
					"content": "Bem... Ela disse que tinha coisas para fazer na cidade recentemente, e nunca voltou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360106
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360106,
					"content": "Eu já a visitei algumas vezes, mas ela apenas manda Zhiruo para me fazer ir embora. Ela ainda se recusa a me ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360107,
					"content": "*Suspiro* Eu honestamente não sei o que dizer a ela agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
