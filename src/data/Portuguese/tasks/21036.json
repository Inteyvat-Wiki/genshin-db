			"dialogs": [
				{
					"id": 210360201,
					"content": "Luta contra monstros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360202
					]
				},
				{
					"id": 210360202,
					"content": "Maravilha! Há muito tempo eu quero colocar em prática as técnicas de espada que eu treinei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360203
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360203,
					"content": "Receio que você não consiga ver meus movimentos claramente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360204
					]
				},
				{
					"id": 210360204,
					"content": "#V-você é realmente tão habilidos{M#o}{F#a} assim? Hahahaha, então, por favor, me faça outro favor e seja um pouco mais devagar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360205,
					"content": "Vamos ver... Tem um lugar que os monstros se juntam bem à frente. Vamos dar um pulo lá primeiro, tudo bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
