			},
			"dialogs": [
				{
					"id": 210360401,
					"content": "Ufff... Essa foi difícil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360402,
					"content": "Olhe para mim, passando vergonha de novo. Eu acho que não fiz tanto progresso assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360403
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360403,
					"content": "Não preciso dizer, ainda preciso de mais treinamento. Obrigado, Viajante, pegue isso como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360404
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360404,
					"content": "Como você sairá de Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360405
					]
				},
				{
					"id": 210360405,
					"content": "Bem, meu plano atual é pegar o barco do comerciante e viajar pela água.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360406
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360406,
					"content": "Como minha primeira parada... estou pensando em Fontaine. Eu provavelmente começarei por lá por um tempo e planejarei os próximos passos de lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360407
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360407,
					"content": "*Suspiro* Me pergunto se conseguirei convencer Que'er a viajar comigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
