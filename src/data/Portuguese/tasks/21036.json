				},
				{
					"id": 210360903,
					"content": "Me disseram que eu só precisava alcançar o destino o mais rápido possível. Mas parece que eu nunca fui rápido o bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360904
					],
					"speakerTitle": "Sun Yu"
				},
				{
