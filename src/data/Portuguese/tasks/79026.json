			"dialogs": [
				{
					"id": 790260101,
					"content": "#Bem-vind{F#a}{M#o}! Bem-vind{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260102
					],
					"speakerTitle": "Diretor da Companhia Teatral Crepúsculo"
				},
				{
					"id": 790260102,
					"content": "#Bem-vind{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260104
					],
					"speakerTitle": "Diretor da Companhia Teatral Crepúsculo"
				},
				{
					"id": 790260104,
					"content": "#Você deve ser {F#a}{M#o} famos{F#a}{M#o} {NICKNAME}! E com sua melhor companheira, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260105
					],
					"speakerTitle": "Diretor da Companhia Teatral Crepúsculo"
				},
				{
					"id": 790260105,
					"content": "Uau! Como você sabe o nosso nome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790260106,
					"content": "É claro que eu sei quem são os visitantes ilustres da ilha. Afinal eu sou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260107
					],
					"speakerTitle": "Diretor da Companhia Teatral Crepúsculo"
				},
				{
					"id": 790260107,
					"content": "Você é...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790260108,
					"content": "Eu sou o famoso diretor da Companhia Teatral Crepúsculo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260109
					],
					"speakerTitle": "Diretor da Companhia Teatral Crepúsculo"
				},
				{
					"id": 790260109,
					"content": "Então, realmente há gente que se chama de \"famosa\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790260110
					]
				},
				{
					"id": 790260110,
					"content": "Apesar de você se considerar famoso, nunca ouvimos falar de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790260111,
					"content": "Não tem problema. Agora vocês já ouviram falar de mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260112
					],
					"speakerTitle": "Diretor da Companhia Teatral Crepúsculo"
				},
				{
					"id": 790260112,
					"content": "Após preparos intensos, a nossa peça \"A Princesa Espadachim\" será lançada em breve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260113
					],
					"speakerTitle": "Diretor da Companhia Teatral Crepúsculo"
				},
				{
					"id": 790260113,
					"content": "Há cinco atos no total. Cada ato é dividido em duas partes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260114
					],
					"speakerTitle": "Diretor da Companhia Teatral Crepúsculo"
				},
				{
					"id": 790260114,
					"content": "#{M#Meus convidados}{F#Minhas convidadas} especiais, vocês chegaram bem a tempo! O prólogo já vai começar! Sentem-se!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260115
					],
					"speakerTitle": "Diretor da Companhia Teatral Crepúsculo"
				},
				{
					"id": 790260115,
					"content": "Ainda preciso fazer algumas coisas nos bastidores. Com licença, me retirarei agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260116
					],
					"speakerTitle": "Diretor da Companhia Teatral Crepúsculo"
				},
				{
					"id": 790260116,
					"content": "A Companhia Teatral Crepúsculo apresenta esse palco feito com muito esforço. Aproveitem o show!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diretor da Companhia Teatral Crepúsculo"
				}
			]
		}
	]
