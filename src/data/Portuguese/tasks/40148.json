			"dialogs": [
				{
					"id": 401489601,
					"content": "...Sério, se eu tivesse piscado, tinha perdido! Cajado Carmesim se jogou no Podador de Flores e mandou ele voando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489602
