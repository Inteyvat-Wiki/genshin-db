			"dialogs": [
				{
					"id": 401489701,
					"content": "\"Conde Redentor\", \"Besouzilla\"... Nunca imaginava que haveria tantos batalhadores de besouro de elite em Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489702
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401489702,
					"content": "Você não veio mesmo pelo torneio de Batalha de Besouros, veio...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401489703
					]
				},
				{
					"id": 401489703,
					"content": "Heh, dá para imaginar? Esse atraso seria dos mais deselegantes. Não, na verdade, esta viagem é parte negócios e parte lazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489704
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401489704,
					"content": "Por que você não veio ao Ritual de Lanternas então?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401489705
					]
				},
				{
					"id": 401489705,
					"content": "Cada visitante tem seus próprios objetivos. Para alguns, as festividades são o motivo perfeito para visitar, para outros, o motivo perfeito para evitar multidões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489706
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401489706,
					"content": "Em todo caso, de uma forma ou de outra, eu pareço ter acabado na hora certa e no lugar certo... Agora, quanto ao tofu restante... sim, tenho certeza que Thoma fará o que achar melhor com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayato"
				}
			]
		},
