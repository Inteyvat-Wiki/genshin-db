					{
						"sceneId": 3,
						"position": [
							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401480201,
					"content": "Uh... A comida tá aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480202,
					"content": "Oh, então esse é o Humilde Satisfação? Vocês não brincam em serviço! O cara tem que amar uma porção desse tamanho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480203
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480203,
					"content": "#Bora, {M#meu consagrado}{F#minha consagrada}, puxa uma cadeira. Aqui é todo mundo chegado, não precisa se segurar! Eu vou cair dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480204
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480204,
					"content": "Ahem! Chefe, a gente deveria respeitar os costumes locais. Aqui em Liyue, é de bom-tom deixar os convidados comerem primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480205
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480205,
					"content": "Bom-tom? Hmm... Shinobu, eu pensava que tradições antigonas não eram sua vibe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480206,
						401480207
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480206,
					"content": "#Agora que acabei na cozinha, sou um{F#a} convidad{M#o}{F#a} também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				},
				{
					"id": 401480208,
					"content": "#Hã? Tá me tirando, consagrad{M#o}{F#a}?... Ah, pera, saquei. A comida tá cheirando tão bem, que tá geral morrendo de vontade de comer primeiro! Bem, acho que só posso culpar meu bom gosto. Vai lá, manda ver, eu espero pra ser o último!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480209
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480210
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480210,
					"content": "Você, Paimon, Ayato e Shinobu se servem, deixando pouquíssima \"carne\" para trás...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480211
					]
				},
				{
					"id": 401480211,
					"content": "...Hah, saquei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480212
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480212,
					"content": "Finalmente, chegou minha hora! Uhuuul, já tô mirando em um pedação de delícia com meu nome estampado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480213
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480213,
					"content": "Espera, não!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480214,
					"content": "Hã? O que foi agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480215,
						401480216
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480215,
					"content": "Você consegue, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480217,
					"content": "Hmm... Certo, aqui vai... Enfim, então, hmm, Paimon esqueceu de te contar a história de origem bem maneira desse prato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480218,
					"content": "História de origem? Cara, quem se importa de onde veio, todo mundo sabe pra onde vai! Pra dentro da barriga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480219
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480219,
					"content": "Uh, bem, hmm... Desconsiderar a história de origem é tipo... tipo viajar sem um guia de turismo! Confie em Paimon, você vai gostar muito mais depois de ouvir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480220,
					"content": "Paimon fez uma observação astuta. Assim como cada chá deve ser apreciado em seus próprios termos, não é um desperdício da boa vontade do chef provar um prato sem ouvir sua história?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480221
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480221,
					"content": "#Boa vontade {M#do meu consagrado}{F#da minha consagrada}, hein? Não posso deixar isso se perder... Beleza então, manda aí! Sou todo ouvidos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480222
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480222,
					"content": "É assim que se fala! Vamos começar com os ingredientes... Na verdade, não, vamos começar com a história do Albergue Wangshu... Que começa com a história da Ilhota de Dihua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480223,
					"content": "#(Agora é nossa chance, {NICKNAME}!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480224
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480224,
					"content": "(Pode deixar!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480225
					]
				},
				{
					"id": 401480225,
					"content": "Enquanto Itto está distraído, você e Shinobu começar a devorar o prato...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480226
					]
				},
				{
					"id": 401480226,
					"content": "...Cara, o conto da Ilhota de Dihua pega pesado... A galera do passado ralava mesmo. Te faz apreciar o que tem. \"Humilde Satisfação\"... essa é uma boa maneira de pensar na vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480227
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480227,
					"content": "(Droga, não tem como mencionar tofu daqui... Como a gente fugiu tanto do assunto? Ugh. Bem, a boa notícia é que só tem um pouco sobrando!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480228,
					"content": "(Mas a gente já tá... além de estufado...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480229
					]
				},
				{
					"id": 401480229,
					"content": "#Aaah! {M#Meu}{F#Minha} Consagrad{M#o}{F#a}, Shinobu! Vocês tavam detonando esse tempo todo?! Assim eu vou ficar só com o bagaço!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480230
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480230,
					"content": "É isso, cansei de esperar! É minha vez de comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480231
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480231,
					"content": "Espera! Chefe, isso é feito de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480232
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480232,
					"content": "Um momento, Itto. Eu... tenho um pequeno pedido, se tiver a gentileza de considerá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480233
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480233,
					"content": "Saí de casa com pressa e não pude trazer ninguém da minha família comigo. Eles todos ouviram tanto de seus grandes admiradores da Gangue Arataki, então vão ficar devastados em saber que perderam essa oportunidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480234
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480234,
					"content": "Contudo... se estiver disposta a me deixar levar o restante do Humilde Satisfação de volta para eles, tenho certeza que os animaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480235
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480235,
					"content": "Ehh... É, sei não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480236
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480236,
					"content": "Chefe, você tem que fazer o certo pelos seus amigos. Eles apreciam muito isso em Liyue... Além disso, você comeu bastante peixe grelhado enquanto a gente tava esperando pelo prato principal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480237
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480237,
					"content": "...Incluindo o meu e o de Ayato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480238
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480238,
					"content": "Hã? Aqueles eram de vocês?! Meleca... me deixar levar contando aquela história, não foi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480239
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480239,
					"content": "Ahem, nesse caso... Mande meus cumprimentos à família, mano! El Jefe, a gente pode levar o resto disso pra viagem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480216,
					"content": "Você sabe o que fazer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480207,
					"content": "Só me deixar comer primeiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				}
			]
		},
