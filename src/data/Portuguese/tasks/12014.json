			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yoimiya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120140101,
					"content": "Acho que vou ficar aqui um pouco mais. O espetáculo ainda não terminou no meu coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140102
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140102,
					"content": "Oh, mas se você quisesse conversar, eu teria todo o prazer em fazê-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140103,
						120140108,
						120140115
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140103,
					"content": "O que você quer fazer depois?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140104
					]
				},
				{
					"id": 120140104,
					"content": "Matsuzaka e os outros ainda estão esperando por mim para que possamos ir caçar a Grande Mujina Youkai. Sou como uma irmã mais velha para eles, portanto não posso voltar atrás em minha palavra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140105
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140105,
					"content": "Além disso, quero ir e perguntar a todos o que acharam dos fogos de artifício.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140106,
					"content": "E nos próximos dias, também gostaria de agradecer a todos pelo apoio que me deram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140107
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140107,
					"content": "Isso inclui você e a Paimon também, é claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140108,
					"content": "Os fogos de artifício são caros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140109
					]
				},
				{
					"id": 120140109,
					"content": "Para vocês...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140110
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140110,
					"content": "Farei de graça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140111
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140111,
					"content": "Afinal de contas, eu te forcei um pouco. Sem mencionar que eu te arrastei junto comigo e lhe dei todo tipo de problemas ao longo do caminho. Hehe, eu me sentiria mal se lhe cobrasse alguma Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140112
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140112,
					"content": "Você tem certeza? Me sinto mal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140113
					]
				},
				{
					"id": 120140113,
					"content": "#Está tudo bem... Olha, que tal fazermos um acordo: depois de encontrar {M#sua irmã}{F#seu irmão}, diga a {M#ela}{F#ele} para vir até o Fogos de Artifício Naganohara para todas as suas necessidades de fogos de artifício. Dessa forma, conseguirei outro cliente. Parece justo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140114
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140114,
					"content": "#Além disso, seria legal conhecer {M#ela}{F#ele}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140115,
					"content": "E se a Comissão Tenryou te causar mais problemas...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140116
					]
				},
				{
					"id": 120140116,
					"content": "Eu vou acabar com eles novamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140117
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140117,
					"content": "Hahaha, estou brincando. Eu não lhe disse que minha família lida bastante com as Comissões?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140118
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140118,
					"content": "Na verdade, temos bastante facilidade em lidar com isso. No pior dos casos, teríamos que pedir desculpas, sorrir e pagar uma multa. Não seria o fim do mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140119
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140119,
					"content": "#No entanto, vocês deveriam ser cuidados{M#o}{F#a}s. Sem as mesmas conexões, não podem ser tão imprudentes como eu, hee hee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		}
	]
}