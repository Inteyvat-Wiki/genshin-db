					"Joel"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230501,
					"content": "E então? Você descobriu alguma informação sobre meu pai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230502,
						701230511
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230502,
					"content": "Sobre as descobertas na caverna no topo da montanha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230503
					]
				},
				{
					"id": 701230503,
					"content": "Meu pai... Ele... Não! Ele é um ótimo Aventureiro! Isso foi só um problema pequeno, ele com certeza conseguiria resolver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230504
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230504,
					"content": "O caderno do meu papai disse que ele encontrou uma maneira de descer a montanha... Ele já pode ter descido em segurança, você não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230505
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230505,
					"content": "Ele já deve ter descido em segurança...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230506
					]
				},
				{
					"id": 701230506,
					"content": "Sim... Ele deve ter descido e está descansando agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230507
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230507,
					"content": "Ou talvez tenha montado um acampamento em outro local na montanha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230508
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230508,
					"content": "Quando papai terminar de descansar, ele retornará...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230509
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230509,
					"content": "Vou continuar esperando ele aqui. Obrigado pela sua ajuda, fique com isso em troca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230511,
					"content": "Eu não encontrei nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230512
					]
				},
				{
					"id": 701230512,
					"content": "S-Sério? Mas aquele Cavaleiro de Favonius disse que o papai subiu a montanha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230513
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230513,
					"content": "Talvez ele tenha se enganado? Meu pai deve ter montado um novo acampamento em outro lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230514
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230514,
					"content": "Está bem, vou continuar esperando aqui... Se eu não estiver quando meu pai retornar, ele ficará preocupado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230515
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230515,
					"content": "Obrigado pela sua ajuda. Por favor, fique com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230516
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230516,
					"content": "Papai... Onde você está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				}
			]
		},
