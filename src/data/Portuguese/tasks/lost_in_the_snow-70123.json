			},
			"dialogs": [
				{
					"id": 701230301,
					"content": "Não aconteceu nada de errado no caminho. O tempo está muito bom, parece que finalmente tive sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230302
					],
					"speakerTitle": "Caderno escrito ordenadamente"
				},
				{
					"id": 701230302,
					"content": "Talvez eu possa tentar subir até o topo da montanha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230303
					],
					"speakerTitle": "Caderno escrito ordenadamente"
				},
				{
					"id": 701230303,
					"content": "Eu só quero tentar, se encontrar algum problema, descerei imediatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caderno escrito ordenadamente"
				}
			]
		},
		{
			"id": 7012304,
			"completionStepIds": [
				7012304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7012303",
							"3"
						],
						"stepId": 7012303,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230401,
					"content": "Uma nevasca chegou rapidamente enquanto eu subia. Só tive tempo de me esconder dentro dessa caverna, e acabei perdendo mais da metade dos meus suprimentos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230402
					],
					"speakerTitle": "Caderno Rabiscado"
				},
				{
					"id": 701230402,
					"content": "Além disso, não sei por que, mas a entrada da caverna desmoronou. Isso é realmente terrível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230403
					],
					"speakerTitle": "Caderno Rabiscado"
				},
				{
					"id": 701230403,
					"content": "Mas creio que ainda exista uma alternativa... Há uma outra saída da caverna por um precipício. Embaixo dele há uma camada grossa de neve, se eu conseguir descer um pouco, talvez possa pular nela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230404
					],
					"speakerTitle": "Caderno Rabiscado"
				},
				{
					"id": 701230404,
					"content": "Os suprimentos não vão durar muitos dias, preciso fazer algo rápido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230405
					],
					"speakerTitle": "Caderno Rabiscado"
				},
				{
					"id": 701230405,
					"content": "Eu prometi que levaria Joel para ver a neve, não posso quebrar essa promessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230406
					],
					"speakerTitle": "Caderno Rabiscado"
				},
				{
					"id": 701230406,
					"content": "Se alguém encontrar esse caderno, por favor coloque comida naquele recipiente e chame as raposas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230407
					],
					"speakerTitle": "Caderno Rabiscado"
				},
				{
					"id": 701230407,
					"content": "Quando fiquei preso aqui, elas me acompanharam o tempo inteiro. Se fosse possível, eu gostaria de trazer Joel para ver elas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caderno Rabiscado"
				}
			]
		},
		{
