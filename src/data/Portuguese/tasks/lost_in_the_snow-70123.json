			},
			"dialogs": [
				{
					"id": 701230201,
					"content": "Tudo está indo bem até agora. O tempo está bom, temos bastante suprimentos, e os monstros não estão fazendo encrenca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230202
					],
					"speakerTitle": "Caderno escrito ordenadamente"
				},
				{
					"id": 701230202,
					"content": "Além disso, acabei descobrindo dentro de minha bolsa o sexto volume de A Princesa Javali. Ah Joel... Com certeza foi esse garoto que o colocou sorrateiramente dentro dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230203
					],
					"speakerTitle": "Caderno escrito ordenadamente"
				},
				{
					"id": 701230203,
					"content": "A história desse livro conta sobre a Princesa Javali e seus amigos escalando uma montanha coberta de neve... Mas como eu estou escalando a Montanha Nevada, e essa escalada não é fácil, creio que Joel colocou esse livro para dar boa sorte. Muito obrigado, Joel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230204
					],
					"speakerTitle": "Caderno escrito ordenadamente"
				},
				{
					"id": 701230204,
					"content": "Resumindo, estou me preparando para partir para o acampamento. Vou repor meus suprimentos nele, registrar a situação e então descerei a montanha. Creio que Joel ainda esteja esperando por mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caderno escrito ordenadamente"
				}
			]
		},
		{
			"id": 7012303,
			"completionStepIds": [
				7012303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
