			},
			"dialogs": [
				{
					"id": 701230101,
					"content": "Para onde meu pai foi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230102
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230103
					]
				},
				{
					"id": 701230103,
					"content": "Ah... Oi. Eu não consigo encontrar o meu pai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230104
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230104,
					"content": "Ele disse que me levaria até a Montanha Nevada para ver a neve. Mas o dia que ele prometeu chegou, e ainda assim ele não veio me buscar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230105
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230105,
					"content": "Ele deve ter descoberto algo muito importante, como um Mapa do Tesouro, por isso não veio me buscar. Deve ser isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230106
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230106,
					"content": "Então eu vim sozinho para a Espinha do Dragão. Se ele não vier me procurar, então irei procurá-lo... Ou pelo menos, assim eu pensei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230107
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230107,
					"content": "Mas quando cheguei aqui, não o encontrei. Aquele tio dos Cavaleiros de Favonius disse que iria subir a montanha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230108
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230108,
					"content": "Eu quero ir procurar pelo meu pai, mas o tio dos Cavaleiros de Favonius não me deixa ir. Só me resta ficar aqui esperando meu pai retornar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230109
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230109,
					"content": "Mas... Mas ele não voltou até agora, estou muito preocupado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230110
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230110,
					"content": "Se você vai entrar na Montanha Nevada, pode procurar ele para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230111,
						701230112
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230111,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230113
					]
				},
				{
					"id": 701230113,
					"content": "Você quer me ajudar, ótimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230114
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230114,
					"content": "Deixe-me pensar... Aquele tio dos Cavaleiros de Favonius disse que papai mencionou que <color=#00E1FFFF>iria seguir para o Caminho da Neve</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230115
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230115,
					"content": "Depois ele disse que iria para <color=#00E1FFFF>para a encosta leste da Montanha Nevada</color> dar uma olhada nos arredores. Depois meu pai disse que iria para <color=#00E1FFFF>o topo da montanha</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230116
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230116,
					"content": "Por favor, vá até esses lugares e procure por ele. Ele deve estar nas redondezas de um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230117
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230117,
					"content": "Ele fez uma promessa de ver a neve junto comigo, e ele tem que manter essa promessa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230112,
					"content": "Onde devo procurar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230113
					]
				}
			]
		},
		{
			"id": 7012302,
			"completionStepIds": [
				7012302
