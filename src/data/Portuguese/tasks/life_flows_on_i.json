			},
			"dialogs": [
				{
					"id": 414210501,
					"content": "Veja, algo caiu ali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210502,
					"content": "Sem água... Endora... Vai morrer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210503
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210503,
					"content": "Endora... Esse é o seu nome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210504,
					"content": "O sabor amargo... Faz mal. Vai matar Endora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210505
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210505,
					"content": "Bem, hum, então o que podemos fazer para salvar você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210506,
					"content": "Preciso de... Água fresca. Devo ir até... Uma nascente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210507
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210507,
					"content": "Endora... Vive na água. Sem água... Sem lugar para ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210508
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210508,
					"content": "Como vamos levá-la até uma nascente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210509,
					"content": "Temos uma garrafa bem aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210510
					]
				},
				{
					"id": 414210510,
					"content": "Mas a água nela está amarga, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210511,
					"content": "Endora... Consegue aguentar. Mas não... Por muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210512
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210512,
					"content": "Não podemos perder tempo. Vamos encontrar logo uma nascente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210513,
					"content": "Eudora fez uma longa viagem nas costas de um Slime Hydro. Bem parecido com nossa história, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
