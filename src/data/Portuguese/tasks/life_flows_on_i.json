			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Connor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210201,
					"content": "Vocês são as pessoas enviadas pela Guilda de Aventureiros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210202
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210202,
					"content": "Somos nós!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210203,
					"content": "Ah, então posso me acalmar. Quanto a este problema, é melhor verem com seus próprios olhos para entenderem a situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210204
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210204,
					"content": "A água nesta garrafa foi coletada recentemente. Não se preocupem, ela foi purificada. Podem bebê-la sem problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210205
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210205,
					"content": "Oh, oh, Paimon também quer, Paimon quer experimentar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210206,
					"content": "(Vamos tomar um gole...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210207
					]
				},
				{
					"id": 414210207,
					"content": "Ugh! Blergh! Que amargo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210208,
					"content": "O gosto amargo não pode ser removido por processos de purificação convencionais. Portanto, não é uma questão de composição da água. Suspeito que seja algum fenômeno elemental misterioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210209
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210209,
					"content": "Esta água não pode ser usada para fazer vinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210210
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210210,
					"content": "Deve ser muito ruim para os peixes que vivem aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210211,
					"content": "Tentamos cozinhar os peixes que morreram nessas águas. A comida que preparamos ficou amarga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210212
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210212,
					"content": "Paimon... Não tinha pensado nisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210213,
					"content": "Esse é o resumo da situação. Quanto a pistas sobre o que pode ter acontecido, acho que você deve investigar ao norte. Além disso, gostaria de saber como estão o Rio Bishui e as águas da Vila Qingce em Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Connor"
				}
			]
		},
		{
			"id": 4142105,
			"completionStepIds": [
				4142105
			],
