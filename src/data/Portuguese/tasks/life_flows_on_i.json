				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Velho Finch"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210701,
					"content": "... Oh, e quem é você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210702
					],
					"speakerTitle": "Velho Finch"
				},
				{
					"id": 414210702,
					"content": "Ah, espere um pouco, Endora. Você não pode sair correndo sozinha assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210703,
					"content": "Eu sou Endora. Uma fada dos mananciais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210704
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210704,
					"content": "Ah, certo! Aquele velhinho realmente acreditava na existência de uma fada das nascentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210705,
					"content": "...Hmph.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210706
					],
					"speakerTitle": "Velho Finch"
				},
				{
					"id": 414210706,
					"content": "Você é exatamente como ela, embora um pouco menor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210707
					],
					"speakerTitle": "Velho Finch"
				},
				{
					"id": 414210707,
					"content": "Endora ainda é pequena! Endora está... Aprendendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210708
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210708,
					"content": "Sua aparência mostra que aquele encontro não foi apenas um sonho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210709
					],
					"speakerTitle": "Velho Finch"
				},
				{
					"id": 414210709,
					"content": "Ela ainda está aqui. Não sei seu nome, então ela não vai falar com Endora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210710
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210710,
					"content": "Endora... Quer falar com ela. Levar uma mensagem. O que você deseja dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210711
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210711,
					"content": "Ela sempre esteve aqui? E você pode enviar uma mensagem minha para ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210712
					],
					"speakerTitle": "Velho Finch"
				},
				{
					"id": 414210712,
					"content": "Sim. Sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210713
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210713,
					"content": "...Hmph.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210714
					],
					"speakerTitle": "Velho Finch"
				},
				{
					"id": 414210714,
					"content": "Mas já estou muito velho. Eu...",
