			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210601,
					"content": "Ali... Água fresca. Água boa... Para Endora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210602
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210602,
					"content": "A água de Endora... É boa. A água de Rhodeia... Faz mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210603
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210603,
					"content": "Hã. Pensando bem, no Vale Termal não contam uma lenda sobre uma Fada da Fonte ou algo assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210604,
					"content": "De qualquer forma, é melhor chegarmos logo a uma nascente para trocar a água amarga da garrafa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4142107,
			"completionStepIds": [
				4142107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142107",
							"2"
						],
						"stepId": 4142107,
						"stateName": "QUEST_STATE_UNFINISHED"
