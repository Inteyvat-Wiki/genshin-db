				"points": []
			},
			"dialogs": [
				{
					"id": 414210101,
					"content": "Olá, Viajante. Como vão as coisas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 414210102,
					"content": "Aconteceu algo estranho de novo, Katheryne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210103,
					"content": "Comparado com os eventos recentes, não é nada fora do comum. No entanto, pode ter um grave impacto na economia de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210104,
						414210105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 414210104,
					"content": "Do que se trata?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				},
				{
					"id": 414210106,
					"content": "Sim. Recentemente, as nascentes próximas à adega ficaram amargas sem motivo aparente. Se continuar assim, a indústria de vinhos de Mondstadt pode deixar de existir em alguns anos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 414210107,
					"content": "Fale com Connor na adega para saber mais detalhes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 414210105,
					"content": "A economia de Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				}
			]
		},
		{
			"id": 4142102,
			"completionStepIds": [
				4142102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
