					"nextDialogs": [
						414210810
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210810,
					"content": "A menos que queiram se afogar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210811,
					"content": "Vocês são solitários. Nós amamos todos. Amamos todas as pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210812
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210812,
					"content": "Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210813
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210813,
					"content": "Eh? O que está acontecendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210814,
					"content": "Um informante de Rhodeia perto do Portal de Pedra! Ela usa pequenas criaturas aquáticas como espiões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210815
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210815,
					"content": "Bem, nós vimos uma Criatura de Água Pura por aqui antes, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210816,
						414210817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210816,
					"content": "Sim, eu me lembro disso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210818
					]
				},
				{
					"id": 414210818,
					"content": "Águas poderosas se transformam em animais. Muito perigoso. Mas ao absorvê-los, aprendemos coisas novas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210819
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210819,
					"content": "Leve-me até lá. Rhodeia está inquieta. Rhodeia deixa as águas amargas. Endora aprenderá a falar claramente com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210820
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210820,
					"content": "Então você está dizendo que pode nos ajudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210821
					]
				},
				{
					"id": 414210821,
					"content": "Sim. Sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210822
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210822,
					"content": "#{NICKNAME}, vale a pena tentar. Afinal de contas, não temos outras pistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210817,
					"content": "É mesmo? Não prestei atenção.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210818
					]
				}
