			"dialogs": [
				{
					"id": 706570101,
					"content": "Olá, sou a Lizzie dos Cavaleiros de Favonius. Você deve já ter ouvido que muitas atividades divertidas serão realizadas durante o Festival da Brisa Florescente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570102,
						706570103
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706570102,
					"content": "Já ouvi falar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570104
					]
				},
				{
					"id": 706570104,
					"content": "Meu trabalho é receber os visitantes de Mondstadt, permitindo que todos desfrutem da diversão desse festival!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570105
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706570105,
					"content": "Uma vez que o local do evento pode não ser dentro da cidade, se ninguém fizer as apresentações, os visitantes perderão a oportunidade de participar em muitos jogos divertidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570106
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706570106,
					"content": "Agora, o que quero apresentar majestosamente a vocês é a \"Mira Certeira\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570107
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706570107,
					"content": "#Como diz o nome, dispare em alvos no céu! Se você for rápid{F#a}{M#o} e precis{F#a}{M#o}, obterá uma pontuação alta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570108,
						706570109
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706570108,
					"content": "Parece bem interessante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570110
					]
				},
				{
					"id": 706570110,
					"content": "Não tem problema. Marcarei a localização para você no seu mapa para ir até lá tentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570111
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706570111,
					"content": "De acordo com os pontos obtidos, também poderá obter recompensas valiosas! Independentemente de apenas jogar às vezes ou ser um perfeccionista, sempre será divertido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570112,
						706570113
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706570112,
					"content": "Isso despertou meu interesse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570114
					]
				},
				{
					"id": 706570114,
					"content": "Hehe, vá dar uma olhada primeiro! Se quiser saber mais sobre outros eventos divertidos, podem me procurar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570115
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706570115,
					"content": "Divirta-se!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706570113,
					"content": "#Obrigad{F#a}{M#o} pela apresentação.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570114
					]
				},
				{
					"id": 706570109,
					"content": "Parece um pouco difícil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570110
					]
				},
				{
					"id": 706570103,
					"content": "Primeira vez que ouço falar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570104
