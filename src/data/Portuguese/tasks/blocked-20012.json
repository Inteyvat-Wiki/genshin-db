				{
					"id": 200120201,
					"content": "Obrigada, Viajante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120202
					],
					"speakerTitle": "Myrana em Pânico"
				},
				{
					"id": 200120202,
					"content": "*Suspiro* Primeiro são os monstros, agora é esse bloqueio... Geralmente já tenho muitas coisas para fazer em casa, e agora tenho o azar de me acontecer isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120203
					],
					"speakerTitle": "Myrana em Pânico"
				},
				{
					"id": 200120203,
					"content": "Desculpe, mas será que você tem como tirar o bloqueio para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120204,
						200120205
					],
					"speakerTitle": "Myrana em Pânico"
				},
				{
					"id": 200120204,
					"content": "Tudo bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200120206
					]
				},
				{
					"id": 200120206,
					"content": "Obrigada! Espero que quando meus filhos crescerem, sejam gentis como você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Myrana em Pânico"
				},
				{
					"id": 200120205,
					"content": "Ainda tenho outro assunto para tratar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200120207
					]
				},
				{
					"id": 200120207,
					"content": "Vamos lá, por favor... Eu prometo que não vai demorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Myrana em Pânico"
				}
			]
