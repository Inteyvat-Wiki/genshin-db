			"dialogs": [
				{
					"id": 200120301,
					"content": "Muito obrigada, Viajante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120302
					],
					"speakerTitle": "Myrana em Pânico"
				},
				{
					"id": 200120302,
					"content": "Não conte a ninguém que me meti em problemas, por favor. Ou o meu marido não para de me dar sermão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120303
					],
					"speakerTitle": "Myrana em Pânico"
				},
				{
					"id": 200120303,
					"content": "Não me olhe assim... Espere até você se casar e você vai ver. Um passeio solitário é um grande luxo quando você está vivendo com alguém. Você precisa aproveitar o máximo enquanto pode.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120304
					],
					"speakerTitle": "Myrana em Pânico"
				},
				{
					"id": 200120304,
					"content": "Aqui, pegue isso. Eu colhi alguns enquanto estava fora. É muito mais barato cozinhar sozinho do que comer no Caçador de Cervos! É preciso se atentar aos detalhes para viver!",
					"roleType": "TALK_ROLE_NPC",
