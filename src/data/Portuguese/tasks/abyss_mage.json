	"talks": [
		{
			"id": 39702,
			"completionStepIds": [
				39702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39702",
							"2"
						],
						"stepId": 39702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3970201,
					"content": "A Ordem do Abismo... Inimigos da raça humana. Até mesmo os contatos mais secretos não possuem nenhuma informação deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970202
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970202,
					"content": "Dito isso, foi muito difícil, mas eu consegui achar algumas pistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970203
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970203,
					"content": "Sério? Tão rápido? Você realmente possui bons contatos, Sr. Diluc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970204,
					"content": "Pensando nisso, oh grande Sr. Arconte Anemo Barbatos - por que exatamente você precisa da ajuda de meros humanos...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970205,
					"content": "Haha... Ah, como eu posso dizer...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970206,
					"content": "\"Os Sete\", como as pessoas hoje os conhecem, foram conhecidos uma vez como \"Os Sete Arcontes\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970207,
					"content": "Cada Arconte preside a sua própria parte de Teyvat, esse é o papel de nós, os Arcontes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970208,
					"content": "Obteremos poder quando cumprimos nosso dever. Mas não gosto da ideia de \"governar\", acho que Mondstadt também não gosta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970209
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970209,
					"content": "\"Vá em frente e estabeleça uma cidade de liberdade sem regra.\" Não esquecemos o desejo de Barbatos por Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970210,
					"content": "Jean... Você é uma grande fiel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970211,
					"content": "Talvez alguém tenha ficado um pouco ocioso demais e está com preguiça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970212,
					"content": "Ah... Enfim, faz muito tempo que eu não voltava a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970213,
					"content": "Sem sombra de dúvida, agora eu sou o Arconte mais fraco entre os Sete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970214,
						3970215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970214,
					"content": "E mesmo assim você parece orgulhoso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				},
				{
					"id": 3970216,
					"content": "Oh, estou lisonjeado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970217
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970217,
					"content": "Oh, que Arconte tão humilde... Isso é uma bênção ou uma maldição?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970218
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970218,
					"content": "Mas estamos nos desviando do tópico. Voltemos ao tema em questão: O inimigo comum de toda a humanidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970219
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970219,
					"content": "Os rastros do <color=#00E1FFFF>Feiticeiro do Abismo</color> que encontramos perto do <color=#00E1FFFF>Vinhedo</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970220
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970220,
					"content": "Não podemos deixá-lo fugir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970221
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970221,
					"content": "Vamos começar a caçar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3970215,
					"content": "Suponho que seja porque você é o Deus da Cidade da Liberdade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				}
			]
		},
		{
			"id": 39704,
			"completionStepIds": [
				39704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39704",
							"2"
						],
						"stepId": 39704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3970401,
					"content": "Hum? O que é isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970402,
					"content": "Após o Feiticeiro do Abismo ser derrotado, uma certa energia começou a se dispersar do seu corpo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970403
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970403,
					"content": "Parece que serve para cortar a conexão entre o Dvalin e eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970405,
					"content": "#{NICKNAME}, você já ouviu falar da <color=#00E1FFFF>Toca do Stormterror</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970406,
						3970408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970406,
					"content": "Não sei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970407
					]
				},
				{
					"id": 3970407,
					"content": "Mas a Jean e o Sr. Diluc sabem com certeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970410
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970410,
					"content": "Depois de Dvalin acordar, ele tornou as ruínas antigas como sua toca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970411,
					"content": "Assim como a tempestade que assolou Mondstadt do resto do mundo, a entrada das ruínas também parece estar selada com uma barreira especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970412
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970412,
					"content": "Mas agora, à medida que a energia era dispersada pelo Feiticeiro do Abismo, fui capaz de entender o ritmo do fluxo da barreira de energia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970413
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970413,
					"content": "Tenho que admitir, isso soa pior do que o coro dos Hilichurls, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970414,
					"content": "Deve ser suficiente para nos ajudar a quebrar a barreira de tempestade e chegar na <color=#00E1FFFF>Toca do Stormterror</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970415
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970415,
					"content": "Então, isso quer dizer que vamos enfrentar o Dvalin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970416
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970416,
					"content": "Por mim, tanto faz... A Jean é quem deseja evitar qualquer confronto direto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970417
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970417,
					"content": "Não. Quando não há outras opções, é de minha responsabilidade decidir o nosso rumo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970418
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970418,
					"content": "Se acabar com ele é a nossa única escolha, ficarei honrada em ser o cavaleiro a liderar o ataque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970419
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970419,
					"content": "Felizmente, ainda não chegamos a esse ponto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970420,
					"content": "Uh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970421
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970421,
					"content": "Com isso, você quer dizer que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970422
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970422,
					"content": "Quero dizer, a Lira Sagrada não é a nossa carta na manga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970423
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970423,
					"content": "#Nossa carta na manga é {M#o}{F#a} {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970424
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970424,
					"content": "#{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970425,
						3970427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970425,
					"content": "Foi por causa que eu purifiquei o Cristal de Lágrima?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970426
					]
				},
				{
					"id": 3970426,
					"content": "Sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970430,
					"content": "As impurezas nas lágrimas e a maldição que liga Dvalin pertencem ao mesmo poder maléfico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970431
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970431,
					"content": "Por isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970432
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970432,
					"content": "Bardo Desafinado, isso é muito perigoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970433,
					"content": "#Você já viu como era o Dvalin enfurecido! {NICKNAME} será engolid{M#o}{F#a} antes de agir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970434,
						3970435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970434,
					"content": "Eu já disse que eu consigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970436
					]
				},
				{
					"id": 3970436,
					"content": "... Ei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970437
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970437,
					"content": "Ótimo plano, vale a pena tentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970438
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970438,
					"content": "#Estou com você, Cavaleir{M#o}{F#a} Honorável!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970439
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970439,
					"content": "Ah, então nossos adversários são... Monstros do Abismo, e um dragão! Sem pressão e tal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970440,
					"content": "Nós humanos temos nosso orgulho e coragem. Preparem suas armas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970441
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970441,
					"content": "E então,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970442
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970442,
					"content": "As proezas dos heróis finalmente chegaram à etapa final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970435,
					"content": "Nós temos que dar tudo de nós para conseguirmos vencer essa batalha!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970436
					]
				},
				{
					"id": 3970427,
					"content": "#É porque eu sou muito poderos{F#a}{M#o}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970428
					]
				},
				{
					"id": 3970428,
					"content": "#Bem... Claro, o poder de {NICKNAME} é muito forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970429
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970429,
					"content": "Mas você possui pontos essenciais muito mais importantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970408,
					"content": "Acho que eu já ouvi as pessoas falando disso em Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970409
					]
				},
				{
					"id": 3970409,
					"content": "Eu acredito que todas as pessoas de Mondstadt já ouviram falar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970410
					],
					"speakerTitle": "Venti"
				}
			]
		}
	]
}