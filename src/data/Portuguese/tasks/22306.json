					"content": "Sim, por favor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060302
					]
				},
				{
					"id": 223060302,
					"content": "Bem, vou marcar os locais para você agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060303
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223060303,
					"content": "Tenha cuidado, quando encontrar o tesouro, lembre-se de trazer de volta para dividirmos.",
					"roleType": "TALK_ROLE_NPC",
