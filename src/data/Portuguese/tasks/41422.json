					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220101,
					"content": "Falei com Rhodeia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220102
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220102,
					"content": "Ela é a Oceanid mais famosa e mais forte entre nós. Mas fugiu de Fontaine porque se importava muito com o antigo Arconte Hydro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220103
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220103,
					"content": "Não posso mais voltar para Fontaine, então deixe-me contar tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220104
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220104,
					"content": "No passado, nós Oceanids vivíamos entre os rios, riachos e lagoas de todo o continente. Na maior parte do tempo, éramos como informantes de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220105
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220105,
					"content": "Informantes? O que o Arconte Hydro estava planejando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220106,
					"content": "O antigo Arconte não tinha nenhum plano. Ela apenas desejava conectar todos os seres do mundo, da mesma forma que todas as águas estão conectadas. Mas após seu falecimento, muitas Oceanids cortaram os laços com Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220107
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220107,
					"content": "Assim como Rhodeia, a mais forte de nosso grupo, elas não aceitaram o novo Arconte Hydro e queriam apenas manter vivos os seus antigos sonhos. Rhodeia buscava apenas águas tranquilas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220108
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220108,
					"content": "Mas ela sentiu minha presença e pensou que eu era uma assassina de Fontaine. Ela tornou as águas amargas para tentar me matar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220109
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220109,
					"content": "Mas você era tão pequena e fraca quando nos conhecemos. Ela realmente precisava fazer tanto esforço assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220110,
					"content": "Nossa consciência dominante pode ser facilmente corrompida se entrarmos em contato com outra consciência menor, mas perversa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220111
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220111,
					"content": "Eu sentia muita falta de Rhodeia, então peguei carona em um Slime Hydro e pulei de nascente em nascente, viajando de Fontaine até aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220112
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220112,
					"content": "Difícil imaginar que uma Oceanid seria tão determinada assim se não estivesse em uma missão de assassinato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220113
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220113,
					"content": "É mesmo impressionante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220114,
					"content": "#Mas comparado a Paimon, que está percorrendo todas as Sete Nações com {NICKNAME}, você ainda tem um longo caminho a andar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220115,
					"content": "Oh, pare com isso, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220116
					]
				},
				{
					"id": 414220116,
					"content": "Eu já esclareci a situação com ela. O sabor amargo na água deve desaparecer em breve. No final, ela me perguntou se eu queria me unir as águas da Vila Qingce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220117
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220117,
					"content": "Então você veio aqui se despedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220118,
					"content": "Eu ainda tenho uma mensagem que preciso transmitir. Vocês poderiam me acompanhar até o Vale Termal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Endora"
				}
			]
		},
		{
			"id": 4142202,
			"completionStepIds": [
				4142202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142202",
							"2"
						],
						"stepId": 4142202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Velho Finch"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220201,
					"content": "Finch, Finch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220202
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220202,
					"content": "Ai! Quase que você me mata de susto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220203
					],
					"speakerTitle": "Velho Finch"
				},
				{
					"id": 414220203,
					"content": "Endora aprende muito rápido! É de se esperar que tenha lhe assustado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220204,
					"content": "Não foi isso. É que quando chamou meu nome, pensei que era ela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220205
					],
					"speakerTitle": "Velho Finch"
				},
				{
					"id": 414220205,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220206,
					"content": "\"Todo dia há uma criança que cambaleava em frente. Queria ver tudo que existia no mundo. Tudo que ela viu acabou transformando-se no que ela é\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220207
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220207,
					"content": "\"Essa criança cambaleava em frente, e seguiu toda a vida assim\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220208
					],
					"speakerTitle": "Velho Finch"
				},
				{
					"id": 414220208,
					"content": "Conheço esse poema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220209
					],
					"speakerTitle": "Velho Finch"
				},
				{
					"id": 414220209,
					"content": "As diferenças entre nossa vida e a de vocês é muito grande. Por isso, enquanto estamos vivendo, não é possível se compreender mutuamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220210
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220210,
					"content": "Mas nossa vida também possuem similaridades. Sempre damos boas-vindas às novas coisas e novas partes dela até chegar ao mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220211
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220211,
					"content": "Por isso ela disse: \"Quando todas as luzes das estrelas no céu noturno desaparecerem, todas as correntes e todos os sonhos entrarão em um grande mar. Quando isso acontecer, nós finalmente nos despediremos.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220212
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220212,
					"content": "...Hmph.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220213
					],
					"speakerTitle": "Velho Finch"
				},
				{
					"id": 414220213,
					"content": "O fluxo da vida é sempre seguir em frente. Por favor, sempre siga em frente, nunca pare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220214
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220214,
					"content": "Hahaha, como era de se esperar dela. Mas fala comigo como se eu ainda fosse uma criança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220215
					],
					"speakerTitle": "Velho Finch"
				},
				{
					"id": 414220215,
					"content": "Está bem, agora eu quero ficar um pouco só.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220216
					],
					"speakerTitle": "Velho Finch"
				},
				{
					"id": 414220216,
					"content": "#Bem, {NICKNAME}, nós deveríamos ir encontrar Connor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4142203,
			"completionStepIds": [
				4142203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
