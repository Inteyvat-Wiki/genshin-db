				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Connor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220301,
					"content": "Oh, vocês vieram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220302
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414220302,
					"content": "Já que foram vocês que lidaram com o assunto, creio que ele deva ter sido perfeitamente resolvido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220303,
						414220304
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414220303,
					"content": "Claro que sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220305
					]
				},
				{
					"id": 414220305,
					"content": "O sabor amargo nas águas deve desaparecer dentro de alguns dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220306,
					"content": "Oh, entendo. Como vocês eliminaram a causa do problema, é preciso esperar um tempo até que a água se purifique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220307
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414220307,
					"content": "Entrarei em contato com a Guilda de Aventureiros para encerrar essa questão. Agradeço-lhes muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Connor"
				},
				{
					"id": 414220304,
					"content": "Encontramos algumas dificuldades no caminho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220305
					]
				}
			]
		},
		{
			"id": 4142204,
			"completionStepIds": [
				4142204
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142204",
							"2"
						],
						"stepId": 4142204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220401,
					"content": "A forma que minha espécie demonstra afeição é fundindo os corpos de água em um. Com isso, múltiplas consciências podem se entender mutuamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220402
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220402,
					"content": "Mas, para entender as outras criaturas vivas nesta terra não é tão simples assim. Por causa disto, nós observamos, pesquisamos, copiamos, e nos metamorfoseamos à sua aparência. Pode-se dizer que a aparência delas transformou-se em parte de nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220403
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220403,
					"content": "Vendo as águas do rio correrem, Endora começou a pensar profundamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220404,
					"content": "Antes eu nunca havia pensado sobre como seria meu futuro. Antes sempre pensava que me unir a Rhodeia seria o suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220405
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220405,
					"content": "Mas Rhodeia não parece feliz. Ela entende que só está aguardando a água limpa ser contaminada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220406,
						414220407
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220406,
					"content": "Então, qual será sua escolha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220408
					]
				},
				{
					"id": 414220408,
					"content": "Nem Rhodeia ou aquela que vive no Vale Termal parecem querer que eu siga o caminho delas. Mas elas com certeza detestam ainda mais a vida em Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220409
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220409,
					"content": "A vida de vocês é muito estranha. Não tenho nenhum conselho útil para lhe dar. Entretanto, Paimon crê que não há nada melhor que viver uma vida feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220410,
					"content": "Portanto, decidi que escolherei um caminho que ninguém fez ainda. Viajar com vocês me deixou muito feliz. Quero sentir essa felicidade todos os dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220411
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220411,
					"content": "Eu quero viajar com vocês. Ver como crescem as flores nas margens dos rios, ver o sol se pondo no horizonte antes da vida chegar até o mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220412,
						414220413
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220412,
					"content": "Você é bem-vinda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220415
					]
				},
				{
					"id": 414220415,
					"content": "#Entretanto, o privilégio de viajar com {NICKNAME} pelas Sete Nações é exclusivo de Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220413,
					"content": "Que tal substituir Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220414
					]
				},
				{
					"id": 414220414,
					"content": "Ei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220407,
					"content": "Então, você vai rejeitá-la?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
