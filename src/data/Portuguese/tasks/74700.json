			"dialogs": [
				{
					"id": 747000101,
					"content": "Hehe, Paimon tá se divertindo de montão enchendo esse aquário!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000102,
					"content": "Já que Sandrone não se importa, a gente devia com certeza pegar mais alguns peixinhos e deixar esse lugar ainda mais bonito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000103,
					"content": "Ei, vocês aí. Venham aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000104,
					"content": "Hã? Tá tudo bem...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000105,
					"content": "Aqui, isso é pra vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000106,
					"content": "...O que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000107,
					"content": "É um dispositivo de mobilidade subaquática que eu estava desenvolvendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000108,
					"content": "Hã!? Uau, que gentil da sua parte, Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000109,
					"content": "É só um dispositivo mecânico simples. Vi o jeito que vocês estavam pegando peixes e, como devo dizer... parecia meio... rudimentar. Para ser completamente honesta, achei terrível de assistir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000110,
					"content": "F-Foi mesmo tão ruim assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000111,
					"content": "Foi ineficiente, sem nenhuma maestria e completamente deselegante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000112,
					"content": "Sinto... muito que fizemos você passar por isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000113
					]
				},
				{
					"id": 747000113,
					"content": "Não precisa se desculpar. Cada um tem seu jeito de fazer as coisas. Mas já que vocês pretendem continuar expandindo o aquário, seria melhor usar este dispositivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000114,
					"content": "As águas de Fontaine abrigam mais do que apenas peixes ornamentais inofensivos. Há muitos predadores que podem machucar vocês de verdade. Este dispositivo não vai somente ajudar vocês a pescar, mas também a fugir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000115,
						747000116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000115,
					"content": "#Muito obrigad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				},
				{
					"id": 747000117,
					"content": "Certo. Se você for nadar, vá agora. E não se esqueça de me dizer o que achou do dispositivo. Posso fazer mais ajustes se você tiver algum comentário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000116,
					"content": "Vou usar com certeza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				}
			]
		}
	]
}