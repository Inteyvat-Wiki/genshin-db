			"dialogs": [
				{
					"id": 120004501,
					"content": "Muito obrigado, já vejo uma esperança para o meu negócio de minérios novamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120004502
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 120004502,
					"content": "Não fui muito educado com vocês antes - realmente sinto muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang, o Nono"
				}
			]
		},
		{
			"id": 1200304,
			"completionStepIds": [
				1200304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200304",
							"2"
						],
						"stepId": 1200304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030401,
					"content": "Bem-vindos. O final deste drama não estaria completo sem vocês aqui como público.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030402
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030402,
					"content": "É muito fácil de dizer! Somos nós que temos feito todo o trabalho! O que exatamente você tem feito esse tempo todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030403,
					"content": "Ah, bem... Naturalmente, eu usei o tempo para mergulhar completamente na lenda da Alabarda Fragmentada. Consegui terminar o livro e aproveitei cada minuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030404
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030404,
					"content": "Alabarda Divina e Espada Ominosa, Mir e Weiyang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030405
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030405,
					"content": "Posso dizer que a maneira como a história se desenvolve nos cinco primeiros volumes é mágica. Mas quanto ao sexto volume... me falta a palavra certa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030426
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030426,
					"content": "Somos abençoados em termos um autor assim que honra nosso mundo com suas obras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030427
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030427,
					"content": "Mas o que isso tem a ver com o Burguês Maocai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030406,
					"content": "Não tem nada a ver. Hoje em dia é muito raro encontrar algo fora da expectativa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030407,
						120030409
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030407,
					"content": "Você conseguiu prever tudo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030408
					]
				},
				{
					"id": 120030408,
					"content": "E graças à sua ajuda que tudo vai dar certo, como eu havia previsto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030411
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030411,
					"content": "Parece que só a Paimon não está entendendo o que está acontecendo? Não é justo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030412,
					"content": "Então, diga-me. O que está fazendo aqui？ E que espetáculo vai acontecer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030413,
					"content": "Pense nisso. O Burguês Maocai foi em busca de Cor Lapis por todos os cantos de Liyue e não encontrou nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030414
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030414,
					"content": "Ele entra em pânico - sem as mercadorias, ele não pode cumprir seu contrato. E se ele não pode cumprir seu contrato, ele não pode ficar em boa posição com os Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030415
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030415,
					"content": "Ele ficou em pânico após escutar o nome da Guilda de Comerciantes de Feiyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030416
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030416,
					"content": "O Burguês Maocai é uma figura extremamente poderosa no mundo dos negócios. Ninguém nunca se atreveu a desafiá-lo assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030417
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030417,
					"content": "Portanto, independentemente de se tratar de vingança ou resolução rápida, ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030418
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030418,
					"content": "Então eram vocês! Vocês estavam protegendo o Chang, o Nono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030419
					],
					"speakerTitle": "Maocai Burguês"
				},
				{
					"id": 120030419,
					"content": "Falando no diabo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030420
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030420,
					"content": "Eu fui a todos os lugares tentando encontrar alguém vendendo Cor Lapis antes de perceber que a Guilda de Comerciantes de Feiyun estava em uma onda de aquisições!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030421
					],
					"speakerTitle": "Maocai Burguês"
				},
				{
					"id": 120030421,
					"content": "Cor Lapis não é um mineral raro e, de repente, os estoques se acabam do nada! Expliquem-se! Quais são suas intenções?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030422
					],
					"speakerTitle": "Maocai Burguês"
				},
				{
					"id": 120030422,
					"content": "Não estamos perseguindo você, mas protegendo outra pessoa com a qual estou em dívida. Ao testemunhar uma injustiça, é uma resposta perfeitamente normal oferecer ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030423
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030423,
					"content": "Não foi um dos seus homens que disse... que isso ainda não acabou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030424
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030424,
					"content": "Hunf, claramente você não sabe o que é bom para você. Não vou gastar saliva com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030425
					],
					"speakerTitle": "Maocai Burguês"
				},
				{
					"id": 120030425,
					"content": "Mestre, por favor, leve todos os Cor Lapis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maocai Burguês"
				},
				{
					"id": 120030409,
					"content": "O final do livro é bom?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030410
					]
				},
				{
					"id": 120030410,
					"content": "Foi muito bom, obrigado... Só espero que o final do nosso plano corresponda às nossas expectativas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030411
					],
					"speakerTitle": "Xingqiu"
				}
			]
		},
		{
			"id": 1200306,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
