			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang, o Nono"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030901,
					"content": "Finalmente, você voltou! Esta manhã, o penhorista apareceu e me devolveu toda a minha coleção!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030902
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 120030902,
					"content": "Estou certo de que você deve estar por trás disso mais uma vez. Obrigado, obrigado do fundo do meu coração!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030903,
						120030904
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 120030903,
					"content": "De nada. Fico feliz por ter ajudado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030905
					]
				},
				{
					"id": 120030905,
					"content": "Por favor, não diga isso, você não tem ideia do quanto isso significa para mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030906
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 120030906,
					"content": "A família Chang era uma família de prestígio em Liyue no passado. Infelizmente, depois que assumi os negócios da família como herdeiro, uma série de contratempos devorou nossa fortuna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030907
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 120030907,
					"content": "Desde então, economizo há anos na esperança de restaurar a casa à sua antiga glória... No final, tudo estava funcionando de acordo com o Cor Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030908
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 120030908,
					"content": "Eu morreria nesta área vazia nas montanhas sem a ajuda de vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030909
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 120030909,
					"content": "Uau, é o segundo herdeiro que conhecemos na cidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030910,
					"content": "Desculpe, o quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030911
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 120030911,
					"content": "...Ugh, nada! Oh - aqui está seu livro de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030912,
					"content": "Oh! Lenda da Alabarda Fragmentada, comecei a pensar que aquele Nerd de Guhua não ia devolver este livro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030913
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 120030913,
					"content": "As pessoas menosprezam tanto assim o Clã de Guhua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030914,
					"content": "Na verdade, a arte tem séculos de idade e já foi muito respeitada, mas agora está quase ficando irreconhecível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030915
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 120030915,
					"content": "Para instigar um reavivamento, você precisa de gente nova. Mas é difícil atrair jovens talentos para uma arte que está morrendo... E isso se torna um ciclo vicioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030916
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 120030916,
					"content": "Hoje em dia, os jovens de Guhua, por exemplo Xingqiu... Ele sempre fala em retribuir, mas no fim foram vocês que assumiram a responsabilidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030917,
						120030918
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 120030917,
					"content": "Ele é melhor do que parece.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030919
					]
				},
				{
					"id": 120030919,
					"content": "Ah, o que isso importa? Enfim, você queria o volume Liyue do Guia de Viagem Teyvat, não queria? Eu peguei para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030920
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 120030920,
					"content": "É para vocês, não precisam devolver. Além disso, é apenas uma pequena demonstração de agradecimento aos seus esforços.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030921,
						120030922
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 120030921,
					"content": "Finalmente. Nossa viagem valeu a pena no final das contas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030923
					]
				},
				{
					"id": 120030923,
					"content": "Conseguimos vender os minérios, e o meu livro favorito regressou, é incrível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030924
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 120030924,
					"content": "Quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030925
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 120030925,
					"content": "O que foi? A Paimon viu que caiu alguma coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030926,
					"content": "Uh. Nada não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030927
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 120030927,
					"content": "(Aquele patife... deve ser...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 120030922,
					"content": "Eu quase me esqueci disso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030923
					]
				},
				{
					"id": 120030918,
					"content": "Talvez o renascimento de Guhua esteja mesmo prestes a acontecer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030919
					]
				},
				{
					"id": 120030904,
					"content": "Na verdade, não fomos nós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030905
					]
				}
			]
		}
	]
}