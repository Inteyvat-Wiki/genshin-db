				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030601,
					"content": "Não se deixe levar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030602
					],
					"speakerTitle": "Agente de Dívidas"
				},
				{
					"id": 120030602,
					"content": "Ah! Esse cara parece muito perigoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1200308,
			"completionStepIds": [
				1200308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200308",
							"2"
						],
						"stepId": 1200308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030801,
					"content": "Impressionante. Vocês não são plebeus... Continuar essa luta seria sofrer mais perdas do que eu posso aceitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030802
					],
					"speakerTitle": "Agente de Dívidas"
				},
				{
					"id": 120030802,
					"content": "Eles estão sem força! Continuem! Os Cor Lapis estão quase no nosso alcance!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030803
					],
					"speakerTitle": "Maocai Burguês"
				},
				{
					"id": 120030803,
					"content": "Devo lembrá-lo que o relacionamento dos Fatui com você se estende apenas a assuntos comerciais! Não emprestei meus homens para causarem problemas por sua causa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030804
					],
					"speakerTitle": "Agente de Dívidas"
				},
				{
					"id": 120030804,
					"content": "O... o que você está dizendo? Mestre, tudo que eu fiz foi com uma única coisa em mente, cumprir a ordem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030805
					],
					"speakerTitle": "Maocai Burguês"
				},
				{
					"id": 120030805,
					"content": "Então tente resolver por si mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030806
					],
					"speakerTitle": "Agente de Dívidas"
				},
				{
					"id": 120030806,
					"content": "N... Não vá! Espere, Mestre! Espeeeeere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030807
					],
					"speakerTitle": "Maocai Burguês"
				},
				{
					"id": 120030807,
					"content": "Jovem mestre! O que você está fazendo aqui, você está ferido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030808
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 120030808,
					"content": "#Graças {M#ao}{F#à} {NICKNAME}, tudo correu bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030809
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030809,
					"content": "Meu Senhor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030810,
						120030811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030810,
					"content": "Meu Senhor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030812
					]
				},
				{
					"id": 120030812,
					"content": "Você... Você é o herdeiro da Guilda dos Comerciantes de Feiyun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030813
					],
					"speakerTitle": "Maocai Burguês"
				},
				{
					"id": 120030813,
					"content": "De fato, meu senhor. Sou Xingqiu, discípulo do Clã de Guhua e segundo filho do gerente da Guilda de Comerciantes de Feiyun, e não escondo isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030814
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030814,
					"content": "Droga! Eu fui enganado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030815
					],
					"speakerTitle": "Maocai Burguês"
				},
				{
					"id": 120030815,
					"content": "Burguês Maocai, coerção e intimidação não são características de um empresário respeitável. Os problemas que as suas práticas comerciais criaram eu resolvi através das minhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030816
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030816,
					"content": "Fico com calafrios só de pensar no que os Fatui farão com você se você não fornecer o Cor Lapis deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030817
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030817,
					"content": "Malditos intrometidos! Bem, diga-me, por quanto você quer vender?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030818
					],
					"speakerTitle": "Maocai Burguês"
				},
				{
					"id": 120030818,
					"content": "Como você pediu um desconto de setenta por cento, o que você acha se fizermos o mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030819
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030819,
					"content": "Três vezes o preço de mercado, justo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030820
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030820,
					"content": "Como ousa me sujeitar a tanta crueldade! Essa é uma tentativa mal-intencionada e calculada de me derrubar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030821
					],
					"speakerTitle": "Maocai Burguês"
				},
				{
					"id": 120030821,
					"content": "...Respire fundo. Esta é uma decisão simples. Você vai comprar, ou não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030822
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030822,
					"content": "Eu... Hunf, está bom, como quiser! Eu arrumarei o dinheiro de alguma forma. Feliz agora!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030823
					],
					"speakerTitle": "Maocai Burguês"
				},
				{
					"id": 120030823,
					"content": "Muito obrigado pela sua visita à Guilda de Comerciantes de Feiyun, desejo que façamos mais negócios no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030824
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030824,
					"content": "Você? O Engraçadinho, leitor de livros, discípulo de Guhua, Xingqiu... Você é o herdeiro da Guilda dos Comerciantes de Feiyun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030825,
					"content": "... Então, aquele enorme estoque de Mora que você deixou queimar em um dia, foi do seu cofre particular?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030826,
					"content": "Parece que é um negócio bem lucrativo e ao mesmo tempo podemos dar uma lição ao Burguês Maocai. Matamos dois coelhos com uma cajadada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030827,
						120030829
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030827,
					"content": "As aparências realmente podem enganar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030828
					]
				},
				{
					"id": 120030828,
					"content": "Você é muito gentil. Você tem valor em seu coração. Isso é digno de admiração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030831
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030831,
					"content": "Ah! E eu tenho te chamado de Nerd de Guhua esse tempo todo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030832
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030832,
					"content": "Paimon leu em um desses romances de artistas marciais que quando herdeiros ricos como você ficam com raiva de alguém, vocês arrancam os braços e pernas da pessoa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030833,
					"content": "E agora... e agora... Me desculpe! Me desculpe de verdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030834
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030834,
					"content": "Calma. Como você sabe voar, não precisa das pernas, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030835
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030835,
					"content": "#Uau! {NICKNAME}, ajude-me, por favor! Parece que ele está falando sério!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030836,
						120030837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030836,
					"content": "Claramente ele está só brincando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030838
					]
				},
				{
					"id": 120030838,
					"content": "Brincadeiras à parte, tenho que agradecer a vocês pela resolução bem-sucedida. Sério, vocês ajudaram muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030839
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030839,
					"content": "Enquanto isso, a Lenda da Alabarda Fragmentada foi fascinante. Eu ficaria muito agradecido se devolvesse a Chang, o Nono por mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030840
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030840,
					"content": "Você está nos mandando fazer mais uma missão?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030841
					]
				},
				{
					"id": 120030841,
					"content": "Não fiz nada demais, por isso não mereço sua gratidão. Enquanto isso, vocês, ainda que desconhecessem as circunstâncias, vieram ajudar e salvaram o dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030842
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030842,
					"content": "Ter feito amigos tão valentes e cavalheirescos é mais do que suficiente para mim, meu senhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030843
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030843,
					"content": "Meu senhor, perdoe a minha intromissão... mas é sobre o seu pai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030844
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 120030844,
					"content": "Por favor, informe meu pai assim: evitei um desastre e ganhei uma quantia considerável de dinheiro no processo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030845
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030845,
					"content": "Esse ato meritório compensaria minhas transgressões anteriores e me renderia mais alguns dias de liberdade, por acaso? A Lenda da Alabarda Fragmentada fala de um Domínio que eu gostaria muito de investigar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030846
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030846,
					"content": "As suas palavras são bonitinhas, mas no fundo, é você que não quer trabalhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030847
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030847,
					"content": "Hahaha... E se eu lhe dissesse que uma recompensa espera por você na casa de Chang, o Nono, e não apenas sua gratidão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030848
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030848,
					"content": "Uma recompensa! Err... Bem, isso muda um pouco as coisas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030849
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030849,
					"content": "*Suspiro* Não importa o que eu diga, não há como convencê-lo a ficar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030850
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 120030850,
					"content": "Devia ter dito mais cedo que o Xingqiu é o herdeiro de Feiyun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030851
					]
				},
				{
					"id": 120030851,
					"content": "Ah, eu não sabia que vocês não sabiam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030852
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 120030852,
					"content": "Obrigado por ajudar a devolver o livro. Vou me despedir, vamos ver no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030837,
					"content": "Em qual livro você leu isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030838
					]
				},
				{
					"id": 120030829,
					"content": "Vocês, crianças ricas, não fazem aulas de caligrafia desde pequenas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030830
					]
				},
				{
					"id": 120030830,
					"content": "Hahaha, muito engraçado... Minha família sempre reconhece a minha caligrafia, é certamente uma das minhas características distintivas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030831
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030811,
					"content": "... Então realmente foi isso mesmo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030812
					]
				}
			]
		},
		{
			"id": 1200309,
			"completionStepIds": [
				1200309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200309",
