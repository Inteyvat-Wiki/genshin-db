			"dialogs": [
				{
					"id": 766670401,
					"content": "Isso será suficiente. Obrigada, muito obrigada! Por favor, espere só um momento — vou preparar o Banquete da Lua mais delicioso especialmente para você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670402
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670402,
					"content": "Lyylikki corre para a cozinha e se dedica com afinco a preparar o \"Banquete da Lua\"...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766670403
					]
				},
				{
					"id": 766670403,
					"content": "Está pronto. Por favor, experimente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670404
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670404,
					"content": "Obrigada mais uma vez pela ajuda. Da próxima vez que estiver com fome, venha me visitar. Prepararei uma porção especial só para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
