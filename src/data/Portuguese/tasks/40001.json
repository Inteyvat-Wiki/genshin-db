			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010201,
					"content": "Finalmente, chegamos em <color=#00E1FFFF>Liyue</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010202,
					"content": "Com licença, jovem, o que é essa coisa curiosa flutuante que fica orbitando em sua volta? E quanto custa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010203,
						400010205
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010203,
					"content": "Não importa o quanto ofereça, não está à venda!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010204
					]
				},
				{
					"id": 400010204,
					"content": "Não importa o quanto ofereça, não está à venda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010209,
					"content": "Hahaha... Na verdade estou passando por dificuldades financeiras agora. Então, quanto quer que seja o custo, eu provavelmente não conseguiria pagar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010210
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010210,
					"content": "Sou apenas um comerciante comum e não trabalho com tesouros exóticos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010211
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010211,
					"content": "Você sabe que, quanto mais você fala, mais suspeito você se torna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010212,
					"content": "Alguém está de mal humor hoje, hein? Aqui, pegue, será que algumas balas podem deixar você melhor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010213
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010213,
					"content": "#... Suspeitosamente confiável! {NICKNAME}, esqueça o que eu disse. Acho que essa pessoa é de confiança!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010214,
					"content": "Enfim, vocês vão vir para o Ritual de Lanternas de Liyue, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010215
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010215,
					"content": "A Lanterna Mingxiao deste ano vai ser um espetáculo. A Plaustrite que levantará a lanterna aos céus é a maior em vinte anos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010216
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010216,
					"content": "É grande o suficiente para fazer você se perguntar... Se a lendária cidade flutuante nas nuvens realmente existe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010217
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010217,
					"content": "... Então provavelmente é apenas porque é sustentada por uma Plaustrite de tamanho semelhante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010218
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010218,
					"content": "Parece ótimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010219,
					"content": "Haha, espero cruzar com você de novo. Sejam bem-vindos a Liyue! Bem, não posso falar por todo <color=#00E1FFFF>Liyue</color>, mas pelo menos em minha loja vocês serão sempre bem-vindos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010205,
					"content": "Confia em mim, você não consegue pagar pelo preço.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010206
					]
				},
				{
					"id": 400010206,
					"content": "Muito suspeito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010207,
					"content": "Mas estou curiosa agora, qual é o valor que você tem em mente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010208,
					"content": "Ugh, esqueça. Vou assumir que a Paimon custa mais do que a Mora consegue pagar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4000103,
			"completionStepIds": [
				4000103
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000103",
							"2"
						],
						"stepId": 4000103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010301,
					"content": "#Veja, {NICKNAME}, aquela pedra acorrentada está flutuando no ar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010302,
					"content": "Se não estivesse bem amarrada, não consigo imaginar para onde voaria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010303,
					"content": "Essa é a Pedra de Plaustrite a ser usada na Lanterna Mingxiao. Todo o Mercado Xiao está centrado ao redor dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010304
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010304,
					"content": "Olá, quem é você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010305,
					"content": "Eu me chamo Jiangzhou. Recentemente estou encarregada de rastrear o progresso da fabricação da Lanterna Mingxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010306
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010306,
					"content": "Parece que é a primeira vez que vocês vêm para o Ritual da Lanterna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010307
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010307,
					"content": "Sim... Como você sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010308,
					"content": "Bem, não me lembro de ter visto nenhum mascote estranho no festival do ano passado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010309
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010309,
					"content": "Estou à disposição para responder quaisquer perguntas sobre o festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010310
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010310,
					"content": "O que é a Lanterna Mingxiao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010311
					]
				},
				{
					"id": 400010311,
					"content": "Vocês verão muitas pessoas soltando lanternas durante o festival, chamadas de Lanterna Celeste. Contudo, há também uma gigante - um esforço de todas as pessoas do Porto de Liyue. Essa é chamada de Lanterna Mingxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010312
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010312,
					"content": "Quase todos os negócios em Liyue têm um estande no Mercado Xiao - mas, apesar de sua popularidade, é a única época do ano em que eles não querem lucrar. O mercado de rua existe apenas para angariar fundos e materiais necessários para a construção da Lanterna Mingxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010313
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010313,
					"content": "Se vocês quiserem, vocês podem vir ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010314
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010314,
					"content": "O que temos para nós?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010315,
					"content": "A Lanterna Mingxiao honrará os seus esforços. Na primeira lua cheia do ano, nos despedimos do velho para receber o novo. Então seus desejos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010316
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010316,
					"content": "Tudo bem, mas eu estava à espera de algo mais substancial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010317,
					"content": "*Suspiro* Que pragmático! Sim, precisamos manter os pés no chão, mas não podemos também admirar as estrelas? Nesta vida, você deve manter o seu lado infantil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010318
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010318,
					"content": "Em outras palavras, qualquer um que ajudar com a Lanterna Mingxiao, ganha algo do <color=#00E1FFFF>Mercado Xiao</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010319
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010319,
					"content": "Quer que dizer que se ajudarmos, teremos algo para comer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010320,
					"content": "#{NICKNAME}, temos que ajudar! Devemos perguntar às pessoas ao redor do <color=#00E1FFFF>Mercado Xiao</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4000106,
			"completionStepIds": [
				4000106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000106",
							"2"
						],
						"stepId": 4000106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010601,
					"content": "A Lanterna Mingxiao deste ano é projetada em homenagem do Mestre dos Céus Transcendentes! Ele vai ficar muito contente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010602,
						400010611
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010602,
					"content": "Quem é o Mestre dos Céus Transcendentes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010603
					]
				},
				{
					"id": 400010603,
					"content": "A Lanterna Mingxiao em curso do Ritual de Lanternas deste ano tem a imagem do Mestre dos Céus Transcendentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010604
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010604,
					"content": "Bem, esse é o plano. Eu realmente espero que eles tornem os chifres dele grandes o suficiente, afinal eles eram seu maior orgulho e satisfação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010605
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010605,
					"content": "A história diz que os chifres foram feitos da própria essência do poder de Rex Lapis, o que o tornou o material mais resistente de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010606
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010606,
					"content": "Mas então, aconteceu a batalha decisiva... Os deuses trocaram golpes poderosos, e as montanhas começaram a entrar em colapso. Para evitar que atingissem os aldeões do monte, o Adeptus convenceu seu amigo a cortar seus chifres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010607
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010607,
					"content": "Ele usou os chifres sangrentos como ponto de apoio da montanha. E como se já não bastasse esse sacrifício, ele continuou lutando até que seu sangue foi drenado por completo e a sua vida acabou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010608
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010608,
					"content": "Graças a ele, o Monte Tianheng ainda está de pé hoje em dia. O sangue que ele perdeu na batalha acabou se transformando no Rio Bishui.",
					"roleType": "TALK_ROLE_NPC",
