				]
			},
			"dialogs": [
				{
					"id": 745140101,
					"content": "Q-Que frio... Eu não devia mesmo ter ido para o vento de bobeira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140102
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140102,
					"content": "#...Hã? {NICKNAME}! Paimon! São vo—ATCHIM!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140103
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140103,
					"content": "Asagiri? O que você tá fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140104
					]
				},
				{
					"id": 745140104,
					"content": "Você tá bem? Como veio parar tão longe sozinha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745140105,
					"content": "Eu... Bem... ok! Estou muito melhor agora! Viu, nem estou mais tossindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140106
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140106,
					"content": "Haha... ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140107,
						745140108
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140107,
					"content": "Tem certeza disso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140109
					]
				},
				{
					"id": 745140109,
					"content": "Opa! Não precisa! Eu admito, saí sozinha! Feliz agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140110
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140110,
					"content": "Eu... eu não tive escolha. Como poderia pintar belas obras se eu só ficasse em Inazuma o tempo todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140111
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140111,
					"content": "Mesmo que faça vocês saírem por aí tirando fotos para mim, fotos de referência não se comparam a ver as coisas com meus próprios olhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140112
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140112,
					"content": "Então, pedi para um sensei que já trabalhei antes para entrar em contato com um navio mercante para mim, e peguei uma carona silenciosamente com eles para que pudesse viajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140113
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140113,
					"content": "E você até trouxe todas as suas ferramentas de pintura com você...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140114
					]
				},
				{
					"id": 745140114,
					"content": "Mas é claro! A tela é minha própria alma! Como eu poderia abandoná-las?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140115
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140115,
					"content": "Além disso, minhas pinturas estão vendendo excepcionalmente bem em Fontaine. Alguns autores de Fontaine até me pediram para fazer capas para seus livros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140116
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140116,
					"content": "Embora... Aparentemente colocar ilustrações ao longo da história não é algo que façam! Realmente estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140117
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140117,
					"content": "#Ah, certo... Já que estão aqui, {NICKNAME}... Se importariam de me ajudar a coletar alguns materiais de referência?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140118,
						745140120
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140118,
					"content": "Deixa comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140119
					]
				},
				{
					"id": 745140119,
					"content": "Excelente! Com você ajudando, sei que o trabalho está praticamente concluído.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140123
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140123,
					"content": "Tudo bem, deixe-me dar uma olhada. Por acaso, recebi mais algumas comissões de alguns autores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140120,
					"content": "Tudo bem, mas não saia correndo por aí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140121
					]
				},
				{
					"id": 745140121,
					"content": "Eu sei! Não é como se eu conseguisse lidar com aqueles Mecautômatos mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140122
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140122,
					"content": "Quando o assunto é lidar com todo tipo de monstro estranho, você é a nata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140123
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140108,
					"content": "Deixe-me escrever de volta e conferir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140109
					]
				}
			]
		}
	]
}