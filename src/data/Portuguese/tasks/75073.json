					"Conulaf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750730201,
					"content": "#Oh, por favor, {M#meu herói}{F#minha heroína}, esse lugar é tão alto e tem tantos Qucussauros por aí. Você não pode me deixar sozinha aqui nessa jaula...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				}
			]
		},
