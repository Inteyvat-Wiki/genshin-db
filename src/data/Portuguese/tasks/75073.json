					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730405
					]
				},
				{
					"id": 750730405,
					"content": "#Ah, é você, {M#meu benfeitor}{F#minha benfeitora}! Eu não esperava me deparar com— Digo, ter você me salvando novamente durante nossas respectivas viagens...",
					"roleType": "TALK_ROLE_NPC",
