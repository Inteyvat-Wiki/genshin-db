				"objectNames": [
					"Conulaf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750730101,
					"content": "#Ah, {M#meu herói}{F#minha heroína}! Obrigado pela sua ajuda em... derrotar aqueles Hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730102
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730102,
					"content": "Eu só estava de pé no penhasco admirando a paisagem e um deles me golpeou. Quando acordei, já estava presa aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730103
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730103,
					"content": "Está trancado. A chave... Ah, certo, a chave está naquele baú bem ali. Posso te incomodar em pedir um favor minusculinho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730104
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730104,
					"content": "Eu seria total e eternamente grata se você pudesse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				}
			]
		},
		{
