			},
			"dialogs": [
				{
					"id": 750730301,
					"content": "*Snif* Liberdade! Finalmente, liberdade dessa prisão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730302
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730302,
					"content": "Esse balão de ar quente fica balançando de um lado a outro. Heh, quem sabe, talvez uma rajada de vento venha e sopre logo tudo abaixo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730303
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730303,
					"content": "Receio que nem a Vovó Itztli conseguiria nos salvar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730304
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730304,
					"content": "Quem é você mesmo, e como você acabou aqui em cima?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730305
					]
				},
				{
					"id": 750730305,
					"content": "Ah, sim, eu ainda não me apresentei. Me chame de Conulaf, uma sacerdotisa aprendiz dos Mestres do Vento Noturno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730306
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730306,
					"content": "Como o nome sugere, estou atualmente treinando para ser uma sacerdotisa. Fiquei dentro de nossa tribo durante toda a minha vida, então os anciões me disseram, \"por que você não sai e vai ver o mundo\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730307
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730307,
					"content": "Então, eles me chutaram da tribo com a desculpa de ser um treinamento—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730308
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730308,
					"content": "#Mesmo assim, eu não chamaria ser pega por Hilichurls o tipo bom de \"ver o mundo\", não acha, {M#meu herói}{F#minha heroína}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730309,
						750730311
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730309,
					"content": "Se aventurar é perigoso sem companhia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730310
					]
				},
				{
					"id": 750730310,
					"content": "De fato, realmente! Se não fosse por você, não sei por quanto mais tempo eu continuaria presa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730313
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730313,
					"content": "#De qualquer forma, muito obrigada por me salvar, {M#meu querido herói}{F#minha querida heroína}... Agora, após todo esse vento ao qual fui submetida, eu deveria descer antes de pensar um pouco mais sobre continuar meu treinamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730314
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730314,
					"content": "Não tenho muito comigo, mas em minha família, pagamos gentileza quando é demonstrada para nós, então deixe-me te dar isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730311,
					"content": "Bem, desde que você seja forte suficiente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730312
					]
				},
				{
					"id": 750730312,
					"content": "Heh... Temo que você não esteja me enganando com essa. Simplesmente não existem muitos aventureiros tão fortes quanto você nesse mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730313
					],
					"speakerTitle": "Conulaf"
				}
			]
		},
