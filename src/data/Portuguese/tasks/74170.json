			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bricole"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741700401,
					"content": "Você conseguiu! Parece que o desafio não é impossível, no fim das contas! Acho que posso enviar essa proposta ao Instituto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700402
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700402,
					"content": "Uma pena que não conseguimos terminar de checar todos os bens ainda, então terei que voltar aqui mais tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700403
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700403,
					"content": "Mas independentemente, obrigado pela sua ajuda! Ah, sim, e aqui está sua recompensa. Boa viagem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
