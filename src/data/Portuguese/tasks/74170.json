				"objectNames": [
					"Bricole"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741701701,
					"content": "Oh, você voltou. Bem, eu também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701702
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701702,
					"content": "Depois que o Instituto ouviu o meu relatório, me pediram para avaliar a adequação da área como um campo de treinamento de qualidade, além de conduzir o meu trabalho de recuperação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701703
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701703,
					"content": "*Suspira* De alguma forma, tudo isso é muito familiar. Eu me lembro que houve um período que nosso Escritório Administrativo estava entusiasmado em todos conduzirem treinamento de mergulho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701704
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701704,
					"content": "Pessoalmente acho que tudo isso é bem inútil, mas trabalho é trabalho, e uma missão é uma missão... Sem falar que esse lugar é bem estranho... digo, único.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701705
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701705,
					"content": "Dessa forma, eu coloquei algumas âncoras réplicas na área. Não se preocupe, são apenas bonecos. São cem por cento seguros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701706
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701706,
					"content": "Meu objetivo de treinamento atual é de <color=#00E1FFFF>recuperar todas as âncoras dentro da construção dentro do tempo limite</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701707
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701707,
					"content": "Você gostaria de tentar? Eu posso te dar uma compensação por participar — afinal de contas, você estará ajudando em uma pesquisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
		{
			"id": 7417004,
			"completionStepIds": [
				7417004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
