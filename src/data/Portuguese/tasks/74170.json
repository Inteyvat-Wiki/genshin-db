			"dialogs": [
				{
					"id": 741700217,
					"content": "Deixando o desafio de lado, e esse dispositivo aqui...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700218
					]
				},
				{
					"id": 741700218,
					"content": "É intrigante, não é? Parece que ele fez... hum... várias modificações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700219
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700219,
					"content": "Agora parece mais adequado a alguma ruína antiga que os turistas possam visitar... Embora talvez não seja muito prudente dizer isso dessa forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700220
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700220,
					"content": "*Cof cof* O ponto de vista mencionado anteriormente é apenas a minha opinião pessoal e não representa o Instituto de Pesquisas de Fontaine nem seus pontos de vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
