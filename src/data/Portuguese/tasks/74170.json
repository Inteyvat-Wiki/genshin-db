			"dialogs": [
				{
					"id": 741700213,
					"content": "Falando nisso, quem é Kuisel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700214
					]
				},
				{
					"id": 741700214,
					"content": "Eu também não sei. Não me lembro de ninguém com esse nome no Instituto de Pesquisas de Fontaine... Talvez seja melhor para ele que ninguém com esse nome exista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700215
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700215,
					"content": "Assim como ele mesmo disse, Kuisel era apenas um personagem conveniente. Quanto mais diferente esse personagem fosse dele próprio, melhor, pois tornava menos provável que alguém o reconhecesse... Embora, eu esteja apenas supondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700216
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700216,
					"content": "*Suspiro* Se quer saber, acho que ele mudou bastante ao longo dos anos. Eu não o reconheci de imediato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
