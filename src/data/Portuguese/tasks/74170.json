			"dialogs": [
				{
					"id": 741700210,
					"content": "Esqueça o desafio por ora. O que aconteceu com Coutrot?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700211
					]
				},
				{
					"id": 741700211,
					"content": "Ter sido expulso do Instituto de Pesquisas de Fontaine não o fez ver a razão. Ele realmente é teimoso como uma mula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700212
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700212,
					"content": "Mas ninguém está apoiando ele agora, então você pode relaxar. Ele não pode causar mais problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
