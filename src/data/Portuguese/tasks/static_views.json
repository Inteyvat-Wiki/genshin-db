				"points": []
			},
			"dialogs": [
				{
					"id": 730980401,
					"content": "Bem... Deixe Paimon ver... Parece que um novo mapa do tesouro apareceu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980402,
					"content": "Não vamos ajudar \"o Aranara preso\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980403
					]
				},
				{
					"id": 730980403,
					"content": "#*Ahem* É verdade, não conseguimos encontrar o dono da casa. Isso é preocupante! Então, {NICKNAME}, por que não vamos conferir os outros lugares mostrados na pintura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980404,
					"content": "Quando a gente chegar lá, nós poderíamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980405,
						730980407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980405,
					"content": "Encontrar mais tesouros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980406
					]
				},
				{
					"id": 730980406,
					"content": "Isso mesmo! Ah, não! É para encontrar o Aranara preso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980409,
					"content": "Bem... Paimon sente que esta \"caixa de correio\" é muito mágica, e talvez possamos conseguir algumas novas pinturas mais tarde. Precisamos ficar de olho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980407,
					"content": "Encontrar o \"Aranara preso\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980408
					]
				},
				{
					"id": 730980408,
					"content": "Sim! E quem sabe não vamos encontrar um tesouro também!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
