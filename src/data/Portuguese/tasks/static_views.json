			},
			"dialogs": [
				{
					"id": 730980301,
					"content": "Deixe Paimon ver... Hein? Esta é uma pintura Aranara...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980302,
					"content": "É feio mexer nas coisas dos outros...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980303
					]
				},
				{
					"id": 730980303,
					"content": "Ah, é mesmo? Mas e quantos aos acampamentos de aventureiros e baús de tesouro que já pilhamos!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980304,
					"content": "#Bem... Digamos que não vimos nenhum Aranara perto da casa, estamos muito preocupad{M#o}{F#a}s e resolvemos procurar pistas. Talvez possamos ajudar Aranaras em apuros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980305,
						730980306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980305,
					"content": "Você tem toda razão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980307
					]
				},
				{
					"id": 730980307,
					"content": "Hmm, claro! Mas de qualquer forma, parece que esta pintura retrata paisagens aqui perto, né? Ah, inacreditável, talvez seja um mapa do tesouro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980308,
					"content": "#{NICKNAME}, vamos ao local da pintura para conferir! Talvez realmente exista um tesouro deixado pelos Aranara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980306,
					"content": "Hmm. Isso faz todo sentido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980307
					]
				}
			]
		},
		{
			"id": 7309804,
			"completionStepIds": [
				7309803
			],
