				"points": []
			},
			"dialogs": [
				{
					"id": 705280401,
					"content": "*Suspiro* A Guilda consegue mesmo gerenciar todo esse trabalho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280402
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280402,
					"content": "Ah, Viajante! Minhas desculpas por não te perceber antes. Eu estava com alguns assuntos da Guilda na cabeça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280403
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280403,
					"content": "Você deve estar aqui em Mondstadt para o Festival da Brisa Florescente, eu presumo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280404
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280404,
					"content": "Você chegou na hora certa: a Guilda elaborou um pequeno jogo, um jogo estrondoso com prêmios a serem ganhos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280405
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280405,
					"content": "Que tal? Querem experimentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280406
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280406,
					"content": "Então, deixe-me te apresentar esse joguinho. A pessoa que o criou, deu o nome de \"Xadrez Floral\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280407
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280407,
					"content": "Ele disse que a inspiração dele veio das pétalas ondulantes e do vento que as persegue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280408
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280408,
					"content": "E o jogo tenta imitar o... romance de perseguir estas pétalas de flores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280409,
						705280410
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280409,
					"content": "Essa é, uh, uma história e tanto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				},
				{
					"id": 705280411,
					"content": "Bem, este inventor é um bardo, então ele tem mais... sabe, imaginação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280412
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280412,
					"content": "Basicamente, quando você está jogando esta forma de xadrez, você precisa coletar o máximo possível de Balões do Florescimento dentro do tabuleiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280413
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280413,
					"content": "Você precisará evitar vários obstáculos no processo... e haverá algumas ferramentas ao seu alcance para te dar uma ajuda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280414
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280414,
					"content": "O inventor até escreveu um manual inteiro para este evento, o qual eu deixarei você dar uma olhada mais tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280415
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280415,
					"content": "#Se tiver interesse, sinta-se bem-vind{M#o}{F#a} para jogar. Lembre-se, prêmios são garantidos apenas por participar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280410,
					"content": "Isso é, ah, meio complicado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				}
			]
		}
	]
}