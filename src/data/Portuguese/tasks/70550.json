							-777.449
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705500101,
					"content": "#Hã? Aquilo é... Sr{F#ta}. Cavaleir{F#a}{M#o} Honorável?! Oooba, é você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500102,
						705500103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500102,
					"content": "E aí, Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				},
				{
					"id": 705500104,
					"content": "Haha, Titia Eula disse a Klee que a Srta. Hertha tinha encontrado uma pessoa incrível pra ajudar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500105,
					"content": "#Te vendo aqui, Sr{F#ta}. Cavaleir{F#a}{M#o} Honorável, Klee sabe que essa deve ser a melhor barraca de bebidas em todo Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500106,
						705500107
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500106,
					"content": "Que gentil da sua parte, Klee. Esse é o objetivo final!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500108,
					"content": "V-Você tá dizendo que essa barraca ainda NÃO É a melhor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500109
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500109,
					"content": "#Bem... de todas as barracas de bebidas que Klee já visitou, a {M#do}{F#da} Cavaleir{F#a}{M#o} Honorável é de longe a melhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500110
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500110,
					"content": "#Eeeee... não importa quais bebidas {M#o}{F#a} Cavaleir{F#a}{M#o} Honorável faça, Klee vai achar delícia, com certeza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500111,
						705500112
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500111,
					"content": "Dessa vez, Klee, preciso que você seja um pouco mais durona comigo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500113,
					"content": "Oh... Oh! Você quer que eu seja malvada? M-Mas... Klee nunca ia conseguir ser malvada com você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500114
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500114,
					"content": "Hmm, deixa eu pensar... já sei! Vou fingir seu o Sr. Albedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500115,
					"content": "Sempre que o Sr. Albedo analisa o trabalho de Timaeus, a cara dele fica super séria e Klee consegue ouvir cada palavra que ele diz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500116,
						705500117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500116,
					"content": "Sensacional, então você pode ser minha professora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500118,
					"content": "Heehee... Se prepare para o super pedido incrível de Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500119
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500119,
					"content": "Vou sair para uma pesca explosiva com a mamãe em breve... Mas não diga à Mestre Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500120
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500120,
					"content": "Eu e mamãe explodimos tantos peixes hoje... Mas não diga à Mestre Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500121,
					"content": "Nesses últimos dias, eu tô me divertindo tanto com mamãe o dia inteiro! É muito legal! Até ser mandada pro confinamento solitário não ia conseguir tirar o sorriso do meu rosto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500122
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500122,
					"content": "Então, Klee quer pedir um Tempo Bom. Qualquer coisa como um belo dia ensolarado vai deixar Klee de super bom humor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500123,
						705500124
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500123,
					"content": "Pode deixar, Srta. Klee, é pra já!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500125,
					"content": "Heehee, como será que vai ser o sabor...7",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500124,
					"content": "Entendido, Mestre Alquimista Klee, farei imediatamente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500117,
					"content": "Sensacional, então você pode ser a Mestre Alquimista Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500112,
					"content": "Dessa vez, você pode me criticar o quanto quiser!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500107,
					"content": "#Quanta gentileza sua, Klee. Tô dando duro para ser {M#o}{F#a} melhor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500103,
					"content": "Olá, Cliente Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				}
			]
		},
