							-777.449
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705500201,
					"content": "Seu Tempo Bom está aqui. Vamos, experimente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500202
					]
				},
				{
					"id": 705500202,
					"content": "Uau, então um Tempo Bom é dessa cor? Céu roxo... É pra ser um céu brilhante de noite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500203,
						705500204
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500203,
					"content": "Talvez fosse para ser um céu sem nuvens ao entardecer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				},
				{
					"id": 705500205,
					"content": "Klee vai dar um gole primeiro... Aí você pensa com mais cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500206
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500206,
					"content": "Ahhh, acabou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500207
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500207,
					"content": "Delícia! É doce e azedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500208
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500208,
					"content": "Se Klee bebesse isso enquanto come peixe grelhado, eu ia conseguir tomar dois, ou três, ou quatro, ou até... cinco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500209
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500209,
					"content": "Mas uma bebida não é suficiente. Klee quer experimentar... uma bebida com gosto de bolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500210,
						705500211,
						705500212
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500210,
					"content": "Entendido. Que tal um \"Bolo no Copo\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500213,
					"content": "#Hmm... Klee não sabe qual bebida escolher. Por que a gente não decide junt{M#os}{F#as} Sr{F#ta}. Cavaleir{F#a}{M#o} Honorável?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500214
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500214,
					"content": "Aquele doce que você trouxe com você parece bem especial!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500215
					]
				},
				{
					"id": 705500215,
					"content": "Essa coisa? Heehee... Mamãe me ensinou a fazer usando o Balcão de Síntese!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500216
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500216,
					"content": "Um pouco de açúcar... aí um montão mais de açúcar, aí umas flores da amiga de mamãe em Fontaine, mel de estrela da Titia Barbie e, finalmente, um pouco de geleia mágica da Titia Tavia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500217
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500217,
					"content": "Junte tudo no Balcão de Síntese, deseje o formato que você quer, aí recite o encantamento de mamãe e... Puf! Doce em formato de Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500218,
						705500219
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500218,
					"content": "É um tremendo processo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500220,
					"content": "Klee pode te dar um pouco de Doce de Dodoco também se quiser! E se gostar mesmo deles, Klee pode até te ensinar o encantamento de mamãe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500221
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500221,
					"content": "Assim, você pode fazer seu próprio doce quando quiser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500222,
						705500223
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500222,
					"content": "Valeu por compartilhar sua receita incrível, Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500224,
					"content": "Heehee, se você tiver problemas, lembra de vir perguntar a Klee! Quando o assunto é doce mágico, sou especialista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500225
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500225,
					"content": "Você tem outros planos pra hoje?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500226
					]
				},
				{
					"id": 705500226,
					"content": "É! Mamãe me deu um livro incrível recentemente. Ela disse que eu tenho que ler um capítulo toda noite, aprender alguma coisa útil e dormir cedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500227
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500227,
					"content": "Aquele livro ensinou Klee como fazer uma pousa chamada \"propulsor\". Agora a Bomba Saltitante pode fazer \"vuuuush!\" e saltar ainda mais alto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500228,
						705500229
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500228,
					"content": "I-Isso é algo que você devia tá aprendendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500230,
					"content": "Não é difícil... Na verdade, é bem parecido com fazer bombas. Você só tem que ter cuidado aparando, é como apontar um lápis de repente pode fazer BOOM!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500231
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500231,
					"content": "A hora de dormir é uma parte importante do dia de Klee também! Mamãe senta do meu lado e me conta todo tipo de história maravilhosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500232
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500232,
					"content": "Ela tem um abajur feito de gemas preciosas e, quando ela liga ele, faz \"ka-bling\" e ilumina o teto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500233
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500233,
					"content": "O teto mostra cenas das histórias?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500234
					]
				},
				{
					"id": 705500234,
					"content": "É! Quando alguma coisa acontece na história, as luzes no teto fazem umas imagens bonitas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500235
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500235,
					"content": "Às vezes, mamãe dorme antes da história acabar, aí Klee que tem que cobrir ela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500236
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500236,
					"content": "#Assim que Klee aprender como usar o abajur, Eu posso vir te contar histórias, Sr{F#ta}. Cavaleir{F#a}{M#o} Honorável!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500237,
						705500238
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500237,
					"content": "Maravilha!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500239,
					"content": "Heehee, Klee decorou tantas histórias maravilhosas, suficiente para deixar todo mundo feliz todo dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500240
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500240,
					"content": "Você planeja comer outra coisa hoje?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500241
					]
				},
				{
					"id": 705500241,
					"content": "Sim! Quando Klee voltar pra casa, vou comer umas nozes enquanto leio meu livro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500242
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500242,
					"content": "Klee costumava comer bolo depois do jantar, mas Mestre Jean disse que tem açúcar demais e não é bom comer essas coisas antes de dormir! Parece que deixa você rechonchuda e dá dor de dente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500243
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500243,
					"content": "Aí mamãe pediu conselhos à Titia Barbie e agora ela me dá nozes. Ela disse que nozes ajudam meu cérebro a lembrar melhor das coisas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500244
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500244,
					"content": "Nozes não têm muito sabor, é tipo mastigar grama, mas são ok se você colocar um pouco de sal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500245
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500245,
					"content": "Parece uma ótima solução, nutritiva e saudável!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500246
					]
				},
				{
					"id": 705500246,
					"content": "Tem que ter uns ingredientes que são saudáveis e doces...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500247
					]
				},
				{
					"id": 705500247,
					"content": "Ah sim... A Klee ainda quer comer coisas doces — tipo bolo, por exemplo! Talvez pudéssemos usar menos creme... ou adicionar mais frutas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500248
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500248,
					"content": "Ah, é verdade! Aquela amiga da mamãe que está sempre usando óculos deu a ela um grande saco de Fruta Bulle. Elas são tão redondas e rolantes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500249
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500249,
					"content": "A Klee comeu várias delas — elas eram super doces, e a Mestre Jean disse que estava tudo bem porque... \"Frutas doces não são a mesma coisa que açúcar doce!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500250
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500250,
					"content": "Então, se Klee realmente precisar comer nozes, talvez eu possa mergulhar elas em suco de fruta primeiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500251
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500251,
					"content": "Falando de comida, espero que esteja fazendo suas três refeições diárias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500252
					]
				},
				{
					"id": 705500252,
					"content": "Três refeições? Heehee, Klee geralmente come cinco refeições por dia, às vezes até sete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500253
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500253,
					"content": "Sério?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500254
					]
				},
				{
					"id": 705500254,
					"content": "Se aventurar precisa de muita energia e, se eu comer demais de uma vez, não consigo correr tão bem... Então é melhor comer muitas refeições pequenas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500255
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500255,
					"content": "Sr. Albedo preparava todas as refeições de Klee, e minha lancheira ficava sempre tão arrumada, igual a uma pintura bonita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500256,
						705500257
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500256,
					"content": "Isso parece mesmo coisa de Albedo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500258,
					"content": "Quando o Sr. Albedo tá ocupado na Espinha do Dragão, Klee sai pra comer com os outros Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500259
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500259,
					"content": "O acampamento de Kaeya é geralmente o mais limpo, enquanto Amber às vezes acampa nas árvores, é bem divertido! Ah, e a Titia Hertha faz a melhor comida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500260
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500260,
					"content": "Quando mamãe volta, tem comidas ainda mais gostosas. Tem esse prato que ela pega um montão de peixes diferentes e faz eles ficarem iguais a uns cubinhos de pudim... o nome é Geleia de Peixe Cromático!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500261,
						705500262
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500261,
					"content": "Você tá me deixando com fome...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500263,
					"content": "As Fatias Crocantes de Chocolate dela são fantásticas também! É a criação mais nova dela, feito com biscoitos de chocolate! Eles são meio amargos, mas são crocantes e têm um cheiro delicioso, deixando um sabor docinho na boca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500264
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500264,
					"content": "Sempre que como eles, me sinto cheeeeeia de energia... na próxima vez, Klee vai trazer um pouco pra você experimentar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500265
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500265,
					"content": "Tudo bem, acho que sei como melhorar aquela bebida!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500266
					]
				},
				{
					"id": 705500266,
					"content": "Me deixa preparar outra pra você!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500267
					]
				},
				{
					"id": 705500267,
					"content": "Eita, que rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500268
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500268,
					"content": "Klee quer saber qual é o sabor da sua próxima bebida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500262,
					"content": "Comida ótima para uma aventureira ótima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500257,
					"content": "Queria experimentar a comida de Albedo algum dia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500238,
					"content": "Vou ficar esperando!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500229,
					"content": "É-É fácil assim de fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500223,
					"content": "Vou me esforçar pra aprender como fazer!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500219,
					"content": "Que doce incrível...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500211,
					"content": "Beleza, se prepare para outra bebida super híper deliciosa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500212,
					"content": "Qualquer sabor que Klee quiser, Klee terá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500204,
					"content": "Não é a cor mais adequada... Que tal eu fazer algumas mudanças?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				}
			]
		},
