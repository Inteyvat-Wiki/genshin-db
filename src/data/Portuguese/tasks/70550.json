			"dialogs": [
				{
					"id": 705500301,
					"content": "Ta-dá! Tá feito, eu sei que você vai adorar essa criação!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500302
					]
				},
				{
					"id": 705500302,
					"content": "Uau! Tem Doce de Dodoco no topo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500303
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500303,
					"content": "Tem tanto laranja nesse copo e Dodoco parece que tá deitada no topo de nuvens brancas fofinhas... e o tempo parece bem melhor também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500304
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500304,
					"content": "Quer experimentar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500305
					]
				},
				{
					"id": 705500305,
					"content": "Uau... Que delícia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500306
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500306,
					"content": "Klee tem que beber devagar... Não posso tomar tudo de uma vez, senão vou perder toda a delícia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500307
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500307,
					"content": "#Sr{F#ta}. Cavaleir{F#a}{M#o} Honorável, isso é incrível... É tipo você colocar sol no suco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500308
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500308,
					"content": "Klee tava tão cansada de brincar, mas agora me sinto refrescada... e quente... e tranquila...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500309
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500309,
					"content": "#*Bocejo* Você é {M#o}{F#a} melhor, Sr{F#ta}. Cavaleir{F#a}{M#o} Honorável!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500310,
						705500311
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500310,
					"content": "Que tal você escolher um nome para essa bebida, Klee?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500312
					]
				},
				{
					"id": 705500312,
					"content": "Sério? Deixe eu pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500313
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500313,
					"content": "Quando o tempo está bom e Dodoco está feliz, Dodoco vai querer cantar, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500314
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500314,
					"content": "E quando Dodoco canta, Klee quer cantar também... Então vamos chamar ela de... Dueto de Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500315,
						705500316
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500315,
					"content": "Que nome maravilhoso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500317
					]
				},
				{
					"id": 705500317,
					"content": "Heehee, obrigada — e obrigada por fazer uma bebida tão boa para Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500318
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500318,
					"content": "Klee vai contar para a mamãe que a bebida mais gostosa em Mondstadt agora é o Dueto de Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500319,
						705500320
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500319,
					"content": "Fico feliz que você tenha gostado!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500321
					]
				},
				{
					"id": 705500321,
					"content": "#Heehee! Klee vai escrever uma cópia do encantamento de mamãe e te dar, Cavaleir{F#a}{M#o} Honorável!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500322
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500322,
					"content": "Aí você devia aprender magia também, pra poder fazer todos os doces que quiser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500323
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500323,
					"content": "Até a próxima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500320,
					"content": "Passei no seu teste, senhorita Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500321
					]
				},
				{
					"id": 705500316,
					"content": "Seus nomes são os melhores!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500317
					]
				},
				{
					"id": 705500311,
					"content": "Tenho certeza que você vai criar um nome incrível!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500312
					]
				}
			]
		}
	]
