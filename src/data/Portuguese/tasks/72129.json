					"Kaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721290401,
					"content": "#Nada mal, forasteir{F#a}{M#o}. As nuvens quase já estão dispersas. Parece que minha intuição estava certa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290402
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290402,
					"content": "Em seguida, dois Amuletos ainda precisam ser fixados na Cabeça da Serpente e na Mina Jakotsu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290403
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290403,
					"content": "Se você não se importar, deixarei esses amuletos com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290404
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290404,
					"content": "Não tem problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290405
					]
				},
				{
					"id": 721290405,
					"content": "Muito obrigado pela sua ajuda. Apesar de eu não ser um homem rico, prometo que lhe recompensarei justamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290406
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290406,
					"content": "Não sei quando acontecerá, mas a reunião familiar está mais próxima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290407
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290407,
					"content": "#Falando nisso, quando você estiver pront{F#a}{M#o}, pode me encontrar no lado oeste da ilha. Também houve uma invasão rebelde no Forte Mumei, talvez ela esteja relacionada à mutação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				}
			]
		},
