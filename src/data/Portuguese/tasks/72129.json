			},
			"dialogs": [
				{
					"id": 721290101,
					"content": "A lanterna de pedra estranha parece estar emitindo uma energia perturbadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290102
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721290102,
					"content": "Essa lanterna de pedra é tão estranha... Que assustadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290103,
					"content": "Oh, o que é aquilo escrito no poste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290104,
					"content": "\"Viajantes que estão de passagem: se vocês tiverem perguntas sobre esse Amuleto, vão até a Garganta Musoujin e falem com o Sr. Kaji\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290105
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721290105,
					"content": "A escrita parece recente, e tem algumas linhas de escrita menor embaixo, que foram erodidas pela chuva:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290106
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721290106,
					"content": "\"Por favor diga ao Sr. Kaji que tentamos... Mas infelizmente... Talvez ele possa encontrar em algum lugar perto...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290107
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721290107,
					"content": "\"Por favor, digam ao Sr. Kaji para vir para o local de refúgio o mais rápido possível. Sua família sente muito sua falta\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290108
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721290108,
					"content": "O Sr. Kaji parece se importar com esta lanterna de pedra. Por que não vamos até a Garganta Musoujin e perguntamos a ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7212902,
			"completionStepIds": [
				7212905
			],
