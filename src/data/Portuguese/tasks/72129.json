			"dialogs": [
				{
					"id": 721290201,
					"content": "Você olha o Amuleto, e de repente, uma energia estranha flui até você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290202
					],
					"speakerTitle": "Tocar o talismã"
				},
				{
					"id": 721290202,
					"content": "Você percebe que não está resistindo você, mas está lhe pedindo algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290203
					],
					"speakerTitle": "Tocar o talismã"
				},
				{
					"id": 721290203,
					"content": "Bem... Parece estar faltando algo desse amuleto. Vamos dar uma olhada nas redondezas, que tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290204,
					"content": "Use a Visão Elemental para procurar por traços elementais por aqui. Talvez você descubra algo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
