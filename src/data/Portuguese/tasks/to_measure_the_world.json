			"dialogs": [
				{
					"id": 230250401,
					"content": "Hum... Então é isso? Desde que esta variável seja reintroduzida, as discrepâncias podem ser explicadas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250402
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250402,
					"content": "Mas isso também muda minhas outras deduções?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250403
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250403,
					"content": "Algum progresso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250404
					]
				},
				{
					"id": 230250404,
					"content": "Ah, desculpe, eu tinha esquecido que você ainda estava aqui... Aqui, aqui está a remuneração prometida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250405
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250405,
					"content": "No que diz respeito ao progresso... Alguns problemas foram resolvidos, mas parece que muitos novos problemas surgiram... Essa é provavelmente a essência de uma pesquisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250406
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250406,
					"content": "Talvez eu tenha que continuar incomodando você, Viajante, até chegar a uma conclusão final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				}
			]
		},
