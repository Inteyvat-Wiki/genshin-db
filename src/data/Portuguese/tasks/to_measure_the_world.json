					"nextDialogs": [
						230250703
					]
				},
				{
					"id": 230250703,
					"content": "Não posso te agradecer o suficiente. Por favor, aceite isso como pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250704
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250704,
					"content": "Agora tudo que temos que fazer é esperar que eles terminem de coletar os dados, então poderei confirmar minha dedução!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250705
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250705,
					"content": "Mas como vou subir e pegar os sinalizadores de volta...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				}
