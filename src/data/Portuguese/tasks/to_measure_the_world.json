						230250523
					]
				},
				{
					"id": 230250523,
					"content": "#Então você está dispost{M#o}{F#a} a ajudar. Agradeço-lhe muito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250524
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250524,
					"content": "Na verdade, adquiri um conjunto personalizado de sinalizadores que coletam automaticamente os dados brutos necessários para apoiar minhas deduções.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250525
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250525,
					"content": "Para evitar ao máximo as interferências topográficas, é melhor configurar esses sinalizadores em um local alto, como um penhasco ou o topo de uma montanha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250526
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250526,
					"content": "Mas como você pode ver, não sou o melhor escalador...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250527,
						230250529
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250527,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250528
					]
				},
				{
					"id": 230250528,
					"content": "Muito obrigado! Os locais de amostragem ficam próximos. Me avise quando tiver terminado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250529,
					"content": "Você não levou em conta o terreno quando fez o pedido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250530
					]
				},
				{
					"id": 230250530,
					"content": "Ahem... A sensibilidade do instrumento era uma prioridade, então o alcance de aplicação foi naturalmente sacrificado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250531
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250531,
					"content": "Os cálculos podem ser completamente equivocados se cometermos apenas um punhado de erros. Enfim, conto contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250515,
					"content": "Boa sorte. Até mais.",
