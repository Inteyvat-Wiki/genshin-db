				{
					"id": 230251001,
					"content": "O quê? Existem monstros lá? Não pode ser, os parâmetros ambientais desta área claramente mostram...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251002
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230251002,
					"content": "Será que os próprios sinalizadores constituem uma variável? Talvez são as leves vibrações, som e luz durante a operação que atraem monstros...",
					"roleType": "TALK_ROLE_NPC",
