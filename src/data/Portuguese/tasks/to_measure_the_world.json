					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251004
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230251004,
					"content": "Eu não esperava que isso lhe causasse problemas extras... Por favor, aceite essa recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251005
					],
