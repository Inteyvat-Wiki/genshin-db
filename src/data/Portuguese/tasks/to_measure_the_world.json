					"nextDialogs": [
						230250802
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250802,
					"content": "Como vai sua pesquisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250803
					]
				},
				{
					"id": 230250803,
					"content": "Graças a você, fiz um grande progresso nos últimos dias. Os sinalizadores devem estar coletando dados neste exato momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250804
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250804,
					"content": "Só me resta recuperar esses dados para verificar as novas conjecturas propostas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250805,
						230250806
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250805,
					"content": "Tudo o que você fez esses dias foram conjecturas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
					]
				},
				{
					"id": 230250807,
					"content": "Bem, eu otimizei equações e calibrarei o instrumento. Afinal de contas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250808
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250808,
					"content": "Não há como eu subir até onde você configurou esses sinalizadores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250809
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250809,
					"content": "#Receio ter que incomodá-l{M#o}{F#a} para recuperar esses sinalizadores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250810,
						230250812
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250810,
					"content": "Tudo bem então...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250811
					]
				},
				{
					"id": 230250811,
					"content": "Por favor, Viajante! Eu cuidarei da recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250812,
					"content": "Que tal cuidar da recuperação dos equipamentos da próxima vez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250813
					]
				},
				{
					"id": 230250813,
					"content": "Eu ponderei algumas opções, sabe? Podemos adicionar um dispositivo de recuperação ou expandir o escopo de aplicação... Coisas assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250814
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250814,
					"content": "Mas isso exigiria um orçamento maior, e não sei como afetaria a precisão dos dados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250815
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250815,
					"content": "De qualquer forma, também estou contando com você desta vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250806,
					"content": "Isso não é nenhum progresso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
					]
				}
