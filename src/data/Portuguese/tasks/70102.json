			"dialogs": [
				{
					"id": 701020301,
					"content": "Achei mais alguns Dentes de Dragão...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020302
					]
				},
				{
					"id": 701020302,
					"content": "Ah, eu esperava que você passasse por aqui. Ouça, antes de ir buscar todos aqueles Dentes de Dragão... Oh. Vejo que você já terminou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020303
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020303,
					"content": "Minhas mais sinceras desculpas... Mas eu tive um pequeno contratempo. Não importa com o que eu acerte esta coisa, eu simplesmente não consigo tirar nem sequer um pedaço dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020304
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020304,
					"content": "É quase como se realmente fosse um Dente de Dragão. Se este é o caso, então com base no que li, há vários métodos bastante específicos para trabalhar com este material.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020305
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020305,
					"content": "Um deles é ter o dente do dragão absorvendo algum tipo de... \"Vitalidade\" relacionada ao dragão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020306
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020306,
					"content": "Então, use o dente do dragão infundido com a vitalidade do dragão para trabalhar as outras peças do Dente de Dragão em forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020307
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020307,
					"content": "Agora, quanto a infundir algo com vitalidade de dragão... Eu não tenho a mínima ideia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020308
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020308,
					"content": "Alguma ideia, Viajante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020309
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020309,
					"content": "Eu... Erm... Vou ver o que posso fazer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020310
					]
				},
				{
					"id": 701020310,
					"content": "Ótimo! Aqui - pegue este Dente do Dragão, então, e eu deixarei toda essa parte das coisas para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020311
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020311,
					"content": "Hum, se apenas os dentes causam tanta confusão, dragões inteiros devem ser criaturas seriamente complicadas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orban"
				}
