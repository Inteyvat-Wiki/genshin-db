			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330101,
					"content": "Por aqui, Viajante, aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330102,
					"content": "Você é o artista que fez um acordo com Qingzhou mais cedo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330103
					]
				},
				{
					"id": 710330103,
					"content": "Sim, eu mesmo. Aquele poeta e eu concordamos que cada um de nós criaria uma obra de arte que resume o Ritual de Lanternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330104,
					"content": "Você até me ajudou a encontrar minhas tintas e pincéis antes, lembra-se?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330105,
						710330106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330105,
					"content": "Sim, eu me lembro disso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				},
				{
					"id": 710330107,
					"content": "A minha pintura... Cof... Na verdade, eu já pintei várias coisas... Cenários, personagens e animais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330108,
					"content": "Estou convencido de que as minhas pinturas falam por si mesmas... No entanto, nenhum delas pode abranger o Ritual de Lanternas",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330109,
					"content": "Ugh... Eu não consigo dormir bem... E os meus materiais estão acabando... Mesmo assim, não consegui criar aquela pintura que eu quis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330110,
					"content": "Portanto, gostaria de encontrar aquele bardo... E ver como é que anda o seu poema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330111,
					"content": "Viajante, você sabe onde o bardo foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330112,
					"content": "Ele foi para a Vila Qingce.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330113
					]
				},
				{
					"id": 710330113,
					"content": "A Vila Qingce? Não faço menor ideia por que foi para lá... Será que era para encontrar mais inspirações?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330114
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330114,
					"content": "Vamos, Viajante. Vamos encontrar ele lá na Vila Qingce. Se for um bom lugar, talvez possa encontrar algumas inspirações também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330115
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330115,
					"content": "Cof... Bom, então vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330106,
					"content": "E a sua pintura...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				}
			]
		},
		{
			"id": 7103303,
			"completionStepIds": [
				7103303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103303",
							"2"
						],
						"stepId": 7103303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330301,
					"content": "Esta é a Vila Qingce, então... Onde está aquele poeta? Ele foi à procura de inspiração em algum lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330302
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330302,
					"content": "Da última vez que nos encontramos, ele estava brincando de quebra-cabeças das lanternas com as crianças...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330303
					]
				},
				{
					"id": 710330303,
					"content": "Um quebra-cabeça na lanterna? O que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330304
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330304,
					"content": "Ele admitiu sua derrota porque não encontrou inspiração?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330305
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330305,
					"content": "Deixa para lá, não me importo com o que ele está fazendo... O Ritual de Lanternas está terminando, não posso demorar ainda mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330306
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330306,
					"content": "Por que não perguntamos o responsável? Hoje temos que decidir o ganhador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 7103304,
			"completionStepIds": [
				7103304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103304",
							"2"
						],
						"stepId": 7103304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Avó Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330401,
					"content": "#Ora, se não é {M#o}{F#a} Viajante. Graças a você, nossa aldeia finalmente tem algum ânimo festivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330402
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 710330402,
					"content": "Oh, vejo que você trouxe uma cara nova com você. Se eu puder perguntar quem é este...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330403
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 710330403,
					"content": "Ele é um artista, e está aqui para procurar pelo Qingzhou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330404
					]
				},
				{
					"id": 710330404,
					"content": "Procurando pelo Sr. Qingzhou, não é? Hmm, entendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330405
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 710330405,
					"content": "Quando a Srta. Wang'ya saiu há vários dias atrás, o Sr. Qingzhou disse que gostaria de ficar aqui por mais um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330406
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 710330406,
					"content": "Ele ainda deveria estar inventando quebra-cabeças das lanternas para as crianças. Se minha memória não me falha, ele as levou lá pra fora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330407
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 710330407,
					"content": "Você provavelmente terá que encontrá-lo lá fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330408
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 710330408,
					"content": "Ele realmente está se divertindo nos quebra-cabeças... Viajante, você pode ir por mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330409
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330409,
					"content": "E dizer que eu já estou aqui, e vou me preparar ainda mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330410
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330410,
					"content": "De qualquer maneira, hoje vai decidir o ganhador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 7103305,
			"completionStepIds": [
				7103305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103305",
							"2"
						],
						"stepId": 7103305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330501,
					"content": "Hahaha, eu acho que todos vocês estão pegando o jeito. Vocês estão adivinhando as respostas cada vez mais rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330502,
						710330503
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330502,
					"content": "Vermeer está aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330504
					]
				},
				{
					"id": 710330504,
					"content": "Vermeer... Ah, sim, aquele artista. Deixe-me ver... Pelo que posso ver, esta é de fato a data acordada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330505
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330505,
					"content": "É uma pena, então, que meu poema ainda esteja inacabado. Nem estas crianças ainda tiveram o suficiente para se encherem destes quebra-cabeças das lanternas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330506
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330506,
					"content": "Bem, então talvez este seja o limite máximo de minha habilidade poética... Você, por acaso, me acompanharia para buscar alguma inspiração mais uma vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330507
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330507,
					"content": "Hmm, talvez eu devesse dizer que não se trata de \"buscar inspiração\", mas sim, de irmos caminhar juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330508
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330508,
					"content": "Tio Qingzhou! Isto significa que não estamos mais resolvendo quebra-cabeças de lanternas? Eu ainda quero tentar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330509
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710330509,
					"content": "Eu também quero resolver alguns quebra-cabeças de lanternas, tio Qingzhou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330510
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 710330510,
					"content": "Ugh... Eu também gostaria de desvendar alguns...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330511
					],
					"speakerTitle": "Pequena You"
				},
				{
					"id": 710330511,
					"content": "#Hahaha, calma aí. Deixa-me só dar uma volta com {M#o}{F#a} Viajante, aí já trazemos novos quebra-cabeças para vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330512
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330512,
					"content": "Então é melhor voltarem para a Vila Qingce. Aí vou encontrar vocês lá, o que vocês acham?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330513
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330513,
					"content": "Ok! O Qingzhou é realmente muito incrível... Ele pensou em tantos quebra-cabeças!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330514
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710330514,
					"content": "Ele deve ter lido bastantes livros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330515
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 710330515,
					"content": "Se pudesse ser tão incrível quanto o Qingzhou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
