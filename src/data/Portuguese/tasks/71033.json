					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 710331202,
					"content": "Sobre Qingzhou e Vermeer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331203
					]
				},
				{
					"id": 710331203,
					"content": "Oh, aqueles dois? Não se preocupe com eles. Desde que eles estejam dispostos a acompanhar as crianças, eu estou contente com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331204
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 710331204,
					"content": "Esta é uma temporada festiva, afinal de contas. É bom que as coisas sejam animadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331205
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 710331205,
					"content": "É você, jovem, que sempre está correndo de um lado para outro da Vila Qingce para nós. Muito obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331206,
						710331207
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 710331206,
					"content": "Não tem problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				},
				{
					"id": 710331208,
					"content": "#Você está muito entusiasmad{F#a}{M#o}. Por favor, fique com isso como agradecimento. Você também deve aproveitar o feriado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331209
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 710331209,
					"content": "Espero que depois que o Ritual de Lanternas terminar aqui continue animado desse jeito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 710331207,
					"content": "De nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				}
			]
		},
		{
