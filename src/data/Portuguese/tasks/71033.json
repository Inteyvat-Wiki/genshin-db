			},
			"dialogs": [
				{
					"id": 710331401,
					"content": "Crianças, vejam essa coisa que está dentro dessa Lanterna Celeste. Tentem adivinhar o que é.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331402
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331402,
					"content": "#Eu vou tratar de um assunto com {M#o}{F#a} Viajante. Logo depois já volto para brincar com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331403
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331403,
					"content": "Tio Qingzhou, o que você está indo fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331404
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 710331404,
					"content": "Eu e um pintor marcamos uma competição. Eu tenho que escrever o melhor poema, e ele tem que pintar a melhor pintura para ver quem é o melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331405
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331405,
					"content": "Claro que será o tio Qingzhou que ganhará. Ele escreveu tantos quebra-cabeças, e todos são ótimos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331406
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331406,
					"content": "Mesmo? Obrigado pelo elogio. Mas peguem essa Lanterna Celeste primeiro e voltem logo para a Vila Qingce para adivinhar os quebra-cabeças. Aqui não é seguro agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331407
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331407,
					"content": "Relaxe, tio. Nós conhecemos bem aqui, sabemos como voltar. Volte logo e derrote aquele pintor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331408
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331408,
					"content": "Tio, quando a competição com aquele pintor terminar, volte logo para cá para brincar conosco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331409
					],
					"speakerTitle": "Pequena You"
				},
				{
					"id": 710331409,
					"content": "Claro que sim. Quando terminar, voltarei logo para procurar vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331410,
						710331411
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331410,
					"content": "Isso é realmente um belo poema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331411
					]
				},
				{
					"id": 710331411,
					"content": "Esse poema sairá vitorioso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331412
					]
				},
				{
					"id": 710331412,
					"content": "Haha, que poema? Isso é apenas um quebra-cabeça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331413
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331413,
					"content": "Está bem, vamos encontrar aquele pintor. Ele com certeza deve estar me esperando ansiosamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
