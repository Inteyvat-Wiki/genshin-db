			"dialogs": [
				{
					"id": 710331001,
					"content": "O tio Qingzhou está de volta! Tio Qingzhou, você já terminou de escrever novos quebra-cabeças de lanternas para nós?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
