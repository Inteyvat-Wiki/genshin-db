					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331101,
					"content": "Finalmente você está aqui. Você já escreveu aquele poema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331102,
					"content": "Não, eu não escrevi nada adequado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331103
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331103,
					"content": "En-Então você... *cof* Você não escreveu nada, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331104,
					"content": "Liyue é grande e seus lares são muitos. Ponderei muito sobre o assunto, mas não consegui encontrar uma síntese apropriada para o Ritual de Lanternas. Você, então, já terminou sua pintura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331105
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331105,
					"content": "Eu... Eu também não. Liyue é muito grande! Como eu poderia pintar tudo isso, a menos que o céu em si, fosse minha tela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331106,
					"content": "Então, no final, nenhum de nós foi capaz de criar um poema ou uma obra de arte que pudesse englobar o Porto de Liyue e o Ritual de Lanterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331107
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331107,
					"content": "Suponho, então, que isto possa ser considerado um \"empate\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331108
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331108,
					"content": "Uhh... Está bem então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331109,
					"content": "Tio Qingzhou, tio Qingzhou! Descobrimos aqueles quebra-cabeças de lanternas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331110
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331110,
					"content": "Quebra-cabeça na lanterna? O que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331111,
					"content": "Não dê atenção. Eu estou brincando com essas crianças, dando-lhes quebra-cabeças em lanternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331112
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331112,
					"content": "Uh? O que é um quebra-cabeça em uma lanterna? Você pode me dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331113
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331113,
					"content": "\"Inúmeros navios sobre as ondas flutuam, suas lâmpadas iluminam as pedras de Guyun. Eles flutuam junto com a maré do oceano, até que com o dragão e os peixes finalmente descansam seus ossos.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331114
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331114,
					"content": "Isso são os quebra-cabeças que você fez para as crianças?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331115
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331115,
					"content": "Tio Qingzhou, quem é esse senhor daí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331116,
						710331117
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331116,
					"content": "Ele é um pintor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331118
					]
				},
				{
					"id": 710331118,
					"content": "Ei, poeta, se você não quer competir comigo, então por que marcou esse encontro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331119
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331119,
					"content": "Você entendeu errado. No começo, eu também queria escrever um poema que garantiria minha vitória. Procurei minha inspiração em todos os cantos, e me esforcei para escrever vários versos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331120
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331120,
					"content": "Mas você também deve ter sentido que algumas palavras são incapazes de representar Liyue e o Ritual de Lanternas. Portanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331121
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331121,
					"content": "Portanto você decidiu vir aqui brincar com crianças? Fazer quebra-cabeças para elas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331122
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331122,
					"content": "Isso mesmo. Vim fazer quebra-cabeças para eles e procurar a inspiração para meu poema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331123
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331123,
					"content": "Haha, mesmo que eu não encontre a inspiração, se conseguir fazer os quebra-cabeças, as crianças com certeza ficarão felizes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331124
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331124,
					"content": "Talvez isso seja o poema que eu estou procurando. Que pena, não tenho como escrevê-lo, e nem tenho como competir com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331125
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331125,
					"content": "Vocês de Liyue... São muito estranhos! Como ficará a nossa competição? Quem vence e quem perde? Não aceito um empate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331126
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331126,
					"content": "Aquele senhor ali é muito chato. Com certeza é o tio Qingzhou que ganhou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331127
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331127,
					"content": "Ele é muito legal, fez muitos quebra-cabeças, você com certeza não adivinharia um!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331128
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331128,
					"content": "Poeta estúpido! Espere, tive uma ideia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331129
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331129,
					"content": "É isso! Teremos uma revanche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331130
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331130,
					"content": "Uh? Você quer uma revanche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331131
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331131,
					"content": "Você está fazendo quebra-cabeças para as crianças, não é? Enquanto estava procurando por materiais, também avistei muitos padrões das Lanternas Celestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331132
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331132,
					"content": "Vamos eu e você fazer um quebra-cabeça e uma Lanterna Celeste. As crianças nos julgarão, decidindo o vencedor por quem gostarem mais. O que você acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331133
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331133,
					"content": "Concordo! Combina comigo, e combina com o Ritual de Lanternas. É perfeito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331134
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331134,
					"content": "Ótimo! Espere eu arrumar meus materiais de pintura e teremos nossa revanche aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331135,
						710331136
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331135,
					"content": "Vocês estão realmente bem animados...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331137
					]
				},
				{
					"id": 710331137,
					"content": "Crianças, venham. Deixem-me ver o quebra-cabeça que esse poeta fez, e eu lhes pintarei uma belíssima Lanterna Celeste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331138
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331138,
					"content": "Haha, temo que a velocidade que você pinta a Lanterna Celeste não é tão rápida como a que eu escrevo meus quebra-cabeças.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331136,
					"content": "Deem o melhor de si!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331137
					]
				},
				{
					"id": 710331117,
					"content": "É uma pessoa que está competindo com Qingzhou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331118
					]
				}
			]
		},
