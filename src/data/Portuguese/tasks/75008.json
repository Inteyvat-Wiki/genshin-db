			},
			"dialogs": [
				{
					"id": 750080101,
					"content": "Manco, voltamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080102,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080103,
					"content": "Ufa, isso certamente foi uma longa espera. Não vou mentir, quanto mais eu esperava, mais ansioso ficava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080104
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750080104,
					"content": "Apesar de ter sido minha ideia em primeiro lugar, se vocês fossem para as ruínas e acabassem nunca retornando, eu ficaria consumido de culpa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080105
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750080105,
					"content": "Mas, se você puder perdoar minha sinceridade, devo perguntar — certamente você encontrou o amuleto que o Sábio da Chama Roubada deixou dentro das ruínas, correto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080106,
						750080107
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750080106,
					"content": "Foi bem difícil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				},
				{
					"id": 750080108,
					"content": "Eu sabia que você conseguiria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080109
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750080109,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080110,
					"content": "Veja, acontece que era esse disco estranho aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080111,
					"content": "Não, certamente não... O Prato Dourado do Ultimato!? O-O Prato Dourado do Ultimato realmente existe? Que incrível, devo incluir isso em minha pesquisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080112
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750080112,
					"content": "Então essa coisa é chamada de Prato Dourado do Ultimato, hein...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080113,
					"content": "I-Isso mesmo. Desculpe, só estou muito animado.  Dizem que certa vez isso já foi manuseado pelo próprio Sábio da Chama Roubada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080114
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750080114,
					"content": "Por um momento, eu estava pensando sobre como seria ficar com ele para mim como um tipo de herança de família...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080115
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750080115,
					"content": "#Sem chance! Precisamos dele para salvar {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080116,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080117,
					"content": "Eu sei... Mas quanto a pistas sobre o paradeiro do amuleto, bem, não tenho nenhuma. Não faço a menor ideia de onde o outro possa estar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080118
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750080118,
					"content": "Ochkanatlan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080119
					]
				},
				{
					"id": 750080119,
					"content": "#Hã? Me perdoe por perguntar, {NICKNAME}, mas, você acabou de dizer \"Ochkanatlan\"...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080120
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750080120,
					"content": "(Explicar que você a viu quando tocou a placa de pedra...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080121
					]
				},
				{
					"id": 750080121,
					"content": "Uau, quem imaginaria que estaria em Ochkanatlan... As ruínas de uma cidade antiga que fica em um trecho estreito de água, ao norte do Clã das Plumas de Flores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080122
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750080122,
					"content": "Se realmente está em Ochkanatlan, então me desculpe, mas eu não posso te ajudar. Não apenas minha tribo me proíbe de ir lá, mas a Associação de Relíquias Saurianas também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080123
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750080123,
					"content": "Aparentemente, uma década atrás, alguns membros da Associação de Relíquias Saurianas receberam uma comissão para investigar aquele lugar, mas após partir, eles sumiram sem deixar rastros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080124
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750080124,
					"content": "Desde então, a Associação ficou bem longe de qualquer coisa relacionada a Ochkanatlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080125
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750080125,
					"content": "Tá tudo bem. Você já nos disse o suficiente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080126,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080127,
					"content": "Bem, devo agradecer a vocês mais uma vez. Não consigo explicar o quanto ver o Prato Dourado do Ultimato significou para mim. Falando nisso, é melhor eu me apressar e voltar para que eu possa registrar tudo isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080128
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750080128,
					"content": "#Obrigado mais uma vez, {NICKNAME} e Paimon. Te desejo uma boa jornada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080129
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750080129,
					"content": "#E {REALNAME[ID(2)|SHOWHOST(true)]}, te desejo sucesso em remover a marca da Bênção do Lorde das Chamas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080130
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750080130,
					"content": "Adeus!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080131
					]
				},
				{
					"id": 750080131,
					"content": "Sim... No fim da jornada, no local onde todas as almas vêm para descansar, nos encontraremos de novo — tenho certeza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manco"
				},
				{
					"id": 750080107,
					"content": "Tão difícil quanto comer bolo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				}
			]
		},
