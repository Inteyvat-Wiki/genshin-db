				"points": []
			},
			"dialogs": [
				{
					"id": 400320101,
					"content": "Vocês chegaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320102,
					"content": "Encontrou alguma pista?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320103
					]
				},
				{
					"id": 400320103,
					"content": "Sim, graças à Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320104,
					"content": "Confirmamos em grande parte alguns locais com a ajuda das deduções dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320105
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320105,
					"content": "No momento, parece que um dos acampamentos é protegido pelo nosso \"Cachorrão\". Este local requer mais cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320106
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320106,
					"content": "Esse apelido foi bem ao estilo da Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320107
					]
				},
				{
					"id": 400320107,
					"content": "Ei! Paimon não criaria um apelido tão ruim assim! Se dependesse da Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320108,
					"content": "Esse cão deveria ser chamado de \"EspaCão\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320109,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320110,
					"content": "Coloquei dispositivos semelhantes em torno desse local. Espero que eles tenham o mesmo efeito que antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320111,
					"content": "Ei! Não ignore a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320112,
					"content": "Vou deixar o resto em suas mãos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320113,
					"content": "Alguma dúvida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320114,
					"content": "Podemos confiar nessa informação?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320115
					]
				},
				{
					"id": 400320115,
					"content": "Certamente. Patrulhei as áreas eu mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320116
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320116,
					"content": "Por que você não está vindo conosco desta vez, Ryuuji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320117,
					"content": "Eu iria, se não tivesse que fazer outras coisas para a Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320118,
					"content": "No geral, ela tem algumas ideias sobre a origem do nosso \"Cachorrão\", e pediu que eu investigasse o assunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320119
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320119,
					"content": "É \"EspaCão\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320120,
					"content": "\"Cachorrão\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320121,
						400320124
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320121,
					"content": "\"EspaCãozão\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320122
					]
				},
				{
					"id": 400320122,
					"content": "Que estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320123
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320123,
					"content": "Que tipo de apelido é esse afinal de contas!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320125,
					"content": "Hmm. Talvez devêssemos apenas voltar a chamar de \"Sombra\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320126
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320126,
					"content": "Seja qual for o caso, deixarei os animais com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320124,
					"content": "Parem de brigar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320125
					]
				}
			]
		},
		{
			"id": 4003203,
			"completionStepIds": [
				4003203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003203",
							"2"
						],
						"stepId": 4003203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400320301,
					"content": "Muito obrigado. Hmmm... Esses ainda não são todos eles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320302
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320302,
					"content": "Tantos animais sumiram assim, hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320303,
					"content": "Infelizmente é o caso, sim. Comparando estes com as missões que recebemos, deveríamos ter encontrado cerca da metade dos animais desaparecidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320304
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320304,
					"content": "Infelizmente, estamos novamente sem pistas. Felizmente, animais vivos são muito mais fáceis de investigar do que objetos inanimados, de qualquer forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320305
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320305,
					"content": "Recebemos recentemente um pedido semelhante de uma família importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320306
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320306,
					"content": "Nossas pistas esfriaram, e se não fosse pelas deduções da Sango, teríamos perdido completamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320307,
						400320325
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320307,
					"content": "Alguns detalhes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320308
					]
				},
				{
					"id": 400320308,
					"content": "Sim, sim, sim! Isso parece super interessante - vamos lá, vamos ouvir mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320309,
					"content": "Eu não sabia que você estava tão interessada em nosso trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320310
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320310,
					"content": "Na verdade, nós já tínhamos definido o nosso suspeito. O problema era que não conseguíamos encontrar nenhuma prova incriminatória em sua casa, nem encontramos nenhuma outra pista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320311
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320311,
					"content": "Mais tarde, ouvi, inteiramente por acaso, que nosso suspeito havia vendido algumas Erva Naku no dia anterior. Fui até o comprador para inspecionar o produto e descobri que ele ainda estava realmente fresco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320312
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320312,
					"content": "Depois de ouvir isso, Sango me fez ir ao sopé da Montanha Yougou para investigar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320313
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320313,
					"content": "Hã? Por que a Montanha Yougou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320314,
					"content": "\"Nosso suspeito vive na Ilha Narukami. Embora a Erva Naku possa ser encontrada em toda Inazuma, a maioria das pessoas precisa de um barco para chegar às outras ilhas, e não encontramos nenhum barco.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320315
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320315,
					"content": "\"Além disso, a Comissão Tenryou é muito sensível quanto ao uso de barcos devido ao Decreto Sakoku. Se nosso suspeito estivesse planejando cometer um crime, ele não o teria feito de tal forma que ficaria exposto à Comissão.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320316
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320316,
					"content": "\"Portanto, isso elimina as outras ilhas.\" Foi o que ela disse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320317
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320317,
					"content": "Mas há Erva Naku ao redor do Grande Santuário Narukami, não é? Por que você só verificou os sopés da Montanha Yougou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320318,
					"content": "Sango também considerou essa questão. \"A Erva Naku cresce ao redor do Grande Santuário Narukami, sim, mas as sacerdotisas estão lá, e muitos adoradores frequentam a área.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320319
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320319,
					"content": "\"Se alguma coisa fora do comum acontecesse ali, seria muito provável que fosse descoberta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320320
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320320,
					"content": "Ooh, então foi isso! Paimon consegue entender agora o motivo da Sango ser o cérebro da equipe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320321,
					"content": "Ao que parece, encontramos uma pilha de terra nos sopés que mostrou sinais de ter sido solta recentemente. Nosso suspeito tinha enterrado ali os objetos roubados e tinha a intenção de esperar passar a pressão antes de emergir e confiscar estes bens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320322
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320322,
					"content": "Mas ele pensou que poderia atrair suspeitas ao sair carregado de peso e voltar de mãos vazias, então ele coletou Erva Naku ao longo do caminho para vendê-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320323
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320323,
					"content": "Hah, mas também foi a Erva Naku que o fez ser pego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320324,
					"content": "De fato. Como tal, acredito que existem pistas nas proximidades. Apenas ainda não imaginei em como descobri-las ainda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320327
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320327,
					"content": "Acredito que nossa cooperação atual é bastante ideal. Afinal de contas, minha verdadeira especialidade é realizar tarefas, não em ser furtivo ou ser bom em combate. Deixar esta parte para você, na verdade, é bem conveniente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320328
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320328,
					"content": "E então, o que você acha? Você gostaria de trabalhar na Bantan Sango?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320329
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320329,
					"content": "Sango pode parecer um pouco... Complicada para falar, e ela diz coisas estranhas como \"a consciência retém a sabedoria\", mas ela é uma pessoa gentil no fim das contas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320330,
						400320331
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320330,
					"content": "Deixa para lá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320332
					]
				},
				{
					"id": 400320332,
					"content": "Que pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320333
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320333,
					"content": "Bem, agora que pensei nisso, acredito que seja para o melhor. Se a Sango tivesse alguém como você, eu estaria desempregado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320334
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320334,
					"content": "Vou continuar minhas investigações. Se você tem outras coisas em que precisa trabalhar, por favor, faça-as primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320335
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320335,
					"content": "Nos encontraremos novamente na agência quando chegar a hora. Mais uma vez, obrigado pelos seus esforços.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320331,
					"content": "#Obrigad{M#o}{F#a}, mas não, obrigad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320332
					]
				},
				{
