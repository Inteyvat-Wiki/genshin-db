				]
			},
			"dialogs": [
				{
					"id": 750761201,
					"content": "#Ah, finalmente... {M#herói}{F#heroína} de longe, se não fosse pela sua ajuda, poderíamos ter sido oprimidos pelo inimigo das trevas há muito tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761202
					],
					"speakerTitle": "Manifestação Wayob Enfraquecida"
				},
				{
					"id": 750761202,
					"content": "...Há muito tempo, o povo da tribo daqui foi enganado pela miragem do inimigo negro e muitos Espíritos da Noite ficaram emaranhados pelo Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761203
					],
					"speakerTitle": "Manifestação Wayob Enfraquecida"
				},
				{
					"id": 750761203,
					"content": "Naquele lugar onde o selo está, até mesmo o poder da noite manifestada está lentamente sendo extraído... Esse selo separou o vínculo com o mundo externo, bem como a fonte da fé da tribo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761204
					],
					"speakerTitle": "Manifestação Wayob Enfraquecida"
				},
				{
					"id": 750761204,
					"content": "Esse selo deve ser desfeito para termos sequer a mínima chance de lutar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761205
					],
					"speakerTitle": "Manifestação Wayob Enfraquecida"
				},
				{
					"id": 750761205,
					"content": "#Obrigado, {M#herói}{F#heroína} de longe... Os Espíritos da Noite podem finalmente encontrar seu caminho de volta para o lar dos sonhos nebulosos, evitando a praga que assola o reino de Yohualtecuhtin, da Dama da Noite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761206
					],
					"speakerTitle": "Manifestação Wayob Enfraquecida"
				},
				{
					"id": 750761206,
					"content": "Ah, finalmente, poder retornar para a quietude da noite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manifestação Wayob Enfraquecida"
				}
			]
		}
	]
