			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sakau"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750760401,
					"content": "A névoa no oceano anda ficando mais densa ultimamente. Ah... isso é preocupante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760404
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760404,
					"content": "Então, será que a lenda é real?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760405
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760405,
					"content": "Que lenda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760406
					]
				},
				{
					"id": 750760406,
					"content": "Err... Ah, isso depende de qual lenda você gostaria de ouvir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760407
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760407,
					"content": "Sobre a ilha flutuante e o enorme grafite, existem duas versões: Uma parece mais um conto, e a outra mais como uma lenda real.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760402
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760402,
					"content": "#Qual você gostaria de ouvir, Valente forasteir{M#o}{F#a}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760408,
						750760411
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760408,
					"content": "Sobre a história...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760409
					]
				},
				{
					"id": 750760409,
					"content": "Hmm, sempre há um toque mais romântico nas histórias... A origem do grafite na ilha flutuante enevoada é parte do Conto de Qoyllor e Ukuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760403
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760403,
					"content": "Diz-se que uma jovem chamada Qoyllor deixou uma imensa pintura naquela praia para se comunicar com seu pai do sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760410
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760410,
					"content": "Seu pai Sol viu o grafite do céu, e levou ela para longe da terra... A história é mais ou menos assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760417
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760417,
					"content": "Aquela névoa inquietante, dizem, é a punição do Pai Sol aos povos das terras por roubarem o poder de sua filha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760415,
					"content": "*Suspira* Seja a lenda ou a história, essa névoa nunca foi um bom sinal desde que apareceu do oceano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760416
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760416,
					"content": "#{M#Herói}{F#Heroína} de longe... Aquele lugar é provavelmente cheio de perigos, então você precisa ter cuidado para não se aproximar demais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760411,
					"content": "Sobre a verdadeira lenda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760412
					]
				},
				{
					"id": 750760412,
					"content": "Sobre isso... dizem que há muito tempo, havia um mago que se disfarçou como um Wayob e enganou os heróis da tribo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760413
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760413,
					"content": "Mais tarde, os heróis tribais tiveram que usar aquele grafite enorme para selar o mago negro dentro dele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760414
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 750760414,
					"content": "Dizem que o motivo pelo qual a superfície do oceano se parece assim é um mau presságio de quando o mago maligno quebrar o selo e escapar dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "Sakau"
				}
			]
		},
