	"talks": [
		{
			"id": 2010201,
			"completionStepIds": [
				2010201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010201",
							"2"
						],
						"stepId": 2010201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Draff"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020101,
					"content": "*Suspiro* Não sei como está este filho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020102
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020103
					]
				},
				{
					"id": 201020103,
					"content": "Hum? Oh, chegou no momento certo! Ainda se lembra daquela carta da última vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020104
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020104,
					"content": "Se tiver tempo, por favor entregue esta carta à Freira Grace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020105,
						201020107
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020105,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020106
					]
				},
				{
					"id": 201020106,
					"content": "Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020107,
					"content": "Por que eu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020108
					]
				},
				{
					"id": 201020108,
					"content": "Vou confiar nestes pombos mais, depois do que aconteceu na última vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020109
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020109,
					"content": "E... se eu for entregar a Mondstadt, com certeza vou encontrar este menino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020110
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020110,
					"content": "*Suspiro* Por favor, não pergunte mais, e entregue esta carta por mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
		{
			"id": 2010202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010202",
							"2"
						],
						"stepId": 2010202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Draff"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020201,
					"content": "Hum?... Eu pensei que você deveria estar entregando minha carta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020202,
						201020205
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020202,
					"content": "Sobre esta carta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020203
					]
				},
				{
					"id": 201020203,
					"content": "...É sobre as histórias antigas. Você não leu na última vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020204
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020204,
					"content": "Esquece, não precisa ler. É muito chato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020205,
					"content": "Quem é este menino?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020206
					]
				},
				{
					"id": 201020206,
					"content": "Caso você queira saber, me refiro ao menino que sempre alimentava os pombos na ponte, ainda se lembre dele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020207
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020207,
					"content": "É o Timmie. É melhor não o ver agora por certas razões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020208
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020208,
					"content": "Satisfeito? Rápido! Entregue esta carta a Freira Grace antes que ela comece a pensar coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
		{
			"id": 2010203,
			"completionStepIds": [
				2010202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010202",
							"2"
						],
						"stepId": 2010202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020301,
					"content": "Que estranho! Ele devia estar cá, aconteceu alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020302
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020302,
					"content": "Este é a carta do Draff para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020303
					]
				},
				{
					"id": 201020303,
					"content": "Hmm? O que você está fazendo aqui? Você não é o pombo-mensageiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020304
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020304,
					"content": "Passou algo aos pombos? Sempre ocorrem coisas estranhas no Vale Termal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020305
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020305,
					"content": "Muito obrigada por me trazer a carta. Espere um momento, preparei uma pequena recompensa para você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020306
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020306,
					"content": "Sobre esta carta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020307
					]
				},
				{
					"id": 201020307,
					"content": "Você já leu? Se não, não faz mal. Não é nada confidencial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020308
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020308,
					"content": "Nas palavras do Draff, são apenas \"coisas no passado\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020309
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020309,
					"content": "Só que... nunca nos esqueceremos das \"coisas no passado\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020310
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020310,
					"content": "Por favor, continue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020311
					]
				},
				{
					"id": 201020311,
					"content": "Você quer saber? Bem, você é uma pessoa confiável... Mas tem que prometer que não vai dizer a ninguém.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020312,
						201020313
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020312,
					"content": "Eu prometo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020316
					]
				},
				{
					"id": 201020316,
					"content": "O pai do Timmie é um bom amigo do Draff, eles fazem tudo juntos, caçar, beber, causar problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020317
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020317,
					"content": "Eu não sei quantas vezes eles foram alertados pelos Cavaleiros e exortados pela Freira Victoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020318
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020318,
					"content": "Depois que o Timmie nasceu, o pai dele começou a ser mais reservado, e se tornou abstêmio. Começou a trabalhar bem para sustentar a família, e para \"dar um bom exemplo ao filho\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020319
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020319,
					"content": "Ele ficou tão obcecado por dar um bom exemplo ao Timmie que conseguiu tornar o Draff abstémio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020320
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020320,
					"content": "Quando não conseguiam resistir, bebiam sidra de maçã. De vez em quando, eu me juntava a eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020321
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020321,
					"content": "Mas infelizmente o pai do Timmie ficou gravemente ferido em uma caçada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020322
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020322,
					"content": "Mesmo que tenhamos o trazido imediatamente para hospital, e tentamos o nosso melhor para curá-lo, mas infelizmente ele faleceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020323
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020323,
					"content": "Desde então, o Draff me pediu para eu tomar cuidado do Timmie, e ele voltou a trabalhar como caçador no Vale Termal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020324
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020324,
					"content": "Ele manda dinheiro e cartas todos os meses, mas não quer encarar o Timmie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020325
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020325,
					"content": "Recentemente, ele começou a dizer que quer contar a Timmie a verdade sobre aquele dia trágico. *Suspiro* Temo em pensar no que ele deve ter passado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020326,
						201020332,
						201020336
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020326,
					"content": "Você não quer dizer a verdade ao Timmie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020327
					]
				},
				{
					"id": 201020327,
					"content": "Não, não quero. Ele ainda é uma criança. Não acho o momento certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020328
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020328,
					"content": "Mesmo que ele sempre diga que já é um rapaz grande, e até tome cuidado da Nora e Glory.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020329
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020329,
					"content": "... Não tenho certeza de que ele consegue lidar com estes detalhes grotescos. É demais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020330
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020330,
					"content": "Antes de ficar maduro o suficiente para saber a verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020331
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020331,
					"content": "Queria lhe dar uma infância feliz, não se importa de esconder a verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020341,
					"content": "Mas o Timmie está crescendo, e perguntando cada vez mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020342
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020342,
					"content": "Já está sendo cada vez mais difícil encará-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020343
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020343,
					"content": "A Nora disse que antes o Timmie sempre a arrastou para a natureza, a fim de preparar presentes para o pai, e queria lhe mandar cartas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020344
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020344,
					"content": "Mas ultimamente... Timmie sempre está triste, e distraído.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020345
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020345,
					"content": "Se você tiver tempo, poderia ir vê-lo por mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020346,
						201020348
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020346,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020347
					]
				},
				{
					"id": 201020347,
					"content": "Conto contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020348,
					"content": "Por que você não faz você mesmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020349
					]
				},
				{
					"id": 201020349,
					"content": "Mesmo que já tendo pensando mil vezes que não vou dizer a verdade a ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020350
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020350,
					"content": "Cada vez que o Timmie disse que ia escrever cartas, parte o meu coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020351
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020351,
					"content": "Temo que lhe diga a história toda um dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020352
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020352,
					"content": "... Isso não pode acontecer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020353
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020353,
					"content": "Então, por favor, você poderia ir ver o Timmie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020332,
					"content": "Você não pode esconder para sempre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020333
					]
				},
				{
					"id": 201020333,
					"content": "Sim, é verdade. Mas o Timmie ainda é uma criança...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020334
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020334,
					"content": "Mas espero.. Não, eu insisto que ele tenha a chance de uma infância feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020335
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020335,
					"content": "Assim, se ele sofrer de alguma desgraça, tem sempre boas memórias para confortá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020336,
					"content": "O que há de ruim com saber a verdade?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020337
					]
				},
				{
					"id": 201020337,
					"content": "*Suspiro*... Bom, faz sentido pensar assim. Você já teve bastantes experiências aventureiras para obter coragens e resiliências.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020338
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020338,
					"content": "Devem ser dolorosas as experiências que te tornaram em uma pessoa assim tão extraordinária.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020339
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020339,
					"content": "Mas o Timmie ainda é pequeno. Talvez eu seja egoísta, mas não quero que ele assuma o que não consegue suportar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020340
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020340,
					"content": "...Pelo menos, quero que ele tenha uma infância feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020313,
					"content": "Eu farei o meu melhor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020314
					]
				},
				{
					"id": 201020314,
					"content": "Ugh, você é insuportável.",
