						201020415
					]
				},
				{
					"id": 201020415,
					"content": "Sim, queria enviar mais, mas vai ser muito pesado. Os pombos não conseguem voar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020416
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020416,
					"content": "E o meu pai trabalho longe, então os pombos têm que voar por muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020405,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
