					"nextDialogs": [
						201020413
					]
				},
				{
					"id": 201020413,
					"content": "#Não se preocupe! É simpátic{M#o}{F#a} de vez em quando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020414,
					"content": "Só Dandelions?",
