					"nextDialogs": [
						201020409
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020409,
					"content": "Então estou pensando em mandar cartas como ele está tão ocupado, com um presente pequeno dentro da carta... mas que tipo de presente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020410
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020410,
					"content": "Ah, já sei! <color=#00E1FFFF>Dandelion</color>! A mãe diz que todo mundo gosta de Dandelion em Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020411
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020411,
					"content": "Se tiver tempo, poderia procurar algum <color=#00E1FFFF>Dandelion</color> por mim?",
