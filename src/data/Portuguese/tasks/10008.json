			"dialogs": [
				{
					"id": 100080101,
					"content": "Razor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080102,
					"content": "*Cheira* Cheiro familiar. Ah, são vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080103
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080103,
					"content": "Vocês, bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080104,
					"content": "Hehe, sim! A gente tá indo muito bem! Ah, mas o que aconteceu com Boreas, Razor? A gente viu vocês conversando agora há pouco. É um segredo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080105,
					"content": "Fomos caçar. Tentei, convencer... senhor dos lobos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080106
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080106,
					"content": "Uma caçada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080107,
					"content": "#(Ah, {NICKNAME}, será que essa é a \"tarefa\" do Razor?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080108,
					"content": "Os lobos estão sem comida? É por isso que vocês vão caçar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080109,
						100080110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080109,
					"content": "Me dê algumas armadilhas de caça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080111
					]
				},
				{
					"id": 100080111,
					"content": "Não. Essa caçada não é por comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080112
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080112,
					"content": "Nós caçamos... inimigos. A matilha sombria. Cheiro estranho vindo das terras que tomaram. Está ficando mais forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080113
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080113,
					"content": "Devemos caçar inimigos, purificar floresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080114
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080114,
					"content": "Ah, então Boreas concordou? Paimon lembra que da última vez ele disse algo tipo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080115,
					"content": "*Cof cof*, \"Razor, você não deve se envolver. Isso é algo que os lobos devem resolver entre si.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080117
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080117,
					"content": "Ah, desculpa, Razor. Paimon não queria tocar nesse assunto de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080118,
					"content": "Tudo bem. Sei que Lupical não tem más intenções. Além disso, mestra me ensinou a falar com Senhor dos Lobos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080119
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080119,
					"content": "A Lisa te ensinou a falar com ele...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080120,
					"content": "Ah! Tipo, ela te disse o que dizer? Então isso quer dizer que você conseguiu fazer ele concordar, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080121,
					"content": "Sim. As palavras foram... difíceis. Mas eu consegui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080122
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080122,
					"content": "Hah, então você conseguiu mesmo convencer aquele grandalhão teimoso! Que impressionante, Razor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080123,
					"content": "Lobos sombrios são inimigos do mundo inteiro. Professora disse que não é problema de lobo. É problema de mundo... Senhor dos lobos concordou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080124
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080124,
					"content": "Mas, por causa disso, outros lobos não se juntam. Essa guerra é entre alcateia sombria e eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080125
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080125,
					"content": "Então conta com a gente! Esses Cães da Fenda terríveis têm atrapalhado a gente há um tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080126,
					"content": "O-Obrigado... Ajuda faz caça mais fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080127
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080127,
					"content": "Falando nisso, como vai ser essa caçada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080128,
					"content": "Prepara armadilha. Persegue lobos sombrios até aqui. Cai na armadilha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080129
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080129,
					"content": "Aí senhor dos lobos prende eles e a gente... termina caçada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080130
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080130,
					"content": "Me fale quando tudo pronto. A gente começa caçada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080401
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080401,
					"content": "Vamos nessa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 100080110,
					"content": "Os Javalis do Bosque já cresceram suficiente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080111
					]
				}
			]
		},
