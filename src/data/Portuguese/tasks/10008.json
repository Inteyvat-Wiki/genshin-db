					}
				]
			},
			"dialogs": [
				{
					"id": 100080301,
					"content": "Essa foi perto! Ainda bem que os lobos estavam aqui pra ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080302,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080303
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080303,
					"content": "Eles interceptaram aqueles Cães da Fenda pra gente e os expulsaram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080304,
					"content": "Mas isso não é... problema de lobos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080305
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080305,
					"content": "Hehe, você tá fazendo isso pra ajudar sua Lupical, certo? Bem, eles querem que você fique em segurança também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080306,
					"content": "Paimon aposta que eles foram até o Lupus Boreas e disseram: \"Ouça aqui! Esse não é só o problema do nosso Lupical. É um problema do mundo inteiro!\"... E então correram para ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080307,
					"content": "Hm, \"Lupical\" é... \"Lupical.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080308
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080308,
					"content": "Sou humano, mas não preciso ser lobo para ser \"Lupical.\" Eu... só quero ajudá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080309
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080309,
					"content": "Muito bem dito, Razor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080310,
					"content": "Talvez o Lupus Boreas tenha concordado em deixar a alcateia ajudar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080311
					]
				},
				{
					"id": 100080311,
					"content": "Porque ele conhece seu coração.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080312
					]
				},
				{
					"id": 100080312,
					"content": "Você... acha mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080313
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080313,
					"content": "Sim, com certeza! Agora, vamos! Vamos detonar esses Cães da Fenda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1000806,
