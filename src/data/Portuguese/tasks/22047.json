				{
					"id": 220470401,
					"content": "Suas habilidades estão tão aguçadas como sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470402
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470402,
					"content": "Espero que você tenha acompanhado de perto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470403
					]
				},
				{
					"id": 220470403,
					"content": "Claro que estava! Eu estava observando tudo, desde o seu controle ao segurar até o seu lançamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470404
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470404,
					"content": "...Hmm, no entanto, como devo dizer isto? Parece que quanto mais eu assisto, mais eu posso sentir a enorme diferença entre nossas habilidades...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470405
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470405,
					"content": "B-bem, o melhor é não ficar pensando nisso agora. Por favor, aceite isso como agradecimento por esta demonstração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470406
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470406,
					"content": "Vou começar a treinar daqui a pouco. Vamos estabelecer nossa meta em... Sete de cada dez tiros, que tal assim?",
