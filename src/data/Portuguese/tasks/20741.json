					"content": "Já.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207412005
					]
				},
				{
					"id": 207412005,
					"content": "De qualquer forma, eu realmente espero que o Lorde Barbatos seja capaz de ouvir a minha voz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207412006
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207412006,
					"content": "Muito obrigada pela sua boa vontade em ajudar. Por favor, pegue isto pelo seu trabalho - e que o Arconte Anemo te proteja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 207412003,
					"content": "O vento irá espalhá-las bem longe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207412004
					]
				},
				{
					"id": 207412004,
					"content": "Isso é maravilhoso. Deve ser fácil do Lorde Barbatos notar.",
					"roleType": "TALK_ROLE_NPC",
