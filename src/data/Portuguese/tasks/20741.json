			"dialogs": [
				{
					"id": 207411001,
					"content": "Você coletou as sementes de Dandelion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411002
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411002,
					"content": "Tenho elas bem aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207411003
					]
				},
				{
					"id": 207411003,
					"content": "Estas devem ser suficientes. Por favor, espere um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411004
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411004,
					"content": "... Lorde Barbatos, por favor me escute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411005
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411005,
					"content": "Uau, ela é tão... Devota. Tantas.. Palavras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207411006,
					"content": "Quem sabe se aquele Bardo Desafinado consegue ouvir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207411007,
					"content": "Certo. Pegue estas sementes de Dandelion. Me ajude a espalhá-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411008
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411008,
					"content": "Eu deveria fazer isso eu mesmo, mas com minhas habilidades físicas... Eu provavelmente sofreria bastante tentando descer, isso é se eu sequer conseguisse subir lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411009
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411009,
					"content": "Então conto com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
