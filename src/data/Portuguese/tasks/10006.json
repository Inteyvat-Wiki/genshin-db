			"dialogs": [
				{
					"id": 100060901,
					"content": "Na verdade, do ponto de vista biológico, não sou um gato de modo algum, mas sim um ser alquímico. Você não se consideraria um Espectro só porque flutua no ar como um, não é mesmo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060902
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060902,
					"content": "Um Espectro? O que está tentando dizer, senhor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060903,
					"content": "Ah, eu sei! O Sebas está insinuando que você...",
					"roleType": "TALK_ROLE_NPC",
