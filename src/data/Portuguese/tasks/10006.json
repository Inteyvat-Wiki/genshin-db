				{
					"id": 100060803,
					"content": "#Sim! Já estamos acostumad{M#o}{F#a}s a gatos falantes, mas um que consegue imitar a voz de outra pessoa... Essa é nova.",
					"roleType": "TALK_ROLE_NPC",
