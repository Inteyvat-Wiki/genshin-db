			"dialogs": [
				{
					"id": 100060601,
					"content": "Hmm. Parece que Albedo não estava enganado, afinal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060602
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060602,
					"content": "Da próxima vez, talvez não nos ataque com um monte de monstros só pra provar um ponto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060603,
					"content": "Ainda assim, sinto que agora consigo controlar meu poder com mais liberdade, depois de derrotá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060604
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060604,
					"content": "Depois de ouvir sobre você, preparei uma técnica capaz de selar o poder sombrio em seu sangue. Eu planejava aproveitar esta oportunidade para transmiti-la a você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060605
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060605,
					"content": "Claro, usá-la tem um preço. Embora ela mantenha sua existência em Teyvat, também enfraquecerá sua conexão com este mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060606
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060606,
					"content": "E você é filho de M, no fim das contas. Como eu poderia encará-la de consciência tranquila, se esse poder descontrolado o levasse pelo mesmo caminho que a criança que veio antes de você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060607
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060607,
					"content": "Mas, vendo você agora, parece que minhas preocupações eram infundadas. M é uma mãe excelente e muito mais capaz do que eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060608
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060608,
					"content": "E devo admitir, tenho bastante curiosidade para ver até onde você pode ir, como você, um ser alquímico verdadeiramente integrado a este mundo, encontrará seu lugar na sociedade humana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060609
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060609,
					"content": "Nunca conduzi um experimento como este antes. Sendo assim, você ainda pode conter a chave para algumas respostas inesperadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060610
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060610,
					"content": "Ei! Tem uma coisa aí que você entendeu errado. O Durin não é um experimento! Ele é nosso amigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060611,
					"content": "Não tenho certeza se entendi, mas... agradeço por sua gentileza, Tia Rhinedottir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Durin"
				}
			]
		},
