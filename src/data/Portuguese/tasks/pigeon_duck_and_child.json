			"trigger": {
				"objectNames": [
					"Timmie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200480101,
					"content": "Argh! Você, de novo! Você assustou os meus pombos, de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480102
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480102,
					"content": "Eu ainda estou alimentando eles, o que você está fazendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480103
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480103,
					"content": "Me desculpe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480104
					]
				},
				{
					"id": 200480104,
					"content": "Hunf! Bem, a mãe sempre dizia que se alguém realmente se sentisse culpado, eles mostrariam o seu arrependimento com ações e não com palavras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480105
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480105,
					"content": "Os pombos na ponte são os meus amigos, sempre os alimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480106
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480106,
					"content": "Mas hoje em dia os patos estão chegando e roubando sua comida, e os pombos nunca mais têm o que comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480107
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480107,
					"content": "Quero que você encontre três trigos para mim e os dê aos patos. Enquanto você faz isso, posso garantir que os pombos da ponte terão o suficiente para comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480108
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480108,
					"content": "Uma vez que comam o suficiente, poderão conviver em paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480109,
						200480110
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480109,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480111
					]
				},
				{
					"id": 200480111,
					"content": "Obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480112
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480112,
					"content": "Se tratar bem os animais, você também pode fazer amigos com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480110,
					"content": "Eu não estou em busca da amizade dos pombos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480113
					]
				},
				{
					"id": 200480113,
					"content": "Independentemente de você querer ser amigos ou não, tem que pedir desculpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480114
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480114,
					"content": "Então, se apresse e consiga o trigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
		},
