			"dialogs": [
				{
					"id": 740841201,
					"content": "...Melusine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841202
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841202,
					"content": "Pahsiv? De onde você veio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841203,
					"content": "Desapareceu, Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841204
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841204,
					"content": "Tudo bem, certo, mas fique longe desse Dragarto! É perigoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841205,
					"content": "Paimon boa, Pahsiv! Perigo, Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841206
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841206,
					"content": "Pahsiv ergue sua mão para acariciar a cabeça do Dragarto furioso e a besta obedientemente deita.\\nEle abre sua boca, tosse uma gota luminosa de água, então volta para a água.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740841207
					]
				},
				{
					"id": 740841207,
					"content": "Chave, chave, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841208
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841208,
					"content": "Uau. O Dragarto te deu a chave quando você pediu. Que inesperado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841209,
					"content": "Coisa azul, coisa boa, chave, protege.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841210
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841210,
					"content": "Com coisa azul, você quer dizer, o Dragarto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841211
					]
				},
				{
					"id": 740841211,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841212
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841212,
					"content": "Ele estava te ajudando a cuidar da chave? Você e o Dragarto são amigos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841213,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841214
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841214,
					"content": "Coisa roxa, roubar chave... coisa azul, desmaiou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841215
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841215,
					"content": "C-Coisa roxa? Quem é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841216,
					"content": "#Coisa roxa, coisa ruim! Coisa azul, Paimon, {NICKNAME}, coisa boa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841217
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841217,
					"content": "Er... tudo bem. Isso tudo é meio estranho, mas parece que você está elogiando a gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841218,
					"content": "Coisa roxa, muito ruim, Erinnyes, muito Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841219
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841219,
					"content": "Mesmo assim, Paimon nunca conheceu uma Melusine tão única quanto você... achávamos que todas as Melusines viviam na Corte de Fontaine ou na Vila Marusea. Por que você está aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841220,
					"content": "Corte de Fontaine? Vila Marusea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841221
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841221,
					"content": "Você parece confusa. Nunca ouviu falar desses lugares?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841222,
					"content": "Corte de Fontaine, Melusine... Vila Marusea, Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841223
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841223,
					"content": "Ah... Erinnyes, Pahsiv, casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841224
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841224,
					"content": "Erinnyes, Pahsiv, proteger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841225
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841225,
					"content": "Espera, você está dizendo que essa é a sua casa? E que você está protegendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841226,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841227
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841227,
					"content": "Mas as Melusines não vivem na Vila Marusea?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841228
					]
				},
				{
					"id": 740841228,
					"content": "Sim, isso é meio estranho. Algumas Melusines nascem em outro lugar? Mas Paimon não vê outras por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841229,
					"content": "Pahsiv, você vive aqui sozinha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841230,
					"content": "Sozinha? Melusine. Nuvem Chiclete! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841231
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841231,
					"content": "Nuvem... Chiclete? Que Nuvem? Onde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841232,
					"content": "#Nuvem... Chiclete! Paimon, Paimon, {NICKNAME}, {NICKNAME}. Nuvem Chiclete, Nuvem Chiclete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841233
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841233,
					"content": "Quem é Nuvem Chiclete, exatamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841234
					]
				},
				{
					"id": 740841234,
					"content": "Pahsiv, você está tentando dizer que Nuvem Chiclete se chama Nuvem Chiclete, assim como Paimon se chama Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841235,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841236
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841236,
					"content": "Ahá! Eu estava certa. Paimon sempre disse que ela era esperta, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841237,
						740841238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841237,
					"content": "Que nome estranho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841239
					]
				},
				{
					"id": 740841238,
					"content": "É um nome incrível.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841239
					]
				},
				{
					"id": 740841239,
					"content": "Nuvem Chiclete, Pahsiv, conhecimento, pow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841240
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841240,
					"content": "Errr... você quer dizer que o Nuvem Chiclete está te ajudando a aprender coisas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841241,
					"content": "Pahsiv! Muito. Linguagem, conhecimento... muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841242
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841242,
					"content": "Errr... Paimon não tem certeza sobre a parte de \"muito\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841243,
					"content": "Pahsiv, Nuvem Chiclete, proteger, pow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841244
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841244,
					"content": "E ele te ajuda a proteger esse lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841245,
					"content": "Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841246
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841246,
					"content": "Você ajuda ele a proteger esse lugar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841247
					]
				},
				{
					"id": 740841247,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841248
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841248,
					"content": "Então é isso... mas quem é esse Nuvem Chiclete? E por que ele precisa da sua ajuda para proteger esse lugar no fim das contas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841249,
					"content": "Algumas coisas ruins aconteceram aqui, também. Vimos a Placa de Pedra, e como alguém borrou as inscrições. E vimos muitas impurezas... Isso tudo foi por causa da coisa roxa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841250
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841250,
					"content": "Paimon curiosa, Pahsiv! Mas tempo não muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841251
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841251,
					"content": "Chave, chave, chave, praça, oeste, pow, pá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841252
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841252,
					"content": "Iremos o mais rápido possível!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841253
					]
				},
				{
					"id": 740841253,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841254
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831040,
					"content": "Pahsiv dá dois pulos felizes e então sai apressada.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740831041
					]
				},
				{
					"id": 740841255,
					"content": "Parece que realmente estamos sem tempo. Mas já temos duas chaves, então vamos continuar e pegar a terceira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}