			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 718020301,
					"content": "Informe imediatamente o que você quer! Há uma miríade de assuntos aos quais devo atender. Não desperdice o tempo valioso de um Adeptus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020302
					],
					"speakerTitle": "Visitar a Casa do Adeptus"
				},
				{
					"id": 718020302,
					"content": "Só queria saber como você está...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020303
					]
				},
				{
					"id": 718020303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020304
					],
					"speakerTitle": "Visitar a Casa do Adeptus"
				},
				{
					"id": 718020304,
					"content": "Seus assuntos são inovadores... Você veio apenas para me ver bem, e não para cumprir um desejo de outra natureza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020305
					],
					"speakerTitle": "Visitar a Casa do Adeptus"
				},
				{
					"id": 718020305,
					"content": "Muito bem, que seja! As mentes mortais trabalham de maneiras misteriosas... Não tenho nenhum interesse em tentar compreendê-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020306
					],
					"speakerTitle": "Visitar a Casa do Adeptus"
				},
				{
					"id": 718020306,
					"content": "Já que você evidentemente está sem nada para fazer... Você se importaria em me fazer um pequeno favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020307
					],
					"speakerTitle": "Visitar a Casa do Adeptus"
				},
				{
					"id": 718020307,
					"content": "Uma vez, quando eu havia feito um modesto avanço em meus estudos mecânicos, eu construí para mim mesmo uma Moradia nas Nuvens, suspensa ao ar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020308
					],
					"speakerTitle": "Visitar a Casa do Adeptus"
				},
				{
					"id": 718020308,
					"content": "Essa Moradia nas Nuvens foi construída principalmente a partir de Plaustrite, apoiada por uma infinidade de outros mecanismos engenhosos... A característica mais incrível de todas foi, foi... Bem, não importa, você não entenderia mesmo se eu explicasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020309
					],
					"speakerTitle": "Visitar a Casa do Adeptus"
				},
				{
					"id": 718020309,
					"content": "Depois que a construção da Moradia nas Nuvens foi concluída, deixei os projetos lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020310
					],
					"speakerTitle": "Visitar a Casa do Adeptus"
				},
				{
					"id": 718020310,
					"content": "Eu também acrescentei um selo, pensando que um de verdadeira afinidade com os projetos poderiam eventualmente obtê-las. Mas não - até hoje, o selo permanece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020311
					],
					"speakerTitle": "Visitar a Casa do Adeptus"
				},
				{
					"id": 718020311,
					"content": "Agora me parece mais um incômodo desnecessário ter os projetos armazenados lá. Talvez você pudesse recuperá-las da Moradia nas Nuvens para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020312,
						718020314
					],
					"speakerTitle": "Visitar a Casa do Adeptus"
				},
				{
					"id": 718020312,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020313
					]
				},
				{
					"id": 718020313,
					"content": "Tanto entusiasmo. Então não demore, entregue-os em minha casa quando os tiver encontrado, pois, é lá que eu estarei esperando por você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Visitar a Casa do Adeptus"
				},
				{
					"id": 718020314,
					"content": "O que você vai fazer com isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020315
					]
				},
				{
					"id": 718020315,
					"content": "Naturalmente, eu tenho meus motivos. Mas por favor, não presuma que você seria capaz de escrutinar uma ideia concebida na mente de um Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020316
					],
					"speakerTitle": "Visitar a Casa do Adeptus"
				},
				{
					"id": 718020316,
					"content": "Não demore! Entregue-os em minha residência quando os tiver encontrado, pois, é lá que eu estarei esperando por você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Visitar a Casa do Adeptus"
				}
			]
		},
