					"nextDialogs": [
						718021308
					],
					"speakerTitle": "Retentora de Nuvem...?"
				},
				{
					"id": 718021308,
					"content": "Uhuull! Hehe, Paimon sabia que você não deixaria a gente ir embora de mãos abanando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021309,
					"content": "Mas, Essa voz diz \"Escreva seu desejo e o coloque no baú.\" Paimon acha que a gente só escreve o desejo e coloca na caixa?",
