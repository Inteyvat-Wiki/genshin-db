					"Retentora de Nuvem"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718020201,
					"content": "Estes certamente são os projetos para a minha Moradia nas Nuvens. Estou bem satisfeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020202
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 718020202,
					"content": "Você ainda não disse o que você vai-",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020203
					]
				},
				{
					"id": 718020203,
					"content": "Você vai mesmo continuar me questionando? *Suspiro* Muito bem, considerando que você me fez uma oferenda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020204
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 718020204,
					"content": "Já se ouviu falar de uma certa Câmara de Jade, que paira no ar acima de Liyue, construída por mãos mortais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020205
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 718020205,
					"content": "Também já se ouviu falar que os mortais valorizam tamanho acima de tudo, e desta forma seguiram em declarar que essa câmara é sem comparação em todo o mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020206
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 718020206,
					"content": "Hunf! Tais são os limites da compreensão mortal, eles falham em entender a genialidade dos Adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020207
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 718020207,
					"content": "Essa Câmara de Jade é insignificante! Uma pequena amostra da mais trivial das minhas proezas mecânicas demonstrariam que a Câmara de Jade é só mais um trabalho absolutamente enfadonho e mundano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020208
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 718020208,
					"content": "Mau perdedor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020209
					]
				},
				{
					"id": 718020209,
					"content": "Besteira! Eu não sou um mau perdedor, nem estou com inveja... Eu só tenho pena dos idiotas! Estes mortais, cegos as habilidades dos Adepti, deslumbrados pela mais crua forma de artesanato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020210
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 718020210,
					"content": "Temo que isto irá causar com que a mecânica entre os mortais se desenvolva em uma direção terrivelmente equivocada. Cabe a mim, apontá-los na direção certa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020211
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 718020211,
					"content": "O assunto em questão já foi encerrado. Vá embora logo, não me incomode mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Retentora de Nuvem"
				}
			]
		},
		{
			"id": 7180203,
			"completionStepIds": [
				7180207
			],
