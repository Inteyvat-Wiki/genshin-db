			"dialogs": [
				{
					"id": 718020401,
					"content": "Você ainda não conseguiu os projetos? Mas eles estão logo lá, na Moradia nas Nuvens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020402
					],
					"speakerTitle": "Visitar a Casa do Adeptus"
				},
				{
					"id": 718020402,
					"content": "Ugh, como que ela sabia que nós não tínhamos pegado eles ainda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718020403,
					"content": "Estes projetos são de minha própria criação, como eu não seria capaz de sentir quando eles estão em minha presença? Agora, vá trazê-los para mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Visitar a Casa do Adeptus"
				}
			]
		},
