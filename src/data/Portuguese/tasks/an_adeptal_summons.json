			"dialogs": [
				{
					"id": 718021001,
					"content": "Buscar os Adepti em Jueyun não é uma tarefa fácil. Mesmo assim, vocês vieram...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021002
					],
					"speakerTitle": "Visitar a Casa do Adeptus",
					"speakerSubtitle": "...Parece que tem algo errado com ela."
				},
				{
					"id": 718021002,
					"content": "Opa! E-Ela já não voltou para o Porto de Liyue? Ela voltou de fininho enquanto não estávamos olhando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021003,
					"content": "A voz dela... não parece certa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021004
					]
				},
				{
					"id": 718021004,
					"content": "#Hmm, então, só estávamos preocupad{M#os}{F#as} que alguém pudesse roubar coisas da sua casa. A gente não queria te incomodar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021005,
					"content": "...Esta tem uma tarefa que vocês podem realizar. Façam isso direito e o acesso à morada desta será concedido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021006,
						718021007
					],
					"speakerTitle": "Visitar a Casa do Adeptus",
					"speakerSubtitle": "...Parece que tem algo errado com ela."
				},
				{
					"id": 718021006,
					"content": "Ela só está falando sozinha a essa altura...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021008
					]
				},
				{
					"id": 718021008,
					"content": "Err, você quer dizer que não tá falando com ela, mas algum mecanismo que ela deixou para trás?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021009,
					"content": "Uma vez, quando esta havia feito um modesto avanço em meus estudos mecânicos, esta construiu para si uma Moradia nas Nuvens, suspensa ao ar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021010
					],
					"speakerTitle": "Visitar a Casa do Adeptus",
					"speakerSubtitle": "...Parece que tem algo errado com ela."
				},
				{
					"id": 718021010,
					"content": "Quando tal moradia estava completa, esta pensou na raridade de encontrar um adeptus, então esta deixou o diagrama lá para alguma pessoa sortuda encontrá-lo",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021011
					],
					"speakerTitle": "Visitar a Casa do Adeptus",
					"speakerSubtitle": "...Parece que tem algo errado com ela."
				},
				{
					"id": 718021011,
					"content": "Recupere o diagrama e entre na morada desta mais uma vez. Falaremos mais então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021012
					],
					"speakerTitle": "Visitar a Casa do Adeptus",
					"speakerSubtitle": "...Parece que tem algo errado com ela."
				},
				{
					"id": 718021012,
					"content": "Hmm, Senhora Adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021013
					]
				},
				{
					"id": 718021013,
					"content": "Retentora de Nuvem? Hmm, Srta. Xianyun...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021014,
					"content": "Recupere o diagrama para concluir essa tarefa e entre na morada desta mais uma vez. Falaremos mais então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021015
					],
					"speakerTitle": "Visitar a Casa do Adeptus",
					"speakerSubtitle": "...Parece que tem algo errado com ela."
				},
				{
					"id": 718021015,
					"content": "Ela continua sem parar e sem prestar atenção na gente, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021016,
						718021017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021016,
