			"dialogs": [
				{
					"id": 225000101,
					"content": "Quando será que ficará pronto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000102
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 225000102,
					"content": "Sem recreio hoje?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000103
					]
				},
				{
					"id": 225000103,
					"content": "Oh, olá! Não, a hora do recreio parece que não chega nunca estes dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000104
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 225000104,
					"content": "O Pequeno Meng está de mau humor e prefere ficar emburrado sozinho, e o Pequeno Fei vive sumindo o tempo inteiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000105
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 225000105,
					"content": "Eu perguntei ao Pequeno Meng o que há de errado, mas ele não queria me dizer. Os dois estão agindo de forma tão estranha ultimamente, honestamente não faço ideia do que houve com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000106,
						225000110
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 225000106,
					"content": "Bem-vinda ao mundo dos adultos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000107
					]
				},
				{
					"id": 225000107,
					"content": "Espera, quer dizer que quando você cresce você deixa de ser feliz? Então por que o Pequeno Meng e o Pequeno Fei querem tanto crescer...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000108
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 225000108,
					"content": "Acho que apenas não crescerei então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000109
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 225000109,
					"content": "De qualquer forma, estamos ficando distraídos. Na verdade, eu preciso da sua ajuda com algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 225000112,
					"content": "Você poderia ir buscar algo na casa de Ying'er, para mim? Já falamos sobre isso, ela já deve tê-lo pronto a esta altura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000113,
						225000115
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 225000113,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000114
					]
				},
				{
					"id": 225000114,
					"content": "Yay! Obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 225000115,
					"content": "Casa da Ying'er, hm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000116
					]
				},
				{
					"id": 225000116,
					"content": "Eu não sei sobre o que você está pensando, mas não é isto. Só pedi que a Ying'er fizesse algo para mim. E ela disse que faria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000117
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 225000117,
					"content": "Então agora estou pedindo gentilmente que você me ajude a pegá-lo para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 225000110,
					"content": "Você está infeliz também?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000111
					]
				},
				{
					"id": 225000111,
					"content": "Eu? Não, estou bem. Mas... Eu preciso da sua ajuda com algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "Pequena Lulu"
				}
			]
		},
