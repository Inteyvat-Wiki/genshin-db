			"dialogs": [
				{
					"id": 225000201,
					"content": "Ora, olá novamente. Já sentiu saudades de mim, hein? O que você está fazendo aqui desta vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000202
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000202,
					"content": "Para pegar algo para a Pequena Lulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000203
					]
				},
				{
					"id": 225000203,
					"content": "Pequena Lulu? ...Ah sim, lembrei. Ela me pediu para fazer um perfume para ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000204
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000204,
					"content": "Mas temo que não seja a melhor hora... Por algum motivo, desde a última vez que você esteve aqui, meus serviços de cheiros agradáveis têm tido uma demanda excepcionalmente alta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000205
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000205,
					"content": "Tive um enorme número de pedidos. São muitos para eu lidar sozinho, especialmente porque também tenho uma loja para cuidar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000206
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000206,
					"content": "Além disso, Lulu é só uma criança. Seria inapropriado dar a ela o mesmo tipo de perfume que uma mulher adulta usa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000207
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000207,
					"content": "Por isso, eu estava tentando pensar em uma maneira de tornar meu perfume mais amigável para as crianças. Agora que finalmente decidi em uma fórmula adequada, não consegui um tempo para fazê-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000208
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000208,
					"content": "Se isso absolutamente não puder esperar, não seria possível de acelerar o processo, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000209
					],
					"speakerTitle": "Ying'er"
				}
			]
		},
