					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000404,
					"content": "Vá pegar três folhas de Menta e depois extraia seu óleo essencial em um Balcão de Síntese. Acredito que você já esteja intimamente familiarizado com a técnica, certo?",
					"roleType": "TALK_ROLE_NPC",
