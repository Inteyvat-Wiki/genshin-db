					"nextDialogs": [
						225000503,
						225000504
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000503,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 225000504,
					"content": "Por que Menta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000505
					]
				},
				{
					"id": 225000505,
					"content": "Ela contraria alguns dos elementos mais... Hmm, estimulantes com seu aroma neutro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000506
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000506,
					"content": "Para ser sincera, eu fiquei bem surpresa de receber um pedido da Lulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000507
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000507,
					"content": "Isso me faz lembrar da época em que eu tinha essa idade. Quando você experimenta o primeiro gosto do amor, oh como isso faz o seu coração bater... Se eu pelo menos tivesse sido um pouco mais sábia sobre as coisas do mundo naquela época...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000508
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000508,
					"content": "Cof... De qualquer forma, eu deveria deixar você voltar para a Lulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying'er"
				}
			]
		},
