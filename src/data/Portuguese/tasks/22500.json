					"content": "O que acha de 3,000 Mora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000302
					]
				},
				{
					"id": 225000302,
					"content": "Uau, alguém está desesperado... Tudo bem, eu vou priorizar o perfume da Lulu pelo bem da nossa amizade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000303
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000303,
					"content": "Mas eu preciso cuidar da loja durante o dia. Meus negócios pessoais são melhores se lidados durante a noite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000304
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000304,
					"content": "Passe aqui durante a noite e devo ter tudo pronto para você.",
