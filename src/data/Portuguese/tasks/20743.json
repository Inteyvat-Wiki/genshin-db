			"dialogs": [
				{
					"id": 207431001,
					"content": "Se os negócios da nossa vinícola continuarem fechados por muito tempo, como é que poderei olhar na cara do Mestre Diluc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207431002
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207431002,
					"content": "#{M#Aventureiro}{F#Aventureira}, se você encontrar o Mestre Diluc, você poderia dizer a ele sobre isto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207431003
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207431003,
					"content": "Simplesmente não dá, da forma que ele deixa a vinícola sempre à sua própria sorte deste jeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elzer"
				}
			]
		},
		{
