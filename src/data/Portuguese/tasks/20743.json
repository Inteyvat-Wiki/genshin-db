			"dialogs": [
				{
					"id": 207432001,
					"content": "Você já conseguiu liberar as rotas comerciais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432002
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432002,
					"content": "Elas estão todas livres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207432003
					]
				},
				{
					"id": 207432003,
					"content": "Isso é ótimo. Os negócios da nossa vinícola podem finalmente retornar aos poucos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432004
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432004,
					"content": "Honestamente, eu deveria ter contado sobre este incidente ao Mestre Diluc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432005
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432005,
					"content": "Mas ele simplesmente desapareceu. Procurei por ele em toda a vinícola, mas ninguém faz ideia de onde ele foi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432006
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432006,
					"content": "Adelinde disse algo sobre \"Mestre Diluc foi resolver alguns problemas pessoais\", mas se recusou a me dizer mais sobre isso. Ela nem sequer pareceu preocupada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432007
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432007,
					"content": "*Suspiro* Deixa para lá. Quando ele voltar, eu terei uma boa conversa com ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elzer"
				}
			]
		}
