				]
			},
			"dialogs": [
				{
					"id": 741401301,
					"content": "Bem. Aqui vamos nós de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401302,
					"content": "O que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401303,
					"content": "#Me sinto muito mal por dizer isso já que todos são tão legais comigo, tod{M#os}{F#as} vocês, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401304,
					"content": "Você não sente que o mundo é tão assustadoramente entendiante? Você não acha que os mundos nos livros são muito mais bonitos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401305,
						741401307,
						741401309
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401305,
					"content": "Também acho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401306
					]
				},
				{
					"id": 741401306,
					"content": "Sério? Você acha isso também, é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401311,
					"content": "Ainda sinto que o mundo no Livro da Revelação é o mais belo de todos. Há pétalas cobertas de orvalho por todo lugar, e finalmente fiz amizade com um filhotinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401312
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401312,
					"content": "Filhotinho... Falando nisso, Canotila, você pode se comunicar com cães?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401313,
					"content": "Hã? Claro que não. Mas, os filhotes no Livro da Revelação são especiais. Ou talvez, eu seja especial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401314
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401314,
					"content": "Estive meditando para viajar para outros mundos nos livros, então um dia, o latido comum de cachorro virou algo que eu podia entender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401315
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401315,
					"content": "Quanto ao que conversamos... Ele me pediu para ir embora e nunca voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401316
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401316,
					"content": "Mas... Ainda quero ver os girassóis desabrocharem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401317
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401317,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401318
					]
				},
				{
					"id": 741401318,
					"content": "É mesmo... Cuide-se, Canotila! Estamos indo nessa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401307,
					"content": "Eu não acho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401308
					]
				},
				{
					"id": 741401308,
					"content": "É mesmo...? Talvez seja isso. Não sou normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401309,
					"content": "Não faz diferença para mim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401310
					]
				},
				{
					"id": 741401310,
					"content": "#Parece que {M#o Sr.}{F#a Srta.} {NICKNAME} é {M#o}{F#a} mais forte de todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Canotila"
				}
			]
		}
	]
