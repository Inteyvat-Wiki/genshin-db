					"nextDialogs": [
						200490204
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490204,
					"content": "Sim, entendo. Bem, eu acho que serão maçãs, então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490205
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490205,
					"content": "Oh... Desculpe, Eury. Eu acho que essas maçãs estão começando a apodrecer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490206
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490206,
					"content": "Sério? Hum... Mas não há outra escolha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490207
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490207,
					"content": "Viemos ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490208
					],
					"speakerTitle": "Paimon"
