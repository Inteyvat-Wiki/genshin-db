					"nextDialogs": [
						200490210
					]
				},
				{
					"id": 200490210,
					"content": "Fica tranquilo. Encontraremos alguns <color=#00E1FFFF>Frutos do Pôr do Sol</color> para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200490211,
					"content": "De verdade? Então, fico muito agradecido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490212
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490212,
					"content": "Ótimo! O Nimrod também gosta mais do Fruto do Pôr do Sol, então fico à espera aqui.",
