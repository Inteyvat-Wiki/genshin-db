						],
						"stepId": 7050107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brunn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010301,
					"content": "Você trouxe a mercadoria de volta? Muito obrigado, Viajante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010302
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010302,
					"content": "Você queria... Arroz, certo? Por favor, espere um momento, vou colher o arroz de melhor qualidade para você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010303
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010303,
					"content": "Pronto! Este arroz é para você, deve ser suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010304
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010304,
					"content": "Obrigado, Viajante. Eu seguirei meu caminho agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010305
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010305,
					"content": "Espero não encontrar mais nenhum monstro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brunn"
				}
			]
		},
		{
			"id": 7050104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050108",
