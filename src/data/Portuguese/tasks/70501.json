			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Retentora de Nuvem"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010101,
					"content": "Me pergunto se este dispositivo também pode fazer sobremesas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010102
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705010102,
					"content": "O que você está fazendo dessa vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010103
					]
				},
				{
					"id": 705010103,
					"content": "Momento impecável, Viajante. Acabei de resmungar sobre a elaboração deste próximo prato - um \"pudim\", assim nomeado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010104
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705010104,
					"content": "Muitas consultas foram feitas com as receitas mais recentes e populares antes de se decidir por este prato. Diz-se que é macio e saboroso - uma boa sobremesa de fato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010105
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705010105,
					"content": "Mudanças e melhorias também foram feitas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010106
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705010106,
					"content": "...Junto com a adição de arroz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010107
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705010107,
					"content": "Naturalmente, terei o direito de nomear este novo prato. Mmm... \"Pudim de Arroz\" deverá ser seu nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010108
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705010108,
					"content": "Parece que enche bem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010109
					]
				},
				{
					"id": 705010109,
					"content": "A qualidade do arroz é a chave para este prato. Ao acionar a Máquina de Culinária Suprema, pedi que ela buscasse arroz de alta qualidade. A busca resultante trouxe-me aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010110
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705010110,
					"content": "Bem agora, Viajante. Já que você está aqui no momento, você pode ajudar a coletar um pouco de arroz de boa qualidade? A Máquina indica que ele pode ser encontrado não muito longe daqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010111,
						705010112
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705010111,
					"content": "Por que eu de novo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010113
					]
				},
				{
					"id": 705010113,
					"content": "Este dispositivo precisa ser cuidado, e não posso estar em dois lugares ao mesmo tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010114
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705010114,
					"content": "#Você é habilidos{M#o}{F#a} em mente e em mão, sendo, portanto, {M#um}{F#uma} ajudante inestimável. Vá em meu auxílio, e prometo que você também terá uma participação no Pudim de Arroz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010115
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705010115,
					"content": "Bem, de qualquer forma, agradeço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010116
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705010116,
					"content": "Máquina de Culinária Suprema... Ativar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010117
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705010117,
					"content": "Viajante, eu agora ativei a máquina. Siga os rastros que ela criou e recupere o Arroz que eu desejo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705010112,
					"content": "Você não pode voar...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010113
					]
				}
			]
		},
		{
			"id": 7050102,
			"completionStepIds": [
				7050104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050104",
							"2"
						],
						"stepId": 7050104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brunn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010201,
					"content": "Obrigado! Você salvou minha vida... Eu sou Brunn, um comerciante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010202
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010202,
					"content": "*Suspiro* Realmente é um azar. Eu estava enviando umas mercadorias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010203
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010203,
					"content": "Mas... Eu nunca esperei ser atacado por monstros enquanto eu estava a caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010204
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010204,
					"content": "Continuei a correr, não pude me preocupar com as mercadorias no carro e não tive tempo de encontrar a direção... Corri sempre até aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010205
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010205,
					"content": "Depois que cheguei aqui, pensei que os tinha despistado completamente. É por isso que eu quis sair do carrinho e verificar a mercadoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010206
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010206,
					"content": "Mas de repente eles surgiram do nada... Graças aos deuses por sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010207
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010207,
					"content": "Que tipo de mercadoria você está transportando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010208
					]
				},
				{
					"id": 705010208,
					"content": "Estou transportando um lote de ingredientes, arroz e coisas assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010209
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010209,
					"content": "Parece que este é o arroz que o Adeptus queria que encontrássemos, mas não parece que sobrou muito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705010210,
					"content": "Você poderia me vender um pouco de arroz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010211
					]
				},
				{
					"id": 705010211,
					"content": "Você quer comprar arroz? Não é que eu não queira vendê-lo, é só que... Eu basicamente perdi todas as mercadorias do meu carrinho na estrada quando estava fugindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010212
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010212,
					"content": "Esses monstros devem ter levado a mercadoria como saque de volta ao seu acampamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010213
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010213,
					"content": "Que dor de cabeça. Como posso conseguir essas mercadorias de volta? Se eu não conseguir recuperá-las, perderei muito dinheiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010214
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010214,
					"content": "#Viajante... Vejo que você é muito habilidos{M#o}{F#a}. Você pode me ajudar a conseguir essas mercadorias de volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010215
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010215,
					"content": "#S-se você estiver dispost{M#o}{F#a} a me ajudar, eu lhe darei o tanto de arroz que você quiser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010216,
						705010218
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010216,
					"content": "Deixa comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010217
					]
				},
				{
					"id": 705010217,
					"content": "Obrigado! Estou contando com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010220
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010220,
					"content": "Traga meu balão de transporte e coloque a mercadoria nele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010221
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010221,
					"content": "Deixarei isso com você, Viajante. Estarei esperando por você aqui. Depois de pegar a mercadoria, por favor, traga-a de volta para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010218,
					"content": "Acho que não consigo carregar tantas mercadorias...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010219
					]
				},
				{
					"id": 705010219,
					"content": "Não se preocupe, tenho uma solução.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010220
					],
					"speakerTitle": "Brunn"
				}
			]
		},
		{
			"id": 7050103,
			"completionStepIds": [
				7050107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
