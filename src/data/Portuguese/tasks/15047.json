			"dialogs": [
				{
					"id": 150470401,
					"content": "...Ah, então as instalações aqui ainda estão em construção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470402
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470402,
					"content": "Olha, tem um funcionário Iktomissauro! Será que a gente pede por ajuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470403,
					"content": "Olá! Será que você poderia nos ajudar a construir esses?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470404
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470405
					],
					"speakerTitle": "Filhote de Iktomissauro"
				},
				{
					"id": 150470405,
					"content": "Coloque... aqui... e... construa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470406
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470406,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470407
					],
					"speakerTitle": "Filhote de Iktomissauro"
				},
				{
					"id": 150470407,
					"content": "Não parece que entendeu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470408,
					"content": "É... Hmm, o que a gente devia fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470409
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470409,
					"content": "...Oooooh, espera aí, acabei de pensar numa coisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470410
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470410,
					"content": "Eee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470411
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470411,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470412
					],
					"speakerTitle": "Filhote de Iktomissauro"
				},
				{
					"id": 150470412,
					"content": "Eee! Eee! Eee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470413
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470413,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470414
					],
					"speakerTitle": "Filhote de Iktomissauro"
				},
				{
					"id": 150470414,
					"content": "Ah, não... Pelo menos agora a gente sabe que não consigo falar Koholassaurês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470415
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470415,
					"content": "Por que a gente só não...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470416
					]
				},
				{
					"id": 150470416,
					"content": "Ei, tive outra ideia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470417
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470417,
					"content": "Qual foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470418,
					"content": "Uma vez ouvi Ifa mencionar que Iktomissauros ficam malucos por Cogumelo Brilhante, e adivinhem o que eu tenho aqui comigo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470419
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470419,
					"content": "Perfeito, tem que ser isso! Quando terminar de comer isso, estaremos totalmente na mesma sintonia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470420
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470420,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470421
					],
					"speakerTitle": "Filhote de Iktomissauro"
				},
				{
					"id": 150470421,
					"content": "Não existe isso de levar coisas demais quando se sai numa viagem longa... Kachina acertou em cheio. Valeu, Kachina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470422
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470422,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470423
					],
					"speakerTitle": "Filhote de Iktomissauro"
				},
				{
					"id": 150470423,
					"content": "Uhhh, Paimon com certeza não tá nessa sintonia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470424,
					"content": "Que desastre... Dia um e lá se vai meu sonho de conquistar todos os desafios na Baía das Ondas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470425
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470425,
					"content": "#{NICKNAME}, grande {M#herói}{F#heroína} {NICKNAME}, você tem alguma ideia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470426,
						150470427
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470426,
					"content": "Bem, sempre tem uma opção...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470428
					]
				},
				{
					"id": 150470428,
					"content": "Ok, vamos tentar isso. Valeu, desculpa pelo incômodo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470427,
					"content": "Vou pegar outro Iktomissauro para ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470428
					]
				}
			]
		},
