			"dialogs": [
				{
					"id": 150470101,
					"content": "Vocês chegaram! Parece que os funcionários tiveram que sair rapidinho, mas eu praticamente já descobri como fazer para dar uma volta... Digo, como concluir o teste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470102,
					"content": "Legal, mostra pra gente como se faz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470103,
					"content": "Basicamente, uma pessoa viaja no barco enquanto a outra envia sinais ao funcionário Sauriano. Trabalhando como uma equipe, o objetivo é guiar o barco até o destino com segurança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470104
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470104,
					"content": "#Eu tô bem confiante — porque quando o assunto é trabalho em equipe, {NICKNAME} e eu dividimos praticamente o mesmo cérebro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470105
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470105,
					"content": "Ah, sério? Porque quando o assunto é velejar, gente que fala demais acaba capotando, sabe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470106,
					"content": "Ei, Paimon, não diga coisas assim! Dá azar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470107,
					"content": "Ok, ok... Então Paimon deseja... uma boa viagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470108,
					"content": "Hehe, vai ser a melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470109,
					"content": "Na verdade, eu tô meio a fim de sair no barco. Tô tão acostumada a desafios de surfe, vai ser legal variar um pouco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470110,
						150470111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470110,
					"content": "#Também tô meio fart{M#o}{F#a} do Quebra-mar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				},
				{
					"id": 150470112,
					"content": "Viu, já estamos em sintonia perfeita! Isso tem que ser prova da nossa conexão, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470113,
					"content": "Mal posso esperar para encher meu biquíni inflável e saltar direto pro barco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470111,
					"content": "Eu cuido dos sinais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				}
			]
		},
