			"dialogs": [
				{
					"id": 150470501,
					"content": "Você volta, tendo habitado um Iktomissauro...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150470502
					]
				},
				{
					"id": 150470502,
					"content": "Mualani, voltamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470503,
					"content": "!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470504
					]
				},
				{
					"id": 150470504,
					"content": "#Ah, olá! Aawn, que fofinho! Espera, cadê {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470505
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470505,
					"content": "#Hmm, {M#ele}{F#ela}... começou a passar mal, aí {M#ele}{F#ela} teve que correr para o banheiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470506,
					"content": "(Sério, Paimon, que explicação horrível. Esqueça, contanto que Mualani acredite...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470507
					]
				},
				{
					"id": 150470507,
					"content": "!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470508
					]
				},
				{
					"id": 150470508,
					"content": "Minha nossa, como você é amigável! Quer experimentar um Cogumelo Brilhante? Aqui, pega um pouco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470509
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470509,
					"content": "(Um sabor realmente curioso. Espesso, suculento e surpreendentemente delicioso, para um cogumelo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470510
					]
				},
				{
					"id": 150470510,
					"content": "!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470511
					]
				},
				{
					"id": 150470511,
					"content": "Haha, que bom que gostou! Aqui, são todos seus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470512
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470512,
					"content": "P-Posso alisar você? Vem, vamos ser amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
