			"dialogs": [
				{
					"id": 760810101,
					"content": "Ouvi dizer que o lendário Starshyna, Sigurd, empunhava uma espada longa, e sua habilidade em derrotar monstros era incomparável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810102,
					"content": "Ele desapareceu após uma grande batalha, e por isso esta tumba vazia foi erguida em sua homenagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810103,
					"content": "Uma lâmina púrpura e cabelos dourados... Deve ser o guerreiro errante que enfrenta a Caçada Feroz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810104,
					"content": "Parece que seu espírito não conseguiu descansar em sua tumba, assim como os muitos espíritos cujos lamentos ecoam pela noite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810105,
					"content": "Para erguer sua espada contra a Caçada Feroz, o espírito do herói permanece inabalável, mesmo após a morte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810106,
					"content": "...Sr. Sigurd, você é um homem digno do meu respeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810107
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810107,
					"content": "Mas como guerreiro, ele luta movido pelo ódio e por um senso de dever. Essa existência solitária é um destino cruel demais para ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810108,
					"content": "Você sente falta dos dias em que compartilhava bebidas e canções com seus companheiros Portadores da Lâmpada, Sigurd? Ainda tem algum motivo para empunhar sua lâmina, além da fome de abater seus inimigos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810109
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810109,
					"content": "Se for assim, então mostre-se. Como nos velhos tempos, como nos dias de Portador da Lâmpada, podemos duelar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
