			},
			"dialogs": [
				{
					"id": 760819901,
					"content": "A maneira como ele derrota monstros... Não, aquela figura lendária há muito já se sacrificou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819902
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760819902,
					"content": "Será que ele despertou de novo, de alguma forma? Hmm... Se tiver um momento, vá até a praia a nordeste dos Pântano Musgoso de Ossos. É lá que está seu túmulo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819903
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760819903,
					"content": "O velho certa vez me contou histórias sobre o lendário Starshyna Sigurd, aquele ao lado de quem ele lutou há tantos anos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819904
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760819904,
					"content": "A lâmina violeta, o cabelo dourado... é exatamente como as histórias descrevem. A pessoa que tenho visto nos últimos dias... poderia realmente ser ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819905
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760819905,
					"content": "Seu local de descanso fica na praia a nordeste dos Pântanos de Musgo do Barro. Se eu tiver tempo, devo ir até lá dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		}
	]
}