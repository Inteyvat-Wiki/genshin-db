				]
			},
			"dialogs": [
				{
					"id": 760810201,
					"content": "Essa foi uma batalha excelente, Sr. Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810202,
					"content": "Lamentável, que esse seja o fim de herói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810203,
					"content": "Vagar sozinho pela terra pela qual você sacrificou sua vida... Você viu esse dia chegando quando respondeu ao juramento dos Portadores da Lâmpada pela primeira vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810204,
					"content": "Talvez mesmo assim você não hesitasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810205,
					"content": "Eu visitarei você novamente no futuro. Adeus, Sr. Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
		{
			"id": 7608103,
