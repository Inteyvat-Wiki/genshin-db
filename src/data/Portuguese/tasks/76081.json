				]
			},
			"dialogs": [
				{
					"id": 760810401,
					"content": "Boa luta, Sr. Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810402
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810402,
					"content": "Fique em paz. Depois que o senhor e seus camaradas caíram, meu pai, Nikita, assumiu o manto de Starshyna e liderou o povo que o senhor salvou para reconstruir a ordem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810403
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810403,
					"content": "Hoje, somos fortes o bastante para proteger esta terra, mesmo sob a sombra da Caçada Feroz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810404
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810404,
					"content": "Seu sacrifício não foi em vão. Seus feitos e sua vontade continuarão vivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810405
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810405,
					"content": "Adeus, Sr. Sigurd. Voltarei para visitá-lo de tempos em tempos. Que o senhor finalmente encontre a paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
		{
			"id": 7608199,
