					{
						"sceneId": 3,
						"position": [
							1963.909,
							200.31,
							9077.054
						],
						"pointId": 13645
					}
				]
			},
			"dialogs": [
				{
					"id": 760810301,
					"content": "Sr. Sigurd, devo-lhe a minha vida. Se o senhor não tivesse conduzido os Portadores da Lâmpada para o sul para manter a linha naquela época, eu talvez tivesse morrido sem nem saber como, e meu corpo jamais teria sido encontrado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810302
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810302,
					"content": "Mas por que seu espírito ainda não encontrou descanso? Por que ainda vagueia, ainda luta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810303
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810303,
					"content": "Corrompido pela influência da Caçada Feroz, com sua forma completamente despedaçada... Parece que o senhor nunca realmente deixou aquele campo de batalha, não é? Para o senhor, a guerra nunca terminou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810304
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810304,
					"content": "Nesse sentido, talvez eu não seja tão diferente do senhor. Nenhum de nós encontrará verdadeira paz até que a Caçada Feroz seja completamente destruída.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810305
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810305,
					"content": "É uma honra conhecê-lo, Sr. Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810306
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810306,
					"content": "Agora eu entendo. Para um Portador da Lâmpada, a melhor forma de comunicação é com as lâminas em punho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810307
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810307,
					"content": "Então, permita-me mostrar-lhe a força da nova geração dos Portadores da Lâmpada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
