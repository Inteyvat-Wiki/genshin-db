			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000101,
					"content": "Olá, você*ROONNCCC*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000102
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000102,
					"content": "Arg, meu estômago está fazendo um barulhão de novo. Eu estava dizendo, você precisa de alguma*ROONNCCC*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000103
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000103,
					"content": "Erm, você ia dizendo...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000104
					]
				},
				{
					"id": 222000104,
					"content": "*Suspiro* Meu estômago faz drama deste jeito toda vez que estou com fome. Ronc isso, ronc aquilo, e é realmente muito alto também. Eu nem consigo ouvir o som da minha própria voz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000105
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000105,
					"content": "Além de que *ROONNCCC* eu fui até o Chalé de Bubu para ser checado, mas o doutor disse que eu não estava doente, apenas faminto - então não existe cura para minha... *ROONCC*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000106
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000106,
					"content": "O doutor disse que eu apenas preciso comer uma refeição completa, mas eu... Eu sempre como mais do que *ROONCC* todo mundo. E se eu fosse comer para ficar cheio o tempo inteiro, eu faria um buraco na minha carteira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000107
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000107,
					"content": "Jiayi diz que se minhas principais refeições não me enchem, eu deveria comprar algumas coisinhas para ir preenchendo os vazios aqui e ali, para que isso não afete meu trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000108
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000108,
					"content": "\"Preencher o vazio\", diz ele, mas eu tenho uma enorme lista de pratos que gostaria de comer, e eu não tenho certeza qual deles é melhor para preencher meu estômago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000109
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000109,
					"content": "#{M#Aventureiro}{F#Aventureira}, você é experiente na vida no campo. Certamente você sabe quais comidas enchem melhor o seu estômago, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000110
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000110,
					"content": "Você poderia me ajudar a escolher a refeição mais gostosa e completa da minha lista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000111
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000111,
					"content": "O que você gostaria de comer desta vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000112
					]
				},
				{
					"id": 222000112,
					"content": "Ah, tem muitas coisas... Deixe-me pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
		{
			"id": 2220002,
			"completionStepIds": [
				2220002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
