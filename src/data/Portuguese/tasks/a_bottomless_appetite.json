					"nextDialogs": [
						222000506
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000506,
					"content": "Quanto à Sopa de Lótus e Ovo, o Herborista Gui sabe fazer, visto que ele trabalha no Chalé de Bubu do Terraço de Yujing. Você pode perguntar a ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000507
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000507,
					"content": "Ouvi um comerciante dizer que a Panqueca de Mondstadt no Caçador de Cervos tem um gosto muito bom, e também enche bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000508
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000508,
