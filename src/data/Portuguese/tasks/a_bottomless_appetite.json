			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000201,
					"content": "Ouvi dizer que alguns pratos de Mondstadt são bons, tais como Frango em Molho de Mel, Peixe Frito de Mondstadt, Pão de Pescador, e Sopa de Lótus de Leite e Frutos do Mar - também são incríveis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000202
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000202,
					"content": "Bem, apenas me dê um que encha meu estômago. Obrigado pela sua ajuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000203
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000203,
					"content": "Se eu comer isso, pelo menos meu estômago não vai ficar chorando o dia inteiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
