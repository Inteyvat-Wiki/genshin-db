			"dialogs": [
				{
					"id": 222000601,
					"content": "Eu mataria por um Peixe Esquilo ou um Frango de Pimenta de Jueyun, mas eu ouvi dizer que alguns pratos de Mondstadt como o Ensopado Cremoso ou Ovo Frito de Teyvat também são muito bons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000602
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000602,
					"content": "Só de pensar nisso, me deixa*ROONNCCC*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000603
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000603,
					"content": "Por favor, me ajude a escolher algum desses pratos... Eu só preciso que meu estômago pare de *ROONCC* pelo resto do dia...",
