			"dialogs": [
				{
					"id": 740510301,
					"content": "Ótimo, o Projektor está intacto, e o filme dentro dele também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510328
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 740510328,
					"content": "Graças aos Arcontes. Eu pensei que íamos ter que começar a filmar tudo de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510302,
						740510303
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 740510302,
					"content": "Por que estão filmando aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510303,
					"content": "Parece que vocês também não são de Fontaine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510329,
					"content": "Essa é uma longa história...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 740510304,
					"content": "Vamos ser breves. Nós três somos da Vila Qiaoying em Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 740510305,
					"content": "A maioria das pessoas lá estão nos negócios de chá mas nós... não temos nenhum interesse em chá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510306
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 740510306,
					"content": "Então mudamos de profissão e começamos a filmar dokumentários para ajudar a promover os vendedores de chá na vila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510307
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 740510307,
					"content": "Na verdade, há muitas pessoas nos negócios de chá e a gente não conseguia competir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510308
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510308,
					"content": "Os ajudantes que tínhamos na loja se foram um a um para trabalhar em outro lugar, se a gente continuasse fazendo chá, passaríamos fome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510309
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510309,
					"content": "Vocês não podem... deixar as coisas menos deprimentes?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510310
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 740510310,
					"content": "Ganhamos muita Mora filmando esses dokumentários de chá na vila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510311
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 740510311,
					"content": "Mas recentemente, algumas outras pessoas na vila também começaram a filmar os próprios filmes promocionais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510312
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510312,
					"content": "Alguns deles até tem uma ópera neles. Estão fazendo um grande espetáculo nesses filmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510313
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510313,
					"content": "É por isso que estamos em Fontaine. Estamos tentando conseguir uma consultoria com mestres em filmagem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510314
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 740510314,
					"content": "Então vocês estão aprendendo sobre a produção de filmes em Fontaine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510315
					]
				},
				{
					"id": 740510315,
					"content": "Isso. Encontramos esse \"especialista em iluminação\" chamado Renault.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510316
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 740510316,
					"content": "Ele é muito bom em usar iluminação para filmar... O que era mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510317
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 740510317,
					"content": "\"Narrativas\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510318
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510318,
					"content": "Isso! Aplicar iluminação às \"narrativas\" dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510319
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 740510319,
					"content": "Com a ajuda do Sr. Renault, definitivamente poderemos filmar os melhores filmes em toda Vila Qiaoying!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510320
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 740510320,
					"content": "Chefe, mês passado você disse que a gente ia filmar os melhores filmes em Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510321
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510321,
					"content": "Você deve ajustar suas expectativas realisticamente ao fazer negócios... O que você sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510322
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 740510322,
					"content": "Enfim, obrigada pela sua ajuda, Viajante. Aqui, aceite essa Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510323
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 740510323,
					"content": "Xingye, Yifeng, arrumem tudo logo! Temos que terminar de filmar nossa amostra para mostrar ao Sr. Renault.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510324
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 740510324,
					"content": "Cuidado com a iluminação! O projektor tem que estar inclinado para a fonte de luz. Temos que capturar aquela... luz de alta definição. Faça as coisas parecerem mais reais! Acentue o tato da cena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510325
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 740510325,
					"content": "Vocês todos leram aquele livro, certo? A iluminação tem que ter um senso de textura? Entendem o que estou dizendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510326
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 740510326,
					"content": "Chefe, podemos ter lido o livro do Sr. Renault...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510327
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510327,
					"content": "Mas com essa máquina que temos, não vamos conseguir capturar aquele tato de iluminação de alta definição que você quer, não importa quanto a gente tente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yifeng"
				}
			]
		},
