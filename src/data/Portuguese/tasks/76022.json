				]
			},
			"dialogs": [
				{
					"id": 760220201,
					"content": "Ei! Grandalhão! O que você está fazendo! Pare agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220202,
					"content": "Mora... Não, não! Foi você quem causou a morte de Murasaki... Prepare-se para morrer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220203
					],
					"speakerTitle": "Samurai Furioso"
				},
				{
					"id": 760220203,
					"content": "#Aaaah! Tenha cuidado, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602203,
