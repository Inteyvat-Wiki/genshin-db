				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Peco"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2260.9,
							200.7,
							9289.5
						],
						"pointId": 12118
					},
					{
						"sceneId": 3,
						"position": [
							2260.4,
							200.2,
							9293.5
						],
						"pointId": 13302
					}
				]
			},
			"dialogs": [
				{
					"id": 760220301,
					"content": "Ai, ai, muito obrigado a vocês por salvarem minha vida. Sou Peco, o mercador itinerante. Se algum dia tiverem a chance de fazer negócios comigo, certamente darei o melhor desconto a vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220302
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220302,
					"content": "Falando nisso, que dia de azar hoje, acabei encontrando essa figura lendária.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220303
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220303,
					"content": "Uma figura lendária? Essa pessoa é famosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220304,
					"content": "Se for por má fama, ele é sim. Ouvi falar dele por outros colegas comerciantes... Eles ficaram tão apavorados que disseram que nunca mais seguiriam essa rota. Mas eu não acreditei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220305
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220305,
					"content": "Você é bem atrevido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220306,
					"content": "Nós, comerciantes itinerantes, já vimos de tudo, não é? E, às vezes, quando nos reunimos para contar nossas histórias, também temos a tendência de \"exagerar um pouco\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220307
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220307,
					"content": "Estou me desviando do assunto... Ele se chama Gonpachi. Ouvi dizer que cometeu algum crime em Inazuma e fugiu para esta área remota. Ah, e ele trouxe sua amada junto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220308
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220308,
					"content": "Então, aquela Murasaki que ele mencionou agora há pouco é...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220309
					]
				},
				{
					"id": 760220309,
					"content": "#É verdade! Aquele sujeito estranho estava murmurando esse nome enquanto lutava com {NICKNAME}. Que esquisito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220310,
					"content": "Quando você se desvia do caminho, é difícil se recuperar, mesmo em um lugar novo. Sem trabalho honesto, você acaba onde começou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220311
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220311,
					"content": "Esse estilo de vida pode funcionar pra um lobo solitário. Mas trilhando o caminho da espada... Cedo ou tarde, você vai acabar cruzando com a pessoa errada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220312
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220312,
					"content": "Ouvi dizer que a amada dele morreu por causa disso... De qualquer forma, desde então, ele ficou completamente louco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220313
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220313,
					"content": "Ugh... Roubar Mora é realmente desprezível, mas, ao pensar no que ele se tornou, Paimon não consegue deixar de sentir um pouquinho de pena dele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220314,
						760220316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220314,
					"content": "Então, Paimon, nunca troque Mora por isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220315
					]
				},
				{
					"id": 760220315,
					"content": "Ei! Esse não é o ponto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220318,
					"content": "Certo, não vou tomar mais o tempo de vocês. Por favor, aceitem este presente como forma de agradecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220316,
					"content": "Mas e se Paimon for roubada um dia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220317
					]
				},
				{
					"id": 760220317,
					"content": "#Hehe, mas Paimon tem você! As Mora da Paimon estão protegidas por {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}