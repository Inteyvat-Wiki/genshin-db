			"dialogs": [
				{
					"id": 760220101,
					"content": "Resistir é inútil e só vai causar mais derramamento de sangue... Deixe sua Mora aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220102
					],
					"speakerTitle": "Samurai Furioso"
				},
				{
					"id": 760220102,
					"content": "Socorro! Alguém me salve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220103
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220103,
					"content": "Oh não... Vamos salvá-lo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
