			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410401,
					"content": "Aquele é Albedo? Por que ele ficaria em um lugar como este?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410402,
					"content": "Dizem que ele adora desenhar. Ele fica em qualquer lugar que tenha uma boa paisagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410403
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410403,
					"content": "As vistas e o cenário aqui são muito bons, há inspiração para todos os lados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410404
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410404,
					"content": "Mas... Ele não está vendo aqueles Hilichurls? Ele não está em perigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410405,
					"content": "Oh não!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1104106,
			"completionStepIds": [
				1104106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104106",
							"2"
						],
						"stepId": 1104106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410601,
					"content": "Quem são vocês? Por que os afugentaram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410602
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410602,
					"content": "Graças aos deuses eu já tinha acabado meu desenho. Teria sido uma pena deixar esses Hilichurls inacabados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410603,
						110410604
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410603,
					"content": "Você estava desenhando Hilichurls?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410605
					]
				},
				{
					"id": 110410605,
					"content": "Qual a dificuldade em desenhar Hilichurls? Eles não são todos iguais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410606,
					"content": "Hmm, receio que a resposta não seja fácil de explicar. Se der uma olhada no meu desenho, pode ter uma ideia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410607,
						110410608
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410607,
					"content": "Isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410609
					]
				},
				{
					"id": 110410609,
					"content": "Uau, vejam os detalhes! Mas algumas coisas parecem ter sido feitas às pressas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410610,
					"content": "Podemos encontrar esses Hilichurls em qualquer lugar, muito entediante na verdade. Não merecem uma atenção mais detalhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410611
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410611,
					"content": "Mas dê uma olhada neste espécime. A forma, o colete... Há uma força distinta em ação aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410612
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410612,
					"content": "Nas vidas cíclicas dessas comunidades primitivas, esses atributos únicos indicam a evolução em ação. Evolução, a transição do nada para a existência, do conhecido para o des-",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410613
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410613,
					"content": "Esperem um minuto. Algo me diz que estou a caminho de uma tese, mas não tenho energia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410614
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410614,
					"content": "Encontramos seu homem, estou voltando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410615
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410615,
					"content": "O quê!? Você não tem perguntas para ele? Ei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410616,
					"content": "Ugh, que estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410617,
					"content": "Então a Irmã Rosaria trouxe você? Surpreendente. E não tive tempo de agradecer a ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410618
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410618,
					"content": "Mas de volta ao assunto. Pelas palavras dela, parece que você estava procurando por mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410619
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410619,
					"content": "Uhum, conhecemos uma garota em Mondstadt, Sucrose! Ela disse que você está com problemas em sua pesquisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410620,
					"content": "Entendo, então Sucrose mandou vocês virem aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410621
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410621,
					"content": "#Então, se não me engano, você deve ser {M#o Cavaleiro}{F#a Cavaleira} Honorável. Não se fala de outra coisa em Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410622
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410622,
					"content": "Ouvi um pouco de tudo, suas ações durante o ataque do Stormterror, seu controle elemental e outras coisas misteriosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410623
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410623,
					"content": "Vou pular para a conclusão, só há uma possibilidade, afinal. Você veio de longe - de outro mundo. Certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410624,
						110410625
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410624,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410626
					]
				},
				{
					"id": 110410626,
					"content": "Excelente. Acho que minha pesquisa se beneficiaria enormemente com sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410627,
						110410628
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410627,
					"content": "Sua pesquisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410629
					]
				},
				{
					"id": 110410629,
					"content": "Ah, me perdoe. Isso deve ser confuso. Por onde devo começar? Hmm... A essência da vida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410630
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410630,
					"content": "Espere um pouco, você quer começar por isso!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410631,
					"content": "Hmm... Você tem razão. Fazer uma demonstração seria melhor do que tentar explicar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410632
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410632,
					"content": "Por exemplo, despertar a vida. Reviver folhas caídas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410634
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410634,
					"content": "Você pode fazer isso!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410635,
						110410636
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410635,
					"content": "A alquimia é realmente milagrosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410637
					]
				},
				{
					"id": 110410637,
					"content": "No entanto, tenho uma semente específica em minha posse. O método de que estou falando não produziu resultados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410639
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410639,
					"content": "Assim como você, ela veio de outro mundo. Ajudá-la a crescer - a florescer... Esse é o problema que estou tendo na minha pesquisa. É por isso que preciso de sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410640
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410640,
					"content": "Se você não consegue descobrir, Paimon não tem certeza se vamos ajudar muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410641,
					"content": "Discordo. Não compreendo as complexidades da vida fora do mundo conhecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410642
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410642,
					"content": "Mas você não é do mundo conhecido. Observando e investigando você, talvez eu encontre um jeito de fazer a semente brotar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410643
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410643,
					"content": "Então eu sou um... Um objeto de pesquisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410644
					]
				},
				{
					"id": 110410644,
					"content": "#Uh... O que fazemos, {NICKNAME}? Isso soa um pouco estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410645,
						110410647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410645,
					"content": "Há algum perigo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410646
					]
				},
				{
					"id": 110410646,
					"content": "É possível. Mas farei tudo que estiver ao meu alcance para garantir sua segurança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410649
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410649,
					"content": "Hora de mudar de ambiente, devemos ir. Há pesquisas para fazer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410650
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410650,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410651
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410651,
					"content": "#Albedo e {M#aquele}{F#aquela} Viajante parecem ter se dado bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410652
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410652,
					"content": "Acho que uma pessoa estranha reconhece outras. Eu me pergunto... Isso representa um risco para Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410647,
					"content": "O que ganharei em troca?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410648
					]
				},
				{
					"id": 110410648,
					"content": "Mora, conhecimento. E a resposta para a pergunta que você está procurando. É uma resposta que posso dar. O que acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410649
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410636,
					"content": "A alquimia é muito útil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410637
					]
				},
				{
					"id": 110410628,
					"content": "Acho que não entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410629
					]
				},
				{
					"id": 110410625,
					"content": "Sua reputação acadêmica precede você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410626
					]
				},
				{
					"id": 110410608,
					"content": "Muito... Avant-garde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410609
					]
				},
				{
					"id": 110410604,
					"content": "Pensei que você estava desenhando uma paisagem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410605
					]
				}
			]
		}
	]
}