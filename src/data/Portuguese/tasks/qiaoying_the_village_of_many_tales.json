					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501217,
					"content": "Não tem jeito mais seguro de fazer isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501218
					]
				}
			]
