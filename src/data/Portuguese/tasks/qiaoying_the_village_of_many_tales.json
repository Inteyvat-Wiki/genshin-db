			"dialogs": [
				{
					"id": 700500801,
					"content": "Então isso aqui são umas lanternas? Essas parecem peixes, que fascinante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500802
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500802,
					"content": "Você pega isso aqui para levantar a lanterna, né? Hmm, essa estrutura pode ser separada, se for bem elaborada, pode ter uma seção ou duas adicionadas secretamente sem serem descobertas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500803
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500803,
					"content": "Esse espaço no interior é enorme. Você deve conseguir inserir alguns...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500804
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500804,
					"content": "Pare! Melhor deixar esses pensamentos dentro da sua cabeça!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500805
					]
				},
				{
					"id": 700500805,
					"content": "Hã? Oh, certo! Hahaha, desculpe. Eu não consigo evitar de pensar falando alto quando veja essas coisas interessantes....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500806
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500806,
					"content": "Hmm. Sim, tenho certeza disso. Adicionar as lanternas vai dar uma certa textura a minha história.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500807
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500807,
					"content": "Posso pedir que você tire uma foto dessa Lanterna de Peixes naquele lado? Quero ter uma foto como referência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500808,
						700500809
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500808,
					"content": "#Tá na hora d{F#a}{M#o} fotógraf{F#a}{M#o} se amostrar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				},
				{
					"id": 700500810,
					"content": "Estou contando com você para as fotos... Ah, sim. Por favor, garanta que você vai tirar uma foto da lanterna inteira, isso é super importante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500811
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500811,
					"content": "...Pensar num esquema relacionado a dimensões vai ser bem interessante... A questão agora é como vamos resolver o problema de peso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500809,
					"content": "Tá na mão, tá feito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				}
