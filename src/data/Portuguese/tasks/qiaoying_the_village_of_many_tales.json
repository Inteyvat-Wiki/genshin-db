					"nextDialogs": [
						700501230
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501230,
					"content": "Você realmente planeja ficar aqui a noite toda com suas mãos levantadas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501231,
					"content": "Isso mesmo. Eu estou determinada. Alguns sacrifícios devem ser feitos pelo bem da escrita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501232
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501232,
					"content": "Bem, por favor, fique aqui de guarda enquanto isso. Só uma noite, só isso...",
