			"dialogs": [
				{
					"id": 700501201,
					"content": "Srta. Guijarro! Como você acabou aí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501202,
					"content": "Não, não. Eu não posso só deixar eles encontrarem a pista mais importante assim. E também, alguém realmente conseguiria pensar depois de ficar amarrado aqui a noite toda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501203
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501203,
					"content": "Uau, ela tá totalmente imersa. Será que encontrou a inspiração dela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501204,
					"content": "Tá mais com cara de um bloqueio criativo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501205
					]
				},
				{
					"id": 700501205,
					"content": "#{NICKNAME}, Paimon! Vocês chegaram na hora certa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501206
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501206,
					"content": "Vocês podem me amarrar a um tronco de madeira?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501207
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501207,
					"content": "É o quê? Cê tá louca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501208,
					"content": "Eu disse. Por favor, amarrem minhas mãos, e depois amarrem elas em uma árvore. Bem, é tudo madeira, então não deve fazer diferença.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501209
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501209,
					"content": "#Eu não quero me tornar n{F#a}{M#o} suspeit{F#a}{M#o} da sua história.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501210
					]
				},
				{
					"id": 700501210,
					"content": "Oh, não se preocupe, eu já escrevi um documento que garante que tudo que ocorrer será culpa minha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501211
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501211,
					"content": "Não, o problema não é esse. Por que você quer que a gente te amarre? Você não fez nada de errado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501212,
					"content": "Mas o protagonista da trama vai ser amarrado pelas mãos a uma árvore pelo pessoal da vila e deixado na natureza uma noite inteira, esperando pelo julgamento da Besta Xuanwen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501213
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501213,
					"content": "Mais tarde no enredo, o protagonista, já esperando essa reviravolta de eventos, de alguma forma sobrevive, e aguenta a noite, depois de revelar a verdade por trás de tudo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501214
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501214,
					"content": "...Entretanto, eu não faço ideia como uma pessoa que foi amarrada por toda uma noite se sente. Nem como essa pessoa ia soar, pensar, ou até se mover!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501215
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501215,
					"content": "É por isso que eu preciso que vocês me amarrem aqui a noite toda. Assim vou poder experimentar essa sensação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501216,
						700501217
					],
					"speakerTitle": "Guijarro"
				},
