					"id": 700501216,
					"content": "Não, é perigoso demais. Tô fora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501218
					]
				},
				{
					"id": 700501218,
					"content": "...Hmm, bem, ter tem. Mas não seria tão eficaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501219
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501219,
					"content": "Seria... eu levantar minhas mãos e ficar aqui a noite toda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501220
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501220,
					"content": "Hã... ou você podia não escrever essa história. Nossas ações podem ser mal-interpretadas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501221,
					"content": "Seu protagonista passa por problema demais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501222
					]
				},
				{
					"id": 700501222,
					"content": "Por favor! Esse é o pedaço mais importante! Quando eu terminar isso, minha história vai estar completa! Se usarmos esse método, vocês não terão cometido crime algum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501223
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501223,
					"content": "Não é como se a gente precisasse cometer um pra começo de conversa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501224,
					"content": "Não é como se a gente precisasse cometer um pra começo de conversa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501225
					]
				},
				{
					"id": 700501225,
					"content": "Ah... bem, vocês não precisam se dar ao trabalho. Só precisam ficar de guarda ao meu lado, garantindo que ninguém vai me levar... ou algum animal, enquanto eu pego o que preciso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501226
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501226,
					"content": "Deixe-me ver... considerando a atmosfera que queremos criar na história, devíamos subir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501227
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501227,
					"content": "Hã? Ei, espera a gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501228,
					"content": "Vocês e Guijarro sobem até o ponto mais alto do campo de chá...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501229
					]
				},
				{
					"id": 700501229,
