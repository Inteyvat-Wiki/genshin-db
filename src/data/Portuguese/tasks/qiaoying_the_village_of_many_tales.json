				]
			},
			"dialogs": [
				{
					"id": 700500501,
					"content": "...Viu? Paimon disse que era só um gatinho qualquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500502,
					"content": "Hmm, e pensar que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500503
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500503,
					"content": "Miau? Miau... miau, miau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500504,
						700500506
					],
					"speakerTitle": "Gatinho Confuso"
				},
				{
					"id": 700500504,
					"content": "Você sabe de alguma Besta Xuanwen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500505
					]
				},
				{
					"id": 700500505,
					"content": "...miau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "Gatinho Confuso"
				},
				{
					"id": 700500508,
					"content": "O gato se vira e sai, parecendo frustrado...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500509
					]
				},
				{
					"id": 700500509,
					"content": "Ainda assim, vocês acham que esse gatinho pode ser a forma mais nova de uma Besta Xuanwen aqui da Vila Qiaoying, que não está chamando atenção até crescer, para então destruir todas as árvores de chá de uma vez só?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500510
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500510,
					"content": "Srta. Guijarro, é a senhorita de novo... eu já não disse que as Bestas Místicas não são tão gentis assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500511
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500511,
					"content": "Ah, Srta. Hung Fan! Que coincidência. O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500512
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500512,
					"content": "*Suspiro* Por favor, pare de mencionar coisas como \"casos criminais\" por aqui. E se as crianças levarem você a sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500513
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500513,
					"content": "Vocês se conhecem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500514
					]
				},
				{
					"id": 700500514,
					"content": "Sim. Quando vim aqui, foi essa senhorita que me ajudou a carregar minha bagagem. Eu também consultei ela sobre muitas coisas a respeito de folclore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500515
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500515,
					"content": "Eu já disse várias vezes que essas criaturas não vão aparecer aqui, mas ela não acredita em mim. O que foi que você disse mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500516
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500516,
					"content": "Mesmo que as bestas não apareçam, você pode pegar fontes de inspiração sobre elas no caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500517
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500517,
					"content": "E lá vai você de novo... eu sei que não vou convencer você, mas ainda assim, peço que não saia da vila e fique correndo por aí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500518
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500518,
					"content": "Essas criaturas são muito perigosas, e se você encontrar uma... *Suspiro* Enfim, só não saia da vila sozinha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500519
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500519,
					"content": "Hung Fan sai, parecendo mais exausta e derrotada do que o gato de antes...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500520
					]
				},
				{
					"id": 700500520,
					"content": "Bem, como a Srta. Hung Fan disse, temos que ir para outro local para nossa fonte de inspiração. Venham, me sigam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500506,
					"content": "Foi mal, pegamos o gato errado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500507
					]
				},
				{
					"id": 700500507,
					"content": "Miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "Gatinho Confuso"
				}
			]
		},
		{
			"id": 7005006,
			"completionStepIds": [
				7005006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7005006",
							"2"
						],
						"stepId": 7005006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guijarro"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2276.275,
							287.313,
							1542.857
						],
						"pointId": 311400058
					}
				]
			},
			"dialogs": [
				{
					"id": 700500601,
					"content": "O que você acha? Esse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500602
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500602,
					"content": "Um caldeirão de chá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500603
					]
				},
				{
					"id": 700500603,
					"content": "Isso mesmo, e faz... alguma coisa com o chá... isso faz dele meio que especial... Independente do caso, foi colocado bem no meio desse lugar! Se quiser saber, deve ter algum significado especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500604
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500604,
					"content": "Hmmm. Agora então, e se... nossa Besta Xuanwen tem usando isso como seu esconderijo esse tempo todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500605,
						700500606
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500605,
					"content": "Nesse ritmo você vai acabar escrevendo uma história de fantasia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				},
				{
					"id": 700500607,
					"content": "Sua história vai acabar tendo uns elementos relacionados aos Adepti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500608,
					"content": "Não sei se esse é o tipo de tema para se escrever em uma história de crime...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500609
					]
				},
				{
					"id": 700500609,
					"content": "Hmm... essas expressões suas são boas. Vocês estão pensando que há um elemento de absurdo nas histórias de crimes escritas com Bestas Xuanwen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500610
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500610,
					"content": "Bem, sim? Você tem como usar mesmo esse tema para avançar a trama de uma história de crime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500611,
					"content": "Espera, será que você...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500612
					]
				},
				{
					"id": 700500612,
					"content": "#Haha, você é perspicaz, {NICKNAME}. Sua fama é justa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500613
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500613,
					"content": "Exato. Eu quero escrever sobre um crime que é absurdo demais para ser verdade. Suas reações, assim como a da Srta. Hung Fan, são muito interessantes. Vou incluir elas na trama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500614
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500614,
					"content": "Já quanto a Besta Xuanwen... ela será a culpada. Uma criatura que nunca foi vista, e que devora todos os malvados da vila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500615
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500615,
					"content": "Durante um certo festival, um habitante do vilarejo parece ter morrido pelas mãos de uma besta selvagem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500616
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500616,
					"content": "Mas durante o segundo dia do festival, o protagonista encontra a vítima, que devia estar morta, mas logo em seguida outra vítima aparece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500617
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500617,
					"content": "Espera, e aí? E depois?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500618,
					"content": "Bem, eu ainda não pensei até esse ponto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500619
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500619,
					"content": "...Estou indo embora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500620
					]
				},
				{
					"id": 700500620,
					"content": "Oh, qualé! Quando eu terminar, vou mandar duas cópias. Na verdade, eu vou precisar de um favorzão de vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500621
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500621,
					"content": "A Srta. Hung Fan disse que eu não posso sair da vila sozinha, não é? Bem, eu estava escutando ela quando disse isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500622
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500622,
					"content": "Mas... agora que vocês estão aqui, isso quer dizer que não estou mais sozinha, né? Isso significa que posso sair da vila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500623
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500623,
					"content": "Não vamos muito longe, claro! E aí, querem me ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500624,
						700500625
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500624,
					"content": "Bem, tá certo... mas vamos querer ver o final da história.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500627
					]
				},
				{
					"id": 700500627,
					"content": "Bem, vamos ali então? Quero ir em um local!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500625,
					"content": "Por favor, siga o processo de pagamento padrão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500626
					]
				},
				{
					"id": 700500626,
					"content": "Claro, não se preocupem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500627
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500606,
					"content": "Isso não tem nada a ver com uma história de crime.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				}
			]
		},
