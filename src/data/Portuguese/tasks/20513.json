					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130102,
					"content": "Você parece bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130103
					]
				},
				{
					"id": 205130103,
					"content": "É, bem, parece que eu realmente só estava me assustando por besteira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130104,
					"content": "Anna tem estado melhor todos os dias. Esse médico realmente é muito bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130105,
					"content": "Se você estiver disposto, poderia me ajudar a achar mais ingredientes? Dessa vez, precisamos de Margaridas Voadoras sopradas pelo Slime Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130106,
						205130111,
						205130115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130106,
					"content": "Isso não soa como remédio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130107
					]
				},
				{
					"id": 205130107,
					"content": "Bem, as Margaridas Voadoras as vezes são usadas como remédio, mas normalmente são usadas para curar pequenas enfermidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130108,
					"content": "Talvez o Slime Anemo seja a chave, mas Margaridas Voadoras e Slimes Anemo não são vistos juntos frequentemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130109,
					"content": "Por sorte, Jack viu isso acontecer algumas vezes antes, e ele me informou a localização aproximada deles. Deixe-me marcar a mais recente no seu mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130110,
					"content": "Eu não consigo lidar com Slimes Anemos já que eles podem voar, então eu só posso contar com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130111,
					"content": "Isso é a cara de Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130112
					]
				},
				{
					"id": 205130112,
					"content": "Eu não discordaria de você, mas as Margaridas Voadoras e Slimes Anemos não são vistos juntos com frequência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130113,
					"content": "Por sorte, Jack viu isso acontecer algumas vezes antes, e ele me informou a localização aproximada deles. Deixe-me marcar a mais recente no seu mapa.",
					"roleType": "TALK_ROLE_NPC",
