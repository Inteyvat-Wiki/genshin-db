						"pointId": 11410
					},
					{
						"sceneId": 3,
						"position": [
							2190.965,
							200.227,
							8784.622
						],
						"pointId": 13688
					}
				]
			},
			"dialogs": [
				{
					"id": 760200701,
					"content": "Agora isso é estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200702
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200702,
					"content": "Vocês viram aquilo? A árvore se acendeu de repente e aqueles pequenos... uma pena que não são peixes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200703
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200703,
					"content": "Então aquela coisa no centro deve ser a raiz dela, né? Sem ideia de como funciona, mas tá tudo brilhante agora. Parece bem melhor do que quando era tudo apagado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200704,
					"content": "Você conta a ele o que houve mais cedo...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760200705
					]
				},
				{
					"id": 760200705,
					"content": "Não posso dizer que acredito... mas vocês não têm motivo para inventar uma história. Parece que aquele meu parceiro de pesca, aquele meio Filho da Lua Gelada, tava mesmo contando a verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200706
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200706,
					"content": "Mas e daí? Eles são só sombras do passado. Não importa o que digam ou cantem, não vão impedir quem tá vivo de pescar peixes vivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200707
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200707,
					"content": "Enfim, vocês são caçadores de tesouros também, né? Aquela coisa que vocês pegaram mais cedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200708
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200708,
					"content": "Então essa é a <color=#00E1FFFF>Prova do Cognoscente</color>? Parece uma pena qualquer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200709,
					"content": "Um comerciante que eu conhecia disse que se você coletar cinco <color=#00E1FFFF>Provas do Cognoscente</color>, você vai descobrir algum \"Grande Tesouro\" ao leste da lua e oeste do sol. Não faço ideia se isso é verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200710
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200710,
					"content": "Mesmo assim, muitos caçadores de tesouro acreditam. Eles todos estão loucos correndo atrás disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200711
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200711,
					"content": "B-Bem, é tesouro, afinal de contas! Se você perguntar a Paimon, ela também tá meio curiosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200712,
					"content": "Se eu fosse 20 anos mais jovem... Não, mesmo assim, eu ainda ia tá aqui pescando. Dito isso, outro dia, outro balde vazio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				}
			]
		}
	]
}