			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ilmari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760200101,
					"content": "Outro dia, outro balde vazio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200102,
						760200105,
						760200112,
						760200117
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200102,
					"content": "O que você tá fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200103
					]
				},
				{
					"id": 760200103,
					"content": "Pescando. Mas até agora só pesquei coisas que não são peixes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200104
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200104,
					"content": "Se fossem bugigangas de naufrágios, tudo bem, porque comerciantes compram essas coisas. Eu já pesquei uma bota com meia... *Suspiro* Esqueça. Falar de coisas assim vai afugentar os peixes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200105,
					"content": "Tem algo interessante por perto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200106
					]
				},
				{
					"id": 760200106,
					"content": "Isso é conversa de tesouro, né? Aquele \"Grande Tesouro\" que dizem ficar ao leste da lua e oeste do sol... Não precisa de muito pra saber que aqui não é o lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200107
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200107,
					"content": "Ah, falando nisso, tiveram uns naufrágios nessas águas. Talvez tenha tesouro lá embaixo, mas não é fácil de pegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200108
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200108,
					"content": "Ouvi falar isso na taverna também. Um dos marinheiros sobreviventes disse que não tinha lua naquela noite, mas tinha uma coisa brilhando lá nas ondas gigantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200109
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200109,
					"content": "Dizem que tinha que ser o Kratti caolho, um monstro que podia devorar até a lua. Estava lutando contra a serpente marinha gigante por território.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200110
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200110,
					"content": "Por muito tempos após isso, essa pedaço inteiro ficou escuro como uma garrafa de tinta. Nenhum navio ousava passar por aqui. Todos temiam que as almas perdidas sob as ondas arrastassem eles pro fundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200111
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200111,
					"content": "Soube que aquelas almas perdidas continuam vagando por perto, mas aquela conversa toda é só para assustar crianças. Eu não acredito nesse tipo de baboseira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200112,
					"content": "Sobre essa árvore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200113
					]
				},
				{
					"id": 760200113,
					"content": "Essa coisa é bem sinistra. Costumava ter um redemoinho aqui e os marinheiros chamavam ele de Olho de Kratti. Então, um dia, essa árvore só começou a crescer dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200114
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200114,
					"content": "Mesmo assim, essa não foi a única coisa estranha que aconteceu naquela época. Pensando nisso, tudo começou depois que aquelas rochas caíram do céu... Talvez essa árvore seja o mesmo lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200115
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200115,
					"content": "E tem também aquelas coisas brilhantes que você vê de vez em quando. Aquilo é raro de verdade. Eu pensei que devia ter novos tipos de peixes também. Por isso vim para cá tentar a sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200116
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200116,
					"content": "Eu costumava ter um parceiro de pesca, mas ele ficou dizendo que ouviu um canto estranho. Assustou ele tanto que ele nunca voltou. Hah, só metade de um Filho da Lua Gelada, mas herdou o rebuliço completo deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200117,
					"content": "Desculpe pelo incômodo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200118
					]
				},
				{
					"id": 760200118,
					"content": "Sem problema. Não tem um único peixe à vista mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				}
			]
		},
