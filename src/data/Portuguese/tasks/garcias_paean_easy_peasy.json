			"dialogs": [
				{
					"id": 230160301,
					"content": "Lutong! Este equipamento está pronto para ser desenformado. Me ajude, rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160302,
					"content": "Viajante, você voltou. Suponho que já tenha memorizado as técnicas do Sr. Ahangar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160303
					],
					"speakerTitle": "Garcia"
				},
				{
