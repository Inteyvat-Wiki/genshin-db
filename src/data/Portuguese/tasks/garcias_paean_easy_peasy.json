			"dialogs": [
				{
					"id": 230163901,
					"content": "Garcia começou a trabalhar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230163902
					]
				},
				{
					"id": 230163902,
					"content": "Brilhante! Funcionou! É uma bela engrenagem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163903
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230163903,
					"content": "Preciso medir tudo... A folga entre os dentes da engrenagem... A espessura... O tamanho... Preciso de uma régua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163904
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230163904,
					"content": "Deixe que o Sr. Garcia cuide das suas medidas, Viajante, muito obrigado pela ajuda. Esta recompensa é para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163905
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163905,
					"content": "Você ainda está... Cautelosamente pessimista?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230163906
					]
				},
				{
					"id": 230163906,
					"content": "Isso mesmo, sempre fui assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163907
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163907,
					"content": "O Sr. Garcia e eu estamos vagando na frente de uma montanha gigante há algum tempo, e acabamos de remover uma pedrinha do sopé desta montanha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163908
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163908,
					"content": "Na verdade, não conseguimos encontrar um jeito de subir na montanha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163909
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163909,
					"content": "Espero que o talento do Sr. Garcia consiga nos guiar para o caminho certo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163910
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163910,
					"content": "Caso contrário, terei apenas que recitar mentalmente aquele ditado: \"Quando seu caminho está bloqueado por uma montanha, existirá um caminho em volta.\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
