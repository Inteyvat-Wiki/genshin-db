						230165102,
						230165105
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165102,
					"content": "Garcia está aqui há muito tempo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230165103
					]
				},
				{
					"id": 230165103,
					"content": "Algum tempo, eu diria. Ele é mais apaixonado pelos estudos do que vários dos meus aprendizes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165104
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165104,
					"content": "Mas do jeito que eu vejo, não acho que ele queira ganhar a vida como ferreiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165105,
					"content": "Além de mim, mais alguém veio procurar por eles?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230165106
					]
				},
				{
					"id": 230165106,
					"content": "Sim... Tem uma mulher que vem sempre, trazendo muitas coisas para ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165107
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165107,
					"content": "Ouvi dizer que o nome dela é Kaia... Ou algo assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165108
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165108,
					"content": "Eu não entendo. Essas pessoas não se parecem com ferreiros, então por que insistem em ficar na minha forja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				}
			]
