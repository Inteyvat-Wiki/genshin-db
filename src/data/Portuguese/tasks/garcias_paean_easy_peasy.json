			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160101,
					"content": "Minhas mãos... Ah! estão dormentes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160102,
					"content": "Senhor, daqui a um tempo você deve fazer as contas da Srta. Kaia também. Não se sobrecarregue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160103,
					"content": "Agora não, Lutong! Agora não!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160104
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160104,
					"content": "Claro, se você não puder ir, eu posso cuidar disso para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160105,
					"content": "Não precisa! Eu irei sozinho, só tenho que terminar de... Forjar mais algumas engrenagens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160106,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160107,
					"content": "Está bem, desisto. Não consigo mais continuar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160108
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160108,
					"content": "O que você está fazendo agora...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160109
					]
				},
				{
					"id": 230160109,
					"content": "Ah, é você, Viajante... Ai!... Minhas mãos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160110,
					"content": "Bem, essa é a situação. O Sr. Ahangar também está envolvido em outras coisas, por isso não é possível comissioná-lo constantemente para fazer essas peças que eu preciso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160111,
					"content": "Além disso, os componentes que ele faz são sempre um pouco diferentes do que tenho em mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160112
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160112,
					"content": "Então, para ter certeza da exatidão dos componentes, decidi forjá-los eu mesmo. Aprendi algumas técnicas de forja com o Sr. Ahangar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160113,
					"content": "Por sorte, quando estava em Fontaine tive experiência em algo parecido... Mesmo assim, existem algumas técnicas do Sr. Ahangar que não consigo memorizar. Ai ai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160114
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160114,
					"content": "Viajante, você poderia perguntar ao Sr. Ahangar sobre suas técnicas de forjamento? Eu realmente preciso descansar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160115,
						230160116
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160115,
					"content": "Está bem, descanse um pouco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160121
					]
				},
				{
					"id": 230160121,
					"content": "Obrigado por se dispor a ajudar. Argh... minha mão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160116,
					"content": "Quem é Kaia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160117
					]
				},
				{
					"id": 230160117,
					"content": "Ela é uma de nossas parceiras! Uma... Hmm... Uma parceira muito talentosa e... rica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160118
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160118,
					"content": "Assinamos um contrato de contabilidade de longo prazo! É por isso que continuo me encontrando com ela, não é, Lutong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160119
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160119,
					"content": "Você está certo, senhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160120,
					"content": "Enfim, é isso... Viajante, por favor, apresse-se e peça conselhos ao Sr. Ahangar, estarei esperando por você aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
		{
			"id": 2301602,
			"completionStepIds": [
				2301602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301602",
							"2"
						],
						"stepId": 2301602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ahangar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160201,
					"content": "Eu disse para esperar um minuto... Hã? O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160202,
						230160203
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160202,
					"content": "Estou aqui para fazer algumas perguntas em nome dele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				},
				{
					"id": 230160204,
					"content": "Então ele realmente foi e fez isso sozinho... Ele é mesmo muito estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160205
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160205,
					"content": "Em todos os meus anos como ferreiro, eu nunca conheci uma pessoa tão meticulosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160206
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160206,
					"content": "Ele ainda traz uma régua para medir a costura entre os tubos de ferro e a distância entre os fios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160207
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160207,
					"content": "Sinceramente, não aguentei mais, então sugeri que ele mesmo fizesse... Para a minha surpresa, no dia seguinte ele estava na minha frente me pedindo para ensinar-lhe a minha técnica de forja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160208
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160208,
					"content": "Ele é teimoso, então eu o deixo fazer o que ele quer. Contanto que ele pague pelos materiais, eu lhe dou permissão para usar as minhas ferramentas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160209
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160209,
					"content": "*Suspira* Eu não tenho absolutamente nenhuma ideia do que ele quer fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160210,
						230160211
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160210,
					"content": "Ele está construindo uma máquina incrível.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160212,
					"content": "Enfim... Meio estranho em todo caso. Vocês querem aprender técnicas de forja, certo? Na verdade, também não tenho nada para ensinar sobre forja de engrenagens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160213
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160213,
					"content": "No entanto, notei que ele quer engrenagens com arestas muito afiadas, mas com um centro côncavo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160214
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160214,
					"content": "Trabalhar apenas com moldes não é suficiente para essas engrenagens especiais, elas precisam de processamento adicional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160215
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160215,
					"content": "Eu já mostrei a ele como fazer em detalhes, é só dizer a ele que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160216
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160216,
					"content": "Primeiro, <color=#00E1FFFF>lembre-se de aumentar o fogo</color> quando for colocar na fornalha pela segunda vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160217
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160217,
					"content": "Depois, quando tirar as engrenagens para processamento, <color=#00E1FFFF>elas precisam ser marteladas de dentro para fora</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160218
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160218,
					"content": "Você memorizou tudo? Bem, se você já memorizou, vá contar o que você aprendeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160219
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160219,
					"content": "Que pessoa estranha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160211,
					"content": "Ele está construindo uma máquina muito estranha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160203,
					"content": "Suas mãos estão dormentes de tanto martelar, você precisa descansar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				}
			]
		},
