			"dialogs": [
				{
					"id": 230165001,
					"content": "Senhor, humildemente sugiro que... Devêssemos mudar a nossa abordagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165002,
					"content": "Mudar a nossa abordagem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165003
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230165003,
					"content": "Talvez pudéssemos fazer uma máquina inteligente, mas não tão complexa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165004,
					"content": "Acredito que com seus talentos, fazer máquinas desse tipo deveria ser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165005,
					"content": "Caro Lutong, já discutimos sobre isso antes, você já sabe a minha resposta... Sempre respeitarei a sua decisão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230165006,
					"content": "É melhor decidirmos onde você vai jantar com a Srta. Kaia, senhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165007
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165007,
					"content": "Ah, obrigado, Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165008
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230165008,
					"content": "É um prazer, senhor. Nosso contrato ainda não terminou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
