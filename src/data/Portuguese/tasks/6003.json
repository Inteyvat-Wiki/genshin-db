			"dialogs": [
				{
					"id": 60030101,
					"content": "Parece que estamos todos aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030102,
					"content": "#Sim, já estamos todos prontos. {NICKNAME}, Paimon, e vocês? Como estão se sentindo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030103
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030103,
					"content": "A Paimon tá pronta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030104,
						60030106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030104,
					"content": "#Também tô pront{M#o}{F#a}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030105
					]
				},
				{
					"id": 60030105,
					"content": "Ótimo, vamos direto ao assunto então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030113
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030113,
					"content": "Então, primeiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030114
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030114,
					"content": "Espera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030115
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60030115,
					"content": "Eu ouvi uma voz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030116,
					"content": "Ouvimos seus passos, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030117
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030117,
					"content": "#Você está aqui há algum tempo, talvez tenha vindo com {NICKNAME}? Mas sua presença não parece ter más intenções.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030118
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030118,
					"content": "Entre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030119,
					"content": "Como eu esperava, vocês reagiram bem rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030120
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Subordinado da Serva"
				},
				{
					"id": 60030120,
					"content": "Por ordem da Mestre Serva, vim transmitir sua mensagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030121
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Subordinado da Serva"
				},
				{
					"id": 60030121,
					"content": "O Dottore fingiu retornar a Snezhnaya, o que era claramente uma desculpa. Mas ele não voltou ao Escritório de Design de Experimentos de Kuuvahki, nem apareceu na Cidade de Nasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030122
					],
					"speakerTitle": "Serva"
				},
				{
					"id": 60030122,
					"content": "Então ele só pode estar no laboratório mais ao norte. Ah, agora entendo por que ele pediu seu próprio campo... ele já tinha planejado tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030123
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 60030123,
					"content": "Diga a eles que eu e Sandrone iremos na frente. Se eles também se interessarem pelo desfecho disso, nos encontraremos no laboratório mais ao norte de Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030124
					],
					"speakerTitle": "Serva"
				},
				{
					"id": 60030124,
					"content": "Ambas são amigas íntimas da Srta. Columbina, mas mesmo assim não deixaram de compartilhar informações conosco antes de agir... Agradeço sinceramente a ajuda dos Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030125
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030125,
					"content": "Embora a Damselette já tenha deixado a organização... a preocupação das Mestres com ela não é falsa. Além disso, pelo que vemos agora, as ações do Mestre Dottore estão cheias de mistérios, e precisamos ficar atentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030126
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Subordinado da Serva"
				},
				{
					"id": 60030126,
					"content": "Muitas vezes nos tornamos inimigos dos outros, mas isso é apenas baseado em nossas posições. Quando se trata de laços humanos e integridade, sempre soubemos honrar ambos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030127
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Subordinado da Serva"
				},
				{
					"id": 60030127,
					"content": "Vocês são amigos da Mestre Damselette, têm o direito de saber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030128
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Subordinado da Serva"
				},
				{
					"id": 60030128,
					"content": "Como sempre, Arlecchino soube avaliar bem a situação e nos poupou muito trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030129
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030129,
					"content": "Deixei o mapa aqui. Se decidirem ir até o laboratório mais ao norte, por favor, tenham muito cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030130
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Subordinado da Serva"
				},
				{
					"id": 60030130,
					"content": "Lembrem-se sempre: pelo menos em Nod-Krai, os subordinados da Mestre Serva podem ser seus aliados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030131
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Subordinado da Serva"
				},
				{
					"id": 60030131,
					"content": "Agradeço sua consideração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030132
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030132,
					"content": "É apenas meu dever. Bem, vou me retirar agora. Se precisarem de algo, podem nos encontrar no Escritório de Design de Experimentos de Kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030133
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Subordinado da Serva"
				},
				{
					"id": 60030133,
					"content": "O Dottore deixou o Escritório de Design de Experimentos de Kuuvahki e foi para o laboratório mais ao norte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030134,
					"content": "Marionette disse que Dottore já estava preparado. Será que ele tinha esse plano antes mesmo de vir para Nod-Krai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030135
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030135,
					"content": "Trabalhar para a Tsaritsa provavelmente era apenas uma mentira dele. Ou talvez, mais simplesmente — ele estava apenas fingindo obediência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030136
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030136,
					"content": "O Dottore age com decisão, e seus métodos são implacáveis e cruéis. Será um adversário formidável. Precisamos nos preparar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030137
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030137,
					"content": "No momento, os movimentos do Dottore são imprevisíveis. Sugiro que nos dividamos em dois grupos, deixando alguns para proteger a Cidade de Nasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030138
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030138,
					"content": "Hmm... embora eu queira ajudar, realmente não sou a melhor escolha para me infiltrar no instituto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030152
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60030152,
					"content": "Levem pelo menos o Patinho Fica Frio com vocês! Deve ajudar um pouco durante a batalha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030139
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60030139,
					"content": "A Srta. Ineffa quer ficar para proteger a Srta. Aino como de costume?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030140
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030140,
					"content": "Lógica de ação detectada: proteger Aino, prioridade: alta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030141
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60030141,
					"content": "Por precaução, seria melhor o Sr. Varka ficar também, nós cuidamos do instituto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030142
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030142,
					"content": "Como o Cavaleiro de Boreas, eu não deveria ficar de guarda num momento como este, mas... tudo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030143
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030143,
					"content": "Deixem a Cidade de Nasha comigo. Por favor, tomem muito cuidado, e se a situação sair de controle, não hesitem em recuar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030144
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030144,
					"content": "A Jahoda também irá ajudar vocês. Enquanto eu estiver fora, ela ficará responsável pelo trabalho de inteligência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030145
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030145,
					"content": "Entendi, chefe. Voltem em segurança!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030146
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60030146,
					"content": "Iremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030147
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030147,
					"content": "É melhor partirmos logo, quanto mais tempo demorarmos, mais problemas podem surgir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030148,
						60030149
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030148,
					"content": "A situação pode ser muito perigosa desta vez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030150
					]
				},
				{
					"id": 60030150,
					"content": "Uma missão de infiltração, e ainda por cima no instituto... Bem, já que vocês planejam entrar numa batalha feroz, a Paimon vai ajudar os outros então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030151,
					"content": "Vamos ter que dar o nosso melhor. Antes disso, tem alguma coisa que você ainda precisa fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030401,
						60030601
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030401,
					"content": "Ainda tenho algumas coisas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030402
					]
				},
				{
					"id": 60030402,
					"content": "#Então quando você estiver pront{M#o}{F#a}, partiremos juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030601,
					"content": "#Estou pront{M#o}{F#a} a qualquer momento!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030602
					]
				},
				{
					"id": 60030602,
					"content": "Então é melhor você ir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030603,
					"content": "Certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030149,
					"content": "Paimon vai ficar aqui para ajudar todo mundo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030150
					]
				},
				{
					"id": 60030106,
					"content": "Certo, que tal confirmarmos o assunto de novo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030107
					]
				},
				{
					"id": 60030107,
					"content": "#Haha, tá um pouco nervos{M#o}{F#a}? Não que eu {M#o}{F#a} culpe, também é a primeira vez que algo assim acontece com todos nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030108
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030108,
					"content": "A Srta. Columbina foi atacada pelo Dottore há pouco tempo... e naquele breve momento, você a viu desaparecer naquele \"reflexo da lua\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030109
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030109,
					"content": "Sim. Durante o incidente, todos nós apenas vimos o Dottore aparecer e usar algum tipo de poder. Logo depois, a Columbina desapareceu, e você caiu do céu no mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030110,
					"content": "Precisamos resgatar a Srta. Columbina, além disso, o Mensageiro dos Fatui \"Dottore\" deve ter um propósito para tomar o poder das três luas. Precisamos detê-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030111
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030111,
					"content": "Recuperar a Deusa da Lua era originalmente a responsabilidade de nós, os Filhos da Lua Gelada. Não imaginava que todos estariam dispostos a ajudar... Em nome dos Filhos da Lua Gelada, expresso minha gratidão a todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030112
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030112,
					"content": "(Excluir)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030113
					]
				}
			]
		},
