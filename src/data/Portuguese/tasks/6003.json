				],
				"points": []
			},
			"dialogs": [
				{
					"id": 60030602,
					"content": "Então é melhor você ir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030803,
					"content": "Certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				}
			]
		},
		{
			"id": 600309,
			"completionStepIds": [
				600309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"600309",
							"2"
						],
						"stepId": 600309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 20322,
						"position": [
							335.674,
							288.735,
							245.957
						],
						"pointId": 6
					}
				]
			},
			"dialogs": [
				{
					"id": 60030901,
					"content": "Bem-vindos, bem-vindos, eu estava esperando por vocês. Espero que todos gostem do meu pequeno laboratório.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030902
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030902,
					"content": "Gostar? O caminho só tem monstros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030903
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030903,
					"content": "Como ousa esperar aqui com tanta tranquilidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030904
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030904,
					"content": "Claro. Por que eu deveria me preocupar? Tudo está correndo perfeitamente, e vocês chegaram exatamente como esperado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030905
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030905,
					"content": "Primeiro Sandrone e Arlecchino, e agora vocês. Temos muitas visitas hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030906
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030906,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030907
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030907,
					"content": "Se você está procurando pelas duas senhoras, então preciso contar: a Arlecchino desapareceu logo após entrar no instituto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030908
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030908,
					"content": "E Sandrone estava bem aqui há pouco, me interrogando aos gritos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030909
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030909,
					"content": "Ela é sempre assim, sem educação nenhuma. Mas uma coisa me surpreendeu, nunca imaginei que até a Sandrone começaria a se importar com os outros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030910
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030910,
					"content": "Será que todas as pessoas que se aproximam de vocês acabam ficando assim? Mas isso não é bom para os pesquisadores. Não é objetivo o suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030911
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030911,
					"content": "Onde está Sandrone?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030912
					]
				},
				{
					"id": 60030912,
					"content": "Sobre isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030913
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030913,
					"content": "Você foi muito longe em seus sonhos, Dottore. Você realmente acha que a Medula Lunar vai te transformar em um deus neste mundo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030914
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 60030914,
					"content": "Não gosto desse termo \"transformar em um deus\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030915
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030915,
					"content": "Não é presunção, mas um fato. Como pesquisadora, você certamente compreende a diferença entre ambos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030916
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030916,
					"content": "Hã? Você, sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030917
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 60030917,
					"content": "Oh, até uma dama pode ser rude às vezes, não ligue. Afinal, somos colegas — conhecemos bem o seu jeito de agir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030918
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 60030918,
					"content": "Era de se esperar — afinal, também conheço seu jeito de agir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030919
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030919,
					"content": "Você e eu sabemos que fatos falam mais que palavras. Por isso, enviei um pequeno presente para ajudá-la a compreender visualmente meu atual patamar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030920
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030920,
					"content": "Um presente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030921
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 60030921,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030922
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 60030922,
					"content": "Onde estão todos os seus subordinados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030923
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 60030923,
					"content": "Quem sabe? Talvez eles já tenham seguido os passos do Deus Desconhecido rumo ao novo mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030924
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030924,
					"content": "Embora você seja mal-educada e convencida, minha querida Sandrone, não levarei isso em conta contra seus subordinados. Eles também merecem respeito igualitário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030925
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030925,
					"content": "Como ousa enviar pessoas ao Escritório de Design de Experimentos de Kuuvahki? Aquele é o local de experimentos de Vossa Majestade, a Tsaritsa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030926
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 60030926,
					"content": "Claro, as ordens de Vossa Majestade devem ser respeitadas. Mas você bem sabe que isso não conflita com meus objetivos atuais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030927
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030927,
					"content": "Nesse caso, estou apenas realizando alguns experimentos de meu interesse. Algum problema com isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030928
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030928,
					"content": "Você pode apostar: será que estou mentindo e apenas tentando criar uma distração, ou será que cada palavra que digo é verdade e seus subordinados estão realmente em perigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030929
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030929,
					"content": "Até os próprios soldados dos Fatui? Você perdeu completamente a humanidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030930
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 60030930,
					"content": "Agora eu criei uma nova regra para mim: dar uma chance a cada pessoa. E naturalmente, isso inclui você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030931
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030931,
					"content": "Se você quiser ir embora, não vou impedir. Afinal, somos todos bons colegas de trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030932
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030932,
					"content": "Maldição!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030933
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 60030933,
					"content": "Mas confesso que não esperava nem mesmo da Sandrone esse interesse pelas pessoas deste mundo. Que pena — achava que o egocentrismo era a única qualidade que lhe restava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030934
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030934,
					"content": "Proteger até mesmo um escritório de design? Com essa mentalidade, que grandes feitos você espera conquistar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030935
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030935,
					"content": "Tomar reféns não é exatamente uma tática digna, não acha? Ou para você, hoje, a dignidade já não importa mais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030936
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030936,
					"content": "Dignidade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030937
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030937,
					"content": "Tenho duas Medulas Lunares em minhas mãos, e a terceira está quase pronta. Falar de dignidade com alguém que está prestes a se tornar um deus do novo mundo? Que piada mais sem graça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030938
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030938,
					"content": "Você não é digno de possuir tal Relíquia Sagrada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030939
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030939,
					"content": "E pelo que vejo, há muitas pessoas neste mundo que não merecem viver, mas ainda assim, em minha misericórdia, permito que existam, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030940
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030940,
					"content": "Você vai se arrepender do que fez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030941
					]
				},
				{
					"id": 60030941,
					"content": "Isso depende se vocês têm mesmo o que é preciso para me fazer arrepender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dottore"
				}
			]
		},
