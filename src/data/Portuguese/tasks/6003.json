			},
			"dialogs": [
				{
					"id": 60031101,
					"content": "Com o apoio da Medula Lunar artificial ainda incompleta, o poder de Dottore já alcançou um nível além do que podemos enfrentar... Não prolongue o confronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031102
					],
					"speakerTitle": "Serva"
				},
				{
					"id": 60031102,
					"content": "Aproveite a chance!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031103
					],
					"speakerTitle": "Serva"
				},
				{
					"id": 60031103,
					"content": "Vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60031104,
					"content": "Fugir é mais sensato que se render, sempre pensei assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031105
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60031105,
					"content": "Isso é...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60031106
					]
				},
				{
					"id": 60031106,
					"content": "Cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031107
					],
					"speakerTitle": "Serva"
				},
				{
					"id": 60031107,
					"content": "Não se preocupem comigo, vocês—",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60031108
					]
				},
				{
					"id": 60031108,
					"content": "#Cadê {NICKNAME}?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60031109,
					"content": "Tsc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031110
					],
					"speakerTitle": "Serva"
				},
				{
					"id": 60031110,
					"content": "Se não conseguirmos avançar, teremos que recuar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
