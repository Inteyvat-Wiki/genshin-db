			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206010601,
					"content": "Você já acabou de expulsar todos os Hilichurls, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010602
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010602,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010603
					]
				},
				{
					"id": 206010603,
					"content": "Você é incrível. Se eu fosse incrível como você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010604
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010604,
					"content": "Eu também quero deixar o meu nome marcado na história de derrotar o dragão ou salvar o mundo, mas enfim, ainda não consegui expulsar os Hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010605
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010605,
					"content": "Urg... De qualquer forma, eu... Isto é constrangedor, mas eu tenho algo a lhe pedir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010606
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010606,
					"content": "Na verdade, vim para o Templo do Vento Milenar porque em breve farei o teste de Rank de Aventura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010607
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010607,
					"content": "Se eu mostrar que eu sou capaz, a minha classificação poderia aumentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010608
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010608,
					"content": "Mas nunca pensei que eu ia destruir tudo, até quase perdi a minha vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010609
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010609,
					"content": "P-posso pedir que por favor não diga nada ao senhor Cyrus sobre isso? Eu realmente estaria em mal bocados se isso afetasse minha classificação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010610,
						206010612
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010610,
					"content": "Não contarei a ninguém...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010611
					]
				},
				{
					"id": 206010611,
					"content": "Muito obrigado. Na próxima vez não vou ser precipitado de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010612,
					"content": "Isso não é muito bom.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010613
					]
				},
				{
					"id": 206010613,
					"content": "Eu sei que não é, e o Cyrus sempre diz que os aventureiros \"devem ser honestos consigo mesmo\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010614
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010614,
					"content": "*Suspiro* Espero que o Cyrus não fique chateado comigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
