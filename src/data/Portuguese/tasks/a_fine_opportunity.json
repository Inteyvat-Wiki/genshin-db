						206010805
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010805,
					"content": "Coragem é uma coisa preciosa sim, mas espero que ele seja mais robusto. Um bom Aventureiro é um Aventureiro que fica vivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010806
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010806,
