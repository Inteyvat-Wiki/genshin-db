			},
			"dialogs": [
				{
					"id": 220300601,
					"content": "Muito obrigado! Esses ingredientes ainda podem ser usados, mas não podemos esperar mais um minuto... Vou começar a cozinhar agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300602
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300602,
					"content": "Está feito. Ufa... é tudo graças a você que este prato foi concluído sem problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300603,
						220300610
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300603,
					"content": "#Você realmente é {M#um}{F#uma} perfeccionista...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300604
					]
				},
				{
					"id": 220300604,
					"content": "Claro. Seja design floral, chá, culinária ou esgrima, se você não buscar a perfeição, seu significado se perderá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300605
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300605,
					"content": "O caminho da \"perfeição\" é minha maneira de viver. No entanto... Xudong parece ter uma opinião diferente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300606
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300606,
					"content": "Certa vez, ele me disse que existe uma palavra em Liyue chamada moderação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300607
					],
