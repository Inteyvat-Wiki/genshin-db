					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220300101,
					"content": "Vossa senhoria, nos encontramos novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300102
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300102,
					"content": "Perdoe minha falta de educação, mas há algo que preciso da ajuda de vossa senhoria hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300103,
						220300104
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300103,
					"content": "Do que você precisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300106
					]
				},
				{
					"id": 220300106,
					"content": "Após começar a trabalhar com o Xudong, eu sempre ando com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300107
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300107,
					"content": "Para retribui-lo, eu gostaria de fazer alguns presentes para ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300108
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300108,
					"content": "Mas como Xudong parece preferir culinária a artes marciais, gostaria de lhe cozinhar algo pessoalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300109
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300109,
					"content": "Eu já havia encontrado dois locais com os ingredientes necessários, e estava planejando pegá-los quando estivessem maduros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300110
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300110,
					"content": "Mas dois grupos de monstros ocuparam esses dois lugares e até já coletaram os ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300111
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300111,
					"content": "No prato que quero fazer, é crucial que os ingredientes sejam muito frescos. No início pensei em ir a um lugar para pegá-los primeiro e depois ao outro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300112
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300112,
					"content": "Mas agora que os dois grupos de monstros já pegaram os ingredientes, devo recuperá-los o mais rápido possível se quiser cozinhar aquele prato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300113
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300113,
					"content": "Mas eu só posso lidar com os monstros em um lugar de cada vez. Enquanto me livro de um grupo, receio que os ingredientes do outro lugar já tenham sido destruídos pelos monstros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300114
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300114,
					"content": "É por isso que preciso de sua ajuda. Vamos derrotar esses monstros ao mesmo tempo e recuperar os ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300115,
						220300117
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300115,
					"content": "Deixa comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300116
					]
				},
				{
					"id": 220300116,
					"content": "Muito obrigado mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300119,
					"content": "Hmm... Falar mais sobre isso aqui não adianta nada. Por favor, venha comigo para dar uma olhada lá na frente, depois discutiremos melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300117,
					"content": "Depois de terminar de cozinhar o prato, posso comer um pouco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300118
					]
				},
				{
					"id": 220300118,
					"content": "#Claro. Na verdade, você será {M#o}{F#a} primeir{M#o}{F#a} a comê-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300104,
					"content": "Não precisa ser tão educado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300105
					]
				},
				{
					"id": 220300105,
					"content": "Sou eu que estou lhe pedindo ajuda, vossa senhoria, portanto, ser educado é apropriado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300106
					],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
		{
