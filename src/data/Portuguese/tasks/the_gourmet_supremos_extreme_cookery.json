			"dialogs": [
				{
					"id": 220300201,
					"content": "É aqui mesmo. Os dois grupos de monstros montaram acampamento em ambos os lados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300202
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300202,
					"content": "Eu já fui para baixo para dar uma investigada. Embora os monstros no campo esquerdo pareçam mais fracos, eles são muitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300203
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300203,
					"content": "Existem menos monstros no acampamento direito, mas eles são muito mais fortes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300204
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300204,
					"content": "Por favor, elimine os monstros em um acampamento e deixe o outro comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
