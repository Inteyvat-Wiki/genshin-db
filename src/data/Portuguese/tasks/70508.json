			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou",
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705080101,
					"content": "#Olá, {NICKNAME}! Chegou na hora certa. Gostaria de se juntar a nós para beber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080102
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080102,
					"content": "Viajante, que surpresa maravilhosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080103
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080103,
					"content": "O que vocês estão fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080104
					]
				},
				{
					"id": 705080104,
					"content": "Espera, vocês vieram juntas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080105,
					"content": "Esta senhorita decidiu do nada que ela gostaria de umas pequenas férias, então acabamos viajando pela área.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080106
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080106,
					"content": "Mas, suponho que temos ideias diferentes de férias. Mal subimos as montanhas e já viemos aqui para relaxar. Muito mimada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080107
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080107,
					"content": "Vamos lá, não precisa ferir meus sentimentos assim. Além disso, eu especificamente escolhi este lugar pois sei o quanto você gosta de beber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080108
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080108,
					"content": "Mas, nossa capitã aqui já viu bastante do mundo, então ela não está exatamente animada com esta pequena taverna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080109
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080109,
					"content": "Já serve. Enfim, essa é por minha conta, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080110
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080110,
					"content": "A Beidou está pagando? Uh, isso inclui a gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080111,
					"content": "#Paimon, nós somos {M#os}{F#as} bartenders.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080112
					]
				},
				{
					"id": 705080112,
					"content": "Ah, sim. Hehe, desculpa... acho que já virou costume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080113,
					"content": "E o que posso trazer para essas duas belas senhoritas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080114
					]
				},
				{
					"id": 705080114,
					"content": "Quero um pequeno copo de Bétula... com um toque azedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080115
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080115,
					"content": "Um copo grande de Ocaso, por favor. Obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080116
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080116,
					"content": "Entendido. Já está indo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7050802,
			"completionStepIds": [
				7050804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
