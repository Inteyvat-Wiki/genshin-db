			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang",
					"Beidou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705080201,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080202
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080202,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080203,
					"content": "Então? Co—como está? O silêncio está deixando Paimon nervosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080204,
					"content": "Hmmm... o gosto agridoce da nostalgia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080205
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080205,
					"content": "Você quer dizer, o gosto de sair da pobreza para a riqueza? Que tipo de gosto é esse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080206
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080206,
					"content": "Hehe... é principalmente azedo com um toque doce, e um gosto persistente na boca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080207
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080207,
					"content": "Interessante... tem gosto de começar um pequeno negócio e então descobrir que vender fruta não é muito lucrativo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080208
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080208,
					"content": "Não precisa entrar em detalhes. Vamos deixar o passado para trás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080209
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080209,
					"content": "Haha, quem imaginaria que a digníssima Tianquan foi uma vendedora de frutas um dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080210
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080210,
					"content": "Por outro lado, aposto que poucos conseguem dizer que sou de uma pequena vila pesqueira, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080211
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080211,
					"content": "Não necessariamente. Na minha opinião...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080212
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080212,
					"content": "Eu diria que os olhos da Capitã Beidou podem perfurar o oceano. Você é uma aventureira que domou o vento e as ondas... que claramente indica alguém que cresceu no oceano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080213
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080213,
					"content": "Ei, você não está zombando da minha cara, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080214
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080214,
					"content": "Sinceramente, não adiantaria de nada ser sarcástica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080215
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080215,
					"content": "Eu sei o quão poderosa você pode ser com as palavras. É por minha conta hoje, então lembre-se de pegar leve comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080216
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080216,
					"content": "Muito bem, então eu gostaria de mais alguns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080217,
						705080218
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080217,
					"content": "Mais uma bebida para a adorável senhorita?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080219
					]
				},
				{
					"id": 705080218,
					"content": "Estamos aqui para te servir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080219
					]
				},
				{
					"id": 705080219,
					"content": "Você ouviu a senhorita, bartender!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080220,
					"content": "Eu gosto de onde isso está indo! Vou querer outra rodada também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080221
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080234,
					"content": "Você imediatamente enche novamente o copo das duas...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 705080221,
					"content": "O suco fresco de Mondstadt é difícil de superar. Eu gostaria de poder desfrutar disso todos os dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080222
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080222,
					"content": "Você está falando sério? Não me diga que você vai abrir uma venda de Frutos do Pôr do Sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080223
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080223,
					"content": "Hmmm, é uma proposta interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080224
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080224,
					"content": "Hã, sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080225
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080225,
					"content": "Só estou brincando, é claro. Já existe toda uma indústria para isso. Eles não precisam de mim se enfiando em seus negócios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080226
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080226,
					"content": "#Obrigada pelas bebidas de hoje, {NICKNAME}. Se você estiver procurando um trabalho rápido, eu adoraria te ter como {M#meu}{F#minha} bartender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080227
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080227,
					"content": "#Você também é bem-vind{M#o}{F#a} ao Alcor. A tripulação adora beber, você poderia vir desfrutar de um banquete conosco. Prometo que você vai se divertir muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080228
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080228,
					"content": "#Capitã Beidou, você está competindo comigo pelo talento {M#dele}{F#dela}? Você sabe que isso não é necessário. Você pode sempre dar uma parada na Câmara de Jade sempre que quiser que {M#o}{F#a} Viajante te faça uma bebida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080229
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080229,
					"content": "(Sou tão popular!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080230
					]
				},
				{
					"id": 705080230,
					"content": "É só a Paimon, ou elas estão falando como se fossem suas donas, agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080231,
						705080232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080231,
					"content": "Quando eu tiver a chance...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705080232,
					"content": "Visitarei vocês duas. Prometo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}