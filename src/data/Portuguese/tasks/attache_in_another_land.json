				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300205",
							"2"
						],
						"stepId": 2300205,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_NUM_LESS_THAN",
						"rawParams": [
							"101955",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanbei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230020301,
					"content": "Maravilhoso, esses são suficientes. Parecem ótimos também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020302
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020302,
					"content": "Aqui está a sua compensação, obrigado pela ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020303
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020303,
					"content": "Isso é antes ou depois dos impostos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020304
					]
				},
				{
					"id": 230020304,
					"content": "Depois dos impostos, é claro. Não se preocupe, eu não faria você voltar para Inazuma só para pagar impostos atrasados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020305
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020305,
					"content": "Mas, não posso garantir que não houve nenhuma mudança nas políticas fiscais do Shogunato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020306
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020306,
					"content": "Hmm... Escrever uma carta para Yousuke sobre isso parece uma boa ideia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanbei"
				}
			]
		},
		{
			"id": 2300204,
			"completionStepIds": [
				2300206
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_A_AND_ETCOR",
