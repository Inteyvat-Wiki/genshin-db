			"dialogs": [
				{
					"id": 230020201,
					"content": "E então? Você conseguiu pegar os cogumelos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanbei"
				}
			]
		},
		{
