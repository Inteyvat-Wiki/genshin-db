			"dialogs": [
				{
					"id": 790550101,
					"content": "Este é um cenário abandonado da peça teatral \"Sonhos de um Navio Naufragado\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550102
					],
					"speakerTitle": "Nota do estúdio"
				},
				{
					"id": 790550102,
					"content": "Originalmente, a história mostrava dois Eidolons Hydro que se apaixonaram a bordo de um navio quebrado, flutuando no ritmo das ondas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550103
					],
					"speakerTitle": "Nota do estúdio"
				},
				{
					"id": 790550103,
					"content": "Depois de confessarem seus sentimentos, eles ergueram-se na proa do navio iluminada pelo brilho do crepúsculo. A cena é muito romântica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550104
					],
					"speakerTitle": "Nota do estúdio"
				},
				{
					"id": 790550104,
					"content": "Entretanto, essa cena foi abandonada porque... os dois Eidolons Hydro que estavam no papel eram animados demais e não conseguiam parar de se mover para essa cena romântica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550105
					],
					"speakerTitle": "Nota do estúdio"
				},
				{
					"id": 790550105,
					"content": "*Suspiro*... se eu pudesse <color=#00E1FFFF>pegar dois deles na proa do navio ao mesmo tempo</color>, a cena ficaria perfeita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550106
					],
					"speakerTitle": "Nota do estúdio"
				},
				{
					"id": 790550106,
					"content": "— O diretor",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nota do estúdio"
				}
			]
		},
