			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110101,
					"content": "Ad astra abyssosque! O que posso fazer por você, Viajante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110102,
						20110103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110102,
					"content": "Sobre a viagem para Inazuma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				},
				{
					"id": 20110104,
					"content": "#Sim, eu já ouvi dizer que a Capitã da Frota Crux já prometeu a vocês para levá-l{M#os}{F#as} para Inazuma, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110105,
					"content": "Na verdade, já faz muito tempo que não vou até lá, e não tenho informações aqui que seriam úteis para você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110106,
					"content": "#Finalmente te encontrei! Você é {M#o}{F#a} Viajante de que a Capitã se orgulha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110107,
						20110109
					],
					"speakerTitle": "Dragão do Oceano"
				},
				{
					"id": 20110107,
					"content": "Já ficamos esperando por muito tempo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110108
					]
				},
				{
					"id": 20110108,
					"content": "Hehe, me sinto muito honrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110110
					],
					"speakerTitle": "Dragão do Oceano"
				},
				{
					"id": 20110110,
					"content": "Estamos terminando os preparativos de suprimentos. Assim que as equipes fizerem a contagem, podemos prosseguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110111
					],
					"speakerTitle": "Dragão do Oceano"
				},
				{
					"id": 20110111,
					"content": "A Capitã me mandou para te procurar. Assim que você chegar, vamos partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110112
					],
					"speakerTitle": "Dragão do Oceano"
				},
				{
					"id": 20110112,
					"content": "Beidou realmente sempre mantém a sua palavra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110113,
					"content": "Claro! Há muitas coisas que a Capitã é insistente, tenho certeza que verá pessoalmente quando estiver a bordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110114
					],
					"speakerTitle": "Dragão do Oceano"
				},
				{
					"id": 20110114,
					"content": "Então agora vocês estão prestes a ir para Inazuma? Espero que vocês tenham uma boa viagem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110115,
					"content": "Não importa se a jornada à frente leva para os altos céus ou ao abismo profundo. Cada novo passo é uma nova conquista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110116,
					"content": "Então, nos veremos no futuro! Boa viagem, Viajante. Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110117,
						20110118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110117,
					"content": "Katheryne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110119,
					"content": "Oh... É meio difícil dizer adeus agora... Nós praticamente nos vemos todos os dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110120,
					"content": "Sendo assim, vocês me procuram assim que chegarem em Inazuma? Esperarei por vocês na Ilha Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110121,
						20110122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110121,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110123,
					"content": "Então realmente há outra Katheryne em Inazuma! Veja, não há necessidade de ficar tão sentimental aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110124,
					"content": "Haha, bem, acho que é hora de vocês se despedirem do Porto de Liyue. Agora que entreguei minha mensagem, vou indo, já que o navio ainda está ancorado na Floresta de Pedra Guyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110125
					],
					"speakerTitle": "Dragão do Oceano"
				},
				{
					"id": 20110125,
					"content": "Ok, obrigada por ter vindo até aqui para nos avisar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110126,
					"content": "Apenas cumprindo ordens. Até logo no Alcor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dragão do Oceano"
				},
				{
					"id": 20110122,
					"content": "... Eu já sabia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110118,
					"content": "Vamos sentir a sua falta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110109,
					"content": "Quer dizer que as informações estão batendo a porta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110110
					]
				},
				{
					"id": 20110103,
					"content": "Sobre a Frota Crux",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				}
			]
		},
		{
			"id": 201103,
			"completionStepIds": [
				201103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
