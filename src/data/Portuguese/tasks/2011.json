			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110301,
					"content": "Aha! Vocês finalmente chegaram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110302
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110302,
					"content": "Todos esses anos, faça chuva ou tempestade, a Frota Crux nunca sofreu um atraso. Se fosse qualquer outra pessoa, eu já poderia ter zarpado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110303,
						20110304
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110303,
					"content": "Minha culpa, Capitã!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				},
				{
					"id": 20110305,
					"content": "#Hahaha, não fique tão séri{F#a}{M#o}, só estou brincando. Você chegou bem na hora, a tripulação acabou de fazer os preparativos finais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110306
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110306,
					"content": "Agora que todos estão aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110307
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110307,
					"content": "Partimos para a terra engolida por tempestades e tormentas... A nação da \"eternidade\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110308
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110308,
					"content": "Vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110304,
					"content": "É uma honra estar a bordo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				}
			]
		},
		{
			"id": 201107,
			"completionStepIds": [
				201107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201107",
							"2"
						],
						"stepId": 201107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110701,
					"content": "Então, você finalmente chegou. Você me deixou esperando por muito tempo, Capitã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110702
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110702,
					"content": "#E parece que temos {F#algumas passageiras clandestinas}{M#alguns passageiros clandestinos}... Ou talvez deva dizer - convidad{F#as}{M#os} de honra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110703
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110703,
					"content": "Shhhhh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110704,
					"content": "Você pode culpar sua Shogun toda-poderosa. As tempestades ao redor de Inazuma têm se tornado ainda mais violentas ultimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110705
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110705,
					"content": "Embora a frota estivesse totalmente pronta para enfrentar desafios, o mau tempo nos atrapalhou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110706
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110706,
					"content": "Agora então, deixe-me apresentar a todos. Este é Thoma, um parceiro comercial que conheci recentemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110707
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110707,
					"content": "#Heh, você não sabe há quanto tempo estou esperando para vê-l{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110708
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110708,
					"content": "#Thoma, {M#estes dois}{F#estas duas} são...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110709
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110709,
					"content": "Não há necessidade de apresentações, sua reputação já diz tudo. Parece que até os mares tempestuosos não conseguem manter os rumores sobre os seus feitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110710,
						20110711
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110710,
					"content": "Olá, Thoma!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110712
					]
				},
				{
					"id": 20110712,
					"content": "Hehe, com certeza é bom ouvir você dizer isso~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110713,
					"content": "Ha, isso seria mais conveniente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110714
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110714,
					"content": "#{NICKNAME}, Thoma está morando em Ritou há algum tempo. Não seria exagero dizer que ele é o Mediador deste lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110715
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110715,
					"content": "Se você tiver algum problema aqui, fale com Thoma. Mas se ele tentar mexer com você, eu vou dar uma lição a ele pessoalmente na próxima vez que vier para cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110716
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110716,
					"content": "Hehehe, não precisa se preocupar. Tenho certeza que nos daremos muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110717
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110717,
					"content": "Bom. Então, se tudo estiver resolvido, vou embora. Eu não gostaria de ser pega com minhas velas aqui embaixo, afinal, tenho um fugitivo procurado a bordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110718
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110718,
					"content": "Oh, você se refere a Kazuha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110719,
					"content": "Até a próxima, Viajante. Lembre-se de dar o melhor de si, independentemente das perigosas \"tempestades\" que possa encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110720,
						20110721
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110720,
					"content": "Tenho essa confiança.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110722
					]
				},
				{
					"id": 20110722,
					"content": "Boa viagem, Capitã Beidou! Tchau tchau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110723,
					"content": "Então, primeiramente, precisamos nos registrar no posto de controle de fronteira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110724
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110724,
					"content": "Hum, Paimon achou que deveríamos manter as coisas em segredo... Vamos cair nas mãos do governo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110725,
					"content": "Haha, não subestime os alcances do Decreto Sakoku. Você não seria capaz de evitar a inspeção, mesmo se tentasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110726
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110726,
					"content": "Portanto, temos que seguir as regras... Mesmo que elas não sejam razoáveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110727,
						20110728
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110727,
					"content": "Sim, está bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
