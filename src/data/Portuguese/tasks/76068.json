			"dialogs": [
				{
					"id": 760680101,
					"content": "Ah, Aria. Parece que você também já escolheu uma forma \"humana\" para si.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680102
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680102,
					"content": "Hehe, você ficou exatamente como imaginei que ficaria, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680103
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680103,
					"content": "Dito isso, eu não esperava que você fosse criar proativamente uma forma assim para aqueles serzinhos adoráveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680104
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680104,
					"content": "É natural, Aria. Essas vidas frágeis confiam em mim e clamam por mim, então responderei às suas vozes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680105
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680105,
					"content": "Nascemos para preservar o mundo. Se os seres conhecidos como \"humanos\" estão dispostos a habitá-lo, ouvir suas súplicas também cumpre a missão que nosso Rei nos concedeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680106
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680106,
					"content": "Sim. Afinal, ele disse que toda vida do outro lado do mar de estrelas é nossa aliada. Eles lutam ao nosso lado contra a escuridão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680107
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680107,
					"content": "Mas não era disso que eu estava falando. Quero dizer, eu não esperava que você, a \"Lua Gelada\", tivesse um lado tão sentimental. É muito fofo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680108
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680109
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680109,
					"content": "...Vejo que sua linguagem já começou a ser influenciada por aqueles pequenos humanos, Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680110
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680110,
					"content": "As palavras deles são sempre tão ambíguas. Não as use. Não consigo compreender o que você está tentando transmitir ao dizer \"fofo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680111
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680111,
					"content": "Ora, vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680112
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680112,
					"content": "Irmãs, agora que moldamos corpos para nós mesmas, a primeira coisa que deveríamos fazer não seria sair escondidas para nos divertir com as pessoas da superfície?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680113
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680113,
					"content": "Senão, teremos feito eles à toa! Rápido, antes que alguém nos descubra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680114
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680114,
					"content": "Hehe. Parece que nossa querida irmã simplesmente não consegue esperar, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680115
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680115,
					"content": "Ora, eu me lembro de que, quando eles começaram a construir sua civilização na superfície, você até disse: \"Aquele forasteiro é má notícia, e naturalmente, suas criações também são.\" Você nem sequer se dignava a olhar para eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680116
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680116,
					"content": "I-Isso é outra história!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680117
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680117,
					"content": "Ainda acho que vocês duas não deveriam ter deixado aquele forasteiro entrar, mas as pessoas da superfície...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680118
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680118,
					"content": "*Suspiro* Desde que estejam se divertindo. Vão, e lembrem-se de ficar perto da Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680119
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680119,
					"content": "Hã? Você não vem com a gente, Canon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680120
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680120,
					"content": "A serva daquele Descido disse que tinha assuntos a discutir comigo sobre o potencial gravitacional deste mundo e o ten{RUBY#[D]das leis do tempo}sor métrico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680121
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680121,
					"content": "Istaroth?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680122
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680122,
					"content": "Acredito que seja esse o nome dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680123
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680123,
					"content": "Você deveria mesmo se lembrar dos nomes das pessoas, irmã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680124
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680124,
					"content": "E talvez seja só impressão minha, mas tenho uma certa... sensação sobre como ela vê aquele Descido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680125
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680125,
					"content": "Não vou tirar conclusões precipitadas, Aria. Mas ficarei de olho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680126
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680126,
					"content": "Que bom ouvir isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680127
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680127,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680128
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680128,
					"content": "Hehe, não é nada. Então vamos na frente, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680129
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680129,
					"content": "Não se preocupe, Sonnet e eu vamos trazer um presente para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680130
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680130,
					"content": "...Eu não preciso de presentes. Só tomem cuidado para não serem reconhecidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}