				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Olaf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110030401,
					"content": "Mmm... Assim está melhor... Muito melhor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030402
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030402,
					"content": "Obrigado. Esta sopa realmente ajudou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030403
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030403,
					"content": "O que aconteceu, você ficou congelado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030404
					]
				},
				{
					"id": 110030404,
					"content": "Eu estava perseguindo um javali e depois de alcançá-lo, ele acabou caindo ruína abaixo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030405
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030405,
					"content": "Eu o segui lá para dentro, mas me deparei com um Regisvine Cryo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030406
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030406,
					"content": "Fiquei congelado na hora. Quando eu acordei, corri para o lado de fora, mas não consegui ir muito longe por falta de energia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030407
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030407,
					"content": "Regisvine Cryo? Árvores... Atacam pessoas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030408
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030408,
					"content": "Essa sim! Eu já tinha ouvido falar delas antes pelos outros, mas esta foi a primeira vez que vi uma com meus próprios olhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030409
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030409,
					"content": "Temos que ficar longe das ruínas... Parecem perigosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110030410,
					"content": "Isso soa delicioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030411,
						110030412
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030411,
					"content": "... Hã?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030413
					]
				},
				{
					"id": 110030413,
					"content": "É isso! O ingrediente que estava faltando! A cereja do bolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030414
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030414,
					"content": "Acalme-se. Nós podemos realmente comer uma árvore que é tão agressiva assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110030415,
					"content": "Só temos um jeito de descobrir, vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030416
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030416,
					"content": "*Suspiro* Lá vai ela de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030417,
						110030418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110030417,
					"content": "Temos que ir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030419
					]
				},
				{
					"id": 110030419,
					"content": "Não se preocupe comigo, eu vou ficar bem. Mas você precisa pará-la, ela está se colocando em um enorme perigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030418,
					"content": "Você devia voltar ao Vale Termal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030419
					]
				},
				{
					"id": 110030412,
					"content": "Tem alguma coisa que não faça você pensar em comida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030413
					]
				}
			]
		},
