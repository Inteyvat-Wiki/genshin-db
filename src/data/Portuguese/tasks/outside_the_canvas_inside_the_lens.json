	"talks": [
		{
			"id": 7268301,
			"completionStepIds": [
				7268302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268302",
							"2"
						],
						"stepId": 7268302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asagiri"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726830101,
					"content": "Cof, Cof... Não... Ainda não está bom... Não posso seguir assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830102
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830102,
					"content": "Mais um atraso, e perderei o próximo prazo de envio... *Snif*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830103,
						726830104
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830103,
					"content": "Olá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830105
					]
				},
				{
					"id": 726830105,
					"content": "Hã?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830106
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830106,
					"content": "Mil perdões—me, desculpa mesmo! Irei enviar hoje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830107
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830107,
					"content": "Uau! Espere um momento aí, nós...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830108,
					"content": "Srta. Moriko, por favor, apenas me dê...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830109
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830109,
					"content": "Hã? Então você não é a Srta. Moriko... Graças aos Arcontes... Urgh, *cof* *cof*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830110
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830110,
					"content": "Então, quem é a Srta. Moriko...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830111
					]
				},
				{
					"id": 726830111,
					"content": "A Srta. Moriko é a minha editora-chefe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830112
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830112,
					"content": "Meu nome é Asagiri. Eu sou uma... uhh... uma ilustradora independente, por assim dizer. A Srta. Moriko é a... uhh... editora-chefe encarregada do meu trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830113
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830113,
					"content": "Uma ilustradora? O que isso significa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830114,
					"content": "Imagino que você tenha visto algumas Light Novels pela Editora Yae, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830115
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830115,
					"content": "Você já reparou que normalmente elas contêm algumas páginas com apenas imagens?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830116
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830116,
					"content": "Tais imagens é o que chamamos de ilustrações, e aqueles que fazem elas são ilustradores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830117
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830117,
					"content": "Caso haja alguns cenários ou histórias importantes no conto, ou quando o autor deseja mostrar o rosto do protagonista, os autores preferem inserir algumas ilustrações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830118
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830118,
					"content": "As ilustrações fazem a história ser mais vívida ao ler. Além de adicionar mais conteúdo à Light Novel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830119
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830119,
					"content": "Oh... Paimon entendeu agora. Realmente não é algo simples fazer uma Light Novel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830120,
					"content": "Posso recomendar alguns romances para você! Por exemplo... *COF*! *Cof* *Cof* *Cof*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830121
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830121,
					"content": "Você está bem...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830122
					]
				},
				{
					"id": 726830122,
					"content": "Estou bem. É só que minha saúde nunca está boa. E para piorar, eu normalmente fico até tarde desenhando, e às vezes esqueço de comer também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830123
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830123,
					"content": "*Cof* *Cof* *Cof*... Por conta disso, minha saúde só continua se deteriorando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830124
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830124,
					"content": "Já que você não está bem, por que trabalhar aqui? Você não poderia fazer isso dentro de casa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830125,
					"content": "Estou aqui procurando inspiração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830126
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830126,
					"content": "Perdi minha inspiração recentemente. Então acabei perdendo alguns prazos de algumas ilustrações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830127
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830127,
					"content": "Srta. Moriko já adiou os prazos várias vezes por mim. Ela vai ficar muito irritada se eu atrasar mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830128
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830128,
					"content": "Eu estive pensando que talvez uma caminhada ao ar livre traria minha inspiração de volta, então pensei em dar um passeio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830129
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830129,
					"content": "Mas acontece que... haha... como pode ver, não demorou muito até que eu acabasse nesse estado miserável...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830130
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830130,
					"content": "*Suspiro* É melhor eu colocar um pedido de comissão para a Guilda de Aventureiros e ver se algum aventureiro com um Aparelho Fotográfico pode me ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830131
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830131,
					"content": "Hã? Falando sobre o Aparelho Fotográfico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830132,
						726830134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830132,
					"content": "Eu coincidentemente tenho um...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830133
					]
				},
				{
					"id": 726830133,
					"content": "Sério!? Você tem um Aparelho Fotográfico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830135
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830135,
					"content": "E-Eu gostaria que um aventureiro tirasse fotos para mim com o Aparelho Fotográfico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830136
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830136,
					"content": "Ouvi sobre vários locais fascinantes por aí — por exemplo, a alta montanha nevada perto de Mondstadt e a área em Liyue onde tem vários pilares...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830137
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830137,
					"content": "E tem mais! Tem esse lugar chamado de \"Relevo de Jueyun\". Dizem que os Adepti vivem lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830138
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830138,
					"content": "A morada dos Adepti... só de pensar nisso me deixa toda emocionada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830139
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830139,
					"content": "Mas por causa de minha saúde, não posso viajar pessoalmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830140
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830140,
					"content": "Mas, se você me ajudar com seu Aparelho Fotográfico registrando a paisagem de lá... Eu com certeza. *COF* *COF*! *COF*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830141
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830141,
					"content": "Eita! Você precisa se acalmar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830142,
						726830143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830142,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830144
					]
				},
				{
					"id": 726830144,
					"content": "Sério!? Isso é incrível! Tem vários lugares em minha lista. Me dê um segundo, deixe-me encontrar a lista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830145
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830145,
					"content": "Ah, e não se preocupe quanto a recompensa. Eu tenho algumas economias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830146
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830146,
					"content": "Onde está meu caderno? Onde está? Meu caderno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830143,
					"content": "Darei um jeito nisso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830144
					]
				},
				{
					"id": 726830134,
					"content": "Mas o que isso pode fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830135
					]
				},
				{
					"id": 726830104,
					"content": "Com licença...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830105
					]
				}
			]
		}
	]
}