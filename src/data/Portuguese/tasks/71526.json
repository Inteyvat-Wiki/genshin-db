			"dialogs": [
				{
					"id": 716663001,
					"content": "Onikabuto são nossos amigos! Como cães e gatos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663002
					],
					"speakerTitle": "Flor do Terror"
				},
				{
					"id": 716663002,
					"content": "Outra criança? Ugh, já não fizemos isso da outra vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663003
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663003,
					"content": "Hmm, é, mas Grande Mestre Hanakado também é uma criança, e uma das outras crianças da última vez se garantia mesmo. Então idade não mede a habilidade de um batalhador de besouros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663004,
					"content": "Embora Changchang não tenha nenhuma experiência anterior com Batalha de Besouros, o Onikabuto que ela escolheu tem o ar de um guerreiro formidável!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663005
					],
					"speakerTitle": "Grande Mestre Hanakado"
				},
				{
					"id": 716663005,
					"content": "Sei lá do que vocês estão falando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663006
					],
					"speakerTitle": "Flor do Terror"
				},
				{
					"id": 716663006,
					"content": "Meu Onikabuto foi um presente do papai. Ele conseguiu de um novo amigo que fez da última vez que ele tava viajando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663007
					],
					"speakerTitle": "Flor do Terror"
				},
				{
					"id": 716663007,
					"content": "Hoho, seu pai parece um cara maneirão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663008,
					"content": "Ok, vamos mandar Melão de Lavanda Destruidora do Céu para essa aí. A gente não quer acusações de intimidação voando por aí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663009
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663009,
					"content": "Hunf, você faz parecer que Paimon é a escolha mais fraca do nosso lado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663010,
					"content": "Mesmo assim, Paimon é provavelmente a escolha mais segura... mas só porque vocês maníacos são uma ameaça para si e outros quando entram no clima competitivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663011,
					"content": "Não fique tão nervosa, jovenzinha! É apenas um jogo, é só por diversão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
