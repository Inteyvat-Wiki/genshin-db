			},
			"dialogs": [
				{
					"id": 716663101,
					"content": "Ufa... Paimon quase arruinou tudo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663102,
					"content": "Eu quase tive um ataque de coração! Aquele monstrinho é muito forte! Até eu teria dificuldade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663103,
					"content": "Como que você ficou tão boa nisso sem um professor? Todo mundo aqui em Liyue é tipo um guerreiro de nascença ou algo assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663104,
					"content": "Então é assim que os Onikabuto brincam? Entendi agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663105
					],
					"speakerTitle": "Flor do Terror"
				},
				{
					"id": 716663105,
					"content": "Vocês têm tempo de brincar um pouco mais? Quero ver vocês brincando também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663106
					],
					"speakerTitle": "Flor do Terror"
				},
				{
					"id": 716663106,
					"content": "Parece que Changchang realmente gostou disso... Meio aterrorizante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663107,
					"content": "Ei, Joga-boi, se você tivesse esse tipo de talento, você podia provavelmente ter aprendido a se comunicar com criaturas com armadura só ouvindo Guoba falar com Tornado de Cristal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663108,
					"content": "Hah... Haha, hah... é, quem dera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
