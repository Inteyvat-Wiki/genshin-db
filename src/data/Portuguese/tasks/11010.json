				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Daipai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100101,
					"content": "Cuidado, Viajante. Agora não é um bom momento para visitas turísticas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100102
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100102,
					"content": "Oh! O que aconteceu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100103,
					"content": "Hmm. Várias testemunhas reportaram ao Quartel-General ter visto alguns Guardas das Ruínas por aqui, mesmo essa área não sendo sua área de atividade comum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100104
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100104,
					"content": "O Sargento enviou alguém para descobrir de onde vêm essas máquinas ancestrais. Parece que saíram repentinamente de suas ruínas, sem razão aparente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100105
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100105,
					"content": "Quem os despertou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100106,
					"content": "Não sabemos. Temos pouca informação sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100107
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100107,
					"content": "Adicionalmente, essas ruínas são tenebrosas. Ouvimos muitas vezes sons estranhos vindos de lá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100108
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100108,
					"content": "Assim sendo, antes de obter a permissão do Quartel-General, não podemos entrar e explorar as ruínas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100109,
						110100110
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100109,
					"content": "Realmente, é melhor ter cuidado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100113
					]
				},
				{
					"id": 110100113,
					"content": "Em resumo, atualmente, a melhor estratégia é fortalecer a patrulha, para evitar que o povo seja afetado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100114
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100114,
					"content": "Hmm... Será perigoso se uma pessoa normal encontrar os Guardas das Ruínas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100115,
					"content": "Posso ajudar de alguma forma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100116
					]
				},
				{
					"id": 110100116,
					"content": "Eu agradeço a oferta, mas... Os riscos não compensam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100117
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100117,
					"content": "#{NICKNAME} sabe lutar bem. Não se preocupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100118,
						110100120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100118,
					"content": "Tudo bem, eu sei me proteger.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100119
					]
				},
				{
					"id": 110100119,
					"content": "Entendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100122,
					"content": "Nesse caso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100123
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100123,
					"content": "Eu vi algumas pegadas de Guardas de Ruínas na <color=#00E1FFFF>encosta</color>, mas me apressei a avisar os transeuntes e por isso não investiguei bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100124
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100124,
					"content": "Vamos começar a procurar a partir dessas pistas? Sem problemas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100125,
					"content": "Enquanto os Millelith estiverem de guarda, o mal nunca prevalecerá! Em nome dos Millelith, eu o saúdo, Viajante. Você tem minha gratidão. Me encontrarei com você quando eu tiver terminado a minha patrulha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100120,
					"content": "Isso não é muito educado, mas eu poderia derrotar dez iguais a você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100121
					]
				},
				{
					"id": 110100121,
					"content": "Haha, os jovens são muito autoconfiantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100110,
					"content": "Os Millelith... Sempre tão ineficientes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100111
					]
				},
				{
					"id": 110100111,
					"content": "Ah? O que disse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100112
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100112,
					"content": "Hey! Você está parecendo o Diluc criticando os Cavaleiros de Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100113
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1101002,
			"completionStepIds": [
				1101004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101004",
							"2"
						],
						"stepId": 1101004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teucer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100201,
					"content": "Ei, venha ver! É enorme, é impressionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100202
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100202,
					"content": "Que roupas estranhas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100203,
					"content": "É a primeira vez que vejo um tão de perto, vocês já viram um assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100204,
						110100206
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100204,
					"content": "É um Guarda das Ruínas sem energia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100205
					]
				},
				{
					"id": 110100205,
					"content": "Não! Quê 'Guarda das Ruínas'? Seu nome é 'Sr. Ciclope'!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100208,
					"content": "\"Sr. Ciclope\"? Aw, que fofinho... Espera, o quê? As pessoas realmente chamam ele assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100209,
					"content": "Sim! Meu irmão que me disse, ele é o melhor vendedor de brinquedos do mundo, especialista em vender brinquedos desse tipo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100210
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100210,
					"content": "No momento ele está trabalhando no Instituto de Pesquisa de Brinquedos de Liyue. É de lá que vem o Sr. Ciclope.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100211
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100211,
					"content": "Você deve gostar muito de brinquedos, esse que está flutuando do seu lado é um modelo novo? Parece que a qualquer momento pode falar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100212,
						110100214
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100212,
					"content": "Paimon e o Guarda das Ruínas não são brinquedos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100213
					]
				},
				{
					"id": 110100213,
					"content": "Sim! Correto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100216,
					"content": "Obrigado por a sua ajuda. Encontraram algo? Hmm? Quem é esse menino estrangeiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100217
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100217,
					"content": "Nós acabamos de encontrar por acidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100218,
					"content": "Você não deveria estar aqui, garoto. Essa região está cheia de robôs assassinos rondando por aí, é muito perigoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100219
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100219,
					"content": "\"Robôs assassinos\"? Como esse daqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100220
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100220,
					"content": "Correto, como esse daí, se acordarmos um por engano será terrível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100221
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100221,
					"content": "Retire o que disse! O Sr. Ciclope não é uma máquina assassina, ele é um dos bonzinhos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100222
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100222,
					"content": "Erm... \"Sr. Ciclope\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100223
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100223,
					"content": "#{NICKNAME}, ele está falando mal do 'Sr. Ciclope', portanto ele é um bandido, não vamos ligar mais para ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100224
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100224,
					"content": "Garoto, eu só estou tentando ajudar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100225,
						110100226
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100225,
					"content": "Ele já não pode mais ouvir você...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100227,
					"content": "Ugh, eu nunca fui bom em lidar com crianças...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100228
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100228,
					"content": "Volte logo a fazer suas coisas, nós garantiremos a segurança dele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100229,
					"content": "Bom, parece que não tenho outra opção... Então, continuarei patrulhando por aqui. Levem a criança para um lugar seguro. Aqui é muito perigoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100230
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100230,
					"content": "Muhahaha, o poderoso Sr. Ciclope assustou os bandidos mais uma vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100231,
						110100232
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100231,
					"content": "Garoto, qual o seu nome?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100233,
					"content": "Eu sou Teucer! Vim da terra distante de Snezhnaya para achar meu irmão, mas estou sozinho, não sei onde meu irmão está...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100234
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100234,
					"content": "Você veio de Snezhnaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100235,
					"content": "Sim, acho que é nessa hora que eu lhe dou isso... Tome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100236
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100236,
					"content": "Hã? O que é isso... É pesado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100237,
					"content": "O que...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100238,
						110100239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100238,
					"content": "Quantos Mora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100240,
					"content": "Meu irmão disse para levar elas comigo, disse também para dar elas para pessoas boas. Pessoas boas são as que tratam Teucer bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100241
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100241,
					"content": "A lógica do seu irmão é boa... Mas é difícil acreditar que você veio de Snezhnaya para Liyue só dependendo disso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100242,
					"content": "Parece que Teucer é rico, não imaginava que vender brinquedos fizesse tanto dinheiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100243,
						110100244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100243,
					"content": "Eu aceito!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100245,
					"content": "#É sério? Muito obrigado, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100246
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100246,
					"content": "Certo, agora temos que fazer uma promessa de dedinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100247
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100247,
					"content": "Você faz uma promessa de dedinho, você a mantém por toda a sua vida. Você quebra a promessa de dedinho, e eu te jogo no gelo. O frio matará o dedinho que uma vez traiu seu amigo, a geada congelará sua língua para que você não volte a mentir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100248
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100248,
					"content": "Que música de ninar cruel de Snezhnaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100249,
					"content": "Bem, se nós não éramos suas babás antes, certamente agora nós somos! ... Mas onde devemos procurar seu irmão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100250,
						110100252
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100250,
					"content": "Em um lugar que tem uma forte ligação com Snezhnaya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100251
					]
				},
				{
					"id": 110100251,
					"content": "Hmm, um lugar relacionado a Snezhnaya... Oh, que tal o <color=#00E1FFFF>Banco do Norte</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100254,
					"content": "Enfim! Finalmente poderei ver meu irmão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100252,
					"content": "<color=#00E1FFFF>Banco do Norte</color>?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100253
					]
				},
				{
					"id": 110100253,
					"content": "Boa ideia! Vamos perguntar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100244,
					"content": "Terei o maior prazer em aceitá-lo! (E de dar ao irmão dele quando o encontrarmos...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100239,
					"content": "Muitos, muitos Mora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100232,
					"content": "Onde está sua família?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100226,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100214,
					"content": "Inveja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100215
					]
				},
				{
					"id": 110100215,
					"content": "Ei! Por que todo mundo me olha como se eu fosse muito esquisita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100206,
					"content": "Cuidado, ele é muito perigoso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100207
					]
				},
				{
					"id": 110100207,
					"content": "Exatamente! O 'Sr. Ciclope' é incrível! Ele não deixa escapar nenhum bandido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "Teucer"
				}
			]
		},
		{
			"id": 1101003,
			"completionStepIds": [
				1101006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101006",
							"2"
						],
						"stepId": 1101006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Childe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100301,
					"content": "Senhor, isso não parece muito apropriado, você não acha? Como você pode...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100302
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 110100302,
					"content": "Relaxe, uma vez só não machuca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100303
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100303,
					"content": "Hã? Como ele está aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100304,
					"content": "Irmão! Irmão, irmão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100305
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100305,
					"content": "Essa voz... Teucer! Oh céus, é Teucer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100306
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100306,
					"content": "Hahaha... Essa é a surpresa que você preparou para mim, Teucer? Eu achava que teria que esperar retornar à Snezhnaya para te ver de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100307
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100307,
					"content": "Sua irmã Tonia, e o irmão Anthon, como eles estão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100308
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100308,
					"content": "Todos eles sentem sua falta, Tonia todo dia reza antes do jantar pela sua segurança...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100309
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100309,
					"content": "Espere, tem algo errado, Teucer! Como você veio de Liyue? Eu não recebi nenhuma mensagem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100310
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100310,
					"content": "Ah, isso... Eu vi um barco que parecia que vendia brinquedos, pensei que você estava nele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100311
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100311,
					"content": "E então, quando saí do barco, continuei andando e andando... Até que, encontrei o Sr. Ciclope!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100312
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100312,
					"content": "#Sr. Ciclope expulsou um bandido, e logo depois, eu segui {M#o}{F#a} {NICKNAME} até aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100313,
						110100315
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100313,
					"content": "Então Teucer é um imigrante clandestino?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100314
					]
				},
				{
					"id": 110100314,
					"content": "E... Teucer é irmão de Childe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100316,
					"content": "Ótimo! Agora Paimon tem a consciência limpa por pegar o dinheiro de Teucer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100317,
					"content": "Teucer, isso foi muito perigoso... Estou muito feliz de ver você, mas você não fará nada perigoso como isso novamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100318
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100318,
					"content": "Teucer sabe, irmão, por favor não fique irritado comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100319
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100319,
					"content": "Não estou irritado com você, só estou preocupado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100320
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100320,
					"content": "Se não tivesse encontrado esses dois, a situação de Teucer poderia ter sido muito mais perigosa. Você os agradeceu bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100321
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100321,
					"content": "Sim! Eu sempre sou educado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100322
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100322,
					"content": "Então agora você presta atenção em nós, irmão 'Childe'?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100323,
					"content": "Hahahaha, me desculpem, de onde eu venho, independentemente de quando seja, a família sempre vem primeiro, espero que entendam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100324
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100324,
					"content": "Além disso, embora já tenhamos tido algumas experiências opostas antes, mas deixando de lado os problemas de posição... Nos damos muito bem, não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100325,
						110100326
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100325,
					"content": "Você está dizendo isso só para agradar, não?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100327
					]
				},
				{
					"id": 110100327,
					"content": "Haha! No que concerne àquela coisa, todos nós somos apenas peças de xadrez. Quanto a quem ganha, perde e lida com as consequências... Prefiro deixar para quem joga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100328
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100328,
					"content": "Eu realmente estou interessado em quem ganha e perde nas nossas batalhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100329
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100329,
					"content": "Você quer perder novamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100330,
					"content": "Hah! Eu, Tartaglia, passo cada segundo me tornando mais forte, a próxima vez não será tão fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100331,
						110100332
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100331,
					"content": "Eu também já não sou quem fui naquela época.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100333
					]
				},
				{
					"id": 110100333,
					"content": "Ei, ei, vocês não vão lutar agora, vão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100334,
					"content": "Hahaha, desta vez não, a luta pode ensinar coisas más para meu irmão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100335
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100335,
					"content": "Lutar? Meu irmão e você não se dão bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100336
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100336,
					"content": "#Não, não. {NICKNAME}, eu oficialmente lhe agradeço por ter escoltado o meu irmão, a segurança dele é muito importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100337,
						110100338
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100337,
					"content": "Ficarei de olho em você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100339
					]
				},
				{
					"id": 110100339,
					"content": "... Hmm, bem, Paimon tem uma dúvida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100340,
					"content": "Teucer disse que o irmão é o Vendedor de Brinquedos, mas como isso é possível? Você não é um dos Mensageiros dos Fatui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100341,
					"content": "Huum... Sim, sobre isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100342
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100342,
					"content": "Nos olhos de uma criança, vender brinquedos é o trabalho que vai fazer mais pessoas terem inveja de você, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100343
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100343,
					"content": "Além disso, eu não quero que minha família tenha algo a ver com os Fatui... Ou deveria dizer, o lado mais escuro de Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100344
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100344,
					"content": "Os mais velhos já sabem que eu trabalho para a Tsaritsa. Mas Teucer ainda é muito pequeno, e nos olhos dele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100345
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100345,
					"content": "Como eu estava dizendo, eu sou o melhor vendedor de brinquedo expatriado de Snezhnaya, temporariamente trabalhando no Instituto de Brinquedos de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100346
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100346,
					"content": "Isso mesmo! Meu irmão é o melhor! Ele é o melhor amigo do Sr. Ciclope!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100347
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100347,
					"content": "Vamos lá, faça-me rir em frente do Teucer, se você puder fazer a gentileza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100348
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100348,
					"content": "Ah, sim. Ekaterina, eu irei lidar logo com aquele problema do pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100349
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100349,
					"content": "Ei! Escapando, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100350
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100350,
					"content": "Mas Mestre Childe, não seria um pouco impróprio eu te pedir para lidar com... As cobranças de dívidas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100351
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 110100351,
					"content": "Uma aposta é uma aposta, não é mesmo? E se você perder uma aposta para um agente... Bem, é melhor você fazer um pouco de exercício.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100352
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100352,
					"content": "Você está indo vender brinquedos agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100353
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100353,
					"content": "#Certo! Eu também queria muito acompanhar o Teucer, mas estou muito ocupado. Que tal você acompanhar {M#ele}{F#ela}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100354
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100354,
					"content": "Urg, então depois de tudo isso, ainda precisamos continuar sendo sua babá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100355
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100355,
					"content": "#Teucer gosta de ficar junto de {NICKNAME}, nós fizemos uma promessa de que você cuidaria de mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100356
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100356,
					"content": "Teucer gosta de ficar com você, e vocês já fizeram uma promessa para tomar conta dele.",
