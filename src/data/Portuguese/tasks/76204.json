			"dialogs": [
				{
					"id": 762040201,
					"content": "Nicole! Estranho, não tem ninguém aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040202,
					"content": "Vocês já estão no meu estúdio? Notaram minha coleção de flores? Tô cultivando amostras que coletei do mundo inteiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040203,
					"content": "*Suspiro* Infelizmente não posso me afastar agora. Abri uma barraca em Fontaine vendendo esculturas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040204,
					"content": "Hmm... Quer ajuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762040205
					]
				},
				{
					"id": 762040205,
					"content": "Não, valeu. Essa é minha única chance de colocar a caneta no papel, mesmo que eu esteja escrevendo praticamente só números...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040206,
					"content": "Mas sei que vocês não têm tempo pra visitar sempre, então podem começar sem mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040207,
					"content": "Por acaso, deixei um pergaminho para vocês. Acho que coloquei perto da estátua de um pássaro perto da parede oeste. Vejam se conseguem encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040208,
					"content": "Paimon encontrou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040209,
					"content": "Então permita que minha guia silenciosa guie seu caminho... Boa sorte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
