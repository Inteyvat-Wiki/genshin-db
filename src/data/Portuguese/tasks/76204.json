			},
			"dialogs": [
				{
					"id": 762040301,
					"content": "Parabéns! Agora, deixa eu dar uma olhada... Hmm, bom trabalho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040302
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040302,
					"content": "Diferentemente do Jardim da Bruxa atual, fiquei nesse templo quando ainda era um anjo. Esse foi meu lar por muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040303
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040303,
					"content": "Tantos anjos! Parece que você era superpopular, Nicole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040304,
					"content": "Sem querer me gabar, mas todas adoravam me ouvir contar histórias, especialmente as que viviam com os humanos, enviando presságios ou guiando-os para construir grandes civilizações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040305
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040305,
					"content": "Toda vez que eu chegava numa parte boa, os outros anjos paravam o que estavam fazendo e seguravam o fôlego, se concentrando em cada palavra. Você não conseguia ouvir nem a corda de uma harpa tremendo ou um pincel passar pela superfície de uma tela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040306
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040306,
					"content": "Então, as cores entrelaçadas e tons desabrochavam. Havia música e luz, iluminando tudo em seu esplendor dourado, um arrebatamento de júbilo e alegria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040307,
					"content": "Eita, parece maneiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040308,
					"content": "Ah, era sim, Paimon... Era sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040309,
					"content": "Até mesmo aqueles dias maravilhosos se foram, a vida permanece cheia de surpresas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040310,
					"content": "Espera um segundo... Alguém teve mesmo a ousadia de roubar minhas esculturas enquanto eu lia meu jornal? Ah, já deu para você, meu tolo amigo! Vou guiar você até a Fortaleza Meropide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040311,
					"content": "Espera um segundo... Alguém teve mesmo a ousadia de roubar minhas esculturas enquanto eu lia meu jornal?",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040312
					]
				},
				{
					"id": 762040312,
					"content": "Ah, já deu para você, meu tolo amigo!",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040313
					]
				},
				{
					"id": 762040313,
					"content": "Vou guiar você até a Fortaleza Meropide!",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		}
