					"Vind"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400201,
					"content": "O que foi agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400202
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400202,
					"content": "Os monstros foram eliminados.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400203
					]
				},
				{
					"id": 200400203,
					"content": "Sério? Graças ao Arconte Anemo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400204
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400204,
					"content": "Não, não, desculpe. Sou eu quem tenho que agradecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400205
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400205,
					"content": "Como posso retribuir? Bem, eu tenho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400206
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400206,
					"content": "Venha me encontrar na Torre de Vigia. Eu esperarei por você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				}
			]
		},
