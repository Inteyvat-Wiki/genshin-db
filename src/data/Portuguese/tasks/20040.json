			},
			"dialogs": [
				{
					"id": 200400401,
					"content": "Hum... o mar está calmo e não há vento hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400402
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400402,
					"content": "Gerações da minha família têm vigiado aqui em nome de Mondstadt, procurando sinais de uma tempestade que se aproximava. Foi Dama Vennessa quem primeiro nos confiou essa tarefa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400403
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400403,
					"content": "Desde que Lorde Barbatos começou a proteger Mondstadt, não vimos uma única tempestade e as torres de vigia caíram em ruínas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400404
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400404,
					"content": "Mesmo assim, ainda não consigo parar de vir nesta torre de vigia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400405,
						200400408
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400405,
					"content": "Você se dedicou muito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400406
					]
				},
				{
					"id": 200400406,
					"content": "Não foi mais do que a minha obrigação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400407
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400407,
					"content": "Preferia nunca ter que cumpri-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400410,
					"content": "Enfim, obrigada pela sua ajuda. Estas Margaridas Voadoras são para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400411
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400411,
					"content": "No passado, a minha família observava como as Margaridas Voadoras cresciam, para ver a velocidade de ventos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400412
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400412,
					"content": "Não se encontram as Margaridas Voadoras em lugares sem vento, nem em lugares com ventos bem fortes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400413
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400413,
					"content": "Só floresce em lugares como Mondstadt, onde o vento é gentil e nutritivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400414
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400414,
					"content": "Esperamos que possam continuar prosperando por aqui para sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400408,
					"content": "É uma história muito triste...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400409
					]
				},
				{
					"id": 200400409,
					"content": "Sim, espero que essa história nunca se repita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "Vind"
				}
			]
		},
