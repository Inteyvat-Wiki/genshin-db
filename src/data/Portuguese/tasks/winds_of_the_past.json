			"dialogs": [
				{
					"id": 3061101,
					"content": "Chegamos. Este é um dos <color=#00E1FFFF>Templos dos Quatro Ventos</color> abandonados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061102,
					"content": "Estes templos caíram já há muitos anos. A maioria das pessoas de Mondstadt nunca vieram aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061103,
					"content": "Há chances de haver um ninho de monstros ou acampamento de Hilichurls dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061104,
					"content": "Mesmo o Stormterror desistiu do seu próprio templo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061105,
						3061106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061105,
					"content": "Stormterror...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061107
					]
				},
				{
					"id": 3061107,
					"content": "...Sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061108,
					"content": "Eu também acho difícil de acreditar, mas... O Stormterror foi um dos Quatro Ventos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061109,
					"content": "Quêêêêê!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3061110,
					"content": "Espere... Você sentiu isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061111,
					"content": "O vento aqui... Tem algo de errado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061112
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061112,
					"content": "#Entre e dê uma olhada, {NICKNAME}. Tenha cuidado, o poder do dragão está interferindo nesta área.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061106,
					"content": "Você disse \"o seu próprio templo...\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061107
					]
				}
			]
