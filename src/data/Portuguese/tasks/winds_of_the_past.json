			"dialogs": [
				{
					"id": 3061001,
					"content": "Uff... Estou cansada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061002
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061002,
					"content": "Mas, pelo menos, dessa maneira nós ajudamos a Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061003
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061003,
					"content": "No passado, nós éramos capazes de defender a cidade e manter a segurança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061004
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061004,
					"content": "Tudo isso, basicamente, é graças a Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061005
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061005,
					"content": "Mas agora com o Stormterror atacando diretamente a cidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061006
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061006,
					"content": "\"A direção do vento muda, e nossas táticas também.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061007,
						3061008
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061007,
					"content": "Profundo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061009
					]
				},
				{
					"id": 3061009,
					"content": "É o que a Lisa gosta de dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061010
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061010,
					"content": "Ah, e sobre o que estávamos falando sobre Os Quatro Ventos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061011
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061011,
					"content": "Se você quiser saber mais da nossa história, você pode perguntar a Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061012
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061012,
					"content": "... Não estou dizendo que não conheço a nossa história! É que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061013
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061013,
					"content": "Digo... Supostamente uma bibliotecária deve ter mais conhecimento que uma Aventureira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061008,
					"content": "Foi você que inventou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061009
					]
				}
			]
		},
