			"trigger": {
				"objectNames": [
					"Paimon",
					"Arabalika"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730161501,
					"content": "Ufa... Que assustador! Ainda bem que Arabalika nos ajudou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161502,
					"content": "Eu disse antes. Paimon ficará encrencada se não tomar cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161503
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161503,
					"content": "Sim... Você está certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161504,
					"content": "Se há guardas das ruínas dentro, eles com certeza se moverão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161505
					]
				},
				{
					"id": 730161505,
					"content": "Sim, Guardas devem estar guardando algo, não é? Para eles, nós que somos invasores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161506,
					"content": "#Nara {NICKNAME} e Paimon são forasteir{F#as}{M#os} em Vana, mas Arabalika não. É por isso que o Bloco de Ferro Grande não é um bom Bloco de Ferro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161507
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161507,
					"content": "Se o Bloco de Ferro Grande não se comportar, Arabalika lhes ensinará uma lição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161508
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161508,
					"content": "Uau... Paimon vai se comportar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161509,
					"content": "Paimon, vou garantir que você cumpra sua palavra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161510
					]
				},
				{
					"id": 730161510,
					"content": "Claro! Amanhã... Não! Agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161511,
					"content": "#Só os Aranaras podem despertar essa pedra daqui. Nara {NICKNAME} e Paimon, deixem isso daqui com Arabalika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161512
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161512,
					"content": "Oh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161513,
					"content": "Estamos um passo mais perto de curar Máquina Varuna! Quando estiver curada, não haverá mais tantos esporos na Floresta Apam... Só de pensar neles, o nariz de Paimon coça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161514,
					"content": "A Máquina Varuna purificará a água da chuva, não haverá mais chuva preta, e não haverão mais tantos esporos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161515
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161515,
					"content": "Mas os cogumelos continuarão existindo. Paimon precisará tomar cuidado caso quase seja comida por cogumelos como Aranakula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161516
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161516,
					"content": "Sim... Paimon terá cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161517,
					"content": "#Esse lugar não precisa mais de Arabalika. Retornarei para o Ponto de Descanso para procurar Arapandu. Nara {NICKNAME} e Paimon, querem retornar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161518,
						730161520
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161518,
					"content": "Então vamos juntos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161519
					]
				},
				{
					"id": 730161519,
					"content": "Sim. Vana está perigosa, é melhor viajar juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161520,
					"content": "Ainda tenho algo para fazer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
