					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arabalika",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730160301,
					"content": "Nara... E algo que voa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160302
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160302,
					"content": "#Sim, Paimon é Paimon, e Paimon sabe voar. {F#Ela}{M#Ele} é {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160303,
					"content": "Você deve ser Arabalika. Falando nisso, você não está com medo da gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160304,
					"content": "#Nara dourad{F#a}{M#o} tem o cheiro de Arapandu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160305
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160305,
					"content": "Ah, sim. Arapandu nos pediu para vir aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160306,
					"content": "Sem más intenções. Se vocês quisessem ferir Arabalika, teriam atacado quando bloco de ferro gigante ainda estava se movendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160307
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160307,
					"content": "Sim. Acho que isso é o que chamam \"bater em um Aranara quando ele está em perigo\"... Espere, não faremos nada assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160308,
					"content": "Por que não? Se eu fosse um inimigo, seria uma boa tática me flanquear. Até animais fazem isso quando caçam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160309
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160309,
					"content": "Bem, faz sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160310,
					"content": "Paimon está confusa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160311
					]
				},
				{
					"id": 730160311,
					"content": "... Enfim! Nós não vamos \"bater em um Aranara quando ele está em perigo\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160312,
					"content": "Porque os Aranaras são amigos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160313
					]
				},
				{
					"id": 730160313,
					"content": "#Sim, sim! É isso mesmo! Os Aranaras são amigos! Paimon e {NICKNAME} não farão nada contra seus amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160314,
					"content": "Hmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160315
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160315,
					"content": "Urgh... Por que Paimon está sentindo que ele está insatisfeito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160316,
						730160318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160316,
					"content": "Paimon não deu uma boa primeira impressão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160317
					]
				},
				{
					"id": 730160317,
					"content": "Mas Paimon não sente que tenha feito nada de errado! Argh... Esses Aranaras têm um temperamento muito estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160320,
					"content": "Oh, sim. Arapandu disse que o Ararakalari de Arabalika é muito forte. Com certeza o usou para derrotar esse Guarda das Ruínas. Que Ararakalari incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160321,
					"content": "Paimon, você sabe o que Ararakalari é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160322
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160322,
					"content": "... Oh, claro que sim! É... É aquele... Aquele poder muito... Muito incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160323,
					"content": "Hunf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160324
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160324,
					"content": "Uau! Paimon acha que ele está a desprezando de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160325,
					"content": "Vamos ao que interessa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160326
					]
				},
				{
					"id": 730160326,
					"content": "Sim... Nós viemos para ajudar a curar a Máquina Varuna! Há galhos e folhas da Máquina Varuna aqui, não é? Que tal Paimon dar uma olhada neles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160327,
					"content": "Que galhos e folhas? Você não quer dizer raízes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160328
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160328,
					"content": "Hã? Mesmo? Mas Arapandu disse que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160329,
					"content": "A Máquina Varuna obtém seu poder através do sistema de raízes espalhado pela terra de Vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160330
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160330,
					"content": "Oh... Isso faz sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160331,
					"content": "Além disso, as raízes são subterrâneas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160332
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160332,
					"content": "#Essas pedras e blocos de ferro daqui não pertencem aos Aranaras. Para descer, é necessário derrotar os Blocos de Ferro. Blocos de Ferro muito fortes, mas Nara dourad{F#a}{M#o} não é frac{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160333
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160333,
					"content": "#Claro que sim. {NICKNAME} já derrotou incontáveis blocos de ferro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160334,
					"content": "Oh? Então Arabalika quer ver o quão forte Nara é!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160335
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160335,
					"content": "Hã?! Por que ele se enterrou no chão? Ooh! Será que ele foi rumo ao Guarda das Ruínas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160336,
					"content": "#{NICKNAME}, vamos segui-lo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160318,
					"content": "Talvez ele seja assim com qualquer um.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160319
					]
				},
				{
					"id": 730160319,
					"content": "Como assim? Ele é fofinho, por que seu temperamento é tão ruim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160320
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301607,
			"completionStepIds": [
				7301607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301607",
							"2"
						],
						"stepId": 7301607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arabalika",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730160701,
					"content": "Derrotamos o grande bloco de ferro, agora só temos que deixar a água fluir e podemos ir ao subsolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160702
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160702,
					"content": "Faz muito tempo desde quando Lambarica veio aqui. Tudo está diferente, talvez hajam grandes blocos de ferro, posso sentir cheiro de ferro. Não é bom, temos que ter cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160703
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160703,
					"content": "#Nara {NICKNAME} é forte, não precisa ter preocupação. Mas Paimon é fraca como Aranakula. Tenha cuidado se Cogumelo quiser lhe comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160704
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160704,
					"content": "Urgh... Você que é muito forte, Arabalika! Nós já encontramos muitos Aranaras antes, e nenhum conseguiu derrotar um Guarda das Ruínas com um golpe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160705,
					"content": "Paimon sabe muito pouco sobre Aranara. Se for Aradasha, o enorme pedaço de ferro será finalizado em um piscar de olhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160706
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160706,
					"content": "O Ararakalari de Aradasha era muito poderoso no passado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160707
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160707,
					"content": "No passado? E agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160708,
					"content": "Agora? Aradasha não está no agora. Por isso que Arabalika deve treinar ainda mais o Ararakalari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160709
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160709,
					"content": "Se ao menos Paimon pudesse aprender Ararakalari também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160710,
						730160714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160710,
					"content": "Se você pudesse, Paimon, deixaria todas as batalhas com você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160711
					]
				},
				{
					"id": 730160711,
					"content": "#Hehe, deixe Paimon proteger {NICKNAME} em vez disso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160712,
					"content": "Conto com você, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160713
					]
				},
				{
					"id": 730160713,
					"content": "Deixe isso com Paimon! Pode deixar tudo com Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160718,
					"content": "Paimon adora sonhar, e não sabe se isso é uma coisa boa ou uma coisa ruim. Mas por ora precisamos encontrar o mecanismo de pedra para fazer a água fluir, caso contrário não vamos chegar ao subsolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160719
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160719,
					"content": "Aranaras conseguem se enterrar na terra, não na água.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160720
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160720,
					"content": "#Bem, {NICKNAME}, vamos dar uma olhadinha em volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160714,
					"content": "Paimon não vai conseguir aprender.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160715
					]
				},
				{
					"id": 730160715,
					"content": "Paimon consegue se Paimon tentar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160716,
					"content": "A maioria das pessoas que dizem isso são...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160717
					]
				},
				{
					"id": 730160717,
					"content": "Paimon devia pedir a Arabalika para ensinar Paimon depois que a gente comer e descansar em um local seguro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160718
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301610,
			"completionStepIds": [
				7301610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301610",
							"2"
						],
						"stepId": 7301610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arabalika"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730161001,
					"content": "Parece que está destruído? Não se move? Argh, assustou Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161002,
					"content": "Hmph! O que foi? É só um pedaço de ferro enferrujado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161003,
					"content": "Vana agora está muito perigosa. Tenha cuidado, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161004
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161004,
					"content": "Urgh... Arabalika é muito rigoroso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161005,
					"content": "Você que é muito descuidada, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161006
					]
				},
				{
					"id": 730161006,
					"content": "Sério? Então... Paimon vai ser rigorosa como Arabalika! Será que assim Paimon ficará forte como ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161007,
					"content": "Paimon, você deve ser rigorosa consigo mesma, não com os outros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161008
					]
				},
				{
					"id": 730161008,
					"content": "Certo, então Paimon passará a ser rigorosa com ela mesma!... A partir de amanhã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161009,
					"content": "Enfim, já que os galhos da pedra estão aqui, agora precisamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161010,
					"content": "Precisamos que as três pedras estejam viradas para essa direção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161011
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161011,
					"content": "... Ele tirou as palavras da boca de Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161012,
					"content": "Falando nisso, Arabalika não gosta de falar como os outros Aranaras. Ele não usa metáforas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161013,
						730161015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161013,
					"content": "Bem, é mais fácil de entender.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161014
					]
				},
				{
					"id": 730161014,
					"content": "É simples e direto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161017,
					"content": "Arapandu pensa muito, mas Arabalika pensa pouco. Arabalika só sabe como proteger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161018
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161018,
					"content": "Arapandu protegeu Vana com Nara Varuna. Eles juntos expulsaram a lama escura e curaram a Máquina Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161019
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161019,
					"content": "#Nara Varuna partiu de Vana. Talvez {F#ele}{M#ela} não retornará para o Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161020
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161020,
					"content": "#Arapandu deve saber. Já se passaram muitos anos. Tempo suficiente para uma semente entrar na árvore gigante. {F#O}{M#A} Nara que partiu de Vana nunca retornará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161021
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161021,
					"content": "Mas Arapandu quer curar a Máquina Varuna mais uma vez por Vana, pelo Festival Utsava, e pelo próximo Nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161022
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161022,
					"content": "Oh, então foi isso que aconteceu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161023
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161023,
					"content": "#Arabalika nunca conheceu Nara Varuna, mas o que {F#ele}{M#ela} fez é conhecido por toda Vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161024
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161024,
					"content": "Arabalika não pensa muito como Arapandu. Arabalika só sabe que deve se tornar mais forte para proteger os Aranaras e Vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161025
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161025,
					"content": "Nara Varuna não está mais aqui, mas os Aranaras ainda podem curar a Máquina Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161026
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161026,
					"content": "#Sim! {NICKNAME} e Paimon ajudarão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161027
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161027,
					"content": "#Algo está errado com o cheiro de ferro aqui dentro. Nara {NICKNAME}, Lambarica está contando com você, aguardarei aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161028
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161028,
					"content": "Paimon se pergunta o que Arabalika sentiu... Bem, Paimon tem certeza que os Aranaras sabem mais sobre a floresta do que nós!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161029,
					"content": "#Enfim, {NICKNAME}, vamos procurar por aqui pelas três folhas espalhadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161015,
					"content": "Ele não parece como os outros Aranaras...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161016
					]
				},
				{
					"id": 730161016,
					"content": "Bem, então o que seria \"parecer com um Aranara\"? Oh, não importa, Paimon não entende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161017
					],
					"speakerTitle": "Paimon"
				}
			]
		},
