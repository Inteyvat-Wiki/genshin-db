					"Raef"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330601,
					"content": "Você voltou, Viajante. Muito obrigado por ajudar... Como Nermin está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330602,
						732330605
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330602,
					"content": "Ela está preocupada se não conseguirá cuidar das flores.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330603
					]
				},
				{
					"id": 732330603,
					"content": "Bem... Eu vou ajudá-la com isso. Se tudo der errado, nós encontraremos alguém para pedir ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330604
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330604,
					"content": "E se até isso der errado... Eu só... vou procurar algo que seja fácil de cultivar e manter vivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330608,
					"content": "Bem, em todo caso, obrigado por ajudar, Viajante. Por favor, fique com isso como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330609
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330609,
					"content": "Eu vou enviar os outros itens para ela depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330610
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330610,
					"content": "Espere um pouco. Essas ferramentas de jardinagem não vem com manual de instruções?... Ah não. Eu não tenho ideia de como usá-las!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330605,
					"content": "Você nunca mandou flores para ela antes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330606
					]
				},
				{
					"id": 732330606,
					"content": "Bem, eu não diria exatamente isso, mas as que eu pedi que comprassem para ela já estavam crescidas. Quando elas chegaram na vila, já tinham murchado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330607
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330607,
					"content": "É por isso que eu decidi que enviaria um jarro de flores recém-plantadas para ela dessa vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "Raef"
				}
			]
		},
