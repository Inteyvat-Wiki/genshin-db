			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Azalai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330201,
					"content": "Hã, então havia mesmo outro lote...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330202
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330202,
					"content": "Sobre a mercadoria de Raef...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330203
					]
				},
				{
					"id": 732330203,
					"content": "Ah, você quer dizer as coisas que ele me encomendou? Bem, você está com sorte! O lote de mercadorias que acabei de receber estão com as coisas dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330204
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330204,
					"content": "Mas eu devo dizer, ele encomendou várias coisas. Você está aqui para pegar o pedido dele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330205,
						732330206
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330205,
					"content": "Eles são muito pesados?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330207
					]
				},
				{
					"id": 732330207,
					"content": "Bem, além do jarro, ele também encomendou várias sementes, fertilizante e outros artigos de jardinagem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330208
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330208,
					"content": "#Na verdade, é bastante coisa. Você tem certeza que vai ficar bem sozinh{M#o}{F#a}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330209,
						732330210
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330209,
					"content": "Eu dou o meu jeito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330211
					]
				},
				{
					"id": 732330211,
					"content": "Ah, então é isso... Está bem. Eu vou embalar tudo para você. Obrigado por fazer essa viagem, por falar nisso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330210,
					"content": "Eu de fato concordei em ajudar, então...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330211
					]
				},
				{
					"id": 732330206,
					"content": "Quanto ele encomendou...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330207
					]
				}
			]
		},
		{
			"id": 7323303,
