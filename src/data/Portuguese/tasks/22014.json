			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chef Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140201,
					"content": "Hã? Viajante? Que surpresa, veio comer algo de delicioso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140202
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140202,
					"content": "Gostaria que você me ensinasse algo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140203
					]
				},
				{
					"id": 220140203,
					"content": "Xudong foi para Inazuma para fazer um prato. Ele está muito determinado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140204
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140204,
					"content": "Você conhece ele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140205
					]
				},
				{
					"id": 220140205,
					"content": "No passado, nós competimos juntos em nossas habilidades culinárias... Pode-se dizer que somos Chefs equivalentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140206
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140206,
					"content": "Ele disse que queria viajar para todos os cantos do mundo para encontrar seu próprio progresso... Não imaginei que ele faria isso de verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140207
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140207,
					"content": "Mas parece que ele também encontrou um bloqueio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140208,
						220140210
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140208,
					"content": "Você saberia como resolver esse problema dele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140209
					]
				},
				{
					"id": 220140209,
					"content": "Não tenho certeza, mas posso tentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140214,
					"content": "Erva Marinha, Fungos Marítimos e Pétalas da Flor de Sakura? Quantos ingredientes estranhos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140215
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140215,
					"content": "Vendo somente essas Ervas Marinhas e Fungos Marítimos, consigo pensar em um prato... Mas ainda preciso de outros ingredientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140216
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140216,
					"content": "Viajante, você poderia trazer para mim algumas Pimentas de Jueyun e Carnes de Ave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140217,
						220140219
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140217,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140218
					]
				},
				{
					"id": 220140218,
					"content": "Muito obrigado. Depois que encontrar as Pimentas de Jueyun e Carnes de Ave, tragas-as para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140219,
					"content": "Ah, são os seus ingredientes tradicionais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140220
					]
				},
				{
					"id": 220140220,
					"content": "Hahaha, claro que sim. Esses ingredientes são confiáveis e versáteis. Depois de os pegar, traga para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140221
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140221,
					"content": "Mas, realmente não sei o que fazer com essas Pétalas da Flor de Sakura... Talvez os Chefs de Inazuma saibam como utilizá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140210,
					"content": "Talvez Xiangling saiba como resolver o problema dele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140211
					]
				},
				{
					"id": 220140211,
					"content": "A culinária dela sempre foi muito criativa. Talvez ela possa encontrar uma maneira de solucionar isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140212
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140212,
					"content": "Mas ela está na Vila Qingce colhendo Brotos de Bambu. Se quiserem encontrá-la, creio que tomará um certo tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140213
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140213,
					"content": "Xudong deve estar ansioso esperando por uma resposta. Talvez eu possa tentar resolver seu problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "Chef Mao"
				}
			]
		},
