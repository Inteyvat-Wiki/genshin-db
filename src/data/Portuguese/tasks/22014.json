			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140101,
					"content": "Viajante, hehe, nos encontramos de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140102,
						220140104
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140102,
					"content": "Precisa de ajuda com algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140103
					]
				},
				{
					"id": 220140103,
					"content": "Você se lembra que na última vez eu lhe prometi uma refeição? Estou preparando ela para você agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140106,
					"content": "Para fazer um bom prato, nós precisamos coletar ingredientes frescos de todos os lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140107,
					"content": "No momento, tenho quase todos os ingredientes. Estou pensando em como fazer a comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140108
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140108,
					"content": "Para onde Julie e Parvaneh foram?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140109
					]
				},
				{
					"id": 220140109,
					"content": "Parvaneh disse que queria continuar procurando outros ingredientes para fazer o seu \"Tempero Multiúso\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140110
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140110,
					"content": "Ela puxou Julie para ir junto com ela... Elas disseram que não iriam muito longe, não precisa se preocupar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140111
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140111,
					"content": "Mas eu posso acabar precisando de sua ajuda. Apesar de ter coletado muitos ingredientes frescos de Inazuma, eu ainda sinto que está faltando algo... Algo com uma inspiração para uma ruptura radical...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140112
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140112,
					"content": "Dê uma olhada, tenho Erva Marinha, Fungos Marítimos e as Pétalas da Flor de Sakura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140113
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140113,
					"content": "Mesmo tendo todos esses ingredientes frescos, não tenho nenhuma ideia do que fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140114,
					"content": "Originalmente eu queria pedir conselhos a algum chef local de Inazuma, mas depois pensei que, se fizesse isso, o que eu cozinhasse meramente seria uma culinária comum de Inazuma, não teria nenhuma ideia nova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140115,
					"content": "Por isso que quero usar o raciocínio de um chef de Liyue ao utilizar esses ingredientes de Inazuma. Dessa maneira, talvez possa fazer alguma comida nova boa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140116
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140116,
					"content": "Viajante, você poderia ir até Liyue por mim e perguntar a opinião do Chef Mao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140117,
						220140119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140117,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140118
					]
				},
				{
					"id": 220140118,
					"content": "Muito obrigado. Estarei esperando por você aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140124,
					"content": "Espero que o Chef Mao tenha alguma boa ideia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140119,
					"content": "Você está procurando por um bum shaka-laka, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140120
					]
				},
				{
					"id": 220140120,
					"content": "Bum shaka-laka? Você quer dizer o sabor de alguma comida que deixa as pessoas surpresas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140121
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140121,
					"content": "Se conseguir encontrar alguma receita assim, então ótimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140122
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140122,
					"content": "Mas não conheço nenhuma pessoa que pensaria numa receita como essa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140123
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140123,
					"content": "Enfim, por favor, peça a ajuda do Chef Mao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140104,
					"content": "Você está fazendo uma refeição para mim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140105
					]
				},
				{
					"id": 220140105,
					"content": "Hahaha, para quem mais eu estaria fazendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2201402,
			"completionStepIds": [
				2201402
