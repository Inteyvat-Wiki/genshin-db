			"dialogs": [
				{
					"id": 220140601,
					"content": "Esse Broto de Bambu daqui está ótimo. Vou cavar um pouco e levar ele de volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140602
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140602,
					"content": "Hã? Viajante, é você! Como que você está aqui? Quer comer algo delicioso de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140603,
						220140604
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140603,
					"content": "Gostaria de pedir sua ajuda com algo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140607
					]
				},
				{
					"id": 220140607,
					"content": "Usar as técnicas de Liyue para cozinhar os ingredientes de Inazuma... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140608
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140608,
					"content": "Hehe, vocês vieram perguntar à pessoa certa. Eu ouvi dizer que em Inazuma existe uma técnica de cobrir os ingredientes com farinha e fritá-los em óleo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140609
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140609,
					"content": "Todas as coisas feitas dessa maneira são chamadas de Tempura, e claro, elas sempre vêm com um molho especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140610
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140610,
					"content": "Quando eu tentei fazer Tempura, fiquem muito interessada nesse molho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140615
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140615,
					"content": "E olhe que eu já experimentei muitos, como Néctar Ardente da Flor Gigante, ou Flores Flamejantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140611
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140611,
					"content": "E quanto ao Condensado de Slime?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140612
					]
				},
				{
					"id": 220140612,
					"content": "Não tem. Não combina usar Condensado de Slime nesse prato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140616
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140616,
					"content": "Também já usei as asas dos Cicin Electro para fazer um pó. Adicionar ele aumenta o grau do sabor ainda mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140613
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140613,
					"content": "Se eu explicar assim, vocês com certeza não se lembrarão. Deixe-me anotar num papel, e então vocês podem levá-lo para Xudong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140614
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140614,
					"content": "*Suspiro* Eu também gostaria de ir para Inazuma, lá com certeza deve ter muitos ingredientes que nunca experimentei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140604,
					"content": "A reação dela e do Chef Mao é igual...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140605
					]
				},
				{
					"id": 220140605,
					"content": "Você deveria ir para o Restaurante. Mas, você não está com cara de quem quer comer alguma coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140606
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140606,
					"content": "Oh, será que você encontrou algum problema culinário?",
