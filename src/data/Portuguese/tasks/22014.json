			"dialogs": [
				{
					"id": 220140401,
					"content": "Esses devem ser suficientes. Esperem um pouco, pensarei no que fazer com eles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140402
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140402,
					"content": "Pronto. Mas não acho que está muito diferente da comida que costumo fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140403
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140403,
					"content": "Levem isso para Xudong. Espero que essa comida possa ajudá-lo a resolver esse problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef Mao"
