			"dialogs": [
				{
					"id": 741850101,
					"content": "Este, voltamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850102,
					"content": "Oh, são vocês... Espera aí, quem são vocês?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850103
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850103,
					"content": "#Hã? Não tem como você não conhecer a gente. Somos {NICKNAME} e Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850104,
					"content": "#{NICKNAME} e Paimon... Realmente ouvi contos sobre esses nomes, mas eu podia jurar que tinha ouvido sobre eles em um sonho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850105
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850105,
					"content": "Uh... Mas você estava definitivamente acordado, Este! Além disso, enquanto estávamos lá embaixo, não vimos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850106,
					"content": "*Suspira* Eu sonhei que todos na cidade estavam petrificados, transformados em estátuas de pedra, me deixando completamente impotente e sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850107
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850107,
					"content": "#Até que finalmente, {M#dois grandes heróis}{F#duas grandes heroínas} assumiram a responsabilidade de salvar todo mundo... Será que, não era um sonho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850108,
						741850109
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850108,
					"content": "Talvez, talvez não.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				},
				{
					"id": 741850110,
					"content": "É. Afinal de contas, todo mundo voltou ao normal agora, não foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850111,
					"content": "Mas parece que todo mundo realmente teve alguns sonhos estranhos. O que aconteceu? Será que fomos todos hipnotizados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850112
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850112,
					"content": "Levaria décadas para a gente explicar tudo direito... apenas esqueça sobre esse papo de hipnose por ora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850113,
					"content": "Oh? Falando em hipnose, vocês até trouxeram um gato! Ele parece bem inteligente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850114,
						741850116
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850114,
					"content": "Ele é ainda mais inteligente do que parece.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850115
					]
				},
				{
					"id": 741850115,
					"content": "E, além disso, ele é nosso companheiro! Mas infelizmente, não podemos levar ele em nossa jornada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850118,
					"content": "Ora, isso não é uma coincidência? Por um acaso nosso clube tem uma cama de gato disponível. Está desocupada desde que aquele pesquisador de hipnose saiu em uma viagem e levou seu gato com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850119
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850119,
					"content": "Se vocês não se importarem, deixem ele aqui conosco. Cuidaremos bem dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850120
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850120,
					"content": "Embora eu não consiga dizer exatamente, sinto como se estivéssemos unidos, quase como se pelo destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850121
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850121,
					"content": "A casa de gato está do outro lado da construção. Apenas dê uma caminhada e você vai ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Este"
				},
				{
					"id": 741850116,
					"content": "Ele é nosso companheiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850117
					]
				},
				{
					"id": 741850117,
					"content": "Isso é verdade, mas mesmo assim, não podemos levar ele conosco em nossa jornada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850109,
					"content": "Isso não importa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				}
			]
		},
