				},
				{
					"id": 731040411,
					"content": "Isso é um elogio? Porque não me deixa feliz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040412
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040412,
					"content": "Certo, recuperamos a primeira relíquia, agora nosso próximo alvo é... a oeste, não muito longe daqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
