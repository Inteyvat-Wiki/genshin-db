						731041204
					]
				},
				{
					"id": 731041204,
					"content": "Um terceiro pacote encharcado é puxado para fora da água pela linha depois de um tempo.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731041205
					]
				},
				{
					"id": 731041205,
					"content": "Veja você mesmo, não quero olhar para isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041206
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041206,
					"content": "Certo, deixe-me dar uma olhada... Bom, está intacto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041207
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041207,
					"content": "É perfeito, Sr. Kayvan! \"O Anzol Supremo\" fez o seu trabalho novamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041208
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041208,
					"content": "Ha...haha, bem...desde que você consiga o que quer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041209
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041209,
					"content": "Três pacotes com três anzóis... mas nenhum peixe pego...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041210,
						731041211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731041210,
					"content": "É isso que torna o Sr. Kayvan tão impressionante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731041212
					]
				},
				{
					"id": 731041212,
					"content": "Escuta aqui! Eu nunca quis ir pescar relíquias! Tudo que eu quero é pegar um bom peixão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041213
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041213,
					"content": "Pode dizer que sou ruim de pesca ou que seja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041214
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041214,
					"content": "Isso é muito azar! Até mesmo alguém com a pior sorte já teria pego algum peixe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041215
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041215,
					"content": "Nem um único peixe! Eu não peguei um único peixe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041216
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041216,
					"content": "Hmm... agora que você mencionou, é meio estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731041217,
					"content": "Hmm... Sr. Kayvan, se estiver interessado, posso apresentá-lo a um pesquisador de pesca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041218
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041218,
					"content": "Ele trabalhou nos designs das iscas e varas de pesca mais populares da atualidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041219
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041219,
					"content": "Não sei por que ele não conseguiu pegar um único peixe, mas... perguntar a um especialista não pode fazer mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041220
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041220,
					"content": "Talvez ele fique interessado em você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041221
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041221,
					"content": "Quer dizer que ele vai se interessar em saber como é que esse pescador \"pega tudo\" menos peixe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041222
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041222,
					"content": "Bem, você está certa. Posso aproveitar esta oportunidade para descobrir o que há de errado com minha técnica de pesca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041223
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041223,
					"content": "Ótimo! Pode deixar comigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041224
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041224,
					"content": "Mas esses pesquisadores que vivem com a cara nos livros sabem mesmo sobre pesca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041225
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041225,
					"content": "Oh, eu quase esqueci! Obrigado pela ajuda, Viajante. Aqui está seu pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041211,
					"content": "Esse com certeza é único, parece...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731041212
					]
				}
			]
		},
