				"points": []
			},
			"dialogs": [
				{
					"id": 731040901,
					"content": "#Vocês são {M#bons}{F#boas} mesmo! Muito obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040902
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040902,
					"content": "Quando recuperarmos todas as relíquias, vou solicitar um pouco mais de dinheiro para recompensá-los por toda a ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040903
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040903,
					"content": "Você não acredita que eu posso pegar um peixe de verdade, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040904
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040904,
					"content": "Espere, você fisgou algo grande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040905
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040905,
					"content": "Kayvan levantou a vara de pesca com força...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040906
					]
				},
				{
					"id": 731040906,
					"content": "O que... o que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040907
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040907,
					"content": "Oh! É mais um dos pacotes de relíquias! Excelente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040908
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040908,
					"content": "Não achei que ia dar tão certo, já recuperamos duas relíquias! Que pegada, Sr. Kayvan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040909
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040909,
					"content": "Eu não deveria ter dito isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040910
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040910,
					"content": "Há muitos peixes no rio, mas não há tantas relíquias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040911
					]
				},
				{
					"id": 731040911,
					"content": "Mas eu não peguei um único peixe até agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040912
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040912,
					"content": "Veja pelo lado positivo Recuperamos as relíquias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040913,
					"content": "Nosso local de pesca fica perto da Vila Vimara, é muito mais seguro lá, vamos nos apressar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040914
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040914,
					"content": "Sim, sim, que seja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040915
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040915,
					"content": "Isto é tão estranho. Não sei se é minha técnica de pesca, ou se não estou usando as iscas certas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040916
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040916,
					"content": "Deixa para lá. Viajante, por favor, traga alguns Pêssegos Zaytun para mim desta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040917
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040917,
					"content": "Já que é o último local, vou usar minha isca especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040918
					],
					"speakerTitle": "Kayvan"
				},
				{
