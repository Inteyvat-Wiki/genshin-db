					"id": 731040413,
					"content": "Vamos nessa. Quanto antes terminar e voltar a pegar peixes em paz, melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040414
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040414,
					"content": "Sem problemas, por favor siga-me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040415
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040415,
					"content": "Viajante, vamos trocar o material agora por Fruta Harra, meu sexto sentido me diz que é o mais adequado para usar desta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040416
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040416,
					"content": "Eu conheço um lugar que tem as melhores Frutas Harra. Eu vou te mostrar a localização.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040417
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040417,
					"content": "Iremos em direção ao local, nos vemos no próximo ponto de pesca.",
