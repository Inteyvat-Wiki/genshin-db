			"dialogs": [
				{
					"id": 223070801,
					"content": "Aliás, você entende esses Mapas do Tesouro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070802
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070802,
					"content": "Não vou mentir, quando eu tinha conseguido pegá-los, chamei algumas pessoas para darem uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070803
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070803,
					"content": "Eles descobriram mais ou menos onde está o tesouro. Mas eles disseram que se eu fosse procurar o tesouro, deveria pagar uma taxa extra... É por isso que nunca pensei em ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070804
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070804,
					"content": "Se você economizar tempo, posso marcar o local para você, sem problemas. Apenas diga a palavra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070805
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070805,
					"content": "Mas você sabe, eu preciso cobrar uma taxa... Que tal <color=#00E1FFFF>100 Mora</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070806
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070806,
					"content": "O que você acha? Posso <color=#00E1FFFF>marcar a localização</color> do tesouro no mapa para você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
