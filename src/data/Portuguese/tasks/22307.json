			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhangshun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223070101,
					"content": "O que eu posso fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070102
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070103
					]
				},
				{
					"id": 223070103,
					"content": "Eu costumava ser um marinheiro da Frota Crux até sofrer um acidente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070104
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070104,
					"content": "Depois de deixar a frota, eu precisava de dinheiro, então penhorei alguns Mapas do Tesouro. Eu os entreguei ao empresário local Bolai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070105
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070105,
					"content": "O acordo era que eu receberia uma parte de qualquer tesouro encontrado, mas não ouvi uma palavra dele desde então, e suspeito que ele nem sequer tentou procurar o tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070106
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070106,
					"content": "Não podemos continuar assim. Você está disposto a me ajudar a encontrar o tesouro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070107,
						223070109,
						223070116
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070107,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070108
					]
				},
				{
					"id": 223070108,
					"content": "Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070120
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070120,
					"content": "Comece com uma visita para <color=#00E1FFFF>Bolai</color> para pegar os <color=#00E1FFFF>Mapas do Tesouro</color>. Então, <color=#00E1FFFF>encontre</color> os tesouros e <color=#00E1FFFF>leve-os até ele</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070121
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070121,
					"content": "Eu já falei com ele, ele vai guardar a minha parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070109,
					"content": "O que fez você deixar a frota?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070110
					]
				},
				{
					"id": 223070110,
					"content": "Eu percebi que o meu último ferimento podia voltar a piorar e causar problemas de verdade. Eu não podia deixar que isso causasse problemas a minha frota, por isso escolhi sair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070111
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070111,
					"content": "Então, montei um pequeno negócio de loja de bicicletas para ganhar a vida, mas não é fácil, e estou quase ficando sem produtos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070112
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070112,
					"content": "Eu tinha alguns Mapas do Tesouro. Peguei-os uma vez em um dia que estava com a tripulação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070113
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070113,
					"content": "Mas nas condições que eu me encontro, mal consigo caminhar, como que posso ir à procura dos tesouros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070114
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070114,
					"content": "Então eu peguei e os entreguei a Bolai em troca de um pouco de dinheiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070115
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070115,
					"content": "Mas parece que ele também não pode procurar pelo tesouro por conta própria. Afinal de contas, ele é apenas um empresário... Então, é por isso que preciso da sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070107,
						223070116
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070116,
					"content": "Realmente existe um grande tesouro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070117
					]
				},
				{
					"id": 223070117,
					"content": "Hahaha, não deve ser de grande valor. Estes são apenas pequenos pedaços de mapas do tesouro divididos entre os membros da tripulação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070118
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070118,
					"content": "A tripulação experiente da frota sempre pode dizer quando há uma quantidade séria de tesouros envolvidos, e eles o rastrearão e o trarão de volta ao navio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070119
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070119,
					"content": "Qualquer tesouro que encontrarmos será de pouco valor, mas com certeza valerá alguma coisa. De certeza dará para ser dividido em três partes... Então, boa sorte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070120
					],
					"speakerTitle": "Zhangshun"
				}
			]
		},
