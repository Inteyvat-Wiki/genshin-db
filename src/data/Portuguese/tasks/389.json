			"dialogs": [
				{
					"id": 3890601,
					"content": "Não podemos chegar mais longe. As ruínas parecem ser protegidas por <color=#00E1FFFF>selos</color> antigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890602,
					"content": "Foi o Dvalin que fez isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3890603,
					"content": "Não. Essas ruínas fizeram parte de uma cidade antiga. Dvalin deve estar apenas morando aqui por enquanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890604
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890604,
					"content": "Essas ruínas são ainda mais antigas que os Quatro Ventos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890605
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890605,
					"content": "Mondstadt é uma cidade sem um governador. Porém, antigamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890606
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890606,
					"content": "Foi governado por um tirano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890607,
					"content": "Enfim... Eu vou contar a história quando tivermos mais tempo outra hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890608,
					"content": "As marcas neste selo... Se eu não estiver enganado, parece ser um <color=#00E1FFFF>Atuador de Luz</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890609
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3890609,
					"content": "Se nós colocarmos de volta as <color=#00E1FFFF>partes que estão faltando</color> no <color=#00E1FFFF>corpo</color> do dispositivo, poderemos realizar uma <color=#00E1FFFF>cerimônia</color> de luzes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890610
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3890610,
					"content": "Este atuador não parece muito longe de estar pronto para uma Cerimônia de Luzes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890611
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3890611,
					"content": "Vamos colocar a <color=#00E1FFFF>última parte</color> de volta e veremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		}
