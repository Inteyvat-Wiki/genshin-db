					}
				]
			},
			"dialogs": [
				{
					"id": 746960101,
					"content": "Você se lembrou, Qiqi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960102
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960102,
					"content": "Oh... Uhm... Me desculpe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960103
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960103,
					"content": "Não precisa se desculpar, tudo bem. Ainda temos um bom caminho até Palais Mermonia. Vamos continuar andando — quem sabe você não se lembra onde fica a sua casa pelo caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960104
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960104,
					"content": "#{NICKNAME}, olha! É a Qiqi! E tem uma Melusine também. Que combinação inusitada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960105,
					"content": "#Ah! {NICKNAME}, e... Pai... Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960106
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960106,
					"content": "Olá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960107
					]
				},
				{
					"id": 746960107,
					"content": "Você conhece a Qiqi? Que notícia fantástica! Encontrei com ela enquanto investigava perto do Porto Lumidouce... Pelo tamanho dela, imaginei que fosse uma criança humana... Ela é uma criança, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960108
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960108,
					"content": "Eu sou... sou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960109
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960109,
					"content": "Nossa boa amiga!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960110
					]
				},
				{
					"id": 746960110,
					"content": "Isso, isso! Nós nos conhecemos há muito tempo. Somos melhores amigas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960111,
					"content": "Hehe! Pensou rápido! Se a Qiqi dissesse que era uma zumbi, talvez tivesse assustado aquela Melusine até a morte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960112,
					"content": "Sim... Melhores... amigas... Isso mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960113
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960113,
					"content": "Bem, isto certamente é uma feliz coincidência. Para ser sincera, é a primeira vez que me vejo completamente sem saber o que fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960114
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960114,
					"content": "Imagino que saiba dos problemas de memória dela? Ela mal parece se lembrar de qualquer coisa além do próprio nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960115
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960115,
					"content": "A Qiqi fica assim às vezes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960116,
					"content": "Pobre criança. Eu ia levá-la de volta ao Marechalato Fantasma e deixá-la ficar lá por um tempo, mas esperava que ela pudesse recuperar algumas memórias pelo caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960117
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960117,
					"content": "#Já que vocês são amig{F#as tão próximas}{M#os tão próximos}, imagino que saibam onde ela mora? Pouparia bastante trabalho se eu pudesse levá-la direto para casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960118
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960118,
					"content": "Nós sabemos... Mas fica, hum, muito longe daqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960119,
					"content": "Muito... longe...? Eu segui uma Seelie até o Porto Lumidouce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960120
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960120,
					"content": "Hã? Você lembrou de algo? O que aconteceu antes disso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960121
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960121,
					"content": "Antes... disso... O Dr. Baizhu me levou em suas visitas em Yi... Hum, Yi-alguma-coisa... Fui coletar ervas, e então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960122
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960122,
					"content": "Ah! O Baizhu te levou ao Porto Yilong, não foi? A Detetive Paimon acha que sabe o que aconteceu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960123,
					"content": "Baizhu levou Qiqi para fazer visitas médicas em Porto Yilong, e quando Qiqi foi coletar ervas por lá, acabou se perdendo. Aí ela encontrou um Seelie por acaso e foi seguindo ele até chegar em Porto Lumidouce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960124,
					"content": "#Hmpf, ainda bem que Paimon assistiu O Detetive e o Ladrão com {NICKNAME}! Um raciocínio tão simples assim não vai derrubar Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960125,
					"content": "Na verdade, aquela história era completamente fictícia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960126
					]
				},
				{
					"id": 746960126,
					"content": "Ahá! Bem, faz sentido! Vou levar a Qiqi de volta para o Porto Yilong agora mesmo. O Dr. Baizhu é o guardião da Qiqi, não é? Ele deve estar morto de preocupação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960127,
						746960128
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960127,
					"content": "Espere... Aquelas pessoas da profecia da Barbeloth...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960129
					]
				},
				{
					"id": 746960129,
					"content": "Ah, é mesmo! Paimon quase se esqueceu disso. Barbeloth, você está aí? Consegue nos ouvir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960130,
					"content": "Não precisa gritar. Estive aqui o tempo todo. Eu só não queria interromper sua conversa. Ouvir é o estado padrão de qualquer boa vidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960131
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960131,
					"content": "Essa tal de orientação dos Seelies também pode ser considerada uma orientação do destino. Hehehe, já que você está aqui, Qiqi, por que não deixa eu ler a sua sorte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960132
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960132,
					"content": "Sor...te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960133
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960133,
					"content": "Ah, querida Barbie, deixe-me intervir. Você não sabe falar com crianças. Está assustando a coitada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960134
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960134,
					"content": "Deixe eu cuidar disso. Escute bem, é assim que você faz uma surpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960135
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960135,
					"content": "Ahem, pequena Qiqi, membro da Sociedade das Feiticeirazinhas, eu sou a mãe de sua aliada Klee, a maior feiticeira do mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960136
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960136,
					"content": "É um prazer te conhecer, tia Alice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960137
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960137,
					"content": "Ora, você é uma criança doce e muito educada. Venha, a amiga da sua tia, outra grande feiticeira, vai te fazer uma festa surpresa maravilhosa para adivinhar a sua sorte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960138
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960138,
					"content": "Uma festa para adivinhar minha sorte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960139
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960139,
					"content": "Isso mesmo! Olhe para essas cartas na sua frente. Não são lindas? Você gosta delas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960140
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960140,
					"content": "Eu... gosto delas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960141
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960141,
					"content": "Que maravilha! Agora, você pode escolher uma para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960142
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960142,
					"content": "Hã... Pode ser essa aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960143
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960143,
					"content": "Claro. E já que você se comportou tão bem, pode ficar com ela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960144
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960144,
					"content": "...Obrigada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960145
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960145,
					"content": "Certo, Barbie, o intervalo acabou. Venha ajudar a pequena Qiqi com a leitura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960146
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960146,
					"content": "Não precisa me sacudir para eu acordar. Eu ouvi tudo. Ah, sim, O Enforcado para cima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960147
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960147,
					"content": "Poucas pessoas tiram essa carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960148
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960148,
					"content": "Isso significa que você é muito especial, Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960149
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960149,
					"content": "Ela simboliza transcendência e espera, assim como distanciamento do mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960150
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960150,
					"content": "Existem correntes que te prendem, mas você não tem desejo de se libertar delas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960151
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960151,
					"content": "Correntes... Você quer dizer... minhas ordens?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960152
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960152,
					"content": "Pelo menos superficialmente, você não estaria errada em entender dessa forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960153
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960153,
					"content": "Quanto ao seu futuro, tudo que você precisa fazer é esperar. Claro, o que não te falta é tempo, mas... Oh, que estranho, muito estranho mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960154
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960154,
					"content": "Espera aí! Você tá dizendo muita coisa de uma vez só. Dê um tempo para essa menina respirar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960155
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960155,
					"content": "Deixe a Qiqi apreciar seu presentinho primeiro. Você precisa ter um pouco mais de paciência com crianças, dar mais tempo para elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960156
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960156,
					"content": "O que você achou, Qiqi? Gostou da surpresa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960157
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960157,
					"content": "Essa carta é muito bonita... Obrigada, tia Alice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960158
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960158,
					"content": "Ah, boa menina! Ótimo trabalho ao lembrar do nome da titia! Titia adoraria conversar mais, mas é hora dela ir para casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960159
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960159,
					"content": "Se tia Barbie tem algo mais para dizer, então, na próxima vez que a Sociedade das Feiticeirazinhas se encontrar, ela pode fazer uma profecia para todas as Feiticeirazinhas que participarem! Assim todo mundo vai ficar feliz!",
