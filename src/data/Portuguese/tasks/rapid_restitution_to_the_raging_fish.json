			"dialogs": [
				{
					"id": 747110101,
					"content": "Aha! Tudo está indo perfeitamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110102,
					"content": "Estou convencido de que nossa busca por uma cura está entrando em sua fase final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110103,
					"content": "Além de encontrar mais alguns pacientes aquáticos para completar a lista, tenho outro pedido especial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110104,
					"content": "Preciso que você localize alguns mecanismos subaquáticos-chave nas águas afetadas e recupere os dados registrados pelos sensores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110105,
						747110106
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110105,
					"content": "Aí analisar os dados para encontrar padrões correspondentes...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				},
				{
					"id": 747110107,
					"content": "Exatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110108,
					"content": "Também precisamos conversar com os donos dos barcos e os mergulhadores para garantir que aprenderam a lição!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747110109,
					"content": "Isso mesmo, sem falar nos pescadores e turistas... Qualquer pessoa que saia de barco na superfície, e aqueles que mergulham por baixo dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110110,
					"content": "Todos que interagem com nossas águas precisam ter consciência — não podem simplesmente jogar coisas no mar e sair por aí destruindo habitats marinhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110111,
					"content": "Caso contrário, alguns peixes bem agressivos podem aparecer e virar os barcos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110106,
					"content": "Para a gente poder prevenir incidentes similares no futuro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				}
			]
		}
	]
