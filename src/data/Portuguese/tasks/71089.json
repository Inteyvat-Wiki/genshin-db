				"points": []
			},
			"dialogs": [
				{
					"id": 710890101,
					"content": "Oh, que carta longa. É de Zhiqiong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710890102,
					"content": "Isso mesmo, é uma carta dela...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890103
					]
				},
				{
					"id": 710890103,
					"content": "Oh não, nós não a encontramos. Vamos voltar e falar com Jinwu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7108902,
			"completionStepIds": [
				7108903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108903",
