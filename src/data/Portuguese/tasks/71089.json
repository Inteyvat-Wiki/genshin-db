			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710890201,
					"content": "Jinwu, nós encontramos isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710890202,
					"content": "#Certo, tudo bem, não fiquem nervos{F#as}{M#os}. O que vocês encontraram? Alguma pista de Zhiqiong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890203
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890203,
					"content": "Isso é uma carta que ela deixou. Ela foi para as profundezas do Despenhadeiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890204
					]
				},
				{
					"id": 710890204,
					"content": "... Obrigada. Por favor, deixem-me ver o que ela escreveu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890205
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890205,
					"content": "Jinwu lê a carta de Zhiqiong detalhadamente.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710890206
					]
				},
				{
					"id": 710890206,
					"content": "Essa garota... Eu nunca pensei em um problema tão grande, e também não avaliei bem sua escolha, mas talvez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890207
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890207,
					"content": "Talvez eu não tenha dado importância devida a sua descoberta. Não lhe respeitei e entendi o bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890208
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890208,
					"content": "Sem o mapa dela, será difícil completar a exploração... Mas eu fiquei tão preocupada com ela que acabei ignorando seu esforço e seus feitos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890209
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890209,
					"content": "Afinal, ela é diferente de nós mineradores... Como não pensei nisso antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890210
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890210,
					"content": "Ela só não quer ser esquecida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890211
					]
				},
				{
					"id": 710890211,
					"content": "Oh, mas para nós que não fomos favorecidos pelos arcontes, quem não quereria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890212
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890212,
					"content": "Quem não quereria mesmo... Mas alguém além dela já foi tão obcecado assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890213
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890213,
					"content": "Entretanto, quando penso no momento que desisti de me tornar em alguém grande... Foi aí que percebi que me acostumei a viver dia após dia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890214
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890214,
					"content": "Eu acho que não tenho direito de julgar Zhiqiong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		}
	]
}