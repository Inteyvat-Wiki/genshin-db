			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7907001",
							"2"
						],
						"stepId": 7907001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Saborin",
					"Souffache",
					"Ameixa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700101,
					"content": "Vossa Excelência. Eu te dou as boas-vindas em nome do Reino das Brisas e Sinos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700102
					],
					"speakerTitle": "Ameixa"
				},
				{
					"id": 790700102,
					"content": "O que vocês vão fazer agora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700103
					]
				},
				{
					"id": 790700103,
					"content": "Hmm... Bem, primeiro de tudo, eu anunciarei à floresta inteira que a relíquia tomou sua decisão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700104
					],
					"speakerTitle": "Ameixa"
				},
				{
					"id": 790700104,
					"content": "E que o Guardião... será o Sr. Flaubert, aquele que veio de longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700105
					],
					"speakerTitle": "Ameixa"
				},
				{
					"id": 790700105,
					"content": "Hã?! Por que você faria isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700106,
					"content": "Tentar explicar tudo que passamos seria complicado demais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700107
					],
					"speakerTitle": "Ameixa"
				},
				{
					"id": 790700107,
					"content": "Além disso, demoraria muito para eles entenderem o conceito de eu ser tanto a princesa e uma Guardiã ao mesmo tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700108
					],
					"speakerTitle": "Ameixa"
				},
				{
					"id": 790700108,
					"content": "Quando for a hora certa, farei um registro detalhado de tudo que aconteceu, então informarei meu povo por escrito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700109
					],
					"speakerTitle": "Ameixa"
				},
				{
					"id": 790700109,
					"content": "Mas até lá, eu ainda presidiarei sobre todos os assuntos do reino como \"Princesa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700110
					],
					"speakerTitle": "Ameixa"
				},
				{
					"id": 790700110,
					"content": "Quando aqueles \"campos de julgamento\" forem oficialmente convertidos em \"campos de treino\" eu partirei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700111,
						790700112
					],
					"speakerTitle": "Ameixa"
				},
				{
					"id": 790700111,
					"content": "Partir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				},
				{
					"id": 790700113,
					"content": "Vossa Alteza, você ainda se lembra... para quem a relíquia realmente acendeu naquela caverna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700114
					],
					"speakerTitle": "Flaubert"
				},
				{
					"id": 790700114,
					"content": "Hã? Para quem... ela realmente acendeu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700115
					],
					"speakerTitle": "Ameixa"
				},
				{
					"id": 790700115,
					"content": "Sim, já que estávamos ambos próximos na hora. Claro, Vossa Alteza merece ser totalmente reconhecida, mas eu, por outro lado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700116
					],
					"speakerTitle": "Flaubert"
				},
				{
					"id": 790700116,
					"content": "Você é um campeão reconhecido por um campeão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700117
					]
				},
				{
					"id": 790700117,
					"content": "Exatamente, e aquele campeão veio especificamente pedir pela sua ajuda! Como você ainda pode achar que não é digno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700118,
					"content": "*Suspiro* Talvez seja simplesmente que você, Vossa Alteza, brilha tão brilhantemente que vocês todos estavam enganados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700119
					],
					"speakerTitle": "Flaubert"
				},
				{
					"id": 790700119,
					"content": "Pfff... Bem então, Sr. Campeão, estaria disposto a passar por outro julgamento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700120
					],
					"speakerTitle": "Ameixa"
				},
				{
					"id": 790700120,
					"content": "Eu, Princesa Ameixa do Reino das Brisas e Sinos, irei pessoalmente testemunhar seus feitos com essa relíquia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700121
					],
					"speakerTitle": "Ameixa"
				},
				{
					"id": 790700121,
					"content": "É claro! Aceito, aceito, aceito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700122,
						790700123
					],
					"speakerTitle": "Flaubert"
				},
				{
					"id": 790700122,
					"content": "Espera aí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700124,
					"content": "Ele fica tão animado sempre que ouve o nome da princesa. Hehe, Flaubert...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700125,
					"content": "Não me entenda errado! E-Eu estou fazendo isso para cumprir a missão da Lagoa da Canção da Chuva! Todo aquele treinamento que fiz, foi tudo para salvar... Uhh, digo, proteger Vossa Alteza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700126
					],
					"speakerTitle": "Flaubert"
				},
				{
					"id": 790700126,
					"content": "É uma tarefa tão importante, então naturalmente preciso garantir que tudo saia sem problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700127
					],
					"speakerTitle": "Flaubert"
				},
				{
					"id": 790700127,
					"content": "Você estaria disposto a viajar junto de Vossa Alteza?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700128
					]
				},
				{
					"id": 790700128,
					"content": "C-Claro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700129
					],
					"speakerTitle": "Flaubert"
				},
				{
					"id": 790700129,
					"content": "Hehe, isso é bom de ouvir. Bem, então, Sr. \"Campeão\" Flaubert, você está pronto para o meu julgamento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700130
					],
					"speakerTitle": "Ameixa"
				},
				{
					"id": 790700130,
					"content": "Estou, Vossa Alteza! Assim que você estiver pronta, eu estarei pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700131
					],
					"speakerTitle": "Flaubert"
				},
				{
					"id": 790700131,
					"content": "Uau! A relíquia acendeu de novo, e está tão brilhante desta vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700123,
					"content": "Minhas orelhas... elas queimam!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700112,
					"content": "O que você vai fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				}
			]
		},
		{
			"id": 7907002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7907001",
							"3"
						],
						"stepId": 7907001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flaubert",
					"Aurel",
					"Estampes"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700201,
					"content": "Estampes! Onde você estava?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700202
					],
					"speakerTitle": "Flaubert"
				},
				{
					"id": 790700202,
					"content": "Uhh, na verdade, eu estava andando pela área e experimentei aquele julgamento. Foi divertido, mas eu tive que adotar uma abordagem ligeiramente diferente para passar nele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700203
					],
					"speakerTitle": "Estampes"
				},
				{
					"id": 790700203,
					"content": "Sr. Aurel me deixou a par de tudo que aconteceu com vocês. Nada mal, Sr. Guardião. Acontece que você é mesmo bem talentoso, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700204
					],
					"speakerTitle": "Estampes"
				},
				{
					"id": 790700204,
					"content": "S-S-Seu... Se você estivesse de pé perto de mim, eu teria te empurrado, pode ter certeza! Eu teria te empurrado dez vezes se tivesse a chance!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700205
					],
					"speakerTitle": "Flaubert"
				},
				{
					"id": 790700205,
					"content": "É por isso que decidi participar no julgamento ao invés disso. Flaubert, meu amigo, eu sempre acreditei que você ia conseguir. E olha... você conseguiu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700206
					],
					"speakerTitle": "Estampes"
				},
				{
					"id": 790700206,
					"content": "Hahaha, vocês são bons rapazes, vocês dois. Hoje é um dia auspicioso para nosso lago!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700207
					],
					"speakerTitle": "Aurel"
				},
				{
					"id": 790700207,
					"content": "Finalmente, temos um verdadeiro campeão. Embora o Sr. Flaubert não tenha salvo a princesa ainda, acredito que a chance dele chegará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700208
					],
					"speakerTitle": "Aurel"
				},
				{
					"id": 790700208,
					"content": "*Suspiro* Mas eu realmente não fiz nada, Sr. Aurel, além de ficar parado e assistir enquanto Vossa Alteza fazia todo o trabalho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700209
					],
					"speakerTitle": "Flaubert"
				},
				{
					"id": 790700209,
					"content": "Isso não é até melhor? Certamente você não queria que a princesa ficasse em perigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700210
					],
					"speakerTitle": "Aurel"
				},
				{
					"id": 790700210,
					"content": "Eu... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700211
					],
					"speakerTitle": "Flaubert"
				},
				{
					"id": 790700211,
					"content": "Ahh, já basta, Sr. Flaubert. Você foi confiado a executar a missão pelo próprio Cibrelus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700212
					],
					"speakerTitle": "Aurel"
				},
				{
					"id": 790700212,
					"content": "Oh, besteira! Não tenho nem certeza se era Cibrelus! Afinal, eu só ouvi falar dele, nunca ouvi ele falar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700213
					],
					"speakerTitle": "Flaubert"
				},
				{
					"id": 790700213,
					"content": "E você até aceitou o julgamento da princesa. Você é um campeão, se algum campeão já existiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700214
					],
					"speakerTitle": "Estampes"
				},
				{
					"id": 790700214,
					"content": "Podemos só... Não falar disso por ora? Por favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700215
					],
					"speakerTitle": "Flaubert"
				},
				{
					"id": 790700215,
					"content": "Enfim, para resumir — o futuro do nosso lago está em suas mãos capazes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700216
					],
					"speakerTitle": "Aurel"
				},
				{
					"id": 790700216,
					"content": "Agora podemos simplesmente aproveitar os saltos só por saltar! Quando eu voltar, eu vou sugerir ao comitê que façamos a \"diversão\" ser o foco a partir daqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700217
					],
					"speakerTitle": "Aurel"
				},
				{
					"id": 790700217,
					"content": "Isso parece uma proposta que eu estaria disposta a apoiar. Por sinal, vamos voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700218
					],
					"speakerTitle": "Estampes"
				},
				{
					"id": 790700218,
					"content": "Ei, não me deixem aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flaubert"
				}
			]
		},
		{
			"id": 7907003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7907001",
							"3"
						],
						"stepId": 7907001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ameixa",
					"Saborin",
					"Souffache"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700301,
					"content": "Tanto você quanto aquele sapo de papel foram reconhecidos como Guardiões, Vossa Alteza?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700302
					],
					"speakerTitle": "Saborin"
				},
				{
					"id": 790700302,
					"content": "Inacreditável, inédito! Simplesmente não há precedente para isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700303
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700303,
					"content": "E você terá que fazer mudanças ao teste também... Não, não faça isso, Vossa Alteza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700304
					],
					"speakerTitle": "Saborin"
				},
				{
					"id": 790700304,
					"content": "Você não pode simplesmente remodelar uma tradição tão antiga por capricho, Vossa Alteza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700305
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700305,
					"content": "Tudo bem, tudo bem, falem baixo. Meus ouvidos estão começando a doer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700306
					],
					"speakerTitle": "Ameixa"
				},
				{
					"id": 790700306,
					"content": "Tudo já foi decidido. Agora, considerando que sou tanto uma princesa e uma Guardiã reconhecida pela relíquia, vocês têm menos chance ainda de me impedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700307
					],
					"speakerTitle": "Ameixa"
				},
				{
					"id": 790700307,
					"content": "Mas, Vossa Alteza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700308
					],
					"speakerTitle": "Saborin"
				},
				{
					"id": 790700308,
					"content": "Ora, relaxem. Vou realizar uma cerimônia para treinar grupos de esquilos voadores confiáveis para defender o reino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700309
					],
					"speakerTitle": "Ameixa"
				},
				{
					"id": 790700309,
					"content": "Apenas após isso eu deixaria o reino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700310
					],
					"speakerTitle": "Ameixa"
				},
				{
					"id": 790700310,
					"content": "Vossa Alteza, nós... *suspiro* você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700311
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700311,
					"content": "Não se preocupem, pessoal. Posso cuidar de mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700312
					],
					"speakerTitle": "Ameixa"
				},
				{
					"id": 790700312,
					"content": "Como Princesa, eu que tenho que enfrentar os ventos selvagens do mundo sozinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700313
					],
					"speakerTitle": "Ameixa"
				},
				{
					"id": 790700313,
					"content": "...Como desejar, Vossa Alteza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Saborin"
				}
			]
		}
	]
}