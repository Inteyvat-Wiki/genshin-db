					"nextDialogs": [
						210100005
					],
					"speakerTitle": "Dandy"
				},
				{
					"id": 210100005,
					"content": "Mas isso significaria descer as escadas, limpando-as um passo de cada vez. É cansativo só de pensar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210100006
					],
					"speakerTitle": "Dandy"
				},
				{
					"id": 210100006,
					"content": "Eu vou tentar.",
