					"nextDialogs": [
						210100003
					]
				},
				{
					"id": 210100003,
					"content": "Oh, não é nada. Eu estava pensando como esse Albergue Wangshu é alto. Eu me pergunto quanto tempo levaria para descer todas aquelas escadas.",
