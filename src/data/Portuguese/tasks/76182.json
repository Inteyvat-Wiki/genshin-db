					"nextDialogs": [
						761820110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761820110,
					"content": "Se estiver ocupada, posso ajudar a cuidar dela para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820111
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761820111,
					"content": "Me dá a mesma sensação que o seu quarto antigo. É reconfortante... Um lugar feliz.",
