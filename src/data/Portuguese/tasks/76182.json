						761820104
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761820104,
					"content": "Do que você tá rindo agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820105
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761820105,
					"content": "Estava imaginando você agachada, cuidando das flores. É uma imagem adorável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820106
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761820106,
					"content": "Posso dar uma olhada lá dentro daqui a pouco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820107
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761820107,
					"content": "Claro. Já limpei e tirei a poeira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761820108,
					"content": "O que você vai fazer com o lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820109
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761820109,
					"content": "Hmm... Acho que ainda quero manter a casa. Posso voltar e arrumar sempre que tiver tempo.",
