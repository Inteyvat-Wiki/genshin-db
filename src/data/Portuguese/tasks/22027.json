			"dialogs": [
				{
					"id": 220270401,
					"content": "Vamos oferecer Dango de Três Cores.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270402
					]
				},
				{
					"id": 220270402,
					"content": "Mesmo? Ótimo! Ainda bem que eu tenho um aqui comigo. Foi minha mãe que fez, e eu ainda não o comi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270403
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270403,
					"content": "Vou oferecer ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270601
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270601,
					"content": "Arcontes, me abençoem e ajudem meus desejos a se realizarem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270602
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270602,
					"content": "#Obrigado por me acompanhar até agora, {F#tia}{M#tio}. Por favor, fique com isso, é para você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270603
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270603,
					"content": "Amanhã voltarei aqui para checar a situação. Espero receber uma resposta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
