			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shouta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270101,
					"content": "Laca... Como que podemos fazer isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270102
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270102,
					"content": "Você quer laca para fazer o quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270103
					]
				},
				{
					"id": 220270103,
					"content": "Oh, Viajante, é você... Bem, você soube das aparições no santuário?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270104
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270104,
					"content": "Ouvi dizer que se você oferecer algo precioso ao santuário, é possível que seu desejo se realize.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270105
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270105,
					"content": "Eu pensei se oferecesse laca, por ela ser especialmente valiosa, com certeza teria meu desejo realizado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270106
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270106,
					"content": "Mas não tenho dinheiro para comprar laca, por isso queria fazer ela eu mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270107
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270107,
					"content": "Ouvi dizer que Nanatsuki, da Yayoi Produtos de Laca, é uma especialista em fazer laca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270108
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270108,
					"content": "Viajante, você poderia ir comigo procurar por Nanatsuki sobre como fazer laca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270109,
						220270111
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270109,
					"content": "Tudo bem, vamos indo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270110
					]
				},
				{
					"id": 220270110,
					"content": "#Obrigado, {F#tia}{M#tio}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270111,
					"content": "Por que você mesmo não vai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270112
					]
				},
				{
					"id": 220270112,
					"content": "Geralmente, Nanatsuki é muito... Séria. Eu não me atrevo a pedir para ela me ensinar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270113
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270113,
					"content": "Mas com você, Viajante, do meu lado, talvez ela queira me ajudar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 2202702,
			"completionStepIds": [
				2202702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202702",
							"2"
						],
						"stepId": 2202702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yayoi Nanatsuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270201,
					"content": "Olá, podemos ajudar vocês com algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270202
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270202,
					"content": "Bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270203
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270203,
					"content": "Sobre laca...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270204
					]
				},
				{
					"id": 220270204,
					"content": "... Vocês querem fazer uma oferenda para o santuário com laca, por isso vieram até aqui para que eu ensine como fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270205
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270205,
					"content": "Por favor, Nanatsuki! Eu quero muito realizar o meu desejo! Além disso, eu... Eu não contarei a sua fórmula para ninguém, prometo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270206
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270206,
					"content": "O problema não é a fórmula de pintura. Se você quer fazer uma laca bonita, também são necessários anos de prática.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270207
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270207,
					"content": "E não é também uma questão só de tempo, mas mais de... Dinheiro. Eu sou a sucessora de quarta geração de uma família de laqueadores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270208
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270208,
					"content": "Eu cheguei até mesmo a viajar para Sumeru para estudar laqueamento. Por isso é impossível você aprender a fazer ele da noite para o dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270209
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270209,
					"content": "Mesmo? Mas eu não consigo pensar em mais nada para oferecer ao santuário...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270210
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270210,
					"content": "Na minha opinião, não é uma questão do valor do objeto que você está oferecendo. O objeto que deveria representar suas intenções.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270211
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270211,
					"content": "Se você tiver as intenções corretas, e oferecer seus objetos favoritos, deve obter uma resposta dos arcontes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270212
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270212,
					"content": "Intenções e sentimentos corretos... Coisas que eu gosto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270213
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270213,
					"content": "Acho que entendi... Mas também não entendi... De todo jeito, obrigado, Nanatsuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270214
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270214,
					"content": "Vamos voltar para o santuário, Viajante. Eu ainda preciso de sua ajuda para saber que tipo de coisa eu devo oferecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 2202703,
			"completionStepIds": [],
