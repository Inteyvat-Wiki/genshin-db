			"dialogs": [
				{
					"id": 220270301,
					"content": "Bem, Nanatsuki disse que eu deveria receber uma resposta, não é? Mas o que será que eu deveria oferecer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270302
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270302,
					"content": "Se é de coisas que gosto, eu gosto de Dango de Três Cores. Gosto muito de comer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270303
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270303,
					"content": "Mas usar um Dango de Três Cores para fazer uma oferenda não é desrespeitoso? Eu ofereci antes Confete, mas não recebi resposta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270304
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270304,
					"content": "Também ouvi dizer que algumas pessoas embrulham pétalas frescas e as oferecem. Isso parece mais apropriado do que Dango...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270305
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270305,
					"content": "E então? Viajante, você acha que eu deveria oferecer o quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
