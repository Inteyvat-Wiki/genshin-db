				"points": []
			},
			"dialogs": [
				{
					"id": 708240101,
					"content": "Limpe o lugar novamente, e desta vez eu quero que esteja impecável! Trata-se de causar uma boa primeira impressão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240102
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240102,
					"content": "Me desculpe, senhorita Adelinde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240103
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 708240103,
					"content": "Seremos mais cuidadosas desta vez, senhorita Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240104
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 708240104,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240105
					]
				},
				{
					"id": 708240105,
					"content": "Ah, olá, viajante. Bem-vindo à Adega do Alvorecer. A tempestade pode ter passado, mas aqui na vinícola ainda estamos limpando a bagunça que ela causou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240106
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240106,
					"content": "Estou tentando organizar a operação de limpeza, mas essas garotas, elas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240107
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240107,
					"content": "Me desculpe, senhorita Adelinde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240108
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 708240108,
					"content": "Seremos mais cuidadosas desta vez, senhorita Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240109
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 708240109,
					"content": "Sim, vocês já disseram isso, muito obrigada! Agora, por que vocês não se esforçam em limpar em vez de ficar aqui me pedindo desculpas? Xô!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240110
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240110,
					"content": "Estas crianças... Elas são tão descuidadas. Não sei como vamos superar tudo isso no ritmo de progresso delas. E mesmo depois disso, ainda há o interior que precisa de limpeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
		{
			"id": 7082402,
			"completionStepIds": [
				7082401
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
