			"dialogs": [
				{
					"id": 708240201,
					"content": "Vim ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240202
					]
				},
				{
					"id": 708240202,
					"content": "Você sabe varrer? Aliás, esqueça, estamos com tão pouco pessoal que eu devo aceitar toda ajuda que eu conseguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240203
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240203,
					"content": "Siga-me até dentro de casa, há muita limpeza que também precisa ser feita lá dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
		{
			"id": 7082403,
			"completionStepIds": [
				7082401
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
