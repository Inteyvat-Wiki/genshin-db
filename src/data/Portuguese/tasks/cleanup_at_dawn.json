				"points": []
			},
			"dialogs": [
				{
					"id": 708240301,
					"content": "#Eu sou {M#um}{F#uma} excelente varred{M#or}{F#ora}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240302
					]
				},
				{
					"id": 708240302,
					"content": "#Sério? Isso é incrível. Bem, já que você está dispost{M#o}{F#a} a me ajudar, terei o maior prazer em aceitar sua oferta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240303
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240303,
					"content": "Siga-me até dentro de casa, há muita limpeza que também precisa ser feita lá dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
