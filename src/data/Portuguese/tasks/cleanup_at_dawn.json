			"dialogs": [
				{
					"id": 708240401,
					"content": "Terminou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240402
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240402,
					"content": "Tudo pronto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240403
					]
				},
				{
					"id": 708240403,
					"content": "Maravilha, isto foi de uma grande ajuda. Não consigo nem imaginar quanto tempo isto teria me levado sozinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240404
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240404,
					"content": "E se eu tivesse colocado as garotas para fazer isso... Sabe-se lá quantas coisas elas teriam acabado por destruir no processo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240405
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240405,
					"content": "#Obrigada, pegue isto. Peço desculpas por ter te incomodado, {M#um}{F#uma} visitante, fazendo o trabalho de uma empregada da vinícola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240406
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240406,
					"content": "Próxima vez que você visitar, a vinícola estará impecável!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
