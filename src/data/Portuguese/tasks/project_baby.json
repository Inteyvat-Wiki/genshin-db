					"nextDialogs": [
						230040802
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040802,
					"content": "Sobre a situação do acampamento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230040803
					]
				},
				{
					"id": 230040803,
					"content": "Verdade? Será que algum animal selvagem invadiu o lugar...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040804
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040804,
					"content": "Pensando bem... A ração que eu fiz atraiu Cogumelos, atraiu pássaros... Não seria estranho se atraísse animais selvagens também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040805
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040805,
					"content": "Hmm... Parece que eu realmente deveria pensar em abrir um negócio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040806
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040806,
					"content": "Se a ideia funcionar, eu vou ganhar muito mais dinheiro que nos meus espetáculos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040807
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040807,
					"content": "Ah, eu viajei no assunto, haha... Muito obrigado pela sua ajuda. Aceite isso como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
