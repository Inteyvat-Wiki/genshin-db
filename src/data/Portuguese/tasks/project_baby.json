			},
			"dialogs": [
				{
					"id": 230042001,
					"content": "Hã? Esta pérola... Como... Onde encontraram isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042002
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042002,
					"content": "Dentro de um pote no acampamento, você deixou isso para trás?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042003,
					"content": "Ah, eu usava isso nos espetáculos. Quando tocava flauta, as pequenas colocavam a pérola na cabeça e erguiam a parte superior do corpo para dançar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042004
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042004,
					"content": "Mas truques desse tipo deixaram de ser lucrativos. Faz muito tempo que não uso nos espetáculos. Nem percebi quando sumiu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042005
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042005,
					"content": "De qualquer forma, obrigado por me ajudar a recuperar a pérola. Aqui está sua recompensa, fique com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
