				"points": []
			},
			"dialogs": [
				{
					"id": 230042201,
					"content": "Hã? Os chapéus... Hahaha, eu fiz para as cobrinhas. Como pude esquecer deles também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042202
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042202,
					"content": "Fiz um chapéu para cada uma das cobras para atraírem as crianças ao espetáculo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042203
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042203,
					"content": "Vermelho para a Jori, verde para Amum, Amarelo para a Gana, e azul para Drak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042204
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042204,
					"content": "Que gracinha! O espetáculo deve ter sido um sucesso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042205,
					"content": "No início era ótimo, mas assim que as cobras abriam a boca, as crianças choravam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042206
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042206,
					"content": "Oh, já chega de falar disso. Aceite isto como agradecimento. É de coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
