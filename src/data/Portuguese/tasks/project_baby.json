			"dialogs": [
				{
					"id": 230040701,
					"content": "Sim! Isso mesmo! Então eu deixei mesmo no acampamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040702
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040702,
					"content": "Estava enterrada sob as pedras. O acampamento sofreu um deslizamento de terra que levou as coisas para longe. Precisamos de um tempo para encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230040703,
					"content": "É sério? Como pode ter ocorrido um deslizamento de terra? Aquele lugar sempre foi seguro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040704
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040704,
					"content": "Oh, sim! Antes, quando eu acampava por lá, sempre ouvia barulhos à noite e sentia alguma coisa arranhando minha barraca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040705
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040705,
					"content": "Minhas cobras estavam de alerta e me acordavam todas as vezes, mas quando eu ia checar, acabava não encontrando nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040706
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040706,
					"content": "Bom, deixa para lá... Muito obrigado pela sua ajuda. Aceite isso como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
