			"dialogs": [
				{
					"id": 230042401,
					"content": "Ah! Esta é a torre de escalar de cobras que eu fiz? Que saudades, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042402
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042402,
					"content": "O que é uma torre de escalar de cobras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042403,
					"content": "É um brinquedo para as cobrinhas escalam. Não posso deixá-las agarradas a meu corpo o tempo todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042404
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042404,
					"content": "Obrigado por trazer isso para mim. Por favor, aceite esta recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042405
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042405,
					"content": "Foi assim que eu projetei? Que nostálgico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		}
