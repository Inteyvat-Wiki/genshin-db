			"dialogs": [
				{
					"id": 200070601,
					"content": "Isso deve ser o suficiente. Eu sinto que eu poderia cair a qualquer momento, desde que isso me leve de volta a Mondstadt, estará bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070602
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070602,
					"content": "Obrigado por tudo! Estou pronto para ir agora. Entre em contato na próxima vez que estiver no Vale Termal e vamos tomar uma bebida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070603
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070603,
					"content": "...Desde que você não beba tanto como o Draff.",
