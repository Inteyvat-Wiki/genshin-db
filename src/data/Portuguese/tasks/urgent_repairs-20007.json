				"points": []
			},
			"dialogs": [
				{
					"id": 200070101,
					"content": "#Obrigado, {NICKNAME}, mal posso acreditar na minha sorte... Tenho certeza de que era...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070102
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070102,
					"content": "Essa carroça está carregada com todos os tipos de coisas que os humanos conseguiram guardar. O Draff quis que eu entregasse à cidade hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070103
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070103,
					"content": "Eu... Eu não sou o melhor caçador do mundo, mas uma entrega simples é tranquila de se fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070104
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070104,
					"content": "Eu quase estraguei tudo. Esse ataque foi completamente inesperado, acho que eles deviam estar atrás das mercadorias. É uma coisa boa que você apareceu nesse momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070105
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070105,
					"content": "Err, não é fácil para mim perguntar, mas... Meu carrinho foi danificado no ataque e é minha única maneira de sair daqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070106
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070106,
					"content": "Tenho certeza de que a floresta por aqui teria os materiais de que preciso para qualquer reparo, mas não consigo deixar minhas mercadorias sem vigilância.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070107
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070107,
					"content": "Você poderia me ajudar a procurar uma <color=#00E1FFFF>Tábua Resistente</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
		{
			"id": 2000702,
