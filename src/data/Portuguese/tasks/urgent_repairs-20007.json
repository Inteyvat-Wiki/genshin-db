			"dialogs": [
				{
					"id": 200070401,
					"content": "Você é um salva-vidas! Eles são terrivelmente persistentes, não são? Eu me pergunto o que aqueles caçadores pegaram que é tão irresistível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070402
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070402,
					"content": "Não tenho nada além de admiração por Draff, conseguindo caçar espécimes tão finos. *Suspiro*. Se eu pudesse aprender a caçar como ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070403
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070403,
					"content": "Ugh, antes disso, é melhor eu levar estas coisas para a cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070404
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070404,
					"content": "Argh, você não vai acreditar nisso... Eu estava quase terminando de consertar o carrinho, mas eles causaram um pouco mais de dano quando atacaram novamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070405
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070405,
					"content": "As coisas só podem piorar quanto mais eu ficar aqui. Eu preciso corrigir isso o mais rápido possível. Havia alguma corda nas costas, mas os Hilichurls devem ter pegado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070406
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070406,
					"content": "Viajante, poderia dar uma olhada ao redor e ver se encontra uma <color=#00E1FFFF>corda</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
