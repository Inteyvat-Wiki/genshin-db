			"dialogs": [
				{
					"id": 150251501,
					"content": "Então a tinta tá em algum lugar nessa caverna, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251502,
					"content": "Aqui é o mais longe que posso levar vocês. Apenas os escolhidos podem prosseguir a partir daqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251503
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251503,
					"content": "Por quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251504,
					"content": "É meio que uma longa história. Aparentemente, há uma certa fruta que cresce nessa caverna. O suco dela pode ser processado para fazer uma tinta excelente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251505
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251505,
					"content": "Muitos anos atrás, nossos ancestrais decidiram fazer uma série de obras de arte ambiciosas com grafite. Eles escolheram essa caverna para produzi-las, possivelmente pela disponibilidade da tinta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251506
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251506,
					"content": "Contudo, eles não queriam que ninguém visse a obra antes de estar concluída. Então, eles selaram a entrada para controlar o acesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251507
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251507,
					"content": "Para burlar o selo, você tem que ter dominado a arte da percepção de cores, ou algo assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251508
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251508,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
