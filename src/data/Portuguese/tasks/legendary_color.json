					"speakerTitle": "Paimon"
				},
				{
					"id": 150251202,
					"content": "Eles provavelmente usaram para as tintas, o mesmo que nós usamos, né? Talvez a gente também crie uma obra-prima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251203
					],
					"speakerTitle": "Paimon"
