			"dialogs": [
				{
					"id": 150251001,
					"content": "Olha só essa vista. O que você acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251002
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chefe dos Mestres do Vento Noturno"
				},
				{
					"id": 150251002,
					"content": "É magnífica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251003,
					"content": "Agora tente olhar um pouco mais longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251004
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chefe dos Mestres do Vento Noturno"
				},
				{
					"id": 150251004,
					"content": "Eita... Aquele grafite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251005,
					"content": "Em todos os anos desde a fundação de nossa tribo, essas cores estiveram conosco a cada passo do caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251006
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chefe dos Mestres do Vento Noturno"
				},
				{
					"id": 150251006,
					"content": "É verdade que busco trazer nova vida a essa tribo antiga via mudanças e reformas. Mas também entendo que há certas questões fundamentais das quais não podemos nos livrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251007
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chefe dos Mestres do Vento Noturno"
				},
				{
					"id": 150251007,
					"content": "A primeira dessas é a maneira que registramos nossa história.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251008
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chefe dos Mestres do Vento Noturno"
				},
				{
					"id": 150251008,
					"content": "Faz sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251009,
					"content": "Desde o início, nossa tribo sempre buscou trazer cores à história, e tenho uma profunda sensação de que essa é uma parte de nossa herança cultural que não devemos abandonar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251010
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chefe dos Mestres do Vento Noturno"
				},
				{
					"id": 150251010,
					"content": "Então, seja o que for, devo encontrar uma maneira de continuarmos a produzir nossos pergaminhos tecidos tradicionais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251011
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chefe dos Mestres do Vento Noturno"
				},
				{
					"id": 150251011,
					"content": "Você tem total razão. Paimon sente muito pelo que disse antes. Foi fora de linha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251012,
					"content": "Tá tudo bem. Só sinto gratidão por você entender a situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251013
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chefe dos Mestres do Vento Noturno"
				},
				{
					"id": 150251013,
					"content": "Nos comprometemos a te ajudar a resolver isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150251014
					]
				},
				{
					"id": 150251014,
					"content": "Então vamos esperar que quando nos encontrarmos novamente, a gente consiga reviver essa tradição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Chefe dos Mestres do Vento Noturno"
				}
			]
		},
