			"dialogs": [
				{
					"id": 150251801,
					"content": "Os ancestrais desses caras fizeram umas obras de arte de verdade aqui. Mas baseado no que vimos até agora, parece que deve ter mais coisa nessa história.",
					"roleType": "TALK_ROLE_NPC",
