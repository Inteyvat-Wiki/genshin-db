			"dialogs": [
				{
					"id": 150251201,
					"content": "Lembra da última vez que viemos aqui? Encontramos toda aquela arte pela caverna. Os ancestrais dessa galera criaram uma obra-prima mesmo!",
					"roleType": "TALK_ROLE_NPC",
