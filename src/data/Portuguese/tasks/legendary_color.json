			"dialogs": [
				{
					"id": 150250101,
					"content": "#Imagino que vocês sejam {M#os escolhidos}{F#as escolhidas} pelo Ancião Tlapo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250102
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250102,
					"content": "Sim! E você é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250103,
					"content": "Pode me chamar de Toltec. O chefe me pediu para ser seu guia hoje. Os mensageiros dele já me deixaram ciente da situação. Só me sigam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toltec"
				}
			]
		},
		{
			"id": 1502502,
			"completionStepIds": [
				1502503
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1502503",
							"2"
						],
						"stepId": 1502503,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"15025"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Toltec"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150250201,
					"content": "Mas a gente já não veio para cá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250202,
					"content": "#É, mas não esqueça, somos {M#os escolhidos}{F#as escolhidas}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250203
					]
				},
				{
					"id": 150250203,
					"content": "O estranho é que nossos ancestrais nunca removeram o selo mesmo após terem terminado o grafite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250204
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250204,
					"content": "Desde que foi selado, a única pessoa que esteve lá dentro foi a grande xamã, Huitzilin. E isso foi há duzentos anos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250205
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250205,
					"content": "Segundo ela, a obra de arte conta a história de um herói chamado Kuntur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250206
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250206,
					"content": "...Mas estou divagando. Desculpe, sou um grande fã de grafite, assim que começo a falar, posso ficar nisso por horas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250207
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250207,
					"content": "Então, você tem certeza que não quer vir conosco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250208,
					"content": "Passo. Já tentei entrar uma vez, mas o selo bloqueou meu caminho. Tentei fazer meu Iktomissauro removê-lo com seu poder, mas até isso não funcionou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250209
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250209,
					"content": "Acho que é um teste deixado pelos nossos ancestrais. Se você não passar no teste, você não merece ver as obras de arte deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250210
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250210,
					"content": "Aw...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250211,
					"content": "Mas não se preocupe comigo. Eu não me juntaria a você dessa vez mesmo que eu conseguisse entrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250212
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250212,
					"content": "Diferente do nosso chefe, eu não tenho a coragem de desafiar nossas tradições. Essa tarefa é especificamente dada para alguém pelo Ancião Iktomissauro. Quem sabe que tipo de coisas ruins podem acontecer se eu me envolver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250213
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250213,
					"content": "Justo. Tudo bem, tentaremos não demorar muito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
