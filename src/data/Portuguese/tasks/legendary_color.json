					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250308,
					"content": "Aw...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250309,
					"content": "Mas não se preocupe comigo. Eu não me juntaria a você dessa vez mesmo que eu conseguisse entrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250310
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250310,
					"content": "Diferente do nosso chefe, eu não tenho a coragem de desafiar nossas tradições. Essa tarefa é especificamente dada para alguém pelo Ancião Iktomissauro. Quem sabe que tipo de coisas ruins podem acontecer se eu me envolver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250311
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250311,
					"content": "Justo. Tudo bem, tentaremos não demorar muito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
