				],
				"points": []
			},
			"dialogs": [
				{
					"id": 725000101,
					"content": "Deu problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000102
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000102,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000103
					]
				},
				{
					"id": 725000103,
					"content": "O chefe entrou de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000104
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000104,
					"content": "Agora mesmo, a Comissão Tenryou enviou alguém e postou um aviso no quadro de mensagens dizendo que iriam suspender nosso festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000105
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000105,
					"content": "Eu não sei o que está acontecendo, o chefe parece ter enviado uns folhetos de publicidade para o Tenshukaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000106
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000106,
					"content": "Ele também disse que a Toda-Poderosa Shogun deve querer participar do Glorioso Festival de Tambores do Muito Respeitado Arataki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000107
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000107,
					"content": "Eh? Dessa forma, acho que o chefe está certo. Eu também acho que a Toda-Poderosa Shogun definitivamente vai querer participar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000108
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 725000108,
					"content": "Sim, você não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000109
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 725000109,
					"content": "Caramba, quem se importa com o que pensamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000110
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000110,
					"content": "Bom, o chefe foi capturado em Okuzumeshuu e enviado para Comissão Tenryou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000111
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000111,
					"content": "O que vamos fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000112
					]
				},
				{
					"id": 725000112,
					"content": "A Shinobu já deve estar resolvendo isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000113
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000113,
					"content": "Diz-se que a acusação de Okuzumeshuu contra o chefe é por supostamente perturbar a área militar restrita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000114
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000114,
					"content": "Posteriormente, foi alterado para suspeita de obstrução da ordem pública pela Madame Kujou Sara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000115
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000115,
					"content": "Ah, ah, ah, esse abominável Tengu Kujou, como ousa condenar o chefe com um crime tão grave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000116
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 725000116,
					"content": "Ai, como é tolo! Isso se tornou uma contravenção, é bom ir à escola de vez em quando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000117
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000117,
					"content": "Quanto à cerimônia, só poderemos falar disso depois que o chefe sair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000118
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000118,
					"content": "Viajante, não precisa se preocupar, com a Shinobu resolvendo, não haverá grandes problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000119
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000119,
					"content": "Você está apoiando tanto o nosso festival, quando o chefe sair, ele com certeza irá te agradecer pessoalmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000120
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000120,
					"content": "Espero que sua jornada seja como o nosso festival, cada vez melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000121
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000121,
					"content": "Cada vez melhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mamoru"
				}
			]
		}
	]
}