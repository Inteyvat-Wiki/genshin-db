					"nextDialogs": [
						200460304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200460304,
					"content": "Eu respeito o sonho da minha irmã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200460305,
					"content": "Ela conseguiu se recuperar de sua doença, e agora tem finalmente a oportunidade de perseguir seus sonhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200460306,
					"content": "Como seu irmão, eu... vou apoiá-la incondicionalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460307
					],
					"speakerTitle": "Anthony"
