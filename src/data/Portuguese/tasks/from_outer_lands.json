					"nextDialogs": [
						790030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030403,
					"content": "\"...Parece que veio do sudeste? Bom, deixa para lá. A nossa prioridade é encontrar uma solução para sair daqui...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030405,
					"content": "Essas palavras entalhadas nos navios parecem que estão relacionadas...",
