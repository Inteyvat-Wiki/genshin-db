					"nextDialogs": [
						790030317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030317,
					"content": "Vamos dar uma olhada nos arredores, talvez tenha algum tesouro escondido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030318,
						790030320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030318,
					"content": "Ficou no mar por muito tempo, com certeza está estragado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030319
					]
				},
				{
					"id": 790030319,
					"content": "Pare de ser tão pessimista! Quando se procura tesouros, sempre se deve crer que o tesouro está intacto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030322,
					"content": "Bem, vamos indo! O mar é grande, talvez precisemos procurar por muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
