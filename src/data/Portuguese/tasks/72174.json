			"trigger": {
				"objectNames": [
					"Barqueiro"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721740101,
					"content": "A parte próxima do rio, hey! O cipreste pintado de prata, hoi! O absinto prateado pelo chão, as pedras prateadas jazem por toda parte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740102,
						721740103
					],
					"speakerTitle": "Barqueiro"
				},
				{
					"id": 721740102,
					"content": "Com licença...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				},
				{
					"id": 721740104,
					"content": "#Oh... {M#Um}{F#Uma} cliente? Você quer subir a bordo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740105
					],
					"speakerTitle": "Barqueiro"
				},
				{
					"id": 721740105,
					"content": "#*Suspiro* Olha, você parecer ser {F#uma}{M#um} forasteir{M#o}{F#a}, não posso deixá-l{M#o}{F#a} entrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740106,
						721740107
					],
					"speakerTitle": "Barqueiro"
				},
				{
					"id": 721740106,
					"content": "Não...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740108,
					"content": "O barco prateado rumo à lua não foi preparado para você, não coloque seus pés nele para não sujar a minha vela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740109
					],
					"speakerTitle": "Barqueiro"
				},
				{
					"id": 721740109,
					"content": "*Suspiro* O nevoeiro já se foi! Quem ainda não subiu a bordo? A dona da casa dourada vai ficar chateada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740110
					],
					"speakerTitle": "Barqueiro"
				},
				{
					"id": 721740110,
					"content": "Um barco...? Onde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740111
					]
				},
				{
					"id": 721740111,
					"content": "Hehe... O barco prateado e brilhante do descendente do sol e da montanha... Todos vão voltar para a casa, para a casa dourada na lua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740112
					],
					"speakerTitle": "Barqueiro"
				},
				{
					"id": 721740112,
					"content": "Mas... mas algumas crianças se perderam e ainda não subiram a bordo. A dona vai ficar com raiva...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740113,
						721740114
					],
					"speakerTitle": "Barqueiro"
				},
				{
					"id": 721740113,
					"content": "Você precisa de ajuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740115,
					"content": "Suba a bordo, suba a bordo! Não se perca! Não se apegue no passado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barqueiro"
				},
				{
					"id": 721740114,
					"content": "Você está me ouvindo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740107,
					"content": "O que você está falando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740103,
					"content": "Quem é você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				}
			]
		},
