					"speakerTitle": "Barqueiro"
				},
				{
					"id": 721741002,
					"content": "#Obrigado, {M#forasteiro justo}{F#forasteira justa}, ho! Partiremos agora, finalmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721741003
					],
					"speakerTitle": "Barqueiro"
				},
				{
					"id": 721741003,
					"content": "A parte próxima do rio, hey! O carvalho dourado está lá, hoi! O absinto prateado pelo chão, as pedras prateadas jazem por toda parte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721741004
					],
					"speakerTitle": "Barqueiro"
				},
				{
					"id": 721741004,
					"content": "Paisagem magnífica... Até onde a vista alcança...",
