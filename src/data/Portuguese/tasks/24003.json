			"dialogs": [
				{
					"id": 240030901,
					"content": "#Irmão! Você disse a {M#ele}{F#ela} sobre meu esconderijo? Como {M#ele}{F#ela} me encontrou tão rápido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030902
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030902,
					"content": "Eu já te contei isso antes. Você se esconde em lugares óbvios demais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030903,
						240030904
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030903,
					"content": "A experiência está ao meu lado, receio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030905
					]
				},
				{
					"id": 240030905,
					"content": "Sério? Nesse caso, você vem aqui de novo da próxima vez? Podemos brincar juntos de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030906
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030906,
					"content": "Nossos pais não estão em casa de dia e meu irmão mais velho está sempre lendo... Ninguém tem tempo para brincar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030907
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030907,
					"content": "Bem, você pode fazer o que eu faço e ler os livros nas prateleiras. É muito mais útil do que brincar de esconde-esconde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030908
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030908,
					"content": "Bem... eu prefiro ir procurar minha mãe e aprender a costurar com ela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030904,
					"content": "#Sou muito bo{M#m}{F#a} em esconde-esconde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030905
					]
				}
			]
		}
	]
