				"objectNames": [
					"Aurele"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030701,
					"content": "Quando Verut vai crescer...? *Suspiro*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030702
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030702,
					"content": "Não vai se esconder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030703
					]
				},
				{
					"id": 240030703,
					"content": "Eu nunca pretendi. Se Verut não me incomodasse tão frequentemente, eu preferiria ler meus livros muito mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030704
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030704,
					"content": "Nossos pais trabalham muito duro, então tenho que crescer logo para ajudar a aliviar a carga deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030705
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030705,
					"content": "Mas Verut continua dizendo que ele sente falta da mãe, então tenho que acompanhá-lo. Desse jeito, ele vai parar de chorar um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030706
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030706,
					"content": "Desculpe, eu falei demais. Estarei esperando por você no nosso ponto de encontro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030707
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030707,
					"content": "Só posso esperar que Verut não suje suas roupas desta vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				}
			]
		},
