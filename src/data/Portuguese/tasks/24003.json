			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verut",
					"Aurele"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030101,
					"content": "Você não vai encontrar o esconderijo que eu escolhi dessa vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030102,
					"content": "Se você se esconder naqueles lugares, serão seus pais que vão te procurar, não eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030103
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030103,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030104
					]
				},
				{
					"id": 240030104,
					"content": "Estou brincando de esconde-esconde com meu irmão! O problema é... Bem, ele conhece todos os meus esconderijos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030105,
					"content": "Verut, temos brincado aqui há tanto tempo que você já se escondeu em todos os lugares que há para se esconder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030106
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030106,
					"content": "Quanto aos lugares onde você não pode se esconder... Se eu te disse uma vez, eu te disse mil vezes o motivo de você não poder ir lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030107
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030107,
					"content": "Oh, aqueles lugares não são tão perigosos! Mãe e Pai exageram demais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030108,
					"content": "Mas quando você se esconde naqueles lugares, suas roupas e calças se sujarão ou rasgarão. Mãe e Pai já trabalham duro demais, não dê mais uma coisa para eles se preocuparem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030109
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030109,
					"content": "Oh... Tudo bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030110,
						240030111
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030110,
					"content": "Por que eu não acompanho?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				},
				{
					"id": 240030112,
					"content": "Sério? Você quer brincar comigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030113
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030113,
					"content": "Verut, não cause problemas aos outros! Desculpe, tudo que meu irmão pensa é em brincar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030114,
						240030115
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030114,
					"content": "Não se preocupe, eu tenho tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030116,
					"content": "#Irado! Viu, irmão? {M#Ele}{F#Ela} concordou! Eu com certeza vou me esconder melhor que você, fique vendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030117,
					"content": "#*Suspiro* Tudo bem então. Nesse caso, conto com você, {M#Irmãozão}{F#Irmãzona}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030118
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030118,
					"content": "Verut, não se esconda naqueles lugares que eu te contei, certo? Se nossos pais voltarem e virem suas roupas todas rasgadas, ninguém vai te ajudar a remendar elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030119
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030119,
					"content": "Entendi, entendi... Ugh, você é chatão, hein! Vou me esconder agora. Se esconda também, rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030120
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030120,
					"content": "Você primeiro. Eu já sei onde vou me esconder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030121
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030121,
					"content": "#Sério? Você está se gabando, tô sabendo! {M#Ele}{F#Ela} vai te encontrar, com certeza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030122
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030122,
					"content": "Aurele e Verut se escondem em seus respectivos lugares...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240030115,
					"content": "Está tudo bem. Não está me incomodando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030111,
					"content": "Bem, eu posso não conseguir te encontrar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				}
			]
		},
		{
