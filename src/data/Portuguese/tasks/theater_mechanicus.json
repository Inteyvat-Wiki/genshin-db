				"points": []
			},
			"dialogs": [
				{
					"id": 726560101,
					"content": "Venha aqui! Experimente o Teatro Mechanicus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560102,
						726560106
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560102,
					"content": "O que é isto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560103
					]
				},
				{
					"id": 726560103,
					"content": "#Oh! Seja bem-vind{M#o}{F#a}! Este é o Teatro Mechanicus, um jogo que eu importei de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560104
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560104,
					"content": "Basicamente é um jogo de mesa, que foi inventado pela Ruijin de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560105
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560105,
					"content": "Como eu poderia explicar melhor... Segundo a Ruijin, sou um dos representantes externos do jogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560111
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560111,
					"content": "Após me tornar a agente, a Ruijin enviou os itens do Teatro Mechanicus, junto com um plano de marketing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560112
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560112,
					"content": "Embora eles tenham ficado presos na Agência de Assuntos Externos por muito tempo, consegui pegá-los depois de muito esforço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560113
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560113,
					"content": "Mas o que a Agência de Assuntos Externos pretendia fazer com seu jogo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560114
					]
				},
				{
					"id": 726560114,
					"content": "Nenhum objeto estrangeiro poderia escapar da inspeção dessa agência, e o meu jogo também não foi um caso excepcional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560115
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560115,
					"content": "Deixa para lá, por que você não quer experimentar um pouco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560116
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560116,
					"content": "Vê estes itens aqui na mesa? São usados no jogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560117
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560117,
					"content": "Isso lembra você de Liyue? Haha... Eu fiz tudo igualzinho de acordo com o que a Ruijin escrever na carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560118
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560118,
					"content": "Até essa mesa foi feita sob medida, e saiu igualzinha à de Liyue... Custou muito dinheiro, mas valeu a pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560119
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560119,
					"content": "Além disso, segundo a sugestão da Ruijin, adicionei um novo modo de jogo nele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560120
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560120,
					"content": "Hã. Não é fácil explicar, mas acredito que basta experimentar uma rodada, você entenderá tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560121,
						726560123
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560121,
					"content": "Experimentar o Teatro Mechanicus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560122
					]
				},
				{
					"id": 726560122,
					"content": "Não tem problema! Te desejo um bom jogo. Hehe, agora é um Teatro Mechanicus totalmente novo, e não te desapontará!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560123,
					"content": "Ainda tenho outros assuntos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560124
					]
				},
				{
					"id": 726560124,
					"content": "Bom! Não se esqueça de voltar quando tudo for resolvido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560106,
					"content": "Como que também há Teatro Mechanicus em Inazuma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560107
					]
				},
				{
					"id": 726560107,
					"content": "Ei? Você também conhece esse jogo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560108
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560108,
					"content": "Bom. Você deve ter jogado com ele em Liyue, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560109
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560109,
					"content": "A Ruijin me comentou que tinha realizado alguns eventos de divulgação durante o Ritual de Lanternas, ao que parece, essas divulgações deram frutos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560110
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560110,
					"content": "Como eu poderia explicar melhor... Segundo a Ruijin, sou uma agente do Teatro Mechanicus na região de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560111
					],
					"speakerTitle": "Komakata"
				}
			]
		}
	]
}