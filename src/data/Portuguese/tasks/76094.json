			},
			"dialogs": [
				{
					"id": 760940201,
					"content": "Maravilhoso. Eu sabia que você pensaria em algo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940202
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940202,
					"content": "As Ovelhas-Preguiça não conseguem sobreviver sem kuuvahki, mas pelo menos durante sua estadia em Nod-Krai, ela talvez traga um pouco de conforto àquele homem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940203
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940203,
					"content": "Já vou me despedindo. Aqui está uma pequena lembrança para demonstrar nossa gratidão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
		},
		{
