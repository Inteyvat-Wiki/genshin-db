			},
			"dialogs": [
				{
					"id": 760940501,
					"content": "*Suspiro* Esse aqui é o companheiro de um comerciante forasteiro que ficou preso na caverna. Não imaginei que você me salvaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940502
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940502,
					"content": "Apesar de nós sabermos que as Ovelhas-Preguiça geralmente seguem as pessoas apenas para espalhar as sementes que carregam, mas como é que raios aquele senhor não ouviu essa explicação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940503
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940503,
					"content": "#É por isso que estou me preocupando. Ainda bem que encontrei com um{F#a} aventureir{F#a}{M#o} gentil como você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940504
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940504,
					"content": "Isso aqui é um pequeno agradecimento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
		}
