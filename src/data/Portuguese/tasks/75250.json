					"nextDialogs": [
						752500302
					],
					"speakerTitle": "Aroja"
				},
				{
					"id": 752500302,
					"content": "Se não se importar... será que poderia me dar uma ajudinha? Só preciso que termine de colorir as peças que ainda temos.",
