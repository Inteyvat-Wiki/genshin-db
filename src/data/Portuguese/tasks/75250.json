			"dialogs": [
				{
					"id": 752500101,
					"content": "Os turistas que compraram os bonecos foram saindo aos poucos, então, alguns visitantes inesperados chegaram ao Parque das Alpacas...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500102
					]
				},
				{
					"id": 752500102,
					"content": "Uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500103
					]
				},
				{
					"id": 752500103,
					"content": "Os Fatui que tentaram roubar ontem? São vocês! Vocês... o que querem agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500104
					],
					"speakerTitle": "Aroja"
				},
				{
					"id": 752500104,
					"content": "Não se preocupe. Deixa comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752500105
					]
				},
				{
					"id": 752500105,
					"content": "Não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500106
					]
				},
				{
					"id": 752500106,
					"content": "Aquele liderando os Fatui parece estar desesperado e balança suas mãos, então te dá uma nota amassada. Você a desenrola. Está escrita com letras trêmulas—",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500107
					]
				},
				{
					"id": 752500112,
					"content": "Então ontem, quando estenderam a mão... na verdade estavam tentando pagar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500113
					],
					"speakerTitle": "Aroja"
				},
				{
					"id": 752500113,
					"content": "D-Desculpe... Eu entendi tudo completamente errado... Sério, minhas desculpas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500114
					],
					"speakerTitle": "Aroja"
				},
				{
					"id": 752500114,
					"content": "Por favor, peguem esses brinquedos! Esse é o meu agradecimento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500115
					],
					"speakerTitle": "Aroja"
				},
				{
					"id": 752500115,
					"content": "O líder dos Fatui balança sua cabeça e levanta três dedos.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500116
					]
				},
				{
					"id": 752500116,
					"content": "Entendi... Vocês são exatamente como os heróis de Natlan. Verdadeiros defensores do heroísmo...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500117
					],
					"speakerTitle": "Aroja"
				},
				{
					"id": 752500117,
					"content": "Então vou pegar três brinquedos com cores que combine melhor com o humor de vocês. Obrigada pela compreensão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aroja"
				}
			]
		},
