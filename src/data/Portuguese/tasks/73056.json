					"nextDialogs": [
						730560504,
						730560506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560504,
					"content": "E Paimon do nada parece saber o que falar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560505
					]
				},
				{
					"id": 730560505,
					"content": "Ei! O que você quer dizer com isso?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560508,
					"content": "Hmm... Acho que você já pegou o suficiente. Obrigada por virem comigo até aqui. Como fizemos o que havíamos planejado, devemos ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560509
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560509,
					"content": "Haha, isso é ótimo... Com essas amostras, talvez eu progrida em minhas pesquisas sobre os segredos e fraquezas do Definhamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560510
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560510,
					"content": "Obrigado pelo seu trabalho duro, vamos voltar pelo mesmo caminho que viemos... Eu tenho algo para vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560511
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560511,
					"content": "Uhul! Recompensas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560512,
					"content": "Hehe, sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560506,
					"content": "Legal!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560507
					]
				},
				{
					"id": 730560507,
					"content": "Paimon não entendeu o que você quis dizer, mas, legal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560508
					],
					"speakerTitle": "Paimon"
				}
			]
		},
