					"nextDialogs": [
						730560706
					]
				},
				{
					"id": 730560706,
					"content": "Mesmo que você tenha esquecido de muitas coisas, você deve saber que não temos más intenções! Estamos sempre do seu lado, e sempre ajudaremos Mawtiyima!",
