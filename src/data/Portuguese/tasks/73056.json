					"nextDialogs": [
						730560711
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560711,
					"content": "#Mas, aqui não fiquem. Saiam logo, vocês. Ainda se recuperando, floresta... Por isso, não ficar aqui, nov{F#as}{M#os} convidad{F#as}{M#os}.",
