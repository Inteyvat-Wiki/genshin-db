	"talks": [
		{
			"id": 7305601,
			"completionStepIds": [
				7305601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305601",
							"2"
						],
						"stepId": 7305601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khayyam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560101,
					"content": "Haha, interessante... Muito interessante. Está revivendo... A floresta... Ela está revivendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560102
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560102,
					"content": "Oi, vovô! Você está perdido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560103,
					"content": "Hmm... Hmm? Rost...? Ah, você está falando comigo? Haha, perdido? Não, não, não estou perdido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560104
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560104,
					"content": "Bom dia, crianças. Eu sou Giyath Khayyam, um Dastur do Amu{RUBY#[S]Biologia}rta, haha... Podem me chamar de Khayyam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560105
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560105,
					"content": "Hmm... Olá, Sr. Khayyam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560106,
					"content": "Não... Vamos, sigam-me, baixem a ponta de sua língua, e subam o meio... Khaaa. Depois disso, faça um círculo com sua boca... Yyaaa. E por fim, fechem seus lábios naturalmente... Mmmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560107
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560107,
					"content": "Hã...Khaaa...Yyaaa...Mmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560108,
					"content": "#Sim, muito bem! Agora, jovem lour{F#a}{M#o}, repita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560109,
						730560111
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560109,
					"content": "Khaaa...Yyaaa...Mmm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560110
					]
				},
				{
					"id": 730560110,
					"content": "Haha, nada mal! Muito melhor do que essa coisinha branca! Estão vendo? Eu disse que poderia ensinar fonética!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560113,
					"content": "Então, Sr. Khayyam... Já que você não está perdido, o que está fazendo em um lugar como este?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560114,
					"content": "O quê? Hoho... Eu sou um pesquisador florestal. Para nós, a floresta é como nossa terra natal. Como eu estaria perdido em minha terra natal, que finalmente retornei para ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560115
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560115,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560116,
					"content": "A floresta está com muitos problemas por causa do Definhamento. Nas últimas três décadas, o número de espécies e espécimes de plantas estava caindo rapidamente, enquanto que os malignos cogumelos continuavam crescendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560117
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560117,
					"content": "Mas, recentemente, as zonas de Definhamento próximas desapareceram. As plantas que haviam desaparecido começaram a crescer de novo, e a reprodução dos cogumelos foi, de alguma forma, limitada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560118
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560118,
					"content": "Eu só vi algo assim uma vez em 60 anos... Por isso, para comprovar minhas hipóteses imaturas, eu vim aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560119
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560119,
					"content": "Entendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560120,
						730560123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560120,
					"content": "Sobre comprovar sua hipótese...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560121
					]
				},
				{
					"id": 730560121,
					"content": "Haha, isso aconteceu 60 anos atrás... Não tenha muitas expectativas, um senhor como eu pode não se lembrar bem delas. Mas estou convencido que o desaparecimento do Definhamento é algo relacionado àquela coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560122
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560122,
					"content": "Por isso, entrarei nessa caverna para coletar algumas amostrar e provar minhas suposições.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560126,
					"content": "Oh, Paimon entende... Mas a caverna ainda assim é perigosa, mesmo sem Marana dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560127,
					"content": "Haha, isso não é nada para mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560128
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560128,
					"content": "Hmm, espere... O que vocês disseram? O que estava na caverna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560129,
						730560130
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560129,
					"content": "Marana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560131,
					"content": "Hmm... Pensando bem, eu talvez precise da ajuda de vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560132
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560132,
					"content": "Sim, Paimon disse isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560133,
					"content": "Hehe, com licença, mas eu não perguntei os seus nomes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560134
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560134,
					"content": "#Pode me chamar de {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560135
					]
				},
				{
					"id": 730560135,
					"content": "E Paimon é Paimon! Paaai...Mooon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560136,
					"content": "Paimon? Paimon... Haha, que nome interessante... Você é a primeira humana... Ou fada, que ouço com esse nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560137
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560137,
					"content": "Oh, me perdoe, sinto muito. Eu não queria lhe ofender... Eu estava falando dessa coisinha daqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560138
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560138,
					"content": "Que coisinha?! Isso é ofensivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560139,
					"content": "Bem, acho que já falamos bastante. Sigam-me, Javans, é hora de ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560140
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560140,
					"content": "\"Javans\"...? O que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560141,
					"content": "É uma palavra antiga do dialeto de minha terra natal, significa \"jovens corajosos\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560142
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560142,
					"content": "Para ser mais preciso, significa \"jovens que nunca ignoram o mal gigante, ou nunca dão um passo atrás perante a injustiça profunda\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560143
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560143,
					"content": "Hehe, nós somos assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560144,
					"content": "Oh? Vocês se veem desse jeito? Haha, então me sigam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560145
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560145,
					"content": "Hein? Suas pernas realmente conseguem nos alcançar, Khayyam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560146,
					"content": "Hehe... Eu tenho uns 20, 30 anos de experiência de estudo em florestas, não me subestime por causa da minha idade! Vão na frente, eu alcanço vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560130,
					"content": "\"Definhamento\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560123,
					"content": "Precisa da nossa ajuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560124
					]
				},
				{
					"id": 730560124,
					"content": "Haha, muito obrigado, jovens. Eu fisicamente estou velho, mas minha mente ainda é lúcida. Não me subestimem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560125
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560125,
					"content": "Afinal, eu sei como agradar a floresta, por isso ela não me fará nenhum mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560111,
					"content": "O que você está fazendo aqui, Sr. Khayyam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560112
					]
				},
				{
					"id": 730560112,
					"content": "Hmm, sua pronúncia foi muito rápida. Mas, tudo bem... Falar ela mais devagar seria melhor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "Khayyam"
				}
			]
		},
		{
			"id": 7305602,
			"completionStepIds": [
				7305606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305606",
							"2"
						],
						"stepId": 7305606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khayyam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560201,
					"content": "Estou investigando principalmente três lugares. Haha, espero que minhas memórias de 30 anos atrás não tenham desaparecido completamente... Eu devo conseguir identificar os locais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560202
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560202,
