			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khayyam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560401,
					"content": "Ah! Olhe! Vejam isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560402
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560402,
					"content": "Uh? Uma planta nova? Por que você está tão entusiasmado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560403,
					"content": "Não, não é isso, mas ainda melhor! Vejam, é nosso castelo secreto! Oh, está uma verdadeira bagunça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560404
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560404,
					"content": "Hã? Castelo secreto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560405,
					"content": "Haha! O acadêmico Omar retornou! Ele voltou com segredos celestiais, Irfan, Siman, onde vocês estão? Não vão me dar boas-vindas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560406
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560406,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560407,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560408
					]
				},
				{
					"id": 730560408,
					"content": "Ah... Ahem! Me desculpem, jovens. Eu... Acabei me entusiasmando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560409
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560409,
					"content": "A velhice me deixa assim. Ela borra o presente e traz saudades do passado, cada vez mais, e mais... Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560410
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560410,
					"content": "Irfan e Siman são amigos meus. Construímos esse castelo juntos, nós três.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560411
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560411,
					"content": "Naquela época, Irfan era um grande músico, Siman era o comandante supremo, e eu era o astrólogo. Às vezes mudávamos de papel... Crianças sempre brincam de algo diferente quando ficam entediadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560412
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560412,
					"content": "Irfan era um ótimo músico, Siman era alto e forte, incomparável. Mas, e quanto a mim? Haha, eu lia muito, e minha família tinha mais Mora que as outras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560413,
						730560415
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560413,
					"content": "Vocês brincavam aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560414
					]
				},
				{
					"id": 730560414,
					"content": "Não, esse era nosso país secreto, e o levávamos a sério. Fizemos um promessa, dizendo que nunca esqueceríamos uns dos outros, e lideraríamos o Exército Restaurador para tomar o castelo de volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560418,
					"content": "Haha, 20 anos se passaram, eles podem ter esquecido nossa promessa... Esse lugar daqui virou meu acampamento de pesquisa na floresta, ele continuou operando até 30 anos atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560419
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560419,
					"content": "Depois disso, a Marana veio, mas o Exército Restaurador não. Haha, é compreensível... Como poderiam essas promessas infantis resistirem contra a morte certa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560420
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560420,
					"content": "Mas... Você se lembra delas, eles também devem se lembrar! Não fique triste, Sr. Khayyam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560421,
					"content": "Triste? Não. As memórias juvenis, \"amigos imaginários\" compartilhados, e não pertencer ao mundo adulto. Provavelmente é uma pena, mas... O passado não retornará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560422
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560422,
					"content": "\"Amigos imaginários\"... Você está falando dos Aranaras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560423,
						730560424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560423,
					"content": "Paimon...! Shh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560425,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560426
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560426,
					"content": "Haha, eu quase esqueci. Pedi para vocês me ajudarem a obter algumas amostras dessas plantas novas, não para ficarmos conversando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560427
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560427,
					"content": "Perdoem esse senhor por esse falatório. Prossigamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560424,
					"content": "Você fala demais, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560415,
					"content": "Vocês fizeram tudo isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560416
					]
				},
				{
					"id": 730560416,
					"content": "Não, nem tudo. Prometemos que lideraríamos o Exército Restaurador para retomar o castelo... Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560417
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560417,
					"content": "Eu cresci e me tornei um pesquisador na Academia, voltei aqui para reconstruir o lugar um pouco, trazendo e levando algumas coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "Khayyam"
				}
			]
		},
