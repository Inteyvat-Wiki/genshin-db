					"Suriqui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650701,
					"content": "Heh, seu desempenho foi muito bom, mas ainda está um pouco atrás de mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650702
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650702,
					"content": "Eu, que mantenho meu corpo levemente rechonchudo há tanto tempo sem nunca descuidar do treinamento, em termos de agilidade e impacto, sou incomparável aos tolos fanáticos por academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650703
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650703,
					"content": "Abandone essa obsessão por músculos e venha comigo louvar a grandiosa gordura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				}
			]
		},
		{
			"id": 7516508,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516505",
							"3"
						],
						"stepId": 7516505,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516506"
						],
						"stepId": 7516506
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Illimani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650801,
					"content": "Seu desempenho foi muito bom, mas, para ser sincero... não é por me gabar, mas o meu recorde ainda é superior ao seu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650802
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650802,
					"content": "Todo mundo tem pelo menos uma ou duas coisas em que realmente se destaca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650803
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650803,
					"content": "Agora você acredita, não é? Guerreiros com um físico como o meu também podem ser ágeis. Por isso, coma bem e não faça dietas malucas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illimani"
				}
			]
		},
		{
			"id": 7516509,
			"completionStepIds": [
				7516506
