				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Suriqui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650201,
					"content": "Ah, valente transeunte, já que você veio até Teteocan, imagino que você seja alguém em busca de força, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650202
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650202,
					"content": "Talvez você já tenha visto os fortões do \"Coletivo da Fartura\". Hmph, a maioria são apenas pessoas cheias de músculos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650203
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650203,
					"content": "#Mas, olhando para o seu físico, você parece bem esbelt{M#o}{F#a}, então ainda não se tornou um{F#a} fanátic{M#o}{F#a} por musculação que levanta peso freneticamente todos os dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650204
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650204,
					"content": "Deixa eu te dizer, tudo isso é uma farsa, não caia nessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650205,
						751650206
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650205,
					"content": "Você odeia se exercitar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				},
				{
					"id": 751650207,
					"content": "Não é bem assim, mas dizer que os músculos são tudo e que a força de um guerreiro vem apenas deles, isso é pura bobagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650208
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650208,
					"content": "Deixa eu te contar, os heróis antigos definitivamente não eram só ossos e músculos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650209
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650209,
					"content": "Eles viviam em condições muito mais adversas do que hoje, e em combates reais, priorizavam a sobrevivência e a defesa, o que certamente incluía manter uma quantidade adequada de gordura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650210
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650210,
					"content": "O físico deles provavelmente era algo como o meu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650211
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650211,
					"content": "Meu físico levemente rechonchudo é o que os heróis do passado realmente tinham — um corpo que combina impacto e flexibilidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650212
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650212,
					"content": "Mas o pessoal da tribo não consegue perceber isso. Ah, tão tolos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650213
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650213,
					"content": "#Pela sua expressão, parece que você não está muito convencid{M#o}{F#a}... Hmm, tudo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650214
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650214,
					"content": "Experimente o desafio de quebrar os jarros que eu preparei! Este campo foi originalmente feito para o meu próprio treinamento, mas emprestá-lo para você não é problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650215
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650215,
					"content": "Experimente e você verá como um físico robusto pode ser poderoso em combate real!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650206,
					"content": "Você odeia músculos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				}
			]
		},
		{
			"id": 7516503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
