					"speakerTitle": "Suriqui"
				}
			]
		},
		{
			"id": 7516504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516504",
							"2"
						],
						"stepId": 7516504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Illimani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650401,
					"content": "Ei, valente transeunte aí — sim, você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650402
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650402,
					"content": "#*Suspira* Você é tão magrel{M#o}{F#a}... Você anda comendo direito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650406,
						751650404
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650406,
					"content": "Mas... toda minha comida foi devorada pela minha guia, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650403
					]
				},
				{
					"id": 751650403,
					"content": "Não importa o motivo ou problemas, a primeira regra é: você deve comer bem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650408,
					"content": "Já que você chegou até Teteocan, você provavelmente já viu os guerreiros do Coletivo da Fartura, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650409
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650409,
					"content": "Como sou uma pessoa maravilhosa, deixe-me te dar um conselho: nunca confie nesses caras obcecados em ficar pregando sobre músculos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650410
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650410,
					"content": "A gordura que os Arcontes nos abençoaram é um presente precioso. Abandonar toda a comida deliciosa e perder sua gordura apenas para buscar músculos chamativos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650411
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650411,
					"content": "Essa é a coisa mais idiota do mundo. Até os javalis da floresta terão pena de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650412
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650412,
					"content": "E honestamente, se estamos falando do que é bonito, toda essa adoração por músculos apenas se tornou popular nas últimas décadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650413
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650413,
					"content": "Meu avô disse que na época dele, as pessoas, na verdade, gostavam de uma aparência um pouco mais cheia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650414
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650414,
					"content": "Portanto, não deixe ninguém te enganar em cair no caminho errado para perder peso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650415
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650415,
					"content": "Mas, se um dia você acabar como meus parentes do Coletivo da Fartura e decidir perder peso em nome da força...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650416
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650416,
					"content": "Então, aqui está algo para ser lembrado: quando se trata de agilidade, guerreiros com uma constituição física um pouco mais cheinha também podem ser tão ágeis quanto um peixe. Mas quando se trata de força, aqueles carinhas magrelos não são páreos para nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650417
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650417,
					"content": "Se você precisa de prova, apenas olhe para os frascos nessa área de treino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650418
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650418,
					"content": "Com o meu corpo, eu consigo facilmente <color=#00E1FFFF>sair correndo por elas sem quebrar nem umazinha</color>. Aposto que até os magrelos não conseguiriam esse tipo de agilidade, não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650419
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650419,
					"content": "Oh, até consigo ver — você está tentando não rir, né? Tá... sei que você não acredita em mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650420
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650420,
					"content": "Experimente! Passe por este campo de treino o mais rápido que puder, mas tome cuidado <color=#00E1FFFF>não quebre nenhum pote</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650421
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650421,
					"content": "Vamos ver o quão bem você se sai e se você consegue me superar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650404,
					"content": "Hã? Você está oferecendo me pagar um jantar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650407
					]
				},
				{
					"id": 751650407,
					"content": "Bem, não foi isso que eu quis dizer... Se você realmente está passando fome, eu tenho um pouco de carne grelhada em minha bolsa. Enfim, vamos deixar isso de lado por enquanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Illimani"
				}
			]
		},
