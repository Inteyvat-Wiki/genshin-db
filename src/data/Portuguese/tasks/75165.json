					"content": "Preciso me preparar antes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650302
					]
				},
				{
					"id": 751650302,
					"content": "#Sem problemas, volte quando estiver preparad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
