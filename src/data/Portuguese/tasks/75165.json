				]
			},
			"dialogs": [
				{
					"id": 751650901,
					"content": "Illimani, parece que você ganhou mais peso de novo — parabéns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650902
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650902,
					"content": "Haha, obrigado, Suriqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650903
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650903,
					"content": "Boa notícia, convenci mais uma pessoa magra a desistir de fazer dieta nesses últimos dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650904
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650904,
					"content": "Oh, que incrível, uma ótima ação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650905
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650905,
					"content": "Ei, é você! E aí, tem comido bem esses dias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650906,
						751650908
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650906,
					"content": "Comer é uma delícia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650907
					]
				},
				{
					"id": 751650907,
					"content": "#Muito bem, é assim que deve ser! Coma bastante, fique bem rechonchud{M#o}{F#a}, é o certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650910
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650910,
					"content": "Oh, a propósito, Illimani, o recorde de quebrar garrafas desse cara é insano — quase pertinho do meu melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650911
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650911,
					"content": "#{M#Ele}{F#Ela} até me desafiou aqui. E se saiu muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650912
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650912,
					"content": "#Nada mal, não esperava que você fosse tão habilidos{M#o}{F#a}, quase nos superou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650913
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650913,
					"content": "#Honestamente, se {M#ele}{F#ela} engordar mais um pouco, talvez consiga até nos superar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650914
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650914,
					"content": "#Hum, é bem possível. Embora, do meu ponto de vista, você seja um pouco magr{M#o}{F#a} demais, ainda tem espaço para engordar, mas enfim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650915
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650915,
					"content": "Eu te reconheço!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650916
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650916,
					"content": "Eu também te reconheço!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650917
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650917,
					"content": "Mas ainda assim, recomendo que você coma um pouco mais em cada refeição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650918
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650918,
					"content": "Não faça dieta, não perca peso, nós ficaríamos decepcionados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650908,
					"content": "Não tenho comido bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650909
					]
				},
				{
					"id": 751650909,
					"content": "Isso não é bom, nada é mais importante do que comer bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650910
					],
					"speakerTitle": "Suriqui"
				}
			]
		},
