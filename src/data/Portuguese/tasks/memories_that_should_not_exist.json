				},
				{
					"id": 80200302,
					"content": "Vamos ver se está seguro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200303,
					"content": "#Espere, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200304
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200304,
					"content": "Oh, hã...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200305
					]
				},
				{
					"id": 80200305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200306,
					"content": "Não temos tempo a perder. Vamos entrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200307
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200307,
					"content": "(O que Dain ia me dizer...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200308
					]
				},
				{
					"id": 80200308,
					"content": "Ei! Espere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 802004,
