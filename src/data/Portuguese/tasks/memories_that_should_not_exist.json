			"dialogs": [
				{
					"id": 80200301,
					"content": "Então você escondeu ele aqui! Não é um lugar fácil de ser encontrado, com certeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200302
