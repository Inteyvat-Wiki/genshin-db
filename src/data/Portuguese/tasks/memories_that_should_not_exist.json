			"dialogs": [
				{
					"id": 80200601,
					"content": "Como eu suspeitava... as memórias falsas eram uma armadilha. A Ordem do Abismo só queria nos seguir até aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200602
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200602,
					"content": "Agora que eles estão nas redondezas, devemos ter uma chance de ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200603
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200603,
					"content": "Argh...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200604
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200604,
					"content": "Dain? O que foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200605,
					"content": "Vocês podem sentir isso? Há uma perturbação nas Linhas Ley, deve ser a Ordem do Abismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200606
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200606,
					"content": "Uau, você deve ser bem sensível a isso. Paimon tá sentindo nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200607,
					"content": "Façam o que eu disser... usem aquele mecanismo ali, e saiam desse lugar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200608
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200608,
					"content": "Deixar você aqui sozinho? Você vai ficar bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200609
					]
				},
				{
					"id": 80200609,
					"content": "A Ordem do Abismo está fazendo algo. Se vocês retornarem para a Vila Vimara, suspeito que vocês tenham a chance de encontrar o morador desaparecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200610
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200610,
					"content": "... Só pense como uma forma de dividir para conquistar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200611
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200611,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200612
					]
				},
				{
					"id": 80200612,
					"content": "(Dain tem um ponto...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200613
					]
				},
				{
					"id": 80200613,
					"content": "(Mas, tem algo errado... o que não estou vendo?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200614
					]
				},
				{
					"id": 80200614,
					"content": "Hunf... eu sabia que cair na sua armadilha seria a única forma de lhe ver pessoalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200615
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200615,
					"content": "Você arriscou sua segurança, e a do olho...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200616
					]
				},
				{
					"id": 80200616,
					"content": "Que aposta, Dainsleif... mas eu acredito que sou eu quem estou entrando numa armadilha deixada pela Espada do Crepúsculo.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200617
					]
				},
				{
					"id": 80200617,
					"content": "#Você veio sozinh{F#o}{M#a}? Onde estão seus seguidores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200618
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200618,
					"content": "Quando a Espada do Crepúsculo está pronta para a batalha, qualquer exército que eu enviasse só marcharia para seu fim... é melhor eu enfrentar você sozinho.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200619
					]
				},
				{
					"id": 80200619,
					"content": "Eu sei que você deve ter muito a dizer...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200620
					]
				},
				{
					"id": 80200620,
					"content": "... Mas, se você só quer uma conversa, terá que me derrotar primeiro.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": []
				}
			]
		},
