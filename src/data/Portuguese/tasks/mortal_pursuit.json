				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xilonen"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1350.876,
							161.634,
							7851.647
						],
						"pointId": 350400213
					}
				]
			},
			"dialogs": [
				{
					"id": 150220101,
					"content": "Então, Allpa disse que Tepal é dos Filhos dos Ecos. Mas como rastreamos ele? Apenas... saímos perguntando por aí até o encontrar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220102,
					"content": "Vamos começar falando com alguém que conhecemos. Será mais rápido assim. Nesse momento e local, aposto que a pessoa mais fácil de encontrar é:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220103
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220103,
					"content": "Xilonen, bom dia, flor do dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220104
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220104,
					"content": "*Boceja* Ah, são vocês... Urg, me deem um segundinho, já vou descer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220105
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220105,
					"content": "*Boceja*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220106
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220106,
					"content": "Parece que vocês adoram escalar árvores...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220107
					]
				},
				{
					"id": 150220107,
					"content": "Escalo árvores para voar e ver mais longe. Normalmente não paro para tirar uma soneca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220108
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220108,
					"content": "Bem, nem todos somos como você — sempre cheia de energia, até mesmo após voar por aí o dia todo... então. Você veio até aqui e interrompeu minha sonequinha preciosa. Posso perguntar o motivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220109
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220109,
					"content": "Desculpe, Xilonen, mas isso não podia esperar. O nome \"Tepal\" significa algo para você? Aparentemente ele é um artesão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220110
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220110,
					"content": "Tepal? Sim, isso me é familiar... Eu acho que é o filho de Puma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220111
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220111,
					"content": "Ele está na tribo no momento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220112
					]
				},
				{
					"id": 150220112,
					"content": "Não, você chegou alguns anos tarde demais... Por que estão procurando por ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220113
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220113,
					"content": "É uma longa história...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220114
					]
				},
				{
					"id": 150220114,
					"content": "Você tenta explicar o que aconteceu resumidamente...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220115
					]
				},
				{
					"id": 150220115,
					"content": "\"Asas de Flogisto\"? Uau. Aquele garoto realmente conseguiu... Bem, parece que acabou meu descanso por hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220116
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220116,
					"content": "Conseguiu? Quer dizer que ele tentou fazer algo assim antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220117,
					"content": "É, ele tentou começar a construir uma máquina voadora logo após voltar do Clã das Plumas de Flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220118
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220118,
					"content": "Então, logo depois dele ter ficado sem asas... Essa máquina de voo era parecida com a arma que você fez para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220119
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220119,
					"content": "Você quer dizer, sua arma que é mais difícil de domar do que o Qucussauro mais orgulhoso? Não, ele queria criar algo que permitisse que qualquer um pudesse voar livremente, mesmo se não fossem naturalmente dotados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220120
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220120,
					"content": "Mas, naquela época, ele nunca foi muito longe. Explodiu sua oficina algumas vezes e por pouco quase não sai vivo. Eu não ficava acompanhando muito ele depois disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220121
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220121,
					"content": "Seus pais viajaram bastante em sua juventude e apenas retornaram para a tribo após ele ter nascido. Mas eles se acomodaram em uma área remota e não interagiam muito com as outras pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220122
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220122,
					"content": "O que significa que a maioria das pessoas na tribo não conhece eles muito bem... Sua melhor aposta seria de conversar diretamente com a família.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220123
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220123,
					"content": "Irei procurar Puma. Me esperem em frente da minha oficina, não vou demorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				}
			]
		},
		{
			"id": 1502202,
			"completionStepIds": [
				1502202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
