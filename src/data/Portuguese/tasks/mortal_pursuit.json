			"dialogs": [
				{
					"id": 150220301,
					"content": "Chasca, você finalmente voltou! As coisas estão ficando realmente tensas na tribo. Você fez algum progresso em sua investigação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220302
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220302,
					"content": "Algumas pessoas até acham que prendemos os comerciantes apenas para apoiar o esquadrão voador e acabar com as Asas de Flogisto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220303,
						150220304
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220303,
					"content": "Se as coisas ainda estão piorando mesmo após termos apreendido os comerciantes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				},
				{
					"id": 150220305,
					"content": "Encontramos algumas pistas promissoras, mas tem um enorme obstáculo entre nós e a prova irrefutável que precisamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220306
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220306,
					"content": "Chasca explica o que você descobriu sobre Tepal e sua teoria sobre a oficina voadora...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220307
					]
				},
				{
					"id": 150220307,
					"content": "Uma relíquia da Cidade Incandescente? Urg... então Och-kan continua conseguindo semear a discórdia por aí, mesmo após todos esses anos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220308
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220308,
					"content": "Uma oficina voadora... e um balão acima da arena de julgamento... E você está tentando ir para lá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220309
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220309,
					"content": "Alguma ideia de como podemos chegar até lá em cima?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220310
					]
				},
				{
					"id": 150220310,
					"content": "Nem as Asas de Flogisto ou um Qucussauro conseguem te levar tão alto. Você realmente acha que é onde Tepal está se escondendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220311
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220311,
					"content": "Hmm... Sabe de uma... Pode haver uma forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220312
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220312,
					"content": "Sério!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220313,
					"content": "Você ainda se lembra daqueles bocais na arena? Quando estavam bloqueados, o Flogisto gasoso estava preso e não conseguia fluir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220314
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220314,
					"content": "Mas agora está fluindo livremente, se a gente os bloqueasse de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220315
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220315,
					"content": "Você quer dizer... Todos eles, exceto aquele bem no topo da arena? Para aumentar a pressão lá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220316
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220316,
					"content": "Precisamente. Todo o Flogisto gasoso fluindo por um único bocal criaria uma corrente de ar de alta pressão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220317
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220317,
					"content": "E podemos usar para sair voando pelos céus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220318,
					"content": "Sim. Tem os seus riscos, mas com as habilidades de Chasca, acho que talvez ela consiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220319
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220319,
					"content": "É extremamente arriscado, mas concordo que é possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220320
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220320,
					"content": "Se você quiser tentar, veja com Inkanak pela área do julgamento. Ela pode te explicar como bloquear os bocais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220321
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220321,
					"content": "Chasca... Se alguém tiver alguma chance de conseguir essa prova do alto dos céus, é você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220304,
					"content": "Talvez haja outros indivíduos por aí que também estejam atiçando as chamas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				}
			]
		},
