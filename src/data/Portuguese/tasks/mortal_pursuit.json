				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Puma",
					"Xilonen"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1374.526,
							169.17,
							7678.847
						],
						"pointId": 350400214
					}
				]
			},
			"dialogs": [
				{
					"id": 150220201,
					"content": "Um tempo depois, na oficina de Xilonen...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220202
					]
				},
				{
					"id": 150220202,
					"content": "Voltei. Permitam-me apresentar a mãe de Tepal, Puma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220203
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220203,
					"content": "Olá! Somos—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220204,
					"content": "Poupem-se das gentilezas. Não quero perder mais tempo do que o necessário falando daquele garoto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220205
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220205,
					"content": "Hã...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220206,
					"content": "Eu o deserdei há muito tempo... Ele não é mais o meu filho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220207
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220207,
					"content": "Tudo que ele se importava era aquele seu sonho idiota de ir aos céus... Tentamos colocar noção na cabeça dele, mas ele estava obcecado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220208
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220208,
					"content": "Hnf... Então ele nos abandonou, ele falou alguma bobagem sobre construir uma oficina nos céus para evitar as críticas constantes das pessoas da superfície...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220209
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220209,
					"content": "Ele deixou seu diário para trás. Sejam quais forem suas dúvidas, podem procurar aí — estou farta de falar sobre ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220210
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220210,
					"content": "Ele não é filho meu... Ele nunca nem me chamou de \"mãe\" mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220211
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220212
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220212,
					"content": "Nossa, eles realmente se desentenderam pesado... Paimon realmente não esperava isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220213,
					"content": "Seu marido, o pai de Tepal... ele faleceu recentemente e Tepal sequer se incomodou de ir ao funeral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220214
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220214,
					"content": "Se você me perguntar, essa provavelmente foi a gota d'água para Puma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220215
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220215,
					"content": "Irei fazer companhia a ela. Se houver mais algo que você precise, pode vir me procurar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220216
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220216,
					"content": "Agradeço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220217
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220217,
					"content": "Certo, então, esse diário é a única pista que temos no momento, certo? O que tem nele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220218,
					"content": "Hmm... Alguns designs iniciais das Asas de Flogisto... e algumas teorias sobre uma oficina voadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220219
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220219,
					"content": "Ochkanatlan, a Cidade Incandescente... Parece que foi daí que ele tirou sua inspiração tecnológica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220220
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220220,
					"content": "Então, ele estava falando sério sobre a oficina nos céus? Mas isso é um projeto tão grande para uma pessoa só... será que ele realmente conseguiu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220221,
						150220222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220221,
					"content": "Na verdade, olhe aquele rascunho de um balão...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				},
				{
					"id": 150220223,
					"content": "...Oh! Sim! Aquele da arena do julgamento estava bem no alto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220224,
					"content": "Aquele balão está lá já faz um bom tempo, e todos andam se perguntando como ele foi parar lá. Mas... e se essa for a pergunta errada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220225
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220225,
					"content": "E se começou ainda mais alto, acima das nuvens e fora da vista, e acabou descendo até sua altura atual por conta de algum tipo de mau funcionamento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220226
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220226,
					"content": "Em outras palavras, poderia ser...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220227
					]
				},
				{
					"id": 150220227,
					"content": "...Parte da oficina de Tepal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220228,
					"content": "Parece provável. Se a base de Tepal esteve escondida nas nuvens esse tempo inteiro, isso definitivamente explicaria o motivo de Isidore não ter conseguido encontrá-la...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220229
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220229,
					"content": "Paimon sabia... Mas, uh, como a gente sobe até lá? Chasca, você sequer consegue voar tão alto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220230,
					"content": "Sozinha... provavelmente. Mas, com passageiro, de jeito nenhum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220231
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220231,
					"content": "Duvido que até as Asas de Flogisto consigam te levar tão alto... pelo menos, não sem aquela \"relíquia\" que Tepal mencionou em seu diário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220232
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220232,
					"content": "É, e ele provavelmente está segurando ela... Teremos que encontrar outra forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220233,
					"content": "Você consegue voar até lá, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220234
					]
				},
				{
					"id": 150220234,
					"content": "Não, está beeem além das capacidades de altitude de Paimon! Além disso, você realmente esperaria que Paimon fosse até lá e enfrentasse Tepal sozinha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220235,
					"content": "Não vamos nos preocupar. Só porque não conseguimos pensar em uma solução, não significa que ninguém mais possa. Não sou a única especialista em voo em minha tribo, sabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220236
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220236,
					"content": "Oh, bom ponto. Deveríamos ir perguntar à Vovó Allpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220237,
					"content": "E Mutota. Ele também era um belo de um piloto antigamente. Vamos voltar e ver o que sugerem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220222,
					"content": "Não vimos isso antes em algum lugar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				}
			]
		},
