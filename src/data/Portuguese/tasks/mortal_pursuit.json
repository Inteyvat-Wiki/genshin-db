			"dialogs": [
				{
					"id": 150221301,
					"content": "Urg... Oof... Paimon nunca voou tão rápido antes... Ela está prestes a vomitar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150221302,
					"content": "#Pelo menos chegamos inteir{M#o}{F#a}s.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150221303
					]
				},
				{
					"id": 150221303,
					"content": "Ahá... assim como imaginei. Pode parecer um balão comum pelo lado de fora, mas, de perto, foi claramente totalmente reformado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221304
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221304,
					"content": "E realmente, ele só desceu abaixo da linha das nuvens porque o maquinário customizado teve um mau funcionamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221305
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221305,
					"content": "Você consegue distinguir qual é o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150221306
					]
				},
				{
					"id": 150221306,
					"content": "Eu devo conseguir descobrir com a ajuda do diário de Tepal. Por sorte, sei fazer algumas gambiarras de tanto consertar minhas armas quando dão problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221307
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221307,
					"content": "Uhum... Isso deve bastar. Agora, tudo que precisa é de um belo chute forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221308
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221308,
					"content": "Uh... Talvez isso funcione com suas armas, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221309
					],
					"speakerTitle": "Paimon"
				},
				{
