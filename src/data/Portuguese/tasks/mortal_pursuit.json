			"dialogs": [
				{
					"id": 150221101,
					"content": "Você corre até a arena de julgamento e explica a situação para Inkanak...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150221102
					]
				},
				{
					"id": 150221102,
					"content": "Pelos deuses... que ideia ousada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221103
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221103,
					"content": "Pode até ser, mas temos que agir rápido. Qual é a forma mais rápida de bloquear os bocais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221104
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221104,
					"content": "Tecnicamente falando, preciso te aconselhar a tirar algumas medidas antes e planejar isso cuidadosamente primeiro... Mas imagino que não seja isso que você queira ouvir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221105
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221105,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150221106
					]
				},
				{
					"id": 150221106,
					"content": "...Então teremos que usar uma solução mais simples e bruta. Vê aquele Flogisto Sólido ali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221107
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221107,
					"content": "Nossas investigações anteriores revelaram que algum tipo de estrutura estável se formou dentro, tornando super resistente a danos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221108
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221108,
					"content": "Tem os seus pontos fracos, mas a menos que todos sejam acertados ao mesmo tempo, a integridade estrutural não será ameaçada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221109
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221109,
					"content": "Então... o que acontece se a gente acertar todos de uma vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150221110,
					"content": "Vai desmoronar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221111
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221111,
					"content": "...Certo, entendi onde você está querendo chegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221112
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221112,
					"content": "É, você consegue! Desde que você acerte todos os pontos fracos de uma vez do ângulo correto, o Flogisto Sólido irá cair bem em cima do bocal e bloqueá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221113
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221113,
					"content": "Você realmente acertou quando disse que seria \"simples e bruto\"... Parece meu tipo de plano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				}
			]
		},
