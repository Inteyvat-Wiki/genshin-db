			"dialogs": [
				{
					"id": 220190601,
					"content": "Se vocês forem agora atrás dele, provavelmente pegarão ele em flagrante. Se apressem, estarei aqui esperando por vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190602
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190602,
					"content": "Precisa de mais alguma coisa, Viajante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190603,
						220190607
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190603,
					"content": "Você não parece estar muito contente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190604
					]
				},
				{
					"id": 220190604,
					"content": "Um crime sem graça, um criminoso comum com técnicas criminosas simples, mas dando uma de espertinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190605
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190605,
					"content": "Se eu tivesse que descrever esse caso em uma só palavra, provavelmente usaria a palavra \"tédio\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190606
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190606,
					"content": "Mas de qualquer forma, ainda é um caso que precisamos resolver, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190607,
					"content": "Você não vem junto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190608
					]
				},
				{
					"id": 220190608,
					"content": "Para mim, este caso já está encerrado, o resto eu deixo para vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190609
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190609,
					"content": "Além do mais, com essa minha estrutura física e habilidade de combate, seria um desastre se o criminoso me sequestrasse e me usasse como refém.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190610
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190610,
					"content": "Me conheço muito bem, por isso, melhor eu deixar que vocês cuidem do criminoso mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		}
