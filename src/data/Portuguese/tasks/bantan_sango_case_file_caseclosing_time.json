				"points": []
			},
			"dialogs": [
				{
					"id": 220190401,
					"content": "...o Andou e o Amano devem ter chegado já na Comissão com o criminoso. E foi basicamente isso, diretora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190402
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190402,
					"content": "Ok, perfeito. Caso resolvido então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190403
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190403,
					"content": "Viajante, você também voltou! Bom trabalho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190404,
						220190405
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190404,
					"content": "...É só isso? Resolvemos o caso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				},
				{
					"id": 220190406,
					"content": "É normal que se sinta assim, afinal, o criminoso foi levado pelo Amano e pelo Andou. Leve isto como recompensa, talvez assim você sinta de fato que o caso foi resolvido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190407,
						220190409
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190407,
					"content": "Mas e a sua recompensa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190408
					]
				},
				{
					"id": 220190408,
					"content": "Minha? Poder ajudar a Comissão a investigar o caso e fazer com que a rua volte a ter paz de antes é a minha maior recompensa",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190412,
					"content": "Mas, pra falar a verdade, desta vez, eu realmente não \"ganhei\" nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190413
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190413,
					"content": "Não presenciei um método novo de cometer crimes, muito menos tive a oportunidade de ouvir novos conceitos criminais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190414
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190414,
					"content": "Foi apenas um crime comum e sem graça, que felizmente não investimos muito tempo e esforço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190415,
						220190417
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190415,
					"content": "Diretora Sango...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190416
					]
				},
				{
					"id": 220190416,
					"content": "Que foi? É a primeira vez que você conhece alguém interessado em crimes como eu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190419,
					"content": "E foi exatamente por causa disso que me tornei uma detetive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190420
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190420,
					"content": "...Mas você sente vontade de cometer crimes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190421
					]
				},
				{
					"id": 220190421,
					"content": "Claro, eu sinto é muita vontade. Eu queria é poder cometer um crime perfeito sem deixar nenhuma evidência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190422
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190422,
					"content": "Mas pena que... Na maioria dos casos, é quase impossível um humano cometer um crime sem deixar nenhuma evidência, ou seja, cedo ou tarde detetives irão descobrir a verdade",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190423,
						220190424,
						220190425
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190423,
					"content": "E se o crime não for cometido por uma pessoa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190426,
					"content": "Viu? Você também se interessou por crimes, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190427
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190427,
					"content": "Não se preocupe, você só parou para refletir um pouco mais sobre crimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190428
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190428,
					"content": "Eu também paro muito pra pensar sobre crimes, por exemplo, sobre métodos de crime ou motivos que podem levar uma pessoa a cometer um crime...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190429
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190429,
					"content": "Por que você para pra pensar sobre isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190430
					]
				},
				{
					"id": 220190430,
					"content": "Para melhorar as minhas técnicas de investigação, é claro. Eu tenho recebido vários casos bem complexos de investigação ultimamente, e ando quebrando a minha cabeça para tentar resolvê-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190431
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190431,
					"content": "Se bem que, desses casos, nenhum pode ser considerado como um \"Crime Perfeito\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190432
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190432,
					"content": "Mas você já presenciou algum \"Crime Perfeito\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190433
					]
				},
				{
					"id": 220190433,
					"content": "Já, e até hoje não consegui encontrar o criminoso daquele \"Crime Perfeito\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190434
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190434,
					"content": "Mas mesmo assim continuo acreditando que não existe um \"crime perfeito\", qualquer crime cometido por humanos deixará rastros... É apenas questão de tempo até achar as evidências.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190435
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190435,
					"content": "Enfim, leve essas recompensas e muito obrigada pela ajuda, Viajante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190436
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190436,
					"content": "E venha sempre nos visitar caso tenha tempo, mas, se não tiver, tudo bem também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190437
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190437,
					"content": "Algo me diz que futuramente ainda teremos chances de trabalhar juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190424,
					"content": "E se não existe um criminoso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190425,
					"content": "Como o criminoso deve fazer para apagar todos os rastros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190417,
					"content": "Então é assim que são os detetives?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190418
					]
				},
				{
					"id": 220190418,
					"content": "Não podemos generalizar, mas no meu caso, sim, me interesso muito por crimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190409,
					"content": "Você não quer nada mesmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190410
					]
				},
				{
					"id": 220190410,
					"content": "Minha recompensa foi que a justiça foi feita. Tirando isso, também não preciso de mais nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190411
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190411,
					"content": "... Talvez eu deva dizer isso, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190405,
					"content": "Não consigo sentir como se tivéssemos encerrado o caso de fato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				}
			]
		},
