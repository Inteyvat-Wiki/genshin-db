				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190301,
					"content": "Agora sim pegamos o criminoso em flagrante. Obrigado, Ryuuji, e a você também, Viajante, bom trabalho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190302
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190302,
					"content": "Amano e eu estaremos levando esses Ladrões de Tesouro de volta para a Comissão, pode deixar o resto com a gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190303
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190303,
					"content": "Mas eu realmente fico impressionado com a Sango, como que ela consegue adivinhar com tanta exatidão a localização do criminoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190304
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190304,
					"content": "Afinal de contas, estamos falando da Sango, para ela isso não é nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190305
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190305,
					"content": "Estamos indo então, Ryuuji. Depois que resolvermos o caso desse malandro, passaremos para dar oi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190306
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190306,
					"content": "Não se preocupem, e tomem cuidado ao voltar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190307
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190307,
					"content": "Vamos, Viajante, precisamos informar isso para a diretora também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 2201904,
