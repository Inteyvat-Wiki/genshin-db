			"dialogs": [
				{
					"id": 761860101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860102
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860103,
					"content": "...Então, como os Filhos da Lua Gelada têm se saído ultimamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860104,
					"content": "Muito bem. O retorno da Deusa da Lua fortaleceu nossa determinação em seguir o caminho que nos foi designado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860105
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860105,
					"content": "Sério? Bem, que bom saber disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860106,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860108,
					"content": "Haha... Acho que realmente não temos nada para conversar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860109,
					"content": "Receio que... seja porque há história demais entre os Filhos da Lua Gelada e os Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860110,
					"content": "Falando por mim, sou grata pelos seus esforços em proteger Nod-Krai e trazer de volta a Deusa da Lua, Srta. Sandrone. Mas quanto aos seus associados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860111,
					"content": "Entendo. Por diversos motivos, não conseguimos estabelecer relações amistosas, ou até mesmo mutuamente benéficas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860112,
					"content": "Mas os Fatui não buscam mais tomar nada dos Filhos da Lua Gelada, e eu já alertei meus subordinados para não criar dificuldades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860113
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860113,
					"content": "Do meu ponto de vista, já que somos vizinhos, mesmo que não possamos coexistir em perfeita harmonia, seria bom se pudéssemos no mínimo nos tratar com respeito mútuo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860114,
					"content": "Receio que isso levará tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860115
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860115,
					"content": "Sem dúvida. Mas podemos começar dando um pequeno passo de cada vez. Gostaria de experimentar este chá de ervas que preparei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860116,
					"content": "Oh, chá de ervas? Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860117,
					"content": "Hmm... Que sabor encorpado... Você preparou isso do jeito dos Filhos da Lua Gelada? A maioria dos forasteiros que conheci não gosta do nosso chá. Como você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860118
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860118,
					"content": "Aprendendo. E respeitando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860119
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860119,
					"content": "Haha... Não foi um mau começo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860120
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860120,
					"content": "Espero que seja do seu agrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860121
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860121,
					"content": "Gostei muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860122
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860122,
					"content": "Conversas amigáveis regadas a chá sempre foram uma ótima forma de criar laços de amizade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860123
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860123,
					"content": "Tenho a impressão de que desta vez não será diferente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		},
