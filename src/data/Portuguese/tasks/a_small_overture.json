			"dialogs": [
				{
					"id": 761860201,
					"content": "Um chá de ervas verdadeiramente delicioso, Srta. Sandrone. É como se eu pudesse sentir o gosto da sua sinceridade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860202,
						761860203
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860202,
					"content": "#(Vamos ficar sentad{M#o}{F#a}s assim por mais um pouco.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860204,
					"content": "Tudo bem. Da próxima vez, terei que convidá-la para um chá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860203,
					"content": "Acho que está na hora de eu começar a arrumar as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
