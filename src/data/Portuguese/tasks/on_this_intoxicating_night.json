					"nextDialogs": [
						766750605
					]
				},
				{
					"id": 766750605,
					"content": "Na primeira vez que fiz esse treinamento com o Razor, levamos o dia inteiro para terminar. Sabe por quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750606
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750606,
					"content": "Ele passou um quarto do dia rolando os barris, e os outros três quartos tentando entender do que raios eu estava falando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
