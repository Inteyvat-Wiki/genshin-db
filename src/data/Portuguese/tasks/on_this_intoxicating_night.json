					]
				},
				{
					"id": 766750805,
					"content": "Pensando bem, você ainda não conheceu o Rowan, não é? O garoto está tão acostumado a fazer tudo do jeito dele que nem apareceu na hora do treino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750806
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750806,
					"content": "Quando perguntei depois, ele disse que tinha ido cutucar um ninho de monstros e, quanto aos exercícios com barris... disse que não achava que valia a pena perder tempo com alvos que não revidassem.",
					"roleType": "TALK_ROLE_NPC",
