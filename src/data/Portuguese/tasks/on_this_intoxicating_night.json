						],
						"pointId": 15070
					}
				]
			},
			"dialogs": [
				{
					"id": 766750401,
					"content": "Ei, você está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750402,
					"content": "E-Estou bem... Ufa. Se vocês não tivessem aparecido a tempo, eu nem sei se conseguiria chegar antes do anoitecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750403
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750403,
					"content": "...Ainda bem! Nossos \"suprimentos essenciais\" chegaram inteiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750404
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750404,
					"content": "Uh, que tipo de suprimento é tão indispensável assim...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750405,
						766750406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750405,
					"content": "Bebida. Só pode.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750407
					]
				},
				{
					"id": 766750407,
					"content": "Nada mal! Este aqui é o Vinho de Dandelion que encomendamos especialmente da Adega do Alvorecer! É Mondstadt puro dentro de uma garrafa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750408
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750408,
					"content": "Você não imagina o sufoco que foi trazer isso de tão longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750409
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750409,
					"content": "Hah, e você fez um ótimo trabalho, chefe! Hoje à noite, no banquete, vai beber com a gente. O acampamento inteiro está esperando para brindar em sua honra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750410
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750410,
					"content": "...Então, no fim das contas, você só estava com pressa para garantir que as bebidas chegassem a tempo? E Paimon aqui achando que, pela primeira vez, você estava levando algo realmente a sério...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750411,
					"content": "Como é? Está dizendo que beber não é a mais séria das coisas sérias? Porque eu adoraria tomar um gole bem agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750412
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750412,
					"content": "E-Espera! Por favor, espera um segundo! Agora não é um bom momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750413
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750413,
					"content": "É, escuta ele! Primeiro, você precisa cuidar do que é sério...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750414,
					"content": "Esta é uma bebida especial, ela precisa ser mantida em movimento o tempo todo para não decantar e preservar o sabor! Depois de tanto tempo parada, eu diria que o gosto já deve ter piorado... em pelo menos dez por cento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750415
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750415,
					"content": "Dez por cento!? Inaceitável! Ninguém encosta numa gota até ficar no ponto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750416
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750416,
					"content": "...Táááá bom. Faz do seu jeito, então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750417,
					"content": "Então, como fazemos para colocar isso de volta nos eixos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750418
					]
				},
				{
					"id": 766750418,
					"content": "Encomendamos especialmente para alguém construir um mecanismo que mantivesse os barris rolando... Mas parece que quebrou na queda. Então agora, acho que vamos ter de contar com a boa e velha força bruta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750419
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750419,
					"content": "Hmm, então é só <color=#00E1FFFF>ficar batendo nos barris de madeira e rolar eles até o destino</color>...? Parece um bom e velho treinamento de força dos Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750420
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750420,
					"content": "Espera, os Cavaleiros treinam desse jeito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750421
					]
				},
				{
					"id": 766750421,
					"content": "Sim, isso ajuda a treinar controle de força e precisão. Você precisa dos dois, ou o barril não vai seguir certinho pelo caminho. É treinamento básico para muitos Cavaleiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750422,
						766750423
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750422,
					"content": "Considere minha curiosidade despertada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750424
					]
				},
				{
					"id": 766750424,
					"content": "#Haha, animad{M#o}{F#a} com os exercícios básicos, hein? Bem, o Laurent e os outros não vão voltar tão cedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750425
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750425,
					"content": "Certo, conto com você. Não se preocupe se acabar mandando eles um pouco longe demais. É só gritar que eu jogo de volta para o lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750423,
					"content": "#Como Cavaleir{F#a}{M#o} Honorável, eu gostaria de tentar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750424
					]
				},
				{
					"id": 766750406,
					"content": "Por que é que estou sentindo cheiro de álcool?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750407
					]
				}
			]
		},
