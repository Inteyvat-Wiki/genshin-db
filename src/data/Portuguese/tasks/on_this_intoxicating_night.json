					"nextDialogs": [
						766750705
					]
				},
				{
					"id": 766750705,
					"content": "A Jean e o Albedo uma vez me chamaram para ter uma conversa séria sobre se a Cavaleira das Faíscas precisava ou não participar de um treinamento básico como este.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750706
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750706,
					"content": "O treinamento básico de um cavaleiro ajuda a formar o caráter, mas como a Cavaleira das Faíscas ainda é tão jovem... eu decidi ouvir a opinião dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750707
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750707,
					"content": "...Ela trouxe suas bombas toda contente para o campo de treinamento. E assim, chegamos a um consenso: não vamos voltar a tocar nesse assunto até ela ser um pouco mais velha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
