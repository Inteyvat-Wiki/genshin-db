			},
			"dialogs": [
				{
					"id": 766750901,
					"content": "#Ah! Grande Mestre! Cavaleir{F#a}{M#o} Honorável! Estão de volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750902
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750902,
					"content": "Voltaram! Voltaram! Todos, em formação, deem uma recepção de respeito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750903
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750903,
					"content": "Uau, a gente é tão popular assim? A Paimon até fica com vontade de corar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750904,
					"content": "Como o vento leva esse aroma de tão longe! Doce Barbatos, é verdade! Vinho de Dandelion!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750905
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 766750905,
					"content": "Ainda por cima, é um lote especial da Adega do Alvorecer! Elas voltaram... todas as minhas lembranças mais queridas... estão todas voltando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750906
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750906,
					"content": "Ahm... Então, as boas-vindas não eram para a gente, né...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750907,
					"content": "Sim, é isso, esse é o sabor... Está exatamente como eu me lembrava!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750908
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750908,
					"content": "Incrível, depois de tantos anos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750909
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 766750909,
					"content": "Eu já estava achando que tinha esquecido o gosto de uma boa safra da Adega do Alvorecer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750910
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750910,
					"content": "Se o sabor continua o mesmo... então a minha casa lá no Vale Termal provavelmente também continua igual... não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750911,
						766750912
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750911,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750913
					]
				},
				{
					"id": 766750913,
					"content": "#...Obrigado, Cavaleir{F#a}{M#o} Honorável!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750914
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750914,
					"content": "...Já chega, acalmem-se, pessoal. Os barris vão ficar lacrados até todo mundo voltar. Enquanto isso, vamos terminar os preparativos da festa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750915
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750915,
					"content": "Sim, senhor! É para já, senhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750916
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750916,
					"content": "...Como eu disse, beber é o assunto mais sério entre todos os assuntos sérios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750917
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750917,
					"content": "Aaaah... Carne Frita com Cenoura e Mel... Frango Assado com Mel... Paimon nunca achou que fosse comer pratos de Mondstadt tão autênticos por essas bandas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750918,
					"content": "Ah, espera, cadê o Varka? Alguém viu ele? Ele não pode estar caído de bêbado em alguma valeta por aí, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750919,
						766750920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750919,
					"content": "Com a resistência do fígado dele, isso é mesmo possível?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750921
					]
				},
				{
					"id": 766750921,
					"content": "Beleza... A Paimon alcança vocês assim que terminar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750920,
					"content": "Vou lá procurar ele, você pode continuar comendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750921
					]
				},
				{
					"id": 766750912,
					"content": "Continua igual, eu estive lá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750913
					]
				}
			]
		},
		{
			"id": 7667510,
			"completionStepIds": [
				7667510
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
