			"dialogs": [
				{
					"id": 701140101,
					"content": "É realmente uma rara ocasião a Srta. Sandrone reservar tempo para visitar Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140102
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140102,
					"content": "Você me ajudou muito enquanto eu pesquisava a matriz numerológica. Eu queria agradecer pessoalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140103,
					"content": "Você é gentil demais. Esse tipo de coisa está muito além da minha área de especialidade, o mérito por concluí-la é todo seu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140104,
					"content": "Foi um esforço em equipe. Hmm... Pensando bem, onde está Durin? Já que você é praticamente o guardião dele, achei que ele não conseguiria se afastar muito de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140105
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140105,
					"content": "Você não está completamente errada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140106,
					"content": "Mas, ultimamente, ele tem melhorado bastante as habilidades sociais, então dei a ele mais liberdade para organizar a própria rotina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140107,
					"content": "Você não está preocupado com ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140108,
					"content": "Um pouco. No passado, quando ele ficava sozinho e interagia com alguém de personalidade... digamos, \"forte\", ele costumava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140109,
					"content": "Adquirir hábitos estranhos? Imitar tiques verbais incomuns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140110,
					"content": "Exatamente. Presumo que tenha passado por algo parecido, Srta. Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140111,
					"content": "Hmph, isso ainda precisa ser perguntado? Sou praticamente uma especialista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140112,
					"content": "Normalmente, depois de uma reunião com o Grande Mestre Varka, eu levo Durin para visitar Sucrose e ajudar com a pesquisa dela. Isso permite que ele acalme a mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140113
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140113,
					"content": "Mas se ele passar tempo demais com a Grande Mestra Interina Jean, fazemos uma visita à Klee para que ele possa redescobrir como relaxar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140114
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140114,
					"content": "Parece muito trabalho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140115
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140115,
					"content": "É só cuidar da minha família.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140116,
					"content": "Como você lidaria com situações assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140117,
					"content": "Eu? Eu não tenho energia para lidar com esse tipo de confusão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140118,
					"content": "Mas parece que, se uma pessoa é boa por natureza, não importa o quanto ela seja influenciada, ela sempre voltará ao seu verdadeiro eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140119
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 701140119,
					"content": "Hmm... Excelente observação. Talvez eu possa adotar esta maneira de pensar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
