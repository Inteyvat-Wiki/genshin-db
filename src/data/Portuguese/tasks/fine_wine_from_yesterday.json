			},
			"dialogs": [
				{
					"id": 705050101,
					"content": "Oh, é o Mestre Diluc! O que o traz aqui? Você não tem nada para fazer hoje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050102,
					"content": "Hnf, eu? \"Nada para fazer\"? Nada disso. Ouvi que vocês estavam trabalhando como bartenders, então pensei em vir ver como estavam se saindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050103
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050103,
					"content": "Uau, você realmente fica sabendo rápido das coisas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050104,
					"content": "#Então, diga-me, {NICKNAME}. Você está gostando de ser {M#um}{F#uma} bartender?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050105
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050105,
					"content": "Na verdade, acabamos de começar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050106
					]
				},
				{
					"id": 705050106,
					"content": "Sim, ainda é meio cedo para dizer. Ainda não estamos nisso por muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050107,
					"content": "Apenas me diga sua primeira impressão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050108
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050108,
					"content": "#Animad{M#o}{F#a}? Confus{M#o}{F#a}? Qualquer coisa. Como você se sente sendo {M#um}{F#uma} bartender?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050109,
						705050110
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050109,
					"content": "É uma experiência nova...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050111
					]
				},
				{
					"id": 705050111,
					"content": "Então é isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050112
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050112,
					"content": "Ei, você não vai perguntar a Paimon também!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050113,
					"content": "A primeira impressão da Paimon é... bebidas são gostosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050115
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050115,
					"content": "Ótimo. Fico feliz por você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050116
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050116,
					"content": "Então, você poderia me fazer um Crepúsculo Cinza do Vale? Deixarei o tamanho contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050117
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050117,
					"content": "Entendido. Já está indo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050118
					]
				},
				{
					"id": 705050118,
					"content": "Ótimo, leve o tempo que precisar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050110,
					"content": "Tem sido um pouco agitado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050111
					]
				}
			]
		},
		{
			"id": 7050502,
			"completionStepIds": [
				7050503
