			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705050201,
					"content": "Hmm. Nada mal, nada mal mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050202
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050202,
					"content": "É tudo questão de ingredientes! Se as frutas estão frescas e viçosas, então a bebida naturalmente será doce e gostosa sem colocar nada mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050203,
					"content": "Parece que eu deveria agradecer ao solo de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050204
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050204,
					"content": "Acontece que o Crepúsculo Cinza do Vale foi a primeira bebida que preparei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050205
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050205,
					"content": "Eu ainda era muito jovem. Meu pai me deu vários ingredientes e me disse para experimentar com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050206
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050206,
					"content": "Sem exigências e sem instruções. Pensando bem, ele provavelmente só queria testar minha criatividade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050207
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050207,
					"content": "No fim, só fiz um copo de ponche de fruta, muito parecido com este.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050208,
					"content": "Oh? Mas por que ponche de fruta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050209,
					"content": "Meu pai também ficou bem surpreso. Eu não pensei muito nisso, apenas achei que seria gostoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050210
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050210,
					"content": "Pensando nisso agora, eu era tão jovem e inocente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050211
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050211,
					"content": "Eu não tenho tanta certeza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050212
					]
				},
				{
					"id": 705050212,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050213,
						705050214
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050213,
					"content": "Tenho certeza que seu pai achou que era uma boa bebida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050215
					]
				},
				{
					"id": 705050215,
					"content": "Nunca pensei nisso, acho que... meu pai não disse nada na hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050216
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050216,
					"content": "Mas, obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050217
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050217,
					"content": "A propósito, tem algo que eu gostaria de te dar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050218
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050218,
					"content": "Mas, imagino que é melhor esperar você ter mais experiência com seu trabalho como bartender. Não tenho dúvidas que vai se sair muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050219
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050219,
					"content": "E Paimon vai... uh, ficar torcendo por você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050220,
					"content": "Muito bem, então. Estou ansioso para ver seu bom trabalho. Te vejo por aí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050221
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050221,
					"content": "Volte logo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050214,
					"content": "Ele deve ter gostado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050215
					]
				}
			]
		}
	]
}