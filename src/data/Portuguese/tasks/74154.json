							4514.881
						],
						"pointId": 7529
					}
				]
			},
			"dialogs": [
				{
					"id": 741540701,
					"content": "Considerando o quão persistente vocês são, eu não esperava que vocês simplesmente deixariam por isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540702
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540702,
					"content": "Eu achei que vocês iriam correndo para a Maison Gardiennage, mas não foram. Parece que vocês têm algumas ideias próprias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540703,
						741540704
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540703,
					"content": "Por que vocês estão mantendo Benoit aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				},
				{
					"id": 741540705,
					"content": "Para falar a verdade, estou começando a admirar vocês. Se vocês pelo menos colocassem seu entusiasmo para um melhor uso, vocês teriam um futuro brilhante à frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540706
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540706,
					"content": "É uma pena que vocês não vão a lugar nenhum com isso. *Suspira* Vocês não estão mesmo com medo, estão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540707
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540707,
					"content": "Você escolheu a pessoa errada para intimidar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540708
					]
				},
				{
					"id": 741540708,
					"content": "Oh? Então você realmente não faz ideia do que está acontecendo aqui, ou será por que você acha que está do lado da justiça?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540709
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540709,
					"content": "Por acaso, o comerciante que dizem que se afogou na notícia agora pouco — seu nome era Brandt. Aquele sujeito realmente tinha jeito com as palavras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540710
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540710,
					"content": "Adivinha só? De acordo com o relatório, acontece que ele não se afogou, na verdade, foi assassinado e jogado no lago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540711
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540711,
					"content": "Depois de uma longa investigação, tudo que o Marechalato Fantasma conseguiu descobrir é que ele foi assassinado e que o assassino era culpado de um crime hediondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540712
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540712,
					"content": "Então foi isso que a notícia disse. Quem sabe o que realmente aconteceu, ou qual dos dois merecia morrer mais — o assassino ou a vítima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540713
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540713,
					"content": "Hmm... é uma pergunta difícil, e eu ainda não decidi qual é a resposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540714
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540714,
					"content": "Enfim, estou divagando! Isso não tem nada a ver com o que precisamos discutir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540715
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540715,
					"content": "O que você está tentando dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540716,
					"content": "Estou dizendo que agir precipitadamente antes de ter compreendido totalmente a situação é imbecil, e pode causar algumas consequências indesejáveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540717,
						741540718
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540717,
					"content": "Testemunhar injustiça e não fazer nada... isso é verdadeira loucura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540719,
					"content": "Haha... bem, talvez se tivéssemos nos conhecido em circunstâncias diferentes, teríamos sido amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540720
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540720,
					"content": "Embora eu goste da forma como você pensa, tenho coisas a fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540721
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540721,
					"content": "Estou no fim da linha agora. Da próxima vez que eu vir vocês dois perto da minha casa, farei algo a respeito — guardem minhas palavras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540722
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741540722,
					"content": "Depois de resmungar algo inexplicável, Atos vai embora.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540723
					]
				},
				{
					"id": 741540723,
					"content": "A atitude bizarra dele te surpreende e você começa a se perguntar qual posição você deveria tomar nesse assunto...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540724
					]
				},
				{
					"id": 741540724,
					"content": "De repente, você ouve um leve som de batida vindo da janela de trás, e depois, um rangido quase inaudível, uma nota cai da janela...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540725
					]
				},
				{
					"id": 741540725,
					"content": "Tem uma escrita marrom na nota. Parece que alguém escreveu apressado, e parece que usaram café para isso...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540726
					]
				},
				{
					"id": 741540726,
					"content": "Rápido, veja o que diz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540727,
					"content": "É do Benoit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540728,
					"content": "Shhh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540729
					]
				},
				{
					"id": 741540729,
					"content": "...Desculpe! Enfim, vamos ficar de olho na vasilha do gato e esperar pelo sinal dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540718,
					"content": "Sempre que vejo injustiça, eu faço algo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540704,
					"content": "Qual relação vocês têm com Benoit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				}
			]
		},
