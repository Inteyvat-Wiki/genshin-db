			},
			"dialogs": [
				{
					"id": 741540201,
					"content": "Algo está estranho, tem algo suspeito... Até Paimon consegue ver que tem algo suspeito acontecendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540202,
					"content": "#{NICKNAME}, você está bem atent{M#o}{F#a}. O que deveríamos fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540203,
						741540204,
						741540205,
						741540206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540203,
					"content": "Benoit quer ajuda, mas insiste que não...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540207,
					"content": "Então que tal darmos uma outra olhada perto da casa de Benoit? Não tinha uma caixa estranha perto da sua janela de trás?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540208,
					"content": "Definitivamente tem alguma coisa escondida lá, e talvez seja a prova que estamos procurando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540204,
					"content": "Talvez aquele casal seja do Fleuve Cendre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540205,
					"content": "Pelas suas reações, eu diria que estão fazendo algo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540206,
					"content": "Eu tenho algumas teorias, mas nenhuma evidência por trás delas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				}
			]
		},
