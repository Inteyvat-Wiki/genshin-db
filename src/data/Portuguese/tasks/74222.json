	"talks": [
		{
			"id": 7422201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422201",
							"2"
						],
						"stepId": 7422201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Moce"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220101,
					"content": "#Fique de guarda, cidad{M#ão}{F#ã}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220102,
						742220106,
						742220109,
						742220116
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220102,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220103
					]
				},
				{
					"id": 742220103,
					"content": "Eu? É como você pode ver. Estou ocupado lidando com a ameaça bárbara! Eles andam aumentando suas ofensivas — talvez eles até enviem espiões!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220104
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220104,
					"content": "Isso não é um assunto trivial! A vigilância deve ser mantida até que reforços cheguem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220105
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220105,
					"content": "#Se houver mais alguma coisa, por favor, comente com o meu assistente, cidad{M#ão}{F#ã}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220106,
					"content": "Uma criança, por aqui por conta própria...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220107
					]
				},
				{
					"id": 742220107,
					"content": "Hmm? Uma criança? Onde? Algum soldado novo quebrou as ordens e trouxe sua família para o acampamento de novo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220108
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220108,
					"content": "*Suspira* Dominus Cassiodor é muito gentil com os novatos. Se isso fosse acontecer três décadas atrás, um Tribunus já teria um chicote em mãos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220109,
					"content": "Coisas suspeitas aconteceram recentemente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220110
					]
				},
				{
					"id": 742220110,
					"content": "Não no momento. Dito isso, os bárbaros são como bestas traiçoeiras. Eles sempre atacam quando sua guarda está baixa, pois a surpresa é o melhor ataque deles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220111
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220111,
					"content": "Através de métodos sujos eles se infiltram em nossas cidades e vasculham por nossos segredos. Até mesmo o menor dos descuidos pode causar uma catástrofe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220112
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220112,
					"content": "*Suspira* Trinta anos atrás, quando eu segui Dominus Boethius em uma expedição bem ao norte, eles não eram nada além de um grupo de primitivos sem nenhuma habilidade de subterfúgio. Onde eles aprenderam esses truques?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220113
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220113,
					"content": "Trinta anos atrás... Seus parentes ainda não tinham nascido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220114
					]
				},
				{
					"id": 742220114,
					"content": "#Hmm? O que você disse, cidad{M#ão}{F#ã}? Infelizmente minha audição tem piorado com a idade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220115
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220115,
					"content": "*Suspira* O tempo é realmente cruel. Durante a conquista de Bituria, eu conseguia ouvir os gongos de reunião dos bárbaros a quilômetros de distância.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220116,
					"content": "Adeus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220117
					]
				},
				{
					"id": 742220117,
					"content": "#Adeus, cidad{M#ão}{F#ã}! Você pode reportar pessoas suspeitas para mim a qualquer momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				}
			]
		},
		{
			"id": 7422202,
			"completionStepIds": [
				7422202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422202",
							"2"
						],
						"stepId": 7422202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Giovanni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220201,
					"content": "*Suspira* Me pergunto quando essa guerra finalmente irá terminar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220202
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220202,
					"content": "O que você está fazendo no telhado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220203
					]
				},
				{
					"id": 742220203,
					"content": "#Hmm? Estou monitorando a área para qualquer atividade bárbara suspeita, é claro! Recentemente... Espera aí, como foi que VOCÊ chegou nessa torre de vigia, cidad{M#ão}{F#ã}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220204
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220204,
					"content": "Ei, eu quem digo isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220205
					]
				},
				{
					"id": 742220205,
					"content": "*Suspira* Tanto faz, isso não é importante. Tribunus Mettius diz que os selvagens estão avançando espaço em seus ataques. As notícias mais recentes é de que eles podem enviar espiões entre nós. Então, temos que ficar de guarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220206
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220206,
					"content": "Mas, esses bárbaros estariam realmente interessados em uma cidadezinha remota? Do nível que eles enviariam espiões?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220207
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220207,
					"content": "Carne é carne, não importa o quão pequena.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220208
					]
				},
				{
					"id": 742220208,
					"content": "#Ah, cidad{M#ão}{F#ã}, você fala a verdade! Parece que devo continuar em minha tarefa. Hmm... Ao julgar por como você falou, você parece ter experiência no assunto, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220209
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220209,
					"content": "Nesse caso, posso te pedir para vistoriar a área ao redor? Caso os bárbaros estejam por aí, eles devem ter deixado algum rastro. Como uma espada de madeira, talvez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220210
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220210,
					"content": "Uh, tipo crianças brincando de luta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220211
					]
				},
				{
					"id": 742220211,
					"content": "Bem, eles *são* selvagens. É tão estranho eles usarem galhos como armas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220212
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220212,
					"content": "#De qualquer forma, estou contando com você. Caso você descubra algo, reporte para mim —  considere seu incrível dever como {M#um Remuriano}{F#uma Remuriana}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Giovanni"
				}
			]
		},
		{
			"id": 7422207,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
