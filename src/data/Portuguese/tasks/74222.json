			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Giovanni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220701,
					"content": "#Você fez alguma descoberta, cidad{M#ão}{F#ã}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220702,
						742220703
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220702,
					"content": "Encontrei algumas coisas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 742220703,
					"content": "Sem estresse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220704
					]
				},
				{
					"id": 742220704,
					"content": "Fique bem! Fale comigo caso qualquer coisa aconteça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Giovanni"
				}
			]
		},
		{
			"id": 7422208,
			"completionStepIds": [
				7422208,
				7422209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422208",
							"2"
						],
						"stepId": 7422208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Giovanni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220801,
					"content": "E pensar que... Não pode haver erros. Esse é um dos postes de sinal que os bárbaros usam para enviar suas mensagens malditas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220802,
						742220803
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220802,
					"content": "É verdade?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220804
					]
				},
				{
					"id": 742220804,
					"content": "*Suspira* Não consigo acreditar que os espiões deles realmente se infiltraram em nossos ranques. Parece que os medos de Tribunus Mettius não eram sem fundamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220805
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220805,
					"content": "Uma vez que eu reporte esse assunto para ele, será meu dever concluído.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220806
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220806,
					"content": "#De qualquer forma, você tem meus agradecimentos, cidad{M#ão}{F#ã}. Se não fosse por você, nossas defesas poderiam ter sido destruídas antes mesmo das hordas chegarem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220807
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220807,
					"content": "Eu certamente vou mencionar sua contribuição ao fazer meu relatório.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220803,
					"content": "Você disse agora pouco que era uma espada de madeira...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220804
					]
				}
			]
		}
	]
}