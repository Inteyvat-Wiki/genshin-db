			"dialogs": [
				{
					"id": 726990101,
					"content": "Não sei como é a sua habilidade como espadachim. Estou muito ansioso por essa batalha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990102
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990102,
					"content": "Hã, o que você está fazendo aqui...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990103
					]
				},
				{
					"id": 726990103,
					"content": "Na verdade, quando eu disse que 4 guerreiros tinham se inscrito, eu estava me incluindo nessa lista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990104
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990104,
					"content": "Sou o organizador, sim, mas tinham pouquíssimos participantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990105
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990105,
					"content": "#E de qualquer forma, eu nasci para lutar! E já que tenho {M#um}{F#uma} formidável desafiante bem em minha frente, tenho que ter o meu duelo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990106
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990106,
					"content": "...Hehe, estou esperando por isso tem um bom tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990107
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990107,
					"content": "Hã, Paimon não tem certeza se ele bate muito bem da cabeça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726990108,
					"content": "Mas não devemos subestimar o inimigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990109
					]
				},
				{
					"id": 726990109,
					"content": "Exatamente. Sua forma de tratar todos os seus oponentes igualmente é o que me fez sentir respeito por você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990110
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990110,
					"content": "Se eu não tivesse subestimado nosso quarto desafiante, eu não teria sofrido uma derrota tão vergonhosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990111
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990111,
					"content": "#Mas o homem que eu sou hoje, não é o mesmo de ontem! Pois então venha, {NICKNAME}, vamos lutar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990114,
						726990112
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990114,
					"content": "Venha se tiver coragem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990115
					]
				},
				{
					"id": 726990115,
					"content": "Venha se tiver coragem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990112,
					"content": "Me dê um momento para me preparar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990113
					]
				},
				{
					"id": 726990113,
					"content": "Entendo. Tome o tempo que precisar para se preparar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasuhiko Tarou"
				}
			]
		}
	]
