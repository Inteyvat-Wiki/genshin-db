					"nextDialogs": [
						708160303
					]
				},
				{
					"id": 708160303,
					"content": "Ufa, que alívio. Eu sempre usei este mapa, por isso coloquei muitos marcadores nele. Perdê-lo teria sido um desastre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708160304
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 708160304,
					"content": "E se eu tivesse realmente perdido o meu manual, não faço ideia de como pediria um novo à Katheryne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708160305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 708160305,
					"content": "Quero dizer, que piada, um aventureiro perder seu manual durante uma aventura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708160306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 708160306,
					"content": "Obrigado, deixarei estas coisas mais bem guardadas daqui em diante. Por favor, pegue isto como forma do meu agradecimento.",
