			"dialogs": [
				{
					"id": 745310101,
					"content": "#{NICKNAME}, Paimon, vocês voltaram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310102,
						745310103
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310102,
					"content": "Tirei muitas fotos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				},
				{
					"id": 745310104,
					"content": "Isso é ótimo! Muito obrigada pela sua ajuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310105
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310105,
					"content": "Enquanto você estava tirando as fotos, comecei a pensar que não posso ficar parada sem fazer nada, ou então nunca irei progredir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310106
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310106,
					"content": "Por isso tomei a coragem de perguntar a algumas pessoas para ajudar, e até mesmo tirei umas fotos! Acho que devo ter mais do que dados suficientes de teste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310107
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310107,
					"content": "#Hehe, eu sabia que você não ia me desapontar! E tudo graças a {NICKNAME} também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310108
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310108,
					"content": "Lepine-Pauline! Quando você voltou? Ninette disse que você estava ocupada com algo ultimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745310109,
					"content": "Bem, claro. O suficiente para encher meus bolsos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310110
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310110,
					"content": "Eu tava bem corrida nesses dias, por isso estou muito feliz que vocês estavam aqui para ajudar Ninette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310111
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310111,
					"content": "Ela tem talento e gosto. É só tímida. Mas com sua ajuda, ela deu um grande passo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310112
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310112,
					"content": "Então, o que é esse grande negócio que você tá sendo misteriosa? Não diga pra Paimon que você ouviu outro boato e foi com tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745310113,
					"content": "O quê? Claro que não! Eu já aprendi minha lição. Dessa vez é de verdade, com certeza vou fazer uma fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310114
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310114,
					"content": "(Isso não soa lá muito convincente...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310115
					]
				},
				{
					"id": 745310115,
					"content": "#Hehe, se eu contar para você, vai estragar a surpresa. Vocês serão {F#as primeiras}{M#os primeiros} a experimentarem quando tudo estiver pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310103,
					"content": "Essa lente de Obturação funcionou muito bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				}
			]
		}
	]
