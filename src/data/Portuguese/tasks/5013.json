			"dialogs": [
				{
					"id": 50130801,
					"content": "O território dos Filhos dos Ecos está seguro. Todos os monstros foram eliminados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130802
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 50130802,
					"content": "Vou lidar com o Tumor do Abismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130803
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 50130803,
					"content": "Tudo de boa aqui no Povo das Termas também. A gente detonou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130804
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50130804,
					"content": "Os Mestres do Vento Noturno também estão seguros. Será que devo ir ajudar o Clã das Plumas de Flores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130805
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 50130805,
					"content": "As coisas ainda estão bem sérias lá. Já estou a caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130806
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50130806,
					"content": "Não precisa. Acabei de resolver aquilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130807
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 50130807,
					"content": "Já?! Mas você tava no Estádio ainda agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50130808,
					"content": "Bem, sim. Vocês não fazem ideia de quanto tempo espero para arrebentar umas cabeças.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130809
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 50130809,
					"content": "Ah... D-De boa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50130810,
					"content": "Iansan, o que devemos fazer em relação ao Coletivo da Fartura? Sua casa fica muito distante do Estádio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130811
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50130811,
					"content": "Ah, não precisa se preocupar. Acabei de ter notícias de Varesa, ela disse que eles estão seguros agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130812
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50130812,
					"content": "Parece que todas as regiões estão seguras. As forças do Abismo estão enfraquecendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130813
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50130813,
					"content": "É! O único plano deles era ter mais número do que nós, e isso não vai funcionar agora que temos a Ode da Ressurreição ao nosso lado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50130814,
					"content": "Esperem... O Abismo está mandando uma unidade enorme em direção ao Estádio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130815
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50130815,
					"content": "Acho que eles perceberam que a Ode da Ressurreição virou o jogo, então estão indo tentar destruir a Chama Sagrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130816
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50130816,
					"content": "Não vamos deixar eles se safarem. Amigos, vamos nos reunir no Estádio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130817
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50130817,
					"content": "Mais Tumores do Abismo desceram, todos perto do Estádio. Vamos nos dividir e destruí-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130818
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 50130818,
					"content": "Ah, e precisamos de alguém para proteger a entrada principal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130819
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 50130819,
					"content": "Deixem comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50130820
					]
				},
				{
					"id": 50130820,
					"content": "Tudo bem. Essa é a batalha final!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		}
	]
}