			"dialogs": [
				{
					"id": 400315201,
					"content": "Deixe os animais que forem encontrados comigo. Vou levá-los para casa o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315202,
						400315207,
						400315210
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315202,
					"content": "O que você pode me dizer sobre a Sombra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315203
					]
				},
				{
					"id": 400315203,
					"content": "Já ouvi falar de uma organização secreta que treina Ninken, ou cães ninja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315204
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315204,
					"content": "Dizem que um desses cães, com o codinome Inujin, destruiu inúmeros monstros que ameaçavam Inazuma pelas sombras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315205
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315205,
					"content": "...É claro, isto é apenas uma lenda. Ainda assim, me pergunto se este tal de Sombra poderia ser o lendário ninken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315206,
					"content": "Tanto faz. Eu não deveria criar desculpas para minhas derrotas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315207,
					"content": "Então, conte-me sobre as distrações que você criou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315208
					]
				},
				{
					"id": 400315208,
					"content": "Eu não consegui salvar os animais enquanto fugiam de seu abrigo, mas enquanto eu estava vigiando, eu consegui tempo para colocar alguns dispersores de fumaça por perto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315209
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315209,
					"content": "Se você ativar esses mecanismos, deverá ser capaz de desviar temporariamente sua atenção. Espero que eles ajudem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315210,
					"content": "Voltarei logo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315211
					]
				},
				{
					"id": 400315211,
					"content": "Ótimo, obrigado. Ficarei de guarda aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
