			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310301,
					"content": "Segundo as nossas atuais investigações, este deve ser o lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310302
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310302,
					"content": "Hã, há realmente um montão de criaturinhas aqui. Será que todas elas são as desaparecidas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310303,
					"content": "E isso é um... Cão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310304,
					"content": "Tem um cachorro protegendo o lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310305,
					"content": "Hã, então foi isso. Hmm... Isso é vergonhoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310306
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310306,
					"content": "Hã? Sobre o que você está envergonhado, Ryuuji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310307,
					"content": "...Este cachorro é a \"sombra\" que me derrotou de uma só vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310308,
						400310310
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310308,
					"content": "Não se preocupe, talvez fosse apenas um cachorro muito forte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310309
					]
				},
				{
					"id": 400310309,
					"content": "Não precisa... Me confortar desta forma. Minhas habilidades estão bastante desprovidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310312
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310312,
					"content": "Ainda assim, essa postura erguida e esse orgulho arrogante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310313,
					"content": "Hã, isso não te lembra alguém?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310314,
						400310315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310314,
					"content": "Sim. Na Casa de Chá Komore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310316
					]
				},
				{
					"id": 400310316,
					"content": "Exatamente! Paimon pensou nele também! Pensamos até mesmo que ele podia falar. O que é uma pena, pois na verdade, ele não pode.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310317,
					"content": "Você está falando do dono da Casa de Chá Komore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310318
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310318,
					"content": "Você conhece ele, Ryuuji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310319,
					"content": "Um pouco. Eles realmente são parecidos, isso é certeza. Não devemos baixar nossa guarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310320
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310320,
					"content": "Taroumaru é conhecido por ser amigável devido às suas muitas relações com os humanos. Mas quanto a este cão, nós não sabemos nada sobre ele. Por isso, aconselho cautela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310321
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310321,
					"content": "Hmm, bom ponto, Ryuuji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310322,
					"content": "É apenas a experiência falando, nada mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310323
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310323,
					"content": "Ainda assim, por qual motivo este cachorro iria juntar todos estes animais e proteger este lugar? Paimon não consegue entender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310324,
					"content": "Talvez precisemos de mais pistas para descobrir isso. Por enquanto, vamos nos concentrar em salvar estes animais. Seus donos estão começando a entrar em pânico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310325
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310325,
					"content": "#É aqui que você entra, {NICKNAME}. Eu cuidarei do que vier depois que você encontrar os animais. Farei com que eles sejam levados para casa o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310326
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310326,
					"content": "Não vamos nos juntar e atacar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310327
					]
				},
				{
					"id": 400310327,
					"content": "Ainda não sabemos se este inimigo pode ser derrotado com um \"ataque em equipe\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310328
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310328,
					"content": "...Na verdade, você tem alguma experiência em \"furtividade\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310329,
						400310330,
						400310331
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310329,
					"content": "Bem, quando tentamos roubar a Lira Sagrada der Himmel...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310332,
					"content": "...Isso... Deve ter sido uma experiência interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310333
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310333,
					"content": "De qualquer forma, devemos ser capazes de resgatar os animais se pudermos evitar com segurança o guarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310334
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310334,
					"content": "Posicionei alguns objetos que podem atrair sua atenção. Espero que eles sejam úteis para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310335
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310335,
					"content": "Muito bem, então. Vamos lá. Ficarei de guarda aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310330,
					"content": "#Evitamos de ser capturad{M#o}{F#a}s uma vez no Ritual de Descendência...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310331,
					"content": "Perseguimos um certo funcionário do governo lá em Ritou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310315,
					"content": "Taroumaru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310316
					]
				},
				{
					"id": 400310310,
					"content": "Hã, então você é meio que uma porcaria, não é, Ryuuji?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310311
					]
				},
				{
					"id": 400310311,
					"content": "Ei! O cachorro era apenas muito forte, só isso! Paimon duvida que ela ganharia também, sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310312
					],
					"speakerTitle": "Paimon"
				}
			]
		},
