				{
					"id": 400310501,
					"content": "Impressionante! Você realmente tem movimentos espetaculares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310502
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310502,
					"content": "#Sim, isso é moleza para {M#o}{F#a} {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310503,
					"content": "Bem, vamos então para o próximo alvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310504
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310504,
					"content": "Hã? Ainda tem mais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310505,
					"content": "Claro. Da quantidade de casos que a senhorita Sango recebeu, esse é o maior da história de Inazuma sobre animaizinhos perdidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310506
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310506,
					"content": "Digo isto, mas a julgar pela história, ter animaizinhos pequenos desaparecendo de uma só vez é simplesmente anormal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310507
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310507,
					"content": "Eu segui os rastros que detectei para outras áreas, e encontrei animais presos lá também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310508
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310508,
					"content": "Ainda é necessário fazer uma infiltração?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310509
					]
				},
				{
					"id": 400310509,
					"content": "Dessa vez não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310510
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310510,
					"content": "Os adversários lá não devem ser páreos às suas habilidades. Você saberá quando chegar lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
