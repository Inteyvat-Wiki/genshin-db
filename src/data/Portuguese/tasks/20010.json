					"nextDialogs": [
						200100306
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 200100306,
					"content": "Oh, eu acho que ele me entendeu! Parece que ele está querendo nos mostrar alguma coisa...",
