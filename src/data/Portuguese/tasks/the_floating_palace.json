				"points": []
			},
			"dialogs": [
				{
					"id": 10200101,
					"content": "Olhe, lá em cima! Aquela é a Câmara de Jade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200102,
						10200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200102,
					"content": "Tão alto",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200104
					]
				},
				{
					"id": 10200104,
					"content": "Você é... Uhh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200105,
					"content": "Ah, isso é ruim... Paimon deveria ser seu guia, mas Paimon não sabe onde fica o caminho até a Câmara de Jade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200106,
						10200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200106,
					"content": "Descobriu isso só agora, é...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200108
					]
				},
				{
					"id": 10200108,
					"content": "Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200109,
					"content": "Todavia, agora que vamos para a Câmara de Jade, ir para sua localização no mapa é o mais sensato a se fazer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200110,
					"content": "Vamos dar uma olhada ao redor. Tem que haver um caminho até lá em cima por perto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200107,
					"content": "Deveríamos ter perguntado a emissária, Ganyu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200108
					]
				},
				{
					"id": 10200103,
					"content": "A questão é: como chegaremos lá em cima?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200104
					]
				}
			]
		},
		{
			"id": 102002,
			"completionStepIds": [
				102002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102002",
