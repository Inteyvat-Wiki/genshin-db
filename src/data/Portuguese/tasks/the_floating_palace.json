			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huaqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200401,
					"content": "Parado ai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200402
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200402,
					"content": "Quem ousa invadir este território sagrado!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200403,
						10200404
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200403,
					"content": "Só estamos de passagem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				},
				{
					"id": 10200405,
					"content": "Exato, não entendo nada do que vocês estão falando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200406,
					"content": "Nós recebemos um convite, somos convidados! Por que estão nos tratando dessa forma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200407,
					"content": "Não... Espera... Será que isso é um plano de Ningguang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200408,
					"content": "Ela fingiu nos convidar para a Câmara de Jade, mas escondeu uns Millelith para nos pegar de surpresa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200409,
						10200410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200409,
					"content": "Eu acho que não...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200411,
					"content": "Arg - Agora Paimon está furiosa! ... Você! Isso, você aí! Isso é uma pegadinha, não é? Que sem-vergonha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200412,
					"content": "O quê? Apenas estamos de guarda. O que você quer dizer com \"sem-vergonha\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200413
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200413,
					"content": "Quanta besteira! Apreendam imediatamente estes intrusos suspeitos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200414
					],
					"speakerTitle": "Yang"
				},
				{
					"id": 10200414,
					"content": "Bem, lá vem eles - vamos derrotá-los de uma vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200410,
					"content": "Ainda não explicamos o convite para eles...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200404,
					"content": "Território sagrado? Essas são só as redondezas selvagens do Monte Tianheng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				}
			]
		},
		{
			"id": 102006,
			"completionStepIds": [
				102006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102006",
							"2"
						],
						"stepId": 102006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200601,
					"content": "Parem! Do que se trata tudo isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200602
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200602,
					"content": "Senhora Keqing, essas duas pessoas estranhas apareceram de repente. Eles parecem ter planos de fazer algo na Balista Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200603
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200603,
					"content": "Qu-Quem você está chamando de \"estranha\"!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200604,
					"content": "Estávamos apenas procurando por um caminho até a Câmara de Jade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200605
					]
				},
				{
					"id": 10200605,
					"content": "Hmm? Você quer ir até a Câmara de Jade? Quem é você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200606
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200606,
					"content": "#Nós fomos convidad{M#o}{F#a}s, estamos aqui para procurar os Qixing de Liyue! Quem é você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200608
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200608,
					"content": "Bem, por um acaso, eu sou um dos Qixing de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200609
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200609,
					"content": "???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200610,
					"content": "Eu sou Keqing, a Yuheng dos Qixing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200611
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200611,
					"content": "#Eu sei quem é você, Viajante. Você é {M#o}{F#a} convidad{M#o}{F#a} da Ningguang, não é? Não esperava encontrá-l{M#o}{F#a} aqui nas montanhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200612
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200612,
					"content": "Uau... Paimon também não imaginou que nos encontraríamos uma pessoa super rica e importante aqui no meio do nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200613,
					"content": "A Balista Guizhong da Passagem de Tianheng quebrou, mas foi consertada apenas em uma noite! Estou aqui para dar uma pesquisada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200614
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200614,
					"content": "Estes Millelith estão aqui apenas para vigiar a área, não para prender ninguém.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200615
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200615,
					"content": "Então, tudo isto foi um mal-entendido? Paimon nunca teria imaginado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200616,
					"content": "Pensar não é tão difícil, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200617
					]
				},
				{
					"id": 10200617,
					"content": "Digamos assim, o mecanismo feito pelos Adepti foi consertado por um mortal. Até para a Qixing, é algo raro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200618
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200618,
					"content": "Hehe, isso foi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200619,
						10200620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200619,
					"content": "(Shhh, Paimon, não complique as coisas!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				},
				{
					"id": 10200621,
					"content": "Ei? Ah... Sim... A senhora Yuheng, você sabe por que a Tianquan nos convidou para a Câmara de Jade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200622,
					"content": "Apenas me chame de Keqing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200623
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200623,
					"content": "#A Ningguang quer que você fique mais neutro, como {M#um herói}{F#uma heroína}, razão pela qual ela marcou um encontrou com você... Melhor dizendo, era para você não ficar totalmente do lado dos Adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200624
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200624,
					"content": "Não estamos tomando partido. Falamos com os Adepti. Eles estão procurando proteger Liyue também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200625,
					"content": "Quando você diz \"proteger\", você se refere à arrogância hipócrita deles, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200626
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200626,
					"content": "Ei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200627,
					"content": "Porque vocês são mortais, aqueles que eles protegem. Razão pela qual eles não lhe consideram \"um assassino com capacidade de matar o arconte\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200628
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200628,
					"content": "Eles devem achar que tudo que a Ningguang fez era inútil, ou até estava disfarçando a verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200629
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200629,
					"content": "Vou dizer com clareza: Eles estão nos subestimando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200630
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200630,
					"content": "Bem, você tem um ponto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200631,
					"content": "Ainda assim, esta é a primeira vez que Paimon vê uma pessoa de Liyue que não respeita os deuses ou os Adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200632,
					"content": "Hã? Eles não têm senso de tempo, e são sempre arrogantes para os mortais, portanto, podemos dar um suspiro de alívio por não agirem contra a Qixing. Você quer dizer que é isso que eu admiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200633
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200633,
					"content": "Esqueça. Eu não deveria falar deles desta maneira. Este ceticismo é só meu, e Ningguang não o compartilha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200634
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200634,
					"content": "De qualquer forma, admito que as ações dos Adepti desta vez foram bastante restringidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200635
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200635,
					"content": "O falecimento do Rex Lapis é algo excepcional. Embora enfrentem uma circunstância anormal, eles decidiram convocar todos os Adepti para negociar em vez de discutir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200636
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200636,
					"content": "Que estranhamente civilizado da parte deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200637,
						10200638
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200637,
					"content": "Alguma chance de você poder conversar com eles?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200639,
					"content": "Para a Ningguang, é melhor nos sentarmos e negociarmos - mas isso é impossível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200640
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200640,
					"content": "O Tempo dos Adepti já passou. Se mesmo os Qixing de Liyue não querem encarar essa verdade, então qual futuro existe para Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200641
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200641,
					"content": "Uff... Outra declaração super ousada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200642,
					"content": "#*Suspiro* Ficamos por aqui então. Não devia ter contado tanto, mas você é {M#um bom}{F#uma boa} ouvinte, Viajante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200643
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200643,
					"content": "Bom. Devem partir agora para a Câmara de Jade. Não se atrasem! Os encontros com a Ningguang já foram marcados para o ano que vem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200644
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200644,
					"content": "Para os comerciantes da primeira classe, subir até Câmara de Jade é a maior honra na sua carreira. Todo mundo leva presentes valiosos, só para conseguir um pequeno favor da Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200645
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200645,
					"content": "Fa-Favor!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200646,
						10200647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200646,
					"content": "Paimon, este não é o ponto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200648,
					"content": "Mas... Mas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200649
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200649,
					"content": "Espere, é isso mesmo! Presentes de saudações são um dos elementos básicos da cultura de Liyue. Precisamos conseguir um, não para receber favores ou qualquer coisa do tipo - apenas para... Respeitar a cultura de Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200650
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200650,
					"content": "Ah, tão entusiasmada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200651
					]
				},
				{
					"id": 10200651,
					"content": "Já chega! Bom, é o seu próprio assunto procurar presente. Deixe-me só lhes dizer como ir para a Câmara de Jade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200652
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200652,
					"content": "Não era preciso virem para a Monte Tianheng. Voltem ao Porto de Liyue, e encontre o \"Guia\" e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200653
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200653,
					"content": "Bem, que nos encontremos novamente, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200654
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200654,
					"content": "Hum... Aquela Yuheng não respeita os arcontes de certa maneira, mas a Paimon acha que ela é bem legal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200655,
						10200656
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200655,
					"content": "Ela me passou uma boa impressão, também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200657,
					"content": "Então... O que deveríamos dar a Ningguang quando a virmos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200658
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200658,
					"content": "Você realmente mudou o foco, não é mesmo Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200659
					]
				},
				{
					"id": 10200659,
					"content": "Ah! Agora que me lembrei, ontem eu sonhei com um lanche muito refinado - <color=#00E1FFFF>Slimes Açucarados Gelados</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200660
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200660,
					"content": "Paimon tem a sensação de que seria perfeito para uma pessoa super rica como a Ningguang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200661
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200661,
					"content": "Por que não escolhemos isso como presente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200662,
						10200664
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200662,
					"content": "Portanto, você tem uma receita?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200663
					]
				},
				{
					"id": 10200663,
					"content": "Não! Mas a Paimon tem certeza de que só precisamos fazer isso com um \"boom shaka-laka\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200666,
					"content": "Vamos recolher mais materiais! Não temos tempo a perder, a fortuna e riqueza estão à nossa espera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200664,
					"content": "E... Como faríamos essa coisa que você sonhou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200665
					]
				},
				{
					"id": 10200665,
					"content": "Com um \"boom shaka-laka\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200656,
					"content": "Eu concordo com alguns de seus pontos de vista.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200647,
					"content": "Paimon, estamos falando de assuntos sérios.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200638,
					"content": "Ningguang iria preferir negociar, não é mesmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200620,
					"content": "(Fizemos apenas uma pequena parte do trabalho lá...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				}
			]
		},
		{
			"id": 102007,
			"completionStepIds": [
				102007
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102007",
							"2"
						],
						"stepId": 102007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200701,
					"content": "Hã? Só nos leva até aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200702,
					"content": "Ah, se essa corrente de vento fosse mais forte, seríamos capazes de alcançar o topo de uma vez só!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200703,
					"content": "É melhor voltarmos a Liyue e perguntarmos aos Millelith...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200704
					]
				},
				{
					"id": 10200704,
					"content": "Ah? Por quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200705,
					"content": "A forma de subir não deveria ser nenhum segredo, ou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200706
					]
				},
				{
					"id": 10200706,
					"content": "Senão?... Oh entendi! Se fosse um segredo, a Ganyu não teria nos deixado tentar descobrir por conta própria, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200707,
					"content": "Tudo bem, vamos seguir o seu plano, depois podemos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200708,
					"content": "Ahh! Espera um minutinho aí. Olhe lá embaixo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200709,
					"content": "Finalmente chegamos perto da <color=#00E1FFFF>Balista Guizhong</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200710,
					"content": "Bem... Hmm... Paimon tem uma nova ideia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200711,
					"content": "Por que não atiramos você até lá em cima, na Câmara de Jade, usando a Balista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200712,
						10200714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200712,
					"content": "#Não obrigad{M#o}{F#a}. Não sou muito fã de morrer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200713
					]
				},
				{
					"id": 10200713,
					"content": "Oh... Certo. Esse método realmente parece um pouco não muito seguro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200716,
					"content": "Ainda assim, lembro que a Balista tinha uma luneta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200717
					]
				},
				{
					"id": 10200717,
					"content": "Ah, sim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200718,
					"content": "Agora que você está dizendo, podemos usar sim... Então vamos usar Balista Guizhong para arranjar um caminho para subir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200714,
					"content": "Você me odeia, por acaso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200715
					]
				},
				{
					"id": 10200715,
					"content": "Uhh... Não. Paimon talvez só tenha esquecido de pensar nas medidas de segurança...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}