			"dialogs": [
				{
					"id": 762140301,
					"content": "#Au au? O que foi, {M#Sr.}{F#Srta.} Viajante Dourad{F#a}{M#o}? Tem algo em que eu possa ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140302
					],
					"speakerTitle": "Srta. Dama Cadela"
				},
				{
					"id": 762140302,
					"content": "Em nome do Sr. Gato Cinzento, você estende um convite para a festa do chá dele à Srta. Dama Cadela...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140303
					]
				},
				{
					"id": 762140303,
					"content": "Ah? Já é hora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140304
					],
					"speakerTitle": "Srta. Dama Cadela"
				},
				{
					"id": 762140304,
					"content": "Obrigada, au au! Se eu não estivesse tão ocupada, eu mesma teria ido convidar a Srta. Malhada... Se eu tivesse feito isso, talvez o Sr. Gato Cinzento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140305
					],
					"speakerTitle": "Srta. Dama Cadela"
				},
				{
					"id": 762140305,
					"content": "Gato ou cachorro, todos somos capazes de conviver em paz... Sim, somos. Enfim, vou para a festa do chá agora. Obrigada por me lembrar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Srta. Dama Cadela"
				}
			]
		},
