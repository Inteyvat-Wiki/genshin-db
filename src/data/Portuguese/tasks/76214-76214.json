				]
			},
			"dialogs": [
				{
					"id": 762140101,
					"content": "Miau... Já está na hora da festa do chá, miau. Será que eles se perderam, miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140102
					],
					"speakerTitle": "Sr. Gato Cinzento"
				},
				{
					"id": 762140102,
					"content": "#Ah, é você, {M#Sr.}{F#Srta.} Viajante Dourad{M#o}{F#a}. Você deve ser {M#o herói}{F#a heroína} escolhid{M#o}{F#a}, miau! Você me ajudaria a procurar meus amigos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140103,
						762140104
					],
					"speakerTitle": "Sr. Gato Cinzento"
				},
				{
					"id": 762140103,
					"content": "E quem seriam os seus amigos...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140106
					]
				},
				{
					"id": 762140106,
					"content": "Ah, e das duas damas que ainda não chegaram, uma é uma gatinha que consegue falar igual a mim. Mas, diferente de mim, ela é uma gata ruiva, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140107
					],
					"speakerTitle": "Sr. Gato Cinzento"
				},
				{
					"id": 762140107,
					"content": "E a outra amiga minha é uma dama poodle muito educada. Uma poodle, sim, mas ainda assim muito distinta, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140108
					],
					"speakerTitle": "Sr. Gato Cinzento"
				},
				{
					"id": 762140108,
					"content": "Mesmo que uma delas seja uma gata e a outra, uma cachorra, sempre que elas se sentam para tomar chá juntas, elas sempre se divertem muito, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140109
					],
					"speakerTitle": "Sr. Gato Cinzento"
				},
				{
					"id": 762140109,
					"content": "Por favor, pela paz de Miaulópolis, me dê uma patinha, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. Gato Cinzento"
				},
				{
					"id": 762140104,
					"content": "#Uau, é bem fácil ser um{F#a} \"{M#herói}{F#heroína}\" hoje em dia, né?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140105
					]
				},
				{
					"id": 762140105,
					"content": "Oh, não vamos ficar discutindo demais os detalhes, miau. Se você já tem a Espada Sagrada lendária, um herói é um herói, encontre ou não o Graal da Pureza de que falam, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140106
					],
					"speakerTitle": "Sr. Gato Cinzento"
				}
			]
		},
		{
			"id": 7621402,
