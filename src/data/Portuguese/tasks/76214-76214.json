				]
			},
			"dialogs": [
				{
					"id": 762140201,
					"content": "...Miau. Sua esgrima... deixou este gato impressionado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140209
					],
					"speakerTitle": "Srta. Malhada"
				},
				{
					"id": 762140209,
					"content": "Agradeço, honrado cavaleiro de terras distantes. Aqueles canalhas cruéis, arrogantes e poderosos não vão mais invadir o lar do meu povo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140210
					],
					"speakerTitle": "Srta. Malhada"
				},
				{
					"id": 762140210,
					"content": "Então, diga. Por que Vossa Senhoria veio à minha corte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140202,
						762140204
					],
					"speakerTitle": "Srta. Malhada"
				},
				{
					"id": 762140202,
					"content": "\"Corte\"...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140203
					]
				},
				{
					"id": 762140203,
					"content": "Hum... Já que isso é um conto de fadas, então isso deve fazer parte desse mundo de conto de fadas, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762140206,
					"content": "Em nome do Sr. Gato Cinzento, você estende um convite para a festa do chá dele à Srta. Malhada...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140207
					]
				},
				{
					"id": 762140207,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140208
					],
					"speakerTitle": "Srta. Malhada"
				},
				{
					"id": 762140208,
					"content": "#...Entendo, e agradeço, honorável cavaleir{F#a}{M#o} de terras distantes. Vou seguir seu sábio conselho e partir imediatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Srta. Malhada"
				},
				{
					"id": 762140204,
					"content": "Vossa Majestade, permita-me fazer meu relatório a você...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140205
					]
				},
				{
					"id": 762140205,
					"content": "Ahem, alguém chegou rapidinho! Parece que você respeita mesmo os costumes locais quando está \"no exterior\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "Paimon"
				}
			]
		},
