					"Daimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722700101,
					"content": "#Eu sou Daimon dos Jibashiri. {F#Heroína}{M#Herói} de Sangonomiya, reconheço que você é mereced{F#ora}{M#or} deste desafio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700102
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700102,
					"content": "A coragem é o poder de derrotar todos os seus inimigos, não importa o método utilizado. Derrote todos os inimigos daqui e libere as Chamas do Portão Alto, assim sua passagem será concedida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700103
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700103,
					"content": "Deve ser dito que todos esses inimigos são ilusões. Nascidos dos Fantasmas do Fogo Solar e dos grandes inimigos que conhece em sue coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700104
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700104,
					"content": "#Ainda assim, você será derrotad{M#o}{F#a} caso não tenha cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700105
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700105,
					"content": "Aguardarei você concluir o desafio na Torre dos Três Reinos acima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daimon"
				}
			]
		},
