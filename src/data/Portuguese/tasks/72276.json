			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yabe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722760101,
					"content": "#Ei, você é {NICKNAME}, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760102
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760102,
					"content": "Não sei se você se lembra de meu nome. Me chamo Yabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760103
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760103,
					"content": "Olá, Yabe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760104
					]
				},
				{
					"id": 722760104,
					"content": "Olá, olá, hehehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760105
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760105,
					"content": "#Bem, você então deve ser muito habilidos{F#a}{M#o}, não é? Lutar contra a Shogun Raiden primeiro, e depois se aventurar pela Escuridão de Enkanomiya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760106
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760106,
					"content": "É verdade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760107
					]
				},
				{
					"id": 722760107,
					"content": "#Ótimo! Nós temos pistas sobre um tesouro, mas pode ser uma jornada perigosa. Você esta interessad{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760108
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760108,
					"content": "Eu sempre fui um fã de mistérios, mas não gosto de me colocar em perigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760109
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760109,
					"content": "#Sim, estou interessad{F#a}{M#o}. Pode falar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760110
					]
				},
				{
					"id": 722760110,
					"content": "Eu encontrei isso enquanto patrulhava o Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760111
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760111,
					"content": "Parece ser apenas uma placa de pedra, mas acho que é a chave para encontrar o Tesouro Secreto de Bunkoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760112
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760112,
					"content": "Tesouro Secreto de Bunkoku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760113
					]
				},
				{
					"id": 722760113,
					"content": "Poucos relatos históricos do Reino de Byakuya sobreviveram a história de Watatsumi, por isso eu também não sei os detalhes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760114
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760114,
					"content": "Uma história diz que Bunkoku foi o segundo Primeiro Ministro da história do Reino de Byakuya. Ele extorquiu o povo junto com o Filho do Sol e então escondeu seu tesouro numa câmara oculta dentro do Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760115
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760115,
					"content": "E depois disso, ele escondeu a câmara oculta com os Fantasmas do Fogo Solar e invocou criaturas de sujeira e ressentimento das Linhas Ley para a proteger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760116
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760116,
					"content": "Bunkoku provavelmente tinha um nome no estilo antigo também. Algo como Tye-alguma-coisa-Eus. Mas obviamente ninguém se importou em registrar a história desse traidor em detalhes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760117
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760117,
					"content": "Vamos falar da placa de pedra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760118
					]
				},
				{
					"id": 722760118,
					"content": "Ela provavelmente é a chave para abrir a câmara oculta de Bunkoku. Eu conheço bastante sobre kaidan e casos misteriosos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760119
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760119,
					"content": "Está escrito... Hmm... Está escapando de minha língua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760120
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760120,
					"content": "Seja franco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760121
					]
				},
				{
					"id": 722760121,
					"content": "Na verdade, eu encontrei essa placa de pedra no armazém do Dainichi Mikoshi, e do lado dela havia uma nota que registrava tanto a escritura antiga como sua tradução.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760122
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760122,
					"content": "Parece que os documentos foram todos escritos juntos com uma tradução durante o período de transição. De acordo com essa noite, a placa de pedra está diretamente atrelada ao Quebra-cabeça Bunkoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760123
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760123,
					"content": "Também diz que ao todo existem oito placas. Até o momento só recuperamos uma. De acordo com as anotações, a câmara oculta está em um local próximo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760124
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760124,
					"content": "Poderia lhes pedir para darem uma olhada lá? Não me importo com o tesouro. Ficarei feliz se puder ver como o Quebra-cabeça Bunkoku é solucionado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yabe"
				}
			]
		},
