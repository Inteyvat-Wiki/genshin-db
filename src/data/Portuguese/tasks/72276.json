					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722761003,
					"content": "Como que eu poderia atacar meu amigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761004
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761004,
					"content": "Eu devo ter sido possuído pelo espírito vingativo invocado por Bunkoku. Ele me controlou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761005
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761005,
					"content": "O tesouro não é nada comparado com nossa amizade. Eu... Eu nunca o atacaria por um tesouro qualquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761006
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761006,
					"content": "Ele confia tanto em mim que até mesmo me convidou até aqui para ver o tesouro de Bunkoku... E eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761007
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761007,
					"content": "Eu não sou uma pessoa desse tipo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761008
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761008,
					"content": "Hmm, então a verdade estava sendo escondida por aquela última tabuleta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722761009,
					"content": "Deixe ele em paz. Ele precisa ficar sozinho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761010
					]
				},
				{
					"id": 722761010,
					"content": "Sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722761011,
					"content": "Vamos voltar e contar o que aconteceu para Yabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
