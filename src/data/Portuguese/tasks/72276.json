			"dialogs": [
				{
					"id": 722760301,
					"content": "Ei, você ouviu isso? Parece que há algum barulho estranho vindo dali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760302,
					"content": "Se você seguir a direção dele, poderá encontrar um padrão estranho no teto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760303
					],
