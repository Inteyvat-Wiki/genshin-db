				"points": []
			},
			"dialogs": [
				{
					"id": 790510101,
					"content": "Tem um diário aqui! Vamos ver como ele está!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510102
					],
					"speakerTitle": "Ler"
				},
				{
					"id": 790510102,
					"content": "Uau, que tom descontraído!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510103
					],
					"speakerTitle": "Ler"
				},
				{
					"id": 790510103,
					"content": "Esse pintor estava totalmente descontraído, suas habilidades haviam melhorado bastante. Com certeza foi por isso que ele fez uma obra como essa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510104
					],
					"speakerTitle": "Ler"
				},
				{
					"id": 790510104,
					"content": "Mas, no final ele foi embora, não teve como ficar com suas amigas Gotinhas. Paimon acha isso um pouco triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510105,
						790510106
					],
					"speakerTitle": "Ler"
				},
				{
					"id": 790510105,
					"content": "Talvez o artista não quisesse ficar se copiando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				},
				{
					"id": 790510107,
					"content": "Sim, não é como se não desse para entender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510108
					],
					"speakerTitle": "Ler"
				},
				{
					"id": 790510108,
					"content": "Mas tem algo que Paimon ainda não entendeu... Ele mencionou que o mural que deixou para trás pode ter sido distorcido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510109
					],
					"speakerTitle": "Ler"
				},
				{
					"id": 790510109,
					"content": "Aquele acidente de antes foi tão terrível... Será que esse problema do mural não é grave demais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510110,
						790510111
					],
					"speakerTitle": "Ler"
				},
				{
					"id": 790510110,
					"content": "A resposta vai estar com as Gotinhas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510112,
					"content": "Oh, é isso! Será que as Gotinhas sabem lidar com o Projetor de Transmissão e restaurar o mural?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510113
					],
					"speakerTitle": "Ler"
				},
				{
					"id": 790510113,
					"content": "Oh, Paimon está comovida. As Gotinhas podem não parecer muito inteligentes, mas elas são bem consideradas, são leais, são amigas importantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ler"
				},
				{
					"id": 790510111,
					"content": "Elas protegeram o mural do seu amigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510106,
					"content": "Ser fiel a sua criatividade também faz sentido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				}
			]
		},
