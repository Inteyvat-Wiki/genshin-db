			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3580101,
					"content": "... Isso foi o que aconteceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3580102,
					"content": "#{M#Bem-vindos}{F#Bem-vindas} a Mondstadt, Viajantes do vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580103
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580103,
					"content": "Eu sou a Jean, a Grande Mestre Intendente dos Cavaleiros de Favonius. Essa é a Lisa, a nossa Bibliotecária.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580104
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580104,
					"content": "Oh! Vocês vieram nos ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580105,
					"content": "#Vocês {M#dois}{F#duas} são muito adoráveis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580106,
					"content": "Infelizmente, agora não é uma boa hora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580107,
					"content": "Com o ressurgimento do Stormterror, a cidade está num caos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580108,
					"content": "Simplificando, a esfera elemental de Mondstadt e as Linhas Ley agora são semelhantes a uma bola de fios nas patas de um gatinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580109,
					"content": "Não poderia haver circunstâncias piores para uma Feiticeira. Minha pele está a uma partícula elemental de se arruinar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580110,
					"content": "Se não fosse por esta interferência, os Cavaleiros de Favonius teriam melhores maneiras de ajudar você, ao invés de apenas colar cartazes de pessoas desaparecidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580111
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580111,
					"content": "#Pedimos para que fiquem em Mondstadt por um tempo. Os Cavaleiros de Favonius vão ajudar você a encontrar o seu {F#irmão}{M#irmã}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580112,
						3580114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580112,
					"content": "Não posso deixar que façam todo o trabalho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580113
					]
				},
				{
					"id": 3580113,
					"content": "A Paimon também quer ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3580116,
					"content": "Ótimo. Neste caso precisamos de um plano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580117
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3580117,
					"content": "Com o Stormterror atacando diretamente Mondstadt, temos a oportunidade de cortar o mal pela raiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580118,
					"content": "Lisa descobriu a fonte do poder do Stormterror com a sua magia de detecção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580119
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580119,
					"content": "É mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580120
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3580120,
					"content": "Eles estão localizados nos <color=#00E1FFFF>Templos dos Quatros Ventos</color> abandonados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580121
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580121,
					"content": "A capacidade do Stormterror de provocar esses tipos de tempestades pode ser atribuída a ele tirando poder dos templos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580122
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580122,
					"content": "O nosso objetivo é lidar com <color=#00E1FFFF>três</color> dos quatros templos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580123
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580123,
					"content": "Suponho que todos saibam do porquê apenas três.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580124,
					"content": "Eu não entendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580125,
						3580126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3580125,
					"content": "Deve ser algo que só os locais sabem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580127,
					"content": "Cavaleiros de Favonius, o tempo está correndo contra nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580128
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580128,
					"content": "A tempestade está ficando forte, não há motivos para ficamos em uma posição defensiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580129
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580129,
					"content": "Precisamos agir antes que a situação piore. Vamos seguir para as <color=#00E1FFFF>ruínas</color> dos <color=#00E1FFFF>templos abandonados</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580126,
					"content": "Vamos perguntar mais tarde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580114,
					"content": "Então, vamos ter que deixar com vocês. Onde fica o albergue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580115
					]
				},
				{
					"id": 3580115,
					"content": "Ei! Deixe de preguiça! Nós temos que participar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}