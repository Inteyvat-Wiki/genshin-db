					"nextDialogs": [
						130120203
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130120203,
					"content": "Eu não lembrava de dever dinheiro a alguém, e o preço era absurdo. Por isso prendi o comerciante sob acusação de provocação e ser irritante.",
					"roleType": "TALK_ROLE_NPC",
