			"dialogs": [
				{
					"id": 120220401,
					"content": "Kokomi, é este o livro que você queria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220402,
					"content": "Hmm, não tenho certeza, na verdade... Você poderia ler um pouco em voz alta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220403,
						120220404
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220403,
					"content": "\"Aja de acordo com o plano e planeje a situação\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220405
					]
				},
				{
					"id": 120220405,
					"content": "*boceja* Sim, é esse mesmo! Obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220406
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220406,
					"content": "Kokomi... Kokomi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220407,
					"content": "#E agora, {NICKNAME}? Parece que a Kokomi caiu no sono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220408,
					"content": "Temos a festa de comemoração hoje de noite, sem falar das negociações de paz que também estão se aproximando. Ela tem tanta coisa para fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220409,
						120220421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220409,
					"content": "Vamos deixá-la descansar um pouco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220410
					]
				},
				{
					"id": 120220410,
					"content": "Tem certeza que é uma boa ideia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220411,
					"content": "Mas realmente, ela parece estar muito exausta. Como ainda temos um pouco de tempo, vamos fazer companhia a ela enquanto ela descansa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220412,
					"content": "Evite o desastre... Proteja a paz a todo custo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220413
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220413,
					"content": "A guerra acabou, e tudo lentamente está retornando ao normal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220414
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220414,
					"content": "Vocês viram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220415
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220415,
					"content": "*Suspiro*... Eu caí no sono? Que horas são?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220416
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220416,
					"content": "Kokomi, você dormiu por muito tempo! É quase hora do banquete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220417,
					"content": "Não consigo acreditar que já é tão tarde assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220418
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220418,
					"content": "Faz um bom tempo que eu não durmo tão bem assim. Devo ter pelo menos recuperado três pontos de energia. Creio ser suficiente para as negociações de paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220419
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220419,
					"content": "#Obrigada, {NICKNAME}. Vamos indo para o banquete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220420
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220420,
					"content": "Uhul, Kokomi está com toda sua energia de volta! Isso é ótimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220421,
					"content": "Vamos acordá-la.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220422
					]
				},
				{
					"id": 120220422,
					"content": "Sim, Kokomi também disse que queria terminar tudo antes do banquete começar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220423,
					"content": "Kokomi, acorde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220424,
					"content": "Hmmmm...? Eu estava dormindo? Que horas são?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220425
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220425,
					"content": "Vamos nos preparar para ir para o banquete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220426,
					"content": "Mesmo? Já é essa hora? Urgh... Eu ainda não me sinto totalmente recarregada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220427
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220427,
					"content": "Eu lhe comprarei um novo livro de estratégias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220428
					]
				},
				{
					"id": 120220428,
					"content": "Sério? Sim! Quero o último volume da Arte da Guerra de Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220429
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220429,
					"content": "A Editora Yae publicou no mês passado, mas eu não tive a chance de colocar minhas mãos nele... Sem dê para trás agora, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220430
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220430,
					"content": "Hã, isso realmente a animou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220431,
					"content": "Tudo bem, vamos para a festa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220404,
					"content": "\"Ataque onde o inimigo é fraco, apareça onde o inimigo é cego\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220405
					]
				}
			]
