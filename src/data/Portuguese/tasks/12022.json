			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220101,
					"content": "Hã? Kokomi não está aqui ainda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220102,
					"content": "Isso é estranho. Ela não parece ser do tipo que aparece tarde para as coisas... Errr, vamos esperar mais um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220103,
					"content": "Como ela ainda não está aqui? Você acha que ela pode estar em apuros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220104,
					"content": "Vamos perguntar àquele soldado ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220701,
					"content": "Você está procurando por Sua Excelência?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220702
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220702,
					"content": "Receio que ela não esteja aqui no momento. Não sei para onde ela foi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220703
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220703,
					"content": "Isso é estranho... Então não temos outra opção senão voltar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220704,
					"content": "Não necessariamente. Lembro que Sangonomiya planejou com antecedência algumas formas de resolução para esse cenário em suas Diretivas Operacionais Gerais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220705
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220705,
					"content": "Deixe-me ver... Ah sim, N° 98. <color=#00E1FFFF>\"Se um visitante de longe vier me ver, e se meu paradeiro for desconhecido, instrua-o a prosseguir para o sul até que cheguem a uma árvore de folhagem roxa\"</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220706
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220706,
					"content": "A nota de rodapé estipula que isto só se aplica quando Sua Excelência não fez nenhuma comunicação sobre o seu paradeiro antes de desaparecer, e mesmo assim apenas quando o visitante em questão é VIP.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220707
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220707,
					"content": "#{F#Vocês duas}{M#Vocês dois} devem ser forasteir{M#os}{F#as} vindos de longe, né? Eu sempre trago essa diretiva, tenho a certeza que isso é o correto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220708
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220708,
					"content": "Kokomi realmente pensa em tudo! Tudo bem, vamos procurar o lugar que ela mencionou e dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202202,
			"completionStepIds": [
				1202208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202208",
							"2"
						],
						"stepId": 1202208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220204,
					"content": "Kokomi!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220205,
					"content": "Então foi para aqui que você fugiu! Íamos nos encontrar e preparar as coisas para o Banquete da Vitória de hoje, o que aconteceu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220206,
					"content": "Oh... É você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220207
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220207,
					"content": "Pe-Perdão... Hoje não estou me sentindo como de costume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220208
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220208,
					"content": "Hã!? Você ficou doente? Vamos procurar um médico agora mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220209,
					"content": "Não, não, não é nada disso... É que, minha energia foi totalmente gasta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220210
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220210,
					"content": "V-Você funciona com energia? Hããã? Você quer dizer... Você é como um Guarda das Ruínas!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220211,
					"content": "Não, é apenas jeito de falar. *Suspiro* Tenho vergonha de admitir isso, mas nem sempre posso ser a pessoa infinitamente capaz como me apresento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220212,
						120220213
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220212,
					"content": "Todos estavam pedindo tanto de você ontem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220214
					]
				},
				{
					"id": 120220214,
					"content": "Oh... você percebeu? Acho que ainda não dominei a habilidade de esconder o que estou sentindo. Vou continuar trabalhando nisso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220215
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220215,
					"content": "Sinceramente, não fui feita para ser uma líder. No início, meu sonho era ler sobre estratégia militar e talvez me tornar uma conselheira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220216
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220216,
					"content": "Comunicar constantemente com as pessoas, tentar manter o moral, ler nas entrelinhas, garantir que todos recebam o reconhecimento que merecem... É um trabalho duro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220217
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220217,
					"content": "Você, de alguma forma, deve fazer as pessoas se sentirem maravilhosas apenas por estar na sua presença, e também impor respeito... Isso não é natural para mim. Na verdade, é algo que nunca quis para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220218
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220218,
					"content": "Mas por causa da minha linhagem, eu sempre acabaria sendo a Sacerdotisa Divina mais cedo ou mais tarde. Queira eu ou não, é assim que é.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220219
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220219,
					"content": "Então, sempre que me sinto sobrecarregada, venho aqui apenas para me perder em um livro e relaxar um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220220
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220220,
					"content": "Não se preocupe, isso não afeta meu trabalho. Eu deixei os preparativos para o Banquete da Vitória com outra pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220221
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220221,
					"content": "Tenho que fazer um discurso esta noite e não devo dar às tropas qualquer motivo para suspeitar que algo possa estar errado. Essa paz foi conquistada com dificuldade e quero que eles se sintam tranquilos",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220222
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220222,
					"content": "Podemos fazer algo para ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220223,
					"content": "Eu devo me sentir fortalecida novamente em breve se adiar o trabalho por mais um pouco de tempo. *suspiro* Se ao menos eu pudesse ouvir uma boa leitura sobre estratégia militar, tenho certeza que isso aceleraria o processo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220224
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220224,
					"content": "Eu estava lendo um livro da última vez que estive aqui, mas só consegui ler mais ou menos a metade. Onde eu coloquei...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220225
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220225,
					"content": "Nós encontraremos para você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220226,
					"content": "E então vamos ler para você — para ajudá-la a se recuperar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220227,
					"content": "Vocês fariam isso por mim? Obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220228
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220228,
					"content": "Hehe... Tive muita sorte de você ter voltado para a Ilha Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220213,
					"content": "Pude sentir que as coisas estavam afetando você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220214
					]
				}
			]
		},
		{
			"id": 1202203,
			"completionStepIds": [
				1202217
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202217",
							"2"
						],
						"stepId": 1202217,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220301,
					"content": "#Ei, olhe, {NICKNAME}. Seria este o livro que ela queria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220302,
					"content": "#\"{M#O Capitão}{F#A Capitã} do Peixe-Espada II voltou hoje. Energia +4...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220303,
					"content": "Ah, isso é... isso é meio, hmmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220304,
						120220305
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220304,
					"content": "Não vimos nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220306
					]
				},
				{
					"id": 120220306,
					"content": "Me. Dê. Isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220307
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220307,
