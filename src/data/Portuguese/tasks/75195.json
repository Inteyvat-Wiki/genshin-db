			"dialogs": [
				{
					"id": 751950201,
					"content": "Pelos Arcontes... Será que alguém de bom coração apareceu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950202
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950202,
					"content": "Eu estava prestes a pedir para um Tantakassauro destruir essas pedras no caminho. E também para lidar com algum monstro, caso aparecesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950203
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950203,
					"content": "Mas eu nem tive a chance de fazer nada, que veio alguém para me ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950204
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950204,
					"content": "Ah, todos os dias de manhã cedo tenho que fertilizar as árvores. Fiz isso por toda minha vida, e essa é a recompensa que os deuses me deram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950205
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950205,
					"content": "#Oh, gentil visitante, emissári{F#a}{M#o} dos deuses! Eu lhe agradeço por sua generosidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950206
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950206,
					"content": "Esse velhote aqui não tem nada de bom, só posso te dar Mora, e uns cacarecos inúteis. Aqui, pode ficar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dutta"
				}
			]
		}
	]
