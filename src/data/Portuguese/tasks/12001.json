			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wu Robusto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010301,
					"content": "Quem está aí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010302,
						120010304
					],
					"speakerTitle": "Wu Robusto"
				},
				{
					"id": 120010302,
					"content": "Um comerciante de Mondstadt que veio para uma reunião com o Burguês Maocai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010303
					]
				},
				{
					"id": 120010303,
					"content": "Sério? Ele não falou nada sobre a reunião...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "Wu Robusto"
				},
				{
					"id": 120010306,
					"content": "O Mestre está tratando de alguns assuntos urgentes hoje. Todos os compromissos anteriores foram cancelados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010307
					],
					"speakerTitle": "Wu Robusto"
				},
				{
					"id": 120010307,
					"content": "Assuntos urgentes?... O que é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010308,
					"content": "O Mestre tem estado ocupado trabalhando em um negócio muito importante. Ele saiu esta manhã para encontrar um cliente VIP.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010309
					],
					"speakerTitle": "Wu Robusto"
				},
				{
					"id": 120010309,
					"content": "Então, onde ele está agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010310,
					"content": "Desculpe, mas o Mestre enfatizou que não devemos dizer nenhuma palavra sobre isso a ninguém...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010311
					],
					"speakerTitle": "Wu Robusto"
				},
				{
					"id": 120010311,
					"content": "\"A ninguém\"? Você está dizendo que não somos clientes VIP?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010312
					]
				},
				{
					"id": 120010312,
					"content": "Não, não. Não quero ofender! Por favor, acredite em mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010313,
						120010314
					],
					"speakerTitle": "Wu Robusto"
				},
				{
					"id": 120010313,
					"content": "Leve-me ao Burguês Maocai ou você terá que arcar com as consequências!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010315,
					"content": "Desculpe! O Mestre está negociando no Quiosque de Xinyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010316
					],
					"speakerTitle": "Wu Robusto"
				},
				{
					"id": 120010316,
					"content": "Por favor, não diga ao meu Mestre. Se ele souber, não sei o que vai acontecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010317
					],
					"speakerTitle": "Wu Robusto"
				},
				{
					"id": 120010317,
					"content": "Bem, o meu Mestre tem coisas muito mais importantes a fazer do que conversar com alguém grosseiro como você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010318,
					"content": "#Você só quer que {M#o}{F#a} {NICKNAME} esqueça a sua ofensa depois de acabar a negociação com o Burguês Maocai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010319,
					"content": "O... Obrigado！ Que seus negócios sejam abençoados pelo Senhor Geo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010320
					],
					"speakerTitle": "Wu Robusto"
				},
				{
					"id": 120010320,
					"content": "#Huum! {NICKNAME}, você tem o dom mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010321,
						120010323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010321,
					"content": "Eu estava apenas blefando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010322
					]
				},
				{
					"id": 120010322,
					"content": "#A Paimon terá que ter cuidado no futuro. Ter {F#tal companheira}{M#tal companheiro} parece perigoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010325,
					"content": "Enfim, parece que o cliente VIP em questão deve ser um dos Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010326,
						120010327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010326,
					"content": "Acho que você tem razão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010328,
					"content": "Então, vamos ao Quiosque de Xinyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010327,
					"content": "Isso pode funcionar a nosso favor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010323,
					"content": "Você fez um bom trabalho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010324
					]
				},
				{
					"id": 120010324,
					"content": "Haha, em agradecimento, eu vou lhe convidar para comer da próxima vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010314,
					"content": "Talvez possa explicar ao seu mestre por que ele terá que pagar pela falha que você cometeu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010304,
					"content": "#Eu sou {NICKNAME}, cliente VIP do seu chefe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010305
					]
				},
				{
					"id": 120010305,
					"content": "Que estranho, você não está na lista de convidados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "Wu Robusto"
				}
			]
		},
		{
