			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010801,
					"content": "Você disse que tinha outras coisas para fazer, como se fosse um homem misterioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010802,
					"content": "Quando, na verdade, tudo o que você queria era um lugar novo para se deitar enquanto lia o livro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010803,
					"content": "Agora sabemos qual é o negócio do Burguês Maocai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010804
					]
				},
				{
					"id": 120010804,
					"content": "Entendo, foi como eu tinha pensado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010805
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010805,
					"content": "Você realmente adivinhou, ou está apenas dizendo isso para parecer inteligente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010806,
					"content": "Já tenho um plano. Para começar, entregue esta carta ao servente da Guilda de Comerciantes de Feiyun. Ele sabe o que fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010807
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010807,
					"content": "Por motivos que não posso explicar, não poderei me juntar a vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010808
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010808,
					"content": "Não há necessidade de ler o conteúdo da carta, quando chegar a hora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010809
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010809,
					"content": "Uf! Que letra feia! Não dá para entender nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010810,
						120010811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010810,
					"content": "Talvez em uma escritura antiga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				},
				{
					"id": 120010812,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010813
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010813,
					"content": "Por isso disse que não seria necessário lê-lo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010814
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010814,
					"content": "A Guilda de Comerciantes de Feiyun terá alguém que possa entender isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010815
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010815,
					"content": "Mas por que você quer envolvê-los? Eles são uma das maiores guildas comerciais de Liyue - por que iriam querer nos ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010816,
					"content": "O que é a Guilda de Comerciantes de Feiyun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010817
					]
				},
				{
					"id": 120010817,
					"content": "Desde que chegamos a Liyue, tenho ouvido as pessoas falarem dela o tempo todo. Parece que eles supervisionam grande parte dos negócios por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010818,
					"content": "Ter um apoio tão grande seria ótimo... Mas você tem certeza de que eles querem ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010819,
					"content": "Não precisa se preocupar com isso. Pelo que sei, eles compartilham do meu senso de cavalheirismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010820
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010820,
					"content": "Após lerem o caso racionalmente fundamentado e emocionalmente argumentado que apresento nesta carta, com certeza ajudarão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010821,
						120010822
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010821,
					"content": "Tem certeza de que vai funcionar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010823,
					"content": "O Burguês Maocai deve aprender uma lição que ele nunca esquecerá. Isso é algo que não podemos fazer sozinhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010824
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010824,
					"content": "Além disso, não desejo que mais ninguém saiba o meu envolvimento nisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010825
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010825,
					"content": "Por que não? Você está fazendo isso só para ajudar Chang, o Nono, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010826,
					"content": "\"Desaparecer silenciosamente na conclusão do problema, ocultando seu nome e contribuição\", isso é cavalheirismo. Saber que a justiça foi feita é a melhor recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010827
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010827,
					"content": "A cada gota de bondade que recebo, tenho a obrigação de retribuir com uma fonte de gratidão. Não busco elogios nem recompensas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010828
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010828,
					"content": "Isso parece muito adorável. Mas para falar a verdade, você só quer que eles façam isso para continuar lendo seu livro, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010829,
					"content": "Então, por favor, entreguem a carta para o servente da Guilda de Comerciantes de Feiyun, ele deve estar perto do Pavilhão de Liuli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010830
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010830,
					"content": "Não me ignore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010822,
					"content": "Mas por que temos que procurá-los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010811,
					"content": "Um texto secreto que precise ser decodificado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				}
			]
		}
	]
