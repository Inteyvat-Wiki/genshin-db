			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maocai Burguês"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010701,
					"content": "#Entendi! Fique tranquil{M#o}{F#a}. Tudo ficará bem e os pedidos serão concluídos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010702
					],
					"speakerTitle": "Maocai Burguês"
				},
				{
					"id": 120010702,
					"content": "Hmm... O subordinado que enviei não estava tão otimista... Alguém não está cooperando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010703
					],
					"speakerTitle": "Agente de Dívidas"
				},
				{
					"id": 120010703,
					"content": "Ah... Acabamos de encontrar um pequeno problema de suprimentos. Ainda não conseguimos comprar o Cor Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010704
					],
					"speakerTitle": "Maocai Burguês"
				},
				{
					"id": 120010704,
					"content": "Mas não precisa se preocupar. Se Chang, o Nono não vender, eu posso comprar de outra pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010705
					],
					"speakerTitle": "Maocai Burguês"
				},
				{
					"id": 120010705,
					"content": "Isso seria o ideal. Lembro novamente que os Fatui se preocupam apenas com o resultado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010706
					],
					"speakerTitle": "Agente de Dívidas"
				},
				{
					"id": 120010706,
					"content": "Estamos dispostos a dar um certo grau de suporte a esta transação. Mas se não for concluído a tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010707
					],
					"speakerTitle": "Agente de Dívidas"
				},
				{
					"id": 120010707,
					"content": "Você poderá descobrir que a nossa boa vontade tem um preço que você não pode pagar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010708
					],
					"speakerTitle": "Agente de Dívidas"
				},
				{
					"id": 120010708,
					"content": "Entendi! Estou em dívida por sua proteção, não vou te desapontar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010709
					],
					"speakerTitle": "Maocai Burguês"
				},
				{
					"id": 120010709,
					"content": "Veremos quando chegar o momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010710
					],
					"speakerTitle": "Agente de Dívidas"
				},
				{
					"id": 120010710,
					"content": "Hunf... Aquele velhote Chang maldito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maocai Burguês"
				},
				{
					"id": 610045701,
					"content": "Então, o Burguês Maocai trabalha para os Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 610045702,
					"content": "Não sei se o Nerd de Guhua fez algum progresso. Devemos ir contar a ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1200108,
