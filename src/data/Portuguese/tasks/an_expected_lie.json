			"dialogs": [
				{
					"id": 741363401,
					"content": "O que vocês estão fazendo aqui?! Por que vocês voltaram? Vejam bem, eu disse que iam procurar cinco vezes, e não iam encontrar nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363402
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363402,
					"content": "Se não puderem, sentem-se aqui para beber um pouco. Acabei de comprar cinco xícaras de chá, e algumas tigelas de comida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363403
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363403,
					"content": "Você gosta mesmo desse número cinco, Sr. Edwin.",
