			"dialogs": [
				{
					"id": 741361101,
					"content": "#Srta. Fusilier! {NICKNAME}! Vocês voltaram! Devem ter lidado com as coisas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361102
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361102,
					"content": "Oh, não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361103
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361103,
					"content": "Uau! O Sr. Choiseul vai desmaiar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361104,
					"content": "Eu nem pensei que você ia voltar pro Instituto, Choiseul. Eu pensei que você ia tá ocupado lidando com papelada pra sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361105
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361105,
					"content": "Impossível! Pelos céus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361106
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361106,
					"content": "Raimondo, o que você acha de pegar meu trabalho? Algo para reportar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361107
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361107,
					"content": "... Que reunião fantástica, Sr. Edwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361108
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361108,
					"content": "Ha! Olhe ao seu redor. Você parece combinar bem com ser um zelador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361109
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361109,
					"content": "... Hunf! Ele nem mesmo limpou corretamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361110
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361110,
					"content": "Talvez porque ele não tenha lhe limpado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361111
					]
				},
				{
					"id": 741361111,
					"content": "#Obrigado por trazer esses dois de volta, Pesquisador{F#a} Sênior Honorári{M#o}{F#a} {NICKNAME}, Srta. Fusilier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361112
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361112,
					"content": "Espero que isso marque o fim da série de eventos infelizes do Instituto de Pesquisas de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361113
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361113,
					"content": "Hahaha! Ótimo! O Instituto de Pesquisas de Fontaine agora vai cair na calmaria mortal em que toda a inspiração murcha e morre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361114
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361114,
					"content": "Você certamente já despertou muita inspiração no Instituto. É hora de acalmar as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361115
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361115,
					"content": "Raimondo Havenport, você não sabe nada sobre pesquisa. Você não merece liderar o Instituto de Pesquisas de Fontaine de Engenharia de Energia Cinética.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361116
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361116,
					"content": "Mas eu sei como manter as coisas funcionando, Edwin Eastinghouse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361117
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361117,
					"content": "O que você precisa é ficar longe de pesquisa e Arkhium. Pelo nosso bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361118
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361118,
					"content": "Um certo tempo depois, o pessoal da Maison Gardiennage chega e levam Nacker e Edwin. É melhor que eles saiam do Instituto para sempre...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741361119
					]
				},
				{
					"id": 741361119,
					"content": "Ainda bem, graças aos céus, meu pesadelo finalmente acabou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361120
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361120,
					"content": "Sr. Chaussivert, Sr. Lemarcq, correto? Ouvi sobre a assistência que vocês deram ao nosso instituto. Por favor, tirem um descanso merecido enquanto a compensação de vocês ainda é organizada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361121
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361121,
					"content": "Hahah! Eu não achei que alguém como eu chegaria a ser associado ao Instituto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361122
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361122,
					"content": "Não diga isso sobre você, caro senhor! Você é sincero, e gentil, é uma boa pessoa. Talvez precisemos de sua ajuda no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361123
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361123,
					"content": "#Quanto a você... Pesquisador{F#a} Sênior Honorári{M#o}{F#a}, você nos fez um grande favor novamente. Como poderemos retribuir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361124,
						741361125
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361124,
					"content": "Só não se exploda de novo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361128
					]
				},
				{
					"id": 741361128,
					"content": "Falando nisso... Cadê a Srta. Fusilier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361129,
					"content": "...A gente devia dar um pouco de espaço a ela. Parece que a imagem que ela tinha criado de Edwin Eastinghouse na própria cabeça se despedaçou completamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361130
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361130,
					"content": "Edwin e Nacker também precisam se acalmar... Espero que eles possam refletir sobre seus próprios erros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361131
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361131,
					"content": "Eles ficarão na Fortaleza Meropide pelo resto das vidas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361132
					]
				},
				{
					"id": 741361132,
					"content": "Considerando como eles são perigosos, espero que nunca deixem aquele lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361133
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361133,
					"content": "Contudo, considerando o estado das coisas aqui no Instituto de Pesquisas de Fontaine... posso apenas esperar que não encontre situações que necessitem da especialidade deles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361134
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361134,
					"content": "#Agradeço novamente a você em nome do Instituto de Pesquisas de Fontaine, Pesquisador{F#a} Sênior Honorári{M#o}{F#a}. Se tiver alguma pergunta adicional, estou ao seu dispor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361125,
					"content": "Que tal uma promoção?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361126
					]
				},
				{
					"id": 741361126,
					"content": "Bem... teoricamente, seu título atual já está no topo... Mas deixe-me ver o que posso fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361127
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361127,
					"content": "#Que tal algo como... Pesquisador{F#a} Sênior Honorári{M#o}{F#a} Chefe? Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361128
					],
					"speakerTitle": "Choiseul"
				}
			]
		},
