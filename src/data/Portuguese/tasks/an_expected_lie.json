			"dialogs": [
				{
					"id": 741360401,
					"content": "É por isso que ele continua repetindo o número \"cinco\". Ele estava dando dicas sobre como resolver o quebra-cabeça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360402,
					"content": "Por que ele não disse logo? Por que ficou enrolando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360403,
					"content": "Hunf, e quem sabe o que tá rolando na cabeça dele? Mas, ele parecia querer estar levando a gente pra Nacker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360404
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360404,
					"content": "Os trajes de mergulho foram deixados na casa... como se tivessem preparado para a gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360405,
						741360406
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360405,
					"content": "Parece que ele encontrou a gente primeiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360407
					]
				},
				{
					"id": 741360407,
					"content": "Nenhum valor de pesquisa... mas eu... eu gastei tanto tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360408
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360408,
					"content": "Fusilier... ela passou esse tempo todo murmurando pra si mesma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360409,
					"content": "#Mas... {NICKNAME}, você tá com uma sensação que tão nos observando? Paimon tá sentindo um calafrio correndo pela espinha dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360410,
					"content": "Vou primeiro e olhar lá dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360406,
					"content": "Enfim, vamos cuidar de Nacker primeiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360407
					]
				}
			]
		},
