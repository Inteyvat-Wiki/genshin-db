					"nextDialogs": [
						741363404
					],
					"speakerTitle": "Lemarcq"
				},
				{
					"id": 741363404,
					"content": "É porque é um número muito misterioso. Se você o usar corretamente, poderá abrir um portão para a inspiração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363405
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363405,
					"content": "E já que estamos falando nisso, há ao todo cinco portões da inspiração. Você precisa abrir pelo menos cinco deles... cinco! Sabia? Cinco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363406
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363406,
					"content": "Sinto muito, eu queria muito dar cinco socos em você agora. Fecha essa matraca, ok?",
