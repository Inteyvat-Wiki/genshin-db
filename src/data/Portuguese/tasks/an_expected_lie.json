			"dialogs": [
				{
					"id": 741360901,
					"content": "Cachorros do instituto! Quanto Choiseul e Raimondo pagaram a vocês?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360902,
						741360903
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360902,
					"content": "Só um título.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360904
					]
				},
				{
					"id": 741360904,
					"content": "Você... você... escute. Me deixe ir. Meu Gerador de Campo está quase pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360905
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360905,
					"content": "Só preciso ajustar o Núcleo Cinético Arkhium e conectar ele... assim eu me tornarei o maior engenheiro de energia que existe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360906
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360906,
					"content": "... Assumir o crédito pelo trabalho de alguém e se intitular o maior engenheiro. Que vergonha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360907
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360907,
					"content": "Agora eu finalmente sei porque o Sr. Edwin... porque ele nunca quis que você participasse no centro do projeto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360908
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360908,
					"content": "Edwin não tem nem ideia do que fazer! Você também é do Instituto... Você sabe o valor de verdade dessa coisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360909
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360909,
					"content": "Me ajude! Eu posso... eu posso desenvolver com você! Nós vamos ser famosos, e incomparáveis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360910
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360910,
					"content": "Edwin, Raimondo, Choiseul... ninguém vai ser mais famoso que a gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360911,
						741360912
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360911,
					"content": "Parece que o que Raimondo disse era verdade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360913
					]
				},
				{
					"id": 741360913,
					"content": "Edwin... as conquistas do Sr. Edwin... pertencem ao Instituto. Eu sou a única aqui que pode reclamar elas, nada mais, nada menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360914
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360914,
					"content": "Srta. Fusilier... ela do nada passou a se referir a Edwin de outro jeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360915,
					"content": "Não seja tola, garota! Você não sabe o que Concini pode dar pra gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360916
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360916,
					"content": "Nunca vamos conseguir tais benefícios, mesmo que trabalhemos para Edwin por um milhão de anos! Edwin e o instituto só queriam nos usar... temos que pensar por nós mesmos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360917
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360917,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360918
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360918,
					"content": "Basta desse monte de besteira. Cale a boca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360919
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360919,
					"content": "E quem raios é você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360920
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360920,
					"content": "Quem protege o Porto Lumidouce. Só mais uma palavra e você vai provar do meu soco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360921
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360921,
					"content": "#{NICKNAME}, me ajude a amarrar ele e levar esse núcleo ou sei lá. Já passou da hora de voltarmos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360912,
					"content": "Deve ter sido difícil para você, Nacker, segurar isso por tanto tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360913
					]
				},
				{
					"id": 741360903,
					"content": "Nem uma Mora. Eu me voluntariei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360904
					]
				}
			]
		},
