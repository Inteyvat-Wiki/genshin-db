			"dialogs": [
				{
					"id": 741360601,
					"content": "Um espaço vazio enorme... com nada dentro... a gente vai acabar de mãos vazias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360602,
					"content": "As plantas foram intencionalmente eliminadas e a construção parece relativamente recente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360603
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360603,
					"content": "... Todos os problemas que eu passei por ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360604
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360604,
					"content": "Enfim, vou descer e dar uma olhada. Fiquem com a Srta. Instituto. Se as coisas ficarem fora de controle, levem ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360605
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360605,
					"content": "Mas não há nada aqui. Como é que as coisas chegaram a esse ponto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360606
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360606,
					"content": "Bip-bip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360607
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360607,
					"content": "Cuidado! Tem alguma coisa vindo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
