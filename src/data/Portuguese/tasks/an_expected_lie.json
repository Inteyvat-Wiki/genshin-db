			"dialogs": [
				{
					"id": 741361001,
					"content": "Edwin... eu sabia! Foi você que os atraiu até lá... você tem inveja de mim! Tem medo que minha pesquisa seja melhor que a sua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361002
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361002,
					"content": "Sim. Eu tenho muita inveja de sua ignorância. Não surpreende você ter tido uma vida tão boa no Instituto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361003
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361003,
					"content": "Se Choiseul visse essa cena, com certeza ia desmaiar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361004,
						741361005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361004,
					"content": "É melhor ele não acordar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361006
					]
				},
				{
					"id": 741361006,
					"content": "Você pode voltar com eles e admitir os seus erros. Eu vou continuar pesquisando... você não destruiu o meu dispositivo de pesquisa, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361007,
						741361008
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361007,
					"content": "E quem foi que te deixou voltar a pesquisar?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361009
					]
				},
				{
					"id": 741361009,
					"content": "E o que vocês vão fazer? Vão me capturar e levar de volta pro instituto? Como vou continuar minha pesquisa então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361010
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361010,
					"content": "Raimondo, aquele imbecil, deve ter acabado com tudo lá. E aquele outro idiota, Choiseul... *Suspiro* Só de pensar nele minha cabeça dói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361011
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361011,
					"content": "Quem quer destruir o instituto é você! Não finja que você não é responsável!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361012,
					"content": "Eu? Quem está colocando a culpa do Laboratório Central explodir em mim é o Instituto, correto? Eu não estava no Instituto nessa época!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361013
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361013,
					"content": "O Instituto é cheio de idiotas! Até mesmo um copo de café caindo é capaz de fazer o dispositivo parar. Não surpreende uma explosão ter acontecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361014
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361014,
					"content": "Então por que você não explica pra gente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361015
					]
				},
				{
					"id": 741361015,
					"content": "Explicar? Eu não vou dar um bode expiatório pra eles. Eu ainda quero pesquisar bastante, não posso perder tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361016
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361016,
					"content": "Por isso você se misturou com aquele tal de Concini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361017
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361017,
					"content": "Ah, Concini... não sabia fazer nada direito. Não conseguia comprar um dispositivo preciso, eu tinha que fazer tudo sozinho. Felizmente ele ficou disposto a pagar o prejuízo, por isso minha pesquisa acabou correndo bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361018
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361018,
					"content": "Mas eu não esperava que meu querido colega, Nacker, viesse carregando aquele núcleo incompleto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361019
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361019,
					"content": "Eu o melhorei! Você nunca vai conseguir usar as minhas tecnologias para isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361020
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361020,
					"content": "Haha! Sr. Nacker, Concini não está aqui para você puxar o saco dele, então por que não para de mentir? Você não tem dignidade nenhuma como pesquisador?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361021
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361021,
					"content": "Você...! Está incompleto porque você não sabe como completar! Mas eu sei, e posso fazer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361022
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361022,
					"content": "Agora. Peguem esse lixo, leve ele para o Instituto e continuem sugando ele. Eu tenho algo importante que precisa de minha atenção. Você... Fusi alguma coisa, deixarei isso nas suas mãos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361023
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361023,
					"content": "Esses dois vão parar de brigar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361024,
					"content": "... Já chega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361025
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361025,
					"content": "O quê? Você pode parar de desperdiçar meu tempo? Preciso voltar ao trabalho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361026
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361026,
					"content": "Eu disse... chega!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361027
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361027,
					"content": "Edwin Eastinghouse! Foi você quem explodiu o instituto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361028
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361028,
					"content": "E você, Nacker, roubou os bens do Instituto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361029
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361029,
					"content": "E explodiu ele uma segunda vez!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361030
					]
				},
				{
					"id": 741361030,
					"content": "Vocês dois prejudicaram os interesses do Instituto... e como investigadora especial do Instituto de Pesquisas de Fontaine, estou levando vocês dois de volta para ele, onde aguardarão suas punições!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361031
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361031,
					"content": "Droga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361032
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361032,
					"content": "Oh, por favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361033
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361033,
					"content": "Eu e Lemarcq vamos escoltar esses dois de volta. Já fomos garotos de mensagem por tanto tempo, o Instituto com certeza vai compensar a gente, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361034
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361034,
					"content": "Lembre-se, fiquem calados, ou o fim de vocês vai ser mais rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361008,
					"content": "Pare agora mesmo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361009
					]
				},
				{
					"id": 741361005,
					"content": "Eu acho que vou desmaiar também...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361006
					]
				}
			]
		},
