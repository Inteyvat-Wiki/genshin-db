				]
			},
			"dialogs": [
				{
					"id": 727380101,
					"content": "Sim, isso serve. Só um trabalhinho rápido e simples de limpeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380102,
					"content": "#Ah, pequenin{F#a}{M#o}, você chegou bem na hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380103,
						727380104
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380103,
					"content": "Bem na hora... Bem na hora do quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380105
					]
				},
				{
					"id": 727380105,
					"content": "Ah, olha só pra você. Dá pra ver o que está pensando. \"Ah, não, lá vem ela me mandar fazer outra daquelas tarefas chatas, né?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380106,
					"content": "Não se preocupe, eu só ia dizer que terminamos a reforma do santuário e estamos prestes a lançar um serviço novinho em folha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380107,
					"content": "Ainda nem tive a chance de anunciar, e aqui está você. Não acha que foi uma boa coincidência?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380108
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380108,
					"content": "Está vendo essa caixa de oferendas ao meu lado? Em breve, vai haver outro lugar para fazer desejos por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380109,
					"content": "Você já não tem os Rolinhos da Sorte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380110
					]
				},
				{
					"id": 727380110,
					"content": "Isso é diferente. Os Rolinhos da Sorte possibilitam revelar a sorte, enquanto isto... é sobre fazer desejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380111,
					"content": "Muito bem, agora feche os olhos, faça um desejo, escreva-o numa tábua de prece e pendure aqui neste suporte, quem sabe seu desejo não se realiza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380112,
					"content": "Posso desejar qualquer coisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380113
					]
				},
				{
					"id": 727380113,
					"content": "Claro. Mas quanto a quais desejos se realizam... Isso cabe aos deuses que nos observam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380114
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380114,
					"content": "#Como a Guuji impotente que sou, só posso ajudá-l{F#a}{M#o} em assuntos do mundo dos mortais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380115,
						727380116
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380115,
					"content": "Eu não me importaria de fazer alguns novos amigos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380117
					]
				},
				{
					"id": 727380117,
					"content": "Se é isso que você deseja, então por que não tentar? Aqui, pegue este papel da sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380118
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380118,
					"content": "Sobrou da confecção dos Rolinhos da Sorte. Pode ficar com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380119
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380119,
					"content": "Tente escrever seu desejo aqui. Talvez assim ele tenha mais chance de se realizar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380120
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380120,
					"content": "Sério?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380121
					]
				},
				{
					"id": 727380121,
					"content": "#Quando foi que eu menti pra você? Vamos lá, pequenin{F#a}{M#o}, está na hora de fazer seu desejo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380122
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380122,
					"content": "Lembre-se de escrever seu desejo no papel da sorte, colá-lo na tábua de prece e pendurá-la no suporte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380123
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380123,
					"content": "Depois disso, seu desejo estará feito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380124,
					"content": "Isso. Bem solene. Muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380125
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380125,
					"content": "Tem certeza de que isso vai funcionar...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380126
					]
				},
				{
					"id": 727380126,
					"content": "#Certo, pequenin{F#a}{M#o}, de volta ao trabalho. Lembre-se de manter os ouvidos atentos e os olhos bem abertos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380127
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380127,
					"content": "Afinal, a pessoa que você deseja encontrar pode muito bem estar sentada comendo um macarrão, aproveitando uma tigela deliciosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380116,
					"content": "Eu gostaria de reencontrar alguns velhos amigos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380117
					]
				},
				{
					"id": 727380104,
					"content": "Espera aí... Aonde isso vai dar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380105
					]
				}
			]
		}
	]
}