			"dialogs": [
				{
					"id": 210330403,
					"content": "Esse cabo... Ele parece bem completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330404
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330404,
					"content": "Ela tem alguma relação com a Lâmina Oculta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330405
					]
				},
				{
					"id": 210330405,
					"content": "Preciso examinar detalhadamente para saber... Esqueci de avisar você que já venho procurando por toda parte pelos fragmentos dessa arma já faz um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330406
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330406,
					"content": "Comprei diversas peças do mercado, juntei pela natureza, e até mesmo comprei de alguns aventureiros... Achei que talvez poderiam me levar até a Lâmina Oculta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330407
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330407,
					"content": "Porém, até então, não encontrei nem sombra dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330408
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330408,
					"content": "Ah, não importa. Temos um ditado em Liyue: \"Querer é poder\". Continuarei procurando... Até eu encontrar a Lâmina Oculta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330409
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330409,
					"content": "Aqui, Viajante. Pegue isso como recompensa pelos seus esforços.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		}
