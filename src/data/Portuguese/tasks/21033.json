			"dialogs": [
				{
					"id": 210330101,
					"content": "Eu tenho uma ideia que pode, ou não, dar certo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330102,
					"content": "Você ainda está procurando por aquela sua espada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330103
					]
				},
				{
					"id": 210330103,
					"content": "Oh, é você, Viajante. De fato, ainda estou procurando pela Lâmina Oculta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330104,
					"content": "Mas, ainda não consegui encontrar nenhuma pista útil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330105,
					"content": "Acho que não tem como evitar. Estou procurando por uma espada em Liyue... É como procurar uma agulha em um palheiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330106,
					"content": "Alguém disse para mim que a espada pode ter sido destruída há muito tempo por um monstro. Mas mesmo que esse seja o caso, eu encontrarei e juntarei cada um dos fragmentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330107
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330107,
					"content": "Desculpa. Estou divagando. A localização que preciso que você cheque foi marcada no seu mapa. Agradeço pela sua ajuda, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330108,
					"content": "Apenas espero que a espada não esteja realmente quebrada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
