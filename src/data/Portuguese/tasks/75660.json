			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xilonen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756600101,
					"content": "Ufa... Com certeza o tempo está ótimo. Esta viagem realmente valeu a pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600102
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600102,
					"content": "Hmm? Meus olhos me enganam, ou estou vendo \"Tuma{RUBY#[S]Esperança}ini\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600103,
						756600104
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600103,
					"content": "Que coincidência, Xilonen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600105
					]
				},
				{
					"id": 756600105,
					"content": "Você conta a Xilonen sobre Irade e as etapas do exame...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756600106
					]
				},
				{
					"id": 756600106,
					"content": "Ah, entendo... Quase esqueci. Eu realmente dei uma mão para ela antes. Na verdade, a etapa da nossa tribo está aqui perto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600107
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600107,
					"content": "No início, ela só contou com a ajuda de \"Calamidade de Tetlahuitl\", Nkunga, e da \"Lâmina de Areia de Setiada\", Amuru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600108
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600108,
					"content": "Mas esses dois não são muito adeptos de \"mobilidade\", preferindo confrontos diretos, então o retorno resultante ficou enviesado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600109
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600109,
					"content": "A primeira coisa que Pacal fez ao ouvir isso foi me pedir para dar algumas sugestões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600110,
						756600113
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600110,
					"content": "Então, a etapa atual é obra sua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600111
					]
				},
				{
					"id": 756600111,
					"content": "Mais ou menos. Pacal, Irade e eu fizemos algumas modificações após algumas discussões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600112
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600112,
					"content": "Agora, as etapas são mais sobre posicionar-se rapidamente em terreno vantajoso e gerenciar um ponto de apoio móvel no calor da batalha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600116,
						756600117
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600116,
					"content": "Permita-me aceitar seu desafio, então!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600118
					]
				},
				{
					"id": 756600118,
					"content": "Por favor, todos em Natlan já presenciaram sua força. Duvido que qualquer desafio consiga derrotar você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600119
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600119,
					"content": "De qualquer forma, a arena está ali. Experimente, se estiver a fim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600117,
					"content": "Vamos torcer para que você não tenha tornado isso difícil demais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600118
					]
				},
				{
					"id": 756600113,
					"content": "Você... realmente consegue fazer praticamente qualquer coisa, não é...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600114
					]
				},
				{
					"id": 756600114,
					"content": "Eh, só alguns dispositivos simples. Não foi tão difícil construí-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600115
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600115,
					"content": "Um esforço único da minha parte para o desenvolvimento de guerreiros mais fortes para a nossa tribo? Esse é um bom negócio — especialmente porque posso usar esse tempo livre extra para dar conta da minha fila de comissões...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600116,
						756600117
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600104,
					"content": "Aceitei a comissão de Irade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600105
					]
				}
			]
		}
	]
}