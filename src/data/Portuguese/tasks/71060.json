			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591101,
					"content": "O quê foi? Vieram aqui incomodar o meu descanso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591102
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591102,
					"content": "Não, nós só vimos que você estava aqui sozinha e queríamos conversar com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591103,
						710591104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591103,
					"content": "Deve ser muito chato beber sozinha, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591105
					]
				},
				{
					"id": 710591105,
					"content": "... Mesmo? Obrigada. Vocês me lembram de Lyudochka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591106
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591106,
					"content": "Ela era uma garota gentil. Antigamente ela sempre conversava de tudo comigo. Mas somente comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591107
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591107,
					"content": "*Suspiro* Como gostaria que Lyudochka estivesse aqui... Ela era uma pessoa muito divertida, você com certeza gostaria dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591108,
						710591113
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591108,
					"content": "Lyudochka? Quem é essa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591109
					]
				},
				{
					"id": 710591109,
					"content": "Ela é uma amiga minha. Ela tem uma aparência muito séria, mas na verdade é uma tonta bem divertida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591110
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591110,
					"content": "Nós éramos como irmãs quando morávamos na Casa da Lareira... Na verdade, é possível que ela fosse ainda mais do que uma irmã para mim... Ela gostava de me provocar, mas também cuidava de mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591111
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591111,
					"content": "Haha, de qualquer forma, eu tenho a sensação que ela está bem lá fora. Quando penso nisso, todas as feridas que sofri neste lugar infernal não são nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591112
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591112,
					"content": "Espero que ela consiga realizar sua missão... E que não pense em mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591113,
					"content": "Lyudochka? Você está falando daquela que está em Inazuma...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591114
					]
				},
				{
					"id": 710591114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591115
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591115,
					"content": "Então ela foi exposta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591116
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591116,
					"content": "Hã? Como você sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591117,
						710591118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591117,
					"content": "Ela conseguiu fugir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591119
					]
				},
				{
					"id": 710591119,
					"content": "Mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591120
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591120,
					"content": "Haha... Ótimo, espero que ela ainda esteja fazendo sua missão bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591121
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591121,
					"content": "Mas se ela traiu a vontade da Tsaritsa para poder viver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591122
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591122,
					"content": "... Espero que ela não lembre de mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591118,
					"content": "Ela ainda está viva, e está muito bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591119
					]
				},
				{
					"id": 710591104,
					"content": "Por isso nós viemos aqui conversar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591105
					]
				}
			]
		},
