			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726790101,
					"content": "Ioroi, nós voltamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790102,
					"content": "Oh, vocês voltaram! Como está o treinamento de Kichiboushi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790103
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790103,
					"content": "Splash splash, caboom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790104
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726790104,
					"content": "Hahahaha, ótimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790105
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790105,
					"content": "Oh não, já não conseguimos mais entender Kichiboushi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790106,
					"content": "Nós até mesmo tiramos muitas fotos. Dê uma olhada nelas, Ioroi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790107,
					"content": "Você mostra as fotos que tirou para Kichiboushi nesse tempo.\\nVocê também conta para ele sobre suas aventuras.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726790108
					]
				},
				{
					"id": 726790108,
					"content": "... Foi assim que nós completamos seu pedido \"leve Kichiboushi a oito locais para treinar\", Ioroi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790109,
					"content": "#Hmm! Ótimo, muito bom. Não julguei vocês mal. Se vocês fossem Tanuki, seriam grandes e renomad{F#as}{M#os}, talvez metade de quão forte e grande que sou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790110
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790110,
					"content": "(Isso não é tão impressionante assim...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790111,
					"content": "Mas, como completamos essa missão, nós deveríamos ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790112,
					"content": "Hmmmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790113
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726790113,
					"content": "Está bem, está bem. Venha, Kichiboushi, Paimon vai lhe ensinar mais uma coisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790114,
					"content": "Quando você se despede de seus amigos, você deve fazer isso com um sorriso! Dessa forma, você ficará ainda mais feliz quando os encontrar novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790115,
					"content": "Hmm? Está bem, deixe comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790116
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790116,
					"content": "Kichiboushi disse: \"Entendi, Pelo Branco\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790117
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790117,
					"content": "Hã? Quer dizer que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790118,
						726790119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790118,
					"content": "Kichiboushi não sabe mais falar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				},
				{
					"id": 726790120,
					"content": "Já se passou muito tempo. O efeito da refeição Tanuki deve ter passado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790121
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790121,
					"content": "Hmph! Se eu estivesse livre desse selo de pedra, seria fácil fazer vocês entenderem a língua Tanuki o tempo inteiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790122
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790122,
					"content": "Hã? Claro, eu lhes ajudarei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790123
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790123,
					"content": "\"Kichiboushi treinar duro\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790124
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790124,
					"content": "\"Virar Bake-Danuki forte como Ioroi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790125
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790125,
					"content": "Hmm? Hahaha! Que atrevimento esse, pequenino! Me lembra de quando eu tinha sua idade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790126
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790126,
					"content": "#\"Assim, quando Pelo Branco e Pelo Lour{F#a}{M#o} não comer comida Tanuki também poder me entender\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790127
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790127,
					"content": "Bem, nós vamos esperar então, Kichiboushi! Viremos treinar com você da próxima vez também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790128,
					"content": "Kichiboushi, força!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790129
					]
				},
				{
					"id": 726790129,
					"content": "E não seja selado por humanos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790130
					]
				},
				{
					"id": 726790130,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790131
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790131,
					"content": "Hmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790132
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726790132,
					"content": "Ah, não importa. Deixarei isso passar, visto que vocês levaram Kichiboushi para treinar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790133
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790133,
					"content": "Ah, sim. Existia uma pessoa chamada Utamarou que pintou o Tanuki selado na Floresta Chinju e deixou para trás alguns rascunhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790134
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790134,
					"content": "Fiquem com eles. Podem olhar quando quiserem para se lembrar das formas majestosas do povo Tanuki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790135
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790135,
					"content": "*Suspiro* Ah, se vocês também fosse Tanuki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790136
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790136,
					"content": "... Teríamos virado pedra também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790137
					]
				},
				{
					"id": 726790137,
					"content": "Hmph, sim. Bem, é melhor vocês seguirem seu caminho. Preciso ensinar algumas magias para Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790119,
					"content": "Será que não estamos entendendo ele de novo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				}
			]
		}
	]
}