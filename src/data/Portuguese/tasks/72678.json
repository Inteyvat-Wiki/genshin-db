			},
			"dialogs": [
				{
					"id": 726780301,
					"content": "Hmm... Bonito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780302
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780302,
					"content": "Kichiboushi, o que está de errado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780303,
					"content": "Cidade muito deserta. Um pouco triste, não sei por quê. Estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780304,
						726780305
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780304,
					"content": "Eu também acho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				},
				{
					"id": 726780306,
					"content": "Bem, vamos seguir agora para o centro dessa cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780305,
					"content": "Kichiboushi, você é estranho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				}
			]
		},
		{
			"id": 7267804,
			"completionStepIds": [
				7267804
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267804",
