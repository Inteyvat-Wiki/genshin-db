			"dialogs": [
				{
					"id": 726780101,
					"content": "Cidade muito grande... Mas parece desolada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780102
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780102,
					"content": "Nós viemos aqui antes com muitos companheiros nossos, e lutamos numa batalha contra Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780103,
					"content": "Stormterror é grande, com dentes afiados e asas enormes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780104,
						726780105
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780104,
					"content": "Na verdade, ele não é tão assustador assim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				},
				{
					"id": 726780106,
					"content": "Kichiboushi, você ainda se lembra da Estátua do Arconte Anemo que vimos em Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780107,
					"content": "Estátua do Arconte Anemo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780108
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780108,
					"content": "É aquela estátua bem alta de pedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780109,
					"content": "Hmm! Sim. Arconte Anemo mãos grandes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780110
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780110,
					"content": "Stormterror é um amigo do Arconte Anemo! Muito tempo atrás, o Arconte Anemo também veio desta cidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780111,
					"content": "Oh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780112
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780112,
					"content": "Mas, se Ventão grande, como ele entra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780113,
						726780114
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780113,
					"content": "Sinto como se já tivesse ouvido essa pergunta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780115,
					"content": "Ah, Paimon sabe! É porque ele não entra andando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780116,
					"content": "Kichiboushi sabe. Ventão voar, não andar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780117
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780117,
					"content": "A—Argh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780118,
					"content": "Mm? Paimon parece infeliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780119
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780119,
					"content": "Ah... Nós podemos falar disso depois. Vamos primeiro tirar uma foto! Ei, Kichiboushi, fique parado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780120,
					"content": "Kichiboushi parado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780114,
					"content": "É Stormterror.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780105,
					"content": "Ele é bem adorável.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				}
			]
		},
		{
