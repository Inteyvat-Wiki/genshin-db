			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726780401,
					"content": "Ai ai ai... Que vento forte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780402
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780402,
					"content": "Não podemos passar por esta muralha de vento! Temos que contornar ela para poder continuar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780403,
					"content": "Kichiboushi, siga-nos em torno da muralha de vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7267805,
			"completionStepIds": [
				7267807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267807",
							"2"
						],
						"stepId": 7267807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726780501,
					"content": "Finalmente chegamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780502,
					"content": "As vistas daqui não se comparam com as de lá de baixo. Vejam, viemos de lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780503,
					"content": "Paimon gosta de lugares altos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780504,
						726780505
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780504,
					"content": "Os lugares altos não só servem para apreciar vistas magníficas, mas também são ideais para planar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780507
					]
				},
				{
					"id": 726780507,
					"content": "Ventão dorme nesta torre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780508
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780508,
					"content": "Sim, ele dormiu aqui por muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780509,
					"content": "#Embora {NICKNAME} e Stormterror tenham lutado, Dvalin não é um dragão mau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780510,
					"content": "Apenas que aconteceu algo infeliz com ele. Ele foi machucado, e alguns bandidos o enganaram, e é por isso que ele acreditava que seu amigo Arconte Anemo não o amava mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780511,
					"content": "Oh... E então o que aconteceu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780512
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780512,
					"content": "#Então... {NICKNAME}, você se lembra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780513,
					"content": "Durante o combate, purificamos seu sangue envenenado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780514
					]
				},
				{
					"id": 726780514,
					"content": "Mas a plataforma em que estávamos lutando desabou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780515,
					"content": "Hmm! Assustador... O que vocês fizeram? Voaram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780516,
						726780519
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780516,
					"content": "Dvalin nos salvou, e eles nos levou para longe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780517
					]
				},
				{
					"id": 726780517,
					"content": "Dva...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780518
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780518,
					"content": "É o nome de Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780520,
					"content": "#Na verdade, Stormterror tinha um nome próprio, assim como Kichiboushi, Paimon e {NICKNAME}. O nome dele é Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780521,
					"content": "No começo, Dvalin estava ferido e foi enganado por pessoas más, por isso ele ficou furioso. É essa a razão dele ter atacado Mondstadt, e porque todos pensavam que ele era um mau dragão, passaram a chamá-lo de Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780522,
					"content": "Depois, nós vencemos essas pessoas más e ajudamos o Arconte Anemo a purificar o sangue que o estava envenenando. Foi aí que ele percebeu que o Arconte não o havia abandonado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780523,
					"content": "Ooh! Então Ventão bom de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780524
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780524,
					"content": "Sim! E é por isso que Paimon trouxe você aqui para treinar hoje. Paimon queria lhe contar a história de Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780525,
					"content": "Kichiboushi, quando você ficar mais velho, você será mal compreendido, se machucará, e também passará por coisas tristes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780526,
					"content": "Mas você não deve virar uma má pessoa. Porque \"os ventos mudam sua direção\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780527,
					"content": "Haverá um dia que eles soprarão para um amanhã melhor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780528
					]
				},
				{
					"id": 726780528,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780529
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780529,
					"content": "Foi difícil entender isso, Kichiboushi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780530
					]
				},
				{
					"id": 726780530,
					"content": "Entendi, e não entendi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780531
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780531,
					"content": "#Mas Kichiboushi sabe que é importante. Não esquecer o que Paimon e {NICKNAME} falaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780532
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780532,
					"content": "Hehe! Bem, pelo menos nossa longa história não foi desperdiçada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780533,
					"content": "De qualquer forma, você não deve virar muito brincalhão ou treloso, Kichiboushi, ou alguém poderá lhe selar no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780534,
						726780535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780534,
					"content": "Parece que essa rodada do seu treinamento acabou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780536,
					"content": "Ooh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780537
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780537,
					"content": "Não fique triste! Sorria enquanto voltamos, Ioroi também ficará feliz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780538,
					"content": "Bem, acho que temos que fazer nosso trabalho como guias de volta uma última vez, não é...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780539,
					"content": "Bem, é hora de levarmos Kichiboushi de volta para Ioroi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780540,
						726780541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780540,
					"content": "Vamos indo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780542,
					"content": "Hmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780541,
					"content": "Vamos lá, Kichiboushi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780535,
					"content": "Acho que concluímos a comissão de Ioroi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780519,
					"content": "Stormterror nos salvou, e nos levou voando para longe da batalha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780520
					]
				},
				{
					"id": 726780505,
					"content": "\"Os tolos e a fumaça adoram lugares altos...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780506
					]
				},
				{
					"id": 726780506,
					"content": "Ei! Não tem nada a ver com isso. Nos lugares altos, as vistas são espetaculares e o ar é muito mais limpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780507
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
