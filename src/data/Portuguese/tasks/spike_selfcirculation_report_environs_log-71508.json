					"nextDialogs": [
						715080105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715080105,
					"content": "Os dois mineradores, ou seja, Lao Tu e Hao, já voltaram e estão descansando, mas... Pelo visto, é difícil de transportar a Ponta até...",
