				},
				{
					"id": 715080102,
					"content": "#Estou feliz que o ajudante que Khedive encontrou foi você. Se fosse outr{F#a Aventureira}{M#o Aventureiro}, talvez não fosse possível resolver esses problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715080103
					],
					"speakerTitle": "Hosseini"
				},
				{
