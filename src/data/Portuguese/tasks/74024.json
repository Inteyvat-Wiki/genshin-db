					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240703,
					"content": "Quero dizer, você pode mesmo fazer \"cores brilhantes\" usando esses materiais como base?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240704,
						740240706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240704,
					"content": "Acho que não.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240705
					]
				},
				{
					"id": 740240705,
					"content": "Mas Sluasi parece tão feliz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240708,
					"content": "Independente do caso, agradeço a vocês pela ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240709
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240709,
					"content": "Por favor, aceitem isso como agradecimento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240710
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240710,
					"content": "G-Gemas brilhantes— e componentes também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240711,
					"content": "Hehe. Fico feliz que gostaram. Se desejarem algum ornamento no futuro, sabem onde me encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240706,
					"content": "Não é totalmente impossível...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240707
					]
				},
				{
					"id": 740240707,
					"content": "Isso é verdade, as cores que Maime usa são bem esquisitas também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240708
					],
					"speakerTitle": "Paimon"
				}
