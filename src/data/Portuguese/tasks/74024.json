					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740241002,
					"content": "Ah, é tão caloroso... cheira tão bem e é tão macio — realmente é tão gentil quanto o próprio sol. Certamente, humanos devem usar isso para fazer comida. Enfim, muito obrigada. Me lembrarei deste item.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740241003
					],
					"speakerTitle": "Sluasi"
				},
				{
